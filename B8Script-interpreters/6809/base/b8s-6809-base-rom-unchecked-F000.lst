                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd4n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd4n:   NEXTF
                    FD4N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD5:      LDD   #5   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd5n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd5n:   NEXTF
                    FD5N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD6:      LDD   #6   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd6n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd6n:   NEXTF
                    FD6N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD7:      LDD   #7   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd7n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd7n:   NEXTF
                    FD7N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD8:      LDD   #8   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd8n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd8n:   NEXTF
                    FD8N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD9:      LDD   #9   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd9n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd9n:   NEXTF
                    FD9N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                                 ; fdm: another digit, at the IP: the value on top becomes value * 10 + digit
                    FDM:      LDD   ,U   
                              ASLB      
                              ROLA      
                              ASLB      
                              ROLA      
                              ADDD   ,U   ; 5V
                              ASLB      
                              ROLA      ; 10V
                              ADDB   ,Y+   ; and the digit
                              ADCA   #0   
                              SUBD   #30h   ; minus "0"
                              STD   ,U   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BLO   fdm   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
F3FF                          ENDIF      
F3FF                          IF   FAST*(1-CHECKED)   
                                 ; A-Z: call the word: the IP goes on the return stack, the IP becomes
                                 ; the word's body (the cell is little-endian), and the break key is
                                 ; looked at, one time in 256.
                    FUA:      PSHS   Y   ; A
                              LDB   <00h   
                              LDA   <01h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuA1   
                              JSR   pk1   
                              ;*Macro unroll: fuA1:   NEXTF
                    FUA1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUB:      PSHS   Y   ; B
                              LDB   <02h   
                              LDA   <03h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuB1   
                              JSR   pk1   
                              ;*Macro unroll: fuB1:   NEXTF
