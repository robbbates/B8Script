E763   68           SP1:      PLA      
E764   60                     RTS      
E765                             ; udiv (QK): as the macro UDIV, and any power of two is shifts: 2, and 32,
E765                             ; 64, 256 and the like, which fixed point and byte work use all the time.
E765   A9 00        UDIV:     LDA   #0   
E767   95 FE                  STA   0FEh,X   
E769   95 FF                  STA   0FFh,X   
E76B   A4 05                  LDY   D0   
E76D   A5 06                  LDA   D1   
E76F   D0 12                  BNE   uq1   ; 256 and up
E771   98                     TYA      
E772   F0 38                  BEQ   ud0   ; by 0: the long way (it means nothing anyway)
E774   88                     DEY      
E775   98                     TYA      
E776   25 05                  AND   D0   
E778   D0 32                  BNE   ud0   ; not a power of two
E77A   98                     TYA      ; by 2^k below 256: r = a & (2^k - 1),
E77B   35 00                  AND   0,X   
E77D   95 FE                  STA   0FEh,X   
E77F   A5 05                  LDA   D0   ;   and q = a >> k
E781   D0 1E                  BNE   uq2   ; always
E783   98           UQ1:      TYA      
E784   D0 26                  BNE   ud0   ; not a power of two
E786   A4 06                  LDY   D1   
E788   88                     DEY      
E789   98                     TYA      
E78A   25 06                  AND   D1   
E78C   D0 1E                  BNE   ud0   ; not a power of two
E78E   98                     TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
E78F   35 01                  AND   1,X   
E791   95 FF                  STA   0FFh,X   
E793   B5 00                  LDA   0,X   
E795   95 FE                  STA   0FEh,X   
E797   B5 01                  LDA   1,X   ;   and q = (a >> 8) >> (k - 8)
E799   95 00                  STA   0,X   
E79B   A9 00                  LDA   #0   
E79D   95 01                  STA   1,X   
E79F   A5 06                  LDA   D1   
E7A1   4A           UQ2:      LSR      ; a bit of 2^k: one shift for each 0 below
E7A2   B0 07                  BCS   uq9   ;   the 1
E7A4   56 01        UQ3:      LSR   1,X   
E7A6   76 00                  ROR   0,X   
E7A8   4A                     LSR      
E7A9   90 F9                  BCC   uq3   
E7AB   60           UQ9:      RTS      
E7AC                          ENDIF      
