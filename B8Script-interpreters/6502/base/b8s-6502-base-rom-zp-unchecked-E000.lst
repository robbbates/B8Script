                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_NOT:   LDA   0,X   ; ~
                              EOR   #0FFh   
                              STA   0,X   
                              LDA   1,X   
                              EOR   #0FFh   
                              STA   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
