E359   36 06                  PSHU   D   
E35B   8D EC                  BSR   pdec   
E35D   35 02        PD1:      PULS   A   
E35F   8B 30                  ADDA   #"0"   ; and fall into putc
E361   7E FF 03     PUTC:     JMP   CONOUT   
E364                             ; ---- the tail ---------------------------------------------------------------
E364                             ; "$" is the last handler, so what follows its first byte may lie past the
E364                             ; second range: its loop, the escapes, and the routines of "/".
E364                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E364                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E364                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E364                             ; it stops with Z, both operands still on the stack.
E364                H_DIV:       
E364                          IF   CHECKED   
E364   EC C4                  LDD   ,U   
E366   10 27 FF 23            LBEQ   e_zero   
E36A                          ENDIF      
E36A   A6 42                  LDA   2,U   
E36C   34 02                  PSHS   A   ; a's sign: for r
E36E   A8 C4                  EORA   ,U   
E370   34 02                  PSHS   A   ; a xor b: for q
E372   30 42                  LEAX   2,U   
E374   8D 64                  BSR   absx   ; |a|
E376   1F 31                  TFR   U,X   
E378   8D 60                  BSR   absx   ; |b|
E37A                          IF   1-QK   
                              BSR   udiv   ; NOS = q, TOS = r
E37A                          ENDIF      
E37A                          IF   QK   
E37A   BD E4 68               JSR   udiv   ; (base: with the speed-ups)
E37D                          ENDIF      
E37D   30 42                  LEAX   2,U   
E37F   6D E0                  TST   ,S+   
E381   2A 02                  BPL   dv1   
E383   8D 4E                  BSR   negx   ; q's sign
E385   6D E0        DV1:      TST   ,S+   
E387   2A 50                  BPL   ng9   
E389   20 46                  BRA   negt   ; r's sign
E38B                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E38B                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E38B                             ; clears that character"s bit 6 (/M is CR, "/" and DEL is "?"; "/", ""'
E38B                             ; and "?" have no bit 6, so //, /" and /? give themselves). The address
E38B                             ; comes off the stack first, and Y walks the string (the IP waits on S), so
E38B                             ; that /~ finds its row and column on top, and an escape may use A, B, X
E38B                             ; and the routines.
E38B                             ; Checked: a NUL (not one escaped by "/") stops with Q, the string's
E38B                             ; address put back on the stack (from PSAV) over what any /~ left.
E38B   34 20        H_PRINT:   PSHS   Y   
E38D   37 20                  PULU   Y   
