E243                             ; carry clear, and then the address is pushed back.
E243   38           H_RET:    SEC      
E244                RET1:        
E244   68                     PLA      
E245   68                     PLA      ; drop the step frame
E246   68                     PLA      
E247   85 00                  STA   IP   
E249   68                     PLA      
E24A   85 01                  STA   IP+1   
E24C   B0 1D                  BCS   nxt2   
