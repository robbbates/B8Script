0226                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0226   CD                     DS   CPM,0CDh   
0227   27                     DS   CPM,ANEG&0FFh   
0228   01                     DS   CPM,ANEG/256   
0229   D1           H_ADD:    POP   D   
022A   19                     DAD   D   
