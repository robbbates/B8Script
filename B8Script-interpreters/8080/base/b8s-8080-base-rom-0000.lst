                                 ; A-Z: call the word. The return address goes on the return stack, the IP
                                 ; becomes the word's body, and the break key is looked at as rpushd would.
                    FUA:      LHLD   RSP   ; A
                              DCX   H   
                              MOV   M,B   
                              DCX   H   
                              MOV   M,C   
                              SHLD   RSP   
