  1285                              <1> 
  1286                              <1> ; getk: a key for '?', waiting up to ECX ms (0: for ever); or AL = 0 and
  1287                              <1> ; the zero flag if none came. A held key goes first, and is taken out.
  1288                              <1> ; Keeps ECX and EDX.
  1289 00000509 31C0                <1> getk:   xor     eax,eax
