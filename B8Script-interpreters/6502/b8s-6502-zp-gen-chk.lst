E538                             ; =============================================================================
E538                             ;  Checked build: the error report
E538                             ; =============================================================================
E538                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E538                             ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
E538                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E538                             ; its depth is shown.
E538                             ;   CR LF
E538                             ;   Err X @ line,col CR LF
E538                             ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
E538                             ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
E538                             ;   Rtn n CR LF
E538                             ; The numbers go through "#" (prnum), which pushes them over the data stack
E538                             ; and pops them again, so the stack is shown as it was. With the stack full
E538                             ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
E538   48           ERROR:    PHA      ; the letter
E539   A5 08                  LDA   PLACE   
E53B   85 02                  STA   P   
E53D   A5 09                  LDA   PLACE+1   
E53F   85 03                  STA   P+1   ; (the numbers need D0/D1)
E541   A0 00                  LDY   #M_ERR-MSG   
E543   20 DF E5               JSR   prs   ; CR LF "Err "
E546   68                     PLA      
E547   20 03 FF               JSR   CONOUT   
E54A   20 DF E5               JSR   prs   ; " @ " (it follows M_ERR)
E54D   20 0A E6               JSR   lcol   
E550   A5 0A                  LDA   LN   
E552   A4 0B                  LDY   LN+1   
E554   20 D9 E5               JSR   prnum   ; the line
E557   A9 2C                  LDA   #","   
E559   20 03 FF               JSR   CONOUT   
E55C   A5 05                  LDA   T1   
E55E   A4 06                  LDY   T2   
E560   20 D9 E5               JSR   prnum   ; the column
E563   A0 09                  LDY   #M_NL-MSG   
E565   20 DF E5               JSR   prs   
E568   A0 00                  LDY   #0   ; the text at the place
E56A   B1 02        ER1:      LDA   (P),Y   
E56C   F0 10                  BEQ   er2   
E56E   C9 0D                  CMP   #13   
E570   F0 0C                  BEQ   er2   
E572   C9 0A                  CMP   #10   
E574   F0 08                  BEQ   er2   
E576   20 03 FF               JSR   CONOUT   
E579   C8                     INY      
E57A   C0 10                  CPY   #16   
E57C   D0 EC                  BNE   er1   
E57E   A0 0B        ER2:      LDY   #M_STK-MSG   
E580   20 DF E5               JSR   prs   ; CR LF "Stk "
E583   8A                     TXA      
E584   49 FF                  EOR   #0FFh   
E586   38                     SEC      
E587   E9 0F                  SBC   #0FFh-DSE   
E589   4A                     LSR      ; the depth, (DSE - X) / 2
E58A   48                     PHA      
E58B   20 D7 E5               JSR   prnum8   
E58E   68                     PLA      
E58F   A0 16                  LDY   #M_C-MSG   ; ":"
E591   C9 09                  CMP   #9   
E593   90 04                  BCC   er3   
E595   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E597   A0 11                  LDY   #M_CD-MSG   
E599   85 05        ER3:      STA   T1   ; T1 = how many cells to show
E59B   20 DF E5               JSR   prs   
E59E   A5 05        ER4:      LDA   T1   ; cells T1-1 down to 0, the top last: cell i
E5A0   F0 1F                  BEQ   er5   ;   from the top is at X+2i
E5A2   C6 05                  DEC   T1   
E5A4   A9 20                  LDA   #" "   
E5A6   20 03 FF               JSR   CONOUT   
E5A9   A5 05                  LDA   T1   
E5AB   0A                     ASL      
E5AC   85 06                  STA   T2   
E5AE   8A                     TXA      
E5AF   65 06                  ADC   T2   ; (the carry is clear)
E5B1   A8                     TAY      
E5B2   B9 00 00               LDA   0,Y   
E5B5   48                     PHA      
E5B6   B9 01 00               LDA   1,Y   
E5B9   A8                     TAY      
E5BA   68                     PLA      
E5BB   20 D9 E5               JSR   prnum   
E5BE   4C 9E E5               JMP   er4   
E5C1   A0 17        ER5:      LDY   #M_RTN-MSG   
E5C3   20 DF E5               JSR   prs   ; CR LF "Rtn "
E5C6   AD 35 04               LDA   RSV   
E5C9   49 FF                  EOR   #0FFh   
E5CB   4A                     LSR      ; (FFh - S) / 2 entries
E5CC   20 D7 E5               JSR   prnum8   
E5CF   A0 09                  LDY   #M_NL-MSG   
E5D1   20 DF E5               JSR   prs   
E5D4   4C 09 FF               JMP   EXIT   
E5D7                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
E5D7                             ; prnum8: the same for A alone, 0-255.
E5D7   A0 00        PRNUM8:   LDY   #0   
