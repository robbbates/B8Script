   358                              <1> 
   359                              <1> ; ---- before the window: what its handlers jump to, within a short jump --
   360                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
   361                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
   362 000000DB 89F2                <1> upper:  mov     edx,esi
   363 000000DD 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
   364                              <1> 
   365                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
   366                              <1> ; return stack ends here, and the true ')' comes to rpoll.
   367                              <1> ;
   368                              <1> ; The break key is looked at here, so at every word call and loop-back (and
   369                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
   370 000000E5 83EF04              <1> rpush:  sub     edi,4
   371 000000E8 8917                <1>         mov     [edi],edx
   372 000000EA FE4D5B              <1> rpoll:  dec     byte [V(v_pcnt)]
   373 000000ED 7505                <1>         jnz     .rp1
