E309   16 00        UD1:      ASL   0,X   
E30B   36 01                  ROL   1,X   
E30D   36 FE                  ROL   0FEh,X   
E30F   36 FF                  ROL   0FFh,X   
E311   38                     SEC      
E312   B5 FE                  LDA   0FEh,X   
E314   E5 08                  SBC   D0   
E316   85 04                  STA   T0   
E318   B5 FF                  LDA   0FFh,X   
E31A   E5 09                  SBC   D1   
E31C   90 08                  BCC   ud2   
E31E   95 FF                  STA   0FFh,X   
E320   A5 04                  LDA   T0   
E322   95 FE                  STA   0FEh,X   
E324   F6 00                  INC   0,X   
E326   88           UD2:      DEY      
E327   D0 E0                  BNE   ud1   
E329   60                     RTS      
E32A                          IF   CHECKED   
                                 ; The checked build's inner loop, out of page 1, where it would not fit,
                                 ; and its break check (described with the unchecked one in page 1).
                                 ; pnext: the break check, then (falling through) next. A word call, a true
                                 ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
                                 ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
                                 ; falls in here too, which does no harm.)
                    PNEXT:    DEC   CDOWN   
                              BNE   next   
                              JSR   KEY   
                              BEQ   next   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              CMP   #3   
                              BNE   next   
                              JSR   ctlc   ; (it comes back only if the break key is off)
                    NEXT:        
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE (an
                                 ; underflow) or below DSFULL (an overflow). No handler moves X by
                                 ; more than 4, so X is caught before it wraps; an overrun by a cell
                                 ; or two writes on the scratch bytes below or above the stack.
                                 ; S is kept in RSV, for the report's Rtn line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_sund   
                              CPX   #DSFULL   
                              BCC   e_sovr   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
                              JSR   step   
                              JMP   next   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: Rtn 0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_SUND:   LDX   #DSE   ; Stk 0
                              LDA   #"s"   
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_SOVR:   LDA   #"S"   
                    EJMP:     JMP   error   
                                 ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
                                 ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
                                 ; which takes either. Meeting the wrong closer at this level, or the end
                                 ; (a NUL, or a string that runs into it), stops with N, except for \,
                                 ; which then ends the program as before.
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                              JMP   error   ;   or the end: the place is the opener
E32A                          ENDIF      
E32A                          IF   1-CHECKED   
E32A                CBREAK:   EQU   endp   ; the unchecked build stops without a word
E32A                          ENDIF      
E32A                          IF   CHECKED   
                    CBREAK:   EQU   e_break   ; the checked build reports B
E32A                          ENDIF      
E32A                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E32A                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E32A                             ; taken out of KEYBUF.
E32A   AD 7A 04     GETK:     LDA   KEYBUF   
E32D   F0 08                  BEQ   gk1   
E32F   48                     PHA      
E330   A9 00                  LDA   #0   
E332   8D 7A 04               STA   KEYBUF   
E335   68                     PLA      
E336   60                     RTS      
E337   20 06 FF     GK1:      JSR   KEY   
E33A   F0 04                  BEQ   gk9   
E33C   C9 03                  CMP   #3   
E33E   F0 01                  BEQ   ctlc   ; Ctrl-C: ctlc gives the 03h back, if at all
E340   60           GK9:      RTS      
E341                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E341                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E341                             ; looks: D0 counts the 256s, D1 runs on from whatever it holds) for one more
E341                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E341                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E341   AD 7B 04     CTLC:     LDA   BRKOFF   
E344   F0 5D                  BEQ   cbreak   
E346   A9 28                  LDA   #CWAIT+1   
E348   85 08                  STA   D0   
E34A   20 06 FF     CT2:      JSR   KEY   
E34D   D0 0A                  BNE   ct3   
E34F   C6 09                  DEC   D1   
E351   D0 F7                  BNE   ct2   
E353   C6 08                  DEC   D0   
E355   D0 F3                  BNE   ct2   
E357   F0 07                  BEQ   ct9   ; always: none came
E359   C9 03        CT3:      CMP   #3   
E35B   F0 46                  BEQ   cbreak   
E35D   8D 7A 04               STA   KEYBUF   
E360   A9 03        CT9:      LDA   #3   
E362   60                     RTS      
E363                          IF   CHECKED   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP2:    JMP   error   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; Rtn does not count the call
                              LDA   #"U"   
                              BNE   ejmp2   ; always
E363                          ENDIF      
E363                             ; step: read one character and sort it by range.
E363                             ;    00h          end of program
E363                             ;    01h-20h, 7Fh-FFh   ignored
E363                             ;    30h-39h      digit: read a whole number
E363                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E363                             ;    61h-7Ah      a-z: push the address of that letter's cell
E363                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E363   20 31 E4     STEP:     JSR   getc   ; flags follow A
E366   F0 3B                  BEQ   endp   
E368   38                     SEC      
E369   E9 21                  SBC   #21h   ; A = c - 21h
E36B   90 35                  BCC   ign   ; 01h-20h
E36D   C9 0F                  CMP   #0Fh   
E36F   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E371   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E373   C9 0A                  CMP   #10   
E375   90 6C                  BCC   digit   
E377   C9 11                  CMP   #11h   
E379   90 16                  BCC   p3a   ; 3Ah-40h
E37B   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E37D   C9 1A                  CMP   #1Ah   
E37F   90 25                  BCC   upper   ; 41h-5Ah
E381   C9 20                  CMP   #20h   
E383   90 0A                  BCC   p5b   ; 5Bh-60h
E385   C9 3A                  CMP   #3Ah   
E387   90 29                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E389   C9 3E                  CMP   #3Eh   
E38B                          IF   1-CHECKED   
E38B   B0 15                  BCS   ign   ; 7Fh-FFh
E38D                          ENDIF      
E38D                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E38D                          ENDIF      
E38D                             ; The three adjustments below chain. Each ADC adds the carry the one
E38D                             ; before it left, which the constants allow for.
E38D   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E38F   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E391   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E393                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E393                             ; the index is N1 or more, plus one more if it is N2 or more.
E393   C9 08        PUNCT:    CMP   #N1   
E395   A8                     TAY      
E396   A9 70                  LDA   #HALFPG   
E398   2A                     ROL      ; the first page, or the second (carry clear)
E399   C0 15                  CPY   #N2   
E39B   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E39D   48                     PHA      
E39E   B9 C3 E3               LDA   PTAB,Y   
E3A1   48                     PHA      
E3A2   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E3A3                             ; directly, it just ends an ignored character.
E3A3                ENDP:        ; the program has ended
E3A3                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E3A3                          ENDIF      
E3A3   4C 09 FF               JMP   EXIT   
E3A6                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E3A6                             ; the return stack, and the IP becomes the address in the letter's cell.
E3A6   0A           UPPER:    ASL      
E3A7   A8                     TAY      
E3A8   38                     SEC      
E3A9   4C C5 E0               JMP   pushn   
E3AC   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E3AE   A4 01                  LDY   IP+1   
E3B0   D0 03                  BNE   pushay   ; always: no program is in page zero
E3B2                             ; a-z: push the cell's address (the cell is the variable)
E3B2   0A           LOWER:    ASL      
E3B3   A0 04                  LDY   #>LET   
E3B5                             ; pushay: push a cell: A = its low byte, Y = its high byte
E3B5   CA           PUSHAY:   DEX      
E3B6   CA                     DEX      
E3B7   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E3B9   94 01                  STY   1,X   
E3BB   60                     RTS      
E3BC                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E3BC   E8           FLAG:     INX      
E3BD   E8                     INX      
E3BE   B5 FE                  LDA   0FEh,X   
E3C0   15 FF                  ORA   0FFh,X   
E3C2   60                     RTS      
E3C3                             ; =============================================================================
E3C3                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E3C3                             ;  character, in code order.
E3C3                             ; =============================================================================
E3C3   97           PTAB:     DB   (h_store-1) & 0FFh   ; !
E3C4   4F                     DB   (h_str-1) & 0FFh   ; "
E3C5   6B                     DB   (h_num-1) & 0FFh   ; #
E3C6   39                     DB   (h_print-1) & 0FFh   ; $
E3C7   A3                     DB   (h_swap-1) & 0FFh   ; %
E3C8   B4                     DB   (h_and-1) & 0FFh   ; &
E3C9   63                     DB   (h_emit-1) & 0FFh   ; '
E3CA   BF                     DB   (h_open-1) & 0FFh   ; (
E3CB   BA                     DB   (h_close-1) & 0FFh   ; )
E3CC   68                     DB   (h_mul-1) & 0FFh   ; *
E3CD   32                     DB   (h_add-1) & 0FFh   ; +
E3CE   B1                     DB   (h_cfetch-1) & 0FFh   ; ,
E3CF   29                     DB   (h_sub-1) & 0FFh   ; -
E3D0   20                     DB   (h_cstore-1) & 0FFh   ; .
E3D1   8E                     DB   (h_div-1) & 0FFh   ; /
E3D2   19                     DB   (h_dup-1) & 0FFh   ; :
E3D3   26                     DB   (drop-1) & 0FFh   ; ;
E3D4   47                     DB   (h_lt-1) & 0FFh   ; <
E3D5   58                     DB   (h_eq-1) & 0FFh   ; =
E3D6   44                     DB   (h_gt-1) & 0FFh   ; >
E3D7   C1                     DB   (h_key-1) & 0FFh   ; ?
E3D8   74                     DB   (h_fetch-1) & 0FFh   ; @
E3D9   8A                     DB   (h_def-1) & 0FFh   ; [
E3DA   1E                     DB   (h_break-1) & 0FFh   ; \
E3DB   30                     DB   (h_ret-1) & 0FFh   ; ]
E3DC   5E                     DB   (h_xor-1) & 0FFh   ; ^
E3DD   DA                     DB   (h_alloc-1) & 0FFh   ; _
E3DE   AC                     DB   (h_grave-1) & 0FFh   ; `
E3DF   42                     DB   (h_tor-1) & 0FFh   ; {
E3E0   69                     DB   (h_or-1) & 0FFh   ; |
E3E1   4E                     DB   (h_fromr-1) & 0FFh   ; }
E3E2   5B                     DB   (h_not-1) & 0FFh   ; ~
E3E3                             ; Digits: the first one is in A; read the rest of the number.
E3E3   A0 00        DIGIT:    LDY   #0   
E3E5   20 B5 E3               JSR   pushay   
E3E8                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E3E8                             ; Returns with the carry set.
E3E8   20 17 E4     RDNUM:    JSR   isdig   
E3EB   B0 4F                  BCS   ic9   ; (an RTS)
E3ED   20 34 E4               JSR   incip   ; (keeps A = the digit)
E3F0   16 00                  ASL   0,X   
E3F2   36 01                  ROL   1,X   ; x2
E3F4   18                     CLC      
E3F5   75 00                  ADC   0,X   
E3F7   85 04                  STA   T0   
E3F9   B5 01                  LDA   1,X   
E3FB   69 00                  ADC   #0   
E3FD   85 05                  STA   T1   ; T = x2 + digit
E3FF   16 00                  ASL   0,X   
E401   36 01                  ROL   1,X   
E403   16 00                  ASL   0,X   
E405   36 01                  ROL   1,X   ; x8
E407   18                     CLC      
E408   B5 00                  LDA   0,X   
E40A   65 04                  ADC   T0   
E40C   95 00                  STA   0,X   
E40E   B5 01                  LDA   1,X   
E410   65 05                  ADC   T1   
E412   95 01                  STA   1,X   ; x8 + x2 + digit
E414   4C E8 E3               JMP   rdnum   
E417                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E417                             ; digit. Y = 0.
E417   20 3D E4     ISDIG:    JSR   peek   
E41A   38                     SEC      
E41B   E9 30                  SBC   #"0"   
E41D   C9 0A                  CMP   #10   
E41F   60                     RTS      
E420                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E420                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E420   20 17 E4     RDHEX:    JSR   isdig   
E423   90 0F                  BCC   incip   
E425   29 DF                  AND   #0DFh   
E427   E9 11                  SBC   #11h   ; (the carry is set)
E429   C9 06                  CMP   #6   
E42B   B0 0F                  BCS   ic9   
E42D   69 0A                  ADC   #10   
E42F   D0 03                  BNE   incip   ; always
E431                             ; Reading the program
E431                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E431                             ;    getc: the same, then IP moves on; flags follow A
E431                             ;    incip: IP moves on; keeps A, the carry and Y
E431   20 3D E4     GETC:     JSR   peek   
E434   E6 00        INCIP:    INC   IP   
E436   D0 02                  BNE   ic1   
E438   E6 01                  INC   IP+1   
E43A   09 00        IC1:      ORA   #0   
E43C   60           IC9:      RTS      
E43D   A0 00        PEEK:     LDY   #0   
E43F   B1 00                  LDA   (IP),Y   
E441   60                     RTS      
E442                             ; rstip: point IP at the start of the program
E442   A9 00        RSTIP:    LDA   #<PROG   
E444   85 00                  STA   IP   
E446   A9 05                  LDA   #>PROG   
E448   85 01                  STA   IP+1   
E44A   60                     RTS      
E44B                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
                                 ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   Rtn n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was. With the stack full
                                 ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
                    ERROR:    PHA      ; the letter
                              LDA   PLACE   
                              STA   P   
                              LDA   PLACE+1   
                              STA   P+1   
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   D0   
                              LDY   D1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   T1   
                              LDY   T2   
                              JSR   prnum   ; the column
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              LDY   #0   ; the text at the place
                    ER1:      LDA   (P),Y   
                              BEQ   er2   
                              CMP   #13   
                              BEQ   er2   
                              CMP   #10   
                              BEQ   er2   
                              JSR   CONOUT   
                              INY      
                              CPY   #16   
                              BNE   er1   
                    ER2:      LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "Stk "
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   
                              LSR      ; the depth, (DSE - X) / 2
                              PHA      
                              LDY   #0   
                              JSR   prnum   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T1   ; T1 = how many cells to show
                              JSR   prs   
                    ER4:      LDA   T1   ; cells T1-1 down to 0, the top last: cell i
                              BEQ   er5   ;   from the top is at X+2i
                              DEC   T1   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   T1   
                              ASL      
                              STA   T2   
                              TXA      
                              ADC   T2   ; (the carry is clear)
                              TAY      
                              LDA   0,Y   
                              PHA      
                              LDA   1,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "Rtn "
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              LDY   #0   
                              JSR   prnum   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"Stk"," "+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"Rtn"," "+80h   
                                 ; lcol: the line (D0/D1) and the column (T1/T2) of the place at P, both from
                                 ; 1. A place below the program is in the -n? line buffer: line 0, and the
                                 ; column is the place in the buffer. Otherwise the LFs before the place are
                                 ; counted from PROG; T1/T2 holds the address before the line's first
                                 ; character (the last LF, or PROG - 1), and the column is P minus that.
                    LCOL:     LDY   #0   
                              STY   D1   
                              STY   D0   
                              LDA   #<LBM1   
                              STA   T1   
                              LDA   #>LBM1   
                              STA   T2   
                              LDA   P   
                              CMP   #<PROG   
                              LDA   P+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   D0   
                              LDA   #<PROGM1   
                              STA   Q   
                              STA   T1   
                              LDA   #>PROGM1   
                              STA   Q+1   
                              STA   T2   
                    LC1:      INC   Q   ; the next character
                              BNE   lc2   
                              INC   Q+1   
                    LC2:      LDA   Q   
                              CMP   P   
                              LDA   Q+1   
                              SBC   P+1   
                              BCS   lc9   ; at the place
                              LDA   (Q),Y   
                              CMP   #10   
                              BNE   lc1   
                              INC   D0   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   D1   
                    LC3:      LDA   Q   
                              STA   T1   
                              LDA   Q+1   
                              STA   T2   
                              BNE   lc1   ; always: no program is in page zero
                    LC9:      LDA   P   
                              SEC      
                              SBC   T1   
                              STA   T1   
                              LDA   P+1   
                              SBC   T2   
                              STA   T2   
                              RTS      
E44B                          ENDIF      


