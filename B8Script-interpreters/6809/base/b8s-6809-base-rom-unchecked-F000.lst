F226   26 F6                  BNE   skipstr   
F228   39                     RTS      
F229                          ENDIF      
F229   AE C4        H_CFETCH:   LDX   ,U   ; ","
F22B   4F                     CLRA      
F22C   E6 84        CF1:      LDB   ,X   
F22E   ED C4                  STD   ,U   
F230   39                     RTS      
F231                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F231                             ; drops it and carries on.
F231   EC C1        H_CLOSE:   LDD   ,U++   
F233   10 27 FF 63            LBEQ   rdrop   
F237   10 AE 62               LDY   2,S   ; the block start, under the return address
F23A   7E F0 CB               JMP   pollk   ; the break check, at every loop-back
F23D                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
F23D                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F23D                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F23D                             ; (base leaves out a cross term whose high byte is 0, which most
F23D                             ; multiplications have: a count or a small constant.)
F23D                          IF   1-QK   
                    H_MUL:    LDA   3,U   
                              LDB   ,U   
                              MUL      ; al*bh
                              STB   ,U   ; (bh is no longer needed)
                              LDA   2,U   
                              LDB   1,U   
                              MUL      ; ah*bl
                              ADDB   ,U   
                              STB   ,U   ; the cross terms, low byte
F23D                          ENDIF      
F23D                          IF   QK   
F23D   A6 43        H_MUL:    LDA   3,U   
F23F   E6 C4                  LDB   ,U   
F241   27 03                  BEQ   mu1   ; bh = 0: no al*bh (and ,U is 0 already)
F243   3D                     MUL      ; al*bh
F244   E7 C4                  STB   ,U   ; (bh is no longer needed)
F246   A6 42        MU1:      LDA   2,U   
F248   27 07                  BEQ   mu2   ; ah = 0: no ah*bl
F24A   E6 41                  LDB   1,U   
F24C   3D                     MUL      ; ah*bl
F24D   EB C4                  ADDB   ,U   
F24F   E7 C4                  STB   ,U   ; the cross terms, low byte
F251                MU2:         
F251                          ENDIF      
F251   A6 43                  LDA   3,U   
F253   E6 41                  LDB   1,U   
F255   3D                     MUL      ; al*bl
F256   AB C4                  ADDA   ,U   
F258   33 42                  LEAU   2,U   
F25A   ED C4                  STD   ,U   
F25C   39                     RTS      
F25D                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F25D   8D 18        H_GT:     BSR   h_swap   ; a > b is b < a
F25F   8D 10        H_LT:     BSR   cmp   
F261   2D 02                  BLT   true   
F263   5F           FALSE:    CLRB      
F264   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F265   C6 FF        TRUE:     LDB   #0FFh   
F267   1D                     SEX      ; D = 0000 or FFFF
F268   ED C4                  STD   ,U   
F26A   39                     RTS      
F26B   8D 04        H_EQ:     BSR   cmp   
F26D   27 F6                  BEQ   true   
F26F   20 F2                  BRA   false   
F271   EC 42        CMP:      LDD   2,U   
F273   10 A3 C1               CMPD   ,U++   
F276   39                     RTS      
F277                             ; ---- stack, and printing ----------------------------------------------------
F277   37 16        H_SWAP:   PULU   D,X   ; "%"
F279   36 06                  PSHU   D   
F27B   36 10                  PSHU   X   
F27D   39                     RTS      
F27E   EC C4        H_DUP:    LDD   ,U   ; ":"
F280   36 06                  PSHU   D   
F282   39                     RTS      
F283   A6 41        H_EMIT:   LDA   1,U   ; "'"
F285                          IF   1-CHECKED   
F285   8D 4C                  BSR   putc   
F287                          ENDIF      
F287                          IF   CHECKED   
                              JSR   CONOUT   ; (the checked build's report is in the way)
F287                          ENDIF      
F287   33 42        H_DROP:   LEAU   2,U   ; ";"
F289   39                     RTS      
F28A                             ; ---- more arithmetic ---------------------------------------------------------
F28A   EC C1        H_AND:    LDD   ,U++   
F28C   A4 C4                  ANDA   ,U   
F28E   E4 41                  ANDB   1,U   
F290   20 04                  BRA   st   
F292   EC C1        H_ADD:    LDD   ,U++   
F294   E3 C4                  ADDD   ,U   
F296   ED C4        ST:       STD   ,U   
F298   39                     RTS      
F299                             ; "-" has two jobs: directly before a digit it starts a negative number.
F299                             ; (The checked build has it in the tail, near negnum: its report would be
F299                             ; in the way here.)
F299                          IF   1-CHECKED   
F299   BD F0 A7     H_SUB:    JSR   isdig   
F29C   25 7D                  BLO   negnum   
F29E   EC 42                  LDD   2,U   
F2A0   A3 C1                  SUBD   ,U++   
F2A2   20 F2                  BRA   st   
F2A4                          ENDIF      
F2A4                             ; "!" ( n addr -- ) is "." with the high byte stored first. The cell in
F2A4                             ; memory is little-endian.
F2A4                             ; Checked: both bytes must be in the program's space, and they are tested
F2A4                             ; before either is stored (chkst stops with O, the stack untouched).
F2A4                          IF   1-CHECKED   
F2A4   37 10        H_STORE:   PULU   X   
F2A6   A6 C4                  LDA   ,U   
F2A8   A7 01                  STA   1,X   
F2AA                          ENDIF      
F2AA                          IF   CHECKED   
                    H_STORE:   LDX   ,U   
                              BSR   chkst   
                              LEAX   1,X   
                              BSR   chkst   
                              LDA   2,U   
                              STA   ,X   
                                 ; and fall into ".", which loads X again (and checks it again)
F2AA                          ENDIF      
F2AA                          IF   1-CHECKED   
F2AA   8C                     FCB   8Ch   ; (CMPX #: steps over the PULU)
F2AB   37 10        H_CSTORE:   PULU   X   ; "." ( c addr -- )
F2AD                          ENDIF      
F2AD                          IF   CHECKED   
                    H_CSTORE:   LDX   ,U   ; "." ( c addr -- )
                              BSR   chkst   
                              LEAU   2,U   
F2AD                          ENDIF      
F2AD   37 06                  PULU   D   
F2AF   E7 84                  STB   ,X   
F2B1   39                     RTS      
F2B2                          IF   CHECKED   
                                 ; ---- reached from a handler ------------------------------------------------
                                 ; chkst: stop with O unless X is in the program's own space: from the letter
                                 ; page up to HEAPLIM, so the interpreter's stacks and whatever lies above the
                                 ; limit are safe. Memory above the heap top but below the limit is the
                                 ; program's own: Tiny BASIC keeps its lines there. Keeps every register.
                    CHKST:    CMPX   #LET   
                              BLO   cs9   
                              CMPX   #HEAPLIM*256   
                              BHS   cs9   
                              RTS      ; in range
                    CS9:      LDA   #"O"   
                              FCB   8Ch   
                    E_ZERO:   LDA   #"Z"   ; / by zero
                              FCB   8Ch   
                    E_QUOTE:   LDA   #"Q"   ; " or $ ran into the NUL
                                 ; and fall into error. (H, W and N have their own entries, near
                                 ; their handlers, at ejmp.)
                                 ; =============================================================================
                                 ;  Checked build: the error report. A = the letter, AT = the place; U is
                                 ;  as the program left it, and SSAV holds S as the failing character began
                                 ;  (see "the error entries" after `upper`).
                                 ;  It sits here, ahead of h_num, pdec and putc, so that it reaches them with
                                 ;  short calls. Prints
                                 ; 
                                 ;     CR LF
                                 ;     Err X @ line,col CR LF
                                 ;     D:n:[ ...][ v]*  CR LF     (the top 8 cells, bottom to top, signed)
                                 ;     R:n CR LF
                                 ; 
                                 ;  and goes to EXIT. Line and column count from 1: the line is one more
                                 ;  than the LFs between PROG and the place, the column the distance from the
                                 ;  last LF (or from PROG-1). A place below PROG is in the -n? line buffer:
                                 ;  line 0, column = its offset there + 1. Numbers other than the cells are
                                 ;  printed unsigned (pdec), the cells signed (h_num).
                                 ; 
                                 ;  The data stack may be one cell past its limit (S, U = 8100h): the
                                 ;  report's own cells then reach 6 bytes further down, to 80FAh, into the
                                 ;  return stack page, so the report runs on a fresh return stack at RSREP
                                 ;  (80F0h), below those bytes.
                                 ; =============================================================================
                    ERROR:    LDS   #RSREP   
                              TFR   A,B   ; the letter (pmsg and CONOUT keep B)
                              BSR   pmsg   
                              FCB   13,10,"Err"," "+80h   
                              TFR   B,A   
                              JSR   CONOUT   
                              BSR   pmsg   
                              FCB   " @"," "+80h   
                                 ; the place: Y counts the lines, X walks, the cell at ,U holds the
                                 ; address of the last LF (PROG-1 to begin with)
                              LDY   #0   
                              LDX   #LINEBUF-1   
                              PSHU   X   
                              LDX   #PROG-1   
                              CMPX   <AT   
                              BHS   lc3   ; the place is below PROG: line 0
                              STX   ,U   
                    LC1:      LEAY   1,Y   ; a line
                    LC2:      LEAX   1,X   
                              CMPX   <AT   
                              BHS   lc3   
                              LDA   ,X   
                              CMPA   #10   
                              BNE   lc2   
                              STX   ,U   
                              BRA   lc1   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                                 ; (It sits here, in the middle of the report, where all its calls reach.)
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              JSR   putc   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
                    LC3:      LDD   <AT   
                              SUBD   ,U   
                              STD   ,U   ; the column
                              PSHU   Y   
                              BSR   pdec   ; the line
                              BSR   pmsg   
                              FCB   ","+80h   
                              BSR   pdec   ; the column
                              BSR   pmsg   
                              FCB   13,10,"D",":"+80h   
                                 ; the data stack: its depth, then its top 8 cells, from Y down to
                                 ; the program's top cell, at ,U.
                              PSHS   U   ; where the walk ends
                              LDD   #DSTOP   
                              SUBD   ,S   
                              BSR   pdh   ; the depth (pdec leaves U as it was)
                              BSR   pmsg   
                              FCB   ":"+80h   
                              LEAY   16,U   ; past the 8th cell from the top ...
                              CMPY   #DSTOP   
                              BHS   sl1   
                              BSR   pmsg   ; (there are more than 8)
                              FCB   " ..","."+80h   
                              BRA   sl2   
                    SL1:      LDY   #DSTOP   ; ... or the whole stack, if no more than 8
                    SL2:      CMPY   ,S   
                              BLS   sl9   
                              LDD   ,--Y   
                              PSHU   D   
                              BSR   pmsg   
                              FCB   " "+80h   
                              BSR   h_num   
                              BRA   sl2   
                    SL9:      BSR   pmsg   
                              FCB   13,10,"R",":"+80h   
                              LDD   #RSTOP   ; the return stack's depth, (RSTOP - S) / 2,
                              SUBD   <SSAV   ;   S as it was when this character began
                              BSR   pdh   
                              JSR   pmsg   
                              FCB   13,10+80h   
                              JMP   EXIT   
                                 ; pdh: print D/2 (a depth: D is twice it), unsigned.
                    PDH:      LSRA      
                              RORB      
                              PSHU   D   
                              BRA   pdec   
F2B2                          ENDIF      
F2B2                             ; "#" prints TOS as a signed decimal number, with no space after it.
F2B2   6D C4        H_NUM:    TST   ,U   
F2B4   2A 06                  BPL   pdec   
F2B6   86 2D                  LDA   #"-"   
F2B8   8D 19                  BSR   putc   
F2BA                          IF   CHECKED   
                              LBSR   negt   ; (long: the checked h_print is in between)
F2BA                          ENDIF      
F2BA                          IF   1-CHECKED   
F2BA   8D 62                  BSR   negt   
F2BC                          ENDIF      
F2BC                             ; pdec: print the top cell as unsigned and drop it, by recursion on /10
F2BC   CC 00 0A     PDEC:     LDD   #10   
F2BF   36 06                  PSHU   D   
F2C1                          IF   (1-CHECKED)*(1-QK)   
                              BSR   udiv   ; NOS = quotient, TOS = digit
F2C1                          ENDIF      
F2C1                          IF   CHECKED*(1-QK)   
                              LBSR   udiv   ; (out of a BSR's reach here)
F2C1                          ENDIF      
F2C1                          IF   SBASEU   
F2C1   8D 6A                  BSR   ud0   ; (base: past the power-of-two test)
F2C3                          ENDIF      
F2C3                          IF   QK-SBASEU   
                              LBSR   ud0   
F2C3                          ENDIF      
F2C3   37 06                  PULU   D   ; the digit
F2C5   34 04                  PSHS   B   
F2C7   EC C1                  LDD   ,U++   ; the quotient: if it is not 0, it goes
F2C9   27 04                  BEQ   pd1   ;   back for the rest of the digits
F2CB   36 06                  PSHU   D   
F2CD   8D ED                  BSR   pdec   
F2CF   35 02        PD1:      PULS   A   
F2D1   8B 30                  ADDA   #"0"   ; and fall into putc
F2D3   7E FF 03     PUTC:     JMP   CONOUT   
F2D6                             ; ---- the tail ---------------------------------------------------------------
F2D6                             ; "$" is the last handler, so what follows its first byte may lie past the
F2D6                             ; second range: its loop, the escapes, and the routines of "/".
F2D6                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
F2D6                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F2D6                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
F2D6                             ; it stops with Z, both operands still on the stack.
F2D6                H_DIV:       
F2D6                          IF   CHECKED   
                              LDD   ,U   
                              LBEQ   e_zero   
F2D6                          ENDIF      
F2D6   A6 42                  LDA   2,U   
F2D8   34 02                  PSHS   A   ; a's sign: for r
F2DA   A8 C4                  EORA   ,U   
F2DC   34 02                  PSHS   A   ; a xor b: for q
F2DE   30 42                  LEAX   2,U   
F2E0   8D 45                  BSR   absx   ; |a|
F2E2   1F 31                  TFR   U,X   
F2E4   8D 41                  BSR   absx   ; |b|
F2E6                          IF   1-QK   
                              BSR   udiv   ; NOS = q, TOS = r
F2E6                          ENDIF      
F2E6                          IF   QK   
F2E6   BD F3 C5               JSR   udiv   ; (base: with the speed-ups)
F2E9                          ENDIF      
F2E9   30 42                  LEAX   2,U   
F2EB   6D E0                  TST   ,S+   
F2ED   2A 02                  BPL   dv1   
F2EF   8D 2F                  BSR   negx   ; q's sign
F2F1   6D E0        DV1:      TST   ,S+   
F2F3   2A 31                  BPL   ng9   
F2F5   20 27                  BRA   negt   ; r's sign
F2F7                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
F2F7                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
F2F7                             ; clears that character"s bit 6 (/M is CR, "/" and DEL is "?"; "/", ""'
F2F7                             ; and "?" have no bit 6, so //, /" and /? give themselves). The address
F2F7                             ; comes off the stack first, and Y walks the string (the IP waits on S), so
F2F7                             ; that /~ finds its row and column on top, and an escape may use A, B, X
F2F7                             ; and the routines.
F2F7                             ; Checked: a NUL (not one escaped by "/") stops with Q, the string's
F2F7                             ; address put back on the stack (from PSAV) over what any /~ left.
F2F7   34 20        H_PRINT:   PSHS   Y   
F2F9   37 20                  PULU   Y   
F2FB                          IF   CHECKED   
                              CMPU   #DSTOP   ; "$" with nothing on the stack: s, before it
                              LBHI   e_ds   ;   prints from an address of no meaning (N
                              STY   <PSAV   ;   is clear: an underflow)
F2FB                          ENDIF      
F2FB   A6 A0        PR0:      LDA   ,Y+   
F2FD                          IF   CHECKED   
                              BEQ   prq   
F2FD                          ENDIF      
F2FD   81 22                  CMPA   #22h   
F2FF   27 18                  BEQ   pr9   
F301   81 2F                  CMPA   #"/"   
F303   26 10                  BNE   pr1   
F305   A6 A0                  LDA   ,Y+   
F307   80 60                  SUBA   #60h   ; ` 0, a-z 1-26, 00bbIDI3LCB8IDI4LCA= 29, ~ 30
F309   81 1F                  CMPA   #1Fh   
F30B   24 04                  BHS   pr2   
F30D   8D 39                  BSR   pesc   
F30F   20 EA                  BRA   pr0   
F311   8B 60        PR2:      ADDA   #60h   ; any other: bit 6 goes
F313   84 BF                  ANDA   #0BFh   
F315   8D BC        PR1:      BSR   putc   
F317   20 E2                  BRA   pr0   
F319   35 A0        PR9:      PULS   Y,PC   
F31B                          IF   CHECKED   
                    PRQ:      LDX   <PSAV   
                              PSHU   X   
                              JMP   e_quote   
F31B                          ENDIF      
F31B                             ; "-", checked build (see the unchecked one, before "!").
F31B                          IF   CHECKED   
                    H_SUB:    JSR   isdig   
                              BLO   negnum   
                              LDD   2,U   
                              SUBD   ,U++   
                              BRA   ud3   ; (STD ,U / RTS)
F31B                          ENDIF      
F31B   BD F0 AE     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F31E   1F 31        NEGT:     TFR   U,X   
F320   4F           NEGX:     CLRA      ; negx: negate the cell at X
F321   5F                     CLRB      
F322   A3 84                  SUBD   ,X   
F324   ED 84                  STD   ,X   
F326   39           NG9:      RTS      
F327   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F329   2A FB                  BPL   ng9   
F32B   20 F3                  BRA   negx   
F32D                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F32D                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F32D                             ; the TOS cell the remainder. The remainder is built in D (always < the
F32D                             ; divisor, so 2R+1 fits in 16 bits).
F32D                             ; Dividing by 2 is one shift (the spec wants that fast). (base divides
F32D                             ; by any power of two with shifts: its udiv is with the speed-ups, and
F32D                             ; comes to ud0 for the rest; pdec, whose divisor is 10, goes straight there.)
F32D                          IF   1-QK   
                    UDIV:     LDD   ,U   
                              SUBD   #2   
                              BNE   ud0   
                              LSR   2,U   
                              ROR   3,U   ; the quotient
                              ROLB      ; the remainder: the bit that fell out (D was 0)
                              BRA   ud3   
F32D                          ENDIF      
F32D                          IF   1-FAST   
F32D   8E 00 10     UD0:      LDX   #16   
F330   4F                     CLRA      
F331   5F                     CLRB      
F332   68 43        UD1:      ASL   3,U   
F334   69 42                  ROL   2,U   ; the dividend's top bit ...
F336   59                     ROLB      
F337   49                     ROLA      ; ... into the remainder
F338   10 A3 C4               CMPD   ,U   
F33B   25 04                  BLO   ud2   
F33D   A3 C4                  SUBD   ,U   
F33F   6C 43                  INC   3,U   ; a quotient bit
F341   30 1F        UD2:      LEAX   -1,X   
F343   26 ED                  BNE   ud1   
F345                          ENDIF      ; (the fast build's is unrolled: see the end)
F345   ED C4        UD3:      STD   ,U   
F347   39                     RTS      
F348                             ; pesc: the escapes of "$". A = the character after the "/", minus 60h
F348                             ; (0 to 30); Y points past it. Each returns to the loop with an RTS, its
F348                             ; own or that of the routine it ends by jumping to. A, B and X are free.
F348                             ;    /a-/z   print the variable, as "#" does
F348                             ;    /{      clear the screen, the cursor to the top left
F348                             ;    /}      clear from the cursor to the end of the line
F348                             ;    /|  /`  show the cursor, hide it
F348                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
F348   81 1B        PESC:     CMPA   #27   
F34A   24 0F                  BHS   pcon   
F34C   48                     ASLA      ; (` leaves A = 0: hide)
F34D   27 18                  BEQ   phide   
F34F   8E 82 3E               LDX   #LET+40h-2   ; the variable's cell (little-endian)
F352   EC 86                  LDD   A,X   
F354   1E 89                  EXG   A,B   
F356   36 06                  PSHU   D   
F358   7E F2 B2               JMP   h_num   
F35B                          IF   1-ANSI   
F35B   10 27 0B AD  PCON:     LBEQ   CONCLS   ; /{
F35F   81 1D                  CMPA   #29   
F361   10 27 0B AA            LBEQ   CONEOL   ; /}
F365   22 03                  BHI   pat   
F367   7E FF 12     PHIDE:    JMP   CONCUR   ; /|  (A = 28: show), /`  (A = 0: hide)
F36A                          ENDIF      
F36A                PAT:         
F36A                          IF   CHECKED   
                                 ; /~ checks first that there are a row and a column (with less it
                                 ; is s, and the stack counts as empty): U is never let past the
                                 ; top of the stack, however many /~ there are.
                              CMPU   #DSTOP-4   
                              LBHI   e_ds   ; (N is clear: an underflow)
F36A                          ENDIF      
F36A                          IF   1-ANSI   
F36A   37 16                  PULU   D,X   ; /~  D = the column, X = the row
F36C   7E FF 15               JMP   CONAT   
F36F                          ENDIF      
F36F                          IF   ANSI   
                                 ; /~  ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              PULU   D,X   ; D = the column, X = the row
                              ADDD   #1   
                              LEAX   1,X   
                              PSHU   D   
                              PSHU   X   
                              BSR   csi   
                              JSR   pdec   
                              BSR   pm   
                              FCB   ";"+80h   
                              JSR   pdec   
                              BSR   pm   
                              FCB   "H"+80h   
                              RTS      
                    PCON:     BEQ   pcls   ; /{
                              CMPA   #29   
                              BEQ   peol   ; /}
                              BHI   pat   
                              BSR   pcsi   ; /|  ESC [ ? 2 5 h
                              FCB   "?25","h"+80h   
                              RTS      
                    PHIDE:    BSR   pcsi   ; /`  ESC [ ? 2 5 l
                              FCB   "?25","l"+80h   
                              RTS      
                    PCLS:     BSR   pcsi   ; /{  ESC [ H ESC [ J
                              FCB   "H"+80h   
                              BSR   pcsi   
                              FCB   "J"+80h   
                              RTS      
                    PEOL:     BSR   pcsi   ; /}  ESC [ K
                              FCB   "K"+80h   
                              RTS      
                                 ; pcsi: ESC [ and then the text after the call, as pmsg. csi: ESC [.
                    CSI:      BSR   pm   
                              FCB   27,"["+80h   
                              RTS      
                    PCSI:     BSR   csi   
F36F                          ENDIF      
F36F                          IF   ANSI*(1-CHECKED)   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                                 ; (The checked build has its own, with the report: pm leads to it.)
                    PM:          
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              JSR   CONOUT   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
F36F                          ENDIF      
F36F                          IF   ANSI*CHECKED   
                    PM:       JMP   pmsg   
F36F                          ENDIF      
F36F                          IF   QK   
F36F                             ; =============================================================================
F36F                             ;  Speed-ups (base, and the fast build)
F36F                             ; 
F36F                             ;  The rest of them are with their handlers: "*" (h_mul), the unchecked
F36F                             ;  a-z (lower), pdec (straight to the long divide) and the startup, which
F36F                             ;  empties the skip cache. (A true ")" already reads the block start where
F36F                             ;  it is, in every build, so there is nothing to gain there.)
F36F                             ; =============================================================================
F36F                             ; skip, with the skip cache. Nearly every skip is one that has happened
F36F                             ; before (a loop skips the same false block on every pass), so the end of
F36F                             ; each scan is remembered: 64 entries of 00bbc3RhcnQsIGVuZA== (big-endian), in the
F36F                             ; page CPAGE, found by the start's low byte times 4. Only skips that start
F36F                             ; in the program text hit (the line buffer changes); the cache is emptied
F36F                             ; whenever a run starts. A program that changes its own text while it runs
F36F                             ; is not looked after. A hit returns as the scan would: Y past the closer,
F36F                             ; and A = 0 for ")" or 2 for "]".
F36F   1F 20        SKIP:     TFR   Y,D   ; the start: the cache's key
F371   58                     ASLB      
F372   58                     ASLB      
F373   8E EF 00               LDX   #CPAGE*256   
F376   3A                     ABX      ; X -> the entry
F377   10 AC 84               CMPY   ,X   
F37A   26 0F                  BNE   sks   
F37C   10 8C 83 00            CMPY   #PROG   
F380   25 09                  BLO   sks   ; below the program text: never a hit
F382   10 AE 02               LDY   2,X   ; a hit: the IP is past the closer,
F385   A6 3F                  LDA   -1,Y   ;   ")" (29h) or "]" (5Dh): 0 or 2
F387   44                     LSRA      
F388   84 02                  ANDA   #2   
F38A   39                     RTS      
F38B                             ; The scan, which fills the entry (X is kept throughout). A scan that fails
F38B                             ; ends the program, so an entry is never left half written for a later run
F38B                             ; to find. Two range tests rule most characters out: ^ and up, and * to Z.
F38B                             ; Only NUL " ( ) [ ] count. B counts the open levels.
F38B   10 AF 84     SKS:      STY   ,X   ; the key
F38E   C6 FF                  LDB   #0FFh   
F390   5C           SQ3:      INCB      ; an opener: one deeper
F391   A6 A0        SQ1:      LDA   ,Y+   
F393   81 5E                  CMPA   #5Eh   
F395   24 FA                  BHS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
F397   81 5B                  CMPA   #5Bh   
F399   24 19                  BHS   sqb   ; [ \ ]
F39B   81 2A                  CMPA   #2Ah   
F39D   24 F2                  BHS   sq1   ; * to Z: nothing
F39F   81 28                  CMPA   #28h   
F3A1   27 ED                  BEQ   sq3   ; (
F3A3   22 18                  BHI   sqc   ; )
F3A5   81 22                  CMPA   #22h   
F3A7   27 06                  BEQ   sqq   ; a string
F3A9   4D                     TSTA      
F3AA   26 E5                  BNE   sq1   ; the rest below "(": nothing
F3AC                          ENDIF      
F3AC                          IF   QK*(1-CHECKED)   
F3AC   7E F0 9D               JMP   fin   ; NUL: the end of the program
F3AF   BD F2 1E     SQQ:      JSR   skipstr   ; step over the string
F3B2   20 DD                  BRA   sq1   
F3B4                          ENDIF      
F3B4                          IF   QK*CHECKED   
                              DECA      ; NUL: A = FFh, and the caller decides
                              RTS      
                    SQQ:      JSR   skipstr   ; step over the string; A = FFh with the
                              BCC   sq1   ;   carry set if it ran into the NUL
                              RTS      
F3B4                          ENDIF      
F3B4                          IF   QK   
F3B4   80 5C        SQB:      SUBA   #5Ch   ; [ -1, \ 0, ] 1
F3B6   27 D9                  BEQ   sq1   ; "\" is nothing here
F3B8   25 D6                  BLO   sq3   ; [
F3BA   86 02                  LDA   #2   ; ]
F3BC   21                     FCB   21h   ; (BRN: steps over the CLRA)
F3BD   4F           SQC:      CLRA      ; )
F3BE   5A                     DECB      
F3BF   2A D0                  BPL   sq1   
F3C1   10 AF 02               STY   2,X   ; the closer at this level: the entry's end
F3C4   39                     RTS      
F3C5                             ; base: a power of two, 2^k, is a shift: q = a >> k and r = a AND (2^k - 1).
F3C5                             ; That is 2, and 256 for a high byte, and the 32 or 64 of fixed point.
F3C5   EC C4        UDIV:     LDD   ,U   
F3C7   27 33                  BEQ   uqx   ; by 0: the long way (it means nothing anyway)
F3C9   83 00 01               SUBD   #1   
F3CC   1F 01                  TFR   D,X   ; X = d - 1
F3CE   A4 C4                  ANDA   ,U   
F3D0   26 2A                  BNE   uqx   
F3D2   E4 41                  ANDB   1,U   
F3D4   26 26                  BNE   uqx   ; not a power of two
F3D6   1F 10                  TFR   X,D   
F3D8   A4 42                  ANDA   2,U   
F3DA   E4 43                  ANDB   3,U   
F3DC   34 06                  PSHS   D   ; r
F3DE   6D 41                  TST   1,U   
F3E0   26 09                  BNE   uq0   ; d < 256
F3E2   A6 C4                  LDA   ,U   ; 256 and up: d and a move a byte down
F3E4   A7 41                  STA   1,U   ;   (the low byte of d is all the loop
F3E6   E6 42                  LDB   2,U   ;   looks at)
F3E8   4F                     CLRA      
F3E9   20 02                  BRA   uq1   
F3EB   EC 42        UQ0:      LDD   2,U   
F3ED   64 41        UQ1:      LSR   1,U   ; a moves down until d's one bit falls out
F3EF   25 04                  BCS   uq2   
F3F1   44                     LSRA      
F3F2   56                     RORB      
F3F3   20 F8                  BRA   uq1   
F3F5   ED 42        UQ2:      STD   2,U   ; q
F3F7   35 06                  PULS   D   
F3F9   ED C4                  STD   ,U   
F3FB   39                     RTS      
F3FC   7E F3 2D     UQX:      JMP   ud0   ; (three short branches to one jump are
F3FF                             ;  3 bytes less than three long ones)
F3FF                          ENDIF      
F3FF                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table of 256 handler addresses, FTAB, one for every
                                 ;  byte, and the dispatcher (NEXTF, at the top) is inline at the end of each
                                 ;  of the fast build's own entries, so there is no return to a loop:
                                 ; 
                                 ;      LDB ,Y+ / LDX #FTAB / ABX / ABX / JMP [,X]
                                 ; 
                                 ;  (21 cycles; the checked build calls fchk first, which checks the stacks
                                 ;  and keeps the place, as the ordinary inner loop does.) The entries are
                                 ;  jumped to, not called, so nothing of the dispatcher's is on the return
                                 ;  stack while they run. The letters and digits have one entry each, which
                                 ;  knows its cell or its value already; the commonest punctuation has its
                                 ;  own; the rest are thunks, JSR to the ordinary handler, which returns
                                 ;  with its RTS as it would to the ordinary dispatcher.
                                 ; =============================================================================
F3FF                          ENDIF      
F3FF                          IF   FAST*CHECKED   
                                 ; fchk: the checks of the inner loop, for the checked fast build (S is 2
                                 ; lower in here than when the character starts).
                    FCHK:     LEAX   (0-DSLIM)&0FFFFh,U   
                              CMPX   #DSTOP-DSLIM   
                              LBHI   e_ds   
                              LEAX   (2-RSLIM)&0FFFFh,S   
                              CMPX   #RSTOP-RSLIM   
                              LBHI   e_rs   
                              STY   <AT   ; the place, should this character fail
                              LEAX   2,S   
                              STX   <SSAV   ; and the return stack, as it is then
                              RTS      
                    FOPF:     EQU   opf   ; (a false "(": the checked skip)
                    FSTORE:   EQU   ft_store   ; ("!" and "." are checked: the thunks)
                    FCSTORE:   EQU   ft_cstore   
                    FHIGH:    EQU   fhi   ; (80h-FFh: X)
                    FHI:      JMP   e_resv   ; 80h-FFh: reserved
F3FF                          ENDIF      
F3FF                          IF   FAST*(1-CHECKED)   
                    FOPF:     EQU   skip   
                    FSTORE:   EQU   fs_store   
                    FCSTORE:   EQU   fs_cstore   
                    FHIGH:    EQU   fign   ; (80h-FFh are ignored)
F3FF                          ENDIF      
F3FF                          IF   FAST   
                              ;*Macro unroll: fnext:  NEXTF                   ; the startup comes here
                    FNEXT:    DS   CHECKED,0BDh   ; the startup comes here
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FNUL:     JMP   EXIT   ; NUL: the end of the program
                              ;*Macro unroll: fign:   NEXTF                   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
                    FIGN:     DS   CHECKED,0BDh   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                                 ; The thunks: the ordinary handler, then the dispatcher.
                    FT_STORE:   JSR   h_store   ; !
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_STR:   JSR   h_str   ; "
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_NUM:   JSR   h_num   ; #
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_PRINT:   JSR   h_print   ; $
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_EMIT:   JSR   h_emit   ; '
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_CSTORE:   JSR   h_cstore   ; .
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_DIV:   JSR   h_div   ; /
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_KEY:   JSR   h_key   ; ?
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_DEF:   JSR   h_def   ; [
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_BREAK:   JSR   h_break   ; \
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_ALLOC:   JSR   h_alloc   ; _
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_GRAVE:   JSR   h_grave   ; `
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_TOR:   JSR   h_tor   ; {
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_FROMR:   JSR   h_fromr   ; }
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                                 ; The commonest punctuation, written for the fast build.
                    FS_ADD:   PULU   D   ; +
                              ADDD   ,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_SUB:   LDA   ,Y   ; -  (a digit next: a negative number)
                              SUBA   #"0"   
                              CMPA   #10   
                              BLO   fsb1   
                              LDD   2,U   
                              SUBD   ,U++   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FSB1:     JSR   negnum   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_DUP:   LDD   ,U   ; :
                              PSHU   D   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_DROP:   LEAU   2,U   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_SWAP:   LDD   ,U   ; %
                              LDX   2,U   
                              STD   2,U   
                              STX   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_FET:   LDX   ,U   ; @  (the cell in memory is little-endian)
                              LDB   ,X   
                              LDA   1,X   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_CFET:   LDX   ,U   ; ,
                              LDB   ,X   
                              CLRA      
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_LT:    PULU   X   ; <  (X = b: b - a)
                              CMPX   ,U   
                              BGT   flt1   
                              LDD   #0   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FLT1:     LDD   #0FFFFh   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_EQ:    PULU   X   ; =  (X = b: b - a)
                              CMPX   ,U   
                              BEQ   feq1   
                              LDD   #0   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FEQ1:     LDD   #0FFFFh   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_GT:    PULU   X   ; >  (X = b: b - a)
                              CMPX   ,U   
                              BLT   fgt1   
                              LDD   #0   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FGT1:     LDD   #0FFFFh   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_AND:   PULU   D   ; &
                              ANDA   ,U   
                              ANDB   1,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_OR:    PULU   D   ; |
                              ORA   ,U   
                              ORB   1,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_XOR:   PULU   D   ; ^
                              EORA   ,U   
                              EORB   1,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_NOT:   COM   ,U   ; ~
                              COM   1,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_MUL:   LDA   3,U   ; *  (as base's h_mul)
                              LDB   ,U   
                              BEQ   fmu1   
                              MUL      ; al*bh
                              STB   ,U   
                    FMU1:     LDA   2,U   
                              BEQ   fmu2   
                              LDB   1,U   
                              MUL      ; ah*bl
                              ADDB   ,U   
                              STB   ,U   
                    FMU2:     LDA   3,U   
                              LDB   1,U   
                              MUL      ; al*bl
                              ADDA   ,U   
                              LEAU   2,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_OPEN:   LDD   ,U++   ; (
                              BEQ   fop0   
                              PSHS   Y   ; true: the block starts at the IP
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FOP0:     JSR   FOPF   ; false: skip to the ")"
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_CLOSE:   LDD   ,U++   ; )
                              BEQ   fcl0   
                              LDY   ,S   ; true: back to the block start, read where
                              DEC   <COUNT   ;   it is; and the break check, 1 look in 256
                              BNE   fcl1   
                              JSR   pk1   
                              ;*Macro unroll: fcl1:   NEXTF
                    FCL1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FCL0:     LEAS   2,S   ; false: drop the block start
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_RET:   PULS   Y   ; ]
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
F3FF                          ENDIF      
F3FF                          IF   FAST*(1-CHECKED)   
                    FS_STORE:   PULU   X   ; !  ( n addr -- ), little-endian
                              PULU   D   
                              STB   ,X   
                              STA   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_CSTORE:   PULU   X   ; .
                              PULU   D   
                              STB   ,X   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
F3FF                          ENDIF      
F3FF                          IF   FAST   
                                 ; The digits: each pushes its value, and goes on to fdm for more digits.
                    FD0:      LDD   #0   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd0n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd0n:   NEXTF
                    FD0N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD1:      LDD   #1   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd1n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd1n:   NEXTF
                    FD1N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
