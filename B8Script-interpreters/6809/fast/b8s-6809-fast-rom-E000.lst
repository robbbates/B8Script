E540   A5                     DS   CHECKED,ACHK&0FFh   
E541   E6 A0                  LDB   ,Y+   
E543   8E EE A1               LDX   #FTAB   
E546   3A                     ABX      
E547   3A                     ABX      
E548   6E 94                  JMP   [,X]   
E54A   BD E1 9D     FT_KEY:   JSR   h_key   ; ?
