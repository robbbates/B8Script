  1272 000004E6 8D453B              <1>         lea     eax,[V(v_rec)]
  1273 000004E9 50                  <1>         push    eax
  1274 000004EA FF7553              <1>         push    dword [V(v_hin)]
  1275 000004ED FF55A1              <1>         call    [V(iat_ReadFile)]
  1276 000004F0 837D4F00            <1>         cmp     dword [V(v_cnt)],0
