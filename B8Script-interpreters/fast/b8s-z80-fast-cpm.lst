0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    QUICK    1 = the speed-ups that cost bytes: a skip cache, a faster skip,
0000                             ;                 "*" and "/" quicker for small and power-of-two operands, and
0000                             ;                 more (see "Speed-ups"). 0, the default, is the smallest build.
0000                             ;    FAST     1 = the speed build: QUICK and a dispatch table besides, with
0000                             ;                 no size limit (see "The speed build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                QUICK:    EQU   0   ; 1 = the speed-ups that cost bytes (see "Speed-ups")
0000                FAST:     EQU   1   ; 1 = the speed build (not with EDITOR): see "The speed build"
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   QUICK+FAST-QUICK*FAST   ; (the speed-ups: QUICK, or the speed build)
0000                QUICKU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the speed build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
0000                EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC and
                                 ; IY, and all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
                                 ;   at the heap limit, which the heap never reaches
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
                    PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
                    ACHK:     EQU   chkstk   ; (for the speed build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
0000                DTPG:     EQU   DTAB/256   ; (the speed build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
                    DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (speed build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (speed build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 15               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM*(1-EDITOR)   
0103   C3 8E 06               JP   start   ; 03
0106                          ENDIF      
0106                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0106                          ENDIF      
0106                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0106                          ENDIF      
0106                          IF   1-CPM   
                                 ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
                    RPOP:     LD   E,(IY+0)   ; 08
                              LD   D,(IY+1)   
                              JR   rp2   ; (the rest is at 2Bh)
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
                              JR   NZ,next0   ;     the rest are ignored
                    ENDPROG:   JP   EXIT   ;     the program has ended
                              NOP      ; 17  spare
                                 ; ---- RST 18h: drop TOS, then next ------------------------------------------
                    RST18:    POP   DE   ; 18  discard the RST's return address
                    DRP:      POP   HL   ;     new TOS = NOS
                              JR   next0   
0106                          ENDIF      
0106   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
0107                          ;*Macro unroll:  POPR
0107                          DS   1-CPM,0CFh   
0107   CD                     DS   CPM,0CDh   
0108   5E                     DS   CPM,AROP&0FFh   
0109   06                     DS   CPM,AROP/256   
010A   EB                     EX   DE,HL   
010B                          ;*Macro unroll:  NEXTZ
010B                          DS   1-CPM,0F7h   
010B   DD                     DS   CPM,0DDh   
010C   E9                     DS   CPM,0E9h   
010D                          IF   1-CPM   
                                 ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
                    NEG16:    XOR   A   ; 20
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
                              NOP      ; 27  spare
                                 ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
                    RST28:       
                    PUTC:     JP   CONOUT   ; 28
                    RP2:      INC   IY   ; 2B  the rest of rpop
                              INC   IY   
                              RET      
                                 ; ---- RST 30h: next character -----------------------------------------------
                    RST30:    POP   DE   ; 30  discard the RST's return address
010D                          ENDIF      
010D                          IF   CPM   
010D                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
010D   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
010F   20 03                  JR   NZ,next0   ; the rest are ignored
0111   C3 00 00     ENDPROG:   JP   EXIT   ; the program has ended
0114                          ENDIF      
0114                             ; =============================================================================
0114                             ;  The inner loop: read one character and sort it by range.
0114                             ; 
0114                             ;    00h          end of program
0114                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0114                             ;    30h-39h      digit: read a whole number
0114                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0114                             ;    61h-7Ah      a-z: push the address of that letter's cell
0114                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0114                             ; =============================================================================
0114                          IF   FAST   
0114                          ;*Macro unroll: next0:  NEXTF                   ; (the speed build: the table dispatcher)
0114                NEXT0:    DS   FAST*CHECKED,0CDh   ; (the speed build: the table dispatcher)
0114                          DS   FAST*CHECKED,ACHK&0FFh   
0114                          DS   FAST*CHECKED,ACHK/256   
0114   0A                     DS   FAST,0Ah   
0115   03                     DS   FAST,03h   
0116   EB                     DS   FAST,0EBh   
0117   6F                     DS   FAST,6Fh   
0118   26                     DS   FAST,26h   
0119   11                     DS   FAST,DTPG   
011A   7E                     DS   FAST,7Eh   
011B   24                     DS   FAST,24h   
011C   66                     DS   FAST,66h   
011D   6F                     DS   FAST,6Fh   
011E   E9                     DS   FAST,0E9h   
011F                          ENDIF      
011F                          IF   1-FAST   
                    NEXT0:       
011F                          ENDIF      
011F                          IF   CHECKED*(1-FAST)   
                              CALL   chkstk   ; both stacks are checked once per character
011F                          ENDIF      
011F                          IF   1-FAST   
                              LD   A,(BC)   
                              INC   BC   
                              SUB   21h   ; A = c - 21h
                              JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
                              CP   0Fh   
                              JR   C,punct   ; 21h-2Fh: PTAB index 0-14
                              SUB   0Fh   ; A = c - 30h
                              CP   0Ah   
                              JR   C,digit   ; 30h-39h
                              CP   11h   
                              JR   C,p3a   ; 3Ah-40h
                              SUB   11h   ; A = c - 41h
                              CP   1Ah   
                              JR   C,upper   ; 41h-5Ah: A = letter index 0-25
                              CP   20h   
                              JR   C,p5b   ; 5Bh-60h
                              CP   3Ah   
                              JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
                              CP   3Eh   
011F                          ENDIF      
011F                          IF   (1-CHECKED)*(1-FAST)   
                              JR   NC,next0   ; 7Fh-FFh: ignored
011F                          ENDIF      
011F                          IF   CHECKED*(1-FAST)   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
011F                          ENDIF      
011F                          IF   1-FAST   
                              SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
                    P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
                    P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
011F                          ENDIF      
011F                .macro PTABLE,
011F                             ; 
011F                 DB      h_store & 0FFh  ; !
011F                 DB      h_str & 0FFh    ; "
011F                 DB      h_num & 0FFh    ; #
011F                 DB      h_print & 0FFh  ; $
011F                 DB      h_swap & 0FFh   ; %
011F                 DB      h_and & 0FFh    ; &
011F                 DB      h_emit & 0FFh   ; '
011F                 DB      h_open & 0FFh   ; (
011F                 DB      h_close & 0FFh  ; )
011F                 DB      h_mul & 0FFh    ; *
011F                 DB      h_add & 0FFh    ; +
011F                 DB      h_cfetch & 0FFh ; ,
011F                 DB      h_sub & 0FFh    ; -
011F                 DB      h_cstore & 0FFh ; .
011F                 DB      h_div & 0FFh    ; /
011F                 DB      h_dup & 0FFh    ; :
011F                 DB      h_drop & 0FFh   ; ;
011F                 DB      h_lt & 0FFh     ; <
011F                 DB      h_eq & 0FFh     ; =
011F                 DB      h_gt & 0FFh     ; >
011F                 DB      h_key & 0FFh    ; ?
011F                 DB      h_fetch & 0FFh  ; @
011F                 DB      h_def & 0FFh    ; [
011F                 DB      h_break & 0FFh  ; \
011F                 DB      h_ret & 0FFh    ; ]
011F                 DB      h_xor & 0FFh    ; ^
011F                 DB      h_alloc & 0FFh  ; _
011F                 DB      h_grave & 0FFh  ; `
011F                 DB      h_tor & 0FFh    ; {
011F                 DB      h_or & 0FFh     ; |
011F                 DB      h_fromr & 0FFh  ; }
011F                 DB      h_not & 0FFh    ; ~
011F                .endm
011F                 
011F                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
011F                             ; untouched, and A, DE free.
011F                          IF   1-FAST   
                    PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
                              LD   E,A   
                              LD   D,PTAB / 256   ; (0 if the table is in page zero)
                              CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
                              LD   A,(DE)   
                              LD   E,A   ; the handler's low byte
011F                          ENDIF      
011F                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
                              LD   D,0   
011F                          ENDIF      
011F                          IF   (1-CPM)*(1-FAST)   
                              RL   D   ; its page: 0 + carry
011F                          ENDIF      
011F                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
011F                          ENDIF      
011F                          IF   1-FAST   
                              PUSH   DE   ; jump to it; the stack is balanced again
                              RET      ;   when the handler starts
011F                          ENDIF      
011F                             ; The rest of the startup: here so that the generic reset code can reach it
011F                             ; with JR. st0: find the program's NUL; the heap starts after it.
011F                             ; (The editor build has its own copy of this, next to the editor.)
011F                             ; A checked build first clears the lower half of the letter page (A = 0):
011F                             ; every variable starts at 0, every word cell holds 0000h, the address an
011F                             ; undefined word is caught at (see e_hi), and no key is held back.
011F                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
011F                          ENDIF      
011F                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
011F                          ENDIF      
011F                          IF   1-EDITOR   
011F   22 7C 16     ST2:      LD   (HEAP),HL   
0122                          ENDIF      
0122                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0122                          ENDIF      
0122                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0122                          ENDIF      ;   these)
0122                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
0122   21 00 00               LD   HL,0   
0125                          ENDIF      
0125                          IF   (1-CHECKED)*(1-EDITOR)   
0125   22 7A 16               LD   (KEYBUF),HL   
0128                          ENDIF      
0128                          IF   1-EDITOR   
0128                          ;*Macro unroll:  SETIX
0128   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0129   21                     DS   CPM+FAST-CPM*FAST,21h   
012A   14                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
012B   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
012C   FD 21 E0 14            LD   IY,RSTOP   ; the return stack is empty
0130                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0130                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0130   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0131   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0132                          ENDIF      
0132                             ; In the unchecked generic editor build the table is here, in the first
0132                             ; page, which saves loading D twice. (The other builds have no room for it
0132                             ; here: theirs is further down.)
0132                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0132                          ENDIF      
0132                             ; =============================================================================
0132                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0132                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0132                             ;  is here too: it belongs to "`" and makes the page come out right.
0132                             ; =============================================================================
0132   D1           H_XOR:    POP   DE   
0133   7C                     LD   A,H   
0134   AA                     XOR   D   
0135   67                     LD   H,A   
0136   7D                     LD   A,L   
0137   AB                     XOR   E   
0138   6F                     LD   L,A   
0139                          ;*Macro unroll:  NEXT
0139                          DS   (1-CPM)*(1-FAST),0F7h   
0139   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
013A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
013B   D1           H_OR:     POP   DE   
013C   7C                     LD   A,H   
013D   B2                     OR   D   
013E   67                     LD   H,A   
013F   7D                     LD   A,L   
0140   B3                     OR   E   
0141   6F                     LD   L,A   
0142                          ;*Macro unroll:  NEXT
0142                          DS   (1-CPM)*(1-FAST),0F7h   
0142   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0143   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0144                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0144                H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0144   CD                     DS   CPM,0CDh   
0145   69                     DS   CPM,ANEG&0FFh   
0146   06                     DS   CPM,ANEG/256   
0147   2B                     DEC   HL   
0148                          ;*Macro unroll:  NEXT
0148                          DS   (1-CPM)*(1-FAST),0F7h   
0148   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0149   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
014A                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
014A                             ; the same either way); TOS is the old pointer.
014A   ED 5B 7C 16  H_ALLOC:   LD   DE,(HEAP)   
014E                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
014E                          ENDIF      
014E   19                     ADD   HL,DE   ; the new top
014F                          IF   CHECKED   
                              CALL   chkhp   
014F                          ENDIF      
014F   22 7C 16               LD   (HEAP),HL   
0152   EB                     EX   DE,HL   
0153                          ;*Macro unroll:  NEXT
0153                          DS   (1-CPM)*(1-FAST),0F7h   
0153   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0154   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0155                          IF   1-CPM*CHECKED   
0155   FD 22 34 16  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
0159   CD 98 01               CALL   jphl   
015C   FD 2A 34 16            LD   IY,(RSAVE)   
0160                          ;*Macro unroll:  SETIX
0160   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0161   21                     DS   CPM+FAST-CPM*FAST,21h   
0162   14                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0163   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0164   E1                     POP   HL   
0165                          ;*Macro unroll:  NEXT
0165                          DS   (1-CPM)*(1-FAST),0F7h   
0165   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0166   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0167                          ENDIF      
0167                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
0167                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
0167                             ; Digits: step back onto the first digit and read the whole number.
0167   E5           DIGIT:    PUSH   HL   
0168   0B                     DEC   BC   
0169   CD 60 04               CALL   rdnum   
016C                          ;*Macro unroll:  NEXT
016C                          DS   (1-CPM)*(1-FAST),0F7h   
016C   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
016D   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
016E                             ; a-z: push the cell's address (the cell is the variable)
016E                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
016E                          IF   1-QUICKU   
016E   E5           LOWER:    PUSH   HL   
016F   87                     ADD   A,A   
0170   6F                     LD   L,A   
0171   26 16                  LD   H,LETPAGE   
0173                          ;*Macro unroll:  NEXT
0173                          DS   (1-CPM)*(1-FAST),0F7h   
0173   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0174   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0175                          ENDIF      
0175                          IF   QUICKU   
                    LOWER:    JP   lowq   
0175                          ENDIF      
0175                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0175                             ; the return stack, and the IP becomes the address in the letter's cell.
0175   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
0176   EB                     EX   DE,HL   ; park TOS
0177   87                     ADD   A,A   
0178   6F                     LD   L,A   
0179   26 16                  LD   H,LETPAGE   ; HL -> cell
017B   4E                     LD   C,(HL)   
017C   2C                     INC   L   
017D   46                     LD   B,(HL)   ; IP = the word's body
017E   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
017F                             ; rpushn: move the top cell of the data stack (in memory) to the return
017F                             ; stack, then next. Everything that pushes the return stack ends here.
017F                             ; 
017F                             ; The break key is looked at here, so at every word call and loop-back (and
017F                             ; block entry and "{"), but only one time in 256: PCNT counts them.
017F                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
017F   D1           RPUSHN:   POP   DE   
0180   FD 72 FF               LD   (IY-1),D   
0183   FD 73 FE               LD   (IY-2),E   
0186   FD 2B                  DEC   IY   
0188   FD 2B                  DEC   IY   
018A   E5                     PUSH   HL   
018B   21 36 16               LD   HL,PCNT   
018E   35                     DEC   (HL)   
018F   E1                     POP   HL   ; (the zero flag lasts)
0190   CC 20 06               CALL   Z,pollk   
0193                          ;*Macro unroll:  NEXT
0193                          DS   (1-CPM)*(1-FAST),0F7h   
0193   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0194   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0195                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
0195   E3           H_TOR:    EX   (SP),HL   
0196   18 E7                  JR   rpushn   
0198   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
0199                             ; ---- machine code: the grave -----------------------------------------------
0199                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
0199                             ; are stored from addr until a non-hex character; then a RET (C9h) is
0199                             ; written and its address is left. An odd last digit is consumed and dropped.
0199                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
0199                             ; code is entered by CALL with the data stack above the return address; it
0199                             ; must keep BC, and on return the top cell becomes the new TOS.
0199   CD C4 05     H_GRAVE:   CALL   hexc   
019C                          IF   1-CPM*CHECKED   
019C   30 B7                  JR   NC,exec   
019E                          ENDIF      
019E                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
019E                          ENDIF      
019E   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
019F   CD C4 05               CALL   hexc   
01A2   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01A4   ED 6F                  RLD      ;   overwrites it
01A6   23                     INC   HL   ; ... and RLD shifts it up under the low one
01A7   CD C4 05               CALL   hexc   
01AA   38 F2                  JR   C,hx1   
01AC   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01AE                          ;*Macro unroll:  NEXT
01AE                          DS   (1-CPM)*(1-FAST),0F7h   
01AE   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01AF   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01B0                             ; ---- where the two pages meet ----------------------------------------------
01B0                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01B0                             ; are in falling code order for this), and where exactly differs between the
01B0                             ; builds: NPG1 follows. Every handler below these four must start in the
01B0                             ; second page, and every one above in the first; chktab.py checks both.
01B0                             ; "]" returns: pop an address and jump to it.
01B0                          ;*Macro unroll: h_ret:  POPR
01B0                H_RET:    DS   1-CPM,0CFh   
01B0   CD                     DS   CPM,0CDh   
01B1   5E                     DS   CPM,AROP&0FFh   
01B2   06                     DS   CPM,AROP/256   
01B3   42                     LD   B,D   
01B4   4B                     LD   C,E   
01B5                          ;*Macro unroll: brk1:   NEXT
01B5                BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
01B5   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01B6   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01B7                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01B7                             ; drops the block start, "]" returns. No closer at all ends the program.
01B7   7C           H_BREAK:   LD   A,H   
01B8   B5                     OR   L   
01B9   E1                     POP   HL   
01BA   28 F9                  JR   Z,brk1   
01BC   CD 82 04               CALL   skip   
01BF   B7                     OR   A   ; skip returns 0 for ")"
01C0   20 EE                  JR   NZ,h_ret   
01C2                          ;*Macro unroll: rdrop:  POPR
01C2                RDROP:    DS   1-CPM,0CFh   
01C2   CD                     DS   CPM,0CDh   
01C3   5E                     DS   CPM,AROP&0FFh   
01C4   06                     DS   CPM,AROP/256   
01C5                          ;*Macro unroll:  NEXT
01C5                          DS   (1-CPM)*(1-FAST),0F7h   
01C5   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01C6   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01C7                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01C7                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01C7                             ; the body"s address instead. Either way it then skips to the matching "]'.
01C7                             ; (The unchecked build takes anything that is not a letter as the space; the
01C7                             ; checked build stops on it.)
01C7   0A           H_DEF:    LD   A,(BC)   
01C8   03                     INC   BC   
01C9   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01CB   5F                     LD   E,A   ;   lands 64 bytes up
01CC   E6 DF                  AND   0DFh   ; fold case
01CE   FE 1A                  CP   26   
01D0   30 0B                  JR   NC,def2   ; not a letter
01D2   CB 23                  SLA   E   
01D4   16 16                  LD   D,LETPAGE   ; DE -> cell
01D6   79                     LD   A,C   
01D7   12                     LD   (DE),A   
01D8   1C                     INC   E   
01D9   78                     LD   A,B   
01DA   12                     LD   (DE),A   
01DB   18 03                  JR   skipnx   
01DD                DEF2:        
01DD                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
01DD                          ENDIF      
01DD   E5                     PUSH   HL   ; an anonymous block: push its address
01DE   60                     LD   H,B   
01DF   69                     LD   L,C   
01E0                SKIPNX:      
01E0                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
01E0                          ENDIF      ;   opener, the "[", just before where it starts
01E0   CD 82 04     SKIPO:    CALL   skip   
01E3                          ;*Macro unroll:  NEXT
01E3                          DS   (1-CPM)*(1-FAST),0F7h   
01E3   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01E4   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01E5   5E           H_FETCH:   LD   E,(HL)   ; "@"
01E6   23                     INC   HL   
01E7   56                     LD   D,(HL)   
01E8   EB                     EX   DE,HL   
01E9                          ;*Macro unroll:  NEXT
01E9                          DS   (1-CPM)*(1-FAST),0F7h   
01E9   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01EA   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01EB                             ; =============================================================================
01EB                             ;  Handlers that must start in the image's second page.
01EB                             ;  "?" is the last (with "," inside it), so its long tail may run past that
01EB                             ;  page.
01EB                             ; =============================================================================
01EB                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
01EB                             ; the matching ")".
01EB   7C           H_OPEN:   LD   A,H   
01EC   B5                     OR   L   
01ED   E1                     POP   HL   
01EE   28 F0                  JR   Z,skipo   
01F0   C5                     PUSH   BC   ; the block starts at the IP
01F1   18 8C                  JR   rpushn   
01F3                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
01F3                             ; drops it and carries on.
01F3   7C           H_CLOSE:   LD   A,H   
01F4   B5                     OR   L   
01F5   E1                     POP   HL   
01F6   28 CA                  JR   Z,rdrop   
01F8                          IF   QK   
01F8   C3 B3 05               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
01FB                          ENDIF      
01FB                          IF   1-QK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
01FB                          ENDIF      
01FB                          IF   (1-QK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
01FB                          ENDIF      
01FB                          IF   (1-QK)*CPM   
                              JP   rpushn   
01FB                          ENDIF      
01FB                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
01FB                             ; "-" has two jobs: directly before a digit it starts a negative number.
01FB   0A           H_SUB:    LD   A,(BC)   
01FC   D6 30                  SUB   "0"   
01FE   FE 0A                  CP   10   
0200   38 07                  JR   C,negnum   
0202                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0202                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0202   CD                     DS   CPM,0CDh   
0203   69                     DS   CPM,ANEG&0FFh   
0204   06                     DS   CPM,ANEG/256   
0205   D1           H_ADD:    POP   DE   
0206   19                     ADD   HL,DE   
0207                          ;*Macro unroll:  NEXT
0207                          DS   (1-CPM)*(1-FAST),0F7h   
0207   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0208   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0209   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
020A   CD 60 04               CALL   rdnum   
020D                          ;*Macro unroll:  NEGH
020D                          DS   1-CPM,0E7h   
020D   CD                     DS   CPM,0CDh   
020E   69                     DS   CPM,ANEG&0FFh   
020F   06                     DS   CPM,ANEG/256   
0210                          ;*Macro unroll:  NEXT
0210                          DS   (1-CPM)*(1-FAST),0F7h   
0210   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0211   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0212   D1           H_AND:    POP   DE   
0213   7C                     LD   A,H   
0214   A2                     AND   D   
0215   67                     LD   H,A   
0216   7D                     LD   A,L   
0217   A3                     AND   E   
0218   6F                     LD   L,A   
0219                          ;*Macro unroll:  NEXT
0219                          DS   (1-CPM)*(1-FAST),0F7h   
0219   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
021A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
021B                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
021B                             ; cells first. Flipping both sign bits turns a signed compare into an
021B                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
021B                             ; carry into -1 or 0 with no branch.
021B   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
021C   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
021D   7C                     LD   A,H   
021E   EE 80                  XOR   80h   
0220   67                     LD   H,A   
0221   7A                     LD   A,D   
0222   EE 80                  XOR   80h   
0224   57                     LD   D,A   
0225   ED 52                  SBC   HL,DE   ; carry if HL < DE
0227   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0229                          ;*Macro unroll:  NEXT
0229                          DS   (1-CPM)*(1-FAST),0F7h   
0229   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
022A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
022B   D1           H_EQ:     POP   DE   
022C   B7                     OR   A   
022D   ED 52                  SBC   HL,DE   
022F   7C                     LD   A,H   
0230   B5                     OR   L   
0231   FE 01                  CP   1   ; carry only if a - b = 0
0233   18 F2                  JR   tf   
0235                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0235                             ; multiplier shifts up through A:C.
0235                          IF   1-QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0235                          ENDIF      
0235                          IF   QK   
0235   D1           H_MUL:    POP   DE   ; DE = multiplicand
0236   C3 03 05               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0239                          ENDIF      
0239                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0239                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0239                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0239                             ; stops on it.
0239                H_DIV:       
0239                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0239                          ENDIF      
0239   D1                     POP   DE   ; DE = a, HL = b
023A   D5                     PUSH   DE   ; a, for r's sign
023B   7A                     LD   A,D   
023C   AC                     XOR   H   
023D   F5                     PUSH   AF   ; S flag = sign of q
023E   CB 7C                  BIT   7,H   
0240   C4 69 06               CALL   NZ,neg16   ; HL = |b|
0243   EB                     EX   DE,HL   
0244   CB 7C                  BIT   7,H   
0246   C4 69 06               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0249   CD 5B 03               CALL   udiv   ; HL = q, DE = r
024C   F1                     POP   AF   
024D   FC 69 06               CALL   M,neg16   ; q's sign
0250   EB                     EX   DE,HL   ; HL = r, DE = q
0251   F1                     POP   AF   ; A = a's high byte
0252   B7                     OR   A   
0253   FC 69 06               CALL   M,neg16   ; r's sign
0256   D5                     PUSH   DE   ; q under r
0257                          ;*Macro unroll:  NEXT
0257                          DS   (1-CPM)*(1-FAST),0F7h   
0257   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0258   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0259                             ; ---- stack and storage -----------------------------------------------------
0259   E5           H_DUP:    PUSH   HL   ; ":"
025A                          ;*Macro unroll:  NEXT
025A                          DS   (1-CPM)*(1-FAST),0F7h   
025A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
025B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
025C   E3           H_SWAP:   EX   (SP),HL   ; "%"
025D                          ;*Macro unroll:  NEXT
025D                          DS   (1-CPM)*(1-FAST),0F7h   
025D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
025E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
025F                             ; (The checked build tests the address before it takes the value off the
025F                             ; stack, so that an error report shows both.)
025F                H_CSTORE:      ; "." ( c addr -- )
025F                          IF   CHECKED   
                              CALL   chkst   
025F                          ENDIF      
025F   D1                     POP   DE   
0260   73                     LD   (HL),E   
0261                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
0261                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
0261   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0262   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0263   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0264                H_STORE:      ; "!" ( n addr -- )
0264                          IF   CHECKED   
                              CALL   chkst   
0264                          ENDIF      
0264   D1                     POP   DE   
0265   73                     LD   (HL),E   
0266   23                     INC   HL   
0267   72                     LD   (HL),D   
0268                          ;*Macro unroll:  DROP
0268                          DS   (1-CPM)*(1-FAST),0DFh   
0268   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0269   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
026A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
026B                             ; ---- console ---------------------------------------------------------------
026B                             ; 22h pushes the address of the text after it and skips the string.
026B   E5           H_STR:    PUSH   HL   
026C   60                     LD   H,B   
026D   69                     LD   L,C   
026E   CD 77 04               CALL   skipstr   
0271                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
0271                          ENDIF      
0271                          ;*Macro unroll:  NEXT
0271                          DS   (1-CPM)*(1-FAST),0F7h   
0271   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0272   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0273                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
0273                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
0273                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
0273                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
0273                          IF   1-CHECKED   
0273   7E           H_PRINT:   LD   A,(HL)   
0274   23                     INC   HL   
0275   FE 22                  CP   22h   
0277   28 19                  JR   Z,pr9   
0279   FE 2F                  CP   "/"   
027B   20 0C                  JR   NZ,pr1   
027D   7E                     LD   A,(HL)   
027E   23                     INC   HL   
027F   FE 60                  CP   60h   
0281   38 04                  JR   C,pr0   
0283   FE 7F                  CP   7Fh   
0285   38 63                  JR   C,pesc   
0287   E6 BF        PR0:      AND   0BFh   
0289                          ;*Macro unroll: pr1:    PUTA
0289                PR1:      DS   1-CPM,0EFh   
0289   CD                     DS   CPM,0CDh   
028A   78                     DS   CPM,APUT&0FFh   
028B   06                     DS   CPM,APUT/256   
028C   18 E5                  JR   h_print   
028E                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
028E                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
028E                          ENDIF      
028E                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM+FAST-CPM*FAST,0E1h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
028E                          ENDIF      
028E   7D           H_EMIT:   LD   A,L   ; "'"
028F                          ;*Macro unroll:  PUTA
028F                          DS   1-CPM,0EFh   
028F   CD                     DS   CPM,0CDh   
0290   78                     DS   CPM,APUT&0FFh   
0291   06                     DS   CPM,APUT/256   
0292                          ;*Macro unroll: pr9:    DROP
0292                PR9:      DS   (1-CPM)*(1-FAST),0DFh   
0292   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0293   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0294   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0295                             ; "#" prints TOS as a signed decimal number, with no space after it.
0295   CD D6 05     H_NUM:    CALL   psgn   
0298                          ;*Macro unroll:  DROP
0298                          DS   (1-CPM)*(1-FAST),0DFh   
0298   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0299   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
029A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
029B                             ; "?" ( n -- c ) or ( -n -- addr )
029B                             ;   n > 0: wait about n ms for a key; 0 if none came
029B                             ;   n = 0: wait for a key
029B                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
029B                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
029B   CB 7C        H_KEY:    BIT   7,H   
029D   20 1A                  JR   NZ,line   
029F   1E 04        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02A1   CD 4E 06     KT2:      CALL   getk   
02A4   20 0E                  JR   NZ,kt3   
02A6   1D                     DEC   E   
02A7   20 F8                  JR   NZ,kt2   
02A9   7C                     LD   A,H   ; 0? never counts down: it waits
02AA   B5                     OR   L   
02AB   28 F2                  JR   Z,kt1   
02AD   2B                     DEC   HL   
02AE   7C                     LD   A,H   
02AF   B5                     OR   L   
02B0   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02B2   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02B3   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02B4   6F           KT3:      LD   L,A   
02B5   26 00                  LD   H,0   
02B7                          ;*Macro unroll:  NEXT
02B7                          DS   (1-CPM)*(1-FAST),0F7h   
02B7   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02B8   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02B9                             ; Backspace takes the last character back (and is echoed as it
02B9                             ; is), CR ends (stored, not echoed), every other key is stored and
02B9                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02B9                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02B9                             ; is the place in the line: D holds the L of a full line.
02B9   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02BC   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02BD   9F                     SBC   A,A   
02BE   A5                     AND   L   ; (0 for a count that is too big)
02BF   2F                     CPL      
02C0   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
02C1                             ;   at most
02C1   21 80 16               LD   HL,LINEBUF   
02C4   CD 4E 06     LN2:      CALL   getk   
02C7   28 FB                  JR   Z,ln2   
02C9   FE 0D                  CP   13   
02CB   28 18                  JR   Z,ln5   
02CD   FE 08                  CP   8   
02CF   28 0D                  JR   Z,ln4   
02D1   5F                     LD   E,A   
02D2   7D                     LD   A,L   
02D3   BA                     CP   D   
02D4   28 EE                  JR   Z,ln2   ; full
02D6   73                     LD   (HL),E   
02D7   2C                     INC   L   
02D8   7B                     LD   A,E   
02D9                          ;*Macro unroll: ln3:    PUTA
02D9                LN3:      DS   1-CPM,0EFh   
02D9   CD                     DS   CPM,0CDh   
02DA   78                     DS   CPM,APUT&0FFh   
02DB   06                     DS   CPM,APUT/256   
02DC   18 E6                  JR   ln2   
02DE   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
02DF   FA D9 02               JP   M,ln3   ;   unless the line was empty (L left the
02E2   2C                     INC   L   ;   upper half of the page)
02E3   18 DF                  JR   ln2   
02E5   77           LN5:      LD   (HL),A   ; the CR
02E6   2E 80                  LD   L,LINEBUF & 0FFh   
02E8                          ;*Macro unroll:  NEXT
02E8                          DS   (1-CPM)*(1-FAST),0F7h   
02E8   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02E9   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02EA                             ; =============================================================================
02EA                             ;  More routines (no handler starts past this point)
02EA                             ; =============================================================================
02EA                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
                              DB   13,10,22h   ;   the caller's text)
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
02EA                          ENDIF      
02EA                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
02EA                             ; HL points past it. Each goes back into the loop that prints the string
02EA                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
02EA                             ;    /a-/z   print the variable, as "#" does
02EA                             ;    /{      clear the screen, the cursor to the top left
02EA                             ;    /}      clear from the cursor to the end of the line
02EA                             ;    /|  /`  show the cursor, hide it
02EA                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
02EA   FE 7E        PESC:     CP   7Eh   
02EC   28 1C                  JR   Z,pat   
02EE   11 73 02               LD   DE,PRLOOP   ; the others return into the loop
02F1   D5                     PUSH   DE   
02F2   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
02F4   30 45                  JR   NC,pcon   
02F6   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
02F8   30 2E                  JR   NC,phide   
02FA   87                     ADD   A,A   ; the variable's cell
02FB   C6 40                  ADD   A,40h   
02FD   E5                     PUSH   HL   
02FE   6F                     LD   L,A   
02FF   26 16                  LD   H,LETPAGE   
0301   7E                     LD   A,(HL)   
0302   2C                     INC   L   
0303   66                     LD   H,(HL)   
0304   6F                     LD   L,A   
0305   CD D6 05               CALL   psgn   
0308   E1                     POP   HL   
0309   C9                     RET      
030A                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
030A                             ; the checked build "$" is the routine prstr: its own return address goes
030A                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
030A                             ; its two cells are there, and is s if not, before it prints anything.
030A                PAT:         
030A                          IF   CHECKED   
                              EX   (SP),HL   ; the text pointer over prstr's return address
                              LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              ADD   HL,SP   
                              JP   C,e_under   
                              POP   HL   
030A                          ENDIF      
030A   D1                     POP   DE   ; DE = the column
030B   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
030C                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
030C                          ENDIF      
030C                          IF   ANS   
030C   D5                     PUSH   DE   
030D   CD 50 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0310   23                     INC   HL   
0311   CD E1 05               CALL   pdec   
0314                          ;*Macro unroll:  PUTK    3Bh             ; ';'
0314                          DS   1-CPM,3Eh   ; ";"
0314                          DS   1-CPM,3Bh   
0314                          DS   1-CPM,0EFh   
0314   CD                     DS   CPM,0CDh   
0315   74                     DS   CPM,APTK&0FFh   
0316   06                     DS   CPM,APTK/256   
0317   3B                     DS   CPM,3Bh   
0318   E1                     POP   HL   
0319   23                     INC   HL   
031A   CD E1 05               CALL   pdec   
031D                          ;*Macro unroll:  PUTK    48h             ; 'H'
031D                          DS   1-CPM,3Eh   ; "H"
031D                          DS   1-CPM,48h   
031D                          DS   1-CPM,0EFh   
031D   CD                     DS   CPM,0CDh   
031E   74                     DS   CPM,APTK&0FFh   
031F   06                     DS   CPM,APTK/256   
0320   48                     DS   CPM,48h   
0321   E1                     POP   HL   
0322   C3 73 02               JP   PRAGAIN   
0325                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0325   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0327   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0328   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
032A                          ENDIF      
032A                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
032A                          ENDIF      
032A                          IF   ANS*(1-CHECKED)   
032A   3E 3F                  LD   A,"?"   
032C   CD 4A 03               CALL   csia   
032F                          ;*Macro unroll:  PUTK    32h             ; '2'
032F                          DS   1-CPM,3Eh   ; "2"
032F                          DS   1-CPM,32h   
032F                          DS   1-CPM,0EFh   
032F   CD                     DS   CPM,0CDh   
0330   74                     DS   CPM,APTK&0FFh   
0331   06                     DS   CPM,APTK/256   
0332   32                     DS   CPM,32h   
0333                          ;*Macro unroll:  PUTK    35h             ; '5'
0333                          DS   1-CPM,3Eh   ; "5"
0333                          DS   1-CPM,35h   
0333                          DS   1-CPM,0EFh   
0333   CD                     DS   CPM,0CDh   
0334   74                     DS   CPM,APTK&0FFh   
0335   06                     DS   CPM,APTK/256   
0336   35                     DS   CPM,35h   
0337   7B                     LD   A,E   
0338                          ;*Macro unroll:  PUTAR
0338                          DS   1-CPM,0EFh   
0338                          DS   1-CPM,0C9h   
0338   C3                     DS   CPM,0C3h   
0339   78                     DS   CPM,APUT&0FFh   
033A   06                     DS   CPM,APUT/256   
033B                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
033B   3D           PCON:     DEC   A   
033C   28 E7                  JR   Z,pshow   ; /|
033E   3E 4B                  LD   A,"K"   
0340   F2 4A 03               JP   P,csia   ; /}  ESC [ K
0343   3E 48                  LD   A,"H"   ; /{  ESC [ H ESC [ J
0345   CD 4A 03               CALL   csia   
0348   3E 4A                  LD   A,"J"   ; (on into csia)
