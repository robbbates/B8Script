                              JMP   sknul   
E3BE                          ENDIF      
E3BE                          IF   QK   
E3BE   E6 01        SQW:      INC   IP+1   ; Y went round: on into the next page
E3C0   D0 DF                  BNE   sq2   ; always
E3C2   20 F6 E3     SQQ:      JSR   sqip   ; a string: step over it
E3C5   20 63 E0               JSR   skipstr   
E3C8                          ENDIF      
E3C8                          IF   QK*CHECKED   
                              BNE   sqq1   
                              JMP   sknul   ; the string ran into the end
                    SQQ1:        
E3C8                          ENDIF      
