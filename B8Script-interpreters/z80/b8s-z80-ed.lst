0149   67                     LD   H,A   
014A   7A                     LD   A,D   
014B   EE 80                  XOR   80h   
014D   57                     LD   D,A   
014E   ED 52                  SBC   HL,DE   ; carry if HL < DE
0150   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0152   F7                     RST   30h   
0153   D1           H_EQ:     POP   DE   
0154   B7                     OR   A   
0155   ED 52                  SBC   HL,DE   
