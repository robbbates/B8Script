0505   2D                     DEC   L   
0506   77                     LD   (HL),A   
0507   2C                     INC   L   
0508   7D                     LD   A,L   
0509   BB                     CP   E   
050A   20 F7                  JR   NZ,bs1   
050C   2D                     DEC   L   
050D   36 20                  LD   (HL)," "   
050F   E1                     POP   HL   
0510   53                     LD   D,E   
0511   1D                     DEC   E   
0512   18 15                  JR   ic2   
0514                             ; A character goes in at the cursor: it ripples up through the rest of the
0514                             ; line, the cursor moves on, and the rest is printed again.
0514   47           INSC:     LD   B,A   
0515   7B                     LD   A,E   
0516   FE FD                  CP   0FDh   
