01DB   7C                     LD   A,H   
01DC   B5                     OR   L   
01DD   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01DF   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01E0   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01E1   6F           KT3:      LD   L,A   
01E2   26 00                  LD   H,0   
01E4   F7                     RST   30h   
01E5                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     XOR   A   
                              SUB   L   ; A = the count (TOS is minus the count)
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
