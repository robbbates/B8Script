   924 000002D5 49                  <1> .sk4:   dec     ecx
   925 000002D6 75DB                <1>         jnz     .sk1
   926                              <1> %if CHECKED
   927                              <1>         xor     ah,al                   ; the closer at this level: 0 or 2. Bit
   928                              <1>         and     ah,6                    ;   1 of the opener is 0 for '(' and 1
   929                              <1>         cmp     ah,2                    ;   for '[', and only the backslash has
   930                              <1>         je      .sk7                    ;   bit 2: so this is 2 for the wrong
   931                              <1>                                         ;   closer, and only then
   932                              <1>         ret
   933                              <1> .sk6:   test    ah,4                    ; the text ran out:
   934                              <1>         jnz     SKEND                   ;   '\' with no closer ends the program
   935                              <1> .sk7:   mov     esi,[V(v_skat)]         ; N. The place is the opener
   936                              <1>         mov     al,'N'
