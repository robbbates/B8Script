E543   A0 09                  LDY   #M_NL-MSG   
E545   20 C1 E5               JSR   prs   
E548   A0 00                  LDY   #0   ; the text at the place
E54A   B1 02        ER1:      LDA   (P),Y   
E54C   F0 10                  BEQ   er2   
E54E   C9 0D                  CMP   #13   
E550   F0 0C                  BEQ   er2   
E552   C9 0A                  CMP   #10   
E554   F0 08                  BEQ   er2   
E556   20 03 FF               JSR   CONOUT   
E559   C8                     INY      
E55A   C0 10                  CPY   #16   
E55C   D0 EC                  BNE   er1   
E55E   A0 0B        ER2:      LDY   #M_STK-MSG   
E560   20 C1 E5               JSR   prs   ; CR LF "Stk "
E563   8A                     TXA      
E564   49 FF                  EOR   #0FFh   
E566   38                     SEC      
E567   E9 0F                  SBC   #0FFh-DSE   
E569   4A                     LSR      ; the depth, (DSE - X) / 2
E56A   48                     PHA      
E56B   A0 00                  LDY   #0   
E56D   20 BB E5               JSR   prnum   
E570   68                     PLA      
E571   A0 16                  LDY   #M_C-MSG   ; ":"
E573   C9 09                  CMP   #9   
E575   90 04                  BCC   er3   
