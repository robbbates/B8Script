   537                              <1> ; ---- machine code: the grave -----------------------------------------------
   538                              <1> ; '`' plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
   539                              <1> ; are stored from addr until a non-hex character; then a RET (C3h) is
   540                              <1> ; written and its address is left. An odd last digit is consumed and its
   541                              <1> ; byte is overwritten by the RET. (Never range-checked: the spec says so.)
   542                              <1> ; '`' plus anything else calls the machine code at TOS: ( addr -- ).
   543                              <1> ;
   544                              <1> ; The machine-code contract: the code is entered by CALL, with the return
   545                              <1> ; address at [ESP] and the data stack above it: [ESP+4] is the top cell
   546                              <1> ; (the one under the address, which was consumed), [ESP+8] the next, one
   547                              <1> ; dword per cell, the cell in the low word. EBX holds the code's own
   548                              <1> ; address (ARENA + addr), and its high word is the arena's (0041h): a
   549                              <1> ; B8Script address a is the byte at ARENA + a. The code may push and pop
   550                              <1> ; dwords, and may change EAX, EBX, ECX, EDX and the flags; it must keep
   551                              <1> ; ESI, EDI and EBP, leave the direction flag clear, and return with RET
   552                              <1> ; (C3h, which the loader writes). On return the dword on top of the stack
   553                              <1> ; becomes TOS. Only the low word of each cell counts: the interpreter puts
   554                              <1> ; the arena's high word back into every cell on the stack.
   555 000001E4 E8B5000000          <1> grave1: call    hexc
   556 000001E9 731B                <1>         jnc     .ex
   557 000001EB 8803                <1> .hx1:   mov     [ebx],al                ; the high digit goes in first ...
   558 000001ED E8AC000000          <1>         call    hexc
   559 000001F2 730D                <1>         jnc     .hx2                    ; odd digit: consumed, and the RET
   560 000001F4 C02304              <1>         shl     byte [ebx],4            ;   overwrites it
   561 000001F7 0803                <1>         or      [ebx],al                ; ... and the low one joins it
   562 000001F9 43                  <1>         inc     ebx
   563 000001FA E89F000000          <1>         call    hexc
   564 000001FF 72EA                <1>         jc      .hx1
   565 00000201 C603C3              <1> .hx2:   mov     byte [ebx],0C3h
   566 00000204 FFE5                <1>         jmp     ebp
   567 00000206 FFD3                <1> .ex:    call    ebx
   568 00000208 89E0                <1>         mov     eax,esp                 ; (the stack holds one cell at least,
   569 0000020A 66C740024100        <1> .ex1:   mov     word [eax+2],ARENA>>16  ;   the one that stands for TOS)
   570 00000210 83C004              <1>         add     eax,4
   571 00000213 3B455B              <1>         cmp     eax,[V(v_dstop)]
   572 00000216 72F2                <1>         jb      .ex1
