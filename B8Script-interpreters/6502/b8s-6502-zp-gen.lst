E338                GQ11:     EQU   (g_eol-1)/256   
E338                GQ12:     EQU   (g_exec-1)/256   
E338                GK:       EQU   13+12*GQ0-GQ1-GQ2-GQ2-GQ4-GQ5-GQ6-GQ6-GQ8-GQ9-GQ10-GQ11-GQ12   
E338                             ; `$ (never checked: the spec says so)
E338   20 20 E5     G_HEX:    JSR   rdhex   
E33B   B0 14                  BCS   hx2   
E33D   0A                     ASL      
E33E   0A                     ASL      
E33F   0A                     ASL      
E340   0A                     ASL      
E341   85 04                  STA   T0   
E343   20 20 E5               JSR   rdhex   
E346   B0 09                  BCS   hx2   ; odd digit: already consumed, dropped
E348   05 04                  ORA   T0   
E34A   81 00                  STA   (0,X)   
E34C   20 8C E2               JSR   inctos   
E34F   90 E7                  BCC   g_hex   ; always (rdhex left the carry clear)
E351   A9 60        HX2:      LDA   #60h   
E353   81 00                  STA   (0,X)   
E355   60                     RTS      
E356   A9 0D        G_NL:     LDA   #13   
E358   20 03 FF               JSR   CONOUT   
E35B   A9 0A                  LDA   #10   
E35D   4C 03 FF               JMP   CONOUT   
E360                             ; `+ and `-: one routine. It adds 0000h with the carry set, or FFFFh with it
E360                             ; clear: SBC turns the carry into that 00 or FF and leaves the carry as it
E360                             ; was. The cell is reached a byte at a time through the top cell, which
E360                             ; moves on between.
E360                G_INC:       
E360                          IF   CHECKED   
                              JSR   chkst   ; each byte"s address is tested, as for "!'
E360                          ENDIF      
E360   C0 03                  CPY   #GMINUS-GCH+1   ; carry: "+"
E362   A9 00                  LDA   #0   
E364   E9 00                  SBC   #0   
E366   85 05                  STA   T1   
E368   61 00                  ADC   (0,X)   
E36A   81 00                  STA   (0,X)   
E36C   48                     PHA      
E36D   20 8C E2               JSR   inctos   ; (keeps the carry)
E370                          IF   CHECKED   
                              PHP      
                              JSR   chkst   
                              PLP      
E370                          ENDIF      
E370   A5 05                  LDA   T1   
E372   61 00                  ADC   (0,X)   
E374   81 00                  STA   (0,X)   
E376   95 01                  STA   1,X   ; the new value is TOS
E378   68                     PLA      
E379   95 00                  STA   0,X   
E37B   60                     RTS      
E37C                             ; `. pushes the address of the random seed.
E37C   A9 76        G_SEED:   LDA   #<SEED   
E37E   A0 04                  LDY   #>SEED   
E380   4C B5 E4               JMP   pushay   
E383                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
E383                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
E383                             ; and the low ones repeat soon, so the high byte is folded into the low
E383                             ; (EOR) before the remainder of dividing by n is taken.
E383                             ; n must be 1 to 32767: the checked build stops with Z on anything less
E383                             ; than 1.
E383                G_RND:       
E383                          IF   CHECKED   
                              LDA   1,X   
                              BMI   gr9   
                              ORA   0,X   
                              BNE   gr8   
                    GR9:      JMP   e_zero   
                    GR8:         
E383                          ENDIF      
E383   B5 00                  LDA   0,X   
E385   85 08                  STA   D0   
E387   B5 01                  LDA   1,X   
E389   85 09                  STA   D1   ; D = n
E38B   AD 76 04               LDA   SEED   
E38E   AC 77 04               LDY   SEED+1   
E391   20 B7 E4               JSR   setay   ; the seed in n's place,
E394   A9 05                  LDA   #05h   ;   and 261 (0105h) on top of it
E396   A0 01                  LDY   #01h   
E398   20 B5 E4               JSR   pushay   
E39B   20 69 E1               JSR   h_mul   ; TOS = seed * 261
E39E   20 8C E2               JSR   inctos   
E3A1   B5 00                  LDA   0,X   
E3A3   8D 76 04               STA   SEED   
E3A6   B5 01                  LDA   1,X   
E3A8   8D 77 04               STA   SEED+1   
E3AB   55 00                  EOR   0,X   
E3AD   95 00                  STA   0,X   
E3AF   20 E6 E2               JSR   udiv   ; TOS = the quotient, the remainder under it
E3B2   CA                     DEX      
E3B3   CA                     DEX      
E3B4   20 A0 E0               JSR   h_swap   
E3B7   4C 23 E1               JMP   drop   ; the remainder is TOS
E3BA                             ; `< and `>: one routine. scmp leaves the carry clear if a < b. Y is even
E3BA                             ; for "<" and odd for ">" (their places in the table), so the low bit of Y
E3BA                             ; plus the carry is clear when a, the cell below, is the one to keep.
E3BA   20 4B E1     G_MIN:    JSR   scmp   
E3BD   98                     TYA      
E3BE   69 00                  ADC   #0   
E3C0   4A                     LSR      
E3C1   90 03                  BCC   gm1   
E3C3   20 A0 E0               JSR   h_swap   ; b is wanted: a on top, to be dropped
E3C6   4C 23 E1     GM1:      JMP   drop   
E3C9                          IF   ANSI   
E3C9                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
E3C9   A0 04        G_CUR:    LDY   #4   
E3CB   B9 E1 E3     GC1:      LDA   GQ25,Y   
E3CE   20 03 FF               JSR   CONOUT   
E3D1   88                     DEY      
E3D2   10 F7                  BPL   gc1   
E3D4   20 BC E4               JSR   flag   
E3D7   F0 03                  BEQ   gc2   
E3D9   A9 68                  LDA   #"h"   
E3DB   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E3DC   A9 6C        GC2:      LDA   #"l"   
E3DE   4C 03 FF               JMP   CONOUT   
E3E1   35 32 3F 5B 1B GQ25:   DB   "5","2","?","[",27   ; (printed from the end)
E3E6                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
E3E6   20 02 E4     G_AT:     JSR   csi   
E3E9   20 A0 E0               JSR   h_swap   ; the row on top
E3EC   20 FC E3               JSR   pinc   
E3EF   A9 3B                  LDA   #";"   
E3F1   20 03 FF               JSR   CONOUT   
E3F4   20 FC E3               JSR   pinc   
E3F7   A9 48                  LDA   #"H"   
E3F9   4C 03 FF               JMP   CONOUT   
E3FC                             ; pinc: print TOS + 1, unsigned, and drop it
E3FC   20 8C E2     PINC:     JSR   inctos   
E3FF   4C 74 E0               JMP   pn1   
E402                             ; csi: print ESC [, which starts every ANSI sequence. Keeps X and Y.
E402   A9 1B        CSI:      LDA   #27   
E404   20 03 FF               JSR   CONOUT   
E407   A9 5B                  LDA   #"["   
E409   4C 03 FF               JMP   CONOUT   
E40C                             ; `^: ESC [ H homes the cursor, and ESC [ J clears from there to the end of
E40C                             ; the screen. `_: ESC [ K clears to the end of the line.
E40C   A0 48        G_CLS:    LDY   #"H"   
E40E   20 16 E4               JSR   csiy   
E411   A0 4A                  LDY   #"J"   
E413   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E414   A0 4B        G_EOL:    LDY   #"K"   
E416                             ; csiy: print ESC [ and the character in Y
E416   20 02 E4     CSIY:     JSR   csi   
E419   98                     TYA      
E41A   4C 03 FF               JMP   CONOUT   
E41D                          ENDIF      
E41D                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    JSR   flag   ; A = 0 and Z set: off
                              JMP   CONCUR   
                    G_AT:     LDY   2,X   ; Y = the row
                              LDA   0,X   ; A = the column
                              JSR   CONAT   
                              INX      
                              INX      
                              JMP   drop   
                    G_CLS:    JMP   CONCLS   
                    G_EOL:    JMP   CONEOL   
E41D                          ENDIF      
E41D                             ; `! ( addr -- ): call the machine code at addr; see the contract in the
E41D                             ; header.
E41D   B5 00        G_EXEC:   LDA   0,X   
E41F   85 04                  STA   T0   
E421   B5 01                  LDA   1,X   
E423   85 05                  STA   T1   
E425   E8                     INX      ; the address is consumed
E426   E8                     INX      
E427   6C 04 00               JMP   (T0)   
E42A                          IF   CHECKED   
                                 ; The checked build's inner loop, out of page 1, where it would not fit,
                                 ; and its break check (described with the unchecked one in page 1).
                                 ; pnext: the break check, then (falling through) next. A word call, a true
                                 ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
                                 ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
                                 ; falls in here too, which does no harm.)
                    PNEXT:    DEC   CDOWN   
                              BNE   next   
                              JSR   KEY   
                              BEQ   next   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JSR   chk3   ; (Ctrl-C: back only if the break key is off)
                    NEXT:        
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE (an
                                 ; underflow) or below DSFULL (an overflow). No handler moves X by
                                 ; more than 4, so X is caught before it wraps; an overrun by a cell
                                 ; or two writes on the scratch bytes below or above the stack.
                                 ; S is kept in RSV, for the report's Rtn line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_sund   
                              CPX   #DSFULL   
                              BCC   e_sovr   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
                              JSR   step   
                              JMP   next   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: Rtn 0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_SUND:   LDX   #DSE   ; Stk 0
                              LDA   #"s"   
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_SOVR:   LDA   #"S"   
                    EJMP:     JMP   error   
                                 ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
                                 ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
                                 ; which takes either. Meeting the wrong closer at this level, or the end
                                 ; (a NUL, or a string that runs into it), stops with N, except for \,
                                 ; which then ends the program as before.
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                              JMP   error   ;   or the end: the place is the opener
E42A                          ENDIF      
E42A                          IF   1-CHECKED   
E42A                CBREAK:   EQU   endp   ; the unchecked build stops without a word
E42A                          ENDIF      
E42A                          IF   CHECKED   
                    CBREAK:   EQU   e_break   ; the checked build reports B
E42A                          ENDIF      
E42A                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E42A                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E42A                             ; taken out of KEYBUF.
E42A   AD 7A 04     GETK:     LDA   KEYBUF   
E42D   F0 08                  BEQ   gk1   
E42F   48                     PHA      
E430   A9 00                  LDA   #0   
E432   8D 7A 04               STA   KEYBUF   
E435   68                     PLA      
E436   60                     RTS      
E437   20 06 FF     GK1:      JSR   KEY   
E43A   F0 04                  BEQ   gk9   
E43C                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E43C                             ; back if it comes back at all.
E43C   C9 03        CHK3:     CMP   #3   
E43E   F0 01                  BEQ   ctlc   
E440   60           GK9:      RTS      
E441                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E441                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E441                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E441                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E441                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y. (Not D0/D1:
E441                             ; they hold the place in the checked build.)
E441   AD 7B 04     CTLC:     LDA   BRKOFF   
E444   F0 5D                  BEQ   cbreak   
E446   A9 28                  LDA   #CWAIT+1   
E448   85 05                  STA   T1   
E44A   20 06 FF     CT2:      JSR   KEY   
E44D   D0 0A                  BNE   ct3   
E44F   C6 06                  DEC   T2   
E451   D0 F7                  BNE   ct2   
E453   C6 05                  DEC   T1   
E455   D0 F3                  BNE   ct2   
E457   F0 07                  BEQ   ct9   ; always: none came
E459   C9 03        CT3:      CMP   #3   
E45B   F0 46                  BEQ   cbreak   
E45D   8D 7A 04               STA   KEYBUF   
E460   A9 03        CT9:      LDA   #3   
E462   60                     RTS      
E463                          IF   CHECKED   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP2:    JMP   error   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; Rtn does not count the call
                              LDA   #"U"   
                              BNE   ejmp2   ; always
E463                          ENDIF      
E463                             ; step: read one character and sort it by range.
E463                             ;    00h          end of program
E463                             ;    01h-20h, 7Fh-FFh   ignored
E463                             ;    30h-39h      digit: read a whole number
E463                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E463                             ;    61h-7Ah      a-z: push the address of that letter's cell
E463                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E463   20 31 E5     STEP:     JSR   getc   ; flags follow A
E466   F0 3B                  BEQ   endp   
E468   38                     SEC      
E469   E9 21                  SBC   #21h   ; A = c - 21h
E46B   90 35                  BCC   ign   ; 01h-20h
E46D   C9 0F                  CMP   #0Fh   
E46F   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E471   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E473   C9 0A                  CMP   #10   
E475   90 6C                  BCC   digit   
E477   C9 11                  CMP   #11h   
E479   90 16                  BCC   p3a   ; 3Ah-40h
E47B   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E47D   C9 1A                  CMP   #1Ah   
E47F   90 25                  BCC   upper   ; 41h-5Ah
E481   C9 20                  CMP   #20h   
E483   90 0A                  BCC   p5b   ; 5Bh-60h
E485   C9 3A                  CMP   #3Ah   
E487   90 29                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E489   C9 3E                  CMP   #3Eh   
E48B                          IF   1-CHECKED   
E48B   B0 15                  BCS   ign   ; 7Fh-FFh
E48D                          ENDIF      
E48D                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E48D                          ENDIF      
E48D                             ; The three adjustments below chain. Each ADC adds the carry the one
E48D                             ; before it left, which the constants allow for.
E48D   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E48F   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E491   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E493                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E493                             ; the index is N1 or more, plus one more if it is N2 or more.
E493   C9 08        PUNCT:    CMP   #N1   
E495   A8                     TAY      
E496   A9 70                  LDA   #HALFPG   
E498   2A                     ROL      ; the first page, or the second (carry clear)
E499   C0 15                  CPY   #N2   
E49B   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E49D   48                     PHA      
E49E   B9 C3 E4               LDA   PTAB,Y   
E4A1   48                     PHA      
E4A2   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E4A3                             ; directly, it just ends an ignored character.
E4A3                ENDP:        ; the program has ended
E4A3                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E4A3                          ENDIF      
E4A3   4C 09 FF               JMP   EXIT   
E4A6                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E4A6                             ; the return stack, and the IP becomes the address in the letter's cell.
E4A6   0A           UPPER:    ASL      
E4A7   A8                     TAY      
E4A8   38                     SEC      
E4A9   4C C1 E0               JMP   pushn   
E4AC   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E4AE   A4 01                  LDY   IP+1   
E4B0   D0 03                  BNE   pushay   ; always: no program is in page zero
E4B2                             ; a-z: push the cell's address (the cell is the variable)
E4B2   0A           LOWER:    ASL      
E4B3   A0 04                  LDY   #>LET   
E4B5                             ; pushay: push a cell: A = its low byte, Y = its high byte
E4B5   CA           PUSHAY:   DEX      
E4B6   CA                     DEX      
E4B7   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E4B9   94 01                  STY   1,X   
E4BB   60                     RTS      
E4BC                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E4BC   E8           FLAG:     INX      
E4BD   E8                     INX      
E4BE   B5 FE                  LDA   0FEh,X   
E4C0   15 FF                  ORA   0FFh,X   
E4C2   60                     RTS      
E4C3                             ; =============================================================================
E4C3                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E4C3                             ;  character, in code order.
E4C3                             ; =============================================================================
E4C3   93           PTAB:     DB   (h_store-1) & 0FFh   ; !
E4C4   4B                     DB   (h_str-1) & 0FFh   ; "
E4C5   67                     DB   (h_num-1) & 0FFh   ; #
E4C6   35                     DB   (h_print-1) & 0FFh   ; $
E4C7   9F                     DB   (h_swap-1) & 0FFh   ; %
E4C8   B0                     DB   (h_and-1) & 0FFh   ; &
E4C9   5F                     DB   (h_emit-1) & 0FFh   ; '
E4CA   BB                     DB   (h_open-1) & 0FFh   ; (
E4CB   BA                     DB   (h_close-1) & 0FFh   ; )
E4CC   68                     DB   (h_mul-1) & 0FFh   ; *
E4CD   2E                     DB   (h_add-1) & 0FFh   ; +
E4CE   B1                     DB   (h_cfetch-1) & 0FFh   ; ,
E4CF   25                     DB   (h_sub-1) & 0FFh   ; -
E4D0   1C                     DB   (h_cstore-1) & 0FFh   ; .
E4D1   8E                     DB   (h_div-1) & 0FFh   ; /
E4D2   15                     DB   (h_dup-1) & 0FFh   ; :
E4D3   22                     DB   (drop-1) & 0FFh   ; ;
E4D4   43                     DB   (h_lt-1) & 0FFh   ; <
E4D5   58                     DB   (h_eq-1) & 0FFh   ; =
E4D6   40                     DB   (h_gt-1) & 0FFh   ; >
E4D7   C1                     DB   (h_key-1) & 0FFh   ; ?
E4D8   7C                     DB   (h_fetch-1) & 0FFh   ; @
E4D9   92                     DB   (h_def-1) & 0FFh   ; [
E4DA   26                     DB   (h_break-1) & 0FFh   ; \
E4DB   38                     DB   (h_ret-1) & 0FFh   ; ]
E4DC   66                     DB   (h_xor-1) & 0FFh   ; ^
E4DD   CE                     DB   (h_alloc-1) & 0FFh   ; _
E4DE   B4                     DB   (h_grave-1) & 0FFh   ; `
E4DF   4A                     DB   (h_tor-1) & 0FFh   ; {
E4E0   71                     DB   (h_or-1) & 0FFh   ; |
E4E1   56                     DB   (h_fromr-1) & 0FFh   ; }
E4E2   63                     DB   (h_not-1) & 0FFh   ; ~
E4E3                             ; Digits: the first one is in A; read the rest of the number.
E4E3   A0 00        DIGIT:    LDY   #0   
E4E5   20 B5 E4               JSR   pushay   
E4E8                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E4E8                             ; Returns with the carry set.
E4E8   20 17 E5     RDNUM:    JSR   isdig   
E4EB   B0 4F                  BCS   ic9   ; (an RTS)
E4ED   20 34 E5               JSR   incip   ; (keeps A = the digit)
E4F0   16 00                  ASL   0,X   
E4F2   36 01                  ROL   1,X   ; x2
E4F4   18                     CLC      
E4F5   75 00                  ADC   0,X   
E4F7   85 04                  STA   T0   
E4F9   B5 01                  LDA   1,X   
E4FB   69 00                  ADC   #0   
E4FD   85 05                  STA   T1   ; T = x2 + digit
E4FF   16 00                  ASL   0,X   
E501   36 01                  ROL   1,X   
E503   16 00                  ASL   0,X   
E505   36 01                  ROL   1,X   ; x8
E507   18                     CLC      
E508   B5 00                  LDA   0,X   
E50A   65 04                  ADC   T0   
E50C   95 00                  STA   0,X   
E50E   B5 01                  LDA   1,X   
E510   65 05                  ADC   T1   
E512   95 01                  STA   1,X   ; x8 + x2 + digit
E514   4C E8 E4               JMP   rdnum   
E517                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E517                             ; digit. Y = 0.
E517   20 3D E5     ISDIG:    JSR   peek   
E51A   38                     SEC      
E51B   E9 30                  SBC   #"0"   
E51D   C9 0A                  CMP   #10   
E51F   60                     RTS      
E520                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E520                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E520   20 17 E5     RDHEX:    JSR   isdig   
E523   90 0F                  BCC   incip   
E525   29 DF                  AND   #0DFh   
E527   E9 11                  SBC   #11h   ; (the carry is set)
E529   C9 06                  CMP   #6   
E52B   B0 0F                  BCS   ic9   
E52D   69 0A                  ADC   #10   
E52F   D0 03                  BNE   incip   ; always
E531                             ; Reading the program
E531                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E531                             ;    getc: the same, then IP moves on; flags follow A
E531                             ;    incip: IP moves on; keeps A, the carry and Y
E531   20 3D E5     GETC:     JSR   peek   
E534   E6 00        INCIP:    INC   IP   
E536   D0 02                  BNE   ic1   
E538   E6 01                  INC   IP+1   
E53A   09 00        IC1:      ORA   #0   
E53C   60           IC9:      RTS      
E53D   A0 00        PEEK:     LDY   #0   
E53F   B1 00                  LDA   (IP),Y   
E541   60                     RTS      
E542                             ; rstip: point IP at the start of the program
E542   A9 00        RSTIP:    LDA   #<PROG   
E544   85 00                  STA   IP   
E546   A9 05                  LDA   #>PROG   
E548   85 01                  STA   IP+1   
E54A   60                     RTS      
E54B                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
                                 ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   Rtn n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was. With the stack full
                                 ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
                    ERROR:    PHA      ; the letter
                              LDA   PLACE   
                              STA   P   
                              LDA   PLACE+1   
                              STA   P+1   ; (the numbers need D0/D1)
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   LN   
                              LDY   LN+1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   T1   
                              LDY   T2   
                              JSR   prnum   ; the column
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              LDY   #0   ; the text at the place
                    ER1:      LDA   (P),Y   
                              BEQ   er2   
                              CMP   #13   
                              BEQ   er2   
                              CMP   #10   
                              BEQ   er2   
                              JSR   CONOUT   
                              INY      
                              CPY   #16   
                              BNE   er1   
                    ER2:      LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "Stk "
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   
                              LSR      ; the depth, (DSE - X) / 2
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T1   ; T1 = how many cells to show
                              JSR   prs   
                    ER4:      LDA   T1   ; cells T1-1 down to 0, the top last: cell i
                              BEQ   er5   ;   from the top is at X+2i
                              DEC   T1   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   T1   
                              ASL      
                              STA   T2   
                              TXA      
                              ADC   T2   ; (the carry is clear)
                              TAY      
                              LDA   0,Y   
                              PHA      
                              LDA   1,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "Rtn "
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"Stk"," "+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"Rtn"," "+80h   
                                 ; lcol: the line (LN) and the column (T1/T2) of the place at P, both from
                                 ; 1. A place below the program is in the -n? line buffer: line 0, and the
                                 ; column is the place in the buffer. Otherwise IP (free now: the program has
                                 ; stopped) runs from PROG to the place, counting LFs; T1/T2 keeps where the
                                 ; last line started, and the column is the place minus that, plus 1.
                    LCOL:     LDA   #0   
                              STA   LN+1   
                              STA   LN   
                              LDA   #<LINEBUF   
                              STA   T1   
                              LDA   #>LINEBUF   
                              STA   T2   
                              LDA   P   
                              CMP   #<PROG   
                              LDA   P+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   LN   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   T1   
                              LDA   IP+1   
                              STA   T2   
                    LC1:      LDA   IP   
                              CMP   P   
                              LDA   IP+1   
                              SBC   P+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              INC   LN   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   LN+1   
                              BNE   lc3   ; always
                    LC9:      LDA   P   
                              SEC      
                              SBC   T1   
                              STA   T1   
                              LDA   P+1   
                              SBC   T2   
                              STA   T2   
                              INC   T1   ; + 1
                              BNE   lc8   
                              INC   T2   
                    LC8:      RTS      
E54B                          ENDIF      


