01B0   E5           H_DUP:    PUSH   H   ; ":"
01B1   F7                     RST   6   
01B2   E3           H_SWAP:   XTHL      ; "%"
01B3   F7                     RST   6   
01B4                             ; (The checked build tests the address before it takes the value off the
01B4                             ; stack, so that an error report shows both.)
01B4                H_STORE:      ; "!" ( n addr -- )
01B4                          IF   CHECKED   
01B4   CD 71 03               CALL   chkst   
01B7                          ENDIF      
01B7   D1                     POP   D   
01B8   73                     MOV   M,E   
01B9   23                     INX   H   
01BA   72                     MOV   M,D   
01BB   DF                     RST   3   
01BC                H_CSTORE:      ; "." ( c addr -- )
01BC                          IF   CHECKED   
01BC   CD 71 03               CALL   chkst   
01BF                          ENDIF      
01BF   D1                     POP   D   
01C0   73                     MOV   M,E   
01C1   DF                     RST   3   
01C2                             ; ---- console ---------------------------------------------------------------
01C2                             ; 22h pushes the address of the text after it and skips the string.
01C2   E5           H_STR:    PUSH   H   
01C3   60                     MOV   H,B   
01C4   69                     MOV   L,C   
01C5   CD 08 03               CALL   skipstr   
01C8                          IF   CHECKED   
01C8   B7                     ORA   A   ; 0: the text ran out before the closing quote
01C9   CA 0B 04               JZ   e_quote   
01CC                          ENDIF      
01CC   F7                     RST   6   
01CD                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01CD                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01CD                             ; bit 6, so // and /" give themselves).
01CD                          IF   1-CHECKED   
                    H_PRINT:   MOV   A,M   
                              INX   H   
                              CPI   22h   
                              JZ   h_drop   
                              CPI   "/"   
                              JNZ   pr1   
                              MOV   A,M   
                              INX   H   
                              ANI   0BFh   
                    PR1:      RST   5   
                              JMP   h_print   
01CD                          ENDIF      
01CD                          IF   CHECKED   
01CD                             ; (The checked build has the loop as a routine, prstr, which the error
01CD                             ; report uses too. The address is kept on the stack meanwhile: a report
01CD                             ; shows the stack as it was before the "$".)
01CD   E5           H_PRINT:   PUSH   H   
01CE   CD 97 03               CALL   prstr   
01D1   D1                     POP   D   
01D2   DF                     RST   3   
01D3                          ENDIF      
01D3   7D           H_EMIT:   MOV   A,L   ; "'"
01D4   EF                     RST   5   
01D5   DF           H_DROP:   RST   3   ; ";" is this one byte
01D6                             ; "#" prints TOS as a signed decimal number, with no space after it.
01D6   C5           H_NUM:    PUSH   B   
01D7   CD A9 02               CALL   psgn   
01DA   C1                     POP   B   
01DB   DF                     RST   3   
01DC                          IF   CHECKED   ; (the checked build has no room to start ","
01DC   6E           H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
01DD   26 00                  MVI   H,0   ;   the end of "?")
01DF   F7                     RST   6   
01E0                          ENDIF      
01E0                             ; "?" ( n -- c ) or ( -n -- addr )
01E0                             ;   n > 0: wait about n ms for a key; 0 if none came
01E0                             ;   n = 0: wait for a key
01E0                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01E0                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01E0   7C           H_KEY:    MOV   A,H   
01E1   B7                     ORA   A   
01E2   FA 00 02               JM   line   
01E5   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
01E7   CD 60 03     KT2:      CALL   getk   
01EA   C2 FC 01               JNZ   kt3   
01ED   1D                     DCR   E   
01EE   C2 E7 01               JNZ   kt2   
01F1   7C                     MOV   A,H   ; 0? never counts down: it waits
01F2   B5                     ORA   L   
01F3   CA E5 01               JZ   kt1   
01F6   2B                     DCX   H   
01F7   7C                     MOV   A,H   
01F8   B5                     ORA   L   
01F9   C2 E5 01               JNZ   kt1   ; A = 0 if the time ran out
01FC                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01FC                          ENDIF      
01FC   6F           KT3:      MOV   L,A   
01FD   26 00                  MVI   H,0   
01FF   F7                     RST   6   
0200                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
                              DAD   D   ;   only for 1 to 127, and leaves 127 - count
                              SBB   A   
                              ANA   L   ; (0 for a count that is too big)
                              XRI   127   ; A = the count, 127 at most
                              STA   LBHDR   
                              PUSH   B   
                              LXI   D,LBHDR   
                              MVI   C,10   
                              CALL   BDOS   
                              POP   B   
                              LXI   H,LBHDR+1   
                              MOV   A,M   ; the count typed (0-127)
                              INR   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   L   ;   adding the count to L can't carry
                              MOV   L,A   
                              MVI   M,13   
                              MVI   L,LINEBUF & 0FFh   
                              RST   6   
0200                          ENDIF      
0200                          IFN   CPM   
0200                             ; Generic: Backspace takes the last character back (and is echoed as
0200                             ; it is), CR ends (stored, not echoed), every other key is stored and
0200                             ; echoed until the line is full. The line buffer starts at offset 80h
0200                             ; of its page, so L alone is the place in the line: D holds the L of
0200                             ; a full line.
0200   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
0203   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
0204   9F                     SBB   A   
0205   A5                     ANA   L   ; (0 for a count that is too big)
0206   2F                     CMA      
0207   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
0208                             ;   at most
0208   21 80 82               LXI   H,LINEBUF   
020B   CD 60 03     LN2:      CALL   getk   
020E   CA 0B 02               JZ   ln2   
0211   FE 0D                  CPI   13   
0213   CA 30 02               JZ   ln5   
0216   FE 08                  CPI   8   
0218   CA 28 02               JZ   ln4   
021B   5F                     MOV   E,A   
021C   7D                     MOV   A,L   
021D   BA                     CMP   D   
021E   CA 0B 02               JZ   ln2   ; full
0221   73                     MOV   M,E   
0222   2C                     INR   L   
0223   7B                     MOV   A,E   
0224   EF           LN3:      RST   5   
0225   C3 0B 02               JMP   ln2   
0228   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0229   FA 24 02               JM   ln3   ;   unless the line was empty (L left the
022C   2C                     INR   L   ;   upper half of the page)
022D   C3 0B 02               JMP   ln2   
0230   77           LN5:      MOV   M,A   ; the CR
0231   2E 80                  MVI   L,LINEBUF & 0FFh   
0233   F7                     RST   6   
0234                          ENDIF      
0234                             ; =============================================================================
0234                             ;  Dispatch table: the low byte of each handler's address, in code order.
0234                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0234                             ; =============================================================================
0234                             ; The handlers of the first NPG1 characters start in the image's second page.
0234                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0234                             ; differs between the builds, so the count is worked out here.
0234                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0234                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0234                PGBRK:    EQU   (h_break-BASE)/256   
0234                PGDEF:    EQU   (h_def-BASE)/256   
0234                PGFET:    EQU   (h_fetch-BASE)/256   
0234                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0234   B4           PTAB:     DB   h_store & 0FFh   ; !
0235   C2                     DB   h_str & 0FFh   ; "
0236   D6                     DB   h_num & 0FFh   ; #
0237   CD                     DB   h_print & 0FFh   ; $
0238   B2                     DB   h_swap & 0FFh   ; %
0239   47                     DB   h_and & 0FFh   ; &
023A   D3                     DB   h_emit & 0FFh   ; '
023B   23                     DB   h_open & 0FFh   ; (
023C   2F                     DB   h_close & 0FFh   ; )
023D   6C                     DB   h_mul & 0FFh   ; *
023E   44                     DB   h_add & 0FFh   ; +
023F   DC                     DB   h_cfetch & 0FFh   ; ,
0240   3B                     DB   h_sub & 0FFh   ; -
0241   BC                     DB   h_cstore & 0FFh   ; .
0242   88                     DB   h_div & 0FFh   ; /
0243   B0                     DB   h_dup & 0FFh   ; :
0244   D5                     DB   h_drop & 0FFh   ; ;
0245   50                     DB   h_lt & 0FFh   ; <
0246   5F                     DB   h_eq & 0FFh   ; =
0247   4F                     DB   h_gt & 0FFh   ; >
0248   E0                     DB   h_key & 0FFh   ; ?
0249   1E                     DB   h_fetch & 0FFh   ; @
024A   F7                     DB   h_def & 0FFh   ; [
024B   E8                     DB   h_break & 0FFh   ; \
024C   E3                     DB   h_ret & 0FFh   ; ]
024D   82                     DB   h_xor & 0FFh   ; ^
024E   95                     DB   h_alloc & 0FFh   ; _
024F   C6                     DB   h_grave & 0FFh   ; `
0250   14                     DB   h_tor & 0FFh   ; {
0251   8A                     DB   h_or & 0FFh   ; |
0252   1D                     DB   h_fromr & 0FFh   ; }
0253   92                     DB   h_not & 0FFh   ; ~
0254                PTABEND:      
