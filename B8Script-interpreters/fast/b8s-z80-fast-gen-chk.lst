034F   ED 52                  SBC   HL,DE   
0351   30 02                  JR   NC,uvr12   
0353   19                     ADD   HL,DE   
0354   0D                     DEC   C   
0355   0C           UVR12:    INC   C   
0356   CB 21                  SLA   C   
0358   17                     RLA      
0359   ED 6A                  ADC   HL,HL   
035B   ED 52                  SBC   HL,DE   
035D   30 02                  JR   NC,uvr13   
035F   19                     ADD   HL,DE   
0360   0D                     DEC   C   
0361   0C           UVR13:    INC   C   
0362   CB 21                  SLA   C   
0364   17                     RLA      
0365   ED 6A                  ADC   HL,HL   
0367   ED 52                  SBC   HL,DE   
0369   30 02                  JR   NC,uvr14   
036B   19                     ADD   HL,DE   
036C   0D                     DEC   C   
036D   0C           UVR14:    INC   C   
036E   CB 21                  SLA   C   
0370   17                     RLA      
0371   ED 6A                  ADC   HL,HL   
0373   ED 52                  SBC   HL,DE   
0375   30 02                  JR   NC,uvr15   
0377   19                     ADD   HL,DE   
0378   0D                     DEC   C   
0379   0C           UVR15:    INC   C   
037A   EB                     EX   DE,HL   ; DE = remainder
037B   67                     LD   H,A   
037C   69                     LD   L,C   ; HL = quotient
037D   C1                     POP   BC   
037E   C9                     RET      
037F                          ENDIF      
037F                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
037F                             ; non-digit. Values wrap at 16 bits, as the spec says.
037F   21 00 00     RDNUM:    LD   HL,0   
0382   0A           RDN1:     LD   A,(BC)   
0383   D6 30                  SUB   "0"   
0385   FE 0A                  CP   10   
0387   D0                     RET   NC   
0388   03                     INC   BC   
0389   54                     LD   D,H   
038A   5D                     LD   E,L   
038B   29                     ADD   HL,HL   
038C   29                     ADD   HL,HL   
038D   19                     ADD   HL,DE   
038E   29                     ADD   HL,HL   ; HL * 10
038F   5F                     LD   E,A   
0390   16 00                  LD   D,0   
0392   19                     ADD   HL,DE   
0393   18 ED                  JR   rdn1   
0395                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0395                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0395                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0395                          ENDIF      
0395                          IF   CHECKED   
0395                             ; The checked build never steps over a NUL: if the text runs out first it
0395                             ; returns A = 0 with the IP on the NUL.
0395   0A           SKIPSTR:   LD   A,(BC)   
0396   B7                     OR   A   
0397   C8                     RET   Z   
0398   03                     INC   BC   
0399   FE 22                  CP   22h   
039B   C8                     RET   Z   
039C   FE 2F                  CP   "/"   
039E   20 F5                  JR   NZ,skipstr   
03A0   0A                     LD   A,(BC)   ; the escaped character
03A1   B7                     OR   A   
03A2   C8                     RET   Z   
03A3   03                     INC   BC   
03A4   18 EF                  JR   skipstr   
03A6                          ENDIF      
03A6                             ; skip: read past text to the closer at this level, and return A = 0 if it
03A6                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03A6                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03A6                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03A6                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03A6                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
03A6                             ; 
03A6                             ; The checked build also looks at the character the skip was started by,
03A6                             ; which is always the one just before where it starts: "(" must end at ")",
03A6                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03A6                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
03A6                             ; place where the skip started, for the report.
03A6                          IF   1-QK   
                                 ; (Without QUICK: no skip cache.)
                    SKIP:        
03A6                          ENDIF      
03A6                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
03A6                          ENDIF      
03A6                          IF   1-QK   
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
03A6                          ENDIF      
03A6                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
03A6                          ENDIF      
03A6                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
03A6                          ENDIF      
03A6                          IF   1-QK   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
03A6                          ENDIF      
03A6                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
03A6                          ENDIF      
03A6                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
03A6                          ENDIF      
03A6                          IF   QK   
03A6                             ; The skip cache. Nearly every skip is one that has happened before (a loop
03A6                             ; skips the same false block on every pass), so the first scan from each
03A6                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
03A6                             ; start's low byte. Only skips that start in the program text are kept (the
03A6                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
03A6                             ; A program that changes its own text while it runs is not looked after.
03A6   ED 43 3C 82  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
03AA   78                     LD   A,B   ;   checked report's place)
03AB   FE 83                  CP   PROG/256   
03AD   38 1B                  JR   C,sks   ; below the program text: no cache
03AF   79                     LD   A,C   
03B0   87                     ADD   A,A   
03B1   87                     ADD   A,A   
03B2   5F                     LD   E,A   
03B3   16 F0                  LD   D,CPAGE   ; DE -> the entry
03B5   1A                     LD   A,(DE)   
03B6   B9                     CP   C   
03B7   20 11                  JR   NZ,sks   
03B9   1C                     INC   E   
03BA   1A                     LD   A,(DE)   
03BB   B8                     CP   B   
03BC   20 0C                  JR   NZ,sks   
03BE   1C                     INC   E   
03BF   1A                     LD   A,(DE)   
03C0   4F                     LD   C,A   
03C1   1C                     INC   E   
03C2   1A                     LD   A,(DE)   
03C3   47                     LD   B,A   ; a hit: the IP is past the closer
03C4   0B                     DEC   BC   
03C5   0A                     LD   A,(BC)   
03C6   03                     INC   BC   
03C7   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
03C9   C9                     RET      
03CA                SKS:         
03CA                          ENDIF      
03CA                          IF   QK*CHECKED   
03CA   0B                     DEC   BC   
03CB   0A                     LD   A,(BC)   
03CC   03                     INC   BC   
03CD   5F                     LD   E,A   ; E = the opener: ( [ or \
03CE                          ENDIF      
03CE                          IF   QK   
03CE                             ; The scan. Most characters are nothing to it, and two range tests rule
03CE                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
03CE   16 00                  LD   D,0   
03D0   14           SQ3:      INC   D   ; an opener: one deeper
03D1   0A           SQ1:      LD   A,(BC)   
03D2   03                     INC   BC   
03D3   FE 5E                  CP   5Eh   
03D5   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
03D7   FE 5B                  CP   5Bh   
03D9   30 25                  JR   NC,sqb   ; [ \ ]
03DB   FE 2A                  CP   2Ah   
03DD   30 F2                  JR   NC,sq1   ; * to Z: nothing
03DF   FE 28                  CP   28h   
03E1   28 ED                  JR   Z,sq3   ; (
03E3   30 25                  JR   NC,sqc   ; )
03E5   FE 22                  CP   22h   
03E7   28 12                  JR   Z,sqq   ; a string
03E9   B7                     OR   A   
03EA   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
03EC                          ENDIF      
03EC                          IF   QK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
03EC                          ENDIF      
03EC                          IF   QK*CHECKED   
03EC   0B                     DEC   BC   ; NUL: the IP stays on it
03ED   CB 53                  BIT   2,E   ; the text ran out:
03EF   C2 09 FF               JP   NZ,SKEND   ;   "\" with no closer ends the program
03F2   ED 4B 3C 82  SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
03F6   3E 4E                  LD   A,"N"   
03F8   C3 EC 05               JP   errp   ; (errp drops skip's return address)
03FB                          ENDIF      
03FB                          IF   QK   
03FB   CD 95 03     SQQ:      CALL   skipstr   ; step over the string
03FE   18 D1                  JR   sq1   
0400   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
0402   28 CD                  JR   Z,sq1   ; "\" is nothing here
0404   38 CA                  JR   C,sq3   ; [
0406   3E 02                  LD   A,2   ; ]
0408   18 01                  JR   sq4   
040A   AF           SQC:      XOR   A   ; )
040B   15           SQ4:      DEC   D   
040C   20 C3                  JR   NZ,sq1   
040E                          ENDIF      
040E                          IF   QK*CHECKED   
040E   57                     LD   D,A   ; the closer at this level (as above): 2 here
040F   AB                     XOR   E   ;   means the wrong closer
0410   E6 06                  AND   6   
0412   FE 02                  CP   2   
0414   7A                     LD   A,D   
0415   28 DB                  JR   Z,sq7   
0417                          ENDIF      
0417                          IF   QK   
0417                             ; The closer at this level: remember the skip (if it started in the program
0417                             ; text), and return A = 0 for ")" or 2 for "]".
0417   F5                     PUSH   AF   
0418   E5                     PUSH   HL   
0419   2A 3C 82               LD   HL,(SKPL)   
041C   7C                     LD   A,H   
041D   FE 83                  CP   PROG/256   
041F   38 11                  JR   C,sq9   
0421   7D                     LD   A,L   
0422   87                     ADD   A,A   
0423   87                     ADD   A,A   
0424   5F                     LD   E,A   
0425   16 F0                  LD   D,CPAGE   
0427   7D                     LD   A,L   
0428   12                     LD   (DE),A   
0429   1C                     INC   E   
042A   7C                     LD   A,H   
042B   12                     LD   (DE),A   
042C   1C                     INC   E   
042D   79                     LD   A,C   
042E   12                     LD   (DE),A   
042F   1C                     INC   E   
0430   78                     LD   A,B   
0431   12                     LD   (DE),A   
0432   E1           SQ9:      POP   HL   
0433   F1                     POP   AF   
0434   C9                     RET      
0435                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
0435   E5           SKCLR:    PUSH   HL   
0436   21 00 F0               LD   HL,CPAGE*256   
0439   36 00        SKC1:     LD   (HL),0   
043B   2C                     INC   L   
043C   20 FB                  JR   NZ,skc1   
043E   E1                     POP   HL   
043F   C9                     RET      
0440                          ENDIF      
0440                             ;  ---- Speed-ups (QUICK builds) -------------------------------------------
0440                             ;  The skip cache is above. These are the handlers' tails that the builds with
0440                             ;  room take, kept here, out of the handlers' first two pages.
0440                          IF   QK   
0440                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
0440                             ; multiplier (most multiplications have one, a count or a small constant).
0440   7C           MULQ:     LD   A,H   
0441   B7                     OR   A   
0442   28 05                  JR   Z,mq8   ; the multiplier is below 256
0444   7A                     LD   A,D   
0445   B7                     OR   A   
0446   20 2F                  JR   NZ,mq16   
0448   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
0449                          ENDIF      
0449                          IF   QK*(1-FAST)   
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              PUSH   BC   
                              LD   B,8   
                    MQ1:      ADD   HL,HL   
                              RLA      
                              JR   NC,mq2   
                              ADD   HL,DE   
                    MQ2:      DJNZ   mq1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    MQ3:      ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mq4   
                              ADD   HL,DE   
                    MQ4:      DJNZ   mq3   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0449                          ENDIF      
0449                          IF   FAST   
0449                             ; (the speed build: the same rounds, unrolled)
0449   7D           MQ8:      LD   A,L   
044A   21 00 00               LD   HL,0   
044D   29                     ADD   HL,HL   
044E   17                     RLA      
044F   30 01                  JR   NC,mur0   
0451   19                     ADD   HL,DE   
0452                MUR0:        
0452   29                     ADD   HL,HL   
0453   17                     RLA      
0454   30 01                  JR   NC,mur1   
0456   19                     ADD   HL,DE   
0457                MUR1:        
0457   29                     ADD   HL,HL   
0458   17                     RLA      
0459   30 01                  JR   NC,mur2   
045B   19                     ADD   HL,DE   
045C                MUR2:        
045C   29                     ADD   HL,HL   
045D   17                     RLA      
045E   30 01                  JR   NC,mur3   
0460   19                     ADD   HL,DE   
0461                MUR3:        
0461   29                     ADD   HL,HL   
0462   17                     RLA      
0463   30 01                  JR   NC,mur4   
0465   19                     ADD   HL,DE   
0466                MUR4:        
0466   29                     ADD   HL,HL   
0467   17                     RLA      
0468   30 01                  JR   NC,mur5   
046A   19                     ADD   HL,DE   
046B                MUR5:        
046B   29                     ADD   HL,HL   
046C   17                     RLA      
046D   30 01                  JR   NC,mur6   
046F   19                     ADD   HL,DE   
0470                MUR6:        
0470   29                     ADD   HL,HL   
0471   17                     RLA      
0472   30 01                  JR   NC,mur7   
0474   19                     ADD   HL,DE   
0475                MUR7:        
0475                          ;*Macro unroll:  NEXT
0475                          DS   (1-CPM)*(1-FAST),0F7h   
0475   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0476   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0477   C5           MQ16:     PUSH   BC   
0478   7C                     LD   A,H   
0479   4D                     LD   C,L   
047A   21 00 00               LD   HL,0   
047D   29                     ADD   HL,HL   
047E   CB 21                  SLA   C   
0480   17                     RLA      
0481   30 01                  JR   NC,mus0   
0483   19                     ADD   HL,DE   
0484                MUS0:        
0484   29                     ADD   HL,HL   
0485   CB 21                  SLA   C   
0487   17                     RLA      
0488   30 01                  JR   NC,mus1   
048A   19                     ADD   HL,DE   
048B                MUS1:        
048B   29                     ADD   HL,HL   
048C   CB 21                  SLA   C   
048E   17                     RLA      
048F   30 01                  JR   NC,mus2   
0491   19                     ADD   HL,DE   
0492                MUS2:        
0492   29                     ADD   HL,HL   
0493   CB 21                  SLA   C   
0495   17                     RLA      
0496   30 01                  JR   NC,mus3   
0498   19                     ADD   HL,DE   
0499                MUS3:        
0499   29                     ADD   HL,HL   
049A   CB 21                  SLA   C   
049C   17                     RLA      
049D   30 01                  JR   NC,mus4   
049F   19                     ADD   HL,DE   
04A0                MUS4:        
04A0   29                     ADD   HL,HL   
04A1   CB 21                  SLA   C   
04A3   17                     RLA      
04A4   30 01                  JR   NC,mus5   
04A6   19                     ADD   HL,DE   
04A7                MUS5:        
04A7   29                     ADD   HL,HL   
04A8   CB 21                  SLA   C   
04AA   17                     RLA      
04AB   30 01                  JR   NC,mus6   
04AD   19                     ADD   HL,DE   
04AE                MUS6:        
04AE   29                     ADD   HL,HL   
04AF   CB 21                  SLA   C   
04B1   17                     RLA      
04B2   30 01                  JR   NC,mus7   
04B4   19                     ADD   HL,DE   
04B5                MUS7:        
04B5   29                     ADD   HL,HL   
04B6   CB 21                  SLA   C   
04B8   17                     RLA      
04B9   30 01                  JR   NC,mus8   
04BB   19                     ADD   HL,DE   
04BC                MUS8:        
04BC   29                     ADD   HL,HL   
04BD   CB 21                  SLA   C   
04BF   17                     RLA      
04C0   30 01                  JR   NC,mus9   
04C2   19                     ADD   HL,DE   
04C3                MUS9:        
