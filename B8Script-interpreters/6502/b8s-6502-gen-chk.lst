0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        Dividing by zero is not checked. -n? does no more editing than
0000                             ;        Backspace.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page. b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  One switch, set in the EQU line below:
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C
0000                             ;               (= z10+), KEYBUF at +34, the -n? line buffer at +80..+FF
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003   20 9C E1               JSR   rstip   
E006   20 90 E1     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B                          IF   CHECKED   
E00B   8D 34 04               STA   KEYBUF   ; (A = 0) no key held back
E00E                          ENDIF      
E00E   A5 00                  LDA   IP   
E010   8D 7C 04               STA   HEAP   
E013   A5 01                  LDA   IP+1   
E015   8D 7D 04               STA   HEAP+1   
E018   20 9C E1               JSR   rstip   
E01B   A2 FC                  LDX   #DSE   
E01D                             ; =============================================================================
E01D                             ;  The inner loop
E01D                             ; =============================================================================
E01D                NEXT:        
E01D                          IF   CHECKED   
E01D                             ; Both stacks are checked once per character. The data stack has
E01D                             ; overrun when X is above DSE (an overflow wraps X to FF, an underflow
E01D                             ; moves it up; no handler moves X by more than 2). The return stack
E01D                             ; has when S is below RSLIM (an underflow wraps S to 00-03).
E01D   E0 FD                  CPX   #DSE+1   
E01F   B0 4B                  BCS   e_stack   
E021   8A                     TXA      ; TSX trashes X: keep it in A
E022   BA                     TSX      
E023   E0 20                  CPX   #RSLIM   
E025   AA                     TAX      ; TAX leaves the carry alone
E026   90 47                  BCC   e_rstack   
E028                          ENDIF      
E028   20 2E E0               JSR   step   
E02B   4C 1D E0               JMP   next   
E02E                             ; step: read one character and sort it by range.
E02E                             ;    00h          end of program
E02E                             ;    01h-20h, 7Fh-FFh   ignored
E02E                             ;    30h-39h      digit: read a whole number
E02E                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E02E                             ;    61h-7Ah      a-z: push the address of that letter's cell
E02E                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E02E                             ; Every way out of the sort has the carry clear, except "ignored".
E02E   20 90 E1     STEP:     JSR   getc   ; flags follow A
E031   F0 36                  BEQ   endprog   
E033   38                     SEC      
E034   E9 21                  SBC   #21h   ; A = c - 21h
E036   90 30                  BCC   ign   ; 01h-20h
E038   C9 0F                  CMP   #0Fh   
E03A   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E03C   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E03E   C9 0A                  CMP   #10   
E040   90 32                  BCC   digit   
E042   C9 11                  CMP   #11h   
E044   90 16                  BCC   p3a   ; 3Ah-40h
E046   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E048   C9 1A                  CMP   #1Ah   
E04A   90 5D                  BCC   upper   ; 41h-5Ah
E04C   C9 20                  CMP   #20h   
E04E   90 0A                  BCC   p5b   ; 5Bh-60h
E050   C9 3A                  CMP   #3Ah   
E052   90 2D                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E054   C9 3E                  CMP   #3Eh   
E056   B0 10                  BCS   ign   ; 7Fh-FFh
E058                             ; The three adjustments below chain. Each ADC adds the carry the one
E058                             ; before it left, which the constants allow for.
E058   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E05A   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E05C   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E05E   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E05F   A8                     TAY      
E060   B9 16 E1               LDA   PTAB+1,Y   
E063   48                     PHA      
E064   B9 15 E1               LDA   PTAB,Y   
E067   48                     PHA      
E068   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E069                             ; directly, it just ends an ignored character.
E069   4C 09 FF     ENDPROG:   JMP   EXIT   
E06C                          IF   CHECKED   
E06C   A9 53        E_STACK:   LDA   #"S"   ; data stack over or under
E06E   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E06F   A9 52        E_RSTACK:   LDA   #"R"   ; return stack over or under
E071   4C D4 E4               JMP   error   
E074                          ENDIF      
E074                             ; Digits: the first one is in A; read the rest of the number.
E074   A8           DIGIT:    TAY      
E075   20 B1 E1               JSR   push   
E078   84 02                  STY   TL   
E07A   A9 00                  LDA   #0   
E07C   85 03                  STA   TH   
E07E   4C 7C E1               JMP   rdnum   
E081                             ; a-z: push the cell's address (the cell is the variable)
E081   0A           LOWER:    ASL      
E082   A8                     TAY      
E083   20 B1 E1               JSR   push   
E086   84 02                  STY   TL   
E088   A9 04                  LDA   #>LET   
E08A   85 03                  STA   TH   
E08C   60                     RTS      
E08D                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E08D                             ; the matching ")".
E08D   20 BD E1     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E090   F0 41                  BEQ   skip   
E092                             ; pushn: take the step frame off, push the reading position on the return
E092                             ; stack, and go on. With the carry set (a word call) the reading position
E092                             ; then becomes the address in the letter cell at LET,Y.
E092   68           PUSHN:    PLA      
E093   68                     PLA      ; drop the step frame
E094   A5 01                  LDA   IP+1   
E096   48                     PHA      
E097   A5 00                  LDA   IP   
E099   48                     PHA      
E09A   90 0A                  BCC   nxt   
E09C   B9 00 04               LDA   LET,Y   
E09F   85 00                  STA   IP   
E0A1   B9 01 04               LDA   LET+1,Y   
E0A4   85 01                  STA   IP+1   
E0A6   4C 1D E0     NXT:      JMP   next   
E0A9                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E0A9                             ; the return stack, and the IP becomes the address in the letter's cell.
E0A9   0A           UPPER:    ASL      
E0AA   A8                     TAY      
E0AB   38                     SEC      
E0AC   B0 E4                  BCS   pushn   ; always
E0AE                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E0AE                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E0AE                             ; the body"s address instead. Either way it then skips to the matching "]'.
E0AE                             ; (The unchecked build takes anything that is not a letter as the space; the
E0AE                             ; checked build stops on it.)
E0AE                          IF   CHECKED   
E0AE   C0 DF        DEF1:     CPY   #" "-"A"+256   
E0B0   F0 1E                  BEQ   def2   
E0B2   D0 48                  BNE   e_brack   ; anything but a letter or a space
E0B4                          ENDIF      
E0B4   20 90 E1     H_DEF:    JSR   getc   
E0B7   38                     SEC      
E0B8   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E0BA   A8                     TAY      ;   lands 64 bytes up
E0BB   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E0BD   C9 1A                  CMP   #26   
E0BF                          IF   1-CHECKED   
                              BCS   def2   ; not a letter
E0BF                          ENDIF      
E0BF                          IF   CHECKED   
E0BF   B0 ED                  BCS   def1   
E0C1                          ENDIF      
E0C1   98                     TYA      
E0C2   0A                     ASL      
E0C3   A8                     TAY      ; Y -> the cell
E0C4   A5 00                  LDA   IP   
E0C6   99 00 04               STA   LET,Y   
E0C9   A5 01                  LDA   IP+1   
E0CB   99 01 04               STA   LET+1,Y   
E0CE   D0 03                  BNE   skip   ; always: no program is in page zero
E0D0   20 A5 E1     DEF2:     JSR   puship   ; an anonymous block: push its address
E0D3                             ; skip: read past text to the closer at this level, and return it in A.
E0D3                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0D3                             ; NUL first ends the program.
E0D3   A9 00        SKIP:     LDA   #0   
E0D5   85 06                  STA   T2   ; depth
E0D7   20 90 E1     SK1:      JSR   getc   
E0DA   F0 8D                  BEQ   endprog   
E0DC   C9 22                  CMP   #22h   
E0DE   D0 03                  BNE   sk2   
E0E0   20 04 E1               JSR   skipstr   ; leaves A = 22h, which matches nothing below
E0E3   C9 28        SK2:      CMP   #"("   
E0E5   F0 11                  BEQ   sk3   
E0E7   C9 5B                  CMP   #"["   
E0E9   F0 0D                  BEQ   sk3   
E0EB   C9 29                  CMP   #")"   
E0ED   F0 04                  BEQ   sk4   
E0EF   C9 5D                  CMP   #"]"   
E0F1   D0 E4                  BNE   sk1   
E0F3   C6 06        SK4:      DEC   T2   
E0F5   10 E0                  BPL   sk1   
E0F7   60                     RTS      ; the closer at this level
E0F8   E6 06        SK3:      INC   T2   
E0FA   D0 DB                  BNE   sk1   
E0FC                          IF   CHECKED   
E0FC   A9 44        E_BRACK:   LDA   #"D"   ; bad character after [
E0FE   4C D4 E4               JMP   error   
E101                          ENDIF      
E101                             ; 22h pushes the address of the text after it and skips the string.
E101   20 A5 E1     H_STR:    JSR   puship   
E104                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E104                             ; the next character, so "/"" does not end it. Returns with Z set, A = 22h.
E104   20 90 E1     SKIPSTR:   JSR   getc   
E107   C9 2F                  CMP   #"/"   
E109   F0 05                  BEQ   ss0   
E10B   C9 22                  CMP   #22h   
E10D   D0 F5                  BNE   skipstr   
E10F   60                     RTS      
E110   20 93 E1     SS0:      JSR   incip   
E113   D0 EF                  BNE   skipstr   ; A is "/" here
E115                             ; =============================================================================
E115                             ;  Dispatch table: one handler per punctuation character, in code order.
E115                             ;  Entries are handler-1 for the RTS trick.
E115                             ; =============================================================================
E115   C5 E1        PTAB:     DW   h_store-1   ; !
E117   00 E1                  DW   h_str-1   ; "
E119   BD E3                  DW   h_num-1   ; #
E11B   9F E3                  DW   h_print-1   ; $
E11D   E3 E2                  DW   h_swap-1   ; %
E11F   38 E2                  DW   h_and-1   ; &
E121   B5 E3                  DW   h_emit-1   ; '
E123   8C E0                  DW   h_open-1   ; (
E125   0B E2                  DW   h_close-1   ; )
E127   BB E2                  DW   h_mul-1   ; *
E129   6A E2                  DW   h_add-1   ; +
E12B   F8 E3                  DW   h_cfetch-1   ; ,
E12D   62 E2                  DW   h_sub-1   ; -
E12F   D7 E1                  DW   h_cstore-1   ; .
E131   F8 E2                  DW   h_div-1   ; /
E133   B0 E1                  DW   push-1   ; :
E135   E4 E1                  DW   drop-1   ; ;
E137   99 E2                  DW   h_lt-1   ; <
E139   AB E2                  DW   h_eq-1   ; =
E13B   96 E2                  DW   h_gt-1   ; >
E13D   01 E4                  DW   h_key-1   ; ?
E13F   EC E3                  DW   h_fetch-1   ; @
E141   B3 E0                  DW   h_def-1   ; [
E143   25 E2                  DW   h_break-1   ; \
E145   11 E2                  DW   h_ret-1   ; ]
E147   54 E2                  DW   h_xor-1   ; ^
E149   66 E3                  DW   h_alloc-1   ; _
E14B   62 E4                  DW   h_grave-1   ; `
E14D   F0 E1                  DW   h_tor-1   ; {
E14F   46 E2                  DW   h_or-1   ; |
E151   FD E1                  DW   h_fromr-1   ; }
E153   82 E2                  DW   h_not-1   ; ~
E155                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E155                             ; test is at the bottom so the loop closes with a branch. Returns with the
E155                             ; carry set.
E155   20 93 E1     RD1:      JSR   incip   ; (keeps A = the digit)
E158   06 02                  ASL   TL   
E15A   26 03                  ROL   TH   ; x2
E15C   18                     CLC      
E15D   65 02                  ADC   TL   
E15F   85 04                  STA   T0   
E161   A5 03                  LDA   TH   
E163   69 00                  ADC   #0   
E165   85 05                  STA   T1   ; T = x2 + digit
E167   06 02                  ASL   TL   
E169   26 03                  ROL   TH   
E16B   06 02                  ASL   TL   
E16D   26 03                  ROL   TH   ; x8
E16F   18                     CLC      
E170   A5 02                  LDA   TL   
E172   65 04                  ADC   T0   
E174   85 02                  STA   TL   
E176   A5 03                  LDA   TH   
E178   65 05                  ADC   T1   
E17A   85 03                  STA   TH   ; x8 + x2 + digit
E17C   20 82 E1     RDNUM:    JSR   isdig   
E17F   90 D4                  BCC   rd1   
E181   60                     RTS      
E182                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E182                             ; digit. Y = 0.
E182   20 8B E1     ISDIG:    JSR   peek   
E185   38                     SEC      
E186   E9 30                  SBC   #"0"   
E188   C9 0A                  CMP   #10   
E18A   60                     RTS      
E18B                             ; =============================================================================
E18B                             ;  Reading the program
E18B                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E18B                             ;    getc: the same, then IP moves on; flags follow A
E18B                             ;    incip: IP moves on; keeps A, the carry and Y
E18B                             ; =============================================================================
E18B   A0 00        PEEK:     LDY   #0   
E18D   B1 00                  LDA   (IP),Y   
E18F   60                     RTS      
E190   20 8B E1     GETC:     JSR   peek   
E193   E6 00        INCIP:    INC   IP   
E195   D0 02                  BNE   ic1   
E197   E6 01                  INC   IP+1   
E199   09 00        IC1:      ORA   #0   
E19B   60                     RTS      
E19C                             ; rstip: point IP at the start of the program
E19C   A9 00        RSTIP:    LDA   #<PROG   
E19E   85 00                  STA   IP   
E1A0   A9 05                  LDA   #>PROG   
E1A2   85 01                  STA   IP+1   
E1A4   60                     RTS      
E1A5                             ; =============================================================================
E1A5                             ;  Stack
E1A5                             ; =============================================================================
E1A5   20 B1 E1     PUSHIP:   JSR   push   ; push the reading position
E1A8   A5 00                  LDA   IP   
E1AA   85 02                  STA   TL   
E1AC   A5 01                  LDA   IP+1   
E1AE   85 03                  STA   TH   
E1B0   60                     RTS      
E1B1   CA           PUSH:     DEX      ; ":" and every push
E1B2   A5 02                  LDA   TL   
E1B4   9D 00 02               STA   DSL,X   
E1B7   A5 03                  LDA   TH   
E1B9   9D 00 03               STA   DSH,X   
E1BC   60                     RTS      
E1BD                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E1BD   A5 02        FLAG:     LDA   TL   
E1BF   05 03                  ORA   TH   
E1C1   20 E5 E1               JSR   drop   
E1C4   A8                     TAY      ; (drop's INX changed the flags)
E1C5   60                     RTS      
E1C6                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E1C6                H_STORE:      
E1C6                          IF   CHECKED   
E1C6   A5 02                  LDA   TL   ; both bytes must be in the program's space:
E1C8   69 01                  ADC   #1   ; check the page of addr+1 (the carry is
E1CA   A5 03                  LDA   TH   ; clear on the way in)
E1CC   69 00                  ADC   #0   
E1CE   20 8C E3               JSR   chkst   
E1D1                          ENDIF      
E1D1   BD 00 03               LDA   DSH,X   
E1D4   A0 01                  LDY   #1   
E1D6   91 02                  STA   (TL),Y   
E1D8                H_CSTORE:      ; "." ( c addr -- )
E1D8                          IF   CHECKED   
E1D8   A5 03                  LDA   TH   
E1DA   20 8C E3               JSR   chkst   
E1DD                          ENDIF      
E1DD   BD 00 02               LDA   DSL,X   
E1E0   A0 00                  LDY   #0   
E1E2   91 02                  STA   (TL),Y   
E1E4   E8                     INX      ; falls into drop
E1E5                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E1E5                             ; it returns with Z clear.
E1E5   BC 00 02     DROP:     LDY   DSL,X   
E1E8   84 02                  STY   TL   
E1EA   BC 00 03               LDY   DSH,X   
E1ED   84 03                  STY   TH   
E1EF   E8                     INX      
E1F0   60                     RTS      
E1F1                             ; "{" TOS to the return stack, "}" return stack to TOS
E1F1   68           H_TOR:    PLA      
E1F2   68                     PLA      
E1F3   A5 03                  LDA   TH   
E1F5   48                     PHA      
E1F6   A5 02                  LDA   TL   
E1F8   48                     PHA      
E1F9   20 E5 E1               JSR   drop   
E1FC   D0 0B                  BNE   nxt2   ; always
E1FE   68           H_FROMR:   PLA      
E1FF   68                     PLA      
E200   20 B1 E1               JSR   push   
E203   68                     PLA      
E204   85 02                  STA   TL   
E206   68                     PLA      
E207   85 03                  STA   TH   
E209   4C 1D E0     NXT2:     JMP   next   
E20C                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E20C                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E20C                             ; it is here, the address popped is pushed back.
E20C   20 BD E1     H_CLOSE:   JSR   flag   
E20F   F0 21                  BEQ   rdrop   
E211   24                     DB   24h   ; (BIT zp: steps over the SEC)
E212                             ; "]" returns: pull an address and jump to it.
E212   38           H_RET:    SEC      
E213                          IF   CHECKED   
E213   20 C3 E4               JSR   chkbrk   ; Ctrl-C is checked at every loop-back and
E216                          ENDIF      ;   every word return (it keeps the carry)
E216   68                     PLA      
E217   68                     PLA      ; drop the step frame
E218   68                     PLA      
E219   85 00                  STA   IP   
E21B   68                     PLA      
E21C   85 01                  STA   IP+1   
E21E   B0 E9                  BCS   nxt2   
E220   48                     PHA      ; ")": keep the block start
E221   A5 00                  LDA   IP   
E223   48                     PHA      
E224   90 E3                  BCC   nxt2   ; always
E226                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E226                             ; drops the block start, "]" returns.
E226   20 BD E1     H_BREAK:   JSR   flag   
E229   F0 6B                  BEQ   ab9   
E22B   20 D3 E0               JSR   skip   
E22E   C9 29                  CMP   #")"   
E230   D0 E0                  BNE   h_ret   
E232   68           RDROP:    PLA      
E233   68                     PLA      
E234   68                     PLA      
E235   68                     PLA      
E236   4C 1D E0               JMP   next   
E239                             ; =============================================================================
E239                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E239                             ; =============================================================================
E239                             ; The logic operators leave the carry as they found it, clear, so they can
E239                             ; branch to fin.
E239   BD 00 02     H_AND:    LDA   DSL,X   
E23C   25 02                  AND   TL   
E23E   85 02                  STA   TL   
E240   BD 00 03               LDA   DSH,X   
E243   25 03                  AND   TH   
E245   90 31                  BCC   fin   ; always
E247   BD 00 02     H_OR:     LDA   DSL,X   
E24A   05 02                  ORA   TL   
E24C   85 02                  STA   TL   
E24E   BD 00 03               LDA   DSH,X   
E251   05 03                  ORA   TH   
E253   90 23                  BCC   fin   ; always
E255   BD 00 02     H_XOR:    LDA   DSL,X   
E258   45 02                  EOR   TL   
E25A   85 02                  STA   TL   
E25C   BD 00 03               LDA   DSH,X   
E25F   45 03                  EOR   TH   
E261   90 15                  BCC   fin   ; always
E263                             ; "-" has two jobs: directly before a digit it starts a negative number.
E263   20 82 E1     H_SUB:    JSR   isdig   
E266   90 14                  BCC   negnum   
E268   20 89 E2     SUB1:     JSR   neg   ; a - b = a + (-b)
E26B   18           H_ADD:    CLC      
E26C   BD 00 02               LDA   DSL,X   
E26F   65 02                  ADC   TL   
E271   85 02                  STA   TL   
E273   BD 00 03               LDA   DSH,X   
E276   65 03                  ADC   TH   ; falls into fin
E278                             ; fin: finish a two-operand op: A = the high byte of the result
E278   85 03        FIN:      STA   TH   
E27A   E8                     INX      
E27B   60                     RTS      
E27C   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E27E   20 74 E0               JSR   digit   ; (comes back with the carry set)
E281   B0 06                  BCS   neg   ; always: the number, negated
E283                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E283   90 05        H_NOT:    BCC   neg1   ; always
E285                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E285   A5 03        ABSV:     LDA   TH   
E287   10 0D        NEGM:     BPL   ab9   
E289                             ; neg: TOS = -TOS
E289   38           NEG:      SEC      
E28A   A9 00        NEG1:     LDA   #0   
E28C   E5 02                  SBC   TL   
E28E   85 02                  STA   TL   
E290   A9 00                  LDA   #0   
E292   E5 03                  SBC   TH   
E294   85 03                  STA   TH   
E296   60           AB9:      RTS      
E297                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E297                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E297   20 E4 E2     H_GT:     JSR   h_swap   ; a > b is b < a
E29A   BD 00 02     H_LT:     LDA   DSL,X   
E29D   C5 02                  CMP   TL   
E29F   BD 00 03               LDA   DSH,X   
E2A2   E5 03                  SBC   TH   
E2A4   70 02                  BVS   lt1   
E2A6   49 80                  EOR   #80h   
E2A8   0A           LT1:      ASL      
E2A9   E8                     INX      ; (keeps the carry; never leaves X at 0)
E2AA   D0 07                  BNE   bool   ; always
E2AC   20 68 E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E2AF   05 02                  ORA   TL   
E2B1   C9 01                  CMP   #1   ; carry clear if A = 0
E2B3   A9 00        BOOL:     LDA   #0   
E2B5   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E2B7   85 02                  STA   TL   
E2B9   85 03                  STA   TH   
E2BB   60                     RTS      
E2BC                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E2BC                             ; bottom while the product comes in at the top, through A:T0 above it; after
E2BC                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E2BC   A0 10        H_MUL:    LDY   #16   
E2BE   84 05                  STY   T1   ; the round count
E2C0   A9 00                  LDA   #0   
E2C2   85 04                  STA   T0   ; A:T0 = the upper half
E2C4   46 03                  LSR   TH   
E2C6   66 02                  ROR   TL   ; the first multiplier bit
E2C8   90 0D        ML1:      BCC   ml2   
E2CA   A8                     TAY      
E2CB   18                     CLC      
E2CC   A5 04                  LDA   T0   
E2CE   7D 00 02               ADC   DSL,X   
E2D1   85 04                  STA   T0   
E2D3   98                     TYA      
E2D4   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E2D7   6A           ML2:      ROR      
E2D8   66 04                  ROR   T0   
E2DA   66 03                  ROR   TH   
E2DC   66 02                  ROR   TL   ; everything one place right; next bit out
E2DE   C6 05                  DEC   T1   
E2E0   D0 E6                  BNE   ml1   
E2E2   E8                     INX      ; drop the multiplicand
E2E3   60                     RTS      
E2E4   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E2E7   A5 02                  LDA   TL   
E2E9   9D 00 02               STA   DSL,X   
E2EC   84 02                  STY   TL   
E2EE   BC 00 03               LDY   DSH,X   
E2F1   A5 03                  LDA   TH   
E2F3   9D 00 03               STA   DSH,X   
E2F6   84 03                  STY   TH   
E2F8   60                     RTS      
E2F9                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E2F9                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E2F9                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
E2F9   BD 00 03     H_DIV:    LDA   DSH,X   
E2FC   48                     PHA      ; a's sign: for r
E2FD   45 03                  EOR   TH   
E2FF   48                     PHA      ; a xor b: for q
E300   20 85 E2               JSR   absv   
E303   A5 02                  LDA   TL   
E305   85 08                  STA   D0   
E307   A5 03                  LDA   TH   
E309   85 09                  STA   D1   ; D = |b|
E30B   BD 00 02               LDA   DSL,X   
E30E   85 02                  STA   TL   
E310   BD 00 03               LDA   DSH,X   
E313   85 03                  STA   TH   
E315   20 85 E2               JSR   absv   ; TOS = |a|
E318   20 26 E3               JSR   udiv   ; TOS = q, NOS = r
E31B   68                     PLA      
E31C   20 87 E2               JSR   negm   ; q's sign
E31F   20 E4 E2               JSR   h_swap   ; r on top
E322   68                     PLA      
E323   4C 87 E2               JMP   negm   ; r's sign
E326                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E326                             ; cell the remainder (whatever was there is lost).
E326                             ; Dividing by 2 is one shift (the spec wants that fast).
E326   A9 00        UDIV:     LDA   #0   
E328   9D 00 02               STA   DSL,X   
E32B   9D 00 03               STA   DSH,X   
E32E   A5 08                  LDA   D0   
E330   49 02                  EOR   #2   
E332   05 09                  ORA   D1   
E334   D0 08                  BNE   ud0   
E336   46 03                  LSR   TH   
E338   66 02                  ROR   TL   ; the quotient
E33A   3E 00 02               ROL   DSL,X   ; the remainder: the bit that fell out
E33D   60                     RTS      
E33E   A0 10        UD0:      LDY   #16   
E340   06 02        UD1:      ASL   TL   
E342   26 03                  ROL   TH   
E344   3E 00 02               ROL   DSL,X   
E347   3E 00 03               ROL   DSH,X   
E34A   38                     SEC      
E34B   BD 00 02               LDA   DSL,X   
E34E   E5 08                  SBC   D0   
E350   85 04                  STA   T0   
E352   BD 00 03               LDA   DSH,X   
E355   E5 09                  SBC   D1   
E357   90 0A                  BCC   ud2   
E359   9D 00 03               STA   DSH,X   
E35C   A5 04                  LDA   T0   
E35E   9D 00 02               STA   DSL,X   
E361   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E363   88           UD2:      DEY      
E364   D0 DA                  BNE   ud1   
E366   60           UD9:      RTS      
E367                             ; =============================================================================
E367                             ;  Storage
E367                             ; =============================================================================
E367                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
E367                             ; (The carry is clear on the way in.)
E367   AD 7C 04     H_ALLOC:   LDA   HEAP   
E36A   A8                     TAY      
E36B   65 02                  ADC   TL   
E36D   8D 7C 04               STA   HEAP   
E370   84 02                  STY   TL   
E372   AD 7D 04               LDA   HEAP+1   
E375   A8                     TAY      
E376   65 03                  ADC   TH   
E378                          IF   CHECKED   
E378   B0 0A                  BCS   e_heap   ; a negative count wraps: too big
E37A   C9 E0                  CMP   #HEAPLIM   
E37C   B0 06                  BCS   e_heap   ; the new top must stay below the limit page
E37E                          ENDIF      
E37E   8D 7D 04               STA   HEAP+1   
E381   84 03                  STY   TH   
E383   60                     RTS      
E384                          IF   CHECKED   
E384   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit
E386   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E387   A9 57        E_STORE:   LDA   #"W"   ; write outside the program's space
E389   4C D4 E4               JMP   error   
E38C                             ; chkst: stop unless the page in A is in the program's own space, from the
E38C                             ; letter page up to the heap limit. Keeps Y.
E38C   C9 04        CHKST:    CMP   #LETPAGE   
E38E   90 F7                  BCC   e_store   
E390   C9 E0                  CMP   #HEAPLIM   
E392   B0 F3                  BCS   e_store   
E394   60                     RTS      
E395                          ENDIF      
E395                             ; =============================================================================
E395                             ;  Console
E395                             ; =============================================================================
E395                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E395   A0 00        TOSGET:   LDY   #0   
E397   B1 02                  LDA   (TL),Y   
E399   E6 02        INCTOS:   INC   TL   
E39B   D0 02                  BNE   tg1   
E39D   E6 03                  INC   TH   
E39F   60           TG1:      RTS      
E3A0                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E3A0                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E3A0                             ; bit 6, so // and /" give themselves).
E3A0   20 95 E3     H_PRINT:   JSR   tosget   
E3A3   C9 22                  CMP   #22h   
E3A5   F0 14                  BEQ   pdrop   
E3A7   C9 2F                  CMP   #"/"   
E3A9   D0 05                  BNE   pr1   
E3AB   20 95 E3               JSR   tosget   
E3AE   29 BF                  AND   #0BFh   
E3B0   20 03 FF     PR1:      JSR   CONOUT   
E3B3   4C A0 E3               JMP   h_print   
E3B6   A5 02        H_EMIT:   LDA   TL   ; "'"
E3B8   20 03 FF               JSR   CONOUT   
E3BB   4C E5 E1     PDROP:    JMP   drop   
E3BE                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E3BE                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E3BE                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E3BE   A5 03        H_NUM:    LDA   TH   
E3C0   10 08                  BPL   pn1   
E3C2   A9 2D                  LDA   #"-"   
E3C4   20 03 FF               JSR   CONOUT   
E3C7   20 89 E2               JSR   neg   
E3CA   CA           PN1:      DEX      ; the spare cell
E3CB   A9 0A                  LDA   #10   
E3CD   85 08                  STA   D0   
E3CF   A9 00                  LDA   #0   
E3D1   85 09                  STA   D1   
E3D3   48                     PHA      ; the end marker
E3D4   20 26 E3     PN2:      JSR   udiv   
E3D7   BD 00 02               LDA   DSL,X   
E3DA   09 30                  ORA   #"0"   
E3DC   48                     PHA      
E3DD   A5 02                  LDA   TL   
E3DF   05 03                  ORA   TH   
E3E1   D0 F1                  BNE   pn2   
E3E3   E8                     INX      
E3E4   68           PN3:      PLA      
E3E5   F0 D4                  BEQ   pdrop   
E3E7   20 03 FF               JSR   CONOUT   
E3EA   4C E4 E3               JMP   pn3   
E3ED   A0 01        H_FETCH:   LDY   #1   ; "@"
E3EF   B1 02                  LDA   (TL),Y   
E3F1   48                     PHA      ; the high byte, while "," gets the low one
E3F2   20 F9 E3               JSR   h_cfetch   
E3F5   68                     PLA      
E3F6   85 03                  STA   TH   
E3F8   60                     RTS      
E3F9                H_CFETCH:      ; ","
E3F9   A0 00                  LDY   #0   
E3FB   B1 02                  LDA   (TL),Y   
E3FD   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E3FF   84 03                  STY   TH   
E401   60                     RTS      
E402                             ; "?" ( n -- c ) or ( -n -- addr )
E402                             ;   n > 0: wait about n ms for a key; 0 if none came
E402                             ;   n = 0: wait for a key
E402                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E402                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E402   A5 03        H_KEY:    LDA   TH   
E404   30 20                  BMI   line   
E406   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E408   20 B3 E4     KT2:      JSR   getk   
E40B   D0 15                  BNE   kt3   
E40D   88                     DEY      
E40E   D0 F8                  BNE   kt2   
E410   A5 02                  LDA   TL   ; count the millisecond off:
E412   D0 06                  BNE   kt4   
E414   A5 03                  LDA   TH   
E416   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E418   C6 03                  DEC   TH   
E41A   C6 02        KT4:      DEC   TL   
E41C   D0 E8                  BNE   kt1   
E41E   A5 03                  LDA   TH   
E420   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E422   A0 00        KT3:      LDY   #0   
E424   F0 D7                  BEQ   cf2   ; always: TOS = A
E426                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E426                             ; (stored, not echoed), every other key is stored and echoed until the line
E426                             ; is full. Y = the length so far; TL = the most allowed.
E426   20 89 E2     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E429   D0 04                  BNE   ln0   
E42B   A5 02                  LDA   TL   
E42D   10 04                  BPL   ln1   
E42F   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E431   85 02                  STA   TL   
E433   A0 00        LN1:      LDY   #0   
E435   F0 03                  BEQ   ln2   ; always
E437   20 03 FF     LN3:      JSR   CONOUT   
E43A   20 B3 E4     LN2:      JSR   getk   
E43D   F0 FB                  BEQ   ln2   
E43F   C9 0D                  CMP   #13   
E441   F0 14                  BEQ   ln5   
E443   C9 08                  CMP   #8   
E445   F0 0A                  BEQ   ln4   
E447   C4 02                  CPY   TL   
E449   B0 EF                  BCS   ln2   ; full
E44B   99 80 04               STA   LINEBUF,Y   
E44E   C8                     INY      
E44F   D0 E6                  BNE   ln3   ; always: echo it
E451   88           LN4:      DEY      ; Backspace: one back, and echo it,
E452   10 E3                  BPL   ln3   
E454   C8                     INY      ;   unless the line was empty
E455   F0 E3                  BEQ   ln2   ; always
E457   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E45A   A9 80                  LDA   #<LINEBUF   
E45C   85 02                  STA   TL   
E45E   A9 04                  LDA   #>LINEBUF   
E460   85 03                  STA   TH   
E462   60                     RTS      
E463                             ; =============================================================================
E463                             ;  Machine code: the grave
E463                             ; =============================================================================
E463                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E463                             ; are stored from addr until a non-hex character; then a RET (60h) is
E463                             ; written and its address is left. An odd last digit is consumed and dropped.
E463                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E463                             ; contract in the header.
E463   20 A0 E4     H_GRAVE:   JSR   rdhex   
E466   B0 2A                  BCS   exec   
E468   0A           HX1:      ASL      
E469   0A                     ASL      
E46A   0A                     ASL      
E46B   0A                     ASL      
E46C   85 04                  STA   T0   
E46E   20 A0 E4               JSR   rdhex   
E471   B0 15                  BCS   hx2   ; odd digit: already consumed, dropped
E473   05 04                  ORA   T0   
E475                          IF   CHECKED   
E475   85 04                  STA   T0   
E477   A5 03                  LDA   TH   
E479   20 8C E3               JSR   chkst   
E47C   A5 04                  LDA   T0   
E47E                          ENDIF      
E47E   91 02                  STA   (TL),Y   ; Y is 0 after rdhex
E480   20 99 E3               JSR   inctos   
E483   20 A0 E4               JSR   rdhex   
E486   90 E0                  BCC   hx1   
E488                HX2:         
E488                          IF   CHECKED   
E488   A5 03                  LDA   TH   
E48A   20 8C E3               JSR   chkst   
E48D                          ENDIF      
E48D   A9 60                  LDA   #60h   
E48F   91 02                  STA   (TL),Y   
E491   60                     RTS      
E492   A5 02        EXEC:     LDA   TL   
E494   85 04                  STA   T0   
E496   A5 03                  LDA   TH   
E498   85 05                  STA   T1   
E49A   20 E5 E1               JSR   drop   ; the address is consumed
E49D   6C 04 00               JMP   (T0)   
E4A0                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E4A0                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E4A0                             ; Y = 0.
E4A0   20 82 E1     RDHEX:    JSR   isdig   
E4A3   90 0A                  BCC   rh1   
E4A5   29 DF                  AND   #0DFh   
E4A7   E9 11                  SBC   #11h   ; (the carry is set)
E4A9   C9 06                  CMP   #6   
E4AB   B0 05                  BCS   rh9   
E4AD   69 0A                  ADC   #10   
E4AF   4C 93 E1     RH1:      JMP   incip   
E4B2   60           RH9:      RTS      
E4B3                             ; =============================================================================
E4B3                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E4B3                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E4B3                             ;  Both keep X and Y. In the unchecked build getk is the host's KEY itself.
E4B3                             ; =============================================================================
E4B3                          IF   1-CHECKED   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
E4B3                          ENDIF      
E4B3                          IF   CHECKED   
E4B3   AD 34 04     GETK:     LDA   KEYBUF   ; a key held back by the break check
E4B6   F0 08                  BEQ   gk1   
E4B8   48                     PHA      
E4B9   A9 00                  LDA   #0   
E4BB   8D 34 04               STA   KEYBUF   
E4BE   68                     PLA      
E4BF   60                     RTS      
E4C0   4C 06 FF     GK1:      JMP   KEY   
E4C3                          ENDIF      
E4C3                             ; =============================================================================
E4C3                             ;  Checked build: break key and error reports
E4C3                             ; =============================================================================
E4C3                          IF   CHECKED   
E4C3                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
E4C3                             ; else is held for the next "?". Keeps the flags.
E4C3   08           CHKBRK:   PHP      
E4C4   20 B3 E4               JSR   getk   
E4C7   F0 07                  BEQ   cb9   
E4C9   C9 03                  CMP   #3   
E4CB   F0 05                  BEQ   e_break   
E4CD   8D 34 04               STA   KEYBUF   
E4D0   28           CB9:      PLP      
E4D1   60                     RTS      
E4D2   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C
E4D4                             ; error: print the letter in A, " @ " and the offset in the program of the
E4D4                             ; character just read, then end. For example: S @ 245
E4D4                             ; The hardware stack is left as it is: it wraps inside its page, so the
E4D4                             ; calls below work whatever state it is in.
E4D4   A2 FC        ERROR:    LDX   #DSE   ; (the number printer uses a data cell)
E4D6   20 03 FF               JSR   CONOUT   
E4D9   A9 20                  LDA   #" "   
E4DB   20 03 FF               JSR   CONOUT   
E4DE   A9 40                  LDA   #"@"   
E4E0   20 03 FF               JSR   CONOUT   
E4E3   A9 20                  LDA   #" "   
E4E5   20 03 FF               JSR   CONOUT   
E4E8   A5 00                  LDA   IP   
E4EA   38                     SEC      
E4EB   E9 01                  SBC   #<PROG1   ; the character just read
E4ED   85 02                  STA   TL   
E4EF   A5 01                  LDA   IP+1   
E4F1   E9 05                  SBC   #>PROG1   
E4F3   85 03                  STA   TH   
E4F5   20 BE E3               JSR   h_num   
E4F8   4C 69 E0               JMP   endprog   
E4FB                          ENDIF      


