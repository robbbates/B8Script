   383                              <1> 
   384                              <1> ; '_' ( n -- addr ): the heap pointer moves by n, a signed count; TOS is
   385                              <1> ; the old pointer. The checked build stops with H if the new top is not
   386                              <1> ; below the limit or is below the program's end (done in 32 bits, so a top
   387                              <1> ; that wraps round is caught too).
   388                              <1> %macro  ALLOCCODE 0
   389                              <1> alloc1: movzx   edx,word [ARENA+HEAP]
   390                              <1> %if CHECKED
   391                              <1>         movsx   eax,bx
   392                              <1>         add     eax,edx
   393                              <1>         cmp     eax,LIMIT
   394                              <1>         jae     e_heap
   395                              <1>         cmp     eax,[V(v_npend)]
   396                              <1>         jb      e_heap
   397                              <1> %endif
   398                              <1>         add     [ARENA+HEAP],bx
   399                              <1>         mov     bx,dx
   400                              <1>         jmp     ebp
   401                              <1> %endmacro
   402                              <1> 
   403                              <1> ; '/' ( a b -- q r ): truncates toward zero, and r takes a's sign: x86's
   404                              <1> ; IDIV does exactly that. It is done in 32 bits, so that -32768 / -1 (whose
   405                              <1> ; quotient, 32768, does not fit in 16) wraps as the spec says instead of
   406                              <1> ; faulting. Dividing by 0 skips the IDIV in an unchecked build (two cells of
   407                              <1> ; no meaning: a and its sign); the checked build stops with Z. (The handler
   408                              <1> ; itself in an unchecked build; in a checked one its body, div1.)
   409                              <1> %macro  DIVCODE 0
   410                              <1> %if CHECKED
   411                              <1>         test    bx,bx
   412                              <1>         jz      e_zero
   413                              <1> %endif
   414                              <1>         pop     eax
   415                              <1>         movsx   ecx,bx
   416                              <1>         cwde
   417                              <1>         cdq
   418                              <1> %if CHECKED=0
   419                              <1>         jecxz   %%z
   420                              <1> %endif
   421                              <1>         idiv    ecx
   422                              <1> %%z:    mov     bx,ax
   423                              <1>         push    ebx                     ; q
   424                              <1>         mov     bx,dx                   ; r on top
   425                              <1>         jmp     ebp
   426                              <1> %endmacro
   427                              <1> 
   428                              <1> ; PRLOOPCODE: the loop of '$' (h_print; in a checked build the routine
   429                              <1> ; prstr). It prints from EBX to the closing quote.
   430                              <1> %macro  PRLOOPCODE 0
   431                              <1> %%pr:   mov     al,[ebx]
   432                              <1>         inc     ebx
   433                              <1>         cmp     al,22h
   434                              <1> %if CHECKED
   435                              <1>         je      %%pr9
   436                              <1>         test    al,al
   437                              <1>         jz      e_dollar                ; a NUL first: Q
   438                              <1> %else
   439                              <1>         je      h_drop
   440                              <1> %endif
   441                              <1>         cmp     al,'/'
   442                              <1>         jne     prput
   443                              <1>         movzx   eax,byte [ebx]
   444                              <1>         inc     ebx
   445                              <1>         cmp     al,60h
   446                              <1>         jb      %%pr0
   447                              <1>         cmp     al,7Fh
   448                              <1>         jb      pesc
   449                              <1> %%pr0:  and     al,0BFh
   450                              <1> prput:  CALLP   putc                    ; (/~ comes here with its 'H')
   451                              <1>         jmp     %%pr
   452                              <1> %if CHECKED
   453                              <1> %%pr9:  ret
   454                              <1> %endif
   455                              <1> %endmacro
   456                              <1> 
   457                              <1> ; PESCCODE: prstr (checked builds) and the escapes of '$'. (After the
   458                              <1> ; bodies of '[', '_' and '`' in an unchecked build, so that h_print's loop
   459                              <1> ; reaches pesc; after the report in a checked one.)
   460                              <1> %macro  PESCCODE 0
   461                              <1> %if CHECKED
   462                              <1> ; prstr: print the string at EBX, to its closing quote, decoding '/' (this
   463                              <1> ; is '$', and the texts of the report). EBX is left past the quote. A NUL
   464                              <1> ; first is an error: Q.
   465                              <1> prstr:  PRLOOPCODE
   466                              <1> PRLOOP  equ     prstr                   ; (where the escapes go back to)
   467                              <1> %else
   468                              <1> PRLOOP  equ     h_print
   469                              <1> %endif
   470                              <1> 
   471                              <1> ; /~ ( row col addr -- ): the two cells under the string's address go.
   472                              <1> ; It comes before pesc: from there the short jumps reach h_print's loop.
   473                              <1> ; In a checked build the loop is the routine prstr: its return address
   474                              <1> ; goes, and hp1 calls it again afterwards. Before each /~ chkstk looks at
   475                              <1> ; the stack, as `next` does before each character: a /~ that finds it run
   476                              <1> ; out already is s at once. One that takes its row or column from past the
   477                              <1> ; bottom (at most two cells past, from the frame above the stack, which is
   478                              <1> ; never returned to) is s after the '$', as for any other character.
   479                              <1> pat:
   480                              <1> %if CHECKED
   481                              <1>         pop     eax
   482                              <1>         call    chkstk
   483                              <1> %endif
   484                              <1>         call    pcsi
   485                              <1>         pop     eax                     ; the column
   486                              <1>         xchg    eax,[esp]               ; the row (the column waits)
   487                              <1>         call    psgn1
   488                              <1>         mov     al,';'
   489                              <1>         CALLP   putc
   490                              <1>         pop     eax
   491                              <1>         call    psgn1
   492                              <1>         mov     al,'H'
   493                              <1> %if CHECKED
   494                              <1>         CALLP   putc
   495                              <1>         jmp     hp1
   496                              <1> %else
   497                              <1>         jmp     prput
   498                              <1> %endif
   499                              <1> 
   500                              <1> ; pesc: the escapes of '$'. EAX = the character after the '/', 60h to 7Eh,
   501                              <1> ; and EBX points past it. Each goes back into the loop (PRLOOP), but /~ has
   502                              <1> ; the stack to see to.
   503                              <1> ;    /a-/z   print the variable, as '#' does
   504                              <1> ;    /{      clear the screen, the cursor to the top left: ESC [ H ESC [ J
   505                              <1> ;    /}      clear from the cursor to the end of the line: ESC [ K
   506                              <1> ;    /|  /`  show the cursor, hide it: ESC [ ? 2 5 h, ESC [ ? 2 5 l
   507                              <1> ;    /~      ( row col -- ) the cursor to that row and column, from 0:
   508                              <1> ;            ESC [ row+1 ; col+1 H
   509                              <1> pesc:   cmp     al,7Eh
   510                              <1>         je      pat
   511                              <1>         push    PRLOOP                  ; (the others return into the loop)
   512                              <1>         cmp     al,7Bh
   513                              <1>         jae     pcon
   514                              <1>         cmp     al,60h
   515                              <1>         je      phide
   516                              <1>         mov     ax,[ARENA+LET-2*41h+eax*2]  ; a-z: the variable's cell (as in
   517                              <1>         jmp     psgn                    ;   `lower`)
   518                              <1> pcon:   mov     eax,[ptails-4*7Bh+eax*4] ; { | }
   519                              <1> pseq:   push    eax                     ; ESC [ and then the bytes of EAX
   520                              <1>         call    pcsi
   521                              <1>         pop     eax
   522                              <1>         jmp     pch
   523                              <1> phide:  mov     eax,6C35323Fh           ; ? 2 5 l
   524                              <1>         jmp     pseq
   525                              <1> ptails: dd      4A5B1B48h               ; {  H ESC [ J
   526                              <1>         dd      6835323Fh               ; |  ? 2 5 h
   527                              <1>         dd      4Bh                     ; }  K
   528                              <1> ; pcsi: print ESC [. pch: print the bytes of EAX, from the low one up to the
   529                              <1> ; last that is not 0 (at least one). Both use EAX.
   530                              <1> pcsi:   mov     eax,5B1Bh
   531                              <1> pch:    CALLP   putc
   532                              <1>         shr     eax,8
   533                              <1>         jnz     pch
   534                              <1>         ret
   535                              <1> %endmacro
   536                              <1> 
   537                              <1> ; =============================================================================
   538                              <1> ;  Punctuation handlers. PTAB holds one byte per character: its handler's
   539                              <1> ;  distance from hbase, so every handler starts in the 256 bytes from hbase
   540                              <1> ;  (PT checks it). Only the starts must be there: the last handler, '$',
   541                              <1> ;  runs on past the window, and '[', '`' (and '_' and '/' in a checked
   542                              <1> ;  build) are stubs that jump to their bodies after it. Each handler starts
   543                              <1> ;  with EBX = TOS and EAX, ECX, EDX free, and ends with JMP EBP.
   544                              <1> ;  (Two other layouts were tried: handlers 2-aligned with the table holding
   545                              <1> ;  half the distance, which costs a NOP after every handler of odd length,
   546                              <1> ;  about 22 bytes; and the Z80's two 256-byte windows, whose dispatcher is 7
   547                              <1> ;  bytes longer and whose handlers must be in table order, which costs near
   548                              <1> ;  jumps.)
   549                              <1> ; =============================================================================
   550                              <1> hbase:
   551                              <1> ; ']' returns: pop an address and jump to it.
   552 00000101 8B37                <1> h_ret:  mov     esi,[edi]
   553 00000103 AF                  <1> rdrop:  scasd                           ; drop the return stack's top
   554 00000104 FFE5                <1> nx:     jmp     ebp
   555                              <1> 
   556                              <1> ; '\' ( flag -- ): true skips to the next ')' or ']' at this level; ')'
   557                              <1> ; drops the block start, ']' returns. No closer at all ends the program.
   558 00000106 6685DB              <1> h_break:test    bx,bx
   559 00000109 5B                  <1>         pop     ebx
   560 0000010A 74F8                <1>         jz      nx
   561 0000010C E8CE040000          <1>         call    skip
   562 00000111 84C0                <1>         test    al,al                   ; skip returns 0 for ')'
   563 00000113 75EC                <1>         jnz     h_ret
   564 00000115 EBEC                <1>         jmp     rdrop
   565                              <1> 
   566                              <1> ; ')' ( flag -- ): true jumps back to the block start (and keeps it); false
   567                              <1> ; drops it and carries on. The loop-back looks at the break key.
   568 00000117 6685DB              <1> h_close:test    bx,bx
   569 0000011A 5B                  <1>         pop     ebx
   570 0000011B 74E6                <1>         jz      rdrop
   571 0000011D 8B37                <1>         mov     esi,[edi]
   572 0000011F EBC9                <1>         jmp     rpoll
   573                              <1> 
   574                              <1> ; '(' ( flag -- ): true pushes the block start and enters; false skips to
   575                              <1> ; the matching ')'.
   576 00000121 6685DB              <1> h_open: test    bx,bx
   577 00000124 5B                  <1>         pop     ebx
   578 00000125 0F84F1000000        <1>         jz      skipo
   579 0000012B 89F2                <1>         mov     edx,esi
   580 0000012D EBB6                <1>         jmp     rpush
