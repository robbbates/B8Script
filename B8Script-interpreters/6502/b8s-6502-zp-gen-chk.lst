E171   6A           ML2:      ROR      
E172   66 04                  ROR   T0   
E174   76 03                  ROR   3,X   
E176   76 02                  ROR   2,X   ; everything one place right; next bit out
E178   88                     DEY      
E179   D0 E7                  BNE   ml1   
E17B   E8                     INX      
E17C   E8                     INX      
E17D   60                     RTS      
E17E                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E17E                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E17E                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E17E                             ; it stops with Z.
E17E                             ; b's cell is dropped once D holds |b|; udiv then leaves the remainder just
E17E                             ; where that cell was, so stepping X back down makes it the top cell.
E17E                          IF   CHECKED   
E17E   A9 5A        E_ZERO:   LDA   #"Z"   ; divide by zero, the stack as it was
E180   4C 16 E5               JMP   error   
E183                          ENDIF      
E183                H_DIV:       
E183                          IF   CHECKED   
E183   B5 00                  LDA   0,X   
E185   15 01                  ORA   1,X   
E187   F0 F5                  BEQ   e_zero   
