0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                FAST:     EQU   0   ; 1 = the speed build (not with EDITOR): see "The speed build"
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QUICK:    EQU   1-(1-FAST)*(CHECKED*CPM*EDITOR+CHECKED*(1-CPM)*(1-EDITOR))   
0000                             ; (1: the speed-ups that cost bytes: every build
0000                             ;  but the two that are full, the checked
0000                             ;  generic one and the checked CP/M editor.
0000                             ;  See "Speed-ups" below)
0000                QUICKU:   EQU   QUICK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the speed build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; IY, and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QUICK builds): the page
0000                             ;   at the heap limit, which the heap never reaches
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
0000                PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
0000                ACHK:     EQU   chkstk   ; (for the speed build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
                    ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the speed build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (speed build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (speed build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 72 05               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0008                          ENDIF      
0008                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0008                          ENDIF      
0008                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0008                          ENDIF      
0008                          IF   1-CPM   
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   FD 5E 00     RPOP:     LD   E,(IY+0)   ; 08
000B   FD 56 01               LD   D,(IY+1)   
000E   18 1B                  JR   rp2   ; (the rest is at 2Bh)
0010                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0010   C6 21        CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
0012   20 1D                  JR   NZ,next0   ;     the rest are ignored
0014   C3 BC 05     ENDPROG:   JP   EXIT   ;     the program has ended
0017   00                     NOP      ; 17  spare
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1           DRP:      POP   HL   ;     new TOS = NOS
001A   18 15                  JR   next0   
001C                          ENDIF      
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D                          ;*Macro unroll:  POPR
001D   CF                     DS   1-CPM,0CFh   
001E                          DS   CPM,0CDh   
001E                          DS   CPM,AROP&0FFh   
001E                          DS   CPM,AROP/256   
001E   EB                     EX   DE,HL   
001F                          ;*Macro unroll:  NEXTZ
001F   F7                     DS   1-CPM,0F7h   
0020                          DS   CPM,0DDh   
0020                          DS   CPM,0E9h   
0020                          IF   1-CPM   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
0028                RST28:       
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B   FD 23        RP2:      INC   IY   ; 2B  the rest of rpop
002D   FD 23                  INC   IY   
002F   C9                     RET      
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                          ENDIF      
0031                          IF   CPM   
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; back to c; zero only for NUL
                              JR   NZ,next0   ; the rest are ignored
                    ENDPROG:   JP   EXIT   ; the program has ended
0031                          ENDIF      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the speed build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the speed build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0031                          ENDIF      
0031                          IF   1-FAST   
0031                NEXT0:       
0031                          ENDIF      
0031                          IF   CHECKED*(1-FAST)   
0031   CD 5E 04               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034                          IF   1-FAST   
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D6                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 5B                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 5D                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 4F                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          ENDIF      
0058                          IF   (1-CHECKED)*(1-FAST)   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED*(1-FAST)   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 8B 04               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D                          IF   1-FAST   
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                          ENDIF      
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063                          IF   1-FAST   
0063   C6 00        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 04                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE 16                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          ENDIF      
006C                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IF   (1-CPM)*(1-FAST)   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070                          IF   1-FAST   
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                          ENDIF      
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0072                          ENDIF      
0072                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0072                          ENDIF      
0072                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0072                          ENDIF      ;   these)
0072                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0072                          ENDIF      
0072                             ; In the unchecked generic editor build the table is here, in the first
0072                             ; page, which saves loading D twice. (The other builds have no room for it
0072                             ; here: theirs is further down.)
0072                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0072                          ENDIF      
0072                             ; =============================================================================
0072                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0072                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0072                             ;  is here too: it belongs to "`" and makes the page come out right.
0072                             ; =============================================================================
0072   D1           H_XOR:    POP   DE   
0073   7C                     LD   A,H   
0074   AA                     XOR   D   
0075   67                     LD   H,A   
0076   7D                     LD   A,L   
0077   AB                     XOR   E   
0078   6F                     LD   L,A   
0079                          ;*Macro unroll:  NEXT
0079   F7                     DS   (1-CPM)*(1-FAST),0F7h   
007A                          DS   CPM+FAST-CPM*FAST,0DDh   
007A                          DS   CPM+FAST-CPM*FAST,0E9h   
007A   D1           H_OR:     POP   DE   
007B   7C                     LD   A,H   
007C   B2                     OR   D   
007D   67                     LD   H,A   
007E   7D                     LD   A,L   
007F   B3                     OR   E   
0080   6F                     LD   L,A   
0081                          ;*Macro unroll:  NEXT
0081   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0082                          DS   CPM+FAST-CPM*FAST,0DDh   
0082                          DS   CPM+FAST-CPM*FAST,0E9h   
0082                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0082   E7           H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0083                          DS   CPM,0CDh   
0083                          DS   CPM,ANEG&0FFh   
0083                          DS   CPM,ANEG/256   
0083   2B                     DEC   HL   
0084                          ;*Macro unroll:  NEXT
0084   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0085                          DS   CPM+FAST-CPM*FAST,0DDh   
0085                          DS   CPM+FAST-CPM*FAST,0E9h   
0085                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0085                             ; the same either way); TOS is the old pointer.
0085   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0089                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0089                          ENDIF      
0089   19                     ADD   HL,DE   ; the new top
008A                          IF   CHECKED   
008A   CD 95 04               CALL   chkhp   
008D                          ENDIF      
008D   22 7C 82               LD   (HEAP),HL   
0090   EB                     EX   DE,HL   
0091                          ;*Macro unroll:  NEXT
0091   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0092                          DS   CPM+FAST-CPM*FAST,0DDh   
0092                          DS   CPM+FAST-CPM*FAST,0E9h   
0092                          IF   1-CPM*CHECKED   
0092   FD 22 34 82  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
0096   CD CD 00               CALL   jphl   
0099   FD 2A 34 82            LD   IY,(RSAVE)   
009D                          ;*Macro unroll:  SETIX
009D                          DS   CPM+FAST-CPM*FAST,0DDh   
009D                          DS   CPM+FAST-CPM*FAST,21h   
009D                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
009D                          DS   CPM+FAST-CPM*FAST,ANXT/256   
009D   E1                     POP   HL   
009E                          ;*Macro unroll:  NEXT
009E   F7                     DS   (1-CPM)*(1-FAST),0F7h   
009F                          DS   CPM+FAST-CPM*FAST,0DDh   
009F                          DS   CPM+FAST-CPM*FAST,0E9h   
009F                          ENDIF      
009F                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
009F                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
009F                             ; Digits: step back onto the first digit and read the whole number.
009F   E5           DIGIT:    PUSH   HL   
00A0   0B                     DEC   BC   
00A1   CD BA 02               CALL   rdnum   
00A4                          ;*Macro unroll:  NEXT
00A4   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00A5                          DS   CPM+FAST-CPM*FAST,0DDh   
00A5                          DS   CPM+FAST-CPM*FAST,0E9h   
00A5                             ; a-z: push the cell's address (the cell is the variable)
00A5                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
00A5                          IF   1-QUICKU   
00A5   E5           LOWER:    PUSH   HL   
00A6   87                     ADD   A,A   
00A7   6F                     LD   L,A   
00A8   26 82                  LD   H,LETPAGE   
00AA                          ;*Macro unroll:  NEXT
00AA   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00AB                          DS   CPM+FAST-CPM*FAST,0DDh   
00AB                          DS   CPM+FAST-CPM*FAST,0E9h   
00AB                          ENDIF      
00AB                          IF   QUICKU   
                    LOWER:    JP   lowq   
00AB                          ENDIF      
00AB                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00AB                             ; the return stack, and the IP becomes the address in the letter's cell.
00AB   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00AC   EB                     EX   DE,HL   ; park TOS
00AD   87                     ADD   A,A   
00AE   6F                     LD   L,A   
00AF   26 82                  LD   H,LETPAGE   ; HL -> cell
00B1   4E                     LD   C,(HL)   
00B2   2C                     INC   L   
00B3   46                     LD   B,(HL)   ; IP = the word's body
00B4   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B5                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B5                             ; stack, then next. Everything that pushes the return stack ends here.
00B5                             ; 
00B5                             ; The break key is looked at here, so at every word call and loop-back (and
00B5                             ; block entry and "{"), but only one time in 256: PCNT counts them.
00B5                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
00B5   D1           RPUSHN:   POP   DE   
00B6   FD 72 FF               LD   (IY-1),D   
00B9   FD 73 FE               LD   (IY-2),E   
00BC   FD 2B                  DEC   IY   
00BE   FD 2B                  DEC   IY   
00C0   E5                     PUSH   HL   
00C1   21 36 82               LD   HL,PCNT   
00C4   35                     DEC   (HL)   
00C5   E1                     POP   HL   ; (the zero flag lasts)
00C6   CC 20 04               CALL   Z,pollk   
00C9                          ;*Macro unroll:  NEXT
00C9   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00CA                          DS   CPM+FAST-CPM*FAST,0DDh   
00CA                          DS   CPM+FAST-CPM*FAST,0E9h   
00CA                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
00CA   E3           H_TOR:    EX   (SP),HL   
00CB   18 E8                  JR   rpushn   
00CD   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
00CE                             ; ---- machine code: the grave -----------------------------------------------
00CE                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00CE                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00CE                             ; written and its address is left. An odd last digit is consumed and dropped.
00CE                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00CE                             ; code is entered by CALL with the data stack above the return address; it
00CE                             ; must keep BC, and on return the top cell becomes the new TOS.
00CE   CD B7 03     H_GRAVE:   CALL   hexc   
00D1                          IF   1-CPM*CHECKED   
00D1   30 BF                  JR   NC,exec   
00D3                          ENDIF      
00D3                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
00D3                          ENDIF      
00D3   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00D4   CD B7 03               CALL   hexc   
00D7   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00D9   ED 6F                  RLD      ;   overwrites it
00DB   23                     INC   HL   ; ... and RLD shifts it up under the low one
00DC   CD B7 03               CALL   hexc   
00DF   38 F2                  JR   C,hx1   
00E1   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00E3                          ;*Macro unroll:  NEXT
00E3   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00E4                          DS   CPM+FAST-CPM*FAST,0DDh   
00E4                          DS   CPM+FAST-CPM*FAST,0E9h   
00E4                             ; ---- where the two pages meet ----------------------------------------------
00E4                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00E4                             ; are in falling code order for this), and where exactly differs between the
00E4                             ; builds: NPG1 follows. Every handler below these four must start in the
00E4                             ; second page, and every one above in the first; chktab.py checks both.
00E4                             ; "]" returns: pop an address and jump to it.
00E4                          ;*Macro unroll: h_ret:  POPR
00E4   CF           H_RET:    DS   1-CPM,0CFh   
00E5                          DS   CPM,0CDh   
00E5                          DS   CPM,AROP&0FFh   
00E5                          DS   CPM,AROP/256   
00E5   42                     LD   B,D   
00E6   4B                     LD   C,E   
00E7                          ;*Macro unroll: brk1:   NEXT
00E7   F7           BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
00E8                          DS   CPM+FAST-CPM*FAST,0DDh   
00E8                          DS   CPM+FAST-CPM*FAST,0E9h   
00E8                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00E8                             ; drops the block start, "]" returns. No closer at all ends the program.
00E8   7C           H_BREAK:   LD   A,H   
00E9   B5                     OR   L   
00EA   E1                     POP   HL   
00EB   28 FA                  JR   Z,brk1   
00ED   CD E1 02               CALL   skip   
00F0   B7                     OR   A   ; skip returns 0 for ")"
00F1   20 F1                  JR   NZ,h_ret   
00F3                          ;*Macro unroll: rdrop:  POPR
00F3   CF           RDROP:    DS   1-CPM,0CFh   
00F4                          DS   CPM,0CDh   
00F4                          DS   CPM,AROP&0FFh   
00F4                          DS   CPM,AROP/256   
00F4                          ;*Macro unroll:  NEXT
00F4   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00F5                          DS   CPM+FAST-CPM*FAST,0DDh   
00F5                          DS   CPM+FAST-CPM*FAST,0E9h   
00F5                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00F5                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00F5                             ; the body"s address instead. Either way it then skips to the matching "]'.
00F5                             ; (The unchecked build takes anything that is not a letter as the space; the
00F5                             ; checked build stops on it.)
00F5   0A           H_DEF:    LD   A,(BC)   
00F6   03                     INC   BC   
00F7   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00F9   5F                     LD   E,A   ;   lands 64 bytes up
00FA   E6 DF                  AND   0DFh   ; fold case
00FC   FE 1A                  CP   26   
00FE   30 0B                  JR   NC,def2   ; not a letter
0100   CB 23                  SLA   E   
0102   16 82                  LD   D,LETPAGE   ; DE -> cell
0104   79                     LD   A,C   
0105   12                     LD   (DE),A   
0106   1C                     INC   E   
0107   78                     LD   A,B   
0108   12                     LD   (DE),A   
0109   18 09                  JR   skipnx   
010B                DEF2:        
010B                          IF   CHECKED   
010B   7B                     LD   A,E   
010C   FE DF                  CP   " "-"A"+256   
010E   C2 D1 04               JP   NZ,e_brack   ; anything but a letter or a space
0111                          ENDIF      
0111   E5                     PUSH   HL   ; an anonymous block: push its address
0112   60                     LD   H,B   
0113   69                     LD   L,C   
0114                SKIPNX:      
0114                          IF   CHECKED   
0114   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0115                          ENDIF      ;   opener, the "[", just before where it starts
0115   CD E1 02     SKIPO:    CALL   skip   
0118                          ;*Macro unroll:  NEXT
0118   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0119                          DS   CPM+FAST-CPM*FAST,0DDh   
0119                          DS   CPM+FAST-CPM*FAST,0E9h   
0119   5E           H_FETCH:   LD   E,(HL)   ; "@"
011A   23                     INC   HL   
011B   56                     LD   D,(HL)   
011C   EB                     EX   DE,HL   
011D                          ;*Macro unroll:  NEXT
011D   F7                     DS   (1-CPM)*(1-FAST),0F7h   
011E                          DS   CPM+FAST-CPM*FAST,0DDh   
011E                          DS   CPM+FAST-CPM*FAST,0E9h   
011E                             ; =============================================================================
011E                             ;  Handlers that must start in the image's second page.
011E                             ;  "?" is the last (with "," inside it), so its long tail may run past that
011E                             ;  page.
011E                             ; =============================================================================
011E                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
011E                             ; the matching ")".
011E   7C           H_OPEN:   LD   A,H   
011F   B5                     OR   L   
0120   E1                     POP   HL   
0121   28 F2                  JR   Z,skipo   
0123   C5                     PUSH   BC   ; the block starts at the IP
0124   18 8F                  JR   rpushn   
0126                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0126                             ; drops it and carries on.
0126   7C           H_CLOSE:   LD   A,H   
0127   B5                     OR   L   
0128   E1                     POP   HL   
0129   28 C8                  JR   Z,rdrop   
012B                          IF   QUICK   
012B   C3 A7 03               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
012E                          ENDIF      
012E                          IF   1-QUICK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
012E                          ENDIF      
012E                          IF   (1-QUICK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
012E                          ENDIF      
012E                          IF   (1-QUICK)*CPM   
                              JP   rpushn   
012E                          ENDIF      
012E                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
012E                             ; "-" has two jobs: directly before a digit it starts a negative number.
012E   0A           H_SUB:    LD   A,(BC)   
012F   D6 30                  SUB   "0"   
0131   FE 0A                  CP   10   
0133   38 04                  JR   C,negnum   
0135                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0135   E7                     DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0136                          DS   CPM,0CDh   
0136                          DS   CPM,ANEG&0FFh   
0136                          DS   CPM,ANEG/256   
0136   D1           H_ADD:    POP   DE   
0137   19                     ADD   HL,DE   
0138                          ;*Macro unroll:  NEXT
0138   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0139                          DS   CPM+FAST-CPM*FAST,0DDh   
0139                          DS   CPM+FAST-CPM*FAST,0E9h   
0139   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
013A   CD BA 02               CALL   rdnum   
013D                          ;*Macro unroll:  NEGH
013D   E7                     DS   1-CPM,0E7h   
013E                          DS   CPM,0CDh   
013E                          DS   CPM,ANEG&0FFh   
013E                          DS   CPM,ANEG/256   
013E                          ;*Macro unroll:  NEXT
013E   F7                     DS   (1-CPM)*(1-FAST),0F7h   
013F                          DS   CPM+FAST-CPM*FAST,0DDh   
013F                          DS   CPM+FAST-CPM*FAST,0E9h   
013F   D1           H_AND:    POP   DE   
0140   7C                     LD   A,H   
0141   A2                     AND   D   
0142   67                     LD   H,A   
0143   7D                     LD   A,L   
0144   A3                     AND   E   
0145   6F                     LD   L,A   
0146                          ;*Macro unroll:  NEXT
0146   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0147                          DS   CPM+FAST-CPM*FAST,0DDh   
0147                          DS   CPM+FAST-CPM*FAST,0E9h   
0147                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0147                             ; cells first. Flipping both sign bits turns a signed compare into an
0147                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0147                             ; carry into -1 or 0 with no branch.
0147   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0148   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0149   7C                     LD   A,H   
014A   EE 80                  XOR   80h   
014C   67                     LD   H,A   
014D   7A                     LD   A,D   
014E   EE 80                  XOR   80h   
0150   57                     LD   D,A   
0151   ED 52                  SBC   HL,DE   ; carry if HL < DE
0153   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0155                          ;*Macro unroll:  NEXT
0155   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0156                          DS   CPM+FAST-CPM*FAST,0DDh   
0156                          DS   CPM+FAST-CPM*FAST,0E9h   
0156   D1           H_EQ:     POP   DE   
0157   B7                     OR   A   
0158   ED 52                  SBC   HL,DE   
015A   7C                     LD   A,H   
015B   B5                     OR   L   
015C   FE 01                  CP   1   ; carry only if a - b = 0
015E   18 F3                  JR   tf   
0160                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0160                             ; multiplier shifts up through A:C.
0160                          IF   1-QUICK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0160                          ENDIF      
0160                          IF   QUICK   
0160   D1           H_MUL:    POP   DE   ; DE = multiplicand
0161   C3 7B 03               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0164                          ENDIF      
0164                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0164                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0164                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0164                             ; stops on it.
0164                H_DIV:       
0164                          IF   CHECKED   
0164   7C                     LD   A,H   
0165   B5                     OR   L   
0166   CA CE 04               JP   Z,e_zero   
0169                          ENDIF      
0169   D1                     POP   DE   ; DE = a, HL = b
016A   D5                     PUSH   DE   ; a, for r's sign
016B   7A                     LD   A,D   
016C   AC                     XOR   H   
016D   F5                     PUSH   AF   ; S flag = sign of q
016E   CB 7C                  BIT   7,H   
0170   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0173   EB                     EX   DE,HL   
0174   CB 7C                  BIT   7,H   
0176   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0179   CD 65 02               CALL   udiv   ; HL = q, DE = r
017C   F1                     POP   AF   
017D   FC 20 00               CALL   M,neg16   ; q's sign
0180   EB                     EX   DE,HL   ; HL = r, DE = q
0181   F1                     POP   AF   ; A = a's high byte
0182   B7                     OR   A   
0183   FC 20 00               CALL   M,neg16   ; r's sign
0186   D5                     PUSH   DE   ; q under r
0187                          ;*Macro unroll:  NEXT
0187   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0188                          DS   CPM+FAST-CPM*FAST,0DDh   
0188                          DS   CPM+FAST-CPM*FAST,0E9h   
0188                             ; ---- stack and storage -----------------------------------------------------
0188   E5           H_DUP:    PUSH   HL   ; ":"
0189                          ;*Macro unroll:  NEXT
0189   F7                     DS   (1-CPM)*(1-FAST),0F7h   
018A                          DS   CPM+FAST-CPM*FAST,0DDh   
018A                          DS   CPM+FAST-CPM*FAST,0E9h   
018A   E3           H_SWAP:   EX   (SP),HL   ; "%"
018B                          ;*Macro unroll:  NEXT
018B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
018C                          DS   CPM+FAST-CPM*FAST,0DDh   
018C                          DS   CPM+FAST-CPM*FAST,0E9h   
018C                             ; (The checked build tests the address before it takes the value off the
018C                             ; stack, so that an error report shows both.)
018C                H_CSTORE:      ; "." ( c addr -- )
018C                          IF   CHECKED   
018C   CD AA 04               CALL   chkst   
018F                          ENDIF      
018F   D1                     POP   DE   
0190   73                     LD   (HL),E   
0191                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
0191   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
0192                          DS   CPM+FAST-CPM*FAST,0E1h   
0192                          DS   CPM+FAST-CPM*FAST,0DDh   
0192                          DS   CPM+FAST-CPM*FAST,0E9h   
0192                H_STORE:      ; "!" ( n addr -- )
0192                          IF   CHECKED   
0192   CD AA 04               CALL   chkst   
0195                          ENDIF      
0195   D1                     POP   DE   
0196   73                     LD   (HL),E   
0197   23                     INC   HL   
0198   72                     LD   (HL),D   
0199                          ;*Macro unroll:  DROP
0199   DF                     DS   (1-CPM)*(1-FAST),0DFh   
019A                          DS   CPM+FAST-CPM*FAST,0E1h   
019A                          DS   CPM+FAST-CPM*FAST,0DDh   
019A                          DS   CPM+FAST-CPM*FAST,0E9h   
019A                             ; ---- console ---------------------------------------------------------------
019A                             ; 22h pushes the address of the text after it and skips the string.
019A   E5           H_STR:    PUSH   HL   
019B   60                     LD   H,B   
019C   69                     LD   L,C   
019D   CD D0 02               CALL   skipstr   
01A0                          IF   CHECKED   
01A0   B7                     OR   A   ; 0: the text ran out before the closing quote
01A1   CA C6 04               JP   Z,e_quote   
01A4                          ENDIF      
01A4                          ;*Macro unroll:  NEXT
01A4   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01A5                          DS   CPM+FAST-CPM*FAST,0DDh   
01A5                          DS   CPM+FAST-CPM*FAST,0E9h   
01A5                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01A5                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01A5                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01A5                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01A5                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01A5                          ENDIF      
01A5                          IF   CHECKED   
01A5                             ; (The checked build has the loop as a routine, prstr, which the error
01A5                             ; report uses too. The address is kept meanwhile, for a report: it shows
01A5                             ; the stack as it was before the "$". /~ comes back to hp1.)
01A5   22 34 82     H_PRINT:   LD   (RSAVE),HL   
01A8   CD FE 01     HP1:      CALL   prstr   
01AB                          ;*Macro unroll:  DROP
01AB   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01AC                          DS   CPM+FAST-CPM*FAST,0E1h   
01AC                          DS   CPM+FAST-CPM*FAST,0DDh   
01AC                          DS   CPM+FAST-CPM*FAST,0E9h   
01AC                          ENDIF      
01AC   7D           H_EMIT:   LD   A,L   ; "'"
01AD                          ;*Macro unroll:  PUTA
01AD   EF                     DS   1-CPM,0EFh   
01AE                          DS   CPM,0CDh   
01AE                          DS   CPM,APUT&0FFh   
01AE                          DS   CPM,APUT/256   
01AE                          ;*Macro unroll: pr9:    DROP
01AE   DF           PR9:      DS   (1-CPM)*(1-FAST),0DFh   
01AF                          DS   CPM+FAST-CPM*FAST,0E1h   
01AF                          DS   CPM+FAST-CPM*FAST,0DDh   
01AF                          DS   CPM+FAST-CPM*FAST,0E9h   
01AF                             ; "#" prints TOS as a signed decimal number, with no space after it.
01AF   CD C9 03     H_NUM:    CALL   psgn   
01B2                          ;*Macro unroll:  DROP
01B2   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01B3                          DS   CPM+FAST-CPM*FAST,0E1h   
01B3                          DS   CPM+FAST-CPM*FAST,0DDh   
01B3                          DS   CPM+FAST-CPM*FAST,0E9h   
01B3                             ; "?" ( n -- c ) or ( -n -- addr )
01B3                             ;   n > 0: wait about n ms for a key; 0 if none came
01B3                             ;   n = 0: wait for a key
01B3                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01B3                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01B3   CB 7C        H_KEY:    BIT   7,H   
01B5   20 19                  JR   NZ,line   
01B7   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01B9   CD 4E 04     KT2:      CALL   getk   
01BC   20 0E                  JR   NZ,kt3   
01BE   1D                     DEC   E   
01BF   20 F8                  JR   NZ,kt2   
01C1   7C                     LD   A,H   ; 0? never counts down: it waits
01C2   B5                     OR   L   
01C3   28 F2                  JR   Z,kt1   
01C5   2B                     DEC   HL   
01C6   7C                     LD   A,H   
01C7   B5                     OR   L   
01C8   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01CA   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01CB   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01CC   6F           KT3:      LD   L,A   
01CD   26 00                  LD   H,0   
01CF                          ;*Macro unroll:  NEXT
01CF   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01D0                          DS   CPM+FAST-CPM*FAST,0DDh   
01D0                          DS   CPM+FAST-CPM*FAST,0E9h   
01D0                             ; Backspace takes the last character back (and is echoed as it
01D0                             ; is), CR ends (stored, not echoed), every other key is stored and
01D0                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01D0                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01D0                             ; is the place in the line: D holds the L of a full line.
01D0   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01D3   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01D4   9F                     SBC   A,A   
01D5   A5                     AND   L   ; (0 for a count that is too big)
01D6   2F                     CPL      
01D7   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01D8                             ;   at most
01D8   21 80 82               LD   HL,LINEBUF   
01DB   CD 4E 04     LN2:      CALL   getk   
01DE   28 FB                  JR   Z,ln2   
01E0   FE 0D                  CP   13   
01E2   28 16                  JR   Z,ln5   
01E4   FE 08                  CP   8   
01E6   28 0B                  JR   Z,ln4   
01E8   5F                     LD   E,A   
01E9   7D                     LD   A,L   
01EA   BA                     CP   D   
01EB   28 EE                  JR   Z,ln2   ; full
01ED   73                     LD   (HL),E   
01EE   2C                     INC   L   
01EF   7B                     LD   A,E   
01F0                          ;*Macro unroll: ln3:    PUTA
01F0   EF           LN3:      DS   1-CPM,0EFh   
01F1                          DS   CPM,0CDh   
01F1                          DS   CPM,APUT&0FFh   
01F1                          DS   CPM,APUT/256   
01F1   18 E8                  JR   ln2   
01F3   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
01F4   FA F0 01               JP   M,ln3   ;   unless the line was empty (L left the
01F7   2C                     INC   L   ;   upper half of the page)
01F8   18 E1                  JR   ln2   
01FA   77           LN5:      LD   (HL),A   ; the CR
01FB   2E 80                  LD   L,LINEBUF & 0FFh   
01FD                          ;*Macro unroll:  NEXT
01FD   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01FE                          DS   CPM+FAST-CPM*FAST,0DDh   
01FE                          DS   CPM+FAST-CPM*FAST,0E9h   
01FE                             ; =============================================================================
01FE                             ;  More routines (no handler starts past this point)
01FE                             ; =============================================================================
01FE                          IF   CHECKED   
01FE                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
01FE                             ; "$", and the texts of the report). A NUL first is an error: Q.
01FE   7E           PRSTR:    LD   A,(HL)   
01FF   23                     INC   HL   
0200   FE 22                  CP   22h   
0202   C8                     RET   Z   
0203   B7                     OR   A   
0204   CA BC 04               JP   Z,e_dollar   
0207   FE 2F                  CP   "/"   
0209   20 0C                  JR   NZ,prs1   
020B   7E                     LD   A,(HL)   
020C   23                     INC   HL   
020D   FE 60                  CP   60h   
020F   38 04                  JR   C,prs0   
0211   FE 7F                  CP   7Fh   
0213   38 11                  JR   C,pesc   
0215   E6 BF        PRS0:     AND   0BFh   
0217                          ;*Macro unroll: prs1:   PUTA
0217   EF           PRS1:     DS   1-CPM,0EFh   
0218                          DS   CPM,0CDh   
0218                          DS   CPM,APUT&0FFh   
0218                          DS   CPM,APUT/256   
0218   18 E4                  JR   prstr   
021A                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
021A                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
021A                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
021A                             ; pnl: the same, on a new line.
021A   CD 20 02     PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
021D   0D 0A 22               DB   13,10,22h   ;   the caller's text)
0220   E3           PMSG:     EX   (SP),HL   
0221   CD FE 01               CALL   prstr   
0224   E3                     EX   (SP),HL   
0225   C9                     RET      
0226                          ENDIF      
0226                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0226                             ; HL points past it. Each goes back into the loop that prints the string
0226                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0226                             ;    /a-/z   print the variable, as "#" does
0226                             ;    /{      clear the screen, the cursor to the top left
0226                             ;    /}      clear from the cursor to the end of the line
0226                             ;    /|  /`  show the cursor, hide it
0226                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0226   FE 7E        PESC:     CP   7Eh   
0228   28 1C                  JR   Z,pat   
022A   11 FE 01               LD   DE,PRLOOP   ; the others return into the loop
022D   D5                     PUSH   DE   
022E   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0230   30 26                  JR   NC,pcon   
0232   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0234   30 2B                  JR   NC,phide   
0236   87                     ADD   A,A   ; the variable's cell
0237   C6 40                  ADD   A,40h   
0239   E5                     PUSH   HL   
023A   6F                     LD   L,A   
023B   26 82                  LD   H,LETPAGE   
023D   7E                     LD   A,(HL)   
023E   2C                     INC   L   
023F   66                     LD   H,(HL)   
0240   6F                     LD   L,A   
0241   CD C9 03               CALL   psgn   
0244   E1                     POP   HL   
0245   C9                     RET      
0246                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0246                             ; the checked build "$" is the routine prstr: its own return address goes
0246                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0246                             ; its two cells are there, and is s if not, before it prints anything.
0246                PAT:         
0246                          IF   CHECKED   
0246   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
0247   21 0A 7E               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
024A   39                     ADD   HL,SP   
024B   DA 84 04               JP   C,e_under   
024E   E1                     POP   HL   
024F                          ENDIF      
024F   D1                     POP   DE   ; DE = the column
0250   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0251                          IF   1-ANS   
0251   CD 15 FF               CALL   CONAT   
0254   E1                     POP   HL   
0255   C3 A8 01               JP   PRAGAIN   
0258                             ; With ANSI = 0 the machine's routines do the rest.
0258   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
025B   FE 02                  CP   2   
025D   CA 0F FF               JP   Z,CONEOL   ; /}
0260   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
0261   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0262   C3 12 FF               JP   CONCUR   
0265                          ENDIF      
0265                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    3Bh             ; ';'
                              DS   1-CPM,3Eh   ; ";"
                              DS   1-CPM,3Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Bh   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    48h             ; 'H'
                              DS   1-CPM,3Eh   ; "H"
                              DS   1-CPM,48h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,48h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0265                          ENDIF      
0265                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0265                          ENDIF      
0265                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
0265                          ENDIF      
0265                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0265                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0265                             ; the quotient bits arrive at the bottom of C.
0265                             ; Dividing by 2 is one shift (the spec wants that fast).
0265                          IF   1-QUICK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
0265                          ENDIF      
0265                          IF   QUICK   
0265                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0265                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0265   7A           UDIV:     LD   A,D   
0266   B7                     OR   A   
0267   20 1A                  JR   NZ,uq1   ; 256 and up
0269   B3                     OR   E   
026A   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
026C   3D                     DEC   A   
026D   A3                     AND   E   
026E   20 2F                  JR   NZ,udv0   ; not a power of two
0270   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
0271   3D                     DEC   A   ;   r = L & (2^k - 1)
0272   A5                     AND   L   
0273   F5                     PUSH   AF   
0274   CB 3B        UQ2:      SRL   E   
0276   38 06                  JR   C,uq3   
0278   CB 3C                  SRL   H   
027A   CB 1D                  RR   L   
027C   18 F6                  JR   uq2   
027E   F1           UQ3:      POP   AF   
027F   5F                     LD   E,A   
0280   16 00                  LD   D,0   
0282   C9                     RET      
0283   7B           UQ1:      LD   A,E   
0284   B7                     OR   A   
0285   20 18                  JR   NZ,udv0   
0287   7A                     LD   A,D   
0288   3D                     DEC   A   
0289   A2                     AND   D   
028A   20 13                  JR   NZ,udv0   ; not a power of two
028C   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
028D   3D                     DEC   A   ;   r = HL & (2^k - 1)
028E   A4                     AND   H   
028F   5F                     LD   E,A   ; (the remainder's high byte,
0290   7D                     LD   A,L   ;   and its low byte)
0291   6C                     LD   L,H   
0292   26 00                  LD   H,0   
0294   CB 3A        UQ4:      SRL   D   
0296   38 04                  JR   C,uq5   
0298   CB 3D                  SRL   L   
029A   18 F8                  JR   uq4   
029C   53           UQ5:      LD   D,E   
029D   5F                     LD   E,A   
029E   C9                     RET      
029F                          ENDIF      
029F                          IF   1-FAST   
029F   C5           UDV0:     PUSH   BC   
02A0   7C                     LD   A,H   
02A1   4D                     LD   C,L   
02A2   21 00 00               LD   HL,0   
02A5   06 10                  LD   B,16   
02A7   CB 21        UDV1:     SLA   C   
02A9   17                     RLA      
02AA   ED 6A                  ADC   HL,HL   
02AC   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
02AE   30 02                  JR   NC,udv2   ;   always fits in 16 bits
02B0   19                     ADD   HL,DE   ; too much: put it back, and cancel the
02B1   0D                     DEC   C   ;   INC below
02B2   0C           UDV2:     INC   C   ; a quotient bit
02B3   10 F2                  DJNZ   udv1   
02B5   EB                     EX   DE,HL   ; DE = remainder
02B6   67                     LD   H,A   
02B7   69                     LD   L,C   ; HL = quotient
02B8   C1                     POP   BC   
02B9   C9                     RET      
02BA                          ENDIF      
02BA                          IF   FAST   
                                 ; (the speed build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
02BA                          ENDIF      
02BA                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
02BA                             ; non-digit. Values wrap at 16 bits, as the spec says.
02BA   21 00 00     RDNUM:    LD   HL,0   
02BD   0A           RDN1:     LD   A,(BC)   
02BE   D6 30                  SUB   "0"   
02C0   FE 0A                  CP   10   
02C2   D0                     RET   NC   
02C3   03                     INC   BC   
02C4   54                     LD   D,H   
02C5   5D                     LD   E,L   
02C6   29                     ADD   HL,HL   
02C7   29                     ADD   HL,HL   
02C8   19                     ADD   HL,DE   
02C9   29                     ADD   HL,HL   ; HL * 10
02CA   5F                     LD   E,A   
02CB   16 00                  LD   D,0   
02CD   19                     ADD   HL,DE   
02CE   18 ED                  JR   rdn1   
02D0                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02D0                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02D0                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
02D0                          ENDIF      
02D0                          IF   CHECKED   
02D0                             ; The checked build never steps over a NUL: if the text runs out first it
02D0                             ; returns A = 0 with the IP on the NUL.
02D0   0A           SKIPSTR:   LD   A,(BC)   
02D1   B7                     OR   A   
02D2   C8                     RET   Z   
02D3   03                     INC   BC   
02D4   FE 22                  CP   22h   
02D6   C8                     RET   Z   
02D7   FE 2F                  CP   "/"   
02D9   20 F5                  JR   NZ,skipstr   
02DB   0A                     LD   A,(BC)   ; the escaped character
02DC   B7                     OR   A   
02DD   C8                     RET   Z   
02DE   03                     INC   BC   
02DF   18 EF                  JR   skipstr   
02E1                          ENDIF      
02E1                             ; skip: read past text to the closer at this level, and return A = 0 if it
02E1                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02E1                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02E1                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02E1                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02E1                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02E1                             ; 
02E1                             ; The checked build also looks at the character the skip was started by,
02E1                             ; which is always the one just before where it starts: "(" must end at ")",
02E1                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02E1                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
02E1                             ; place where the skip started, for the report.
02E1                          IF   1-QUICK   
                                 ; (The two full builds, both checked, have no skip cache: this is their skip.)
                    SKIP:     LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02E1                          ENDIF      
02E1                          IF   QUICK   
02E1                             ; The skip cache. Nearly every skip is one that has happened before (a loop
02E1                             ; skips the same false block on every pass), so the first scan from each
02E1                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
02E1                             ; start's low byte. Only skips that start in the program text are kept (the
02E1                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
02E1                             ; A program that changes its own text while it runs is not looked after.
02E1   ED 43 3C 82  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
02E5   78                     LD   A,B   ;   checked report's place)
02E6   FE 83                  CP   PROG/256   
02E8   38 1B                  JR   C,sks   ; below the program text: no cache
02EA   79                     LD   A,C   
02EB   87                     ADD   A,A   
02EC   87                     ADD   A,A   
02ED   5F                     LD   E,A   
02EE   16 F0                  LD   D,CPAGE   ; DE -> the entry
02F0   1A                     LD   A,(DE)   
02F1   B9                     CP   C   
02F2   20 11                  JR   NZ,sks   
02F4   1C                     INC   E   
02F5   1A                     LD   A,(DE)   
02F6   B8                     CP   B   
02F7   20 0C                  JR   NZ,sks   
02F9   1C                     INC   E   
02FA   1A                     LD   A,(DE)   
02FB   4F                     LD   C,A   
02FC   1C                     INC   E   
02FD   1A                     LD   A,(DE)   
02FE   47                     LD   B,A   ; a hit: the IP is past the closer
02FF   0B                     DEC   BC   
0300   0A                     LD   A,(BC)   
0301   03                     INC   BC   
0302   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
0304   C9                     RET      
0305                SKS:         
0305                          ENDIF      
0305                          IF   QUICK*CHECKED   
0305   0B                     DEC   BC   
0306   0A                     LD   A,(BC)   
0307   03                     INC   BC   
0308   5F                     LD   E,A   ; E = the opener: ( [ or \
0309                          ENDIF      
0309                          IF   QUICK   
0309                             ; The scan. Most characters are nothing to it, and two range tests rule
0309                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
0309   16 00                  LD   D,0   
030B   14           SQ3:      INC   D   ; an opener: one deeper
030C   0A           SQ1:      LD   A,(BC)   
030D   03                     INC   BC   
030E   FE 5E                  CP   5Eh   
0310   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
0312   FE 5B                  CP   5Bh   
0314   30 25                  JR   NC,sqb   ; [ \ ]
0316   FE 2A                  CP   2Ah   
0318   30 F2                  JR   NC,sq1   ; * to Z: nothing
031A   FE 28                  CP   28h   
031C   28 ED                  JR   Z,sq3   ; (
031E   30 25                  JR   NC,sqc   ; )
0320   FE 22                  CP   22h   
0322   28 12                  JR   Z,sqq   ; a string
0324   B7                     OR   A   
0325   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
0327                          ENDIF      
0327                          IF   QUICK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
0327                          ENDIF      
0327                          IF   QUICK*CHECKED   
0327   0B                     DEC   BC   ; NUL: the IP stays on it
0328   CB 53                  BIT   2,E   ; the text ran out:
032A   C2 BB 05               JP   NZ,SKEND   ;   "\" with no closer ends the program
032D   ED 4B 3C 82  SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
0331   3E 4E                  LD   A,"N"   
0333   C3 B9 04               JP   errp   ; (errp drops skip's return address)
0336                          ENDIF      
0336                          IF   QUICK   
0336   CD D0 02     SQQ:      CALL   skipstr   ; step over the string
0339   18 D1                  JR   sq1   
033B   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
033D   28 CD                  JR   Z,sq1   ; "\" is nothing here
033F   38 CA                  JR   C,sq3   ; [
0341   3E 02                  LD   A,2   ; ]
0343   18 01                  JR   sq4   
0345   AF           SQC:      XOR   A   ; )
0346   15           SQ4:      DEC   D   
0347   20 C3                  JR   NZ,sq1   
0349                          ENDIF      
0349                          IF   QUICK*CHECKED   
0349   57                     LD   D,A   ; the closer at this level (as above): 2 here
034A   AB                     XOR   E   ;   means the wrong closer
034B   E6 06                  AND   6   
034D   FE 02                  CP   2   
034F   7A                     LD   A,D   
0350   28 DB                  JR   Z,sq7   
0352                          ENDIF      
0352                          IF   QUICK   
0352                             ; The closer at this level: remember the skip (if it started in the program
0352                             ; text), and return A = 0 for ")" or 2 for "]".
0352   F5                     PUSH   AF   
0353   E5                     PUSH   HL   
0354   2A 3C 82               LD   HL,(SKPL)   
0357   7C                     LD   A,H   
0358   FE 83                  CP   PROG/256   
035A   38 11                  JR   C,sq9   
035C   7D                     LD   A,L   
035D   87                     ADD   A,A   
035E   87                     ADD   A,A   
035F   5F                     LD   E,A   
0360   16 F0                  LD   D,CPAGE   
0362   7D                     LD   A,L   
0363   12                     LD   (DE),A   
0364   1C                     INC   E   
0365   7C                     LD   A,H   
0366   12                     LD   (DE),A   
0367   1C                     INC   E   
0368   79                     LD   A,C   
0369   12                     LD   (DE),A   
036A   1C                     INC   E   
036B   78                     LD   A,B   
036C   12                     LD   (DE),A   
036D   E1           SQ9:      POP   HL   
036E   F1                     POP   AF   
036F   C9                     RET      
0370                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
0370   E5           SKCLR:    PUSH   HL   
0371   21 00 F0               LD   HL,CPAGE*256   
0374   36 00        SKC1:     LD   (HL),0   
0376   2C                     INC   L   
0377   20 FB                  JR   NZ,skc1   
0379   E1                     POP   HL   
037A   C9                     RET      
037B                          ENDIF      
037B                             ;  ---- Speed-ups (QUICK builds) -------------------------------------------
037B                             ;  The skip cache is above. These are the handlers' tails that the builds with
037B                             ;  room take, kept here, out of the handlers' first two pages.
037B                          IF   QUICK   
037B                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
037B                             ; multiplier (most multiplications have one, a count or a small constant).
037B   7C           MULQ:     LD   A,H   
037C   B7                     OR   A   
037D   28 05                  JR   Z,mq8   ; the multiplier is below 256
037F   7A                     LD   A,D   
0380   B7                     OR   A   
0381   20 11                  JR   NZ,mq16   
0383   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
0384                          ENDIF      
0384                          IF   QUICK*(1-FAST)   
0384   7D           MQ8:      LD   A,L   
0385   21 00 00               LD   HL,0   
0388   C5                     PUSH   BC   
0389   06 08                  LD   B,8   
038B   29           MQ1:      ADD   HL,HL   
038C   17                     RLA      
038D   30 01                  JR   NC,mq2   
038F   19                     ADD   HL,DE   
0390   10 F9        MQ2:      DJNZ   mq1   
0392   C1                     POP   BC   
0393                          ;*Macro unroll:  NEXT
0393   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0394                          DS   CPM+FAST-CPM*FAST,0DDh   
0394                          DS   CPM+FAST-CPM*FAST,0E9h   
0394   C5           MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
0395   7C                     LD   A,H   
0396   4D                     LD   C,L   
0397   21 00 00               LD   HL,0   
039A   06 10                  LD   B,16   
039C   29           MQ3:      ADD   HL,HL   
039D   CB 21                  SLA   C   
039F   17                     RLA      
03A0   30 01                  JR   NC,mq4   
03A2   19                     ADD   HL,DE   
03A3   10 F7        MQ4:      DJNZ   mq3   
03A5   C1                     POP   BC   
03A6                          ;*Macro unroll:  NEXT
03A6   F7                     DS   (1-CPM)*(1-FAST),0F7h   
03A7                          DS   CPM+FAST-CPM*FAST,0DDh   
03A7                          DS   CPM+FAST-CPM*FAST,0E9h   
03A7                          ENDIF      
03A7                          IF   FAST   
                                 ; (the speed build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
03A7                          ENDIF      
03A7                          IF   QUICK   
03A7                             ; A true ")" reads the block start where it is, on top of the return stack,
03A7                             ; instead of popping it and pushing it back; the break key is looked at as
03A7                             ; rpushn would.
03A7   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
03AA   FD 46 01               LD   B,(IY+1)   
03AD   E5                     PUSH   HL   
03AE   21 36 82               LD   HL,PCNT   
03B1   35                     DEC   (HL)   
03B2   E1                     POP   HL   
03B3   CC 20 04               CALL   Z,pollk   
03B6                          ;*Macro unroll:  NEXT
03B6   F7                     DS   (1-CPM)*(1-FAST),0F7h   
03B7                          DS   CPM+FAST-CPM*FAST,0DDh   
03B7                          DS   CPM+FAST-CPM*FAST,0E9h   
03B7                          ENDIF      
03B7                          IF   QUICKU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
03B7                          ENDIF      
03B7                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
03B7                          ENDIF      
03B7                             ; =============================================================================
03B7                             ;  Dispatch table: the low byte of each handler's address, in code order
03B7                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03B7                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03B7                             ; =============================================================================
03B7                             ; The handlers of the first NPG1 characters start in the image's second page.
03B7                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03B7                             ; differs between the builds, so the count is worked out here.
03B7                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03B7                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03B7                PGBRK:    EQU   (h_break-BASE)/256   
03B7                PGDEF:    EQU   (h_def-BASE)/256   
03B7                PGFET:    EQU   (h_fetch-BASE)/256   
03B7                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03B7                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
03B7                          ENDIF      
03B7                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03B7                             ; and return its value in A with the carry set; otherwise leave the IP and
03B7                             ; return with the carry clear.
03B7   0A           HEXC:     LD   A,(BC)   
03B8   D6 30                  SUB   "0"   
03BA   FE 0A                  CP   10   
03BC   38 09                  JR   C,hc1   
03BE   E6 DF                  AND   0DFh   
03C0   D6 11                  SUB   11h   
03C2   FE 06                  CP   6   
03C4   D0                     RET   NC   
03C5   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03C7   03           HC1:      INC   BC   
03C8   C9                     RET      
03C9                             ; psgn: print HL as a signed number. Keeps BC.
03C9   CB 7C        PSGN:     BIT   7,H   
03CB   28 04                  JR   Z,pdec   
03CD                          ;*Macro unroll:  PUTK    2Dh             ; '-'
03CD   3E                     DS   1-CPM,3Eh   ; "-"
03CE   2D                     DS   1-CPM,2Dh   
03CF   EF                     DS   1-CPM,0EFh   
03D0                          DS   CPM,0CDh   
03D0                          DS   CPM,APTK&0FFh   
03D0                          DS   CPM,APTK/256   
03D0                          DS   CPM,2Dh   
03D0                          ;*Macro unroll:  NEGH
03D0   E7                     DS   1-CPM,0E7h   
03D1                          DS   CPM,0CDh   
03D1                          DS   CPM,ANEG&0FFh   
03D1                          DS   CPM,ANEG/256   
03D1                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03D1                             ; Keeps BC.
03D1   11 0A 00     PDEC:     LD   DE,10   
03D4   CD 65 02               CALL   udiv   ; HL = HL / 10, E = the last digit
03D7   7B                     LD   A,E   
03D8   F5                     PUSH   AF   
03D9   7C                     LD   A,H   
03DA   B5                     OR   L   
03DB   C4 D1 03               CALL   NZ,pdec   
03DE   F1                     POP   AF   
03DF   C6 30                  ADD   A,"0"   
03E1                          ;*Macro unroll:  PUTAR
03E1   EF                     DS   1-CPM,0EFh   
03E2   C9                     DS   1-CPM,0C9h   
03E3                          DS   CPM,0C3h   
03E3                          DS   CPM,APUT&0FFh   
03E3                          DS   CPM,APUT/256   
03E3                             ; (The table goes here instead in the builds where, before psgn, it would
03E3                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
03E3                             ; page: PTPAD is 0 unless it must.)
03E3                          IF   (1-TABP0)*PTLATE   
03E3                PTPH:     EQU   $ & 0FFh   
03E3                PTPX:     EQU   (PTPH + 31) / 256   
03E3                PTPAD:    EQU   PTPX * (256 - PTPH)   
03E3                          DS   PTPAD   
0400                PTAB:        
0400                          ;*Macro unroll:  PTABLE
0400   92                     DB   h_store & 0FFh   
0401   9A                     DB   h_str & 0FFh   
0402   AF                     DB   h_num & 0FFh   
0403   A5                     DB   h_print & 0FFh   
0404   8A                     DB   h_swap & 0FFh   
0405   3F                     DB   h_and & 0FFh   
0406   AC                     DB   h_emit & 0FFh   
0407   1E                     DB   h_open & 0FFh   
0408   26                     DB   h_close & 0FFh   
0409   60                     DB   h_mul & 0FFh   
040A   36                     DB   h_add & 0FFh   
040B   CB                     DB   h_cfetch & 0FFh   
040C   2E                     DB   h_sub & 0FFh   
040D   8C                     DB   h_cstore & 0FFh   
040E   64                     DB   h_div & 0FFh   
040F   88                     DB   h_dup & 0FFh   
0410   91                     DB   h_drop & 0FFh   
0411   47                     DB   h_lt & 0FFh   
0412   56                     DB   h_eq & 0FFh   
0413   48                     DB   h_gt & 0FFh   
0414   B3                     DB   h_key & 0FFh   
0415   19                     DB   h_fetch & 0FFh   
0416   F5                     DB   h_def & 0FFh   
0417   E8                     DB   h_break & 0FFh   
0418   E4                     DB   h_ret & 0FFh   
0419   72                     DB   h_xor & 0FFh   
041A   85                     DB   h_alloc & 0FFh   
041B   CE                     DB   h_grave & 0FFh   
041C   CA                     DB   h_tor & 0FFh   
041D   7A                     DB   h_or & 0FFh   
041E   1C                     DB   h_fromr & 0FFh   
041F   82                     DB   h_not & 0FFh   
0420                PTABEND:      
0420                          ENDIF      
0420                             ; =============================================================================
0420                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0420                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0420                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0420                             ;  they are the host's KEY and CONOUT routines themselves.
0420                             ; 
0420                             ;  A running program reads the keyboard only through getk and pollk, which
0420                             ;  between them give the break key its rules:
0420                             ;    - Ctrl-C stops the program;
0420                             ;    - any other key that the break check reads is held in KEYBUF for the
0420                             ;      next "?", and a newer one takes its place;
0420                             ;    - "?" (getk) takes the held key first;
0420                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0420                             ;      key like any other, but two of them within about 250 ms still stop it.
0420                             ;  Both are called straight from a handler, never from a routine under one:
0420                             ;  the checked build's report counts on finding one return address above the
0420                             ;  data stack.
0420                             ; =============================================================================
0420                          IFN   CPM   
0420                RAWK:     EQU   KEY   
0420                          ENDIF      
0420                             ; pollk: the break check (see rpushn).
0420   CD 06 FF     POLLK:    CALL   rawk   
0423   C8                     RET   Z   ; no key
0424   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0427   FE 03        PK1:      CP   3   ; (getk joins here)
0429   C0                     RET   NZ   
042A                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
042A                             ; the program has turned it off, wait about 250 ms for one more key: a
042A                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
042A                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
042A   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
042D   B7                     OR   A   
042E   CA B7 04     CT0:      JP   Z,brk   
0431   D5                     PUSH   DE   
0432   11 10 27               LD   DE,250*MSLOOP   
0435   CD 06 FF     CT1:      CALL   rawk   
0438   20 05                  JR   NZ,ct2   
043A   1B                     DEC   DE   
043B   7A                     LD   A,D   
043C   B3                     OR   E   
043D   20 F6                  JR   NZ,ct1   
043F   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0440   FE 03                  CP   3   
0442   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0444   B7                     OR   A   
0445   28 03                  JR   Z,ct3   
0447   32 7A 82               LD   (KEYBUF),A   
044A   3E 03        CT3:      LD   A,3   
044C   B7                     OR   A   
044D   C9                     RET      
044E                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
044E   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
044F   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0452   7E                     LD   A,(HL)   
0453   36 00                  LD   (HL),0   
0455   E1                     POP   HL   
0456   B7                     OR   A   
0457   C0                     RET   NZ   
0458   CD 06 FF               CALL   rawk   
045B   C8                     RET   Z   
045C   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
045E                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
045E                          ENDIF      ;   (with the editor, both stacks are cleared);
045E                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
045E                          ENDIF      
045E                          IF   CHECKED   
045E                BRK:      EQU   e_break   ;   the checked build reports B
045E                          ENDIF      
045E                          IF   CPM   
                                 ; The routines a generic build keeps in page zero (see there). Here they are
                                 ; out of the way of the handlers, which must fit in the image's first two
                                 ; pages.
                    RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
                              LD   D,(IY+1)   
                              INC   IY   
                              INC   IY   
                              RET      
                    NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
045E                          ENDIF      
045E                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
045E                          ENDIF      
045E                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JR   putc   
                    PUTK:     EX   (SP),HL   ; print the byte after the CALL
                              LD   A,(HL)   
                              INC   HL   
                              EX   (SP),HL   
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                                 ; It keeps every register but A and the flags: BDOS may change any of them
                                 ; (IX and IY too, in a Z80 BDOS or BIOS).
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              PUSH   IX   
                              PUSH   IY   
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              POP   IY   
                              POP   IX   
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              OR   A   ; (for getk)
                              RET      
045E                          ENDIF      
045E                             ; =============================================================================
045E                             ;  Checked build: the checks and the error report
045E                             ; =============================================================================
045E                          IF   CHECKED   
045E                             ; chkstk: both stacks are checked once per character, not in every handler.
045E                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
045E                             ; the constant carries if it is above (cells were popped that were never
045E                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
045E                             ; a character late at most: the bytes above DSTOP and the guard band below
045E                             ; the page take what happens meanwhile. DE is free between characters.
045E   EB           CHKSTK:   EX   DE,HL   
045F   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0462   39                     ADD   HL,SP   
0463   EB                     EX   DE,HL   
0464   38 1E                  JR   C,e_under   
0466   14                     INC   D   
0467   20 17                  JR   NZ,e_over   
0469   FD E5                  PUSH   IY   ; the return stack: in its page (or it has
046B   D1                     POP   DE   ;   overflowed), and not above its empty
046C   7A                     LD   A,D   ;   position (an underflow stays inside the
046D   FE 80                  CP   RSPAGE   ;   page, in the guard band)
046F   7B                     LD   A,E   
0470   20 0B                  JR   NZ,e_rover   
0472   FE E1                  CP   RSTOP&0FFh+1   
0474   D8                     RET   C   
0475   FD 21 E0 80            LD   IY,RSTOP   ; return stack underflow: it counts as empty
0479   3E 72                  LD   A,"r"   
047B   18 3C                  JR   errp   
047D   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
047F   11                     DB   11h   ; (LD DE,nn hides the next entry)
0480   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0482   18 35                  JR   errp   
0484   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0487   3E 73                  LD   A,"s"   
0489   18 48                  JR   error   
048B                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
048B                             ; was never defined still holds 0000h, and the byte there is a reserved one
048B                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
048B                             ; an undefined word. The call is undone, so the place is the call itself.
048B   04           E_HI:     INC   B   
048C   10 3D                  DJNZ   e_resv   ; (B is as it was, and is not 0)
048E                          ;*Macro unroll:  POPR
048E   CF                     DS   1-CPM,0CFh   
048F                          DS   CPM,0CDh   
048F                          DS   CPM,AROP&0FFh   
048F                          DS   CPM,AROP/256   
048F   42                     LD   B,D   
0490   4B                     LD   C,E   
0491   3E 55                  LD   A,"U"   
0493   18 3E                  JR   error   
0495                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0495                             ; the count. Stop if the top is not below the limit page, or is below the
0495                             ; program's end.
0495                CHKHP:       
0495                          ENDIF      
0495                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0495                          ENDIF      
0495                          IF   CHECKED*(1-CPM)   
0495                             ; (Here the program's space is under 32K, so a top that wrapped
0495                             ; round always falls outside it.)
0495   7C                     LD   A,H   
0496   FE F0                  CP   HEAPLIM   
0498   30 09                  JR   NC,e_heap   
049A                          ENDIF      
049A                          IF   CHECKED   
049A   D5                     PUSH   DE   
049B   EB                     EX   DE,HL   
049C   2A 38 82               LD   HL,(NPEND)   
049F   19                     ADD   HL,DE   ; carry: at or above the program's end
04A0   EB                     EX   DE,HL   
04A1   D1                     POP   DE   
04A2   D8                     RET   C   
04A3   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
04A4   ED 52                  SBC   HL,DE   
04A6   3E 48                  LD   A,"H"   
04A8   18 0F                  JR   errp   
04AA                             ; chkst: stop unless HL is in the program's own space: from the letter page
04AA                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
04AA                             ; whatever lies above the limit are safe. Memory above the heap top but
04AA                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
04AA                             ; It is the page of HL + 1 that is tested, so that one test serves both
04AA                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
04AA                             ; Keeps HL and BC. It runs on into its own error entry.
04AA   23           CHKST:    INC   HL   
04AB   7C                     LD   A,H   
04AC   2B                     DEC   HL   
04AD   FE 82                  CP   LETPAGE   
04AF   38 03                  JR   C,e_store   
04B1                          ENDIF      
04B1                          IF   CHECKED*(1-CPM)   
04B1   FE F0                  CP   HEAPLIM   
04B3   D8                     RET   C   
04B4                          ENDIF      
04B4                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
04B4                          ENDIF      
04B4                          IF   CHECKED   
04B4                             ; Error entries. Each loads its letter and then hides the next entry inside
04B4                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
04B4   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
04B6   11                     DB   11h   
04B7   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
04B9                             ; errp: an error found inside a routine: drop its return address first.
04B9   D1           ERRP:     POP   DE   
04BA   18 17                  JR   error   
04BC                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
04BC                             ; back in TOS. prstr"s return address goes first. But if "$' had no
04BC                             ; address at all (the stack was empty), it is s, found now: chkstk, called
04BC                             ; one cell up, sees the stack past its empty place then.
04BC   D1           E_DOLLAR:   POP   DE   
04BD   E1                     POP   HL   
04BE   CD 5E 04               CALL   chkstk   
04C1   E5                     PUSH   HL   
04C2   2A 34 82               LD   HL,(RSAVE)   
04C5   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
04C6   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
04C7   4D                     LD   C,L   ;   past the opening quote, which is the place
04C8   3E 51                  LD   A,"Q"   
04CA   11                     DB   11h   
04CB   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
04CD   11                     DB   11h   
04CE   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
04D0   11                     DB   11h   
04D1   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
04D3                             ; error: the report, then the end. A = the letter, BC = one past the place,
04D3                             ; HL = TOS, and both stacks as the report is to show them:
04D3                             ; 
04D3                             ;   Err X @ line,col
04D3                             ;   D:n: the top 8 cells at most, bottom to top
04D3                             ;   R:n
04D3   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
04D4   5F                     LD   E,A   
04D5   CD 1A 02               CALL   pnl   
04D8   45 72 72 20 22         DB   "Err ",22h   
04DD   7B                     LD   A,E   
04DE                          ;*Macro unroll:  PUTA
04DE   EF                     DS   1-CPM,0EFh   
04DF                          DS   CPM,0CDh   
04DF                          DS   CPM,APUT&0FFh   
04DF                          DS   CPM,APUT/256   
04DF   CD 20 02               CALL   pmsg   
04E2   20 40 20 22            DB   " @ ",22h   
04E6   0B                     DEC   BC   ; BC = the place
04E7                             ; The line and column. A place below the program is in the line
04E7                             ; buffer: line 0. Otherwise count the LFs from the program's start;
04E7                             ; DE = the line's number, HL = where it starts.
04E7   21 80 82               LD   HL,LINEBUF   
04EA   11 00 00               LD   DE,0   
04ED   78                     LD   A,B   
04EE   FE 83                  CP   PROG/256   
04F0   38 14                  JR   C,er3   
04F2   24                     INC   H   
04F3   6B                     LD   L,E   ; HL = PROG
04F4   13           ER1:      INC   DE   ; a new line starts at HL
04F5   E5                     PUSH   HL   
04F6   7D           ER2:      LD   A,L   
04F7   91                     SUB   C   
04F8   7C                     LD   A,H   
04F9   98                     SBC   A,B   
04FA   30 09                  JR   NC,er2x   ; reached the place
04FC   7E                     LD   A,(HL)   
04FD   23                     INC   HL   
04FE   FE 0A                  CP   10   
0500   20 F4                  JR   NZ,er2   
0502   F1                     POP   AF   
0503   18 EF                  JR   er1   
0505   E1           ER2X:     POP   HL   
0506   C5           ER3:      PUSH   BC   
0507   E5                     PUSH   HL   
0508   EB                     EX   DE,HL   
0509   CD D1 03               CALL   pdec   ; the line
050C                          ;*Macro unroll:  PUTK    2Ch             ; ','
050C   3E                     DS   1-CPM,3Eh   ; ","
050D   2C                     DS   1-CPM,2Ch   
050E   EF                     DS   1-CPM,0EFh   
050F                          DS   CPM,0CDh   
050F                          DS   CPM,APTK&0FFh   
050F                          DS   CPM,APTK/256   
050F                          DS   CPM,2Ch   
050F   D1                     POP   DE   
0510   E1                     POP   HL   
0511   B7                     OR   A   
0512   ED 52                  SBC   HL,DE   
0514   23                     INC   HL   
0515   CD D1 03               CALL   pdec   ; the column
0518                             ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
0518                             ;                       R:n
0518                             ; TOS is in memory with the rest (pushed) by now.
0518   CD 1A 02               CALL   pnl   
051B   44 3A 22               DB   "D:",22h   
051E   21 FA 81               LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
0521   ED 72                  SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
0523                             ;   and holds nothing; pnl left the carry clear)
0523   CD 68 05               CALL   phalf   ; the depth
0526                          ;*Macro unroll:  PUTK    3Ah             ; ':'
0526   3E                     DS   1-CPM,3Eh   ; ":"
0527   3A                     DS   1-CPM,3Ah   
0528   EF                     DS   1-CPM,0EFh   
0529                          DS   CPM,0CDh   
0529                          DS   CPM,APTK&0FFh   
0529                          DS   CPM,APTK/256   
0529                          DS   CPM,3Ah   
0529   79                     LD   A,C   
052A   FE 09                  CP   9   
052C   38 0A                  JR   C,er6   
052E   CD 20 02               CALL   pmsg   
0531   20 2E 2E 2E 22         DB   " ...",22h   
0536   0E 08                  LD   C,8   
0538   26 00        ER6:      LD   H,0   ; C = the number of cells to show
053A   69                     LD   L,C   
053B   29                     ADD   HL,HL   
053C   39                     ADD   HL,SP   ; HL -> just above the deepest of them
053D   0C                     INC   C   
053E   0D           ER7:      DEC   C   
053F   28 0F                  JR   Z,er8   
0541   2B                     DEC   HL   
0542   56                     LD   D,(HL)   
0543   2B                     DEC   HL   
0544   5E                     LD   E,(HL)   
0545   E5                     PUSH   HL   
0546                          ;*Macro unroll:  PUTK    20h             ; ' '
0546   3E                     DS   1-CPM,3Eh   ; " "
0547   20                     DS   1-CPM,20h   
0548   EF                     DS   1-CPM,0EFh   
0549                          DS   CPM,0CDh   
0549                          DS   CPM,APTK&0FFh   
0549                          DS   CPM,APTK/256   
0549                          DS   CPM,20h   
0549   EB                     EX   DE,HL   
054A   CD C9 03               CALL   psgn   
054D   E1                     POP   HL   
054E   18 EE                  JR   er7   
0550   CD 1A 02     ER8:      CALL   pnl   
0553   52 3A 22               DB   "R:",22h   
0556   FD E5                  PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
0558   E1                     POP   HL   ;   at most one entry below its page), so
0559   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough
055B   95                     SUB   L   
055C   6F                     LD   L,A   
055D   26 00                  LD   H,0   
055F   CD 68 05               CALL   phalf   
0562   CD 1A 02               CALL   pnl   
0565   22                     DB   22h   
0566                          ENDIF      
0566                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
0566                          ENDIF      
0566                          IF   CHECKED*EDITOR   
0566   18 4A                  JR   edit0   ; back to the editor, with both stacks cleared
0568                          ENDIF      
0568                          IF   CHECKED   
0568                             ; phalf: print half of HL, and leave it in C.
0568   CB 3C        PHALF:    SRL   H   
056A   CB 1D                  RR   L   
056C   E5                     PUSH   HL   
056D   CD D1 03               CALL   pdec   
0570   C1                     POP   BC   
0571   C9                     RET      
0572                          ENDIF      
0572                             ; =============================================================================
0572                             ;  The line editor (EDITOR = 1)
0572                             ; 
0572                             ;  The interpreter starts here, and a program that ends comes back here.
0572                             ;  There is no prompt. It follows the spec's suggested standard for a line
0572                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0572                             ; 
0572                             ;    n text    put the text in as line n; the lines from n on move down. A
0572                             ;              number past the end (or 0) adds the line at the end.
0572                             ;    n         take line n out
0572                             ;    anything else is run at once, as B8Script. (Start such a line with a
0572                             ;    space if it would begin with a digit.)
0572                             ; 
0572                             ;  A command key ends the line too, and takes what was typed as its argument:
0572                             ; 
0572                             ;    ^G        run the program
0572                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0572                             ;              list until another key is pressed; Ctrl-C ends it.
0572                             ;    n ^E      put line n in the input line; Return puts it back, changed
0572                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0572                             ;              last time). Generic: what is typed, or pasted, from now until
0572                             ;              ^Z replaces the program; it is not echoed.
0572                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0572                             ;              time). Generic: the text is printed, as it is.
0572                             ;    ^N        new: no program
0572                             ;    ^X        leave (to LEAVE)
0572                             ; 
0572                             ;  In the line: the left and right arrow keys move the cursor;
0572                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0572                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0572                             ;  sent to the terminal, so any terminal will do.
0572                             ; 
0572                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0572                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0572                             ;  125 characters; the one character after a line number separates it from
0572                             ;  the text and is not stored. The text is kept as it is typed, each line
0572                             ;  ending in CR LF, at PROG.
0572                             ; 
0572                             ;  What lasts from one line to the next: the program, the words, the
0572                             ;  variables and the data stack. An error or a break clears both stacks. The
0572                             ;  return stack starts empty for every line.
0572                             ; 
0572                             ;  Things to know:
0572                             ;    - Reset empties the program (generic builds).
0572                             ;    - A word's address points into the program, so run the program again
0572                             ;      after editing it.
0572                             ;    - Nothing is printed between a program's output and what is typed next.
0572                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0572                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0572                             ;      (The stored program never comes back to the line, so it may.)
0572                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0572                             ;      read of the other builds.
0572                             ; 
0572                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0572                             ;  the last line left there, with TOS pushed like the rest.
0572                             ; =============================================================================
0572                          IF   EDGEN   
0572                INIT:        ; reset (A = 0)
0572                          ENDIF      
0572                          IF   EDGEN*CHECKED   
0572                             ; Clear the lower half of the letter page: every variable starts at 0, and
0572                             ; every word cell holds 0000h, the address an undefined word is caught at
0572                             ; (see e_hi).
0572   21 00 82               LD   HL,LET   
0575   77           INI1:     LD   (HL),A   
0576   2C                     INC   L   
0577   F2 75 05               JP   P,ini1   ; +00h to +7Fh
057A                          ENDIF      
057A                          IF   EDGEN   
057A   18 36                  JR   edit0   
057C                          ENDIF      
057C                          IF   EDITOR   
057C                             ; Right arrow: one to the right, by printing the character there
057C   7D           RIGHT:    LD   A,L   
057D   BB                     CP   E   
057E   28 4E                  JR   Z,ed1   ; at the end
0580   7E                     LD   A,(HL)   
0581   2C                     INC   L   
0582   18 2B                  JR   lf1   
0584                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0584                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0584                             ; ends the sequence, and act on C (right) and D (left).
0584   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0587   CD 06 FF     ES1:      CALL   rawk   
058A   20 0A                  JR   NZ,es2   
058C   0B                     DEC   BC   
058D   78                     LD   A,B   
058E   B1                     OR   C   
058F   20 F6                  JR   NZ,es1   
0591   CD FB 05               CALL   fin   ; no second key: the line is dropped
0594   18 27                  JR   edit   
0596   FE 5B        ES2:      CP   "["   
0598   20 34                  JR   NZ,ed1   ; not a sequence known here
059A   CD 54 06     ES3:      CALL   ekey   
059D   FE 40                  CP   40h   
059F   38 F9                  JR   C,es3   ; (its parameters)
05A1   D6 43                  SUB   "C"   
05A3   28 D7                  JR   Z,right   
05A5   3D                     DEC   A   ; "D"?
05A6   20 26                  JR   NZ,ed1   ; no: on into left
05A8                             ; Left arrow: the cursor goes one to the left
05A8   7D           LEFT:     LD   A,L   
05A9   87                     ADD   A,A   
05AA   28 22                  JR   Z,ed1   ; (L = 80h: at the start)
05AC   2D                     DEC   L   
05AD   3E 08                  LD   A,8   
05AF                          ;*Macro unroll: lf1:    PUTA
05AF   EF           LF1:      DS   1-CPM,0EFh   
05B0                          DS   CPM,0CDh   
05B0                          DS   CPM,APUT&0FFh   
05B0                          DS   CPM,APUT/256   
05B0   18 1C                  JR   ed1   
05B2                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
05B2                             ;   is shown, in case the program had hidden it and could not show it again.
05B2                             ; skend: a program that ended inside skip: its return address goes.
05B2                             ; edend: a program that ended: TOS joins the rest of the data stack.
05B2   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
05B5                          ENDIF      
05B5                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
05B5                          ENDIF      
05B5                          IF   EDITOR*(1-ANS)   
05B5   3E 01                  LD   A,1   
05B7   CD 12 FF               CALL   CONCUR   ; show the cursor
05BA                          ENDIF      
05BA                          IF   EDITOR   
05BA   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
05BB   D1           SKEND:    POP   DE   
05BC   E5           EDEND:    PUSH   HL   
05BD                             ; edit: start a new input line.
05BD   FD 21 E0 80  EDIT:     LD   IY,RSTOP   ; the return stack is empty
05C1                          ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
05C1                          DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
05C1                          DS   CPM+FAST-CPM*FAST,21h   
05C1                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
05C1                          DS   CPM+FAST-CPM*FAST,ANXT/256   
05C1   21 00 00               LD   HL,0   
05C4   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
05C7   22 3A 82               LD   (EDLN),HL   ; no line is being edited
05CA   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
05CD   5D                     LD   E,L   ;   E = the end of the line (its low byte)
05CE   CD 54 06     ED1:      CALL   ekey   
05D1   FE 7F                  CP   7Fh   
05D3   28 38                  JR   Z,bsp   ; DEL
05D5   FE 20                  CP   " "   
05D7   30 4E                  JR   NC,insc   
05D9   FE 09                  CP   9   
05DB   28 4A                  JR   Z,insc   ; Tab is text
05DD   FE 08                  CP   8   
05DF   28 2C                  JR   Z,bsp   
05E1   FE 1B                  CP   1Bh   
05E3   28 9F                  JR   Z,esc   
05E5   E5                     PUSH   HL   ; a command key? Look it up
05E6   21 5A 06               LD   HL,cmds   
05E9   06 08                  LD   B,NCMD   
05EB   BE           ED2:      CP   (HL)   
05EC   23                     INC   HL   
05ED   28 07                  JR   Z,ed3   
05EF   23                     INC   HL   
05F0   23                     INC   HL   
05F1   10 F8                  DJNZ   ed2   
05F3   E1                     POP   HL   
05F4   18 D8                  JR   ed1   ; no: the key is ignored
05F6   7E           ED3:      LD   A,(HL)   
05F7   23                     INC   HL   
05F8   66                     LD   H,(HL)   
05F9   6F                     LD   L,A   
05FA   E3                     EX   (SP),HL   ; the command's address: fin returns to it
05FB                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
05FB                             ; terminal. Leaves BC -> the line and HL -> the NUL.
05FB   26 82        FIN:      LD   H,LETPAGE   
05FD   6B                     LD   L,E   
05FE   36 0D                  LD   (HL),13   
0600   2C                     INC   L   
0601   36 0A                  LD   (HL),10   
0603   2D                     DEC   L   
0604   CD 5B 07               CALL   prl   ; (prints the CR LF)
0607   36 00                  LD   (HL),0   
0609   01 80 82               LD   BC,LINEBUF   
060C   C9                     RET      
060D                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
060D                             ; left, the rest of the line moves down over it, and the last place (now a
060D                             ; space) is printed over along with the rest.
060D   7D           BSP:      LD   A,L   
060E   87                     ADD   A,A   
060F   28 BD                  JR   Z,ed1   ; at the start
0611   2D                     DEC   L   
0612                          ;*Macro unroll:  PUTK    08h             ; backspace
0612   3E                     DS   1-CPM,3Eh   ; backspace
0613   08                     DS   1-CPM,08h   
0614   EF                     DS   1-CPM,0EFh   
0615                          DS   CPM,0CDh   
0615                          DS   CPM,APTK&0FFh   
0615                          DS   CPM,APTK/256   
0615                          DS   CPM,08h   
0615   E5                     PUSH   HL   
0616   2C           BS1:      INC   L   
0617   7E                     LD   A,(HL)   
0618   2D                     DEC   L   
0619   77                     LD   (HL),A   
061A   2C                     INC   L   
061B   7D                     LD   A,L   
061C   BB                     CP   E   
061D   20 F7                  JR   NZ,bs1   
061F   2D                     DEC   L   
0620   36 20                  LD   (HL)," "   
0622   E1                     POP   HL   
0623   53                     LD   D,E   
0624   1D                     DEC   E   
0625   18 15                  JR   ic2   
0627                             ; A character goes in at the cursor: it ripples up through the rest of the
0627                             ; line, the cursor moves on, and the rest is printed again.
0627   47           INSC:     LD   B,A   
0628   7B                     LD   A,E   
0629   FE FD                  CP   0FDh   
062B   28 A1                  JR   Z,ed1   ; the line is full: 125 characters
062D   78                     LD   A,B   
062E                          ;*Macro unroll:  PUTA
062E   EF                     DS   1-CPM,0EFh   
062F                          DS   CPM,0CDh   
062F                          DS   CPM,APUT&0FFh   
062F                          DS   CPM,APUT/256   
062F   E5                     PUSH   HL   
0630   7E           IC1:      LD   A,(HL)   
0631   70                     LD   (HL),B   
0632   47                     LD   B,A   
0633   7D                     LD   A,L   
0634   2C                     INC   L   
0635   BB                     CP   E   
0636   20 F8                  JR   NZ,ic1   
0638   E1                     POP   HL   
0639   2C                     INC   L   
063A   1C                     INC   E   
063B   53                     LD   D,E   
063C   CD 41 06     IC2:      CALL   tail   
063F   18 8D                  JR   ed1   
0641                             ; tail: print the line from the cursor to D (a low byte), and bring the
0641                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0641   4D           TAIL:     LD   C,L   
0642   7D           TA1:      LD   A,L   
0643   BA                     CP   D   
0644   28 05                  JR   Z,ta2   
0646   7E                     LD   A,(HL)   
0647                          ;*Macro unroll:  PUTA
0647   EF                     DS   1-CPM,0EFh   
0648                          DS   CPM,0CDh   
0648                          DS   CPM,APUT&0FFh   
0648                          DS   CPM,APUT/256   
0648   2C                     INC   L   
0649   18 F7                  JR   ta1   
064B   7D           TA2:      LD   A,L   
064C   B9                     CP   C   
064D   C8                     RET   Z   
064E                          ;*Macro unroll:  PUTK    08h             ; backspace
064E   3E                     DS   1-CPM,3Eh   ; backspace
064F   08                     DS   1-CPM,08h   
0650   EF                     DS   1-CPM,0EFh   
0651                          DS   CPM,0CDh   
0651                          DS   CPM,APTK&0FFh   
0651                          DS   CPM,APTK/256   
0651                          DS   CPM,08h   
0651   2D                     DEC   L   
0652   18 F7                  JR   ta2   
0654                             ; ekey: wait for a key
0654   CD 06 FF     EKEY:     CALL   rawk   
0657   28 FB                  JR   Z,ekey   
0659   C9                     RET      
065A                             ; The command keys, and where each goes (after fin).
065A   0D           CMDS:     DB   13   
065B   A2 06                  DW   cret   
065D   07                     DB   7   ; ^G
065E   EA 06                  DW   crun   
0660   0C                     DB   12   ; ^L
0661   03 07                  DW   clist   
0663   05                     DB   5   ; ^E
0664   78 06                  DW   cedln   
0666   12                     DB   18   ; ^R
0667   67 07                  DW   cread   
0669   17                     DB   23   ; ^W
066A   94 07                  DW   cwrite   
066C   0E                     DB   14   ; ^N
066D   72 06                  DW   cnew   
066F   18                     DB   24   ; ^X
0670   09 FF                  DW   LEAVE   
0672                NCMD:     EQU   8   
0672                             ; ^N: no program
0672   AF           CNEW:     XOR   A   
0673   32 00 83               LD   (PROG),A   
0676   18 6F        GED0:     JR   gedit   
0678                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0678                             ; line it was: Return puts the text back in its place.
0678   CD BA 02     CEDLN:    CALL   rdnum   
067B   E5                     PUSH   HL   
067C   CD 43 07               CALL   find   ; HL -> the line, or the NUL if there is none
067F   D1                     POP   DE   
0680   7E                     LD   A,(HL)   
0681   B7                     OR   A   
0682   28 F2                  JR   Z,ged0   
0684   ED 53 3A 82            LD   (EDLN),DE   
0688   11 80 82               LD   DE,LINEBUF   
068B   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
068C   FE 0D                  CP   13   
068E   28 0D                  JR   Z,ce2   
0690   FE 0A                  CP   10   
0692   28 09                  JR   Z,ce2   
0694   12                     LD   (DE),A   
0695                          ;*Macro unroll:  PUTA
0695   EF                     DS   1-CPM,0EFh   
0696                          DS   CPM,0CDh   
0696                          DS   CPM,APUT&0FFh   
0696                          DS   CPM,APUT/256   
0696   23                     INC   HL   
0697   1C                     INC   E   
0698   7B                     LD   A,E   
0699   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
069B   20 EE                  JR   NZ,ce1   
069D   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
069E   5D                     LD   E,L   
069F   C3 CE 05               JP   ed1   
06A2                             ; Return. If ^E put a line here, the text goes back in its place. If not:
06A2                             ; a number and text is a line to put in, a number alone a line to take out,
06A2                             ; and anything else is run where it is.
06A2   E5           CRET:     PUSH   HL   ; the end of what was typed
06A3   2A 3A 82               LD   HL,(EDLN)   
06A6   7C                     LD   A,H   
06A7   B5                     OR   L   
06A8   28 07                  JR   Z,cr1   
06AA   E5                     PUSH   HL   
06AB   CD 33 07               CALL   delln   
06AE   E1                     POP   HL   
06AF   18 13                  JR   ins   
06B1   CD BA 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
06B4   79                     LD   A,C   ; C is still 80h if there was no number:
06B5   87                     ADD   A,A   ;   only then is twice it 0
06B6   28 36                  JR   Z,st0p   ; no number: run the line
06B8   0A                     LD   A,(BC)   
06B9   FE 0D                  CP   13   
06BB   20 06                  JR   NZ,cr2   
06BD   D1                     POP   DE   ; the number alone: take that line out
06BE   CD 33 07               CALL   delln   
06C1   18 24                  JR   gedit   
06C3   03           CR2:      INC   BC   ; step over the one character after the number
06C4                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
06C4                             ; CR and LF included, and copy it in.
06C4   CD 43 07     INS:      CALL   find   ; HL -> where it goes
06C7   D1                     POP   DE   ; the end of what was typed
06C8   7B                     LD   A,E   
06C9   91                     SUB   C   ; A = the length of the text, with its CR LF
06CA   C5                     PUSH   BC   ; the text
06CB   4F                     LD   C,A   
06CC   06 00                  LD   B,0   
06CE   C5                     PUSH   BC   ; its length
06CF   54                     LD   D,H   
06D0   5D                     LD   E,L   ; DE = where it goes
06D1   AF                     XOR   A   
06D2   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
06D3   ED B1                  CPIR      ; HL -> one past the program's NUL
06D5   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
06D7   44                     LD   B,H   
06D8   4D                     LD   C,L   
06D9   19                     ADD   HL,DE   
06DA   2B                     DEC   HL   ; HL -> the NUL
06DB   EB                     EX   DE,HL   
06DC   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
06DD   E5                     PUSH   HL   
06DE   19                     ADD   HL,DE   ; the NUL's new place
06DF   EB                     EX   DE,HL   
06E0   ED B8                  LDDR      ; move the rest of the program up
06E2   C1                     POP   BC   ; the length
06E3   D1                     POP   DE   ; where it goes
06E4   E1                     POP   HL   ; the text
06E5   ED B0                  LDIR      
06E7   C3 BD 05     GEDIT:    JP   edit   
06EA                             ; ^G: run the program. st0p: run the typed line (BC -> it).
06EA   01 00 83     CRUN:     LD   BC,PROG   
06ED   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
06EE   E1           ST0P:     POP   HL   ; (the end of what was typed)
06EF                             ; st0: start running at BC. The heap starts after the stored program's NUL.
06EF   21 00 83     ST0:      LD   HL,PROG   
06F2   AF                     XOR   A   
06F3   BE           ST1:      CP   (HL)   
06F4   23                     INC   HL   
06F5   20 FC                  JR   NZ,st1   
06F7   22 7C 82               LD   (HEAP),HL   
06FA                          ENDIF      
06FA                          IF   EDITOR*QUICK   
06FA   CD 70 03               CALL   skclr   ; every run starts with an empty skip cache
06FD                          ENDIF      
06FD                          IF   EDITOR*CHECKED   
06FD                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
06FD   E7                     DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
06FE                          DS   CPM,0CDh   
06FE                          DS   CPM,ANEG&0FFh   
06FE                          DS   CPM,ANEG/256   
06FE   22 38 82               LD   (NPEND),HL   ;   release below it
0701                          ENDIF      
0701                          IF   EDITOR   
0701   E1                     POP   HL   ; TOS: the data stack is as the last line left it
0702                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0702   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0703                          DS   CPM+FAST-CPM*FAST,0DDh   
0703                          DS   CPM+FAST-CPM*FAST,0E9h   
0703                             ; ^L: list from line n. DE = the number of the line at HL.
0703   CD BA 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
0706   7C                     LD   A,H   
0707   B5                     OR   L   
0708   20 01                  JR   NZ,li0   
070A   2C                     INC   L   ;   then from line 1
070B   E5           LI0:      PUSH   HL   
070C   CD 43 07               CALL   find   
070F   D1                     POP   DE   
0710   7E           LI1:      LD   A,(HL)   
0711   B7                     OR   A   
0712   28 D3                  JR   Z,gedit   ; the end of the text
0714   CD 06 FF               CALL   rawk   
0717   28 09                  JR   Z,li3   ; no key: carry on
0719   FE 03                  CP   3   
071B   C4 54 06               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
071E   FE 03                  CP   3   
0720   28 C5                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
0722   E5           LI3:      PUSH   HL   
0723   D5                     PUSH   DE   
0724   EB                     EX   DE,HL   
0725   CD D1 03               CALL   pdec   ; the line's number,
0728   3E 20                  LD   A," "   
072A                          ;*Macro unroll:  PUTA                    ;   a space,
072A   EF                     DS   1-CPM,0EFh   ;   a space,
072B                          DS   CPM,0CDh   
072B                          DS   CPM,APUT&0FFh   
072B                          DS   CPM,APUT/256   
072B   D1                     POP   DE   
072C   E1                     POP   HL   
072D   13                     INC   DE   
072E   CD 5B 07               CALL   prl   ;   and the line
0731   18 DD                  JR   li1   
0733                             ; delln: take line n (in HL) out: copy everything after it down over it.
0733   CD 43 07     DELLN:    CALL   find   
0736   54                     LD   D,H   
0737   5D                     LD   E,L   
0738   CD 51 07               CALL   nxl   ; HL -> the next line
073B   7E           DE1:      LD   A,(HL)   
073C   12                     LD   (DE),A   
073D   23                     INC   HL   
073E   13                     INC   DE   
073F   B7                     OR   A   
0740   20 F9                  JR   NZ,de1   
0742   C9                     RET      
0743                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0743                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0743   EB           FIND:     EX   DE,HL   
0744   21 00 83               LD   HL,PROG   
0747   1B           FI1:      DEC   DE   
0748   7A                     LD   A,D   
0749   B3                     OR   E   
074A   C8                     RET   Z   
074B   CD 51 07               CALL   nxl   
074E   20 F7                  JR   NZ,fi1   
0750   C9                     RET      
0751                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0751                             ; stop at the NUL that ends the text (and return zero).
0751   7E           NXL:      LD   A,(HL)   
0752   B7                     OR   A   
0753   C8                     RET   Z   
0754   23                     INC   HL   
0755   FE 0A                  CP   10   
0757   20 F8                  JR   NZ,nxl   
0759   B7                     OR   A   
075A   C9                     RET      
075B                             ; prl: print the line at HL, to its LF; HL -> just past it.
075B   7E           PRL:      LD   A,(HL)   
075C                          ;*Macro unroll:  PUTA
075C   EF                     DS   1-CPM,0EFh   
075D                          DS   CPM,0CDh   
075D                          DS   CPM,APUT&0FFh   
075D                          DS   CPM,APUT/256   
075D   7E                     LD   A,(HL)   
075E   23                     INC   HL   
075F   FE 0A                  CP   10   
0761   20 F8                  JR   NZ,prl   
0763   C9                     RET      
0764                          ENDIF      
0764                          IF   EDGEN   
0764   C3 BD 05     GED1:     JP   edit   
0767                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
0767                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
0767                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
0767                             ; line with no end is given one. Nothing is echoed, and there is no check
0767                             ; for running out of memory.
0767   21 FF 82     CREAD:    LD   HL,PROG-1   
076A   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
076C   23                     INC   HL   ;   the line buffer's last, and spare)
076D   CD 54 06     RD1:      CALL   ekey   
0770   4F                     LD   C,A   
0771   FE 1A                  CP   1Ah   
0773   20 02                  JR   NZ,rd2   
0775   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
0777   FE 0A        RD2:      CP   10   
0779   20 07                  JR   NZ,rd3   
077B   2B                     DEC   HL   
077C   BE                     CP   (HL)   
077D   23                     INC   HL   
077E   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
0780   3E 0D                  LD   A,13   ; anywhere else it ends the line
0782   77           RD3:      LD   (HL),A   
0783   23                     INC   HL   
0784   FE 0D                  CP   13   
0786   20 03                  JR   NZ,rd4   
0788   36 0A                  LD   (HL),10   ; after a CR goes a LF
078A   23                     INC   HL   
078B   79           RD4:      LD   A,C   
078C   FE 1A                  CP   1Ah   
078E   20 DD                  JR   NZ,rd1   
0790   36 00                  LD   (HL),0   
0792   18 D0                  JR   ged1   
0794                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
0794   21 00 83     CWRITE:   LD   HL,PROG   
0797   7E           CW1:      LD   A,(HL)   
0798   B7                     OR   A   
0799   28 C9                  JR   Z,ged1   
079B                          ;*Macro unroll:  PUTA
079B   EF                     DS   1-CPM,0EFh   
079C                          DS   CPM,0CDh   
079C                          DS   CPM,APUT&0FFh   
079C                          DS   CPM,APUT/256   
079C   23                     INC   HL   
079D   18 F8                  JR   cw1   
079F                          ENDIF      
079F                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
079F                          ENDIF      
079F                             ; =============================================================================
079F                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
079F                          ENDIF      
079F                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
079F                          ENDIF      
079F                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              CALL   skclr   ; an empty skip cache
                              JP   st2   
079F                          ENDIF      
079F                          IF   FAST   
                                 ; =============================================================================
                                 ;  The speed build (FAST = 1)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the speed build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the speed build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:      ; &
                              POP   HL   
                              LD   A,H   
                              AND   D   
                              LD   H,A   
                              LD   A,L   
                              AND   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_OR:       ; |
                              POP   HL   
                              LD   A,H   
                              OR   D   
                              LD   H,A   
                              LD   A,L   
                              OR   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_XOR:      ; ^
                              POP   HL   
                              LD   A,H   
                              XOR   D   
                              LD   H,A   
                              LD   A,L   
                              XOR   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NOT:      ; ~
                              LD   A,E   
                              CPL      
                              LD   L,A   
                              LD   A,D   
                              CPL      
                              LD   H,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_MUL:      ; *
                              POP   HL   ; (the two the other way round: the same)
                              JP   mulq   
                    FS_OPEN:      ; (
                              LD   A,D   
                              OR   E   
                              POP   HL   
                              JR   Z,fs_op0   
                              PUSH   BC   ; the block start
                              JP   rpushn   
                    FS_OP0:   CALL   skip   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CLOSE:      ; )
                              LD   A,D   
                              OR   E   
                              POP   HL   
                              JR   Z,fs_cl0   
                              LD   C,(IY+0)   ; the block start, read where it is
                              LD   B,(IY+1)   
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                              ;*Macro unroll: fs_cl0: POPR
                    FS_CL0:   DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_RET:   EX   DE,HL   ; ]
                              LD   C,(IY+0)   
                              LD   B,(IY+1)   
                              INC   IY   
                              INC   IY   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FD0:      EX   DE,HL   ; 0
                              PUSH   HL   
                              LD   HL,0   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JP   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
