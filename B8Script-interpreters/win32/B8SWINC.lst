   380 000000EB 74F8                <1>         jz      nx
   381 000000ED E820030000          <1>         call    skip
   382 000000F2 84C0                <1>         test    al,al                   ; skip returns 0 for ')'
   383 000000F4 75EC                <1>         jnz     h_ret
   384 000000F6 EBEC                <1>         jmp     rdrop
   385                              <1> 
   386                              <1> ; ')' ( flag -- ): true jumps back to the block start (and keeps it); false
   387                              <1> ; drops it and carries on. The loop-back looks at the break key.
   388 000000F8 6685DB              <1> h_close:test    bx,bx
