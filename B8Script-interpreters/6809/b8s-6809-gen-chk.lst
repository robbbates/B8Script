0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Motorola 6809
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ;  Follows the design of the Z80 interpreter (z80/b8s-z80.asm).
0000                             ; 
0000                             ;  Two builds, selected by the CHECKED line below (CPM is always 0: the 6809
0000                             ;  has no CP/M; the line is kept only so that build.sh works):
0000                             ;    CHECKED  0 = no checks (spec: an unchecked build checks nothing)
0000                             ;             1 = a checked build: variables start at 0, words start
0000                             ;                 undefined, and every error in the spec's table stops the
0000                             ;                 program with the four-line report, then goes to EXIT:
0000                             ;                   Err X @ line,col
0000                             ;                   <up to 16 characters of the text at the place>
0000                             ;                   Stk n: ... v v v      (n = depth, then the top 8 values)
0000                             ;                   Rtn n
0000                             ;                 S/s data stack over/underflow, R/r return stack over/
0000                             ;                 underflow, H heap, O store outside the program's space,
0000                             ;                 W bad character after [, U undefined word, Q no closing
0000                             ;                 quote, X reserved byte, Z divide by zero, N unbalanced or
0000                             ;                 mismatched brackets, B Ctrl-C.
0000                             ; 
0000                             ;  A third line, ANSI, says how the four console codes (`@ `^ `_ `?) work:
0000                             ;    ANSI     1 = they send ANSI escape sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In both builds Ctrl-C stops a running program (the unchecked build goes
0000                             ;  to EXIT without a word): see the console layer below for the rules, the
0000                             ;  held key and the break-off cell at 827Bh.
0000                             ; 
0000                             ;  Assembler: asm80, M6809 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0 (no CP/M on the 6809)
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    Y    IP: the address of the next program character to read
0000                             ;    U    the data stack pointer. The stack grows down and U points at the
0000                             ;         top cell (TOS); nothing is cached in a register, because every
0000                             ;         dispatch needs A, B and X as scratch. Cells are big-endian here.
0000                             ;         (Only the stacks are big-endian: cells in RAM that the program can
0000                             ;         see - variables, the heap pointer, anything @ and ! reach - are
0000                             ;         little-endian, as the spec says, so @ and ! swap the bytes.)
0000                             ;    S    the return stack. A word call is a plain push of Y. Entries are
0000                             ;         2 bytes, big-endian. Handlers are called with JSR, so the return
0000                             ;         address of the dispatcher is on top of S while a handler runs.
0000                             ;    DP   the letter page, so the letter-page variables below cost 2-byte
0000                             ;         direct addressing. Nothing else may change DP.
0000                             ;    A B X are scratch. Every handler is entered by JSR and ends in RTS (one
0000                             ;    byte). A handler that pushes or pops the return stack first pulls the
0000                             ;    dispatcher's return address into X (PULS X) and ends with JMP ,X.
0000                             ; 
0000                             ;  Dispatch (unchecked build). PTAB holds one byte per punctuation character:
0000                             ;  the low byte of the handler's distance from PTAB. The handlers of the last
0000                             ;  characters (in code order) start within 256 bytes after PTAB, the handlers
0000                             ;  of the first NPG1 characters in the 256 bytes after that. The assembler
0000                             ;  works NPG1 out from where five handlers landed, and testing/chktab09.py
0000                             ;  checks the layout. The checked build is bigger than that reach, so its
0000                             ;  table holds whole addresses instead.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM areas:
0000                             ; 
0000                             ;    8000h-80FFh  return stack (S); empty = 8100h. Unchecked: 127 entries.
0000                             ;                 Checked: 112 entries (S down to 8020h); the 32 bytes below
0000                             ;                 are a guard band for what a handler and an interrupt push
0000                             ;                 on top of a full stack before the check runs.
0000                             ;    8100h-81FFh  data stack (U). Unchecked: 127 cells, empty = 8200h.
0000                             ;                 Checked: 126 cells (U from 81FCh, empty, down to 8100h):
0000                             ;                 the 4 bytes above are a guard band, so a handler that runs
0000                             ;                 on an empty stack writes there and not on the letter
0000                             ;                 cells. A push past the last cell lands on the return
0000                             ;                 stack's bottom entry (80FEh), and the program stops with S
0000                             ;                 before anything reads it.
0000                             ;    8200h-82FFh  letter page (LET): A..Z at +00h..+33h, a..z at +40h..+73h
0000                             ;                 (a word cell is always 64 bytes below its variable), the
0000                             ;                 heap pointer at +7Ch (= z10+), interpreter variables in the
0000                             ;                 gaps, and the -n? line buffer at +80h..+FFh. The break-off
0000                             ;                 cell is at +7Bh (827Bh); +7Ah is free.
0000                             ;    8300h-       PROG, the program text, NUL-terminated; the heap starts
0000                             ;                 after the NUL and grows to HEAPLIM*256 (F000h)
0000                             ;    F000h-       this image (ROM). The reset vector (FFFEh) must point to
0000                             ;                 `start` (see the listing); the image does not contain it.
0000                             ;    FF03h-FF0Bh  the console routines (CONOUT, KEY) and EXIT are supplied
0000                             ;                 by the system and need no space here.
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LET..HEAPLIM*256.
0000                             ; -----------------------------------------------------------------------------
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (end the
0000                             ;   routine with TSTA / RTS, or a plain LDA).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   Both are called with JSR. They may change A and CC and must preserve
0000                             ;   B, X, Y, U and DP.
0000                          IF   1-ANSI   
                                 ; ---- with ANSI = 0 the console codes call these (JMP or JSR) ----------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to the row in X and the column in
                                 ;     D, both from 0
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if D = 0 (the Z flag is set to
                                 ;     match), on if not
                                 ;   All four may change A, B, X and CC and must preserve Y, U and DP.
0000                          ENDIF      
0000                RSPAGE:   EQU   80h   
0000                DSPAGE:   EQU   81h   
0000                LETPAGE:   EQU   82h   
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                             ; (the checked startup counts on it being
0000                             ; the page after LETPAGE)
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                MSLOOP:   EQU   20   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (direct-page offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   7Ch   ; z10+, the heap pointer (little-endian)
0000                KEYBUF:   EQU   34h   ; gap after Z: a key held back by the break check
0000                COUNT:    EQU   35h   ; the break check's countdown (1 look in 256)
0000                AT:       EQU   36h   ; checked: the address of the character being
0000                             ;   run (big-endian), the place an error reports
0000                PEND:     EQU   38h   ; checked: the program's end, the first byte
0000                             ;   after its NUL (big-endian): the heap's floor
0000                SSAV:     EQU   3Ah   ; checked: S as each character starts (big-
0000                             ;   endian): the return stack an error reports
0000                SEED:     EQU   76h   ; the random seed (8276h, little-endian): the
0000                             ;   cell whose address `. gives. Nothing sets
0000                             ;   it at the start but the checked build's
0000                             ;   clearing of the page
0000                BRKOFF:   EQU   7Bh   ; the break-off cell (827Bh, z9+): 0 = the
0000                             ;   break key is on
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+100h   ; empty return stack
0000                RSLIM:    EQU   RSPAGE*256+20h   ; checked: S may go no lower between characters
0000                RSREP:    EQU   RSTOP-16   ; checked: S while the error report runs
0000                DSTOP:    EQU   DSPAGE*256+100h-4*CHECKED   ; empty data stack (a guard if checked)
0000                DSLIM:    EQU   DSPAGE*256   ; checked: U may go no lower between characters
F000                          .ORG   0F000h   
F000                             ; =============================================================================
F000                             ;  Startup
F000                             ; =============================================================================
F000   10 CE 81 00  START:    LDS   #RSTOP   
F004   CE 81 FC               LDU   #DSTOP   
F007   86 82                  LDA   #LETPAGE   
F009   1F 8B                  TFR   A,DP   
F00B                          IF   CHECKED   
F00B                             ; Zero the whole letter page: every variable starts at 0, every word
F00B                             ; cell at 0 (undefined: a call stops with U), and so do the
F00B                             ; interpreter's own cells in the gaps (KEYBUF and the rest). A is
F00B                             ; still LETPAGE; 256 rounds leave X at the next page, PROG.
F00B   5F                     CLRB      
F00C   1F 01                  TFR   D,X   
F00E   6F 80        SZ:       CLR   ,X+   
F010   5A                     DECB      
F011   26 FB                  BNE   sz   
F013                          ENDIF      
F013   10 8E 83 00            LDY   #PROG   ; the reading position
F017                          IF   1-CHECKED   
                              CLR   <KEYBUF   ; no key held
                              CLR   <BRKOFF   ; the break key is on
                              TFR   Y,X   ; the heap starts after the program's NUL
F017                          ENDIF      
F017   A6 80        SC:       LDA   ,X+   
F019   26 FC                  BNE   sc   
F01B   1F 10                  TFR   X,D   
F01D   D7 7C                  STB   <HEAP   ; (little-endian)
F01F   97 7D                  STA   <HEAP+1   
F021                          IF   CHECKED   
F021   9F 38                  STX   <PEND   ; the heap may never go below this
F023                          ENDIF      
F023                             ; =============================================================================
F023                             ;  The inner loop: read one character and sort it by range.
F023                             ; 
F023                             ;    00h          end of program
F023                             ;    01h-20h, 7Fh       ignored (control, space, DEL)
F023                             ;    80h-FFh      reserved: ignored, or X in the checked build
F023                             ;    30h-39h      digit: read a whole number
F023                             ;    41h-5Ah      A-Z: call the word in that letter's cell
F023                             ;    61h-7Ah      a-z: push the address of that letter's cell
F023                             ;    the rest     punctuation: JSR through PTAB, 32 entries, in code order
F023                             ; =============================================================================
F023                NEXT:        
F023                          IF   CHECKED   
F023                             ; Both stacks are checked once per character, not in every handler:
F023                             ; the pointer minus its limit, taken as unsigned, must be no more
F023                             ; than the stack's size. Below the limit (an overflow) it wraps to
F023                             ; FFxxh, and the compare leaves N set; above the empty point (an
F023                             ; underflow) it is just over the size, and N is clear.
F023   30 C9 7F 00            LEAX   (0-DSLIM)&0FFFFh,U   
F027   8C 00 FC               CMPX   #DSTOP-DSLIM   
F02A   22 61                  BHI   e_ds   
F02C   30 E9 7F E0            LEAX   (0-RSLIM)&0FFFFh,S   
F030   8C 00 E0               CMPX   #RSTOP-RSLIM   
F033   22 61                  BHI   e_rs   
F035   10 9F 36               STY   <AT   ; the place, should this character fail
F038   10 DF 3A               STS   <SSAV   ; and the return stack, as it is now
F03B                          ENDIF      
F03B   A6 A0                  LDA   ,Y+   
F03D   27 72                  BEQ   fin   ; NUL ends the program
F03F   80 21                  SUBA   #21h   ; A = c - 21h
F041   25 E0                  BLO   next   ; 01h-20h ignored
F043   81 0F                  CMPA   #0Fh   
F045   25 22                  BLO   punct   ; 21h-2Fh: PTAB index 0-14
F047   81 19                  CMPA   #19h   
F049   25 26                  BLO   digit   ; 30h-39h
F04B   81 20                  CMPA   #20h   
F04D   25 18                  BLO   p3a   ; 3Ah-40h: A = 19h-1Fh
F04F   80 20                  SUBA   #20h   ; A = c - 41h
F051   81 1A                  CMPA   #1Ah   
F053   25 28                  BLO   upper   ; 41h-5Ah: A = letter index 0-25
F055   81 20                  CMPA   #20h   
F057   25 0C                  BLO   p5b   ; 5Bh-60h
F059   81 3A                  CMPA   #3Ah   
F05B   25 1A                  BLO   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
F05D   81 3E                  CMPA   #3Eh   
F05F                          IF   1-CHECKED   
                              BHS   next   ; 7Fh-FFh: ignored
F05F                          ENDIF      
F05F                          IF   CHECKED   
F05F   27 C2                  BEQ   next   ; 7Fh (DEL): ignored
F061   22 43                  BHI   e_resv   ; 80h-FFh: reserved
F063                          ENDIF      
F063   80 1A                  SUBA   #1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
F065   8B 06        P5B:      ADDA   #6   ; 5Bh-60h: -4 in all, index 22-27
F067   80 0A        P3A:      SUBA   #0Ah   ; 3Ah-40h: index 15-21
F069                             ; Punctuation: A = the PTAB index.
F069   8E F1 1C     PUNCT:    LDX   #PTAB   
F06C                          IF   1-CHECKED   
                                 ; The handler is at PTAB + D, where B is the table byte and A is 1
                                 ; for the first NPG1 characters, 0 for the rest.
                              LDB   A,X   
                              CMPA   #NPG1   ; carry: one of the first NPG1
                              LDA   #0   ; (leaves the carry alone)
                              ROLA      
                              JSR   D,X   ; the handler ends in RTS
F06C                          ENDIF      
F06C                          IF   CHECKED   
F06C   48                     ASLA      ; the table holds whole addresses
F06D   AD 96                  JSR   [A,X]   
F06F                          ENDIF      
F06F   20 B2                  BRA   next   
F071                             ; Digits: step back onto the first digit and read the whole number.
F071   31 3F        DIGIT:    LEAY   -1,Y   
F073   8D 4D                  BSR   rdnum   
F075   20 AC                  BRA   next   
F077                             ; a-z: push the cell's address (the cell is the variable)
F077   8D 3B        LOWER:    BSR   cellx   
F079   36 10                  PSHU   X   
F07B   20 A6                  BRA   next   
F07D                             ; A-Z: call the word. The IP (the address after the letter) goes on the
F07D                             ; return stack, and the IP becomes the address in the letter's cell.
F07D                             ; Checked: a cell still 0 (high byte 0) was never defined, since every
F07D                             ; address in the program's space is 8200h or more. The call has not been
F07D                             ; made yet, so the report shows the stacks as they were.
F07D   8D 35        UPPER:    BSR   cellx   
F07F   E6 84                  LDB   ,X   
F081   A6 01                  LDA   1,X   
F083                          IF   CHECKED   
F083   27 27                  BEQ   e_undef   
F085                          ENDIF      
F085   34 20                  PSHS   Y   
F087   1F 02                  TFR   D,Y   
F089   8D 55                  BSR   pollk   ; the break check, at every word call
F08B   20 96                  BRA   next   
F08D                             ; =============================================================================
F08D                             ;  Checked build: the error entries.
F08D                             ; 
F08D                             ;  Each entry loads its letter and then hides the next entry inside a 3-byte
F08D                             ;  CMPX # (the 8Ch), so that a run of them falls through to one place. The
F08D                             ;  place an error reports is the address in AT, which the inner loop sets to
F08D                             ;  each character before it runs it; the one error that reports another
F08D                             ;  place (W, at the character after the [) changes AT before it comes.
F08D                             ; 
F08D                             ;  The report counts the return stack from SSAV, which the inner loop sets
F08D                             ;  to S before each character, so an error may come from any depth of
F08D                             ;  calls: a handler, chkst under one, or ctlc under "?" or the break check.
F08D                             ;  (An r sets SSAV to the empty stack.) The inner loop's own entries are
F08D                             ;  here, where its short branches reach them; those reached from a handler
F08D                             ;  are after h_cstore, just ahead of the report.
F08D                             ; =============================================================================
F08D                          IF   CHECKED   
F08D                             ; ---- reached from the inner loop -------------------------------------------
F08D                             ; The stack checks branch here with N set for an overflow (the pointer is
F08D                             ; below its limit) and clear for an underflow. After an underflow that stack
F08D                             ; counts as empty.
F08D   2B 11        E_DS:     BMI   e_S   
F08F   CE 81 FC               LDU   #DSTOP   ; s
F092   86 73                  LDA   #"s"   
F094   20 18                  BRA   eall   
F096   2B 0B        E_RS:     BMI   e_R   
F098   8E 81 00               LDX   #RSTOP   ; r
F09B   9F 3A                  STX   <SSAV   
F09D   86 72                  LDA   #"r"   
F09F   8C                     FCB   8Ch   
F0A0   86 53        E_S:      LDA   #"S"   
F0A2   8C                     FCB   8Ch   
F0A3   86 52        E_R:      LDA   #"R"   
F0A5   8C                     FCB   8Ch   
F0A6   86 58        E_RESV:   LDA   #"X"   ; a reserved byte (80h-FFh) outside a string
F0A8   8C                     FCB   8Ch   
F0A9   86 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (from ctlc, at any depth)
F0AB   8C                     FCB   8Ch   
F0AC   86 55        E_UNDEF:   LDA   #"U"   ; a word never defined (its cell is still 0)
F0AE   7E F3 15     EALL:     JMP   error   
F0B1                          ENDIF      
F0B1   7E FF 09     FIN:      JMP   EXIT   ; the program has ended
F0B4                             ; cellx: A = letter index (0-25, or 32-57 for lowercase) -> X = cell address
F0B4   48           CELLX:    ASLA      
F0B5   8E 82 00               LDX   #LET   
F0B8   30 86                  LEAX   A,X   
F0BA   39                     RTS      
F0BB                             ; isdig: A = the character at IP minus "0"; the carry is set if it is a digit
F0BB   A6 A4        ISDIG:    LDA   ,Y   
F0BD   80 30                  SUBA   #"0"   
F0BF   81 0A                  CMPA   #10   
F0C1   39           AB9:      RTS      
F0C2                             ; rdnum: read decimal digits at IP and push the value; IP is left on the
F0C2                             ; first non-digit. Values wrap at 16 bits, as the spec says. The running
F0C2                             ; value lives in the new top cell: V = V*10 + digit.
F0C2   4F           RDNUM:    CLRA      
F0C3   5F                     CLRB      
F0C4   36 06                  PSHU   D   
F0C6   8D F3        RD1:      BSR   isdig   
F0C8   24 F7                  BHS   ab9   
F0CA   31 21                  LEAY   1,Y   
F0CC   34 02                  PSHS   A   
F0CE   EC C4                  LDD   ,U   
F0D0   58                     ASLB      
F0D1   49                     ROLA      
F0D2   58                     ASLB      
F0D3   49                     ROLA      
F0D4   E3 C4                  ADDD   ,U   ; 5V
F0D6   58                     ASLB      
F0D7   49                     ROLA      ; 10V
F0D8   EB E0                  ADDB   ,S+   
F0DA   89 00                  ADCA   #0   
F0DC   ED C4                  STD   ,U   
F0DE   20 E6                  BRA   rd1   
F0E0                             ; =============================================================================
F0E0                             ;  Console layer: the break key. A running program reads the keyboard only
F0E0                             ;  through pollk and getk, which between them give the break key its rules:
F0E0                             ;    - Ctrl-C (03h) stops the program;
F0E0                             ;    - any other key that the break check reads is held in KEYBUF for the
F0E0                             ;      next "?", and a newer one takes its place;
F0E0                             ;    - "?" (getk) takes the held key first;
F0E0                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
F0E0                             ;      key like any other, but two of them within about 250 ms still stop it.
F0E0                             ;  On a break the unchecked build ends without a word (EXIT); the checked
F0E0                             ;  one reports B. All three keep B, X, Y and U.
F0E0                             ; =============================================================================
F0E0                             ; pollk: the break check, at every word call and every true ")" loop-back.
F0E0                             ; It looks at the keyboard only once in 256 calls.
F0E0   0A 35        POLLK:    DEC   <COUNT   
F0E2   26 37                  BNE   cc9   
F0E4   BD FF 06               JSR   KEY   
F0E7   27 32                  BEQ   cc9   ; no key
F0E9   97 34                  STA   <KEYBUF   ; held for the next "?"
F0EB   20 0C                  BRA   ctlc   
F0ED                             ; getk: a key for "?", or A = 0 with the zero flag set if there is none.
F0ED   96 34        GETK:     LDA   <KEYBUF   ; a held key goes first, and is taken out of
F0EF   0F 34                  CLR   <KEYBUF   ;   the buffer (it has been through ctlc)
F0F1   4D                     TSTA      
F0F2   26 27                  BNE   cc9   
F0F4   BD FF 06               JSR   KEY   
F0F7   27 22                  BEQ   cc9   
F0F9                             ; ctlc: a key has been read. If it is Ctrl-C and the break key is on, that
F0F9                             ; is the end. If the program has turned it off, wait about 250 ms for one
F0F9                             ; more key: a second Ctrl-C is the end too; any other key is held (the
F0F9                             ; newest wins), and the Ctrl-C goes on: A = 3, zero flag clear.
F0F9   81 03        CTLC:     CMPA   #3   
F0FB   26 1E                  BNE   cc9   
F0FD   0D 7B                  TST   <BRKOFF   
F0FF   27 A8                  BEQ   brk   
F101   34 10                  PSHS   X   
F103   8E 13 88               LDX   #250*MSLOOP   
F106   BD FF 06     CC1:      JSR   KEY   
F109   26 06                  BNE   cc2   
F10B   30 1F                  LEAX   -1,X   
F10D   26 F7                  BNE   cc1   
F10F   20 06                  BRA   cc3   
F111   81 03        CC2:      CMPA   #3   
F113   27 94                  BEQ   brk   
F115   97 34                  STA   <KEYBUF   
F117   86 03        CC3:      LDA   #3   
F119   35 10                  PULS   X   
F11B   39           CC9:      RTS      
F11C                          IF   1-CHECKED   
                    BRK:      EQU   fin   ; the unchecked build stops without a word;
F11C                          ENDIF      
F11C                          IF   CHECKED   
F11C                BRK:      EQU   e_break   ;   the checked build reports B (the report
F11C                          ENDIF      ;   takes S from SSAV, so the depth of the
F11C                             ;   calls here doesn't matter)
F11C                             ; =============================================================================
F11C                             ;  Dispatch table, in code order.
F11C                             ; 
F11C                             ;  Unchecked build: one byte per character, the low byte of the handler's
F11C                             ;  distance from PTAB. NPG1 is how many characters, from the start, have
F11C                             ;  handlers more than 255 bytes past PTAB. ] \ [ @ ? sit where the two ranges
F11C                             ;  meet (in falling code order for this), and which side each lands on is
F11C                             ;  worked out here. (One division to a line: asm80 only rounds down when it
F11C                             ;  stores a value.)
F11C                             ; 
F11C                             ;  Checked build: it has more code than the two ranges hold, so its table
F11C                             ;  holds whole addresses and there are no rules about where handlers go.
F11C                             ; =============================================================================
F11C                          IF   1-CHECKED   
                    PGRET:    EQU   (h_ret-PTAB)/256   ; 0 = first range, 1 = second
                    PGBRK:    EQU   (h_break-PTAB)/256   
                    PGDEF:    EQU   (h_def-PTAB)/256   
                    PGFET:    EQU   (h_fetch-PTAB)/256   
                    PGKEY:    EQU   (h_key-PTAB)/256   
                    NPG1:     EQU   20 + PGKEY + PGFET + PGDEF + PGBRK + PGRET   
F11C                          ENDIF      
F11C                PTAB:        
F11C                          IF   1-CHECKED   
                              FCB   (h_store-PTAB) & 0FFh   ; !
                              FCB   (h_str-PTAB) & 0FFh   ; "
                              FCB   (h_num-PTAB) & 0FFh   ; #
                              FCB   (h_print-PTAB) & 0FFh   ; $
                              FCB   (h_swap-PTAB) & 0FFh   ; %
                              FCB   (h_and-PTAB) & 0FFh   ; &
                              FCB   (h_emit-PTAB) & 0FFh   ; '
                              FCB   (h_open-PTAB) & 0FFh   ; (
                              FCB   (h_close-PTAB) & 0FFh   ; )
                              FCB   (h_mul-PTAB) & 0FFh   ; *
                              FCB   (h_add-PTAB) & 0FFh   ; +
                              FCB   (h_cfetch-PTAB) & 0FFh   ; ,
                              FCB   (h_sub-PTAB) & 0FFh   ; -
                              FCB   (h_cstore-PTAB) & 0FFh   ; .
                              FCB   (h_div-PTAB) & 0FFh   ; /
                              FCB   (h_dup-PTAB) & 0FFh   ; :
                              FCB   (h_drop-PTAB) & 0FFh   ; ;
                              FCB   (h_lt-PTAB) & 0FFh   ; <
                              FCB   (h_eq-PTAB) & 0FFh   ; =
                              FCB   (h_gt-PTAB) & 0FFh   ; >
                              FCB   (h_key-PTAB) & 0FFh   ; ?
                              FCB   (h_fetch-PTAB) & 0FFh   ; @
                              FCB   (h_def-PTAB) & 0FFh   ; [
                              FCB   (h_break-PTAB) & 0FFh   ; \
                              FCB   (h_ret-PTAB) & 0FFh   ; ]
                              FCB   (h_xor-PTAB) & 0FFh   ; ^
                              FCB   (h_alloc-PTAB) & 0FFh   ; _
                              FCB   (h_grave-PTAB) & 0FFh   ; `
                              FCB   (h_tor-PTAB) & 0FFh   ; {
                              FCB   (h_or-PTAB) & 0FFh   ; |
                              FCB   (h_fromr-PTAB) & 0FFh   ; }
                              FCB   (h_not-PTAB) & 0FFh   ; ~
F11C                          ENDIF      
F11C                          IF   CHECKED   
F11C   F2 EB                  FDB   h_store   ; !
F11E   F2 22                  FDB   h_str   ; "
F120   F3 DF                  FDB   h_num   ; #
F122   F2 D2                  FDB   h_print   ; $
F124   F2 BE                  FDB   h_swap   ; %
F126   F4 04                  FDB   h_and   ; &
F128   F2 CA                  FDB   h_emit   ; '
F12A   F2 68                  FDB   h_open   ; (
F12C   F2 7C                  FDB   h_close   ; )
F12E   F2 88                  FDB   h_mul   ; *
F130   F4 0C                  FDB   h_add   ; +
F132   F2 74                  FDB   h_cfetch   ; ,
F134   F4 13                  FDB   h_sub   ; -
F136   F2 F7                  FDB   h_cstore   ; .
F138   F4 1E                  FDB   h_div   ; /
F13A   F2 C5                  FDB   h_dup   ; :
F13C   F2 CF                  FDB   h_drop   ; ;
F13E   F2 A6                  FDB   h_lt   ; <
F140   F2 B2                  FDB   h_eq   ; =
F142   F2 A4                  FDB   h_gt   ; >
F144   F2 45                  FDB   h_key   ; ?
F146   F2 3F                  FDB   h_fetch   ; @
F148   F1 D9                  FDB   h_def   ; [
F14A   F1 BA                  FDB   h_break   ; \
F14C   F1 B6                  FDB   h_ret   ; ]
F14E   F1 64                  FDB   h_xor   ; ^
F150   F1 80                  FDB   h_alloc   ; _
F152   F1 9C                  FDB   h_grave   ; `
F154   F1 72                  FDB   h_tor   ; {
F156   F1 5C                  FDB   h_or   ; |
F158   F1 7A                  FDB   h_fromr   ; }
F15A   F1 6D                  FDB   h_not   ; ~
F15C                          ENDIF      
F15C                PTABEND:      
F15C                             ; =============================================================================
F15C                             ;  Handlers that must start in the first range (within 255 bytes of PTAB)
F15C                             ;  in the unchecked build: ^ _ ` 00bbIHwg ~
F15C                             ; =============================================================================
F15C   EC C1        H_OR:     LDD   ,U++   
F15E   AA C4                  ORA   ,U   
F160   EA 41                  ORB   1,U   
F162   20 06                  BRA   st0   
F164   EC C1        H_XOR:    LDD   ,U++   
F166   A8 C4                  EORA   ,U   
F168   E8 41                  EORB   1,U   
F16A   ED C4        ST0:      STD   ,U   
F16C   39                     RTS      
F16D   63 C4        H_NOT:    COM   ,U   
F16F   63 41                  COM   1,U   
F171   39                     RTS      
F172                             ; "{" ( n -- ) R: ( -- n )     The dispatcher's return address comes off the
F172                             ; return stack first (PULS X) and is jumped to at the end.
F172   35 10        H_TOR:    PULS   X   
F174   37 06                  PULU   D   
F176   34 06                  PSHS   D   
F178   6E 84                  JMP   ,X   
F17A                             ; "}" ( -- n ) R: ( n -- )    The dispatcher's return address comes off
F17A                             ; into D and the entry under it into X; D is then jumped to.
F17A   35 16        H_FROMR:   PULS   D,X   
F17C   36 10                  PSHU   X   
F17E   1F 05                  TFR   D,PC   
F180                             ; "_" ( n -- addr ): the heap pointer moves by n (signed: a 16-bit add);
F180                             ; TOS is the old pointer.
F180                             ; Checked: the new top must be at least the program's end (PEND) and below
F180                             ; the limit page. That also catches an add that wraps: the top is always
F180                             ; 8301h-EFFFh and n is -32768..32767, so a sum that carries past FFFFh
F180                             ; lands below 7000h, and one that borrows can't happen.
F180   D6 7C        H_ALLOC:   LDB   <HEAP   
F182   96 7D                  LDA   <HEAP+1   
F184   1F 01                  TFR   D,X   ; the old pointer
F186   E3 C4                  ADDD   ,U   
F188                          IF   CHECKED   
F188   10 93 38               CMPD   <PEND   
F18B   25 04                  BLO   ah9   ; below the program's end
F18D   81 F0                  CMPA   #HEAPLIM   
F18F   25 04                  BLO   ah1   ; the new top must stay below the limit page
F191   86 48        AH9:      LDA   #"H"   
F193   20 41                  BRA   ejmp   ; (with [ below)
F195                AH1:         
F195                          ENDIF      
F195   D7 7C                  STB   <HEAP   
F197   97 7D                  STA   <HEAP+1   
F199   AF C4                  STX   ,U   
F19B   39                     RTS      
F19C                             ; ---- the grave -------------------------------------------------------------
F19C                             ; The grave is a prefix: with the character after it, it is one command.
F19C                             ; GTAB (at the end of the image, just ahead of the handlers) holds each
F19C                             ; character with the place of its handler, as a byte to add to the address
F19C                             ; after that byte. A handler starts with A = the character, is entered by
F19C                             ; the dispatcher's own JSR and ends in RTS.
F19C                             ; A character that is not in the table is unsafe: the unchecked build
F19C                             ; searches on through memory, the checked build stops with W.
F19C                H_GRAVE:      
F19C                          IF   CHECKED   
F19C   10 9F 36               STY   <AT   ; the place of anything that goes wrong in
F19F                          ENDIF      ;   one of these is the character after the grave
F19F   A6 A0                  LDA   ,Y+   
F1A1   8E F4 81               LDX   #GTAB   
F1A4   A1 81        GR1:      CMPA   ,X++   
F1A6                          IF   1-CHECKED   
                              BNE   gr1   
F1A6                          ENDIF      
F1A6                          IF   CHECKED   
F1A6   27 09                  BEQ   gr2   
F1A8   6D 84                  TST   ,X   ; 0 ends the table
F1AA   26 F8                  BNE   gr1   
F1AC   86 57                  LDA   #"W"   
F1AE   7E F3 15               JMP   error   
F1B1                GR2:         
F1B1                          ENDIF      
F1B1   E6 1F                  LDB   -1,X   
F1B3   3A                     ABX      ; the handler: the next entry's address plus it
F1B4   6E 84                  JMP   ,X   
F1B6                             ; ---- the line reader of -n? (see h_key) --------------------------------------
F1B6                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F1B6                             ; (stored, not echoed), every other key is stored and echoed until the line
F1B6                             ; is full. B = the length so far; the low byte of the top cell becomes the
F1B6                             ; most allowed (it holds minus the count on entry).
F1B6                             ; (A macro, because the two builds need it in different places: the
F1B6                             ; unchecked build here, in the first range, where the layout needs these
F1B6                             ; bytes ahead of the handlers that follow; the checked build at the end of
F1B6                             ; the image, out of the way of its short branches.)
F1B6                .macro LINERD,
F1B6                             ; 
F1B6                line:   CMPX    #-127           ; (X = TOS, minus the count)
F1B6                 BHS     ln1
F1B6                 LDA     #-127           ; more than 127 is taken as 127
F1B6                 STA     1,U
F1B6                ln1:    NEG     1,U
F1B6                 LDX     #LINEBUF
F1B6                 CLRB
F1B6                ln2:    JSR     getk
F1B6                 BEQ     ln2
F1B6                 CMPA    #13
F1B6                 BEQ     ln5
F1B6                 CMPA    #8
F1B6                 BEQ     ln4
F1B6                 CMPB    1,U
F1B6                 BHS     ln2             ; full
F1B6                 STA     B,X
F1B6                 INCB
F1B6                ln3:    JSR     CONOUT
F1B6                 BRA     ln2
F1B6                ln4:    TSTB                    ; Backspace: nothing to take back?
F1B6                 BEQ     ln2
F1B6                 DECB
F1B6                 BRA     ln3             ; echo it
F1B6                ln5:    STA     B,X             ; A = 13
F1B6                 STX     ,U
F1B6                 RTS
F1B6                .endm
F1B6                 
F1B6                          IF   1-CHECKED   
                              ;*Macro unroll:  LINERD
                    LINE:     CMPX   #-127   
                              BHS   ln1   
                              LDA   #-127   
                              STA   1,U   
                    LN1:      NEG   1,U   
                              LDX   #LINEBUF   
                              CLRB      
                    LN2:      JSR   getk   
                              BEQ   ln2   
                              CMPA   #13   
                              BEQ   ln5   
                              CMPA   #8   
                              BEQ   ln4   
                              CMPB   1,U   
                              BHS   ln2   
                              STA   B,X   
                              INCB      
                    LN3:      JSR   CONOUT   
                              BRA   ln2   
                    LN4:      TSTB      
                              BEQ   ln2   
                              DECB      
                              BRA   ln3   
                    LN5:      STA   B,X   
                              STX   ,U   
                              RTS      
F1B6                          ENDIF      
F1B6                             ; ---- where the two ranges meet ---------------------------------------------
F1B6                             ; The first range ends somewhere among the next five handlers, ] \ [ @ ?
F1B6                             ; (they are in falling code order for this): NPG1 follows. Every handler
F1B6                             ; below them must start in the second range, and every one above in the
F1B6                             ; first.
F1B6                             ; "]" returns: pop an address and jump to it. (PULS X,Y: the dispatcher's
F1B6                             ; return address into X, then the saved IP into Y.)
F1B6   35 30        H_RET:    PULS   X,Y   
F1B8   6E 84                  JMP   ,X   
F1BA                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F1BA                             ; drops the block start, "]" returns. No closer at all ends the program.
F1BA   EC C1        H_BREAK:   LDD   ,U++   
F1BC   27 60                  BEQ   sk9   ; false: nothing to do
F1BE   8D 3F                  BSR   skip   
F1C0   4D                     TSTA      ; skip returns 0 for ")"
F1C1                          IF   CHECKED   
F1C1   10 2B FE EC            LBMI   fin   ; (and FFh for the NUL: the program ends)
F1C5                          ENDIF      
F1C5   26 EF                  BNE   h_ret   
F1C7   35 16        RDROP:    PULS   D,X   ; the return address and the block start
F1C9   1F 05                  TFR   D,PC   ; back to the dispatcher
F1CB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F1CB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F1CB                             ; the body"s address instead. Either way it then skips to the matching "]'.
F1CB                             ; (The unchecked build takes anything that is not a letter as the space; the
F1CB                             ; checked build stops on it.)
F1CB                          IF   CHECKED   
F1CB   81 DF        DEF1:     CMPA   #" "-"A"+256   
F1CD   27 20                  BEQ   def2   
F1CF   31 3F                  LEAY   -1,Y   ; anything but a letter or a space: W. The
F1D1   10 9F 36               STY   <AT   ;   place is that character, just read
F1D4   86 57                  LDA   #"W"   
F1D6   7E F3 15     EJMP:     JMP   error   ; (H and N come here too)
F1D9                          ENDIF      
F1D9   A6 A0        H_DEF:    LDA   ,Y+   
F1DB   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
F1DD   1F 89                  TFR   A,B   ;   lands 64 bytes up
F1DF   C4 DF                  ANDB   #0DFh   ; fold case
F1E1   C1 1A                  CMPB   #26   
F1E3                          IF   1-CHECKED   
                              BHS   def2   ; not a letter
F1E3                          ENDIF      
F1E3                          IF   CHECKED   
F1E3   24 E6                  BHS   def1   
F1E5                          ENDIF      
F1E5   BD F0 B4               JSR   cellx   
F1E8   1F 20                  TFR   Y,D   
F1EA   E7 84                  STB   ,X   ; little-endian
F1EC   A7 01                  STA   1,X   
F1EE   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F1EF   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F1F1                          IF   1-CHECKED   
                                 ; fall into skip
F1F1                          ENDIF      
F1F1                          IF   CHECKED   
F1F1                             ; Checked: the skip must end at a "]" (A = 2), or for a false "(",
F1F1                             ; which comes to opf, at a ")" (A = 0). Anything else stops with N.
F1F1   8D 0C                  BSR   skip   
F1F3   80 02                  SUBA   #2   
F1F5   8C                     FCB   8Ch   ; (CMPX #: steps over the BSR)
F1F6   8D 07        OPF:      BSR   skip   
F1F8   4D                     TSTA      
F1F9   27 23                  BEQ   sk9   ; (an RTS)
F1FB   86 4E                  LDA   #"N"   
F1FD   20 D7                  BRA   ejmp   
F1FF                          ENDIF      
F1FF                             ; skip: read past text to the closer at this level, and return A = 0 if it
F1FF                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F1FF                             ; strings are stepped over whole. B counts the open levels.
F1FF                             ; Unchecked: a NUL first ends the program (for "\" with no closer; anything
F1FF                             ; else that runs into the NUL had unbalanced brackets anyway).
F1FF                             ; Checked: a NUL, or a string that runs into it, returns A = FFh, and the
F1FF                             ; caller decides: "\" ends the program, "(" and "[" stop with N, as they do
F1FF                             ; for a closer of the other kind. The place is the opener, still in AT.
F1FF   5F           SKIP:     CLRB      
F200   A6 A0        SK1:      LDA   ,Y+   
F202                          IF   1-CHECKED   
                              LBEQ   fin   
F202                          ENDIF      
F202                          IF   CHECKED   
F202   27 38                  BEQ   ssn   ; A = FFh
F204                          ENDIF      
F204   81 22                  CMPA   #22h   
F206   26 04                  BNE   sk2   
F208   8D 25                  BSR   skipstr   ; leaves A = 22h, which matches nothing below
F20A                          IF   CHECKED   
F20A   25 12                  BCS   sk9   ; (or FFh, with the carry set: unclosed)
F20C                          ENDIF      
F20C   80 28        SK2:      SUBA   #"("   
F20E   27 0F                  BEQ   sk3   
F210   4A                     DECA      ; ")"
F211   27 08                  BEQ   sk4   
F213   80 32                  SUBA   #"["-")"   
F215   27 08                  BEQ   sk3   
F217   81 02                  CMPA   #"]"-"["   
F219   26 E5                  BNE   sk1   
F21B   5A           SK4:      DECB      
F21C   2A E2                  BPL   sk1   
F21E   39           SK9:      RTS      ; the closer at this level
F21F   5C           SK3:      INCB      
F220   20 DE                  BRA   sk1   
F222                             ; 22h, checked build (the unchecked one is with the handlers below).
F222                             ; Checked: a NUL ends the string too, even right after a "/"; skipstr then
F222                             ; returns A = FFh with the carry set (the carry is clear at the quote), and
F222                             ; """ stops with Q, the string's address already pushed. (skip comes here
F222                             ; for its own NUL as well.)
F222                          IF   CHECKED   
F222   36 20        H_STR:    PSHU   Y   
F224   8D 09                  BSR   skipstr   
F226   10 25 00 E9            LBCS   e_quote   
F22A   39                     RTS      
F22B   A6 A0        SS0:      LDA   ,Y+   ; the character after the "/"
F22D   27 0D                  BEQ   ssn   
F22F   A6 A0        SKIPSTR:   LDA   ,Y+   
F231   27 09                  BEQ   ssn   
F233   81 2F                  CMPA   #"/"   
F235   27 F4                  BEQ   ss0   
F237   81 22                  CMPA   #22h   
F239   26 F4                  BNE   skipstr   
F23B   39                     RTS      ; the quote: C = 0
F23C   80 01        SSN:      SUBA   #1   ; the NUL: A = FFh, C = 1
F23E   39                     RTS      
F23F                          ENDIF      
F23F   AE C4        H_FETCH:   LDX   ,U   ; "@" (the cell in memory is little-endian)
F241   A6 01                  LDA   1,X   
F243   20 32                  BRA   cf1   
F245                             ; "?" ( n -- c ) or ( -n -- addr )
F245                             ;   n > 0: wait about n ms for a key; 0 if none came
F245                             ;   n = 0: wait for a key
F245                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
F245                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
F245   AE C4        H_KEY:    LDX   ,U   
F247   10 2B 03 37            LBMI   line   
F24B   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F24D   BD F0 ED     KT2:      JSR   getk   
F250   26 11                  BNE   kt3   
F252   5A                     DECB      
F253   26 F8                  BNE   kt2   
F255   0C 76                  INC   <SEED   ; a millisecond with no key stirs the random
F257   26 02                  BNE   kt4   ;   seed by one: how long a key takes to come
F259   0C 77                  INC   <SEED+1   ;   is the one thing here that is not the
F25B                KT4:         ;   same every time
F25B   30 1F                  LEAX   -1,X   
F25D   26 EC                  BNE   kt1   ; A = 0 if the time ran out
F25F   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F261   27 E8                  BEQ   kt1   ;   run it again, until a key comes
F263   6F C4        KT3:      CLR   ,U   
F265   A7 41                  STA   1,U   
F267   39                     RTS      
F268                             ; (The line reader, `line`, is the macro LINERD, above: there is no
F268                             ; room for it here, between the short branches.)
F268                             ; =============================================================================
F268                             ;  Handlers that must start in the second range (unchecked build).
F268                             ; =============================================================================
F268                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
F268                             ; the matching ")".
F268   EC C1        H_OPEN:   LDD   ,U++   
F26A                          IF   1-CHECKED   
                              BEQ   skip   ; tail call: skip ends in RTS
F26A                          ENDIF      
F26A                          IF   CHECKED   
F26A   10 27 FF 88            LBEQ   opf   ; checked: skip, and check the closer
F26E                          ENDIF      
F26E   35 10                  PULS   X   
F270   34 20                  PSHS   Y   
F272   6E 84                  JMP   ,X   
F274                             ; 22h pushes the address of the text after it and skips the string.
F274                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
F274                             ; the next character, so "/"" does not end it. Leaves A = 22h. (The checked
F274                             ; build's is after skip.)
F274                          IF   1-CHECKED   
                    H_STR:    PSHU   Y   
                              FCB   8Ch   ; (CMPX #: steps over the LEAY)
                    SS0:      LEAY   1,Y   
                    SKIPSTR:   LDA   ,Y+   
                              CMPA   #"/"   
                              BEQ   ss0   
                              CMPA   #22h   
                              BNE   skipstr   
                              RTS      
F274                          ENDIF      
F274   AE C4        H_CFETCH:   LDX   ,U   ; ","
F276   4F                     CLRA      
F277   E6 84        CF1:      LDB   ,X   
F279   ED C4                  STD   ,U   
F27B   39                     RTS      
F27C                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F27C                             ; drops it and carries on.
F27C   EC C1        H_CLOSE:   LDD   ,U++   
F27E   10 27 FF 45            LBEQ   rdrop   
F282   10 AE 62               LDY   2,S   ; the block start, under the return address
F285   7E F0 E0               JMP   pollk   ; the break check, at every loop-back
F288                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
F288                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F288                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F288   A6 43        H_MUL:    LDA   3,U   
F28A   E6 C4                  LDB   ,U   
F28C   3D                     MUL      ; al*bh
F28D   E7 C4                  STB   ,U   ; (bh is no longer needed)
F28F   A6 42                  LDA   2,U   
F291   E6 41                  LDB   1,U   
F293   3D                     MUL      ; ah*bl
F294   EB C4                  ADDB   ,U   
F296   E7 C4                  STB   ,U   ; the cross terms, low byte
F298   A6 43                  LDA   3,U   
F29A   E6 41                  LDB   1,U   
F29C   3D                     MUL      ; al*bl
F29D   AB C4                  ADDA   ,U   
F29F   33 42                  LEAU   2,U   
F2A1   ED C4                  STD   ,U   
F2A3   39                     RTS      
F2A4                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F2A4   8D 18        H_GT:     BSR   h_swap   ; a > b is b < a
F2A6   8D 10        H_LT:     BSR   cmp   
F2A8   2D 02                  BLT   true   
F2AA   5F           FALSE:    CLRB      
F2AB   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F2AC   C6 FF        TRUE:     LDB   #0FFh   
F2AE   1D                     SEX      ; D = 0000 or FFFF
F2AF   ED C4                  STD   ,U   
F2B1   39                     RTS      
F2B2   8D 04        H_EQ:     BSR   cmp   
F2B4   27 F6                  BEQ   true   
F2B6   20 F2                  BRA   false   
F2B8   EC 42        CMP:      LDD   2,U   
F2BA   10 A3 C1               CMPD   ,U++   
F2BD   39                     RTS      
F2BE                             ; ---- stack, and printing ----------------------------------------------------
