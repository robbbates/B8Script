0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as
0000                             ;                 line and column, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC and HL'; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
0000   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003                          ENDIF      
0003                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
0003   01 00 83               LD   BC,PROG   ; 03  the IP
0006   18 64                  JR   st0   ; 06  (the rest of the startup is close by)
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 C3 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 DA                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 6C                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 6E                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 60                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          IF   1-CHECKED   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D   C6 4B        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE 61                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          IF   (1-CPM)*(1-TABP0)   
0066   16 00                  LD   D,0   
0068                          ENDIF      
0068                          IFN   CPM   
0068   CB 12                  RL   D   ; its page: 0 + carry
006A                          ENDIF      
006A                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
006A                          ENDIF      
006A   D5                     PUSH   DE   ; jump to it; the stack is balanced again
006B   C9                     RET      ;   when the handler starts
006C                             ; The rest of the startup: here so that the generic reset code can reach it
006C                             ; with JR. st0: find the program's NUL; the heap starts after it.
006C                             ; (The editor build has its own copy of this, next to the editor.)
006C                             ; A checked build first clears the lower half of the letter page (A = 0):
006C                             ; every variable starts at 0, every word cell holds 0000h, the address an
006C                             ; undefined word is caught at (see e_hi), and no key is held back.
006C                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006C                          ENDIF      
006C                          IF   (1-CPM)*(1-EDITOR)   
006C   60           ST0:      LD   H,B   
006D   69                     LD   L,C   
006E   AF                     XOR   A   
006F   BE           ST1:      CP   (HL)   
0070   23                     INC   HL   
0071   20 FC                  JR   NZ,st1   
0073                          ENDIF      
0073                          IF   1-EDITOR   
0073   22 7C 82     ST2:      LD   (HEAP),HL   
0076                          ENDIF      
0076                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0076                          ENDIF      
0076                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
0076   67                     LD   H,A   ; (A = 0) no key is held, and the break key
0077   6F                     LD   L,A   ;   is on (the checked build has cleared
0078                          ENDIF      ;   these)
0078                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0078                          ENDIF      
0078                          IF   (1-CHECKED)*(1-EDITOR)   
0078   22 7A 82               LD   (KEYBUF),HL   
007B                          ENDIF      
007B                          IF   1-EDITOR   
007B   D9                     EXX      
007C   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
007F   D9                     EXX      
0080   F7                     RST   30h   ; (its return address is thrown away)
0081                          ENDIF      
0081                             ; In the unchecked generic editor build the table is here, in the first
0081                             ; page, which saves loading D twice. (The other builds have no room for it
0081                             ; here: theirs is further down.)
0081                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0081                          ENDIF      
0081                             ; =============================================================================
0081                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0081                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0081                             ;  is here too: it belongs to "`" and makes the page come out right.
0081                             ; =============================================================================
0081   D1           H_XOR:    POP   DE   
0082   7C                     LD   A,H   
0083   AA                     XOR   D   
0084   67                     LD   H,A   
0085   7D                     LD   A,L   
0086   AB                     XOR   E   
0087   6F                     LD   L,A   
0088   F7                     RST   30h   
0089   D1           H_OR:     POP   DE   
008A   7C                     LD   A,H   
008B   B2                     OR   D   
008C   67                     LD   H,A   
008D   7D                     LD   A,L   
008E   B3                     OR   E   
008F   6F                     LD   L,A   
0090   F7                     RST   30h   
0091   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0092   2B                     DEC   HL   
0093   F7                     RST   30h   
0094                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0094                             ; the same either way); TOS is the old pointer.
0094   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0098                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0098                          ENDIF      
0098   19                     ADD   HL,DE   ; the new top
0099                          IF   CHECKED   
                              CALL   chkhp   
0099                          ENDIF      
0099   22 7C 82               LD   (HEAP),HL   
009C   EB                     EX   DE,HL   
009D   F7                     RST   30h   
009E   D9           EXEC:     EXX      
009F   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00A2   D9                     EXX      
00A3   CD 2B 00               CALL   jphl   
00A6   D9                     EXX      
00A7   2A 34 82               LD   HL,(RSAVE)   
00AA   D9                     EXX      
00AB   E1                     POP   HL   
00AC   F7                     RST   30h   
00AD                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00AD                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00AD                             ; Digits: step back onto the first digit and read the whole number.
00AD   E5           DIGIT:    PUSH   HL   
00AE   0B                     DEC   BC   
00AF   CD 35 02               CALL   rdnum   
00B2   F7                     RST   30h   
00B3                             ; a-z: push the cell's address (the cell is the variable)
00B3   E5           LOWER:    PUSH   HL   
00B4   87                     ADD   A,A   
00B5   6F                     LD   L,A   
00B6   26 82                  LD   H,LETPAGE   
00B8   F7                     RST   30h   
00B9                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00B9                             ; the return stack, and the IP becomes the address in the letter's cell.
00B9   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00BA   EB                     EX   DE,HL   ; park TOS
00BB   87                     ADD   A,A   
00BC   6F                     LD   L,A   
00BD   26 82                  LD   H,LETPAGE   ; HL -> cell
00BF   4E                     LD   C,(HL)   
00C0   2C                     INC   L   
00C1   46                     LD   B,(HL)   ; IP = the word's body
00C2   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00C3                             ; rpushn: move the top cell of the data stack (in memory) to the return
00C3                             ; stack, then next. Everything that pushes the return stack ends here.
00C3                             ; 
00C3                             ; The break key is looked at here, so at every word call and loop-back (and
00C3                             ; block entry and "{"), but only one time in 256: B', which nothing else
00C3                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00C3                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00C3                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00C3                             ; both ways out.)
00C3   D9           RPUSHN:   EXX      
00C4   D1                     POP   DE   
00C5   2B                     DEC   HL   
00C6   72                     LD   (HL),D   
00C7   2B                     DEC   HL   
00C8   73                     LD   (HL),E   
00C9   05                     DEC   B   
00CA   D9                     EXX      
00CB   CC 7D 03               CALL   Z,pollk   
00CE   F7                     RST   30h   
00CF                             ; ---- the grave -------------------------------------------------------------
00CF                             ; The grave is a prefix: with the character after it, it is one command.
00CF                             ; The characters are tested one after another, each SUB taking off the step
00CF                             ; from the one before, so A is 0 (and the carry clear) when a handler is
00CF                             ; reached. Two are here, where they keep the first page as full as the
00CF                             ; layout needs; grave2 has the rest.
00CF                             ; 
00CF                             ;   `!  ( addr -- )  calls the machine code at TOS. The code is entered by
00CF                             ;       CALL with the data stack above the return address; it must keep BC,
00CF                             ;       and on return the top cell becomes the new TOS.
00CF                             ;   `'  ( -- )  new line: CR LF
00CF   0A           H_GRAVE:   LD   A,(BC)   
00D0   03                     INC   BC   
00D1   D6 21                  SUB   "!"   
00D3   28 C9                  JR   Z,exec   
00D5   D6 06                  SUB   27h-"!"   ; "'"
00D7   C2 92 02               JP   NZ,grave2   
00DA   3E 0D                  LD   A,13   
00DC   EF                     RST   28h   
00DD   3E 0A                  LD   A,10   
00DF   EF                     RST   28h   
00E0   F7                     RST   30h   
00E1                             ; ---- where the two pages meet ----------------------------------------------
00E1                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00E1                             ; are in falling code order for this), and where exactly differs between the
00E1                             ; builds: NPG1 follows. Every handler below these four must start in the
00E1                             ; second page, and every one above in the first; chktab.py checks both.
00E1                             ; "]" returns: pop an address and jump to it.
00E1   CF           H_RET:    RST   08h   
00E2   42                     LD   B,D   
00E3   4B                     LD   C,E   
00E4   F7           BRK1:     RST   30h   
00E5                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00E5                             ; drops the block start, "]" returns. No closer at all ends the program.
00E5   7C           H_BREAK:   LD   A,H   
00E6   B5                     OR   L   
00E7   E1                     POP   HL   
00E8   28 FA                  JR   Z,brk1   
00EA   CD 57 02               CALL   skip   
00ED   B7                     OR   A   ; skip returns 0 for ")"
00EE   20 F1                  JR   NZ,h_ret   
00F0   CF           RDROP:    RST   08h   
00F1   F7                     RST   30h   
00F2                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00F2                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00F2                             ; the body"s address instead. Either way it then skips to the matching "]'.
00F2                             ; (The unchecked build takes anything that is not a letter as the space; the
00F2                             ; checked build stops on it.)
00F2   0A           H_DEF:    LD   A,(BC)   
00F3   03                     INC   BC   
00F4   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00F6   5F                     LD   E,A   ;   lands 64 bytes up
00F7   E6 DF                  AND   0DFh   ; fold case
00F9   FE 1A                  CP   26   
00FB   30 0B                  JR   NC,def2   ; not a letter
00FD   CB 23                  SLA   E   
00FF   16 82                  LD   D,LETPAGE   ; DE -> cell
0101   79                     LD   A,C   
0102   12                     LD   (DE),A   
0103   1C                     INC   E   
0104   78                     LD   A,B   
0105   12                     LD   (DE),A   
0106   18 03                  JR   skipnx   
0108                DEF2:        
0108                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0108                          ENDIF      
0108   E5                     PUSH   HL   ; an anonymous block: push its address
0109   60                     LD   H,B   
010A   69                     LD   L,C   
010B                SKIPNX:      
010B                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
010B                          ENDIF      ;   opener, the "[", just before where it starts
010B   CD 57 02     SKIPO:    CALL   skip   
010E   F7                     RST   30h   
010F   5E           H_FETCH:   LD   E,(HL)   ; "@"
0110   23                     INC   HL   
0111   56                     LD   D,(HL)   
0112   EB                     EX   DE,HL   
0113   F7                     RST   30h   
0114                             ; =============================================================================
0114                             ;  Handlers that must start in the image's second page.
0114                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0114                             ;  page.
0114                             ; =============================================================================
0114                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0114                             ; the matching ")".
0114   7C           H_OPEN:   LD   A,H   
0115   B5                     OR   L   
0116   E1                     POP   HL   
0117   28 F2                  JR   Z,skipo   
0119   C5                     PUSH   BC   ; the block starts at the IP
011A   18 A7                  JR   rpushn   
011C                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
011C                             ; drops it and carries on.
011C   7C           H_CLOSE:   LD   A,H   
011D   B5                     OR   L   
011E   E1                     POP   HL   
011F   28 CF                  JR   Z,rdrop   
0121   CF                     RST   08h   ; pop the block start ...
0122   42                     LD   B,D   
0123   4B                     LD   C,E   
0124   C5                     PUSH   BC   
0125   18 9C                  JR   rpushn   ; ... and push it back
0127                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0127                             ; "-" has two jobs: directly before a digit it starts a negative number.
0127   0A           H_SUB:    LD   A,(BC)   
0128   D6 30                  SUB   "0"   
012A   FE 0A                  CP   10   
012C   38 04                  JR   C,negnum   
012E   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
012F   D1           H_ADD:    POP   DE   
0130   19                     ADD   HL,DE   
0131   F7                     RST   30h   
0132   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0133   CD 35 02               CALL   rdnum   
0136   E7                     RST   20h   
0137   F7                     RST   30h   
0138   D1           H_AND:    POP   DE   
0139   7C                     LD   A,H   
013A   A2                     AND   D   
013B   67                     LD   H,A   
013C   7D                     LD   A,L   
013D   A3                     AND   E   
013E   6F                     LD   L,A   
013F   F7                     RST   30h   
0140                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0140                             ; cells first. Flipping both sign bits turns a signed compare into an
0140                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0140                             ; carry into -1 or 0 with no branch.
0140   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0141   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0142   7C                     LD   A,H   
0143   EE 80                  XOR   80h   
0145   67                     LD   H,A   
0146   7A                     LD   A,D   
0147   EE 80                  XOR   80h   
0149   57                     LD   D,A   
014A   ED 52                  SBC   HL,DE   ; carry if HL < DE
014C   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
014E   F7                     RST   30h   
014F   D1           H_EQ:     POP   DE   
0150   B7                     OR   A   
0151   ED 52                  SBC   HL,DE   
0153   7C                     LD   A,H   
0154   B5                     OR   L   
0155   FE 01                  CP   1   ; carry only if a - b = 0
0157   18 F3                  JR   tf   
0159                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0159                             ; multiplier shifts up through A:C.
0159   D1           H_MUL:    POP   DE   ; DE = multiplicand
015A   C5                     PUSH   BC   
015B   7C                     LD   A,H   
015C   4D                     LD   C,L   ; A:C = multiplier
015D   21 00 00               LD   HL,0   
0160   06 10                  LD   B,16   
0162   29           MUL1:     ADD   HL,HL   
0163   CB 21                  SLA   C   
0165   17                     RLA      
0166   30 01                  JR   NC,mul2   
0168   19                     ADD   HL,DE   
0169   10 F7        MUL2:     DJNZ   mul1   
016B   C1                     POP   BC   
016C   F7                     RST   30h   
016D                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
016D                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
016D                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
016D                             ; stops on it.
016D                H_DIV:       
016D                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
016D                          ENDIF      
016D   D1                     POP   DE   ; DE = a, HL = b
016E   C5                     PUSH   BC   ; free BC for udiv
016F   D5                     PUSH   DE   ; a, for r's sign
0170   7A                     LD   A,D   
0171   AC                     XOR   H   
0172   F5                     PUSH   AF   ; S flag = sign of q
0173   CB 7C                  BIT   7,H   
0175   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0178   EB                     EX   DE,HL   
0179   CB 7C                  BIT   7,H   
017B   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
017E   CD 0F 02               CALL   udiv   ; HL = q, DE = r
0181   F1                     POP   AF   
0182   FC 20 00               CALL   M,neg16   ; q's sign
0185   EB                     EX   DE,HL   ; HL = r, DE = q
0186   F1                     POP   AF   ; A = a's high byte
0187   B7                     OR   A   
0188   FC 20 00               CALL   M,neg16   ; r's sign
018B   C1                     POP   BC   
018C   D5                     PUSH   DE   ; q under r
018D   F7                     RST   30h   
018E                             ; ---- stack and storage -----------------------------------------------------
018E   E5           H_DUP:    PUSH   HL   ; ":"
018F   F7                     RST   30h   
0190   E3           H_SWAP:   EX   (SP),HL   ; "%"
0191   F7                     RST   30h   
0192                             ; (The checked build tests the address before it takes the value off the
0192                             ; stack, so that an error report shows both.)
0192                H_CSTORE:      ; "." ( c addr -- )
0192                          IF   CHECKED   
                              CALL   chkst   
0192                          ENDIF      
0192   D1                     POP   DE   
0193   73                     LD   (HL),E   
0194   DF           H_DROP:   RST   18h   ; ";" is this one byte
0195                H_STORE:      ; "!" ( n addr -- )
0195                          IF   CHECKED   
                              CALL   chkst   
0195                          ENDIF      
0195   D1                     POP   DE   
0196   73                     LD   (HL),E   
0197   23                     INC   HL   
0198   72                     LD   (HL),D   
0199   DF                     RST   18h   
019A                             ; ---- console ---------------------------------------------------------------
019A                             ; 22h pushes the address of the text after it and skips the string.
019A   E5           H_STR:    PUSH   HL   
019B   60                     LD   H,B   
019C   69                     LD   L,C   
019D   CD 4C 02               CALL   skipstr   
01A0                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01A0                          ENDIF      
01A0   F7                     RST   30h   
01A1                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01A1                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01A1                             ; bit 6, so // and /" give themselves).
01A1                          IF   1-CHECKED   
01A1   7E           H_PRINT:   LD   A,(HL)   
01A2   23                     INC   HL   
01A3   FE 22                  CP   22h   
01A5   28 0D                  JR   Z,pr9   
01A7   FE 2F                  CP   "/"   
01A9   20 04                  JR   NZ,pr1   
01AB   7E                     LD   A,(HL)   
01AC   23                     INC   HL   
01AD   E6 BF                  AND   0BFh   
01AF   EF           PR1:      RST   28h   
01B0   18 EF                  JR   h_print   
01B2                          ENDIF      
01B2                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
01B2                          ENDIF      
01B2   7D           H_EMIT:   LD   A,L   ; "'"
01B3   EF                     RST   28h   
01B4   DF           PR9:      RST   18h   
01B5                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B5   C5           H_NUM:    PUSH   BC   
01B6   CD 78 02               CALL   psgn   
01B9   C1                     POP   BC   
01BA   DF                     RST   18h   
01BB                             ; "?" ( n -- c ) or ( -n -- addr )
01BB                             ;   n > 0: wait about n ms for a key; 0 if none came
01BB                             ;   n = 0: wait for a key
01BB                             ;          (both stir the random seed while they wait: see kt2)
01BB                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BB                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BB   CB 7C        H_KEY:    BIT   7,H   
01BD   20 22                  JR   NZ,line   
01BF   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C1   CD AB 03     KT2:      CALL   getk   
01C4   20 17                  JR   NZ,kt3   
01C6   1D                     DEC   E   
01C7   20 F8                  JR   NZ,kt2   
01C9   EB                     EX   DE,HL   ; a millisecond with no key stirs the random
01CA   2A 76 82               LD   HL,(SEED)   ;   seed by one: how long a key takes to come
01CD   23                     INC   HL   ;   is the one thing here that is not the
01CE   22 76 82               LD   (SEED),HL   ;   same every time
01D1   EB                     EX   DE,HL   
01D2   7C                     LD   A,H   ; 0? never counts down: it waits
01D3   B5                     OR   L   
01D4   28 E9                  JR   Z,kt1   
01D6   2B                     DEC   HL   
01D7   7C                     LD   A,H   
01D8   B5                     OR   L   
01D9   20 E4                  JR   NZ,kt1   ; A = 0 if the time ran out
01DB   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01DC   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DD   6F           KT3:      LD   L,A   
01DE   26 00                  LD   H,0   
01E0   F7                     RST   30h   
01E1                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01E1                          ENDIF      
01E1                          IFN   CPM   
01E1                             ; Generic: Backspace takes the last character back (and is echoed as
01E1                             ; it is), CR ends (stored, not echoed), every other key is stored and
01E1                             ; echoed until the line is full. The line buffer starts at offset 80h
01E1                             ; of its page, so L alone is the place in the line: D holds the L of
01E1                             ; a full line.
01E1   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E4   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E5   9F                     SBC   A,A   
01E6   A5                     AND   L   ; (0 for a count that is too big)
01E7   2F                     CPL      
01E8   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E9                             ;   at most
01E9   21 80 82               LD   HL,LINEBUF   
01EC   CD AB 03     LN2:      CALL   getk   
01EF   28 FB                  JR   Z,ln2   
01F1   FE 0D                  CP   13   
01F3   28 16                  JR   Z,ln5   
01F5   FE 08                  CP   8   
01F7   28 0B                  JR   Z,ln4   
01F9   5F                     LD   E,A   
01FA   7D                     LD   A,L   
01FB   BA                     CP   D   
01FC   28 EE                  JR   Z,ln2   ; full
01FE   73                     LD   (HL),E   
01FF   2C                     INC   L   
0200   7B                     LD   A,E   
0201   EF           LN3:      RST   28h   
0202   18 E8                  JR   ln2   
0204   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0205   FA 01 02               JP   M,ln3   ;   unless the line was empty (L left the
0208   2C                     INC   L   ;   upper half of the page)
0209   18 E1                  JR   ln2   
020B   77           LN5:      LD   (HL),A   ; the CR
020C                          ENDIF      
020C   2E 80                  LD   L,LINEBUF & 0FFh   
020E   F7                     RST   30h   
020F                             ; =============================================================================
020F                             ;  More routines (no handler starts past this point)
020F                             ; =============================================================================
020F                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
020F                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
020F                             ; while the quotient bits arrive at the bottom of C.
020F                             ; Dividing by 2 is one shift (the spec wants that fast).
020F   7B           UDIV:     LD   A,E   
0210   EE 02                  XOR   2   
0212   B2                     OR   D   
0213   20 07                  JR   NZ,udv0   
0215   CB 3C                  SRL   H   
0217   CB 1D                  RR   L   ; the quotient
0219   8F                     ADC   A,A   
021A   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
021B   C9                     RET      
021C   7C           UDV0:     LD   A,H   
021D   4D                     LD   C,L   
021E   21 00 00               LD   HL,0   
0221   06 10                  LD   B,16   
0223   CB 21        UDV1:     SLA   C   
0225   17                     RLA      
0226   ED 6A                  ADC   HL,HL   
0228   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
022A   30 02                  JR   NC,udv2   ;   always fits in 16 bits
022C   19                     ADD   HL,DE   ; too much: put it back, and cancel the
022D   0D                     DEC   C   ;   INC below
022E   0C           UDV2:     INC   C   ; a quotient bit
022F   10 F2                  DJNZ   udv1   
0231   EB                     EX   DE,HL   ; DE = remainder
0232   67                     LD   H,A   
0233   69                     LD   L,C   ; HL = quotient
0234   C9                     RET      
0235                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0235                             ; non-digit. Values wrap at 16 bits, as the spec says.
0235   21 00 00     RDNUM:    LD   HL,0   
0238   0A           RDN1:     LD   A,(BC)   
0239   D6 30                  SUB   "0"   
023B   FE 0A                  CP   10   
023D   D0                     RET   NC   
023E   03                     INC   BC   
023F   54                     LD   D,H   
0240   5D                     LD   E,L   
0241   29                     ADD   HL,HL   
0242   29                     ADD   HL,HL   
0243   19                     ADD   HL,DE   
0244   29                     ADD   HL,HL   ; HL * 10
0245   5F                     LD   E,A   
0246   16 00                  LD   D,0   
0248   19                     ADD   HL,DE   
0249   18 ED                  JR   rdn1   
024B                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
024B                             ; the next character, so "/"" does not end it. Leaves A = 22h.
024B                          IF   1-CHECKED   
024B   03           SS0:      INC   BC   
024C   0A           SKIPSTR:   LD   A,(BC)   
024D   03                     INC   BC   
024E   FE 2F                  CP   "/"   
0250   28 F9                  JR   Z,ss0   
0252   FE 22                  CP   22h   
0254   20 F6                  JR   NZ,skipstr   
0256   C9                     RET      
0257                          ENDIF      
0257                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0257                          ENDIF      
0257                             ; skip: read past text to the closer at this level, and return A = 0 if it
0257                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0257                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0257                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0257                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0257                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0257                             ; 
0257                             ; The checked build also looks at the character the skip was started by,
0257                             ; which is always the one just before where it starts: "(" must end at ")",
0257                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0257                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0257                             ; place where the skip started, for the report.
0257                SKIP:        
0257                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0257                          ENDIF      
0257   16 00                  LD   D,0   
0259   14           SK3:      INC   D   ; an opener: one deeper
025A   0A           SK1:      LD   A,(BC)   
025B                          IF   1-CHECKED   
025B   03                     INC   BC   
025C   B7                     OR   A   
025D   CA 09 FF               JP   Z,SKEND   ; (the end of the program)
0260                          ENDIF      
0260                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0260                          ENDIF      
0260   FE 22                  CP   22h   
0262   CC 4C 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0265   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0267   28 F0                  JR   Z,sk3   
0269   3D                     DEC   A   ; ")"
026A   28 08                  JR   Z,sk4   
026C   D6 32                  SUB   "["-")"   
026E   28 E9                  JR   Z,sk3   
0270   FE 02                  CP   "]"-"["   
0272   20 E6                  JR   NZ,sk1   
0274   15           SK4:      DEC   D   
0275                          IF   1-CHECKED   
0275   C8                     RET   Z   ; the closer at this level
0276   18 E2                  JR   sk1   
0278                          ENDIF      
0278                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0278                          ENDIF      
0278                             ; psgn: print HL as a signed number. Uses BC.
0278   CB 7C        PSGN:     BIT   7,H   
027A   28 04                  JR   Z,pdec   
027C   3E 2D                  LD   A,"-"   
027E   EF                     RST   28h   
027F   E7                     RST   20h   
0280                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0280                             ; Uses BC.
0280   11 0A 00     PDEC:     LD   DE,10   
0283   CD 0F 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0286   7B                     LD   A,E   
0287   F5                     PUSH   AF   
0288   7C                     LD   A,H   
0289   B5                     OR   L   
028A   C4 80 02               CALL   NZ,pdec   
028D   F1                     POP   AF   
028E   C6 30                  ADD   A,"0"   
0290   EF                     RST   28h   
0291   C9                     RET      
0292                             ; =============================================================================
0292                             ;  The grave's other codes. h_grave comes here with A = the character minus
0292                             ;  27h, not zero; the tests carry on from there. The four characters from
0292                             ;  "+" to "." follow one another, so one range test finds them and two
0292                             ;  rotates tell them apart.
0292                             ; 
0292                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
0292                             ;        from addr until a non-hex character; then a RET (C9h) is written
0292                             ;        and its address is left. An odd last digit is consumed and dropped.
0292                             ;    `+  ( addr -- n )   add 1 to the cell at addr and leave its new value
0292                             ;    `,  ( n -- r )      a random number from 0 to n-1 (n is 1 to 32767)
0292                             ;    `-  ( addr -- n )   subtract 1 from the cell at addr, the same way
0292                             ;    `.  ( -- addr )     the address of the random seed
0292                             ;    `<  ( a b -- n )    the smaller of the two (signed)
0292                             ;    `>  ( a b -- n )    the larger
0292                             ;    `?  ( flag -- )     the cursor off (0) or on
0292                             ;    `@  ( row col -- )  the cursor to that row and column, both from 0
0292                             ;    `^  ( -- )          clear the screen and home the cursor
0292                             ;    `_  ( -- )          clear from the cursor to the end of the line
0292                             ; 
0292                             ;  Any other character is unsafe: the unchecked build takes it as "_", the
0292                             ;  checked build stops with W.
0292                             ; =============================================================================
0292   D6 04        GRAVE2:   SUB   "+"-27h   ; "+" "," "-" "." leave 0 to 3
0294   FE 04                  CP   4   
0296   30 32                  JR   NC,gv2   
0298   1F                     RRA      ; carry: "," or "."; bit 0 of A: "-" or "."
0299   38 0E                  JR   C,gv3   
029B                             ; `+ and `-: one routine.
029B                          IF   CHECKED   
                              LD   D,A   ; (the checked build tests the address first,
                              CALL   chkst   ;   as "!" does: the test uses A, and under
                              LD   A,D   ;   CP/M E too)
029B                          ENDIF      
029B   5E                     LD   E,(HL)   
029C   23                     INC   HL   
029D   56                     LD   D,(HL)   
029E   1F                     RRA      ; carry: "-"
029F   38 02                  JR   C,gi1   
02A1   13                     INC   DE   
02A2   13                     INC   DE   
02A3   1B           GI1:      DEC   DE   
02A4   72                     LD   (HL),D   
02A5   2B                     DEC   HL   
02A6   73                     LD   (HL),E   
02A7   EB                     EX   DE,HL   ; the new value is TOS
02A8   F7                     RST   30h   
02A9   1F           GV3:      RRA      ; carry: "."
02AA   38 19                  JR   C,g_seed   
02AC                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
02AC                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
02AC                             ; and the low ones repeat soon, so the high byte is folded into the low
02AC                             ; (XOR) before the remainder of dividing by n is taken.
02AC                             ; n must be 1 to 32767: the checked build stops with Z on anything less
02AC                             ; than 1.
02AC                G_RND:       
02AC                          IF   CHECKED   
                              DEC   HL   
                              BIT   7,H   ; n - 1 negative: n is 0 or less
                              INC   HL   
                              JP   NZ,e_zero   
02AC                          ENDIF      
02AC   EB                     EX   DE,HL   ; DE = n
02AD   C5                     PUSH   BC   
02AE   2A 76 82               LD   HL,(SEED)   
02B1   44                     LD   B,H   
02B2   4D                     LD   C,L   
02B3   29                     ADD   HL,HL   
02B4   29                     ADD   HL,HL   
02B5   09                     ADD   HL,BC   ; * 5
02B6   23                     INC   HL   ; + 1
02B7   7C                     LD   A,H   
02B8   81                     ADD   A,C   
02B9   67                     LD   H,A   ; + * 256: * 261 + 1
02BA   22 76 82               LD   (SEED),HL   
02BD   AD                     XOR   L   ; (A is still the high byte)
02BE   6F                     LD   L,A   
02BF   CD 0F 02               CALL   udiv   ; DE = the remainder
02C2   EB                     EX   DE,HL   
02C3   C1                     POP   BC   
02C4   F7                     RST   30h   
02C5                             ; `. pushes the address of the random seed.
02C5   E5           G_SEED:   PUSH   HL   
02C6   21 76 82               LD   HL,SEED   
02C9   F7                     RST   30h   
02CA   C6 07        GV2:      ADD   A,"+"-"$"   ; "$"
02CC   20 13                  JR   NZ,gv4   
02CE   CD 6B 03     HX1:      CALL   hexc   
02D1   30 0B                  JR   NC,hx2   
02D3   77                     LD   (HL),A   ; the high digit goes in first ...
02D4   CD 6B 03               CALL   hexc   
02D7   30 05                  JR   NC,hx2   ; odd digit: consumed, and the RET below
02D9   ED 6F                  RLD      ;   overwrites it
02DB   23                     INC   HL   ; ... and RLD shifts it up under the low one
02DC   18 F0                  JR   hx1   
02DE   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
02E0   F7                     RST   30h   
02E1   D6 18        GV4:      SUB   "<"-"$"   
02E3   28 1F                  JR   Z,g_min   
02E5   D6 02                  SUB   ">"-"<"   
02E7   28 1A                  JR   Z,g_max   
02E9   3D                     DEC   A   ; "?"
02EA   28 2A                  JR   Z,g_cur   
02EC   3D                     DEC   A   ; "@"
02ED   28 3D                  JR   Z,g_at   
02EF   D6 1E                  SUB   "^"-"@"   ; "^" leaves 0 and "_" leaves 1
02F1                          IF   CHECKED   
                              CP   2   
                              JP   NC,e_brack   ; anything else: W. The place is the character
                              OR   A   
02F1                          ENDIF      
02F1                          IF   ANSI   
02F1   20 07                  JR   NZ,ge1   
02F3   CD 44 03               CALL   csi   ; "^": ESC [ H homes the cursor, and then
02F6   3E 48                  LD   A,"H"   ;   ESC [ J clears from there to the end of
02F8   EF                     RST   28h   ;   the screen
02F9   AF                     XOR   A   
02FA   C6 4A        GE1:      ADD   A,"J"   ; "_": ESC [ K clears to the end of the line
02FC   5F                     LD   E,A   
02FD   CD 44 03               CALL   csi   
0300   7B                     LD   A,E   
0301   EF                     RST   28h   
0302   F7                     RST   30h   
0303                          ENDIF      
0303                          IF   1-ANSI   
                              JR   NZ,ge1   
                              CALL   CONCLS   
                              RST   30h   
                    GE1:      CALL   CONEOL   
                              RST   30h   
0303                          ENDIF      
0303                             ; `< and `>. The carry says which: set for the larger. The two are put in
0303                             ; order, HL the smaller and DE the larger, and then swapped for ">".
0303                             ; b < a (signed) is the borrow of b - a, turned round if the two signs
0303                             ; differ: RRA puts the borrow in bit 7, where the two XORs meet it.
0303   37           G_MAX:    SCF      ; ("<" comes in with the carry clear)
0304   D1           G_MIN:    POP   DE   ; DE = a, HL = b
0305   F5                     PUSH   AF   
0306   7D                     LD   A,L   
0307   93                     SUB   E   
0308   7C                     LD   A,H   
0309   9A                     SBC   A,D   
030A   1F                     RRA      
030B   AC                     XOR   H   
030C   AA                     XOR   D   
030D   17                     RLA      ; carry: b < a
030E   38 01                  JR   C,gm2   
0310   EB                     EX   DE,HL   
0311   F1           GM2:      POP   AF   
0312   30 01                  JR   NC,gm3   
0314   EB                     EX   DE,HL   
0315   F7           GM3:      RST   30h   
0316                          IF   ANSI   
0316                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
0316   CD 44 03     G_CUR:    CALL   csi   
0319   3E 3F                  LD   A,"?"   
031B   EF                     RST   28h   
031C   3E 32                  LD   A,"2"   
031E   EF                     RST   28h   
031F   3E 35                  LD   A,"5"   
0321   EF                     RST   28h   
0322   7C                     LD   A,H   
0323   B5                     OR   L   
0324   3E 6C                  LD   A,"l"   
0326   28 02                  JR   Z,gc1   
0328   3E 68                  LD   A,"h"   
032A   EF           GC1:      RST   28h   
032B   DF                     RST   18h   
032C                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
032C   D1           G_AT:     POP   DE   ; DE = the row
032D   C5                     PUSH   BC   ; (pdec uses BC)
032E   E5                     PUSH   HL   ; the column
032F   EB                     EX   DE,HL   
0330   CD 44 03               CALL   csi   
0333   23                     INC   HL   
0334   CD 80 02               CALL   pdec   
0337   3E 3B                  LD   A,";"   
0339   EF                     RST   28h   
033A   E1                     POP   HL   
033B   23                     INC   HL   
033C   CD 80 02               CALL   pdec   
033F   3E 48                  LD   A,"H"   
0341   EF                     RST   28h   
0342   C1                     POP   BC   
0343   DF                     RST   18h   
0344                             ; csi: print ESC [, which starts every ANSI sequence. Keeps all but A.
0344   3E 1B        CSI:      LD   A,27   
0346   EF                     RST   28h   
0347   3E 5B                  LD   A,"["   
0349   EF                     RST   28h   
034A   C9                     RET      
034B                          ENDIF      
034B                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    LD   A,H   
                              OR   L   
                              CALL   CONCUR   
                              RST   18h   
                    G_AT:     POP   DE   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   18h   
034B                          ENDIF      
034B                             ; =============================================================================
034B                             ;  Dispatch table: the low byte of each handler's address, in code order
034B                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
034B                             ;  It must not cross a page (the dispatcher only adds to its low byte).
034B                             ; =============================================================================
034B                             ; The handlers of the first NPG1 characters start in the image's second page.
034B                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
034B                             ; differs between the builds, so the count is worked out here.
034B                             ; (One division to a line: asm80 only rounds down when it stores a value.)
034B                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
034B                PGBRK:    EQU   (h_break-BASE)/256   
034B                PGDEF:    EQU   (h_def-BASE)/256   
034B                PGFET:    EQU   (h_fetch-BASE)/256   
034B                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
034B                          IF   1-TABP0   
034B                PTAB:        
034B                          ;*Macro unroll:  PTABLE
034B   95                     DB   h_store & 0FFh   
034C   9A                     DB   h_str & 0FFh   
034D   B5                     DB   h_num & 0FFh   
034E   A1                     DB   h_print & 0FFh   
034F   90                     DB   h_swap & 0FFh   
0350   38                     DB   h_and & 0FFh   
0351   B2                     DB   h_emit & 0FFh   
0352   14                     DB   h_open & 0FFh   
0353   1C                     DB   h_close & 0FFh   
0354   59                     DB   h_mul & 0FFh   
0355   2F                     DB   h_add & 0FFh   
0356   DC                     DB   h_cfetch & 0FFh   
0357   27                     DB   h_sub & 0FFh   
0358   92                     DB   h_cstore & 0FFh   
0359   6D                     DB   h_div & 0FFh   
035A   8E                     DB   h_dup & 0FFh   
035B   94                     DB   h_drop & 0FFh   
035C   40                     DB   h_lt & 0FFh   
035D   4F                     DB   h_eq & 0FFh   
035E   41                     DB   h_gt & 0FFh   
035F   BB                     DB   h_key & 0FFh   
0360   0F                     DB   h_fetch & 0FFh   
0361   F2                     DB   h_def & 0FFh   
0362   E5                     DB   h_break & 0FFh   
0363   E1                     DB   h_ret & 0FFh   
0364   81                     DB   h_xor & 0FFh   
0365   94                     DB   h_alloc & 0FFh   
0366   CF                     DB   h_grave & 0FFh   
0367   2C                     DB   h_tor & 0FFh   
0368   89                     DB   h_or & 0FFh   
0369   1C                     DB   h_fromr & 0FFh   
036A   91                     DB   h_not & 0FFh   
036B                PTABEND:      
036B                          ENDIF      
036B                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
036B                             ; and return its value in A with the carry set; otherwise leave the IP and
036B                             ; return with the carry clear.
036B   0A           HEXC:     LD   A,(BC)   
036C   D6 30                  SUB   "0"   
036E   FE 0A                  CP   10   
0370   38 09                  JR   C,hc1   
0372   E6 DF                  AND   0DFh   
0374   D6 11                  SUB   11h   
0376   FE 06                  CP   6   
0378   D0                     RET   NC   
0379   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
037B   03           HC1:      INC   BC   
037C   C9                     RET      
037D                             ; =============================================================================
037D                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
037D                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
037D                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
037D                             ;  they are the host's KEY and CONOUT routines themselves.
037D                             ; 
037D                             ;  A running program reads the keyboard only through getk and pollk, which
037D                             ;  between them give the break key its rules:
037D                             ;    - Ctrl-C stops the program;
037D                             ;    - any other key that the break check reads is held in KEYBUF for the
037D                             ;      next "?", and a newer one takes its place;
037D                             ;    - "?" (getk) takes the held key first;
037D                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
037D                             ;      key like any other, but two of them within about 250 ms still stop it.
037D                             ;  Both are called straight from a handler, never from a routine under one:
037D                             ;  the checked build's report counts on finding one return address above the
037D                             ;  data stack.
037D                             ; =============================================================================
037D                          IFN   CPM   
037D                RAWK:     EQU   KEY   
037D                          ENDIF      
037D                             ; pollk: the break check (see rpushn).
037D   CD 06 FF     POLLK:    CALL   rawk   
0380   C8                     RET   Z   ; no key
0381   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0384   FE 03        PK1:      CP   3   ; (getk joins here)
0386   C0                     RET   NZ   
0387                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0387                             ; the program has turned it off, wait about 250 ms for one more key: a
0387                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0387                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0387   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
038A   B7                     OR   A   
038B   CA 15 00     CT0:      JP   Z,brk   
038E   D5                     PUSH   DE   
038F   11 10 27               LD   DE,250*MSLOOP   
0392   CD 06 FF     CT1:      CALL   rawk   
0395   20 05                  JR   NZ,ct2   
0397   1B                     DEC   DE   
0398   7A                     LD   A,D   
0399   B3                     OR   E   
039A   20 F6                  JR   NZ,ct1   
039C   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
039D   FE 03                  CP   3   
039F   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
03A1   B7                     OR   A   
03A2   28 03                  JR   Z,ct3   
03A4   32 7A 82               LD   (KEYBUF),A   
03A7   3E 03        CT3:      LD   A,3   
03A9   B7                     OR   A   
03AA   C9                     RET      
03AB                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
03AB   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
03AC   21 7A 82               LD   HL,KEYBUF   ;   the buffer
03AF   7E                     LD   A,(HL)   
03B0   36 00                  LD   (HL),0   
03B2   E1                     POP   HL   
03B3   B7                     OR   A   
03B4   C0                     RET   NZ   
03B5   CD 06 FF               CALL   rawk   
03B8   C8                     RET   Z   
03B9   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
03BB                          IF   (1-CHECKED)*(1-EDITOR)   
03BB                BRK:      EQU   endprog   ; the unchecked build stops without a word
03BB                          ENDIF      ;   (with the editor, both stacks are cleared);
03BB                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
03BB                          ENDIF      
03BB                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
03BB                          ENDIF      
03BB                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
03BB                          ENDIF      
03BB                             ; =============================================================================
03BB                             ;  Checked build: the checks and the error report
03BB                             ; =============================================================================
03BB                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
03BB                          ENDIF      
03BB                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03BB                          ENDIF      
03BB                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
03BB                          ENDIF      
03BB                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
03BB                          ENDIF      
03BB                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
03BB                          ENDIF      
03BB                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03BB                          ENDIF      
03BB                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop prstr's return
                              POP   HL   ;   address, put the string's address back in
                              DB   11h   ;   TOS, and step over the next two bytes: Q
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
                                 ;                       Rtn n
                                 ; TOS is in memory with the rest (pushed).
                              CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
                              ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
                              RST   20h   ;   with the first value and holds nothing)
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,B   ; C = the number of cells to show (B is 0:
                                 ;   phalf left the depth in BC)
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              PUSH   BC   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   BC   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      ; twice the depth is RSTOP less the pointer:
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough, since even an
                              SUB   L   ;   overflowing stack holds under 128 entries
                              EXX      
                              LD   L,A   
                              LD   H,B   ; (B is still 0)
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
03BB                          ENDIF      
03BB                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
03BB                          ENDIF      
03BB                          IF   CHECKED*EDITOR   
                              JP   edit0   ; back to the editor, with both stacks cleared
03BB                          ENDIF      
03BB                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A
                                 ; NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
03BB                          ENDIF      
03BB                             ; =============================================================================
03BB                             ;  The line editor (EDITOR = 1)
03BB                             ; 
03BB                             ;  The interpreter starts here, and a program that ends comes back here.
03BB                             ;  There is no prompt. It follows the spec's suggested standard for a line
03BB                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
03BB                             ; 
03BB                             ;    n text    put the text in as line n; the lines from n on move down. A
03BB                             ;              number past the end (or 0) adds the line at the end.
03BB                             ;    n         take line n out
03BB                             ;    anything else is run at once, as B8Script. (Start such a line with a
03BB                             ;    space if it would begin with a digit.)
03BB                             ; 
03BB                             ;  A command key ends the line too, and takes what was typed as its argument:
03BB                             ; 
03BB                             ;    ^G        run the program
03BB                             ;    n ^L      list from line n (no number: all of it). Any key holds the
03BB                             ;              list until another key is pressed; Ctrl-C ends it.
03BB                             ;    n ^E      put line n in the input line; Return puts it back, changed
03BB                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
03BB                             ;              last time). Generic: what is typed, or pasted, from now until
03BB                             ;              ^Z replaces the program; it is not echoed.
03BB                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
03BB                             ;              time). Generic: the text is printed, as it is.
03BB                             ;    ^N ^N     new: no program (the key twice in a row)
03BB                             ;    ^X        leave (to LEAVE)
03BB                             ; 
03BB                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
03BB                             ;  a character goes in at the cursor; Backspace and DEL take out the one
03BB                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
03BB                             ;  sent to the terminal, so any terminal will do.
03BB                             ; 
03BB                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
03BB                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
03BB                             ;  125 characters; the one character after a line number separates it from
03BB                             ;  the text and is not stored. The text is kept as it is typed, each line
03BB                             ;  ending in CR LF, at PROG.
03BB                             ; 
03BB                             ;  What lasts from one line to the next: the program, the words, the
03BB                             ;  variables and the data stack. An error or a break clears both stacks. The
03BB                             ;  return stack starts empty for every line.
03BB                             ; 
03BB                             ;  Things to know:
03BB                             ;    - Reset empties the program (generic builds).
03BB                             ;    - A word's address points into the program, so run the program again
03BB                             ;      after editing it.
03BB                             ;    - Nothing is printed between a program's output and what is typed next.
03BB                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
03BB                             ;      a line that calls -n? and carries on afterwards runs what was typed.
03BB                             ;      (The stored program never comes back to the line, so it may.)
03BB                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
03BB                             ;      read of the other builds (BDOS 10 under CP/M).
03BB                             ; 
03BB                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
03BB                             ;  the last line left there, with TOS pushed like the rest.
03BB                             ; =============================================================================
03BB                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
03BB                          ENDIF      
03BB                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
03BB                          ENDIF      
03BB                          IF   EDGEN   
                              JR   edit0   
03BB                          ENDIF      
03BB                          IF   EDITOR   
                                 ; ^F, right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; ^B, left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                    LF1:      RST   28h   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   2   
                              JR   Z,left   ; ^B
                              CP   6   
                              JR   Z,right   ; ^F
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              LD   A,8   
                              RST   28h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              RST   28h   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              RST   28h   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              LD   A,8   
                              RST   28h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N ^N: no program, if the next key is ^N too
                    CNEW:     CALL   ekey   
                              CP   14   
                              JR   NZ,ged0   
                              XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              LD   (EDLN),HL   ; (no such line: `edit` clears it again)
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              RST   28h   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
03BB                          ENDIF      
03BB                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
03BB                          ENDIF      
03BB                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              RST   30h   ; (its return address is thrown away)
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
03BB                          ENDIF      
03BB                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                    GED1:     JP   edit   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
03BB                          ENDIF      
03BB                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close,
                              LD   HL,edit   ;   and from there back to the editor
                              PUSH   HL   
                                 ; fbdos: BDOS function C on the file. (^W ends by running on into it.)
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. It runs on into load, which returns to the editor.
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
03BB                          ENDIF      
03BB                             ; =============================================================================
03BB                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
03BB                          ENDIF      
03BB                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
03BB                          ENDIF      
03BB                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
03BB                          ENDIF      
03BB                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
03BB                          ENDIF      
03BB                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
03BB                          ENDIF      
03BB                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
03BB                          ENDIF      
03BB                IMGEND:      


