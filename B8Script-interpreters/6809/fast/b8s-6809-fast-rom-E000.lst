E88F   81 0A                  CMPA   #10   
E891   24 03                  BHS   fd9n   
E893   7E E8 A2               JMP   fdm   ; another digit
E896                          ;*Macro unroll: fd9n:   NEXTF
E896   BD           FD9N:     DS   CHECKED,0BDh   
E897   E4                     DS   CHECKED,ACHK/256   
E898   A2                     DS   CHECKED,ACHK&0FFh   
E899   E6 A0                  LDB   ,Y+   
E89B   8E EE 9E               LDX   #FTAB   
E89E   3A                     ABX      
E89F   3A                     ABX      
E8A0   6E 94                  JMP   [,X]   
E8A2                             ; fdm: another digit, at the IP: the value on top becomes value * 10 + digit
E8A2   EC C4        FDM:      LDD   ,U   
E8A4   58                     ASLB      
E8A5   49                     ROLA      
E8A6   58                     ASLB      
E8A7   49                     ROLA      
E8A8   E3 C4                  ADDD   ,U   ; 5V
E8AA   58                     ASLB      
E8AB   49                     ROLA      ; 10V
E8AC   EB A0                  ADDB   ,Y+   ; and the digit
E8AE   89 00                  ADCA   #0   
E8B0   83 00 30               SUBD   #30h   ; minus "0"
