E1B3   A9 00                  LDA   #0   
E1B5   95 01                  STA   1,X   
E1B7   60                     RTS      
E1B8                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E1B8                             ; drops it and carries on. It uses "]"s code, entered past its SEC: with the
E1B8                             ; carry clear, as it is here, the address popped is pushed back.
E1B8   20 C8 E5     H_CLOSE:   JSR   flag   
E1BB   F0 75                  BEQ   rdrop   
E1BD   D0 7A                  BNE   ret1   ; always
E1BF                             ; "?" ( n -- c ) or ( -n -- addr )
E1BF                             ;   n > 0: wait about n ms for a key; 0 if none came
E1BF                             ;   n = 0: wait for a key
E1BF                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E1BF                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E1BF   B5 01        H_KEY:    LDA   1,X   
E1C1   30 26                  BMI   line   
E1C3   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E1C5   20 11 E5     KT2:      JSR   getk   
E1C8   D0 E7                  BNE   seta   
E1CA   88                     DEY      
E1CB   D0 F8                  BNE   kt2   
E1CD   EE 76 04               INC   SEED   ; a millisecond with no key stirs the random
E1D0   D0 03                  BNE   kt5   ;   seed by one: how long a key takes to come
E1D2   EE 77 04               INC   SEED+1   ;   is the one thing here that is not the
E1D5                KT5:         ;   same every time
E1D5   B5 00                  LDA   0,X   ; count the millisecond off:
E1D7   D0 06                  BNE   kt4   
E1D9   B5 01                  LDA   1,X   
E1DB   F0 E6                  BEQ   kt1   ; 0? never counts down: it waits
E1DD   D6 01                  DEC   1,X   
E1DF   D6 00        KT4:      DEC   0,X   
E1E1   D0 E0                  BNE   kt1   
E1E3   B5 01                  LDA   1,X   
E1E5   D0 DC                  BNE   kt1   
E1E7   F0 C8                  BEQ   seta   ; always: the time ran out, A = 0
E1E9                             ; ---- no handler starts between here and the next heading --------------------
E1E9                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E1E9                             ; (stored, not echoed), every other key is stored and echoed until the line
E1E9                             ; is full. Y = the length so far; T0 = the most allowed.
E1E9   20 F7 E0     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E1EC   D0 04                  BNE   ln0   
E1EE   B5 00                  LDA   0,X   
E1F0   10 02                  BPL   ln1   
