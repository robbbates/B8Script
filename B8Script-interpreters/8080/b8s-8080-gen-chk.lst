0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        "/" leaves ( r q ), the quotient on top; dividing by zero is not
0000                             ;        checked. -n? does no more editing than Backspace.
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three. (asm80 wants the vector number: RST 1 = RST 08h.)
0000                             ; 
0000                             ;    RST 1  08h  rpop    pop the return stack into HL
0000                             ;    RST 3  18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 4  20h  neg16   HL = -HL
0000                             ;    RST 5  28h  putc    print A
0000                             ;    RST 6  30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block has no jumps inside itself, so it works at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    EXIT:     EQU   0000h   ; warm boot
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with ORA A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve BC, DE and HL.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000   31 FE 81               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003   C3 6E 03               JMP   start   
0006   CF           RDROP:    RST   1   ; 06  drop the top of the return stack, then
0007   DF                     RST   3   ;     drop TOS (a spent flag) and go on
0008                VECS:        
0008                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
0008   2A 34 82     RPOP:     LHLD   RSP   ; 08
000B   5E                     MOV   E,M   
000C   23                     INX   H   
000D   56                     MOV   D,M   
000E   23                     INX   H   
000F   22 34 82               SHLD   RSP   
0012   EB                     XCHG      
0013   C9                     RET      ; 13  (so RST 2 is not used)
0014   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0015   C3 B0 00               JMP   rpushd   ;     brings up the new TOS
0018                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
0018   D1           RST18:    POP   D   ; 18  discard the RST's return address
0019   E1                     POP   H   ;     new TOS = NOS
001A   C3 31 00               JMP   next0   
001D   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
001E   CF                     RST   1   
001F   F7                     RST   6   
0020                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0020   AF           NEG16:    XRA   A   ; 20
0021   95                     SUB   L   
0022   6F                     MOV   L,A   
0023   9F                     SBB   A   
0024   94                     SUB   H   
0025   67                     MOV   H,A   
0026   C9                     RET      
0027   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
0028                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JMP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JMP   putc   ; 28
002B                          ENDIF      
002B                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
002B                             ; returns here, with its top cell on the stack: that becomes the new TOS.
002B   CD 27 00     EXEC:     CALL   jphl   ; 2B
002E   E1                     POP   H   
002F   F7                     RST   6   
0030                             ; ---- RST 6: next character --------------------------------------------------
0030   D1           RST30:    POP   D   ; 30  discard the RST's return address
0031                          IF   CPM   
                              JMP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 08 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LDAX   B   
0035   03                     INX   B   
0036   D6 21                  SUI   21h   ; A = c - 21h
0038   DA 77 00               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
003B   FE 0F                  CPI   0Fh   
003D   DA 68 00               JC   punct   ; 21h-2Fh: PTAB index 0-14
0040   D6 0F                  SUI   0Fh   ; A = c - 30h
0042   FE 0A                  CPI   0Ah   
0044   DA 5E 02               JC   digit   ; 30h-39h
0047   FE 11                  CPI   11h   
0049   DA 66 00               JC   p3a   ; 3Ah-40h
004C   D6 11                  SUI   11h   ; A = c - 41h
004E   FE 1A                  CPI   1Ah   
0050   DA A6 00               JC   upper   ; 41h-5Ah: A = letter index 0-25
0053   FE 20                  CPI   20h   
0055   DA 64 00               JC   p5b   ; 5Bh-60h
0058   FE 3A                  CPI   3Ah   
005A   DA A0 00               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
005D   FE 3E                  CPI   3Eh   
005F   D2 31 00               JNC   next0   ; 7Fh-FFh: ignored
0062   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0064   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
0066   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
0068                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0068                             ; untouched, and A, DE free.
0068   C6 3E        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
006A   5F                     MOV   E,A   
006B   16 02                  MVI   D,PTAB / 256   
006D   FE 54                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006F   1A                     LDAX   D   
0070   5F                     MOV   E,A   ; the handler's low byte
0071                          IFN   CPM   
0071   3E 00                  MVI   A,0   
0073   17                     RAL      ; its page: 0 + carry
0074                          ENDIF      
0074                          IF   CPM   
                              MVI   A,1   
                              ACI   0   ; its page: 1 + carry
0074                          ENDIF      
0074   57                     MOV   D,A   
0075   D5                     PUSH   D   ; jump to it; the stack is balanced again
0076   C9                     RET      ;   when the handler starts
0077                             ; ctl: characters below 21h. A = c - 21h.
0077   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
0079   C2 31 00               JNZ   next0   ; the rest are ignored
007C   C3 09 FF     ENDPROG:   JMP   EXIT   ; the program has ended
007F                             ; =============================================================================
007F                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
007F                             ;  (00bbIGFuZCA= are up among the RST routines.)
007F                             ; =============================================================================
007F   D1           H_XOR:    POP   D   
0080   7C                     MOV   A,H   
0081   AA                     XRA   D   
0082   67                     MOV   H,A   
0083   7D                     MOV   A,L   
0084   AB                     XRA   E   
0085   6F                     MOV   L,A   
0086   F7                     RST   6   
0087   D1           H_OR:     POP   D   
0088   7C                     MOV   A,H   
0089   B2                     ORA   D   
008A   67                     MOV   H,A   
008B   7D                     MOV   A,L   
008C   B3                     ORA   E   
008D   6F                     MOV   L,A   
008E   F7                     RST   6   
008F   E7           H_NOT:    RST   4   ; ~x = -x - 1
0090   2B                     DCX   H   
0091   F7                     RST   6   
0092                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
0092   EB           H_ALLOC:   XCHG      
0093   2A 7C 82               LHLD   HEAP   
0096   E5                     PUSH   H   
0097   19                     DAD   D   ; the new top
0098                          IF   CHECKED   
0098   CD 3F 03               CALL   chkhp   
009B                          ENDIF      
009B   22 7C 82               SHLD   HEAP   
009E   E1                     POP   H   
009F   F7                     RST   6   
00A0                             ; ---- the letters and digits --------------------------------------------------
00A0                             ; a-z: push the cell's address (the cell is the variable)
00A0   E5           LOWER:    PUSH   H   
00A1   87                     ADD   A   
00A2   6F                     MOV   L,A   
00A3   26 82                  MVI   H,LETPAGE   
00A5   F7                     RST   6   
00A6                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00A6                             ; the return stack, and the IP becomes the address in the letter's cell.
00A6   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
00A7   87                     ADD   A   
00A8   6F                     MOV   L,A   
00A9   26 82                  MVI   H,LETPAGE   ; HL -> cell
00AB   50                     MOV   D,B   
00AC   59                     MOV   E,C   ; DE = the return address
00AD   4E                     MOV   C,M   
00AE   23                     INX   H   
00AF   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
00B0                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
00B0                             ; go on. Every push of the return stack ends here: for a word call the cell
00B0                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
00B0                             ; the one that was used up.
00B0                RPUSHD:      
00B0                          IF   CHECKED   
00B0   CD 24 03               CALL   chkbrk   ; Ctrl-C is checked at every word call, block
00B3                          ENDIF      ;   entry, loop-back and "{"
00B3   2A 34 82               LHLD   RSP   
00B6   2B                     DCX   H   
00B7   72                     MOV   M,D   
00B8   2B                     DCX   H   
00B9   73                     MOV   M,E   
00BA   22 34 82               SHLD   RSP   
00BD   E1                     POP   H   
00BE   F7                     RST   6   
00BF                             ; ---- machine code: the grave -----------------------------------------------
00BF                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00BF                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00BF                             ; written and its address is left. An odd last digit is consumed and dropped.
00BF                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00BF                             ; code is entered by CALL with the data stack above the return address; it
00BF                             ; must keep BC, and on return the top cell becomes the new TOS.
00BF   CD E8 02     H_GRAVE:   CALL   hexc   
00C2   D2 2B 00               JNC   exec   
00C5   87           HX1:      ADD   A   
00C6   87                     ADD   A   
00C7   87                     ADD   A   
00C8   87                     ADD   A   
00C9   57                     MOV   D,A   ; the high digit
00CA   CD E8 02               CALL   hexc   
00CD   D2 DC 00               JNC   hx2   ; odd digit: consumed and dropped
00D0   B2                     ORA   D   
00D1                          IF   CHECKED   
00D1   CD 31 03               CALL   chkst   
00D4                          ENDIF      
00D4   77                     MOV   M,A   
00D5   23                     INX   H   
00D6   CD E8 02               CALL   hexc   
00D9   DA C5 00               JC   hx1   
00DC                HX2:         
00DC                          IF   CHECKED   
00DC   CD 31 03               CALL   chkst   
00DF                          ENDIF      
00DF   36 C9                  MVI   M,0C9h   
00E1   F7                     RST   6   
00E2                             ; ---- where the two pages meet ----------------------------------------------
00E2                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00E2                             ; are in falling code order for this), and where exactly differs between the
00E2                             ; builds: NPG1 follows. Every handler below these four must start in the
00E2                             ; second page, and every one above in the first; chktab.py checks both.
00E2                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
00E2                             ; while rpop uses HL, and the drop at the end brings it back.
00E2   E5           H_RET:    PUSH   H   
00E3   CF           RET2:     RST   1   
00E4   44                     MOV   B,H   
00E5   4D                     MOV   C,L   
00E6   DF                     RST   3   
00E7                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00E7                             ; drops the block start, "]" returns. No closer at all ends the program.
00E7                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
00E7   7C           H_BREAK:   MOV   A,H   
00E8   B5                     ORA   L   
00E9   CA DA 01               JZ   h_drop   ; false: just drop the flag
00EC   CD B4 02               CALL   skip   
00EF   B7                     ORA   A   ; skip returns 0 for ")"
00F0   C2 E3 00               JNZ   ret2   
00F3   C3 06 00               JMP   rdrop   
00F6                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00F6                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00F6                             ; the body"s address instead. Either way it then skips to the matching "]'.
00F6                             ; (The unchecked build takes anything below "A" as the space, and anything
00F6                             ; from "A" up as a letter.)
00F6   0A           H_DEF:    LDAX   B   
00F7   03                     INX   B   
00F8   D6 41                  SUI   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
00FA                          IF   1-CHECKED   
                              JC   def2   
00FA                          ENDIF      
00FA                          IF   CHECKED   
00FA   FE DF                  CPI   " "-"A"+256   
00FC   CA 14 01               JZ   def2   
00FF   5F                     MOV   E,A   
0100   E6 DF                  ANI   0DFh   ; fold case
0102   FE 1A                  CPI   26   
0104   D2 55 03               JNC   e_brack   ; anything but a letter or a space
0107   7B                     MOV   A,E   
0108                          ENDIF      
0108   87                     ADD   A   
0109   5F                     MOV   E,A   
010A   16 82                  MVI   D,LETPAGE   ; DE -> cell
010C   79                     MOV   A,C   
010D   12                     STAX   D   
010E   1C                     INR   E   
010F   78                     MOV   A,B   
0110   12                     STAX   D   
0111   C3 17 01               JMP   skipnx   
0114   E5           DEF2:     PUSH   H   ; an anonymous block: push its address
0115   60                     MOV   H,B   
0116   69                     MOV   L,C   
0117   CD B4 02     SKIPNX:   CALL   skip   
011A   F7                     RST   6   
011B   5E           H_FETCH:   MOV   E,M   ; "@"
011C   23                     INX   H   
011D   56                     MOV   D,M   
011E   EB                     XCHG      
011F   F7                     RST   6   
0120                             ; =============================================================================
0120                             ;  Handlers that must start in the image's second page.
0120                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
0120                             ;  tail may run past that page.
0120                             ; =============================================================================
0120                             ; ---- flow control ----------------------------------------------------------
0120                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0120                             ; the matching ")".
0120   7C           H_OPEN:   MOV   A,H   
0121   B5                     ORA   L   
0122   E1                     POP   H   
0123   CA 17 01               JZ   skipnx   
0126   E5                     PUSH   H   ; (rpushd pops it again)
0127   50                     MOV   D,B   
0128   59                     MOV   E,C   ; the block starts at the IP
0129   C3 B0 00               JMP   rpushd   
012C                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
012C                             ; drops it and carries on.
012C   7C           H_CLOSE:   MOV   A,H   
012D   B5                     ORA   L   
012E   CA 06 00               JZ   rdrop   
0131   CF                     RST   1   ; pop the block start ...
0132   44                     MOV   B,H   
0133   4D                     MOV   C,L   ; ... jump to it ...
0134   EB                     XCHG      
0135   C3 B0 00               JMP   rpushd   ; ... and push it back (which drops the flag)
0138                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0138                             ; "-" has two jobs: directly before a digit it starts a negative number.
0138   0A           H_SUB:    LDAX   B   
0139   D6 30                  SUI   "0"   
013B   FE 0A                  CPI   10   
013D   DA 64 02               JC   negnum   
0140   E7                     RST   4   ; a - b = a + (-b): fall into "+"
0141   D1           H_ADD:    POP   D   
0142   19                     DAD   D   
0143   F7                     RST   6   
0144   D1           H_AND:    POP   D   
0145   7C                     MOV   A,H   
0146   A2                     ANA   D   
0147   67                     MOV   H,A   
0148   7D                     MOV   A,L   
0149   A3                     ANA   E   
014A   6F                     MOV   L,A   
014B   F7                     RST   6   
014C                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
014C                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
014C                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
014C                             ; SBB A turns a carry into -1 or 0 with no branch.
014C   E3           H_GT:     XTHL      ; a > b  is  b < a
014D   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
014E   7B                     MOV   A,E   
014F   95                     SUB   L   
0150   7A                     MOV   A,D   
0151   9C                     SBB   H   
0152   9F                     SBB   A   ; A = -1 if DE < HL unsigned
0153   6F                     MOV   L,A   
0154   7C                     MOV   A,H   
0155   AA                     XRA   D   
0156   17                     RAL      ; carry = the signs differ
0157   9F                     SBB   A   
0158   AD                     XRA   L   ; flip when they do
0159   67                     MOV   H,A   
015A   6F                     MOV   L,A   
015B   F7                     RST   6   
015C   D1           H_EQ:     POP   D   
015D   7D                     MOV   A,L   
015E   AB                     XRA   E   
015F   6F                     MOV   L,A   
0160   7C                     MOV   A,H   
0161   AA                     XRA   D   
0162   B5                     ORA   L   ; zero if equal
0163   D6 01                  SUI   1   ; carry only for zero
0165   9F                     SBB   A   
0166   67                     MOV   H,A   
0167   6F                     MOV   L,A   
0168   F7                     RST   6   
0169                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0169                             ; multiplier is used up; only the low 16 bits are kept.
0169   D1           H_MUL:    POP   D   ; DE = multiplicand
016A   C5                     PUSH   B   
016B   44                     MOV   B,H   
016C   4D                     MOV   C,L   ; BC = multiplier
016D   21 00 00               LXI   H,0   
0170   78           MUL1:     MOV   A,B   
0171   B7                     ORA   A   ; clear carry
0172   1F                     RAR      
0173   47                     MOV   B,A   
0174   79                     MOV   A,C   
0175   1F                     RAR      
0176   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0177   D2 7B 01               JNC   mul2   
017A   19                     DAD   D   
017B   EB           MUL2:     XCHG      
017C   29                     DAD   H   ; multiplicand << 1
017D   EB                     XCHG      
017E   78                     MOV   A,B   
017F   B1                     ORA   C   
0180   C2 70 01               JNZ   mul1   
0183   C1                     POP   B   
0184   F7                     RST   6   
0185                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
0185                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0185                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0185   D1           H_DIV:    POP   D   ; DE = a, HL = b
0186   C5                     PUSH   B   
0187   7A                     MOV   A,D   
0188   B7                     ORA   A   
0189   F5                     PUSH   PSW   ; S flag = sign of a (for r)
018A   AC                     XRA   H   
018B   F5                     PUSH   PSW   ; S flag = sign of q
018C   7C                     MOV   A,H   
018D   B7                     ORA   A   
018E   FC 20 00               CM   neg16   ; HL = |b|
0191   EB                     XCHG      
0192   7C                     MOV   A,H   
0193   B7                     ORA   A   
0194   FC 20 00               CM   neg16   ; HL = |a|, DE = |b|
0197   CD 81 02               CALL   udiv   ; HL = q, BC = r
019A   F1                     POP   PSW   
019B   FC 20 00               CM   neg16   ; q's sign
019E   EB                     XCHG      ; DE = q
019F   60                     MOV   H,B   
01A0   69                     MOV   L,C   ; HL = r
01A1   F1                     POP   PSW   
01A2   FC 20 00               CM   neg16   ; r's sign
01A5   C1                     POP   B   
01A6   E5                     PUSH   H   ; r under q
01A7   EB                     XCHG      ; HL = q
01A8   F7                     RST   6   
01A9                             ; ---- stack and storage -----------------------------------------------------
01A9   E5           H_DUP:    PUSH   H   ; ":"
01AA   F7                     RST   6   
01AB   E3           H_SWAP:   XTHL      ; "%"
01AC   F7                     RST   6   
01AD   D1           H_STORE:   POP   D   ; "!" ( n addr -- )
01AE                          IF   CHECKED   
01AE   23                     INX   H   ; both bytes must be in the program's space
01AF   CD 31 03               CALL   chkst   
01B2   2B                     DCX   H   
01B3                          ENDIF      
01B3   73                     MOV   M,E   
01B4   23                     INX   H   
01B5   72                     MOV   M,D   
01B6   DF                     RST   3   
01B7   D1           H_CSTORE:   POP   D   ; "." ( c addr -- )
01B8                          IF   CHECKED   
01B8   CD 31 03               CALL   chkst   
01BB                          ENDIF      
01BB   73                     MOV   M,E   
01BC   DF                     RST   3   
01BD                             ; ---- console ---------------------------------------------------------------
01BD                             ; 22h pushes the address of the text after it and skips the string.
01BD   E5           H_STR:    PUSH   H   
01BE   60                     MOV   H,B   
01BF   69                     MOV   L,C   
01C0   CD DB 02               CALL   skipstr   
01C3   F7                     RST   6   
01C4                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01C4                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01C4                             ; bit 6, so // and /" give themselves).
01C4   7E           H_PRINT:   MOV   A,M   
01C5   23                     INX   H   
01C6   FE 22                  CPI   22h   
01C8   CA DA 01               JZ   h_drop   
01CB   FE 2F                  CPI   "/"   
01CD   C2 D4 01               JNZ   pr1   
01D0   7E                     MOV   A,M   
01D1   23                     INX   H   
01D2   E6 BF                  ANI   0BFh   
01D4   EF           PR1:      RST   5   
01D5   C3 C4 01               JMP   h_print   
01D8   7D           H_EMIT:   MOV   A,L   ; "'"
01D9   EF                     RST   5   
01DA   DF           H_DROP:   RST   3   ; ";" is this one byte
01DB                             ; "#" prints TOS as a signed decimal number, with no space after it.
01DB   7C           H_NUM:    MOV   A,H   
01DC   B7                     ORA   A   
01DD   F2 E4 01               JP   num1   
01E0   3E 2D                  MVI   A,"-"   
01E2   EF                     RST   5   
01E3   E7                     RST   4   
01E4   C5           NUM1:     PUSH   B   
01E5   CD A2 02               CALL   pdec   
01E8   C1                     POP   B   
01E9   DF                     RST   3   
01EA                          IF   CHECKED   ; (the checked build has no room to start ","
01EA   6E           H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
01EB   26 00                  MVI   H,0   ;   the end of "?")
01ED   F7                     RST   6   
01EE                          ENDIF      
01EE                             ; "?" ( n -- c ) or ( -n -- addr )
01EE                             ;   n > 0: wait about n ms for a key; 0 if none came
01EE                             ;   n = 0: wait for a key
01EE                             ;   n < 0: read a line of at most -n characters, with echo. n is not
01EE                             ;          checked: the buffer holds 127 characters and the CR, so a
01EE                             ;          program must ask for 127 or fewer.
01EE   7C           H_KEY:    MOV   A,H   
01EF   B7                     ORA   A   
01F0   FA 0E 02               JM   line   
01F3   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
01F5   CD FB 02     KT2:      CALL   getk   
01F8   C2 0A 02               JNZ   kt3   
01FB   1D                     DCR   E   
01FC   C2 F5 01               JNZ   kt2   
01FF   7C                     MOV   A,H   ; 0? never counts down: it waits
0200   B5                     ORA   L   
0201   CA F3 01               JZ   kt1   
0204   2B                     DCX   H   
0205   7C                     MOV   A,H   
0206   B5                     ORA   L   
0207   C2 F3 01               JNZ   kt1   ; A = 0 if the time ran out
020A                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
020A                          ENDIF      
020A   6F           KT3:      MOV   L,A   
020B   26 00                  MVI   H,0   
020D   F7                     RST   6   
020E                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     XRA   A   
                              SUB   L   ; A = the count (TOS is minus the count)
                              STA   LBHDR   
                              PUSH   B   
                              LXI   D,LBHDR   
                              MVI   C,10   
                              CALL   BDOS   
                              POP   B   
                              LXI   H,LBHDR+1   
                              MOV   A,M   ; the count typed (0-127)
                              INR   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   L   ;   adding the count to L can't carry
                              MOV   L,A   
                              MVI   M,13   
                              MVI   L,LINEBUF & 0FFh   
                              RST   6   
020E                          ENDIF      
020E                          IFN   CPM   
020E                             ; Generic: Backspace takes the last character back (and is echoed as
020E                             ; it is), CR ends (stored, not echoed), every other key is stored and
020E                             ; echoed until the line is full. The line buffer starts at offset 80h
020E                             ; of its page, so L alone is the place in the line: D holds the L of
020E                             ; a full line.
020E   3E 80        LINE:     MVI   A,LINEBUF & 0FFh   
0210   95                     SUB   L   ; (TOS is minus the count)
0211   57                     MOV   D,A   ; D = the L of a full line
0212   21 80 82               LXI   H,LINEBUF   
0215   CD FB 02     LN2:      CALL   getk   
0218   CA 15 02               JZ   ln2   
021B   FE 0D                  CPI   13   
021D   CA 3A 02               JZ   ln5   
0220   FE 08                  CPI   8   
0222   CA 32 02               JZ   ln4   
0225   5F                     MOV   E,A   
0226   7D                     MOV   A,L   
0227   BA                     CMP   D   
0228   CA 15 02               JZ   ln2   ; full
022B   73                     MOV   M,E   
022C   2C                     INR   L   
022D   7B                     MOV   A,E   
022E   EF           LN3:      RST   5   
022F   C3 15 02               JMP   ln2   
0232   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0233   FA 2E 02               JM   ln3   ;   unless the line was empty (L left the
0236   2C                     INR   L   ;   upper half of the page)
0237   C3 15 02               JMP   ln2   
023A   77           LN5:      MOV   M,A   ; the CR
023B   2E 80                  MVI   L,LINEBUF & 0FFh   
023D   F7                     RST   6   
023E                          ENDIF      
023E                             ; =============================================================================
023E                             ;  Dispatch table: the low byte of each handler's address, in code order.
023E                             ;  It must not cross a page (the dispatcher only adds to its low byte).
023E                             ; =============================================================================
023E                             ; The handlers of the first NPG1 characters start in the image's second page.
023E                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
023E                             ; differs between the builds, so the count is worked out here.
023E                             ; (One division to a line: asm80 only rounds down when it stores a value.)
023E                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
023E                PGBRK:    EQU   (h_break-BASE)/256   
023E                PGDEF:    EQU   (h_def-BASE)/256   
023E                PGFET:    EQU   (h_fetch-BASE)/256   
023E                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
023E   AD           PTAB:     DB   h_store & 0FFh   ; !
023F   BD                     DB   h_str & 0FFh   ; "
0240   DB                     DB   h_num & 0FFh   ; #
0241   C4                     DB   h_print & 0FFh   ; $
0242   AB                     DB   h_swap & 0FFh   ; %
0243   44                     DB   h_and & 0FFh   ; &
0244   D8                     DB   h_emit & 0FFh   ; '
0245   20                     DB   h_open & 0FFh   ; (
0246   2C                     DB   h_close & 0FFh   ; )
0247   69                     DB   h_mul & 0FFh   ; *
0248   41                     DB   h_add & 0FFh   ; +
0249   EA                     DB   h_cfetch & 0FFh   ; ,
024A   38                     DB   h_sub & 0FFh   ; -
024B   B7                     DB   h_cstore & 0FFh   ; .
024C   85                     DB   h_div & 0FFh   ; /
024D   A9                     DB   h_dup & 0FFh   ; :
024E   DA                     DB   h_drop & 0FFh   ; ;
024F   4D                     DB   h_lt & 0FFh   ; <
0250   5C                     DB   h_eq & 0FFh   ; =
0251   4C                     DB   h_gt & 0FFh   ; >
0252   EE                     DB   h_key & 0FFh   ; ?
0253   1B                     DB   h_fetch & 0FFh   ; @
0254   F6                     DB   h_def & 0FFh   ; [
0255   E7                     DB   h_break & 0FFh   ; \
0256   E2                     DB   h_ret & 0FFh   ; ]
0257   7F                     DB   h_xor & 0FFh   ; ^
0258   92                     DB   h_alloc & 0FFh   ; _
0259   BF                     DB   h_grave & 0FFh   ; `
025A   14                     DB   h_tor & 0FFh   ; {
025B   87                     DB   h_or & 0FFh   ; |
025C   1D                     DB   h_fromr & 0FFh   ; }
025D   8F                     DB   h_not & 0FFh   ; ~
025E                PTABEND:      
025E                             ; =============================================================================
025E                             ;  Routines (no handler starts past this point)
025E                             ; =============================================================================
025E                             ; Digits: step back onto the first digit and read the whole number.
025E   E5           DIGIT:    PUSH   H   
025F   0B                     DCX   B   
0260   CD 6A 02               CALL   rdnum   
0263   F7                     RST   6   
0264                             ; negnum: "-" directly before a digit: read the number, negate it.
0264   E5           NEGNUM:   PUSH   H   
0265   CD 6A 02               CALL   rdnum   
0268   E7                     RST   4   
0269   F7                     RST   6   
026A                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
026A                             ; non-digit. Values wrap at 16 bits, as the spec says.
026A   21 00 00     RDNUM:    LXI   H,0   
026D   0A           RDN1:     LDAX   B   
026E   D6 30                  SUI   "0"   
0270   FE 0A                  CPI   10   
0272   D0                     RNC      
0273   03                     INX   B   
0274   54                     MOV   D,H   
0275   5D                     MOV   E,L   
0276   29                     DAD   H   
0277   29                     DAD   H   
0278   19                     DAD   D   
0279   29                     DAD   H   ; HL * 10
027A   5F                     MOV   E,A   
027B   16 00                  MVI   D,0   
027D   19                     DAD   D   
027E   C3 6D 02               JMP   rdn1   
0281                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0281                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0281                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0281                             ; lives on the stack, since A is busy with the shifts.
0281   01 00 00     UDIV:     LXI   B,0   
0284   3E 10                  MVI   A,16   
0286   F5                     PUSH   PSW   
0287   29           UDV1:     DAD   H   ; next dividend bit into the carry
0288   79                     MOV   A,C   
0289   17                     RAL      
028A   4F                     MOV   C,A   
028B   78                     MOV   A,B   
028C   17                     RAL      
028D   47                     MOV   B,A   ; BC = BC*2 + bit
028E   79                     MOV   A,C   
028F   93                     SUB   E   
0290   78                     MOV   A,B   
0291   9A                     SBB   D   ; carry if BC < DE
0292   DA 9A 02               JC   udv2   
0295   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0296   79                     MOV   A,C   
0297   93                     SUB   E   
0298   4F                     MOV   C,A   
0299   2C                     INR   L   ; quotient bit
029A   F1           UDV2:     POP   PSW   
029B   3D                     DCR   A   
029C   F5                     PUSH   PSW   
029D   C2 87 02               JNZ   udv1   
02A0   F1                     POP   PSW   
02A1   C9                     RET      
02A2                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02A2                             ; Uses BC.
02A2   11 0A 00     PDEC:     LXI   D,10   
02A5   CD 81 02               CALL   udiv   ; HL = HL / 10, C = the last digit
02A8   79                     MOV   A,C   
02A9   F5                     PUSH   PSW   
02AA   7C                     MOV   A,H   
02AB   B5                     ORA   L   
02AC   C4 A2 02               CNZ   pdec   
02AF   F1                     POP   PSW   
02B0   C6 30                  ADI   "0"   
02B2   EF                     RST   5   
02B3   C9                     RET      
02B4                             ; skip: read past text to the closer at this level, and return A = 0 if it
02B4                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02B4                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02B4                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02B4                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02B4                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
02B4   16 00        SKIP:     MVI   D,0   
02B6   14           SK3:      INR   D   ; an opener: one deeper
02B7   0A           SK1:      LDAX   B   
02B8   03                     INX   B   
02B9   B7                     ORA   A   
02BA   CA 7C 00               JZ   endprog   
02BD   FE 22                  CPI   22h   
02BF   CC DB 02               CZ   skipstr   ; leaves A = 22h, which matches nothing below
02C2   D6 28                  SUI   "("   
02C4   CA B6 02               JZ   sk3   
02C7   3D                     DCR   A   ; ")"
02C8   CA D5 02               JZ   sk4   
02CB   D6 32                  SUI   "["-")"   
02CD   CA B6 02               JZ   sk3   
02D0   FE 02                  CPI   "]"-"["   
02D2   C2 B7 02               JNZ   sk1   
02D5   15           SK4:      DCR   D   
02D6   C8                     RZ      ; the closer at this level
02D7   C3 B7 02               JMP   sk1   
02DA                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02DA                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02DA   03           SS0:      INX   B   
02DB   0A           SKIPSTR:   LDAX   B   
02DC   03                     INX   B   
02DD   FE 2F                  CPI   "/"   
02DF   CA DA 02               JZ   ss0   
02E2   FE 22                  CPI   22h   
02E4   C2 DB 02               JNZ   skipstr   
02E7   C9                     RET      
02E8                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02E8                             ; and return its value in A with the carry set; otherwise leave the IP and
02E8                             ; return with the carry clear.
02E8   0A           HEXC:     LDAX   B   
02E9   D6 30                  SUI   "0"   
02EB   FE 0A                  CPI   10   
02ED   DA F9 02               JC   hc1   
02F0   E6 DF                  ANI   0DFh   
02F2   D6 11                  SUI   11h   
02F4   FE 06                  CPI   6   
02F6   D0                     RNC      
02F7   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
02F9   03           HC1:      INX   B   
02FA   C9                     RET      
02FB                             ; =============================================================================
02FB                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02FB                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 5) prints A.
02FB                             ;  Both keep BC, DE and HL. In the generic build they are the host's KEY and
02FB                             ;  CONOUT routines themselves.
02FB                             ; =============================================================================
02FB                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
02FB                          ENDIF      
02FB                          IF   CHECKED   
02FB   E5           GETK:     PUSH   H   ; a key held back by the break check goes
02FC   21 36 82               LXI   H,KEYBUF   ;   first, and is taken out of the buffer
02FF   7E                     MOV   A,M   
0300   36 00                  MVI   M,0   
0302   E1                     POP   H   
0303   B7                     ORA   A   
0304   C0                     RNZ      
0305                          ENDIF      
0305                          IF   (1-CPM)*CHECKED   
0305   C3 06 FF               JMP   KEY   
0308                          ENDIF      
0308                          IF   CPM*(1-CHECKED)   
                    GETK:        
0308                          ENDIF      
0308                          IF   CPM   
                              MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
0308                          ENDIF      
0308                             ; =============================================================================
0308                             ;  Checked build: the checks and the error report
0308                             ; =============================================================================
0308                          IF   CHECKED   
0308                             ; chkstk: both stacks are checked once per character, not in every handler.
0308                             ; Each stack lives in one page, so it has overrun exactly when the pointer's
0308                             ; high byte has left that page. Errors are caught one cell late at most; the
0308                             ; page below each stack is a guard band. (The call itself is on the data
0308                             ; stack, but in the same page whenever the stack is in range.)
0308   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
0309   21 00 00               LXI   H,0   
030C   39                     DAD   SP   
030D   7C                     MOV   A,H   
030E   FE 81                  CPI   DSPAGE   
0310   C2 4C 03               JNZ   e_stack   
0313   2A 34 82               LHLD   RSP   ; the return stack: in its page, and not
0316   7D                     MOV   A,L   ;   above its empty position (an underflow
0317   FE E1                  CPI   RSTOP&0FFh+1   ;   would stay inside the page, in the
0319   D2 4F 03               JNC   e_rstack   ;   guard band)
031C   7C                     MOV   A,H   
031D   FE 80                  CPI   RSPAGE   
031F   C2 4F 03               JNZ   e_rstack   
0322   EB                     XCHG      ; TOS back
0323   C9                     RET      
0324                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
0324                             ; else is held for the next "?". Keeps BC, DE, HL.
0324   CD FB 02     CHKBRK:   CALL   getk   
0327   C8                     RZ      
0328   FE 03                  CPI   3   
032A   CA 52 03               JZ   e_break   
032D   32 36 82               STA   KEYBUF   
0330   C9                     RET      
0331                             ; chkst: stop unless HL is in the program's own space: from the letter page
0331                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0331                             ; whatever lies above the limit are safe. Memory above the heap top but
0331                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0331                             ; Keeps every register.
0331   F5           CHKST:    PUSH   PSW   
0332   7C                     MOV   A,H   
0333   FE 82                  CPI   LETPAGE   
0335   DA 49 03               JC   e_store   
0338                          ENDIF      
0338                          IF   CHECKED*(1-CPM)   
0338   FE F0                  CPI   HEAPLIM   
033A   D2 49 03               JNC   e_store   
033D                          ENDIF      
033D                          IF   CHECKED*CPM   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   H   
                              JC   e_store   
033D                          ENDIF      
033D                          IF   CHECKED   
033D   F1                     POP   PSW   
033E   C9                     RET      
033F                             ; chkhp: stop if working out the new heap top carried (a negative count
033F                             ; wraps: too big), or if the new top in HL is not below the limit page.
033F   DA 46 03     CHKHP:    JC   e_heap   
0342                          ENDIF      
0342                          IF   CHECKED*(1-CPM)   
0342   7C                     MOV   A,H   
0343   FE F0                  CPI   HEAPLIM   
0345   D8                     RC      
0346                          ENDIF      
0346                          IF   CHECKED*CPM   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              RNC      
0346                          ENDIF      
0346                          IF   CHECKED   
0346                             ; Error entries. Each loads its letter and then hides the next entry inside
0346                             ; a 3-byte LXI H (the 21h), so they all fall through to `error`.
0346   3E 48        E_HEAP:   MVI   A,"H"   ; heap past the limit
0348   21                     DB   21h   
0349   3E 57        E_STORE:   MVI   A,"W"   ; write outside the program's space
034B   21                     DB   21h   
034C   3E 53        E_STACK:   MVI   A,"S"   ; data stack over or under
034E   21                     DB   21h   
034F   3E 52        E_RSTACK:   MVI   A,"R"   ; return stack over or under
0351   21                     DB   21h   
0352   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C
0354   21                     DB   21h   
0355   3E 44        E_BRACK:   MVI   A,"D"   ; bad character after [
0357                             ; error: print the letter in A, " @ " and the offset in the program of the
0357                             ; character just read, then end. For example: S @ 245
0357   31 FE 81     ERROR:    LXI   SP,DSTOP   ; the stacks may be wrecked: start clean
035A   EF                     RST   5   
035B   3E 20                  MVI   A," "   
035D   EF                     RST   5   
035E   3E 40                  MVI   A,"@"   
0360   EF                     RST   5   
0361   3E 20                  MVI   A," "   
0363   EF                     RST   5   
0364   21 FF 7C               LXI   H,(0-PROG-1)&0FFFFh   ; minus the address of the character
0367   09                     DAD   B   ;   just read: HL = its offset
0368   CD A2 02               CALL   pdec   
036B   C3 7C 00               JMP   endprog   
036E                          ENDIF      
036E                             ; =============================================================================
036E                             ;  Startup
036E                             ; =============================================================================
036E                START:       
036E                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   H,vecs   ; the RST routines go down into page zero
                              LXI   D,0008h   
                              MVI   B,vecend-vecs   
                    CPY:      MOV   A,M   
                              STAX   D   
                              INX   H   
                              INX   D   
                              DCR   B   
                              JNZ   cpy   
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
036E                          ENDIF      
036E                          IFN   CPM   
036E   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
0371   7E           FNUL:     MOV   A,M   
0372   23                     INX   H   
0373   B7                     ORA   A   
0374   C2 71 03               JNZ   fnul   
0377                          ENDIF      
0377   22 7C 82               SHLD   HEAP   
037A   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
037D   22 34 82               SHLD   RSP   
0380                          IF   CHECKED   
0380   AF                     XRA   A   
0381   32 36 82               STA   KEYBUF   ; no key held back
0384                          ENDIF      
0384   01 00 83               LXI   B,PROG   ; the IP
0387   F7                     RST   6   ; (its return address is thrown away)
0388                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0388                          ENDIF      
0388                IMGEND:      


