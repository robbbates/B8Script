   652                              <1> ; =============================================================================
   653                              <1> ;  Checked build: the checks and the error report (here, so that the
   654                              <1> ;  handlers' bodies above reach the error entries with short jumps)
   655                              <1> ; =============================================================================
   656                              <1> %if CHECKED
   657                              <1> e_zero: mov     al,'Z'                  ; dividing by zero
   658                              <1>         jmp     error
   659                              <1> e_heap: mov     al,'H'                  ; the heap
   660                              <1>         jmp     error
   661                              <1> 
   662                              <1> ; chkst1, chkst2: stop with O unless the 1 or 2 bytes at TOS are in the
   663                              <1> ; program's space: from the letter page up to the heap limit. Memory above
   664                              <1> ; the heap top but below the limit is the program's own: Tiny BASIC keeps
   665                              <1> ; its lines there.
   666                              <1> chkst2: mov     eax,ebx
   667                              <1>         sub     ax,LET
   668                              <1>         cmp     ax,LIMIT-LET-1
   669                              <1>         jmp     short chs1
   670                              <1> chkst1: mov     eax,ebx
   671                              <1>         sub     ax,LET
   672                              <1>         cmp     ax,LIMIT-LET
   673                              <1> chs1:   jae     e_store
   674                              <1>         ret
   675                              <1> 
   676                              <1> ; chkstk: both stacks are checked once per character, not in every handler.
   677                              <1> ; A character can pop a cell or two too many, or push one too many, before
   678                              <1> ; it is seen here: the data stack has the caller's frame above it and the
   679                              <1> ; thread's stack below, and the return stack has the image's spare space on
   680                              <1> ; both sides.
   681                              <1> chkstk: lea     eax,[esp+4]
   682                              <1>         sub     eax,[V(v_dstop)]        ; minus 4 x the depth
   683                              <1>         jg      e_under
   684                              <1>         cmp     eax,-4*DSMAX
   685                              <1>         jl      e_over
   686                              <1>         cmp     di,RSTOP & 0FFFFh       ; (the return stack is in one 64K: only
   687                              <1>         ja      e_rund                  ;   the low word changes)
   688                              <1>         cmp     di,(RSTOP-4*RSMAX) & 0FFFFh
   689                              <1>         jb      e_rover
   690                              <1>         ret
   691                              <1> e_under:mov     esp,[V(v_dstop)]        ; data stack underflow: it counts as
   692                              <1>         mov     al,'s'                  ;   empty
   693                              <1>         jmp     short error
   694                              <1> e_rund: mov     edi,RSTOP               ; return stack underflow: the same.
   695                              <1>         or      esi,ARENA               ;   (A ']' or ')' may have taken an IP
   696                              <1>         mov     al,'r'                  ;   of 0 from below the stack: keep the
   697                              <1>                                         ;   place readable)
   698                              <1>         jmp     short errp
   699                              <1> e_rover:mov     al,'R'
   700                              <1>         jmp     short errp
   701                              <1> e_over: mov     al,'S'
   702                              <1>         jmp     short errp
   703                              <1> e_break:mov     al,'B'                  ; Ctrl-C (inside pollk or getk)
   704                              <1>         jmp     short errp
   705                              <1> e_store:mov     al,'O'                  ; a store outside the program's space
   706                              <1>         jmp     short errp
   707                              <1> e_dollar:mov    al,'Q'                  ; '$' ran into a NUL
   708                              <1> ; errp: an error found inside a routine: drop its return address first.
   709                              <1> errp:   pop     edx
   710                              <1>         jmp     short error
   711                              <1> e_quote:mov     esi,ebx                 ; an unclosed string: its address, one
   712                              <1>         mov     al,'Q'                  ;   past the quote, is the place
   713                              <1>         jmp     short error
   714                              <1> e_brack:mov     al,'W'                  ; bad character after [
   715                              <1> 
   716                              <1> ; error: the report, then the end. AL = the letter, ESI = one past the
   717                              <1> ; place, EBX = TOS, and both stacks as the report is to show them:
   718                              <1> ;
   719                              <1> ;   Err X @ line,col
