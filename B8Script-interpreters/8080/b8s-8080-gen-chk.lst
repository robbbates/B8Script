037C   3E 1B        CSI:      MVI   A,27   
037E   EF                     RST   5   
037F   3E 5B                  MVI   A,"["   
0381   EF                     RST   5   
0382   C9                     RET      
0383                          ENDIF      
0383                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CLS:    CALL   CONCLS   
                              RST   6   
                    G_EOL:    CALL   CONEOL   
                              RST   6   
                    G_CUR:    MOV   A,H   
                              ORA   L   
                              CALL   CONCUR   
                              RST   3   
                    G_AT:     POP   D   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   3   
0383                          ENDIF      
0383                          IF   CHECKED   
0383   E1           GBAD:     POP   H   ; no such code: W. The place is the character
0384   C3 F2 04               JMP   e_brack   
0387                          ENDIF      
0387                             ; psgn: print HL as a signed number. Uses BC.
0387   7C           PSGN:     MOV   A,H   
