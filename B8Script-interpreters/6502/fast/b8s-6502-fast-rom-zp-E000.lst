F26A                          IF   FAST*(1-CHECKED)   
                                 ; a-z, unchecked: a variable followed by @ or ! is fetched or stored in the
                                 ; same step; otherwise its address is pushed, and the character after it,
                                 ; read already, is dispatched from A or Y.
                    FVA:      LDY   #0   ; a
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   fvaf   
                              CMP   #"!"   
                              BEQ   fvas   
                              DEX      ; not @ or !: push the address
                              DEX      
                              LDY   #40h   
                              STY   0,X   
                              LDY   #>LET   
                              STY   1,X   
                              ;*Macro unroll:  NEXTA
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
