F125   6E 84                  JMP   ,X   ; the code's RTS returns to the dispatcher
F127                          IF   CHECKED   
                    HEXC:     JSR   isdig   
                              BLO   hv1   ; C = 1
                              ANDA   #0DFh   
                              SUBA   #11h   
                              CMPA   #6   
                              BHS   hv9   ; C = 0
                              SUBA   #0F6h   ; + 10, and sets the carry
                    HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
