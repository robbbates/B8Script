0539   5D                     LD   E,L   ;   E = the end of the line (its low byte)
053A   CD C8 05     ED1:      CALL   ekey   
053D   FE 7F                  CP   7Fh   
053F   28 40                  JR   Z,bsp   ; DEL
0541   FE 20                  CP   " "   
0543   30 56                  JR   NC,insc   
0545   FE 09                  CP   9   
0547   28 52                  JR   Z,insc   ; Tab is text
0549   FE 08                  CP   8   
054B   28 34                  JR   Z,bsp   
054D   FE 02                  CP   2   
054F   28 C7                  JR   Z,left   ; ^B
0551   FE 06                  CP   6   
0553   28 97                  JR   Z,right   ; ^F
0555   FE 1B                  CP   1Bh   
0557   28 9B                  JR   Z,esc   
0559   E5                     PUSH   HL   ; a command key? Look it up
055A   21 CE 05               LD   HL,cmds   
055D   06 08                  LD   B,NCMD   
055F   BE           ED2:      CP   (HL)   
0560   23                     INC   HL   
0561   28 07                  JR   Z,ed3   
0563   23                     INC   HL   
0564   23                     INC   HL   
0565   10 F8                  DJNZ   ed2   
0567   E1                     POP   HL   
0568   18 D0                  JR   ed1   ; no: the key is ignored
