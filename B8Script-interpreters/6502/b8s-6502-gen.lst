0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-11-21). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page ($00-$09). b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  One switch, set in the EQU line below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's four-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   0/ "no"$
0000                             ;                   Stk 2: 5 0
0000                             ;                   Rtn 0
0000                             ;                 and then goes to EXIT.
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                CDOWN:    EQU   07h   ; the break check's countdown (see pnext)
0000                             ; The error report (checked) runs after the program, so it may use the zero
0000                             ; page that machine code has ($0A-$0F):
0000                P:        EQU   0Ah   ; 0A-0B the place being reported
0000                Q:        EQU   0Ch   ; 0C-0D a pointer for counting lines
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PLACE at +36, PEND at +38;
0000                             ;               and every build's: KEYBUF (the held key) at +7A, BRKOFF (the
0000                             ;               break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                RSV:      EQU   LET+35h   ; checked: S as it was before this character
0000                PLACE:    EQU   LET+36h   ; checked: the address of this character
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                LBM1:     EQU   LINEBUF-1   ; (for the error report)
0000                PROGM1:   EQU   PROG-1   
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
                                 ; The first half of the letter page is zeroed: every variable, every
                                 ; cell of the interpreter's own (no key held back), and every word
                                 ; cell, which then points at 0000h: calling an undefined word stops
                                 ; with U (see e_undef).
                              INX      
                              TXA      ; A = 0
                              LDY   #7Fh   
                    STZ:      STA   LET,Y   
                              DEY      
                              BPL   stz   
E003                          ENDIF      
E003   20 A2 E1               JSR   rstip   
E006   20 96 E1     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B                          IF   1-CHECKED   
E00B   8D 7A 04               STA   KEYBUF   ; (A = 0) no key held, the break key on
E00E   8D 7B 04               STA   BRKOFF   
E011                          ENDIF      
E011   A5 00                  LDA   IP   
E013   8D 7C 04               STA   HEAP   
E016                          IF   CHECKED   
                              STA   PEND   
E016                          ENDIF      
E016   A5 01                  LDA   IP+1   
E018   8D 7D 04               STA   HEAP+1   
E01B                          IF   CHECKED   
                              STA   PEND+1   
E01B                          ENDIF      
E01B   20 A2 E1               JSR   rstip   
E01E   A2 FC                  LDX   #DSE   
E020                             ; =============================================================================
E020                             ;  The inner loop
E020                             ; =============================================================================
E020                             ; -----------------------------------------------------------------------------
E020                             ;  The break key. A running program reads the keyboard only through getk
E020                             ;  (for "?") and pnext (the break check), which between them give the break
E020                             ;  key its rules:
E020                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E020                             ;      build, with the report (B) in the checked one;
E020                             ;    - any other key that the break check reads is held in KEYBUF for the
E020                             ;      next "?", and a newer one takes its place;
E020                             ;    - "?" (getk) takes the held key first;
E020                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E020                             ;      key like any other, but two of them within about 250 ms still stop it.
E020                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E020                             ; -----------------------------------------------------------------------------
E020                             ; pnext: the break check, then (falling through) next. A word call, a true
E020                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E020                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E020                             ; falls in here too, which does no harm.)
E020   C6 07        PNEXT:    DEC   CDOWN   
E022   D0 0F                  BNE   next   
E024   20 06 FF               JSR   KEY   
E027   F0 0A                  BEQ   next   ; no key
E029   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E02C   C9 03                  CMP   #3   
E02E   D0 03                  BNE   next   
E030   20 81 E4               JSR   ctlc   ; (it comes back only if the break key is off)
E033                NEXT:        
E033                          IF   CHECKED   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE: an
                                 ; underflow moves X up to FDh or FEh (no handler moves X by more
                                 ; than 2), and an overflow wraps it from 00h to FFh.
                                 ; S is kept in RSV, for the report's Rtn line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_stack   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E033                          ENDIF      
E033   20 39 E0               JSR   step   
E036   4C 33 E0               JMP   next   
E039                             ; step: read one character and sort it by range.
E039                             ;    00h          end of program
E039                             ;    01h-20h, 7Fh-FFh   ignored
E039                             ;    30h-39h      digit: read a whole number
E039                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E039                             ;    61h-7Ah      a-z: push the address of that letter's cell
E039                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E039                             ; Every way out of the sort has the carry clear, except "ignored". A checked
E039                             ; build stops on 80h-FFh (X) and still ignores DEL.
E039   20 96 E1     STEP:     JSR   getc   ; flags follow A
E03C   F0 36                  BEQ   endprog   
E03E   38                     SEC      
E03F   E9 21                  SBC   #21h   ; A = c - 21h
E041   90 30                  BCC   ign   ; 01h-20h
E043   C9 0F                  CMP   #0Fh   
E045   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E047   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E049   C9 0A                  CMP   #10   
E04B   90 2F                  BCC   digit   
E04D   C9 11                  CMP   #11h   
E04F   90 16                  BCC   p3a   ; 3Ah-40h
E051   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E053   C9 1A                  CMP   #1Ah   
E055   90 20                  BCC   upper   ; 41h-5Ah
E057   C9 20                  CMP   #20h   
E059   90 0A                  BCC   p5b   ; 5Bh-60h
E05B   C9 3A                  CMP   #3Ah   
E05D   90 25                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E05F   C9 3E                  CMP   #3Eh   
E061                          IF   1-CHECKED   
E061   B0 10                  BCS   ign   ; 7Fh-FFh
E063                          ENDIF      
E063                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E063                          ENDIF      
E063                             ; The three adjustments below chain. Each ADC adds the carry the one
E063                             ; before it left, which the constants allow for.
E063   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E065   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E067   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E069   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E06A   A8                     TAY      
E06B   B9 1C E1               LDA   PTAB+1,Y   
E06E   48                     PHA      
E06F   B9 1B E1               LDA   PTAB,Y   
E072   48                     PHA      
E073   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E074                             ; directly, it just ends an ignored character.
E074                ENDPROG:      
E074                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E074                          ENDIF      
E074   4C 09 FF               JMP   EXIT   
E077                          IF   CHECKED   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; Rtn does not count the call
                              LDA   #"U"   
                              BNE   ejmp   ; always
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: Rtn 0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_STACK:   CPX   #0FFh   
                              LDA   #"S"   
                              BCS   ejmp   ; X wrapped from 00h to FFh: an overflow
                              LDX   #DSE   ; an underflow: Stk 0
                              LDA   #"s"   
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP:     JMP   error   
E077                          ENDIF      
E077                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E077                             ; the return stack, and the IP becomes the address in the letter's cell.
E077   0A           UPPER:    ASL      
E078   A8                     TAY      
E079   38                     SEC      
E07A   B0 2C                  BCS   pushn   ; always
E07C                             ; Digits: the first one is in A; read the rest of the number.
E07C   A0 00        DIGIT:    LDY   #0   
E07E   20 8D E0               JSR   pushay   
E081   4C 82 E1               JMP   rdnum   
E084                             ; a-z: push the cell's address (the cell is the variable)
E084   0A           LOWER:    ASL      
E085   A0 04                  LDY   #>LET   
E087   D0 04                  BNE   pushay   ; always
E089   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E08B   A4 01                  LDY   IP+1   
E08D                             ; pushay: push a cell: A = its low byte, Y = its high byte
E08D   48           PUSHAY:   PHA      
E08E   20 97 E0               JSR   push   
E091   68                     PLA      
E092   85 02                  STA   TL   
E094   84 03                  STY   TH   
E096   60                     RTS      
E097   CA           PUSH:     DEX      ; ":" and every push (keeps Y)
E098   A5 02                  LDA   TL   
E09A   9D 00 02               STA   DSL,X   
E09D   A5 03                  LDA   TH   
E09F   9D 00 03               STA   DSH,X   
E0A2   60                     RTS      
E0A3                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E0A3                             ; the matching ")".
E0A3   20 AB E1     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E0A6                          IF   1-CHECKED   
E0A6   F0 36                  BEQ   skip   
E0A8                          ENDIF      
E0A8                          IF   CHECKED   
                              BEQ   skpar   
E0A8                          ENDIF      
E0A8                             ; pushn: take the step frame off, push the reading position on the return
E0A8                             ; stack, and go on. With the carry set (a word call) the reading position
E0A8                             ; then becomes the address in the letter cell at LET,Y.
E0A8   68           PUSHN:    PLA      
E0A9   68                     PLA      ; drop the step frame
E0AA   A5 01                  LDA   IP+1   
E0AC   48                     PHA      
E0AD   A5 00                  LDA   IP   
E0AF   48                     PHA      
E0B0   90 0A                  BCC   nxt   
E0B2   B9 00 04               LDA   LET,Y   
E0B5   85 00                  STA   IP   
E0B7   B9 01 04               LDA   LET+1,Y   
E0BA   85 01                  STA   IP+1   
E0BC   4C 20 E0     NXT:      JMP   pnext   
E0BF                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E0BF                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E0BF                             ; the body"s address instead. Either way it then skips to the matching "]'.
E0BF                             ; (The unchecked build takes anything that is not a letter as the space; the
E0BF                             ; checked build stops on it.)
E0BF                          IF   CHECKED   
                    DEF1:     CPY   #" "-"A"+256   
                              BEQ   def2   
                                 ; W: anything but a letter or a space after [. The place is that character,
                                 ; one past the [.
                              INC   PLACE   
                              BNE   eb1   
                              INC   PLACE+1   
                    EB1:      LDA   #"W"   
                              BNE   ejmp   ; always
                                 ; A false ( skips: the wrong closer for it is ].
                    SKPAR:    LDA   #"]"   
                              BNE   skip   ; always
E0BF                          ENDIF      
E0BF   20 96 E1     H_DEF:    JSR   getc   
E0C2   38                     SEC      
E0C3   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E0C5   A8                     TAY      ;   lands 64 bytes up
E0C6   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E0C8   C9 1A                  CMP   #26   
E0CA                          IF   1-CHECKED   
E0CA   B0 0F                  BCS   def2   ; not a letter
E0CC                          ENDIF      
E0CC                          IF   CHECKED   
                              BCS   def1   
E0CC                          ENDIF      
E0CC   98                     TYA      
E0CD   0A                     ASL      
E0CE   A8                     TAY      ; Y -> the cell
E0CF   A5 00                  LDA   IP   
E0D1   99 00 04               STA   LET,Y   
E0D4   A5 01                  LDA   IP+1   
E0D6   99 01 04               STA   LET+1,Y   
E0D9   D0 03                  BNE   skdef   ; always: no program is in page zero
E0DB   20 89 E0     DEF2:     JSR   puship   ; an anonymous block: push its address
E0DE                SKDEF:       
E0DE                          IF   CHECKED   
                              LDA   #")"   ; the wrong closer for [
E0DE                          ENDIF      
E0DE                             ; skip: read past text to the closer at this level, and return it in A.
E0DE                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0DE                             ; NUL first ends the program.
E0DE                             ; In the checked build A holds, on the way in, the wrong closer for the
E0DE                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E0DE                             ; which takes either. Meeting the wrong closer at this level, or the end
E0DE                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E0DE                             ; which then ends the program as before.
E0DE                SKIP:        
E0DE                          IF   CHECKED   
                              STA   T0   
E0DE                          ENDIF      
E0DE   A9 00                  LDA   #0   
E0E0   85 06                  STA   T2   ; depth
E0E2   20 96 E1     SK1:      JSR   getc   
E0E5                          IF   1-CHECKED   
E0E5   F0 8D                  BEQ   endprog   
E0E7                          ENDIF      
E0E7                          IF   CHECKED   
                              BEQ   sknul   
E0E7                          ENDIF      
E0E7   C9 22                  CMP   #22h   
E0E9   D0 03                  BNE   sk2   
E0EB   20 0A E1               JSR   skipstr   ; leaves A = 22h (11h when checked), which
E0EE                             ;   matches nothing below
E0EE                          IF   CHECKED   
                              BEQ   sknul   ; the string ran into the end
E0EE                          ENDIF      
E0EE   C9 28        SK2:      CMP   #"("   
E0F0   F0 11                  BEQ   sk3   
E0F2   C9 5B                  CMP   #"["   
E0F4   F0 0D                  BEQ   sk3   
E0F6   C9 29                  CMP   #")"   
E0F8   F0 04                  BEQ   sk4   
E0FA   C9 5D                  CMP   #"]"   
E0FC   D0 E4                  BNE   sk1   
E0FE   C6 06        SK4:      DEC   T2   
E100   10 E0                  BPL   sk1   
E102                          IF   CHECKED   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
E102                          ENDIF      
E102   60                     RTS      ; the closer at this level
E103   E6 06        SK3:      INC   T2   
E105   D0 DB                  BNE   sk1   
E107                          IF   CHECKED   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                              DB   2Ch   ;   or the end: the place is the opener
                    E_QUOTE:   LDA   #"Q"   ; a string from 22h runs into the end
                              JMP   error   
E107                          ENDIF      
E107                             ; 22h pushes the address of the text after it and skips the string.
E107   20 89 E0     H_STR:    JSR   puship   
E10A                          IF   CHECKED   
                              JSR   skipstr   
                              BEQ   e_quote   ; it ran into the end: the place is the 22h
                              RTS      
E10A                          ENDIF      
E10A                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E10A                             ; the next character, so "/"" does not end it.
E10A                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E10A                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E10A                             ; text ended first (a NUL, also one just after "/").
E10A                          IF   1-CHECKED   
E10A   20 96 E1     SKIPSTR:   JSR   getc   
E10D   C9 2F                  CMP   #"/"   
E10F   F0 05                  BEQ   ss0   
E111   C9 22                  CMP   #22h   
E113   D0 F5                  BNE   skipstr   
E115   60                     RTS      
E116   20 99 E1     SS0:      JSR   incip   
E119   D0 EF                  BNE   skipstr   ; A is "/" here
E11B                          ENDIF      
E11B                          IF   CHECKED   
                    SKIPSTR:   JSR   getc   
                              BEQ   ss9   ; the end
                              CMP   #"/"   
                              BNE   ss1   
                              JSR   getc   ; the escaped character
                              BNE   skipstr   
                    SS9:      RTS      ; the end, just after "/"
                    SS1:      CMP   #22h   
                              BNE   skipstr   
                              LSR      ; A = 11h, Z clear
                              RTS      
E11B                          ENDIF      
E11B                             ; =============================================================================
E11B                             ;  Dispatch table: one handler per punctuation character, in code order.
E11B                             ;  Entries are handler-1 for the RTS trick.
E11B                             ; =============================================================================
E11B   B3 E1        PTAB:     DW   h_store-1   ; !
E11D   06 E1                  DW   h_str-1   ; "
E11F   82 E3                  DW   h_num-1   ; #
E121   64 E3                  DW   h_print-1   ; $
E123   BF E2                  DW   h_swap-1   ; %
E125   14 E2                  DW   h_and-1   ; &
E127   7A E3                  DW   h_emit-1   ; '
E129   A2 E0                  DW   h_open-1   ; (
E12B   E9 E1                  DW   h_close-1   ; )
E12D   97 E2                  DW   h_mul-1   ; *
E12F   46 E2                  DW   h_add-1   ; +
E131   BD E3                  DW   h_cfetch-1   ; ,
E133   3E E2                  DW   h_sub-1   ; -
E135   BA E1                  DW   h_cstore-1   ; .
E137   D4 E2                  DW   h_div-1   ; /
E139   96 E0                  DW   push-1   ; :
E13B   C2 E1                  DW   drop-1   ; ;
E13D   75 E2                  DW   h_lt-1   ; <
E13F   87 E2                  DW   h_eq-1   ; =
E141   72 E2                  DW   h_gt-1   ; >
E143   C6 E3                  DW   h_key-1   ; ?
E145   B1 E3                  DW   h_fetch-1   ; @
E147   BE E0                  DW   h_def-1   ; [
E149   01 E2                  DW   h_break-1   ; \
E14B   EF E1                  DW   h_ret-1   ; ]
E14D   30 E2                  DW   h_xor-1   ; ^
E14F   42 E3                  DW   h_alloc-1   ; _
E151   27 E4                  DW   h_grave-1   ; `
E153   CE E1                  DW   h_tor-1   ; {
E155   22 E2                  DW   h_or-1   ; |
E157   DB E1                  DW   h_fromr-1   ; }
E159   5E E2                  DW   h_not-1   ; ~
E15B                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E15B                             ; test is at the bottom so the loop closes with a branch. Returns with the
E15B                             ; carry set.
E15B   20 99 E1     RD1:      JSR   incip   ; (keeps A = the digit)
E15E   06 02                  ASL   TL   
E160   26 03                  ROL   TH   ; x2
E162   18                     CLC      
E163   65 02                  ADC   TL   
E165   85 04                  STA   T0   
E167   A5 03                  LDA   TH   
E169   69 00                  ADC   #0   
E16B   85 05                  STA   T1   ; T = x2 + digit
E16D   06 02                  ASL   TL   
E16F   26 03                  ROL   TH   
E171   06 02                  ASL   TL   
E173   26 03                  ROL   TH   ; x8
E175   18                     CLC      
E176   A5 02                  LDA   TL   
E178   65 04                  ADC   T0   
E17A   85 02                  STA   TL   
E17C   A5 03                  LDA   TH   
E17E   65 05                  ADC   T1   
E180   85 03                  STA   TH   ; x8 + x2 + digit
E182   20 88 E1     RDNUM:    JSR   isdig   
E185   90 D4                  BCC   rd1   
E187   60                     RTS      
E188                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E188                             ; digit. Y = 0.
E188   20 91 E1     ISDIG:    JSR   peek   
E18B   38                     SEC      
E18C   E9 30                  SBC   #"0"   
E18E   C9 0A                  CMP   #10   
E190   60                     RTS      
E191                             ; =============================================================================
E191                             ;  Reading the program
E191                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E191                             ;    getc: the same, then IP moves on; flags follow A
E191                             ;    incip: IP moves on; keeps A, the carry and Y
E191                             ; =============================================================================
E191   A0 00        PEEK:     LDY   #0   
E193   B1 00                  LDA   (IP),Y   
E195   60                     RTS      
E196   20 91 E1     GETC:     JSR   peek   
E199   E6 00        INCIP:    INC   IP   
E19B   D0 02                  BNE   ic1   
E19D   E6 01                  INC   IP+1   
E19F   09 00        IC1:      ORA   #0   
E1A1   60                     RTS      
E1A2                             ; rstip: point IP at the start of the program
E1A2   A9 00        RSTIP:    LDA   #<PROG   
E1A4   85 00                  STA   IP   
E1A6   A9 05                  LDA   #>PROG   
E1A8   85 01                  STA   IP+1   
E1AA   60                     RTS      
E1AB                             ; =============================================================================
E1AB                             ;  Stack
E1AB                             ; =============================================================================
E1AB                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E1AB   A5 02        FLAG:     LDA   TL   
E1AD   05 03                  ORA   TH   
E1AF   20 C3 E1               JSR   drop   
E1B2   A8                     TAY      ; (drop's INX changed the flags)
E1B3   60                     RTS      
E1B4                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E1B4                H_STORE:      
E1B4                          IF   CHECKED   
                              LDA   TL   ; both bytes must be in the program's space:
                              ADC   #1   ; check the page of addr+1 (the carry is
                              LDA   TH   ; clear on the way in)
                              ADC   #0   
                              JSR   chkst   
E1B4                          ENDIF      
E1B4   BD 00 03               LDA   DSH,X   
E1B7   A0 01                  LDY   #1   
E1B9   91 02                  STA   (TL),Y   
E1BB                H_CSTORE:      ; "." ( c addr -- )
E1BB                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E1BB                          ENDIF      
E1BB   BD 00 02               LDA   DSL,X   
E1BE   A0 00                  LDY   #0   
E1C0   91 02                  STA   (TL),Y   
E1C2   E8                     INX      ; falls into drop
E1C3                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E1C3                             ; it returns with Z clear.
E1C3   BC 00 02     DROP:     LDY   DSL,X   
E1C6   84 02                  STY   TL   
E1C8   BC 00 03               LDY   DSH,X   
E1CB   84 03                  STY   TH   
E1CD   E8                     INX      
E1CE   60                     RTS      
E1CF                             ; "{" TOS to the return stack, "}" return stack to TOS
E1CF   68           H_TOR:    PLA      
E1D0   68                     PLA      
E1D1   A5 03                  LDA   TH   
E1D3   48                     PHA      
E1D4   A5 02                  LDA   TL   
E1D6   48                     PHA      
E1D7   20 C3 E1               JSR   drop   
E1DA   D0 0B                  BNE   nxt2   ; always
E1DC   68           H_FROMR:   PLA      
E1DD   68                     PLA      
E1DE   20 97 E0               JSR   push   
E1E1   68                     PLA      
E1E2   85 02                  STA   TL   
E1E4   68                     PLA      
E1E5   85 03                  STA   TH   
E1E7   4C 33 E0     NXT2:     JMP   next   
E1EA                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E1EA                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E1EA                             ; it is here, the address popped is pushed back.
E1EA   20 AB E1     H_CLOSE:   JSR   flag   
E1ED   F0 1F                  BEQ   rdrop   
E1EF   24                     DB   24h   ; (BIT zp: steps over the SEC)
E1F0                             ; "]" returns: pull an address and jump to it.
E1F0   38           H_RET:    SEC      
E1F1   68                     PLA      
E1F2   68                     PLA      ; drop the step frame
E1F3   68                     PLA      
E1F4   85 00                  STA   IP   
E1F6   68                     PLA      
E1F7   85 01                  STA   IP+1   
E1F9   B0 EC                  BCS   nxt2   
E1FB   48                     PHA      ; ")": keep the block start
E1FC   A5 00                  LDA   IP   
E1FE   48                     PHA      
E1FF   4C 20 E0               JMP   pnext   ; a loop-back: the break check
E202                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E202                             ; drops the block start, "]" returns.
E202   20 AB E1     H_BREAK:   JSR   flag   
E205   F0 6B                  BEQ   ab9   
E207                          IF   CHECKED   
                              LDA   #0   ; \ takes either closer
E207                          ENDIF      
E207   20 DE E0               JSR   skip   
E20A   C9 29                  CMP   #")"   
E20C   D0 E2                  BNE   h_ret   
E20E   68           RDROP:    PLA      
E20F   68                     PLA      
E210   68                     PLA      
E211   68                     PLA      
E212   4C 33 E0               JMP   next   
E215                             ; =============================================================================
E215                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E215                             ; =============================================================================
E215                             ; The logic operators leave the carry as they found it, clear, so they can
E215                             ; branch to fin.
E215   BD 00 02     H_AND:    LDA   DSL,X   
E218   25 02                  AND   TL   
E21A   85 02                  STA   TL   
E21C   BD 00 03               LDA   DSH,X   
E21F   25 03                  AND   TH   
E221   90 31                  BCC   fin   ; always
E223   BD 00 02     H_OR:     LDA   DSL,X   
E226   05 02                  ORA   TL   
E228   85 02                  STA   TL   
E22A   BD 00 03               LDA   DSH,X   
E22D   05 03                  ORA   TH   
E22F   90 23                  BCC   fin   ; always
E231   BD 00 02     H_XOR:    LDA   DSL,X   
E234   45 02                  EOR   TL   
E236   85 02                  STA   TL   
E238   BD 00 03               LDA   DSH,X   
E23B   45 03                  EOR   TH   
E23D   90 15                  BCC   fin   ; always
E23F                             ; "-" has two jobs: directly before a digit it starts a negative number.
E23F   20 88 E1     H_SUB:    JSR   isdig   
E242   90 14                  BCC   negnum   
E244   20 65 E2     SUB1:     JSR   neg   ; a - b = a + (-b)
E247   18           H_ADD:    CLC      
E248   BD 00 02               LDA   DSL,X   
E24B   65 02                  ADC   TL   
E24D   85 02                  STA   TL   
E24F   BD 00 03               LDA   DSH,X   
E252   65 03                  ADC   TH   ; falls into fin
E254                             ; fin: finish a two-operand op: A = the high byte of the result
E254   85 03        FIN:      STA   TH   
E256   E8                     INX      
E257   60                     RTS      
E258   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E25A   20 7C E0               JSR   digit   ; (comes back with the carry set)
E25D   B0 06                  BCS   neg   ; always: the number, negated
E25F                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E25F   90 05        H_NOT:    BCC   neg1   ; always
E261                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E261   A5 03        ABSV:     LDA   TH   
E263   10 0D        NEGM:     BPL   ab9   
E265                             ; neg: TOS = -TOS
E265   38           NEG:      SEC      
E266   A9 00        NEG1:     LDA   #0   
E268   E5 02                  SBC   TL   
E26A   85 02                  STA   TL   
E26C   A9 00                  LDA   #0   
E26E   E5 03                  SBC   TH   
E270   85 03                  STA   TH   
E272   60           AB9:      RTS      
E273                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E273                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E273   20 C0 E2     H_GT:     JSR   h_swap   ; a > b is b < a
E276   BD 00 02     H_LT:     LDA   DSL,X   
E279   C5 02                  CMP   TL   
E27B   BD 00 03               LDA   DSH,X   
E27E   E5 03                  SBC   TH   
E280   70 02                  BVS   lt1   
E282   49 80                  EOR   #80h   
E284   0A           LT1:      ASL      
E285   E8                     INX      ; (keeps the carry; never leaves X at 0)
E286   D0 07                  BNE   bool   ; always
E288   20 44 E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E28B   05 02                  ORA   TL   
E28D   C9 01                  CMP   #1   ; carry clear if A = 0
E28F   A9 00        BOOL:     LDA   #0   
E291   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E293   85 02                  STA   TL   
E295   85 03                  STA   TH   
E297   60                     RTS      
E298                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E298                             ; bottom while the product comes in at the top, through A:T0 above it; after
E298                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E298   A0 10        H_MUL:    LDY   #16   
E29A   84 05                  STY   T1   ; the round count
E29C   A9 00                  LDA   #0   
E29E   85 04                  STA   T0   ; A:T0 = the upper half
E2A0   46 03                  LSR   TH   
E2A2   66 02                  ROR   TL   ; the first multiplier bit
E2A4   90 0D        ML1:      BCC   ml2   
E2A6   A8                     TAY      
E2A7   18                     CLC      
E2A8   A5 04                  LDA   T0   
E2AA   7D 00 02               ADC   DSL,X   
E2AD   85 04                  STA   T0   
E2AF   98                     TYA      
E2B0   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E2B3   6A           ML2:      ROR      
E2B4   66 04                  ROR   T0   
E2B6   66 03                  ROR   TH   
E2B8   66 02                  ROR   TL   ; everything one place right; next bit out
E2BA   C6 05                  DEC   T1   
E2BC   D0 E6                  BNE   ml1   
E2BE   E8                     INX      ; drop the multiplicand
E2BF   60                     RTS      
E2C0   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E2C3   A5 02                  LDA   TL   
E2C5   9D 00 02               STA   DSL,X   
E2C8   84 02                  STY   TL   
E2CA   BC 00 03               LDY   DSH,X   
E2CD   A5 03                  LDA   TH   
E2CF   9D 00 03               STA   DSH,X   
E2D2   84 03                  STY   TH   
E2D4   60                     RTS      
E2D5                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E2D5                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E2D5                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E2D5                             ; it stops with Z.
E2D5                          IF   CHECKED   
                    E_ZERO:   LDA   #"Z"   ; divide by zero, the stack as it was
                              JMP   error   
E2D5                          ENDIF      
E2D5                H_DIV:       
E2D5                          IF   CHECKED   
                              LDA   TL   
                              ORA   TH   
                              BEQ   e_zero   
E2D5                          ENDIF      
E2D5   BD 00 03               LDA   DSH,X   
E2D8   48                     PHA      ; a's sign: for r
E2D9   45 03                  EOR   TH   
E2DB   48                     PHA      ; a xor b: for q
E2DC   20 61 E2               JSR   absv   
E2DF   A5 02                  LDA   TL   
E2E1   85 08                  STA   D0   
E2E3   A5 03                  LDA   TH   
E2E5   85 09                  STA   D1   ; D = |b|
E2E7   BD 00 02               LDA   DSL,X   
E2EA   85 02                  STA   TL   
E2EC   BD 00 03               LDA   DSH,X   
E2EF   85 03                  STA   TH   
E2F1   20 61 E2               JSR   absv   ; TOS = |a|
E2F4   20 02 E3               JSR   udiv   ; TOS = q, NOS = r
E2F7   68                     PLA      
E2F8   20 63 E2               JSR   negm   ; q's sign
E2FB   20 C0 E2               JSR   h_swap   ; r on top
E2FE   68                     PLA      
E2FF   4C 63 E2               JMP   negm   ; r's sign
E302                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E302                             ; cell the remainder (whatever was there is lost).
E302                             ; Dividing by 2 is one shift (the spec wants that fast).
E302   A9 00        UDIV:     LDA   #0   
E304   9D 00 02               STA   DSL,X   
E307   9D 00 03               STA   DSH,X   
E30A   A5 08                  LDA   D0   
E30C   49 02                  EOR   #2   
E30E   05 09                  ORA   D1   
E310   D0 08                  BNE   ud0   
E312   46 03                  LSR   TH   
E314   66 02                  ROR   TL   ; the quotient
E316   3E 00 02               ROL   DSL,X   ; the remainder: the bit that fell out
E319   60                     RTS      
E31A   A0 10        UD0:      LDY   #16   
E31C   06 02        UD1:      ASL   TL   
E31E   26 03                  ROL   TH   
E320   3E 00 02               ROL   DSL,X   
E323   3E 00 03               ROL   DSH,X   
E326   38                     SEC      
E327   BD 00 02               LDA   DSL,X   
E32A   E5 08                  SBC   D0   
E32C   85 04                  STA   T0   
E32E   BD 00 03               LDA   DSH,X   
E331   E5 09                  SBC   D1   
E333   90 0A                  BCC   ud2   
E335   9D 00 03               STA   DSH,X   
E338   A5 04                  LDA   T0   
E33A   9D 00 02               STA   DSL,X   
E33D   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E33F   88           UD2:      DEY      
E340   D0 DA                  BNE   ud1   
E342   60           UD9:      RTS      
E343                             ; =============================================================================
E343                             ;  Storage
E343                             ; =============================================================================
E343                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E343                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E343                          IF   1-CHECKED   
E343   AD 7C 04     H_ALLOC:   LDA   HEAP   
E346   A8                     TAY      
E347   65 02                  ADC   TL   
E349   8D 7C 04               STA   HEAP   
E34C   84 02                  STY   TL   
E34E   AD 7D 04               LDA   HEAP+1   
E351   A8                     TAY      
E352   65 03                  ADC   TH   
E354   8D 7D 04               STA   HEAP+1   
E357   84 03                  STY   TH   
E359   60                     RTS      
E35A                          ENDIF      
E35A                             ; The checked build works the new top out first, in T0 and Y, and stops with
E35A                             ; H, the count still on the stack, if it is at or past the limit, below the
E35A                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E35A                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E35A                             ; a signed number from -8000h, so the add overflows exactly when the true
E35A                             ; sum leaves 0000h-FFFFh.
E35A                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   TL   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   TH   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   TL   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   TH   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the page in A is in the program's own space, from the
                                 ; letter page up to the heap limit. Keeps Y.
                    CHKST:    CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              RTS      
E35A                          ENDIF      
E35A                             ; =============================================================================
E35A                             ;  Console
E35A                             ; =============================================================================
E35A                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E35A   A0 00        TOSGET:   LDY   #0   
E35C   B1 02                  LDA   (TL),Y   
E35E   E6 02        INCTOS:   INC   TL   
E360   D0 02                  BNE   tg1   
E362   E6 03                  INC   TH   
E364   60           TG1:      RTS      
E365                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E365                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E365                             ; bit 6, so // and /" give themselves).
E365                             ; The checked build walks a copy of TOS along the string, so that the address
E365                             ; is still there if it stops with Q on a NUL.
E365                H_PRINT:      
E365                          IF   CHECKED   
                              JSR   push   ; the copy
                              JSR   pr0   
                              JMP   drop   
                    PR0:         
E365                          ENDIF      
E365   20 5A E3               JSR   tosget   
E368   C9 22                  CMP   #22h   
E36A   F0 14                  BEQ   pdrop   
E36C                          IF   CHECKED   
                              CMP   #0   
                              BEQ   e_qpr   
E36C                          ENDIF      
E36C   C9 2F                  CMP   #"/"   
E36E   D0 05                  BNE   pr1   
E370   20 5A E3               JSR   tosget   
E373   29 BF                  AND   #0BFh   
E375   20 03 FF     PR1:      JSR   CONOUT   
E378                          IF   1-CHECKED   
E378   4C 65 E3               JMP   h_print   
E37B                          ENDIF      
E37B                          IF   CHECKED   
                              JMP   pr0   
                    E_QPR:    JSR   drop   ; the copy goes: the address is TOS again
                              LDA   #"Q"   ; $ ran into the end
                              JMP   error   
E37B                          ENDIF      
E37B   A5 02        H_EMIT:   LDA   TL   ; "'"
E37D   20 03 FF               JSR   CONOUT   
E380   4C C3 E1     PDROP:    JMP   drop   
E383                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E383                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E383                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E383   A5 03        H_NUM:    LDA   TH   
E385   10 08                  BPL   pn1   
E387   A9 2D                  LDA   #"-"   
E389   20 03 FF               JSR   CONOUT   
E38C   20 65 E2               JSR   neg   
E38F   CA           PN1:      DEX      ; the spare cell
E390   A9 0A                  LDA   #10   
E392   85 08                  STA   D0   
E394   A9 00                  LDA   #0   
E396   85 09                  STA   D1   
E398   48                     PHA      ; the end marker
E399   20 02 E3     PN2:      JSR   udiv   
E39C   BD 00 02               LDA   DSL,X   
E39F   09 30                  ORA   #"0"   
E3A1   48                     PHA      
E3A2   A5 02                  LDA   TL   
E3A4   05 03                  ORA   TH   
E3A6   D0 F1                  BNE   pn2   
E3A8   E8                     INX      
E3A9   68           PN3:      PLA      
E3AA   F0 D4                  BEQ   pdrop   
E3AC   20 03 FF               JSR   CONOUT   
E3AF   4C A9 E3               JMP   pn3   
E3B2   A0 01        H_FETCH:   LDY   #1   ; "@"
E3B4   B1 02                  LDA   (TL),Y   
E3B6   48                     PHA      ; the high byte, while "," gets the low one
E3B7   20 BE E3               JSR   h_cfetch   
E3BA   68                     PLA      
E3BB   85 03                  STA   TH   
E3BD   60                     RTS      
E3BE                H_CFETCH:      ; ","
E3BE   A0 00                  LDY   #0   
E3C0   B1 02                  LDA   (TL),Y   
E3C2   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E3C4   84 03                  STY   TH   
E3C6   60                     RTS      
E3C7                             ; "?" ( n -- c ) or ( -n -- addr )
E3C7                             ;   n > 0: wait about n ms for a key; 0 if none came
E3C7                             ;   n = 0: wait for a key
E3C7                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E3C7                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E3C7   A5 03        H_KEY:    LDA   TH   
E3C9   30 20                  BMI   line   
E3CB   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E3CD   20 6A E4     KT2:      JSR   getk   
E3D0   D0 15                  BNE   kt3   
E3D2   88                     DEY      
E3D3   D0 F8                  BNE   kt2   
E3D5   A5 02                  LDA   TL   ; count the millisecond off:
E3D7   D0 06                  BNE   kt4   
E3D9   A5 03                  LDA   TH   
E3DB   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E3DD   C6 03                  DEC   TH   
E3DF   C6 02        KT4:      DEC   TL   
E3E1   D0 E8                  BNE   kt1   
E3E3   A5 03                  LDA   TH   
E3E5   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E3E7   A0 00        KT3:      LDY   #0   
E3E9   F0 D7                  BEQ   cf2   ; always: TOS = A
E3EB                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E3EB                             ; (stored, not echoed), every other key is stored and echoed until the line
E3EB                             ; is full. Y = the length so far; TL = the most allowed.
E3EB   20 65 E2     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E3EE   D0 04                  BNE   ln0   
E3F0   A5 02                  LDA   TL   
E3F2   10 04                  BPL   ln1   
E3F4   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E3F6   85 02                  STA   TL   
E3F8   A0 00        LN1:      LDY   #0   
E3FA   F0 03                  BEQ   ln2   ; always
E3FC   20 03 FF     LN3:      JSR   CONOUT   
E3FF   20 6A E4     LN2:      JSR   getk   
E402   F0 FB                  BEQ   ln2   
E404   C9 0D                  CMP   #13   
E406   F0 14                  BEQ   ln5   
E408   C9 08                  CMP   #8   
E40A   F0 0A                  BEQ   ln4   
E40C   C4 02                  CPY   TL   
E40E   B0 EF                  BCS   ln2   ; full
E410   99 80 04               STA   LINEBUF,Y   
E413   C8                     INY      
E414   D0 E6                  BNE   ln3   ; always: echo it
E416   88           LN4:      DEY      ; Backspace: one back, and echo it,
E417   10 E3                  BPL   ln3   
E419   C8                     INY      ;   unless the line was empty
E41A   F0 E3                  BEQ   ln2   ; always
E41C   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E41F   A9 80                  LDA   #<LINEBUF   
E421   85 02                  STA   TL   
E423   A9 04                  LDA   #>LINEBUF   
E425   85 03                  STA   TH   
E427   60                     RTS      
E428                             ; =============================================================================
E428                             ;  Machine code: the grave
E428                             ; =============================================================================
E428                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E428                             ; are stored from addr until a non-hex character; then a RET (60h) is
E428                             ; written and its address is left. An odd last digit is consumed and dropped.
E428                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E428                             ; contract in the header.
E428   20 57 E4     H_GRAVE:   JSR   rdhex   
E42B   B0 1C                  BCS   exec   
E42D   0A           HX1:      ASL      
E42E   0A                     ASL      
E42F   0A                     ASL      
E430   0A                     ASL      
E431   85 04                  STA   T0   
E433   20 57 E4               JSR   rdhex   
E436   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E438   05 04                  ORA   T0   
E43A   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
E43C   20 5E E3               JSR   inctos   
E43F   20 57 E4               JSR   rdhex   
E442   90 E9                  BCC   hx1   
E444   A9 60        HX2:      LDA   #60h   
E446   91 02                  STA   (TL),Y   
E448   60                     RTS      
E449   A5 02        EXEC:     LDA   TL   
E44B   85 04                  STA   T0   
E44D   A5 03                  LDA   TH   
E44F   85 05                  STA   T1   
E451   20 C3 E1               JSR   drop   ; the address is consumed
E454   6C 04 00               JMP   (T0)   
E457                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E457                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E457                             ; Y = 0.
E457   20 88 E1     RDHEX:    JSR   isdig   
E45A   90 0A                  BCC   rh1   
E45C   29 DF                  AND   #0DFh   
E45E   E9 11                  SBC   #11h   ; (the carry is set)
E460   C9 06                  CMP   #6   
E462   B0 05                  BCS   rh9   
E464   69 0A                  ADC   #10   
E466   4C 99 E1     RH1:      JMP   incip   
E469   60           RH9:      RTS      
E46A                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E46A                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E46A                             ; taken out of KEYBUF.
E46A   AD 7A 04     GETK:     LDA   KEYBUF   
E46D   F0 08                  BEQ   gk1   
E46F   48                     PHA      
E470   A9 00                  LDA   #0   
E472   8D 7A 04               STA   KEYBUF   
E475   68                     PLA      
E476   60                     RTS      
E477   20 06 FF     GK1:      JSR   KEY   
E47A   F0 04                  BEQ   gk9   
E47C   C9 03                  CMP   #3   
E47E   F0 01                  BEQ   ctlc   ; Ctrl-C: ctlc gives the 03h back, if at all
E480   60           GK9:      RTS      
E481                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E481                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E481                             ; looks: D0 counts the 256s, D1 runs on from whatever it holds) for one more
E481                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E481                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E481   AD 7B 04     CTLC:     LDA   BRKOFF   
E484   F0 1D                  BEQ   cbreak   
E486   A9 28                  LDA   #CWAIT+1   
E488   85 08                  STA   D0   
E48A   20 06 FF     CT2:      JSR   KEY   
E48D   D0 0A                  BNE   ct3   
E48F   C6 09                  DEC   D1   
E491   D0 F7                  BNE   ct2   
E493   C6 08                  DEC   D0   
E495   D0 F3                  BNE   ct2   
E497   F0 07                  BEQ   ct9   ; always: none came
E499   C9 03        CT3:      CMP   #3   
E49B   F0 06                  BEQ   cbreak   
E49D   8D 7A 04               STA   KEYBUF   
E4A0   A9 03        CT9:      LDA   #3   
E4A2   60                     RTS      
E4A3                          IF   1-CHECKED   
E4A3   4C 09 FF     CBREAK:   JMP   EXIT   ; the unchecked build stops without a word
E4A6                          ENDIF      
E4A6                          IF   CHECKED   
                    CBREAK:      ; the checked build reports B, the stacks as
                    E_BREAK:   LDA   #"B"   ;   they stand (it falls into error)
E4A6                          ENDIF      
E4A6                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
                                 ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   Rtn n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was.
                    ERROR:    PHA      ; the letter
                              LDA   PLACE   
                              STA   P   
                              LDA   PLACE+1   
                              STA   P+1   
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   D0   
                              LDY   D1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   T1   
                              LDY   T2   
                              JSR   prnum   ; the column
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              LDY   #0   ; the text at the place
                    ER1:      LDA   (P),Y   
                              BEQ   er2   
                              CMP   #13   
                              BEQ   er2   
                              CMP   #10   
                              BEQ   er2   
                              JSR   CONOUT   
                              INY      
                              CPY   #16   
                              BNE   er1   
                    ER2:      LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "Stk "
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
                              PHA      
                              LDY   #0   
                              JSR   prnum   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T1   ; T1 = how many cells to show
                              JSR   prs   
                              JSR   push   ; TOS into memory with the rest: cell i from
                                 ;   the top is at DSL+X+i now
                    ER4:      LDA   T1   ; cells T1-1 down to 0, the top last
                              BEQ   er5   
                              DEC   T1   
                              LDA   #" "   
                              JSR   CONOUT   
                              TXA      
                              CLC      
                              ADC   T1   
                              TAY      
                              LDA   DSL,Y   
                              PHA      
                              LDA   DSH,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "Rtn "
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              LDY   #0   
                              JSR   prnum   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"Stk"," "+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"Rtn"," "+80h   
                                 ; lcol: the line (D0/D1) and the column (T1/T2) of the place at P, both from
                                 ; 1. A place below the program is in the -n? line buffer: line 0, and the
                                 ; column is the place in the buffer. Otherwise the LFs before the place are
                                 ; counted from PROG; T1/T2 holds the address before the line's first
                                 ; character (the last LF, or PROG - 1), and the column is P minus that.
                    LCOL:     LDY   #0   
                              STY   D1   
                              STY   D0   
                              LDA   #<LBM1   
                              STA   T1   
                              LDA   #>LBM1   
                              STA   T2   
                              LDA   P   
                              CMP   #<PROG   
                              LDA   P+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   D0   
                              LDA   #<PROGM1   
                              STA   Q   
                              STA   T1   
                              LDA   #>PROGM1   
                              STA   Q+1   
                              STA   T2   
                    LC1:      INC   Q   ; the next character
                              BNE   lc2   
                              INC   Q+1   
                    LC2:      LDA   Q   
                              CMP   P   
                              LDA   Q+1   
                              SBC   P+1   
                              BCS   lc9   ; at the place
                              LDA   (Q),Y   
                              CMP   #10   
                              BNE   lc1   
                              INC   D0   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   D1   
                    LC3:      LDA   Q   
                              STA   T1   
                              LDA   Q+1   
                              STA   T2   
                              BNE   lc1   ; always: no program is in page zero
                    LC9:      LDA   P   
                              SEC      
                              SBC   T1   
                              STA   T1   
                              LDA   P+1   
                              SBC   T2   
                              STA   T2   
                              RTS      
E4A6                          ENDIF      


