   560 00000110 74F8                <1>         jz      nx
   561 00000112 E8CD040000          <1>         call    skip
   562 00000117 84C0                <1>         test    al,al                   ; skip returns 0 for ')'
   563 00000119 75EC                <1>         jnz     h_ret
   564 0000011B EBEC                <1>         jmp     rdrop
   565                              <1> 
   566                              <1> ; ')' ( flag -- ): true jumps back to the block start (and keeps it); false
   567                              <1> ; drops it and carries on. The loop-back looks at the break key.
   568 0000011D 6685DB              <1> h_close:test    bx,bx
   569 00000120 5B                  <1>         pop     ebx
   570 00000121 74E6                <1>         jz      rdrop
