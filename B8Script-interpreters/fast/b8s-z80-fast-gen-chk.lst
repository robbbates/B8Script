02E3   ED 52                  SBC   HL,DE   
02E5   30 02                  JR   NC,uvr3   
02E7   19                     ADD   HL,DE   
02E8   0D                     DEC   C   
02E9   0C           UVR3:     INC   C   
02EA   CB 21                  SLA   C   
02EC   17                     RLA      
02ED   ED 6A                  ADC   HL,HL   
02EF   ED 52                  SBC   HL,DE   
02F1   30 02                  JR   NC,uvr4   
02F3   19                     ADD   HL,DE   
02F4   0D                     DEC   C   
02F5   0C           UVR4:     INC   C   
02F6   CB 21                  SLA   C   
02F8   17                     RLA      
02F9   ED 6A                  ADC   HL,HL   
02FB   ED 52                  SBC   HL,DE   
02FD   30 02                  JR   NC,uvr5   
02FF   19                     ADD   HL,DE   
0300   0D                     DEC   C   
0301   0C           UVR5:     INC   C   
0302   CB 21                  SLA   C   
0304   17                     RLA      
0305   ED 6A                  ADC   HL,HL   
0307   ED 52                  SBC   HL,DE   
0309   30 02                  JR   NC,uvr6   
030B   19                     ADD   HL,DE   
030C   0D                     DEC   C   
030D   0C           UVR6:     INC   C   
030E   CB 21                  SLA   C   
0310   17                     RLA      
0311   ED 6A                  ADC   HL,HL   
0313   ED 52                  SBC   HL,DE   
0315   30 02                  JR   NC,uvr7   
0317   19                     ADD   HL,DE   
0318   0D                     DEC   C   
0319   0C           UVR7:     INC   C   
031A   CB 21                  SLA   C   
031C   17                     RLA      
031D   ED 6A                  ADC   HL,HL   
031F   ED 52                  SBC   HL,DE   
0321   30 02                  JR   NC,uvr8   
0323   19                     ADD   HL,DE   
0324   0D                     DEC   C   
0325   0C           UVR8:     INC   C   
0326   CB 21                  SLA   C   
0328   17                     RLA      
