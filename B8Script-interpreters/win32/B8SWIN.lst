  1182 0000043D 8D4C240C            <1>         lea     ecx,[esp+12]
  1183 00000441 8D54241C            <1>         lea     edx,[esp+28]
  1184 00000445 6A00                <1>         push    0                       ; lpOverlapped
  1185 00000447 51                  <1>         push    ecx                     ; lpNumberOfBytesWritten
  1186 00000448 6A01                <1>         push    1
  1187 0000044A 52                  <1>         push    edx
  1188 0000044B FF755B              <1>         push    dword [V(v_outh)]
  1189 0000044E FF55A5              <1>         call    [V(iat_WriteFile)]
  1190 00000451 61                  <1>         popad
