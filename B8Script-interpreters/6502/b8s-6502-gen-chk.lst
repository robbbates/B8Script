0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  Two builds, set in the two EQU lines below:
0000                             ;    CPM      always 0 (there is no CP/M here; the line exists for build.sh)
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0: no CP/M build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its two pages because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is $0200,X (low) and $0300,X (high). To push:
0000                             ;  DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load TL/TH from
0000                             ;  DSL,X/DSH,X and INX. The code may change A, Y, X (it is the stack index, so
0000                             ;  it must stay consistent on return) and zero page $04-$06 and $08-$0B; it
0000                             ;  must keep IP ($00/$01) and the hardware stack balanced. On return TL/TH are
0000                             ;  the TOS. Zero page $0C-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                R0:       EQU   0Ah   ; remainder
0000                R1:       EQU   0Bh   
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page (above)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL  data stack, low bytes   (X = FC when empty: 252 cells)
0000                             ;    0300       DSH  data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C
0000                             ;               (= z10+), KEYBUF at +34, the -n? line buffer at +80..+FF
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                CONIN:    EQU   0FF00h   ; wait for a key, return it in A
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                CONST:    EQU   0FF06h   ; A = 0 if no key is waiting, else nonzero
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   All three console routines must preserve X and Y.
0000                DSL:      EQU   0200h   
0000                DSH:      EQU   0300h   
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                CAP:      EQU   127   ; -n? reads at most this many characters
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003   A9 00                  LDA   #<PROG   
E005   85 00                  STA   IP   
E007   A9 05                  LDA   #>PROG   
E009   85 01                  STA   IP+1   
E00B   20 6E E1     ST1:      JSR   getc   
E00E   D0 FB                  BNE   st1   ; IP ends just past the NUL
E010   A5 00                  LDA   IP   
E012   8D 7C 04               STA   HEAP   
E015   A5 01                  LDA   IP+1   
E017   8D 7D 04               STA   HEAP+1   
E01A                          IF   CHECKED   
E01A   A9 00                  LDA   #0   
E01C   8D 34 04               STA   KEYBUF   
E01F                          ENDIF      
E01F   A9 00                  LDA   #<PROG   
E021   85 00                  STA   IP   
E023   A9 05                  LDA   #>PROG   
E025   85 01                  STA   IP+1   
E027   A2 FC                  LDX   #DSE   
E029                             ; =============================================================================
E029                             ;  The inner loop
E029                             ; =============================================================================
E029                NEXT:        
E029                          IF   CHECKED   
E029                             ; Both stacks are checked once per character. The data stack has
E029                             ; overrun when X is above DSE (an overflow wraps X to FF, an underflow
E029                             ; moves it up; no handler moves X by more than 2). The return stack
E029                             ; has when S is below RSLIM (an underflow wraps S to 00-03).
E029   E0 FD                  CPX   #DSE+1   
E02B   B0 4F                  BCS   e_stack   
E02D   8A                     TXA      ; TSX trashes X: keep it in A
E02E   BA                     TSX      
E02F   E0 20                  CPX   #RSLIM   
E031   AA                     TAX      ; TAX leaves the carry alone
E032   90 50                  BCC   e_rstack   
E034                          ENDIF      
E034   20 3A E0               JSR   step   
E037   4C 29 E0               JMP   next   
E03A                             ; step: read one character and sort it by range.
E03A                             ;    00h          end of program
E03A                             ;    01h-20h, 7Fh-FFh   ignored
E03A                             ;    30h-39h      digit: read a whole number
E03A                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E03A                             ;    61h-7Ah      a-z: push the address of that letter's cell
E03A                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E03A   20 6E E1     STEP:     JSR   getc   ; flags follow A
E03D   F0 3A                  BEQ   endprog   
E03F   38                     SEC      
E040   E9 21                  SBC   #21h   ; A = c - 21h
E042   90 34                  BCC   ign   ; 01h-20h
E044   C9 0F                  CMP   #0Fh   
E046   90 26                  BCC   punct   ; 21h-2Fh: index 0-14
E048   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E04A   C9 0A                  CMP   #10   
E04C   90 3F                  BCC   digit   
E04E   C9 11                  CMP   #11h   
E050   B0 04                  BCS   ab40   
E052   69 05                  ADC   #5   ; (carry clear) 3Ah-40h: index 15-21
E054   90 18                  BCC   punct   ; always
E056   E9 11        AB40:     SBC   #11h   ; A = c - 41h
E058   C9 1A                  CMP   #1Ah   
E05A   90 7B                  BCC   upper   ; 41h-5Ah
E05C   C9 20                  CMP   #20h   
E05E   B0 04                  BCS   ab60   
E060   E9 03                  SBC   #3   ; (carry clear: subtracts 4) 5Bh-60h: 22-27
E062   B0 0A                  BCS   punct   ; always
E064   C9 3A        AB60:     CMP   #3Ah   
E066   90 63                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E068   C9 3E                  CMP   #3Eh   
E06A   B0 0C                  BCS   ign   ; 7Fh-FFh
E06C   E9 1D                  SBC   #1Dh   ; (carry clear: subtracts 1Eh) 7Bh-7Eh: 28-31
E06E   0A           PUNCT:    ASL      
E06F   A8                     TAY      
E070   B9 2A E1               LDA   PTAB+1,Y   
E073   48                     PHA      
E074   B9 29 E1               LDA   PTAB,Y   
E077   48                     PHA      
E078   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E079                             ; directly, it just ends an ignored character.
E079   4C 09 FF     ENDPROG:   JMP   EXIT   
E07C                          IF   CHECKED   
E07C   20 7B E5     E_STACK:   JSR   error   
E07F   73 74 61 63 EB         DB   "stac","k"+80h   
E084   20 7B E5     E_RSTACK:   JSR   error   
E087   72 65 74 75 72 EE      DB   "retur","n"+80h   
E08D                          ENDIF      
E08D                             ; Digits: the first one is in A; read the rest of the number.
E08D   A8           DIGIT:    TAY      
E08E   20 86 E1               JSR   push   
E091   84 02                  STY   TL   
E093   A9 00                  LDA   #0   
E095   85 03                  STA   TH   
E097   F0 27                  BEQ   rdnum   ; always: A = 0
E099                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E099                             ; test is at the bottom so the loop closes with a branch.
E099   20 71 E1     RD1:      JSR   incip   ; (keeps A = the digit)
E09C   06 02                  ASL   TL   
E09E   26 03                  ROL   TH   ; x2
E0A0   18                     CLC      
E0A1   65 02                  ADC   TL   
E0A3   85 04                  STA   T0   
E0A5   A5 03                  LDA   TH   
E0A7   69 00                  ADC   #0   
E0A9   85 05                  STA   T1   ; T = x2 + digit
E0AB   06 02                  ASL   TL   
E0AD   26 03                  ROL   TH   
E0AF   06 02                  ASL   TL   
E0B1   26 03                  ROL   TH   ; x8
E0B3   18                     CLC      
E0B4   A5 02                  LDA   TL   
E0B6   65 04                  ADC   T0   
E0B8   85 02                  STA   TL   
E0BA   A5 03                  LDA   TH   
E0BC   65 05                  ADC   T1   
E0BE   85 03                  STA   TH   ; x8 + x2 + digit
E0C0   20 69 E1     RDNUM:    JSR   peek   
E0C3   38                     SEC      
E0C4   E9 30                  SBC   #"0"   
E0C6   C9 0A                  CMP   #10   
E0C8   90 CF                  BCC   rd1   
E0CA   60                     RTS      
E0CB                             ; a-z: push the cell's address (the cell is the variable)
E0CB   0A           LOWER:    ASL      
E0CC   A8                     TAY      
E0CD   20 86 E1               JSR   push   
E0D0   84 02                  STY   TL   
E0D2   A9 04                  LDA   #>LET   
E0D4   85 03                  STA   TH   
E0D6   60                     RTS      
E0D7                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E0D7                             ; the return stack, and the IP becomes the address in the letter's cell.
E0D7   0A           UPPER:    ASL      
E0D8   A8                     TAY      
E0D9   68                     PLA      
E0DA   68                     PLA      ; drop the step frame
E0DB   A5 01                  LDA   IP+1   
E0DD   48                     PHA      
E0DE   A5 00                  LDA   IP   
E0E0   48                     PHA      
E0E1   B9 00 04               LDA   LET,Y   
E0E4   85 00                  STA   IP   
E0E6   B9 01 04               LDA   LET+1,Y   
E0E9   85 01                  STA   IP+1   
E0EB   4C 29 E0               JMP   next   
E0EE                             ; skip: read past text to the closer at this level, and return it in A.
E0EE                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0EE                             ; NUL first ends the program.
E0EE   A9 00        SKIP:     LDA   #0   
E0F0   85 06                  STA   T2   ; depth
E0F2   20 6E E1     SK1:      JSR   getc   
E0F5   F0 82                  BEQ   endprog   
E0F7   C9 22                  CMP   #22h   
E0F9   D0 05                  BNE   sk2   
E0FB   20 FC E3               JSR   skipstr   
E0FE   F0 F2                  BEQ   sk1   ; skipstr ends with the zero flag set
E100   C9 28        SK2:      CMP   #"("   
E102   F0 11                  BEQ   sk3   
E104   C9 5B                  CMP   #"["   
E106   F0 0D                  BEQ   sk3   
E108   C9 29                  CMP   #")"   
E10A   F0 04                  BEQ   sk4   
E10C   C9 5D                  CMP   #"]"   
E10E   D0 E2                  BNE   sk1   
E110   C6 06        SK4:      DEC   T2   
E112   10 DE                  BPL   sk1   
E114   60                     RTS      ; the closer at this level
E115   E6 06        SK3:      INC   T2   
E117   D0 D9                  BNE   sk1   
E119                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E119                             ; the matching ")".
E119   20 8B E3     H_OPEN:   JSR   flag   
E11C   F0 D0                  BEQ   skip   
E11E   68                     PLA      
E11F   68                     PLA      
E120   A5 01                  LDA   IP+1   
E122   48                     PHA      
E123   A5 00                  LDA   IP   
E125   48                     PHA      
E126   4C 29 E0               JMP   next   
E129                             ; =============================================================================
E129                             ;  Dispatch table: one handler per punctuation character, in code order.
E129                             ;  Entries are handler-1 for the RTS trick.
E129                             ; =============================================================================
E129   91 E1        PTAB:     DW   h_store-1   ; !
E12B   F8 E3                  DW   h_str-1   ; "
E12D   3C E4                  DW   h_num-1   ; #
E12F   17 E4                  DW   h_print-1   ; $
E131   42 E2                  DW   h_swap-1   ; %
E133   D9 E1                  DW   h_and-1   ; &
E135   34 E4                  DW   h_emit-1   ; '
E137   18 E1                  DW   h_open-1   ; (
E139   94 E3                  DW   h_close-1   ; )
E13B   13 E2                  DW   h_mul-1   ; *
E13D   04 E3                  DW   h_add-1   ; +
E13F   4B E3                  DW   h_cfetch-1   ; ,
E141   EF E2                  DW   h_sub-1   ; -
E143   A4 E1                  DW   h_cstore-1   ; .
E145   57 E2                  DW   h_div-1   ; /
E147   85 E1                  DW   push-1   ; :
E149   B1 E1                  DW   drop-1   ; ;
E14B   18 E3                  DW   h_lt-1   ; <
E14D   2B E3                  DW   h_eq-1   ; =
E14F   15 E3                  DW   h_gt-1   ; >
E151   68 E4                  DW   h_key-1   ; ?
E153   3D E3                  DW   h_fetch-1   ; @
E155   CD E3                  DW   h_def-1   ; [
E157   AB E3                  DW   h_break-1   ; \
E159   BF E3                  DW   h_ret-1   ; ]
E15B   F7 E1                  DW   h_xor-1   ; ^
E15D   54 E3                  DW   h_alloc-1   ; _
E15F   EE E4                  DW   h_grave-1   ; `
E161   BD E1                  DW   h_tor-1   ; {
E163   E8 E1                  DW   h_or-1   ; |
E165   CB E1                  DW   h_fromr-1   ; }
E167   06 E2                  DW   h_not-1   ; ~
E169                             ; =============================================================================
E169                             ;  Reading the program
E169                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E169                             ;    getc: the same, then IP moves on; flags follow A
E169                             ;    incip: IP moves on; keeps A, the carry and Y
E169                             ; =============================================================================
E169   A0 00        PEEK:     LDY   #0   
E16B   B1 00                  LDA   (IP),Y   
E16D   60                     RTS      
E16E   20 69 E1     GETC:     JSR   peek   
E171   E6 00        INCIP:    INC   IP   
E173   D0 02                  BNE   ic1   
E175   E6 01                  INC   IP+1   
E177   09 00        IC1:      ORA   #0   
E179   60                     RTS      
E17A                             ; =============================================================================
E17A                             ;  Stack
E17A                             ; =============================================================================
E17A   20 86 E1     PUSHIP:   JSR   push   ; push the reading position
E17D   A5 00                  LDA   IP   
E17F   85 02                  STA   TL   
E181   A5 01                  LDA   IP+1   
E183   85 03                  STA   TH   
E185   60                     RTS      
E186   CA           PUSH:     DEX      ; ":" and every push
E187   A5 02                  LDA   TL   
E189   9D 00 02               STA   DSL,X   
E18C   A5 03                  LDA   TH   
E18E   9D 00 03               STA   DSH,X   
E191   60                     RTS      
E192                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E192                H_STORE:      
E192                          IF   CHECKED   
E192   A5 02                  LDA   TL   ; both bytes must be in the program's space:
E194   18                     CLC      ; check the page of addr+1
E195   69 01                  ADC   #1   
E197   A5 03                  LDA   TH   
E199   69 00                  ADC   #0   
E19B   20 7A E3               JSR   chkst   
E19E                          ENDIF      
E19E   BD 00 03               LDA   DSH,X   
E1A1   A0 01                  LDY   #1   
E1A3   91 02                  STA   (TL),Y   
E1A5                H_CSTORE:      ; "." ( c addr -- )
E1A5                          IF   CHECKED   
E1A5   A5 03                  LDA   TH   
E1A7   20 7A E3               JSR   chkst   
E1AA                          ENDIF      
E1AA   BD 00 02               LDA   DSL,X   
E1AD   A0 00                  LDY   #0   
E1AF   91 02                  STA   (TL),Y   
E1B1   E8                     INX      ; falls into drop
E1B2   BD 00 02     DROP:     LDA   DSL,X   ; ";" and every drop
E1B5   85 02                  STA   TL   
E1B7   BD 00 03               LDA   DSH,X   
E1BA   85 03                  STA   TH   
E1BC   E8                     INX      
E1BD   60                     RTS      
E1BE                             ; "{" TOS to the return stack, "}" return stack to TOS
E1BE   68           H_TOR:    PLA      
E1BF   68                     PLA      
E1C0   A5 03                  LDA   TH   
E1C2   48                     PHA      
E1C3   A5 02                  LDA   TL   
E1C5   48                     PHA      
E1C6   20 B2 E1               JSR   drop   
E1C9   4C 29 E0               JMP   next   
E1CC   68           H_FROMR:   PLA      
E1CD   68                     PLA      
E1CE   20 86 E1               JSR   push   
E1D1   68                     PLA      
E1D2   85 02                  STA   TL   
E1D4   68                     PLA      
E1D5   85 03                  STA   TH   
E1D7   4C 29 E0               JMP   next   
E1DA                             ; =============================================================================
E1DA                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E1DA                             ; =============================================================================
E1DA   BD 00 02     H_AND:    LDA   DSL,X   
E1DD   25 02                  AND   TL   
E1DF   85 02                  STA   TL   
E1E1   BD 00 03               LDA   DSH,X   
E1E4   25 03                  AND   TH   
E1E6   4C 12 E3               JMP   fin   
E1E9   BD 00 02     H_OR:     LDA   DSL,X   
E1EC   05 02                  ORA   TL   
E1EE   85 02                  STA   TL   
E1F0   BD 00 03               LDA   DSH,X   
E1F3   05 03                  ORA   TH   
E1F5   4C 12 E3               JMP   fin   
E1F8   BD 00 02     H_XOR:    LDA   DSL,X   
E1FB   45 02                  EOR   TL   
E1FD   85 02                  STA   TL   
E1FF   BD 00 03               LDA   DSH,X   
E202   45 03                  EOR   TH   
E204   4C 12 E3               JMP   fin   
E207   A5 02        H_NOT:    LDA   TL   
E209   49 FF                  EOR   #0FFh   
E20B   85 02                  STA   TL   
E20D   A5 03                  LDA   TH   
E20F   49 FF                  EOR   #0FFh   
E211   85 03                  STA   TH   
E213   60                     RTS      
E214                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept.
E214   A9 00        H_MUL:    LDA   #0   
E216   85 04                  STA   T0   
E218   85 05                  STA   T1   ; product
E21A   A0 10                  LDY   #16   
E21C   46 03        ML1:      LSR   TH   
E21E   66 02                  ROR   TL   ; next multiplier bit
E220   90 0F                  BCC   ml2   
E222   18                     CLC      
E223   A5 04                  LDA   T0   
E225   7D 00 02               ADC   DSL,X   
E228   85 04                  STA   T0   
E22A   A5 05                  LDA   T1   
E22C   7D 00 03               ADC   DSH,X   
E22F   85 05                  STA   T1   
E231   1E 00 02     ML2:      ASL   DSL,X   
E234   3E 00 03               ROL   DSH,X   ; multiplicand * 2
E237   88                     DEY      
E238   D0 E2                  BNE   ml1   
E23A   A5 04                  LDA   T0   
E23C   85 02                  STA   TL   
E23E   A5 05                  LDA   T1   
E240   4C 12 E3               JMP   fin   
E243   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E246   A5 02                  LDA   TL   
E248   9D 00 02               STA   DSL,X   
E24B   84 02                  STY   TL   
E24D   BC 00 03               LDY   DSH,X   
E250   A5 03                  LDA   TH   
E252   9D 00 03               STA   DSH,X   
E255   84 03                  STY   TH   
E257   60                     RTS      
E258                             ; "/" ( a b -- q r ): truncates toward zero; r takes a's sign.
E258                             ; b = 0 gives q = 0, r = a: that is just a swap. |b| = 2 takes a fast shift.
E258   A5 02        H_DIV:    LDA   TL   
E25A   05 03                  ORA   TH   
E25C   F0 E5                  BEQ   h_swap   
E25E   BD 00 03               LDA   DSH,X   
E261   48                     PHA      ; r's sign
E262   45 03                  EOR   TH   
E264   48                     PHA      ; q's sign
