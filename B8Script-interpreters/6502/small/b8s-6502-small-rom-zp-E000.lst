E24F   A5 00                  LDA   IP   
E251   48                     PHA      
E252   4C C5 E3               JMP   pnext   ; a loop-back: the break check
E255                             ; "{" TOS to the return stack, "}" return stack to TOS
E255   68           H_TOR:    PLA      
E256   68                     PLA      
E257   B5 01                  LDA   1,X   
E259   48                     PHA      
E25A   B5 00                  LDA   0,X   
E25C   48                     PHA      
E25D   E8                     INX      
E25E   E8                     INX      
E25F   D0 0A                  BNE   nxt2   ; always: X is never 0
E261   68           H_FROMR:   PLA      
E262   68                     PLA      
E263   CA                     DEX      
E264   CA                     DEX      
E265   68                     PLA      
E266   95 00                  STA   0,X   
E268   68                     PLA      
E269   95 01                  STA   1,X   
E26B   4C D5 E3     NXT2:     JMP   next   
E26E                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E26E   4C 0F E1     H_NOT:    JMP   neg1   
E271   20 74 E2     H_XOR:    JSR   xr1   
E274   B5 00        XR1:      LDA   0,X   
E276   55 02                  EOR   2,X   
E278   95 02                  STA   2,X   
E27A   E8                     INX      
E27B   60                     RTS      
E27C   20 7F E2     H_OR:     JSR   or1   
E27F   B5 00        OR1:      LDA   0,X   
E281   15 02                  ORA   2,X   
E283   95 02                  STA   2,X   
E285   E8                     INX      
E286   60                     RTS      
E287   A1 00        H_FETCH:   LDA   (0,X)   ; "@"
E289   A8                     TAY      
E28A   20 96 E2               JSR   inctos   
E28D   A1 00                  LDA   (0,X)   
E28F   95 01                  STA   1,X   
E291   94 00                  STY   0,X   
E293   60                     RTS      
