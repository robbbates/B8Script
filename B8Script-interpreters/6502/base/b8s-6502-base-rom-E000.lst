E7B8                          IF   FAST*(1-CHECKED)   
                                 ; a-z, unchecked: a variable followed by @ or ! is fetched or stored in the
                                 ; same step; otherwise its address is pushed, and the character after it,
                                 ; read already, is dispatched from A or Y.
                    FVA:      LDY   #0   ; a
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   fvaf   
                              CMP   #"!"   
                              BEQ   fvas   
                              TAY      ; not @ or !: push the address
                              DEX      
                              LDA   TL   
                              STA   DSL,X   
                              LDA   TH   
                              STA   DSH,X   
                              LDA   #40h   
                              STA   TL   
                              LDA   #>LET   
                              STA   TH   
                              ;*Macro unroll:  NEXTY
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FVAF:     LDY   #40h   
                              JMP   fvat   
                    FVAS:     LDY   #40h   
                              JMP   fvst   
                    FVB:      LDY   #0   ; b
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   fvbf   
                              CMP   #"!"   
                              BEQ   fvbs   
                              TAY      ; not @ or !: push the address
                              DEX      
                              LDA   TL   
                              STA   DSL,X   
                              LDA   TH   
                              STA   DSH,X   
                              LDA   #42h   
                              STA   TL   
                              LDA   #>LET   
                              STA   TH   
                              ;*Macro unroll:  NEXTY
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
