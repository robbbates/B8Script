05B9   C2 D9 05               JNZ   e_over   
05BC   2A 34 0A               LHLD   RSP   ; the return stack: in its page (or it has
05BF   7C                     MOV   A,H   ;   overflowed), and not above its empty
05C0   FE 08                  CPI   RSPAGE   ;   position (an underflow stays inside the
05C2   C2 D6 05               JNZ   e_rover   ;   page, in the guard band)
05C5   7D                     MOV   A,L   
05C6   FE E1                  CPI   RSTOP&0FFh+1   
05C8   D2 CD 05               JNC   e_runder   
05CB   EB                     XCHG      ; TOS back
05CC   C9                     RET      
05CD   21 E0 08     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
05D0   22 34 0A               SHLD   RSP   
05D3   3E 72                  MVI   A,"r"   
05D5   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
05D6   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
05D8   21                     DB   21h   
05D9   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
05DB   EB                     XCHG      ; TOS back
05DC   C3 04 06               JMP   errp   
05DF   31 FC 09     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
05E2   3E 73                  MVI   A,"s"   
05E4   C3 05 06               JMP   error   
05E7                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
05E7                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
05E7                             ; every build: if the IP is in page zero, this was a call of an undefined
05E7                             ; word. The call is undone, so the place is the call itself.
05E7   04           E_HI:     INR   B   
05E8   05                     DCR   B   
05E9   C2 FB 05               JNZ   e_resv   
05EC   E5                     PUSH   H   
05ED   CF                     RST   1   
05EE   44                     MOV   B,H   
05EF   4D                     MOV   C,L   
05F0   E1                     POP   H   
05F1   3E 55                  MVI   A,"U"   
05F3   C3 05 06               JMP   error   
05F6                             ; Error entries. Each loads its letter and then hides the next entry inside
05F6                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
05F6   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
05F7   4D                     MOV   C,L   ;   past the opening quote, which is the place
05F8   3E 51                  MVI   A,"Q"   
05FA   11                     DB   11h   
05FB   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
05FD   11                     DB   11h   
05FE   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
0600   11                     DB   11h   
0601   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
0603   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
0604                             ; errp: an error found inside a routine: drop its return address first.
0604   D1           ERRP:     POP   D   
0605                             ; error: the report, then the end. A = the letter, BC = one past the place,
0605                             ; HL = TOS, and both stacks as the report is to show them:
0605                             ; 
0605                             ;   Err X @ line,col
0605                             ;   up to 16 characters of the text from the place
0605                             ;   Stk n: the top 8 cells at most, bottom to top
0605                             ;   Rtn n
0605   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
0606   5F                     MOV   E,A   
0607   CD A4 05               CALL   pnl   
060A   45 72 72 20 22         DB   "Err ",22h   
060F   7B                     MOV   A,E   
0610   EF                     RST   5   
0611   CD AA 05               CALL   pmsg   
0614   20 40 20 22            DB   " @ ",22h   
0618   0B                     DCX   B   ; BC = the place
0619                             ; The line and column. A place below the program is in the line
0619                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0619                             ; DE = the line's number, HL = where it starts.
0619   21 80 0A               LXI   H,LINEBUF   
061C   11 00 00               LXI   D,0   
061F   78                     MOV   A,B   
0620   FE 0B                  CPI   PROG/256   
0622   DA 3C 06               JC   er3   
0625   24                     INR   H   
0626   6B                     MOV   L,E   ; HL = PROG
0627   13           ER1:      INX   D   ; a new line starts at HL
0628   E5                     PUSH   H   
0629   7D           ER2:      MOV   A,L   
062A   91                     SUB   C   
062B   7C                     MOV   A,H   
062C   98                     SBB   B   
062D   D2 3B 06               JNC   er2x   ; reached the place
0630   7E                     MOV   A,M   
0631   23                     INX   H   
0632   FE 0A                  CPI   10   
0634   C2 29 06               JNZ   er2   
0637   F1                     POP   PSW   
0638   C3 27 06               JMP   er1   
063B   E1           ER2X:     POP   H   
063C   C5           ER3:      PUSH   B   
063D   E5                     PUSH   H   
063E   EB                     XCHG      
063F   CD 81 04               CALL   pdec   ; the line
0642   3E 2C                  MVI   A,","   
0644   EF                     RST   5   
0645   D1                     POP   D   
0646   E1                     POP   H   
0647   E5                     PUSH   H   
0648   CD D8 06               CALL   sub16   
064B   23                     INX   H   
064C   CD 81 04               CALL   pdec   ; the column
064F   CD A4 05               CALL   pnl   
0652   22                     DB   22h   
0653   E1                     POP   H   ; the text, as it is: 16 characters, or fewer
0654   06 10                  MVI   B,16   ;   if the line or the program ends first
0656   7E           ER4:      MOV   A,M   
0657   23                     INX   H   
0658   B7                     ORA   A   
0659   CA 70 06               JZ   er5   
065C   FE 0D                  CPI   13   
065E   CA 70 06               JZ   er5   
0661   FE 0A                  CPI   10   
0663   CA 70 06               JZ   er5   
0666                          ENDIF      
0666                          IF   CHECKED*CPM   
0666   FE 1A                  CPI   1Ah   ; (the ^Z that pads a file's last record ends
0668   CA 70 06               JZ   er5   ;   the text too: some terminals clear the
066B                          ENDIF      ;   screen on it)
066B                          IF   CHECKED   
066B   EF                     RST   5   
066C   05                     DCR   B   
066D   C2 56 06               JNZ   er4   
0670   CD A4 05     ER5:      CALL   pnl   
0673   53 74 6B 20 22         DB   "Stk ",22h   
0678   21 06 F6               LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
067B   39                     DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
067C   E7                     RST   4   ;   first value and holds nothing)
067D   7C                     MOV   A,H   
067E   CD CC 06               CALL   phal2   ; the depth
0681   3E 3A                  MVI   A,":"   
0683   EF                     RST   5   
0684   79                     MOV   A,C   
0685   FE 09                  CPI   9   
0687   DA 94 06               JC   er6   
068A   CD AA 05               CALL   pmsg   
068D   20 2E 2E 2E 22         DB   " ...",22h   
0692   0E 08                  MVI   C,8   
0694   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
0696   69                     MOV   L,C   
0697   29                     DAD   H   
0698   39                     DAD   SP   ; HL -> just above the deepest of them
0699   0C                     INR   C   
069A   0D           ER7:      DCR   C   
069B   CA B0 06               JZ   er8   
069E   2B                     DCX   H   
069F   56                     MOV   D,M   
06A0   2B                     DCX   H   
06A1   5E                     MOV   E,M   
06A2   E5                     PUSH   H   
06A3   C5                     PUSH   B   
06A4   3E 20                  MVI   A," "   
06A6   EF                     RST   5   
06A7   EB                     XCHG      
06A8   CD 78 04               CALL   psgn   
06AB   C1                     POP   B   
06AC   E1                     POP   H   
06AD   C3 9A 06               JMP   er7   
06B0   CD A4 05     ER8:      CALL   pnl   
06B3   52 74 6E 20 22         DB   "Rtn ",22h   
06B8   2A 34 0A               LHLD   RSP   
06BB   EB                     XCHG      
06BC   21 E0 08               LXI   H,RSTOP   
06BF   CD C9 06               CALL   phalf   
06C2   CD A4 05               CALL   pnl   
06C5   22                     DB   22h   
06C6   C3 83 01               JMP   endprog   
06C9                             ; phalf: print half of HL - DE, and leave it in BC
06C9   CD D8 06     PHALF:    CALL   sub16   
06CC   B7           PHAL2:    ORA   A   ; (A = H; this clears the carry)
06CD   1F                     RAR      
06CE   67                     MOV   H,A   
06CF   7D                     MOV   A,L   
06D0   1F                     RAR      
06D1   6F                     MOV   L,A   
06D2   E5                     PUSH   H   
06D3   CD 81 04               CALL   pdec   
06D6   C1                     POP   B   
06D7   C9                     RET      
06D8                             ; sub16: HL = HL - DE. Leaves A = H.
06D8   7D           SUB16:    MOV   A,L   
06D9   93                     SUB   E   
06DA   6F                     MOV   L,A   
06DB   7C                     MOV   A,H   
06DC   9A                     SBB   D   
