0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-11-24). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page ($00-$09). b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's three-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   D:2: 5 0
0000                             ;                   R:0
0000                             ;                 and then goes to EXIT.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build").
0000                             ;  The base and fast builds use one more RAM page, for the skip cache: the page
0000                             ;  at the heap limit, which is DF00h in them (E000h in the others).
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   2   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ;  The fast build (SPEED = 2) dispatches through a full table instead: see
0000                             ;  "The fast build" at the end.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                SKL:      EQU   T1   ; (QK) 05 and 08: where a skip started, for
0000                SKH:      EQU   D0   ;   the skip cache
0000                V:        EQU   T0   ; (FAST) 04-05 the dispatcher's jump vector
0000                          IF   1-CHECKED   
0000                KEYBUF:   EQU   07h   ; a key held back by the break check (0: none)
0000                          ENDIF      
0000                          IF   CHECKED   
                    PLACE:    EQU   06h   ; 06-07 (T2 and $07) the address of the
                                 ;   character being run, for the error report:
                                 ;   no handler of the checked build uses T2.
                                 ;   (Machine code may change T2: that matters
                                 ;   only if it also leaves a stack overrun,
                                 ;   whose report then shows a wrong place.)
                    RSV:      EQU   LET+35h   ; S as it was before this character
                    KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
                                 ; The error report runs after the program, so it may use the zero page that
                                 ; machine code has ($0A-$0F):
                    CL:       EQU   0Ah   ; 0A-0B where the reported line starts
0000                          ENDIF      
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PEND at +38, KEYBUF (the held
0000                             ;               key; $07 in the unchecked build) at +7A; and every build's:
0000                             ;               CDOWN at +79, BRKOFF (the break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    DF00       CPAGE (QK builds only): the skip cache, at the heap limit
0000                             ;    E000       the interpreter (ROM). In the fast build its first two
0000                             ;               pages are the dispatch table, and start is at E200
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these. All four must keep X;
0000                             ; they may change A, Y and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if the carry is set,
0000                             ;     hide it if the carry is clear
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row A, column Y, both
0000                             ;     counted from 0
0000                          ENDIF      
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h-QK   ; the heap must stay below E000h (a page);
0000                             ;   below DF00h in the QK builds, where
0000                CPAGE:    EQU   HEAPLIM   ;   DF00h is the skip cache's page: the page
0000                             ;   at the heap limit, which the heap never reaches
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                CDOWN:    EQU   LET+79h   ; the break check's countdown (see pnext)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
0000                             ; The fast build's dispatcher (SPEED = 2; see "The fast build"), inline at
0000                             ; the end of its own entries. NEXTF reads the next character and jumps
0000                             ; through the table:
0000                             ;     LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
0000                             ;     LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
0000                             ; NEXTA is the same from INC IP on: the character is already in A, and IP is
0000                             ; still at it (it skips the LDY and the LDA); NEXTY is the same with the
0000                             ; character in Y (it skips the TAY too). In the checked build all three are
0000                             ; JMP fnext, which checks the stacks first. (The bytes are written out with
0000                             ; DS, because asm80 does not nest an IF in a macro inside another IF; and
0000                             ; DS takes the addresses as these equates.)
0000                          IF   FAST   
0000                ADTL:     EQU   DTL   
0000                ADTH:     EQU   DTH   
0000                AFNX:     EQU   fnext   
0000                          ENDIF      
0000                          IF   1-FAST   
                    ADTL:     EQU   0   
                    ADTH:     EQU   0   
                    AFNX:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      1-CHECKED,0A0h  ; LDY #0
0000                 DS      1-CHECKED,0
0000                 DS      1-CHECKED,0B1h  ; LDA (IP),Y
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTA,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTY,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                FTAB:     EQU   0E000h   ; (FAST: the fast build's table, two pages,
E200                          .ORG   FTAB+FAST*512   ;   comes first, and the code after it)
E200                             ; =============================================================================
E200                             ;  Startup: find the NUL, the heap starts after it
E200                             ; =============================================================================
E200   A2 FF        START:    LDX   #0FFh   
E202   9A                     TXS      ; return stack empty
E203                          IF   CHECKED   
                                 ; The first half of the letter page is zeroed: every variable, every
                                 ; cell of the interpreter's own (no key held back), and every word
                                 ; cell, which then points at 0000h: calling an undefined word stops
                                 ; with U (see e_undef).
                              INX      
                              TXA      ; A = 0
                              LDY   #7Fh   
                    STZ:      STA   LET,Y   
                              DEY      
                              BPL   stz   
E203                          ENDIF      
E203                          IF   QK   
E203   A9 00                  LDA   #0   ; an empty skip cache (a start of 0000h
E205   A8                     TAY      ;   matches no skip)
E206   99 00 DF     SKC:      STA   CPAGE*256,Y   
E209   C8                     INY      
E20A   D0 FA                  BNE   skc   
E20C                          ENDIF      
E20C   20 55 E5               JSR   rstip   
E20F   20 49 E5     ST1:      JSR   getc   
E212   D0 FB                  BNE   st1   ; IP ends just past the NUL
E214                          IF   1-CHECKED   
E214   85 07                  STA   KEYBUF   ; (A = 0) no key held, the break key on
E216   8D 7B 04               STA   BRKOFF   
E219                          ENDIF      
E219   A5 00                  LDA   IP   
E21B   8D 7C 04               STA   HEAP   
E21E                          IF   CHECKED   
                              STA   PEND   
E21E                          ENDIF      
E21E   A5 01                  LDA   IP+1   
E220   8D 7D 04               STA   HEAP+1   
E223                          IF   CHECKED   
                              STA   PEND+1   
E223                          ENDIF      
E223   20 55 E5               JSR   rstip   
E226   A2 FC                  LDX   #DSE   
E228                             ; =============================================================================
E228                             ;  The inner loop
E228                             ; =============================================================================
E228                             ; -----------------------------------------------------------------------------
E228                             ;  The break key. A running program reads the keyboard only through getk
E228                             ;  (for "?") and pnext (the break check), which between them give the break
E228                             ;  key its rules:
E228                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E228                             ;      build, with the report (B) in the checked one;
E228                             ;    - any other key that the break check reads is held in KEYBUF for the
E228                             ;      next "?", and a newer one takes its place;
E228                             ;    - "?" (getk) takes the held key first;
E228                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E228                             ;      key like any other, but two of them within about 250 ms still stop it.
E228                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E228                             ; -----------------------------------------------------------------------------
E228                             ; pnext: the break check, then (falling through) next. A word call, a true
E228                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E228                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E228                             ; falls in here too, which does no harm.)
E228   CE 79 04     PNEXT:    DEC   CDOWN   
E22B   D0 0A                  BNE   next   
E22D   20 06 FF     PKEY:     JSR   KEY   
E230   F0 05                  BEQ   next   ; no key
E232   85 07                  STA   KEYBUF   ; held for the next "?"
E234   20 90 E2               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E237                NEXT:        
E237                          IF   FAST   
E237   4C 0A EB               JMP   fnext   ; (the fast build: see "The fast build")
E23A                          ENDIF      
E23A                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE: an
                                 ; underflow moves X up to FDh or FEh (no handler moves X by more
                                 ; than 2, but "$", whose /~ escapes each look first), and an
                                 ; overflow wraps it from 00h to FFh.
                                 ; S is kept in RSV, for the report's R: line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_stack   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E23A                          ENDIF      
E23A                          IF   1-FAST   
                              JSR   step   
                              JMP   next   
E23A                          ENDIF      
E23A                          IF   CHECKED   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: R:0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_STACK:   CPX   #0FFh   
                              LDA   #"S"   
                              BCS   ejmp   ; X wrapped from 00h to FFh: an overflow
                              LDX   #DSE   ; an underflow: D:0
                              LDA   #"s"   
                    EJMP:     JMP   error   
E23A                          ENDIF      
E23A                             ; The handlers that work on the return stack sit here, where short branches
E23A                             ; reach next and pnext.
E23A                             ; "{" TOS to the return stack, "}" return stack to TOS
E23A   68           H_TOR:    PLA      
E23B   68                     PLA      
E23C   A5 03                  LDA   TH   
E23E   48                     PHA      
E23F   A5 02                  LDA   TL   
E241   48                     PHA      
E242   20 76 E5               JSR   drop   
E245   D0 F0                  BNE   next   ; always
E247   68           H_FROMR:   PLA      
E248   68                     PLA      
E249   20 14 E3               JSR   push   
E24C   68                     PLA      
E24D   85 02                  STA   TL   
E24F   68                     PLA      
E250   85 03                  STA   TH   
E252   90 E3                  BCC   next   ; always: the carry is clear on the way in
E254                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E254                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E254                             ; it is here, the address popped is pushed back.
E254   20 5E E5     H_CLOSE:   JSR   flag   
E257   F0 20                  BEQ   rdrop   
E259                          IF   1-QK   
                              DB   24h   ; (BIT zp: steps over the SEC)
E259                          ENDIF      
E259                          IF   QK   
E259   4C 20 E3               JMP   closeq   ; (QK: see Speed-ups)
E25C                          ENDIF      
E25C                             ; "]" returns: pull an address and jump to it.
E25C   38           H_RET:    SEC      
E25D   68                     PLA      
E25E   68                     PLA      ; drop the step frame
E25F   68                     PLA      
E260   85 00                  STA   IP   
E262   68                     PLA      
E263   85 01                  STA   IP+1   
E265   B0 D0                  BCS   next   
E267   48                     PHA      ; ")": keep the block start
E268   A5 00                  LDA   IP   
E26A   48                     PHA      
E26B   90 BB                  BCC   pnext   ; always: a loop-back, with the break check
E26D                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E26D                             ; drops the block start, "]" returns.
E26D   20 5E E5     H_BREAK:   JSR   flag   
E270   F0 22                  BEQ   gk9   ; (an RTS)
E272                          IF   CHECKED   
                              LDA   #0   ; \ takes either closer
E272                          ENDIF      
E272   20 73 E3               JSR   skip   
E275   C9 29                  CMP   #")"   
E277   D0 E3                  BNE   h_ret   
E279   68           RDROP:    PLA      
E27A   68                     PLA      
E27B   68                     PLA      
E27C   68                     PLA      ; (the block start's high byte: never 0)
E27D                          IF   1-QK   
                              BNE   next   ; always
E27D                          ENDIF      
E27D                          IF   QK   
E27D   4C 37 E2               JMP   next   ; (closeq moved next out of reach)
E280                          ENDIF      
E280                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E280                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E280                             ; taken out of KEYBUF.
E280   A5 07        GETK:     LDA   KEYBUF   
E282   F0 07                  BEQ   gk1   
E284   48                     PHA      
E285   A9 00                  LDA   #0   
E287   85 07                  STA   KEYBUF   
E289   68                     PLA      
E28A   60                     RTS      
E28B   20 06 FF     GK1:      JSR   KEY   
E28E   F0 04                  BEQ   gk9   
E290                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E290                             ; back if it comes back at all.
E290   C9 03        CHK3:     CMP   #3   
E292   F0 01                  BEQ   ctlc   
E294   60           GK9:      RTS      
E295                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E295                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E295                             ; looks: D0 counts the 256s, D1 runs on from whatever it holds) for one more
E295                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E295                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E295   AD 7B 04     CTLC:     LDA   BRKOFF   
E298   F0 57                  BEQ   cbreak   
E29A   A9 28                  LDA   #CWAIT+1   
E29C   85 08                  STA   D0   
E29E   20 06 FF     CT2:      JSR   KEY   
E2A1   D0 0A                  BNE   ct3   
E2A3   C6 09                  DEC   D1   
E2A5   D0 F7                  BNE   ct2   
E2A7   C6 08                  DEC   D0   
E2A9   D0 F3                  BNE   ct2   
E2AB   F0 06                  BEQ   ct9   ; always: none came
E2AD   C9 03        CT3:      CMP   #3   
E2AF   F0 40                  BEQ   cbreak   
E2B1   85 07                  STA   KEYBUF   
E2B3   A9 03        CT9:      LDA   #3   
E2B5   60                     RTS      
E2B6                          IF   1-CHECKED   
E2B6                CBREAK:   EQU   endprog   ; the unchecked build stops without a word
E2B6                          ENDIF      
E2B6                          IF   CHECKED   
                    CBREAK:   EQU   e_break   ; the checked build reports B
E2B6                          ENDIF      
E2B6                          IF   CHECKED   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
                              DB   2Ch   
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP3:    JMP   error   
E2B6                          ENDIF      
E2B6                          IF   CHECKED   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; R: does not count the call
                              LDA   #"U"   
                              BNE   ejmp3   ; always
E2B6                          ENDIF      
E2B6                             ; step: read one character and sort it by range.
E2B6                             ;    00h          end of program
E2B6                             ;    01h-20h, 7Fh-FFh   ignored
E2B6                             ;    30h-39h      digit: read a whole number
E2B6                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E2B6                             ;    61h-7Ah      a-z: push the address of that letter's cell
E2B6                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E2B6                             ; Every way out of the sort has the carry clear, except "ignored". A checked
E2B6                             ; build stops on 80h-FFh (X) and still ignores DEL.
E2B6   20 49 E5     STEP:     JSR   getc   ; flags follow A
E2B9   F0 36                  BEQ   endprog   
E2BB   38                     SEC      
E2BC   E9 21                  SBC   #21h   ; A = c - 21h
E2BE   90 30                  BCC   ign   ; 01h-20h
E2C0   C9 0F                  CMP   #0Fh   
E2C2   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E2C4   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E2C6   C9 0A                  CMP   #10   
E2C8   90 2F                  BCC   digit   
E2CA   C9 11                  CMP   #11h   
E2CC   90 16                  BCC   p3a   ; 3Ah-40h
E2CE   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E2D0   C9 1A                  CMP   #1Ah   
E2D2   90 20                  BCC   upper   ; 41h-5Ah
E2D4   C9 20                  CMP   #20h   
E2D6   90 0A                  BCC   p5b   ; 5Bh-60h
E2D8   C9 3A                  CMP   #3Ah   
E2DA                          IF   1-SBASEU   
E2DA   90 25                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E2DC                          ENDIF      
E2DC                          IF   SBASEU   
                              BCC   lowq   ; 61h-7Ah: A = 20h-39h
E2DC                          ENDIF      
E2DC   C9 3E                  CMP   #3Eh   
E2DE                          IF   1-CHECKED   
E2DE   B0 10                  BCS   ign   ; 7Fh-FFh
E2E0                          ENDIF      
E2E0                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E2E0                          ENDIF      
E2E0                             ; The three adjustments below chain. Each ADC adds the carry the one
E2E0                             ; before it left, which the constants allow for.
E2E0   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E2E2   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E2E4   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E2E6   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E2E7   A8                     TAY      
E2E8   B9 BF E4               LDA   PTAB+1,Y   
E2EB   48                     PHA      
E2EC   B9 BE E4               LDA   PTAB,Y   
E2EF   48                     PHA      
E2F0   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E2F1                             ; directly, it just ends an ignored character.
E2F1                ENDPROG:      
E2F1                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E2F1                          ENDIF      
E2F1   4C 09 FF               JMP   EXIT   
E2F4                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E2F4                             ; the return stack, and the IP becomes the address in the letter's cell.
E2F4   0A           UPPER:    ASL      
E2F5   A8                     TAY      
E2F6   38                     SEC      
E2F7   B0 44                  BCS   pushn   ; always
E2F9                             ; Digits: the first one is in A; read the rest of the number.
E2F9   A0 00        DIGIT:    LDY   #0   
E2FB   20 0A E3               JSR   pushay   
E2FE   4C 23 E5               JMP   rdnum   
E301                             ; a-z: push the cell's address (the cell is the variable)
E301   0A           LOWER:    ASL      
E302   A0 04                  LDY   #>LET   
E304   D0 04                  BNE   pushay   ; always
E306   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E308   A4 01                  LDY   IP+1   
E30A                             ; pushay: push a cell: A = its low byte, Y = its high byte
E30A   48           PUSHAY:   PHA      
E30B   20 14 E3               JSR   push   
E30E   68                     PLA      
E30F   85 02                  STA   TL   
E311   84 03                  STY   TH   
E313   60                     RTS      
E314   CA           PUSH:     DEX      ; ":" and every push (keeps Y)
E315   A5 02                  LDA   TL   
E317   9D 00 02               STA   DSL,X   
E31A   A5 03                  LDA   TH   
E31C   9D 00 03               STA   DSH,X   
E31F   60                     RTS      
E320                          IF   SBASEU   
                                 ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
                                 ; fetched or stored in the same step (x@ is the commonest pair in most
                                 ; programs). A checked build checks the stacks between the two, so it keeps
                                 ; them apart. (pvar calls lower, which only pushes.)
                    LOWQ:     ASL      
                              STA   T0   ; the cell's offset in the letter page
                              LDY   #0   
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   lwf   
                              CMP   #"!"   
                              BEQ   lws   
                              LDA   T0   
                              LDY   #>LET   
                              BNE   pushay   ; always: the address
                    LWF:      JSR   incip   ; x@: TOS = the cell's value
                              JSR   push   
                              LDY   T0   
                              LDA   LET,Y   
                              STA   TL   
                              LDA   LET+1,Y   
                              STA   TH   
                              RTS      
                    LWS:      JSR   incip   ; x!: the cell = TOS, and NOS comes up
                              LDY   T0   
                              LDA   TL   
                              STA   LET,Y   
                              LDA   TH   
                              STA   LET+1,Y   
                              JMP   drop   
E320                          ENDIF      
E320                          IF   QK   
E320                             ;  ---- Speed-ups (QK builds) ---------------------------------------------
E320                             ;  The skip cache and the faster skip are at skip, "*" at h_mul and "/" at
E320                             ;  udiv; x@ and x! (unchecked) at lowq, above.
E320                             ; A true ")" reads the block start where it is, under the step frame,
E320                             ; instead of popping it and pushing it back. The break key is looked at as
E320                             ; pnext would.
E320   8A           CLOSEQ:   TXA      ; (TSX trashes X)
E321   BA                     TSX      
E322   BC 03 01               LDY   103h,X   
E325   84 00                  STY   IP   
E327   BC 04 01               LDY   104h,X   
E32A   84 01                  STY   IP+1   
E32C   AA                     TAX      
E32D   CE 79 04               DEC   CDOWN   
E330   F0 01                  BEQ   cq1   
E332   60                     RTS      ; into the loop
E333   68           CQ1:      PLA      
E334   68                     PLA      ; the step frame
E335   4C 2D E2               JMP   pkey   
E338                          ENDIF      
E338                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E338                             ; the matching ")".
E338   20 5E E5     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E33B                          IF   1-CHECKED   
E33B   F0 36                  BEQ   skip   
E33D                          ENDIF      
E33D                          IF   CHECKED   
                              BEQ   skpar   
E33D                          ENDIF      
E33D                             ; pushn: take the step frame off, push the reading position on the return
E33D                             ; stack, and go on. With the carry set (a word call) the reading position
E33D                             ; then becomes the address in the letter cell at LET,Y.
E33D   68           PUSHN:    PLA      
E33E   68                     PLA      ; drop the step frame
E33F   A5 01                  LDA   IP+1   
E341   48                     PHA      
E342   A5 00                  LDA   IP   
E344   48                     PHA      
E345   90 0A                  BCC   nxt   
E347   B9 00 04               LDA   LET,Y   
E34A   85 00                  STA   IP   
E34C   B9 01 04               LDA   LET+1,Y   
E34F   85 01                  STA   IP+1   
E351   4C 28 E2     NXT:      JMP   pnext   
E354                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E354                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E354                             ; the body"s address instead. Either way it then skips to the matching "]'.
E354                             ; (The unchecked build takes anything that is not a letter as the space; the
E354                             ; checked build stops on it.)
E354                          IF   CHECKED   
                    DEF1:     CPY   #" "-"A"+256   
                              BEQ   def2   
                                 ; W: anything but a letter or a space after [. The place is that character,
                                 ; one past the [.
                              INC   PLACE   
                              BNE   eb1   
                              INC   PLACE+1   
                    EB1:      LDA   #"W"   
E354                          ENDIF      
E354                          IF   CHECKED*(1-QK)   
                              BNE   ejmp2   ; always
E354                          ENDIF      
E354                          IF   CHECKED*QK   
                              JMP   error   ; (the skip cache moved ejmp2 out of reach)
E354                          ENDIF      
E354                          IF   CHECKED   
                                 ; A false ( skips: the wrong closer for it is ].
                    SKPAR:    LDA   #"]"   
                              BNE   skip   ; always
E354                          ENDIF      
E354   20 49 E5     H_DEF:    JSR   getc   
E357   38                     SEC      
E358   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E35A   A8                     TAY      ;   lands 64 bytes up
E35B   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E35D   C9 1A                  CMP   #26   
E35F                          IF   1-CHECKED   
E35F   B0 0F                  BCS   def2   ; not a letter
E361                          ENDIF      
E361                          IF   CHECKED   
                              BCS   def1   
E361                          ENDIF      
E361   98                     TYA      
E362   0A                     ASL      
E363   A8                     TAY      ; Y -> the cell
E364   A5 00                  LDA   IP   
E366   99 00 04               STA   LET,Y   
E369   A5 01                  LDA   IP+1   
E36B   99 01 04               STA   LET+1,Y   
E36E   D0 03                  BNE   skdef   ; always: no program is in page zero
E370   20 06 E3     DEF2:     JSR   puship   ; an anonymous block: push its address
E373                SKDEF:       
E373                          IF   CHECKED   
                              LDA   #")"   ; the wrong closer for [
E373                          ENDIF      
E373                             ; skip: read past text to the closer at this level, and return it in A.
E373                             ; Brackets of both kinds count together; strings are stepped over whole. A
E373                             ; NUL first ends the program.
E373                             ; In the checked build A holds, on the way in, the wrong closer for the
E373                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E373                             ; which takes either. Meeting the wrong closer at this level, or the end
E373                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E373                             ; which then ends the program as before.
E373                SKIP:        
E373                          IF   CHECKED   
                              STA   T0   
E373                          ENDIF      
E373                          IF   1-QK   
                              LDA   #0   
                              STA   D1   ; depth
                    SK1:      JSR   getc   
E373                          ENDIF      
E373                          IF   (1-QK)*(1-CHECKED)   
                              BEQ   endprog   
E373                          ENDIF      
E373                          IF   (1-QK)*CHECKED   
                              BEQ   sknul   
E373                          ENDIF      
E373                          IF   1-QK   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 22h (11h when checked), which
                                 ;   matches nothing below
E373                          ENDIF      
E373                          IF   (1-QK)*CHECKED   
                              BEQ   sknul   ; the string ran into the end
E373                          ENDIF      
E373                          IF   1-QK   
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   D1   
                              BPL   sk1   
E373                          ENDIF      
E373                          IF   (1-QK)*CHECKED   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
E373                          ENDIF      
E373                          IF   1-QK   
                              RTS      ; the closer at this level
                    SK3:      INC   D1   
                              BNE   sk1   
E373                          ENDIF      
E373                          IF   QK   
E373                             ; The skip cache (QK builds). Nearly every skip is one that has happened
E373                             ; before (a loop skips the same false block on every pass), so the first
E373                             ; scan from each place is remembered: 64 entries of {start, the closer's
E373                             ; address}, in CPAGE, found by the start's low byte times 4. Only skips that
E373                             ; start in the program text are kept (the line buffer changes); the cache is
E373                             ; emptied when the program starts. A program that changes its own text while
E373                             ; it runs is not looked after.
E373   A5 01                  LDA   IP+1   
E375   C9 05                  CMP   #>PROG   
E377   90 24                  BCC   sks   ; below the program text: no cache
E379   A5 00                  LDA   IP   
E37B   0A                     ASL      
E37C   0A                     ASL      
E37D   A8                     TAY      ; Y -> the entry
E37E   A5 00                  LDA   IP   
E380   D9 00 DF               CMP   CPAGE*256,Y   
E383   D0 18                  BNE   sks   
E385   A5 01                  LDA   IP+1   
E387   D9 01 DF               CMP   CPAGE*256+1,Y   
E38A   D0 11                  BNE   sks   
E38C   B9 02 DF               LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
E38F   85 00                  STA   IP   ;   read
E391   B9 03 DF               LDA   CPAGE*256+3,Y   
E394   85 01                  STA   IP+1   
E396   A0 00                  LDY   #0   
E398   B1 00                  LDA   (IP),Y   
E39A   4C 4C E5               JMP   incip   
E39D   A5 00        SKS:      LDA   IP   
E39F   85 05                  STA   SKL   
E3A1   A5 01                  LDA   IP+1   
E3A3   85 08                  STA   SKH   
E3A5   A0 00                  LDY   #0   
E3A7   84 09                  STY   D1   ; depth
E3A9                             ; The scan reads at IP+Y. Most characters are nothing to it, and two range
E3A9                             ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
E3A9   B1 00        SQ1:      LDA   (IP),Y   
E3AB   C8                     INY      
E3AC   F0 1D                  BEQ   sqw   
E3AE   C9 5E        SQ2:      CMP   #5Eh   
E3B0   B0 F7                  BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E3B2   C9 5B                  CMP   #5Bh   
E3B4   B0 28                  BCS   sqb   ; [ \ ]
E3B6   C9 2A                  CMP   #2Ah   
E3B8   B0 EF                  BCS   sq1   ; * to Z: nothing
E3BA   C9 28                  CMP   #28h   
E3BC   F0 1B                  BEQ   sqo   ; (
E3BE   B0 24                  BCS   sqc   ; )
E3C0   C9 22                  CMP   #22h   
E3C2   F0 0B                  BEQ   sqq   ; a string
E3C4   C9 01                  CMP   #1   
E3C6   B0 E1                  BCS   sq1   ; the rest below "(": nothing
E3C8                          ENDIF      
E3C8                          IF   QK*(1-CHECKED)   
E3C8   4C 09 FF               JMP   EXIT   ; NUL: the end of the program
E3CB                          ENDIF      
E3CB                          IF   QK*CHECKED   
                              JMP   sknul   
E3CB                          ENDIF      
E3CB                          IF   QK   
E3CB   E6 01        SQW:      INC   IP+1   ; Y went round: on into the next page
E3CD   D0 DF                  BNE   sq2   ; always
E3CF   20 12 E4     SQQ:      JSR   sqip   ; a string: step over it
E3D2   20 22 E4               JSR   skipstr   
E3D5                          ENDIF      
E3D5                          IF   QK*CHECKED   
                              BEQ   sknul   ; the string ran into the end
E3D5                          ENDIF      
E3D5                          IF   QK   
E3D5   A0 00                  LDY   #0   
E3D7   F0 D0                  BEQ   sq1   ; always
E3D9   E6 09        SQO:      INC   D1   ; an opener
E3DB   4C A9 E3               JMP   sq1   
E3DE   C9 5C        SQB:      CMP   #5Ch   
E3E0   F0 C7                  BEQ   sq1   ; "\" is nothing here
E3E2   90 F5                  BCC   sqo   ; [
E3E4   C6 09        SQC:      DEC   D1   ; ) ]
E3E6   10 C1                  BPL   sq1   
E3E8   20 12 E4               JSR   sqip   ; the closer at this level: the IP past it
E3EB                          ENDIF      
E3EB                          IF   QK*CHECKED   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
E3EB                          ENDIF      
E3EB                          IF   QK   
E3EB   48                     PHA      
E3EC   A5 08                  LDA   SKH   ; remember the skip, if it started in the
E3EE   C9 05                  CMP   #>PROG   ;   program text
E3F0   90 1E                  BCC   sq9   
E3F2   A5 05                  LDA   SKL   
E3F4   0A                     ASL      
E3F5   0A                     ASL      
E3F6   A8                     TAY      
E3F7   A5 05                  LDA   SKL   
E3F9   99 00 DF               STA   CPAGE*256,Y   
E3FC   A5 08                  LDA   SKH   
E3FE   99 01 DF               STA   CPAGE*256+1,Y   
E401   A5 00                  LDA   IP   
E403   38                     SEC      
E404   E9 01                  SBC   #1   
E406   99 02 DF               STA   CPAGE*256+2,Y   ; the closer's address
E409   A5 01                  LDA   IP+1   
E40B   E9 00                  SBC   #0   
E40D   99 03 DF               STA   CPAGE*256+3,Y   
E410   68           SQ9:      PLA      
E411   60                     RTS      ; the closer at this level
E412                             ; sqip: IP = IP + Y. Keeps A.
E412   48           SQIP:     PHA      
E413   98                     TYA      
E414   18                     CLC      
E415   65 00                  ADC   IP   
E417   85 00                  STA   IP   
E419   90 02                  BCC   sp1   
E41B   E6 01                  INC   IP+1   
E41D   68           SP1:      PLA      
E41E   60                     RTS      
E41F                          ENDIF      
E41F                          IF   CHECKED   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                                 ; The end of "$" (h_print): the string's address goes back into TOS; then a
                                 ; closing quote drops it, and a NUL (the carry clear) is Q.
                    PQ:       PLA      
                              STA   TL   
                              PLA      
                              STA   TH   
                              BCS   pdrop   
                              CPX   #DSE   ; a NUL: Q, unless "$" had nothing on the
                              LDA   #"s"   ;   stack at all (X at the empty mark): s
                              BCS   ejmp2   
                    E_QUOTE:   LDA   #"Q"   ; a string runs into the end
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                    EJMP2:    JMP   error   ;   or the end: the place is the opener
E41F                          ENDIF      
E41F                             ; 22h pushes the address of the text after it and skips the string.
E41F   20 06 E3     H_STR:    JSR   puship   
E422                          IF   CHECKED   
                              JSR   skipstr   
                              BEQ   e_quote   ; it ran into the end: the place is the 22h
                              RTS      
E422                          ENDIF      
E422                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E422                             ; the next character, so "/"" does not end it.
E422                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E422                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E422                             ; text ended first (a NUL, also one just after "/").
E422                          IF   1-CHECKED   
E422   20 49 E5     SKIPSTR:   JSR   getc   
E425   C9 2F                  CMP   #"/"   
E427   F0 05                  BEQ   ss0   
E429   C9 22                  CMP   #22h   
E42B   D0 F5                  BNE   skipstr   
E42D   60                     RTS      
E42E   20 4C E5     SS0:      JSR   incip   
E431   D0 EF                  BNE   skipstr   ; A is "/" here
E433                          ENDIF      
E433                          IF   CHECKED   
                    SKIPSTR:   JSR   getc   
                              BEQ   ss9   ; the end
                              CMP   #"/"   
                              BNE   ss1   
                              JSR   getc   ; the escaped character
                              BNE   skipstr   
                    SS9:      RTS      ; the end, just after "/"
                    SS1:      CMP   #22h   
                              BNE   skipstr   
                              LSR      ; A = 11h, Z clear
                              RTS      
E433                          ENDIF      
E433                             ; =============================================================================
E433                             ;  Console
E433                             ; =============================================================================
E433                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E433                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E433                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
E433                             ; no bit 6, so // and /" give themselves). TOS walks along the string; the
E433                             ; checked build keeps the address on the hardware stack meanwhile, for a Q
E433                             ; report (see pq).
E433                          IF   CHECKED   
                    H_PRINT:   LDA   TH   
                              PHA      
                              LDA   TL   
                              PHA      
                              BCC   pr0   ; always: the carry is clear on the way in
E433                          ENDIF      
E433                          IF   1-CHECKED   
E433                H_PRINT:   EQU   pr0   
E433                          ENDIF      
E433   20 67 E4     PESC0:    JSR   pesc   ; (an escape, and back into the loop)
E436   20 5C E4     PR0:      JSR   tosget   
E439   C9 22                  CMP   #22h   
E43B                          IF   1-CHECKED   
E43B   F0 1C                  BEQ   pdrop   
E43D                          ENDIF      
E43D                          IF   CHECKED   
                              BEQ   pq   ; the closing quote, with the carry set
                              TAY      ; (Y is free here)
                              BEQ   pq   ; a NUL, with the carry clear
E43D                          ENDIF      
E43D   C9 2F                  CMP   #"/"   
E43F   D0 0D                  BNE   pr1   
E441   20 5C E4               JSR   tosget   
E444   C9 60                  CMP   #60h   
E446   90 04                  BCC   pr2   
E448   C9 7F                  CMP   #7Fh   
E44A   90 E7                  BCC   pesc0   ; 60h-7Eh, and the carry is clear
E44C   29 BF        PR2:      AND   #0BFh   
E44E   20 03 FF     PR1:      JSR   CONOUT   
E451   4C 36 E4               JMP   pr0   
E454   A5 02        H_EMIT:   LDA   TL   ; "'"
E456   20 03 FF               JSR   CONOUT   
E459   4C 76 E5     PDROP:    JMP   drop   
E45C                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E45C   A0 00        TOSGET:   LDY   #0   
E45E   B1 02                  LDA   (TL),Y   
E460   E6 02        INCTOS:   INC   TL   
E462   D0 02                  BNE   tg1   
E464   E6 03                  INC   TH   
E466   60           TG1:      RTS      
E467                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E467                             ; the carry is clear. Each returns into the loop.
E467                             ;    /a-/z   print the variable, as "#" does
E467                             ;    /{      clear the screen, the cursor to the top left
E467                             ;    /}      clear from the cursor to the end of the line
E467                             ;    /|  /`  show the cursor, hide it
E467                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E467                             ;            from 0. The two cells under TOS (the string's address) go.
E467                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E467                             ; E6h-FFh with it clear.
E467                          IF   1-ANSI   
E467                             ; With ANSI = 0 the machine's routines do the work.
E467   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E469   90 0D                  BCC   pe1   
E46B   F0 08                  BEQ   pcls   ; {
E46D   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E46E   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E470   B0 0D                  BCS   pat   ; ~
E472   4C 0F FF               JMP   CONEOL   ; }
E475   4C 0C FF     PCLS:     JMP   CONCLS   
E478   C9 E6        PE1:      CMP   #0E6h   
E47A   B0 0E                  BCS   pvar   
E47C   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E47F                          ENDIF      
E47F                             ; /~: the column is NOS, the row the cell under it.
E47F                PAT:         
E47F                          IF   CHECKED   
                              CPX   #DSE-2   ; fewer than two cells under TOS: s
                              BCS   e_atu   
E47F                          ENDIF      
E47F                          IF   1-ANSI   
E47F   BC 00 02               LDY   DSL,X   ; the column
E482   BD 01 02               LDA   DSL+1,X   ; the row
E485   E8                     INX      
E486   E8                     INX      
E487   4C 15 FF               JMP   CONAT   
E48A                          ENDIF      
E48A                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). The row's cell and TOS change
                                 ; places first: then "#" prints the row and drops it, prints the column and
                                 ; drops it, and TOS is the string's address again.
                              INX      
                              JSR   h_swap   
                              DEX      
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E48A                          ENDIF      
E48A                          IF   CHECKED   
                    E_ATU:    JMP   e_stack   ; (X is FAh-FCh: an underflow)
E48A                          ENDIF      
E48A                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E48A                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' (next)
E48A                             ; prints it and drops it: TOS is the string's address again.
E48A   69 39        PVAR:     ADC   #39h   
E48C   20 01 E3               JSR   lower   
E48F   20 68 EA               JSR   h_fetch   
E492                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E492                             ; digits are divided off and held on the hardware stack, ended by a 0.
E492   A5 03        H_NUM:    LDA   TH   
E494   10 08                  BPL   pn1   
E496   A9 2D                  LDA   #"-"   
E498   20 03 FF               JSR   CONOUT   
E49B   20 D2 E5               JSR   neg   
E49E   A9 0A        PN1:      LDA   #10   
E4A0   85 08                  STA   D0   
E4A2   A9 00                  LDA   #0   
E4A4   85 09                  STA   D1   
E4A6   48                     PHA      ; the end marker
E4A7   20 80 E8     PN2:      JSR   udiv   
E4AA   A5 04                  LDA   T0   ; the remainder
E4AC   09 30                  ORA   #"0"   
E4AE   48                     PHA      
E4AF   A5 02                  LDA   TL   
E4B1   05 03                  ORA   TH   
E4B3   D0 F2                  BNE   pn2   
E4B5   68           PN3:      PLA      
E4B6   F0 A1                  BEQ   pdrop   
E4B8   20 03 FF               JSR   CONOUT   
E4BB   4C B5 E4               JMP   pn3   
E4BE                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into. (It sits here, just above prs, for that.)
                    PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh). Y is 0, as
                                 ;   tosget leaves it, and M_CLS is the first
                                 ;   message: Y already points at it
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E4BE                          ENDIF      
E4BE                          IF   CHECKED+ANSI   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
E4BE                          ENDIF      
E4BE                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   ; (the first: pesc counts on it)
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
E4BE                          ENDIF      
E4BE                          IF   CHECKED   
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"D",":"+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"R",":"+80h   
E4BE                          ENDIF      
E4BE                             ; =============================================================================
E4BE                             ;  Dispatch table: one handler per punctuation character, in code order.
E4BE                             ;  Entries are handler-1 for the RTS trick.
E4BE                             ; =============================================================================
E4BE   66 E5        PTAB:     DW   h_store-1   ; !
E4C0   1E E4                  DW   h_str-1   ; "
E4C2   91 E4                  DW   h_num-1   ; #
E4C4   35 E4                  DW   h_print-1   ; $
E4C6   29 E8                  DW   h_swap-1   ; %
E4C8   81 E5                  DW   h_and-1   ; &
E4CA   53 E4                  DW   h_emit-1   ; '
E4CC   37 E3                  DW   h_open-1   ; (
E4CE   53 E2                  DW   h_close-1   ; )
E4D0   04 E6                  DW   h_mul-1   ; *
E4D2   B3 E5                  DW   h_add-1   ; +
E4D4   73 EA                  DW   h_cfetch-1   ; ,
E4D6   AB E5                  DW   h_sub-1   ; -
E4D8   6D E5                  DW   h_cstore-1   ; .
E4DA   3E E8                  DW   h_div-1   ; /
E4DC   13 E3                  DW   push-1   ; :
E4DE   75 E5                  DW   drop-1   ; ;
E4E0   E2 E5                  DW   h_lt-1   ; <
E4E2   F4 E5                  DW   h_eq-1   ; =
E4E4   DF E5                  DW   h_gt-1   ; >
E4E6   7C EA                  DW   h_key-1   ; ?
E4E8   67 EA                  DW   h_fetch-1   ; @
E4EA   53 E3                  DW   h_def-1   ; [
E4EC   6C E2                  DW   h_break-1   ; \
E4EE   5B E2                  DW   h_ret-1   ; ]
E4F0   9D E5                  DW   h_xor-1   ; ^
E4F2   68 E8                  DW   h_alloc-1   ; _
E4F4   DA EA                  DW   h_grave-1   ; `
E4F6   39 E2                  DW   h_tor-1   ; {
E4F8   8F E5                  DW   h_or-1   ; |
E4FA   46 E2                  DW   h_fromr-1   ; }
E4FC   CB E5                  DW   h_not-1   ; ~
E4FE                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E4FE                             ; test is at the bottom so the loop closes with a branch. Returns with the
E4FE                             ; carry set.
E4FE   20 4C E5     RD1:      JSR   incip   ; (keeps A = the digit)
E501   06 02                  ASL   TL   
E503   26 03                  ROL   TH   ; x2
E505   18                     CLC      
E506   65 02                  ADC   TL   
E508   85 04                  STA   T0   
E50A   A5 03                  LDA   TH   
E50C   69 00                  ADC   #0   
E50E   A8                     TAY      ; Y:T0 = x2 + digit
E50F   06 02                  ASL   TL   
E511   26 03                  ROL   TH   
E513   06 02                  ASL   TL   
E515   26 03                  ROL   TH   ; x8
E517   18                     CLC      
E518   A5 02                  LDA   TL   
E51A   65 04                  ADC   T0   
E51C   85 02                  STA   TL   
E51E   98                     TYA      
E51F   65 03                  ADC   TH   
E521   85 03                  STA   TH   ; x8 + x2 + digit
E523   20 29 E5     RDNUM:    JSR   isdig   
E526   90 D6                  BCC   rd1   
E528   60                     RTS      
E529                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E529                             ; digit. Y = 0.
E529   20 44 E5     ISDIG:    JSR   peek   
E52C   38                     SEC      
E52D   E9 30                  SBC   #"0"   
E52F   C9 0A                  CMP   #10   
E531   60                     RTS      
E532                             ; =============================================================================
E532                             ;  Reading the program
E532                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E532                             ;    getc: the same, then IP moves on; flags follow A
E532                             ;    incip: IP moves on; keeps A, the carry and Y
E532                             ; =============================================================================
E532                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E532                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E532                             ; Y = 0.
E532   20 29 E5     RDHEX:    JSR   isdig   
E535   90 0A                  BCC   rh1   
E537   29 DF                  AND   #0DFh   
E539   E9 11                  SBC   #11h   ; (the carry is set)
E53B   C9 06                  CMP   #6   
E53D   B0 04                  BCS   rh9   
E53F   69 0A                  ADC   #10   
E541   90 09        RH1:      BCC   incip   ; always: the carry is clear
E543   60           RH9:      RTS      
E544   A0 00        PEEK:     LDY   #0   
E546   B1 00                  LDA   (IP),Y   
E548   60                     RTS      
E549   20 44 E5     GETC:     JSR   peek   
E54C   E6 00        INCIP:    INC   IP   
E54E   D0 02                  BNE   ic1   
E550   E6 01                  INC   IP+1   
E552   09 00        IC1:      ORA   #0   
E554   60                     RTS      
E555                             ; rstip: point IP at the start of the program
E555   A9 00        RSTIP:    LDA   #<PROG   
E557   85 00                  STA   IP   
E559   A9 05                  LDA   #>PROG   
E55B   85 01                  STA   IP+1   
E55D   60                     RTS      
E55E                             ; =============================================================================
E55E                             ;  Stack
E55E                             ; =============================================================================
E55E                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E55E   A5 02        FLAG:     LDA   TL   
E560   05 03                  ORA   TH   
E562   20 76 E5               JSR   drop   
E565   A8                     TAY      ; (drop's INX changed the flags)
E566   60                     RTS      
E567                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E567                H_STORE:      
E567                          IF   CHECKED   
                              LDA   TL   ; both bytes must be in the program's space:
                              ADC   #1   ; check the page of addr+1 (the carry is
                              LDA   TH   ; clear on the way in)
                              ADC   #0   
                              JSR   chkst   
E567                          ENDIF      
E567   BD 00 03               LDA   DSH,X   
E56A   A0 01                  LDY   #1   
E56C   91 02                  STA   (TL),Y   
E56E                H_CSTORE:      ; "." ( c addr -- )
E56E                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E56E                          ENDIF      
E56E   BD 00 02               LDA   DSL,X   
E571   A0 00                  LDY   #0   
E573   91 02                  STA   (TL),Y   
E575   E8                     INX      ; falls into drop
E576                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E576                             ; it returns with Z clear.
E576   BC 00 02     DROP:     LDY   DSL,X   
E579   84 02                  STY   TL   
E57B   BC 00 03               LDY   DSH,X   
E57E   84 03                  STY   TH   
E580   E8                     INX      
E581   60                     RTS      
E582                             ; =============================================================================
E582                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E582                             ; =============================================================================
E582                             ; The logic operators leave the carry as they found it, clear, so they can
E582                             ; branch to fin.
E582   BD 00 02     H_AND:    LDA   DSL,X   
E585   25 02                  AND   TL   
E587   85 02                  STA   TL   
E589   BD 00 03               LDA   DSH,X   
E58C   25 03                  AND   TH   
E58E   90 31                  BCC   fin   ; always
E590   BD 00 02     H_OR:     LDA   DSL,X   
E593   05 02                  ORA   TL   
E595   85 02                  STA   TL   
E597   BD 00 03               LDA   DSH,X   
E59A   05 03                  ORA   TH   
E59C   90 23                  BCC   fin   ; always
E59E   BD 00 02     H_XOR:    LDA   DSL,X   
E5A1   45 02                  EOR   TL   
E5A3   85 02                  STA   TL   
E5A5   BD 00 03               LDA   DSH,X   
E5A8   45 03                  EOR   TH   
E5AA   90 15                  BCC   fin   ; always
E5AC                             ; "-" has two jobs: directly before a digit it starts a negative number.
E5AC   20 29 E5     H_SUB:    JSR   isdig   
E5AF   90 14                  BCC   negnum   
E5B1   20 D2 E5     SUB1:     JSR   neg   ; a - b = a + (-b)
E5B4   18           H_ADD:    CLC      
E5B5   BD 00 02               LDA   DSL,X   
E5B8   65 02                  ADC   TL   
E5BA   85 02                  STA   TL   
E5BC   BD 00 03               LDA   DSH,X   
E5BF   65 03                  ADC   TH   ; falls into fin
E5C1                             ; fin: finish a two-operand op: A = the high byte of the result
E5C1   85 03        FIN:      STA   TH   
E5C3   E8                     INX      
E5C4   60                     RTS      
E5C5   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E5C7   20 F9 E2               JSR   digit   ; (comes back with the carry set)
E5CA   B0 06                  BCS   neg   ; always: the number, negated
E5CC                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E5CC   90 05        H_NOT:    BCC   neg1   ; always
E5CE                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E5CE   A5 03        ABSV:     LDA   TH   
E5D0   10 0D        NEGM:     BPL   ab9   
E5D2                             ; neg: TOS = -TOS
E5D2   38           NEG:      SEC      
E5D3   A9 00        NEG1:     LDA   #0   
E5D5   E5 02                  SBC   TL   
E5D7   85 02                  STA   TL   
E5D9   A9 00                  LDA   #0   
E5DB   E5 03                  SBC   TH   
E5DD   85 03                  STA   TH   
E5DF   60           AB9:      RTS      
E5E0                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E5E0                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E5E0   20 2A E8     H_GT:     JSR   h_swap   ; a > b is b < a
E5E3   BD 00 02     H_LT:     LDA   DSL,X   
E5E6   C5 02                  CMP   TL   
E5E8   BD 00 03               LDA   DSH,X   
E5EB   E5 03                  SBC   TH   
E5ED   70 02                  BVS   lt1   
E5EF   49 80                  EOR   #80h   
E5F1   0A           LT1:      ASL      
E5F2   E8                     INX      ; (keeps the carry; never leaves X at 0)
E5F3   D0 07                  BNE   bool   ; always
E5F5   20 B1 E5     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E5F8   05 02                  ORA   TL   
E5FA   C9 01                  CMP   #1   ; carry clear if A = 0
E5FC   A9 00        BOOL:     LDA   #0   
E5FE   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E600   85 02                  STA   TL   
E602   85 03                  STA   TH   
E604   60                     RTS      
E605                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E605                             ; bottom while the product comes in at the top, through A:T0 above it; after
E605                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E605                          IF   FAST   
E605                             ; (the fast build: as QK below, the rounds unrolled, with Y for the upper
E605                             ; half's high byte while the low one is added)
E605   A5 03        H_MUL:    LDA   TH   
E607   F0 0B                  BEQ   mq8   
E609   BD 00 03               LDA   DSH,X   
E60C   F0 03                  BEQ   mqs   
E60E   4C C0 E6               JMP   mq16   ; (out of a branch's reach)
E611   20 2A E8     MQS:      JSR   h_swap   
E614   A9 00        MQ8:      LDA   #0   
E616   85 04                  STA   T0   
E618   46 02                  LSR   TL   
E61A   90 0D                  BCC   mu0   
E61C   A8                     TAY      
E61D   18                     CLC      
E61E   A5 04                  LDA   T0   
E620   7D 00 02               ADC   DSL,X   
E623   85 04                  STA   T0   
E625   98                     TYA      
E626   7D 00 03               ADC   DSH,X   
E629   6A           MU0:      ROR      
E62A   66 04                  ROR   T0   
E62C   66 02                  ROR   TL   
E62E   90 0D                  BCC   mu1   
E630   A8                     TAY      
E631   18                     CLC      
E632   A5 04                  LDA   T0   
E634   7D 00 02               ADC   DSL,X   
E637   85 04                  STA   T0   
E639   98                     TYA      
E63A   7D 00 03               ADC   DSH,X   
E63D   6A           MU1:      ROR      
E63E   66 04                  ROR   T0   
E640   66 02                  ROR   TL   
E642   90 0D                  BCC   mu2   
E644   A8                     TAY      
E645   18                     CLC      
E646   A5 04                  LDA   T0   
E648   7D 00 02               ADC   DSL,X   
E64B   85 04                  STA   T0   
E64D   98                     TYA      
E64E   7D 00 03               ADC   DSH,X   
E651   6A           MU2:      ROR      
E652   66 04                  ROR   T0   
