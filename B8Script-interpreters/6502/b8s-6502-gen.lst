0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        Dividing by zero is not checked. -n? does no more editing than
0000                             ;        Backspace.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page. b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  One switch, set in the EQU line below:
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C
0000                             ;               (= z10+), KEYBUF at +34, the -n? line buffer at +80..+FF
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003   20 7B E1               JSR   rstip   
E006   20 6F E1     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B                          IF   CHECKED   
                              STA   KEYBUF   ; (A = 0) no key held back
E00B                          ENDIF      
E00B   A5 00                  LDA   IP   
E00D   8D 7C 04               STA   HEAP   
E010   A5 01                  LDA   IP+1   
E012   8D 7D 04               STA   HEAP+1   
E015   20 7B E1               JSR   rstip   
E018   A2 FC                  LDX   #DSE   
E01A                             ; =============================================================================
E01A                             ;  The inner loop
E01A                             ; =============================================================================
E01A                NEXT:        
E01A                          IF   CHECKED   
                                 ; Both stacks are checked once per character. The data stack has
                                 ; overrun when X is above DSE (an overflow wraps X to FF, an underflow
                                 ; moves it up; no handler moves X by more than 2). The return stack
                                 ; has when S is below RSLIM (an underflow wraps S to 00-03).
                              CPX   #DSE+1   
                              BCS   e_stack   
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
E01A                          ENDIF      
E01A   20 20 E0               JSR   step   
E01D   4C 1A E0               JMP   next   
E020                             ; step: read one character and sort it by range.
E020                             ;    00h          end of program
E020                             ;    01h-20h, 7Fh-FFh   ignored
E020                             ;    30h-39h      digit: read a whole number
E020                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E020                             ;    61h-7Ah      a-z: push the address of that letter's cell
E020                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E020                             ; Every way out of the sort has the carry clear, except "ignored".
E020   20 6F E1     STEP:     JSR   getc   ; flags follow A
E023   F0 36                  BEQ   endprog   
E025   38                     SEC      
E026   E9 21                  SBC   #21h   ; A = c - 21h
E028   90 30                  BCC   ign   ; 01h-20h
E02A   C9 0F                  CMP   #0Fh   
E02C   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E02E   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E030   C9 0A                  CMP   #10   
E032   90 2A                  BCC   digit   
E034   C9 11                  CMP   #11h   
E036   90 16                  BCC   p3a   ; 3Ah-40h
E038   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E03A   C9 1A                  CMP   #1Ah   
E03C   90 55                  BCC   upper   ; 41h-5Ah
E03E   C9 20                  CMP   #20h   
E040   90 0A                  BCC   p5b   ; 5Bh-60h
E042   C9 3A                  CMP   #3Ah   
E044   90 25                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E046   C9 3E                  CMP   #3Eh   
E048   B0 10                  BCS   ign   ; 7Fh-FFh
E04A                             ; The three adjustments below chain. Each ADC adds the carry the one
E04A                             ; before it left, which the constants allow for.
E04A   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E04C   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E04E   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E050   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E051   A8                     TAY      
E052   B9 F5 E0               LDA   PTAB+1,Y   
E055   48                     PHA      
E056   B9 F4 E0               LDA   PTAB,Y   
E059   48                     PHA      
E05A   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E05B                             ; directly, it just ends an ignored character.
E05B   4C 09 FF     ENDPROG:   JMP   EXIT   
E05E                          IF   CHECKED   
                    E_STACK:   LDA   #"S"   ; data stack over or under
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RSTACK:   LDA   #"R"   ; return stack over or under
                              JMP   error   
E05E                          ENDIF      
E05E                             ; Digits: the first one is in A; read the rest of the number.
E05E   A8           DIGIT:    TAY      
E05F   20 90 E1               JSR   push   
E062   84 02                  STY   TL   
E064   A9 00                  LDA   #0   
E066   85 03                  STA   TH   
E068   4C 5B E1               JMP   rdnum   
E06B                             ; a-z: push the cell's address (the cell is the variable)
E06B   0A           LOWER:    ASL      
E06C   A8                     TAY      
E06D   20 90 E1               JSR   push   
E070   84 02                  STY   TL   
E072   A9 04                  LDA   #>LET   
E074   85 03                  STA   TH   
E076   60                     RTS      
E077                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E077                             ; the matching ")".
E077   20 9C E1     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E07A   F0 3B                  BEQ   skip   
E07C                             ; pushn: take the step frame off, push the reading position on the return
E07C                             ; stack, and go on. With the carry set (a word call) the reading position
E07C                             ; then becomes the address in the letter cell at LET,Y.
E07C   68           PUSHN:    PLA      
E07D   68                     PLA      ; drop the step frame
E07E   A5 01                  LDA   IP+1   
E080   48                     PHA      
E081   A5 00                  LDA   IP   
E083   48                     PHA      
E084   90 0A                  BCC   nxt   
E086   B9 00 04               LDA   LET,Y   
E089   85 00                  STA   IP   
E08B   B9 01 04               LDA   LET+1,Y   
E08E   85 01                  STA   IP+1   
E090   4C 1A E0     NXT:      JMP   next   
E093                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E093                             ; the return stack, and the IP becomes the address in the letter's cell.
E093   0A           UPPER:    ASL      
E094   A8                     TAY      
E095   38                     SEC      
E096   B0 E4                  BCS   pushn   ; always
E098                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E098                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E098                             ; the body"s address instead. Either way it then skips to the matching "]'.
E098                             ; (The unchecked build takes anything that is not a letter as the space; the
E098                             ; checked build stops on it.)
E098                          IF   CHECKED   
                    DEF1:     CPY   #" "-"A"+256   
                              BEQ   def2   
                              BNE   e_brack   ; anything but a letter or a space
E098                          ENDIF      
E098   20 6F E1     H_DEF:    JSR   getc   
E09B   38                     SEC      
E09C   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E09E   A8                     TAY      ;   lands 64 bytes up
E09F   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E0A1   C9 1A                  CMP   #26   
E0A3                          IF   1-CHECKED   
E0A3   B0 0F                  BCS   def2   ; not a letter
E0A5                          ENDIF      
E0A5                          IF   CHECKED   
                              BCS   def1   
E0A5                          ENDIF      
E0A5   98                     TYA      
E0A6   0A                     ASL      
E0A7   A8                     TAY      ; Y -> the cell
E0A8   A5 00                  LDA   IP   
E0AA   99 00 04               STA   LET,Y   
E0AD   A5 01                  LDA   IP+1   
E0AF   99 01 04               STA   LET+1,Y   
E0B2   D0 03                  BNE   skip   ; always: no program is in page zero
E0B4   20 84 E1     DEF2:     JSR   puship   ; an anonymous block: push its address
E0B7                             ; skip: read past text to the closer at this level, and return it in A.
E0B7                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0B7                             ; NUL first ends the program.
E0B7   A9 00        SKIP:     LDA   #0   
E0B9   85 06                  STA   T2   ; depth
E0BB   20 6F E1     SK1:      JSR   getc   
E0BE   F0 9B                  BEQ   endprog   
E0C0   C9 22                  CMP   #22h   
E0C2   D0 03                  BNE   sk2   
E0C4   20 E3 E0               JSR   skipstr   ; leaves A = 22h, which matches nothing below
E0C7   C9 28        SK2:      CMP   #"("   
E0C9   F0 11                  BEQ   sk3   
E0CB   C9 5B                  CMP   #"["   
E0CD   F0 0D                  BEQ   sk3   
E0CF   C9 29                  CMP   #")"   
E0D1   F0 04                  BEQ   sk4   
E0D3   C9 5D                  CMP   #"]"   
E0D5   D0 E4                  BNE   sk1   
E0D7   C6 06        SK4:      DEC   T2   
E0D9   10 E0                  BPL   sk1   
E0DB   60                     RTS      ; the closer at this level
E0DC   E6 06        SK3:      INC   T2   
E0DE   D0 DB                  BNE   sk1   
E0E0                          IF   CHECKED   
                    E_BRACK:   LDA   #"D"   ; bad character after [
                              JMP   error   
E0E0                          ENDIF      
E0E0                             ; 22h pushes the address of the text after it and skips the string.
E0E0   20 84 E1     H_STR:    JSR   puship   
E0E3                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E0E3                             ; the next character, so "/"" does not end it. Returns with Z set, A = 22h.
E0E3   20 6F E1     SKIPSTR:   JSR   getc   
E0E6   C9 2F                  CMP   #"/"   
E0E8   F0 05                  BEQ   ss0   
E0EA   C9 22                  CMP   #22h   
E0EC   D0 F5                  BNE   skipstr   
E0EE   60                     RTS      
E0EF   20 72 E1     SS0:      JSR   incip   
E0F2   D0 EF                  BNE   skipstr   ; A is "/" here
E0F4                             ; =============================================================================
E0F4                             ;  Dispatch table: one handler per punctuation character, in code order.
E0F4                             ;  Entries are handler-1 for the RTS trick.
E0F4                             ; =============================================================================
E0F4   A4 E1        PTAB:     DW   h_store-1   ; !
E0F6   DF E0                  DW   h_str-1   ; "
E0F8   72 E3                  DW   h_num-1   ; #
E0FA   54 E3                  DW   h_print-1   ; $
E0FC   AF E2                  DW   h_swap-1   ; %
E0FE   04 E2                  DW   h_and-1   ; &
E100   6A E3                  DW   h_emit-1   ; '
E102   76 E0                  DW   h_open-1   ; (
E104   DA E1                  DW   h_close-1   ; )
E106   87 E2                  DW   h_mul-1   ; *
E108   36 E2                  DW   h_add-1   ; +
E10A   AD E3                  DW   h_cfetch-1   ; ,
E10C   2E E2                  DW   h_sub-1   ; -
E10E   AB E1                  DW   h_cstore-1   ; .
E110   C4 E2                  DW   h_div-1   ; /
E112   8F E1                  DW   push-1   ; :
E114   B3 E1                  DW   drop-1   ; ;
E116   65 E2                  DW   h_lt-1   ; <
E118   77 E2                  DW   h_eq-1   ; =
E11A   62 E2                  DW   h_gt-1   ; >
E11C   B6 E3                  DW   h_key-1   ; ?
E11E   A1 E3                  DW   h_fetch-1   ; @
E120   97 E0                  DW   h_def-1   ; [
E122   F1 E1                  DW   h_break-1   ; \
E124   E0 E1                  DW   h_ret-1   ; ]
E126   20 E2                  DW   h_xor-1   ; ^
E128   32 E3                  DW   h_alloc-1   ; _
E12A   17 E4                  DW   h_grave-1   ; `
E12C   BF E1                  DW   h_tor-1   ; {
E12E   12 E2                  DW   h_or-1   ; |
E130   CC E1                  DW   h_fromr-1   ; }
E132   4E E2                  DW   h_not-1   ; ~
E134                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E134                             ; test is at the bottom so the loop closes with a branch. Returns with the
E134                             ; carry set.
E134   20 72 E1     RD1:      JSR   incip   ; (keeps A = the digit)
E137   06 02                  ASL   TL   
E139   26 03                  ROL   TH   ; x2
E13B   18                     CLC      
E13C   65 02                  ADC   TL   
E13E   85 04                  STA   T0   
E140   A5 03                  LDA   TH   
E142   69 00                  ADC   #0   
E144   85 05                  STA   T1   ; T = x2 + digit
E146   06 02                  ASL   TL   
E148   26 03                  ROL   TH   
E14A   06 02                  ASL   TL   
E14C   26 03                  ROL   TH   ; x8
E14E   18                     CLC      
E14F   A5 02                  LDA   TL   
E151   65 04                  ADC   T0   
E153   85 02                  STA   TL   
E155   A5 03                  LDA   TH   
E157   65 05                  ADC   T1   
E159   85 03                  STA   TH   ; x8 + x2 + digit
E15B   20 61 E1     RDNUM:    JSR   isdig   
E15E   90 D4                  BCC   rd1   
E160   60                     RTS      
E161                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E161                             ; digit. Y = 0.
E161   20 6A E1     ISDIG:    JSR   peek   
E164   38                     SEC      
E165   E9 30                  SBC   #"0"   
E167   C9 0A                  CMP   #10   
E169   60                     RTS      
E16A                             ; =============================================================================
E16A                             ;  Reading the program
E16A                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E16A                             ;    getc: the same, then IP moves on; flags follow A
E16A                             ;    incip: IP moves on; keeps A, the carry and Y
E16A                             ; =============================================================================
E16A   A0 00        PEEK:     LDY   #0   
E16C   B1 00                  LDA   (IP),Y   
E16E   60                     RTS      
E16F   20 6A E1     GETC:     JSR   peek   
E172   E6 00        INCIP:    INC   IP   
E174   D0 02                  BNE   ic1   
E176   E6 01                  INC   IP+1   
E178   09 00        IC1:      ORA   #0   
E17A   60                     RTS      
E17B                             ; rstip: point IP at the start of the program
E17B   A9 00        RSTIP:    LDA   #<PROG   
E17D   85 00                  STA   IP   
E17F   A9 05                  LDA   #>PROG   
E181   85 01                  STA   IP+1   
E183   60                     RTS      
E184                             ; =============================================================================
E184                             ;  Stack
E184                             ; =============================================================================
E184   20 90 E1     PUSHIP:   JSR   push   ; push the reading position
E187   A5 00                  LDA   IP   
E189   85 02                  STA   TL   
E18B   A5 01                  LDA   IP+1   
E18D   85 03                  STA   TH   
E18F   60                     RTS      
E190   CA           PUSH:     DEX      ; ":" and every push
E191   A5 02                  LDA   TL   
E193   9D 00 02               STA   DSL,X   
E196   A5 03                  LDA   TH   
E198   9D 00 03               STA   DSH,X   
E19B   60                     RTS      
E19C                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E19C   A5 02        FLAG:     LDA   TL   
E19E   05 03                  ORA   TH   
E1A0   20 B4 E1               JSR   drop   
E1A3   A8                     TAY      ; (drop's INX changed the flags)
E1A4   60                     RTS      
E1A5                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E1A5                H_STORE:      
E1A5                          IF   CHECKED   
                              LDA   TL   ; both bytes must be in the program's space:
                              ADC   #1   ; check the page of addr+1 (the carry is
                              LDA   TH   ; clear on the way in)
                              ADC   #0   
                              JSR   chkst   
E1A5                          ENDIF      
E1A5   BD 00 03               LDA   DSH,X   
E1A8   A0 01                  LDY   #1   
E1AA   91 02                  STA   (TL),Y   
E1AC                H_CSTORE:      ; "." ( c addr -- )
E1AC                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E1AC                          ENDIF      
E1AC   BD 00 02               LDA   DSL,X   
E1AF   A0 00                  LDY   #0   
E1B1   91 02                  STA   (TL),Y   
E1B3   E8                     INX      ; falls into drop
E1B4                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E1B4                             ; it returns with Z clear.
E1B4   BC 00 02     DROP:     LDY   DSL,X   
E1B7   84 02                  STY   TL   
E1B9   BC 00 03               LDY   DSH,X   
E1BC   84 03                  STY   TH   
E1BE   E8                     INX      
E1BF   60                     RTS      
E1C0                             ; "{" TOS to the return stack, "}" return stack to TOS
E1C0   68           H_TOR:    PLA      
E1C1   68                     PLA      
E1C2   A5 03                  LDA   TH   
E1C4   48                     PHA      
E1C5   A5 02                  LDA   TL   
E1C7   48                     PHA      
E1C8   20 B4 E1               JSR   drop   
E1CB   D0 0B                  BNE   nxt2   ; always
E1CD   68           H_FROMR:   PLA      
E1CE   68                     PLA      
E1CF   20 90 E1               JSR   push   
E1D2   68                     PLA      
E1D3   85 02                  STA   TL   
E1D5   68                     PLA      
E1D6   85 03                  STA   TH   
E1D8   4C 1A E0     NXT2:     JMP   next   
E1DB                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E1DB                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E1DB                             ; it is here, the address popped is pushed back.
E1DB   20 9C E1     H_CLOSE:   JSR   flag   
E1DE   F0 1E                  BEQ   rdrop   
E1E0   24                     DB   24h   ; (BIT zp: steps over the SEC)
E1E1                             ; "]" returns: pull an address and jump to it.
E1E1   38           H_RET:    SEC      
E1E2                          IF   CHECKED   
                              JSR   chkbrk   ; Ctrl-C is checked at every loop-back and
E1E2                          ENDIF      ;   every word return (it keeps the carry)
E1E2   68                     PLA      
E1E3   68                     PLA      ; drop the step frame
E1E4   68                     PLA      
E1E5   85 00                  STA   IP   
E1E7   68                     PLA      
E1E8   85 01                  STA   IP+1   
E1EA   B0 EC                  BCS   nxt2   
E1EC   48                     PHA      ; ")": keep the block start
E1ED   A5 00                  LDA   IP   
E1EF   48                     PHA      
E1F0   90 E6                  BCC   nxt2   ; always
E1F2                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E1F2                             ; drops the block start, "]" returns.
E1F2   20 9C E1     H_BREAK:   JSR   flag   
E1F5   F0 6B                  BEQ   ab9   
E1F7   20 B7 E0               JSR   skip   
E1FA   C9 29                  CMP   #")"   
E1FC   D0 E3                  BNE   h_ret   
E1FE   68           RDROP:    PLA      
E1FF   68                     PLA      
E200   68                     PLA      
E201   68                     PLA      
E202   4C 1A E0               JMP   next   
E205                             ; =============================================================================
E205                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E205                             ; =============================================================================
E205                             ; The logic operators leave the carry as they found it, clear, so they can
E205                             ; branch to fin.
E205   BD 00 02     H_AND:    LDA   DSL,X   
E208   25 02                  AND   TL   
E20A   85 02                  STA   TL   
E20C   BD 00 03               LDA   DSH,X   
E20F   25 03                  AND   TH   
E211   90 31                  BCC   fin   ; always
E213   BD 00 02     H_OR:     LDA   DSL,X   
E216   05 02                  ORA   TL   
E218   85 02                  STA   TL   
E21A   BD 00 03               LDA   DSH,X   
E21D   05 03                  ORA   TH   
E21F   90 23                  BCC   fin   ; always
E221   BD 00 02     H_XOR:    LDA   DSL,X   
E224   45 02                  EOR   TL   
E226   85 02                  STA   TL   
E228   BD 00 03               LDA   DSH,X   
E22B   45 03                  EOR   TH   
E22D   90 15                  BCC   fin   ; always
E22F                             ; "-" has two jobs: directly before a digit it starts a negative number.
E22F   20 61 E1     H_SUB:    JSR   isdig   
E232   90 14                  BCC   negnum   
E234   20 55 E2     SUB1:     JSR   neg   ; a - b = a + (-b)
E237   18           H_ADD:    CLC      
E238   BD 00 02               LDA   DSL,X   
E23B   65 02                  ADC   TL   
E23D   85 02                  STA   TL   
E23F   BD 00 03               LDA   DSH,X   
E242   65 03                  ADC   TH   ; falls into fin
E244                             ; fin: finish a two-operand op: A = the high byte of the result
E244   85 03        FIN:      STA   TH   
E246   E8                     INX      
E247   60                     RTS      
E248   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E24A   20 5E E0               JSR   digit   ; (comes back with the carry set)
E24D   B0 06                  BCS   neg   ; always: the number, negated
E24F                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E24F   90 05        H_NOT:    BCC   neg1   ; always
E251                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E251   A5 03        ABSV:     LDA   TH   
E253   10 0D        NEGM:     BPL   ab9   
E255                             ; neg: TOS = -TOS
E255   38           NEG:      SEC      
E256   A9 00        NEG1:     LDA   #0   
E258   E5 02                  SBC   TL   
E25A   85 02                  STA   TL   
E25C   A9 00                  LDA   #0   
E25E   E5 03                  SBC   TH   
E260   85 03                  STA   TH   
E262   60           AB9:      RTS      
E263                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E263                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E263   20 B0 E2     H_GT:     JSR   h_swap   ; a > b is b < a
E266   BD 00 02     H_LT:     LDA   DSL,X   
E269   C5 02                  CMP   TL   
E26B   BD 00 03               LDA   DSH,X   
E26E   E5 03                  SBC   TH   
E270   70 02                  BVS   lt1   
E272   49 80                  EOR   #80h   
E274   0A           LT1:      ASL      
E275   E8                     INX      ; (keeps the carry; never leaves X at 0)
E276   D0 07                  BNE   bool   ; always
E278   20 34 E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E27B   05 02                  ORA   TL   
E27D   C9 01                  CMP   #1   ; carry clear if A = 0
E27F   A9 00        BOOL:     LDA   #0   
E281   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E283   85 02                  STA   TL   
E285   85 03                  STA   TH   
E287   60                     RTS      
E288                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E288                             ; bottom while the product comes in at the top, through A:T0 above it; after
E288                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E288   A0 10        H_MUL:    LDY   #16   
E28A   84 05                  STY   T1   ; the round count
E28C   A9 00                  LDA   #0   
E28E   85 04                  STA   T0   ; A:T0 = the upper half
E290   46 03                  LSR   TH   
E292   66 02                  ROR   TL   ; the first multiplier bit
E294   90 0D        ML1:      BCC   ml2   
E296   A8                     TAY      
E297   18                     CLC      
E298   A5 04                  LDA   T0   
E29A   7D 00 02               ADC   DSL,X   
E29D   85 04                  STA   T0   
E29F   98                     TYA      
E2A0   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E2A3   6A           ML2:      ROR      
E2A4   66 04                  ROR   T0   
E2A6   66 03                  ROR   TH   
E2A8   66 02                  ROR   TL   ; everything one place right; next bit out
E2AA   C6 05                  DEC   T1   
E2AC   D0 E6                  BNE   ml1   
E2AE   E8                     INX      ; drop the multiplicand
E2AF   60                     RTS      
E2B0   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E2B3   A5 02                  LDA   TL   
E2B5   9D 00 02               STA   DSL,X   
E2B8   84 02                  STY   TL   
E2BA   BC 00 03               LDY   DSH,X   
E2BD   A5 03                  LDA   TH   
E2BF   9D 00 03               STA   DSH,X   
E2C2   84 03                  STY   TH   
E2C4   60                     RTS      
E2C5                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E2C5                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E2C5                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
E2C5   BD 00 03     H_DIV:    LDA   DSH,X   
E2C8   48                     PHA      ; a's sign: for r
E2C9   45 03                  EOR   TH   
E2CB   48                     PHA      ; a xor b: for q
E2CC   20 51 E2               JSR   absv   
E2CF   A5 02                  LDA   TL   
E2D1   85 08                  STA   D0   
E2D3   A5 03                  LDA   TH   
E2D5   85 09                  STA   D1   ; D = |b|
E2D7   BD 00 02               LDA   DSL,X   
E2DA   85 02                  STA   TL   
E2DC   BD 00 03               LDA   DSH,X   
E2DF   85 03                  STA   TH   
E2E1   20 51 E2               JSR   absv   ; TOS = |a|
E2E4   20 F2 E2               JSR   udiv   ; TOS = q, NOS = r
E2E7   68                     PLA      
E2E8   20 53 E2               JSR   negm   ; q's sign
E2EB   20 B0 E2               JSR   h_swap   ; r on top
E2EE   68                     PLA      
E2EF   4C 53 E2               JMP   negm   ; r's sign
E2F2                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E2F2                             ; cell the remainder (whatever was there is lost).
E2F2                             ; Dividing by 2 is one shift (the spec wants that fast).
E2F2   A9 00        UDIV:     LDA   #0   
E2F4   9D 00 02               STA   DSL,X   
E2F7   9D 00 03               STA   DSH,X   
E2FA   A5 08                  LDA   D0   
E2FC   49 02                  EOR   #2   
E2FE   05 09                  ORA   D1   
E300   D0 08                  BNE   ud0   
E302   46 03                  LSR   TH   
E304   66 02                  ROR   TL   ; the quotient
E306   3E 00 02               ROL   DSL,X   ; the remainder: the bit that fell out
E309   60                     RTS      
E30A   A0 10        UD0:      LDY   #16   
E30C   06 02        UD1:      ASL   TL   
E30E   26 03                  ROL   TH   
E310   3E 00 02               ROL   DSL,X   
E313   3E 00 03               ROL   DSH,X   
E316   38                     SEC      
E317   BD 00 02               LDA   DSL,X   
E31A   E5 08                  SBC   D0   
E31C   85 04                  STA   T0   
E31E   BD 00 03               LDA   DSH,X   
E321   E5 09                  SBC   D1   
E323   90 0A                  BCC   ud2   
E325   9D 00 03               STA   DSH,X   
E328   A5 04                  LDA   T0   
E32A   9D 00 02               STA   DSL,X   
E32D   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E32F   88           UD2:      DEY      
E330   D0 DA                  BNE   ud1   
E332   60           UD9:      RTS      
E333                             ; =============================================================================
E333                             ;  Storage
E333                             ; =============================================================================
E333                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
E333                             ; (The carry is clear on the way in.)
E333   AD 7C 04     H_ALLOC:   LDA   HEAP   
E336   A8                     TAY      
E337   65 02                  ADC   TL   
E339   8D 7C 04               STA   HEAP   
E33C   84 02                  STY   TL   
E33E   AD 7D 04               LDA   HEAP+1   
E341   A8                     TAY      
E342   65 03                  ADC   TH   
E344                          IF   CHECKED   
                              BCS   e_heap   ; a negative count wraps: too big
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; the new top must stay below the limit page
E344                          ENDIF      
E344   8D 7D 04               STA   HEAP+1   
E347   84 03                  STY   TH   
E349   60                     RTS      
E34A                          IF   CHECKED   
                    E_HEAP:   LDA   #"H"   ; heap past the limit
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_STORE:   LDA   #"W"   ; write outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the page in A is in the program's own space, from the
                                 ; letter page up to the heap limit. Keeps Y.
                    CHKST:    CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              RTS      
E34A                          ENDIF      
E34A                             ; =============================================================================
E34A                             ;  Console
E34A                             ; =============================================================================
E34A                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E34A   A0 00        TOSGET:   LDY   #0   
E34C   B1 02                  LDA   (TL),Y   
E34E   E6 02        INCTOS:   INC   TL   
E350   D0 02                  BNE   tg1   
E352   E6 03                  INC   TH   
E354   60           TG1:      RTS      
E355                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E355                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E355                             ; bit 6, so // and /" give themselves).
E355   20 4A E3     H_PRINT:   JSR   tosget   
E358   C9 22                  CMP   #22h   
E35A   F0 14                  BEQ   pdrop   
E35C   C9 2F                  CMP   #"/"   
E35E   D0 05                  BNE   pr1   
E360   20 4A E3               JSR   tosget   
E363   29 BF                  AND   #0BFh   
E365   20 03 FF     PR1:      JSR   CONOUT   
E368   4C 55 E3               JMP   h_print   
E36B   A5 02        H_EMIT:   LDA   TL   ; "'"
E36D   20 03 FF               JSR   CONOUT   
E370   4C B4 E1     PDROP:    JMP   drop   
E373                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E373                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E373                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E373   A5 03        H_NUM:    LDA   TH   
E375   10 08                  BPL   pn1   
E377   A9 2D                  LDA   #"-"   
E379   20 03 FF               JSR   CONOUT   
E37C   20 55 E2               JSR   neg   
E37F   CA           PN1:      DEX      ; the spare cell
E380   A9 0A                  LDA   #10   
E382   85 08                  STA   D0   
E384   A9 00                  LDA   #0   
E386   85 09                  STA   D1   
E388   48                     PHA      ; the end marker
E389   20 F2 E2     PN2:      JSR   udiv   
E38C   BD 00 02               LDA   DSL,X   
E38F   09 30                  ORA   #"0"   
E391   48                     PHA      
E392   A5 02                  LDA   TL   
E394   05 03                  ORA   TH   
E396   D0 F1                  BNE   pn2   
E398   E8                     INX      
E399   68           PN3:      PLA      
E39A   F0 D4                  BEQ   pdrop   
E39C   20 03 FF               JSR   CONOUT   
E39F   4C 99 E3               JMP   pn3   
E3A2   A0 01        H_FETCH:   LDY   #1   ; "@"
E3A4   B1 02                  LDA   (TL),Y   
E3A6   48                     PHA      ; the high byte, while "," gets the low one
E3A7   20 AE E3               JSR   h_cfetch   
E3AA   68                     PLA      
E3AB   85 03                  STA   TH   
E3AD   60                     RTS      
E3AE                H_CFETCH:      ; ","
E3AE   A0 00                  LDY   #0   
E3B0   B1 02                  LDA   (TL),Y   
E3B2   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E3B4   84 03                  STY   TH   
E3B6   60                     RTS      
E3B7                             ; "?" ( n -- c ) or ( -n -- addr )
E3B7                             ;   n > 0: wait about n ms for a key; 0 if none came
E3B7                             ;   n = 0: wait for a key
E3B7                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E3B7                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E3B7   A5 03        H_KEY:    LDA   TH   
E3B9   30 20                  BMI   line   
E3BB   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E3BD   20 06 FF     KT2:      JSR   getk   
E3C0   D0 15                  BNE   kt3   
E3C2   88                     DEY      
E3C3   D0 F8                  BNE   kt2   
E3C5   A5 02                  LDA   TL   ; count the millisecond off:
E3C7   D0 06                  BNE   kt4   
E3C9   A5 03                  LDA   TH   
E3CB   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E3CD   C6 03                  DEC   TH   
E3CF   C6 02        KT4:      DEC   TL   
E3D1   D0 E8                  BNE   kt1   
E3D3   A5 03                  LDA   TH   
E3D5   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E3D7   A0 00        KT3:      LDY   #0   
E3D9   F0 D7                  BEQ   cf2   ; always: TOS = A
E3DB                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E3DB                             ; (stored, not echoed), every other key is stored and echoed until the line
E3DB                             ; is full. Y = the length so far; TL = the most allowed.
E3DB   20 55 E2     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E3DE   D0 04                  BNE   ln0   
E3E0   A5 02                  LDA   TL   
E3E2   10 04                  BPL   ln1   
E3E4   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E3E6   85 02                  STA   TL   
E3E8   A0 00        LN1:      LDY   #0   
E3EA   F0 03                  BEQ   ln2   ; always
E3EC   20 03 FF     LN3:      JSR   CONOUT   
E3EF   20 06 FF     LN2:      JSR   getk   
E3F2   F0 FB                  BEQ   ln2   
E3F4   C9 0D                  CMP   #13   
E3F6   F0 14                  BEQ   ln5   
E3F8   C9 08                  CMP   #8   
E3FA   F0 0A                  BEQ   ln4   
E3FC   C4 02                  CPY   TL   
E3FE   B0 EF                  BCS   ln2   ; full
E400   99 80 04               STA   LINEBUF,Y   
E403   C8                     INY      
E404   D0 E6                  BNE   ln3   ; always: echo it
E406   88           LN4:      DEY      ; Backspace: one back, and echo it,
E407   10 E3                  BPL   ln3   
E409   C8                     INY      ;   unless the line was empty
E40A   F0 E3                  BEQ   ln2   ; always
E40C   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E40F   A9 80                  LDA   #<LINEBUF   
E411   85 02                  STA   TL   
E413   A9 04                  LDA   #>LINEBUF   
E415   85 03                  STA   TH   
E417   60                     RTS      
E418                             ; =============================================================================
E418                             ;  Machine code: the grave
E418                             ; =============================================================================
E418                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E418                             ; are stored from addr until a non-hex character; then a RET (60h) is
E418                             ; written and its address is left. An odd last digit is consumed and dropped.
E418                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E418                             ; contract in the header.
E418   20 47 E4     H_GRAVE:   JSR   rdhex   
E41B   B0 1C                  BCS   exec   
E41D   0A           HX1:      ASL      
E41E   0A                     ASL      
E41F   0A                     ASL      
E420   0A                     ASL      
E421   85 04                  STA   T0   
E423   20 47 E4               JSR   rdhex   
E426   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E428   05 04                  ORA   T0   
E42A                          IF   CHECKED   
                              STA   T0   
                              LDA   TH   
                              JSR   chkst   
                              LDA   T0   
E42A                          ENDIF      
E42A   91 02                  STA   (TL),Y   ; Y is 0 after rdhex
E42C   20 4E E3               JSR   inctos   
E42F   20 47 E4               JSR   rdhex   
E432   90 E9                  BCC   hx1   
E434                HX2:         
E434                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E434                          ENDIF      
E434   A9 60                  LDA   #60h   
E436   91 02                  STA   (TL),Y   
E438   60                     RTS      
E439   A5 02        EXEC:     LDA   TL   
E43B   85 04                  STA   T0   
E43D   A5 03                  LDA   TH   
E43F   85 05                  STA   T1   
E441   20 B4 E1               JSR   drop   ; the address is consumed
E444   6C 04 00               JMP   (T0)   
E447                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E447                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E447                             ; Y = 0.
E447   20 61 E1     RDHEX:    JSR   isdig   
E44A   90 0A                  BCC   rh1   
E44C   29 DF                  AND   #0DFh   
E44E   E9 11                  SBC   #11h   ; (the carry is set)
E450   C9 06                  CMP   #6   
E452   B0 05                  BCS   rh9   
E454   69 0A                  ADC   #10   
E456   4C 72 E1     RH1:      JMP   incip   
E459   60           RH9:      RTS      
E45A                             ; =============================================================================
E45A                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E45A                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E45A                             ;  Both keep X and Y. In the unchecked build getk is the host's KEY itself.
E45A                             ; =============================================================================
E45A                          IF   1-CHECKED   
E45A                GETK:     EQU   KEY   ; the host's routine does the whole job
E45A                          ENDIF      
E45A                          IF   CHECKED   
                    GETK:     LDA   KEYBUF   ; a key held back by the break check
                              BEQ   gk1   
                              PHA      
                              LDA   #0   
                              STA   KEYBUF   
                              PLA      
                              RTS      
                    GK1:      JMP   KEY   
E45A                          ENDIF      
E45A                             ; =============================================================================
E45A                             ;  Checked build: break key and error reports
E45A                             ; =============================================================================
E45A                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?". Keeps the flags.
                    CHKBRK:   PHP      
                              JSR   getk   
                              BEQ   cb9   
                              CMP   #3   
                              BEQ   e_break   
                              STA   KEYBUF   
                    CB9:      PLP      
                              RTS      
                    E_BREAK:   LDA   #"B"   ; Ctrl-C
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                                 ; The hardware stack is left as it is: it wraps inside its page, so the
                                 ; calls below work whatever state it is in.
                    ERROR:    LDX   #DSE   ; (the number printer uses a data cell)
                              JSR   CONOUT   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   #"@"   
                              JSR   CONOUT   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   IP   
                              SEC      
                              SBC   #<PROG1   ; the character just read
                              STA   TL   
                              LDA   IP+1   
                              SBC   #>PROG1   
                              STA   TH   
                              JSR   h_num   
                              JMP   endprog   
E45A                          ENDIF      


