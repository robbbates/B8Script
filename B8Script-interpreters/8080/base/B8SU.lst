0178   D5                     PUSH   D   ; jump to it; the stack is balanced again
0179   C9                     RET      ;   when the handler starts
017A                             ; ctl: characters below 21h. A = c - 21h.
017A   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
017C   C2 36 01               JNZ   next0   ; the rest are ignored
017F                          ENDIF      
017F   C3 00 00     ENDPROG:   JMP   EXIT   ; the program has ended
