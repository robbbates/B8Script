048D   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
048E   E7                     RST   20h   ;   with the first value and holds nothing)
048F   CD D8 04               CALL   phalf   ; the depth
0492   3E 3A                  LD   A,":"   
0494   EF                     RST   28h   
0495   79                     LD   A,C   
0496   FE 09                  CP   9   
0498   38 0A                  JR   C,er6   
049A   CD 27 02               CALL   pmsg   
049D   20 2E 2E 2E 22         DB   " ...",22h   
04A2   0E 08                  LD   C,8   
