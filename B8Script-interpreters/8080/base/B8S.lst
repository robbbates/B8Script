                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
01B3                          ENDIF      
01B3                             ; ---- machine code: the grave -----------------------------------------------
01B3                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01B3                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01B3                             ; written and its address is left. An odd last digit is consumed and dropped.
01B3                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01B3                             ; code is entered by CALL with the data stack above the return address; it
01B3                             ; must keep BC, and on return the top cell becomes the new TOS.
01B3   CD 30 05     H_GRAVE:   CALL   hexc   
01B6   D2 2F 01               JNC   exec   
01B9   87           HX1:      ADD   A   
01BA   87                     ADD   A   
01BB   87                     ADD   A   
01BC   87                     ADD   A   
01BD   57                     MOV   D,A   ; the high digit
01BE   CD 30 05               CALL   hexc   
01C1   D2 CD 01               JNC   hx2   ; odd digit: consumed and dropped
01C4   B2                     ORA   D   
01C5   77                     MOV   M,A   
01C6   23                     INX   H   
01C7   CD 30 05               CALL   hexc   
01CA   DA B9 01               JC   hx1   
01CD   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
01CF                          ;*Macro unroll:  NEXT
01CF                          DS   (1-CPM)*(1-FAST),0F7h   
01CF   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
01D0   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01D1   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
01D2                             ; ---- where the two pages meet ----------------------------------------------
01D2                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D2                             ; are in falling code order for this), and where exactly differs between the
01D2                             ; builds: NPG1 follows. Every handler below these four must start in the
01D2                             ; second page, and every one above in the first; chktab.py checks both.
01D2                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
01D2                             ; while rpop uses HL, and the drop at the end brings it back.
01D2   E5           H_RET:    PUSH   H   
01D3                          ;*Macro unroll: ret2:   POPR
01D3                RET2:     DS   1-CPM,0CFh   
01D3   CD                     DS   CPM,0CDh   
01D4   0C                     DS   CPM,AROP&0FFh   
01D5   01                     DS   CPM,AROP/256   
01D6   44                     MOV   B,H   
01D7   4D                     MOV   C,L   
