   843                              <1>         jl      e_over
   844                              <1>         cmp     di,RSTOP & 0FFFFh       ; (the return stack is in one 64K: only
   845                              <1>         ja      e_rund                  ;   the low word changes)
   846                              <1>         cmp     di,(RSTOP-4*RSMAX) & 0FFFFh
   847                              <1>         jb      e_rover
   848                              <1>         ret
   849                              <1> e_under:mov     esp,[V(v_dstop)]        ; data stack underflow: it counts as
   850                              <1>         mov     al,'s'                  ;   empty
   851                              <1>         jmp     short error
   852                              <1> e_rund: mov     edi,RSTOP               ; return stack underflow: the same.
