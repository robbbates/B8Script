  1906                              <1> ; =============================================================================
  1907                              <1> ;  The inner loop: read one character and sort it by range.
  1908                              <1> ;
  1909                              <1> ;    00h          end of program
  1910                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1911                              <1> ;                 build stops on 80h-FFh: X)
  1912                              <1> ;    30h-39h      digit: read a whole number
  1913                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1914                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1915                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1916                              <1> ; =============================================================================
  1917                              <1> ; Digits: step back onto the first digit and read the whole number.
  1918 00000B3C 53                  <1> digit:  push    ebx
  1919 00000B3D 4E                  <1>         dec     esi
  1920                              <1>         CALLP   rdnum
   192                              <2>  %if P_%1
   193 00000B3E FF55CB              <2>  call [V(p_%1)]
   194                              <2>  %else
   195                              <2>  call %1
   196                              <2>  %endif
  1921 00000B41 FFE5                <1>         jmp     ebp
  1922                              <1> 
  1923                              <1> ; a-z: push the cell's address (the cell is the variable).
  1924 00000B43 53                  <1> lower:  push    ebx
  1925 00000B44 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1926 00000B4B FFE5                <1>         jmp     ebp
  1927                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1928                              <1> ; next in reach)
  1929 00000B4D 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1930 00000B4F 750C                <1>         jnz     next                    ; the rest are ignored
  1931 00000B51 E91DFAFFFF          <1>         jmp     endprog
  1932                              <1> %if CHECKED
  1933 00000B56 B058                <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1934 00000B58 E9BFF7FFFF          <1>         jmp     error
  1935                              <1> %endif
  1936                              <1> next:
  1937                              <1> %if CHECKED
  1938 00000B5D E85DF7FFFF          <1>         call    chkstk                  ; both stacks, once per character
  1939                              <1> %endif
  1940 00000B62 31C0                <1>         xor     eax,eax
  1941 00000B64 AC                  <1>         lodsb
  1942 00000B65 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1943 00000B67 72E4                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1944 00000B69 3C0F                <1>         cmp     al,0Fh
  1945 00000B6B 7228                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1946 00000B6D 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1947 00000B6F 3C0A                <1>         cmp     al,0Ah
  1948 00000B71 72C9                <1>         jb      digit                   ; 30h-39h
  1949 00000B73 3C11                <1>         cmp     al,11h
  1950 00000B75 721C                <1>         jb      p3a                     ; 3Ah-40h
  1951 00000B77 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1952 00000B79 3C1A                <1>         cmp     al,1Ah
  1953 00000B7B 0F826CF5FFFF        <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1954 00000B81 3C20                <1>         cmp     al,20h
  1955 00000B83 720C                <1>         jb      p5b                     ; 5Bh-60h
  1956 00000B85 3C3A                <1>         cmp     al,3Ah
  1957 00000B87 72BA                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1958 00000B89 3C3E                <1>         cmp     al,3Eh
  1959                              <1> %if CHECKED
  1960 00000B8B 74D0                <1>         je      next                    ; 7Fh, DEL: ignored
  1961 00000B8D 73C7                <1>         jae     e_hi                    ; 80h-FFh: reserved
  1962                              <1> %else
  1963                              <1>         jae     next                    ; 7Fh-FFh: ignored
  1964                              <1> %endif
  1965 00000B8F 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1966 00000B91 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1967 00000B93 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1968 00000B95 8A80[6D090000]      <1> punct:  mov     al,[ptab+eax]
  1969 00000B9B 8D80[11010000]      <1>         lea     eax,[hbase+eax]
  1970 00000BA1 FFE0                <1>         jmp     eax
