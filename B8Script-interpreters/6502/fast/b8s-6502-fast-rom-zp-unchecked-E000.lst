E6C2                          IF   SBASEU   
                                 ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
                                 ; fetched or stored in the same step (x@ is the commonest pair in most
                                 ; programs). A checked build checks the stacks between the two, so it keeps
                                 ; them apart. (pvar calls lowp, which only pushes.)
                    LOWQ:     ASL      
                              STA   T0   ; the cell's offset in the letter page
                              LDY   #0   
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   lwf   
                              CMP   #"!"   
                              BEQ   lws   
                              LDA   T0   
                              LDY   #>LET   
                              JMP   pushay   ; the address
                    LWF:      JSR   incip   ; x@: TOS = the cell's value
                              LDY   T0   
                              DEX      
                              DEX      
                              LDA   LET,Y   
                              STA   0,X   
                              LDA   LET+1,Y   
                              STA   1,X   
                              RTS      
                    LWS:      JSR   incip   ; x!: the cell = TOS, and it is dropped
                              LDY   T0   
                              LDA   0,X   
                              STA   LET,Y   
                              LDA   1,X   
                              STA   LET+1,Y   
                              INX      
                              INX      
                              RTS      
E6C2                          ENDIF      
E6C2                          IF   QK   
E6C2                             ; The skip cache. Nearly every skip is one that has happened before (a loop
E6C2                             ; skips the same false block on every pass), so the first scan from each
E6C2                             ; place is remembered: 64 entries of 00bbc3RhcnQsIHRoZSBjbG9zZXIncyBhZGRyZXNz, in CPAGE,
E6C2                             ; found by the start's low byte times 4. Only skips that start in the
E6C2                             ; program text are kept (the line buffer changes); the cache is emptied when
E6C2                             ; the program starts. A program that changes its own text while it runs is
E6C2                             ; not looked after. Where the skip started is kept in the scratch under the
E6C2                             ; top cell, $FE,X and $FF,X. (The checked build: A holds the wrong closer on
E6C2                             ; the way in, as at the checked skip above.)
E6C2                SKIP:        
E6C2                          ENDIF      
E6C2                          IF   CHECKED*QK   
                              STA   T0   
E6C2                          ENDIF      
E6C2                          IF   QK   
E6C2   A5 01                  LDA   IP+1   
E6C4   C9 05                  CMP   #>PROG   
E6C6   90 24                  BCC   sks   ; below the program text: no cache
E6C8   A5 00                  LDA   IP   
E6CA   0A                     ASL      
E6CB   0A                     ASL      
E6CC   A8                     TAY      ; Y -> the entry
E6CD   A5 00                  LDA   IP   
E6CF   D9 00 02               CMP   CPAGE*256,Y   
E6D2   D0 18                  BNE   sks   
E6D4   A5 01                  LDA   IP+1   
E6D6   D9 01 02               CMP   CPAGE*256+1,Y   
E6D9   D0 11                  BNE   sks   
E6DB   B9 02 02               LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
E6DE   85 00                  STA   IP   ;   read
E6E0   B9 03 02               LDA   CPAGE*256+3,Y   
E6E3   85 01                  STA   IP+1   
E6E5   A0 00                  LDY   #0   
E6E7   B1 00                  LDA   (IP),Y   
E6E9   4C 91 EA               JMP   incip   
E6EC   A5 00        SKS:      LDA   IP   
E6EE   95 FE                  STA   0FEh,X   
E6F0   A5 01                  LDA   IP+1   
E6F2   95 FF                  STA   0FFh,X   
E6F4   A0 00                  LDY   #0   
E6F6   84 06                  STY   T2   ; depth
E6F8                             ; The scan reads at IP+Y. Most characters are nothing to it, and two range
E6F8                             ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
E6F8   B1 00        SQ1:      LDA   (IP),Y   
E6FA   C8                     INY      
E6FB   F0 1D                  BEQ   sqw   
E6FD   C9 5E        SQ2:      CMP   #5Eh   
E6FF   B0 F7                  BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E701   C9 5B                  CMP   #5Bh   
E703   B0 28                  BCS   sqb   ; [ \ ]
E705   C9 2A                  CMP   #2Ah   
E707   B0 EF                  BCS   sq1   ; * to Z: nothing
E709   C9 28                  CMP   #28h   
E70B   F0 1B                  BEQ   sqo   ; (
E70D   B0 24                  BCS   sqc   ; )
E70F   C9 22                  CMP   #22h   
E711   F0 0B                  BEQ   sqq   ; a string
E713   C9 01                  CMP   #1   
E715   B0 E1                  BCS   sq1   ; the rest below "(": nothing
E717                          ENDIF      
E717                          IF   QK*(1-CHECKED)   
E717   4C 09 FF               JMP   EXIT   ; NUL: the end of the program
E71A                          ENDIF      
E71A                          IF   QK*CHECKED   
                              JMP   sknul   
E71A                          ENDIF      
E71A                          IF   QK   
E71A   E6 01        SQW:      INC   IP+1   ; Y went round: on into the next page
E71C   D0 DF                  BNE   sq2   ; always
E71E   20 61 E7     SQQ:      JSR   sqip   ; a string: step over it
E721   20 60 E2               JSR   skipstr   
E724                          ENDIF      
E724                          IF   QK*CHECKED   
                              BNE   sqq1   
                              JMP   sknul   ; the string ran into the end
                    SQQ1:        
E724                          ENDIF      
E724                          IF   QK   
