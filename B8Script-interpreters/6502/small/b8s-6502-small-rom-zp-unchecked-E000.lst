0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only), with the data stack
0000                             ;  in zero page
0000                             ;  Spec: docs/b8script.md (2026-11-24). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ; 
0000                             ;  This is the smaller of the two 6502 interpreters. b8s-6502.asm keeps the
0000                             ;  data stack in pages 2 and 3 (252 cells) and leaves zero page almost free;
0000                             ;  this one keeps it in zero page (112 cells), where the 6502's short
0000                             ;  addressing modes make nearly every handler smaller. The language is the
0000                             ;  same; the memory map and the machine-code contract differ.
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's three-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   D:2: 5 0
0000                             ;                   R:0
0000                             ;                 and then goes to EXIT.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build").
0000                             ;  The base and fast builds keep the skip cache in the page at $0200, which no
0000                             ;  other build uses (this interpreter's data stack is in zero page).
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   0   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    X       the data-stack pointer. Every cell is two bytes in zero page, low
0000                             ;            byte first: the top cell (TOS) is 0,X and 1,X, the one under it
0000                             ;            (NOS) 2,X and 3,X. The stack grows down: a push is DEX DEX, a
0000                             ;            drop INX INX. A cell that holds an address is used where it is,
0000                             ;            with (0,X): nothing is copied to a pointer first.
0000                             ;    $FE,X   the two bytes under the top cell (zero-page indexing wraps, so
0000                             ;    $FF,X   this is -2,X and -1,X): free memory, used as scratch.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  PTAB holds one byte per punctuation character: the low byte of its
0000                             ;  handler's address, less 1 (the dispatcher pushes an address and "returns"
0000                             ;  to it). The high byte comes from the character: the handlers of the first
0000                             ;  N1 characters start in the image's first page, those of the characters from
0000                             ;  N1 up to N2 in its second, and the rest in its third. The layout below
0000                             ;  keeps to that, and testing/chktab6502.py checks it in every build but the
0000                             ;  fast build (SPEED = 2), which dispatches through a full table instead:
0000                             ;  see "The fast build" at the end.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the dispatcher
0000                             ;  leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry the
0000                             ;  address has been dropped and X is the data-stack pointer: TOS is 0,X (low)
0000                             ;  and 1,X (high), NOS is 2,X and 3,X. To push: DEX, DEX, then store at 0,X
0000                             ;  and 1,X. To drop: INX, INX. The code may change A and Y, and X as the
0000                             ;  stack pointer; it must keep IP ($00/$01) and leave the hardware stack
0000                             ;  balanced. Zero page $02, $03, $07 and $0A-$0D are free for its own use;
0000                             ;  but $0C-$0D only while the code runs: a "$" that prints a variable escape
0000                             ;  with the data stack full writes there.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   T1   ; 05-06 the divisor (division, number printing)
0000                D1:       EQU   T2   
0000                V:        EQU   T0   ; (FAST) 04-05 the dispatcher's jump vector
0000                          IF   CHECKED   
                    PLACE:    EQU   08h   ; 08-09 the address of the character being
                                 ;   run, for the error report. No handler
                                 ;   uses it.
                                 ; The error report runs after the program, so it may use the zero page that
                                 ; machine code has ($02, $03, $0A-$0D; but not $0A-$0D once it prints
                                 ; numbers, since a full stack and "#" reach down to them):
                    P:        EQU   02h   ; 02-03 the place, copied (PLACE is the
                    CO:       EQU   08h   ;   report's own scratch then, CO)
                    LN:       EQU   0Ah   ; 0A-0B the line being reported
0000                          ENDIF      
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-000F  the variables above, and scratch
0000                             ;    0010-00EF  the data stack: 112 cells. X = F0 when it is empty. (0E and
0000                             ;               0F are the scratch under the top cell when it is full.)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       CPAGE (QK builds only): the skip cache
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PEND at +38;
0000                             ;               and every build's: the countdown CDOWN at +79, KEYBUF (the
0000                             ;               held key) at +7A, BRKOFF (the break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM). In the fast build its first two
0000                             ;               pages are the dispatch table, and start is at E200
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these. All four must keep X;
0000                             ; they may change A, Y and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if the carry is set,
0000                             ;     hide it if the carry is clear
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row A, column Y, both
0000                             ;     counted from 0
0000                          ENDIF      
0000                DSE:      EQU   0F0h   ; X when the data stack is empty
0000                DSFULL:   EQU   10h   ; X when it is full
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                CDOWN:    EQU   LET+79h   ; the break check's countdown (see pnext)
0000                RSV:      EQU   LET+35h   ; checked: S as it was before this character
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                CPAGE:    EQU   02h   ; (QK) the skip cache's page
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
0000                BASE:     EQU   0E000h   ; where the image starts: a multiple of 512
0000                HALFPG:   EQU   BASE/512   ; (the dispatcher doubles this to get a page)
0000                N1:       EQU   8   ; ! " # $ % & ' (  start in the first page,
0000                N2:       EQU   21   ; ) * + , - . / : ; < = > ?  in the second,
0000                             ; @ [ \ ] ^ _ ` 00bbIHwg ~  in the third
0000                             ; The fast build's dispatcher (SPEED = 2; see "The fast build"), inline at
0000                             ; the end of its own entries. NEXTF reads the next character and jumps
0000                             ; through the table:
0000                             ;     LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
0000                             ;     LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
0000                             ; NEXTA is the same from INC IP on: the character is already in A, and IP is
0000                             ; still at it (it skips the LDY and the LDA); NEXTY is the same with the
0000                             ; character in Y (it skips the TAY too). In the checked build all three are
0000                             ; JMP fnext, which checks the stacks first. (The bytes are written out with
0000                             ; DS, because asm80 does not nest an IF in a macro inside another IF; and
0000                             ; DS takes the addresses as these equates.)
0000                          IF   FAST   
                    ADTL:     EQU   DTL   
                    ADTH:     EQU   DTH   
                    AFNX:     EQU   fnext   
0000                          ENDIF      
0000                          IF   1-FAST   
0000                ADTL:     EQU   0   
0000                ADTH:     EQU   0   
0000                AFNX:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      1-CHECKED,0A0h  ; LDY #0
0000                 DS      1-CHECKED,0
0000                 DS      1-CHECKED,0B1h  ; LDA (IP),Y
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTA,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTY,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient; the
0000                             ; remainder is left in the scratch under it, at $FE,X and $FF,X.
0000                             ; Dividing by 2 is one shift (the spec wants that fast).
0000                             ; (A macro, from when the two builds needed it in different places.)
0000                .macro UDIV,
0000                             ; 
0000                udiv:   LDA     #0
0000                 STA     0FEh,X
0000                 STA     0FFh,X
0000                 LDA     D0
0000                 EOR     #2
0000                 ORA     D1
0000                 BNE     ud0
0000                 LSR     1,X
0000                 ROR     0,X             ; the quotient
0000                 ROL     0FEh,X          ; the remainder: the bit that fell out
0000                 RTS
0000                ud0:    LDY     #16
0000                ud1:    ASL     0,X
0000                 ROL     1,X
0000                 ROL     0FEh,X
0000                 ROL     0FFh,X
0000                 SEC
0000                 LDA     0FEh,X
0000                 SBC     D0
0000                 STA     T0
0000                 LDA     0FFh,X
0000                 SBC     D1
0000                 BCC     ud2
0000                 STA     0FFh,X
0000                 LDA     T0
0000                 STA     0FEh,X
0000                 INC     0,X             ; the quotient bit (bit 0 is free)
0000                ud2:    DEY
0000                 BNE     ud1
0000                 RTS
0000                .endm
0000                 
0000                             ; (QK) "*" with an operand below 256 takes 8 rounds, not 16: that one
0000                             ; becomes the multiplier, so the product's low byte comes out of the NOS
0000                             ; cell's low byte and its high byte is left in T0. Most multiplications have
0000                             ; one: a count or a small constant. (A macro, as it sits in a different
0000                             ; place in the checked and the unchecked builds, to keep the handlers'
0000                             ; pages.)
0000                .macro MULQ,
0000                             ; 
0000                mulq:   LDA     3,X
0000                 BEQ     mq8             ; the multiplier is below 256
0000                 LDA     1,X
0000                 BNE     mq16
0000                 JSR     h_swap          ; the multiplicand is: it becomes the multiplier
0000                mq8:    LDY     #8
0000                 LDA     #0
0000                 STA     T0
0000                 LSR     2,X
0000                mq1:    BCC     mq2
0000                 STA     T1
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 LDA     T1
0000                 ADC     1,X
0000                mq2:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 DEY
0000                 BNE     mq1
0000                 LDA     T0
0000                 STA     3,X
0000                 INX
0000                 INX
0000                 RTS
0000                mq16:   LDY     #16             ; 16 rounds, as h_mul does without QK
0000                 LDA     #0
0000                 STA     T0
0000                 LSR     3,X
0000                 ROR     2,X
0000                mq3:    BCC     mq4
0000                 STA     T1
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 LDA     T1
0000                 ADC     1,X
0000                mq4:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 DEY
0000                 BNE     mq3
0000                 INX
0000                 INX
0000                 RTS
0000                .endm
0000                 
0000                             ; (MULF: the same for the fast build, the rounds unrolled, with Y for the
0000                             ; upper half's high byte while the low one is added)
0000                .macro MULF,
0000                             ; 
0000                mulq:   LDA     3,X
0000                 BEQ     mq8             ; the multiplier is below 256
0000                 LDA     1,X
0000                 BEQ     mqs
0000                 JMP     mq16            ; (out of a branch's reach)
0000                mqs:    JSR     h_swap          ; the multiplicand is: it becomes the multiplier
0000                mq8:    LDA     #0
0000                 STA     T0
0000                 LSR     2,X
0000                 BCC     mu0
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu0:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu1
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu1:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu2
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu2:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu3
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu3:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu4
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu4:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu5
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu5:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu6
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu6:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu7
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu7:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 LDA     T0
0000                 STA     3,X
0000                 INX
0000                 INX
0000                 RTS
0000                mq16:   LDA     #0
0000                 STA     T0
0000                 LSR     3,X
0000                 ROR     2,X
0000                 BCC     mw0
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw0:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw1
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw1:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw2
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw2:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw3
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw3:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw4
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw4:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw5
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw5:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw6
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw6:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw7
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw7:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw8
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw8:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw9
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw9:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw10
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw10:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw11
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw11:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw12
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw12:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw13
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw13:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw14
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw14:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw15
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw15:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 INX
0000                 INX
0000                 RTS
0000                .endm
0000                 
0000                             ; (QK) A true ")" reads the block start where it is, under the step frame,
0000                             ; instead of popping it and pushing it back. The break key is looked at as
0000                             ; pnext would. (A macro, for the same reason.)
0000                .macro CLOSEQ,
0000                             ; 
0000                closeq: TXA                     ; (TSX trashes X)
0000                 TSX
0000                 LDY     103h,X
0000                 STY     IP
0000                 LDY     104h,X
0000                 STY     IP+1
0000                 TAX
0000                 DEC     CDOWN
0000                 BEQ     cq1
0000                 RTS                     ; into the loop
0000                cq1:    PLA
0000                 PLA                     ; the step frame
0000                 JMP     pkey
0000                .endm
0000                 
0000                FTAB:     EQU   BASE   ; (FAST: the fast build's table, two pages,
E000                          .ORG   BASE+FAST*512   ;   comes first, and the code after it)
E000                             ; =============================================================================
E000                             ;  Page 1 of 3. Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
                                 ; The first half of the letter page is zeroed: every variable, every
                                 ; cell of the interpreter's own (no key held back), and every word
                                 ; cell, which then points at 0000h: calling an undefined word stops
                                 ; with U (see e_undef).
                              INX      
                              TXA      ; A = 0
                              LDY   #7Fh   
                    STZ:      STA   LET,Y   
                              DEY      
                              BPL   stz   
E003                          ENDIF      
E003                          IF   QK   
                              LDA   #0   ; an empty skip cache (a start of 0000h
                              TAY      ;   matches no skip)
                    SKC:      STA   CPAGE*256,Y   
                              INY      
                              BNE   skc   
E003                          ENDIF      
E003   20 7A E4               JSR   rstip   
E006   20 69 E4     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B                          IF   1-CHECKED   
E00B   8D 7A 04               STA   KEYBUF   ; (A = 0) no key held, the break key on
E00E   8D 7B 04               STA   BRKOFF   
E011                          ENDIF      
E011   A5 00                  LDA   IP   
E013   8D 7C 04               STA   HEAP   
E016                          IF   CHECKED   
                              STA   PEND   
E016                          ENDIF      
E016   A5 01                  LDA   IP+1   
E018   8D 7D 04               STA   HEAP+1   
E01B                          IF   CHECKED   
                              STA   PEND+1   
E01B                          ENDIF      
E01B   20 7A E4               JSR   rstip   
E01E   A2 F0                  LDX   #DSE   
E020                             ; ---- the inner loop (the checked build's is further down, out of this page)
E020                          IF   1-CHECKED   
E020                             ; -----------------------------------------------------------------------------
E020                             ;  The break key. A running program reads the keyboard only through getk
E020                             ;  (for "?") and pnext (the break check), which between them give the break
E020                             ;  key its rules:
E020                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E020                             ;      build, with the report (B) in the checked one;
E020                             ;    - any other key that the break check reads is held in KEYBUF for the
E020                             ;      next "?", and a newer one takes its place;
E020                             ;    - "?" (getk) takes the held key first;
E020                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E020                             ;      key like any other, but two of them within about 250 ms still stop it.
E020                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E020                             ; -----------------------------------------------------------------------------
E020                             ; pnext: the break check, then (falling through) next. A word call, a true
E020                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E020                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E020                             ; falls in here too, which does no harm.)
E020   CE 79 04     PNEXT:    DEC   CDOWN   
E023   D0 0B                  BNE   next   
E025   20 06 FF     PKEY:     JSR   KEY   
E028   F0 06                  BEQ   next   ; no key
E02A   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E02D   20 76 E3               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E030                NEXT:        
E030                          ENDIF      
E030                          IF   (1-CHECKED)*(1-FAST)   
E030   20 9D E3               JSR   step   
E033   4C 30 E0               JMP   next   
E036                          ENDIF      
E036                          IF   (1-CHECKED)*FAST   
                              JMP   fnext   ; (the fast build: see "The fast build")
E036                          ENDIF      
E036                          IF   CHECKED   
                              JMP   next   
E036                          ENDIF      
E036                             ; ---- handlers of ! " # $ % & ' ( : they must start in this page -------------
E036                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E036                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E036                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
E036                             ; no bit 6, so // and /" give themselves). TOS walks along the string; the
E036                             ; checked build keeps the address on the hardware stack meanwhile, for a Q
E036                             ; report, and puts it back in TOS at the end (pq).
E036                          IF   CHECKED   
                    PQ:       PLA      
                              STA   0,X   
                              PLA      
                              STA   1,X   
                              BCS   pdrop   ; the closing quote: drop it
                              CPX   #DSE   ; a NUL: Q, unless "$" had nothing on the
                              LDA   #"s"   ;   stack at all (X at the empty mark): s
                              BCS   eq1   
                    E_QUOTE:   LDA   #"Q"   ; a NUL: "$" or a string ran into the end
                    EQ1:      JMP   error   
                    H_PRINT:   LDA   1,X   
                              PHA      
                              LDA   0,X   
                              PHA      
                              BCC   pr0   ; always: the carry is clear on the way in
E036                          ENDIF      
E036                          IF   1-CHECKED   
E036                H_PRINT:   EQU   pr0   
E036                          ENDIF      
E036   20 31 E3     PESC0:    JSR   pesc   ; (an escape, and back into the loop)
E039   20 89 E2     PR0:      JSR   tosget   
E03C   C9 22                  CMP   #22h   
E03E                          IF   1-CHECKED   
E03E   F0 30                  BEQ   pdrop   
E040                          ENDIF      
E040                          IF   CHECKED   
                              BEQ   pq   ; the closing quote, with the carry set
                              TAY      ; (Y is free here)
                              BEQ   pq   ; a NUL, with the carry clear
E040                          ENDIF      
E040   C9 2F                  CMP   #"/"   
E042   D0 0D                  BNE   pr1   
E044   20 89 E2               JSR   tosget   
E047   C9 60                  CMP   #60h   
E049   90 04                  BCC   pr2   
E04B   C9 7F                  CMP   #7Fh   
E04D   90 E7                  BCC   pesc0   ; 60h-7Eh, and the carry is clear
E04F   29 BF        PR2:      AND   #0BFh   
E051   20 03 FF     PR1:      JSR   CONOUT   
E054   4C 39 E0               JMP   pr0   
E057                             ; 22h pushes the address of the text after it and skips the string.
E057   20 E6 E3     H_STR:    JSR   puship   
E05A                          IF   CHECKED   
                              JSR   skipstr   
                              BEQ   e_quote   ; it ran into the end: the place is the 22h
                              RTS      
E05A                          ENDIF      
E05A                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E05A                             ; the next character, so "/"" does not end it.
E05A                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E05A                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E05A                             ; text ended first (a NUL, also one just after "/").
E05A                          IF   1-CHECKED   
E05A   20 69 E4     SKIPSTR:   JSR   getc   
E05D   C9 2F                  CMP   #"/"   
E05F   F0 05                  BEQ   ss0   
E061   C9 22                  CMP   #22h   
E063   D0 F5                  BNE   skipstr   
E065   60                     RTS      
E066   20 6C E4     SS0:      JSR   incip   
E069   D0 EF                  BNE   skipstr   ; A is "/" here
E06B                          ENDIF      
E06B                          IF   CHECKED   
                    SKIPSTR:   JSR   getc   
                              BEQ   ss9   ; the end
                              CMP   #"/"   
                              BNE   ss1   
                              JSR   getc   ; the escaped character
                              BNE   skipstr   
                    SS9:      RTS      ; the end, just after "/"
                    SS1:      CMP   #22h   
                              BNE   skipstr   
                              LSR      ; A = 11h, Z clear
                              RTS      
E06B                          ENDIF      
E06B   B5 00        H_EMIT:   LDA   0,X   ; "'"
E06D   20 03 FF               JSR   CONOUT   
E070   E8           PDROP:    INX      ; a drop for this page's handlers
E071   E8                     INX      
E072   60                     RTS      
E073                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E073                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E073                             ; leaves each remainder in the scratch under the top cell.
E073   B5 01        H_NUM:    LDA   1,X   
E075   10 08                  BPL   pn1   
E077   A9 2D                  LDA   #"-"   
E079   20 03 FF               JSR   CONOUT   
E07C   20 13 E1               JSR   neg   
E07F   A9 0A        PN1:      LDA   #10   
E081   85 05                  STA   D0   
E083   A9 00                  LDA   #0   
E085   85 06                  STA   D1   
E087   48                     PHA      ; the end marker
E088   20 F9 E2     PN2:      JSR   udiv   
E08B   B5 FE                  LDA   0FEh,X   
E08D   09 30                  ORA   #"0"   
E08F   48                     PHA      
E090   B5 00                  LDA   0,X   
E092   15 01                  ORA   1,X   
E094   D0 F2                  BNE   pn2   
E096   68           PN3:      PLA      
E097   F0 D7                  BEQ   pdrop   
E099   20 03 FF               JSR   CONOUT   
E09C   4C 96 E0               JMP   pn3   
E09F                             ; "!" ( n addr -- ): the low byte, then "."s ending for the high byte.
E09F   B5 02        H_STORE:   LDA   2,X   
E0A1                          IF   CHECKED   
                              JSR   chkst   
E0A1                          ENDIF      
E0A1   81 00                  STA   (0,X)   
E0A3   20 8B E2               JSR   inctos   
E0A6   B5 03                  LDA   3,X   
E0A8   4C 2A E1               JMP   st9   
E0AB   B5 00        H_SWAP:   LDA   0,X   ; "%"
E0AD   B4 02                  LDY   2,X   
E0AF   94 00                  STY   0,X   
E0B1   95 02                  STA   2,X   
E0B3   B5 01                  LDA   1,X   
E0B5   B4 03                  LDY   3,X   
E0B7   94 01                  STY   1,X   
E0B9   95 03                  STA   3,X   
E0BB   60                     RTS      
E0BC                             ; "&", and "|" and "^" further down: one byte of the result goes into NOS,
E0BC                             ; and X moves up one. Done twice, that is both bytes, and NOS has become TOS.
E0BC   20 BF E0     H_AND:    JSR   an1   
E0BF   B5 00        AN1:      LDA   0,X   
E0C1   35 02                  AND   2,X   
E0C3   95 02                  STA   2,X   
E0C5   E8                     INX      
E0C6   60                     RTS      
E0C7                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E0C7                             ; the matching ")".
E0C7   20 F6 E3     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E0CA                          IF   (1-CHECKED)*(1-QK)   
E0CA   F0 17                  BEQ   skip   
E0CC                          ENDIF      
E0CC                          IF   CHECKED+QK   
                              BEQ   skpar   
E0CC                          ENDIF      
E0CC                             ; pushn: take the step frame off, push the reading position on the return
E0CC                             ; stack, and go on. With the carry set (a word call) the reading position
E0CC                             ; then becomes the address in the letter cell at LET,Y.
E0CC   68           PUSHN:    PLA      
E0CD   68                     PLA      ; drop the step frame
E0CE   A5 01                  LDA   IP+1   
E0D0   48                     PHA      
E0D1   A5 00                  LDA   IP   
E0D3   48                     PHA      
E0D4   90 0A                  BCC   nxt   
E0D6   B9 00 04               LDA   LET,Y   
E0D9   85 00                  STA   IP   
E0DB   B9 01 04               LDA   LET+1,Y   
E0DE   85 01                  STA   IP+1   
E0E0   4C 20 E0     NXT:      JMP   pnext   
E0E3                             ; ---- no handler starts between here and the next heading: these routines
E0E3                             ; ---- fill the space up to the page boundary and past it ---------------------
E0E3                             ; skip: read past text to the closer at this level, and return it in A.
E0E3                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0E3                             ; NUL first ends the program. (The checked build's skip is further down.)
E0E3                          IF   (1-CHECKED)*(1-QK)   
E0E3   A9 00        SKIP:     LDA   #0   
E0E5   85 06                  STA   T2   ; depth
E0E7   20 69 E4     SK1:      JSR   getc   
E0EA   F0 20                  BEQ   endprog   
E0EC   C9 22                  CMP   #22h   
E0EE   D0 03                  BNE   sk2   
E0F0   20 5A E0               JSR   skipstr   ; leaves A = 22h, which matches nothing below
E0F3   C9 28        SK2:      CMP   #"("   
E0F5   F0 11                  BEQ   sk3   
E0F7   C9 5B                  CMP   #"["   
E0F9   F0 0D                  BEQ   sk3   
E0FB   C9 29                  CMP   #")"   
E0FD   F0 04                  BEQ   sk4   
E0FF   C9 5D                  CMP   #"]"   
E101   D0 E4                  BNE   sk1   
E103   C6 06        SK4:      DEC   T2   
E105   10 E0                  BPL   sk1   
E107   60                     RTS      ; the closer at this level
E108   E6 06        SK3:      INC   T2   
E10A   D0 DB                  BNE   sk1   
E10C   4C 09 FF     ENDPROG:   JMP   EXIT   
E10F                          ENDIF      
E10F                          IF   CHECKED   
                                 ; A false ( skips: the wrong closer for it is ].
                    SKPAR:    LDA   #"]"   
                              JMP   skip   
E10F                          ENDIF      
E10F                          IF   (1-CHECKED)*QK   
                    SKPAR:    JMP   skip   ; (QK: the skip is further down)
E10F                          ENDIF      
E10F                          IF   (1-CHECKED)*QK*(1-FAST)   
                              ;*Macro unroll:  MULQ                    ; (QK: here, where the skip was)
                    MULQ:     LDA   3,X   ; (QK: here, where the skip was)
                              BEQ   mq8   
                              LDA   1,X   
                              BNE   mq16   
                              JSR   h_swap   
                    MQ8:      LDY   #8   
                              LDA   #0   
                              STA   T0   
                              LSR   2,X   
                    MQ1:      BCC   mq2   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              LDA   T1   
                              ADC   1,X   
                    MQ2:      ROR      
                              ROR   T0   
                              ROR   2,X   
                              DEY      
                              BNE   mq1   
                              LDA   T0   
                              STA   3,X   
                              INX      
                              INX      
                              RTS      
                    MQ16:     LDY   #16   
                              LDA   #0   
                              STA   T0   
                              LSR   3,X   
                              ROR   2,X   
                    MQ3:      BCC   mq4   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              LDA   T1   
                              ADC   1,X   
                    MQ4:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              DEY      
                              BNE   mq3   
                              INX      
                              INX      
                              RTS      
E10F                          ENDIF      
E10F                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E10F   B5 01        ABSV:     LDA   1,X   
E111   10 0D        NEGM:     BPL   ab9   
E113                             ; neg: TOS = -TOS
E113   38           NEG:      SEC      
E114   A9 00        NEG1:     LDA   #0   
E116   F5 00                  SBC   0,X   
E118   95 00                  STA   0,X   
E11A   A9 00                  LDA   #0   
E11C   F5 01                  SBC   1,X   
E11E   95 01                  STA   1,X   
E120   60           AB9:      RTS      
E121                             ; =============================================================================
E121                             ;  Page 2 of 3: handlers of ) * + , - . / : ; < = > ?
E121                             ; =============================================================================
E121   B5 00        H_DUP:    LDA   0,X   ; ":"
E123   B4 01                  LDY   1,X   
E125   4C EF E3               JMP   pushay   
E128                             ; "." ( c addr -- ), and the end of "!": store A at TOS, drop both cells.
E128   B5 02        H_CSTORE:   LDA   2,X   
E12A                ST9:         
E12A                          IF   CHECKED   
                              JSR   chkst   
E12A                          ENDIF      
E12A   81 00                  STA   (0,X)   
E12C   E8                     INX      
E12D   E8                     INX      
E12E   E8           DROP:     INX      ; ";"
E12F   E8                     INX      
E130   60                     RTS      
E131                             ; "-" has two jobs: directly before a digit it starts a negative number.
E131   20 4F E4     H_SUB:    JSR   isdig   
E134   90 0F                  BCC   negnum   
E136   20 13 E1     SUB1:     JSR   neg   ; a - b = a + (-b)
E139   18                     CLC      
E13A                             ; "+": one byte at a time, as the logic operators do; the carry goes across.
E13A                             ; It ends with A = the high byte of the sum.
E13A   20 3D E1     H_ADD:    JSR   ad1   
E13D   B5 00        AD1:      LDA   0,X   
E13F   75 02                  ADC   2,X   
E141   95 02                  STA   2,X   
E143   E8                     INX      
E144   60                     RTS      
E145   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E147   20 1D E4               JSR   digit   ; (comes back with the carry set)
E14A   B0 C7                  BCS   neg   ; always: the number, negated
E14C                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E14C                             ; clear for true, and bool turns it into -1 (true) or 0.
E14C   20 AB E0     H_GT:     JSR   h_swap   ; a > b is b < a
E14F   B5 02        H_LT:     LDA   2,X   
E151   D5 00                  CMP   0,X   
E153   B5 03                  LDA   3,X   
E155   F5 01                  SBC   1,X   
E157   70 02                  BVS   lt1   
E159   49 80                  EOR   #80h   
E15B   0A           LT1:      ASL      
E15C   E8                     INX      
E15D   E8                     INX      ; (keeps the carry; X is never 0)
E15E   D0 07                  BNE   bool   ; always
E160   20 36 E1     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E163   15 00                  ORA   0,X   
E165   C9 01                  CMP   #1   ; carry clear if A = 0
E167   A9 00        BOOL:     LDA   #0   
E169   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E16B   95 00                  STA   0,X   
E16D   95 01                  STA   1,X   
E16F   60                     RTS      
E170                             ; "*": the classic shift-right multiply. The multiplier is the NOS cell: it
E170                             ; leaves from the bottom while the product comes in at the top, through
E170                             ; A:T0 above it; after 16 rounds the cell holds the low 16 bits, which are
E170                             ; all that is kept. Dropping TOS (the multiplicand) leaves it on top.
E170                          IF   1-QK   
E170   A0 10        H_MUL:    LDY   #16   ; the round count
E172   A9 00                  LDA   #0   
E174   85 04                  STA   T0   ; A:T0 = the upper half
E176   56 03                  LSR   3,X   
E178   76 02                  ROR   2,X   ; the first multiplier bit
E17A   90 0D        ML1:      BCC   ml2   
E17C   85 05                  STA   T1   
E17E   18                     CLC      
E17F   A5 04                  LDA   T0   
E181   75 00                  ADC   0,X   
E183   85 04                  STA   T0   
E185   A5 05                  LDA   T1   
E187   75 01                  ADC   1,X   ; upper half += the multiplicand
E189   6A           ML2:      ROR      
E18A   66 04                  ROR   T0   
E18C   76 03                  ROR   3,X   
E18E   76 02                  ROR   2,X   ; everything one place right; next bit out
E190   88                     DEY      
E191   D0 E7                  BNE   ml1   
E193   E8                     INX      
