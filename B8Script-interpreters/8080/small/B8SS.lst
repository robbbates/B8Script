                              LHLD   LET+50   
                              MOV   B,H   
                              MOV   C,L   
                              LXI   H,BRKCNT   
                              DCR   M   
                              ;*Macro unroll:  XCHGC
                              DS   CHECKED,0EBh   
                              CZ   pollk   
                              ;*Macro unroll:  NEXTX
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
