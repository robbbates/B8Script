E383   09 01                  ORA   #1   ;   and the low
E385   18                     CLC      
E386   61 00                  ADC   (0,X)   
E388   81 00                  STA   (0,X)   
E38A   48                     PHA      
E38B   20 8C E2               JSR   inctos   ; (keeps the carry)
E38E                          IF   CHECKED   
                              PHP      
                              JSR   chkst   
                              PLP      
E38E                          ENDIF      
E38E   A5 05                  LDA   T1   
E390   61 00                  ADC   (0,X)   
E392   81 00                  STA   (0,X)   
E394   95 01                  STA   1,X   ; the new value is TOS
E396   68                     PLA      
E397   95 00                  STA   0,X   
E399   60                     RTS      
E39A                             ; `. pushes the address of the random seed.
E39A   A9 76        G_SEED:   LDA   #<SEED   
E39C   A0 04                  LDY   #>SEED   
E39E   4C CC E4               JMP   pushay   
E3A1                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
E3A1                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
E3A1                             ; and the low ones repeat soon, so the high byte is folded into the low
E3A1                             ; (EOR) before the remainder of dividing by n is taken.
E3A1                             ; n must be 1 to 32767: the checked build stops with Z on anything less
E3A1                             ; than 1.
E3A1                G_RND:       
E3A1                          IF   CHECKED   
                              LDA   1,X   
                              BMI   gr9   
                              ORA   0,X   
                              BNE   gr8   
                    GR9:      JMP   e_zero   
                    GR8:         
E3A1                          ENDIF      
E3A1   B5 00                  LDA   0,X   
E3A3   85 08                  STA   D0   
E3A5   B5 01                  LDA   1,X   
E3A7   85 09                  STA   D1   ; D = n
E3A9   AD 76 04               LDA   SEED   
E3AC   95 00                  STA   0,X   
E3AE   AD 77 04               LDA   SEED+1   
E3B1   95 01                  STA   1,X   ; the seed in n's place,
E3B3   A9 05                  LDA   #05h   ;   and 261 (0105h) on top of it
E3B5   A0 01                  LDY   #01h   
E3B7   20 CC E4               JSR   pushay   
E3BA   20 69 E1               JSR   h_mul   ; TOS = seed * 261
E3BD   20 8C E2               JSR   inctos   
E3C0   B5 00                  LDA   0,X   
E3C2   8D 76 04               STA   SEED   
E3C5   B5 01                  LDA   1,X   
E3C7   8D 77 04               STA   SEED+1   
E3CA   55 00                  EOR   0,X   
E3CC   95 00                  STA   0,X   
E3CE   20 F2 E2               JSR   udiv   ; TOS = the quotient, the remainder under it
E3D1   CA                     DEX      
E3D2   CA                     DEX      
E3D3   20 A0 E0               JSR   h_swap   
E3D6   4C 23 E1               JMP   drop   ; the remainder is TOS
E3D9                             ; `< and `>: one routine. scmp leaves the carry clear if a < b. Y is odd for
E3D9                             ; "<" and even for ">", so the low bit of Y plus the carry is set when a,
E3D9                             ; the cell below, is the one to keep.
E3D9   20 4B E1     G_MIN:    JSR   scmp   
E3DC   98                     TYA      
E3DD   69 00                  ADC   #0   
E3DF   4A                     LSR      
E3E0   B0 03                  BCS   gm1   
E3E2   20 A0 E0               JSR   h_swap   ; b is wanted: a on top, to be dropped
E3E5   4C 23 E1     GM1:      JMP   drop   
E3E8                          IF   ANSI   
E3E8                             ; `^: ESC [ H homes the cursor, and ESC [ J clears from there to the end of
E3E8                             ; the screen. `_: ESC [ K clears to the end of the line.
E3E8   20 37 E4     G_CLS:    JSR   csi   
E3EB   A9 48                  LDA   #"H"   
E3ED   20 03 FF               JSR   CONOUT   
E3F0   A9 4A                  LDA   #"J"   
E3F2   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E3F3   A9 4B        G_EOL:    LDA   #"K"   
E3F5   48                     PHA      
E3F6   20 37 E4               JSR   csi   
E3F9   68                     PLA      
E3FA   4C 03 FF               JMP   CONOUT   
E3FD                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
E3FD   20 37 E4     G_CUR:    JSR   csi   
E400   A0 02                  LDY   #2   
E402   B9 18 E4     GC1:      LDA   GQ25,Y   
E405   20 03 FF               JSR   CONOUT   
E408   88                     DEY      
E409   10 F7                  BPL   gc1   
E40B   20 D3 E4               JSR   flag   
E40E   F0 03                  BEQ   gc2   
E410   A9 68                  LDA   #"h"   
E412   2C                     DB   2Ch   
E413   A9 6C        GC2:      LDA   #"l"   
E415   4C 03 FF               JMP   CONOUT   
E418   35 32 3F     GQ25:     DB   "5","2","?"   ; (printed from the end)
E41B                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
E41B   20 37 E4     G_AT:     JSR   csi   
E41E   20 A0 E0               JSR   h_swap   ; the row on top
E421   20 31 E4               JSR   pinc   
E424   A9 3B                  LDA   #";"   
E426   20 03 FF               JSR   CONOUT   
E429   20 31 E4               JSR   pinc   
E42C   A9 48                  LDA   #"H"   
E42E   4C 03 FF               JMP   CONOUT   
E431                             ; pinc: print TOS + 1, unsigned, and drop it
E431   20 8C E2     PINC:     JSR   inctos   
E434   4C 74 E0               JMP   pn1   
E437                             ; csi: print ESC [, which starts every ANSI sequence. Keeps X and Y.
E437   A9 1B        CSI:      LDA   #27   
E439   20 03 FF               JSR   CONOUT   
E43C   A9 5B                  LDA   #"["   
E43E   4C 03 FF               JMP   CONOUT   
E441                          ENDIF      
E441                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                                 ; CONCLS and CONEOL are jumped to straight from the table.
                    G_CLS:    EQU   CONCLS   
                    G_EOL:    EQU   CONEOL   
                    G_CUR:    JSR   flag   ; A = 0 and Z set: off
                              JMP   CONCUR   
                    G_AT:     LDY   2,X   ; Y = the row
                              LDA   0,X   ; A = the column
                              JSR   CONAT   
                              INX      
                              INX      
                              JMP   drop   
E441                          ENDIF      
E441                          IF   CHECKED   
                                 ; The checked build's inner loop, out of page 1, where it would not fit,
                                 ; and its break check (described with the unchecked one in page 1).
                                 ; pnext: the break check, then (falling through) next. A word call, a true
                                 ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
                                 ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
                                 ; falls in here too, which does no harm.)
                    PNEXT:    DEC   CDOWN   
                              BNE   next   
                              JSR   KEY   
                              BEQ   next   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JSR   chk3   ; (Ctrl-C: back only if the break key is off)
                    NEXT:        
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE (an
                                 ; underflow) or below DSFULL (an overflow). No handler moves X by
                                 ; more than 4, so X is caught before it wraps; an overrun by a cell
                                 ; or two writes on the scratch bytes below or above the stack.
                                 ; S is kept in RSV, for the report's Rtn line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_sund   
                              CPX   #DSFULL   
                              BCC   e_sovr   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
                              JSR   step   
                              JMP   next   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: Rtn 0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_SUND:   LDX   #DSE   ; Stk 0
                              LDA   #"s"   
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_SOVR:   LDA   #"S"   
                    EJMP:     JMP   error   
                                 ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
                                 ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
                                 ; which takes either. Meeting the wrong closer at this level, or the end
                                 ; (a NUL, or a string that runs into it), stops with N, except for \,
                                 ; which then ends the program as before.
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                              JMP   error   ;   or the end: the place is the opener
E441                          ENDIF      
E441                          IF   1-CHECKED   
E441                CBREAK:   EQU   endp   ; the unchecked build stops without a word
E441                          ENDIF      
E441                          IF   CHECKED   
                    CBREAK:   EQU   e_break   ; the checked build reports B
E441                          ENDIF      
E441                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E441                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E441                             ; taken out of KEYBUF.
E441   AD 7A 04     GETK:     LDA   KEYBUF   
E444   F0 08                  BEQ   gk1   
E446   48                     PHA      
E447   A9 00                  LDA   #0   
E449   8D 7A 04               STA   KEYBUF   
E44C   68                     PLA      
E44D   60                     RTS      
E44E   20 06 FF     GK1:      JSR   KEY   
E451   F0 04                  BEQ   gk9   
E453                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E453                             ; back if it comes back at all.
E453   C9 03        CHK3:     CMP   #3   
E455   F0 01                  BEQ   ctlc   
E457   60           GK9:      RTS      
E458                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E458                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E458                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E458                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E458                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y. (Not D0/D1:
E458                             ; they hold the place in the checked build.)
E458   AD 7B 04     CTLC:     LDA   BRKOFF   
E45B   F0 5D                  BEQ   cbreak   
E45D   A9 28                  LDA   #CWAIT+1   
E45F   85 05                  STA   T1   
E461   20 06 FF     CT2:      JSR   KEY   
E464   D0 0A                  BNE   ct3   
E466   C6 06                  DEC   T2   
E468   D0 F7                  BNE   ct2   
E46A   C6 05                  DEC   T1   
E46C   D0 F3                  BNE   ct2   
E46E   F0 07                  BEQ   ct9   ; always: none came
E470   C9 03        CT3:      CMP   #3   
E472   F0 46                  BEQ   cbreak   
E474   8D 7A 04               STA   KEYBUF   
E477   A9 03        CT9:      LDA   #3   
E479   60                     RTS      
E47A                          IF   CHECKED   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP2:    JMP   error   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; Rtn does not count the call
                              LDA   #"U"   
                              BNE   ejmp2   ; always
E47A                          ENDIF      
E47A                             ; step: read one character and sort it by range.
E47A                             ;    00h          end of program
E47A                             ;    01h-20h, 7Fh-FFh   ignored
E47A                             ;    30h-39h      digit: read a whole number
E47A                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E47A                             ;    61h-7Ah      a-z: push the address of that letter's cell
E47A                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E47A   20 48 E5     STEP:     JSR   getc   ; flags follow A
E47D   F0 3B                  BEQ   endp   
E47F   38                     SEC      
E480   E9 21                  SBC   #21h   ; A = c - 21h
E482   90 35                  BCC   ign   ; 01h-20h
E484   C9 0F                  CMP   #0Fh   
E486   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E488   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E48A   C9 0A                  CMP   #10   
E48C   90 6C                  BCC   digit   
E48E   C9 11                  CMP   #11h   
E490   90 16                  BCC   p3a   ; 3Ah-40h
E492   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E494   C9 1A                  CMP   #1Ah   
E496   90 25                  BCC   upper   ; 41h-5Ah
E498   C9 20                  CMP   #20h   
E49A   90 0A                  BCC   p5b   ; 5Bh-60h
E49C   C9 3A                  CMP   #3Ah   
E49E   90 29                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E4A0   C9 3E                  CMP   #3Eh   
E4A2                          IF   1-CHECKED   
E4A2   B0 15                  BCS   ign   ; 7Fh-FFh
E4A4                          ENDIF      
E4A4                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E4A4                          ENDIF      
E4A4                             ; The three adjustments below chain. Each ADC adds the carry the one
E4A4                             ; before it left, which the constants allow for.
E4A4   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E4A6   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E4A8   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E4AA                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E4AA                             ; the index is N1 or more, plus one more if it is N2 or more.
E4AA   C9 08        PUNCT:    CMP   #N1   
E4AC   A8                     TAY      
E4AD   A9 70                  LDA   #HALFPG   
E4AF   2A                     ROL      ; the first page, or the second (carry clear)
E4B0   C0 15                  CPY   #N2   
E4B2   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E4B4   48                     PHA      
E4B5   B9 DA E4               LDA   PTAB,Y   
E4B8   48                     PHA      
E4B9   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E4BA                             ; directly, it just ends an ignored character.
E4BA                ENDP:        ; the program has ended
E4BA                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E4BA                          ENDIF      
E4BA   4C 09 FF               JMP   EXIT   
E4BD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E4BD                             ; the return stack, and the IP becomes the address in the letter's cell.
E4BD   0A           UPPER:    ASL      
E4BE   A8                     TAY      
E4BF   38                     SEC      
E4C0   4C C1 E0               JMP   pushn   
E4C3   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E4C5   A4 01                  LDY   IP+1   
E4C7   D0 03                  BNE   pushay   ; always: no program is in page zero
E4C9                             ; a-z: push the cell's address (the cell is the variable)
E4C9   0A           LOWER:    ASL      
E4CA   A0 04                  LDY   #>LET   
E4CC                             ; pushay: push a cell: A = its low byte, Y = its high byte
E4CC   CA           PUSHAY:   DEX      
E4CD   CA                     DEX      
E4CE   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E4D0   94 01                  STY   1,X   
E4D2   60                     RTS      
E4D3                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E4D3   E8           FLAG:     INX      
E4D4   E8                     INX      
E4D5   B5 FE                  LDA   0FEh,X   
E4D7   15 FF                  ORA   0FFh,X   
E4D9   60                     RTS      
E4DA                             ; =============================================================================
E4DA                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E4DA                             ;  character, in code order.
E4DA                             ; =============================================================================
E4DA   93           PTAB:     DB   (h_store-1) & 0FFh   ; !
E4DB   4B                     DB   (h_str-1) & 0FFh   ; "
E4DC   67                     DB   (h_num-1) & 0FFh   ; #
E4DD   35                     DB   (h_print-1) & 0FFh   ; $
E4DE   9F                     DB   (h_swap-1) & 0FFh   ; %
E4DF   B0                     DB   (h_and-1) & 0FFh   ; &
E4E0   5F                     DB   (h_emit-1) & 0FFh   ; '
E4E1   BB                     DB   (h_open-1) & 0FFh   ; (
E4E2   BA                     DB   (h_close-1) & 0FFh   ; )
E4E3   68                     DB   (h_mul-1) & 0FFh   ; *
E4E4   2E                     DB   (h_add-1) & 0FFh   ; +
E4E5   B1                     DB   (h_cfetch-1) & 0FFh   ; ,
E4E6   25                     DB   (h_sub-1) & 0FFh   ; -
E4E7   1C                     DB   (h_cstore-1) & 0FFh   ; .
E4E8   8E                     DB   (h_div-1) & 0FFh   ; /
E4E9   15                     DB   (h_dup-1) & 0FFh   ; :
E4EA   22                     DB   (drop-1) & 0FFh   ; ;
E4EB   43                     DB   (h_lt-1) & 0FFh   ; <
E4EC   58                     DB   (h_eq-1) & 0FFh   ; =
E4ED   40                     DB   (h_gt-1) & 0FFh   ; >
E4EE   C1                     DB   (h_key-1) & 0FFh   ; ?
E4EF   7C                     DB   (h_fetch-1) & 0FFh   ; @
E4F0   92                     DB   (h_def-1) & 0FFh   ; [
E4F1   26                     DB   (h_break-1) & 0FFh   ; \
E4F2   38                     DB   (h_ret-1) & 0FFh   ; ]
E4F3   66                     DB   (h_xor-1) & 0FFh   ; ^
E4F4   DA                     DB   (h_alloc-1) & 0FFh   ; _
E4F5   B4                     DB   (h_grave-1) & 0FFh   ; `
E4F6   4A                     DB   (h_tor-1) & 0FFh   ; {
E4F7   71                     DB   (h_or-1) & 0FFh   ; |
E4F8   56                     DB   (h_fromr-1) & 0FFh   ; }
E4F9   63                     DB   (h_not-1) & 0FFh   ; ~
E4FA                             ; Digits: the first one is in A; read the rest of the number.
E4FA   A0 00        DIGIT:    LDY   #0   
E4FC   20 CC E4               JSR   pushay   
E4FF                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E4FF                             ; Returns with the carry set.
E4FF   20 2E E5     RDNUM:    JSR   isdig   
E502   B0 4F                  BCS   ic9   ; (an RTS)
E504   20 4B E5               JSR   incip   ; (keeps A = the digit)
E507   16 00                  ASL   0,X   
E509   36 01                  ROL   1,X   ; x2
E50B   18                     CLC      
E50C   75 00                  ADC   0,X   
E50E   85 04                  STA   T0   
E510   B5 01                  LDA   1,X   
E512   69 00                  ADC   #0   
E514   85 05                  STA   T1   ; T = x2 + digit
E516   16 00                  ASL   0,X   
E518   36 01                  ROL   1,X   
E51A   16 00                  ASL   0,X   
E51C   36 01                  ROL   1,X   ; x8
E51E   18                     CLC      
E51F   B5 00                  LDA   0,X   
E521   65 04                  ADC   T0   
E523   95 00                  STA   0,X   
E525   B5 01                  LDA   1,X   
E527   65 05                  ADC   T1   
E529   95 01                  STA   1,X   ; x8 + x2 + digit
E52B   4C FF E4               JMP   rdnum   
E52E                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E52E                             ; digit. Y = 0.
E52E   20 54 E5     ISDIG:    JSR   peek   
E531   38                     SEC      
E532   E9 30                  SBC   #"0"   
E534   C9 0A                  CMP   #10   
E536   60                     RTS      
E537                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E537                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E537   20 2E E5     RDHEX:    JSR   isdig   
E53A   90 0F                  BCC   incip   
E53C   29 DF                  AND   #0DFh   
E53E   E9 11                  SBC   #11h   ; (the carry is set)
E540   C9 06                  CMP   #6   
E542   B0 0F                  BCS   ic9   
E544   69 0A                  ADC   #10   
E546   D0 03                  BNE   incip   ; always
E548                             ; Reading the program
E548                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E548                             ;    getc: the same, then IP moves on; flags follow A
E548                             ;    incip: IP moves on; keeps A, the carry and Y
E548   20 54 E5     GETC:     JSR   peek   
E54B   E6 00        INCIP:    INC   IP   
E54D   D0 02                  BNE   ic1   
E54F   E6 01                  INC   IP+1   
E551   09 00        IC1:      ORA   #0   
E553   60           IC9:      RTS      
E554   A0 00        PEEK:     LDY   #0   
E556   B1 00                  LDA   (IP),Y   
E558   60                     RTS      
E559                             ; rstip: point IP at the start of the program
E559   A9 00        RSTIP:    LDA   #<PROG   
E55B   85 00                  STA   IP   
E55D   A9 05                  LDA   #>PROG   
E55F   85 01                  STA   IP+1   
E561   60                     RTS      
E562                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
                                 ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   Rtn n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was. With the stack full
                                 ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
                    ERROR:    PHA      ; the letter
                              LDA   PLACE   
                              STA   P   
                              LDA   PLACE+1   
                              STA   P+1   ; (the numbers need D0/D1)
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   LN   
                              LDY   LN+1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   T1   
                              LDY   T2   
                              JSR   prnum   ; the column
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              LDY   #0   ; the text at the place
                    ER1:      LDA   (P),Y   
                              BEQ   er2   
                              CMP   #13   
                              BEQ   er2   
                              CMP   #10   
                              BEQ   er2   
                              JSR   CONOUT   
                              INY      
                              CPY   #16   
                              BNE   er1   
                    ER2:      LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "Stk "
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   
                              LSR      ; the depth, (DSE - X) / 2
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T1   ; T1 = how many cells to show
                              JSR   prs   
                    ER4:      LDA   T1   ; cells T1-1 down to 0, the top last: cell i
                              BEQ   er5   ;   from the top is at X+2i
                              DEC   T1   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   T1   
                              ASL      
                              STA   T2   
                              TXA      
                              ADC   T2   ; (the carry is clear)
                              TAY      
                              LDA   0,Y   
                              PHA      
                              LDA   1,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "Rtn "
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"Stk"," "+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"Rtn"," "+80h   
                                 ; lcol: the line (LN) and the column (T1/T2) of the place at P, both from
                                 ; 1. A place below the program is in the -n? line buffer: line 0, and the
                                 ; column is the place in the buffer. Otherwise IP (free now: the program has
                                 ; stopped) runs from PROG to the place, counting LFs; T1/T2 keeps where the
                                 ; last line started, and the column is the place minus that, plus 1.
                    LCOL:     LDA   #0   
                              STA   LN+1   
                              STA   LN   
                              LDA   #<LINEBUF   
                              STA   T1   
                              LDA   #>LINEBUF   
                              STA   T2   
                              LDA   P   
                              CMP   #<PROG   
                              LDA   P+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   LN   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   T1   
                              LDA   IP+1   
                              STA   T2   
                    LC1:      LDA   IP   
                              CMP   P   
                              LDA   IP+1   
                              SBC   P+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              INC   LN   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   LN+1   
                              BNE   lc3   ; always
                    LC9:      LDA   P   
                              SEC      
                              SBC   T1   
                              STA   T1   
                              LDA   P+1   
                              SBC   T2   
                              STA   T2   
                              INC   T1   ; + 1
                              BNE   lc8   
                              INC   T2   
                    LC8:      RTS      
E562                          ENDIF      


