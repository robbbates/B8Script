0171   69                     MOV   L,C   ; HL = r
0172   F1                     POP   PSW   
0173   FC 20 00               CM   neg16   ; r's sign
0176   C1                     POP   B   
0177   D5                     PUSH   D   ; q under r
0178                          ;*Macro unroll:  NEXT
0178   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0179                          DS   CPM+FAST-CPM*FAST,0C3h   
0179                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0179                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0179                             ; ---- stack and storage -----------------------------------------------------
0179   E5           H_DUP:    PUSH   H   ; ":"
017A                          ;*Macro unroll:  NEXT
017A   F7                     DS   (1-CPM)*(1-FAST),0F7h   
017B                          DS   CPM+FAST-CPM*FAST,0C3h   
017B                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
017B                          DS   CPM+FAST-CPM*FAST,ANXT/256   
017B   E3           H_SWAP:   XTHL      ; "%"
017C                          ;*Macro unroll:  NEXT
017C   F7                     DS   (1-CPM)*(1-FAST),0F7h   
017D                          DS   CPM+FAST-CPM*FAST,0C3h   
017D                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
017D                          DS   CPM+FAST-CPM*FAST,ANXT/256   
017D                             ; (The checked build tests the address before it takes the value off the
017D                             ; stack, so that an error report shows both.)
017D                H_STORE:      ; "!" ( n addr -- )
017D                          IF   CHECKED   
                              CALL   chkst   
017D                          ENDIF      
017D   D1                     POP   D   
017E   73                     MOV   M,E   
017F   23                     INX   H   
0180   72                     MOV   M,D   
0181                          ;*Macro unroll:  DROP
0181   DF                     DS   (1-CPM)*(1-FAST),0DFh   
0182                          DS   CPM*(1-FAST),0C3h   
0182                          DS   CPM*(1-FAST),ADRP&0FFh   
0182                          DS   CPM*(1-FAST),ADRP/256   
0182                          DS   FAST,0E1h   
0182                          DS   FAST,0C3h   
0182                          DS   FAST,ANXT&0FFh   
0182                          DS   FAST,ANXT/256   
0182                H_CSTORE:      ; "." ( c addr -- )
0182                          IF   CHECKED   
                              CALL   chkst   
0182                          ENDIF      
0182   D1                     POP   D   
0183   73                     MOV   M,E   
0184                          ;*Macro unroll:  DROP
0184   DF                     DS   (1-CPM)*(1-FAST),0DFh   
0185                          DS   CPM*(1-FAST),0C3h   
0185                          DS   CPM*(1-FAST),ADRP&0FFh   
0185                          DS   CPM*(1-FAST),ADRP/256   
0185                          DS   FAST,0E1h   
0185                          DS   FAST,0C3h   
0185                          DS   FAST,ANXT&0FFh   
0185                          DS   FAST,ANXT/256   
0185                             ; ---- console ---------------------------------------------------------------
0185                             ; 22h pushes the address of the text after it and skips the string.
0185   E5           H_STR:    PUSH   H   
0186   60                     MOV   H,B   
0187   69                     MOV   L,C   
0188   CD 7C 03               CALL   skipstr   
018B                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
018B                          ENDIF      
018B                          ;*Macro unroll:  NEXT
018B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
018C                          DS   CPM+FAST-CPM*FAST,0C3h   
018C                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
018C                          DS   CPM+FAST-CPM*FAST,ANXT/256   
018C                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
018C                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
018C                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
018C                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
018C                          IF   1-CHECKED   
018C   C3 A4 02     H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
018F                PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
018F                PRAGAIN:   EQU   prlp   ;   the image's first two pages)
018F                          ENDIF      
018F                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   SHLD   PSAVE   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ADRP&0FFh   
                              DS   CPM*(1-FAST),ADRP/256   
                              DS   FAST,0E1h   
                              DS   FAST,0C3h   
                              DS   FAST,ANXT&0FFh   
                              DS   FAST,ANXT/256   
018F                          ENDIF      
018F   7D           H_EMIT:   MOV   A,L   ; "'"
0190                          ;*Macro unroll:  PUTA
0190   EF                     DS   1-CPM,0EFh   
0191                          DS   CPM,0CDh   
0191                          DS   CPM,APUT&0FFh   
0191                          DS   CPM,APUT/256   
0191                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
0191   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
0192                          DS   CPM*(1-FAST),0C3h   
0192                          DS   CPM*(1-FAST),ADRP&0FFh   
0192                          DS   CPM*(1-FAST),ADRP/256   
0192                          DS   FAST,0E1h   
0192                          DS   FAST,0C3h   
0192                          DS   FAST,ANXT&0FFh   
0192                          DS   FAST,ANXT/256   
0192                             ; "#" prints TOS as a signed decimal number, with no space after it.
0192   C5           H_NUM:    PUSH   B   
0193   CD 69 02               CALL   psgn   
0196   C1                     POP   B   
0197                          ;*Macro unroll:  DROP
0197   DF                     DS   (1-CPM)*(1-FAST),0DFh   
0198                          DS   CPM*(1-FAST),0C3h   
0198                          DS   CPM*(1-FAST),ADRP&0FFh   
0198                          DS   CPM*(1-FAST),ADRP/256   
0198                          DS   FAST,0E1h   
0198                          DS   FAST,0C3h   
0198                          DS   FAST,ANXT&0FFh   
0198                          DS   FAST,ANXT/256   
0198                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0198                          ENDIF      
0198                             ; "?" ( n -- c ) or ( -n -- addr )
0198                             ;   n > 0: wait about n ms for a key; 0 if none came
0198                             ;   n = 0: wait for a key
0198                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
0198                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
0198   7C           H_KEY:    MOV   A,H   
0199   B7                     ORA   A   
019A   FA BA 01               JM   line   
019D   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
019F   CD 39 04     KT2:      CALL   getk   
01A2   C2 B6 01               JNZ   kt3   
01A5   1D                     DCR   E   
01A6   C2 9F 01               JNZ   kt2   
01A9   7C                     MOV   A,H   ; 0? never counts down: it waits
01AA   B5                     ORA   L   
01AB   CA 9D 01               JZ   kt1   
01AE   2B                     DCX   H   
01AF   7C                     MOV   A,H   
01B0   B5                     ORA   L   
01B1   C2 9D 01               JNZ   kt1   ; A = 0 if the time ran out
01B4                          IF   1-CHECKED   
01B4   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
01B5   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01B6                          ENDIF      
01B6   6F           KT3:      MOV   L,A   
01B7   26 00                  MVI   H,0   
01B9                          ;*Macro unroll:  NEXT
01B9   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01BA                          DS   CPM+FAST-CPM*FAST,0C3h   
01BA                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01BA                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01BA                             ; Backspace takes the last character back (and is echoed as
01BA                             ; it is), CR ends (stored, not echoed), every other key is stored and
01BA                             ; echoed until the line is full. The line buffer starts at offset 80h
01BA                             ; of its page, so L alone is the place in the line: D holds the L of
01BA                             ; a full line.
01BA   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
01BD   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
01BE   9F                     SBB   A   
01BF   A5                     ANA   L   ; (0 for a count that is too big)
01C0   2F                     CMA      
01C1   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
01C2                             ;   at most
01C2   21 80 82               LXI   H,LINEBUF   
01C5   CD 39 04     LN2:      CALL   getk   
01C8   CA C5 01               JZ   ln2   
01CB   FE 0D                  CPI   13   
01CD   CA EA 01               JZ   ln5   
01D0   FE 08                  CPI   8   
01D2   CA E2 01               JZ   ln4   
01D5   5F                     MOV   E,A   
01D6   7D                     MOV   A,L   
01D7   BA                     CMP   D   
01D8   CA C5 01               JZ   ln2   ; full
01DB   73                     MOV   M,E   
01DC   2C                     INR   L   
01DD   7B                     MOV   A,E   
01DE                          ;*Macro unroll: ln3:    PUTA
01DE   EF           LN3:      DS   1-CPM,0EFh   
01DF                          DS   CPM,0CDh   
01DF                          DS   CPM,APUT&0FFh   
01DF                          DS   CPM,APUT/256   
01DF   C3 C5 01               JMP   ln2   
01E2   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
01E3   FA DE 01               JM   ln3   ;   unless the line was empty (L left the
01E6   2C                     INR   L   ;   upper half of the page)
01E7   C3 C5 01               JMP   ln2   
01EA   77           LN5:      MOV   M,A   ; the CR
01EB   2E 80                  MVI   L,LINEBUF & 0FFh   
01ED                          ;*Macro unroll:  NEXT
01ED   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01EE                          DS   CPM+FAST-CPM*FAST,0C3h   
01EE                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01EE                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01EE                             ; =============================================================================
01EE                             ;  Dispatch table: the low byte of each handler's address, in code order.
01EE                             ;  It must not cross a page (the dispatcher only adds to its low byte).
01EE                             ; =============================================================================
01EE                             ; The handlers of the first NPG1 characters start in the image's second page.
01EE                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
01EE                             ; differs between the builds, so the count is worked out here.
01EE                             ; (One division to a line: asm80 only rounds down when it stores a value.)
01EE                          IF   1-FAST   
01EE                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
01EE                PGBRK:    EQU   (h_break-BASE)/256   
01EE                PGDEF:    EQU   (h_def-BASE)/256   
01EE                PGFET:    EQU   (h_fetch-BASE)/256   
01EE                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
01EE                          ENDIF      
01EE                          IF   (1-FAST)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
01EE                          ENDIF      
01EE                             ; =============================================================================
01EE                             ;  Routines (no handler starts past this point)
01EE                             ; =============================================================================
01EE                             ; Digits: step back onto the first digit and read the whole number.
01EE   E5           DIGIT:    PUSH   H   
01EF   0B                     DCX   B   
01F0   CD FA 01               CALL   rdnum   
01F3                          ;*Macro unroll:  NEXT
01F3   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01F4                          DS   CPM+FAST-CPM*FAST,0C3h   
01F4                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01F4                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01F4                             ; negnum: "-" directly before a digit: read the number, negate it.
01F4   E5           NEGNUM:   PUSH   H   
01F5   CD FA 01               CALL   rdnum   
01F8                          ;*Macro unroll:  NEGH
01F8   E7                     DS   1-CPM,0E7h   
01F9                          DS   CPM,0CDh   
01F9                          DS   CPM,ANEG&0FFh   
01F9                          DS   CPM,ANEG/256   
01F9                          ;*Macro unroll:  NEXT
01F9   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01FA                          DS   CPM+FAST-CPM*FAST,0C3h   
01FA                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01FA                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01FA                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
01FA                             ; non-digit. Values wrap at 16 bits, as the spec says.
01FA   21 00 00     RDNUM:    LXI   H,0   
01FD   0A           RDN1:     LDAX   B   
01FE   D6 30                  SUI   "0"   
0200   FE 0A                  CPI   10   
0202   D0                     RNC      
0203   03                     INX   B   
0204   54                     MOV   D,H   
0205   5D                     MOV   E,L   
0206   29                     DAD   H   
0207   29                     DAD   H   
0208   19                     DAD   D   
0209   29                     DAD   H   ; HL * 10
020A   5F                     MOV   E,A   
020B   16 00                  MVI   D,0   
020D   19                     DAD   D   
020E   C3 FD 01               JMP   rdn1   
0211                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0211                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0211                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0211                             ; lives on the stack, since A is busy with the shifts.
0211                             ; Dividing by 2 is one shift (the spec wants that fast).
0211   01 00 00     UDIV:     LXI   B,0   
0214                          IF   1-QK   
                              MOV   A,E   
                              XRI   2   
                              ORA   D   
                              JNZ   udv0   
                              ORA   H   ; A was 0, and the carry is clear
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   ; the quotient
                              MOV   A,B   
                              RAL      
                              MOV   C,A   ; the remainder: the bit that fell out
                              RET      
0214                          ENDIF      
0214                          IF   QK   
0214                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0214                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0214   7A                     MOV   A,D   
0215   B7                     ORA   A   
0216   C2 34 02               JNZ   uq1   ; 256 and up
0219   B3                     ORA   E   
021A   CA 4B 02               JZ   udv0   ; by 0: the long way (it means nothing anyway)
021D   3D                     DCR   A   
021E   A3                     ANA   E   
021F   C2 4B 02               JNZ   udv0   ; not a power of two
0222   7B                     MOV   A,E   ; by 2^k below 256: q = HL >> k, and
0223   3D                     DCR   A   ;   r = L & (2^k - 1)
0224   A5                     ANA   L   
0225   4F                     MOV   C,A   
0226                          ENDIF      
0226                          IF   QK*(1-FAST)   
0226   7B           UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
0227   B7                     ORA   A   
0228   1F                     RAR      
0229   D8                     RC      
022A   5F                     MOV   E,A   
022B   7C                     MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
022C   1F                     RAR      
022D   67                     MOV   H,A   
022E   7D                     MOV   A,L   
022F   1F                     RAR      
0230   6F                     MOV   L,A   
0231   C3 26 02               JMP   uq2   
0234                          ENDIF      
0234                          IF   FAST   
                                 ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
                                 ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
                    UQ2:      MOV   A,E   
                              CPI   16   
                              JNC   uqh   
                              CPI   2   
                              RC      ; by 1
                              JZ   ur1   
                              CPI   4   
                              JZ   ur2   
                    UR3:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR2:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR1:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              RET      
                    UQH:      CPI   64   
                              MVI   A,0   
                              JZ   ul2   
                              JNC   ul1   
                              MOV   A,E   
                              CPI   32   
                              MVI   A,0   
                              JZ   ul3   
                              DAD   H   ; by 16
                              ADC   A   
                    UL3:      DAD   H   
                              ADC   A   
                    UL2:      DAD   H   
                              ADC   A   
                    UL1:      DAD   H   
                              ADC   A   
                              MOV   L,H   
                              MOV   H,A   
                              RET      
0234                          ENDIF      
0234                          IF   QK   
0234   7B           UQ1:      MOV   A,E   
0235   B7                     ORA   A   
0236   C2 4B 02               JNZ   udv0   
0239   7A                     MOV   A,D   
023A   3D                     DCR   A   
023B   A2                     ANA   D   
023C   C2 4B 02               JNZ   udv0   ; not a power of two
023F   7A                     MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
0240   3D                     DCR   A   ;   q = H >> (k - 8)
0241   A4                     ANA   H   
0242   47                     MOV   B,A   
0243   4D                     MOV   C,L   
0244   6C                     MOV   L,H   
0245   26 00                  MVI   H,0   
0247   5A                     MOV   E,D   
0248   C3 26 02               JMP   uq2   
024B                          ENDIF      
024B                          IF   1-FAST   
024B   3E 10        UDV0:     MVI   A,16   
024D   F5                     PUSH   PSW   
024E   29           UDV1:     DAD   H   ; next dividend bit into the carry
024F   79                     MOV   A,C   
0250   17                     RAL      
0251   4F                     MOV   C,A   
0252   78                     MOV   A,B   
0253   17                     RAL      
0254   47                     MOV   B,A   ; BC = BC*2 + bit
0255   79                     MOV   A,C   
0256   93                     SUB   E   
0257   78                     MOV   A,B   
0258   9A                     SBB   D   ; carry if BC < DE
0259   DA 61 02               JC   udv2   
025C   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
025D   79                     MOV   A,C   
025E   93                     SUB   E   
025F   4F                     MOV   C,A   
0260   2C                     INR   L   ; quotient bit
0261   F1           UDV2:     POP   PSW   
0262   3D                     DCR   A   
0263   F5                     PUSH   PSW   
0264   C2 4E 02               JNZ   udv1   
0267   F1                     POP   PSW   
0268   C9                     RET      
0269                          ENDIF      
0269                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
                                 ; starts 8 bits up and takes only the last 8, since its first 8 would only
                                 ; shift zeros)
                    UDV0:     MOV   A,H   
                              ORA   A   
                              JZ   uvs   
                    UV0:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw0   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW0:         
                    UV1:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw1   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW1:         
                    UV2:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
