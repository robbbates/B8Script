05B6   7D           TA1:      LD   A,L   
05B7   BA                     CP   D   
05B8   28 05                  JR   Z,ta2   
05BA   7E                     LD   A,(HL)   
05BB   EF                     RST   28h   
05BC   2C                     INC   L   
05BD   18 F7                  JR   ta1   
05BF   7D           TA2:      LD   A,L   
05C0   B9                     CP   C   
05C1   C8                     RET   Z   
05C2   3E 08                  LD   A,8   
05C4   EF                     RST   28h   
05C5   2D                     DEC   L   
05C6   18 F7                  JR   ta2   
