  1216 0000051F 85C0                <1>         test    eax,eax
  1217 00000521 7551                <1>         jnz     .wk8                    ; the timer, or WAIT_TIMEOUT: no key
  1218 00000523 8D4510              <1>         lea     eax,[V(v_cnt)]
  1219 00000526 50                  <1>         push    eax
  1220 00000527 6A01                <1>         push    1
