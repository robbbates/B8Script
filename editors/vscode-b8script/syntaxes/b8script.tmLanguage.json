{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "B8Script",
  "scopeName": "source.b8script",
  "comment": "Every command is one character. A comment is a string dropped at once: \"text\"; (it pushes the string's address and ; drops it).",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#definition" },
    { "include": "#number" },
    { "include": "#machine-code" },
    { "include": "#word" },
    { "include": "#variable" },
    { "include": "#control" },
    { "include": "#io" },
    { "include": "#stack" },
    { "include": "#memory" },
    { "include": "#arithmetic" },
    { "include": "#reserved" }
  ],
  "repository": {
    "comment": {
      "comment": "A string followed (after optional blanks) by ; on the same line. A / escapes the next character, quotes included.",
      "match": "\"(?:/.|[^\"/])*\"[ \\t]*;",
      "name": "comment.line.b8script"
    },
    "string": {
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.b8script" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.b8script" } },
      "name": "string.quoted.double.b8script",
      "patterns": [
        {
          "comment": "/a to /z print a variable as # does",
          "match": "/[a-z]",
          "name": "variable.other.escape.b8script"
        },
        {
          "comment": "the console escapes: /{ clear screen, /} clear to end of line, /| show and /` hide the cursor, /~ move it",
          "match": "/[{}|`~]",
          "name": "constant.character.escape.console.b8script"
        },
        {
          "comment": "/ and any other character: that character with bit 6 cleared (/M is CR, /J is LF, /\" a quote, // a slash)",
          "match": "/.",
          "name": "constant.character.escape.b8script"
        }
      ]
    },
    "definition": {
      "patterns": [
        {
          "comment": "[X defines word X",
          "match": "(\\[)([A-Z])",
          "captures": {
            "1": { "name": "keyword.control.definition.b8script" },
            "2": { "name": "entity.name.function.definition.b8script" }
          }
        },
        {
          "comment": "[x stores a block's address in variable x",
          "match": "(\\[)([a-z])",
          "captures": {
            "1": { "name": "keyword.control.definition.b8script" },
            "2": { "name": "variable.other.definition.b8script" }
          }
        }
      ]
    },
    "number": {
      "comment": "a - directly before a digit starts a negative number",
      "match": "-?[0-9]+",
      "name": "constant.numeric.decimal.b8script"
    },
    "machine-code": {
      "patterns": [
        {
          "comment": "` and hex digits load machine code; ` and anything else calls it",
          "match": "(`)([0-9A-Fa-f]+)",
          "captures": {
            "1": { "name": "keyword.other.machine-code.b8script" },
            "2": { "name": "constant.numeric.hex.b8script" }
          }
        },
        { "match": "`", "name": "keyword.other.machine-code.b8script" }
      ]
    },
    "word": { "match": "[A-Z]", "name": "entity.name.function.call.b8script" },
    "variable": { "match": "[a-z]", "name": "variable.other.b8script" },
    "control": { "match": "[()\\[\\]\\\\]", "name": "keyword.control.b8script" },
    "io": { "match": "[$#'?]", "name": "keyword.other.io.b8script" },
    "stack": { "match": "[:;%{}]", "name": "keyword.operator.stack.b8script" },
    "memory": { "match": "[@!,._]", "name": "keyword.operator.memory.b8script" },
    "arithmetic": { "match": "[-+*/&|^~<=>]", "name": "keyword.operator.arithmetic.b8script" },
    "reserved": {
      "comment": "bytes 80h-FFh are reserved outside strings",
      "match": "[\\x{80}-\\x{FF}]",
      "name": "invalid.illegal.reserved.b8script"
    }
  }
}
