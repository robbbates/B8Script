0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet
0001   32 00 83               LD   (PROG),A   
0004                          ENDIF      
0004                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0004                          ENDIF      
0004                          IF   EDGEN*CHECKED   
0004   C3 51 04               JP   init   ; 04  (and no key held back)
0007                          ENDIF      
0007                          IF   EDGEN   
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 9A 04     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 B7 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 36 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 5D                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 5F                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 51                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 6F 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 C2        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 02                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE D8                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0072                          ENDIF      
0072                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0072                          ENDIF      
0072                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0072                          ENDIF      
0072                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0072                          ENDIF      
0072                             ; In the unchecked generic editor build the table is here, in the first
0072                             ; page, which saves loading D twice. (The other builds have no room for it
0072                             ; here: theirs is further down.)
0072                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0072                          ENDIF      
0072                             ; =============================================================================
0072                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0072                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0072                             ;  is here too: it belongs to "`" and makes the page come out right.
0072                             ; =============================================================================
0072   D1           H_XOR:    POP   DE   
0073   7C                     LD   A,H   
0074   AA                     XOR   D   
0075   67                     LD   H,A   
0076   7D                     LD   A,L   
0077   AB                     XOR   E   
0078   6F                     LD   L,A   
0079   F7                     RST   30h   
007A   D1           H_OR:     POP   DE   
007B   7C                     LD   A,H   
007C   B2                     OR   D   
007D   67                     LD   H,A   
007E   7D                     LD   A,L   
007F   B3                     OR   E   
0080   6F                     LD   L,A   
0081   F7                     RST   30h   
0082   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0083   2B                     DEC   HL   
0084   F7                     RST   30h   
0085                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0085                             ; the same either way); TOS is the old pointer.
0085   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0089                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0089                          ENDIF      
0089   19                     ADD   HL,DE   ; the new top
008A                          IF   CHECKED   
008A   CD FC 02               CALL   chkhp   
008D                          ENDIF      
008D   22 7C 82               LD   (HEAP),HL   
0090   EB                     EX   DE,HL   
0091   F7                     RST   30h   
0092   D9           EXEC:     EXX      
0093   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
0096   D9                     EXX      
0097   CD 2B 00               CALL   jphl   
009A   D9                     EXX      
009B   2A 34 82               LD   HL,(RSAVE)   
009E   D9                     EXX      
009F   E1                     POP   HL   
00A0   F7                     RST   30h   
00A1                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00A1                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00A1                             ; Digits: step back onto the first digit and read the whole number.
00A1   E5           DIGIT:    PUSH   HL   
00A2   0B                     DEC   BC   
00A3   CD 32 02               CALL   rdnum   
00A6   F7                     RST   30h   
00A7                             ; a-z: push the cell's address (the cell is the variable)
00A7   E5           LOWER:    PUSH   HL   
00A8   87                     ADD   A,A   
00A9   6F                     LD   L,A   
00AA   26 82                  LD   H,LETPAGE   
00AC   F7                     RST   30h   
00AD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00AD                             ; the return stack, and the IP becomes the address in the letter's cell.
00AD   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00AE   EB                     EX   DE,HL   ; park TOS
00AF   87                     ADD   A,A   
00B0   6F                     LD   L,A   
00B1   26 82                  LD   H,LETPAGE   ; HL -> cell
00B3   4E                     LD   C,(HL)   
00B4   2C                     INC   L   
00B5   46                     LD   B,(HL)   ; IP = the word's body
00B6   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B7                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B7                             ; stack, then next. Everything that pushes the return stack ends here.
00B7                RPUSHN:      
00B7                          IF   CHECKED   
00B7   CD 63 03               CALL   chkbrk   ; Ctrl-C is checked at every word call, block
00BA                          ENDIF      ;   entry, loop-back and "{"
00BA   D9                     EXX      
00BB   D1                     POP   DE   
00BC   2B                     DEC   HL   
00BD   72                     LD   (HL),D   
00BE   2B                     DEC   HL   
00BF   73                     LD   (HL),E   
00C0   D9                     EXX      
00C1   F7                     RST   30h   
00C2                             ; ---- machine code: the grave -----------------------------------------------
00C2                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00C2                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00C2                             ; written and its address is left. An odd last digit is consumed and dropped.
00C2                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00C2                             ; code is entered by CALL with the data stack above the return address; it
00C2                             ; must keep BC, and on return the top cell becomes the new TOS.
00C2   CD B0 02     H_GRAVE:   CALL   hexc   
00C5   30 CB                  JR   NC,exec   
00C7   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00C8   CD B0 02               CALL   hexc   
00CB   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00CD   ED 6F                  RLD      ;   overwrites it
00CF   23                     INC   HL   ; ... and RLD shifts it up under the low one
00D0   CD B0 02               CALL   hexc   
00D3   38 F2                  JR   C,hx1   
00D5   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00D7   F7                     RST   30h   
00D8                             ; ---- where the two pages meet ----------------------------------------------
00D8                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00D8                             ; are in falling code order for this), and where exactly differs between the
00D8                             ; builds: NPG1 follows. Every handler below these four must start in the
00D8                             ; second page, and every one above in the first; chktab.py checks both.
00D8                             ; "]" returns: pop an address and jump to it.
00D8   CF           H_RET:    RST   08h   
00D9   42                     LD   B,D   
00DA   4B                     LD   C,E   
00DB   F7           BRK1:     RST   30h   
00DC                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00DC                             ; drops the block start, "]" returns. No closer at all ends the program.
00DC   7C           H_BREAK:   LD   A,H   
00DD   B5                     OR   L   
00DE   E1                     POP   HL   
00DF   28 FA                  JR   Z,brk1   
00E1   CD 59 02               CALL   skip   
00E4   B7                     OR   A   ; skip returns 0 for ")"
00E5   20 F1                  JR   NZ,h_ret   
00E7   CF           RDROP:    RST   08h   
00E8   F7                     RST   30h   
00E9                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00E9                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00E9                             ; the body"s address instead. Either way it then skips to the matching "]'.
00E9                             ; (The unchecked build takes anything that is not a letter as the space; the
00E9                             ; checked build stops on it.)
00E9   0A           H_DEF:    LD   A,(BC)   
00EA   03                     INC   BC   
00EB   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00ED   5F                     LD   E,A   ;   lands 64 bytes up
00EE   E6 DF                  AND   0DFh   ; fold case
00F0   FE 1A                  CP   26   
00F2   30 0B                  JR   NC,def2   ; not a letter
00F4   CB 23                  SLA   E   
00F6   16 82                  LD   D,LETPAGE   ; DE -> cell
00F8   79                     LD   A,C   
00F9   12                     LD   (DE),A   
00FA   1C                     INC   E   
00FB   78                     LD   A,B   
00FC   12                     LD   (DE),A   
00FD   18 09                  JR   skipnx   
00FF                DEF2:        
00FF                          IF   CHECKED   
00FF   7B                     LD   A,E   
0100   FE DF                  CP   " "-"A"+256   
0102   C2 8F 03               JP   NZ,e_brack   ; anything but a letter or a space
0105                          ENDIF      
0105   E5                     PUSH   HL   ; an anonymous block: push its address
0106   60                     LD   H,B   
0107   69                     LD   L,C   
0108                SKIPNX:      
0108                          IF   CHECKED   
0108   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0109                          ENDIF      ;   opener, the "[", just before where it starts
0109   CD 59 02     SKIPO:    CALL   skip   
010C   F7                     RST   30h   
010D   5E           H_FETCH:   LD   E,(HL)   ; "@"
010E   23                     INC   HL   
010F   56                     LD   D,(HL)   
0110   EB                     EX   DE,HL   
0111   F7                     RST   30h   
0112                             ; =============================================================================
0112                             ;  Handlers that must start in the image's second page.
0112                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0112                             ;  page.
0112                             ; =============================================================================
0112                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0112                             ; the matching ")".
0112   7C           H_OPEN:   LD   A,H   
0113   B5                     OR   L   
0114   E1                     POP   HL   
0115   28 F2                  JR   Z,skipo   
0117   C5                     PUSH   BC   ; the block starts at the IP
0118   18 9D                  JR   rpushn   
011A                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
011A                             ; drops it and carries on.
011A   7C           H_CLOSE:   LD   A,H   
011B   B5                     OR   L   
011C   E1                     POP   HL   
011D   28 C8                  JR   Z,rdrop   
011F   CF                     RST   08h   ; pop the block start ...
0120   42                     LD   B,D   
0121   4B                     LD   C,E   
0122   C5                     PUSH   BC   
0123   18 92                  JR   rpushn   ; ... and push it back
0125                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0125                             ; "-" has two jobs: directly before a digit it starts a negative number.
0125   0A           H_SUB:    LD   A,(BC)   
0126   D6 30                  SUB   "0"   
0128   FE 0A                  CP   10   
012A   38 04                  JR   C,negnum   
012C   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
012D   D1           H_ADD:    POP   DE   
012E   19                     ADD   HL,DE   
012F   F7                     RST   30h   
0130   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0131   CD 32 02               CALL   rdnum   
0134   E7                     RST   20h   
0135   F7                     RST   30h   
0136   D1           H_AND:    POP   DE   
0137   7C                     LD   A,H   
0138   A2                     AND   D   
0139   67                     LD   H,A   
013A   7D                     LD   A,L   
013B   A3                     AND   E   
013C   6F                     LD   L,A   
013D   F7                     RST   30h   
013E                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
013E                             ; cells first. Flipping both sign bits turns a signed compare into an
013E                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
013E                             ; carry into -1 or 0 with no branch.
013E   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
013F   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0140   7C                     LD   A,H   
0141   EE 80                  XOR   80h   
0143   67                     LD   H,A   
0144   7A                     LD   A,D   
0145   EE 80                  XOR   80h   
0147   57                     LD   D,A   
0148   ED 52                  SBC   HL,DE   ; carry if HL < DE
014A   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
014C   F7                     RST   30h   
014D   D1           H_EQ:     POP   DE   
014E   B7                     OR   A   
014F   ED 52                  SBC   HL,DE   
0151   7C                     LD   A,H   
0152   B5                     OR   L   
0153   FE 01                  CP   1   ; carry only if a - b = 0
0155   18 F3                  JR   tf   
0157                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0157                             ; multiplier shifts up through A:C.
0157   D1           H_MUL:    POP   DE   ; DE = multiplicand
0158   C5                     PUSH   BC   
0159   7C                     LD   A,H   
015A   4D                     LD   C,L   ; A:C = multiplier
015B   21 00 00               LD   HL,0   
015E   06 10                  LD   B,16   
0160   29           MUL1:     ADD   HL,HL   
0161   CB 21                  SLA   C   
0163   17                     RLA      
0164   30 01                  JR   NC,mul2   
0166   19                     ADD   HL,DE   
0167   10 F7        MUL2:     DJNZ   mul1   
0169   C1                     POP   BC   
016A   F7                     RST   30h   
016B                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
016B                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
016B                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
016B                             ; stops on it.
016B                H_DIV:       
016B                          IF   CHECKED   
016B   7C                     LD   A,H   
016C   B5                     OR   L   
016D   CA 8C 03               JP   Z,e_zero   
0170                          ENDIF      
0170   D1                     POP   DE   ; DE = a, HL = b
0171   C5                     PUSH   BC   ; free BC for udiv
0172   D5                     PUSH   DE   ; a, for r's sign
0173   7A                     LD   A,D   
0174   AC                     XOR   H   
0175   F5                     PUSH   AF   ; S flag = sign of q
0176   CB 7C                  BIT   7,H   
0178   C4 20 00               CALL   NZ,neg16   ; HL = |b|
017B   EB                     EX   DE,HL   
017C   CB 7C                  BIT   7,H   
017E   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0181   CD 0C 02               CALL   udiv   ; HL = q, DE = r
0184   F1                     POP   AF   
0185   FC 20 00               CALL   M,neg16   ; q's sign
0188   EB                     EX   DE,HL   ; HL = r, DE = q
0189   F1                     POP   AF   ; A = a's high byte
018A   B7                     OR   A   
018B   FC 20 00               CALL   M,neg16   ; r's sign
018E   C1                     POP   BC   
018F   D5                     PUSH   DE   ; q under r
0190   F7                     RST   30h   
0191                             ; ---- stack and storage -----------------------------------------------------
0191   E5           H_DUP:    PUSH   HL   ; ":"
0192   F7                     RST   30h   
0193   E3           H_SWAP:   EX   (SP),HL   ; "%"
0194   F7                     RST   30h   
0195                             ; (The checked build tests the address before it takes the value off the
0195                             ; stack, so that an error report shows both.)
0195                H_CSTORE:      ; "." ( c addr -- )
0195                          IF   CHECKED   
0195   CD EF 02               CALL   chkst   
0198                          ENDIF      
0198   D1                     POP   DE   
0199   73                     LD   (HL),E   
019A   DF           H_DROP:   RST   18h   ; ";" is this one byte
019B                H_STORE:      ; "!" ( n addr -- )
019B                          IF   CHECKED   
019B   CD EF 02               CALL   chkst   
019E                          ENDIF      
019E   D1                     POP   DE   
019F   73                     LD   (HL),E   
01A0   23                     INC   HL   
01A1   72                     LD   (HL),D   
01A2   DF                     RST   18h   
01A3                             ; ---- console ---------------------------------------------------------------
01A3                             ; 22h pushes the address of the text after it and skips the string.
01A3   E5           H_STR:    PUSH   HL   
01A4   60                     LD   H,B   
01A5   69                     LD   L,C   
01A6   CD 48 02               CALL   skipstr   
01A9                          IF   CHECKED   
01A9   B7                     OR   A   ; 0: the text ran out before the closing quote
01AA   CA 84 03               JP   Z,e_quote   
01AD                          ENDIF      
01AD   F7                     RST   30h   
01AE                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01AE                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01AE                             ; bit 6, so // and /" give themselves).
01AE                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
01AE                          ENDIF      
01AE                          IF   CHECKED   
01AE                             ; (The checked build has the loop as a routine, prstr, which the error
01AE                             ; report uses too. The address is kept on the stack meanwhile: a report
01AE                             ; shows the stack as it was before the "$".)
01AE   E5           H_PRINT:   PUSH   HL   
01AF   CD 10 03               CALL   prstr   
01B2   D1                     POP   DE   
01B3   DF                     RST   18h   
01B4                          ENDIF      
01B4   7D           H_EMIT:   LD   A,L   ; "'"
01B5   EF                     RST   28h   
01B6   DF           PR9:      RST   18h   
01B7                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B7   C5           H_NUM:    PUSH   BC   
01B8   CD 96 02               CALL   psgn   
01BB   C1                     POP   BC   
01BC   DF                     RST   18h   
01BD                             ; "?" ( n -- c ) or ( -n -- addr )
01BD                             ;   n > 0: wait about n ms for a key; 0 if none came
01BD                             ;   n = 0: wait for a key
01BD                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BD                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BD   CB 7C        H_KEY:    BIT   7,H   
01BF   20 19                  JR   NZ,line   
01C1   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C3   CD E2 02     KT2:      CALL   getk   
01C6   20 0E                  JR   NZ,kt3   
01C8   1D                     DEC   E   
01C9   20 F8                  JR   NZ,kt2   
01CB   7C                     LD   A,H   ; 0? never counts down: it waits
01CC   B5                     OR   L   
01CD   28 F2                  JR   Z,kt1   
01CF   2B                     DEC   HL   
01D0   7C                     LD   A,H   
01D1   B5                     OR   L   
01D2   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01D4   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01D5   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01D6   6F           KT3:      LD   L,A   
01D7   26 00                  LD   H,0   
01D9   F7                     RST   30h   
01DA                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
01DA                          ENDIF      
01DA                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
01DA                          ENDIF      
01DA                          IF   CPM   
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01DA                          ENDIF      
01DA                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
01DA                          ENDIF      
01DA                          IF   CPM*EDITOR   
                              RET      
01DA                          ENDIF      
01DA                          IFN   CPM   
01DA                             ; Generic: Backspace takes the last character back (and is echoed as
01DA                             ; it is), CR ends (stored, not echoed), every other key is stored and
01DA                             ; echoed until the line is full. The line buffer starts at offset 80h
01DA                             ; of its page, so L alone is the place in the line: D holds the L of
01DA                             ; a full line.
01DA                          ENDIF      
01DA                          IFN   CPM   
01DA   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01DD   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01DE   9F                     SBC   A,A   
01DF   A5                     AND   L   ; (0 for a count that is too big)
01E0   2F                     CPL      
01E1   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E2                          ENDIF      ;   at most
01E2                          IF   EDGEN   
01E2   CD E8 01               CALL   rdline   ; (the editor calls rdline too)
01E5   2E 80                  LD   L,LINEBUF & 0FFh   
01E7   F7                     RST   30h   
01E8                             ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
01E8                RDLINE:      
01E8                          ENDIF      
01E8                          IFN   CPM   
01E8   21 80 82               LD   HL,LINEBUF   
01EB   CD E2 02     LN2:      CALL   getk   
01EE   28 FB                  JR   Z,ln2   
01F0   FE 0D                  CP   13   
01F2   28 16                  JR   Z,ln5   
01F4   FE 08                  CP   8   
01F6   28 0B                  JR   Z,ln4   
01F8   5F                     LD   E,A   
01F9   7D                     LD   A,L   
01FA   BA                     CP   D   
01FB   28 EE                  JR   Z,ln2   ; full
01FD   73                     LD   (HL),E   
01FE   2C                     INC   L   
01FF   7B                     LD   A,E   
0200   EF           LN3:      RST   28h   
0201   18 E8                  JR   ln2   
0203   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0204   FA 00 02               JP   M,ln3   ;   unless the line was empty (L left the
0207   2C                     INC   L   ;   upper half of the page)
0208   18 E1                  JR   ln2   
020A   77           LN5:      LD   (HL),A   ; the CR
020B                          ENDIF      
020B                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
020B                          ENDIF      
020B                          IF   EDGEN   
020B   C9                     RET      
020C                          ENDIF      
020C                             ; =============================================================================
020C                             ;  More routines (no handler starts past this point)
020C                             ; =============================================================================
020C                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
020C                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
020C                             ; while the quotient bits arrive at the bottom of C.
020C                             ; Dividing by 2 is one shift (the spec wants that fast).
020C   7B           UDIV:     LD   A,E   
020D   EE 02                  XOR   2   
020F   B2                     OR   D   
0210   20 07                  JR   NZ,udv0   
0212   CB 3C                  SRL   H   
0214   CB 1D                  RR   L   ; the quotient
0216   8F                     ADC   A,A   
0217   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0218   C9                     RET      
0219   7C           UDV0:     LD   A,H   
021A   4D                     LD   C,L   
021B   21 00 00               LD   HL,0   
021E   06 10                  LD   B,16   
0220   CB 21        UDV1:     SLA   C   
0222   17                     RLA      
0223   ED 6A                  ADC   HL,HL   
0225   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0227   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0229   19                     ADD   HL,DE   ; too much: put it back, and cancel the
022A   0D                     DEC   C   ;   INC below
022B   0C           UDV2:     INC   C   ; a quotient bit
022C   10 F2                  DJNZ   udv1   
022E   EB                     EX   DE,HL   ; DE = remainder
022F   67                     LD   H,A   
0230   69                     LD   L,C   ; HL = quotient
0231   C9                     RET      
0232                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0232                             ; non-digit. Values wrap at 16 bits, as the spec says.
0232   21 00 00     RDNUM:    LD   HL,0   
0235   0A           RDN1:     LD   A,(BC)   
0236   D6 30                  SUB   "0"   
0238   FE 0A                  CP   10   
023A   D0                     RET   NC   
023B   03                     INC   BC   
023C   54                     LD   D,H   
023D   5D                     LD   E,L   
023E   29                     ADD   HL,HL   
023F   29                     ADD   HL,HL   
0240   19                     ADD   HL,DE   
0241   29                     ADD   HL,HL   ; HL * 10
0242   5F                     LD   E,A   
0243   16 00                  LD   D,0   
0245   19                     ADD   HL,DE   
0246   18 ED                  JR   rdn1   
0248                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0248                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0248                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0248                          ENDIF      
0248                          IF   CHECKED   
0248                             ; The checked build never steps over a NUL: if the text runs out first it
0248                             ; returns A = 0 with the IP on the NUL.
0248   0A           SKIPSTR:   LD   A,(BC)   
0249   B7                     OR   A   
024A   C8                     RET   Z   
024B   03                     INC   BC   
024C   FE 22                  CP   22h   
024E   C8                     RET   Z   
024F   FE 2F                  CP   "/"   
0251   20 F5                  JR   NZ,skipstr   
0253   0A                     LD   A,(BC)   ; the escaped character
0254   B7                     OR   A   
0255   C8                     RET   Z   
0256   03                     INC   BC   
0257   18 EF                  JR   skipstr   
0259                          ENDIF      
0259                             ; skip: read past text to the closer at this level, and return A = 0 if it
0259                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0259                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0259                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0259                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0259                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0259                             ; 
0259                             ; The checked build also looks at the character the skip was started by,
0259                             ; which is always the one just before where it starts: "(" must end at ")",
0259                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0259                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0259                             ; place where the skip started, for the report.
0259                SKIP:        
0259                          IF   CHECKED   
0259   C5                     PUSH   BC   
025A   DD E1                  POP   IX   
025C   0B                     DEC   BC   
025D   0A                     LD   A,(BC)   
025E   03                     INC   BC   
025F   5F                     LD   E,A   ; E = the opener: ( [ or \
0260                          ENDIF      
0260   16 00                  LD   D,0   
0262   14           SK3:      INC   D   ; an opener: one deeper
0263   0A           SK1:      LD   A,(BC)   
0264                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,endprog   
0264                          ENDIF      
0264                          IF   CHECKED   
0264   B7                     OR   A   
0265   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0267   03                     INC   BC   
0268                          ENDIF      
0268   FE 22                  CP   22h   
026A   CC 48 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
026D   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
026F   28 F1                  JR   Z,sk3   
0271   3D                     DEC   A   ; ")"
0272   28 08                  JR   Z,sk4   
0274   D6 32                  SUB   "["-")"   
0276   28 EA                  JR   Z,sk3   
0278   FE 02                  CP   "]"-"["   
027A   20 E7                  JR   NZ,sk1   
027C   15           SK4:      DEC   D   
027D                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
027D                          ENDIF      
027D                          IF   CHECKED   
027D   20 E4                  JR   NZ,sk1   
027F   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0280   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0281   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0283   FE 02                  CP   2   ;   closer, and only then
0285   7A                     LD   A,D   
0286   C0                     RET   NZ   
0287   18 05                  JR   sk7   
0289   CB 53        SK6:      BIT   2,E   ; the text ran out:
028B   C2 15 00               JP   NZ,endprog   ;   "\" with no closer ends the program
028E   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0290   C1                     POP   BC   
0291   3E 4E                  LD   A,"N"   
0293   C3 81 03               JP   errp   ; (errp drops skip's return address)
0296                          ENDIF      
0296                             ; psgn: print HL as a signed number. Uses BC.
0296   CB 7C        PSGN:     BIT   7,H   
0298   28 04                  JR   Z,pdec   
029A   3E 2D                  LD   A,"-"   
029C   EF                     RST   28h   
029D   E7                     RST   20h   
029E                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
029E                             ; Uses BC.
029E   11 0A 00     PDEC:     LD   DE,10   
02A1   CD 0C 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02A4   7B                     LD   A,E   
02A5   F5                     PUSH   AF   
02A6   7C                     LD   A,H   
02A7   B5                     OR   L   
02A8   C4 9E 02               CALL   NZ,pdec   
02AB   F1                     POP   AF   
02AC   C6 30                  ADD   A,"0"   
02AE   EF                     RST   28h   
02AF   C9                     RET      
02B0                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02B0                             ; and return its value in A with the carry set; otherwise leave the IP and
02B0                             ; return with the carry clear.
02B0   0A           HEXC:     LD   A,(BC)   
02B1   D6 30                  SUB   "0"   
02B3   FE 0A                  CP   10   
02B5   38 09                  JR   C,hc1   
02B7   E6 DF                  AND   0DFh   
02B9   D6 11                  SUB   11h   
02BB   FE 06                  CP   6   
02BD   D0                     RET   NC   
02BE   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02C0   03           HC1:      INC   BC   
02C1   C9                     RET      
02C2                             ; =============================================================================
02C2                             ;  Dispatch table: the low byte of each handler's address, in code order
02C2                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02C2                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02C2                             ; =============================================================================
02C2                             ; The handlers of the first NPG1 characters start in the image's second page.
02C2                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02C2                             ; differs between the builds, so the count is worked out here.
02C2                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02C2                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02C2                PGBRK:    EQU   (h_break-BASE)/256   
02C2                PGDEF:    EQU   (h_def-BASE)/256   
02C2                PGFET:    EQU   (h_fetch-BASE)/256   
02C2                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02C2                          IF   1-TABP0   
02C2                PTAB:        
02C2                          ;*Macro unroll:  PTABLE
02C2   9B                     DB   h_store & 0FFh   
02C3   A3                     DB   h_str & 0FFh   
02C4   B7                     DB   h_num & 0FFh   
02C5   AE                     DB   h_print & 0FFh   
02C6   93                     DB   h_swap & 0FFh   
02C7   36                     DB   h_and & 0FFh   
02C8   B4                     DB   h_emit & 0FFh   
02C9   12                     DB   h_open & 0FFh   
02CA   1A                     DB   h_close & 0FFh   
02CB   57                     DB   h_mul & 0FFh   
02CC   2D                     DB   h_add & 0FFh   
02CD   D5                     DB   h_cfetch & 0FFh   
02CE   25                     DB   h_sub & 0FFh   
02CF   95                     DB   h_cstore & 0FFh   
02D0   6B                     DB   h_div & 0FFh   
02D1   91                     DB   h_dup & 0FFh   
02D2   9A                     DB   h_drop & 0FFh   
02D3   3E                     DB   h_lt & 0FFh   
02D4   4D                     DB   h_eq & 0FFh   
02D5   3F                     DB   h_gt & 0FFh   
02D6   BD                     DB   h_key & 0FFh   
02D7   0D                     DB   h_fetch & 0FFh   
02D8   E9                     DB   h_def & 0FFh   
02D9   DC                     DB   h_break & 0FFh   
02DA   D8                     DB   h_ret & 0FFh   
02DB   72                     DB   h_xor & 0FFh   
02DC   85                     DB   h_alloc & 0FFh   
02DD   C2                     DB   h_grave & 0FFh   
02DE   2C                     DB   h_tor & 0FFh   
02DF   7A                     DB   h_or & 0FFh   
02E0   1C                     DB   h_fromr & 0FFh   
02E1   82                     DB   h_not & 0FFh   
02E2                PTABEND:      
02E2                          ENDIF      
02E2                             ; =============================================================================
02E2                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02E2                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
02E2                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
02E2                             ;  KEY and CONOUT routines themselves.
02E2                             ; =============================================================================
02E2                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
02E2                          ENDIF      
02E2                          IF   CHECKED   
02E2   E5           GETK:     PUSH   HL   ; a key held back by the break check goes
02E3   21 36 82               LD   HL,KEYBUF   ;   first, and is taken out of the buffer
02E6   7E                     LD   A,(HL)   
02E7   36 00                  LD   (HL),0   
02E9   E1                     POP   HL   
02EA   B7                     OR   A   
02EB   C0                     RET   NZ   
02EC                          ENDIF      
02EC                          IF   (1-CPM)*CHECKED   
02EC   C3 06 FF               JP   KEY   
02EF                          ENDIF      
02EF                          IF   CPM*(1-CHECKED)   
                    GETK:        
02EF                          ENDIF      
02EF                          IF   CPM   
                              LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
02EF                          ENDIF      
02EF                             ; =============================================================================
02EF                             ;  Checked build: the checks and the error report
02EF                             ; =============================================================================
02EF                          IF   CHECKED   
02EF                             ; chkst: stop unless HL is in the program's own space: from the letter page
02EF                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
02EF                             ; whatever lies above the limit are safe. Memory above the heap top but
02EF                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
02EF                             ; It is the page of HL + 1 that is tested, so that one test serves both
02EF                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
02EF                             ; Keeps HL and BC.
02EF   23           CHKST:    INC   HL   
02F0   7C                     LD   A,H   
02F1   2B                     DEC   HL   
02F2   FE 82                  CP   LETPAGE   
02F4   38 03                  JR   C,chs1   
02F6                          ENDIF      
02F6                          IF   CHECKED*(1-CPM)   
02F6   FE F0                  CP   HEAPLIM   
02F8   D8                     RET   C   
02F9                          ENDIF      
02F9                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
02F9                          ENDIF      
02F9                          IF   CHECKED   
02F9   C3 7F 03     CHS1:     JP   e_store   
02FC                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
02FC                             ; the count. Stop if the top is not below the limit page, or is below the
02FC                             ; program's end.
02FC                CHKHP:       
02FC                          ENDIF      
02FC                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
02FC                          ENDIF      
02FC                          IF   CHECKED*(1-CPM)   
02FC                             ; (Here the program's space is under 32K, so a top that wrapped
02FC                             ; round always falls outside it.)
02FC   7C                     LD   A,H   
02FD   FE F0                  CP   HEAPLIM   
02FF   30 09                  JR   NC,e_heap   
0301                          ENDIF      
0301                          IF   CHECKED   
0301   D5                     PUSH   DE   
0302   EB                     EX   DE,HL   
0303   2A 38 82               LD   HL,(NPEND)   
0306   19                     ADD   HL,DE   ; carry: at or above the program's end
0307   EB                     EX   DE,HL   
0308   D1                     POP   DE   
0309   D8                     RET   C   
030A   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
030B   ED 52                  SBC   HL,DE   
030D   C3 7C 03               JP   e_heap1   
0310                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0310                             ; "$", and the error report's texts). A NUL first is an error: Q.
0310   7E           PRSTR:    LD   A,(HL)   
0311   23                     INC   HL   
0312   FE 22                  CP   22h   
0314   C8                     RET   Z   
0315   B7                     OR   A   
0316   28 0B                  JR   Z,e_dollar   
0318   FE 2F                  CP   "/"   
031A   20 04                  JR   NZ,prs1   
031C   7E                     LD   A,(HL)   
031D   23                     INC   HL   
031E   E6 BF                  AND   0BFh   
0320   EF           PRS1:     RST   28h   
0321   18 ED                  JR   prstr   
0323   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
0324   E1                     POP   HL   ;   and put the string's address back in TOS
0325   3E 51                  LD   A,"Q"   
0327   C3 91 03               JP   error   
032A                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
032A                             ; pnl: the same, on a new line.
032A   3E 0D        PNL:      LD   A,13   
032C   EF                     RST   28h   
032D   3E 0A                  LD   A,10   
032F   EF                     RST   28h   
0330   E3           PMSG:     EX   (SP),HL   
0331   CD 10 03               CALL   prstr   
0334   E3                     EX   (SP),HL   
0335   C9                     RET      
0336                             ; chkstk: both stacks are checked once per character, not in every handler.
0336                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0336                             ; the constant carries if it is above (cells were popped that were never
0336                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0336                             ; a character late at most: the bytes above DSTOP and the guard band below
0336                             ; the page take what happens meanwhile. DE is free between characters.
0336   EB           CHKSTK:   EX   DE,HL   
0337   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
033A   39                     ADD   HL,SP   
033B   EB                     EX   DE,HL   
033C   38 1E                  JR   C,e_under   
033E   14                     INC   D   
033F   20 17                  JR   NZ,e_over   
0341   D9                     EXX      ; the return stack: in its page (or it has
0342   7C                     LD   A,H   ;   overflowed), and not above its empty
0343   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
0345   7D                     LD   A,L   ;   page, in the guard band)
0346   D9                     EXX      
0347   20 0C                  JR   NZ,e_rover   
0349   FE E1                  CP   RSTOP&0FFh+1   
034B   D8                     RET   C   
034C   D9                     EXX      ; return stack underflow: it counts as empty
034D   21 E0 80               LD   HL,RSTOP   
0350   D9                     EXX      
0351   3E 72                  LD   A,"r"   
0353   18 2C                  JR   errp   
0355   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0357   11                     DB   11h   ; (LD DE,nn hides the next entry)
0358   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
035A   18 25                  JR   errp   
035C   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
035F   3E 73                  LD   A,"s"   
0361   18 2E                  JR   error   
0363                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
0363                             ; else is held for the next "?".
0363   CD E2 02     CHKBRK:   CALL   getk   
0366   C8                     RET   Z   
0367   FE 03                  CP   3   
0369   28 0E                  JR   Z,e_break   
036B   32 36 82               LD   (KEYBUF),A   
036E   C9                     RET      
036F                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
036F                             ; was never defined still holds 0000h, and the byte there is a reserved one
036F                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
036F                             ; an undefined word. The call is undone, so the place is the call itself.
036F   04           E_HI:     INC   B   
0370   10 17                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0372   CF                     RST   08h   
0373   42                     LD   B,D   
0374   4B                     LD   C,E   
0375   3E 55                  LD   A,"U"   
0377   18 18                  JR   error   
0379                             ; Error entries. Each loads its letter and then hides the next entry inside
0379                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0379   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside chkbrk)
037B   11                     DB   11h   
037C   3E 48        E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
037E   11                     DB   11h   
037F   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
0381                             ; errp: an error found inside a routine: drop its return address first.
0381   D1           ERRP:     POP   DE   
0382   18 0D                  JR   error   
0384   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0385   4D                     LD   C,L   ;   past the opening quote, which is the place
0386   3E 51                  LD   A,"Q"   
0388   11                     DB   11h   
0389   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
038B   11                     DB   11h   
038C   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
038E   11                     DB   11h   
038F   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0391                             ; error: the report, then the end. A = the letter, BC = one past the place,
0391                             ; HL = TOS, and both stacks as the report is to show them:
0391                             ; 
0391                             ;   Err X @ line,col
0391                             ;   up to 16 characters of the text from the place
0391                             ;   Stk n: the top 8 cells at most, bottom to top
0391                             ;   Rtn n
0391   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0392   5F                     LD   E,A   
0393   CD 2A 03               CALL   pnl   
0396   45 72 72 20 22         DB   "Err ",22h   
039B   7B                     LD   A,E   
039C   EF                     RST   28h   
039D   CD 30 03               CALL   pmsg   
03A0   20 40 20 22            DB   " @ ",22h   
03A4   0B                     DEC   BC   ; BC = the place
03A5                             ; The line and column. A place below the program is in the line
03A5                             ; buffer: line 0. Otherwise count the LFs from the program's start;
03A5                             ; DE = the line's number, HL = where it starts.
03A5   21 80 82               LD   HL,LINEBUF   
03A8   11 00 00               LD   DE,0   
03AB   78                     LD   A,B   
03AC   FE 83                  CP   PROG/256   
03AE   38 14                  JR   C,er3   
03B0   24                     INC   H   
03B1   6B                     LD   L,E   ; HL = PROG
03B2   13           ER1:      INC   DE   ; a new line starts at HL
03B3   E5                     PUSH   HL   
03B4   7D           ER2:      LD   A,L   
03B5   91                     SUB   C   
03B6   7C                     LD   A,H   
03B7   98                     SBC   A,B   
03B8   30 09                  JR   NC,er2x   ; reached the place
03BA   7E                     LD   A,(HL)   
03BB   23                     INC   HL   
03BC   FE 0A                  CP   10   
03BE   20 F4                  JR   NZ,er2   
03C0   F1                     POP   AF   
03C1   18 EF                  JR   er1   
03C3   E1           ER2X:     POP   HL   
03C4   C5           ER3:      PUSH   BC   
03C5   E5                     PUSH   HL   
03C6   EB                     EX   DE,HL   
03C7   CD 9E 02               CALL   pdec   ; the line
03CA   3E 2C                  LD   A,","   
03CC   EF                     RST   28h   
03CD   D1                     POP   DE   
03CE   E1                     POP   HL   
03CF   E5                     PUSH   HL   
03D0   B7                     OR   A   
03D1   ED 52                  SBC   HL,DE   
03D3   23                     INC   HL   
03D4   CD 9E 02               CALL   pdec   ; the column
03D7   CD 2A 03               CALL   pnl   
03DA   22                     DB   22h   
03DB   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
03DC   06 10                  LD   B,16   ;   if the line or the program ends first
03DE   7E           ER4:      LD   A,(HL)   
03DF   23                     INC   HL   
03E0   B7                     OR   A   
03E1   28 0B                  JR   Z,er5   
03E3   FE 0D                  CP   13   
03E5   28 07                  JR   Z,er5   
03E7   FE 0A                  CP   10   
03E9   28 03                  JR   Z,er5   
03EB                          ENDIF      
03EB                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
03EB                          ENDIF      ;   screen on it)
03EB                          IF   CHECKED   
03EB   EF                     RST   28h   
03EC   10 F0                  DJNZ   er4   
03EE   CD 2A 03     ER5:      CALL   pnl   
03F1   53 74 6B 20 22         DB   "Stk ",22h   
03F6   21 FA 81               LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
03F9   B7                     OR   A   ;   first value and holds nothing)
03FA   ED 72                  SBC   HL,SP   
03FC   CD 47 04               CALL   phalf   ; the depth
03FF   3E 3A                  LD   A,":"   
0401   EF                     RST   28h   
0402   79                     LD   A,C   
0403   FE 09                  CP   9   
0405   38 0A                  JR   C,er6   
0407   CD 30 03               CALL   pmsg   
040A   20 2E 2E 2E 22         DB   " ...",22h   
040F   0E 08                  LD   C,8   
0411   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0413   69                     LD   L,C   
0414   29                     ADD   HL,HL   
0415   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0416   0C                     INC   C   
0417   0D           ER7:      DEC   C   
0418   28 11                  JR   Z,er8   
041A   2B                     DEC   HL   
041B   56                     LD   D,(HL)   
041C   2B                     DEC   HL   
041D   5E                     LD   E,(HL)   
041E   E5                     PUSH   HL   
041F   C5                     PUSH   BC   
0420   3E 20                  LD   A," "   
0422   EF                     RST   28h   
0423   EB                     EX   DE,HL   
0424   CD 96 02               CALL   psgn   
0427   C1                     POP   BC   
0428   E1                     POP   HL   
0429   18 EC                  JR   er7   
042B   CD 2A 03     ER8:      CALL   pnl   
042E   52 74 6E 20 22         DB   "Rtn ",22h   
0433   D9                     EXX      
0434   E5                     PUSH   HL   
0435   D9                     EXX      
0436   D1                     POP   DE   
0437   21 E0 80               LD   HL,RSTOP   
043A   B7                     OR   A   
043B   ED 52                  SBC   HL,DE   
043D   CD 47 04               CALL   phalf   
0440   CD 2A 03               CALL   pnl   
0443   22                     DB   22h   
0444   C3 15 00               JP   endprog   
0447                             ; phalf: print half of HL, and leave it in C
0447   CB 3C        PHALF:    SRL   H   
0449   CB 1D                  RR   L   
044B   E5                     PUSH   HL   
044C   CD 9E 02               CALL   pdec   
044F   C1                     POP   BC   
0450   C9                     RET      
0451                          ENDIF      
0451                             ; =============================================================================
0451                             ;  The line editor (EDITOR = 1)
0451                             ; 
0451                             ;  The interpreter starts here, and a program that ends comes back here. Type
0451                             ;  a line and press Return:
0451                             ; 
0451                             ;    n text    put the text in as line n; the lines from n on move down.
0451                             ;              A number past the end, or 0, adds the line at the end.
0451                             ;    n         take line n out
0451                             ;    0         run the program
0451                             ;    -n        list the program from line n on (-1 lists all of it). Any key
0451                             ;              stops the list until another key is pressed; Ctrl-C ends it.
0451                             ;    anything else is run at once, as B8Script. (Start such a line with a
0451                             ;    space if it would begin with a digit or a minus sign.)
0451                             ; 
0451                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0451                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0451                             ;  125 characters, the line number and the one character after it included;
0451                             ;  that character is not stored. The text is kept as it is typed, each line
0451                             ;  ending in CR LF, at PROG. Nothing is checked.
0451                             ; 
0451                             ;  With CPM = 1 the file named on the command line is the program to start
0451                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
0451                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
0451                             ;  CP/M. Nothing is written back: there is no command to save.
0451                             ; 
0451                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
0451                             ;  its report and comes back here, with both stacks empty. The place is a
0451                             ;  line and column of the program; in a line typed here it is line 0.
0451                             ; 
0451                             ;  Things to know:
0451                             ;    - Reset empties the program (generic builds).
0451                             ;    - Words and variables last from one line to the next. A word's address
0451                             ;      points into the program, so run the program again after editing it.
0451                             ;    - Nothing is printed between a program's output and what is typed next.
0451                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0451                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0451                             ;      (The stored program never comes back to the line, so it may.)
0451                             ; =============================================================================
0451                          IF   EDGEN*CHECKED   
0451                             ; Reset (A = 0): clear the lower half of the letter page. Every variable
0451                             ; starts at 0, every word cell holds 0000h, the address an undefined word is
0451                             ; caught at (see e_hi), and no key is held back.
0451   21 00 82     INIT:     LD   HL,LET   
0454   77           INI1:     LD   (HL),A   
0455   2C                     INC   L   
0456   F2 54 04               JP   P,ini1   ; +00h to +7Fh
0459   18 3F                  JR   edit   
045B                          ENDIF      
045B                          IF   EDITOR   
045B                             ; -n: list from line n. DE = the number of the line at HL.
045B   03           LIST:     INC   BC   
045C   CD 32 02               CALL   rdnum   ; HL = n
045F   E5                     PUSH   HL   
0460   CD 03 05               CALL   find   
0463   D1                     POP   DE   
0464   7E           LI1:      LD   A,(HL)   
0465   B7                     OR   A   
0466   28 32                  JR   Z,edit   ; the end of the text
0468   CD E2 02               CALL   getk   
046B   28 0D                  JR   Z,li3   ; no key: carry on
046D   FE 03                  CP   3   
046F   28 29                  JR   Z,edit   ; Ctrl-C
0471   CD E2 02     LI2:      CALL   getk   ; any other key: wait for one more
0474   28 FB                  JR   Z,li2   
0476   FE 03                  CP   3   
0478   28 20                  JR   Z,edit   
047A   E5           LI3:      PUSH   HL   
047B   D5                     PUSH   DE   
047C   EB                     EX   DE,HL   
047D   CD 9E 02               CALL   pdec   ; the line's number,
0480   3E 20                  LD   A," "   
0482   EF                     RST   28h   ;   a space,
0483   D1                     POP   DE   
0484   E1                     POP   HL   
0485   13                     INC   DE   
0486   CD 1B 05               CALL   prl   ;   and the line
0489   18 D9                  JR   li1   
048B                             ; Take line n (in HL) out: copy everything after it down over it.
048B   CD 03 05     DEL:      CALL   find   
048E   54                     LD   D,H   
048F   5D                     LD   E,L   
0490   CD 11 05               CALL   nxl   ; HL -> the next line
0493   7E           DE1:      LD   A,(HL)   
0494   12                     LD   (DE),A   
0495   23                     INC   HL   
0496   13                     INC   DE   
0497   B7                     OR   A   
0498   20 F9                  JR   NZ,de1   ; and fall into the editor
049A   31 FC 81     EDIT:     LD   SP,DSTOP   
049D                          ENDIF      
049D                          IF   EDITOR*CPM*CHECKED   
                                 ; A key that the break check held back while a program ran is let
                                 ; go: BDOS 10 would not see it, and it would turn up in the next
                                 ; program that asked for a key. (This also serves at the start.)
                              XOR   A   
                              LD   (KEYBUF),A   
049D                          ENDIF      
049D                          IF   EDGEN   
049D   16 FD                  LD   D,0FDh   ; 125 characters at most
049F                          ENDIF      
049F                          IF   EDITOR*CPM   
                              LD   A,125   
049F                          ENDIF      
049F                          IF   EDITOR   
049F   CD E8 01               CALL   rdline   ; HL -> the CR that ended the line
04A2   2C                     INC   L   
04A3   36 0A                  LD   (HL),10   ; a LF after it,
04A5   2D                     DEC   L   
04A6   CD 1B 05               CALL   prl   ; (print the CR LF: a new line)
04A9   36 00                  LD   (HL),0   ;   and a NUL after that
04AB   E5                     PUSH   HL   ; the end of what was typed
04AC   01 80 82               LD   BC,LINEBUF   
04AF   0A                     LD   A,(BC)   
04B0   FE 2D                  CP   "-"   
04B2   28 A7                  JR   Z,list   
04B4   CD 32 02               CALL   rdnum   ; HL = the number it starts with, BC -> after
04B7   79                     LD   A,C   ; C is still 80h if there was no number:
04B8   87                     ADD   A,A   ;   only then is twice it 0
04B9   28 0C                  JR   Z,st0   ; no number: run the line where it is
04BB   0A                     LD   A,(BC)   
04BC   D6 0D                  SUB   13   
04BE   20 1D                  JR   NZ,ins   ; text follows the number
04C0   B4                     OR   H   ; the number alone:
04C1   B5                     OR   L   
04C2   20 C7                  JR   NZ,del   ;   not 0: take that line out
04C4   01 00 83               LD   BC,PROG   ;   0: run the program
04C7                             ; st0: start running at BC. The heap starts after the stored program's NUL.
04C7   E1           ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
04C8   21 00 83               LD   HL,PROG   
04CB   AF                     XOR   A   
04CC   BE           ST1:      CP   (HL)   
04CD   23                     INC   HL   
04CE   20 FC                  JR   NZ,st1   
04D0   22 7C 82               LD   (HEAP),HL   
04D3                          ENDIF      
04D3                          IF   EDITOR*CHECKED   
04D3   E7                     RST   20h   ; minus the heap"s first address: "_' may not
04D4   22 38 82               LD   (NPEND),HL   ;   release below it
04D7                          ENDIF      
04D7                          IF   EDITOR   
04D7   D9                     EXX      
04D8   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
04DB   D9                     EXX      
04DC   F7                     RST   30h   ; (its return address is thrown away)
04DD                             ; Put the typed text in as line n (in HL): open a gap of its length there,
04DD                             ; CR and LF included, and copy it in.
04DD   CD 03 05     INS:      CALL   find   ; HL -> where it goes
04E0   03                     INC   BC   ; step over the one character after the number
04E1   D1                     POP   DE   ; the end of what was typed
04E2   7B                     LD   A,E   
04E3   91                     SUB   C   ; A = the length of the text, with its CR LF
04E4   C5                     PUSH   BC   ; the text
04E5   4F                     LD   C,A   
04E6   06 00                  LD   B,0   
04E8   C5                     PUSH   BC   ; its length
04E9   54                     LD   D,H   
04EA   5D                     LD   E,L   ; DE = where it goes
04EB   AF                     XOR   A   
04EC   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
04ED   ED B1                  CPIR      ; HL -> one past the program's NUL
04EF   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
04F1   44                     LD   B,H   
04F2   4D                     LD   C,L   
04F3   19                     ADD   HL,DE   
04F4   2B                     DEC   HL   ; HL -> the NUL
04F5   EB                     EX   DE,HL   
04F6   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
04F7   E5                     PUSH   HL   
04F8   19                     ADD   HL,DE   ; the NUL's new place
04F9   EB                     EX   DE,HL   
04FA   ED B8                  LDDR      ; move the rest of the program up
04FC   C1                     POP   BC   ; the length
04FD   D1                     POP   DE   ; where it goes
04FE   E1                     POP   HL   ; the text
04FF   ED B0                  LDIR      
0501   18 97                  JR   edit   
0503                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0503                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0503   EB           FIND:     EX   DE,HL   
0504   21 00 83               LD   HL,PROG   
0507   1B           FI1:      DEC   DE   
0508   7A                     LD   A,D   
0509   B3                     OR   E   
050A   C8                     RET   Z   
050B   CD 11 05               CALL   nxl   
050E   20 F7                  JR   NZ,fi1   
0510   C9                     RET      
0511                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0511                             ; stop at the NUL that ends the text (and return zero).
0511   7E           NXL:      LD   A,(HL)   
0512   B7                     OR   A   
0513   C8                     RET   Z   
0514   23                     INC   HL   
0515   FE 0A                  CP   10   
0517   20 F8                  JR   NZ,nxl   
0519   B7                     OR   A   
051A   C9                     RET      
051B                             ; prl: print the line at HL, to its LF; HL -> just past it.
051B   7E           PRL:      LD   A,(HL)   
051C   EF                     RST   28h   
051D   7E                     LD   A,(HL)   
051E   23                     INC   HL   
051F   FE 0A                  CP   10   
0521   20 F8                  JR   NZ,prl   
0523   C9                     RET      
0524                          ENDIF      
0524                             ; =============================================================================
0524                             ;  CP/M startup (the generic build starts at address 0: see st0)
0524                             ; =============================================================================
0524                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0524                          ENDIF      
0524                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0524                          ENDIF      
0524                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:         
0524                          ENDIF      
0524                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0524                          ENDIF      
0524                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
0524                          ENDIF      
0524                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0524                          ENDIF      
0524                IMGEND:      


