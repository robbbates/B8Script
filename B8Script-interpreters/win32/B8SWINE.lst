   878                              <1>         jmp     short error
   879                              <1> e_brack:mov     al,'W'                  ; bad character after [
   880                              <1> 
   881                              <1> ; error: the report, then the end. AL = the letter, ESI = one past the
   882                              <1> ; place, EBX = TOS, and both stacks as the report is to show them:
   883                              <1> ;
   884                              <1> ;   Err X @ line,col
   885                              <1> ;   D:n: the top 8 cells at most, bottom to top
   886                              <1> ;   R:n
   887                              <1> ;
   888                              <1> ; It goes to the standard error handle. (The letter is written into the
   889                              <1> ; text of the first line. The texts end at a quote; prstr prints them, and
   890                              <1> ; their CR LF are the bytes themselves.)
   891                              <1> error:  push    ebx                     ; now the whole data stack is in memory
   892                              <1>         mov     [erlet],al
