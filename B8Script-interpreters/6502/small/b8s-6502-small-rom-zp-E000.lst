                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW2:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw3   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW3:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw4   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW4:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw5   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW5:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw6   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW6:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw7   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW7:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw8   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW8:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw9   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW9:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw10   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW10:     ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw11   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW11:     ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw12   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW12:     ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw13   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW13:     ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw14   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW14:     ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              BCC   mw15   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              TYA      
                              ADC   1,X   
                    MW15:     ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              INX      
                              INX      
                              RTS      
E380                          ENDIF      
E380                          IF   QK   
                              ;*Macro unroll:  CLOSEQ
                    CLOSEQ:   TXA      
                              TSX      
                              LDY   103h,X   
                              STY   IP   
                              LDY   104h,X   
                              STY   IP+1   
                              TAX      
                              DEC   CDOWN   
                              BEQ   cq1   
                              RTS      
                    CQ1:      PLA      
                              PLA      
                              JMP   pkey   
E380                          ENDIF      
E380                          IF   SBASEU   
                                 ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
                                 ; fetched or stored in the same step (x@ is the commonest pair in most
                                 ; programs). A checked build checks the stacks between the two, so it keeps
                                 ; them apart. (pvar calls lowp, which only pushes.)
                    LOWQ:     ASL      
                              STA   T0   ; the cell's offset in the letter page
                              LDY   #0   
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   lwf   
                              CMP   #"!"   
                              BEQ   lws   
                              LDA   T0   
                              LDY   #>LET   
                              JMP   pushay   ; the address
                    LWF:      JSR   incip   ; x@: TOS = the cell's value
                              LDY   T0   
                              DEX      
                              DEX      
                              LDA   LET,Y   
                              STA   0,X   
                              LDA   LET+1,Y   
                              STA   1,X   
                              RTS      
                    LWS:      JSR   incip   ; x!: the cell = TOS, and it is dropped
                              LDY   T0   
                              LDA   0,X   
                              STA   LET,Y   
                              LDA   1,X   
                              STA   LET+1,Y   
                              INX      
                              INX      
                              RTS      
E380                          ENDIF      
E380                          IF   QK   
                                 ; The skip cache. Nearly every skip is one that has happened before (a loop
                                 ; skips the same false block on every pass), so the first scan from each
                                 ; place is remembered: 64 entries of 00bbc3RhcnQsIHRoZSBjbG9zZXIncyBhZGRyZXNz, in CPAGE,
                                 ; found by the start's low byte times 4. Only skips that start in the
                                 ; program text are kept (the line buffer changes); the cache is emptied when
                                 ; the program starts. A program that changes its own text while it runs is
                                 ; not looked after. Where the skip started is kept in the scratch under the
                                 ; top cell, $FE,X and $FF,X. (The checked build: A holds the wrong closer on
                                 ; the way in, as at the checked skip above.)
                    SKIP:        
E380                          ENDIF      
E380                          IF   CHECKED*QK   
                              STA   T0   
E380                          ENDIF      
E380                          IF   QK   
                              LDA   IP+1   
                              CMP   #>PROG   
                              BCC   sks   ; below the program text: no cache
                              LDA   IP   
                              ASL      
                              ASL      
                              TAY      ; Y -> the entry
                              LDA   IP   
                              CMP   CPAGE*256,Y   
                              BNE   sks   
                              LDA   IP+1   
                              CMP   CPAGE*256+1,Y   
                              BNE   sks   
                              LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
                              STA   IP   ;   read
                              LDA   CPAGE*256+3,Y   
                              STA   IP+1   
                              LDY   #0   
                              LDA   (IP),Y   
                              JMP   incip   
                    SKS:      LDA   IP   
                              STA   0FEh,X   
                              LDA   IP+1   
                              STA   0FFh,X   
                              LDY   #0   
                              STY   T2   ; depth
                                 ; The scan reads at IP+Y. Most characters are nothing to it, and two range
                                 ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                    SQ1:      LDA   (IP),Y   
                              INY      
                              BEQ   sqw   
                    SQ2:      CMP   #5Eh   
                              BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CMP   #5Bh   
                              BCS   sqb   ; [ \ ]
                              CMP   #2Ah   
                              BCS   sq1   ; * to Z: nothing
                              CMP   #28h   
                              BEQ   sqo   ; (
                              BCS   sqc   ; )
                              CMP   #22h   
                              BEQ   sqq   ; a string
                              CMP   #1   
                              BCS   sq1   ; the rest below "(": nothing
E380                          ENDIF      
E380                          IF   QK*(1-CHECKED)   
                              JMP   EXIT   ; NUL: the end of the program
E380                          ENDIF      
E380                          IF   QK*CHECKED   
                              JMP   sknul   
E380                          ENDIF      
E380                          IF   QK   
                    SQW:      INC   IP+1   ; Y went round: on into the next page
                              BNE   sq2   ; always
                    SQQ:      JSR   sqip   ; a string: step over it
                              JSR   skipstr   
E380                          ENDIF      
E380                          IF   QK*CHECKED   
                              BNE   sqq1   
                              JMP   sknul   ; the string ran into the end
                    SQQ1:        
E380                          ENDIF      
E380                          IF   QK   
                              LDY   #0   
                              BEQ   sq1   ; always
                    SQO:      INC   T2   ; an opener
                              JMP   sq1   
                    SQB:      CMP   #5Ch   
                              BEQ   sq1   ; "\" is nothing here
                              BCC   sqo   ; [
                    SQC:      DEC   T2   ; ) ]
                              BPL   sq1   
                              JSR   sqip   ; the closer at this level: the IP past it
E380                          ENDIF      
E380                          IF   QK*CHECKED   
                              CMP   T0   
                              BNE   sqc1   
                              JMP   e_nest   ; the wrong kind
                    SQC1:        
E380                          ENDIF      
E380                          IF   QK   
                              PHA      
                              LDA   0FFh,X   ; remember the skip, if it started in the
                              CMP   #>PROG   ;   program text
                              BCC   sq9   
                              LDA   0FEh,X   
                              ASL      
                              ASL      
                              TAY      
                              LDA   0FEh,X   
                              STA   CPAGE*256,Y   
                              LDA   0FFh,X   
                              STA   CPAGE*256+1,Y   
                              LDA   IP   
                              SEC      
                              SBC   #1   
                              STA   CPAGE*256+2,Y   ; the closer's address
                              LDA   IP+1   
                              SBC   #0   
                              STA   CPAGE*256+3,Y   
                    SQ9:      PLA      
                              RTS      ; the closer at this level
                                 ; sqip: IP = IP + Y. Keeps A.
                    SQIP:     PHA      
                              TYA      
                              CLC      
                              ADC   IP   
                              STA   IP   
                              BCC   sp1   
                              INC   IP+1   
                    SP1:      PLA      
                              RTS      
                                 ; udiv (QK): as the macro UDIV, and any power of two is shifts: 2, and 32,
                                 ; 64, 256 and the like, which fixed point and byte work use all the time.
                    UDIV:     LDA   #0   
                              STA   0FEh,X   
                              STA   0FFh,X   
                              LDY   D0   
                              LDA   D1   
                              BNE   uq1   ; 256 and up
                              TYA      
                              BEQ   ud0   ; by 0: the long way (it means nothing anyway)
                              DEY      
                              TYA      
                              AND   D0   
                              BNE   ud0   ; not a power of two
                              TYA      ; by 2^k below 256: r = a & (2^k - 1),
                              AND   0,X   
                              STA   0FEh,X   
                              LDA   D0   ;   and q = a >> k
                              BNE   uq2   ; always
                    UQ1:      TYA      
                              BNE   ud0   ; not a power of two
                              LDY   D1   
                              DEY      
                              TYA      
                              AND   D1   
                              BNE   ud0   ; not a power of two
                              TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
                              AND   1,X   
                              STA   0FFh,X   
                              LDA   0,X   
                              STA   0FEh,X   
                              LDA   1,X   ;   and q = (a >> 8) >> (k - 8)
                              STA   0,X   
                              LDA   #0   
                              STA   1,X   
                              LDA   D1   
                    UQ2:      LSR      ; a bit of 2^k: one shift for each 0 below
                              BCS   uq9   ;   the 1
                    UQ3:      LSR   1,X   
                              ROR   0,X   
                              LSR      
                              BCC   uq3   
                    UQ9:      RTS      
E380                          ENDIF      
E380                          IF   QK*(1-FAST)   
                    UD0:      LDY   #16   
                    UD1:      ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              STA   T0   
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   ud2   
                              STA   0FFh,X   
                              LDA   T0   
                              STA   0FEh,X   
                              INC   0,X   ; the quotient bit (bit 0 is free)
                    UD2:      DEY      
                              BNE   ud1   
                              RTS      
E380                          ENDIF      
E380                          IF   FAST   
