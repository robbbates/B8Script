0282                          ;*Macro unroll:  PUTA
0282   EF                     DS   1-CPM,0EFh   
0283                          DS   CPM,0CDh   
0283                          DS   CPM,APUT&0FFh   
0283                          DS   CPM,APUT/256   
0283   C9                     RET      
0284                             ; (The table goes here instead in the builds where, before the routines, it
0284                             ; would cross a page: PTLATE. If it would cross one here too, it starts on
0284                             ; the next page: PTPAD is 0 unless it must.)
0284                          IF   (1-FAST)*PTLATE   
0284                PTPH:     EQU   $ & 0FFh   
0284                PTPX:     EQU   (PTPH + 31) / 256   
0284                PTPAD:    EQU   PTPX * (256 - PTPH)   
0284                          DS   PTPAD   
0284                PTAB:        
0284                          ;*Macro unroll:  PTABLE
0284   7D                     DB   h_store & 0FFh   
0285   85                     DB   h_str & 0FFh   
0286   92                     DB   h_num & 0FFh   
0287   8C                     DB   h_print & 0FFh   
0288   7B                     DB   h_swap & 0FFh   
0289   2D                     DB   h_and & 0FFh   
028A   8F                     DB   h_emit & 0FFh   
028B   0D                     DB   h_open & 0FFh   
028C   19                     DB   h_close & 0FFh   
028D   52                     DB   h_mul & 0FFh   
028E   2A                     DB   h_add & 0FFh   
028F   B5                     DB   h_cfetch & 0FFh   
0290   21                     DB   h_sub & 0FFh   
0291   82                     DB   h_cstore & 0FFh   
0292   56                     DB   h_div & 0FFh   
0293   79                     DB   h_dup & 0FFh   
0294   91                     DB   h_drop & 0FFh   
0295   36                     DB   h_lt & 0FFh   
0296   45                     DB   h_eq & 0FFh   
0297   35                     DB   h_gt & 0FFh   
0298   98                     DB   h_key & 0FFh   
0299   08                     DB   h_fetch & 0FFh   
029A   E8                     DB   h_def & 0FFh   
029B   D9                     DB   h_break & 0FFh   
029C   D4                     DB   h_ret & 0FFh   
029D   7C                     DB   h_xor & 0FFh   
029E   8F                     DB   h_alloc & 0FFh   
029F   B7                     DB   h_grave & 0FFh   
02A0   14                     DB   h_tor & 0FFh   
02A1   84                     DB   h_or & 0FFh   
02A2   1D                     DB   h_fromr & 0FFh   
02A3   8C                     DB   h_not & 0FFh   
