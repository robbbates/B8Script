                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              JP   CONCUR   ; /|  (A = 1: show)
0361                          ENDIF      
0361                          IF   ANS   
0361   D5                     PUSH   DE   
0362   CD 9F 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0365   23                     INC   HL   
0366   CD 4E 04               CALL   pdec   
0369   3E 3B                  LD   A,";"   
036B   EF                     RST   28h   
036C   E1                     POP   HL   
036D   23                     INC   HL   
036E   CD 4E 04               CALL   pdec   
0371   3E 48                  LD   A,"H"   
0373   EF                     RST   28h   
0374   E1                     POP   HL   
0375   C3 B5 02               JP   PRAGAIN   
0378                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0378   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
037A   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
037B   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
037D   3E 3F                  LD   A,"?"   
037F   CD 9A 03               CALL   csia   
0382   3E 32                  LD   A,"2"   
0384   EF                     RST   28h   
0385   3E 35                  LD   A,"5"   
0387   EF                     RST   28h   
0388   7B                     LD   A,E   
0389   EF                     RST   28h   
038A   C9                     RET      
038B                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
038B   3D           PCON:     DEC   A   
038C   28 EA                  JR   Z,pshow   ; /|
038E   3E 4B                  LD   A,"K"   
0390   F2 9A 03               JP   P,csia   ; /}  ESC [ K
0393   3E 48                  LD   A,"H"   ; /{  ESC [ H ESC [ J
0395   CD 9A 03               CALL   csia   
0398   3E 4A                  LD   A,"J"   ; (on into csia)
039A                             ; csia: ESC [ and then A. csi: ESC [, keeping A.
039A   CD 9F 03     CSIA:     CALL   csi   
039D   EF                     RST   28h   
039E   C9                     RET      
039F   F5           CSI:      PUSH   AF   
03A0   3E 1B                  LD   A,27   
03A2   EF                     RST   28h   
03A3   3E 5B                  LD   A,"["   
03A5   EF                     RST   28h   
03A6   F1                     POP   AF   
03A7   C9                     RET      
03A8                          ENDIF      
03A8                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
03A8                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
03A8                             ; the quotient bits arrive at the bottom of C.
03A8                             ; Dividing by 2 is one shift (the spec wants that fast).
03A8   7B           UDIV:     LD   A,E   
03A9   EE 02                  XOR   2   
03AB   B2                     OR   D   
03AC   20 07                  JR   NZ,udv0   
03AE   CB 3C                  SRL   H   
03B0   CB 1D                  RR   L   ; the quotient
03B2   8F                     ADC   A,A   
03B3   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
03B4   C9                     RET      
03B5   C5           UDV0:     PUSH   BC   
03B6   7C                     LD   A,H   
03B7   4D                     LD   C,L   
03B8   21 00 00               LD   HL,0   
03BB   06 10                  LD   B,16   
03BD   CB 21        UDV1:     SLA   C   
03BF   17                     RLA      
03C0   ED 6A                  ADC   HL,HL   
03C2   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03C4   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03C6   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03C7   0D                     DEC   C   ;   INC below
03C8   0C           UDV2:     INC   C   ; a quotient bit
03C9   10 F2                  DJNZ   udv1   
03CB   EB                     EX   DE,HL   ; DE = remainder
03CC   67                     LD   H,A   
03CD   69                     LD   L,C   ; HL = quotient
03CE   C1                     POP   BC   
03CF   C9                     RET      
03D0                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
03D0                             ; non-digit. Values wrap at 16 bits, as the spec says.
03D0   21 00 00     RDNUM:    LD   HL,0   
03D3   0A           RDN1:     LD   A,(BC)   
03D4   D6 30                  SUB   "0"   
03D6   FE 0A                  CP   10   
03D8   D0                     RET   NC   
03D9   03                     INC   BC   
03DA   54                     LD   D,H   
03DB   5D                     LD   E,L   
03DC   29                     ADD   HL,HL   
03DD   29                     ADD   HL,HL   
03DE   19                     ADD   HL,DE   
03DF   29                     ADD   HL,HL   ; HL * 10
03E0   5F                     LD   E,A   
03E1   16 00                  LD   D,0   
03E3   19                     ADD   HL,DE   
03E4   18 ED                  JR   rdn1   
03E6                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03E6                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03E6                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
03E6                          ENDIF      
03E6                          IF   CHECKED   
03E6                             ; The checked build never steps over a NUL: if the text runs out first it
03E6                             ; returns A = 0 with the IP on the NUL.
03E6   0A           SKIPSTR:   LD   A,(BC)   
03E7   B7                     OR   A   
03E8   C8                     RET   Z   
03E9   03                     INC   BC   
03EA   FE 22                  CP   22h   
03EC   C8                     RET   Z   
03ED   FE 2F                  CP   "/"   
03EF   20 F5                  JR   NZ,skipstr   
03F1   0A                     LD   A,(BC)   ; the escaped character
03F2   B7                     OR   A   
03F3   C8                     RET   Z   
03F4   03                     INC   BC   
03F5   18 EF                  JR   skipstr   
03F7                          ENDIF      
03F7                             ; skip: read past text to the closer at this level, and return A = 0 if it
03F7                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03F7                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03F7                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03F7                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03F7                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
03F7                             ; 
03F7                             ; The checked build also looks at the character the skip was started by,
03F7                             ; which is always the one just before where it starts: "(" must end at ")",
03F7                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03F7                             ; quote counts as running into it. "\" takes either closer. IX keeps the
03F7                             ; place where the skip started, for the report.
03F7                SKIP:        
03F7                          IF   CHECKED   
03F7   C5                     PUSH   BC   
03F8   DD E1                  POP   IX   
03FA   0B                     DEC   BC   
03FB   0A                     LD   A,(BC)   
03FC   03                     INC   BC   
03FD   5F                     LD   E,A   ; E = the opener: ( [ or \
03FE                          ENDIF      
03FE   16 00                  LD   D,0   
0400   14           SK3:      INC   D   ; an opener: one deeper
0401   0A           SK1:      LD   A,(BC)   
0402                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0402                          ENDIF      
0402                          IF   CHECKED   
0402   B7                     OR   A   
0403   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0405   03                     INC   BC   
0406                          ENDIF      
0406   FE 22                  CP   22h   
0408   CC E6 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
040B   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
040D   28 F1                  JR   Z,sk3   
040F   3D                     DEC   A   ; ")"
0410   28 08                  JR   Z,sk4   
0412   D6 32                  SUB   "["-")"   
0414   28 EA                  JR   Z,sk3   
0416   FE 02                  CP   "]"-"["   
0418   20 E7                  JR   NZ,sk1   
041A   15           SK4:      DEC   D   
041B                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
041B                          ENDIF      
041B                          IF   CHECKED   
041B   20 E4                  JR   NZ,sk1   
041D   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
041E   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
041F   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0421   FE 02                  CP   2   ;   closer, and only then
0423   7A                     LD   A,D   
0424   C0                     RET   NZ   
0425   18 05                  JR   sk7   
0427   CB 53        SK6:      BIT   2,E   ; the text ran out:
0429   C2 46 06               JP   NZ,SKEND   ;   "\" with no closer ends the program
042C   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
042E   C1                     POP   BC   
042F   3E 4E                  LD   A,"N"   
0431   C3 3F 05               JP   errp   ; (errp drops skip's return address)
0434                          ENDIF      
0434                             ; =============================================================================
0434                             ;  Dispatch table: the low byte of each handler's address, in code order
0434                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0434                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0434                             ; =============================================================================
0434                             ; The handlers of the first NPG1 characters start in the image's second page.
0434                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0434                             ; differs between the builds, so the count is worked out here.
0434                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0434                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0434                PGBRK:    EQU   (h_break-BASE)/256   
0434                PGDEF:    EQU   (h_def-BASE)/256   
0434                PGFET:    EQU   (h_fetch-BASE)/256   
0434                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0434                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0434                          ENDIF      
0434                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0434                             ; and return its value in A with the carry set; otherwise leave the IP and
0434                             ; return with the carry clear.
0434   0A           HEXC:     LD   A,(BC)   
0435   D6 30                  SUB   "0"   
0437   FE 0A                  CP   10   
0439   38 09                  JR   C,hc1   
043B   E6 DF                  AND   0DFh   
043D   D6 11                  SUB   11h   
043F   FE 06                  CP   6   
0441   D0                     RET   NC   
0442   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0444   03           HC1:      INC   BC   
0445   C9                     RET      
0446                             ; psgn: print HL as a signed number. Keeps BC.
0446   CB 7C        PSGN:     BIT   7,H   
0448   28 04                  JR   Z,pdec   
044A   3E 2D                  LD   A,"-"   
044C   EF                     RST   28h   
044D   E7                     RST   20h   
044E                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
044E                             ; Keeps BC.
044E   11 0A 00     PDEC:     LD   DE,10   
0451   CD A8 03               CALL   udiv   ; HL = HL / 10, E = the last digit
0454   7B                     LD   A,E   
0455   F5                     PUSH   AF   
0456   7C                     LD   A,H   
0457   B5                     OR   L   
0458   C4 4E 04               CALL   NZ,pdec   
045B   F1                     POP   AF   
045C   C6 30                  ADD   A,"0"   
045E   EF                     RST   28h   
045F   C9                     RET      
0460                             ; (The table goes here instead in the builds where, before psgn, it would
0460                             ; cross a page: PTLATE.)
0460                          IF   (1-TABP0)*PTLATE   
0460                PTAB:        
0460                          ;*Macro unroll:  PTABLE
0460   9F                     DB   h_store & 0FFh   
0461   A7                     DB   h_str & 0FFh   
0462   BC                     DB   h_num & 0FFh   
0463   B2                     DB   h_print & 0FFh   
0464   97                     DB   h_swap & 0FFh   
0465   3C                     DB   h_and & 0FFh   
0466   B9                     DB   h_emit & 0FFh   
0467   18                     DB   h_open & 0FFh   
0468   20                     DB   h_close & 0FFh   
0469   5D                     DB   h_mul & 0FFh   
046A   33                     DB   h_add & 0FFh   
046B   D8                     DB   h_cfetch & 0FFh   
046C   2B                     DB   h_sub & 0FFh   
046D   99                     DB   h_cstore & 0FFh   
046E   71                     DB   h_div & 0FFh   
046F   95                     DB   h_dup & 0FFh   
0470   9E                     DB   h_drop & 0FFh   
0471   44                     DB   h_lt & 0FFh   
0472   53                     DB   h_eq & 0FFh   
0473   45                     DB   h_gt & 0FFh   
0474   C0                     DB   h_key & 0FFh   
0475   13                     DB   h_fetch & 0FFh   
0476   EF                     DB   h_def & 0FFh   
0477   E2                     DB   h_break & 0FFh   
0478   DE                     DB   h_ret & 0FFh   
0479   76                     DB   h_xor & 0FFh   
047A   89                     DB   h_alloc & 0FFh   
047B   C8                     DB   h_grave & 0FFh   
047C   2C                     DB   h_tor & 0FFh   
047D   7E                     DB   h_or & 0FFh   
047E   1C                     DB   h_fromr & 0FFh   
047F   86                     DB   h_not & 0FFh   
0480                PTABEND:      
0480                          ENDIF      
0480                             ; =============================================================================
0480                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0480                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0480                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
0480                             ;  they are the host's KEY and CONOUT routines themselves.
0480                             ; 
0480                             ;  A running program reads the keyboard only through getk and pollk, which
0480                             ;  between them give the break key its rules:
0480                             ;    - Ctrl-C stops the program;
0480                             ;    - any other key that the break check reads is held in KEYBUF for the
0480                             ;      next "?", and a newer one takes its place;
0480                             ;    - "?" (getk) takes the held key first;
0480                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0480                             ;      key like any other, but two of them within about 250 ms still stop it.
0480                             ;  Both are called straight from a handler, never from a routine under one:
0480                             ;  the checked build's report counts on finding one return address above the
0480                             ;  data stack.
0480                             ; =============================================================================
0480                          IFN   CPM   
                    RAWK:     EQU   KEY   
0480                          ENDIF      
0480                             ; pollk: the break check (see rpushn).
0480   CD BE 04     POLLK:    CALL   rawk   
0483   C8                     RET   Z   ; no key
0484   32 7A 0B               LD   (KEYBUF),A   ; held for the next "?"
0487   FE 03        PK1:      CP   3   ; (getk joins here)
0489   C0                     RET   NZ   
048A                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
048A                             ; the program has turned it off, wait about 250 ms for one more key: a
048A                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
048A                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
048A   3A 7B 0B     CTLC:     LD   A,(BRKOFF)   
048D   B7                     OR   A   
048E   CA 3D 05     CT0:      JP   Z,brk   
0491   D5                     PUSH   DE   
0492   11 10 27               LD   DE,250*MSLOOP   
0495   CD BE 04     CT1:      CALL   rawk   
0498   20 05                  JR   NZ,ct2   
049A   1B                     DEC   DE   
049B   7A                     LD   A,D   
049C   B3                     OR   E   
049D   20 F6                  JR   NZ,ct1   
049F   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
04A0   FE 03                  CP   3   
04A2   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
04A4   B7                     OR   A   
04A5   28 03                  JR   Z,ct3   
04A7   32 7A 0B               LD   (KEYBUF),A   
04AA   3E 03        CT3:      LD   A,3   
04AC   B7                     OR   A   
04AD   C9                     RET      
04AE                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04AE   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
04AF   21 7A 0B               LD   HL,KEYBUF   ;   the buffer
04B2   7E                     LD   A,(HL)   
04B3   36 00                  LD   (HL),0   
04B5   E1                     POP   HL   
04B6   B7                     OR   A   
04B7   C0                     RET   NZ   
04B8   CD BE 04               CALL   rawk   
04BB   C8                     RET   Z   
04BC   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
04BE                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
04BE                          ENDIF      ;   (with the editor, both stacks are cleared);
04BE                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
04BE                          ENDIF      
04BE                          IF   CHECKED   
04BE                BRK:      EQU   e_break   ;   the checked build reports B
04BE                          ENDIF      
04BE                          IF   CPM   
04BE   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
04C0                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
04C0                             ; printing and could swallow a key that BDOS 6 then never sees.
04C0   D5           PUTC:     PUSH   DE   
04C1   E5                     PUSH   HL   
04C2   5F                     LD   E,A   
04C3   3E 06                  LD   A,6   
04C5   CD CC 04               CALL   bdosx   
04C8   E1                     POP   HL   
04C9   D1                     POP   DE   
04CA   B7                     OR   A   ; (for getk)
04CB   C9                     RET      
04CC                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
04CC   C5           BDOSX:    PUSH   BC   
04CD   D9                     EXX      
04CE   E5                     PUSH   HL   
04CF   D9                     EXX      
04D0   4F                     LD   C,A   
04D1   CD 05 00               CALL   BDOS   
04D4   D9                     EXX      
04D5   E1                     POP   HL   
04D6   D9                     EXX      
04D7   C1                     POP   BC   
04D8   C9                     RET      
04D9                          ENDIF      
04D9                             ; =============================================================================
04D9                             ;  Checked build: the checks and the error report
04D9                             ; =============================================================================
04D9                          IF   CHECKED   
04D9                             ; chkstk: both stacks are checked once per character, not in every handler.
04D9                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
04D9                             ; the constant carries if it is above (cells were popped that were never
04D9                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
04D9                             ; a character late at most: the bytes above DSTOP and the guard band below
04D9                             ; the page take what happens meanwhile. DE is free between characters.
04D9   EB           CHKSTK:   EX   DE,HL   
04DA   21 05 F5               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
04DD   39                     ADD   HL,SP   
04DE   EB                     EX   DE,HL   
04DF   38 1D                  JR   C,e_under   
04E1   14                     INC   D   
04E2   20 16                  JR   NZ,e_over   
04E4   D9                     EXX      ; the return stack: in its page (or it has
04E5   7C                     LD   A,H   ;   overflowed), and not above its empty
04E6   FE 09                  CP   RSPAGE   ;   position (an underflow stays inside the
04E8   7D                     LD   A,L   ;   page, in the guard band)
04E9   D9                     EXX      
04EA   20 0B                  JR   NZ,e_rover   
04EC   FE E1                  CP   RSTOP&0FFh+1   
04EE   D8                     RET   C   
04EF   D9                     EXX      ; return stack underflow: it counts as empty
04F0   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
04F2   D9                     EXX      
04F3   3E 72                  LD   A,"r"   
04F5   18 48                  JR   errp   
04F7   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
04F9   11                     DB   11h   ; (LD DE,nn hides the next entry)
04FA   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
04FC   18 41                  JR   errp   
04FE   31 FC 0A     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0501   3E 73                  LD   A,"s"   
0503   18 4A                  JR   error   
0505                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0505                             ; was never defined still holds 0000h, and the byte there is a reserved one
0505                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0505                             ; an undefined word. The call is undone, so the place is the call itself.
0505   04           E_HI:     INC   B   
0506   10 3F                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0508   CF                     RST   08h   
0509   42                     LD   B,D   
050A   4B                     LD   C,E   
050B   3E 55                  LD   A,"U"   
050D   18 40                  JR   error   
050F                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
050F                             ; the count. Stop if the top is not below the limit page, or is below the
050F                             ; program's end.
050F                CHKHP:       
050F                          ENDIF      
050F                          IF   CHECKED*CPM   
050F                             ; With this much room a top that wrapped round can land back in
050F                             ; range, so the add is tested too: growing (A, the count's high
050F                             ; byte, is positive) must not carry, and releasing must.
050F   1F                     RRA      ; the carry comes in above the sign:
0510   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
0512   87                     ADD   A,A   
0513   38 10                  JR   C,e_heap   
0515   3A 07 00               LD   A,(0007h)   
0518   3D                     DEC   A   
0519   BC                     CP   H   
051A   38 09                  JR   C,e_heap   
051C                          ENDIF      
051C                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
051C                          ENDIF      
051C                          IF   CHECKED   
051C   D5                     PUSH   DE   
051D   EB                     EX   DE,HL   
051E   2A 38 0B               LD   HL,(NPEND)   
0521   19                     ADD   HL,DE   ; carry: at or above the program's end
0522   EB                     EX   DE,HL   
0523   D1                     POP   DE   
0524   D8                     RET   C   
0525   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0526   ED 52                  SBC   HL,DE   
0528   3E 48                  LD   A,"H"   
052A   18 13                  JR   errp   
052C                             ; chkst: stop unless HL is in the program's own space: from the letter page
052C                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
052C                             ; whatever lies above the limit are safe. Memory above the heap top but
052C                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
052C                             ; It is the page of HL + 1 that is tested, so that one test serves both
052C                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
052C                             ; Keeps HL and BC. It runs on into its own error entry.
052C   23           CHKST:    INC   HL   
052D   7C                     LD   A,H   
052E   2B                     DEC   HL   
052F   FE 0B                  CP   LETPAGE   
0531   38 07                  JR   C,e_store   
0533                          ENDIF      
0533                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0533                          ENDIF      
0533                          IF   CHECKED*CPM   
0533   5F                     LD   E,A   
0534   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0537   3D                     DEC   A   
0538   BB                     CP   E   
0539   D0                     RET   NC   
053A                          ENDIF      
053A                          IF   CHECKED   
053A                             ; Error entries. Each loads its letter and then hides the next entry inside
053A                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
053A   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
053C   11                     DB   11h   
053D   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
053F                             ; errp: an error found inside a routine: drop its return address first.
053F   D1           ERRP:     POP   DE   
0540   18 0D                  JR   error   
0542   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0543   4D                     LD   C,L   ;   past the opening quote, which is the place
0544   3E 51                  LD   A,"Q"   
0546   11                     DB   11h   
0547   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
0549   11                     DB   11h   
054A   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
054C   11                     DB   11h   
054D   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
054F                             ; error: the report, then the end. A = the letter, BC = one past the place,
054F                             ; HL = TOS, and both stacks as the report is to show them:
054F                             ; 
054F                             ;   Err X @ line,col
054F                             ;   up to 16 characters of the text from the place
054F                             ;   Stk n: the top 8 cells at most, bottom to top
054F                             ;   Rtn n
054F   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0550   5F                     LD   E,A   
0551   CD 26 03               CALL   pnl   
0554   45 72 72 20 22         DB   "Err ",22h   
0559   7B                     LD   A,E   
055A   EF                     RST   28h   
055B   CD 2C 03               CALL   pmsg   
055E   20 40 20 22            DB   " @ ",22h   
0562   0B                     DEC   BC   ; BC = the place
0563                             ; The line and column. A place below the program is in the line
0563                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0563                             ; DE = the line's number, HL = where it starts.
0563   21 80 0B               LD   HL,LINEBUF   
0566   11 00 00               LD   DE,0   
0569   78                     LD   A,B   
056A   FE 0C                  CP   PROG/256   
056C   38 14                  JR   C,er3   
056E   24                     INC   H   
056F   6B                     LD   L,E   ; HL = PROG
0570   13           ER1:      INC   DE   ; a new line starts at HL
0571   E5                     PUSH   HL   
0572   7D           ER2:      LD   A,L   
0573   91                     SUB   C   
0574   7C                     LD   A,H   
0575   98                     SBC   A,B   
0576   30 09                  JR   NC,er2x   ; reached the place
0578   7E                     LD   A,(HL)   
0579   23                     INC   HL   
057A   FE 0A                  CP   10   
057C   20 F4                  JR   NZ,er2   
057E   F1                     POP   AF   
057F   18 EF                  JR   er1   
0581   E1           ER2X:     POP   HL   
0582   C5           ER3:      PUSH   BC   
0583   E5                     PUSH   HL   
0584   EB                     EX   DE,HL   
0585   CD 4E 04               CALL   pdec   ; the line
0588   3E 2C                  LD   A,","   
058A   EF                     RST   28h   
058B   D1                     POP   DE   
058C   E1                     POP   HL   
058D   E5                     PUSH   HL   
058E   B7                     OR   A   
058F   ED 52                  SBC   HL,DE   
0591   23                     INC   HL   
0592   CD 4E 04               CALL   pdec   ; the column
0595   CD 26 03               CALL   pnl   
0598   22                     DB   22h   
0599   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
059A   06 10                  LD   B,16   ;   if the line or the program ends first
059C   7E           ER4:      LD   A,(HL)   
059D   23                     INC   HL   
059E   B7                     OR   A   
059F   28 0B                  JR   Z,er5   
05A1   FE 0D                  CP   13   
05A3   28 07                  JR   Z,er5   
05A5   FE 0A                  CP   10   
05A7   28 03                  JR   Z,er5   
05A9                          ENDIF      
05A9                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
05A9                          ENDIF      ;   screen on it. The editor's loader ends
05A9                          IF   CHECKED   ;   the text at the first ^Z.)
05A9   EF                     RST   28h   
05AA   10 F0                  DJNZ   er4   
05AC                ER5:         ; (on into the two stack lines)
05AC                             ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
05AC                             ;                       Rtn n
05AC                             ; TOS is in memory with the rest (pushed) by now.
05AC   CD 26 03               CALL   pnl   
05AF   53 74 6B 20 22         DB   "Stk ",22h   
05B4   21 06 F5               LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
05B7   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
05B8   E7                     RST   20h   ;   with the first value and holds nothing)
05B9   CD 02 06               CALL   phalf   ; the depth
05BC   3E 3A                  LD   A,":"   
05BE   EF                     RST   28h   
05BF   79                     LD   A,C   
05C0   FE 09                  CP   9   
05C2   38 0A                  JR   C,er6   
05C4   CD 2C 03               CALL   pmsg   
05C7   20 2E 2E 2E 22         DB   " ...",22h   
05CC   0E 08                  LD   C,8   
05CE   26 00        ER6:      LD   H,0   ; C = the number of cells to show
05D0   69                     LD   L,C   
05D1   29                     ADD   HL,HL   
05D2   39                     ADD   HL,SP   ; HL -> just above the deepest of them
05D3   0C                     INC   C   
05D4   0D           ER7:      DEC   C   
05D5   28 0F                  JR   Z,er8   
05D7   2B                     DEC   HL   
05D8   56                     LD   D,(HL)   
05D9   2B                     DEC   HL   
05DA   5E                     LD   E,(HL)   
05DB   E5                     PUSH   HL   
05DC   3E 20                  LD   A," "   
05DE   EF                     RST   28h   
05DF   EB                     EX   DE,HL   
05E0   CD 46 04               CALL   psgn   
05E3   E1                     POP   HL   
05E4   18 EE                  JR   er7   
05E6   CD 26 03     ER8:      CALL   pnl   
05E9   52 74 6E 20 22         DB   "Rtn ",22h   
05EE   D9                     EXX      
05EF   E5                     PUSH   HL   
05F0   D9                     EXX      
05F1   D1                     POP   DE   
05F2   21 E0 09               LD   HL,RSTOP   
05F5   B7                     OR   A   
05F6   ED 52                  SBC   HL,DE   
05F8   CD 02 06               CALL   phalf   
05FB   CD 26 03               CALL   pnl   
05FE   22                     DB   22h   
05FF                          ENDIF      
05FF                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
05FF                          ENDIF      
05FF                          IF   CHECKED*EDITOR   
05FF   C3 42 06               JP   edit0   ; back to the editor, with both stacks cleared
0602                          ENDIF      
0602                          IF   CHECKED   
0602                             ; phalf: print half of HL, and leave it in C.
0602   CB 3C        PHALF:    SRL   H   
0604   CB 1D                  RR   L   
0606   E5                     PUSH   HL   
0607   CD 4E 04               CALL   pdec   
060A   C1                     POP   BC   
060B   C9                     RET      
060C                          ENDIF      
060C                             ; =============================================================================
060C                             ;  The line editor (EDITOR = 1)
060C                             ; 
060C                             ;  The interpreter starts here, and a program that ends comes back here.
060C                             ;  There is no prompt. It follows the spec's suggested standard for a line
060C                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
060C                             ; 
060C                             ;    n text    put the text in as line n; the lines from n on move down. A
060C                             ;              number past the end (or 0) adds the line at the end.
060C                             ;    n         take line n out
060C                             ;    anything else is run at once, as B8Script. (Start such a line with a
060C                             ;    space if it would begin with a digit.)
060C                             ; 
060C                             ;  A command key ends the line too, and takes what was typed as its argument:
060C                             ; 
060C                             ;    ^G        run the program
060C                             ;    n ^L      list from line n (no number: all of it). Any key holds the
060C                             ;              list until another key is pressed; Ctrl-C ends it.
060C                             ;    n ^E      put line n in the input line; Return puts it back, changed
060C                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
060C                             ;              last time). Generic: what is typed, or pasted, from now until
060C                             ;              ^Z replaces the program; it is not echoed.
060C                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
060C                             ;              time). Generic: the text is printed, as it is.
060C                             ;    ^N ^N     new: no program (the key twice in a row)
060C                             ;    ^X        leave (to LEAVE)
060C                             ; 
060C                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
060C                             ;  a character goes in at the cursor; Backspace and DEL take out the one
060C                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
060C                             ;  sent to the terminal, so any terminal will do.
060C                             ; 
060C                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
060C                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
060C                             ;  125 characters; the one character after a line number separates it from
060C                             ;  the text and is not stored. The text is kept as it is typed, each line
060C                             ;  ending in CR LF, at PROG.
060C                             ; 
060C                             ;  What lasts from one line to the next: the program, the words, the
060C                             ;  variables and the data stack. An error or a break clears both stacks. The
060C                             ;  return stack starts empty for every line.
060C                             ; 
060C                             ;  Things to know:
060C                             ;    - Reset empties the program (generic builds).
060C                             ;    - A word's address points into the program, so run the program again
060C                             ;      after editing it.
060C                             ;    - Nothing is printed between a program's output and what is typed next.
060C                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
060C                             ;      a line that calls -n? and carries on afterwards runs what was typed.
060C                             ;      (The stored program never comes back to the line, so it may.)
060C                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
060C                             ;      read of the other builds.
060C                             ; 
060C                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
060C                             ;  the last line left there, with TOS pushed like the rest.
060C                             ; =============================================================================
060C                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
060C                          ENDIF      
060C                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
060C                          ENDIF      
060C                          IF   EDGEN   
                              JR   edit0   
060C                          ENDIF      
060C                          IF   EDITOR   
060C                             ; ^F, right arrow: one to the right, by printing the character there
060C   7D           RIGHT:    LD   A,L   
060D   BB                     CP   E   
060E   28 4A                  JR   Z,ed1   ; at the end
0610   7E                     LD   A,(HL)   
0611   2C                     INC   L   
0612   18 2B                  JR   lf1   
0614                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0614                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0614                             ; ends the sequence, and act on C (right) and D (left).
0614   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0617   CD BE 04     ES1:      CALL   rawk   
061A   20 0A                  JR   NZ,es2   
061C   0B                     DEC   BC   
061D   78                     LD   A,B   
061E   B1                     OR   C   
061F   20 F6                  JR   NZ,es1   
0621   CD 8F 06               CALL   fin   ; no second key: the line is dropped
0624   18 22                  JR   edit   
0626   FE 5B        ES2:      CP   "["   
0628   20 30                  JR   NZ,ed1   ; not a sequence known here
062A   CD E8 06     ES3:      CALL   ekey   
062D   FE 40                  CP   40h   
062F   38 F9                  JR   C,es3   ; (its parameters)
0631   D6 43                  SUB   "C"   
0633   28 D7                  JR   Z,right   
0635   3D                     DEC   A   ; "D"?
0636   20 22                  JR   NZ,ed1   ; no: on into left
0638                             ; ^B, left arrow: the cursor goes one to the left
0638   7D           LEFT:     LD   A,L   
0639   87                     ADD   A,A   
063A   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
063C   2D                     DEC   L   
063D   3E 08                  LD   A,8   
063F   EF           LF1:      RST   28h   
0640   18 18                  JR   ed1   
0642                             ; edit0: reset, an error or a break: both stacks are cleared.
0642                             ; skend: a program that ended inside skip: its return address goes.
0642                             ; edend: a program that ended: TOS joins the rest of the data stack.
0642   31 FA 0A     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0645   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0646   D1           SKEND:    POP   DE   
0647   E5           EDEND:    PUSH   HL   
0648                             ; edit: start a new input line.
0648   D9           EDIT:     EXX      
0649   21 E0 09               LD   HL,RSTOP   ; the return stack is empty
064C   D9                     EXX      
064D   21 00 00               LD   HL,0   
0650   22 7A 0B               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0653   22 3A 0B               LD   (EDLN),HL   ; no line is being edited
0656   21 80 0B               LD   HL,LINEBUF   ; HL = the cursor,
0659   5D                     LD   E,L   ;   E = the end of the line (its low byte)
065A   CD E8 06     ED1:      CALL   ekey   
065D   FE 7F                  CP   7Fh   
065F   28 40                  JR   Z,bsp   ; DEL
0661   FE 20                  CP   " "   
0663   30 56                  JR   NC,insc   
0665   FE 09                  CP   9   
0667   28 52                  JR   Z,insc   ; Tab is text
0669   FE 08                  CP   8   
066B   28 34                  JR   Z,bsp   
066D   FE 02                  CP   2   
066F   28 C7                  JR   Z,left   ; ^B
0671   FE 06                  CP   6   
0673   28 97                  JR   Z,right   ; ^F
0675   FE 1B                  CP   1Bh   
0677   28 9B                  JR   Z,esc   
0679   E5                     PUSH   HL   ; a command key? Look it up
067A   21 EE 06               LD   HL,cmds   
067D   06 08                  LD   B,NCMD   
067F   BE           ED2:      CP   (HL)   
0680   23                     INC   HL   
0681   28 07                  JR   Z,ed3   
0683   23                     INC   HL   
0684   23                     INC   HL   
0685   10 F8                  DJNZ   ed2   
0687   E1                     POP   HL   
0688   18 D0                  JR   ed1   ; no: the key is ignored
068A   7E           ED3:      LD   A,(HL)   
068B   23                     INC   HL   
068C   66                     LD   H,(HL)   
068D   6F                     LD   L,A   
068E   E3                     EX   (SP),HL   ; the command's address: fin returns to it
068F                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
068F                             ; terminal. Leaves BC -> the line and HL -> the NUL.
068F   26 0B        FIN:      LD   H,LETPAGE   
0691   6B                     LD   L,E   
0692   36 0D                  LD   (HL),13   
0694   2C                     INC   L   
0695   36 0A                  LD   (HL),10   
0697   2D                     DEC   L   
0698   CD F7 07               CALL   prl   ; (prints the CR LF)
069B   36 00                  LD   (HL),0   
069D   01 80 0B               LD   BC,LINEBUF   
06A0   C9                     RET      
06A1                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
06A1                             ; left, the rest of the line moves down over it, and the last place (now a
06A1                             ; space) is printed over along with the rest.
06A1   7D           BSP:      LD   A,L   
06A2   87                     ADD   A,A   
06A3   28 B5                  JR   Z,ed1   ; at the start
06A5   2D                     DEC   L   
06A6   3E 08                  LD   A,8   
06A8   EF                     RST   28h   
06A9   E5                     PUSH   HL   
06AA   2C           BS1:      INC   L   
06AB   7E                     LD   A,(HL)   
06AC   2D                     DEC   L   
06AD   77                     LD   (HL),A   
06AE   2C                     INC   L   
06AF   7D                     LD   A,L   
06B0   BB                     CP   E   
06B1   20 F7                  JR   NZ,bs1   
06B3   2D                     DEC   L   
06B4   36 20                  LD   (HL)," "   
06B6   E1                     POP   HL   
06B7   53                     LD   D,E   
06B8   1D                     DEC   E   
06B9   18 15                  JR   ic2   
06BB                             ; A character goes in at the cursor: it ripples up through the rest of the
06BB                             ; line, the cursor moves on, and the rest is printed again.
06BB   47           INSC:     LD   B,A   
06BC   7B                     LD   A,E   
06BD   FE FD                  CP   0FDh   
06BF   28 99                  JR   Z,ed1   ; the line is full: 125 characters
06C1   78                     LD   A,B   
06C2   EF                     RST   28h   
06C3   E5                     PUSH   HL   
06C4   7E           IC1:      LD   A,(HL)   
06C5   70                     LD   (HL),B   
06C6   47                     LD   B,A   
06C7   7D                     LD   A,L   
06C8   2C                     INC   L   
06C9   BB                     CP   E   
06CA   20 F8                  JR   NZ,ic1   
06CC   E1                     POP   HL   
06CD   2C                     INC   L   
06CE   1C                     INC   E   
06CF   53                     LD   D,E   
06D0   CD D5 06     IC2:      CALL   tail   
06D3   18 85                  JR   ed1   
06D5                             ; tail: print the line from the cursor to D (a low byte), and bring the
06D5                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
06D5   4D           TAIL:     LD   C,L   
06D6   7D           TA1:      LD   A,L   
06D7   BA                     CP   D   
06D8   28 05                  JR   Z,ta2   
06DA   7E                     LD   A,(HL)   
06DB   EF                     RST   28h   
06DC   2C                     INC   L   
06DD   18 F7                  JR   ta1   
06DF   7D           TA2:      LD   A,L   
06E0   B9                     CP   C   
06E1   C8                     RET   Z   
06E2   3E 08                  LD   A,8   
06E4   EF                     RST   28h   
06E5   2D                     DEC   L   
06E6   18 F7                  JR   ta2   
06E8                             ; ekey: wait for a key
06E8   CD BE 04     EKEY:     CALL   rawk   
06EB   28 FB                  JR   Z,ekey   
06ED   C9                     RET      
06EE                             ; The command keys, and where each goes (after fin).
06EE   0D           CMDS:     DB   13   
06EF   3E 07                  DW   cret   
06F1   07                     DB   7   ; ^G
06F2   86 07                  DW   crun   
06F4   0C                     DB   12   ; ^L
06F5   9C 07                  DW   clist   
06F7   05                     DB   5   ; ^E
06F8   14 07                  DW   cedln   
06FA   12                     DB   18   ; ^R
06FB   00 08                  DW   cread   
06FD   17                     DB   23   ; ^W
06FE   09 08                  DW   cwrite   
0700   0E                     DB   14   ; ^N
0701   06 07                  DW   cnew   
0703   18                     DB   24   ; ^X
0704   00 00                  DW   LEAVE   
0706                NCMD:     EQU   8   
0706                             ; ^N ^N: no program, if the next key is ^N too
0706   CD E8 06     CNEW:     CALL   ekey   
0709   FE 0E                  CP   14   
070B   20 04                  JR   NZ,ged0   
070D   AF                     XOR   A   
070E   32 00 0C               LD   (PROG),A   
0711   C3 48 06     GED0:     JP   edit   
0714                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0714                             ; line it was: Return puts the text back in its place.
0714   CD D0 03     CEDLN:    CALL   rdnum   
0717   E5                     PUSH   HL   
0718   CD DF 07               CALL   find   ; HL -> the line, or the NUL if there is none
071B   D1                     POP   DE   
071C   7E                     LD   A,(HL)   
071D   B7                     OR   A   
071E   28 F1                  JR   Z,ged0   
0720   ED 53 3A 0B            LD   (EDLN),DE   
0724   11 80 0B               LD   DE,LINEBUF   
0727   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0728   FE 0D                  CP   13   
072A   28 0D                  JR   Z,ce2   
072C   FE 0A                  CP   10   
072E   28 09                  JR   Z,ce2   
0730   12                     LD   (DE),A   
0731   EF                     RST   28h   
0732   23                     INC   HL   
0733   1C                     INC   E   
0734   7B                     LD   A,E   
0735   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0737   20 EE                  JR   NZ,ce1   
0739   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
073A   5D                     LD   E,L   
073B   C3 5A 06               JP   ed1   
073E                             ; Return. If ^E put a line here, the text goes back in its place. If not:
073E                             ; a number and text is a line to put in, a number alone a line to take out,
073E                             ; and anything else is run where it is.
073E   E5           CRET:     PUSH   HL   ; the end of what was typed
073F   2A 3A 0B               LD   HL,(EDLN)   
0742   7C                     LD   A,H   
0743   B5                     OR   L   
0744   28 07                  JR   Z,cr1   
0746   E5                     PUSH   HL   
0747   CD CF 07               CALL   delln   
074A   E1                     POP   HL   
074B   18 13                  JR   ins   
074D   CD D0 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0750   79                     LD   A,C   ; C is still 80h if there was no number:
0751   87                     ADD   A,A   ;   only then is twice it 0
0752   28 36                  JR   Z,st0p   ; no number: run the line
0754   0A                     LD   A,(BC)   
0755   FE 0D                  CP   13   
0757   20 06                  JR   NZ,cr2   
0759   D1                     POP   DE   ; the number alone: take that line out
075A   CD CF 07               CALL   delln   
075D   18 24                  JR   gedit   
075F   03           CR2:      INC   BC   ; step over the one character after the number
0760                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0760                             ; CR and LF included, and copy it in.
0760   CD DF 07     INS:      CALL   find   ; HL -> where it goes
0763   D1                     POP   DE   ; the end of what was typed
0764   7B                     LD   A,E   
0765   91                     SUB   C   ; A = the length of the text, with its CR LF
0766   C5                     PUSH   BC   ; the text
0767   4F                     LD   C,A   
0768   06 00                  LD   B,0   
076A   C5                     PUSH   BC   ; its length
076B   54                     LD   D,H   
076C   5D                     LD   E,L   ; DE = where it goes
076D   AF                     XOR   A   
076E   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
076F   ED B1                  CPIR      ; HL -> one past the program's NUL
0771   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0773   44                     LD   B,H   
0774   4D                     LD   C,L   
0775   19                     ADD   HL,DE   
0776   2B                     DEC   HL   ; HL -> the NUL
0777   EB                     EX   DE,HL   
0778   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0779   E5                     PUSH   HL   
077A   19                     ADD   HL,DE   ; the NUL's new place
077B   EB                     EX   DE,HL   
077C   ED B8                  LDDR      ; move the rest of the program up
077E   C1                     POP   BC   ; the length
077F   D1                     POP   DE   ; where it goes
0780   E1                     POP   HL   ; the text
0781   ED B0                  LDIR      
0783   C3 48 06     GEDIT:    JP   edit   
0786                             ; ^G: run the program. st0p: run the typed line (BC -> it).
0786   01 00 0C     CRUN:     LD   BC,PROG   
0789   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
078A   E1           ST0P:     POP   HL   ; (the end of what was typed)
078B                             ; st0: start running at BC. The heap starts after the stored program's NUL.
078B   21 00 0C     ST0:      LD   HL,PROG   
078E   AF                     XOR   A   
078F   BE           ST1:      CP   (HL)   
0790   23                     INC   HL   
0791   20 FC                  JR   NZ,st1   
0793   22 7C 0B               LD   (HEAP),HL   
0796                          ENDIF      
0796                          IF   EDITOR*CHECKED   
0796   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0797   22 38 0B               LD   (NPEND),HL   ;   release below it
079A                          ENDIF      
079A                          IF   EDITOR   
079A   E1                     POP   HL   ; TOS: the data stack is as the last line left it
079B   F7                     RST   30h   ; (its return address is thrown away)
079C                             ; ^L: list from line n. DE = the number of the line at HL.
079C   CD D0 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
079F   7C                     LD   A,H   
07A0   B5                     OR   L   
07A1   20 01                  JR   NZ,li0   
07A3   2C                     INC   L   ;   then from line 1
07A4   E5           LI0:      PUSH   HL   
07A5   CD DF 07               CALL   find   
07A8   D1                     POP   DE   
07A9   7E           LI1:      LD   A,(HL)   
07AA   B7                     OR   A   
07AB   28 D6                  JR   Z,gedit   ; the end of the text
07AD   CD BE 04               CALL   rawk   
07B0   28 09                  JR   Z,li3   ; no key: carry on
07B2   FE 03                  CP   3   
07B4   C4 E8 06               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
07B7   FE 03                  CP   3   
07B9   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
07BB   E5           LI3:      PUSH   HL   
07BC   D5                     PUSH   DE   
07BD   EB                     EX   DE,HL   
07BE   CD 4E 04               CALL   pdec   ; the line's number,
07C1   3E 20                  LD   A," "   
07C3   EF                     RST   28h   ;   a space,
07C4   D1                     POP   DE   
07C5   E1                     POP   HL   
07C6   13                     INC   DE   
07C7   CD F7 07               CALL   prl   ;   and the line
07CA   18 DD                  JR   li1   
07CC   C3 48 06     GED1:     JP   edit   
07CF                             ; delln: take line n (in HL) out: copy everything after it down over it.
07CF   CD DF 07     DELLN:    CALL   find   
07D2   54                     LD   D,H   
07D3   5D                     LD   E,L   
07D4   CD ED 07               CALL   nxl   ; HL -> the next line
07D7   7E           DE1:      LD   A,(HL)   
07D8   12                     LD   (DE),A   
07D9   23                     INC   HL   
07DA   13                     INC   DE   
07DB   B7                     OR   A   
07DC   20 F9                  JR   NZ,de1   
07DE   C9                     RET      
07DF                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
07DF                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
07DF   EB           FIND:     EX   DE,HL   
07E0   21 00 0C               LD   HL,PROG   
07E3   1B           FI1:      DEC   DE   
07E4   7A                     LD   A,D   
07E5   B3                     OR   E   
07E6   C8                     RET   Z   
07E7   CD ED 07               CALL   nxl   
07EA   20 F7                  JR   NZ,fi1   
07EC   C9                     RET      
07ED                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
07ED                             ; stop at the NUL that ends the text (and return zero).
07ED   7E           NXL:      LD   A,(HL)   
07EE   B7                     OR   A   
07EF   C8                     RET   Z   
07F0   23                     INC   HL   
07F1   FE 0A                  CP   10   
07F3   20 F8                  JR   NZ,nxl   
07F5   B7                     OR   A   
07F6   C9                     RET      
07F7                             ; prl: print the line at HL, to its LF; HL -> just past it.
07F7   7E           PRL:      LD   A,(HL)   
07F8   EF                     RST   28h   
07F9   7E                     LD   A,(HL)   
07FA   23                     INC   HL   
07FB   FE 0A                  CP   10   
07FD   20 F8                  JR   NZ,prl   
07FF   C9                     RET      
0800                          ENDIF      
0800                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
0800                          ENDIF      
0800                          IF   EDITOR*CPM   
0800                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
0800                             ;   put the one from the command line
0800                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
0800                             ; from now on.
0800   CD 57 08     CREAD:    CALL   setname   
0803   CD 96 08               CALL   load   
0806   C3 48 06               JP   edit   
0809                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
0809                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
0809                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
0809                             ; full disk or directory is not noticed: the calls fail and that is all.)
0809   CD 57 08     CWRITE:   CALL   setname   
080C   0E 13                  LD   C,19   ; delete
080E   CD 90 08               CALL   fbdos   
0811   0E 16                  LD   C,22   ; make
0813   CD 90 08               CALL   fbdos   
0816   21 00 0C               LD   HL,PROG   
0819   AF                     XOR   A   
081A   BE           CW1:      CP   (HL)   
081B   23                     INC   HL   
081C   20 FC                  JR   NZ,cw1   
081E   2B                     DEC   HL   ; HL -> the NUL
081F   E5                     PUSH   HL   
0820   06 80                  LD   B,128   
0822   36 1A        CW2:      LD   (HL),1Ah   
0824   23                     INC   HL   
0825   10 FB                  DJNZ   cw2   
0827   E1                     POP   HL   
0828   11 00 0C               LD   DE,PROG   
082B   7B           CW3:      LD   A,E   ; a record that starts before the end is written
082C   95                     SUB   L   
082D   7A                     LD   A,D   
082E   9C                     SBC   A,H   
082F   30 09                  JR   NC,cw4   
0831   E5                     PUSH   HL   
0832   0E 15                  LD   C,21   ; write, from where the record lies
0834   CD 44 08               CALL   frec   
0837   E1                     POP   HL   
0838   18 F1                  JR   cw3   
083A   36 00        CW4:      LD   (HL),0   ; the NUL again
083C   0E 10                  LD   C,16   ; close
083E   CD 90 08               CALL   fbdos   
0841   C3 48 06               JP   edit   
0844                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
0844                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
0844   D5           FREC:     PUSH   DE   
0845   C5                     PUSH   BC   
0846   0E 1A                  LD   C,26   ; set the DMA address
0848   CD 05 00               CALL   BDOS   
084B   C1                     POP   BC   
084C   CD 90 08               CALL   fbdos   
084F   E1                     POP   HL   
0850   11 80 00               LD   DE,128   
0853   EB                     EX   DE,HL   
0854   19                     ADD   HL,DE   
0855   EB                     EX   DE,HL   
0856   C9                     RET      
0857                             ; setname: if a name was typed (the line does not start with its CR), put it
0857                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
0857                             ; is the current one. Then, name or no name, clear the FCB after the name,
0857                             ; as it must be before a file is opened or made.
0857   11 80 0B     SETNAME:   LD   DE,LINEBUF   
085A   1A                     LD   A,(DE)   
085B   FE 0D                  CP   13   
085D   28 26                  JR   Z,fcbclr   
085F   21 5C 00               LD   HL,CFCB   
0862   36 00                  LD   (HL),0   ; the current drive
0864   06 0B                  LD   B,11   
0866   2C           SN1:      INC   L   
0867   36 20                  LD   (HL)," "   
0869   10 FB                  DJNZ   sn1   
086B   2E 5D                  LD   L,CFCB+1   
086D   1A           SN2:      LD   A,(DE)   
086E   13                     INC   DE   
086F   FE 0D                  CP   13   
0871   28 12                  JR   Z,fcbclr   
0873   FE 2E                  CP   "."   
0875   20 04                  JR   NZ,sn3   
0877   2E 65                  LD   L,CFCB+9   ; the type
0879   18 F2                  JR   sn2   
087B   FE 61        SN3:      CP   "a"   
087D   38 02                  JR   C,sn4   
087F   E6 5F                  AND   5Fh   ; a capital
0881   77           SN4:      LD   (HL),A   
0882   2C                     INC   L   
0883   18 E8                  JR   sn2   
0885   21 68 00     FCBCLR:   LD   HL,CFCB+12   
0888   06 18                  LD   B,24   
088A   36 00        FC1:      LD   (HL),0   
088C   23                     INC   HL   
088D   10 FB                  DJNZ   fc1   
088F   C9                     RET      
0890                             ; fbdos: BDOS function C on the file
0890   11 5C 00     FBDOS:    LD   DE,CFCB   
0893   C3 05 00               JP   BDOS   
0896                             ; load: read the file into PROG. No such file: no program. The text ends at
0896                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0896                             ; goes after the last record, so the search always stops. And every line
0896                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
0896                             ; clear after its name: the CCP left it so, or setname did.)
0896   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
0898   CD 90 08               CALL   fbdos   ;   too)
089B   11 00 0C               LD   DE,PROG   
089E   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
08A0   CD 44 08               CALL   frec   
08A3   B7                     OR   A   
08A4   28 F8                  JR   Z,ld1   
08A6   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
08A8   21 FF 0B               LD   HL,PROG-1   
08AB   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
08AD   23           TR1:      INC   HL   
08AE   5F                     LD   E,A   ; E = the character before this one
08AF   7E                     LD   A,(HL)   
08B0   FE 1A                  CP   1Ah   
08B2   20 F9                  JR   NZ,tr1   
08B4   7B                     LD   A,E   
08B5   FE 0A                  CP   10   
08B7   28 06                  JR   Z,tr2   
08B9   36 0D                  LD   (HL),13   
08BB   23                     INC   HL   
08BC   36 0A                  LD   (HL),10   
08BE   23                     INC   HL   
08BF   36 00        TR2:      LD   (HL),0   
08C1   C9                     RET      
08C2                          ENDIF      
08C2                             ; =============================================================================
08C2                          IF   CPM   
08C2                             ; The RAM pages follow the image; the heap may grow to the BDOS.
08C2                START:       
08C2                          ENDIF      
08C2                          IF   CPM*CHECKED   
08C2                             ; Clear the lower half of the letter page: every variable starts at
08C2                             ; 0, every word cell holds 0000h, the address an undefined word is
08C2                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
08C2                             ; is held back.
08C2   21 00 0B               LD   HL,LET   
08C5   AF                     XOR   A   
08C6   77           INI1:     LD   (HL),A   
08C7   2C                     INC   L   
08C8   F2 C6 08               JP   P,ini1   ; +00h to +7Fh
08CB                          ENDIF      
08CB                          IF   CPM   
08CB   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
08CE   11 08 00               LD   DE,0008h   
08D1   01 2C 00               LD   BC,vecend-vecs   
08D4   ED B0                  LDIR      
08D6                          ENDIF      
08D6                          IF   CPM*EDITOR   
08D6   CD 96 08               CALL   load   ; the file named on the command line
08D9   C3 42 06               JP   edit0   
08DC                          ENDIF      
08DC                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
08DC                          ENDIF      
08DC                          IF   CPM   
08DC                             ; RAM pages, after the image
08DC                RSPAGE:   EQU   (imgend + 255) / 256   
08DC                DSPAGE:   EQU   RSPAGE + 1   
08DC                LETPAGE:   EQU   RSPAGE + 2   
08DC                PROG:     EQU   LETPAGE*256 + 256   
08DC                          ENDIF      
08DC                IMGEND:      


