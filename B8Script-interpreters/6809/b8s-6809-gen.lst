F260                          IF   CHECKED   
                                 ; ---- reached from a handler ------------------------------------------------
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program (B), anything
                                 ; else is held for the next "?". Called from the handlers of ] and a true ).
                    CHKBRK:   JSR   getk   
                              BEQ   ck9   
                              CMPA   #3   
                              BNE   ck1   
                              LDA   #"B"   
                              BRA   eh2   
                    CK1:      STA   <KEYBUF   
                    CK9:      RTS      
                                 ; chkst: stop with O unless X is in the program's own space: from the letter
                                 ; page up to HEAPLIM, so the interpreter's stacks and whatever lies above the
                                 ; limit are safe. Memory above the heap top but below the limit is the
                                 ; program's own: Tiny BASIC keeps its lines there. Keeps every register.
                    CHKST:    CMPX   #LET   
                              BLO   cs9   
                              CMPX   #HEAPLIM*256   
                              BLO   ck9   ; in range: return
                    CS9:      LDA   #"O"   
                    EH2:      LEAS   2,S   ; chkst"s or chkbrk"s return address
                              FCB   8Ch   ; (and the chain below hides every LDA)
                    E_BRACK:   LDA   #"W"   ; [ and a bad character (AT is set)
                              FCB   8Ch   
                    E_ZERO:   LDA   #"Z"   ; / by zero
                              FCB   8Ch   
                    E_HEAP:   LDA   #"H"   ; _ past the limit, or below the program's end
                              FCB   8Ch   
                    E_QUOTE:   LDA   #"Q"   ; " or $ ran into the NUL
                              FCB   8Ch   
                    E_NEST:   LDA   #"N"   ; a skip from ( or [: the NUL or the wrong closer
                    EH1:      LEAS   2,S   ; the dispatcher's return address
                                 ; and fall into error
                                 ; =============================================================================
                                 ;  Checked build: the error report. A = the letter, AT = the place; U and S
                                 ;  are as the program left them (see "the error entries" after `upper`).
                                 ;  It sits here, ahead of h_num, pdec and putc, so that it reaches them with
                                 ;  short calls. Prints
                                 ; 
                                 ;     CR LF
                                 ;     Err X @ line,col CR LF
                                 ;     <up to 16 raw characters from the place, ending early at CR, LF, NUL>
                                 ;     CR LF
                                 ;     Stk n:[ ...][ v]*  CR LF     (the top 8 cells, bottom to top, signed)
                                 ;     Rtn n CR LF
                                 ; 
                                 ;  and goes to EXIT. Line and column count from 1: the line is one more
                                 ;  than the LFs between PROG and the place, the column the distance from the
                                 ;  last LF (or from PROG-1). A place below PROG is in the -n? line buffer:
                                 ;  line 0, column = its offset there + 1. Numbers other than the cells are
                                 ;  printed unsigned (pdec), the cells signed (h_num).
                                 ; 
                                 ;  The data stack may be one cell past its limit (S, U = 80FEh): the
                                 ;  report's own cells then reach 8 bytes further down, to 80F6h, into the
                                 ;  return stack page, so the report runs on a fresh return stack at RSREP
                                 ;  (80F0h), below those bytes.
                                 ; =============================================================================
                    ERROR:    TFR   A,B   ; the letter (pmsg and CONOUT keep B)
                              JSR   pmsg   
                              FCB   13,10,"Err"," "+80h   
                              TFR   B,A   
                              JSR   CONOUT   
                              TFR   S,D   ; the return stack's depth, (RSTOP - S) / 2:
                              COMA      ;   -S-1 ...
                              COMB      
                              ADDD   #RSTOP+1   ;   ... + RSTOP+1
                              LSRA      
                              RORB      
                              LDS   #RSREP   
                              PSHU   D   ; kept on the data stack, printed last
                              JSR   pmsg   
                              FCB   " @"," "+80h   
                                 ; the place: Y counts the lines, X walks, the cell at ,U holds the
                                 ; address of the last LF (PROG-1 to begin with)
                              LDY   #0   
                              LDX   #LINEBUF-1   
                              PSHU   X   
                              LDX   #PROG-1   
                              CMPX   <AT   
                              BHS   lc3   ; the place is below PROG: line 0
                              STX   ,U   
                    LC1:      LEAY   1,Y   ; a line
                    LC2:      LEAX   1,X   
                              CMPX   <AT   
                              BHS   lc3   
                              LDA   ,X   
                              CMPA   #10   
                              BNE   lc2   
                              STX   ,U   
                              BRA   lc1   
                    LC3:      LDD   <AT   
                              SUBD   ,U   
                              STD   ,U   ; the column
                              PSHU   Y   
                              JSR   pdec   ; the line
                              BSR   pmsg   
                              FCB   ","+80h   
                              JSR   pdec   ; the column
                              BSR   pmsg   
                              FCB   13,10+80h   
                                 ; the text at the place
                              LDX   <AT   
                              LDB   #16   
                    TX1:      LDA   ,X+   
                              BEQ   tx9   
                              CMPA   #10   
                              BEQ   tx9   
                              CMPA   #13   
                              BEQ   tx9   
                              JSR   putc   
                              DECB      
                              BNE   tx1   
                    TX9:      BSR   pmsg   
                              FCB   13,10,"Stk"," "+80h   
                                 ; the data stack: its depth, then its top 8 cells, from Y down to
                                 ; the program"s top cell, which is under the return stack"s depth,
                                 ; at 2,U.
                              LEAY   2,U   
                              PSHS   Y   ; where the walk ends
                              LDD   #DSTOP   
                              SUBD   ,S   
                              LSRA      
                              RORB      
                              PSHU   D   
                              BSR   pdec   ; the depth
                              BSR   pmsg   
                              FCB   ":"+80h   
                              LEAY   16,Y   ; past the 8th cell from the top ...
                              CMPY   #DSTOP   
                              BHS   sl1   
                              BSR   pmsg   ; (there are more than 8)
                              FCB   " ..","."+80h   
                              BRA   sl2   
                    SL1:      LDY   #DSTOP   ; ... or the whole stack, if no more than 8
                    SL2:      CMPY   ,S   
                              BLS   sl9   
                              LDD   ,--Y   
                              PSHU   D   
                              BSR   pmsg   
                              FCB   " "+80h   
                              BSR   h_num   
                              BRA   sl2   
                    SL9:      BSR   pmsg   
                              FCB   13,10,"Rtn"," "+80h   
                              BSR   pdec   ; the depth of the return stack, pushed first
                              BSR   pmsg   
                              FCB   13,10+80h   
                              JMP   EXIT   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              BSR   putc   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
F260                          ENDIF      
F260                             ; "#" prints TOS as a signed decimal number, with no space after it.
F260   6D C4        H_NUM:    TST   ,U   
F262   2A 06                  BPL   pdec   
F264   86 2D                  LDA   #"-"   
F266   8D 1B                  BSR   putc   
F268   8D 59                  BSR   negt   
F26A                             ; pdec: print the top cell as unsigned and drop it, by recursion on /10
F26A   CC 00 0A     PDEC:     LDD   #10   
F26D   36 06                  PSHU   D   
F26F   8D 63                  BSR   udiv   ; NOS = quotient, TOS = digit
F271   37 06                  PULU   D   ; the digit
F273   34 04                  PSHS   B   
F275   EC C4                  LDD   ,U   
F277   27 04                  BEQ   pd1   
F279   8D EF                  BSR   pdec   
F27B   20 02                  BRA   pd2   
F27D   33 42        PD1:      LEAU   2,U   ; drop the zero quotient
F27F   35 02        PD2:      PULS   A   
F281   8B 30                  ADDA   #"0"   ; and fall into putc
F283   7E FF 03     PUTC:     JMP   CONOUT   
F286                             ; ---- more arithmetic ---------------------------------------------------------
F286   EC C1        H_AND:    LDD   ,U++   
F288   A4 C4                  ANDA   ,U   
F28A   E4 41                  ANDB   1,U   
F28C   20 04                  BRA   st   
F28E   EC C1        H_ADD:    LDD   ,U++   
F290   E3 C4                  ADDD   ,U   
F292   ED C4        ST:       STD   ,U   
F294   39                     RTS      
F295                             ; "-" has two jobs: directly before a digit it starts a negative number.
F295   BD F0 7A     H_SUB:    JSR   isdig   
F298   25 26                  BLO   negnum   
F29A   EC 42                  LDD   2,U   
F29C   A3 C1                  SUBD   ,U++   
F29E   20 F2                  BRA   st   
F2A0                             ; ---- the tail ---------------------------------------------------------------
F2A0                             ; "/" is the last handler, so what follows its first byte may lie past the
F2A0                             ; second range: the divide itself and the routines after it.
F2A0                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
F2A0                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F2A0                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
F2A0                             ; it stops with Z, both operands still on the stack.
F2A0                H_DIV:       
F2A0                          IF   CHECKED   
                              LDD   ,U   
                              LBEQ   e_zero   
F2A0                          ENDIF      
F2A0   A6 42                  LDA   2,U   
F2A2   34 02                  PSHS   A   ; a's sign: for r
F2A4   A8 C4                  EORA   ,U   
F2A6   34 02                  PSHS   A   ; a xor b: for q
F2A8   30 42                  LEAX   2,U   
F2AA   8D 22                  BSR   absx   ; |a|
F2AC   1F 31                  TFR   U,X   
F2AE   8D 1E                  BSR   absx   ; |b|
F2B0   8D 22                  BSR   udiv   ; NOS = q, TOS = r
F2B2   30 42                  LEAX   2,U   
F2B4   6D E0                  TST   ,S+   
F2B6   2A 02                  BPL   dv1   
F2B8   8D 0B                  BSR   negx   ; q's sign
F2BA   6D E0        DV1:      TST   ,S+   
F2BC   2A 0F                  BPL   ng9   
F2BE   20 03                  BRA   negt   ; r's sign
F2C0   BD F0 81     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F2C3   1F 31        NEGT:     TFR   U,X   
F2C5   EC 84        NEGX:     LDD   ,X   ; negx: negate the cell at X
F2C7   40                     NEGA      
F2C8   50                     NEGB      
F2C9   82 00                  SBCA   #0   
F2CB   ED 84                  STD   ,X   
F2CD   39           NG9:      RTS      
F2CE   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F2D0   2A FB                  BPL   ng9   
F2D2   20 F1                  BRA   negx   
F2D4                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F2D4                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F2D4                             ; the TOS cell the remainder. The remainder is built in D (always < the
F2D4                             ; divisor, so 2R+1 fits in 16 bits).
F2D4                             ; Dividing by 2 is one shift (the spec wants that fast).
F2D4   EC C4        UDIV:     LDD   ,U   
F2D6   83 00 02               SUBD   #2   
F2D9   26 07                  BNE   ud0   
F2DB   64 42                  LSR   2,U   
F2DD   66 43                  ROR   3,U   ; the quotient
F2DF   59                     ROLB      ; the remainder: the bit that fell out (D was 0)
F2E0   20 18                  BRA   ud3   
F2E2   8E 00 10     UD0:      LDX   #16   
F2E5   4F                     CLRA      
F2E6   5F                     CLRB      
F2E7   68 43        UD1:      ASL   3,U   
F2E9   69 42                  ROL   2,U   ; the dividend's top bit ...
F2EB   59                     ROLB      
F2EC   49                     ROLA      ; ... into the remainder
F2ED   10 A3 C4               CMPD   ,U   
F2F0   25 04                  BLO   ud2   
F2F2   A3 C4                  SUBD   ,U   
F2F4   6C 43                  INC   3,U   ; a quotient bit
F2F6   30 1F        UD2:      LEAX   -1,X   
F2F8   26 ED                  BNE   ud1   
F2FA   ED C4        UD3:      STD   ,U   
F2FC   39                     RTS      
F2FD                          IF   CHECKED   
                                 ; getk: a key held back by the break check goes first; then the host's KEY.
                    GETK:     LDA   <KEYBUF   
                              BEQ   gk1   
                              CLR   <KEYBUF   
                              TSTA      
                              RTS      
                    GK1:      JMP   KEY   
F2FD                          ENDIF      
F2FD                IMGEND:      


