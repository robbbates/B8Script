E241   B5 00                  LDA   0,X   
E243   48                     PHA      
E244   E8                     INX      
E245   E8                     INX      
E246   D0 0A                  BNE   nxt2   ; always: X is never 0
E248   68           H_FROMR:   PLA      
E249   68                     PLA      
E24A   CA                     DEX      
E24B   CA                     DEX      
E24C   68                     PLA      
E24D   95 00                  STA   0,X   
E24F   68                     PLA      
E250   95 01                  STA   1,X   
E252   4C 17 E5     NXT2:     JMP   next   
E255                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E255   4C 18 E1     H_NOT:    JMP   neg1   
E258   20 5B E2     H_XOR:    JSR   xr1   
E25B   B5 00        XR1:      LDA   0,X   
E25D   55 02                  EOR   2,X   
E25F   95 02                  STA   2,X   
E261   E8                     INX      
E262   60                     RTS      
E263   20 66 E2     H_OR:     JSR   or1   
E266   B5 00        OR1:      LDA   0,X   
E268   15 02                  ORA   2,X   
E26A   95 02                  STA   2,X   
E26C   E8                     INX      
