F2A9   8D 54                  BSR   putc   
F2AB   33 42        H_DROP:   LEAU   2,U   ; ";"
F2AD   39                     RTS      
F2AE                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
F2AE                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
F2AE                             ; bit 6, so // and /" give themselves).
