  1895                              <1> ; =============================================================================
  1896                              <1> ;  The letters and digits, the return stack's push, and the inner loop
  1897                              <1> ; =============================================================================
  1898                              <1> 
  1899                              <1> 
  1900                              <1> ; =============================================================================
  1901                              <1> ;  The inner loop: read one character and sort it by range.
  1902                              <1> ;
  1903                              <1> ;    00h          end of program
  1904                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1905                              <1> ;                 build stops on 80h-FFh: X)
  1906                              <1> ;    30h-39h      digit: read a whole number
  1907                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1908                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1909                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1910                              <1> ; =============================================================================
  1911                              <1> ; Digits: step back onto the first digit and read the whole number.
  1912 0000090C 53                  <1> digit:  push    ebx
  1913 0000090D 4E                  <1>         dec     esi
  1914                              <1>         CALLP   rdnum
   192                              <2>  %if P_%1
   193 0000090E FF55DA              <2>  call [V(p_%1)]
   194                              <2>  %else
   195                              <2>  call %1
   196                              <2>  %endif
  1915 00000911 FFE5                <1>         jmp     ebp
  1916                              <1> 
  1917                              <1> ; a-z: push the cell's address (the cell is the variable).
  1918 00000913 53                  <1> lower:  push    ebx
  1919 00000914 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1920 0000091B FFE5                <1>         jmp     ebp
  1921                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1922                              <1> ; next in reach)
  1923 0000091D 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1924 0000091F 7505                <1>         jnz     next                    ; the rest are ignored
  1925 00000921 E9FBFBFFFF          <1>         jmp     endprog
  1926                              <1> %if CHECKED
  1927                              <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1928                              <1>         jmp     error
  1929                              <1> %endif
  1930                              <1> next:
  1931                              <1> %if CHECKED
  1932                              <1>         call    chkstk                  ; both stacks, once per character
  1933                              <1> %endif
  1934 00000926 31C0                <1>         xor     eax,eax
  1935 00000928 AC                  <1>         lodsb
  1936 00000929 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1937 0000092B 72F0                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1938 0000092D 3C0F                <1>         cmp     al,0Fh
  1939 0000092F 7226                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1940 00000931 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1941 00000933 3C0A                <1>         cmp     al,0Ah
  1942 00000935 72D5                <1>         jb      digit                   ; 30h-39h
  1943 00000937 3C11                <1>         cmp     al,11h
  1944 00000939 721A                <1>         jb      p3a                     ; 3Ah-40h
  1945 0000093B 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1946 0000093D 3C1A                <1>         cmp     al,1Ah
  1947 0000093F 0F829EF7FFFF        <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1948 00000945 3C20                <1>         cmp     al,20h
  1949 00000947 720A                <1>         jb      p5b                     ; 5Bh-60h
  1950 00000949 3C3A                <1>         cmp     al,3Ah
  1951 0000094B 72C6                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1952 0000094D 3C3E                <1>         cmp     al,3Eh
  1953                              <1> %if CHECKED
  1954                              <1>         je      next                    ; 7Fh, DEL: ignored
  1955                              <1>         jae     e_hi                    ; 80h-FFh: reserved
  1956                              <1> %else
  1957 0000094F 73D5                <1>         jae     next                    ; 7Fh-FFh: ignored
  1958                              <1> %endif
  1959 00000951 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1960 00000953 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1961 00000955 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1962 00000957 8A80[46070000]      <1> punct:  mov     al,[ptab+eax]
  1963 0000095D 8D80[07010000]      <1>         lea     eax,[hbase+eax]
  1964 00000963 FFE0                <1>         jmp     eax
