019B   B7                     ORA   A   
019C   FC 20 00               CM   neg16   ; HL = |a|, DE = |b|
019F   CD 78 02               CALL   udiv   ; HL = q, BC = r
01A2   F1                     POP   PSW   
01A3   FC 20 00               CM   neg16   ; q's sign
01A6   EB                     XCHG      ; DE = q
01A7   60                     MOV   H,B   
01A8   69                     MOV   L,C   ; HL = r
01A9   F1                     POP   PSW   
01AA   FC 20 00               CM   neg16   ; r's sign
01AD   C1                     POP   B   
01AE   D5                     PUSH   D   ; q under r
01AF                          ;*Macro unroll:  NEXT
01AF   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01B0                          DS   CPM+FAST-CPM*FAST,0C3h   
01B0                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01B0                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01B0                             ; ---- stack and storage -----------------------------------------------------
01B0   E5           H_DUP:    PUSH   H   ; ":"
01B1                          ;*Macro unroll:  NEXT
01B1   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01B2                          DS   CPM+FAST-CPM*FAST,0C3h   
01B2                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01B2                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01B2   E3           H_SWAP:   XTHL      ; "%"
01B3                          ;*Macro unroll:  NEXT
01B3   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01B4                          DS   CPM+FAST-CPM*FAST,0C3h   
01B4                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01B4                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01B4                             ; (The checked build tests the address before it takes the value off the
01B4                             ; stack, so that an error report shows both.)
01B4                H_STORE:      ; "!" ( n addr -- )
01B4                          IF   CHECKED   
01B4   CD CC 03               CALL   chkst   
01B7                          ENDIF      
01B7   D1                     POP   D   
01B8   73                     MOV   M,E   
01B9   23                     INX   H   
01BA   72                     MOV   M,D   
01BB                          ;*Macro unroll:  DROP
01BB   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01BC                          DS   CPM*(1-FAST),0C3h   
01BC                          DS   CPM*(1-FAST),ADRP&0FFh   
01BC                          DS   CPM*(1-FAST),ADRP/256   
01BC                          DS   FAST,0E1h   
01BC                          DS   FAST,0C3h   
01BC                          DS   FAST,ANXT&0FFh   
01BC                          DS   FAST,ANXT/256   
01BC                H_CSTORE:      ; "." ( c addr -- )
01BC                          IF   CHECKED   
01BC   CD CC 03               CALL   chkst   
01BF                          ENDIF      
01BF   D1                     POP   D   
01C0   73                     MOV   M,E   
01C1                          ;*Macro unroll:  DROP
01C1   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01C2                          DS   CPM*(1-FAST),0C3h   
01C2                          DS   CPM*(1-FAST),ADRP&0FFh   
01C2                          DS   CPM*(1-FAST),ADRP/256   
01C2                          DS   FAST,0E1h   
01C2                          DS   FAST,0C3h   
01C2                          DS   FAST,ANXT&0FFh   
01C2                          DS   FAST,ANXT/256   
01C2                             ; ---- console ---------------------------------------------------------------
01C2                             ; 22h pushes the address of the text after it and skips the string.
01C2   E5           H_STR:    PUSH   H   
01C3   60                     MOV   H,B   
01C4   69                     MOV   L,C   
01C5   CD 4D 03               CALL   skipstr   
01C8                          IF   CHECKED   
01C8   B7                     ORA   A   ; 0: the text ran out before the closing quote
01C9   CA 5B 04               JZ   e_quote   
01CC                          ENDIF      
01CC                          ;*Macro unroll:  NEXT
01CC   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01CD                          DS   CPM+FAST-CPM*FAST,0C3h   
01CD                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01CD                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01CD                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01CD                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01CD                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01CD                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01CD                          IF   1-CHECKED   
                    H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
                    PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
                    PRAGAIN:   EQU   prlp   ;   the image's first two pages)
01CD                          ENDIF      
01CD                          IF   CHECKED   
01CD                             ; (The checked build has the loop as a routine, prstr, which the error
01CD                             ; report uses too. The address is kept meanwhile, for a report: it shows
01CD                             ; the stack as it was before the "$". /~ comes back to hp1.)
01CD   22 3A 82     H_PRINT:   SHLD   PSAVE   
01D0   CD DF 03     HP1:      CALL   prstr   
01D3                          ;*Macro unroll:  DROP
01D3   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01D4                          DS   CPM*(1-FAST),0C3h   
01D4                          DS   CPM*(1-FAST),ADRP&0FFh   
01D4                          DS   CPM*(1-FAST),ADRP/256   
01D4                          DS   FAST,0E1h   
01D4                          DS   FAST,0C3h   
01D4                          DS   FAST,ANXT&0FFh   
01D4                          DS   FAST,ANXT/256   
01D4                          ENDIF      
01D4   7D           H_EMIT:   MOV   A,L   ; "'"
01D5                          ;*Macro unroll:  PUTA
01D5   EF                     DS   1-CPM,0EFh   
01D6                          DS   CPM,0CDh   
01D6                          DS   CPM,APUT&0FFh   
01D6                          DS   CPM,APUT/256   
01D6                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
01D6   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
01D7                          DS   CPM*(1-FAST),0C3h   
01D7                          DS   CPM*(1-FAST),ADRP&0FFh   
01D7                          DS   CPM*(1-FAST),ADRP/256   
01D7                          DS   FAST,0E1h   
01D7                          DS   FAST,0C3h   
01D7                          DS   FAST,ANXT&0FFh   
01D7                          DS   FAST,ANXT/256   
01D7                             ; "#" prints TOS as a signed decimal number, with no space after it.
01D7   C5           H_NUM:    PUSH   B   
01D8   CD AA 02               CALL   psgn   
01DB   C1                     POP   B   
01DC                          ;*Macro unroll:  DROP
01DC   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01DD                          DS   CPM*(1-FAST),0C3h   
01DD                          DS   CPM*(1-FAST),ADRP&0FFh   
01DD                          DS   CPM*(1-FAST),ADRP/256   
01DD                          DS   FAST,0E1h   
01DD                          DS   FAST,0C3h   
01DD                          DS   FAST,ANXT&0FFh   
01DD                          DS   FAST,ANXT/256   
01DD                          IF   CHECKED   ; (the checked build has no room to start ","
01DD   6E           H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
01DE   26 00                  MVI   H,0   ;   the end of "?")
01E0                          ;*Macro unroll:  NEXT
01E0   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01E1                          DS   CPM+FAST-CPM*FAST,0C3h   
01E1                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01E1                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01E1                          ENDIF      
01E1                             ; "?" ( n -- c ) or ( -n -- addr )
01E1                             ;   n > 0: wait about n ms for a key; 0 if none came
01E1                             ;   n = 0: wait for a key
01E1                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01E1                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01E1   7C           H_KEY:    MOV   A,H   
01E2   B7                     ORA   A   
01E3   FA 01 02               JM   line   
01E6   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
01E8   CD A5 03     KT2:      CALL   getk   
01EB   C2 FD 01               JNZ   kt3   
01EE   1D                     DCR   E   
01EF   C2 E8 01               JNZ   kt2   
01F2   7C                     MOV   A,H   ; 0? never counts down: it waits
01F3   B5                     ORA   L   
01F4   CA E6 01               JZ   kt1   
01F7   2B                     DCX   H   
01F8   7C                     MOV   A,H   
01F9   B5                     ORA   L   
01FA   C2 E6 01               JNZ   kt1   ; A = 0 if the time ran out
01FD                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01FD                          ENDIF      
01FD   6F           KT3:      MOV   L,A   
01FE   26 00                  MVI   H,0   
0200                          ;*Macro unroll:  NEXT
0200   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0201                          DS   CPM+FAST-CPM*FAST,0C3h   
0201                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0201                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0201                             ; Backspace takes the last character back (and is echoed as
0201                             ; it is), CR ends (stored, not echoed), every other key is stored and
0201                             ; echoed until the line is full. The line buffer starts at offset 80h
0201                             ; of its page, so L alone is the place in the line: D holds the L of
0201                             ; a full line.
0201   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
0204   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
0205   9F                     SBB   A   
0206   A5                     ANA   L   ; (0 for a count that is too big)
0207   2F                     CMA      
0208   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
0209                             ;   at most
0209   21 80 82               LXI   H,LINEBUF   
020C   CD A5 03     LN2:      CALL   getk   
020F   CA 0C 02               JZ   ln2   
0212   FE 0D                  CPI   13   
0214   CA 31 02               JZ   ln5   
0217   FE 08                  CPI   8   
0219   CA 29 02               JZ   ln4   
021C   5F                     MOV   E,A   
021D   7D                     MOV   A,L   
021E   BA                     CMP   D   
021F   CA 0C 02               JZ   ln2   ; full
0222   73                     MOV   M,E   
0223   2C                     INR   L   
0224   7B                     MOV   A,E   
0225                          ;*Macro unroll: ln3:    PUTA
0225   EF           LN3:      DS   1-CPM,0EFh   
0226                          DS   CPM,0CDh   
0226                          DS   CPM,APUT&0FFh   
0226                          DS   CPM,APUT/256   
0226   C3 0C 02               JMP   ln2   
0229   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
022A   FA 25 02               JM   ln3   ;   unless the line was empty (L left the
022D   2C                     INR   L   ;   upper half of the page)
022E   C3 0C 02               JMP   ln2   
0231   77           LN5:      MOV   M,A   ; the CR
0232   2E 80                  MVI   L,LINEBUF & 0FFh   
0234                          ;*Macro unroll:  NEXT
0234   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0235                          DS   CPM+FAST-CPM*FAST,0C3h   
0235                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0235                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0235                             ; =============================================================================
0235                             ;  Dispatch table: the low byte of each handler's address, in code order.
0235                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0235                             ; =============================================================================
0235                             ; The handlers of the first NPG1 characters start in the image's second page.
0235                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0235                             ; differs between the builds, so the count is worked out here.
0235                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0235                          IF   1-FAST   
0235                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0235                PGBRK:    EQU   (h_break-BASE)/256   
0235                PGDEF:    EQU   (h_def-BASE)/256   
0235                PGFET:    EQU   (h_fetch-BASE)/256   
0235                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0235                          ENDIF      
0235                          IF   (1-FAST)*(1-PTLATE)   
0235                PTAB:        
0235                          ;*Macro unroll:  PTABLE
0235   B4                     DB   h_store & 0FFh   
0236   C2                     DB   h_str & 0FFh   
0237   D7                     DB   h_num & 0FFh   
0238   CD                     DB   h_print & 0FFh   
0239   B2                     DB   h_swap & 0FFh   
023A   47                     DB   h_and & 0FFh   
023B   D4                     DB   h_emit & 0FFh   
023C   23                     DB   h_open & 0FFh   
023D   2F                     DB   h_close & 0FFh   
023E   6C                     DB   h_mul & 0FFh   
023F   44                     DB   h_add & 0FFh   
0240   DD                     DB   h_cfetch & 0FFh   
0241   3B                     DB   h_sub & 0FFh   
0242   BC                     DB   h_cstore & 0FFh   
0243   88                     DB   h_div & 0FFh   
0244   B0                     DB   h_dup & 0FFh   
0245   D6                     DB   h_drop & 0FFh   
0246   50                     DB   h_lt & 0FFh   
0247   5F                     DB   h_eq & 0FFh   
0248   4F                     DB   h_gt & 0FFh   
0249   E1                     DB   h_key & 0FFh   
024A   1E                     DB   h_fetch & 0FFh   
024B   F7                     DB   h_def & 0FFh   
024C   E8                     DB   h_break & 0FFh   
024D   E3                     DB   h_ret & 0FFh   
024E   82                     DB   h_xor & 0FFh   
024F   95                     DB   h_alloc & 0FFh   
0250   C6                     DB   h_grave & 0FFh   
0251   14                     DB   h_tor & 0FFh   
0252   8A                     DB   h_or & 0FFh   
0253   1D                     DB   h_fromr & 0FFh   
0254   92                     DB   h_not & 0FFh   
0255                PTABEND:      
0255                          ENDIF      
0255                             ; =============================================================================
0255                             ;  Routines (no handler starts past this point)
0255                             ; =============================================================================
0255                             ; Digits: step back onto the first digit and read the whole number.
0255   E5           DIGIT:    PUSH   H   
0256   0B                     DCX   B   
0257   CD 61 02               CALL   rdnum   
025A                          ;*Macro unroll:  NEXT
025A   F7                     DS   (1-CPM)*(1-FAST),0F7h   
025B                          DS   CPM+FAST-CPM*FAST,0C3h   
025B                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
025B                          DS   CPM+FAST-CPM*FAST,ANXT/256   
025B                             ; negnum: "-" directly before a digit: read the number, negate it.
025B   E5           NEGNUM:   PUSH   H   
025C   CD 61 02               CALL   rdnum   
025F                          ;*Macro unroll:  NEGH
025F   E7                     DS   1-CPM,0E7h   
0260                          DS   CPM,0CDh   
0260                          DS   CPM,ANEG&0FFh   
0260                          DS   CPM,ANEG/256   
0260                          ;*Macro unroll:  NEXT
0260   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0261                          DS   CPM+FAST-CPM*FAST,0C3h   
0261                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0261                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0261                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0261                             ; non-digit. Values wrap at 16 bits, as the spec says.
0261   21 00 00     RDNUM:    LXI   H,0   
0264   0A           RDN1:     LDAX   B   
0265   D6 30                  SUI   "0"   
0267   FE 0A                  CPI   10   
0269   D0                     RNC      
026A   03                     INX   B   
026B   54                     MOV   D,H   
026C   5D                     MOV   E,L   
026D   29                     DAD   H   
026E   29                     DAD   H   
026F   19                     DAD   D   
0270   29                     DAD   H   ; HL * 10
0271   5F                     MOV   E,A   
0272   16 00                  MVI   D,0   
0274   19                     DAD   D   
0275   C3 64 02               JMP   rdn1   
0278                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0278                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0278                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0278                             ; lives on the stack, since A is busy with the shifts.
0278                             ; Dividing by 2 is one shift (the spec wants that fast).
0278   01 00 00     UDIV:     LXI   B,0   
027B                          IF   1-QK   
027B   7B                     MOV   A,E   
027C   EE 02                  XRI   2   
027E   B2                     ORA   D   
027F   C2 8C 02               JNZ   udv0   
0282   B4                     ORA   H   ; A was 0, and the carry is clear
0283   1F                     RAR      
0284   67                     MOV   H,A   
0285   7D                     MOV   A,L   
0286   1F                     RAR      
0287   6F                     MOV   L,A   ; the quotient
0288   78                     MOV   A,B   
0289   17                     RAL      
028A   4F                     MOV   C,A   ; the remainder: the bit that fell out
028B   C9                     RET      
028C                          ENDIF      
028C                          IF   QK   
                                 ; (The builds with room divide by any power of two with shifts: 2, and 32,
                                 ; 64, 256 and the like, which fixed point and byte work use all the time.)
                              MOV   A,D   
                              ORA   A   
                              JNZ   uq1   ; 256 and up
                              ORA   E   
                              JZ   udv0   ; by 0: the long way (it means nothing anyway)
                              DCR   A   
                              ANA   E   
                              JNZ   udv0   ; not a power of two
                              MOV   A,E   ; by 2^k below 256: q = HL >> k, and
                              DCR   A   ;   r = L & (2^k - 1)
                              ANA   L   
                              MOV   C,A   
028C                          ENDIF      
028C                          IF   QK*(1-FAST)   
                    UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
                              ORA   A   
                              RAR      
                              RC      
                              MOV   E,A   
                              MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              JMP   uq2   
028C                          ENDIF      
028C                          IF   FAST   
                                 ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
                                 ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
                    UQ2:      MOV   A,E   
                              CPI   16   
                              JNC   uqh   
                              CPI   2   
                              RC      ; by 1
                              JZ   ur1   
                              CPI   4   
                              JZ   ur2   
                    UR3:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR2:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR1:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              RET      
                    UQH:      CPI   64   
                              MVI   A,0   
                              JZ   ul2   
                              JNC   ul1   
                              MOV   A,E   
                              CPI   32   
                              MVI   A,0   
                              JZ   ul3   
                              DAD   H   ; by 16
                              ADC   A   
                    UL3:      DAD   H   
                              ADC   A   
                    UL2:      DAD   H   
                              ADC   A   
                    UL1:      DAD   H   
                              ADC   A   
                              MOV   L,H   
                              MOV   H,A   
                              RET      
028C                          ENDIF      
028C                          IF   QK   
                    UQ1:      MOV   A,E   
                              ORA   A   
                              JNZ   udv0   
                              MOV   A,D   
                              DCR   A   
                              ANA   D   
                              JNZ   udv0   ; not a power of two
                              MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
                              DCR   A   ;   q = H >> (k - 8)
                              ANA   H   
                              MOV   B,A   
                              MOV   C,L   
                              MOV   L,H   
                              MVI   H,0   
                              MOV   E,D   
                              JMP   uq2   
028C                          ENDIF      
028C                          IF   1-FAST   
028C   3E 10        UDV0:     MVI   A,16   
028E   F5                     PUSH   PSW   
028F   29           UDV1:     DAD   H   ; next dividend bit into the carry
0290   79                     MOV   A,C   
0291   17                     RAL      
0292   4F                     MOV   C,A   
0293   78                     MOV   A,B   
0294   17                     RAL      
0295   47                     MOV   B,A   ; BC = BC*2 + bit
0296   79                     MOV   A,C   
0297   93                     SUB   E   
0298   78                     MOV   A,B   
0299   9A                     SBB   D   ; carry if BC < DE
029A   DA A2 02               JC   udv2   
029D   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
029E   79                     MOV   A,C   
029F   93                     SUB   E   
02A0   4F                     MOV   C,A   
02A1   2C                     INR   L   ; quotient bit
02A2   F1           UDV2:     POP   PSW   
02A3   3D                     DCR   A   
02A4   F5                     PUSH   PSW   
02A5   C2 8F 02               JNZ   udv1   
02A8   F1                     POP   PSW   
02A9   C9                     RET      
02AA                          ENDIF      
02AA                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
                                 ; starts 8 bits up and takes only the last 8, since its first 8 would only
                                 ; shift zeros)
                    UDV0:     MOV   A,H   
                              ORA   A   
                              JZ   uvs   
                    UV0:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw0   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW0:         
                    UV1:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw1   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW1:         
                    UV2:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw2   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW2:         
                    UV3:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw3   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW3:         
                    UV4:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw4   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW4:         
                    UV5:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw5   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW5:         
                    UV6:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw6   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW6:         
                    UV7:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw7   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW7:         
                    UV8:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw8   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW8:         
                    UV9:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw9   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW9:         
                    UV10:     DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw10   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW10:        
                    UV11:     DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw11   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
