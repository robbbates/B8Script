0138                             ; multiplier is used up; only the low 16 bits are kept.
0138                          IF   QK   
0138   D1           H_MUL:    POP   D   ; DE = multiplicand
0139   C3 D2 04               JMP   mulq   ; (out of the handlers' pages: see Speed-ups)
013C                          ENDIF      
013C                          IF   1-QK   
                    H_MUL:    POP   D   ; DE = multiplicand
