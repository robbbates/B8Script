   357                              <1> ; =============================================================================
   358                              <1> ;  Punctuation handlers. PTAB holds one byte per character: its handler's
   359                              <1> ;  distance from hbase, so every handler starts in the 256 bytes from hbase
   360                              <1> ;  (PT checks it). Only the starts must be there: the last handler, '?',
   361                              <1> ;  runs on past the window, and '[', '_', '`' (and '/' in a checked build)
   362                              <1> ;  are stubs that jump to their bodies after it. Each handler starts with EBX = TOS and EAX, ECX, EDX
   363                              <1> ;  free, and ends with JMP EBP.
   364                              <1> ;  (Two other layouts were tried: handlers 2-aligned with the table holding
   365                              <1> ;  half the distance, which costs a NOP after every handler of odd length,
   366                              <1> ;  about 22 bytes; and the Z80's two 256-byte windows, whose dispatcher is 7
   367                              <1> ;  bytes longer and whose handlers must be in table order, which costs near
   368                              <1> ;  jumps.)
   369                              <1> ; =============================================================================
   370                              <1> hbase:
   371                              <1> ; ']' returns: pop an address and jump to it.
   372 000000E2 8B37                <1> h_ret:  mov     esi,[edi]
   373 000000E4 AF                  <1> rdrop:  scasd                           ; drop the return stack's top
   374 000000E5 FFE5                <1> nx:     jmp     ebp
   375                              <1> 
   376                              <1> ; '\' ( flag -- ): true skips to the next ')' or ']' at this level; ')'
   377                              <1> ; drops the block start, ']' returns. No closer at all ends the program.
   378 000000E7 6685DB              <1> h_break:test    bx,bx
