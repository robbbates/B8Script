   585 00000207 BA[54040000]        <1>         mov     edx,gtab-2
   586 0000020C 42                  <1> .g1:    inc     edx
   587 0000020D 42                  <1>         inc     edx
   588                              <1> %if CHECKED
   589 0000020E 803A00              <1>         cmp     byte [edx],0            ; the end of the table: W. The place
   590 00000211 0F84E2000000        <1>         je      e_brack                 ;   is the character
   591                              <1> %endif
