E31A   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E31C   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E31D   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E31F   4C A3 E6               JMP   error   
