E5A6   A0 11                  LDY   #M_CD-MSG   
E5A8   85 05        ER3:      STA   T1   ; T1 = how many cells to show
E5AA   20 EE E5               JSR   prs   
E5AD   A5 05        ER4:      LDA   T1   ; cells T1-1 down to 0, the top last: cell i
E5AF   F0 1F                  BEQ   er5   ;   from the top is at X+2i
E5B1   C6 05                  DEC   T1   
E5B3   A9 20                  LDA   #" "   
E5B5   20 03 FF               JSR   CONOUT   
E5B8   A5 05                  LDA   T1   
E5BA   0A                     ASL      
E5BB   85 06                  STA   T2   
E5BD   8A                     TXA      
E5BE   65 06                  ADC   T2   ; (the carry is clear)
E5C0   A8                     TAY      
E5C1   B9 00 00               LDA   0,Y   
E5C4   48                     PHA      
E5C5   B9 01 00               LDA   1,Y   
E5C8   A8                     TAY      
E5C9   68                     PLA      
E5CA   20 E8 E5               JSR   prnum   
E5CD   4C AD E5               JMP   er4   
