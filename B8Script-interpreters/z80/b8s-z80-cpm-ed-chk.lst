0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 0A               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 D1 08               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 D4 05     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 15 04               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 BC 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD 5B 04               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LD   A,(BC)   
0138   03                     INC   BC   
0139   D6 21                  SUB   21h   ; A = c - 21h
013B   38 D4                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CP   0Fh   
013F   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0141   D6 0F                  SUB   0Fh   ; A = c - 30h
0143   FE 0A                  CP   0Ah   
0145   38 5F                  JR   C,digit   ; 30h-39h
0147   FE 11                  CP   11h   
0149   38 19                  JR   C,p3a   ; 3Ah-40h
014B   D6 11                  SUB   11h   ; A = c - 41h
014D   FE 1A                  CP   1Ah   
014F   38 61                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0151   FE 20                  CP   20h   
0153   38 0D                  JR   C,p5b   ; 5Bh-60h
0155   FE 3A                  CP   3Ah   
0157   38 53                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0159   FE 3E                  CP   3Eh   
015B                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
015B                          ENDIF      
015B                          IF   CHECKED   
015B   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
015D   D2 88 04               JP   NC,e_hi   ; 80h-FFh: reserved
0160                          ENDIF      
0160   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0162   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0164   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0166                .macro PTABLE,
0166                             ; 
0166                 DB      h_store & 0FFh  ; !
0166                 DB      h_str & 0FFh    ; "
0166                 DB      h_num & 0FFh    ; #
0166                 DB      h_print & 0FFh  ; $
0166                 DB      h_swap & 0FFh   ; %
0166                 DB      h_and & 0FFh    ; &
0166                 DB      h_emit & 0FFh   ; '
0166                 DB      h_open & 0FFh   ; (
0166                 DB      h_close & 0FFh  ; )
0166                 DB      h_mul & 0FFh    ; *
0166                 DB      h_add & 0FFh    ; +
0166                 DB      h_cfetch & 0FFh ; ,
0166                 DB      h_sub & 0FFh    ; -
0166                 DB      h_cstore & 0FFh ; .
0166                 DB      h_div & 0FFh    ; /
0166                 DB      h_dup & 0FFh    ; :
0166                 DB      h_drop & 0FFh   ; ;
0166                 DB      h_lt & 0FFh     ; <
0166                 DB      h_eq & 0FFh     ; =
0166                 DB      h_gt & 0FFh     ; >
0166                 DB      h_key & 0FFh    ; ?
0166                 DB      h_fetch & 0FFh  ; @
0166                 DB      h_def & 0FFh    ; [
0166                 DB      h_break & 0FFh  ; \
0166                 DB      h_ret & 0FFh    ; ]
0166                 DB      h_xor & 0FFh    ; ^
0166                 DB      h_alloc & 0FFh  ; _
0166                 DB      h_grave & 0FFh  ; `
0166                 DB      h_tor & 0FFh    ; {
0166                 DB      h_or & 0FFh     ; |
0166                 DB      h_fromr & 0FFh  ; }
0166                 DB      h_not & 0FFh    ; ~
0166                .endm
0166                 
0166                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0166                             ; untouched, and A, DE free.
0166   C6 A3        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0168   5F                     LD   E,A   
0169   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
016B   FE B9                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016D   1A                     LD   A,(DE)   
016E   5F                     LD   E,A   ; the handler's low byte
016F                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
016F                          ENDIF      
016F                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
016F                          ENDIF      
016F                          IF   CPM   
016F   16 01                  LD   D,1   
0171   30 01                  JR   NC,pu1   
0173   14                     INC   D   ; its page: 1 + carry
0174                PU1:         
0174                          ENDIF      
0174   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0175   C9                     RET      ;   when the handler starts
0176                             ; The rest of the startup: here so that the generic reset code can reach it
0176                             ; with JR. st0: find the program's NUL; the heap starts after it.
0176                             ; (The editor build has its own copy of this, next to the editor.)
0176                             ; A checked build first clears the lower half of the letter page (A = 0):
0176                             ; every variable starts at 0, every word cell holds 0000h, the address an
0176                             ; undefined word is caught at (see e_hi), and no key is held back.
0176                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0176                          ENDIF      
0176                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0176                          ENDIF      
0176                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0176                          ENDIF      
0176                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0176                          ENDIF      ;   these)
0176                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0176                          ENDIF      
0176                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0176                          ENDIF      
0176                             ; In the unchecked generic editor build the table is here, in the first
0176                             ; page, which saves loading D twice. (The other builds have no room for it
0176                             ; here: theirs is further down.)
0176                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0176                          ENDIF      
0176                             ; =============================================================================
0176                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0176                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0176                             ;  is here too: it belongs to "`" and makes the page come out right.
0176                             ; =============================================================================
0176   D1           H_XOR:    POP   DE   
0177   7C                     LD   A,H   
0178   AA                     XOR   D   
0179   67                     LD   H,A   
017A   7D                     LD   A,L   
017B   AB                     XOR   E   
017C   6F                     LD   L,A   
017D   F7                     RST   30h   
017E   D1           H_OR:     POP   DE   
017F   7C                     LD   A,H   
0180   B2                     OR   D   
0181   67                     LD   H,A   
0182   7D                     LD   A,L   
0183   B3                     OR   E   
0184   6F                     LD   L,A   
0185   F7                     RST   30h   
0186   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0187   2B                     DEC   HL   
0188   F7                     RST   30h   
0189                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0189                             ; the same either way); TOS is the old pointer.
0189   ED 5B 7C 0B  H_ALLOC:   LD   DE,(HEAP)   
018D                          IF   CHECKED*CPM   
018D   7C                     LD   A,H   ; the count's sign, for chkhp
018E                          ENDIF      
018E   19                     ADD   HL,DE   ; the new top
018F                          IF   CHECKED   
018F   CD 3F 04               CALL   chkhp   
0192                          ENDIF      
0192   22 7C 0B               LD   (HEAP),HL   
0195   EB                     EX   DE,HL   
0196   F7                     RST   30h   
0197   D9           EXEC:     EXX      
0198   22 34 0B               LD   (RSAVE),HL   ; machine code may change the alternates
019B   D9                     EXX      
019C   CD 2B 01               CALL   jphl   
019F   D9                     EXX      
01A0   2A 34 0B               LD   HL,(RSAVE)   
01A3   D9                     EXX      
01A4   E1                     POP   HL   
01A5   F7                     RST   30h   
01A6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01A6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01A6                             ; Digits: step back onto the first digit and read the whole number.
01A6   E5           DIGIT:    PUSH   HL   
01A7   0B                     DEC   BC   
01A8   CD 25 03               CALL   rdnum   
01AB   F7                     RST   30h   
01AC                             ; a-z: push the cell's address (the cell is the variable)
01AC   E5           LOWER:    PUSH   HL   
01AD   87                     ADD   A,A   
01AE   6F                     LD   L,A   
01AF   26 0B                  LD   H,LETPAGE   
01B1   F7                     RST   30h   
01B2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01B2                             ; the return stack, and the IP becomes the address in the letter's cell.
01B2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01B3   EB                     EX   DE,HL   ; park TOS
01B4   87                     ADD   A,A   
01B5   6F                     LD   L,A   
01B6   26 0B                  LD   H,LETPAGE   ; HL -> cell
01B8   4E                     LD   C,(HL)   
01B9   2C                     INC   L   
01BA   46                     LD   B,(HL)   ; IP = the word's body
01BB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01BC                             ; rpushn: move the top cell of the data stack (in memory) to the return
01BC                             ; stack, then next. Everything that pushes the return stack ends here.
01BC                             ; 
01BC                             ; The break key is looked at here, so at every word call and loop-back (and
01BC                             ; block entry and "{"), but only one time in 256: B', which nothing else
01BC                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
01BC                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
01BC                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
01BC                             ; both ways out.)
01BC   D9           RPUSHN:   EXX      
01BD   D1                     POP   DE   
01BE   2B                     DEC   HL   
01BF   72                     LD   (HL),D   
01C0   2B                     DEC   HL   
01C1   73                     LD   (HL),E   
01C2   05                     DEC   B   
01C3   D9                     EXX      
01C4   CC D5 03               CALL   Z,pollk   
01C7   F7                     RST   30h   
01C8                             ; ---- machine code: the grave -----------------------------------------------
01C8                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01C8                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01C8                             ; written and its address is left. An odd last digit is consumed and dropped.
01C8                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01C8                             ; code is entered by CALL with the data stack above the return address; it
01C8                             ; must keep BC, and on return the top cell becomes the new TOS.
01C8   CD C3 03     H_GRAVE:   CALL   hexc   
01CB   30 CA                  JR   NC,exec   
01CD   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01CE   CD C3 03               CALL   hexc   
01D1   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01D3   ED 6F                  RLD      ;   overwrites it
01D5   23                     INC   HL   ; ... and RLD shifts it up under the low one
01D6   CD C3 03               CALL   hexc   
01D9   38 F2                  JR   C,hx1   
01DB   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01DD   F7                     RST   30h   
01DE                             ; ---- where the two pages meet ----------------------------------------------
01DE                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01DE                             ; are in falling code order for this), and where exactly differs between the
01DE                             ; builds: NPG1 follows. Every handler below these four must start in the
01DE                             ; second page, and every one above in the first; chktab.py checks both.
01DE                             ; "]" returns: pop an address and jump to it.
01DE   CF           H_RET:    RST   08h   
01DF   42                     LD   B,D   
01E0   4B                     LD   C,E   
01E1   F7           BRK1:     RST   30h   
01E2                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E2                             ; drops the block start, "]" returns. No closer at all ends the program.
01E2   7C           H_BREAK:   LD   A,H   
01E3   B5                     OR   L   
01E4   E1                     POP   HL   
01E5   28 FA                  JR   Z,brk1   
01E7   CD 4C 03               CALL   skip   
01EA   B7                     OR   A   ; skip returns 0 for ")"
01EB   20 F1                  JR   NZ,h_ret   
01ED   CF           RDROP:    RST   08h   
01EE   F7                     RST   30h   
01EF                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EF                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EF                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EF                             ; (The unchecked build takes anything that is not a letter as the space; the
01EF                             ; checked build stops on it.)
01EF   0A           H_DEF:    LD   A,(BC)   
01F0   03                     INC   BC   
01F1   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01F3   5F                     LD   E,A   ;   lands 64 bytes up
01F4   E6 DF                  AND   0DFh   ; fold case
01F6   FE 1A                  CP   26   
01F8   30 0B                  JR   NC,def2   ; not a letter
01FA   CB 23                  SLA   E   
01FC   16 0B                  LD   D,LETPAGE   ; DE -> cell
01FE   79                     LD   A,C   
01FF   12                     LD   (DE),A   
0200   1C                     INC   E   
0201   78                     LD   A,B   
0202   12                     LD   (DE),A   
0203   18 09                  JR   skipnx   
0205                DEF2:        
0205                          IF   CHECKED   
0205   7B                     LD   A,E   
0206   FE DF                  CP   " "-"A"+256   
0208   C2 A8 04               JP   NZ,e_brack   ; anything but a letter or a space
020B                          ENDIF      
020B   E5                     PUSH   HL   ; an anonymous block: push its address
020C   60                     LD   H,B   
020D   69                     LD   L,C   
020E                SKIPNX:      
020E                          IF   CHECKED   
020E   0B                     DEC   BC   ; back onto the letter, so that skip finds its
020F                          ENDIF      ;   opener, the "[", just before where it starts
020F   CD 4C 03     SKIPO:    CALL   skip   
0212   F7                     RST   30h   
0213   5E           H_FETCH:   LD   E,(HL)   ; "@"
0214   23                     INC   HL   
0215   56                     LD   D,(HL)   
0216   EB                     EX   DE,HL   
0217   F7                     RST   30h   
0218                             ; =============================================================================
0218                             ;  Handlers that must start in the image's second page.
0218                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0218                             ;  page.
0218                             ; =============================================================================
0218                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0218                             ; the matching ")".
0218   7C           H_OPEN:   LD   A,H   
0219   B5                     OR   L   
021A   E1                     POP   HL   
021B   28 F2                  JR   Z,skipo   
021D   C5                     PUSH   BC   ; the block starts at the IP
021E   18 9C                  JR   rpushn   
0220                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0220                             ; drops it and carries on.
0220   7C           H_CLOSE:   LD   A,H   
0221   B5                     OR   L   
0222   E1                     POP   HL   
0223   28 C8                  JR   Z,rdrop   
0225   CF                     RST   08h   ; pop the block start ...
0226   42                     LD   B,D   
0227   4B                     LD   C,E   
0228   C5                     PUSH   BC   
0229   18 91                  JR   rpushn   ; ... and push it back
022B                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022B                             ; "-" has two jobs: directly before a digit it starts a negative number.
022B   0A           H_SUB:    LD   A,(BC)   
022C   D6 30                  SUB   "0"   
022E   FE 0A                  CP   10   
0230   38 04                  JR   C,negnum   
0232   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0233   D1           H_ADD:    POP   DE   
0234   19                     ADD   HL,DE   
0235   F7                     RST   30h   
0236   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0237   CD 25 03               CALL   rdnum   
023A   E7                     RST   20h   
023B   F7                     RST   30h   
023C   D1           H_AND:    POP   DE   
023D   7C                     LD   A,H   
023E   A2                     AND   D   
023F   67                     LD   H,A   
0240   7D                     LD   A,L   
0241   A3                     AND   E   
0242   6F                     LD   L,A   
0243   F7                     RST   30h   
0244                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0244                             ; cells first. Flipping both sign bits turns a signed compare into an
0244                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0244                             ; carry into -1 or 0 with no branch.
0244   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0245   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0246   7C                     LD   A,H   
0247   EE 80                  XOR   80h   
0249   67                     LD   H,A   
024A   7A                     LD   A,D   
024B   EE 80                  XOR   80h   
024D   57                     LD   D,A   
024E   ED 52                  SBC   HL,DE   ; carry if HL < DE
0250   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0252   F7                     RST   30h   
0253   D1           H_EQ:     POP   DE   
0254   B7                     OR   A   
0255   ED 52                  SBC   HL,DE   
0257   7C                     LD   A,H   
0258   B5                     OR   L   
0259   FE 01                  CP   1   ; carry only if a - b = 0
025B   18 F3                  JR   tf   
025D                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
025D                             ; multiplier shifts up through A:C.
025D   D1           H_MUL:    POP   DE   ; DE = multiplicand
025E   C5                     PUSH   BC   
025F   7C                     LD   A,H   
0260   4D                     LD   C,L   ; A:C = multiplier
0261   21 00 00               LD   HL,0   
0264   06 10                  LD   B,16   
0266   29           MUL1:     ADD   HL,HL   
0267   CB 21                  SLA   C   
0269   17                     RLA      
026A   30 01                  JR   NC,mul2   
026C   19                     ADD   HL,DE   
026D   10 F7        MUL2:     DJNZ   mul1   
026F   C1                     POP   BC   
0270   F7                     RST   30h   
0271                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0271                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0271                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0271                             ; stops on it.
0271                H_DIV:       
0271                          IF   CHECKED   
0271   7C                     LD   A,H   
0272   B5                     OR   L   
0273   CA A5 04               JP   Z,e_zero   
0276                          ENDIF      
0276   D1                     POP   DE   ; DE = a, HL = b
0277   C5                     PUSH   BC   ; free BC for udiv
0278   D5                     PUSH   DE   ; a, for r's sign
0279   7A                     LD   A,D   
027A   AC                     XOR   H   
027B   F5                     PUSH   AF   ; S flag = sign of q
027C   CB 7C                  BIT   7,H   
027E   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0281   EB                     EX   DE,HL   
0282   CB 7C                  BIT   7,H   
0284   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0287   CD FF 02               CALL   udiv   ; HL = q, DE = r
028A   F1                     POP   AF   
028B   FC 20 01               CALL   M,neg16   ; q's sign
028E   EB                     EX   DE,HL   ; HL = r, DE = q
028F   F1                     POP   AF   ; A = a's high byte
0290   B7                     OR   A   
0291   FC 20 01               CALL   M,neg16   ; r's sign
0294   C1                     POP   BC   
0295   D5                     PUSH   DE   ; q under r
0296   F7                     RST   30h   
0297                             ; ---- stack and storage -----------------------------------------------------
0297   E5           H_DUP:    PUSH   HL   ; ":"
0298   F7                     RST   30h   
0299   E3           H_SWAP:   EX   (SP),HL   ; "%"
029A   F7                     RST   30h   
029B                             ; (The checked build tests the address before it takes the value off the
029B                             ; stack, so that an error report shows both.)
029B                H_CSTORE:      ; "." ( c addr -- )
029B                          IF   CHECKED   
029B   CD 2E 04               CALL   chkst   
029E                          ENDIF      
029E   D1                     POP   DE   
029F   73                     LD   (HL),E   
02A0   DF           H_DROP:   RST   18h   ; ";" is this one byte
02A1                H_STORE:      ; "!" ( n addr -- )
02A1                          IF   CHECKED   
02A1   CD 2E 04               CALL   chkst   
02A4                          ENDIF      
02A4   D1                     POP   DE   
02A5   73                     LD   (HL),E   
02A6   23                     INC   HL   
02A7   72                     LD   (HL),D   
02A8   DF                     RST   18h   
02A9                             ; ---- console ---------------------------------------------------------------
02A9                             ; 22h pushes the address of the text after it and skips the string.
02A9   E5           H_STR:    PUSH   HL   
02AA   60                     LD   H,B   
02AB   69                     LD   L,C   
02AC   CD 3B 03               CALL   skipstr   
02AF                          IF   CHECKED   
02AF   B7                     OR   A   ; 0: the text ran out before the closing quote
02B0   CA 9D 04               JP   Z,e_quote   
02B3                          ENDIF      
02B3   F7                     RST   30h   
02B4                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02B4                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02B4                             ; bit 6, so // and /" give themselves).
02B4                          IF   (1-CHECKED)*(1-EDITOR)   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
02B4                          ENDIF      
02B4                          IF   CHECKED   
02B4                             ; (The checked build has the loop as a routine, prstr, which the error
02B4                             ; report uses too. The address is kept on the stack meanwhile: a report
02B4                             ; shows the stack as it was before the "$".)
02B4   E5           H_PRINT:   PUSH   HL   
02B5   CD 70 05               CALL   prstr   
02B8   D1                     POP   DE   
02B9   DF                     RST   18h   
02BA                          ENDIF      
02BA                          IF   (1-CHECKED)*EDITOR   
                                 ; (With the editor the loop is a routine, prstr, which ^V uses too.)
                    H_PRINT:   CALL   prstr   
                              RST   18h   
02BA                          ENDIF      
02BA   7D           H_EMIT:   LD   A,L   ; "'"
02BB   EF                     RST   28h   
02BC   DF           PR9:      RST   18h   
02BD                             ; "#" prints TOS as a signed decimal number, with no space after it.
02BD   C5           H_NUM:    PUSH   BC   
02BE   CD 89 03               CALL   psgn   
02C1   C1                     POP   BC   
02C2   DF                     RST   18h   
02C3                             ; "?" ( n -- c ) or ( -n -- addr )
02C3                             ;   n > 0: wait about n ms for a key; 0 if none came
02C3                             ;   n = 0: wait for a key
02C3                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C3                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C3   CB 7C        H_KEY:    BIT   7,H   
02C5   20 19                  JR   NZ,line   
02C7   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02C9   CD 03 04     KT2:      CALL   getk   
02CC   20 0E                  JR   NZ,kt3   
02CE   1D                     DEC   E   
02CF   20 F8                  JR   NZ,kt2   
02D1   7C                     LD   A,H   ; 0? never counts down: it waits
02D2   B5                     OR   L   
02D3   28 F2                  JR   Z,kt1   
02D5   2B                     DEC   HL   
02D6   7C                     LD   A,H   
02D7   B5                     OR   L   
02D8   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02DA   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02DB   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02DC   6F           KT3:      LD   L,A   
02DD   26 00                  LD   H,0   
02DF   F7                     RST   30h   
02E0                          IF   CPM   
02E0                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02E0                             ; own line editor). It doesn't store the CR, so it is added here.
02E0   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E3   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02E4   9F                     SBC   A,A   
02E5   A5                     AND   L   ; (0 for a count that is too big)
02E6   EE 7F                  XOR   127   ; A = the count, 127 at most
02E8   32 7E 0B               LD   (LBHDR),A   
02EB   11 7E 0B               LD   DE,LBHDR   
02EE   3E 0A                  LD   A,10   
02F0   CD 21 04               CALL   bdosx   
02F3   21 7F 0B               LD   HL,LBHDR+1   
02F6   7E                     LD   A,(HL)   ; the count typed (0-127)
02F7   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
02F8   85                     ADD   A,L   ;   adding the count to L can't carry
02F9   6F                     LD   L,A   
02FA   36 0D                  LD   (HL),13   
02FC                          ENDIF      
02FC                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
                                 ;   at most
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
02FC                          ENDIF      
02FC   2E 80                  LD   L,LINEBUF & 0FFh   
02FE   F7                     RST   30h   
02FF                             ; =============================================================================
02FF                             ;  More routines (no handler starts past this point)
02FF                             ; =============================================================================
02FF                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
02FF                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
02FF                             ; while the quotient bits arrive at the bottom of C.
02FF                             ; Dividing by 2 is one shift (the spec wants that fast).
02FF   7B           UDIV:     LD   A,E   
0300   EE 02                  XOR   2   
0302   B2                     OR   D   
0303   20 07                  JR   NZ,udv0   
0305   CB 3C                  SRL   H   
0307   CB 1D                  RR   L   ; the quotient
0309   8F                     ADC   A,A   
030A   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
030B   C9                     RET      
030C   7C           UDV0:     LD   A,H   
030D   4D                     LD   C,L   
030E   21 00 00               LD   HL,0   
0311   06 10                  LD   B,16   
0313   CB 21        UDV1:     SLA   C   
0315   17                     RLA      
0316   ED 6A                  ADC   HL,HL   
0318   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
031A   30 02                  JR   NC,udv2   ;   always fits in 16 bits
031C   19                     ADD   HL,DE   ; too much: put it back, and cancel the
031D   0D                     DEC   C   ;   INC below
031E   0C           UDV2:     INC   C   ; a quotient bit
031F   10 F2                  DJNZ   udv1   
0321   EB                     EX   DE,HL   ; DE = remainder
0322   67                     LD   H,A   
0323   69                     LD   L,C   ; HL = quotient
0324   C9                     RET      
0325                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0325                             ; non-digit. Values wrap at 16 bits, as the spec says.
0325   21 00 00     RDNUM:    LD   HL,0   
0328   0A           RDN1:     LD   A,(BC)   
0329   D6 30                  SUB   "0"   
032B   FE 0A                  CP   10   
032D   D0                     RET   NC   
032E   03                     INC   BC   
032F   54                     LD   D,H   
0330   5D                     LD   E,L   
0331   29                     ADD   HL,HL   
0332   29                     ADD   HL,HL   
0333   19                     ADD   HL,DE   
0334   29                     ADD   HL,HL   ; HL * 10
0335   5F                     LD   E,A   
0336   16 00                  LD   D,0   
0338   19                     ADD   HL,DE   
0339   18 ED                  JR   rdn1   
033B                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
033B                             ; the next character, so "/"" does not end it. Leaves A = 22h.
033B                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
033B                          ENDIF      
033B                          IF   CHECKED   
033B                             ; The checked build never steps over a NUL: if the text runs out first it
033B                             ; returns A = 0 with the IP on the NUL.
033B   0A           SKIPSTR:   LD   A,(BC)   
033C   B7                     OR   A   
033D   C8                     RET   Z   
033E   03                     INC   BC   
033F   FE 22                  CP   22h   
0341   C8                     RET   Z   
0342   FE 2F                  CP   "/"   
0344   20 F5                  JR   NZ,skipstr   
0346   0A                     LD   A,(BC)   ; the escaped character
0347   B7                     OR   A   
0348   C8                     RET   Z   
0349   03                     INC   BC   
034A   18 EF                  JR   skipstr   
034C                          ENDIF      
034C                             ; skip: read past text to the closer at this level, and return A = 0 if it
034C                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
034C                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
034C                             ; no closer; anything else that runs into the NUL had unbalanced brackets
034C                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
034C                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
034C                             ; 
034C                             ; The checked build also looks at the character the skip was started by,
034C                             ; which is always the one just before where it starts: "(" must end at ")",
034C                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
034C                             ; quote counts as running into it. "\" takes either closer. IX keeps the
034C                             ; place where the skip started, for the report.
034C                SKIP:        
034C                          IF   CHECKED   
034C   C5                     PUSH   BC   
034D   DD E1                  POP   IX   
034F   0B                     DEC   BC   
0350   0A                     LD   A,(BC)   
0351   03                     INC   BC   
0352   5F                     LD   E,A   ; E = the opener: ( [ or \
0353                          ENDIF      
0353   16 00                  LD   D,0   
0355   14           SK3:      INC   D   ; an opener: one deeper
0356   0A           SK1:      LD   A,(BC)   
0357                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0357                          ENDIF      
0357                          IF   CHECKED   
0357   B7                     OR   A   
0358   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
035A   03                     INC   BC   
035B                          ENDIF      
035B   FE 22                  CP   22h   
035D   CC 3B 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0360   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0362   28 F1                  JR   Z,sk3   
0364   3D                     DEC   A   ; ")"
0365   28 08                  JR   Z,sk4   
0367   D6 32                  SUB   "["-")"   
0369   28 EA                  JR   Z,sk3   
036B   FE 02                  CP   "]"-"["   
036D   20 E7                  JR   NZ,sk1   
036F   15           SK4:      DEC   D   
0370                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0370                          ENDIF      
0370                          IF   CHECKED   
0370   20 E4                  JR   NZ,sk1   
0372   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0373   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0374   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0376   FE 02                  CP   2   ;   closer, and only then
0378   7A                     LD   A,D   
0379   C0                     RET   NZ   
037A   18 05                  JR   sk7   
037C   CB 53        SK6:      BIT   2,E   ; the text ran out:
037E   C2 D3 05               JP   NZ,SKEND   ;   "\" with no closer ends the program
0381   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0383   C1                     POP   BC   
0384   3E 4E                  LD   A,"N"   
0386   C3 9A 04               JP   errp   ; (errp drops skip's return address)
0389                          ENDIF      
0389                             ; psgn: print HL as a signed number. Uses BC.
0389   CB 7C        PSGN:     BIT   7,H   
038B   28 04                  JR   Z,pdec   
038D   3E 2D                  LD   A,"-"   
038F   EF                     RST   28h   
0390   E7                     RST   20h   
0391                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0391                             ; Uses BC.
0391   11 0A 00     PDEC:     LD   DE,10   
0394   CD FF 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0397   7B                     LD   A,E   
0398   F5                     PUSH   AF   
0399   7C                     LD   A,H   
039A   B5                     OR   L   
039B   C4 91 03               CALL   NZ,pdec   
039E   F1                     POP   AF   
039F   C6 30                  ADD   A,"0"   
03A1   EF                     RST   28h   
03A2   C9                     RET      
03A3                             ; =============================================================================
03A3                             ;  Dispatch table: the low byte of each handler's address, in code order
03A3                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03A3                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03A3                             ; =============================================================================
03A3                             ; The handlers of the first NPG1 characters start in the image's second page.
03A3                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03A3                             ; differs between the builds, so the count is worked out here.
03A3                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03A3                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03A3                PGBRK:    EQU   (h_break-BASE)/256   
03A3                PGDEF:    EQU   (h_def-BASE)/256   
03A3                PGFET:    EQU   (h_fetch-BASE)/256   
03A3                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03A3                          IF   1-TABP0   
03A3                PTAB:        
03A3                          ;*Macro unroll:  PTABLE
03A3   A1                     DB   h_store & 0FFh   
03A4   A9                     DB   h_str & 0FFh   
03A5   BD                     DB   h_num & 0FFh   
03A6   B4                     DB   h_print & 0FFh   
03A7   99                     DB   h_swap & 0FFh   
03A8   3C                     DB   h_and & 0FFh   
03A9   BA                     DB   h_emit & 0FFh   
03AA   18                     DB   h_open & 0FFh   
03AB   20                     DB   h_close & 0FFh   
03AC   5D                     DB   h_mul & 0FFh   
03AD   33                     DB   h_add & 0FFh   
03AE   DB                     DB   h_cfetch & 0FFh   
03AF   2B                     DB   h_sub & 0FFh   
03B0   9B                     DB   h_cstore & 0FFh   
03B1   71                     DB   h_div & 0FFh   
03B2   97                     DB   h_dup & 0FFh   
03B3   A0                     DB   h_drop & 0FFh   
03B4   44                     DB   h_lt & 0FFh   
03B5   53                     DB   h_eq & 0FFh   
03B6   45                     DB   h_gt & 0FFh   
03B7   C3                     DB   h_key & 0FFh   
03B8   13                     DB   h_fetch & 0FFh   
03B9   EF                     DB   h_def & 0FFh   
03BA   E2                     DB   h_break & 0FFh   
03BB   DE                     DB   h_ret & 0FFh   
03BC   76                     DB   h_xor & 0FFh   
03BD   89                     DB   h_alloc & 0FFh   
03BE   C8                     DB   h_grave & 0FFh   
03BF   2C                     DB   h_tor & 0FFh   
03C0   7E                     DB   h_or & 0FFh   
03C1   1C                     DB   h_fromr & 0FFh   
03C2   86                     DB   h_not & 0FFh   
03C3                PTABEND:      
03C3                          ENDIF      
03C3                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03C3                             ; and return its value in A with the carry set; otherwise leave the IP and
03C3                             ; return with the carry clear.
03C3   0A           HEXC:     LD   A,(BC)   
03C4   D6 30                  SUB   "0"   
03C6   FE 0A                  CP   10   
03C8   38 09                  JR   C,hc1   
03CA   E6 DF                  AND   0DFh   
03CC   D6 11                  SUB   11h   
03CE   FE 06                  CP   6   
03D0   D0                     RET   NC   
03D1   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03D3   03           HC1:      INC   BC   
03D4   C9                     RET      
03D5                             ; =============================================================================
03D5                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
03D5                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
03D5                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
03D5                             ;  they are the host's KEY and CONOUT routines themselves.
03D5                             ; 
03D5                             ;  A running program reads the keyboard only through getk and pollk, which
03D5                             ;  between them give the break key its rules:
03D5                             ;    - Ctrl-C stops the program;
03D5                             ;    - any other key that the break check reads is held in KEYBUF for the
03D5                             ;      next "?", and a newer one takes its place;
03D5                             ;    - "?" (getk) takes the held key first;
03D5                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
03D5                             ;      key like any other, but two of them within about 250 ms still stop it.
03D5                             ;  Both are called straight from a handler, never from a routine under one:
03D5                             ;  the checked build's report counts on finding one return address above the
03D5                             ;  data stack.
03D5                             ; =============================================================================
03D5                          IFN   CPM   
                    RAWK:     EQU   KEY   
03D5                          ENDIF      
03D5                             ; pollk: the break check (see rpushn).
03D5   CD 13 04     POLLK:    CALL   rawk   
03D8   C8                     RET   Z   ; no key
03D9   32 7A 0B               LD   (KEYBUF),A   ; held for the next "?"
03DC   FE 03        PK1:      CP   3   ; (getk joins here)
03DE   C0                     RET   NZ   
03DF                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
03DF                             ; the program has turned it off, wait about 250 ms for one more key: a
03DF                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
03DF                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
03DF   3A 7B 0B     CTLC:     LD   A,(BRKOFF)   
03E2   B7                     OR   A   
03E3   CA 92 04     CT0:      JP   Z,brk   
03E6   D5                     PUSH   DE   
03E7   11 10 27               LD   DE,250*MSLOOP   
03EA   CD 13 04     CT1:      CALL   rawk   
03ED   20 05                  JR   NZ,ct2   
03EF   1B                     DEC   DE   
03F0   7A                     LD   A,D   
03F1   B3                     OR   E   
03F2   20 F6                  JR   NZ,ct1   
03F4   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
03F5   FE 03                  CP   3   
03F7   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
03F9   B7                     OR   A   
03FA   28 03                  JR   Z,ct3   
03FC   32 7A 0B               LD   (KEYBUF),A   
03FF   3E 03        CT3:      LD   A,3   
0401   B7                     OR   A   
0402   C9                     RET      
0403                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0403   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0404   21 7A 0B               LD   HL,KEYBUF   ;   the buffer
0407   7E                     LD   A,(HL)   
0408   36 00                  LD   (HL),0   
040A   E1                     POP   HL   
040B   B7                     OR   A   
040C   C0                     RET   NZ   
040D   CD 13 04               CALL   rawk   
0410   C8                     RET   Z   
0411   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0413                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0413                          ENDIF      ;   (with the editor, both stacks are cleared);
0413                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0413                          ENDIF      
0413                          IF   CHECKED   
0413                BRK:      EQU   e_break   ;   the checked build reports B
0413                          ENDIF      
0413                          IF   CPM   
0413   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0415                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0415                             ; printing and could swallow a key that BDOS 6 then never sees.
0415   D5           PUTC:     PUSH   DE   
0416   E5                     PUSH   HL   
0417   5F                     LD   E,A   
0418   3E 06                  LD   A,6   
041A   CD 21 04               CALL   bdosx   
041D   E1                     POP   HL   
041E   D1                     POP   DE   
041F   B7                     OR   A   ; (for getk)
0420   C9                     RET      
0421                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
0421   C5           BDOSX:    PUSH   BC   
0422   D9                     EXX      
0423   E5                     PUSH   HL   
0424   D9                     EXX      
0425   4F                     LD   C,A   
0426   CD 05 00               CALL   BDOS   
0429   D9                     EXX      
042A   E1                     POP   HL   
042B   D9                     EXX      
042C   C1                     POP   BC   
042D   C9                     RET      
042E                          ENDIF      
042E                             ; =============================================================================
042E                             ;  Checked build: the checks and the error report
042E                             ; =============================================================================
042E                          IF   CHECKED   
042E                             ; chkst: stop unless HL is in the program's own space: from the letter page
042E                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
042E                             ; whatever lies above the limit are safe. Memory above the heap top but
042E                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
042E                             ; It is the page of HL + 1 that is tested, so that one test serves both
042E                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
042E                             ; Keeps HL and BC.
042E   23           CHKST:    INC   HL   
042F   7C                     LD   A,H   
0430   2B                     DEC   HL   
0431   FE 0B                  CP   LETPAGE   
0433   38 07                  JR   C,chs1   
0435                          ENDIF      
0435                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0435                          ENDIF      
0435                          IF   CHECKED*CPM   
0435   5F                     LD   E,A   
0436   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0439   3D                     DEC   A   
043A   BB                     CP   E   
043B   D0                     RET   NC   
043C                          ENDIF      
043C                          IF   CHECKED   
043C   C3 98 04     CHS1:     JP   e_store   
043F                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
043F                             ; the count. Stop if the top is not below the limit page, or is below the
043F                             ; program's end.
043F                CHKHP:       
043F                          ENDIF      
043F                          IF   CHECKED*CPM   
043F                             ; With this much room a top that wrapped round can land back in
043F                             ; range, so the add is tested too: growing (A, the count's high
043F                             ; byte, is positive) must not carry, and releasing must.
043F   1F                     RRA      ; the carry comes in above the sign:
0440   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
0442   87                     ADD   A,A   
0443   38 10                  JR   C,e_heap   
0445   3A 07 00               LD   A,(0007h)   
0448   3D                     DEC   A   
0449   BC                     CP   H   
044A   38 09                  JR   C,e_heap   
044C                          ENDIF      
044C                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
044C                          ENDIF      
044C                          IF   CHECKED   
044C   D5                     PUSH   DE   
044D   EB                     EX   DE,HL   
044E   2A 38 0B               LD   HL,(NPEND)   
0451   19                     ADD   HL,DE   ; carry: at or above the program's end
0452   EB                     EX   DE,HL   
0453   D1                     POP   DE   
0454   D8                     RET   C   
0455   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0456   ED 52                  SBC   HL,DE   
0458   C3 95 04               JP   e_heap1   
045B                             ; chkstk: both stacks are checked once per character, not in every handler.
045B                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
045B                             ; the constant carries if it is above (cells were popped that were never
045B                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
045B                             ; a character late at most: the bytes above DSTOP and the guard band below
045B                             ; the page take what happens meanwhile. DE is free between characters.
045B   EB           CHKSTK:   EX   DE,HL   
045C   21 05 F5               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
045F   39                     ADD   HL,SP   
0460   EB                     EX   DE,HL   
0461   38 1E                  JR   C,e_under   
0463   14                     INC   D   
0464   20 17                  JR   NZ,e_over   
0466   D9                     EXX      ; the return stack: in its page (or it has
0467   7C                     LD   A,H   ;   overflowed), and not above its empty
0468   FE 09                  CP   RSPAGE   ;   position (an underflow stays inside the
046A   7D                     LD   A,L   ;   page, in the guard band)
046B   D9                     EXX      
046C   20 0C                  JR   NZ,e_rover   
046E   FE E1                  CP   RSTOP&0FFh+1   
0470   D8                     RET   C   
0471   D9                     EXX      ; return stack underflow: it counts as empty
0472   21 E0 09               LD   HL,RSTOP   
0475   D9                     EXX      
0476   3E 72                  LD   A,"r"   
0478   18 20                  JR   errp   
047A   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
047C   11                     DB   11h   ; (LD DE,nn hides the next entry)
047D   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
047F   18 19                  JR   errp   
0481   31 FC 0A     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0484   3E 73                  LD   A,"s"   
0486   18 22                  JR   error   
0488                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0488                             ; was never defined still holds 0000h, and the byte there is a reserved one
0488                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0488                             ; an undefined word. The call is undone, so the place is the call itself.
0488   04           E_HI:     INC   B   
0489   10 17                  DJNZ   e_resv   ; (B is as it was, and is not 0)
048B   CF                     RST   08h   
048C   42                     LD   B,D   
048D   4B                     LD   C,E   
048E   3E 55                  LD   A,"U"   
0490   18 18                  JR   error   
0492                             ; Error entries. Each loads its letter and then hides the next entry inside
0492                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0492   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0494   11                     DB   11h   
0495   3E 48        E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
0497   11                     DB   11h   
0498   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
049A                             ; errp: an error found inside a routine: drop its return address first.
049A   D1           ERRP:     POP   DE   
049B   18 0D                  JR   error   
049D   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
049E   4D                     LD   C,L   ;   past the opening quote, which is the place
049F   3E 51                  LD   A,"Q"   
04A1   11                     DB   11h   
04A2   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
04A4   11                     DB   11h   
04A5   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
04A7   11                     DB   11h   
04A8   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
04AA                             ; error: the report, then the end. A = the letter, BC = one past the place,
04AA                             ; HL = TOS, and both stacks as the report is to show them:
04AA                             ; 
04AA                             ;   Err X @ line,col
04AA                             ;   up to 16 characters of the text from the place
04AA                             ;   Stk n: the top 8 cells at most, bottom to top
04AA                             ;   Rtn n
04AA   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
04AB   5F                     LD   E,A   
04AC   CD 83 05               CALL   pnl   
04AF   45 72 72 20 22         DB   "Err ",22h   
04B4   7B                     LD   A,E   
04B5   EF                     RST   28h   
04B6   CD 89 05               CALL   pmsg   
04B9   20 40 20 22            DB   " @ ",22h   
04BD   0B                     DEC   BC   ; BC = the place
04BE                             ; The line and column. A place below the program is in the line
04BE                             ; buffer: line 0. Otherwise count the LFs from the program's start;
04BE                             ; DE = the line's number, HL = where it starts.
04BE   21 80 0B               LD   HL,LINEBUF   
04C1   11 00 00               LD   DE,0   
04C4   78                     LD   A,B   
04C5   FE 0C                  CP   PROG/256   
04C7   38 14                  JR   C,er3   
04C9   24                     INC   H   
04CA   6B                     LD   L,E   ; HL = PROG
04CB   13           ER1:      INC   DE   ; a new line starts at HL
04CC   E5                     PUSH   HL   
04CD   7D           ER2:      LD   A,L   
04CE   91                     SUB   C   
04CF   7C                     LD   A,H   
04D0   98                     SBC   A,B   
04D1   30 09                  JR   NC,er2x   ; reached the place
04D3   7E                     LD   A,(HL)   
04D4   23                     INC   HL   
04D5   FE 0A                  CP   10   
04D7   20 F4                  JR   NZ,er2   
04D9   F1                     POP   AF   
04DA   18 EF                  JR   er1   
04DC   E1           ER2X:     POP   HL   
04DD   C5           ER3:      PUSH   BC   
04DE   E5                     PUSH   HL   
04DF   EB                     EX   DE,HL   
04E0   CD 91 03               CALL   pdec   ; the line
04E3   3E 2C                  LD   A,","   
04E5   EF                     RST   28h   
04E6   D1                     POP   DE   
04E7   E1                     POP   HL   
04E8   E5                     PUSH   HL   
04E9   B7                     OR   A   
04EA   ED 52                  SBC   HL,DE   
04EC   23                     INC   HL   
04ED   CD 91 03               CALL   pdec   ; the column
04F0   CD 83 05               CALL   pnl   
04F3   22                     DB   22h   
04F4   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
04F5   06 10                  LD   B,16   ;   if the line or the program ends first
04F7   7E           ER4:      LD   A,(HL)   
04F8   23                     INC   HL   
04F9   B7                     OR   A   
04FA   28 0F                  JR   Z,er5   
04FC   FE 0D                  CP   13   
04FE   28 0B                  JR   Z,er5   
0500   FE 0A                  CP   10   
0502   28 07                  JR   Z,er5   
0504                          ENDIF      
0504                          IF   CHECKED*CPM   
0504   FE 1A                  CP   1Ah   ; (the ^Z that pads a file's last record ends
0506   28 03                  JR   Z,er5   ;   the text too: some terminals clear the
0508                          ENDIF      ;   screen on it)
0508                          IF   CHECKED   
0508   EF                     RST   28h   
0509   10 EC                  DJNZ   er4   
050B                ER5:         ; (without the editor: on into pstk)
050B                          ENDIF      
050B                          IF   CHECKED*EDITOR   
050B   CD 15 05               CALL   pstk   
050E   CD 83 05               CALL   pnl   
0511   22                     DB   22h   
0512   C3 CF 05               JP   edit0   ; back to the editor, with both stacks cleared
0515                          ENDIF      
0515                             ; =============================================================================
0515                             ;  Routines that the checked build's report and the editor share
0515                             ; =============================================================================
0515                SPADJ:    EQU   2*EDITOR   ; (with the editor pstk is called, not fallen
0515                             ;   into: the stack is one address deeper)
0515                          IF   CHECKED+EDITOR   
0515                             ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
0515                             ;                             Rtn n
0515                             ; TOS must be in memory with the rest (pushed). In a build without the
0515                             ; editor this is the end of `error`, which runs on into it.
0515   CD 83 05     PSTK:     CALL   pnl   
0518   53 74 6B 20 22         DB   "Stk ",22h   
051D   21 F8 0A               LD   HL,DSTOP-2-SPADJ   ; (the cell at DSTOP-2 was pushed with the
0520   B7                     OR   A   ;   first value and holds nothing)
0521   ED 72                  SBC   HL,SP   
0523   CD 66 05               CALL   phalf   ; the depth
0526   3E 3A                  LD   A,":"   
0528   EF                     RST   28h   
0529   79                     LD   A,C   
052A   FE 09                  CP   9   
052C   38 0A                  JR   C,er6   
052E   CD 89 05               CALL   pmsg   
0531   20 2E 2E 2E 22         DB   " ...",22h   
0536   0E 08                  LD   C,8   
0538   26 00        ER6:      LD   H,0   ; C = the number of cells to show
053A   69                     LD   L,C   
053B   29                     ADD   HL,HL   
053C   39                     ADD   HL,SP   ; HL -> just above the deepest of them
053D                          ENDIF      
053D                          IF   EDITOR   
053D   23                     INC   HL   
053E   23                     INC   HL   
053F                          ENDIF      
053F                          IF   CHECKED+EDITOR   
053F   0C                     INC   C   
0540   0D           ER7:      DEC   C   
0541   28 11                  JR   Z,er8   
0543   2B                     DEC   HL   
0544   56                     LD   D,(HL)   
0545   2B                     DEC   HL   
0546   5E                     LD   E,(HL)   
0547   E5                     PUSH   HL   
0548   C5                     PUSH   BC   
0549   3E 20                  LD   A," "   
054B   EF                     RST   28h   
054C   EB                     EX   DE,HL   
054D   CD 89 03               CALL   psgn   
0550   C1                     POP   BC   
0551   E1                     POP   HL   
0552   18 EC                  JR   er7   
0554   CD 83 05     ER8:      CALL   pnl   
0557   52 74 6E 20 22         DB   "Rtn ",22h   
055C   D9                     EXX      
055D   E5                     PUSH   HL   
055E   D9                     EXX      
055F   D1                     POP   DE   
0560   21 E0 09               LD   HL,RSTOP   
0563   B7                     OR   A   
0564   ED 52                  SBC   HL,DE   
0566                          ENDIF      
0566                          IF   CHECKED*(1-EDITOR)   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
0566                          ENDIF      
0566                          IF   CHECKED+EDITOR   
0566                             ; phalf: print half of HL, and leave it in C. (With the editor, pstk ends by
0566                             ; running on into this.)
0566   CB 3C        PHALF:    SRL   H   
0568   CB 1D                  RR   L   
056A   E5                     PUSH   HL   
056B   CD 91 03               CALL   pdec   
056E   C1                     POP   BC   
056F   C9                     RET      
0570                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0570                             ; "$", and the texts of the report and the editor). In the checked build a
0570                             ; NUL first is an error: Q.
0570   7E           PRSTR:    LD   A,(HL)   
0571   23                     INC   HL   
0572   FE 22                  CP   22h   
0574   C8                     RET   Z   
0575                          ENDIF      
0575                          IF   CHECKED   
0575   B7                     OR   A   
0576   28 17                  JR   Z,e_dollar   
0578                          ENDIF      
0578                          IF   CHECKED+EDITOR   
0578   FE 2F                  CP   "/"   
057A   20 04                  JR   NZ,prs1   
057C   7E                     LD   A,(HL)   
057D   23                     INC   HL   
057E   E6 BF                  AND   0BFh   
0580   EF           PRS1:     RST   28h   
0581   18 ED                  JR   prstr   
0583                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0583                             ; pnl: the same, on a new line.
0583   3E 0D        PNL:      LD   A,13   
0585   EF                     RST   28h   
0586   3E 0A                  LD   A,10   
0588   EF                     RST   28h   
0589   E3           PMSG:     EX   (SP),HL   
058A   CD 70 05               CALL   prstr   
058D   E3                     EX   (SP),HL   
058E   C9                     RET      
058F                          ENDIF      
058F                          IF   CHECKED   
058F   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
0590   E1                     POP   HL   ;   and put the string's address back in TOS
0591   3E 51                  LD   A,"Q"   
0593   C3 AA 04               JP   error   
0596                          ENDIF      
0596                             ; =============================================================================
0596                             ;  The line editor (EDITOR = 1)
0596                             ; 
0596                             ;  The interpreter starts here, and a program that ends comes back here.
0596                             ;  There is no prompt. It follows the spec's suggested standard for a line
0596                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0596                             ; 
0596                             ;    n text    put the text in as line n; the lines from n on move down. A
0596                             ;              number past the end (or 0) adds the line at the end.
0596                             ;    n         take line n out
0596                             ;    anything else is run at once, as B8Script. (Start such a line with a
0596                             ;    space if it would begin with a digit.)
0596                             ; 
0596                             ;  A command key ends the line too, and takes what was typed as its argument:
0596                             ; 
0596                             ;    ^G        run the program
0596                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0596                             ;              list until another key is pressed; Ctrl-C ends it.
0596                             ;    n ^E      put line n in the input line; Return puts it back, changed
0596                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0596                             ;              last time). Generic: what is typed, or pasted, from now until
0596                             ;              ^Z replaces the program; it is not echoed.
0596                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0596                             ;              time). Generic: the text is printed, as it is.
0596                             ;    ^N ^N     new: no program (the key twice in a row)
0596                             ;    ^V        view: the build, both stacks, and the program's size, lines
0596                             ;              and free memory
0596                             ;    ^X        leave (to LEAVE)
0596                             ; 
0596                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
0596                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0596                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0596                             ;  sent to the terminal, so any terminal will do.
0596                             ; 
0596                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0596                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0596                             ;  125 characters; the one character after a line number separates it from
0596                             ;  the text and is not stored. The text is kept as it is typed, each line
0596                             ;  ending in CR LF, at PROG.
0596                             ; 
0596                             ;  What lasts from one line to the next: the program, the words, the
0596                             ;  variables and the data stack. An error or a break clears both stacks. The
0596                             ;  return stack starts empty for every line.
0596                             ; 
0596                             ;  Things to know:
0596                             ;    - Reset empties the program (generic builds).
0596                             ;    - A word's address points into the program, so run the program again
0596                             ;      after editing it.
0596                             ;    - Nothing is printed between a program's output and what is typed next.
0596                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0596                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0596                             ;      (The stored program never comes back to the line, so it may.)
0596                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0596                             ;      read of the other builds (BDOS 10 under CP/M).
0596                             ; 
0596                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0596                             ;  the last line left there, with TOS pushed like the rest.
0596                             ; =============================================================================
0596                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
0596                          ENDIF      
0596                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0596                          ENDIF      
0596                          IF   EDGEN   
                              JR   edit0   
0596                          ENDIF      
0596                          IF   EDITOR   
0596                             ; ^B, left arrow: the cursor goes one to the left
0596   7D           LEFT:     LD   A,L   
0597   87                     ADD   A,A   
0598   28 4D                  JR   Z,ed1   ; (L = 80h: at the start)
059A   2D                     DEC   L   
059B   3E 08                  LD   A,8   
059D   EF           LF1:      RST   28h   
059E   18 47                  JR   ed1   
05A0                             ; ^F, right arrow: one to the right, by printing the character there
05A0   7D           RIGHT:    LD   A,L   
05A1   BB                     CP   E   
05A2   28 43                  JR   Z,ed1   ; at the end
05A4   7E                     LD   A,(HL)   
05A5   2C                     INC   L   
05A6   18 F5                  JR   lf1   
05A8                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
05A8                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
05A8                             ; ends the sequence, and act on C (right) and D (left).
05A8   01 C8 00     ESC:      LD   BC,5*MSLOOP   
05AB   CD 13 04     ES1:      CALL   rawk   
05AE   20 0A                  JR   NZ,es2   
05B0   0B                     DEC   BC   
05B1   78                     LD   A,B   
05B2   B1                     OR   C   
05B3   20 F6                  JR   NZ,es1   
05B5   CD 1C 06               CALL   fin   ; no second key: the line is dropped
05B8   18 1B                  JR   edit   
05BA   FE 5B        ES2:      CP   "["   
05BC   20 29                  JR   NZ,ed1   ; not a sequence known here
05BE   CD 75 06     ES3:      CALL   ekey   
05C1   FE 40                  CP   40h   
05C3   38 F9                  JR   C,es3   ; (its parameters)
05C5   FE 43                  CP   "C"   
05C7   28 D7                  JR   Z,right   
05C9   FE 44                  CP   "D"   
05CB   28 C9                  JR   Z,left   
05CD   18 18                  JR   ed1   
05CF                             ; edit0: reset, an error or a break: both stacks are cleared.
05CF                             ; skend: a program that ended inside skip: its return address goes.
05CF                             ; edend: a program that ended: TOS joins the rest of the data stack.
05CF   31 FA 0A     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
05D2   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
05D3   D1           SKEND:    POP   DE   
05D4   E5           EDEND:    PUSH   HL   
05D5                             ; edit: start a new input line.
05D5   D9           EDIT:     EXX      
05D6   21 E0 09               LD   HL,RSTOP   ; the return stack is empty
05D9   D9                     EXX      
05DA   21 00 00               LD   HL,0   
05DD   22 7A 0B               LD   (KEYBUF),HL   ; no key is held, and the break key is on
05E0   22 3A 0B               LD   (EDLN),HL   ; no line is being edited
05E3   21 80 0B               LD   HL,LINEBUF   ; HL = the cursor,
05E6   5D                     LD   E,L   ;   E = the end of the line (its low byte)
05E7   CD 75 06     ED1:      CALL   ekey   
05EA   FE 7F                  CP   7Fh   
05EC   28 40                  JR   Z,bsp   ; DEL
05EE   FE 20                  CP   " "   
05F0   30 56                  JR   NC,insc   
05F2   FE 09                  CP   9   
05F4   28 52                  JR   Z,insc   ; Tab is text
05F6   FE 08                  CP   8   
05F8   28 34                  JR   Z,bsp   
05FA   FE 02                  CP   2   
05FC   28 98                  JR   Z,left   ; ^B
05FE   FE 06                  CP   6   
0600   28 9E                  JR   Z,right   ; ^F
0602   FE 1B                  CP   1Bh   
0604   28 A2                  JR   Z,esc   
0606   E5                     PUSH   HL   ; a command key? Look it up
0607   21 7B 06               LD   HL,cmds   
060A   06 09                  LD   B,NCMD   
060C   BE           ED2:      CP   (HL)   
060D   23                     INC   HL   
060E   28 07                  JR   Z,ed3   
0610   23                     INC   HL   
0611   23                     INC   HL   
0612   10 F8                  DJNZ   ed2   
0614   E1                     POP   HL   
0615   18 D0                  JR   ed1   ; no: the key is ignored
0617   7E           ED3:      LD   A,(HL)   
0618   23                     INC   HL   
0619   66                     LD   H,(HL)   
061A   6F                     LD   L,A   
061B   E3                     EX   (SP),HL   ; the command's address: fin returns to it
061C                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
061C                             ; terminal. Leaves BC -> the line and HL -> the NUL.
061C   26 0B        FIN:      LD   H,LETPAGE   
061E   6B                     LD   L,E   
061F   36 0D                  LD   (HL),13   
0621   2C                     INC   L   
0622   36 0A                  LD   (HL),10   
0624   2D                     DEC   L   
0625   CD F7 07               CALL   prl   ; (prints the CR LF)
0628   36 00                  LD   (HL),0   
062A   01 80 0B               LD   BC,LINEBUF   
062D   C9                     RET      
062E                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
062E                             ; left, the rest of the line moves down over it, and the last place (now a
062E                             ; space) is printed over along with the rest.
062E   7D           BSP:      LD   A,L   
062F   87                     ADD   A,A   
0630   28 B5                  JR   Z,ed1   ; at the start
0632   2D                     DEC   L   
0633   3E 08                  LD   A,8   
0635   EF                     RST   28h   
0636   E5                     PUSH   HL   
0637   2C           BS1:      INC   L   
0638   7E                     LD   A,(HL)   
0639   2D                     DEC   L   
063A   77                     LD   (HL),A   
063B   2C                     INC   L   
063C   7D                     LD   A,L   
063D   BB                     CP   E   
063E   20 F7                  JR   NZ,bs1   
0640   2D                     DEC   L   
0641   36 20                  LD   (HL)," "   
0643   E1                     POP   HL   
0644   53                     LD   D,E   
0645   1D                     DEC   E   
0646   18 15                  JR   ic2   
0648                             ; A character goes in at the cursor: it ripples up through the rest of the
0648                             ; line, the cursor moves on, and the rest is printed again.
0648   47           INSC:     LD   B,A   
0649   7B                     LD   A,E   
064A   FE FD                  CP   0FDh   
064C   28 99                  JR   Z,ed1   ; the line is full: 125 characters
064E   78                     LD   A,B   
064F   EF                     RST   28h   
0650   E5                     PUSH   HL   
0651   7E           IC1:      LD   A,(HL)   
0652   70                     LD   (HL),B   
0653   47                     LD   B,A   
0654   7D                     LD   A,L   
0655   2C                     INC   L   
0656   BB                     CP   E   
0657   20 F8                  JR   NZ,ic1   
0659   E1                     POP   HL   
065A   2C                     INC   L   
065B   1C                     INC   E   
065C   53                     LD   D,E   
065D   CD 62 06     IC2:      CALL   tail   
0660   18 85                  JR   ed1   
0662                             ; tail: print the line from the cursor to D (a low byte), and bring the
0662                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0662   4D           TAIL:     LD   C,L   
0663   7D           TA1:      LD   A,L   
0664   BA                     CP   D   
0665   28 05                  JR   Z,ta2   
0667   7E                     LD   A,(HL)   
0668   EF                     RST   28h   
0669   2C                     INC   L   
066A   18 F7                  JR   ta1   
066C   7D           TA2:      LD   A,L   
066D   B9                     CP   C   
066E   C8                     RET   Z   
066F   3E 08                  LD   A,8   
0671   EF                     RST   28h   
0672   2D                     DEC   L   
0673   18 F7                  JR   ta2   
0675                             ; ekey: wait for a key
0675   CD 13 04     EKEY:     CALL   rawk   
0678   28 FB                  JR   Z,ekey   
067A   C9                     RET      
067B                             ; The command keys, and where each goes (after fin).
067B   0D           CMDS:     DB   13   
067C   D5 06                  DW   cret   
067E   07                     DB   7   ; ^G
067F   1D 07                  DW   crun   
0681   0C                     DB   12   ; ^L
0682   33 07                  DW   clist   
0684   05                     DB   5   ; ^E
0685   A4 06                  DW   cedln   
0687   12                     DB   18   ; ^R
0688   00 08                  DW   cread   
068A   17                     DB   23   ; ^W
068B   09 08                  DW   cwrite   
068D   0E                     DB   14   ; ^N
068E   96 06                  DW   cnew   
0690   16                     DB   22   ; ^V
0691   65 07                  DW   cview   
0693   18                     DB   24   ; ^X
0694   00 00                  DW   LEAVE   
0696                NCMD:     EQU   9   
0696                             ; ^N ^N: no program, if the next key is ^N too
0696   CD 75 06     CNEW:     CALL   ekey   
0699   FE 0E                  CP   14   
069B   20 04                  JR   NZ,ged0   
069D   AF                     XOR   A   
069E   32 00 0C               LD   (PROG),A   
06A1   C3 D5 05     GED0:     JP   edit   
06A4                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
06A4                             ; line it was: Return puts the text back in its place.
06A4   CD 25 03     CEDLN:    CALL   rdnum   
06A7   E5                     PUSH   HL   
06A8   CD DF 07               CALL   find   ; HL -> the line, or the NUL if there is none
06AB   D1                     POP   DE   
06AC   7E                     LD   A,(HL)   
06AD   B7                     OR   A   
06AE   28 F1                  JR   Z,ged0   
06B0   ED 53 3A 0B            LD   (EDLN),DE   
06B4   11 80 0B               LD   DE,LINEBUF   
06B7   7E           CE1:      LD   A,(HL)   
06B8   FE 0D                  CP   13   
06BA   28 0C                  JR   Z,ce2   
06BC   FE 0A                  CP   10   
06BE   28 08                  JR   Z,ce2   
06C0   12                     LD   (DE),A   
06C1   23                     INC   HL   
06C2   1C                     INC   E   
06C3   7B                     LD   A,E   
06C4   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
06C6   20 EF                  JR   NZ,ce1   
06C8   21 80 0B     CE2:      LD   HL,LINEBUF   ; show it; the cursor ends up at its end
06CB   7D           CE3:      LD   A,L   
06CC   BB                     CP   E   
06CD   CA E7 05               JP   Z,ed1   
06D0   7E                     LD   A,(HL)   
06D1   EF                     RST   28h   
06D2   2C                     INC   L   
06D3   18 F6                  JR   ce3   
06D5                             ; Return. If ^E put a line here, the text goes back in its place. If not:
06D5                             ; a number and text is a line to put in, a number alone a line to take out,
06D5                             ; and anything else is run where it is.
06D5   E5           CRET:     PUSH   HL   ; the end of what was typed
06D6   2A 3A 0B               LD   HL,(EDLN)   
06D9   7C                     LD   A,H   
06DA   B5                     OR   L   
06DB   28 07                  JR   Z,cr1   
06DD   E5                     PUSH   HL   
06DE   CD CF 07               CALL   delln   
06E1   E1                     POP   HL   
06E2   18 13                  JR   ins   
06E4   CD 25 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
06E7   79                     LD   A,C   ; C is still 80h if there was no number:
06E8   87                     ADD   A,A   ;   only then is twice it 0
06E9   28 36                  JR   Z,st0p   ; no number: run the line
06EB   0A                     LD   A,(BC)   
06EC   FE 0D                  CP   13   
06EE   20 06                  JR   NZ,cr2   
06F0   D1                     POP   DE   ; the number alone: take that line out
06F1   CD CF 07               CALL   delln   
06F4   18 24                  JR   gedit   
06F6   03           CR2:      INC   BC   ; step over the one character after the number
06F7                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
06F7                             ; CR and LF included, and copy it in.
06F7   CD DF 07     INS:      CALL   find   ; HL -> where it goes
06FA   D1                     POP   DE   ; the end of what was typed
06FB   7B                     LD   A,E   
06FC   91                     SUB   C   ; A = the length of the text, with its CR LF
06FD   C5                     PUSH   BC   ; the text
06FE   4F                     LD   C,A   
06FF   06 00                  LD   B,0   
0701   C5                     PUSH   BC   ; its length
0702   54                     LD   D,H   
0703   5D                     LD   E,L   ; DE = where it goes
0704   AF                     XOR   A   
0705   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0706   ED B1                  CPIR      ; HL -> one past the program's NUL
0708   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
070A   44                     LD   B,H   
070B   4D                     LD   C,L   
070C   19                     ADD   HL,DE   
070D   2B                     DEC   HL   ; HL -> the NUL
070E   EB                     EX   DE,HL   
070F   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0710   E5                     PUSH   HL   
0711   19                     ADD   HL,DE   ; the NUL's new place
0712   EB                     EX   DE,HL   
0713   ED B8                  LDDR      ; move the rest of the program up
0715   C1                     POP   BC   ; the length
0716   D1                     POP   DE   ; where it goes
0717   E1                     POP   HL   ; the text
0718   ED B0                  LDIR      
071A   C3 D5 05     GEDIT:    JP   edit   
071D                             ; ^G: run the program. st0p: run the typed line (BC -> it).
071D   01 00 0C     CRUN:     LD   BC,PROG   
0720   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
0721   E1           ST0P:     POP   HL   ; (the end of what was typed)
0722                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0722   21 00 0C     ST0:      LD   HL,PROG   
0725   AF                     XOR   A   
0726   BE           ST1:      CP   (HL)   
0727   23                     INC   HL   
0728   20 FC                  JR   NZ,st1   
072A   22 7C 0B               LD   (HEAP),HL   
072D                          ENDIF      
072D                          IF   EDITOR*CHECKED   
072D   E7                     RST   20h   ; minus the heap"s first address: "_' may not
072E   22 38 0B               LD   (NPEND),HL   ;   release below it
0731                          ENDIF      
0731                          IF   EDITOR   
0731   E1                     POP   HL   ; TOS: the data stack is as the last line left it
0732   F7                     RST   30h   ; (its return address is thrown away)
0733                             ; ^L: list from line n. DE = the number of the line at HL.
0733   CD 25 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
0736   7C                     LD   A,H   
0737   B5                     OR   L   
0738   20 01                  JR   NZ,li0   
073A   2C                     INC   L   ;   then from line 1
073B   E5           LI0:      PUSH   HL   
073C   CD DF 07               CALL   find   
073F   D1                     POP   DE   
0740   7E           LI1:      LD   A,(HL)   
0741   B7                     OR   A   
0742   28 D6                  JR   Z,gedit   ; the end of the text
0744   CD 13 04               CALL   rawk   
0747   28 0B                  JR   Z,li3   ; no key: carry on
0749   FE 03                  CP   3   
074B   28 CD                  JR   Z,gedit   ; Ctrl-C
074D   CD 75 06               CALL   ekey   ; any other key: wait for one more
0750   FE 03                  CP   3   
0752   28 C6                  JR   Z,gedit   
0754   E5           LI3:      PUSH   HL   
0755   D5                     PUSH   DE   
0756   EB                     EX   DE,HL   
0757   CD 91 03               CALL   pdec   ; the line's number,
075A   3E 20                  LD   A," "   
075C   EF                     RST   28h   ;   a space,
075D   D1                     POP   DE   
075E   E1                     POP   HL   
075F   13                     INC   DE   
0760   CD F7 07               CALL   prl   ;   and the line
0763   18 DB                  JR   li1   
0765                             ; ^V: view.
0765   CD 89 05     CVIEW:    CALL   pmsg   
0768   42 38 53 5A 38 30 45   DB   "B8SZ80E"   
076F                          ENDIF      
076F                          IF   EDITOR*CHECKED   
076F   43                     DB   "C"   
0770                          ENDIF      
0770                          IF   EDITOR   
0770   20 32 30 32 36 2D 31 31 2D 32 31 22 DB   " 2026-11-21",22h   
077C   CD 15 05               CALL   pstk   ; both stacks
077F   21 00 0C               LD   HL,PROG   
0782   11 00 00               LD   DE,0   
0785   7E           CV1:      LD   A,(HL)   ; count the lines, and find the end
0786   B7                     OR   A   
0787   28 08                  JR   Z,cv2   
0789   23                     INC   HL   
078A   FE 0A                  CP   10   
078C   20 F7                  JR   NZ,cv1   
078E   13                     INC   DE   
078F   18 F4                  JR   cv1   
0791   E5           CV2:      PUSH   HL   ; the NUL
0792   D5                     PUSH   DE   ; the lines
0793   11 00 F4               LD   DE,(0-PROG)&0FFFFh   
0796   19                     ADD   HL,DE   
0797   CD 83 05               CALL   pnl   
079A   50 72 6F 67 20 22      DB   "Prog ",22h   
07A0   CD 91 03               CALL   pdec   ; the program's size
07A3   E1                     POP   HL   
07A4   CD 83 05               CALL   pnl   
07A7   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
07AE   CD 91 03               CALL   pdec   
07B1   D1                     POP   DE   
07B2                          ENDIF      
07B2                          IF   EDGEN   
                              LD   HL,HEAPLIM*256-1   
07B2                          ENDIF      
07B2                          IF   EDITOR*CPM   
07B2   3A 07 00               LD   A,(0007h)   ; the BDOS page is the limit
07B5   67                     LD   H,A   
07B6   2E 00                  LD   L,0   
07B8   2B                     DEC   HL   
07B9                          ENDIF      
07B9                          IF   EDITOR   
07B9   B7                     OR   A   
07BA   ED 52                  SBC   HL,DE   
07BC   CD 83 05               CALL   pnl   
07BF   46 72 65 65 20 22      DB   "Free ",22h   
07C5   CD 91 03               CALL   pdec   ; the room left for text and heap
07C8   CD 83 05               CALL   pnl   
07CB   22                     DB   22h   
07CC   C3 D5 05     GED1:     JP   edit   
07CF                             ; delln: take line n (in HL) out: copy everything after it down over it.
07CF   CD DF 07     DELLN:    CALL   find   
07D2   54                     LD   D,H   
07D3   5D                     LD   E,L   
07D4   CD ED 07               CALL   nxl   ; HL -> the next line
07D7   7E           DE1:      LD   A,(HL)   
07D8   12                     LD   (DE),A   
07D9   23                     INC   HL   
07DA   13                     INC   DE   
07DB   B7                     OR   A   
07DC   20 F9                  JR   NZ,de1   
07DE   C9                     RET      
07DF                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
07DF                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
07DF   EB           FIND:     EX   DE,HL   
07E0   21 00 0C               LD   HL,PROG   
07E3   1B           FI1:      DEC   DE   
07E4   7A                     LD   A,D   
07E5   B3                     OR   E   
07E6   C8                     RET   Z   
07E7   CD ED 07               CALL   nxl   
07EA   20 F7                  JR   NZ,fi1   
07EC   C9                     RET      
07ED                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
07ED                             ; stop at the NUL that ends the text (and return zero).
07ED   7E           NXL:      LD   A,(HL)   
07EE   B7                     OR   A   
07EF   C8                     RET   Z   
07F0   23                     INC   HL   
07F1   FE 0A                  CP   10   
07F3   20 F8                  JR   NZ,nxl   
07F5   B7                     OR   A   
07F6   C9                     RET      
07F7                             ; prl: print the line at HL, to its LF; HL -> just past it.
07F7   7E           PRL:      LD   A,(HL)   
07F8   EF                     RST   28h   
07F9   7E                     LD   A,(HL)   
07FA   23                     INC   HL   
07FB   FE 0A                  CP   10   
07FD   20 F8                  JR   NZ,prl   
07FF   C9                     RET      
0800                          ENDIF      
0800                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   A,10   
                              DB   0FEh   ; (CP n: steps over the LD A,13)
                    RD1:      LD   A,13   ; a LF alone ends a line
                    RD2:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              LD   A,10   
                              JR   Z,rd2   ; after a CR goes a LF
                    RD3:      CALL   ekey   
                              CP   1Ah   
                              JR   Z,rd4   
                              CP   10   
                              JR   NZ,rd2   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd3   ; (the LF is dropped)
                              JR   rd1   
                    RD4:      DEC   HL   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   Z,rd5   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    RD5:      LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
0800                          ENDIF      
0800                          IF   EDITOR*CPM   
0800                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
0800                             ;   put the one from the command line
0800                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
0800                             ; from now on.
0800   CD 57 08     CREAD:    CALL   setname   
0803   CD 94 08               CALL   load   
0806   C3 D5 05               JP   edit   
0809                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
0809                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
0809                             ; bytes after it are set to ^Z meanwhile, which pads the last record.
0809   CD 57 08     CWRITE:   CALL   setname   
080C   CD 83 08               CALL   fcbclr   
080F   0E 13                  LD   C,19   ; delete
0811   CD 8E 08               CALL   fbdos   
0814   0E 16                  LD   C,22   ; make
0816   CD 8E 08               CALL   fbdos   
0819   3C                     INC   A   
081A   CA D5 05               JP   Z,edit   ; no room in the directory
081D   21 00 0C               LD   HL,PROG   
0820   AF                     XOR   A   
0821   BE           CW1:      CP   (HL)   
0822   23                     INC   HL   
0823   20 FC                  JR   NZ,cw1   
0825   2B                     DEC   HL   ; HL -> the NUL
0826   E5                     PUSH   HL   
0827   06 80                  LD   B,128   
0829   36 1A        CW2:      LD   (HL),1Ah   
082B   23                     INC   HL   
082C   10 FB                  DJNZ   cw2   
082E   E1                     POP   HL   
082F   11 00 0C               LD   DE,PROG   
0832   7B           CW3:      LD   A,E   ; a record that starts before the end is written
0833   95                     SUB   L   
0834   7A                     LD   A,D   
0835   9C                     SBC   A,H   
0836   30 15                  JR   NC,cw4   
0838   E5                     PUSH   HL   
0839   D5                     PUSH   DE   
083A   0E 1A                  LD   C,26   ; set the DMA address: the record is written
083C   CD 05 00               CALL   BDOS   ;   from where it lies
083F   0E 15                  LD   C,21   ; write
0841   CD 8E 08               CALL   fbdos   
0844   E1                     POP   HL   
0845   11 80 00               LD   DE,128   
0848   19                     ADD   HL,DE   
0849   EB                     EX   DE,HL   
084A   E1                     POP   HL   
084B   18 E5                  JR   cw3   
084D   36 00        CW4:      LD   (HL),0   ; the NUL again
084F   0E 10                  LD   C,16   ; close
0851   CD 8E 08               CALL   fbdos   
0854   C3 D5 05               JP   edit   
0857                             ; setname: if a name was typed (the line does not start with its CR), put it
0857                             ; in the CFCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
0857                             ; is the current one.
0857   11 80 0B     SETNAME:   LD   DE,LINEBUF   
085A   1A                     LD   A,(DE)   
085B   FE 0D                  CP   13   
085D   C8                     RET   Z   
085E   21 5C 00               LD   HL,CFCB   
0861   36 00                  LD   (HL),0   ; the current drive
0863   06 0B                  LD   B,11   
0865   2C           SN1:      INC   L   
0866   36 20                  LD   (HL)," "   
0868   10 FB                  DJNZ   sn1   
086A   2E 5D                  LD   L,CFCB+1   
086C   1A           SN2:      LD   A,(DE)   
086D   13                     INC   DE   
086E   FE 0D                  CP   13   
0870   C8                     RET   Z   
0871   FE 2E                  CP   "."   
0873   20 04                  JR   NZ,sn3   
0875   2E 65                  LD   L,CFCB+9   ; the type
0877   18 F3                  JR   sn2   
0879   FE 61        SN3:      CP   "a"   
087B   38 02                  JR   C,sn4   
087D   E6 5F                  AND   5Fh   ; a capital
087F   77           SN4:      LD   (HL),A   
0880   2C                     INC   L   
0881   18 E9                  JR   sn2   
0883                             ; fcbclr: clear the CFCB after its name, as it must be before a file is opened
0883   21 68 00     FCBCLR:   LD   HL,CFCB+12   
0886   06 18                  LD   B,24   
0888   36 00        FC1:      LD   (HL),0   
088A   23                     INC   HL   
088B   10 FB                  DJNZ   fc1   
088D   C9                     RET      
088E                             ; fbdos: BDOS function C on the file
088E   11 5C 00     FBDOS:    LD   DE,CFCB   
0891   C3 05 00               JP   BDOS   
0894                             ; load: read the file into PROG. No such file: no program. The text ends at
0894                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0894                             ; goes after the last record, so the search always stops. And every line
0894                             ; must end in LF: a last line without one is given a CR LF.
0894   CD 83 08     LOAD:     CALL   fcbclr   
0897   0E 0F                  LD   C,15   ; open (no such file: the first read fails
0899   CD 8E 08               CALL   fbdos   ;   too)
089C   11 00 0C               LD   DE,PROG   
089F   D5           LD1:      PUSH   DE   
08A0   0E 1A                  LD   C,26   ; set the DMA address
08A2   CD 05 00               CALL   BDOS   
08A5   0E 14                  LD   C,20   ; read the next 128 bytes
08A7   CD 8E 08               CALL   fbdos   
08AA   E1                     POP   HL   ; HL = the address this record went to
08AB   B7                     OR   A   
08AC   20 07                  JR   NZ,ld2   
08AE   11 80 00               LD   DE,128   
08B1   19                     ADD   HL,DE   
08B2   EB                     EX   DE,HL   
08B3   18 EA                  JR   ld1   
08B5   36 1A        LD2:      LD   (HL),1Ah   
08B7   21 FF 0B               LD   HL,PROG-1   
08BA   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
08BC   23           TR1:      INC   HL   
08BD   5F                     LD   E,A   ; E = the character before this one
08BE   7E                     LD   A,(HL)   
08BF   FE 1A                  CP   1Ah   
08C1   20 F9                  JR   NZ,tr1   
08C3   7B                     LD   A,E   
08C4   FE 0A                  CP   10   
08C6   28 06                  JR   Z,tr2   
08C8   36 0D                  LD   (HL),13   
08CA   23                     INC   HL   
08CB   36 0A                  LD   (HL),10   
08CD   23                     INC   HL   
08CE   36 00        TR2:      LD   (HL),0   
08D0   C9                     RET      
08D1                          ENDIF      
08D1                             ; =============================================================================
08D1                             ;  CP/M startup (the generic build starts at address 0: see st0)
08D1                             ; =============================================================================
08D1                          IF   CPM   
08D1                             ; The RAM pages follow the image; the heap may grow to the BDOS.
08D1                START:       
08D1                          ENDIF      
08D1                          IF   CPM*CHECKED   
08D1                             ; Clear the lower half of the letter page: every variable starts at
08D1                             ; 0, every word cell holds 0000h, the address an undefined word is
08D1                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
08D1                             ; is held back.
08D1   21 00 0B               LD   HL,LET   
08D4   AF                     XOR   A   
08D5   77           INI1:     LD   (HL),A   
08D6   2C                     INC   L   
08D7   F2 D5 08               JP   P,ini1   ; +00h to +7Fh
08DA                          ENDIF      
08DA                          IF   CPM   
08DA   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
08DD   11 08 00               LD   DE,0008h   
08E0   01 2C 00               LD   BC,vecend-vecs   
08E3   ED B0                  LDIR      
08E5                          ENDIF      
08E5                          IF   CPM*EDITOR   
08E5   CD 94 08               CALL   load   ; the file named on the command line
08E8   C3 CF 05               JP   edit0   
08EB                          ENDIF      
08EB                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
08EB                          ENDIF      
08EB                          IF   CPM   
08EB                             ; RAM pages, after the image
08EB                RSPAGE:   EQU   (imgend + 255) / 256   
08EB                DSPAGE:   EQU   RSPAGE + 1   
08EB                LETPAGE:   EQU   RSPAGE + 2   
08EB                PROG:     EQU   LETPAGE*256 + 256   
08EB                          ENDIF      
08EB                IMGEND:      


