F22C   35 02        PD2:      PULS   A   
F22E   8B 30                  ADDA   #"0"   
F230   7E FF 03               JMP   CONOUT   
F233                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F233                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F233   A6 43        H_MUL:    LDA   3,U   
F235   E6 C4                  LDB   ,U   
F237   3D                     MUL      ; al*bh
F238   E7 C4                  STB   ,U   ; (bh is no longer needed)
F23A   A6 42                  LDA   2,U   
F23C   E6 41                  LDB   1,U   
F23E   3D                     MUL      ; ah*bl
F23F   EB C4                  ADDB   ,U   
F241   E7 C4                  STB   ,U   ; the cross terms, low byte
F243   A6 43                  LDA   3,U   
F245   E6 41                  LDB   1,U   
F247   3D                     MUL      ; al*bl
F248   AB C4                  ADDA   ,U   
F24A   33 42                  LEAU   2,U   
F24C   ED C4                  STD   ,U   
F24E   39                     RTS      
F24F   EC C1        H_ADD:    LDD   ,U++   
F251   E3 C4                  ADDD   ,U   
F253   20 38                  BRA   st   
F255   EC C1        H_AND:    LDD   ,U++   
F257   A4 C4                  ANDA   ,U   
F259   E4 41                  ANDB   1,U   
F25B   20 30                  BRA   st   
F25D   EC C1        H_OR:     LDD   ,U++   
F25F   AA C4                  ORA   ,U   
F261   EA 41                  ORB   1,U   
F263   20 28                  BRA   st   
F265   EC C1        H_XOR:    LDD   ,U++   
F267   A8 C4                  EORA   ,U   
F269   E8 41                  EORB   1,U   
F26B   20 20                  BRA   st   
F26D   63 C4        H_NOT:    COM   ,U   
F26F   63 41                  COM   1,U   
F271   39                     RTS      
F272                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F272   EC 42        CMP:      LDD   2,U   
F274   10 A3 C1               CMPD   ,U++   
F277   39                     RTS      
F278   8D F8        H_LT:     BSR   cmp   
F27A   2D 0E                  BLT   true   
F27C   4F           FALSE:    CLRA      
F27D   5F                     CLRB      
F27E   20 0D                  BRA   st   
F280   8D F0        H_GT:     BSR   cmp   
F282   2E 06                  BGT   true   
F284   20 F6                  BRA   false   
F286   8D EA        H_EQ:     BSR   cmp   
F288   26 F2                  BNE   false   
F28A   CC FF FF     TRUE:     LDD   #-1   
F28D   ED C4        ST:       STD   ,U   
F28F   39                     RTS      
F290                             ; =============================================================================
F290                             ;  Stack
F290                             ; =============================================================================
F290   EC C4        H_DUP:    LDD   ,U   
F292   36 06                  PSHU   D   
F294   39                     RTS      
F295   37 16        H_SWAP:   PULU   D,X   
F297   36 06                  PSHU   D   
F299   36 10                  PSHU   X   
F29B   39                     RTS      
F29C                             ; =============================================================================
F29C                             ;  Storage. The cells in RAM are little-endian: the byte order is swapped
F29C                             ;  between the stack (big-endian) and memory.
F29C                             ; =============================================================================
F29C   AE C4        H_FETCH:   LDX   ,U   ; "@"
F29E   E6 84                  LDB   ,X   
F2A0   A6 01                  LDA   1,X   
F2A2   20 E9                  BRA   st   
F2A4   AE C4        H_CFETCH:   LDX   ,U   ; ","
F2A6   E6 84                  LDB   ,X   
F2A8   4F                     CLRA      
F2A9   20 E2                  BRA   st   
F2AB   AE C1        H_STORE:   LDX   ,U++   ; "!" ( n addr -- )
F2AD                          IF   CHECKED   
F2AD   8D 31                  BSR   chkst   ; both bytes must be in the program's space
F2AF   30 01                  LEAX   1,X   
F2B1   8D 2D                  BSR   chkst   
F2B3   30 1F                  LEAX   -1,X   
F2B5                          ENDIF      
F2B5   37 06                  PULU   D   
F2B7   E7 84                  STB   ,X   ; little-endian
F2B9   A7 01                  STA   1,X   
F2BB   39                     RTS      
F2BC   AE C1        H_CSTORE:   LDX   ,U++   ; "." ( c addr -- )
F2BE                          IF   CHECKED   
F2BE   8D 20                  BSR   chkst   
F2C0                          ENDIF      
F2C0   37 06                  PULU   D   
F2C2   E7 84                  STB   ,X   
F2C4   39                     RTS      
F2C5                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
F2C5   D6 7C        H_ALLOC:   LDB   <HEAP   
F2C7   96 7D                  LDA   <HEAP+1   
F2C9   1F 01                  TFR   D,X   ; the old pointer
F2CB   E3 C4                  ADDD   ,U   
F2CD                          IF   CHECKED   
F2CD   10 25 01 21            LBCS   e_heap   ; a negative count wraps: too big
F2D1   10 83 F0 00            CMPD   #HEAPLIM*256   
F2D5   10 24 01 19            LBHS   e_heap   
F2D9                          ENDIF      
F2D9   D7 7C                  STB   <HEAP   
F2DB   97 7D                  STA   <HEAP+1   
F2DD   AF C4                  STX   ,U   
F2DF   39                     RTS      
F2E0                          IF   CHECKED   
F2E0                             ; chkst: stop unless X is in the program's own space: from the letter page
F2E0                             ; up to HEAPLIM, so the interpreter's stacks and whatever lies above the
F2E0                             ; limit are safe. Memory above the heap top but below the limit is the
F2E0                             ; program's own: Tiny BASIC keeps its lines there. Keeps every register.
F2E0   8C 82 00     CHKST:    CMPX   #LET   
F2E3   10 25 01 11            LBLO   e_store   
F2E7   8C F0 00               CMPX   #HEAPLIM*256   
F2EA   10 24 01 0A            LBHS   e_store   
F2EE   39                     RTS      
F2EF                          ENDIF      
F2EF                             ; =============================================================================
F2EF                             ;  Flow control helpers
F2EF                             ; =============================================================================
F2EF                             ; =============================================================================
F2EF                             ;  Console
F2EF                             ; =============================================================================
F2EF                             ; "$" prints the string at TOS, decoding escapes: ">" plus a character from
F2EF                             ; 40h-7Fh clears its bit 6 (>M is CR, >` is space); plus anything lower gives
F2EF                             ; that character itself.
F2EF   AE C4        H_PRINT:   LDX   ,U   
F2F1   A6 80        PR0:      LDA   ,X+   
F2F3   81 22                  CMPA   #22h   
F2F5   27 14                  BEQ   drop   
F2F7   81 3E                  CMPA   #">"   
F2F9   26 08                  BNE   pr1   
F2FB   A6 80                  LDA   ,X+   
F2FD   81 40                  CMPA   #40h   
F2FF   25 02                  BLO   pr1   
F301   84 BF                  ANDA   #0BFh   
F303   8D 2D        PR1:      BSR   putc   
F305   20 EA                  BRA   pr0   
F307   A6 41        H_EMIT:   LDA   1,U   ; "'"
F309   8D 27                  BSR   putc   
F30B   33 42        DROP:     LEAU   2,U   ; ";"
F30D   39                     RTS      
F30E                             ; =============================================================================
F30E                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
F30E                             ;  A = 0 with the zero flag set when none is waiting. It keeps B, X, Y, U.
F30E                             ; =============================================================================
F30E                GETK:        
F30E                          IF   CHECKED   
F30E   96 34                  LDA   <KEYBUF   ; a key held back by the break check
F310   27 04                  BEQ   gk1   
F312   0F 34                  CLR   <KEYBUF   
F314   4D                     TSTA      
F315   39                     RTS      
F316                GK1:         
F316                          ENDIF      
F316   BD FF 06               JSR   CONST   
F319   4D                     TSTA      
F31A   27 04                  BEQ   gk9   
F31C   BD FF 00               JSR   CONIN   
F31F   4D                     TSTA      
F320   39           GK9:      RTS      
F321                          IF   CHECKED   
F321                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
F321                             ; else is held for the next "?".
F321   96 34        CHKBRK:   LDA   <KEYBUF   
F323   26 0C                  BNE   cb9   ; one key is already held
F325   8D E7                  BSR   getk   
F327   27 08                  BEQ   cb9   
F329   81 03                  CMPA   #3   
F32B   10 27 00 BC            LBEQ   e_break   
F32F   97 34                  STA   <KEYBUF   
F331   39           CB9:      RTS      
F332                          ENDIF      
F332   7E FF 03     PUTC:     JMP   CONOUT   
F335                             ; "?" ( n -- c ) or ( -n -- addr )
F335                             ;   n > 0: wait about n ms for a key; 0 if none came
F335                             ;   n = 0: wait for a key
F335                             ;   n < 0: read a line of at most -n characters (capped at CAP) with echo
F335   AE C4        H_KEY:    LDX   ,U   
F337   2B 16                  BMI   line   
F339   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F33B   8D D1        KT2:      BSR   getk   
F33D   26 0B                  BNE   kt3   
F33F   5A                     DECB      
F340   26 F9                  BNE   kt2   
F342   30 1F                  LEAX   -1,X   
F344   26 F3                  BNE   kt1   ; A = 0 if the time ran out
F346   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F348   27 EF                  BEQ   kt1   ;   run it again, until a key comes
F34A   6F C4        KT3:      CLR   ,U   
F34C   A7 41                  STA   1,U   
F34E   39                     RTS      
F34F   4F           LINE:     CLRA      
F350   5F                     CLRB      
F351   A3 C4                  SUBD   ,U   ; D = the count
F353   10 83 00 7F            CMPD   #CAP   
F357   23 02                  BLS   ln1   
F359   C6 7F                  LDB   #CAP   
F35B   D7 35        LN1:      STB   <MAXV   
F35D   8E 82 80               LDX   #LINEBUF   
F360   5F                     CLRB      ; B = length
F361                             ; Backspace and DEL erase, CR ends (stored, not echoed), other
F361                             ; control keys are ignored, and a full line takes only those.
F361   8D AB        LN2:      BSR   getk   
F363   27 FC                  BEQ   ln2   
F365   81 0D                  CMPA   #13   
F367   27 2B                  BEQ   ln5   
F369   81 08                  CMPA   #8   
F36B   27 13                  BEQ   ln4   
F36D   81 7F                  CMPA   #7Fh   
F36F   27 0F                  BEQ   ln4   
F371   81 20                  CMPA   #" "   
F373   25 EC                  BLO   ln2   
F375   D1 35                  CMPB   <MAXV   
F377   24 E8                  BHS   ln2   ; full
F379   A7 80                  STA   ,X+   
F37B   5C                     INCB      
F37C   8D B4                  BSR   putc   
F37E   20 E1                  BRA   ln2   
F380   5D           LN4:      TSTB      
F381   27 DE                  BEQ   ln2   
F383   5A                     DECB      
F384   30 1F                  LEAX   -1,X   
F386   86 08                  LDA   #8   
F388   8D A8                  BSR   putc   
F38A   86 20                  LDA   #" "   
F38C   8D A4                  BSR   putc   
F38E   86 08                  LDA   #8   
F390   8D A0                  BSR   putc   
F392   20 CD                  BRA   ln2   
F394   A7 84        LN5:      STA   ,X   ; A = 13
F396   CC 82 80               LDD   #LINEBUF   
F399   ED C4                  STD   ,U   
F39B   39                     RTS      
F39C                             ; =============================================================================
F39C                             ;  Machine code: the grave
F39C                             ; =============================================================================
F39C                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
F39C                             ; are stored from addr until a non-hex character; then a RTS (39h) is
F39C                             ; written and its address is left. An odd last digit is consumed and dropped.
F39C                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
F39C                             ; code is entered by JSR (the dispatcher's own), with the address already
F39C                             ; popped: U points at the top data cell (big-endian, 2 bytes, stack grows
F39C                             ; down) and the return address is on top of S. The code may pop and push
F39C                             ; data cells by changing U; on return the cell at ,U is the new TOS. It must
F39C                             ; keep Y (the interpreter's reading position), DP and S (balanced), and
F39C                             ; return with RTS. A, B, X, CC may change.
F39C   8D 27        H_GRAVE:   BSR   hexc   ; the digit after the grave, if any
F39E   24 21                  BCC   exec   
F3A0   AE C4                  LDX   ,U   
F3A2   48           HX1:      ASLA      
F3A3   48                     ASLA      
F3A4   48                     ASLA      
F3A5   48                     ASLA      
F3A6                          IF   CHECKED   
F3A6   BD F2 E0               JSR   chkst   
F3A9                          ENDIF      
F3A9   A7 84                  STA   ,X   ; the high nibble; an odd digit is overwritten
F3AB   8D 18                  BSR   hexc   
F3AD   24 08                  BCC   hx2   ; odd digit: already consumed, dropped
F3AF   AA 84                  ORA   ,X   
F3B1   A7 80                  STA   ,X+   
F3B3   8D 10                  BSR   hexc   
F3B5   25 EB                  BCS   hx1   
F3B7                HX2:         
F3B7                          IF   CHECKED   
F3B7   BD F2 E0               JSR   chkst   
F3BA                          ENDIF      
F3BA   86 39                  LDA   #39h   ; RTS
F3BC   A7 84                  STA   ,X   
F3BE   AF C4                  STX   ,U   
F3C0   39                     RTS      
F3C1   AE C1        EXEC:     LDX   ,U++   
F3C3   6E 84                  JMP   ,X   ; the code's RTS returns to the dispatcher
F3C5                             ; hexc: read the character at IP. If it is a hex digit (0-9, A-F, a-f), return
F3C5                             ; its value 0-15 in A with carry set and step over it; otherwise return with
F3C5                             ; carry clear and the IP unchanged.
F3C5   A6 A4        HEXC:     LDA   ,Y   
F3C7   80 30                  SUBA   #"0"   
F3C9   81 0A                  CMPA   #10   
F3CB   25 0C                  BLO   hv1   ; C = 1
F3CD   84 DF                  ANDA   #0DFh   
F3CF   80 11                  SUBA   #11h   
F3D1   81 06                  CMPA   #6   
F3D3   24 06                  BHS   hv9   ; C = 0
F3D5   8B 0A                  ADDA   #10   
F3D7   81 10                  CMPA   #16   ; C = 1
F3D9   31 21        HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
F3DB   39           HV9:      RTS      
F3DC                             ; =============================================================================
F3DC                             ;  Checked build: break key and error reports
F3DC                             ; =============================================================================
F3DC                          IF   CHECKED   
F3DC   8D 24        E_STACK:   BSR   error   
F3DE   73 74 61 63 EB         FCB   "stac","k"+80h   
F3E3   8D 1D        E_RSTACK:   BSR   error   
F3E5   72 65 74 75 72 EE      FCB   "retur","n"+80h   
F3EB   8D 15        E_BREAK:   BSR   error   
F3ED   62 72 65 61 EB         FCB   "brea","k"+80h   
F3F2   8D 0E        E_HEAP:   BSR   error   
F3F4   68 65 61 F0            FCB   "hea","p"+80h   
F3F8   8D 08        E_STORE:   BSR   error   
F3FA   73 74 6F 72 E5         FCB   "stor","e"+80h   
F3FF   8D 01        E_BRACK:   BSR   error   
F401   DB                     FCB   "["+80h   
F402                             ; error: print CR LF, the word after the BSR (last character has bit 7
F402                             ; set), " at " and the offset of the reading position in the program.
F402   35 10        ERROR:    PULS   X   ; X -> the word
F404   10 CE 81 00            LDS   #RSTOP   ; the stacks may be wrecked: start clean
F408   CE 82 00               LDU   #DSTOP   
F40B   34 10                  PSHS   X   
F40D   8E F4 36               LDX   #crlf   
F410   8D 16                  BSR   puts7   
F412   35 10                  PULS   X   
F414   8D 12                  BSR   puts7   
F416   8E F4 38               LDX   #aat   
F419   8D 0D                  BSR   puts7   
F41B   1F 20                  TFR   Y,D   
F41D   83 83 01               SUBD   #PROG+1   ; the character just read
F420   36 06                  PSHU   D   
F422   BD F2 17               JSR   pdec   
F425   7E FF 09               JMP   EXIT   
F428                             ; puts7: print the characters at X up to one with bit 7 set (inclusive)
F428   A6 80        PUTS7:    LDA   ,X+   
F42A   34 02                  PSHS   A   
F42C   84 7F                  ANDA   #7Fh   
F42E   BD FF 03               JSR   CONOUT   
F431   6D E0                  TST   ,S+   
F433   2A F3                  BPL   puts7   
F435   39                     RTS      
F436   0D 8A        CRLF:     FCB   13,10+80h   
F438   20 61 74 A0  AAT:      FCB   " at"," "+80h   
F43C                          ENDIF      
