03E9                PR1:      DS   1-CPM,0EFh   
03E9   CD                     DS   CPM,0CDh   
03EA   E8                     DS   CPM,APUT&0FFh   
03EB   05                     DS   CPM,APUT/256   
03EC   C3 CF 03               JMP   prlp   
03EF                          ENDIF      
03EF                             ;-----------------------------------------------------------------------------
03EF                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
03EF                             ; HL points past it. Each goes back into the loop that prints the string
03EF                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
03EF                             ;    /a-/z   print the variable, as "#" does
03EF                             ;    /{      clear the screen, the cursor to the top left
03EF                             ;    /}      clear from the cursor to the end of the line
03EF                             ;    /|  /`  show the cursor, hide it
03EF                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
03EF   FE 7E        PESC:     CPI   7Eh   
03F1   CA 14 04               JZ   pat   
03F4   11 CF 03               LXI   D,PRLOOP   ; the others return into the loop
03F7   D5                     PUSH   D   
03F8   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
03FA   D2 4C 04               JNC   pcon   
03FD   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
03FF   D2 36 04               JNC   phide   
0402   87                     ADD   A   ; the variable's cell
0403   C6 40                  ADI   40h   
0405   E5                     PUSH   H   
0406   C5                     PUSH   B   
0407   6F                     MOV   L,A   
0408   26 0A                  MVI   H,LETPAGE   
040A   7E                     MOV   A,M   
040B   2C                     INR   L   
040C   66                     MOV   H,M   
040D   6F                     MOV   L,A   
040E   CD AE 03               CALL   psgn   
0411   C1                     POP   B   
0412   E1                     POP   H   
0413   C9                     RET      
0414                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0414                             ; the checked build "$" is the routine prstr: its own return address goes
0414                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0414                             ; its two cells are there, and is s if not, before it prints anything.
0414                PAT:         
0414                          IF   CHECKED   
                              XTHL      ; the text pointer over prstr's return address
                              LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              DAD   SP   
                              JC   e_under   
                              POP   H   
0414                          ENDIF      
0414   D1                     POP   D   ; DE = the column
0415   E3                     XTHL      ; HL = the row; the text pointer is kept
0416                          IF   1-ANS   
                              CALL   CONAT   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JZ   CONCLS   ; /{
                              CPI   2   
                              JZ   CONEOL   ; /}
                              DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
                    PHIDE:    XRA   A   ; /`  (A = 0: hide)
                              JMP   CONCUR   
0416                          ENDIF      
0416                          IF   ANS   
0416   C5                     PUSH   B   ; (pdec uses BC)
0417   D5                     PUSH   D   
0418   CD 65 04               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
041B   23                     INX   H   
041C   CD BB 03               CALL   pdec   
041F   3E 3B                  MVI   A,";"   
0421                          ;*Macro unroll:  PUTA
0421                          DS   1-CPM,0EFh   
0421   CD                     DS   CPM,0CDh   
0422   E8                     DS   CPM,APUT&0FFh   
0423   05                     DS   CPM,APUT/256   
0424   E1                     POP   H   
0425   23                     INX   H   
0426   CD BB 03               CALL   pdec   
0429   3E 48                  MVI   A,"H"   
042B                          ;*Macro unroll:  PUTA
042B                          DS   1-CPM,0EFh   
042B   CD                     DS   CPM,0CDh   
042C   E8                     DS   CPM,APUT&0FFh   
042D   05                     DS   CPM,APUT/256   
042E   C1                     POP   B   
042F   E1                     POP   H   
0430   C3 CF 03               JMP   PRAGAIN   
0433                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0433   1E 68        PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
0435   DA                     DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
0436   1E 6C        PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
0438   3E 3F                  MVI   A,"?"   
043A   CD 5C 04               CALL   csia   
043D   3E 32                  MVI   A,"2"   
043F                          ;*Macro unroll:  PUTA
043F                          DS   1-CPM,0EFh   
043F   CD                     DS   CPM,0CDh   
0440   E8                     DS   CPM,APUT&0FFh   
0441   05                     DS   CPM,APUT/256   
0442   3E 35                  MVI   A,"5"   
0444                          ;*Macro unroll:  PUTA
0444                          DS   1-CPM,0EFh   
0444   CD                     DS   CPM,0CDh   
0445   E8                     DS   CPM,APUT&0FFh   
0446   05                     DS   CPM,APUT/256   
0447   7B                     MOV   A,E   
0448                          ;*Macro unroll:  PUTA
0448                          DS   1-CPM,0EFh   
0448   CD                     DS   CPM,0CDh   
0449   E8                     DS   CPM,APUT&0FFh   
044A   05                     DS   CPM,APUT/256   
044B   C9                     RET      
044C                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
044C   3D           PCON:     DCR   A   
044D   CA 33 04               JZ   pshow   ; /|
0450   3E 4B                  MVI   A,"K"   
0452   F2 5C 04               JP   csia   ; /}  ESC [ K
0455   3E 48                  MVI   A,"H"   ; /{  ESC [ H ESC [ J
0457   CD 5C 04               CALL   csia   
045A   3E 4A                  MVI   A,"J"   ; (on into csia)
045C                             ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
045C   F5           CSIA:     PUSH   PSW   
045D   CD 65 04               CALL   csi   
0460   F1                     POP   PSW   
0461                          ;*Macro unroll:  PUTA
0461                          DS   1-CPM,0EFh   
0461   CD                     DS   CPM,0CDh   
0462   E8                     DS   CPM,APUT&0FFh   
0463   05                     DS   CPM,APUT/256   
0464   C9                     RET      
0465   3E 1B        CSI:      MVI   A,27   
0467                          ;*Macro unroll:  PUTA
0467                          DS   1-CPM,0EFh   
0467   CD                     DS   CPM,0CDh   
0468   E8                     DS   CPM,APUT&0FFh   
0469   05                     DS   CPM,APUT/256   
046A   3E 5B                  MVI   A,"["   
046C                          ;*Macro unroll:  PUTA
046C                          DS   1-CPM,0EFh   
046C   CD                     DS   CPM,0CDh   
046D   E8                     DS   CPM,APUT&0FFh   
046E   05                     DS   CPM,APUT/256   
046F   C9                     RET      
0470                          ENDIF      
0470                             ; skip: read past text to the closer at this level, and return A = 0 if it
0470                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0470                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0470                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0470                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0470                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
0470                             ; 
0470                             ; The checked build also looks at the character the skip was started by,
0470                             ; which is always the one just before where it starts: "(" must end at ")",
0470                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0470                             ; quote counts as running into it. "\" takes either closer. The place where
0470                             ; the skip started is kept on the stack, for the report.
0470                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
0470                          ENDIF      
0470                          IF   CHECKED*(1-QK)   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
0470                          ENDIF      
0470                          IF   1-QK   
                              MVI   D,0   
                    SK3:      INR   D   ; an opener: one deeper
                    SK1:      LDAX   B   
0470                          ENDIF      
0470                          IF   (1-CHECKED)*(1-QK)   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
0470                          ENDIF      
0470                          IF   CHECKED*(1-QK)   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
0470                          ENDIF      
0470                          IF   1-QK   
                              CPI   22h   
                              CZ   skipstr   ; leaves A = 22h, which matches nothing below
                              SUI   "("   ;   (or 0, and then the NUL is read next)
                              JZ   sk3   
                              DCR   A   ; ")"
                              JZ   sk4   
                              SUI   "["-")"   
                              JZ   sk3   
                              CPI   "]"-"["   
                              JNZ   sk1   
                    SK4:      DCR   D   
0470                          ENDIF      
0470                          IF   (1-CHECKED)*(1-QK)   
                              RZ      ; the closer at this level
                              JMP   sk1   
0470                          ENDIF      
0470                          IF   CHECKED*(1-QK)   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
0470                          ENDIF      
0470                          IF   QK   
0470                             ; The skip cache. Nearly every skip is one that has happened before (a loop
0470                             ; skips the same false block on every pass), so the first scan from each
0470                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
0470                             ; by the start's low byte (times 4). Only skips that start in the program
0470                             ; text are kept (the line buffer changes); the cache is emptied whenever a
0470                             ; run starts (see start). A program that changes its own text while it
0470                             ; runs is not looked after.
0470   78           SKIP:     MOV   A,B   
0471   FE 0B                  CPI   PROG/256   
0473   DA 93 04               JC   sks   ; below the program text: no cache
0476   79                     MOV   A,C   
0477   87                     ADD   A   
0478   87                     ADD   A   
0479   5F                     MOV   E,A   
047A   16 07                  MVI   D,CPAGE   ; DE -> the entry
047C   1A                     LDAX   D   
047D   B9                     CMP   C   
047E   C2 93 04               JNZ   sks   
0481   1C                     INR   E   
0482   1A                     LDAX   D   
0483   B8                     CMP   B   
0484   C2 93 04               JNZ   sks   
0487   1C                     INR   E   
0488   1A                     LDAX   D   
0489   4F                     MOV   C,A   
048A   1C                     INR   E   
048B   1A                     LDAX   D   
048C   47                     MOV   B,A   ; a hit: the IP is past the closer
048D   0B                     DCX   B   
048E   0A                     LDAX   B   
048F   03                     INX   B   
0490   D6 29                  SUI   ")"   ; 0 for ")", not 0 for "]"
0492   C9                     RET      
0493   C5           SKS:      PUSH   B   ; where it starts: the cache's key (and the
0494                          ENDIF      ;   checked report's place)
0494                          IF   QK*CHECKED   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
0494                          ENDIF      
0494                          IF   QK   
0494                             ; The scan. Most characters are nothing to it, and two range tests rule
0494                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
0494   16 00                  MVI   D,0   
0496   14           SQ3:      INR   D   ; an opener: one deeper
0497   0A           SQ1:      LDAX   B   
0498   03                     INX   B   
0499   FE 5E                  CPI   5Eh   
049B   D2 97 04               JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
049E   FE 5B                  CPI   5Bh   
04A0   D2 C2 04               JNC   sqb   ; [ \ ]
04A3   FE 2A                  CPI   2Ah   
04A5   D2 97 04               JNC   sq1   ; * to Z: nothing
04A8   FE 28                  CPI   28h   
04AA   CA 96 04               JZ   sq3   ; (
04AD   D2 CD 04               JNC   sqc   ; )
04B0   FE 22                  CPI   22h   
04B2   CA BC 04               JZ   sqq   ; a string
04B5   B7                     ORA   A   
04B6   C2 97 04               JNZ   sq1   ; the rest below "(": nothing
04B9                          ENDIF      
04B9                          IF   QK*(1-CHECKED)   
04B9   C3 7F 01               JMP   endprog   ; NUL: the end of the program
04BC                          ENDIF      
04BC                          IF   QK*CHECKED   
                              DCX   B   ; NUL: the IP stays on it
                              MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SQ7:      MVI   A,"N"   ; N. The place is the opener
                              JMP   errp   ; (errp drops skip's return address)
04BC                          ENDIF      
04BC                          IF   QK   
04BC   CD EF 04     SQQ:      CALL   skipstr   ; step over the string
04BF   C3 97 04               JMP   sq1   
04C2   D6 5C        SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
04C4   CA 97 04               JZ   sq1   ; "\" is nothing here
04C7   DA 96 04               JC   sq3   ; [
04CA   3E 02                  MVI   A,2   ; ]
04CC   FE                     DB   0FEh   ; (CPI: steps over the XRA)
04CD   AF           SQC:      XRA   A   ; )
04CE   15           SQ4:      DCR   D   
04CF   C2 97 04               JNZ   sq1   
04D2                          ENDIF      
04D2                          IF   QK*CHECKED   
                              MOV   D,A   ; the closer at this level (as above): 2 here
                              XRA   E   ;   means the wrong closer
                              ANI   6   
                              CPI   2   
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              JNZ   sq8   
                              MOV   B,D   
                              MOV   C,E   
                              JMP   sq7   
                    SQ8:         
04D2                          ENDIF      
04D2                          IF   QK*(1-CHECKED)   
04D2   D1                     POP   D   ; where the skip started
04D3                          ENDIF      
04D3                          IF   QK   
04D3                             ; The closer at this level: remember the skip (if it started in the program
04D3                             ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
04D3   E5                     PUSH   H   
04D4   67                     MOV   H,A   
04D5   7A                     MOV   A,D   
04D6   FE 0B                  CPI   PROG/256   
04D8   DA EB 04               JC   sq9   
04DB   7B                     MOV   A,E   
04DC   87                     ADD   A   
04DD   87                     ADD   A   
04DE   6F                     MOV   L,A   
04DF   7C                     MOV   A,H   
04E0   26 07                  MVI   H,CPAGE   
04E2   73                     MOV   M,E   
04E3   2C                     INR   L   
04E4   72                     MOV   M,D   
04E5   2C                     INR   L   
04E6   71                     MOV   M,C   
04E7   2C                     INR   L   
04E8   70                     MOV   M,B   
04E9   E1                     POP   H   
04EA   C9                     RET      
04EB   7C           SQ9:      MOV   A,H   
04EC   E1                     POP   H   
04ED   C9                     RET      
04EE                          ENDIF      
04EE                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
04EE                             ; the next character, so "/"" does not end it. Leaves A = 22h.
04EE                          IF   1-CHECKED   
04EE   03           SS0:      INX   B   
04EF   0A           SKIPSTR:   LDAX   B   
04F0   03                     INX   B   
04F1   FE 2F                  CPI   "/"   
04F3   CA EE 04               JZ   ss0   
04F6   FE 22                  CPI   22h   
04F8   C2 EF 04               JNZ   skipstr   
04FB   C9                     RET      
04FC                          ENDIF      
04FC                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
04FC                          ENDIF      
04FC                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
04FC                             ; and return its value in A with the carry set; otherwise leave the IP and
04FC                             ; return with the carry clear.
04FC   0A           HEXC:     LDAX   B   
04FD   D6 30                  SUI   "0"   
04FF   FE 0A                  CPI   10   
0501   DA 0D 05               JC   hc1   
0504   E6 DF                  ANI   0DFh   
0506   D6 11                  SUI   11h   
0508   FE 06                  CPI   6   
050A   D0                     RNC      
050B   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
050D   03           HC1:      INX   B   
050E   C9                     RET      
050F                             ;  ---- Speed-ups (base builds) -------------------------------------------
050F                             ;  The skip cache and "/" by a power of two are above. These are the
050F                             ;  handlers' tails that the builds with room take, kept here, out of the
050F                             ;  handlers' first two pages.
050F                          IF   QK   
050F                             ; "*" with an operand below 256: that one becomes the multiplier, a byte in
050F                             ; A, and the loop stops as soon as its bits are used up (most
050F                             ; multiplications have one, a count or a small constant). With both at 256
050F                             ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
050F                             ; shifted in above it says when), and its high byte goes on as a small one.
050F                             ; DE = NOS, HL = TOS.
050F   7C           MULQ:     MOV   A,H   
0510   B7                     ORA   A   
0511   CA 1A 05               JZ   mq8   ; the multiplier is below 256
0514   7A                     MOV   A,D   
0515   B7                     ORA   A   
0516   C2 31 05               JNZ   mq16   
0519   EB                     XCHG      ; the multiplicand is: it becomes the multiplier
051A   7D           MQ8:      MOV   A,L   
051B   21 00 00               LXI   H,0   
051E   B7                     ORA   A   ; (clears the carry)
051F   CA 2E 05               JZ   mq9   
0522   1F           MQ1:      RAR      ; the next bit
0523   D2 27 05               JNC   mq2   
0526   19                     DAD   D   
0527   EB           MQ2:      XCHG      
0528   29                     DAD   H   ; multiplicand << 1
0529   EB                     XCHG      
052A   B7                     ORA   A   ; bits left? (and clears the carry)
052B   C2 22 05               JNZ   mq1   
052E                          ;*Macro unroll: mq9:    NEXTQ
052E                MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
052E   C3                     DS   CPM*(1-FAST),0C3h   
052F   36                     DS   CPM*(1-FAST),ANXT&0FFh   
0530   01                     DS   CPM*(1-FAST),ANXT/256   
0531                          DS   FAST*CHECKED,0CDh   
0531                          DS   FAST*CHECKED,ACHK&0FFh   
0531                          DS   FAST*CHECKED,ACHK/256   
0531                          DS   FAST,0Ah   
0531                          DS   FAST,03h   
0531                          DS   FAST,0EBh   
0531                          DS   FAST,6Fh   
0531                          DS   FAST,26h   
0531                          DS   FAST,DTPG   
0531                          DS   FAST,7Eh   
0531                          DS   FAST,24h   
0531                          DS   FAST,66h   
0531                          DS   FAST,6Fh   
0531                          DS   FAST,0E9h   
0531   C5           MQ16:     PUSH   B   
0532   44                     MOV   B,H   ; the high byte, for later
0533   7D                     MOV   A,L   
0534   21 00 00               LXI   H,0   
0537   37                     STC      ; the marker
0538   1F                     RAR      
0539   D2 3D 05     MQ3:      JNC   mq4   
053C   19                     DAD   D   
053D   EB           MQ4:      XCHG      
053E   29                     DAD   H   
053F   EB                     XCHG      
0540   FE 01                  CPI   1   ; only the marker left: 8 rounds done (and
0542   1F                     RAR      ;   the carry was clear for the shift)
0543   C2 39 05               JNZ   mq3   
0546   78                     MOV   A,B   
0547   C1                     POP   B   
0548   B7                     ORA   A   
0549   C3 22 05               JMP   mq1   ; the high byte, as a small multiplier
054C                             ; A true ")" reads the block start where it is, on top of the return stack,
054C                             ; instead of popping it and pushing it back; the break key is looked at as
054C                             ; rpushd would.
054C   2A 34 0A     CLOSEQ:   LHLD   RSP   
054F   4E                     MOV   C,M   
0550   23                     INX   H   
0551   46                     MOV   B,M   
0552   21 36 0A               LXI   H,BRKCNT   
0555   35                     DCR   M   
0556   E1                     POP   H   ; (keeps the flags)
0557   CC 84 05               CZ   pollk   
055A                          ;*Macro unroll:  NEXTQ
055A                          DS   (1-CPM)*(1-FAST),0F7h   
055A   C3                     DS   CPM*(1-FAST),0C3h   
055B   36                     DS   CPM*(1-FAST),ANXT&0FFh   
055C   01                     DS   CPM*(1-FAST),ANXT/256   
055D                          DS   FAST*CHECKED,0CDh   
055D                          DS   FAST*CHECKED,ACHK&0FFh   
055D                          DS   FAST*CHECKED,ACHK/256   
055D                          DS   FAST,0Ah   
055D                          DS   FAST,03h   
055D                          DS   FAST,0EBh   
055D                          DS   FAST,6Fh   
055D                          DS   FAST,26h   
055D                          DS   FAST,DTPG   
055D                          DS   FAST,7Eh   
055D                          DS   FAST,24h   
055D                          DS   FAST,66h   
055D                          DS   FAST,6Fh   
055D                          DS   FAST,0E9h   
055D                          ENDIF      
055D                          IF   SBASEU   
055D                             ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
055D                             ; or stored in the same step (x@ is the commonest pair in most programs).
055D                             ; (A checked build checks the stacks between the two, so it keeps them apart.)
055D                LOWER:    EQU   lowq   
055D   87           LOWQ:     ADD   A   
055E   5F                     MOV   E,A   
055F   16 0A                  MVI   D,LETPAGE   ; DE -> the cell
0561   0A                     LDAX   B   
0562   FE 40                  CPI   "@"   
0564   CA 71 05               JZ   lwf   
0567   FE 21                  CPI   "!"   
0569   CA 7B 05               JZ   lws   
056C   E5                     PUSH   H   
056D   EB                     XCHG      ; TOS = the cell's address
056E                          ;*Macro unroll:  NEXT
056E                          DS   (1-CPM)*(1-FAST),0F7h   
056E   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
056F   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0570   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0571   03           LWF:      INX   B   ; x@: TOS = the cell's value
0572   E5                     PUSH   H   
0573   EB                     XCHG      
0574   5E                     MOV   E,M   
0575   23                     INX   H   
0576   56                     MOV   D,M   
0577   EB                     XCHG      
0578                          ;*Macro unroll:  NEXT
0578                          DS   (1-CPM)*(1-FAST),0F7h   
0578   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0579   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
057A   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
057B   03           LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
057C   EB                     XCHG      
057D   73                     MOV   M,E   
057E   23                     INX   H   
057F   72                     MOV   M,D   
0580   E1                     POP   H   
0581                          ;*Macro unroll:  NEXT
0581                          DS   (1-CPM)*(1-FAST),0F7h   
0581   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0582   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0583   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0584                          ENDIF      
0584                             ; =============================================================================
0584                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0584                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0584                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
0584                             ;  the host's KEY and CONOUT routines themselves.
0584                             ; 
0584                             ;  A running program reads the keyboard only through getk and pollk, which
0584                             ;  between them give the break key its rules:
0584                             ;    - Ctrl-C stops the program;
0584                             ;    - any other key that the break check reads is held in KEYBUF for the
0584                             ;      next "?", and a newer one takes its place;
0584                             ;    - "?" (getk) takes the held key first;
0584                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0584                             ;      key like any other, but two of them within about 250 ms still stop it.
0584                             ;  Both are called straight from a handler, never from a routine under one:
0584                             ;  the checked build's report counts on finding one return address above the
0584                             ;  data stack, and TOS in HL.
0584                             ; =============================================================================
0584                          IFN   CPM   
                    RAWK:     EQU   KEY   
0584                          ENDIF      
0584                             ; pollk: the break check (see rpushd).
0584   CD E6 05     POLLK:    CALL   rawk   
0587   C8                     RZ      ; no key
0588   32 7A 0A               STA   KEYBUF   ; held for the next "?"
058B   FE 03        PK1:      CPI   3   ; (getk joins here)
058D   C0                     RNZ      
058E                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
058E                             ; the program has turned it off, wait about 250 ms for one more key: a
058E                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
058E                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
058E   3A 7B 0A     CTLC:     LDA   BRKOFF   
0591   B7                     ORA   A   
0592   CA 7F 01               JZ   brk   
0595   D5                     PUSH   D   
0596   11 E8 03               LXI   D,250*MSLOOP   
0599   CD E6 05     CT1:      CALL   rawk   
059C   C2 A5 05               JNZ   ct2   
059F   1B                     DCX   D   
05A0   7A                     MOV   A,D   
05A1   B3                     ORA   E   
05A2   C2 99 05               JNZ   ct1   
05A5   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
05A6   FE 03                  CPI   3   
05A8   CA 7F 01               JZ   brk   
05AB   B7                     ORA   A   
05AC   CA B2 05               JZ   ct3   
05AF   32 7A 0A               STA   KEYBUF   
05B2   3E 03        CT3:      MVI   A,3   
05B4   B7                     ORA   A   
05B5   C9                     RET      
05B6                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
05B6   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
05B7   21 7A 0A               LXI   H,KEYBUF   ;   the buffer
05BA   7E                     MOV   A,M   
05BB   36 00                  MVI   M,0   
05BD   E1                     POP   H   
05BE   B7                     ORA   A   
05BF   C0                     RNZ      
05C0   CD E6 05               CALL   rawk   
05C3   C8                     RZ      
05C4   C3 8B 05               JMP   pk1   ; Ctrl-C? If not, that is the key
05C7                          IF   1-CHECKED   
05C7                BRK:      EQU   endprog   ; the unchecked build stops without a word;
05C7                          ENDIF      
05C7                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
05C7                          ENDIF      
05C7                          IF   CPM   
05C7                             ; (In a CP/M build the letters and digits are here, out of the way of the
05C7                             ; handlers, which must fit in the image's first two pages. The same code as
05C7                             ; in the generic build.)
05C7                             ; ---- the letters and digits --------------------------------------------------
05C7                             ; a-z: push the cell's address (the cell is the variable)
05C7                          ENDIF      
05C7                          IF   CPM*(1-SBASEU)   
                    LOWER:    PUSH   H   
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
05C7                          ENDIF      
05C7                          IF   CPM   
05C7                             ; A-Z: call the word. The return address (the IP after the letter) goes on
05C7                             ; the return stack, and the IP becomes the address in the letter's cell.
05C7   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
05C8   87                     ADD   A   
05C9   6F                     MOV   L,A   
05CA   26 0A                  MVI   H,LETPAGE   ; HL -> cell
05CC   50                     MOV   D,B   
05CD   59                     MOV   E,C   ; DE = the return address
05CE   4E                     MOV   C,M   
05CF   23                     INX   H   
05D0   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
05D1                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
05D1                             ; go on. Every push of the return stack ends here: for a word call the cell
05D1                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
05D1                             ; the one that was used up.
05D1                             ; 
05D1                             ; The break key is looked at here, so at every word call and loop-back (and
05D1                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
05D1                             ; the keyboard can be slow (it is a BDOS call under CP/M).
05D1   2A 34 0A     RPUSHD:   LHLD   RSP   
05D4   2B                     DCX   H   
05D5   72                     MOV   M,D   
05D6   2B                     DCX   H   
05D7   73                     MOV   M,E   
05D8   22 34 0A               SHLD   RSP   
05DB   21 36 0A               LXI   H,BRKCNT   
05DE   35                     DCR   M   
05DF   E1                     POP   H   ; (keeps the flags)
05E0   CC 84 05               CZ   pollk   
05E3                          ;*Macro unroll:  NEXT
05E3                          DS   (1-CPM)*(1-FAST),0F7h   
05E3   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
05E4   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
05E5   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
05E6   3E FF        RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
05E8                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
05E8                             ; printing and could swallow a key that BDOS 6 then never sees.
05E8   C5           PUTC:     PUSH   B   
05E9   D5                     PUSH   D   
05EA   E5                     PUSH   H   
05EB   5F                     MOV   E,A   
05EC   0E 06                  MVI   C,6   
05EE   CD 05 00               CALL   BDOS   
05F1   E1                     POP   H   
05F2   D1                     POP   D   
05F3   C1                     POP   B   
05F4   B7                     ORA   A   ; (for getk)
05F5   C9                     RET      
05F6                          ENDIF      
05F6                             ; =============================================================================
05F6                             ;  Checked build: the checks and the error report
05F6                             ; =============================================================================
05F6                          IF   CHECKED   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
05F6                          ENDIF      
05F6                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
05F6                          ENDIF      
05F6                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
05F6                          ENDIF      
05F6                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address (errp drops
                              MVI   A,"H"   ;   the old top)
                              JMP   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
05F6                          ENDIF      
05F6                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
05F6                          ENDIF      
05F6                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
05F6                          ENDIF      
05F6                          IF   CHECKED   
                                 ; Two error entries for errors found inside a routine: the first hides the
                                 ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
                                 ; return address.
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   prs0   
                              CPI   7Fh   
                              JC   pesc   
                    PRS0:     ANI   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,10   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   D   
                              POP   H   
                              CALL   chkstk   
                              PUSH   H   
                              LHLD   PSAVE   
                              DB   11h   ; (LXI D hides e_quote's first two bytes)
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   D   
                              POP   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   "D:",22h   
                              LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
                              DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
                              ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
                              DS   1-CPM,0E7h   ;   first value and holds nothing)
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              MOV   A,H   
                              CALL   phal2   ; the depth
                              MVI   A,":"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                    PHAL2:    ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
05F6                          ENDIF      
05F6                             ; =============================================================================
05F6                             ;  Startup
05F6                             ; =============================================================================
05F6                START:       
05F6                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
05F6                          ENDIF      
05F6                          IF   QK   
05F6   21 00 07               LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
05F9   AF                     XRA   A   ;   start of 0000h matches no skip)
05FA   77           SKC1:     MOV   M,A   
05FB   2C                     INR   L   
05FC   C2 FA 05               JNZ   skc1   
05FF                          ENDIF      
05FF                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
05FF                          ENDIF      
05FF                          IF   CPM   
05FF                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
05FF   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
0602   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
0604   CD 05 00               CALL   BDOS   ;   and the program is empty)
0607   11 00 0B               LXI   D,PROG   
060A   D5           LD1:      PUSH   D   
060B   0E 1A                  MVI   C,26   ; set the DMA address
060D   CD 05 00               CALL   BDOS   
0610   11 5C 00               LXI   D,005Ch   
0613   0E 14                  MVI   C,20   ; read the next 128 bytes
0615   CD 05 00               CALL   BDOS   
0618   E1                     POP   H   ; HL = the address this record went to
0619   B7                     ORA   A   
061A   C2 25 06               JNZ   ld2   
061D   11 80 00               LXI   D,128   
0620   19                     DAD   D   
0621   EB                     XCHG      
0622   C3 0A 06               JMP   ld1   
0625   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0627   23                     INX   H   ; the heap starts after it
0628                          ENDIF      
0628                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
0628                          ENDIF      
0628   22 7C 0A               SHLD   HEAP   
062B                          IF   CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              SHLD   NPEND   ;   release below it
062B                          ENDIF      
062B   21 E0 08               LXI   H,RSTOP   ; the return stack is empty
062E   22 34 0A               SHLD   RSP   
0631                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
0631                          ENDIF      ;   checked build has cleared these)
0631                          IF   (1-CHECKED)*CPM   
0631   21 00 00               LXI   H,0   
0634                          ENDIF      
0634                          IF   1-CHECKED   
0634   22 7A 0A               SHLD   KEYBUF   
0637                          ENDIF      
0637   01 00 0B               LXI   B,PROG   ; the IP
063A                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
063A                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
063A   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
063B   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
063C   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
063D                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
                                 ; 
                                 ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
                                 ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
                                 ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
                                 ;  the letters and digits have one entry each, which knows its cell or its
                                 ;  value already.
                                 ; =============================================================================
                    FTSTORE:   XCHG      ; !
                              JMP   h_store   
                    FTSTR:    XCHG      ; "
                              JMP   h_str   
                    FTNUM:    XCHG      ; #
                              JMP   h_num   
                    FTPRINT:   XCHG      ; $
                              JMP   h_print   
                    FTEMIT:   XCHG      ; '
                              JMP   h_emit   
                    FTCSTORE:   XCHG      ; .
                              JMP   h_cstore   
                    FTDIV:    XCHG      ; /
                              JMP   h_div   
                    FTKEY:    XCHG      ; ?
                              JMP   h_key   
                    FTDEF:    XCHG      ; [
                              JMP   h_def   
                    FTBREAK:   XCHG      ; \
                              JMP   h_break   
                    FTALLOC:   XCHG      ; _
                              JMP   h_alloc   
                    FTGRAVE:   XCHG      ; `
                              JMP   h_grave   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:   POP   H   ; +
                              DAD   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:   LDAX   B   ; -
                              SUI   "0"   
                              CPI   10   
                              JC   fs_neg   
                              POP   H   
                              MOV   A,L   
                              SUB   E   
                              MOV   E,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   D,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   XCHG      ; a digit next: a negative number
                              JMP   negnum   
                    FS_DUP:   PUSH   D   ; :
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:   POP   H   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:   POP   H   ; %
                              PUSH   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:   XCHG      ; @
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:   LDAX   D   ; ,
                              MOV   E,A   
                              MVI   D,0   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:    POP   H   ; < (HL = a, DE = b: the borrow of a - b, flipped if the signs differ)
                              MOV   A,L   
                              SUB   E   
                              MOV   A,H   
                              SBB   D   
                              SBB   A   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              RAL      
                              SBB   A   
                              XRA   L   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:    POP   H   ; > (b < a: the borrow of b - a)
                              MOV   A,E   
                              SUB   L   
                              MOV   A,D   
                              SBB   H   
                              SBB   A   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              RAL      
                              SBB   A   
                              XRA   L   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
