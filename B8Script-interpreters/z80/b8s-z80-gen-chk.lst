024C   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
024D   2A 34 82               LD   HL,(RSAVE)   ;   and put the string's address back in TOS
0250   3E 51                  LD   A,"Q"   
0252   C3 11 04               JP   error   
0255                          ENDIF      
0255                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0255                             ; HL points past it. Each goes back into the loop that prints the string
0255                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0255                             ;    /a-/z   print the variable, as "#" does
0255                             ;    /{      clear the screen, the cursor to the top left
0255                             ;    /}      clear from the cursor to the end of the line
0255                             ;    /|  /`  show the cursor, hide it
0255                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0255   FE 7E        PESC:     CP   7Eh   
0257   28 1C                  JR   Z,pat   
0259   11 25 02               LD   DE,PRLOOP   ; the others return into the loop
025C   D5                     PUSH   DE   
025D   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
025F   30 25                  JR   NC,pcon   
0261   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0263   30 1D                  JR   NC,phide   
0265   87                     ADD   A,A   ; the variable's cell
0266   C6 40                  ADD   A,40h   
0268   E5                     PUSH   HL   
0269   6F                     LD   L,A   
026A   26 82                  LD   H,LETPAGE   
026C   7E                     LD   A,(HL)   
026D   2C                     INC   L   
026E   66                     LD   H,(HL)   
026F   6F                     LD   L,A   
0270   CD 2F 03               CALL   psgn   
0273   E1                     POP   HL   
0274   C9                     RET      
0275                             ; /~ ( row col addr -- ): the two cells under the string's address go. Where
0275                             ; "$" is the routine prstr, its own return address goes first, and hp1
0275                             ; calls it again afterwards. (The checked build looks first, through
0275                             ; chkstk, that there is a column at least: with less, it is s. With a
0275                             ; column but no row it is s after the "$", as for any other character; the
0275                             ; spare bytes above the stack take what is written meanwhile.)
0275                PAT:         
0275                          IF   PRSUB   
0275   D1                     POP   DE   
0276                          ENDIF      
0276                          IF   CHECKED   
0276   CD A7 03               CALL   chkstk   
0279                          ENDIF      
