  1575                              <1> .nx1:   ret
  1576                              <1> 
  1577                              <1> ; prl: print the line at ESI, to its LF; ESI -> just past it.
  1578                              <1> prl:    lodsb
  1579                              <1>         call    putc
  1580                              <1>         cmp     al,10
  1581                              <1>         jne     prl
  1582                              <1>         ret
  1583                              <1> 
  1584                              <1> ; ^R: read the file. ^W: write the file (made anew, or emptied first). A
  1585                              <1> ; name typed before the key is the file's name from now on. (A file that
  1586                              <1> ; can't be made or written is not noticed: nothing is written.)
