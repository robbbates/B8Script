039E                          IF   CPM   
                                 ; RAM pages, after the image
                    CPAGE:    EQU   (imgend + 255) / 256   ; the skip cache (QK builds), first, so
                    RSPAGE:   EQU   CPAGE + QK   ;   that the letter page is still the one
                    DSPAGE:   EQU   RSPAGE + 1   ;   just below the program text
