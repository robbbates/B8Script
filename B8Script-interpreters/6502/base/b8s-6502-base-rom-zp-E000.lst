E236   A5 00                  LDA   IP   
E238   48                     PHA      
E239   4C 07 E5               JMP   pnext   ; a loop-back: the break check
E23C                             ; "{" TOS to the return stack, "}" return stack to TOS
E23C   68           H_TOR:    PLA      
E23D   68                     PLA      
E23E   B5 01                  LDA   1,X   
