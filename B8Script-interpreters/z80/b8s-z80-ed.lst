0537   50 72 6F 67 20 22      DB   "Prog ",22h   
053D   CD 77 02               CALL   pdec   ; the program's size
0540   E1                     POP   HL   
0541   CD 3C 03               CALL   pnl   
0544   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
054B   CD 77 02               CALL   pdec   
054E   D1                     POP   DE   
