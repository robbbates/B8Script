032F   19                     ADD   HL,DE   
0330   0D                     DEC   C   
0331   0C           UVR9:     INC   C   
0332   CB 21                  SLA   C   
0334   17                     RLA      
0335   ED 6A                  ADC   HL,HL   
0337   ED 52                  SBC   HL,DE   
0339   30 02                  JR   NC,uvr10   
033B   19                     ADD   HL,DE   
033C   0D                     DEC   C   
033D   0C           UVR10:    INC   C   
033E   CB 21                  SLA   C   
0340   17                     RLA      
0341   ED 6A                  ADC   HL,HL   
0343   ED 52                  SBC   HL,DE   
0345   30 02                  JR   NC,uvr11   
0347   19                     ADD   HL,DE   
0348   0D                     DEC   C   
0349   0C           UVR11:    INC   C   
