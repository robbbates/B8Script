E86A   38                     SEC      
E86B   B5 FE                  LDA   0FEh,X   
E86D   E5 05                  SBC   D0   
E86F   A8                     TAY      
E870   B5 FF                  LDA   0FFh,X   
E872   E5 06                  SBC   D1   
E874   90 06                  BCC   uv7   
E876   95 FF                  STA   0FFh,X   
E878   94 FE                  STY   0FEh,X   
E87A   F6 00                  INC   0,X   
