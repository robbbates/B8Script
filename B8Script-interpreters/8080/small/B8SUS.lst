027D                          ENDIF      
027D                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
027D                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
027D                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
027D                             ; stops on it.
027D                H_DIV:       
027D                          IF   CHECKED   
                              MOV   A,H   
                              ORA   L   
                              JZ   e_zero   
027D                          ENDIF      
