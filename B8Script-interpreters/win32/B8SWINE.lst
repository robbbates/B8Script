  1889                              <1> ; =============================================================================
  1890                              <1> ;  The inner loop: read one character and sort it by range.
  1891                              <1> ;
  1892                              <1> ;    00h          end of program
  1893                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1894                              <1> ;                 build stops on 80h-FFh: X)
  1895                              <1> ;    30h-39h      digit: read a whole number
  1896                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1897                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1898                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1899                              <1> ; =============================================================================
  1900                              <1> ; Digits: step back onto the first digit and read the whole number.
  1901 00000918 53                  <1> digit:  push    ebx
  1902 00000919 4E                  <1>         dec     esi
  1903                              <1>         CALLP   rdnum
   192                              <2>  %if P_%1
   193 0000091A FF55DA              <2>  call [V(p_%1)]
   194                              <2>  %else
   195                              <2>  call %1
   196                              <2>  %endif
  1904 0000091D FFE5                <1>         jmp     ebp
  1905                              <1> 
  1906                              <1> ; a-z: push the cell's address (the cell is the variable).
  1907 0000091F 53                  <1> lower:  push    ebx
  1908 00000920 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1909 00000927 FFE5                <1>         jmp     ebp
  1910                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1911                              <1> ; next in reach)
  1912 00000929 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1913 0000092B 7505                <1>         jnz     next                    ; the rest are ignored
  1914 0000092D E901FCFFFF          <1>         jmp     endprog
  1915                              <1> %if CHECKED
  1916                              <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1917                              <1>         jmp     error
  1918                              <1> %endif
  1919                              <1> next:
  1920                              <1> %if CHECKED
  1921                              <1>         call    chkstk                  ; both stacks, once per character
  1922                              <1> %endif
  1923 00000932 31C0                <1>         xor     eax,eax
  1924 00000934 AC                  <1>         lodsb
  1925 00000935 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1926 00000937 72F0                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1927 00000939 3C0F                <1>         cmp     al,0Fh
  1928 0000093B 7226                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1929 0000093D 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1930 0000093F 3C0A                <1>         cmp     al,0Ah
  1931 00000941 72D5                <1>         jb      digit                   ; 30h-39h
  1932 00000943 3C11                <1>         cmp     al,11h
  1933 00000945 721A                <1>         jb      p3a                     ; 3Ah-40h
  1934 00000947 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1935 00000949 3C1A                <1>         cmp     al,1Ah
  1936 0000094B 0F829CF7FFFF        <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1937 00000951 3C20                <1>         cmp     al,20h
  1938 00000953 720A                <1>         jb      p5b                     ; 5Bh-60h
  1939 00000955 3C3A                <1>         cmp     al,3Ah
  1940 00000957 72C6                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1941 00000959 3C3E                <1>         cmp     al,3Eh
  1942                              <1> %if CHECKED
  1943                              <1>         je      next                    ; 7Fh, DEL: ignored
  1944                              <1>         jae     e_hi                    ; 80h-FFh: reserved
  1945                              <1> %else
  1946 0000095B 73D5                <1>         jae     next                    ; 7Fh-FFh: ignored
  1947                              <1> %endif
  1948 0000095D 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1949 0000095F 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1950 00000961 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1951 00000963 8A80[51070000]      <1> punct:  mov     al,[ptab+eax]
  1952 00000969 8D80[11010000]      <1>         lea     eax,[hbase+eax]
