F391                             ; the program's top cell, at ,U.
F391   34 40                  PSHS   U   ; where the walk ends
F393   CC 81 FC               LDD   #DSTOP   
F396   A3 E4                  SUBD   ,S   
F398   8D 3F                  BSR   pdh   ; the depth (pdec leaves U as it was)
F39A   8D B5                  BSR   pmsg   
F39C   BA                     FCB   ":"+80h   
F39D   31 C8 10               LEAY   16,U   ; past the 8th cell from the top ...
F3A0   10 8C 81 FC            CMPY   #DSTOP   
F3A4   24 08                  BHS   sl1   
F3A6   8D A9                  BSR   pmsg   ; (there are more than 8)
F3A8   20 2E 2E AE            FCB   " ..","."+80h   
F3AC   20 04                  BRA   sl2   
F3AE   10 8E 81 FC  SL1:      LDY   #DSTOP   ; ... or the whole stack, if no more than 8
F3B2   10 AC E4     SL2:      CMPY   ,S   
F3B5   23 0B                  BLS   sl9   
F3B7   EC A3                  LDD   ,--Y   
F3B9   36 06                  PSHU   D   
F3BB   8D 94                  BSR   pmsg   
F3BD   A0                     FCB   " "+80h   
F3BE   8D 1F                  BSR   h_num   
F3C0   20 F0                  BRA   sl2   
F3C2   8D 8D        SL9:      BSR   pmsg   
F3C4   0D 0A 52 74 6E A0      FCB   13,10,"Rtn"," "+80h   
F3CA   CC 81 00               LDD   #RSTOP   ; the return stack's depth, (RSTOP - S) / 2,
F3CD   93 3A                  SUBD   <SSAV   ;   S as it was when this character began
F3CF   8D 08                  BSR   pdh   
F3D1   BD F3 51               JSR   pmsg   
F3D4   0D 8A                  FCB   13,10+80h   
F3D6   7E FF 09               JMP   EXIT   
F3D9                             ; pdh: print D/2 (a depth: D is twice it), unsigned.
F3D9   44           PDH:      LSRA      
F3DA   56                     RORB      
F3DB   36 06                  PSHU   D   
F3DD   20 0A                  BRA   pdec   
F3DF                          ENDIF      
F3DF                             ; "#" prints TOS as a signed decimal number, with no space after it.
F3DF   6D C4        H_NUM:    TST   ,U   
F3E1   2A 06                  BPL   pdec   
F3E3   86 2D                  LDA   #"-"   
F3E5   8D 1A                  BSR   putc   
F3E7   8D 5E                  BSR   negt   
