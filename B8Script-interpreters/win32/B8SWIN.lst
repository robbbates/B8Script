   675                              <1> ; =============================================================================
   676                              <1> ;  Checked build: the checks and the error report (here, so that the
   677                              <1> ;  handlers' bodies above reach the error entries with short jumps)
   678                              <1> ; =============================================================================
   679                              <1> %if CHECKED
   680                              <1> e_zero: mov     al,'Z'                  ; dividing by zero
   681                              <1>         jmp     error
   682                              <1> e_heap: mov     al,'H'                  ; the heap
   683                              <1>         jmp     error
   684                              <1> 
   685                              <1> ; chkst1, chkst2: stop with O unless the 1 or 2 bytes at TOS are in the
   686                              <1> ; program's space: from the letter page up to the heap limit. Memory above
   687                              <1> ; the heap top but below the limit is the program's own: Tiny BASIC keeps
   688                              <1> ; its lines there.
   689                              <1> chkst2: mov     eax,ebx
   690                              <1>         sub     ax,LET
   691                              <1>         cmp     ax,LIMIT-LET-1
   692                              <1>         jmp     short chs1
   693                              <1> chkst1: mov     eax,ebx
   694                              <1>         sub     ax,LET
   695                              <1>         cmp     ax,LIMIT-LET
   696                              <1> chs1:   jae     e_store
   697                              <1>         ret
   698                              <1> 
   699                              <1> ; chkstk: both stacks are checked once per character, not in every handler.
   700                              <1> ; A character can pop a cell or two too many, or push one too many, before
   701                              <1> ; it is seen here: the data stack has the caller's frame above it and the
   702                              <1> ; thread's stack below, and the return stack has the image's spare space on
   703                              <1> ; both sides.
   704                              <1> chkstk: lea     eax,[esp+4]
   705                              <1>         sub     eax,[V(v_dstop)]        ; minus 4 x the depth
   706                              <1>         jg      e_under
   707                              <1>         cmp     eax,-4*DSMAX
   708                              <1>         jl      e_over
   709                              <1>         cmp     di,RSTOP & 0FFFFh       ; (the return stack is in one 64K: only
   710                              <1>         ja      e_rund                  ;   the low word changes)
   711                              <1>         cmp     di,(RSTOP-4*RSMAX) & 0FFFFh
   712                              <1>         jb      e_rover
   713                              <1>         ret
   714                              <1> e_under:mov     esp,[V(v_dstop)]        ; data stack underflow: it counts as
   715                              <1>         mov     al,'s'                  ;   empty
   716                              <1>         jmp     short error
   717                              <1> e_rund: mov     edi,RSTOP               ; return stack underflow: the same.
