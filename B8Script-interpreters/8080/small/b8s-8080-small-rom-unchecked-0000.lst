                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FVST:     INX   B   ; x!: the cell = TOS, and NOS comes up
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXTF
