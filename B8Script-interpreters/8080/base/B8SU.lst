03CF                             ; "$" prints the string at TOS (see h_print).
03CF   7E           PRLP:     MOV   A,M   
03D0   23                     INX   H   
03D1   FE 22                  CPI   22h   
03D3   CA A6 02               JZ   h_drop   
03D6   FE 2F                  CPI   "/"   
03D8   C2 E9 03               JNZ   pr1   
03DB   7E                     MOV   A,M   
03DC   23                     INX   H   
03DD   FE 60                  CPI   60h   
03DF   DA E7 03               JC   pr0   
03E2   FE 7F                  CPI   7Fh   
03E4   DA EF 03               JC   pesc   
03E7   E6 BF        PR0:      ANI   0BFh   
