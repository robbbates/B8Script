01EE   5F                     MOV   E,A   ;   lands 64 bytes up
01EF   E6 DF                  ANI   0DFh   ; fold case
01F1   FE 1A                  CPI   26   
01F3   D2 03 02               JNC   def2   ; not a letter
01F6   7B                     MOV   A,E   
01F7   87                     ADD   A   
01F8   5F                     MOV   E,A   
01F9   16 0B                  MVI   D,LETPAGE   ; DE -> cell
01FB   79                     MOV   A,C   
01FC   12                     STAX   D   
01FD   1C                     INR   E   
01FE   78                     MOV   A,B   
01FF   12                     STAX   D   
