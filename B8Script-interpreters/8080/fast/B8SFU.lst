04CA                             ; (The table goes here instead in the builds where, before the routines, it
04CA                             ; would cross a page: PTLATE. If it would cross one here too, it starts on
04CA                             ; the next page: PTPAD is 0 unless it must.)
04CA                          IF   (1-FAST)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
04CA                          ENDIF      
04CA                          IF   1-CHECKED   
04CA                             ; "$" prints the string at TOS (see h_print).
04CA   7E           PRLP:     MOV   A,M   
04CB   23                     INX   H   
04CC   FE 22                  CPI   22h   
04CE   CA 6B 02               JZ   h_drop   
04D1   FE 2F                  CPI   "/"   
04D3   C2 E4 04               JNZ   pr1   
04D6   7E                     MOV   A,M   
04D7   23                     INX   H   
04D8   FE 60                  CPI   60h   
04DA   DA E2 04               JC   pr0   
04DD   FE 7F                  CPI   7Fh   
04DF   DA EA 04               JC   pesc   
04E2   E6 BF        PR0:      ANI   0BFh   
04E4                          ;*Macro unroll: pr1:    PUTA
04E4                PR1:      DS   1-CPM,0EFh   
04E4   CD                     DS   CPM,0CDh   
04E5   D4                     DS   CPM,APUT&0FFh   
04E6   06                     DS   CPM,APUT/256   
04E7   C3 CA 04               JMP   prlp   
04EA                          ENDIF      
04EA                             ;-----------------------------------------------------------------------------
04EA                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
04EA                             ; HL points past it. Each goes back into the loop that prints the string
04EA                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
04EA                             ;    /a-/z   print the variable, as "#" does
04EA                             ;    /{      clear the screen, the cursor to the top left
04EA                             ;    /}      clear from the cursor to the end of the line
04EA                             ;    /|  /`  show the cursor, hide it
04EA                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
04EA   FE 7E        PESC:     CPI   7Eh   
04EC   CA 0F 05               JZ   pat   
04EF   11 CA 04               LXI   D,PRLOOP   ; the others return into the loop
04F2   D5                     PUSH   D   
04F3   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
04F5   D2 47 05               JNC   pcon   
04F8   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
04FA   D2 31 05               JNC   phide   
04FD   87                     ADD   A   ; the variable's cell
04FE   C6 40                  ADI   40h   
0500   E5                     PUSH   H   
0501   C5                     PUSH   B   
0502   6F                     MOV   L,A   
0503   26 16                  MVI   H,LETPAGE   
0505   7E                     MOV   A,M   
0506   2C                     INR   L   
0507   66                     MOV   H,M   
0508   6F                     MOV   L,A   
0509   CD A9 04               CALL   psgn   
050C   C1                     POP   B   
050D   E1                     POP   H   
050E   C9                     RET      
050F                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
050F                             ; the checked build "$" is the routine prstr: its own return address goes
050F                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
050F                             ; its two cells are there, and is s if not, before it prints anything.
050F                PAT:         
050F                          IF   CHECKED   
                              XTHL      ; the text pointer over prstr's return address
                              LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              DAD   SP   
                              JC   e_under   
                              POP   H   
050F                          ENDIF      
050F   D1                     POP   D   ; DE = the column
0510   E3                     XTHL      ; HL = the row; the text pointer is kept
0511                          IF   1-ANS   
                              CALL   CONAT   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JZ   CONCLS   ; /{
                              CPI   2   
                              JZ   CONEOL   ; /}
                              DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
                    PHIDE:    XRA   A   ; /`  (A = 0: hide)
                              JMP   CONCUR   
0511                          ENDIF      
0511                          IF   ANS   
0511   C5                     PUSH   B   ; (pdec uses BC)
0512   D5                     PUSH   D   
0513   CD 60 05               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0516   23                     INX   H   
0517   CD B6 04               CALL   pdec   
051A   3E 3B                  MVI   A,";"   
051C                          ;*Macro unroll:  PUTA
051C                          DS   1-CPM,0EFh   
051C   CD                     DS   CPM,0CDh   
051D   D4                     DS   CPM,APUT&0FFh   
051E   06                     DS   CPM,APUT/256   
051F   E1                     POP   H   
0520   23                     INX   H   
0521   CD B6 04               CALL   pdec   
0524   3E 48                  MVI   A,"H"   
0526                          ;*Macro unroll:  PUTA
0526                          DS   1-CPM,0EFh   
0526   CD                     DS   CPM,0CDh   
0527   D4                     DS   CPM,APUT&0FFh   
0528   06                     DS   CPM,APUT/256   
0529   C1                     POP   B   
052A   E1                     POP   H   
052B   C3 CA 04               JMP   PRAGAIN   
052E                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
052E   1E 68        PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
0530   DA                     DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
0531   1E 6C        PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
0533   3E 3F                  MVI   A,"?"   
0535   CD 57 05               CALL   csia   
0538   3E 32                  MVI   A,"2"   
053A                          ;*Macro unroll:  PUTA
053A                          DS   1-CPM,0EFh   
053A   CD                     DS   CPM,0CDh   
053B   D4                     DS   CPM,APUT&0FFh   
053C   06                     DS   CPM,APUT/256   
053D   3E 35                  MVI   A,"5"   
053F                          ;*Macro unroll:  PUTA
053F                          DS   1-CPM,0EFh   
053F   CD                     DS   CPM,0CDh   
0540   D4                     DS   CPM,APUT&0FFh   
0541   06                     DS   CPM,APUT/256   
0542   7B                     MOV   A,E   
0543                          ;*Macro unroll:  PUTA
0543                          DS   1-CPM,0EFh   
0543   CD                     DS   CPM,0CDh   
0544   D4                     DS   CPM,APUT&0FFh   
0545   06                     DS   CPM,APUT/256   
0546   C9                     RET      
0547                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0547   3D           PCON:     DCR   A   
0548   CA 2E 05               JZ   pshow   ; /|
054B   3E 4B                  MVI   A,"K"   
054D   F2 57 05               JP   csia   ; /}  ESC [ K
0550   3E 48                  MVI   A,"H"   ; /{  ESC [ H ESC [ J
0552   CD 57 05               CALL   csia   
0555   3E 4A                  MVI   A,"J"   ; (on into csia)
0557                             ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
0557   F5           CSIA:     PUSH   PSW   
0558   CD 60 05               CALL   csi   
055B   F1                     POP   PSW   
055C                          ;*Macro unroll:  PUTA
055C                          DS   1-CPM,0EFh   
055C   CD                     DS   CPM,0CDh   
055D   D4                     DS   CPM,APUT&0FFh   
055E   06                     DS   CPM,APUT/256   
055F   C9                     RET      
0560   3E 1B        CSI:      MVI   A,27   
0562                          ;*Macro unroll:  PUTA
0562                          DS   1-CPM,0EFh   
0562   CD                     DS   CPM,0CDh   
0563   D4                     DS   CPM,APUT&0FFh   
0564   06                     DS   CPM,APUT/256   
0565   3E 5B                  MVI   A,"["   
0567                          ;*Macro unroll:  PUTA
0567                          DS   1-CPM,0EFh   
0567   CD                     DS   CPM,0CDh   
0568   D4                     DS   CPM,APUT&0FFh   
0569   06                     DS   CPM,APUT/256   
056A   C9                     RET      
056B                          ENDIF      
056B                             ; skip: read past text to the closer at this level, and return A = 0 if it
056B                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
056B                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
056B                             ; no closer; anything else that runs into the NUL had unbalanced brackets
056B                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
056B                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
056B                             ; 
056B                             ; The checked build also looks at the character the skip was started by,
056B                             ; which is always the one just before where it starts: "(" must end at ")",
056B                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
056B                             ; quote counts as running into it. "\" takes either closer. The place where
056B                             ; the skip started is kept on the stack, for the report.
056B                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
056B                          ENDIF      
056B                          IF   CHECKED*(1-QK)   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
056B                          ENDIF      
056B                          IF   1-QK   
                              MVI   D,0   
                    SK3:      INR   D   ; an opener: one deeper
                    SK1:      LDAX   B   
056B                          ENDIF      
056B                          IF   (1-CHECKED)*(1-QK)   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
056B                          ENDIF      
056B                          IF   CHECKED*(1-QK)   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
056B                          ENDIF      
056B                          IF   1-QK   
                              CPI   22h   
                              CZ   skipstr   ; leaves A = 22h, which matches nothing below
                              SUI   "("   ;   (or 0, and then the NUL is read next)
                              JZ   sk3   
                              DCR   A   ; ")"
                              JZ   sk4   
                              SUI   "["-")"   
                              JZ   sk3   
                              CPI   "]"-"["   
                              JNZ   sk1   
                    SK4:      DCR   D   
056B                          ENDIF      
056B                          IF   (1-CHECKED)*(1-QK)   
                              RZ      ; the closer at this level
                              JMP   sk1   
056B                          ENDIF      
056B                          IF   CHECKED*(1-QK)   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
056B                          ENDIF      
056B                          IF   QK   
056B                             ; The skip cache. Nearly every skip is one that has happened before (a loop
056B                             ; skips the same false block on every pass), so the first scan from each
056B                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
056B                             ; by the start's low byte (times 4). Only skips that start in the program
056B                             ; text are kept (the line buffer changes); the cache is emptied whenever a
056B                             ; run starts (see start). A program that changes its own text while it
056B                             ; runs is not looked after.
056B   78           SKIP:     MOV   A,B   
056C   FE 17                  CPI   PROG/256   
056E   DA 8E 05               JC   sks   ; below the program text: no cache
0571   79                     MOV   A,C   
0572   87                     ADD   A   
0573   87                     ADD   A   
0574   5F                     MOV   E,A   
0575   16 13                  MVI   D,CPAGE   ; DE -> the entry
0577   1A                     LDAX   D   
0578   B9                     CMP   C   
0579   C2 8E 05               JNZ   sks   
057C   1C                     INR   E   
057D   1A                     LDAX   D   
057E   B8                     CMP   B   
057F   C2 8E 05               JNZ   sks   
0582   1C                     INR   E   
0583   1A                     LDAX   D   
0584   4F                     MOV   C,A   
0585   1C                     INR   E   
0586   1A                     LDAX   D   
0587   47                     MOV   B,A   ; a hit: the IP is past the closer
0588   0B                     DCX   B   
0589   0A                     LDAX   B   
058A   03                     INX   B   
058B   D6 29                  SUI   ")"   ; 0 for ")", not 0 for "]"
058D   C9                     RET      
058E   C5           SKS:      PUSH   B   ; where it starts: the cache's key (and the
058F                          ENDIF      ;   checked report's place)
058F                          IF   QK*CHECKED   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
058F                          ENDIF      
058F                          IF   QK   
058F                             ; The scan. Most characters are nothing to it, and two range tests rule
058F                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
058F   16 00                  MVI   D,0   
0591   14           SQ3:      INR   D   ; an opener: one deeper
0592   0A           SQ1:      LDAX   B   
0593   03                     INX   B   
0594   FE 5E                  CPI   5Eh   
0596   D2 92 05               JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
0599   FE 5B                  CPI   5Bh   
059B   D2 BD 05               JNC   sqb   ; [ \ ]
059E   FE 2A                  CPI   2Ah   
05A0   D2 92 05               JNC   sq1   ; * to Z: nothing
05A3   FE 28                  CPI   28h   
05A5   CA 91 05               JZ   sq3   ; (
05A8   D2 C8 05               JNC   sqc   ; )
05AB   FE 22                  CPI   22h   
05AD   CA B7 05               JZ   sqq   ; a string
05B0   B7                     ORA   A   
05B1   C2 92 05               JNZ   sq1   ; the rest below "(": nothing
05B4                          ENDIF      
05B4                          IF   QK*(1-CHECKED)   
05B4   C3 41 01               JMP   endprog   ; NUL: the end of the program
05B7                          ENDIF      
05B7                          IF   QK*CHECKED   
                              DCX   B   ; NUL: the IP stays on it
                              MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SQ7:      MVI   A,"N"   ; N. The place is the opener
                              JMP   errp   ; (errp drops skip's return address)
05B7                          ENDIF      
05B7                          IF   QK   
05B7   CD EA 05     SQQ:      CALL   skipstr   ; step over the string
05BA   C3 92 05               JMP   sq1   
05BD   D6 5C        SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
05BF   CA 92 05               JZ   sq1   ; "\" is nothing here
05C2   DA 91 05               JC   sq3   ; [
05C5   3E 02                  MVI   A,2   ; ]
05C7   FE                     DB   0FEh   ; (CPI: steps over the XRA)
05C8   AF           SQC:      XRA   A   ; )
05C9   15           SQ4:      DCR   D   
05CA   C2 92 05               JNZ   sq1   
05CD                          ENDIF      
05CD                          IF   QK*CHECKED   
                              MOV   D,A   ; the closer at this level (as above): 2 here
                              XRA   E   ;   means the wrong closer
                              ANI   6   
                              CPI   2   
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              JNZ   sq8   
                              MOV   B,D   
                              MOV   C,E   
                              JMP   sq7   
                    SQ8:         
05CD                          ENDIF      
05CD                          IF   QK*(1-CHECKED)   
05CD   D1                     POP   D   ; where the skip started
05CE                          ENDIF      
05CE                          IF   QK   
05CE                             ; The closer at this level: remember the skip (if it started in the program
05CE                             ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
05CE   E5                     PUSH   H   
05CF   67                     MOV   H,A   
05D0   7A                     MOV   A,D   
05D1   FE 17                  CPI   PROG/256   
05D3   DA E6 05               JC   sq9   
05D6   7B                     MOV   A,E   
05D7   87                     ADD   A   
05D8   87                     ADD   A   
05D9   6F                     MOV   L,A   
05DA   7C                     MOV   A,H   
05DB   26 13                  MVI   H,CPAGE   
05DD   73                     MOV   M,E   
05DE   2C                     INR   L   
05DF   72                     MOV   M,D   
05E0   2C                     INR   L   
05E1   71                     MOV   M,C   
05E2   2C                     INR   L   
05E3   70                     MOV   M,B   
05E4   E1                     POP   H   
05E5   C9                     RET      
05E6   7C           SQ9:      MOV   A,H   
05E7   E1                     POP   H   
05E8   C9                     RET      
05E9                          ENDIF      
05E9                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
05E9                             ; the next character, so "/"" does not end it. Leaves A = 22h.
05E9                          IF   1-CHECKED   
05E9   03           SS0:      INX   B   
05EA   0A           SKIPSTR:   LDAX   B   
05EB   03                     INX   B   
05EC   FE 2F                  CPI   "/"   
05EE   CA E9 05               JZ   ss0   
05F1   FE 22                  CPI   22h   
05F3   C2 EA 05               JNZ   skipstr   
05F6   C9                     RET      
05F7                          ENDIF      
05F7                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
05F7                          ENDIF      
05F7                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
05F7                             ; and return its value in A with the carry set; otherwise leave the IP and
05F7                             ; return with the carry clear.
05F7   0A           HEXC:     LDAX   B   
05F8   D6 30                  SUI   "0"   
05FA   FE 0A                  CPI   10   
05FC   DA 08 06               JC   hc1   
05FF   E6 DF                  ANI   0DFh   
0601   D6 11                  SUI   11h   
0603   FE 06                  CPI   6   
0605   D0                     RNC      
0606   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
0608   03           HC1:      INX   B   
0609   C9                     RET      
060A                             ;  ---- Speed-ups (base builds) -------------------------------------------
060A                             ;  The skip cache and "/" by a power of two are above. These are the
060A                             ;  handlers' tails that the builds with room take, kept here, out of the
060A                             ;  handlers' first two pages.
060A                          IF   QK   
060A                             ; "*" with an operand below 256: that one becomes the multiplier, a byte in
060A                             ; A, and the loop stops as soon as its bits are used up (most
060A                             ; multiplications have one, a count or a small constant). With both at 256
060A                             ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
060A                             ; shifted in above it says when), and its high byte goes on as a small one.
060A                             ; DE = NOS, HL = TOS.
060A   7C           MULQ:     MOV   A,H   
060B   B7                     ORA   A   
060C   CA 15 06               JZ   mq8   ; the multiplier is below 256
060F   7A                     MOV   A,D   
0610   B7                     ORA   A   
0611   C2 34 06               JNZ   mq16   
0614   EB                     XCHG      ; the multiplicand is: it becomes the multiplier
0615   7D           MQ8:      MOV   A,L   
0616   21 00 00               LXI   H,0   
0619   B7                     ORA   A   ; (clears the carry)
061A   CA 29 06               JZ   mq9   
061D   1F           MQ1:      RAR      ; the next bit
061E   D2 22 06               JNC   mq2   
0621   19                     DAD   D   
0622   EB           MQ2:      XCHG      
0623   29                     DAD   H   ; multiplicand << 1
0624   EB                     XCHG      
0625   B7                     ORA   A   ; bits left? (and clears the carry)
0626   C2 1D 06               JNZ   mq1   
0629                          ;*Macro unroll: mq9:    NEXTQ
0629                MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
0629                          DS   CPM*(1-FAST),0C3h   
0629                          DS   CPM*(1-FAST),ANXT&0FFh   
0629                          DS   CPM*(1-FAST),ANXT/256   
0629                          DS   FAST*CHECKED,0CDh   
0629                          DS   FAST*CHECKED,ACHK&0FFh   
0629                          DS   FAST*CHECKED,ACHK/256   
0629   0A                     DS   FAST,0Ah   
062A   03                     DS   FAST,03h   
062B   EB                     DS   FAST,0EBh   
062C   6F                     DS   FAST,6Fh   
062D   26                     DS   FAST,26h   
062E   11                     DS   FAST,DTPG   
062F   7E                     DS   FAST,7Eh   
0630   24                     DS   FAST,24h   
0631   66                     DS   FAST,66h   
0632   6F                     DS   FAST,6Fh   
0633   E9                     DS   FAST,0E9h   
0634   C5           MQ16:     PUSH   B   
0635   44                     MOV   B,H   ; the high byte, for later
0636   7D                     MOV   A,L   
0637   21 00 00               LXI   H,0   
063A   37                     STC      ; the marker
063B   1F                     RAR      
063C   D2 40 06     MQ3:      JNC   mq4   
063F   19                     DAD   D   
0640   EB           MQ4:      XCHG      
0641   29                     DAD   H   
0642   EB                     XCHG      
0643   FE 01                  CPI   1   ; only the marker left: 8 rounds done (and
0645   1F                     RAR      ;   the carry was clear for the shift)
0646   C2 3C 06               JNZ   mq3   
0649   78                     MOV   A,B   
064A   C1                     POP   B   
064B   B7                     ORA   A   
064C   C3 1D 06               JMP   mq1   ; the high byte, as a small multiplier
064F                             ; A true ")" reads the block start where it is, on top of the return stack,
064F                             ; instead of popping it and pushing it back; the break key is looked at as
064F                             ; rpushd would.
064F   2A 34 16     CLOSEQ:   LHLD   RSP   
0652   4E                     MOV   C,M   
0653   23                     INX   H   
0654   46                     MOV   B,M   
0655   21 36 16               LXI   H,BRKCNT   
0658   35                     DCR   M   
0659   E1                     POP   H   ; (keeps the flags)
065A   CC 68 06               CZ   pollk   
065D                          ;*Macro unroll:  NEXTQ
065D                          DS   (1-CPM)*(1-FAST),0F7h   
065D                          DS   CPM*(1-FAST),0C3h   
065D                          DS   CPM*(1-FAST),ANXT&0FFh   
065D                          DS   CPM*(1-FAST),ANXT/256   
065D                          DS   FAST*CHECKED,0CDh   
065D                          DS   FAST*CHECKED,ACHK&0FFh   
065D                          DS   FAST*CHECKED,ACHK/256   
065D   0A                     DS   FAST,0Ah   
065E   03                     DS   FAST,03h   
065F   EB                     DS   FAST,0EBh   
0660   6F                     DS   FAST,6Fh   
0661   26                     DS   FAST,26h   
0662   11                     DS   FAST,DTPG   
0663   7E                     DS   FAST,7Eh   
0664   24                     DS   FAST,24h   
0665   66                     DS   FAST,66h   
0666   6F                     DS   FAST,6Fh   
0667   E9                     DS   FAST,0E9h   
0668                          ENDIF      
0668                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWER:    EQU   lowq   
                    LOWQ:     ADD   A   
                              MOV   E,A   
                              MVI   D,LETPAGE   ; DE -> the cell
                              LDAX   B   
                              CPI   "@"   
                              JZ   lwf   
                              CPI   "!"   
                              JZ   lws   
                              PUSH   H   
                              XCHG      ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWF:      INX   B   ; x@: TOS = the cell's value
                              PUSH   H   
                              XCHG      
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              XCHG      
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
                              XCHG      
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0668                          ENDIF      
0668                             ; =============================================================================
0668                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0668                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0668                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
0668                             ;  the host's KEY and CONOUT routines themselves.
0668                             ; 
0668                             ;  A running program reads the keyboard only through getk and pollk, which
0668                             ;  between them give the break key its rules:
0668                             ;    - Ctrl-C stops the program;
0668                             ;    - any other key that the break check reads is held in KEYBUF for the
0668                             ;      next "?", and a newer one takes its place;
0668                             ;    - "?" (getk) takes the held key first;
0668                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0668                             ;      key like any other, but two of them within about 250 ms still stop it.
0668                             ;  Both are called straight from a handler, never from a routine under one:
0668                             ;  the checked build's report counts on finding one return address above the
0668                             ;  data stack, and TOS in HL.
0668                             ; =============================================================================
0668                          IFN   CPM   
                    RAWK:     EQU   KEY   
0668                          ENDIF      
0668                             ; pollk: the break check (see rpushd).
0668   CD D2 06     POLLK:    CALL   rawk   
066B   C8                     RZ      ; no key
066C   32 7A 16               STA   KEYBUF   ; held for the next "?"
066F   FE 03        PK1:      CPI   3   ; (getk joins here)
0671   C0                     RNZ      
0672                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0672                             ; the program has turned it off, wait about 250 ms for one more key: a
0672                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0672                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0672   3A 7B 16     CTLC:     LDA   BRKOFF   
0675   B7                     ORA   A   
0676   CA 41 01               JZ   brk   
0679   D5                     PUSH   D   
067A   11 E8 03               LXI   D,250*MSLOOP   
067D   CD D2 06     CT1:      CALL   rawk   
0680   C2 89 06               JNZ   ct2   
0683   1B                     DCX   D   
0684   7A                     MOV   A,D   
0685   B3                     ORA   E   
0686   C2 7D 06               JNZ   ct1   
0689   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
068A   FE 03                  CPI   3   
068C   CA 41 01               JZ   brk   
068F   B7                     ORA   A   
0690   CA 96 06               JZ   ct3   
0693   32 7A 16               STA   KEYBUF   
0696   3E 03        CT3:      MVI   A,3   
0698   B7                     ORA   A   
0699   C9                     RET      
069A                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
069A   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
069B   21 7A 16               LXI   H,KEYBUF   ;   the buffer
069E   7E                     MOV   A,M   
069F   36 00                  MVI   M,0   
06A1   E1                     POP   H   
06A2   B7                     ORA   A   
06A3   C0                     RNZ      
06A4   CD D2 06               CALL   rawk   
06A7   C8                     RZ      
06A8   C3 6F 06               JMP   pk1   ; Ctrl-C? If not, that is the key
06AB                          IF   1-CHECKED   
06AB                BRK:      EQU   endprog   ; the unchecked build stops without a word;
06AB                          ENDIF      
06AB                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
06AB                          ENDIF      
06AB                          IF   CPM   
06AB                             ; (In a CP/M build the letters and digits are here, out of the way of the
06AB                             ; handlers, which must fit in the image's first two pages. The same code as
06AB                             ; in the generic build.)
06AB                             ; ---- the letters and digits --------------------------------------------------
06AB                             ; a-z: push the cell's address (the cell is the variable)
06AB                          ENDIF      
06AB                          IF   CPM*(1-SBASEU)   
06AB   E5           LOWER:    PUSH   H   
06AC   87                     ADD   A   
06AD   6F                     MOV   L,A   
06AE   26 16                  MVI   H,LETPAGE   
06B0                          ;*Macro unroll:  NEXT
06B0                          DS   (1-CPM)*(1-FAST),0F7h   
06B0   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
06B1   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
06B2   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
06B3                          ENDIF      
06B3                          IF   CPM   
06B3                             ; A-Z: call the word. The return address (the IP after the letter) goes on
06B3                             ; the return stack, and the IP becomes the address in the letter's cell.
06B3   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
06B4   87                     ADD   A   
06B5   6F                     MOV   L,A   
06B6   26 16                  MVI   H,LETPAGE   ; HL -> cell
06B8   50                     MOV   D,B   
06B9   59                     MOV   E,C   ; DE = the return address
06BA   4E                     MOV   C,M   
06BB   23                     INX   H   
06BC   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
06BD                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
06BD                             ; go on. Every push of the return stack ends here: for a word call the cell
06BD                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
06BD                             ; the one that was used up.
06BD                             ; 
06BD                             ; The break key is looked at here, so at every word call and loop-back (and
06BD                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
06BD                             ; the keyboard can be slow (it is a BDOS call under CP/M).
06BD   2A 34 16     RPUSHD:   LHLD   RSP   
06C0   2B                     DCX   H   
06C1   72                     MOV   M,D   
06C2   2B                     DCX   H   
06C3   73                     MOV   M,E   
06C4   22 34 16               SHLD   RSP   
06C7   21 36 16               LXI   H,BRKCNT   
06CA   35                     DCR   M   
06CB   E1                     POP   H   ; (keeps the flags)
06CC   CC 68 06               CZ   pollk   
06CF                          ;*Macro unroll:  NEXT
06CF                          DS   (1-CPM)*(1-FAST),0F7h   
06CF   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
06D0   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
06D1   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
06D2   3E FF        RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
06D4                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
06D4                             ; printing and could swallow a key that BDOS 6 then never sees.
06D4   C5           PUTC:     PUSH   B   
06D5   D5                     PUSH   D   
06D6   E5                     PUSH   H   
06D7   5F                     MOV   E,A   
06D8   0E 06                  MVI   C,6   
06DA   CD 05 00               CALL   BDOS   
06DD   E1                     POP   H   
06DE   D1                     POP   D   
06DF   C1                     POP   B   
06E0   B7                     ORA   A   ; (for getk)
06E1   C9                     RET      
06E2                          ENDIF      
06E2                             ; =============================================================================
06E2                             ;  Checked build: the checks and the error report
06E2                             ; =============================================================================
06E2                          IF   CHECKED   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
06E2                          ENDIF      
06E2                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
06E2                          ENDIF      
06E2                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
06E2                          ENDIF      
06E2                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address (errp drops
                              MVI   A,"H"   ;   the old top)
                              JMP   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
06E2                          ENDIF      
06E2                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
06E2                          ENDIF      
06E2                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
06E2                          ENDIF      
06E2                          IF   CHECKED   
                                 ; Two error entries for errors found inside a routine: the first hides the
                                 ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
                                 ; return address.
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   prs0   
                              CPI   7Fh   
                              JC   pesc   
                    PRS0:     ANI   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,10   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   D   
                              POP   H   
                              CALL   chkstk   
                              PUSH   H   
                              LHLD   PSAVE   
                              DB   11h   ; (LXI D hides e_quote's first two bytes)
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   D   
                              POP   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   "D:",22h   
                              LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
                              DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
                              ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
                              DS   1-CPM,0E7h   ;   first value and holds nothing)
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              MOV   A,H   
                              CALL   phal2   ; the depth
                              MVI   A,":"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                    PHAL2:    ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
06E2                          ENDIF      
06E2                             ; =============================================================================
06E2                             ;  Startup
06E2                             ; =============================================================================
06E2                START:       
06E2                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
06E2                          ENDIF      
06E2                          IF   QK   
06E2   21 00 13               LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
06E5   AF                     XRA   A   ;   start of 0000h matches no skip)
06E6   77           SKC1:     MOV   M,A   
06E7   2C                     INR   L   
06E8   C2 E6 06               JNZ   skc1   
06EB                          ENDIF      
06EB                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
06EB                          ENDIF      
06EB                          IF   CPM   
06EB                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
06EB   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
06EE   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
06F0   CD 05 00               CALL   BDOS   ;   and the program is empty)
06F3   11 00 17               LXI   D,PROG   
06F6   D5           LD1:      PUSH   D   
06F7   0E 1A                  MVI   C,26   ; set the DMA address
06F9   CD 05 00               CALL   BDOS   
06FC   11 5C 00               LXI   D,005Ch   
06FF   0E 14                  MVI   C,20   ; read the next 128 bytes
0701   CD 05 00               CALL   BDOS   
0704   E1                     POP   H   ; HL = the address this record went to
0705   B7                     ORA   A   
0706   C2 11 07               JNZ   ld2   
0709   11 80 00               LXI   D,128   
070C   19                     DAD   D   
070D   EB                     XCHG      
070E   C3 F6 06               JMP   ld1   
0711   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0713   23                     INX   H   ; the heap starts after it
0714                          ENDIF      
0714                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
0714                          ENDIF      
0714   22 7C 16               SHLD   HEAP   
0717                          IF   CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              SHLD   NPEND   ;   release below it
0717                          ENDIF      
0717   21 E0 14               LXI   H,RSTOP   ; the return stack is empty
071A   22 34 16               SHLD   RSP   
071D                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
071D                          ENDIF      ;   checked build has cleared these)
071D                          IF   (1-CHECKED)*CPM   
071D   21 00 00               LXI   H,0   
0720                          ENDIF      
0720                          IF   1-CHECKED   
0720   22 7A 16               SHLD   KEYBUF   
0723                          ENDIF      
0723   01 00 17               LXI   B,PROG   ; the IP
0726                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0726                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0726   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0727   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0728   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0729                          IF   FAST   
0729                             ; =============================================================================
0729                             ;  The fast build (SPEED = 2)
0729                             ; 
0729                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
0729                             ;  addresses in one page and the high bytes in the next. The dispatcher (at
0729                             ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
0729                             ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
0729                             ; 
0729                             ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
0729                             ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
0729                             ; 
0729                             ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
0729                             ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
0729                             ;  the letters and digits have one entry each, which knows its cell or its
0729                             ;  value already.
0729                             ; =============================================================================
0729   EB           FTSTORE:   XCHG      ; !
072A   C3 4D 02               JMP   h_store   
072D   EB           FTSTR:    XCHG      ; "
072E   C3 5B 02               JMP   h_str   
0731   EB           FTNUM:    XCHG      ; #
0732   C3 6F 02               JMP   h_num   
0735   EB           FTPRINT:   XCHG      ; $
0736   C3 64 02               JMP   h_print   
0739   EB           FTEMIT:   XCHG      ; '
073A   C3 67 02               JMP   h_emit   
073D   EB           FTCSTORE:   XCHG      ; .
073E   C3 55 02               JMP   h_cstore   
0741   EB           FTDIV:    XCHG      ; /
0742   C3 20 02               JMP   h_div   
0745   EB           FTKEY:    XCHG      ; ?
0746   C3 78 02               JMP   h_key   
0749   EB           FTDEF:    XCHG      ; [
074A   C3 A4 01               JMP   h_def   
074D   EB           FTBREAK:   XCHG      ; \
074E   C3 95 01               JMP   h_break   
0751   EB           FTALLOC:   XCHG      ; _
0752   C3 5F 01               JMP   h_alloc   
0755   EB           FTGRAVE:   XCHG      ; `
0756   C3 6C 01               JMP   h_grave   
0759                             ; The commonest punctuation, written for the fast build: TOS in DE on the
0759                             ; way in, and the dispatcher inline on the way out.
0759   E1           FS_ADD:   POP   H   ; +
075A   19                     DAD   D   
075B                          ;*Macro unroll:  NEXTF
075B                          DS   FAST*CHECKED,0CDh   
075B                          DS   FAST*CHECKED,ACHK&0FFh   
075B                          DS   FAST*CHECKED,ACHK/256   
075B   0A                     DS   FAST,0Ah   
075C   03                     DS   FAST,03h   
075D   EB                     DS   FAST,0EBh   
075E   6F                     DS   FAST,6Fh   
075F   26                     DS   FAST,26h   
0760   11                     DS   FAST,DTPG   
0761   7E                     DS   FAST,7Eh   
0762   24                     DS   FAST,24h   
0763   66                     DS   FAST,66h   
0764   6F                     DS   FAST,6Fh   
0765   E9                     DS   FAST,0E9h   
0766   0A           FS_SUB:   LDAX   B   ; -
0767   D6 30                  SUI   "0"   
0769   FE 0A                  CPI   10   
076B   DA 7F 07               JC   fs_neg   
076E   E1                     POP   H   
076F   7D                     MOV   A,L   
0770   93                     SUB   E   
0771   5F                     MOV   E,A   
0772   7C                     MOV   A,H   
0773   9A                     SBB   D   
0774   57                     MOV   D,A   
0775                          ;*Macro unroll:  NEXTD
0775                          DS   FAST*CHECKED,0EBh   
0775                          DS   FAST*CHECKED,0CDh   
0775                          DS   FAST*CHECKED,ACHK&0FFh   
0775                          DS   FAST*CHECKED,ACHK/256   
0775   0A                     DS   FAST,0Ah   
0776   03                     DS   FAST,03h   
0777                          DS   FAST*CHECKED,0EBh   
0777   6F                     DS   FAST,6Fh   
0778   26                     DS   FAST,26h   
0779   11                     DS   FAST,DTPG   
077A   7E                     DS   FAST,7Eh   
077B   24                     DS   FAST,24h   
077C   66                     DS   FAST,66h   
077D   6F                     DS   FAST,6Fh   
077E   E9                     DS   FAST,0E9h   
077F   EB           FS_NEG:   XCHG      ; a digit next: a negative number
0780   C3 DC 02               JMP   negnum   
0783   D5           FS_DUP:   PUSH   D   ; :
0784                          ;*Macro unroll:  NEXTD
0784                          DS   FAST*CHECKED,0EBh   
0784                          DS   FAST*CHECKED,0CDh   
0784                          DS   FAST*CHECKED,ACHK&0FFh   
0784                          DS   FAST*CHECKED,ACHK/256   
0784   0A                     DS   FAST,0Ah   
0785   03                     DS   FAST,03h   
0786                          DS   FAST*CHECKED,0EBh   
0786   6F                     DS   FAST,6Fh   
0787   26                     DS   FAST,26h   
0788   11                     DS   FAST,DTPG   
0789   7E                     DS   FAST,7Eh   
078A   24                     DS   FAST,24h   
078B   66                     DS   FAST,66h   
078C   6F                     DS   FAST,6Fh   
078D   E9                     DS   FAST,0E9h   
078E   E1           FS_DROP:   POP   H   ; ;
078F                          ;*Macro unroll:  NEXTF
078F                          DS   FAST*CHECKED,0CDh   
078F                          DS   FAST*CHECKED,ACHK&0FFh   
078F                          DS   FAST*CHECKED,ACHK/256   
078F   0A                     DS   FAST,0Ah   
0790   03                     DS   FAST,03h   
0791   EB                     DS   FAST,0EBh   
0792   6F                     DS   FAST,6Fh   
0793   26                     DS   FAST,26h   
0794   11                     DS   FAST,DTPG   
0795   7E                     DS   FAST,7Eh   
0796   24                     DS   FAST,24h   
0797   66                     DS   FAST,66h   
0798   6F                     DS   FAST,6Fh   
0799   E9                     DS   FAST,0E9h   
079A   E1           FS_SWAP:   POP   H   ; %
079B   D5                     PUSH   D   
079C                          ;*Macro unroll:  NEXTF
079C                          DS   FAST*CHECKED,0CDh   
079C                          DS   FAST*CHECKED,ACHK&0FFh   
079C                          DS   FAST*CHECKED,ACHK/256   
079C   0A                     DS   FAST,0Ah   
079D   03                     DS   FAST,03h   
079E   EB                     DS   FAST,0EBh   
079F   6F                     DS   FAST,6Fh   
07A0   26                     DS   FAST,26h   
07A1   11                     DS   FAST,DTPG   
07A2   7E                     DS   FAST,7Eh   
07A3   24                     DS   FAST,24h   
07A4   66                     DS   FAST,66h   
07A5   6F                     DS   FAST,6Fh   
07A6   E9                     DS   FAST,0E9h   
