0617   22 38 82               LD   (NPEND),HL   ;   release below it
061A                          ENDIF      
061A                          IF   EDITOR   
061A   E1                     POP   HL   ; TOS: the data stack is as the last line left it
061B   F7                     RST   30h   ; (its return address is thrown away)
061C                             ; ^L: list from line n. DE = the number of the line at HL.
061C   CD 2F 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
061F   7C                     LD   A,H   
0620   B5                     OR   L   
