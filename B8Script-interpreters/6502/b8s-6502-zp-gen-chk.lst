E414   E9 30                  SBC   #"0"   
E416   C9 0A                  CMP   #10   
E418   60                     RTS      
E419                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E419                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E419   20 10 E4     RDHEX:    JSR   isdig   
E41C   90 0F                  BCC   incip   
E41E   29 DF                  AND   #0DFh   
E420   E9 11                  SBC   #11h   ; (the carry is set)
E422   C9 06                  CMP   #6   
E424   B0 0F                  BCS   ic9   
E426   69 0A                  ADC   #10   
E428   D0 03                  BNE   incip   ; always
E42A                             ; Reading the program
E42A                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E42A                             ;    getc: the same, then IP moves on; flags follow A
E42A                             ;    incip: IP moves on; keeps A, the carry and Y
E42A   20 36 E4     GETC:     JSR   peek   
E42D   E6 00        INCIP:    INC   IP   
E42F   D0 02                  BNE   ic1   
E431   E6 01                  INC   IP+1   
E433   09 00        IC1:      ORA   #0   
E435   60           IC9:      RTS      
E436   A0 00        PEEK:     LDY   #0   
E438   B1 00                  LDA   (IP),Y   
E43A   60                     RTS      
E43B                             ; rstip: point IP at the start of the program
E43B   A9 00        RSTIP:    LDA   #<PROG   
E43D   85 00                  STA   IP   
E43F   A9 05                  LDA   #>PROG   
E441   85 01                  STA   IP+1   
E443   60                     RTS      
E444                             ; =============================================================================
E444                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E444                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E444                             ;  Both keep X and Y. In the unchecked build getk is the host's KEY itself.
E444                             ; =============================================================================
E444                          IF   1-CHECKED   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
E444                          ENDIF      
E444                          IF   CHECKED   
E444   AD 34 04     GETK:     LDA   KEYBUF   ; a key held back by the break check
E447   F0 08                  BEQ   gk1   
E449   48                     PHA      
E44A   A9 00                  LDA   #0   
E44C   8D 34 04               STA   KEYBUF   
E44F   68                     PLA      
E450   60                     RTS      
E451   4C 06 FF     GK1:      JMP   KEY   
E454                             ; =============================================================================
E454                             ;  Checked build: break key and error reports
E454                             ; =============================================================================
E454                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
E454                             ; else is held for the next "?". Keeps the flags.
E454   08           CHKBRK:   PHP      
E455   20 44 E4               JSR   getk   
E458   F0 07                  BEQ   cb9   
E45A   C9 03                  CMP   #3   
E45C   F0 05                  BEQ   e_break   
E45E   8D 34 04               STA   KEYBUF   
E461   28           CB9:      PLP      
E462   60                     RTS      
E463   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C
E465                             ; error: print the letter in A, " @ " and the offset in the program of the
E465                             ; character just read, then end. For example: S @ 245
E465                             ; The hardware stack is left as it is: it wraps inside its page, so the
E465                             ; calls below work whatever state it is in.
E465   A2 EE        ERROR:    LDX   #DSE-2   ; one cell, for the number
E467   20 03 FF               JSR   CONOUT   
E46A   A9 20                  LDA   #" "   
E46C   20 03 FF               JSR   CONOUT   
E46F   A9 40                  LDA   #"@"   
E471   20 03 FF               JSR   CONOUT   
E474   A9 20                  LDA   #" "   
E476   20 03 FF               JSR   CONOUT   
E479   A5 00                  LDA   IP   
E47B   38                     SEC      
E47C   E9 01                  SBC   #<PROG1   ; the character just read
E47E   95 00                  STA   0,X   
E480   A5 01                  LDA   IP+1   
E482   E9 05                  SBC   #>PROG1   
E484   95 01                  STA   1,X   
E486   20 58 E0               JSR   h_num   
E489   4C 9C E3               JMP   endp   
E48C                          ENDIF      


