04C3   AB                     XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
04C4   E6 06                  ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
04C6   FE 02                  CPI   2   ;   closer, and only then
04C8   7A                     MOV   A,D   
04C9   D1                     POP   D   ; (where the skip started)
04CA   C0                     RNZ      
04CB   42                     MOV   B,D   ; N. The place is the opener
04CC   4B                     MOV   C,E   
04CD   C3 D7 04               JMP   sk7   
04D0   7B           SK6:      MOV   A,E   ; the text ran out:
04D1   E6 04                  ANI   4   
04D3   C2 83 01               JNZ   endprog   ;   "\" with no closer ends the program
04D6   C1                     POP   B   
04D7   3E 4E        SK7:      MVI   A,"N"   
04D9   C3 09 06               JMP   errp   ; (errp drops skip's return address)
04DC                          ENDIF      
04DC                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
04DC                             ; the next character, so "/"" does not end it. Leaves A = 22h.
04DC                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
04DC                          ENDIF      
04DC                          IF   CHECKED   
04DC                             ; The checked build never steps over a NUL: if the text runs out first it
04DC                             ; returns A = 0 with the IP on the NUL.
04DC   0A           SKIPSTR:   LDAX   B   
04DD   B7                     ORA   A   
04DE   C8                     RZ      
04DF   03                     INX   B   
