E577   B1 02        ER1:      LDA   (P),Y   
E579   F0 10                  BEQ   er2   
E57B   C9 0D                  CMP   #13   
E57D   F0 0C                  BEQ   er2   
E57F   C9 0A                  CMP   #10   
E581   F0 08                  BEQ   er2   
E583   20 03 FF               JSR   CONOUT   
E586   C8                     INY      
E587   C0 10                  CPY   #16   
E589   D0 EC                  BNE   er1   
E58B   A0 0B        ER2:      LDY   #M_STK-MSG   
E58D   20 EE E5               JSR   prs   ; CR LF "Stk "
E590   8A                     TXA      
E591   49 FF                  EOR   #0FFh   
E593   38                     SEC      
E594   E9 0F                  SBC   #0FFh-DSE   
