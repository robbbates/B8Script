0285                          ENDIF      
0285                             ; psgn: print HL as a signed number. Uses BC.
0285   7C           PSGN:     MOV   A,H   
0286   B7                     ORA   A   
0287   F2 8E 02               JP   pdec   
028A   3E 2D                  MVI   A,"-"   
028C                          ;*Macro unroll:  PUTA
028C   EF                     DS   1-CPM,0EFh   
028D                          DS   CPM,0CDh   
028D                          DS   CPM,APUT&0FFh   
028D                          DS   CPM,APUT/256   
028D                          ;*Macro unroll:  NEGH
028D   E7                     DS   1-CPM,0E7h   
028E                          DS   CPM,0CDh   
028E                          DS   CPM,ANEG&0FFh   
028E                          DS   CPM,ANEG/256   
028E                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
028E                             ; Uses BC.
028E   11 0A 00     PDEC:     LXI   D,10   
0291   CD 53 02               CALL   udiv   ; HL = HL / 10, C = the last digit
0294   79                     MOV   A,C   
0295   F5                     PUSH   PSW   
0296   7C                     MOV   A,H   
0297   B5                     ORA   L   
0298   C4 8E 02               CNZ   pdec   
029B   F1                     POP   PSW   
029C   C6 30                  ADI   "0"   
029E                          ;*Macro unroll:  PUTA
029E   EF                     DS   1-CPM,0EFh   
029F                          DS   CPM,0CDh   
029F                          DS   CPM,APUT&0FFh   
029F                          DS   CPM,APUT/256   
029F   C9                     RET      
02A0                             ; (The table goes here instead in the builds where, before the routines, it
02A0                             ; would cross a page: PTLATE. If it would cross one here too, it starts on
02A0                             ; the next page: PTPAD is 0 unless it must.)
02A0                          IF   (1-FAST)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02A0                          ENDIF      
02A0                          IF   1-CHECKED   
02A0                             ; "$" prints the string at TOS (see h_print).
02A0   7E           PRLP:     MOV   A,M   
02A1   23                     INX   H   
02A2   FE 22                  CPI   22h   
02A4   CA B3 01               JZ   h_drop   
02A7   FE 2F                  CPI   "/"   
02A9   C2 BA 02               JNZ   pr1   
02AC   7E                     MOV   A,M   
02AD   23                     INX   H   
02AE   FE 60                  CPI   60h   
02B0   DA B8 02               JC   pr0   
02B3   FE 7F                  CPI   7Fh   
02B5   DA BE 02               JC   pesc   
02B8   E6 BF        PR0:      ANI   0BFh   
02BA                          ;*Macro unroll: pr1:    PUTA
02BA   EF           PR1:      DS   1-CPM,0EFh   
02BB                          DS   CPM,0CDh   
02BB                          DS   CPM,APUT&0FFh   
02BB                          DS   CPM,APUT/256   
02BB   C3 A0 02               JMP   prlp   
02BE                          ENDIF      
02BE                             ;-----------------------------------------------------------------------------
02BE                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
02BE                             ; HL points past it. Each goes back into the loop that prints the string
02BE                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
02BE                             ;    /a-/z   print the variable, as "#" does
02BE                             ;    /{      clear the screen, the cursor to the top left
02BE                             ;    /}      clear from the cursor to the end of the line
02BE                             ;    /|  /`  show the cursor, hide it
02BE                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
02BE   FE 7E        PESC:     CPI   7Eh   
02C0   CA E3 02               JZ   pat   
02C3   11 A0 02               LXI   D,PRLOOP   ; the others return into the loop
02C6   D5                     PUSH   D   
02C7   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
02C9   D2 EC 02               JNC   pcon   
02CC   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
02CE   D2 F5 02               JNC   phide   
02D1   87                     ADD   A   ; the variable's cell
02D2   C6 40                  ADI   40h   
02D4   E5                     PUSH   H   
02D5   C5                     PUSH   B   
02D6   6F                     MOV   L,A   
02D7   26 82                  MVI   H,LETPAGE   
02D9   7E                     MOV   A,M   
02DA   2C                     INR   L   
02DB   66                     MOV   H,M   
02DC   6F                     MOV   L,A   
02DD   CD 85 02               CALL   psgn   
02E0   C1                     POP   B   
02E1   E1                     POP   H   
02E2   C9                     RET      
02E3                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
02E3                             ; the checked build "$" is the routine prstr: its own return address goes
02E3                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
02E3                             ; its two cells are there, and is s if not, before it prints anything.
02E3                PAT:         
02E3                          IF   CHECKED   
                              XTHL      ; the text pointer over prstr's return address
                              LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              DAD   SP   
                              JC   e_under   
                              POP   H   
02E3                          ENDIF      
02E3   D1                     POP   D   ; DE = the column
02E4   E3                     XTHL      ; HL = the row; the text pointer is kept
02E5                          IF   1-ANS   
02E5   CD 15 FF               CALL   CONAT   
02E8   E1                     POP   H   
02E9   C3 A0 02               JMP   PRAGAIN   
02EC                             ; With ANSI = 0 the machine's routines do the rest.
02EC   CA 0C FF     PCON:     JZ   CONCLS   ; /{
02EF   FE 02                  CPI   2   
02F1   CA 0F FF               JZ   CONEOL   ; /}
02F4   FE                     DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
02F5   AF           PHIDE:    XRA   A   ; /`  (A = 0: hide)
02F6   C3 12 FF               JMP   CONCUR   
02F9                          ENDIF      
02F9                          IF   ANS   
                              PUSH   B   ; (pdec uses BC)
                              PUSH   D   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INX   H   
                              CALL   pdec   
                              MVI   A,";"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   H   
                              INX   H   
                              CALL   pdec   
                              MVI   A,"H"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   B   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
                    PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
                              MVI   A,"?"   
                              CALL   csia   
                              MVI   A,"2"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"5"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DCR   A   
                              JZ   pshow   ; /|
                              MVI   A,"K"   
                              JP   csia   ; /}  ESC [ K
                              MVI   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              MVI   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
                    CSIA:     PUSH   PSW   
                              CALL   csi   
                              POP   PSW   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                    CSI:      MVI   A,27   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"["   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
02F9                          ENDIF      
02F9                             ; skip: read past text to the closer at this level, and return A = 0 if it
02F9                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02F9                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02F9                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02F9                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02F9                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
02F9                             ; 
02F9                             ; The checked build also looks at the character the skip was started by,
02F9                             ; which is always the one just before where it starts: "(" must end at ")",
02F9                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02F9                             ; quote counts as running into it. "\" takes either closer. The place where
02F9                             ; the skip started is kept on the stack, for the report.
02F9                          IF   1-QK   
02F9                             ; (Without base: no skip cache.)
02F9                SKIP:        
02F9                          ENDIF      
02F9                          IF   CHECKED*(1-QK)   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
02F9                          ENDIF      
02F9                          IF   1-QK   
02F9   16 00                  MVI   D,0   
02FB   14           SK3:      INR   D   ; an opener: one deeper
02FC   0A           SK1:      LDAX   B   
02FD                          ENDIF      
02FD                          IF   (1-CHECKED)*(1-QK)   
02FD   03                     INX   B   
02FE   B7                     ORA   A   
02FF   CA 79 00               JZ   endprog   
0302                          ENDIF      
0302                          IF   CHECKED*(1-QK)   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
0302                          ENDIF      
0302                          IF   1-QK   
0302   FE 22                  CPI   22h   
0304   CC 20 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
0307   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
0309   CA FB 02               JZ   sk3   
030C   3D                     DCR   A   ; ")"
030D   CA 1A 03               JZ   sk4   
0310   D6 32                  SUI   "["-")"   
0312   CA FB 02               JZ   sk3   
0315   FE 02                  CPI   "]"-"["   
0317   C2 FC 02               JNZ   sk1   
031A   15           SK4:      DCR   D   
031B                          ENDIF      
031B                          IF   (1-CHECKED)*(1-QK)   
031B   C8                     RZ      ; the closer at this level
031C   C3 FC 02               JMP   sk1   
031F                          ENDIF      
031F                          IF   CHECKED*(1-QK)   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
031F                          ENDIF      
031F                          IF   QK   
                                 ; The skip cache. Nearly every skip is one that has happened before (a loop
                                 ; skips the same false block on every pass), so the first scan from each
                                 ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
                                 ; by the start's low byte (times 4). Only skips that start in the program
                                 ; text are kept (the line buffer changes); the cache is emptied whenever a
                                 ; run starts (see start). A program that changes its own text while it
                                 ; runs is not looked after.
                    SKIP:     MOV   A,B   
                              CPI   PROG/256   
                              JC   sks   ; below the program text: no cache
                              MOV   A,C   
                              ADD   A   
                              ADD   A   
                              MOV   E,A   
                              MVI   D,CPAGE   ; DE -> the entry
                              LDAX   D   
                              CMP   C   
                              JNZ   sks   
                              INR   E   
                              LDAX   D   
                              CMP   B   
                              JNZ   sks   
                              INR   E   
                              LDAX   D   
                              MOV   C,A   
                              INR   E   
                              LDAX   D   
                              MOV   B,A   ; a hit: the IP is past the closer
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              SUI   ")"   ; 0 for ")", not 0 for "]"
                              RET      
                    SKS:      PUSH   B   ; where it starts: the cache's key (and the
031F                          ENDIF      ;   checked report's place)
031F                          IF   QK*CHECKED   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
031F                          ENDIF      
031F                          IF   QK   
                                 ; The scan. Most characters are nothing to it, and two range tests rule
                                 ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                              MVI   D,0   
                    SQ3:      INR   D   ; an opener: one deeper
                    SQ1:      LDAX   B   
                              INX   B   
                              CPI   5Eh   
                              JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CPI   5Bh   
                              JNC   sqb   ; [ \ ]
                              CPI   2Ah   
                              JNC   sq1   ; * to Z: nothing
                              CPI   28h   
                              JZ   sq3   ; (
                              JNC   sqc   ; )
                              CPI   22h   
                              JZ   sqq   ; a string
                              ORA   A   
                              JNZ   sq1   ; the rest below "(": nothing
031F                          ENDIF      
031F                          IF   QK*(1-CHECKED)   
                              JMP   endprog   ; NUL: the end of the program
031F                          ENDIF      
031F                          IF   QK*CHECKED   
                              DCX   B   ; NUL: the IP stays on it
                              MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SQ7:      MVI   A,"N"   ; N. The place is the opener
                              JMP   errp   ; (errp drops skip's return address)
031F                          ENDIF      
031F                          IF   QK   
                    SQQ:      CALL   skipstr   ; step over the string
                              JMP   sq1   
                    SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
                              JZ   sq1   ; "\" is nothing here
                              JC   sq3   ; [
                              MVI   A,2   ; ]
                              DB   0FEh   ; (CPI: steps over the XRA)
                    SQC:      XRA   A   ; )
                    SQ4:      DCR   D   
                              JNZ   sq1   
031F                          ENDIF      
031F                          IF   QK*CHECKED   
                              MOV   D,A   ; the closer at this level (as above): 2 here
                              XRA   E   ;   means the wrong closer
                              ANI   6   
                              CPI   2   
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              JNZ   sq8   
                              MOV   B,D   
                              MOV   C,E   
                              JMP   sq7   
                    SQ8:         
031F                          ENDIF      
031F                          IF   QK*(1-CHECKED)   
                              POP   D   ; where the skip started
031F                          ENDIF      
031F                          IF   QK   
                                 ; The closer at this level: remember the skip (if it started in the program
                                 ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
                              PUSH   H   
                              MOV   H,A   
                              MOV   A,D   
                              CPI   PROG/256   
                              JC   sq9   
                              MOV   A,E   
                              ADD   A   
                              ADD   A   
                              MOV   L,A   
                              MOV   A,H   
                              MVI   H,CPAGE   
                              MOV   M,E   
                              INR   L   
                              MOV   M,D   
                              INR   L   
                              MOV   M,C   
                              INR   L   
                              MOV   M,B   
                              POP   H   
                              RET      
                    SQ9:      MOV   A,H   
                              POP   H   
                              RET      
031F                          ENDIF      
031F                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
031F                             ; the next character, so "/"" does not end it. Leaves A = 22h.
031F                          IF   1-CHECKED   
031F   03           SS0:      INX   B   
0320   0A           SKIPSTR:   LDAX   B   
0321   03                     INX   B   
0322   FE 2F                  CPI   "/"   
0324   CA 1F 03               JZ   ss0   
0327   FE 22                  CPI   22h   
0329   C2 20 03               JNZ   skipstr   
032C   C9                     RET      
032D                          ENDIF      
032D                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
032D                          ENDIF      
032D                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
032D                             ; and return its value in A with the carry set; otherwise leave the IP and
032D                             ; return with the carry clear.
032D   0A           HEXC:     LDAX   B   
032E   D6 30                  SUI   "0"   
0330   FE 0A                  CPI   10   
0332   DA 3E 03               JC   hc1   
0335   E6 DF                  ANI   0DFh   
0337   D6 11                  SUI   11h   
0339   FE 06                  CPI   6   
033B   D0                     RNC      
033C   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
033E   03           HC1:      INX   B   
033F   C9                     RET      
0340                             ;  ---- Speed-ups (base builds) -------------------------------------------
0340                             ;  The skip cache and "/" by a power of two are above. These are the
0340                             ;  handlers' tails that the builds with room take, kept here, out of the
0340                             ;  handlers' first two pages.
0340                          IF   QK   
                                 ; "*" with an operand below 256: that one becomes the multiplier, a byte in
                                 ; A, and the loop stops as soon as its bits are used up (most
                                 ; multiplications have one, a count or a small constant). With both at 256
                                 ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
                                 ; shifted in above it says when), and its high byte goes on as a small one.
                                 ; DE = NOS, HL = TOS.
                    MULQ:     MOV   A,H   
                              ORA   A   
                              JZ   mq8   ; the multiplier is below 256
                              MOV   A,D   
                              ORA   A   
                              JNZ   mq16   
                              XCHG      ; the multiplicand is: it becomes the multiplier
                    MQ8:      MOV   A,L   
                              LXI   H,0   
                              ORA   A   ; (clears the carry)
                              JZ   mq9   
                    MQ1:      RAR      ; the next bit
                              JNC   mq2   
                              DAD   D   
                    MQ2:      XCHG      
                              DAD   H   ; multiplicand << 1
                              XCHG      
                              ORA   A   ; bits left? (and clears the carry)
                              JNZ   mq1   
                              ;*Macro unroll: mq9:    NEXTQ
                    MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ANXT&0FFh   
                              DS   CPM*(1-FAST),ANXT/256   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    MQ16:     PUSH   B   
                              MOV   B,H   ; the high byte, for later
                              MOV   A,L   
                              LXI   H,0   
                              STC      ; the marker
                              RAR      
                    MQ3:      JNC   mq4   
                              DAD   D   
                    MQ4:      XCHG      
                              DAD   H   
                              XCHG      
                              CPI   1   ; only the marker left: 8 rounds done (and
                              RAR      ;   the carry was clear for the shift)
                              JNZ   mq3   
                              MOV   A,B   
                              POP   B   
                              ORA   A   
                              JMP   mq1   ; the high byte, as a small multiplier
                                 ; A true ")" reads the block start where it is, on top of the return stack,
                                 ; instead of popping it and pushing it back; the break key is looked at as
                                 ; rpushd would.
                    CLOSEQ:   LHLD   RSP   
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXTQ
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ANXT&0FFh   
                              DS   CPM*(1-FAST),ANXT/256   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0340                          ENDIF      
0340                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWER:    EQU   lowq   
                    LOWQ:     ADD   A   
                              MOV   E,A   
                              MVI   D,LETPAGE   ; DE -> the cell
                              LDAX   B   
                              CPI   "@"   
                              JZ   lwf   
                              CPI   "!"   
                              JZ   lws   
                              PUSH   H   
                              XCHG      ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWF:      INX   B   ; x@: TOS = the cell's value
                              PUSH   H   
                              XCHG      
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              XCHG      
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
                              XCHG      
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0340                          ENDIF      
0340                             ; =============================================================================
0340                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0340                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0340                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
0340                             ;  the host's KEY and CONOUT routines themselves.
0340                             ; 
0340                             ;  A running program reads the keyboard only through getk and pollk, which
0340                             ;  between them give the break key its rules:
0340                             ;    - Ctrl-C stops the program;
0340                             ;    - any other key that the break check reads is held in KEYBUF for the
0340                             ;      next "?", and a newer one takes its place;
0340                             ;    - "?" (getk) takes the held key first;
0340                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0340                             ;      key like any other, but two of them within about 250 ms still stop it.
0340                             ;  Both are called straight from a handler, never from a routine under one:
0340                             ;  the checked build's report counts on finding one return address above the
0340                             ;  data stack, and TOS in HL.
0340                             ; =============================================================================
0340                          IFN   CPM   
0340                RAWK:     EQU   KEY   
0340                          ENDIF      
0340                             ; pollk: the break check (see rpushd).
0340   CD 06 FF     POLLK:    CALL   rawk   
0343   C8                     RZ      ; no key
0344   32 7A 82               STA   KEYBUF   ; held for the next "?"
0347   FE 03        PK1:      CPI   3   ; (getk joins here)
0349   C0                     RNZ      
034A                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
034A                             ; the program has turned it off, wait about 250 ms for one more key: a
034A                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
034A                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
034A   3A 7B 82     CTLC:     LDA   BRKOFF   
034D   B7                     ORA   A   
034E   CA 79 00               JZ   brk   
0351   D5                     PUSH   D   
0352   11 10 27               LXI   D,250*MSLOOP   
0355   CD 06 FF     CT1:      CALL   rawk   
0358   C2 61 03               JNZ   ct2   
035B   1B                     DCX   D   
035C   7A                     MOV   A,D   
035D   B3                     ORA   E   
035E   C2 55 03               JNZ   ct1   
0361   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
0362   FE 03                  CPI   3   
0364   CA 79 00               JZ   brk   
0367   B7                     ORA   A   
0368   CA 6E 03               JZ   ct3   
036B   32 7A 82               STA   KEYBUF   
036E   3E 03        CT3:      MVI   A,3   
0370   B7                     ORA   A   
0371   C9                     RET      
0372                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0372   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
0373   21 7A 82               LXI   H,KEYBUF   ;   the buffer
0376   7E                     MOV   A,M   
0377   36 00                  MVI   M,0   
0379   E1                     POP   H   
037A   B7                     ORA   A   
037B   C0                     RNZ      
037C   CD 06 FF               CALL   rawk   
037F   C8                     RZ      
0380   C3 47 03               JMP   pk1   ; Ctrl-C? If not, that is the key
0383                          IF   1-CHECKED   
0383                BRK:      EQU   endprog   ; the unchecked build stops without a word;
0383                          ENDIF      
0383                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
0383                          ENDIF      
0383                          IF   CPM   
                                 ; (In a CP/M build the letters and digits are here, out of the way of the
                                 ; handlers, which must fit in the image's first two pages. The same code as
                                 ; in the generic build.)
                                 ; ---- the letters and digits --------------------------------------------------
                                 ; a-z: push the cell's address (the cell is the variable)
0383                          ENDIF      
0383                          IF   CPM*(1-SBASEU)   
                    LOWER:    PUSH   H   
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0383                          ENDIF      
0383                          IF   CPM   
                                 ; A-Z: call the word. The return address (the IP after the letter) goes on
                                 ; the return stack, and the IP becomes the address in the letter's cell.
                    UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   ; HL -> cell
                              MOV   D,B   
                              MOV   E,C   ; DE = the return address
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   ; IP = the word's body, and fall into rpushd
                                 ; rpushd: push DE on the return stack, then pop TOS off the data stack and
                                 ; go on. Every push of the return stack ends here: for a word call the cell
                                 ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
                                 ; the one that was used up.
                                 ; 
                                 ; The break key is looked at here, so at every word call and loop-back (and
                                 ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
                                 ; the keyboard can be slow (it is a BDOS call under CP/M).
                    RPUSHD:   LHLD   RSP   
                              DCX   H   
                              MOV   M,D   
                              DCX   H   
                              MOV   M,E   
                              SHLD   RSP   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
0383                          ENDIF      
0383                             ; =============================================================================
0383                             ;  Checked build: the checks and the error report
0383                             ; =============================================================================
0383                          IF   CHECKED   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
0383                          ENDIF      
0383                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
0383                          ENDIF      
0383                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
0383                          ENDIF      
0383                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address (errp drops
                              MVI   A,"H"   ;   the old top)
                              JMP   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
0383                          ENDIF      
0383                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
0383                          ENDIF      
0383                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
0383                          ENDIF      
0383                          IF   CHECKED   
                                 ; Two error entries for errors found inside a routine: the first hides the
                                 ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
                                 ; return address.
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   prs0   
                              CPI   7Fh   
                              JC   pesc   
                    PRS0:     ANI   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,10   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   D   
                              POP   H   
                              CALL   chkstk   
                              PUSH   H   
                              LHLD   PSAVE   
                              DB   11h   ; (LXI D hides e_quote's first two bytes)
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   D   
                              POP   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   "D:",22h   
                              LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
                              DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
                              ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
                              DS   1-CPM,0E7h   ;   first value and holds nothing)
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              MOV   A,H   
                              CALL   phal2   ; the depth
                              MVI   A,":"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                    PHAL2:    ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
0383                          ENDIF      
0383                             ; =============================================================================
0383                             ;  Startup
0383                             ; =============================================================================
0383                START:       
0383                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
0383                          ENDIF      
0383                          IF   QK   
                              LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
                              XRA   A   ;   start of 0000h matches no skip)
                    SKC1:     MOV   M,A   
                              INR   L   
                              JNZ   skc1   
0383                          ENDIF      
0383                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
0383                          ENDIF      
0383                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
0383                          ENDIF      
0383                          IFN   CPM   
0383   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
0386   7E           FNUL:     MOV   A,M   
0387   23                     INX   H   
0388   B7                     ORA   A   
0389   C2 86 03               JNZ   fnul   
038C                          ENDIF      
038C   22 7C 82               SHLD   HEAP   
038F                          IF   CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              SHLD   NPEND   ;   release below it
038F                          ENDIF      
038F   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
0392   22 34 82               SHLD   RSP   
0395                          IF   (1-CHECKED)*(1-CPM)   
0395   67                     MOV   H,A   ; (A = 0, from the search for the NUL) no key
0396   6F                     MOV   L,A   ;   is held, and the break key is on (the
0397                          ENDIF      ;   checked build has cleared these)
0397                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0397                          ENDIF      
0397                          IF   1-CHECKED   
0397   22 7A 82               SHLD   KEYBUF   
039A                          ENDIF      
039A   01 00 83               LXI   B,PROG   ; the IP
039D                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
039D   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
039E                          DS   CPM+FAST-CPM*FAST,0C3h   
039E                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
039E                          DS   CPM+FAST-CPM*FAST,ANXT/256   
039E                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
                                 ; 
                                 ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
                                 ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
                                 ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
                                 ;  the letters and digits have one entry each, which knows its cell or its
                                 ;  value already.
                                 ; =============================================================================
                    FTSTORE:   XCHG      ; !
                              JMP   h_store   
                    FTSTR:    XCHG      ; "
                              JMP   h_str   
                    FTNUM:    XCHG      ; #
                              JMP   h_num   
                    FTPRINT:   XCHG      ; $
                              JMP   h_print   
                    FTEMIT:   XCHG      ; '
                              JMP   h_emit   
                    FTCSTORE:   XCHG      ; .
                              JMP   h_cstore   
                    FTDIV:    XCHG      ; /
                              JMP   h_div   
                    FTKEY:    XCHG      ; ?
                              JMP   h_key   
                    FTDEF:    XCHG      ; [
                              JMP   h_def   
                    FTBREAK:   XCHG      ; \
                              JMP   h_break   
                    FTALLOC:   XCHG      ; _
                              JMP   h_alloc   
                    FTGRAVE:   XCHG      ; `
                              JMP   h_grave   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:   POP   H   ; +
                              DAD   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:   LDAX   B   ; -
                              SUI   "0"   
                              CPI   10   
                              JC   fs_neg   
                              POP   H   
                              MOV   A,L   
                              SUB   E   
                              MOV   E,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   D,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   XCHG      ; a digit next: a negative number
                              JMP   negnum   
                    FS_DUP:   PUSH   D   ; :
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:   POP   H   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:   POP   H   ; %
                              PUSH   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:   XCHG      ; @
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:   LDAX   D   ; ,
                              MOV   E,A   
                              MVI   D,0   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:    POP   H   ; < (HL = a, DE = b: the borrow of a - b, flipped if the signs differ)
                              MOV   A,L   
                              SUB   E   
                              MOV   A,H   
                              SBB   D   
                              SBB   A   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              RAL      
                              SBB   A   
                              XRA   L   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:    POP   H   ; > (b < a: the borrow of b - a)
                              MOV   A,E   
                              SUB   L   
                              MOV   A,D   
                              SBB   H   
                              SBB   A   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              RAL      
                              SBB   A   
                              XRA   L   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_EQ:    POP   H   ; =
                              MOV   A,L   
                              XRA   E   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              ORA   L   
                              SUI   1   
                              SBB   A   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:   POP   H   ; &
                              MOV   A,H   
                              ANA   D   
                              MOV   D,A   
                              MOV   A,L   
                              ANA   E   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_OR:    POP   H   ; |
                              MOV   A,H   
                              ORA   D   
                              MOV   D,A   
                              MOV   A,L   
                              ORA   E   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_XOR:   POP   H   ; ^
                              MOV   A,H   
                              XRA   D   
                              MOV   D,A   
                              MOV   A,L   
                              XRA   E   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NOT:   MOV   A,E   ; ~
                              CMA      
                              MOV   E,A   
                              MOV   A,D   
                              CMA      
                              MOV   D,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
