0231   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0232   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0233   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0234   D1           H_AND:    POP   D   
0235   7C                     MOV   A,H   
0236   A2                     ANA   D   
0237   67                     MOV   H,A   
0238   7D                     MOV   A,L   
0239   A3                     ANA   E   
