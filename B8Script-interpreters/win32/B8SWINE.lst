   643                              <1> ; =============================================================================
   644                              <1> ;  Checked build: the checks and the error report (here, so that the
   645                              <1> ;  handlers' bodies above reach the error entries with short jumps)
   646                              <1> ; =============================================================================
   647                              <1> %if CHECKED
   648                              <1> e_zero: mov     al,'Z'                  ; dividing by zero
   649                              <1>         jmp     error
   650                              <1> e_heap: mov     al,'H'                  ; the heap
   651                              <1>         jmp     error
   652                              <1> 
   653                              <1> ; chkst1, chkst2: stop with O unless the 1 or 2 bytes at TOS are in the
   654                              <1> ; program's space: from the letter page up to the heap limit. Memory above
   655                              <1> ; the heap top but below the limit is the program's own: Tiny BASIC keeps
   656                              <1> ; its lines there.
   657                              <1> chkst2: mov     eax,ebx
   658                              <1>         sub     ax,LET
   659                              <1>         cmp     ax,LIMIT-LET-1
   660                              <1>         jmp     short chs1
   661                              <1> chkst1: mov     eax,ebx
   662                              <1>         sub     ax,LET
   663                              <1>         cmp     ax,LIMIT-LET
   664                              <1> chs1:   jae     e_store
   665                              <1>         ret
   666                              <1> 
   667                              <1> ; chkstk: both stacks are checked once per character, not in every handler.
   668                              <1> ; A character can pop a cell or two too many, or push one too many, before
   669                              <1> ; it is seen here: the data stack has the caller's frame above it and the
   670                              <1> ; thread's stack below, and the return stack has the image's spare space on
   671                              <1> ; both sides.
   672                              <1> chkstk: lea     eax,[esp+4]
   673                              <1>         sub     eax,[V(v_dstop)]        ; minus 4 x the depth
   674                              <1>         jg      e_under
   675                              <1>         cmp     eax,-4*DSMAX
   676                              <1>         jl      e_over
   677                              <1>         cmp     di,RSTOP & 0FFFFh       ; (the return stack is in one 64K: only
   678                              <1>         ja      e_rund                  ;   the low word changes)
   679                              <1>         cmp     di,(RSTOP-4*RSMAX) & 0FFFFh
   680                              <1>         jb      e_rover
   681                              <1>         ret
   682                              <1> e_under:mov     esp,[V(v_dstop)]        ; data stack underflow: it counts as
   683                              <1>         mov     al,'s'                  ;   empty
   684                              <1>         jmp     short error
   685                              <1> e_rund: mov     edi,RSTOP               ; return stack underflow: the same.
   686                              <1>         or      esi,ARENA               ;   (A ']' or ')' may have taken an IP
   687                              <1>         mov     al,'r'                  ;   of 0 from below the stack: keep the
   688                              <1>                                         ;   place readable)
   689                              <1>         jmp     short errp
   690                              <1> e_rover:mov     al,'R'
   691                              <1>         jmp     short errp
   692                              <1> e_over: mov     al,'S'
   693                              <1>         jmp     short errp
   694                              <1> e_break:mov     al,'B'                  ; Ctrl-C (inside pollk or getk)
   695                              <1>         jmp     short errp
   696                              <1> e_store:mov     al,'O'                  ; a store outside the program's space
   697                              <1>         jmp     short errp
   698                              <1> e_dollar:mov    al,'Q'                  ; '$' ran into a NUL
   699                              <1> ; errp: an error found inside a routine: drop its return address first.
   700                              <1> errp:   pop     edx
   701                              <1>         jmp     short error
   702                              <1> e_quote:mov     esi,ebx                 ; an unclosed string: its address, one
   703                              <1>         mov     al,'Q'                  ;   past the quote, is the place
   704                              <1>         jmp     short error
   705                              <1> e_brack:mov     al,'W'                  ; bad character after [
   706                              <1> 
   707                              <1> ; error: the report, then the end. AL = the letter, ESI = one past the
   708                              <1> ; place, EBX = TOS, and both stacks as the report is to show them:
   709                              <1> ;
   710                              <1> ;   Err X @ line,col
   711                              <1> ;   up to 16 characters of the text from the place
   712                              <1> ;   Stk n: the top 8 cells at most, bottom to top
   713                              <1> ;   Rtn n
   714                              <1> ;
   715                              <1> ; It goes to the standard error handle.
   716                              <1> error:  push    ebx                     ; now the whole data stack is in memory
   717                              <1>         mov     bl,al
