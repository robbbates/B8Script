F564                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled)
                    UD0:      CLRA      
                              CLRB      
                              ASL   3,U   
                              ROL   2,U   
                              ROLB      
                              ROLA      
                              CMPD   ,U   
                              BLO   ur0   
                              SUBD   ,U   
                              INC   3,U   
                    UR0:         
                              ASL   3,U   
                              ROL   2,U   
                              ROLB      
                              ROLA      
                              CMPD   ,U   
                              BLO   ur1   
                              SUBD   ,U   
                              INC   3,U   
