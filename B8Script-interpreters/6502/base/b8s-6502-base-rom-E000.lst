                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FVBF:     LDY   #42h   
                              JMP   fvat   
