0419   4D                     LD   C,L   ;   past the opening quote, which is the place
041A   3E 51                  LD   A,"Q"   
041C   11                     DB   11h   
041D   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
041F   11                     DB   11h   
0420   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0422   11                     DB   11h   
0423   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0425                             ; error: the report, then the end. A = the letter, BC = one past the place,
0425                             ; HL = TOS, and both stacks as the report is to show them:
0425                             ; 
0425                             ;   Err X @ line,col
0425                             ;   up to 16 characters of the text from the place
0425                             ;   Stk n: the top 8 cells at most, bottom to top
0425                             ;   Rtn n
0425   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0426   5F                     LD   E,A   
0427   CD 21 02               CALL   pnl   
042A   45 72 72 20 22         DB   "Err ",22h   
042F   7B                     LD   A,E   
0430   EF                     RST   28h   
0431   CD 27 02               CALL   pmsg   
0434   20 40 20 22            DB   " @ ",22h   
0438   0B                     DEC   BC   ; BC = the place
