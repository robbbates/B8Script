04EE                          ;*Macro unroll:  NEXT
04EE                          DS   (1-CPM)*(1-FAST),0F7h   
04EE   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04EF   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04F0                          ENDIF      
04F0                          IF   QK   
04F0                             ; A true ")" reads the block start where it is, on top of the return stack,
04F0                             ; instead of popping it and pushing it back; the break key is looked at as
04F0                             ; rpushn would.
04F0   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
04F3   FD 46 01               LD   B,(IY+1)   
04F6   E5                     PUSH   HL   
04F7   21 36 82               LD   HL,PCNT   
04FA   35                     DEC   (HL)   
04FB   E1                     POP   HL   
04FC   CC 53 05               CALL   Z,pollk   
04FF                          ;*Macro unroll:  NEXT
04FF                          DS   (1-CPM)*(1-FAST),0F7h   
04FF   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0500   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0501                          ENDIF      
0501                          IF   QUICKU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0501                          ENDIF      
0501                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
0501                          ENDIF      
0501                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
0501   CD 35 04     QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
0504   C3 3F 00               JP   init   
0507                          ENDIF      
0507                             ; =============================================================================
0507                             ;  Dispatch table: the low byte of each handler's address, in code order
0507                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0507                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0507                             ; =============================================================================
0507                             ; The handlers of the first NPG1 characters start in the image's second page.
0507                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0507                             ; differs between the builds, so the count is worked out here.
0507                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0507                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0507                PGBRK:    EQU   (h_break-BASE)/256   
0507                PGDEF:    EQU   (h_def-BASE)/256   
0507                PGFET:    EQU   (h_fetch-BASE)/256   
0507                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0507                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0507                          ENDIF      
0507                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0507                             ; and return its value in A with the carry set; otherwise leave the IP and
0507                             ; return with the carry clear.
0507   0A           HEXC:     LD   A,(BC)   
0508   D6 30                  SUB   "0"   
050A   FE 0A                  CP   10   
050C   38 09                  JR   C,hc1   
050E   E6 DF                  AND   0DFh   
0510   D6 11                  SUB   11h   
0512   FE 06                  CP   6   
0514   D0                     RET   NC   
0515   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0517   03           HC1:      INC   BC   
0518   C9                     RET      
0519                             ; psgn: print HL as a signed number. Keeps BC.
0519   CB 7C        PSGN:     BIT   7,H   
051B   28 04                  JR   Z,pdec   
051D                          ;*Macro unroll:  PUTK    2Dh             ; '-'
051D   3E                     DS   1-CPM,3Eh   ; "-"
051E   2D                     DS   1-CPM,2Dh   
051F   EF                     DS   1-CPM,0EFh   
0520                          DS   CPM,0CDh   
0520                          DS   CPM,APTK&0FFh   
0520                          DS   CPM,APTK/256   
0520                          DS   CPM,2Dh   
0520                          ;*Macro unroll:  NEGH
0520   E7                     DS   1-CPM,0E7h   
0521                          DS   CPM,0CDh   
0521                          DS   CPM,ANEG&0FFh   
0521                          DS   CPM,ANEG/256   
0521                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0521                             ; Keeps BC.
0521   11 0A 00     PDEC:     LD   DE,10   
0524   CD 7A 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0527   7B                     LD   A,E   
0528   F5                     PUSH   AF   
0529   7C                     LD   A,H   
052A   B5                     OR   L   
052B   C4 21 05               CALL   NZ,pdec   
052E   F1                     POP   AF   
052F   C6 30                  ADD   A,"0"   
0531                          ;*Macro unroll:  PUTAR
0531   EF                     DS   1-CPM,0EFh   
0532   C9                     DS   1-CPM,0C9h   
0533                          DS   CPM,0C3h   
0533                          DS   CPM,APUT&0FFh   
0533                          DS   CPM,APUT/256   
0533                             ; (The table goes here instead in the builds where, before psgn, it would
0533                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0533                             ; page: PTPAD is 0 unless it must.)
0533                          IF   (1-TABP0)*PTLATE   
0533                PTPH:     EQU   $ & 0FFh   
0533                PTPX:     EQU   (PTPH + 31) / 256   
0533                PTPAD:    EQU   PTPX * (256 - PTPH)   
0533                          DS   PTPAD   
0533                PTAB:        
0533                          ;*Macro unroll:  PTABLE
0533   9C                     DB   h_store & 0FFh   
0534   A6                     DB   h_str & 0FFh   
0535   C0                     DB   h_num & 0FFh   
0536   B2                     DB   h_print & 0FFh   
0537   91                     DB   h_swap & 0FFh   
0538   42                     DB   h_and & 0FFh   
0539   BB                     DB   h_emit & 0FFh   
053A   1F                     DB   h_open & 0FFh   
053B   27                     DB   h_close & 0FFh   
053C   65                     DB   h_mul & 0FFh   
053D   37                     DB   h_add & 0FFh   
053E   DE                     DB   h_cfetch & 0FFh   
053F   2F                     DB   h_sub & 0FFh   
0540   94                     DB   h_cstore & 0FFh   
0541   69                     DB   h_div & 0FFh   
0542   8E                     DB   h_dup & 0FFh   
0543   99                     DB   h_drop & 0FFh   
0544   4B                     DB   h_lt & 0FFh   
0545   5B                     DB   h_eq & 0FFh   
0546   4C                     DB   h_gt & 0FFh   
0547   C6                     DB   h_key & 0FFh   
0548   19                     DB   h_fetch & 0FFh   
0549   F4                     DB   h_def & 0FFh   
054A   E6                     DB   h_break & 0FFh   
054B   E1                     DB   h_ret & 0FFh   
054C   62                     DB   h_xor & 0FFh   
054D   78                     DB   h_alloc & 0FFh   
054E   CA                     DB   h_grave & 0FFh   
054F   C6                     DB   h_tor & 0FFh   
0550   6B                     DB   h_or & 0FFh   
0551   1C                     DB   h_fromr & 0FFh   
0552   74                     DB   h_not & 0FFh   
0553                PTABEND:      
0553                          ENDIF      
0553                             ; =============================================================================
0553                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0553                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0553                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0553                             ;  they are the host's KEY and CONOUT routines themselves.
0553                             ; 
0553                             ;  A running program reads the keyboard only through getk and pollk, which
0553                             ;  between them give the break key its rules:
0553                             ;    - Ctrl-C stops the program;
0553                             ;    - any other key that the break check reads is held in KEYBUF for the
0553                             ;      next "?", and a newer one takes its place;
0553                             ;    - "?" (getk) takes the held key first;
0553                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0553                             ;      key like any other, but two of them within about 250 ms still stop it.
0553                             ;  Both are called straight from a handler, never from a routine under one:
0553                             ;  the checked build's report counts on finding one return address above the
0553                             ;  data stack.
0553                             ; =============================================================================
0553                          IFN   CPM   
0553                RAWK:     EQU   KEY   
0553                          ENDIF      
0553                             ; pollk: the break check (see rpushn).
0553   CD 06 FF     POLLK:    CALL   rawk   
0556   C8                     RET   Z   ; no key
0557   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
055A   FE 03        PK1:      CP   3   ; (getk joins here)
055C   C0                     RET   NZ   
055D                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
055D                             ; the program has turned it off, wait about 250 ms for one more key: a
055D                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
055D                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
055D   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0560   B7                     OR   A   
0561   CA EA 05     CT0:      JP   Z,brk   
0564   D5                     PUSH   DE   
0565   11 10 27               LD   DE,250*MSLOOP   
0568   CD 06 FF     CT1:      CALL   rawk   
056B   20 05                  JR   NZ,ct2   
056D   1B                     DEC   DE   
056E   7A                     LD   A,D   
056F   B3                     OR   E   
0570   20 F6                  JR   NZ,ct1   
0572   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0573   FE 03                  CP   3   
0575   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0577   B7                     OR   A   
0578   28 03                  JR   Z,ct3   
057A   32 7A 82               LD   (KEYBUF),A   
057D   3E 03        CT3:      LD   A,3   
057F   B7                     OR   A   
0580   C9                     RET      
0581                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0581   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0582   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0585   7E                     LD   A,(HL)   
0586   36 00                  LD   (HL),0   
0588   E1                     POP   HL   
0589   B7                     OR   A   
058A   C0                     RET   NZ   
058B   CD 06 FF               CALL   rawk   
058E   C8                     RET   Z   
058F   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0591                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0591                          ENDIF      ;   (with the editor, both stacks are cleared);
0591                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0591                          ENDIF      
0591                          IF   CHECKED   
0591                BRK:      EQU   e_break   ;   the checked build reports B
0591                          ENDIF      
0591                          IF   CPM   
                                 ; The routines a generic build keeps in page zero (see there). Here they are
                                 ; out of the way of the handlers, which must fit in the image's first two
                                 ; pages.
                    RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
                              LD   D,(IY+1)   
                              INC   IY   
                              INC   IY   
                              RET      
                    NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
0591                          ENDIF      
0591                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0591                          ENDIF      
0591                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JR   putc   
                    PUTK:     EX   (SP),HL   ; print the byte after the CALL
                              LD   A,(HL)   
                              INC   HL   
                              EX   (SP),HL   
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                                 ; It keeps every register but A and the flags: BDOS may change any of them
                                 ; (IX and IY too, in a Z80 BDOS or BIOS).
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              PUSH   IX   
                              PUSH   IY   
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              POP   IY   
                              POP   IX   
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              OR   A   ; (for getk)
                              RET      
0591                          ENDIF      
0591                             ; =============================================================================
0591                             ;  Checked build: the checks and the error report
0591                             ; =============================================================================
0591                          IF   CHECKED   
0591                             ; chkstk: both stacks are checked once per character, not in every handler.
0591                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0591                             ; the constant carries if it is above (cells were popped that were never
0591                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0591                             ; a character late at most: the bytes above DSTOP and the guard band below
0591                             ; the page take what happens meanwhile. DE is free between characters.
0591   EB           CHKSTK:   EX   DE,HL   
0592   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0595   39                     ADD   HL,SP   
0596   EB                     EX   DE,HL   
0597   38 1E                  JR   C,e_under   
0599   14                     INC   D   
059A   20 17                  JR   NZ,e_over   
059C   FD E5                  PUSH   IY   ; the return stack: in its page (or it has
059E   D1                     POP   DE   ;   overflowed), and not above its empty
059F   7A                     LD   A,D   ;   position (an underflow stays inside the
05A0   FE 80                  CP   RSPAGE   ;   page, in the guard band)
05A2   7B                     LD   A,E   
05A3   20 0B                  JR   NZ,e_rover   
05A5   FE E1                  CP   RSTOP&0FFh+1   
05A7   D8                     RET   C   
05A8   FD 21 E0 80            LD   IY,RSTOP   ; return stack underflow: it counts as empty
05AC   3E 72                  LD   A,"r"   
05AE   18 3C                  JR   errp   
05B0   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
05B2   11                     DB   11h   ; (LD DE,nn hides the next entry)
05B3   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
05B5   18 35                  JR   errp   
05B7   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
05BA   3E 73                  LD   A,"s"   
05BC   18 48                  JR   error   
05BE                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
05BE                             ; was never defined still holds 0000h, and the byte there is a reserved one
05BE                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
05BE                             ; an undefined word. The call is undone, so the place is the call itself.
05BE   04           E_HI:     INC   B   
05BF   10 3D                  DJNZ   e_resv   ; (B is as it was, and is not 0)
05C1                          ;*Macro unroll:  POPR
05C1   CF                     DS   1-CPM,0CFh   
05C2                          DS   CPM,0CDh   
05C2                          DS   CPM,AROP&0FFh   
05C2                          DS   CPM,AROP/256   
05C2   42                     LD   B,D   
05C3   4B                     LD   C,E   
05C4   3E 55                  LD   A,"U"   
05C6   18 3E                  JR   error   
05C8                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
05C8                             ; the count. Stop if the top is not below the limit page, or is below the
05C8                             ; program's end.
05C8                CHKHP:       
05C8                          ENDIF      
05C8                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
05C8                          ENDIF      
05C8                          IF   CHECKED*(1-CPM)   
05C8                             ; (Here the program's space is under 32K, so a top that wrapped
05C8                             ; round always falls outside it.)
05C8   7C                     LD   A,H   
05C9   FE F0                  CP   HEAPLIM   
05CB   30 09                  JR   NC,e_heap   
05CD                          ENDIF      
05CD                          IF   CHECKED   
05CD   D5                     PUSH   DE   
05CE   EB                     EX   DE,HL   
05CF   2A 38 82               LD   HL,(NPEND)   
05D2   19                     ADD   HL,DE   ; carry: at or above the program's end
05D3   EB                     EX   DE,HL   
05D4   D1                     POP   DE   
05D5   D8                     RET   C   
05D6   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
05D7   ED 52                  SBC   HL,DE   
05D9   3E 48                  LD   A,"H"   
05DB   18 0F                  JR   errp   
05DD                             ; chkst: stop unless HL is in the program's own space: from the letter page
05DD                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
05DD                             ; whatever lies above the limit are safe. Memory above the heap top but
05DD                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
05DD                             ; It is the page of HL + 1 that is tested, so that one test serves both
05DD                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
05DD                             ; Keeps HL and BC. It runs on into its own error entry.
05DD   23           CHKST:    INC   HL   
05DE   7C                     LD   A,H   
05DF   2B                     DEC   HL   
05E0   FE 82                  CP   LETPAGE   
05E2   38 03                  JR   C,e_store   
05E4                          ENDIF      
05E4                          IF   CHECKED*(1-CPM)   
05E4   FE F0                  CP   HEAPLIM   
05E6   D8                     RET   C   
05E7                          ENDIF      
05E7                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
05E7                          ENDIF      
05E7                          IF   CHECKED   
05E7                             ; Error entries. Each loads its letter and then hides the next entry inside
05E7                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
05E7   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
05E9   11                     DB   11h   
05EA   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
05EC                             ; errp: an error found inside a routine: drop its return address first.
05EC   D1           ERRP:     POP   DE   
05ED   18 17                  JR   error   
05EF                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
05EF                             ; back in TOS. prstr"s return address goes first. But if "$' had no
05EF                             ; address at all (the stack was empty), it is s, found now: chkstk, called
05EF                             ; one cell up, sees the stack past its empty place then.
05EF   D1           E_DOLLAR:   POP   DE   
05F0   E1                     POP   HL   
05F1   CD 91 05               CALL   chkstk   
05F4   E5                     PUSH   HL   
05F5   2A 34 82               LD   HL,(RSAVE)   
05F8   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
05F9   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
05FA   4D                     LD   C,L   ;   past the opening quote, which is the place
05FB   3E 51                  LD   A,"Q"   
05FD   11                     DB   11h   
05FE   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
0600   11                     DB   11h   
0601   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0603   11                     DB   11h   
0604   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0606                             ; error: the report, then the end. A = the letter, BC = one past the place,
0606                             ; HL = TOS, and both stacks as the report is to show them:
0606                             ; 
0606                             ;   Err X @ line,col
0606                             ;   D:n: the top 8 cells at most, bottom to top
0606                             ;   R:n
0606   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0607   5F                     LD   E,A   
0608   CD 2F 02               CALL   pnl   
060B   45 72 72 20 22         DB   "Err ",22h   
0610   7B                     LD   A,E   
0611                          ;*Macro unroll:  PUTA
0611   EF                     DS   1-CPM,0EFh   
0612                          DS   CPM,0CDh   
0612                          DS   CPM,APUT&0FFh   
0612                          DS   CPM,APUT/256   
0612   CD 35 02               CALL   pmsg   
0615   20 40 20 22            DB   " @ ",22h   
0619   0B                     DEC   BC   ; BC = the place
061A                             ; The line and column. A place below the program is in the line
061A                             ; buffer: line 0. Otherwise count the LFs from the program's start;
061A                             ; DE = the line's number, HL = where it starts.
061A   21 80 82               LD   HL,LINEBUF   
061D   11 00 00               LD   DE,0   
0620   78                     LD   A,B   
0621   FE 83                  CP   PROG/256   
0623   38 14                  JR   C,er3   
0625   24                     INC   H   
0626   6B                     LD   L,E   ; HL = PROG
0627   13           ER1:      INC   DE   ; a new line starts at HL
0628   E5                     PUSH   HL   
0629   7D           ER2:      LD   A,L   
062A   91                     SUB   C   
062B   7C                     LD   A,H   
062C   98                     SBC   A,B   
062D   30 09                  JR   NC,er2x   ; reached the place
062F   7E                     LD   A,(HL)   
0630   23                     INC   HL   
0631   FE 0A                  CP   10   
0633   20 F4                  JR   NZ,er2   
0635   F1                     POP   AF   
0636   18 EF                  JR   er1   
0638   E1           ER2X:     POP   HL   
0639   C5           ER3:      PUSH   BC   
063A   E5                     PUSH   HL   
063B   EB                     EX   DE,HL   
063C   CD 21 05               CALL   pdec   ; the line
063F                          ;*Macro unroll:  PUTK    2Ch             ; ','
063F   3E                     DS   1-CPM,3Eh   ; ","
0640   2C                     DS   1-CPM,2Ch   
0641   EF                     DS   1-CPM,0EFh   
0642                          DS   CPM,0CDh   
0642                          DS   CPM,APTK&0FFh   
0642                          DS   CPM,APTK/256   
0642                          DS   CPM,2Ch   
0642   D1                     POP   DE   
0643   E1                     POP   HL   
0644   B7                     OR   A   
0645   ED 52                  SBC   HL,DE   
0647   23                     INC   HL   
0648   CD 21 05               CALL   pdec   ; the column
064B                             ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
064B                             ;                       R:n
064B                             ; TOS is in memory with the rest (pushed) by now.
064B   CD 2F 02               CALL   pnl   
064E   44 3A 22               DB   "D:",22h   
0651   21 FA 81               LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
0654   ED 72                  SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
0656                             ;   and holds nothing; pnl left the carry clear)
0656   CD 9C 06               CALL   phalf   ; the depth
0659                          ;*Macro unroll:  PUTK    3Ah             ; ':'
0659   3E                     DS   1-CPM,3Eh   ; ":"
065A   3A                     DS   1-CPM,3Ah   
065B   EF                     DS   1-CPM,0EFh   
065C                          DS   CPM,0CDh   
065C                          DS   CPM,APTK&0FFh   
065C                          DS   CPM,APTK/256   
065C                          DS   CPM,3Ah   
065C   79                     LD   A,C   
065D   FE 09                  CP   9   
065F   38 0A                  JR   C,er6   
0661   CD 35 02               CALL   pmsg   
0664   20 2E 2E 2E 22         DB   " ...",22h   
0669   0E 08                  LD   C,8   
066B   26 00        ER6:      LD   H,0   ; C = the number of cells to show
066D   69                     LD   L,C   
066E   29                     ADD   HL,HL   
066F   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0670   0C                     INC   C   
0671   0D           ER7:      DEC   C   
0672   28 0F                  JR   Z,er8   
0674   2B                     DEC   HL   
0675   56                     LD   D,(HL)   
0676   2B                     DEC   HL   
0677   5E                     LD   E,(HL)   
0678   E5                     PUSH   HL   
0679                          ;*Macro unroll:  PUTK    20h             ; ' '
0679   3E                     DS   1-CPM,3Eh   ; " "
067A   20                     DS   1-CPM,20h   
067B   EF                     DS   1-CPM,0EFh   
067C                          DS   CPM,0CDh   
067C                          DS   CPM,APTK&0FFh   
067C                          DS   CPM,APTK/256   
067C                          DS   CPM,20h   
067C   EB                     EX   DE,HL   
067D   CD 19 05               CALL   psgn   
0680   E1                     POP   HL   
0681   18 EE                  JR   er7   
0683   CD 2F 02     ER8:      CALL   pnl   
0686   52 3A 22               DB   "R:",22h   
0689   FD E5                  PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
068B   E1                     POP   HL   ;   at most one entry below its page), so
068C   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough
068E   95                     SUB   L   
068F   6F                     LD   L,A   
0690   26 00                  LD   H,0   
0692   CD 9C 06               CALL   phalf   
0695   CD 2F 02               CALL   pnl   
0698   22                     DB   22h   
0699                          ENDIF      
0699                          IF   CHECKED*(1-EDITOR)   
0699   C3 14 00               JP   endprog   
069C                          ENDIF      
069C                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
069C                          ENDIF      
069C                          IF   CHECKED   
069C                             ; phalf: print half of HL, and leave it in C.
069C   CB 3C        PHALF:    SRL   H   
069E   CB 1D                  RR   L   
06A0   E5                     PUSH   HL   
06A1   CD 21 05               CALL   pdec   
06A4   C1                     POP   BC   
06A5   C9                     RET      
06A6                          ENDIF      
06A6                             ; =============================================================================
06A6                             ;  The line editor (EDITOR = 1)
06A6                             ; 
06A6                             ;  The interpreter starts here, and a program that ends comes back here.
06A6                             ;  There is no prompt. It follows the spec's suggested standard for a line
06A6                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
06A6                             ; 
06A6                             ;    n text    put the text in as line n; the lines from n on move down. A
06A6                             ;              number past the end (or 0) adds the line at the end.
06A6                             ;    n         take line n out
06A6                             ;    anything else is run at once, as B8Script. (Start such a line with a
06A6                             ;    space if it would begin with a digit.)
06A6                             ; 
06A6                             ;  A command key ends the line too, and takes what was typed as its argument:
06A6                             ; 
06A6                             ;    ^G        run the program
06A6                             ;    n ^L      list from line n (no number: all of it). Any key holds the
06A6                             ;              list until another key is pressed; Ctrl-C ends it.
06A6                             ;    n ^E      put line n in the input line; Return puts it back, changed
06A6                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
06A6                             ;              last time). Generic: what is typed, or pasted, from now until
06A6                             ;              ^Z replaces the program; it is not echoed.
06A6                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
06A6                             ;              time). Generic: the text is printed, as it is.
06A6                             ;    ^N        new: no program
06A6                             ;    ^X        leave (to LEAVE)
06A6                             ; 
06A6                             ;  In the line: the left and right arrow keys move the cursor;
06A6                             ;  a character goes in at the cursor; Backspace and DEL take out the one
06A6                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
06A6                             ;  sent to the terminal, so any terminal will do.
06A6                             ; 
06A6                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
06A6                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
06A6                             ;  125 characters; the one character after a line number separates it from
06A6                             ;  the text and is not stored. The text is kept as it is typed, each line
06A6                             ;  ending in CR LF, at PROG.
06A6                             ; 
06A6                             ;  What lasts from one line to the next: the program, the words, the
06A6                             ;  variables and the data stack. An error or a break clears both stacks. The
06A6                             ;  return stack starts empty for every line.
06A6                             ; 
06A6                             ;  Things to know:
06A6                             ;    - Reset empties the program (generic builds).
06A6                             ;    - A word's address points into the program, so run the program again
06A6                             ;      after editing it.
06A6                             ;    - Nothing is printed between a program's output and what is typed next.
06A6                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
06A6                             ;      a line that calls -n? and carries on afterwards runs what was typed.
06A6                             ;      (The stored program never comes back to the line, so it may.)
06A6                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
06A6                             ;      read of the other builds.
06A6                             ; 
06A6                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
06A6                             ;  the last line left there, with TOS pushed like the rest.
06A6                             ; =============================================================================
06A6                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
06A6                          ENDIF      
06A6                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
06A6                          ENDIF      
06A6                          IF   EDGEN   
                              JR   edit0   
06A6                          ENDIF      
06A6                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
06A6                          ENDIF      
06A6                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
06A6                          ENDIF      
06A6                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
06A6                          ENDIF      
06A6                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
06A6                          ENDIF      
06A6                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
06A6                          ENDIF      
06A6                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
06A6                          ENDIF      
06A6                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
06A6                          ENDIF      
06A6                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
06A6                          ENDIF      
06A6                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
06A6                          ENDIF      
06A6                             ; =============================================================================
06A6                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
06A6                          ENDIF      
06A6                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
06A6                          ENDIF      
06A6                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
06A6                          ENDIF      
06A6                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
06A6                          ENDIF      
06A6                          IF   CPM*(1-EDITOR)   
                              JP   st2   
06A6                          ENDIF      
06A6                          IF   FAST   
06A6                             ; =============================================================================
06A6                             ;  The speed build (FAST = 1)
06A6                             ; 
06A6                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
06A6                             ;  addresses in one page and the high bytes in the next. The dispatcher (at
06A6                             ;  next0, and inline, as NEXTF, at the end of the speed build's own entries,
06A6                             ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
06A6                             ;  IX = next0, as in the CP/M builds):
06A6                             ; 
06A6                             ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
06A6                             ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
06A6                             ; 
06A6                             ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
06A6                             ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
06A6                             ;  digits have one entry each, which knows its cell or its value already.
06A6                             ; =============================================================================
06A6   EB           FTSTORE:   EX   DE,HL   ; !
06A7   C3 9C 01               JP   h_store   
06AA   EB           FTSTR:    EX   DE,HL   ; "
06AB   C3 A6 01               JP   h_str   
06AE   EB           FTNUM:    EX   DE,HL   ; #
06AF   C3 C0 01               JP   h_num   
06B2   EB           FTPRINT:   EX   DE,HL   ; $
06B3   C3 B2 01               JP   h_print   
06B6   EB           FTSWAP:   EX   DE,HL   ; %
06B7   C3 91 01               JP   h_swap   
06BA   EB           FTAND:    EX   DE,HL   ; &
06BB   C3 42 01               JP   h_and   
06BE   EB           FTEMIT:   EX   DE,HL   ; '
06BF   C3 BB 01               JP   h_emit   
06C2   EB           FTOPEN:   EX   DE,HL   ; (
06C3   C3 1F 01               JP   h_open   
06C6   EB           FTCLOSE:   EX   DE,HL   ; )
06C7   C3 27 01               JP   h_close   
06CA   EB           FTMUL:    EX   DE,HL   ; *
06CB   C3 65 01               JP   h_mul   
06CE   EB           FTADD:    EX   DE,HL   ; +
06CF   C3 37 01               JP   h_add   
06D2   EB           FTCFETCH:   EX   DE,HL   ; ,
06D3   C3 DE 01               JP   h_cfetch   
06D6   EB           FTSUB:    EX   DE,HL   ; -
06D7   C3 2F 01               JP   h_sub   
06DA   EB           FTCSTORE:   EX   DE,HL   ; .
06DB   C3 94 01               JP   h_cstore   
06DE   EB           FTDIV:    EX   DE,HL   ; /
06DF   C3 69 01               JP   h_div   
06E2   EB           FTDUP:    EX   DE,HL   ; :
06E3   C3 8E 01               JP   h_dup   
06E6   EB           FTDROP:   EX   DE,HL   ; ;
06E7   C3 99 01               JP   h_drop   
06EA   EB           FTLT:     EX   DE,HL   ; <
06EB   C3 4B 01               JP   h_lt   
06EE   EB           FTEQ:     EX   DE,HL   ; =
06EF   C3 5B 01               JP   h_eq   
06F2   EB           FTGT:     EX   DE,HL   ; >
06F3   C3 4C 01               JP   h_gt   
06F6   EB           FTKEY:    EX   DE,HL   ; ?
06F7   C3 C6 01               JP   h_key   
06FA   EB           FTFETCH:   EX   DE,HL   ; @
06FB   C3 19 01               JP   h_fetch   
06FE   EB           FTDEF:    EX   DE,HL   ; [
06FF   C3 F4 00               JP   h_def   
0702   EB           FTBREAK:   EX   DE,HL   ; \
0703   C3 E6 00               JP   h_break   
0706   EB           FTRET:    EX   DE,HL   ; ]
0707   C3 E1 00               JP   h_ret   
070A   EB           FTXOR:    EX   DE,HL   ; ^
070B   C3 62 00               JP   h_xor   
070E   EB           FTALLOC:   EX   DE,HL   ; _
070F   C3 78 00               JP   h_alloc   
0712   EB           FTGRAVE:   EX   DE,HL   ; `
0713   C3 CA 00               JP   h_grave   
0716   EB           FTTOR:    EX   DE,HL   ; {
0717   C3 C6 00               JP   h_tor   
071A   EB           FTOR:     EX   DE,HL   ; |
071B   C3 6B 00               JP   h_or   
071E   EB           FTFROMR:   EX   DE,HL   ; }
071F   C3 1C 00               JP   h_fromr   
0722   EB           FTNOT:    EX   DE,HL   ; ~
0723   C3 74 00               JP   h_not   
0726                             ; The commonest punctuation, written for the speed build: TOS in DE on the
0726                             ; way in, and the dispatcher inline on the way out.
0726                FS_ADD:      ; +
0726   E1                     POP   HL   
0727   19                     ADD   HL,DE   
0728                          ;*Macro unroll:  NEXTF
0728   CD                     DS   FAST*CHECKED,0CDh   
0729   91                     DS   FAST*CHECKED,ACHK&0FFh   
072A   05                     DS   FAST*CHECKED,ACHK/256   
072B   0A                     DS   FAST,0Ah   
072C   03                     DS   FAST,03h   
072D   EB                     DS   FAST,0EBh   
072E   6F                     DS   FAST,6Fh   
072F   26                     DS   FAST,26h   
0730   10                     DS   FAST,DTPG   
0731   7E                     DS   FAST,7Eh   
0732   24                     DS   FAST,24h   
0733   66                     DS   FAST,66h   
0734   6F                     DS   FAST,6Fh   
0735   E9                     DS   FAST,0E9h   
0736                FS_SUB:      ; -
0736   0A                     LD   A,(BC)   ; a digit next: a negative number
0737   D6 30                  SUB   "0"   
0739   FE 0A                  CP   10   
073B   38 12                  JR   C,fs_neg   
073D   E1                     POP   HL   
073E   B7                     OR   A   
