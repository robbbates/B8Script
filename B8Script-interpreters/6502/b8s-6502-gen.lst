E1CF                             ; test is at the bottom so the loop closes with a branch. Returns with the
E1CF                             ; carry set.
E1CF   20 1F E2     RD1:      JSR   incip   ; (keeps A = the digit)
E1D2   06 02                  ASL   TL   
E1D4   26 03                  ROL   TH   ; x2
E1D6   18                     CLC      
E1D7   65 02                  ADC   TL   
E1D9   85 04                  STA   T0   
E1DB   A5 03                  LDA   TH   
E1DD   69 00                  ADC   #0   
E1DF   85 05                  STA   T1   ; T = x2 + digit
E1E1   06 02                  ASL   TL   
E1E3   26 03                  ROL   TH   
E1E5   06 02                  ASL   TL   
E1E7   26 03                  ROL   TH   ; x8
E1E9   18                     CLC      
E1EA   A5 02                  LDA   TL   
E1EC   65 04                  ADC   T0   
E1EE   85 02                  STA   TL   
E1F0   A5 03                  LDA   TH   
