0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only), with the data stack
0000                             ;  in zero page
0000                             ;  Spec: docs/b8script.md (2026-11-21). -n? does no more editing than
0000                             ;        Backspace. The break key is checked in the checked build only (at
0000                             ;        every ")" loop-back and every return).
0000                             ; 
0000                             ;  This is the smaller of the two 6502 interpreters. b8s-6502.asm keeps the
0000                             ;  data stack in pages 2 and 3 (252 cells) and leaves zero page almost free;
0000                             ;  this one keeps it in zero page (112 cells), where the 6502's short
0000                             ;  addressing modes make nearly every handler smaller. The language is the
0000                             ;  same; the memory map and the machine-code contract differ.
0000                             ; 
0000                             ;  One switch, set in the EQU line below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's four-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   0/ "no"$
0000                             ;                   Stk 2: 5 0
0000                             ;                   Rtn 0
0000                             ;                 and then goes to EXIT.
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    X       the data-stack pointer. Every cell is two bytes in zero page, low
0000                             ;            byte first: the top cell (TOS) is 0,X and 1,X, the one under it
0000                             ;            (NOS) 2,X and 3,X. The stack grows down: a push is DEX DEX, a
0000                             ;            drop INX INX. A cell that holds an address is used where it is,
0000                             ;            with (0,X): nothing is copied to a pointer first.
0000                             ;    $FE,X   the two bytes under the top cell (zero-page indexing wraps, so
0000                             ;    $FF,X   this is -2,X and -1,X): free memory, used as scratch.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  PTAB holds one byte per punctuation character: the low byte of its
0000                             ;  handler's address, less 1 (the dispatcher pushes an address and "returns"
0000                             ;  to it). The high byte comes from the character: the handlers of the first
0000                             ;  N1 characters start in the image's first page, those of the characters from
0000                             ;  N1 up to N2 in its second, and the rest in its third. The layout below
0000                             ;  keeps to that, and testing/chktab6502.py checks it in every build.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the dispatcher
0000                             ;  leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry the
0000                             ;  address has been dropped and X is the data-stack pointer: TOS is 0,X (low)
0000                             ;  and 1,X (high), NOS is 2,X and 3,X. To push: DEX, DEX, then store at 0,X
0000                             ;  and 1,X. To drop: INX, INX. The code may change A and Y, and X as the
0000                             ;  stack pointer; it must keep IP ($00/$01) and leave the hardware stack
0000                             ;  balanced. Zero page $02, $03, $07 and $0A-$0D are free for its own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                             ; The error report (checked) runs after the program, so it may use the zero
0000                             ; page that machine code has ($02, $03, $0A-$0D; but not $0C-$0D and below
0000                             ; while the report prints, since a full stack reaches down to them):
0000                P:        EQU   02h   ; 02-03 the place being reported
0000                Q:        EQU   0Ah   ; 0A-0B a pointer for counting lines
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-000F  the variables above, and scratch
0000                             ;    0010-00EF  the data stack: 112 cells. X = F0 when it is empty. (0E and
0000                             ;               0F are the scratch under the top cell when it is full.)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: KEYBUF at +34, RSV at +35, PLACE at +36,
0000                             ;               PEND at +38. (+7A and +7B are kept free.)
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                DSE:      EQU   0F0h   ; X when the data stack is empty
0000                DSFULL:   EQU   10h   ; X when it is full
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                RSV:      EQU   LET+35h   ; checked: S as it was before this character
0000                PLACE:    EQU   LET+36h   ; checked: the address of this character
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                LBM1:     EQU   LINEBUF-1   ; (for the error report)
0000                PROGM1:   EQU   PROG-1   
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                BASE:     EQU   0E000h   ; where the image starts: a multiple of 512
0000                HALFPG:   EQU   BASE/512   ; (the dispatcher doubles this to get a page)
0000                N1:       EQU   8   ; ! " # $ % & ' (  start in the first page,
0000                N2:       EQU   21   ; ) * + , - . / : ; < = > ?  in the second,
0000                             ; @ [ \ ] ^ _ ` 00bbIHwg ~  in the third
0000                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient; the
0000                             ; remainder is left in the scratch under it, at $FE,X and $FF,X.
0000                             ; Dividing by 2 is one shift (the spec wants that fast).
0000                             ; (A macro, because the two builds need it in different places: the
0000                             ; unchecked build uses it to fill the first page.)
0000                .macro UDIV,
0000                             ; 
0000                udiv:   LDA     #0
0000                 STA     0FEh,X
0000                 STA     0FFh,X
0000                 LDA     D0
0000                 EOR     #2
0000                 ORA     D1
0000                 BNE     ud0
0000                 LSR     1,X
0000                 ROR     0,X             ; the quotient
0000                 ROL     0FEh,X          ; the remainder: the bit that fell out
0000                 RTS
0000                ud0:    LDY     #16
0000                ud1:    ASL     0,X
0000                 ROL     1,X
0000                 ROL     0FEh,X
0000                 ROL     0FFh,X
0000                 SEC
0000                 LDA     0FEh,X
0000                 SBC     D0
0000                 STA     T0
0000                 LDA     0FFh,X
0000                 SBC     D1
0000                 BCC     ud2
0000                 STA     0FFh,X
0000                 LDA     T0
0000                 STA     0FEh,X
0000                 INC     0,X             ; the quotient bit (bit 0 is free)
0000                ud2:    DEY
0000                 BNE     ud1
0000                 RTS
0000                .endm
0000                 
E000                          .ORG   BASE   
E000                             ; =============================================================================
E000                             ;  Page 1 of 3. Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
                                 ; The first half of the letter page is zeroed: every variable, every
                                 ; cell of the interpreter's own (no key held back), and every word
                                 ; cell, which then points at 0000h: calling an undefined word stops
                                 ; with U (see e_undef).
                              INX      
                              TXA      ; A = 0
                              LDY   #7Fh   
                    STZ:      STA   LET,Y   
                              DEY      
                              BPL   stz   
E003                          ENDIF      
E003   20 EE E3               JSR   rstip   
E006   20 DD E3     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B   A5 00                  LDA   IP   
E00D   8D 7C 04               STA   HEAP   
E010                          IF   CHECKED   
                              STA   PEND   
E010                          ENDIF      
E010   A5 01                  LDA   IP+1   
E012   8D 7D 04               STA   HEAP+1   
E015                          IF   CHECKED   
                              STA   PEND+1   
E015                          ENDIF      
E015   20 EE E3               JSR   rstip   
E018   A2 F0                  LDX   #DSE   
E01A                             ; ---- the inner loop (the checked build's is further down, out of this page)
E01A                          IF   1-CHECKED   
E01A   20 0F E3     NEXT:     JSR   step   
E01D   4C 1A E0               JMP   next   
E020                          ENDIF      
E020                          IF   CHECKED   
                              JMP   next   
E020                          ENDIF      
E020                             ; ---- handlers of ! " # $ % & ' ( : they must start in this page -------------
E020                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E020                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E020                             ; bit 6, so // and /" give themselves).
E020                             ; The checked build walks a copy of TOS along the string, so that the address
E020                             ; is still there if it stops with Q on a NUL.
E020                H_PRINT:      
E020                          IF   CHECKED   
                              JSR   h_dup   ; the copy
                              JSR   pr0   
                              BNE   pdrop   ; always (X is never 0): drop the address
                    E_QPR:    INX      
                              INX      ; the copy goes: the address is TOS again
                    E_QUOTE:   LDA   #"Q"   ; $ or a string from 22h ran into the end
                              JMP   error   
                    PR0:         
E020                          ENDIF      
E020   20 9F E2               JSR   tosget   
E023   C9 22                  CMP   #22h   
E025   F0 28                  BEQ   pdrop   
E027                          IF   CHECKED   
                              CMP   #0   
                              BEQ   e_qpr   
E027                          ENDIF      
E027   C9 2F                  CMP   #"/"   
E029   D0 05                  BNE   pr1   
E02B   20 9F E2               JSR   tosget   
E02E   29 BF                  AND   #0BFh   
E030   20 03 FF     PR1:      JSR   CONOUT   
E033                          IF   1-CHECKED   
E033   4C 20 E0               JMP   h_print   
E036                          ENDIF      
E036                          IF   CHECKED   
                              JMP   pr0   
E036                          ENDIF      
E036                             ; 22h pushes the address of the text after it and skips the string.
E036   20 58 E3     H_STR:    JSR   puship   
E039                          IF   CHECKED   
                              JSR   skipstr   
                              BEQ   e_quote   ; it ran into the end: the place is the 22h
                              RTS      
E039                          ENDIF      
E039                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E039                             ; the next character, so "/"" does not end it.
E039                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E039                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E039                             ; text ended first (a NUL, also one just after "/").
E039                          IF   1-CHECKED   
E039   20 DD E3     SKIPSTR:   JSR   getc   
E03C   C9 2F                  CMP   #"/"   
E03E   F0 05                  BEQ   ss0   
E040   C9 22                  CMP   #22h   
E042   D0 F5                  BNE   skipstr   
E044   60                     RTS      
E045   20 E0 E3     SS0:      JSR   incip   
E048   D0 EF                  BNE   skipstr   ; A is "/" here
E04A                          ENDIF      
E04A                          IF   CHECKED   
                    SKIPSTR:   JSR   getc   
                              BEQ   ss9   ; the end
                              CMP   #"/"   
                              BNE   ss1   
                              JSR   getc   ; the escaped character
                              BNE   skipstr   
                    SS9:      RTS      ; the end, just after "/"
                    SS1:      CMP   #22h   
                              BNE   skipstr   
                              LSR      ; A = 11h, Z clear
                              RTS      
E04A                          ENDIF      
E04A   B5 00        H_EMIT:   LDA   0,X   ; "'"
E04C   20 03 FF               JSR   CONOUT   
E04F   E8           PDROP:    INX      ; a drop for this page's handlers
E050   E8                     INX      
E051   60                     RTS      
E052                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E052                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E052                             ; leaves each remainder in the scratch under the top cell.
E052   B5 01        H_NUM:    LDA   1,X   
E054   10 08                  BPL   pn1   
E056   A9 2D                  LDA   #"-"   
E058   20 03 FF               JSR   CONOUT   
E05B   20 2A E1               JSR   neg   
E05E   A9 0A        PN1:      LDA   #10   
E060   85 08                  STA   D0   
E062   A9 00                  LDA   #0   
E064   85 09                  STA   D1   
E066   48                     PHA      ; the end marker
E067   20 EE E0     PN2:      JSR   udiv   
E06A   B5 FE                  LDA   0FEh,X   
E06C   09 30                  ORA   #"0"   
E06E   48                     PHA      
E06F   B5 00                  LDA   0,X   
E071   15 01                  ORA   1,X   
E073   D0 F2                  BNE   pn2   
E075   68           PN3:      PLA      
E076   F0 D7                  BEQ   pdrop   
E078   20 03 FF               JSR   CONOUT   
E07B   4C 75 E0               JMP   pn3   
E07E                             ; "!" ( n addr -- ): the low byte, then "."s ending for the high byte.
E07E   B5 02        H_STORE:   LDA   2,X   
E080                          IF   CHECKED   
                              JSR   chkst   
E080                          ENDIF      
E080   81 00                  STA   (0,X)   
E082   20 A1 E2               JSR   inctos   
E085   B5 03                  LDA   3,X   
E087   4C 41 E1               JMP   st9   
E08A   B5 00        H_SWAP:   LDA   0,X   ; "%"
E08C   B4 02                  LDY   2,X   
E08E   94 00                  STY   0,X   
E090   95 02                  STA   2,X   
E092   B5 01                  LDA   1,X   
E094   B4 03                  LDY   3,X   
E096   94 01                  STY   1,X   
E098   95 03                  STA   3,X   
E09A   60                     RTS      
E09B                             ; "&", and "|" and "^" further down: one byte of the result goes into NOS,
E09B                             ; and X moves up one. Done twice, that is both bytes, and NOS has become TOS.
E09B   20 9E E0     H_AND:    JSR   an1   
E09E   B5 00        AN1:      LDA   0,X   
E0A0   35 02                  AND   2,X   
E0A2   95 02                  STA   2,X   
E0A4   E8                     INX      
E0A5   60                     RTS      
E0A6                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E0A6                             ; the matching ")".
E0A6   20 68 E3     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E0A9                          IF   1-CHECKED   
E0A9   F0 17                  BEQ   skip   
E0AB                          ENDIF      
E0AB                          IF   CHECKED   
                              BEQ   skpar   
E0AB                          ENDIF      
E0AB                             ; pushn: take the step frame off, push the reading position on the return
E0AB                             ; stack, and go on. With the carry set (a word call) the reading position
E0AB                             ; then becomes the address in the letter cell at LET,Y.
E0AB   68           PUSHN:    PLA      
E0AC   68                     PLA      ; drop the step frame
E0AD   A5 01                  LDA   IP+1   
E0AF   48                     PHA      
E0B0   A5 00                  LDA   IP   
E0B2   48                     PHA      
E0B3   90 0A                  BCC   nxt   
E0B5   B9 00 04               LDA   LET,Y   
E0B8   85 00                  STA   IP   
E0BA   B9 01 04               LDA   LET+1,Y   
E0BD   85 01                  STA   IP+1   
E0BF   4C 1A E0     NXT:      JMP   next   
E0C2                             ; ---- no handler starts between here and the next heading: these routines
E0C2                             ; ---- fill the space up to the page boundary and past it ---------------------
E0C2                             ; skip: read past text to the closer at this level, and return it in A.
E0C2                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0C2                             ; NUL first ends the program. (The checked build's skip is further down.)
E0C2                          IF   1-CHECKED   
E0C2   A9 00        SKIP:     LDA   #0   
E0C4   85 06                  STA   T2   ; depth
E0C6   20 DD E3     SK1:      JSR   getc   
E0C9   F0 20                  BEQ   endprog   
E0CB   C9 22                  CMP   #22h   
E0CD   D0 03                  BNE   sk2   
E0CF   20 39 E0               JSR   skipstr   ; leaves A = 22h, which matches nothing below
E0D2   C9 28        SK2:      CMP   #"("   
E0D4   F0 11                  BEQ   sk3   
E0D6   C9 5B                  CMP   #"["   
E0D8   F0 0D                  BEQ   sk3   
E0DA   C9 29                  CMP   #")"   
E0DC   F0 04                  BEQ   sk4   
E0DE   C9 5D                  CMP   #"]"   
E0E0   D0 E4                  BNE   sk1   
E0E2   C6 06        SK4:      DEC   T2   
E0E4   10 E0                  BPL   sk1   
E0E6   60                     RTS      ; the closer at this level
E0E7   E6 06        SK3:      INC   T2   
E0E9   D0 DB                  BNE   sk1   
E0EB   4C 09 FF     ENDPROG:   JMP   EXIT   
E0EE                          ENDIF      
E0EE                          IF   CHECKED   
                                 ; A false ( skips: the wrong closer for it is ].
                    SKPAR:    LDA   #"]"   
                              JMP   skip   
E0EE                          ENDIF      
E0EE                          IF   1-CHECKED   
E0EE                          ;*Macro unroll:  UDIV
E0EE   A9 00        UDIV:     LDA   #0   
E0F0   95 FE                  STA   0FEh,X   
E0F2   95 FF                  STA   0FFh,X   
E0F4   A5 08                  LDA   D0   
E0F6   49 02                  EOR   #2   
E0F8   05 09                  ORA   D1   
E0FA   D0 07                  BNE   ud0   
E0FC   56 01                  LSR   1,X   
E0FE   76 00                  ROR   0,X   
E100   36 FE                  ROL   0FEh,X   
E102   60                     RTS      
E103   A0 10        UD0:      LDY   #16   
E105   16 00        UD1:      ASL   0,X   
E107   36 01                  ROL   1,X   
E109   36 FE                  ROL   0FEh,X   
E10B   36 FF                  ROL   0FFh,X   
E10D   38                     SEC      
E10E   B5 FE                  LDA   0FEh,X   
E110   E5 08                  SBC   D0   
E112   85 04                  STA   T0   
E114   B5 FF                  LDA   0FFh,X   
E116   E5 09                  SBC   D1   
E118   90 08                  BCC   ud2   
E11A   95 FF                  STA   0FFh,X   
E11C   A5 04                  LDA   T0   
E11E   95 FE                  STA   0FEh,X   
E120   F6 00                  INC   0,X   
E122   88           UD2:      DEY      
E123   D0 E0                  BNE   ud1   
E125   60                     RTS      
E126                          ENDIF      
E126                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E126   B5 01        ABSV:     LDA   1,X   
E128   10 0D        NEGM:     BPL   ab9   
E12A                             ; neg: TOS = -TOS
E12A   38           NEG:      SEC      
E12B   A9 00        NEG1:     LDA   #0   
E12D   F5 00                  SBC   0,X   
E12F   95 00                  STA   0,X   
E131   A9 00                  LDA   #0   
E133   F5 01                  SBC   1,X   
E135   95 01                  STA   1,X   
E137   60           AB9:      RTS      
E138                             ; =============================================================================
E138                             ;  Page 2 of 3: handlers of ) * + , - . / : ; < = > ?
E138                             ; =============================================================================
E138   B5 00        H_DUP:    LDA   0,X   ; ":"
E13A   B4 01                  LDY   1,X   
E13C   4C 61 E3               JMP   pushay   
E13F                             ; "." ( c addr -- ), and the end of "!": store A at TOS, drop both cells.
E13F   B5 02        H_CSTORE:   LDA   2,X   
E141                ST9:         
E141                          IF   CHECKED   
                              JSR   chkst   
E141                          ENDIF      
E141   81 00                  STA   (0,X)   
E143   E8                     INX      
E144   E8                     INX      
E145   E8           DROP:     INX      ; ";"
E146   E8                     INX      
E147   60                     RTS      
E148                             ; "-" has two jobs: directly before a digit it starts a negative number.
E148   20 C3 E3     H_SUB:    JSR   isdig   
E14B   90 0F                  BCC   negnum   
E14D   20 2A E1     SUB1:     JSR   neg   ; a - b = a + (-b)
E150   18                     CLC      
E151                             ; "+": one byte at a time, as the logic operators do; the carry goes across.
E151                             ; It ends with A = the high byte of the sum.
E151   20 54 E1     H_ADD:    JSR   ad1   
E154   B5 00        AD1:      LDA   0,X   
E156   75 02                  ADC   2,X   
E158   95 02                  STA   2,X   
E15A   E8                     INX      
E15B   60                     RTS      
E15C   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E15E   20 8F E3               JSR   digit   ; (comes back with the carry set)
E161   B0 C7                  BCS   neg   ; always: the number, negated
E163                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E163                             ; clear for true, and bool turns it into -1 (true) or 0.
E163   20 8A E0     H_GT:     JSR   h_swap   ; a > b is b < a
E166   B5 02        H_LT:     LDA   2,X   
E168   D5 00                  CMP   0,X   
E16A   B5 03                  LDA   3,X   
E16C   F5 01                  SBC   1,X   
E16E   70 02                  BVS   lt1   
E170   49 80                  EOR   #80h   
E172   0A           LT1:      ASL      
E173   E8                     INX      
E174   E8                     INX      ; (keeps the carry; X is never 0)
E175   D0 07                  BNE   bool   ; always
E177   20 4D E1     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E17A   15 00                  ORA   0,X   
E17C   C9 01                  CMP   #1   ; carry clear if A = 0
E17E   A9 00        BOOL:     LDA   #0   
E180   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E182   95 00                  STA   0,X   
E184   95 01                  STA   1,X   
E186   60                     RTS      
E187                             ; "*": the classic shift-right multiply. The multiplier is the NOS cell: it
E187                             ; leaves from the bottom while the product comes in at the top, through
E187                             ; A:T0 above it; after 16 rounds the cell holds the low 16 bits, which are
E187                             ; all that is kept. Dropping TOS (the multiplicand) leaves it on top.
E187   A0 10        H_MUL:    LDY   #16   ; the round count
E189   A9 00                  LDA   #0   
E18B   85 04                  STA   T0   ; A:T0 = the upper half
E18D   56 03                  LSR   3,X   
E18F   76 02                  ROR   2,X   ; the first multiplier bit
E191   90 0D        ML1:      BCC   ml2   
E193   85 05                  STA   T1   
E195   18                     CLC      
E196   A5 04                  LDA   T0   
E198   75 00                  ADC   0,X   
E19A   85 04                  STA   T0   
E19C   A5 05                  LDA   T1   
E19E   75 01                  ADC   1,X   ; upper half += the multiplicand
E1A0   6A           ML2:      ROR      
E1A1   66 04                  ROR   T0   
E1A3   76 03                  ROR   3,X   
E1A5   76 02                  ROR   2,X   ; everything one place right; next bit out
E1A7   88                     DEY      
E1A8   D0 E7                  BNE   ml1   
E1AA   E8                     INX      
E1AB   E8                     INX      
E1AC   60                     RTS      
E1AD                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E1AD                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E1AD                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E1AD                             ; it stops with Z.
E1AD                             ; b's cell is dropped once D holds |b|; udiv then leaves the remainder just
E1AD                             ; where that cell was, so stepping X back down makes it the top cell.
E1AD                          IF   CHECKED   
                    E_ZERO:   LDA   #"Z"   ; divide by zero, the stack as it was
                              JMP   error   
E1AD                          ENDIF      
E1AD                H_DIV:       
E1AD                          IF   CHECKED   
                              LDA   0,X   
                              ORA   1,X   
                              BEQ   e_zero   
E1AD                          ENDIF      
E1AD   B5 03                  LDA   3,X   
E1AF   48                     PHA      ; a's sign: for r
E1B0   55 01                  EOR   1,X   
E1B2   48                     PHA      ; a xor b: for q
E1B3   20 26 E1               JSR   absv   
E1B6   B5 00                  LDA   0,X   
E1B8   85 08                  STA   D0   
E1BA   B5 01                  LDA   1,X   
E1BC   85 09                  STA   D1   ; D = |b|
E1BE   E8                     INX      
E1BF   E8                     INX      
E1C0   20 26 E1               JSR   absv   ; TOS = |a|
E1C3   20 EE E0               JSR   udiv   ; TOS = q
E1C6   68                     PLA      
E1C7   20 28 E1               JSR   negm   ; q's sign
E1CA   CA                     DEX      
E1CB   CA                     DEX      ; r on top
E1CC   68                     PLA      
E1CD   4C 28 E1               JMP   negm   ; r's sign
E1D0   A1 00        H_CFETCH:   LDA   (0,X)   ; ","
E1D2   95 00        SETA:     STA   0,X   ; TOS = A
E1D4   A9 00                  LDA   #0   
E1D6   95 01                  STA   1,X   
E1D8   60                     RTS      
E1D9                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E1D9                             ; drops it and carries on. It uses "]"s code, entered past its SEC: with the
E1D9                             ; carry clear, as it is here, the address popped is pushed back.
E1D9   20 68 E3     H_CLOSE:   JSR   flag   
E1DC   F0 6B                  BEQ   rdrop   
E1DE   D0 70                  BNE   ret1   ; always
E1E0                             ; "?" ( n -- c ) or ( -n -- addr )
E1E0                             ;   n > 0: wait about n ms for a key; 0 if none came
E1E0                             ;   n = 0: wait for a key
E1E0                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E1E0                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E1E0   B5 01        H_KEY:    LDA   1,X   
E1E2   30 1E                  BMI   line   
E1E4   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E1E6   20 06 FF     KT2:      JSR   getk   
E1E9   D0 E7                  BNE   seta   
E1EB   88                     DEY      
E1EC   D0 F8                  BNE   kt2   
E1EE   B5 00                  LDA   0,X   ; count the millisecond off:
E1F0   D0 06                  BNE   kt4   
E1F2   B5 01                  LDA   1,X   
E1F4   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E1F6   D6 01                  DEC   1,X   
E1F8   D6 00        KT4:      DEC   0,X   
E1FA   D0 E8                  BNE   kt1   
E1FC   B5 01                  LDA   1,X   
E1FE   D0 E4                  BNE   kt1   
E200   F0 D0                  BEQ   seta   ; always: the time ran out, A = 0
E202                             ; ---- no handler starts between here and the next heading --------------------
E202                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E202                             ; (stored, not echoed), every other key is stored and echoed until the line
E202                             ; is full. Y = the length so far; T0 = the most allowed.
E202   20 2A E1     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E205   D0 04                  BNE   ln0   
E207   B5 00                  LDA   0,X   
E209   10 02                  BPL   ln1   
E20B   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E20D   85 04        LN1:      STA   T0   
E20F   A0 00                  LDY   #0   
E211   F0 03                  BEQ   ln2   ; always
E213   20 03 FF     LN3:      JSR   CONOUT   
E216   20 06 FF     LN2:      JSR   getk   
E219   F0 FB                  BEQ   ln2   
E21B   C9 0D                  CMP   #13   
E21D   F0 14                  BEQ   ln5   
E21F   C9 08                  CMP   #8   
E221   F0 0A                  BEQ   ln4   
E223   C4 04                  CPY   T0   
E225   B0 EF                  BCS   ln2   ; full
E227   99 80 04               STA   LINEBUF,Y   
E22A   C8                     INY      
E22B   D0 E6                  BNE   ln3   ; always: echo it
E22D   88           LN4:      DEY      ; Backspace: one back, and echo it,
E22E   10 E3                  BPL   ln3   
E230   C8                     INY      ;   unless the line was empty
E231   F0 E3                  BEQ   ln2   ; always
E233   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E236   A9 80                  LDA   #<LINEBUF   
E238   A0 04                  LDY   #>LINEBUF   
E23A   4C 63 E3               JMP   setay   ; TOS = the line's address
E23D                             ; =============================================================================
E23D                             ;  Page 3 of 3: handlers of @ [ \ ] ^ _ ` 00bbIHwg ~
E23D                             ; =============================================================================
E23D                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E23D                             ; drops the block start, "]" returns.
E23D   20 68 E3     H_BREAK:   JSR   flag   
E240   F0 65                  BEQ   tg1   ; (an RTS)
E242                          IF   CHECKED   
                              LDA   #0   ; \ takes either closer
E242                          ENDIF      
E242   20 C2 E0               JSR   skip   
E245   C9 29                  CMP   #")"   
E247   D0 06                  BNE   h_ret   
E249   68           RDROP:    PLA      
E24A   68                     PLA      
E24B   68                     PLA      
E24C   68                     PLA      ; (the block start's high byte: never 0)
E24D   D0 27                  BNE   nxt2   ; always
E24F                             ; "]" returns: pull an address and jump to it. ")" comes in at ret1 with the
E24F                             ; carry clear, and then the address is pushed back.
E24F   38           H_RET:    SEC      
E250                RET1:        
E250                          IF   CHECKED   
                              JSR   chkbrk   ; Ctrl-C is checked at every loop-back and
E250                          ENDIF      ;   every word return (it keeps the carry)
E250   68                     PLA      
E251   68                     PLA      ; drop the step frame
E252   68                     PLA      
E253   85 00                  STA   IP   
E255   68                     PLA      
E256   85 01                  STA   IP+1   
E258   B0 1C                  BCS   nxt2   
E25A   48                     PHA      ; ")": keep the block start
E25B   A5 00                  LDA   IP   
E25D   48                     PHA      
E25E   90 16                  BCC   nxt2   ; always
E260                             ; "{" TOS to the return stack, "}" return stack to TOS
E260   68           H_TOR:    PLA      
E261   68                     PLA      
E262   B5 01                  LDA   1,X   
E264   48                     PHA      
E265   B5 00                  LDA   0,X   
E267   48                     PHA      
E268   E8                     INX      
E269   E8                     INX      
E26A   D0 0A                  BNE   nxt2   ; always: X is never 0
E26C   68           H_FROMR:   PLA      
E26D   68                     PLA      
E26E   CA                     DEX      
E26F   CA                     DEX      
E270   68                     PLA      
E271   95 00                  STA   0,X   
E273   68                     PLA      
E274   95 01                  STA   1,X   
E276   4C 1A E0     NXT2:     JMP   next   
E279                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E279   4C 2B E1     H_NOT:    JMP   neg1   
E27C   20 7F E2     H_XOR:    JSR   xr1   
E27F   B5 00        XR1:      LDA   0,X   
E281   55 02                  EOR   2,X   
E283   95 02                  STA   2,X   
E285   E8                     INX      
E286   60                     RTS      
E287   20 8A E2     H_OR:     JSR   or1   
E28A   B5 00        OR1:      LDA   0,X   
E28C   15 02                  ORA   2,X   
E28E   95 02                  STA   2,X   
E290   E8                     INX      
E291   60                     RTS      
E292   A1 00        H_FETCH:   LDA   (0,X)   ; "@"
E294   A8                     TAY      
E295   20 A1 E2               JSR   inctos   
E298   A1 00                  LDA   (0,X)   
E29A   95 01                  STA   1,X   
E29C   94 00                  STY   0,X   
E29E   60                     RTS      
E29F                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E29F   A1 00        TOSGET:   LDA   (0,X)   
E2A1   F6 00        INCTOS:   INC   0,X   
E2A3   D0 02                  BNE   tg1   
E2A5   F6 01                  INC   1,X   
E2A7   60           TG1:      RTS      
E2A8                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E2A8                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E2A8                             ; the body"s address instead. Either way it then skips to the matching "]'.
E2A8                             ; (The unchecked build takes anything that is not a letter as the space; the
E2A8                             ; checked build stops on it.)
E2A8                          IF   CHECKED   
                    DEF1:     CPY   #" "-"A"+256   
                              BEQ   def2   
                                 ; W: anything but a letter or a space after [. The place is that character,
                                 ; one past the [.
                              INC   PLACE   
                              BNE   eb1   
                              INC   PLACE+1   
                    EB1:      LDA   #"W"   
                              JMP   error   
E2A8                          ENDIF      
E2A8   20 DD E3     H_DEF:    JSR   getc   
E2AB   38                     SEC      
E2AC   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E2AE   A8                     TAY      ;   lands 64 bytes up
E2AF   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E2B1   C9 1A                  CMP   #26   
E2B3                          IF   1-CHECKED   
E2B3   B0 0F                  BCS   def2   ; not a letter
E2B5                          ENDIF      
E2B5                          IF   CHECKED   
                              BCS   def1   
E2B5                          ENDIF      
E2B5   98                     TYA      
E2B6   0A                     ASL      
E2B7   A8                     TAY      ; Y -> the cell
E2B8   A5 00                  LDA   IP   
E2BA   99 00 04               STA   LET,Y   
E2BD   A5 01                  LDA   IP+1   
E2BF   99 01 04               STA   LET+1,Y   
E2C2   D0 03                  BNE   dsk   ; always: no program is in page zero
E2C4   20 58 E3     DEF2:     JSR   puship   ; an anonymous block: push its address
E2C7                DSK:         
E2C7                          IF   CHECKED   
                              LDA   #")"   ; the wrong closer for [
E2C7                          ENDIF      
E2C7   4C C2 E0               JMP   skip   
E2CA                             ; ---- machine code: the grave
E2CA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E2CA                             ; are stored from addr until a non-hex character; then a RET (60h) is
E2CA                             ; written and its address is left. An odd last digit is consumed and dropped.
E2CA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E2CA                             ; contract in the header.
E2CA   20 CC E3     H_GRAVE:   JSR   rdhex   
E2CD   B0 1C                  BCS   exec   
E2CF   0A           HX1:      ASL      
E2D0   0A                     ASL      
E2D1   0A                     ASL      
E2D2   0A                     ASL      
E2D3   85 04                  STA   T0   
E2D5   20 CC E3               JSR   rdhex   
E2D8   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E2DA   05 04                  ORA   T0   
E2DC   81 00                  STA   (0,X)   ; (never checked)
E2DE   20 A1 E2               JSR   inctos   
E2E1   20 CC E3               JSR   rdhex   
E2E4   90 E9                  BCC   hx1   
E2E6   A9 60        HX2:      LDA   #60h   
E2E8   81 00                  STA   (0,X)   
E2EA   60                     RTS      
E2EB   B5 00        EXEC:     LDA   0,X   
E2ED   85 04                  STA   T0   
E2EF   B5 01                  LDA   1,X   
E2F1   85 05                  STA   T1   
E2F3   E8                     INX      ; the address is consumed
E2F4   E8                     INX      
E2F5   6C 04 00               JMP   (T0)   
E2F8                             ; ---- "_" is the last handler: its body may leave the page
E2F8                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E2F8                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E2F8                          IF   1-CHECKED   
E2F8   AD 7C 04     H_ALLOC:   LDA   HEAP   
E2FB   A8                     TAY      
E2FC   75 00                  ADC   0,X   
E2FE   8D 7C 04               STA   HEAP   
E301   94 00                  STY   0,X   
E303   AD 7D 04               LDA   HEAP+1   
E306   A8                     TAY      
E307   75 01                  ADC   1,X   
E309   8D 7D 04               STA   HEAP+1   
E30C   94 01                  STY   1,X   
E30E   60                     RTS      
E30F                          ENDIF      
E30F                             ; The checked build works the new top out first, in T0 and Y, and stops with
E30F                             ; H, the count still on the stack, if it is at or past the limit, below the
E30F                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E30F                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E30F                             ; a signed number from -8000h, so the add overflows exactly when the true
E30F                             ; sum leaves 0000h-FFFFh.
E30F                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   0,X   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   1,X   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   0,X   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   1,X   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the address in the top cell is in the program's own
                                 ; space, from the letter page up to the heap limit. Keeps A and Y.
                    CHKST:    PHA      
                              LDA   1,X   
                              CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              PLA      
                              RTS      
E30F                          ENDIF      
E30F                             ; =============================================================================
E30F                             ;  The rest: no handler starts past this point
E30F                             ; =============================================================================
E30F                          IF   CHECKED   
                              ;*Macro unroll:  UDIV
                    UDIV:     LDA   #0   
                              STA   0FEh,X   
                              STA   0FFh,X   
                              LDA   D0   
                              EOR   #2   
                              ORA   D1   
                              BNE   ud0   
                              LSR   1,X   
                              ROR   0,X   
                              ROL   0FEh,X   
                              RTS      
                    UD0:      LDY   #16   
                    UD1:      ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              STA   T0   
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   ud2   
                              STA   0FFh,X   
                              LDA   T0   
                              STA   0FEh,X   
                              INC   0,X   
                    UD2:      DEY      
                              BNE   ud1   
                              RTS      
E30F                          ENDIF      
E30F                          IF   CHECKED   
                                 ; The checked build's inner loop, out of page 1, where it would not fit.
                    NEXT:        
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE (an
                                 ; underflow) or below DSFULL (an overflow). No handler moves X by
                                 ; more than 4, so X is caught before it wraps; an overrun by a cell
                                 ; or two writes on the scratch bytes below or above the stack.
                                 ; S is kept in RSV, for the report's Rtn line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_sund   
                              CPX   #DSFULL   
                              BCC   e_sovr   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
                              JSR   step   
                              JMP   next   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: Rtn 0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_SUND:   LDX   #DSE   ; Stk 0
                              LDA   #"s"   
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_SOVR:   LDA   #"S"   
                    EJMP:     JMP   error   
                                 ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
                                 ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
                                 ; which takes either. Meeting the wrong closer at this level, or the end
                                 ; (a NUL, or a string that runs into it), stops with N, except for \,
                                 ; which then ends the program as before.
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                              JMP   error   ;   or the end: the place is the opener
E30F                          ENDIF      
E30F                          IF   CHECKED   
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP2:    JMP   error   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; Rtn does not count the call
                              LDA   #"U"   
                              BNE   ejmp2   ; always
E30F                          ENDIF      
E30F                             ; step: read one character and sort it by range.
E30F                             ;    00h          end of program
E30F                             ;    01h-20h, 7Fh-FFh   ignored
E30F                             ;    30h-39h      digit: read a whole number
E30F                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E30F                             ;    61h-7Ah      a-z: push the address of that letter's cell
E30F                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E30F   20 DD E3     STEP:     JSR   getc   ; flags follow A
E312   F0 3B                  BEQ   endp   
E314   38                     SEC      
E315   E9 21                  SBC   #21h   ; A = c - 21h
E317   90 35                  BCC   ign   ; 01h-20h
E319   C9 0F                  CMP   #0Fh   
E31B   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E31D   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E31F   C9 0A                  CMP   #10   
E321   90 6C                  BCC   digit   
E323   C9 11                  CMP   #11h   
E325   90 16                  BCC   p3a   ; 3Ah-40h
E327   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E329   C9 1A                  CMP   #1Ah   
E32B   90 25                  BCC   upper   ; 41h-5Ah
E32D   C9 20                  CMP   #20h   
E32F   90 0A                  BCC   p5b   ; 5Bh-60h
E331   C9 3A                  CMP   #3Ah   
E333   90 29                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E335   C9 3E                  CMP   #3Eh   
E337                          IF   1-CHECKED   
E337   B0 15                  BCS   ign   ; 7Fh-FFh
E339                          ENDIF      
E339                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E339                          ENDIF      
E339                             ; The three adjustments below chain. Each ADC adds the carry the one
E339                             ; before it left, which the constants allow for.
E339   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E33B   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E33D   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E33F                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E33F                             ; the index is N1 or more, plus one more if it is N2 or more.
E33F   C9 08        PUNCT:    CMP   #N1   
E341   A8                     TAY      
E342   A9 70                  LDA   #HALFPG   
E344   2A                     ROL      ; the first page, or the second (carry clear)
E345   C0 15                  CPY   #N2   
E347   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E349   48                     PHA      
E34A   B9 6F E3               LDA   PTAB,Y   
E34D   48                     PHA      
E34E   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E34F                             ; directly, it just ends an ignored character.
E34F                ENDP:        ; the program has ended
E34F                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E34F                          ENDIF      
E34F   4C 09 FF               JMP   EXIT   
E352                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E352                             ; the return stack, and the IP becomes the address in the letter's cell.
E352   0A           UPPER:    ASL      
E353   A8                     TAY      
E354   38                     SEC      
E355   4C AB E0               JMP   pushn   
E358   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E35A   A4 01                  LDY   IP+1   
E35C   D0 03                  BNE   pushay   ; always: no program is in page zero
E35E                             ; a-z: push the cell's address (the cell is the variable)
E35E   0A           LOWER:    ASL      
E35F   A0 04                  LDY   #>LET   
E361                             ; pushay: push a cell: A = its low byte, Y = its high byte
E361   CA           PUSHAY:   DEX      
E362   CA                     DEX      
E363   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E365   94 01                  STY   1,X   
E367   60                     RTS      
E368                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E368   E8           FLAG:     INX      
E369   E8                     INX      
E36A   B5 FE                  LDA   0FEh,X   
E36C   15 FF                  ORA   0FFh,X   
E36E   60                     RTS      
E36F                             ; =============================================================================
E36F                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E36F                             ;  character, in code order.
E36F                             ; =============================================================================
E36F   7D           PTAB:     DB   (h_store-1) & 0FFh   ; !
E370   35                     DB   (h_str-1) & 0FFh   ; "
E371   51                     DB   (h_num-1) & 0FFh   ; #
E372   1F                     DB   (h_print-1) & 0FFh   ; $
E373   89                     DB   (h_swap-1) & 0FFh   ; %
E374   9A                     DB   (h_and-1) & 0FFh   ; &
E375   49                     DB   (h_emit-1) & 0FFh   ; '
E376   A5                     DB   (h_open-1) & 0FFh   ; (
E377   D8                     DB   (h_close-1) & 0FFh   ; )
E378   86                     DB   (h_mul-1) & 0FFh   ; *
E379   50                     DB   (h_add-1) & 0FFh   ; +
E37A   CF                     DB   (h_cfetch-1) & 0FFh   ; ,
E37B   47                     DB   (h_sub-1) & 0FFh   ; -
E37C   3E                     DB   (h_cstore-1) & 0FFh   ; .
E37D   AC                     DB   (h_div-1) & 0FFh   ; /
E37E   37                     DB   (h_dup-1) & 0FFh   ; :
E37F   44                     DB   (drop-1) & 0FFh   ; ;
E380   65                     DB   (h_lt-1) & 0FFh   ; <
E381   76                     DB   (h_eq-1) & 0FFh   ; =
E382   62                     DB   (h_gt-1) & 0FFh   ; >
E383   DF                     DB   (h_key-1) & 0FFh   ; ?
E384   91                     DB   (h_fetch-1) & 0FFh   ; @
E385   A7                     DB   (h_def-1) & 0FFh   ; [
E386   3C                     DB   (h_break-1) & 0FFh   ; \
E387   4E                     DB   (h_ret-1) & 0FFh   ; ]
E388   7B                     DB   (h_xor-1) & 0FFh   ; ^
E389   F7                     DB   (h_alloc-1) & 0FFh   ; _
E38A   C9                     DB   (h_grave-1) & 0FFh   ; `
E38B   5F                     DB   (h_tor-1) & 0FFh   ; {
E38C   86                     DB   (h_or-1) & 0FFh   ; |
E38D   6B                     DB   (h_fromr-1) & 0FFh   ; }
E38E   78                     DB   (h_not-1) & 0FFh   ; ~
E38F                             ; Digits: the first one is in A; read the rest of the number.
E38F   A0 00        DIGIT:    LDY   #0   
E391   20 61 E3               JSR   pushay   
E394                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E394                             ; Returns with the carry set.
E394   20 C3 E3     RDNUM:    JSR   isdig   
E397   B0 4F                  BCS   ic9   ; (an RTS)
E399   20 E0 E3               JSR   incip   ; (keeps A = the digit)
E39C   16 00                  ASL   0,X   
E39E   36 01                  ROL   1,X   ; x2
E3A0   18                     CLC      
E3A1   75 00                  ADC   0,X   
E3A3   85 04                  STA   T0   
E3A5   B5 01                  LDA   1,X   
E3A7   69 00                  ADC   #0   
E3A9   85 05                  STA   T1   ; T = x2 + digit
E3AB   16 00                  ASL   0,X   
E3AD   36 01                  ROL   1,X   
E3AF   16 00                  ASL   0,X   
E3B1   36 01                  ROL   1,X   ; x8
E3B3   18                     CLC      
E3B4   B5 00                  LDA   0,X   
E3B6   65 04                  ADC   T0   
E3B8   95 00                  STA   0,X   
E3BA   B5 01                  LDA   1,X   
E3BC   65 05                  ADC   T1   
E3BE   95 01                  STA   1,X   ; x8 + x2 + digit
E3C0   4C 94 E3               JMP   rdnum   
E3C3                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E3C3                             ; digit. Y = 0.
E3C3   20 E9 E3     ISDIG:    JSR   peek   
E3C6   38                     SEC      
E3C7   E9 30                  SBC   #"0"   
E3C9   C9 0A                  CMP   #10   
E3CB   60                     RTS      
E3CC                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E3CC                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E3CC   20 C3 E3     RDHEX:    JSR   isdig   
E3CF   90 0F                  BCC   incip   
E3D1   29 DF                  AND   #0DFh   
E3D3   E9 11                  SBC   #11h   ; (the carry is set)
E3D5   C9 06                  CMP   #6   
E3D7   B0 0F                  BCS   ic9   
E3D9   69 0A                  ADC   #10   
E3DB   D0 03                  BNE   incip   ; always
E3DD                             ; Reading the program
E3DD                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E3DD                             ;    getc: the same, then IP moves on; flags follow A
E3DD                             ;    incip: IP moves on; keeps A, the carry and Y
E3DD   20 E9 E3     GETC:     JSR   peek   
E3E0   E6 00        INCIP:    INC   IP   
E3E2   D0 02                  BNE   ic1   
E3E4   E6 01                  INC   IP+1   
E3E6   09 00        IC1:      ORA   #0   
E3E8   60           IC9:      RTS      
E3E9   A0 00        PEEK:     LDY   #0   
E3EB   B1 00                  LDA   (IP),Y   
E3ED   60                     RTS      
E3EE                             ; rstip: point IP at the start of the program
E3EE   A9 00        RSTIP:    LDA   #<PROG   
E3F0   85 00                  STA   IP   
E3F2   A9 05                  LDA   #>PROG   
E3F4   85 01                  STA   IP+1   
E3F6   60                     RTS      
E3F7                             ; =============================================================================
E3F7                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E3F7                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E3F7                             ;  Both keep X and Y. In the unchecked build getk is the host's KEY itself.
E3F7                             ; =============================================================================
E3F7                          IF   1-CHECKED   
E3F7                GETK:     EQU   KEY   ; the host's routine does the whole job
E3F7                          ENDIF      
E3F7                          IF   CHECKED   
                    GETK:     LDA   KEYBUF   ; a key held back by the break check
                              BEQ   gk1   
                              PHA      
                              LDA   #0   
                              STA   KEYBUF   
                              PLA      
                              RTS      
                    GK1:      JMP   KEY   
                                 ; =============================================================================
                                 ;  Checked build: break key and error reports
                                 ; =============================================================================
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?". Keeps the flags.
                    CHKBRK:   PHP      
                              JSR   getk   
                              BEQ   cb9   
                              CMP   #3   
                              BEQ   e_break   
                              STA   KEYBUF   
                    CB9:      PLP      
                              RTS      
                    E_BREAK:   LDA   #"B"   ; Ctrl-C
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
                                 ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   Rtn n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was. With the stack full
                                 ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
                    ERROR:    PHA      ; the letter
                              LDA   PLACE   
                              STA   P   
                              LDA   PLACE+1   
                              STA   P+1   
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   D0   
                              LDY   D1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   T1   
                              LDY   T2   
                              JSR   prnum   ; the column
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              LDY   #0   ; the text at the place
                    ER1:      LDA   (P),Y   
                              BEQ   er2   
                              CMP   #13   
                              BEQ   er2   
                              CMP   #10   
                              BEQ   er2   
                              JSR   CONOUT   
                              INY      
                              CPY   #16   
                              BNE   er1   
                    ER2:      LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "Stk "
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   
                              LSR      ; the depth, (DSE - X) / 2
                              PHA      
                              LDY   #0   
                              JSR   prnum   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T1   ; T1 = how many cells to show
                              JSR   prs   
                    ER4:      LDA   T1   ; cells T1-1 down to 0, the top last: cell i
                              BEQ   er5   ;   from the top is at X+2i
                              DEC   T1   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   T1   
                              ASL      
                              STA   T2   
                              TXA      
                              ADC   T2   ; (the carry is clear)
                              TAY      
                              LDA   0,Y   
                              PHA      
                              LDA   1,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "Rtn "
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              LDY   #0   
                              JSR   prnum   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"Stk"," "+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"Rtn"," "+80h   
                                 ; lcol: the line (D0/D1) and the column (T1/T2) of the place at P, both from
                                 ; 1. A place below the program is in the -n? line buffer: line 0, and the
                                 ; column is the place in the buffer. Otherwise the LFs before the place are
                                 ; counted from PROG; T1/T2 holds the address before the line's first
                                 ; character (the last LF, or PROG - 1), and the column is P minus that.
                    LCOL:     LDY   #0   
                              STY   D1   
                              STY   D0   
                              LDA   #<LBM1   
                              STA   T1   
                              LDA   #>LBM1   
                              STA   T2   
                              LDA   P   
                              CMP   #<PROG   
                              LDA   P+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   D0   
                              LDA   #<PROGM1   
                              STA   Q   
                              STA   T1   
                              LDA   #>PROGM1   
                              STA   Q+1   
                              STA   T2   
                    LC1:      INC   Q   ; the next character
                              BNE   lc2   
                              INC   Q+1   
                    LC2:      LDA   Q   
                              CMP   P   
                              LDA   Q+1   
                              SBC   P+1   
                              BCS   lc9   ; at the place
                              LDA   (Q),Y   
                              CMP   #10   
                              BNE   lc1   
                              INC   D0   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   D1   
                    LC3:      LDA   Q   
                              STA   T1   
                              LDA   Q+1   
                              STA   T2   
                              BNE   lc1   ; always: no program is in page zero
                    LC9:      LDA   P   
                              SEC      
                              SBC   T1   
                              STA   T1   
                              LDA   P+1   
                              SBC   T2   
                              STA   T2   
                              RTS      
E3F7                          ENDIF      


