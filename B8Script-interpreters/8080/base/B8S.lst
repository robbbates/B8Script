03F8                          ENDIF      
03F8                          IF   1-CHECKED   
                                 ; "$" prints the string at TOS (see h_print).
                    PRLP:     MOV   A,M   
                              INX   H   
                              CPI   22h   
                              JZ   h_drop   
                              CPI   "/"   
                              JNZ   pr1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   pr0   
                              CPI   7Fh   
                              JC   pesc   
                    PR0:      ANI   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prlp   
03F8                          ENDIF      
03F8                             ;-----------------------------------------------------------------------------
03F8                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
03F8                             ; HL points past it. Each goes back into the loop that prints the string
03F8                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
03F8                             ;    /a-/z   print the variable, as "#" does
03F8                             ;    /{      clear the screen, the cursor to the top left
03F8                             ;    /}      clear from the cursor to the end of the line
03F8                             ;    /|  /`  show the cursor, hide it
03F8                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
03F8   FE 7E        PESC:     CPI   7Eh   
03FA   CA 1D 04               JZ   pat   
03FD   11 42 06               LXI   D,PRLOOP   ; the others return into the loop
0400   D5                     PUSH   D   
0401   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0403   D2 5E 04               JNC   pcon   
0406   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0408   D2 48 04               JNC   phide   
040B   87                     ADD   A   ; the variable's cell
040C   C6 40                  ADI   40h   
040E   E5                     PUSH   H   
040F   C5                     PUSH   B   
0410   6F                     MOV   L,A   
0411   26 0B                  MVI   H,LETPAGE   
0413   7E                     MOV   A,M   
0414   2C                     INR   L   
0415   66                     MOV   H,M   
0416   6F                     MOV   L,A   
0417   CD D7 03               CALL   psgn   
041A   C1                     POP   B   
041B   E1                     POP   H   
041C   C9                     RET      
041D                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
041D                             ; the checked build "$" is the routine prstr: its own return address goes
041D                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
041D                             ; its two cells are there, and is s if not, before it prints anything.
041D                PAT:         
041D                          IF   CHECKED   
041D   E3                     XTHL      ; the text pointer over prstr's return address
041E   21 0A F5               LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
0421   39                     DAD   SP   
0422   DA A3 06               JC   e_under   
0425   E1                     POP   H   
0426                          ENDIF      
0426   D1                     POP   D   ; DE = the column
0427   E3                     XTHL      ; HL = the row; the text pointer is kept
0428                          IF   1-ANS   
                              CALL   CONAT   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JZ   CONCLS   ; /{
                              CPI   2   
                              JZ   CONEOL   ; /}
                              DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
                    PHIDE:    XRA   A   ; /`  (A = 0: hide)
                              JMP   CONCUR   
0428                          ENDIF      
0428                          IF   ANS   
0428   C5                     PUSH   B   ; (pdec uses BC)
0429   D5                     PUSH   D   
042A   CD 77 04               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
042D   23                     INX   H   
042E   CD E4 03               CALL   pdec   
0431   3E 3B                  MVI   A,";"   
0433                          ;*Macro unroll:  PUTA
0433                          DS   1-CPM,0EFh   
0433   CD                     DS   CPM,0CDh   
0434   FD                     DS   CPM,APUT&0FFh   
0435   05                     DS   CPM,APUT/256   
0436   E1                     POP   H   
0437   23                     INX   H   
0438   CD E4 03               CALL   pdec   
043B   3E 48                  MVI   A,"H"   
043D                          ;*Macro unroll:  PUTA
043D                          DS   1-CPM,0EFh   
043D   CD                     DS   CPM,0CDh   
043E   FD                     DS   CPM,APUT&0FFh   
043F   05                     DS   CPM,APUT/256   
0440   C1                     POP   B   
0441   E1                     POP   H   
0442   C3 C1 02               JMP   PRAGAIN   
0445                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0445   1E 68        PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
0447   DA                     DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
0448   1E 6C        PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
044A   3E 3F                  MVI   A,"?"   
044C   CD 6E 04               CALL   csia   
044F   3E 32                  MVI   A,"2"   
0451                          ;*Macro unroll:  PUTA
0451                          DS   1-CPM,0EFh   
0451   CD                     DS   CPM,0CDh   
0452   FD                     DS   CPM,APUT&0FFh   
0453   05                     DS   CPM,APUT/256   
0454   3E 35                  MVI   A,"5"   
0456                          ;*Macro unroll:  PUTA
0456                          DS   1-CPM,0EFh   
0456   CD                     DS   CPM,0CDh   
0457   FD                     DS   CPM,APUT&0FFh   
0458   05                     DS   CPM,APUT/256   
0459   7B                     MOV   A,E   
045A                          ;*Macro unroll:  PUTA
045A                          DS   1-CPM,0EFh   
045A   CD                     DS   CPM,0CDh   
045B   FD                     DS   CPM,APUT&0FFh   
045C   05                     DS   CPM,APUT/256   
045D   C9                     RET      
045E                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
045E   3D           PCON:     DCR   A   
045F   CA 45 04               JZ   pshow   ; /|
0462   3E 4B                  MVI   A,"K"   
0464   F2 6E 04               JP   csia   ; /}  ESC [ K
0467   3E 48                  MVI   A,"H"   ; /{  ESC [ H ESC [ J
0469   CD 6E 04               CALL   csia   
046C   3E 4A                  MVI   A,"J"   ; (on into csia)
046E                             ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
046E   F5           CSIA:     PUSH   PSW   
046F   CD 77 04               CALL   csi   
0472   F1                     POP   PSW   
0473                          ;*Macro unroll:  PUTA
0473                          DS   1-CPM,0EFh   
0473   CD                     DS   CPM,0CDh   
0474   FD                     DS   CPM,APUT&0FFh   
0475   05                     DS   CPM,APUT/256   
0476   C9                     RET      
0477   3E 1B        CSI:      MVI   A,27   
0479                          ;*Macro unroll:  PUTA
0479                          DS   1-CPM,0EFh   
0479   CD                     DS   CPM,0CDh   
047A   FD                     DS   CPM,APUT&0FFh   
047B   05                     DS   CPM,APUT/256   
047C   3E 5B                  MVI   A,"["   
047E                          ;*Macro unroll:  PUTA
047E                          DS   1-CPM,0EFh   
047E   CD                     DS   CPM,0CDh   
047F   FD                     DS   CPM,APUT&0FFh   
0480   05                     DS   CPM,APUT/256   
0481   C9                     RET      
0482                          ENDIF      
0482                             ; skip: read past text to the closer at this level, and return A = 0 if it
0482                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0482                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0482                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0482                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0482                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
0482                             ; 
0482                             ; The checked build also looks at the character the skip was started by,
0482                             ; which is always the one just before where it starts: "(" must end at ")",
0482                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0482                             ; quote counts as running into it. "\" takes either closer. The place where
0482                             ; the skip started is kept on the stack, for the report.
0482                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
0482                          ENDIF      
0482                          IF   CHECKED*(1-QK)   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
0482                          ENDIF      
0482                          IF   1-QK   
                              MVI   D,0   
                    SK3:      INR   D   ; an opener: one deeper
                    SK1:      LDAX   B   
0482                          ENDIF      
0482                          IF   (1-CHECKED)*(1-QK)   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
0482                          ENDIF      
0482                          IF   CHECKED*(1-QK)   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
0482                          ENDIF      
0482                          IF   1-QK   
                              CPI   22h   
                              CZ   skipstr   ; leaves A = 22h, which matches nothing below
                              SUI   "("   ;   (or 0, and then the NUL is read next)
                              JZ   sk3   
                              DCR   A   ; ")"
                              JZ   sk4   
                              SUI   "["-")"   
                              JZ   sk3   
                              CPI   "]"-"["   
                              JNZ   sk1   
                    SK4:      DCR   D   
0482                          ENDIF      
0482                          IF   (1-CHECKED)*(1-QK)   
                              RZ      ; the closer at this level
                              JMP   sk1   
0482                          ENDIF      
0482                          IF   CHECKED*(1-QK)   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
0482                          ENDIF      
0482                          IF   QK   
0482                             ; The skip cache. Nearly every skip is one that has happened before (a loop
0482                             ; skips the same false block on every pass), so the first scan from each
0482                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
0482                             ; by the start's low byte (times 4). Only skips that start in the program
0482                             ; text are kept (the line buffer changes); the cache is emptied whenever a
0482                             ; run starts (see start). A program that changes its own text while it
0482                             ; runs is not looked after.
0482   78           SKIP:     MOV   A,B   
0483   FE 0C                  CPI   PROG/256   
0485   DA A5 04               JC   sks   ; below the program text: no cache
0488   79                     MOV   A,C   
0489   87                     ADD   A   
048A   87                     ADD   A   
048B   5F                     MOV   E,A   
048C   16 08                  MVI   D,CPAGE   ; DE -> the entry
048E   1A                     LDAX   D   
048F   B9                     CMP   C   
0490   C2 A5 04               JNZ   sks   
0493   1C                     INR   E   
0494   1A                     LDAX   D   
0495   B8                     CMP   B   
0496   C2 A5 04               JNZ   sks   
0499   1C                     INR   E   
049A   1A                     LDAX   D   
049B   4F                     MOV   C,A   
049C   1C                     INR   E   
049D   1A                     LDAX   D   
049E   47                     MOV   B,A   ; a hit: the IP is past the closer
049F   0B                     DCX   B   
04A0   0A                     LDAX   B   
04A1   03                     INX   B   
04A2   D6 29                  SUI   ")"   ; 0 for ")", not 0 for "]"
04A4   C9                     RET      
04A5   C5           SKS:      PUSH   B   ; where it starts: the cache's key (and the
04A6                          ENDIF      ;   checked report's place)
04A6                          IF   QK*CHECKED   
04A6   0B                     DCX   B   
04A7   0A                     LDAX   B   
04A8   03                     INX   B   
04A9   5F                     MOV   E,A   ; E = the opener: ( [ or \
04AA                          ENDIF      
04AA                          IF   QK   
04AA                             ; The scan. Most characters are nothing to it, and two range tests rule
04AA                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
04AA   16 00                  MVI   D,0   
04AC   14           SQ3:      INR   D   ; an opener: one deeper
04AD   0A           SQ1:      LDAX   B   
04AE   03                     INX   B   
04AF   FE 5E                  CPI   5Eh   
04B1   D2 AD 04               JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
04B4   FE 5B                  CPI   5Bh   
04B6   D2 E2 04               JNC   sqb   ; [ \ ]
04B9   FE 2A                  CPI   2Ah   
04BB   D2 AD 04               JNC   sq1   ; * to Z: nothing
04BE   FE 28                  CPI   28h   
04C0   CA AC 04               JZ   sq3   ; (
04C3   D2 ED 04               JNC   sqc   ; )
04C6   FE 22                  CPI   22h   
04C8   CA DC 04               JZ   sqq   ; a string
04CB   B7                     ORA   A   
04CC   C2 AD 04               JNZ   sq1   ; the rest below "(": nothing
04CF                          ENDIF      
04CF                          IF   QK*(1-CHECKED)   
                              JMP   endprog   ; NUL: the end of the program
04CF                          ENDIF      
04CF                          IF   QK*CHECKED   
04CF   0B                     DCX   B   ; NUL: the IP stays on it
04D0   7B                     MOV   A,E   ; the text ran out:
04D1   E6 04                  ANI   4   
04D3   C2 85 01               JNZ   endprog   ;   "\" with no closer ends the program
04D6   C1                     POP   B   
04D7   3E 4E        SQ7:      MVI   A,"N"   ; N. The place is the opener
04D9   C3 D4 06               JMP   errp   ; (errp drops skip's return address)
04DC                          ENDIF      
04DC                          IF   QK   
04DC   CD 1D 05     SQQ:      CALL   skipstr   ; step over the string
04DF   C3 AD 04               JMP   sq1   
04E2   D6 5C        SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
04E4   CA AD 04               JZ   sq1   ; "\" is nothing here
04E7   DA AC 04               JC   sq3   ; [
04EA   3E 02                  MVI   A,2   ; ]
04EC   FE                     DB   0FEh   ; (CPI: steps over the XRA)
04ED   AF           SQC:      XRA   A   ; )
04EE   15           SQ4:      DCR   D   
04EF   C2 AD 04               JNZ   sq1   
04F2                          ENDIF      
04F2                          IF   QK*CHECKED   
04F2   57                     MOV   D,A   ; the closer at this level (as above): 2 here
04F3   AB                     XRA   E   ;   means the wrong closer
04F4   E6 06                  ANI   6   
04F6   FE 02                  CPI   2   
04F8   7A                     MOV   A,D   
04F9   D1                     POP   D   ; (where the skip started)
04FA   C2 02 05               JNZ   sq8   
04FD   42                     MOV   B,D   
04FE   4B                     MOV   C,E   
04FF   C3 D7 04               JMP   sq7   
0502                SQ8:         
0502                          ENDIF      
0502                          IF   QK*(1-CHECKED)   
                              POP   D   ; where the skip started
0502                          ENDIF      
0502                          IF   QK   
0502                             ; The closer at this level: remember the skip (if it started in the program
0502                             ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
0502   E5                     PUSH   H   
0503   67                     MOV   H,A   
0504   7A                     MOV   A,D   
0505   FE 0C                  CPI   PROG/256   
0507   DA 1A 05               JC   sq9   
050A   7B                     MOV   A,E   
050B   87                     ADD   A   
050C   87                     ADD   A   
050D   6F                     MOV   L,A   
050E   7C                     MOV   A,H   
050F   26 08                  MVI   H,CPAGE   
0511   73                     MOV   M,E   
0512   2C                     INR   L   
0513   72                     MOV   M,D   
0514   2C                     INR   L   
0515   71                     MOV   M,C   
0516   2C                     INR   L   
0517   70                     MOV   M,B   
0518   E1                     POP   H   
0519   C9                     RET      
051A   7C           SQ9:      MOV   A,H   
051B   E1                     POP   H   
051C   C9                     RET      
051D                          ENDIF      
051D                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
051D                             ; the next character, so "/"" does not end it. Leaves A = 22h.
051D                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
051D                          ENDIF      
051D                          IF   CHECKED   
051D                             ; The checked build never steps over a NUL: if the text runs out first it
051D                             ; returns A = 0 with the IP on the NUL.
051D   0A           SKIPSTR:   LDAX   B   
051E   B7                     ORA   A   
051F   C8                     RZ      
0520   03                     INX   B   
0521   FE 22                  CPI   22h   
0523   C8                     RZ      
0524   FE 2F                  CPI   "/"   
0526   C2 1D 05               JNZ   skipstr   
0529   0A                     LDAX   B   ; the escaped character
052A   B7                     ORA   A   
052B   C8                     RZ      
052C   03                     INX   B   
052D   C3 1D 05               JMP   skipstr   
0530                          ENDIF      
0530                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0530                             ; and return its value in A with the carry set; otherwise leave the IP and
0530                             ; return with the carry clear.
0530   0A           HEXC:     LDAX   B   
0531   D6 30                  SUI   "0"   
0533   FE 0A                  CPI   10   
0535   DA 41 05               JC   hc1   
0538   E6 DF                  ANI   0DFh   
053A   D6 11                  SUI   11h   
053C   FE 06                  CPI   6   
053E   D0                     RNC      
053F   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
0541   03           HC1:      INX   B   
0542   C9                     RET      
0543                             ;  ---- Speed-ups (base builds) -------------------------------------------
0543                             ;  The skip cache and "/" by a power of two are above. These are the
0543                             ;  handlers' tails that the builds with room take, kept here, out of the
0543                             ;  handlers' first two pages.
0543                          IF   QK   
0543                             ; "*" with an operand below 256: that one becomes the multiplier, a byte in
0543                             ; A, and the loop stops as soon as its bits are used up (most
0543                             ; multiplications have one, a count or a small constant). With both at 256
0543                             ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
0543                             ; shifted in above it says when), and its high byte goes on as a small one.
0543                             ; DE = NOS, HL = TOS.
0543   7C           MULQ:     MOV   A,H   
0544   B7                     ORA   A   
0545   CA 4E 05               JZ   mq8   ; the multiplier is below 256
0548   7A                     MOV   A,D   
0549   B7                     ORA   A   
054A   C2 65 05               JNZ   mq16   
054D   EB                     XCHG      ; the multiplicand is: it becomes the multiplier
054E   7D           MQ8:      MOV   A,L   
054F   21 00 00               LXI   H,0   
0552   B7                     ORA   A   ; (clears the carry)
0553   CA 62 05               JZ   mq9   
0556   1F           MQ1:      RAR      ; the next bit
0557   D2 5B 05               JNC   mq2   
055A   19                     DAD   D   
055B   EB           MQ2:      XCHG      
055C   29                     DAD   H   ; multiplicand << 1
055D   EB                     XCHG      
055E   B7                     ORA   A   ; bits left? (and clears the carry)
055F   C2 56 05               JNZ   mq1   
0562                          ;*Macro unroll: mq9:    NEXTQ
0562                MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
0562   C3                     DS   CPM*(1-FAST),0C3h   
0563   36                     DS   CPM*(1-FAST),ANXT&0FFh   
0564   01                     DS   CPM*(1-FAST),ANXT/256   
0565                          DS   FAST*CHECKED,0CDh   
0565                          DS   FAST*CHECKED,ACHK&0FFh   
0565                          DS   FAST*CHECKED,ACHK/256   
0565                          DS   FAST,0Ah   
0565                          DS   FAST,03h   
0565                          DS   FAST,0EBh   
0565                          DS   FAST,6Fh   
0565                          DS   FAST,26h   
0565                          DS   FAST,DTPG   
0565                          DS   FAST,7Eh   
0565                          DS   FAST,24h   
0565                          DS   FAST,66h   
0565                          DS   FAST,6Fh   
0565                          DS   FAST,0E9h   
0565   C5           MQ16:     PUSH   B   
0566   44                     MOV   B,H   ; the high byte, for later
0567   7D                     MOV   A,L   
0568   21 00 00               LXI   H,0   
056B   37                     STC      ; the marker
056C   1F                     RAR      
056D   D2 71 05     MQ3:      JNC   mq4   
0570   19                     DAD   D   
0571   EB           MQ4:      XCHG      
0572   29                     DAD   H   
0573   EB                     XCHG      
0574   FE 01                  CPI   1   ; only the marker left: 8 rounds done (and
0576   1F                     RAR      ;   the carry was clear for the shift)
0577   C2 6D 05               JNZ   mq3   
057A   78                     MOV   A,B   
057B   C1                     POP   B   
057C   B7                     ORA   A   
057D   C3 56 05               JMP   mq1   ; the high byte, as a small multiplier
0580                             ; A true ")" reads the block start where it is, on top of the return stack,
0580                             ; instead of popping it and pushing it back; the break key is looked at as
0580                             ; rpushd would.
0580   2A 34 0B     CLOSEQ:   LHLD   RSP   
0583   4E                     MOV   C,M   
0584   23                     INX   H   
0585   46                     MOV   B,M   
0586   21 36 0B               LXI   H,BRKCNT   
0589   35                     DCR   M   
058A   E1                     POP   H   ; (keeps the flags)
058B   CC 91 05               CZ   pollk   
058E                          ;*Macro unroll:  NEXTQ
058E                          DS   (1-CPM)*(1-FAST),0F7h   
058E   C3                     DS   CPM*(1-FAST),0C3h   
058F   36                     DS   CPM*(1-FAST),ANXT&0FFh   
0590   01                     DS   CPM*(1-FAST),ANXT/256   
0591                          DS   FAST*CHECKED,0CDh   
0591                          DS   FAST*CHECKED,ACHK&0FFh   
0591                          DS   FAST*CHECKED,ACHK/256   
0591                          DS   FAST,0Ah   
0591                          DS   FAST,03h   
0591                          DS   FAST,0EBh   
0591                          DS   FAST,6Fh   
0591                          DS   FAST,26h   
0591                          DS   FAST,DTPG   
0591                          DS   FAST,7Eh   
0591                          DS   FAST,24h   
0591                          DS   FAST,66h   
0591                          DS   FAST,6Fh   
0591                          DS   FAST,0E9h   
0591                          ENDIF      
0591                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWER:    EQU   lowq   
                    LOWQ:     ADD   A   
                              MOV   E,A   
                              MVI   D,LETPAGE   ; DE -> the cell
                              LDAX   B   
                              CPI   "@"   
                              JZ   lwf   
                              CPI   "!"   
                              JZ   lws   
                              PUSH   H   
                              XCHG      ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWF:      INX   B   ; x@: TOS = the cell's value
                              PUSH   H   
                              XCHG      
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              XCHG      
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
                              XCHG      
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0591                          ENDIF      
0591                             ; =============================================================================
0591                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0591                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0591                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
0591                             ;  the host's KEY and CONOUT routines themselves.
0591                             ; 
0591                             ;  A running program reads the keyboard only through getk and pollk, which
0591                             ;  between them give the break key its rules:
0591                             ;    - Ctrl-C stops the program;
0591                             ;    - any other key that the break check reads is held in KEYBUF for the
0591                             ;      next "?", and a newer one takes its place;
0591                             ;    - "?" (getk) takes the held key first;
0591                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0591                             ;      key like any other, but two of them within about 250 ms still stop it.
0591                             ;  Both are called straight from a handler, never from a routine under one:
0591                             ;  the checked build's report counts on finding one return address above the
0591                             ;  data stack, and TOS in HL.
0591                             ; =============================================================================
0591                          IFN   CPM   
                    RAWK:     EQU   KEY   
0591                          ENDIF      
0591                             ; pollk: the break check (see rpushd).
0591   CD FB 05     POLLK:    CALL   rawk   
0594   C8                     RZ      ; no key
0595   32 7A 0B               STA   KEYBUF   ; held for the next "?"
0598   FE 03        PK1:      CPI   3   ; (getk joins here)
059A   C0                     RNZ      
059B                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
059B                             ; the program has turned it off, wait about 250 ms for one more key: a
059B                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
059B                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
059B   3A 7B 0B     CTLC:     LDA   BRKOFF   
059E   B7                     ORA   A   
059F   CA 3D 06               JZ   brk   
05A2   D5                     PUSH   D   
05A3   11 E8 03               LXI   D,250*MSLOOP   
05A6   CD FB 05     CT1:      CALL   rawk   
05A9   C2 B2 05               JNZ   ct2   
05AC   1B                     DCX   D   
05AD   7A                     MOV   A,D   
05AE   B3                     ORA   E   
05AF   C2 A6 05               JNZ   ct1   
05B2   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
05B3   FE 03                  CPI   3   
05B5   CA 3D 06               JZ   brk   
05B8   B7                     ORA   A   
05B9   CA BF 05               JZ   ct3   
05BC   32 7A 0B               STA   KEYBUF   
05BF   3E 03        CT3:      MVI   A,3   
05C1   B7                     ORA   A   
05C2   C9                     RET      
05C3                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
05C3   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
05C4   21 7A 0B               LXI   H,KEYBUF   ;   the buffer
05C7   7E                     MOV   A,M   
05C8   36 00                  MVI   M,0   
05CA   E1                     POP   H   
05CB   B7                     ORA   A   
05CC   C0                     RNZ      
05CD   CD FB 05               CALL   rawk   
05D0   C8                     RZ      
05D1   C3 98 05               JMP   pk1   ; Ctrl-C? If not, that is the key
05D4                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
05D4                          ENDIF      
05D4                          IF   CHECKED   
05D4                BRK:      EQU   e_break   ;   the checked build reports B
05D4                          ENDIF      
05D4                          IF   CPM   
05D4                             ; (In a CP/M build the letters and digits are here, out of the way of the
05D4                             ; handlers, which must fit in the image's first two pages. The same code as
05D4                             ; in the generic build.)
05D4                             ; ---- the letters and digits --------------------------------------------------
05D4                             ; a-z: push the cell's address (the cell is the variable)
05D4                          ENDIF      
05D4                          IF   CPM*(1-SBASEU)   
05D4   E5           LOWER:    PUSH   H   
05D5   87                     ADD   A   
05D6   6F                     MOV   L,A   
05D7   26 0B                  MVI   H,LETPAGE   
05D9                          ;*Macro unroll:  NEXT
05D9                          DS   (1-CPM)*(1-FAST),0F7h   
05D9   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
05DA   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
05DB   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
05DC                          ENDIF      
05DC                          IF   CPM   
05DC                             ; A-Z: call the word. The return address (the IP after the letter) goes on
05DC                             ; the return stack, and the IP becomes the address in the letter's cell.
05DC   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
05DD   87                     ADD   A   
05DE   6F                     MOV   L,A   
05DF   26 0B                  MVI   H,LETPAGE   ; HL -> cell
05E1   50                     MOV   D,B   
05E2   59                     MOV   E,C   ; DE = the return address
05E3   4E                     MOV   C,M   
05E4   23                     INX   H   
05E5   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
05E6                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
05E6                             ; go on. Every push of the return stack ends here: for a word call the cell
05E6                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
05E6                             ; the one that was used up.
05E6                             ; 
05E6                             ; The break key is looked at here, so at every word call and loop-back (and
05E6                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
05E6                             ; the keyboard can be slow (it is a BDOS call under CP/M).
05E6   2A 34 0B     RPUSHD:   LHLD   RSP   
05E9   2B                     DCX   H   
05EA   72                     MOV   M,D   
05EB   2B                     DCX   H   
05EC   73                     MOV   M,E   
05ED   22 34 0B               SHLD   RSP   
05F0   21 36 0B               LXI   H,BRKCNT   
05F3   35                     DCR   M   
05F4   E1                     POP   H   ; (keeps the flags)
05F5   CC 91 05               CZ   pollk   
05F8                          ;*Macro unroll:  NEXT
05F8                          DS   (1-CPM)*(1-FAST),0F7h   
05F8   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
05F9   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
05FA   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
05FB   3E FF        RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
05FD                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
05FD                             ; printing and could swallow a key that BDOS 6 then never sees.
05FD   C5           PUTC:     PUSH   B   
05FE   D5                     PUSH   D   
05FF   E5                     PUSH   H   
0600   5F                     MOV   E,A   
0601   0E 06                  MVI   C,6   
0603   CD 05 00               CALL   BDOS   
0606   E1                     POP   H   
0607   D1                     POP   D   
0608   C1                     POP   B   
0609   B7                     ORA   A   ; (for getk)
060A   C9                     RET      
060B                          ENDIF      
060B                             ; =============================================================================
060B                             ;  Checked build: the checks and the error report
060B                             ; =============================================================================
060B                          IF   CHECKED   
060B                             ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
060B                             ; it, and the old top is on the stack under the return address. Stop if the
060B                             ; new top is not below the limit page, or is below the program's end.
060B                CHKHP:       
060B                          ENDIF      
060B                          IF   CHECKED*CPM   
060B                             ; With this much room a top that wrapped round can land back in
060B                             ; range, so the add is tested too: growing must not carry, and
060B                             ; releasing must.
060B   7A                     MOV   A,D   
060C   1F                     RAR      ; the carry comes in above the count's sign:
060D   C6 40                  ADI   40h   ;   bit 7 = carry XOR sign
060F   87                     ADD   A   
0610   DA 24 06               JC   e_heap   
0613   3A 07 00               LDA   0007h   
0616   3D                     DCR   A   
0617   BC                     CMP   H   
0618   DA 24 06               JC   e_heap   
061B                          ENDIF      
061B                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
061B                          ENDIF      
061B                          IF   CHECKED   
061B   EB                     XCHG      
061C   E5                     PUSH   H   ; the count
061D   2A 38 0B               LHLD   NPEND   
0620   19                     DAD   D   ; carry: at or above the program's end
0621   E1                     POP   H   
0622   EB                     XCHG      
0623   D8                     RC      
0624   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
0625   D1                     POP   D   ;   and drop the return address (errp drops
0626   3E 48                  MVI   A,"H"   ;   the old top)
0628   C3 D4 06               JMP   errp   
062B                             ; chkst: stop unless HL is in the program's own space: from the letter page
062B                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
062B                             ; whatever lies above the limit are safe. Memory above the heap top but
062B                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
062B                             ; It is the page of HL + 1 that is tested, so that one test serves both
062B                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
062B                             ; Keeps HL and BC. It runs on into its own error entry.
062B   23           CHKST:    INX   H   
062C   7C                     MOV   A,H   
062D   2B                     DCX   H   
062E   FE 0B                  CPI   LETPAGE   
0630   DA 3A 06               JC   e_store   
0633                          ENDIF      
0633                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
0633                          ENDIF      
0633                          IF   CHECKED*CPM   
0633   5F                     MOV   E,A   
0634   3A 07 00               LDA   0007h   ; the BDOS page is the heap limit
0637   3D                     DCR   A   
0638   BB                     CMP   E   
0639   D0                     RNC      
063A                          ENDIF      
063A                          IF   CHECKED   
063A                             ; Two error entries for errors found inside a routine: the first hides the
063A                             ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
063A                             ; return address.
063A   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
063C   11                     DB   11h   
063D   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
063F   C3 D4 06               JMP   errp   
0642                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0642                             ; "$", and the error report's texts). A NUL first is an error: Q.
0642   7E           PRSTR:    MOV   A,M   
0643   23                     INX   H   
0644   FE 22                  CPI   22h   
0646   C8                     RZ      
0647   B7                     ORA   A   
0648   CA BC 06               JZ   e_dollar   
064B   FE 2F                  CPI   "/"   
064D   C2 5E 06               JNZ   prs1   
0650   7E                     MOV   A,M   
0651   23                     INX   H   
0652   FE 60                  CPI   60h   
0654   DA 5C 06               JC   prs0   
0657   FE 7F                  CPI   7Fh   
0659   DA F8 03               JC   pesc   
065C   E6 BF        PRS0:     ANI   0BFh   
065E                          ;*Macro unroll: prs1:   PUTA
065E                PRS1:     DS   1-CPM,0EFh   
065E   CD                     DS   CPM,0CDh   
065F   FD                     DS   CPM,APUT&0FFh   
0660   05                     DS   CPM,APUT/256   
0661   C3 42 06               JMP   prstr   
0664                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0664                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0664                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0664                             ; pnl: the same, on a new line.
0664   3E 0D        PNL:      MVI   A,13   
0666                          ;*Macro unroll:  PUTA
0666                          DS   1-CPM,0EFh   
0666   CD                     DS   CPM,0CDh   
0667   FD                     DS   CPM,APUT&0FFh   
0668   05                     DS   CPM,APUT/256   
0669   3E 0A                  MVI   A,10   
066B                          ;*Macro unroll:  PUTA
066B                          DS   1-CPM,0EFh   
066B   CD                     DS   CPM,0CDh   
066C   FD                     DS   CPM,APUT&0FFh   
066D   05                     DS   CPM,APUT/256   
066E   E3           PMSG:     XTHL      
066F   CD 42 06               CALL   prstr   
0672   E3                     XTHL      
0673   C9                     RET      
0674                             ; chkstk: both stacks are checked once per character, not in every handler.
0674                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0674                             ; the constant carries if it is above (cells were popped that were never
0674                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0674                             ; a character late at most: the bytes above DSTOP and the guard band below
0674                             ; the page take what happens meanwhile.
0674   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
0675   21 05 F5               LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0678   39                     DAD   SP   
0679   DA A3 06               JC   e_under   
067C   24                     INR   H   
067D   C2 9D 06               JNZ   e_over   
0680   2A 34 0B               LHLD   RSP   ; the return stack: in its page (or it has
0683   7C                     MOV   A,H   ;   overflowed), and not above its empty
0684   FE 09                  CPI   RSPAGE   ;   position (an underflow stays inside the
0686   C2 9A 06               JNZ   e_rover   ;   page, in the guard band)
0689   7D                     MOV   A,L   
068A   FE E1                  CPI   RSTOP&0FFh+1   
068C   D2 91 06               JNC   e_runder   
068F   EB                     XCHG      ; TOS back
0690   C9                     RET      
0691   21 E0 09     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
0694   22 34 0B               SHLD   RSP   
0697   3E 72                  MVI   A,"r"   
0699   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
069A   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
069C   21                     DB   21h   
069D   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
069F   EB                     XCHG      ; TOS back
06A0   C3 D4 06               JMP   errp   
06A3   31 FC 0A     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
06A6   3E 73                  MVI   A,"s"   
06A8   C3 D5 06               JMP   error   
06AB                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
06AB                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
06AB                             ; every build: if the IP is in page zero, this was a call of an undefined
06AB                             ; word. The call is undone, so the place is the call itself.
06AB   04           E_HI:     INR   B   
06AC   05                     DCR   B   
06AD   C2 CB 06               JNZ   e_resv   
06B0   E5                     PUSH   H   
06B1                          ;*Macro unroll:  POPR
06B1                          DS   1-CPM,0CFh   
06B1   CD                     DS   CPM,0CDh   
06B2   0C                     DS   CPM,AROP&0FFh   
06B3   01                     DS   CPM,AROP/256   
06B4   44                     MOV   B,H   
06B5   4D                     MOV   C,L   
06B6   E1                     POP   H   
06B7   3E 55                  MVI   A,"U"   
06B9   C3 D5 06               JMP   error   
06BC                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
06BC                             ; back in TOS. prstr"s return address goes first. But if "$' had no
06BC                             ; address at all (the stack was empty), it is s, found now: chkstk, called
06BC                             ; one cell up, sees the stack past its empty place then.
06BC   D1           E_DOLLAR:   POP   D   
06BD   E1                     POP   H   
06BE   CD 74 06               CALL   chkstk   
06C1   E5                     PUSH   H   
06C2   2A 3A 0B               LHLD   PSAVE   
06C5   11                     DB   11h   ; (LXI D hides e_quote's first two bytes)
06C6                             ; Error entries. Each loads its letter and then hides the next entry inside
06C6                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
06C6   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
06C7   4D                     MOV   C,L   ;   past the opening quote, which is the place
06C8   3E 51                  MVI   A,"Q"   
06CA   11                     DB   11h   
06CB   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
06CD   11                     DB   11h   
06CE   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
06D0   11                     DB   11h   
06D1   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
06D3   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
06D4                             ; errp: an error found inside a routine: drop its return address first.
06D4   D1           ERRP:     POP   D   
06D5                             ; error: the report, then the end. A = the letter, BC = one past the place,
06D5                             ; HL = TOS, and both stacks as the report is to show them:
06D5                             ; 
06D5                             ;   Err X @ line,col
06D5                             ;   D:n: the top 8 cells at most, bottom to top
06D5                             ;   R:n
06D5   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
06D6   5F                     MOV   E,A   
06D7   CD 64 06               CALL   pnl   
06DA   45 72 72 20 22         DB   "Err ",22h   
06DF   7B                     MOV   A,E   
06E0                          ;*Macro unroll:  PUTA
06E0                          DS   1-CPM,0EFh   
06E0   CD                     DS   CPM,0CDh   
06E1   FD                     DS   CPM,APUT&0FFh   
06E2   05                     DS   CPM,APUT/256   
06E3   CD 6E 06               CALL   pmsg   
06E6   20 40 20 22            DB   " @ ",22h   
06EA   0B                     DCX   B   ; BC = the place
06EB                             ; The line and column. A place below the program is in the line
06EB                             ; buffer: line 0. Otherwise count the LFs from the program's start;
06EB                             ; DE = the line's number, HL = where it starts.
06EB   21 80 0B               LXI   H,LINEBUF   
06EE   11 00 00               LXI   D,0   
06F1   78                     MOV   A,B   
06F2   FE 0C                  CPI   PROG/256   
06F4   DA 0E 07               JC   er3   
06F7   24                     INR   H   
06F8   6B                     MOV   L,E   ; HL = PROG
06F9   13           ER1:      INX   D   ; a new line starts at HL
06FA   E5                     PUSH   H   
06FB   7D           ER2:      MOV   A,L   
06FC   91                     SUB   C   
06FD   7C                     MOV   A,H   
06FE   98                     SBB   B   
06FF   D2 0D 07               JNC   er2x   ; reached the place
0702   7E                     MOV   A,M   
0703   23                     INX   H   
0704   FE 0A                  CPI   10   
0706   C2 FB 06               JNZ   er2   
0709   F1                     POP   PSW   
070A   C3 F9 06               JMP   er1   
070D   E1           ER2X:     POP   H   
070E   C5           ER3:      PUSH   B   
070F   E5                     PUSH   H   
0710   EB                     XCHG      
0711   CD E4 03               CALL   pdec   ; the line
0714   3E 2C                  MVI   A,","   
0716                          ;*Macro unroll:  PUTA
0716                          DS   1-CPM,0EFh   
0716   CD                     DS   CPM,0CDh   
0717   FD                     DS   CPM,APUT&0FFh   
0718   05                     DS   CPM,APUT/256   
0719   D1                     POP   D   
071A   E1                     POP   H   
071B   CD 8C 07               CALL   sub16   
071E   23                     INX   H   
071F   CD E4 03               CALL   pdec   ; the column
0722   CD 64 06               CALL   pnl   
0725   44 3A 22               DB   "D:",22h   
0728   21 06 F5               LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
072B   39                     DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
072C                          ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
072C                          DS   1-CPM,0E7h   ;   first value and holds nothing)
072C   CD                     DS   CPM,0CDh   
072D   27                     DS   CPM,ANEG&0FFh   
072E   01                     DS   CPM,ANEG/256   
072F   7C                     MOV   A,H   
0730   CD 80 07               CALL   phal2   ; the depth
0733   3E 3A                  MVI   A,":"   
0735                          ;*Macro unroll:  PUTA
0735                          DS   1-CPM,0EFh   
0735   CD                     DS   CPM,0CDh   
0736   FD                     DS   CPM,APUT&0FFh   
0737   05                     DS   CPM,APUT/256   
0738   79                     MOV   A,C   
0739   FE 09                  CPI   9   
073B   DA 48 07               JC   er6   
073E   CD 6E 06               CALL   pmsg   
0741   20 2E 2E 2E 22         DB   " ...",22h   
0746   0E 08                  MVI   C,8   
0748   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
074A   69                     MOV   L,C   
074B   29                     DAD   H   
074C   39                     DAD   SP   ; HL -> just above the deepest of them
074D   0C                     INR   C   
074E   0D           ER7:      DCR   C   
074F   CA 66 07               JZ   er8   
0752   2B                     DCX   H   
0753   56                     MOV   D,M   
0754   2B                     DCX   H   
0755   5E                     MOV   E,M   
0756   E5                     PUSH   H   
0757   C5                     PUSH   B   
0758   3E 20                  MVI   A," "   
075A                          ;*Macro unroll:  PUTA
075A                          DS   1-CPM,0EFh   
075A   CD                     DS   CPM,0CDh   
075B   FD                     DS   CPM,APUT&0FFh   
075C   05                     DS   CPM,APUT/256   
075D   EB                     XCHG      
075E   CD D7 03               CALL   psgn   
0761   C1                     POP   B   
0762   E1                     POP   H   
0763   C3 4E 07               JMP   er7   
0766   CD 64 06     ER8:      CALL   pnl   
0769   52 3A 22               DB   "R:",22h   
076C   2A 34 0B               LHLD   RSP   
076F   EB                     XCHG      
0770   21 E0 09               LXI   H,RSTOP   
0773   CD 7D 07               CALL   phalf   
0776   CD 64 06               CALL   pnl   
0779   22                     DB   22h   
