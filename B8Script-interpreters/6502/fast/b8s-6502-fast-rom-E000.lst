EB82                          IF   1-FAST   
                    UD0:      LDY   #16   
                    UD1:      ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              PHA      
                              LDA   T1   
                              SBC   D1   
                              BCC   ud2   
                              STA   T1   
                              PLA      
                              STA   T0   
                              INC   TL   ; the quotient bit (TL's bit 0 is free)
                              DB   24h   ; (BIT zp: steps over the PLA)
                    UD2:      PLA      
                              DEY      
                              BNE   ud1   
                              RTS      
EB82                          ENDIF      
EB82                             ; =============================================================================
EB82                             ;  Fetches, and the keyboard
EB82                             ; =============================================================================
EB82   A0 01        H_FETCH:   LDY   #1   ; "@"
EB84   B1 02                  LDA   (TL),Y   
EB86   48                     PHA      ; the high byte, while "," gets the low one
EB87   20 8E EB               JSR   h_cfetch   
EB8A   68                     PLA      
EB8B   85 03                  STA   TH   
EB8D   60                     RTS      
EB8E                H_CFETCH:      ; ","
EB8E   A0 00                  LDY   #0   
EB90   B1 02                  LDA   (TL),Y   
EB92   85 02        CF2:      STA   TL   ; TOS = A (low), Y (high)
EB94   84 03                  STY   TH   
EB96   60                     RTS      
EB97                             ; "?" ( n -- c ) or ( -n -- addr )
EB97                             ;   n > 0: wait about n ms for a key; 0 if none came
EB97                             ;   n = 0: wait for a key
EB97                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
EB97                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
EB97   A5 03        H_KEY:    LDA   TH   
EB99   30 20                  BMI   line   
EB9B   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
EB9D   20 AD E2     KT2:      JSR   getk   
EBA0   D0 15                  BNE   kt3   
EBA2   88                     DEY      
EBA3   D0 F8                  BNE   kt2   
EBA5   A5 02                  LDA   TL   ; count the millisecond off:
EBA7   D0 06                  BNE   kt4   
EBA9   A5 03                  LDA   TH   
EBAB   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
EBAD   C6 03                  DEC   TH   
EBAF   C6 02        KT4:      DEC   TL   
EBB1   D0 E8                  BNE   kt1   
EBB3   A5 03                  LDA   TH   
EBB5   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
EBB7   A0 00        KT3:      LDY   #0   
EBB9   F0 D7                  BEQ   cf2   ; always: TOS = A
EBBB                             ; Backspace takes the last character back (and is echoed as it is), CR ends
EBBB                             ; (stored, not echoed), every other key is stored and echoed until the line
EBBB                             ; is full. Y = the length so far; TL = the most allowed.
EBBB   20 B4 E6     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
EBBE   D0 04                  BNE   ln0   
EBC0   A5 02                  LDA   TL   
EBC2   10 04                  BPL   ln1   
EBC4   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
EBC6   85 02                  STA   TL   
EBC8   A0 00        LN1:      LDY   #0   
EBCA   F0 03                  BEQ   ln2   ; always
EBCC   20 03 FF     LN3:      JSR   CONOUT   
EBCF   20 AD E2     LN2:      JSR   getk   
EBD2   F0 FB                  BEQ   ln2   
EBD4   C9 0D                  CMP   #13   
EBD6   F0 14                  BEQ   ln5   
EBD8   C9 08                  CMP   #8   
EBDA   F0 0A                  BEQ   ln4   
EBDC   C4 02                  CPY   TL   
EBDE   B0 EF                  BCS   ln2   ; full
EBE0   99 80 04               STA   LINEBUF,Y   
EBE3   C8                     INY      
EBE4   D0 E6                  BNE   ln3   ; always: echo it
EBE6   88           LN4:      DEY      ; Backspace: one back, and echo it,
EBE7   10 E3                  BPL   ln3   
EBE9   C8                     INY      ;   unless the line was empty
EBEA   F0 E3                  BEQ   ln2   ; always
EBEC   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
EBEF   A9 80                  LDA   #<LINEBUF   
EBF1   A0 04                  LDY   #>LINEBUF   
EBF3   D0 9D                  BNE   cf2   ; always: TOS = the line's address
EBF5                             ; =============================================================================
EBF5                             ;  Machine code: the grave
EBF5                             ; =============================================================================
EBF5                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
EBF5                             ; are stored from addr until a non-hex character; then a RET (60h) is
EBF5                             ; written and its address is left. An odd last digit is consumed and dropped.
EBF5                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
EBF5                             ; contract in the header.
EBF5   20 04 E6     H_GRAVE:   JSR   rdhex   
EBF8   B0 1C                  BCS   exec   
EBFA   0A           HX1:      ASL      
EBFB   0A                     ASL      
EBFC   0A                     ASL      
EBFD   0A                     ASL      
EBFE   85 04                  STA   T0   
EC00   20 04 E6               JSR   rdhex   
EC03   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
EC05   05 04                  ORA   T0   
EC07   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
EC09   20 04 E5               JSR   inctos   
EC0C   20 04 E6               JSR   rdhex   
EC0F   90 E9                  BCC   hx1   
EC11   A9 60        HX2:      LDA   #60h   
EC13   91 02                  STA   (TL),Y   
EC15   60                     RTS      
EC16   A5 02        EXEC:     LDA   TL   
EC18   85 04                  STA   T0   
EC1A   A5 03                  LDA   TH   
EC1C   85 05                  STA   T1   
EC1E   20 58 E6               JSR   drop   ; the address is consumed
EC21   6C 04 00               JMP   (T0)   
EC24                          IF   CHECKED   
EC24                             ; =============================================================================
EC24                             ;  Checked build: the error report
EC24                             ; =============================================================================
EC24                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
EC24                             ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
EC24                             ; overflowed or underflowed hardware stack wraps inside its page, and only
EC24                             ; its depth is shown.
EC24                             ;   CR LF
EC24                             ;   Err X @ line,col CR LF
EC24                             ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
EC24                             ;   R:n CR LF
EC24                             ; The numbers go through "#" (h_num), each pushed over the data stack first
EC24                             ; and popped again by "#", so the stack is shown as it was.
EC24   48           ERROR:    PHA      ; the letter
EC25   A0 00                  LDY   #M_ERR-MSG   
EC27   20 69 E5               JSR   prs   ; CR LF "Err "
EC2A   68                     PLA      
EC2B   20 03 FF               JSR   CONOUT   
EC2E   20 69 E5               JSR   prs   ; " @ " (it follows M_ERR)
EC31                             ; The line and the column of the place, both from 1. The line is counted in
EC31                             ; a cell pushed over the data stack (TOS). A place below the program is in
EC31                             ; the -n? line buffer: line 0, and the column is the place in the buffer.
EC31                             ; Otherwise IP (free now: the program has stopped) runs from PROG to the
EC31                             ; place, counting LFs; CL keeps where the last line started, and the column
EC31                             ; is the place minus that, plus 1.
EC31   A9 80                  LDA   #<LINEBUF   
EC33   85 0A                  STA   CL   
EC35   A9 04                  LDA   #>LINEBUF   
EC37   85 0B                  STA   CL+1   
EC39   A9 00                  LDA   #0   
EC3B   A8                     TAY      
EC3C   20 5F E3               JSR   pushay   ; TOS = the line, 0 so far
EC3F   A5 06                  LDA   PLACE   
EC41   C9 00                  CMP   #<PROG   
EC43   A5 07                  LDA   PLACE+1   
EC45   E9 05                  SBC   #>PROG   
EC47   90 23                  BCC   lc9   ; below the program: line 0
EC49   E6 02                  INC   TL   
EC4B   20 27 E6               JSR   rstip   
EC4E   A5 00        LC3:      LDA   IP   ; a line starts here
EC50   85 0A                  STA   CL   
EC52   A5 01                  LDA   IP+1   
EC54   85 0B                  STA   CL+1   
EC56   A5 00        LC1:      LDA   IP   
EC58   C5 06                  CMP   PLACE   
EC5A   A5 01                  LDA   IP+1   
EC5C   E5 07                  SBC   PLACE+1   
EC5E   B0 0C                  BCS   lc9   ; at the place
EC60   20 1B E6               JSR   getc   
EC63   C9 0A                  CMP   #10   
EC65   D0 EF                  BNE   lc1   
EC67   20 04 E5               JSR   inctos   ; an LF: a new line starts after it
EC6A   D0 E2                  BNE   lc3   ; always (Z clear: fewer than 65536 lines)
EC6C   20 3D E5     LC9:      JSR   h_num   ; the line (and it is dropped)
EC6F   A9 2C                  LDA   #","   
EC71   20 03 FF               JSR   CONOUT   
EC74   38                     SEC      
EC75   A5 06                  LDA   PLACE   
EC77   E5 0A                  SBC   CL   
EC79   48                     PHA      
EC7A   A5 07                  LDA   PLACE+1   
EC7C   E5 0B                  SBC   CL+1   
EC7E   A8                     TAY      
EC7F   68                     PLA      
EC80   20 5F E3               JSR   pushay   
EC83   20 04 E5               JSR   inctos   ; + 1
EC86   20 3D E5               JSR   h_num   ; the column
EC89   A0 0B                  LDY   #M_STK-MSG   
EC8B   20 69 E5               JSR   prs   ; CR LF "D:"
EC8E   8A                     TXA      
EC8F   49 FF                  EOR   #0FFh   
EC91   38                     SEC      
EC92   E9 03                  SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
EC94   48                     PHA      
EC95   20 E0 EC               JSR   prnum8   
EC98   68                     PLA      
EC99   A0 14                  LDY   #M_C-MSG   ; ":"
EC9B   C9 09                  CMP   #9   
EC9D   90 04                  BCC   er3   
EC9F   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
ECA1   A0 0F                  LDY   #M_CD-MSG   
ECA3   85 06        ER3:      STA   T2   ; T2 = how many cells to show (the place
ECA5                             ;   is no longer needed)
ECA5   20 69 E5               JSR   prs   
ECA8   20 69 E3               JSR   push   ; TOS into memory with the rest: cell i from
ECAB                             ;   the top is at DSL+X+i now
ECAB   A5 06        ER4:      LDA   T2   ; cells T2-1 down to 0, the top last
ECAD   F0 1B                  BEQ   er5   
ECAF   C6 06                  DEC   T2   
ECB1   A9 20                  LDA   #" "   
ECB3   20 03 FF               JSR   CONOUT   
ECB6   8A                     TXA      
ECB7   18                     CLC      
ECB8   65 06                  ADC   T2   
ECBA   A8                     TAY      
ECBB   B9 00 02               LDA   DSL,Y   
ECBE   48                     PHA      
ECBF   B9 00 03               LDA   DSH,Y   
ECC2   A8                     TAY      
ECC3   68                     PLA      
ECC4   20 E2 EC               JSR   prnum   
ECC7   4C AB EC               JMP   er4   
ECCA   A0 15        ER5:      LDY   #M_RTN-MSG   
ECCC   20 69 E5               JSR   prs   ; CR LF "R:"
ECCF   AD 35 04               LDA   RSV   
ECD2   49 FF                  EOR   #0FFh   
ECD4   4A                     LSR      ; (FFh - S) / 2 entries
ECD5   20 E0 EC               JSR   prnum8   
ECD8   A0 09                  LDY   #M_NL-MSG   
ECDA   20 69 E5               JSR   prs   
ECDD   4C 09 FF               JMP   EXIT   
ECE0                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
ECE0                             ; prnum8: the same for A alone, 0-255.
ECE0   A0 00        PRNUM8:   LDY   #0   
ECE2   20 5F E3     PRNUM:    JSR   pushay   
ECE5   4C 3D E5               JMP   h_num   
ECE8                          ENDIF      
ECE8                             ; =============================================================================
ECE8                             ;  The fast build (SPEED = 2)
ECE8                             ; 
ECE8                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
ECE8                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
ECE8                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
ECE8                             ;  so there is no JSR and no RTS per character:
ECE8                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
ECE8                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
ECE8                             ;  The letters and digits have one entry each, which knows its cell or its
ECE8                             ;  value already; the commonest punctuation is written for the table; the
ECE8                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
ECE8                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
ECE8                             ;  and the clear carry they expect.
ECE8                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
ECE8                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
ECE8                             ;  stacks first, as next does in the other builds.
ECE8                             ;  Everything here is read-only: the image can be ROM, as the others are.
ECE8                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
ECE8                             ;  starts after it.
ECE8                             ; =============================================================================
ECE8                          IF   FAST   
ECE8                             ; fnext: the dispatcher, after the checks of the checked build
ECE8                FNEXT:       
ECE8                          ENDIF      
ECE8                          IF   FAST*CHECKED   
ECE8                             ; (the same checks as next in the other checked builds)
ECE8   8A                     TXA      ; TSX trashes X: keep it in A
ECE9   BA                     TSX      
ECEA   8E 35 04               STX   RSV   
ECED   E0 20                  CPX   #RSLIM   
ECEF   AA                     TAX      
ECF0   B0 03                  BCS   fn1   
ECF2   4C 46 E2               JMP   e_rstack   
ECF5   E0 FD        FN1:      CPX   #DSE+1   
ECF7   90 03                  BCC   fn3   
ECF9   4C 58 E2               JMP   e_stack   
