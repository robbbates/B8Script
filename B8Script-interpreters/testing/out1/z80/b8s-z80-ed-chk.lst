0608   FE 0D                  CP   13   
060A   28 0D                  JR   Z,ce2   
060C   FE 0A                  CP   10   
060E   28 09                  JR   Z,ce2   
0610   12                     LD   (DE),A   
0611   EF                     RST   28h   
0612   23                     INC   HL   
0613   1C                     INC   E   
0614   7B                     LD   A,E   
0615   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0617   20 EE                  JR   NZ,ce1   
0619   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
061A   5D                     LD   E,L   
061B   C3 3A 05               JP   ed1   
061E                             ; Return. If ^E put a line here, the text goes back in its place. If not:
061E                             ; a number and text is a line to put in, a number alone a line to take out,
061E                             ; and anything else is run where it is.
061E   E5           CRET:     PUSH   HL   ; the end of what was typed
061F   2A 3A 82               LD   HL,(EDLN)   
0622   7C                     LD   A,H   
0623   B5                     OR   L   
0624   28 07                  JR   Z,cr1   
0626   E5                     PUSH   HL   
0627   CD AF 06               CALL   delln   
062A   E1                     POP   HL   
062B   18 13                  JR   ins   
062D   CD CD 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0630   79                     LD   A,C   ; C is still 80h if there was no number:
0631   87                     ADD   A,A   ;   only then is twice it 0
0632   28 36                  JR   Z,st0p   ; no number: run the line
0634   0A                     LD   A,(BC)   
0635   FE 0D                  CP   13   
0637   20 06                  JR   NZ,cr2   
0639   D1                     POP   DE   ; the number alone: take that line out
063A   CD AF 06               CALL   delln   
063D   18 24                  JR   gedit   
063F   03           CR2:      INC   BC   ; step over the one character after the number
0640                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0640                             ; CR and LF included, and copy it in.
0640   CD BF 06     INS:      CALL   find   ; HL -> where it goes
0643   D1                     POP   DE   ; the end of what was typed
0644   7B                     LD   A,E   
0645   91                     SUB   C   ; A = the length of the text, with its CR LF
0646   C5                     PUSH   BC   ; the text
0647   4F                     LD   C,A   
0648   06 00                  LD   B,0   
064A   C5                     PUSH   BC   ; its length
064B   54                     LD   D,H   
064C   5D                     LD   E,L   ; DE = where it goes
064D   AF                     XOR   A   
064E   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
064F   ED B1                  CPIR      ; HL -> one past the program's NUL
0651   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0653   44                     LD   B,H   
0654   4D                     LD   C,L   
0655   19                     ADD   HL,DE   
0656   2B                     DEC   HL   ; HL -> the NUL
0657   EB                     EX   DE,HL   
0658   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0659   E5                     PUSH   HL   
065A   19                     ADD   HL,DE   ; the NUL's new place
065B   EB                     EX   DE,HL   
065C   ED B8                  LDDR      ; move the rest of the program up
065E   C1                     POP   BC   ; the length
065F   D1                     POP   DE   ; where it goes
0660   E1                     POP   HL   ; the text
0661   ED B0                  LDIR      
0663   C3 28 05     GEDIT:    JP   edit   
0666                             ; ^G: run the program. st0p: run the typed line (BC -> it).
0666   01 00 83     CRUN:     LD   BC,PROG   
0669   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
066A   E1           ST0P:     POP   HL   ; (the end of what was typed)
066B                             ; st0: start running at BC. The heap starts after the stored program's NUL.
066B   21 00 83     ST0:      LD   HL,PROG   
066E   AF                     XOR   A   
066F   BE           ST1:      CP   (HL)   
0670   23                     INC   HL   
0671   20 FC                  JR   NZ,st1   
0673   22 7C 82               LD   (HEAP),HL   
0676                          ENDIF      
0676                          IF   EDITOR*CHECKED   
0676   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0677   22 38 82               LD   (NPEND),HL   ;   release below it
067A                          ENDIF      
067A                          IF   EDITOR   
067A   E1                     POP   HL   ; TOS: the data stack is as the last line left it
067B   F7                     RST   30h   ; (its return address is thrown away)
067C                             ; ^L: list from line n. DE = the number of the line at HL.
067C   CD CD 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
067F   7C                     LD   A,H   
0680   B5                     OR   L   
0681   20 01                  JR   NZ,li0   
0683   2C                     INC   L   ;   then from line 1
0684   E5           LI0:      PUSH   HL   
0685   CD BF 06               CALL   find   
0688   D1                     POP   DE   
0689   7E           LI1:      LD   A,(HL)   
068A   B7                     OR   A   
068B   28 D6                  JR   Z,gedit   ; the end of the text
068D   CD 06 FF               CALL   rawk   
0690   28 09                  JR   Z,li3   ; no key: carry on
0692   FE 03                  CP   3   
0694   C4 C8 05               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
0697   FE 03                  CP   3   
0699   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
069B   E5           LI3:      PUSH   HL   
069C   D5                     PUSH   DE   
069D   EB                     EX   DE,HL   
069E   CD 4B 03               CALL   pdec   ; the line's number,
06A1   3E 20                  LD   A," "   
06A3   EF                     RST   28h   ;   a space,
06A4   D1                     POP   DE   
06A5   E1                     POP   HL   
06A6   13                     INC   DE   
06A7   CD D7 06               CALL   prl   ;   and the line
06AA   18 DD                  JR   li1   
06AC   C3 28 05     GED1:     JP   edit   
06AF                             ; delln: take line n (in HL) out: copy everything after it down over it.
06AF   CD BF 06     DELLN:    CALL   find   
06B2   54                     LD   D,H   
06B3   5D                     LD   E,L   
06B4   CD CD 06               CALL   nxl   ; HL -> the next line
06B7   7E           DE1:      LD   A,(HL)   
06B8   12                     LD   (DE),A   
06B9   23                     INC   HL   
06BA   13                     INC   DE   
06BB   B7                     OR   A   
06BC   20 F9                  JR   NZ,de1   
06BE   C9                     RET      
06BF                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
06BF                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
06BF   EB           FIND:     EX   DE,HL   
06C0   21 00 83               LD   HL,PROG   
06C3   1B           FI1:      DEC   DE   
06C4   7A                     LD   A,D   
06C5   B3                     OR   E   
06C6   C8                     RET   Z   
06C7   CD CD 06               CALL   nxl   
06CA   20 F7                  JR   NZ,fi1   
06CC   C9                     RET      
06CD                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
06CD                             ; stop at the NUL that ends the text (and return zero).
06CD   7E           NXL:      LD   A,(HL)   
06CE   B7                     OR   A   
06CF   C8                     RET   Z   
06D0   23                     INC   HL   
06D1   FE 0A                  CP   10   
06D3   20 F8                  JR   NZ,nxl   
06D5   B7                     OR   A   
06D6   C9                     RET      
06D7                             ; prl: print the line at HL, to its LF; HL -> just past it.
06D7   7E           PRL:      LD   A,(HL)   
06D8   EF                     RST   28h   
06D9   7E                     LD   A,(HL)   
06DA   23                     INC   HL   
06DB   FE 0A                  CP   10   
06DD   20 F8                  JR   NZ,prl   
06DF   C9                     RET      
06E0                          ENDIF      
06E0                          IF   EDGEN   
06E0                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
06E0                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
06E0                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
06E0                             ; line with no end is given one. Nothing is echoed, and there is no check
06E0                             ; for running out of memory.
06E0   21 FF 82     CREAD:    LD   HL,PROG-1   
06E3   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
06E5   23                     INC   HL   ;   the line buffer's last, and spare)
06E6   CD C8 05     RD1:      CALL   ekey   
06E9   4F                     LD   C,A   
06EA   FE 1A                  CP   1Ah   
06EC   20 02                  JR   NZ,rd2   
06EE   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
06F0   FE 0A        RD2:      CP   10   
06F2   20 07                  JR   NZ,rd3   
06F4   2B                     DEC   HL   
06F5   BE                     CP   (HL)   
06F6   23                     INC   HL   
06F7   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
06F9   3E 0D                  LD   A,13   ; anywhere else it ends the line
06FB   77           RD3:      LD   (HL),A   
06FC   23                     INC   HL   
06FD   FE 0D                  CP   13   
06FF   20 03                  JR   NZ,rd4   
0701   36 0A                  LD   (HL),10   ; after a CR goes a LF
0703   23                     INC   HL   
0704   79           RD4:      LD   A,C   
0705   FE 1A                  CP   1Ah   
0707   20 DD                  JR   NZ,rd1   
0709   36 00                  LD   (HL),0   
070B   18 9F                  JR   ged1   
070D                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
070D   21 00 83     CWRITE:   LD   HL,PROG   
0710   7E           CW1:      LD   A,(HL)   
0711   B7                     OR   A   
0712   28 98                  JR   Z,ged1   
0714   EF                     RST   28h   
0715   23                     INC   HL   
0716   18 F8                  JR   cw1   
0718                          ENDIF      
0718                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0718                          ENDIF      
0718                             ; =============================================================================
0718                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0718                          ENDIF      
0718                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0718                          ENDIF      
0718                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
0718                          ENDIF      
0718                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0718                          ENDIF      
0718                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0718                          ENDIF      
0718                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0718                          ENDIF      
0718                IMGEND:      


