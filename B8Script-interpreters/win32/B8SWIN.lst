  1250 000004B3 FF55B9              <1>         call    [V(iat_ReadConsoleInputA)]
  1251 000004B6 807D3B01            <1>         cmp     byte [V(v_rec)],1       ; KEY_EVENT
  1252 000004BA 75C6                <1>         jne     .wk1
