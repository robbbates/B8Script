027E   C5                     PUSH   B   
027F   7A                     MOV   A,D   
0280   B7                     ORA   A   
0281   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0282   AC                     XRA   H   
0283   F5                     PUSH   PSW   ; S flag = sign of q
0284   7C                     MOV   A,H   
0285   B7                     ORA   A   
0286   FC 27 01               CM   neg16   ; HL = |b|
0289   EB                     XCHG      
028A   7C                     MOV   A,H   
028B   B7                     ORA   A   
028C   FC 27 01               CM   neg16   ; HL = |a|, DE = |b|
028F   CD 76 03               CALL   udiv   ; HL = q, BC = r
0292   F1                     POP   PSW   
0293   FC 27 01               CM   neg16   ; q's sign
0296   EB                     XCHG      ; DE = q
0297   60                     MOV   H,B   
0298   69                     MOV   L,C   ; HL = r
0299   F1                     POP   PSW   
029A   FC 27 01               CM   neg16   ; r's sign
029D   C1                     POP   B   
029E   D5                     PUSH   D   ; q under r
029F                          ;*Macro unroll:  NEXT
029F                          DS   (1-CPM)*(1-FAST),0F7h   
029F   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02A0   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02A1   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02A2                             ; ---- stack and storage -----------------------------------------------------
02A2   E5           H_DUP:    PUSH   H   ; ":"
02A3                          ;*Macro unroll:  NEXT
02A3                          DS   (1-CPM)*(1-FAST),0F7h   
02A3   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02A4   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02A5   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02A6   E3           H_SWAP:   XTHL      ; "%"
02A7                          ;*Macro unroll:  NEXT
02A7                          DS   (1-CPM)*(1-FAST),0F7h   
02A7   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02A8   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02A9   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02AA                             ; (The checked build tests the address before it takes the value off the
02AA                             ; stack, so that an error report shows both.)
02AA                H_STORE:      ; "!" ( n addr -- )
02AA                          IF   CHECKED   
                              CALL   chkst   
02AA                          ENDIF      
02AA   D1                     POP   D   
02AB   73                     MOV   M,E   
02AC   23                     INX   H   
02AD   72                     MOV   M,D   
02AE                          ;*Macro unroll:  DROP
02AE                          DS   (1-CPM)*(1-FAST),0DFh   
02AE   C3                     DS   CPM*(1-FAST),0C3h   
02AF   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02B0   01                     DS   CPM*(1-FAST),ADRP/256   
02B1                          DS   FAST,0E1h   
02B1                          DS   FAST,0C3h   
02B1                          DS   FAST,ANXT&0FFh   
02B1                          DS   FAST,ANXT/256   
02B1                H_CSTORE:      ; "." ( c addr -- )
02B1                          IF   CHECKED   
                              CALL   chkst   
02B1                          ENDIF      
02B1   D1                     POP   D   
02B2   73                     MOV   M,E   
02B3                          ;*Macro unroll:  DROP
02B3                          DS   (1-CPM)*(1-FAST),0DFh   
02B3   C3                     DS   CPM*(1-FAST),0C3h   
02B4   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02B5   01                     DS   CPM*(1-FAST),ADRP/256   
02B6                          DS   FAST,0E1h   
02B6                          DS   FAST,0C3h   
02B6                          DS   FAST,ANXT&0FFh   
02B6                          DS   FAST,ANXT/256   
02B6                             ; ---- console ---------------------------------------------------------------
02B6                             ; 22h pushes the address of the text after it and skips the string.
02B6   E5           H_STR:    PUSH   H   
02B7   60                     MOV   H,B   
02B8   69                     MOV   L,C   
02B9   CD 91 04               CALL   skipstr   
02BC                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
02BC                          ENDIF      
02BC                          ;*Macro unroll:  NEXT
02BC                          DS   (1-CPM)*(1-FAST),0F7h   
02BC   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02BD   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02BE   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02BF                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02BF                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02BF                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02BF                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02BF                          IF   1-CHECKED   
02BF   C3 C9 03     H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
02C2                PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
02C2                PRAGAIN:   EQU   prlp   ;   the image's first two pages)
02C2                          ENDIF      
02C2                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   SHLD   PSAVE   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ADRP&0FFh   
                              DS   CPM*(1-FAST),ADRP/256   
                              DS   FAST,0E1h   
                              DS   FAST,0C3h   
                              DS   FAST,ANXT&0FFh   
                              DS   FAST,ANXT/256   
02C2                          ENDIF      
02C2   7D           H_EMIT:   MOV   A,L   ; "'"
02C3                          ;*Macro unroll:  PUTA
02C3                          DS   1-CPM,0EFh   
02C3   CD                     DS   CPM,0CDh   
02C4   1D                     DS   CPM,APUT&0FFh   
02C5   05                     DS   CPM,APUT/256   
02C6                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
02C6                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
02C6   C3                     DS   CPM*(1-FAST),0C3h   
02C7   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02C8   01                     DS   CPM*(1-FAST),ADRP/256   
02C9                          DS   FAST,0E1h   
02C9                          DS   FAST,0C3h   
02C9                          DS   FAST,ANXT&0FFh   
02C9                          DS   FAST,ANXT/256   
02C9                             ; "#" prints TOS as a signed decimal number, with no space after it.
02C9   C5           H_NUM:    PUSH   B   
02CA   CD A8 03               CALL   psgn   
02CD   C1                     POP   B   
02CE                          ;*Macro unroll:  DROP
02CE                          DS   (1-CPM)*(1-FAST),0DFh   
02CE   C3                     DS   CPM*(1-FAST),0C3h   
02CF   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02D0   01                     DS   CPM*(1-FAST),ADRP/256   
02D1                          DS   FAST,0E1h   
02D1                          DS   FAST,0C3h   
02D1                          DS   FAST,ANXT&0FFh   
02D1                          DS   FAST,ANXT/256   
02D1                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
02D1                          ENDIF      
02D1                             ; "?" ( n -- c ) or ( -n -- addr )
02D1                             ;   n > 0: wait about n ms for a key; 0 if none came
02D1                             ;   n = 0: wait for a key
02D1                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02D1                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02D1   7C           H_KEY:    MOV   A,H   
02D2   B7                     ORA   A   
02D3   FA F5 02               JM   line   
02D6   1E 04        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
02D8   CD E3 04     KT2:      CALL   getk   
02DB   C2 EF 02               JNZ   kt3   
02DE   1D                     DCR   E   
02DF   C2 D8 02               JNZ   kt2   
02E2   7C                     MOV   A,H   ; 0? never counts down: it waits
02E3   B5                     ORA   L   
02E4   CA D6 02               JZ   kt1   
02E7   2B                     DCX   H   
02E8   7C                     MOV   A,H   
02E9   B5                     ORA   L   
02EA   C2 D6 02               JNZ   kt1   ; A = 0 if the time ran out
02ED                          IF   1-CHECKED   
02ED   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
02EE   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
02EF                          ENDIF      
02EF   6F           KT3:      MOV   L,A   
02F0   26 00                  MVI   H,0   
02F2                          ;*Macro unroll:  NEXT
02F2                          DS   (1-CPM)*(1-FAST),0F7h   
02F2   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02F3   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02F4   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02F5                             ; Backspace takes the last character back (and is echoed as
02F5                             ; it is), CR ends (stored, not echoed), every other key is stored and
02F5                             ; echoed until the line is full. The line buffer starts at offset 80h
02F5                             ; of its page, so L alone is the place in the line: D holds the L of
02F5                             ; a full line.
02F5   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
02F8   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
02F9   9F                     SBB   A   
02FA   A5                     ANA   L   ; (0 for a count that is too big)
02FB   2F                     CMA      
02FC   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
02FD                             ;   at most
02FD   21 80 08               LXI   H,LINEBUF   
0300   CD E3 04     LN2:      CALL   getk   
0303   CA 00 03               JZ   ln2   
0306   FE 0D                  CPI   13   
0308   CA 27 03               JZ   ln5   
030B   FE 08                  CPI   8   
030D   CA 1F 03               JZ   ln4   
0310   5F                     MOV   E,A   
0311   7D                     MOV   A,L   
0312   BA                     CMP   D   
0313   CA 00 03               JZ   ln2   ; full
0316   73                     MOV   M,E   
0317   2C                     INR   L   
0318   7B                     MOV   A,E   
0319                          ;*Macro unroll: ln3:    PUTA
0319                LN3:      DS   1-CPM,0EFh   
0319   CD                     DS   CPM,0CDh   
031A   1D                     DS   CPM,APUT&0FFh   
031B   05                     DS   CPM,APUT/256   
031C   C3 00 03               JMP   ln2   
031F   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0320   FA 19 03               JM   ln3   ;   unless the line was empty (L left the
0323   2C                     INR   L   ;   upper half of the page)
0324   C3 00 03               JMP   ln2   
0327   77           LN5:      MOV   M,A   ; the CR
0328   2E 80                  MVI   L,LINEBUF & 0FFh   
032A                          ;*Macro unroll:  NEXT
032A                          DS   (1-CPM)*(1-FAST),0F7h   
032A   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
032B   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
032C   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
032D                             ; =============================================================================
032D                             ;  Dispatch table: the low byte of each handler's address, in code order.
032D                             ;  It must not cross a page (the dispatcher only adds to its low byte).
032D                             ; =============================================================================
032D                             ; The handlers of the first NPG1 characters start in the image's second page.
032D                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
032D                             ; differs between the builds, so the count is worked out here.
032D                             ; (One division to a line: asm80 only rounds down when it stores a value.)
032D                          IF   1-FAST   
032D                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
032D                PGBRK:    EQU   (h_break-BASE)/256   
032D                PGDEF:    EQU   (h_def-BASE)/256   
032D                PGFET:    EQU   (h_fetch-BASE)/256   
032D                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
032D                          ENDIF      
032D                          IF   (1-FAST)*(1-PTLATE)   
032D                PTAB:        
032D                          ;*Macro unroll:  PTABLE
032D   AA                     DB   h_store & 0FFh   
032E   B6                     DB   h_str & 0FFh   
032F   C9                     DB   h_num & 0FFh   
0330   BF                     DB   h_print & 0FFh   
0331   A6                     DB   h_swap & 0FFh   
0332   34                     DB   h_and & 0FFh   
0333   C2                     DB   h_emit & 0FFh   
0334   0A                     DB   h_open & 0FFh   
0335   16                     DB   h_close & 0FFh   
0336   5F                     DB   h_mul & 0FFh   
0337   2F                     DB   h_add & 0FFh   
0338   EE                     DB   h_cfetch & 0FFh   
0339   24                     DB   h_sub & 0FFh   
033A   B1                     DB   h_cstore & 0FFh   
033B   7D                     DB   h_div & 0FFh   
033C   A2                     DB   h_dup & 0FFh   
033D   C6                     DB   h_drop & 0FFh   
033E   3F                     DB   h_lt & 0FFh   
033F   50                     DB   h_eq & 0FFh   
0340   3E                     DB   h_gt & 0FFh   
0341   D1                     DB   h_key & 0FFh   
0342   03                     DB   h_fetch & 0FFh   
0343   E1                     DB   h_def & 0FFh   
0344   D2                     DB   h_break & 0FFh   
0345   C9                     DB   h_ret & 0FFh   
0346   82                     DB   h_xor & 0FFh   
0347   9D                     DB   h_alloc & 0FFh   
0348   AA                     DB   h_grave & 0FFh   
0349   18                     DB   h_tor & 0FFh   
034A   8C                     DB   h_or & 0FFh   
034B   20                     DB   h_fromr & 0FFh   
034C   96                     DB   h_not & 0FFh   
034D                PTABEND:      
034D                          ENDIF      
034D                             ; =============================================================================
034D                             ;  Routines (no handler starts past this point)
034D                             ; =============================================================================
034D                             ; Digits: step back onto the first digit and read the whole number.
034D   E5           DIGIT:    PUSH   H   
034E   0B                     DCX   B   
034F   CD 5F 03               CALL   rdnum   
0352                          ;*Macro unroll:  NEXT
0352                          DS   (1-CPM)*(1-FAST),0F7h   
0352   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0353   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0354   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0355                             ; negnum: "-" directly before a digit: read the number, negate it.
0355   E5           NEGNUM:   PUSH   H   
0356   CD 5F 03               CALL   rdnum   
0359                          ;*Macro unroll:  NEGH
0359                          DS   1-CPM,0E7h   
0359   CD                     DS   CPM,0CDh   
035A   27                     DS   CPM,ANEG&0FFh   
035B   01                     DS   CPM,ANEG/256   
035C                          ;*Macro unroll:  NEXT
035C                          DS   (1-CPM)*(1-FAST),0F7h   
035C   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
035D   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
035E   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
035F                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
035F                             ; non-digit. Values wrap at 16 bits, as the spec says.
035F   21 00 00     RDNUM:    LXI   H,0   
0362   0A           RDN1:     LDAX   B   
0363   D6 30                  SUI   "0"   
0365   FE 0A                  CPI   10   
0367   D0                     RNC      
0368   03                     INX   B   
0369   54                     MOV   D,H   
036A   5D                     MOV   E,L   
036B   29                     DAD   H   
036C   29                     DAD   H   
036D   19                     DAD   D   
036E   29                     DAD   H   ; HL * 10
036F   5F                     MOV   E,A   
0370   16 00                  MVI   D,0   
0372   19                     DAD   D   
0373   C3 62 03               JMP   rdn1   
0376                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0376                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0376                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0376                             ; lives on the stack, since A is busy with the shifts.
0376                             ; Dividing by 2 is one shift (the spec wants that fast).
0376   01 00 00     UDIV:     LXI   B,0   
0379                          IF   1-QK   
0379   7B                     MOV   A,E   
037A   EE 02                  XRI   2   
037C   B2                     ORA   D   
037D   C2 8A 03               JNZ   udv0   
0380   B4                     ORA   H   ; A was 0, and the carry is clear
0381   1F                     RAR      
0382   67                     MOV   H,A   
0383   7D                     MOV   A,L   
0384   1F                     RAR      
0385   6F                     MOV   L,A   ; the quotient
0386   78                     MOV   A,B   
0387   17                     RAL      
0388   4F                     MOV   C,A   ; the remainder: the bit that fell out
0389   C9                     RET      
038A                          ENDIF      
038A                          IF   QK   
                                 ; (The builds with room divide by any power of two with shifts: 2, and 32,
                                 ; 64, 256 and the like, which fixed point and byte work use all the time.)
                              MOV   A,D   
                              ORA   A   
                              JNZ   uq1   ; 256 and up
                              ORA   E   
                              JZ   udv0   ; by 0: the long way (it means nothing anyway)
                              DCR   A   
                              ANA   E   
                              JNZ   udv0   ; not a power of two
                              MOV   A,E   ; by 2^k below 256: q = HL >> k, and
                              DCR   A   ;   r = L & (2^k - 1)
                              ANA   L   
                              MOV   C,A   
038A                          ENDIF      
038A                          IF   QK*(1-FAST)   
                    UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
                              ORA   A   
                              RAR      
                              RC      
                              MOV   E,A   
                              MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              JMP   uq2   
038A                          ENDIF      
038A                          IF   FAST   
                                 ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
                                 ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
                    UQ2:      MOV   A,E   
                              CPI   16   
                              JNC   uqh   
                              CPI   2   
                              RC      ; by 1
                              JZ   ur1   
                              CPI   4   
                              JZ   ur2   
                    UR3:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR2:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR1:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              RET      
                    UQH:      CPI   64   
                              MVI   A,0   
                              JZ   ul2   
                              JNC   ul1   
                              MOV   A,E   
                              CPI   32   
                              MVI   A,0   
                              JZ   ul3   
                              DAD   H   ; by 16
                              ADC   A   
                    UL3:      DAD   H   
                              ADC   A   
                    UL2:      DAD   H   
                              ADC   A   
                    UL1:      DAD   H   
                              ADC   A   
                              MOV   L,H   
                              MOV   H,A   
                              RET      
038A                          ENDIF      
038A                          IF   QK   
                    UQ1:      MOV   A,E   
                              ORA   A   
                              JNZ   udv0   
                              MOV   A,D   
                              DCR   A   
                              ANA   D   
                              JNZ   udv0   ; not a power of two
                              MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
                              DCR   A   ;   q = H >> (k - 8)
                              ANA   H   
                              MOV   B,A   
                              MOV   C,L   
                              MOV   L,H   
                              MVI   H,0   
                              MOV   E,D   
                              JMP   uq2   
038A                          ENDIF      
038A                          IF   1-FAST   
038A   3E 10        UDV0:     MVI   A,16   
038C   F5                     PUSH   PSW   
038D   29           UDV1:     DAD   H   ; next dividend bit into the carry
038E   79                     MOV   A,C   
038F   17                     RAL      
0390   4F                     MOV   C,A   
0391   78                     MOV   A,B   
0392   17                     RAL      
0393   47                     MOV   B,A   ; BC = BC*2 + bit
0394   79                     MOV   A,C   
0395   93                     SUB   E   
0396   78                     MOV   A,B   
0397   9A                     SBB   D   ; carry if BC < DE
0398   DA A0 03               JC   udv2   
039B   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
039C   79                     MOV   A,C   
039D   93                     SUB   E   
039E   4F                     MOV   C,A   
039F   2C                     INR   L   ; quotient bit
03A0   F1           UDV2:     POP   PSW   
03A1   3D                     DCR   A   
03A2   F5                     PUSH   PSW   
03A3   C2 8D 03               JNZ   udv1   
03A6   F1                     POP   PSW   
03A7   C9                     RET      
03A8                          ENDIF      
03A8                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
                                 ; starts 8 bits up and takes only the last 8, since its first 8 would only
                                 ; shift zeros)
                    UDV0:     MOV   A,H   
                              ORA   A   
                              JZ   uvs   
                    UV0:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw0   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW0:         
                    UV1:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw1   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
