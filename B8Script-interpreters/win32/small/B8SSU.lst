   906                              <1> ; ---- Speed-ups (base builds) ---------------------------------------------
   907                              <1> ; base takes what pays on x86 of the Z80's base: the skip cache and the
   908                              <1> ; faster skip (at skip), '/' by a power of two as shifts (DIVQ), and in the
   909                              <1> ; unchecked build a variable then '@' or '!' in one step (here). The Z80's
   910                              <1> ; '*' in 8 rounds has nothing to do here: x86 has IMUL. Nor has its true
   911                              <1> ; ')': this ')' reads the block start where it is in every build.
   912                              <1> %if SBASEU
   913                              <1> ; a-z, in the unchecked base build: a variable followed by '@' or '!' is
   914                              <1> ; fetched or stored in the same step (x@ is the commonest pair in most
   915                              <1> ; programs). (A checked build checks the stacks between the two, so it keeps
   916                              <1> ; them apart.)
   917                              <1> lower:  lea     edx,[ARENA+LET+eax*2]   ; EDX -> the cell
   918                              <1>         mov     al,[esi]
   919                              <1>         cmp     al,'@'
   920                              <1>         je      .lw1
   921                              <1>         cmp     al,'!'
   922                              <1>         je      .lw2
   923                              <1>         push    ebx                     ; neither: push the cell's address
   924                              <1>         mov     ebx,edx
   925                              <1>         jmp     ebp
   926                              <1> .lw1:   inc     esi                     ; x@: TOS = the cell's value
   927                              <1>         push    ebx
   928                              <1>         mov     bx,[edx]
   929                              <1>         jmp     ebp
   930                              <1> .lw2:   inc     esi                     ; x!: the cell = TOS, and NOS comes up
   931                              <1>         mov     [edx],bx
   932                              <1>         pop     ebx
   933                              <1>         jmp     ebp
   934                              <1> %endif
   935                              <1> 
   936                              <1> ; =============================================================================
   937                              <1> ;  Checked build: the checks and the error report (here, so that the
   938                              <1> ;  handlers' bodies above reach the error entries with short jumps)
   939                              <1> ; =============================================================================
   940                              <1> %if CHECKED
   941                              <1> e_zero: mov     al,'Z'                  ; dividing by zero
   942                              <1>         jmp     error
   943                              <1> e_heap: mov     al,'H'                  ; the heap
   944                              <1>         jmp     error
   945                              <1> 
   946                              <1> ; chkst1, chkst2: stop with O unless the 1 or 2 bytes at TOS are in the
   947                              <1> ; program's space: from the letter page up to the heap limit. Memory above
   948                              <1> ; the heap top but below the limit is the program's own: Tiny BASIC keeps
   949                              <1> ; its lines there.
   950                              <1> chkst2: mov     eax,ebx
   951                              <1>         sub     ax,LET
   952                              <1>         cmp     ax,LIMIT-LET-1
   953                              <1>         jmp     short chs1
   954                              <1> chkst1: mov     eax,ebx
   955                              <1>         sub     ax,LET
   956                              <1>         cmp     ax,LIMIT-LET
   957                              <1> chs1:   jae     e_store
   958                              <1>         ret
   959                              <1> 
   960                              <1> ; chkstk: both stacks are checked once per character, not in every handler.
   961                              <1> ; A character can pop a cell or two too many, or push one too many, before
   962                              <1> ; it is seen here: the data stack has the caller's frame above it and the
   963                              <1> ; thread's stack below, and the return stack has the image's spare space on
   964                              <1> ; both sides.
   965                              <1> chkstk: lea     eax,[esp+4]
   966                              <1>         sub     eax,[V(v_dstop)]        ; minus 4 x the depth
   967                              <1>         jg      e_under
   968                              <1>         cmp     eax,-4*DSMAX
   969                              <1>         jl      e_over
   970                              <1>         cmp     di,RSTOP & 0FFFFh       ; (the return stack is in one 64K: only
   971                              <1>         ja      e_rund                  ;   the low word changes)
   972                              <1>         cmp     di,(RSTOP-4*RSMAX) & 0FFFFh
   973                              <1>         jb      e_rover
   974                              <1>         ret
   975                              <1> e_under:mov     esp,[V(v_dstop)]        ; data stack underflow: it counts as
   976                              <1>         mov     al,'s'                  ;   empty
   977                              <1>         jmp     short error
   978                              <1> e_rund: mov     edi,RSTOP               ; return stack underflow: the same.
   979                              <1>         or      esi,ARENA               ;   (A ']' or ')' may have taken an IP
   980                              <1>         mov     al,'r'                  ;   of 0 from below the stack: keep the
   981                              <1>                                         ;   place readable)
   982                              <1>         jmp     short errp
   983                              <1> e_rover:mov     al,'R'
   984                              <1>         jmp     short errp
   985                              <1> e_over: mov     al,'S'
   986                              <1>         jmp     short errp
   987                              <1> e_break:mov     al,'B'                  ; Ctrl-C (inside pollk or getk)
   988                              <1>         jmp     short errp
   989                              <1> e_store:mov     al,'O'                  ; a store outside the program's space
   990                              <1>         jmp     short errp
   991                              <1> ; e_dollar: '$' ran into a NUL: Q, with the string's address TOS again. But
   992                              <1> ; if its /~ escapes took cells that weren't there, that is s (as the next
