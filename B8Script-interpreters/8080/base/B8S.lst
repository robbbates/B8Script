0228   CA 06 01               JZ   rdrop   
022B                          IF   QK   
022B   C3 80 05               JMP   closeq   ; (out of the handlers' pages: see Speed-ups)
022E                          ENDIF      
022E                          IF   1-QK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              MOV   B,H   
                              MOV   C,L   ; ... jump to it ...
                              XCHG      
                              JMP   rpushd   ; ... and push it back (which drops the flag)
022E                          ENDIF      
022E                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022E                             ; "-" has two jobs: directly before a digit it starts a negative number.
022E   0A           H_SUB:    LDAX   B   
022F   D6 30                  SUI   "0"   
0231   FE 0A                  CPI   10   
0233   DA 5E 03               JC   negnum   
