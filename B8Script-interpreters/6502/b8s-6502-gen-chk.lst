0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  Two builds, set in the two EQU lines below:
0000                             ;    CPM      always 0 (there is no CP/M here; the line exists for build.sh)
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0: no CP/M build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its two pages because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is $0200,X (low) and $0300,X (high). To push:
0000                             ;  DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load TL/TH from
0000                             ;  DSL,X/DSH,X and INX. The code may change A, Y, X (it is the stack index, so
0000                             ;  it must stay consistent on return) and zero page $04-$06 and $08-$0B; it
0000                             ;  must keep IP ($00/$01) and the hardware stack balanced. On return TL/TH are
0000                             ;  the TOS. Zero page $0C-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                R0:       EQU   0Ah   ; remainder
0000                R1:       EQU   0Bh   
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page (above)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL  data stack, low bytes   (X = FC when empty: 252 cells)
0000                             ;    0300       DSH  data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C
0000                             ;               (= z10+), KEYBUF at +34, the -n? line buffer at +80..+FF
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                DSL:      EQU   0200h   
0000                DSH:      EQU   0300h   
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003   A9 00                  LDA   #<PROG   
E005   85 00                  STA   IP   
E007   A9 05                  LDA   #>PROG   
E009   85 01                  STA   IP+1   
E00B   20 65 E1     ST1:      JSR   getc   
E00E   D0 FB                  BNE   st1   ; IP ends just past the NUL
E010   A5 00                  LDA   IP   
E012   8D 7C 04               STA   HEAP   
E015   A5 01                  LDA   IP+1   
E017   8D 7D 04               STA   HEAP+1   
E01A                          IF   CHECKED   
E01A   A9 00                  LDA   #0   
E01C   8D 34 04               STA   KEYBUF   
E01F                          ENDIF      
E01F   A9 00                  LDA   #<PROG   
E021   85 00                  STA   IP   
E023   A9 05                  LDA   #>PROG   
E025   85 01                  STA   IP+1   
E027   A2 FC                  LDX   #DSE   
E029                             ; =============================================================================
E029                             ;  The inner loop
E029                             ; =============================================================================
E029                NEXT:        
E029                          IF   CHECKED   
E029                             ; Both stacks are checked once per character. The data stack has
E029                             ; overrun when X is above DSE (an overflow wraps X to FF, an underflow
E029                             ; moves it up; no handler moves X by more than 2). The return stack
E029                             ; has when S is below RSLIM (an underflow wraps S to 00-03).
E029   E0 FD                  CPX   #DSE+1   
E02B   B0 4F                  BCS   e_stack   
E02D   8A                     TXA      ; TSX trashes X: keep it in A
E02E   BA                     TSX      
E02F   E0 20                  CPX   #RSLIM   
E031   AA                     TAX      ; TAX leaves the carry alone
E032   90 4B                  BCC   e_rstack   
E034                          ENDIF      
E034   20 3A E0               JSR   step   
E037   4C 29 E0               JMP   next   
E03A                             ; step: read one character and sort it by range.
E03A                             ;    00h          end of program
E03A                             ;    01h-20h, 7Fh-FFh   ignored
E03A                             ;    30h-39h      digit: read a whole number
E03A                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E03A                             ;    61h-7Ah      a-z: push the address of that letter's cell
E03A                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E03A   20 65 E1     STEP:     JSR   getc   ; flags follow A
E03D   F0 3A                  BEQ   endprog   
E03F   38                     SEC      
E040   E9 21                  SBC   #21h   ; A = c - 21h
E042   90 34                  BCC   ign   ; 01h-20h
E044   C9 0F                  CMP   #0Fh   
E046   90 26                  BCC   punct   ; 21h-2Fh: index 0-14
E048   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E04A   C9 0A                  CMP   #10   
E04C   90 36                  BCC   digit   
E04E   C9 11                  CMP   #11h   
E050   B0 04                  BCS   ab40   
E052   69 05                  ADC   #5   ; (carry clear) 3Ah-40h: index 15-21
E054   90 18                  BCC   punct   ; always
E056   E9 11        AB40:     SBC   #11h   ; A = c - 41h
E058   C9 1A                  CMP   #1Ah   
E05A   90 72                  BCC   upper   ; 41h-5Ah
E05C   C9 20                  CMP   #20h   
E05E   B0 04                  BCS   ab60   
E060   E9 03                  SBC   #3   ; (carry clear: subtracts 4) 5Bh-60h: 22-27
E062   B0 0A                  BCS   punct   ; always
E064   C9 3A        AB60:     CMP   #3Ah   
E066   90 5A                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E068   C9 3E                  CMP   #3Eh   
E06A   B0 0C                  BCS   ign   ; 7Fh-FFh
E06C   E9 1D                  SBC   #1Dh   ; (carry clear: subtracts 1Eh) 7Bh-7Eh: 28-31
E06E   0A           PUNCT:    ASL      
E06F   A8                     TAY      
E070   B9 21 E1               LDA   PTAB+1,Y   
E073   48                     PHA      
E074   B9 20 E1               LDA   PTAB,Y   
E077   48                     PHA      
E078   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E079                             ; directly, it just ends an ignored character.
E079   4C 09 FF     ENDPROG:   JMP   EXIT   
E07C                          IF   CHECKED   
E07C   A9 53        E_STACK:   LDA   #"S"   ; data stack over or under
E07E   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E07F   A9 52        E_RSTACK:   LDA   #"R"   ; return stack over or under
E081   4C 21 E5               JMP   error   
E084                          ENDIF      
E084                             ; Digits: the first one is in A; read the rest of the number.
E084   A8           DIGIT:    TAY      
E085   20 7D E1               JSR   push   
E088   84 02                  STY   TL   
E08A   A9 00                  LDA   #0   
E08C   85 03                  STA   TH   
E08E   F0 27                  BEQ   rdnum   ; always: A = 0
E090                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E090                             ; test is at the bottom so the loop closes with a branch.
E090   20 68 E1     RD1:      JSR   incip   ; (keeps A = the digit)
E093   06 02                  ASL   TL   
E095   26 03                  ROL   TH   ; x2
E097   18                     CLC      
E098   65 02                  ADC   TL   
E09A   85 04                  STA   T0   
E09C   A5 03                  LDA   TH   
E09E   69 00                  ADC   #0   
E0A0   85 05                  STA   T1   ; T = x2 + digit
E0A2   06 02                  ASL   TL   
E0A4   26 03                  ROL   TH   
E0A6   06 02                  ASL   TL   
E0A8   26 03                  ROL   TH   ; x8
E0AA   18                     CLC      
E0AB   A5 02                  LDA   TL   
E0AD   65 04                  ADC   T0   
E0AF   85 02                  STA   TL   
E0B1   A5 03                  LDA   TH   
E0B3   65 05                  ADC   T1   
E0B5   85 03                  STA   TH   ; x8 + x2 + digit
E0B7   20 60 E1     RDNUM:    JSR   peek   
E0BA   38                     SEC      
E0BB   E9 30                  SBC   #"0"   
E0BD   C9 0A                  CMP   #10   
E0BF   90 CF                  BCC   rd1   
E0C1   60                     RTS      
E0C2                             ; a-z: push the cell's address (the cell is the variable)
E0C2   0A           LOWER:    ASL      
E0C3   A8                     TAY      
E0C4   20 7D E1               JSR   push   
E0C7   84 02                  STY   TL   
E0C9   A9 04                  LDA   #>LET   
E0CB   85 03                  STA   TH   
E0CD   60                     RTS      
E0CE                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E0CE                             ; the return stack, and the IP becomes the address in the letter's cell.
E0CE   0A           UPPER:    ASL      
E0CF   A8                     TAY      
E0D0   68                     PLA      
E0D1   68                     PLA      ; drop the step frame
E0D2   A5 01                  LDA   IP+1   
E0D4   48                     PHA      
E0D5   A5 00                  LDA   IP   
E0D7   48                     PHA      
E0D8   B9 00 04               LDA   LET,Y   
E0DB   85 00                  STA   IP   
E0DD   B9 01 04               LDA   LET+1,Y   
E0E0   85 01                  STA   IP+1   
E0E2   4C 29 E0               JMP   next   
E0E5                             ; skip: read past text to the closer at this level, and return it in A.
E0E5                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0E5                             ; NUL first ends the program.
E0E5   A9 00        SKIP:     LDA   #0   
E0E7   85 06                  STA   T2   ; depth
E0E9   20 65 E1     SK1:      JSR   getc   
E0EC   F0 8B                  BEQ   endprog   
E0EE   C9 22                  CMP   #22h   
E0F0   D0 05                  BNE   sk2   
E0F2   20 D7 E3               JSR   skipstr   
E0F5   F0 F2                  BEQ   sk1   ; skipstr ends with the zero flag set
E0F7   C9 28        SK2:      CMP   #"("   
E0F9   F0 11                  BEQ   sk3   
E0FB   C9 5B                  CMP   #"["   
E0FD   F0 0D                  BEQ   sk3   
E0FF   C9 29                  CMP   #")"   
E101   F0 04                  BEQ   sk4   
E103   C9 5D                  CMP   #"]"   
E105   D0 E2                  BNE   sk1   
E107   C6 06        SK4:      DEC   T2   
E109   10 DE                  BPL   sk1   
E10B   60                     RTS      ; the closer at this level
E10C   E6 06        SK3:      INC   T2   
E10E   D0 D9                  BNE   sk1   
E110                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E110                             ; the matching ")".
E110   20 65 E3     H_OPEN:   JSR   flag   
E113   F0 D0                  BEQ   skip   
E115   68                     PLA      
E116   68                     PLA      
E117   A5 01                  LDA   IP+1   
E119   48                     PHA      
E11A   A5 00                  LDA   IP   
E11C   48                     PHA      
E11D   4C 29 E0               JMP   next   
E120                             ; =============================================================================
E120                             ;  Dispatch table: one handler per punctuation character, in code order.
E120                             ;  Entries are handler-1 for the RTS trick.
E120                             ; =============================================================================
E120   88 E1        PTAB:     DW   h_store-1   ; !
E122   D3 E3                  DW   h_str-1   ; "
E124   17 E4                  DW   h_num-1   ; #
E126   F2 E3                  DW   h_print-1   ; $
E128   39 E2                  DW   h_swap-1   ; %
E12A   D0 E1                  DW   h_and-1   ; &
E12C   0F E4                  DW   h_emit-1   ; '
E12E   0F E1                  DW   h_open-1   ; (
E130   6E E3                  DW   h_close-1   ; )
E132   0A E2                  DW   h_mul-1   ; *
E134   E3 E2                  DW   h_add-1   ; +
E136   2A E3                  DW   h_cfetch-1   ; ,
E138   CE E2                  DW   h_sub-1   ; -
E13A   9B E1                  DW   h_cstore-1   ; .
E13C   4E E2                  DW   h_div-1   ; /
E13E   7C E1                  DW   push-1   ; :
E140   A8 E1                  DW   drop-1   ; ;
E142   F7 E2                  DW   h_lt-1   ; <
E144   0A E3                  DW   h_eq-1   ; =
E146   F4 E2                  DW   h_gt-1   ; >
E148   43 E4                  DW   h_key-1   ; ?
E14A   1C E3                  DW   h_fetch-1   ; @
E14C   A7 E3                  DW   h_def-1   ; [
E14E   85 E3                  DW   h_break-1   ; \
E150   99 E3                  DW   h_ret-1   ; ]
E152   EE E1                  DW   h_xor-1   ; ^
E154   33 E3                  DW   h_alloc-1   ; _
E156   A4 E4                  DW   h_grave-1   ; `
E158   B4 E1                  DW   h_tor-1   ; {
E15A   DF E1                  DW   h_or-1   ; |
E15C   C2 E1                  DW   h_fromr-1   ; }
E15E   FD E1                  DW   h_not-1   ; ~
E160                             ; =============================================================================
E160                             ;  Reading the program
E160                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E160                             ;    getc: the same, then IP moves on; flags follow A
E160                             ;    incip: IP moves on; keeps A, the carry and Y
E160                             ; =============================================================================
E160   A0 00        PEEK:     LDY   #0   
E162   B1 00                  LDA   (IP),Y   
E164   60                     RTS      
E165   20 60 E1     GETC:     JSR   peek   
E168   E6 00        INCIP:    INC   IP   
E16A   D0 02                  BNE   ic1   
E16C   E6 01                  INC   IP+1   
E16E   09 00        IC1:      ORA   #0   
E170   60                     RTS      
E171                             ; =============================================================================
E171                             ;  Stack
E171                             ; =============================================================================
E171   20 7D E1     PUSHIP:   JSR   push   ; push the reading position
E174   A5 00                  LDA   IP   
E176   85 02                  STA   TL   
E178   A5 01                  LDA   IP+1   
E17A   85 03                  STA   TH   
E17C   60                     RTS      
E17D   CA           PUSH:     DEX      ; ":" and every push
E17E   A5 02                  LDA   TL   
E180   9D 00 02               STA   DSL,X   
E183   A5 03                  LDA   TH   
E185   9D 00 03               STA   DSH,X   
E188   60                     RTS      
E189                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E189                H_STORE:      
E189                          IF   CHECKED   
E189   A5 02                  LDA   TL   ; both bytes must be in the program's space:
E18B   18                     CLC      ; check the page of addr+1
E18C   69 01                  ADC   #1   
E18E   A5 03                  LDA   TH   
E190   69 00                  ADC   #0   
E192   20 57 E3               JSR   chkst   
E195                          ENDIF      
E195   BD 00 03               LDA   DSH,X   
E198   A0 01                  LDY   #1   
E19A   91 02                  STA   (TL),Y   
E19C                H_CSTORE:      ; "." ( c addr -- )
E19C                          IF   CHECKED   
E19C   A5 03                  LDA   TH   
E19E   20 57 E3               JSR   chkst   
E1A1                          ENDIF      
E1A1   BD 00 02               LDA   DSL,X   
E1A4   A0 00                  LDY   #0   
E1A6   91 02                  STA   (TL),Y   
E1A8   E8                     INX      ; falls into drop
E1A9   BD 00 02     DROP:     LDA   DSL,X   ; ";" and every drop
E1AC   85 02                  STA   TL   
E1AE   BD 00 03               LDA   DSH,X   
E1B1   85 03                  STA   TH   
E1B3   E8                     INX      
E1B4   60                     RTS      
E1B5                             ; "{" TOS to the return stack, "}" return stack to TOS
E1B5   68           H_TOR:    PLA      
E1B6   68                     PLA      
E1B7   A5 03                  LDA   TH   
E1B9   48                     PHA      
E1BA   A5 02                  LDA   TL   
E1BC   48                     PHA      
E1BD   20 A9 E1               JSR   drop   
E1C0   4C 29 E0               JMP   next   
E1C3   68           H_FROMR:   PLA      
E1C4   68                     PLA      
E1C5   20 7D E1               JSR   push   
E1C8   68                     PLA      
E1C9   85 02                  STA   TL   
E1CB   68                     PLA      
E1CC   85 03                  STA   TH   
E1CE   4C 29 E0               JMP   next   
E1D1                             ; =============================================================================
E1D1                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E1D1                             ; =============================================================================
E1D1   BD 00 02     H_AND:    LDA   DSL,X   
E1D4   25 02                  AND   TL   
E1D6   85 02                  STA   TL   
E1D8   BD 00 03               LDA   DSH,X   
E1DB   25 03                  AND   TH   
E1DD   4C F1 E2               JMP   fin   
E1E0   BD 00 02     H_OR:     LDA   DSL,X   
E1E3   05 02                  ORA   TL   
E1E5   85 02                  STA   TL   
E1E7   BD 00 03               LDA   DSH,X   
E1EA   05 03                  ORA   TH   
E1EC   4C F1 E2               JMP   fin   
E1EF   BD 00 02     H_XOR:    LDA   DSL,X   
E1F2   45 02                  EOR   TL   
E1F4   85 02                  STA   TL   
E1F6   BD 00 03               LDA   DSH,X   
E1F9   45 03                  EOR   TH   
E1FB   4C F1 E2               JMP   fin   
E1FE   A5 02        H_NOT:    LDA   TL   
E200   49 FF                  EOR   #0FFh   
E202   85 02                  STA   TL   
E204   A5 03                  LDA   TH   
E206   49 FF                  EOR   #0FFh   
E208   85 03                  STA   TH   
E20A   60                     RTS      
E20B                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept.
E20B   A9 00        H_MUL:    LDA   #0   
E20D   85 04                  STA   T0   
E20F   85 05                  STA   T1   ; product
E211   A0 10                  LDY   #16   
E213   46 03        ML1:      LSR   TH   
E215   66 02                  ROR   TL   ; next multiplier bit
E217   90 0F                  BCC   ml2   
E219   18                     CLC      
E21A   A5 04                  LDA   T0   
E21C   7D 00 02               ADC   DSL,X   
E21F   85 04                  STA   T0   
E221   A5 05                  LDA   T1   
E223   7D 00 03               ADC   DSH,X   
E226   85 05                  STA   T1   
E228   1E 00 02     ML2:      ASL   DSL,X   
E22B   3E 00 03               ROL   DSH,X   ; multiplicand * 2
E22E   88                     DEY      
E22F   D0 E2                  BNE   ml1   
E231   A5 04                  LDA   T0   
E233   85 02                  STA   TL   
E235   A5 05                  LDA   T1   
E237   4C F1 E2               JMP   fin   
E23A   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E23D   A5 02                  LDA   TL   
E23F   9D 00 02               STA   DSL,X   
E242   84 02                  STY   TL   
E244   BC 00 03               LDY   DSH,X   
E247   A5 03                  LDA   TH   
E249   9D 00 03               STA   DSH,X   
E24C   84 03                  STY   TH   
E24E   60                     RTS      
E24F                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
E24F                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E24F                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
E24F   BD 00 03     H_DIV:    LDA   DSH,X   
E252   48                     PHA      ; r's sign
