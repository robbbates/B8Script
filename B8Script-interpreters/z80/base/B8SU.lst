035C                          DS   1-CPM,3Eh   ; "2"
035C                          DS   1-CPM,32h   
035C                          DS   1-CPM,0EFh   
035C   CD                     DS   CPM,0CDh   
035D   85                     DS   CPM,APTK&0FFh   
035E   05                     DS   CPM,APTK/256   
035F   32                     DS   CPM,32h   
0360                          ;*Macro unroll:  PUTK    35h             ; '5'
0360                          DS   1-CPM,3Eh   ; "5"
0360                          DS   1-CPM,35h   
0360                          DS   1-CPM,0EFh   
0360   CD                     DS   CPM,0CDh   
0361   85                     DS   CPM,APTK&0FFh   
0362   05                     DS   CPM,APTK/256   
0363   35                     DS   CPM,35h   
0364   7B                     LD   A,E   
0365                          ;*Macro unroll:  PUTAR
0365                          DS   1-CPM,0EFh   
0365                          DS   1-CPM,0C9h   
0365   C3                     DS   CPM,0C3h   
0366   89                     DS   CPM,APUT&0FFh   
0367   05                     DS   CPM,APUT/256   
0368                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0368   3D           PCON:     DEC   A   
0369   28 E7                  JR   Z,pshow   ; /|
036B   3E 4B                  LD   A,"K"   
036D   F2 77 03               JP   P,csia   ; /}  ESC [ K
0370   3E 48                  LD   A,"H"   ; /{  ESC [ H ESC [ J
0372   CD 77 03               CALL   csia   
0375   3E 4A                  LD   A,"J"   ; (on into csia)
0377                             ; csia: ESC [ and then A. csi: ESC [, keeping A.
0377   CD 7D 03     CSIA:     CALL   csi   
037A                          ;*Macro unroll:  PUTAR
037A                          DS   1-CPM,0EFh   
037A                          DS   1-CPM,0C9h   
037A   C3                     DS   CPM,0C3h   
037B   89                     DS   CPM,APUT&0FFh   
037C   05                     DS   CPM,APUT/256   
037D   F5           CSI:      PUSH   AF   
037E                          ;*Macro unroll:  PUTK    1Bh             ; ESC
037E                          DS   1-CPM,3Eh   ; ESC
037E                          DS   1-CPM,1Bh   
037E                          DS   1-CPM,0EFh   
037E   CD                     DS   CPM,0CDh   
037F   85                     DS   CPM,APTK&0FFh   
0380   05                     DS   CPM,APTK/256   
0381   1B                     DS   CPM,1Bh   
0382                          ;*Macro unroll:  PUTK    5Bh             ; '['
0382                          DS   1-CPM,3Eh   ; "["
0382                          DS   1-CPM,5Bh   
0382                          DS   1-CPM,0EFh   
0382   CD                     DS   CPM,0CDh   
0383   85                     DS   CPM,APTK&0FFh   
0384   05                     DS   CPM,APTK/256   
0385   5B                     DS   CPM,5Bh   
0386   F1                     POP   AF   
0387   C9                     RET      
0388                          ENDIF      
0388                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0388                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0388                             ; the quotient bits arrive at the bottom of C.
0388                             ; Dividing by 2 is one shift (the spec wants that fast).
0388                          IF   1-QK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
0388                          ENDIF      
0388                          IF   QK   
0388                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0388                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0388   7A           UDIV:     LD   A,D   
0389   B7                     OR   A   
038A   20 1A                  JR   NZ,uq1   ; 256 and up
038C   B3                     OR   E   
038D   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
038F   3D                     DEC   A   
0390   A3                     AND   E   
0391   20 2F                  JR   NZ,udv0   ; not a power of two
0393   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
0394   3D                     DEC   A   ;   r = L & (2^k - 1)
0395   A5                     AND   L   
0396   F5                     PUSH   AF   
0397   CB 3B        UQ2:      SRL   E   
0399   38 06                  JR   C,uq3   
039B   CB 3C                  SRL   H   
039D   CB 1D                  RR   L   
039F   18 F6                  JR   uq2   
03A1   F1           UQ3:      POP   AF   
03A2   5F                     LD   E,A   
03A3   16 00                  LD   D,0   
03A5   C9                     RET      
03A6   7B           UQ1:      LD   A,E   
03A7   B7                     OR   A   
03A8   20 18                  JR   NZ,udv0   
03AA   7A                     LD   A,D   
03AB   3D                     DEC   A   
03AC   A2                     AND   D   
03AD   20 13                  JR   NZ,udv0   ; not a power of two
03AF   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
03B0   3D                     DEC   A   ;   r = HL & (2^k - 1)
03B1   A4                     AND   H   
03B2   5F                     LD   E,A   ; (the remainder's high byte,
03B3   7D                     LD   A,L   ;   and its low byte)
03B4   6C                     LD   L,H   
03B5   26 00                  LD   H,0   
03B7   CB 3A        UQ4:      SRL   D   
03B9   38 04                  JR   C,uq5   
03BB   CB 3D                  SRL   L   
03BD   18 F8                  JR   uq4   
03BF   53           UQ5:      LD   D,E   
03C0   5F                     LD   E,A   
03C1   C9                     RET      
03C2                          ENDIF      
03C2                          IF   1-FAST   
03C2   C5           UDV0:     PUSH   BC   
03C3   7C                     LD   A,H   
03C4   4D                     LD   C,L   
03C5   21 00 00               LD   HL,0   
03C8   06 10                  LD   B,16   
03CA   CB 21        UDV1:     SLA   C   
03CC   17                     RLA      
03CD   ED 6A                  ADC   HL,HL   
03CF   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03D1   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03D3   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03D4   0D                     DEC   C   ;   INC below
03D5   0C           UDV2:     INC   C   ; a quotient bit
03D6   10 F2                  DJNZ   udv1   
03D8   EB                     EX   DE,HL   ; DE = remainder
03D9   67                     LD   H,A   
03DA   69                     LD   L,C   ; HL = quotient
03DB   C1                     POP   BC   
03DC   C9                     RET      
03DD                          ENDIF      
03DD                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
03DD                          ENDIF      
03DD                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
03DD                             ; non-digit. Values wrap at 16 bits, as the spec says.
03DD   21 00 00     RDNUM:    LD   HL,0   
03E0   0A           RDN1:     LD   A,(BC)   
03E1   D6 30                  SUB   "0"   
03E3   FE 0A                  CP   10   
03E5   D0                     RET   NC   
03E6   03                     INC   BC   
03E7   54                     LD   D,H   
03E8   5D                     LD   E,L   
03E9   29                     ADD   HL,HL   
03EA   29                     ADD   HL,HL   
03EB   19                     ADD   HL,DE   
03EC   29                     ADD   HL,HL   ; HL * 10
03ED   5F                     LD   E,A   
03EE   16 00                  LD   D,0   
03F0   19                     ADD   HL,DE   
03F1   18 ED                  JR   rdn1   
03F3                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03F3                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03F3                          IF   1-CHECKED   
03F3   03           SS0:      INC   BC   
03F4   0A           SKIPSTR:   LD   A,(BC)   
03F5   03                     INC   BC   
03F6   FE 2F                  CP   "/"   
03F8   28 F9                  JR   Z,ss0   
03FA   FE 22                  CP   22h   
03FC   20 F6                  JR   NZ,skipstr   
03FE   C9                     RET      
03FF                          ENDIF      
03FF                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
03FF                          ENDIF      
03FF                             ; skip: read past text to the closer at this level, and return A = 0 if it
03FF                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03FF                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03FF                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03FF                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03FF                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
03FF                             ; 
03FF                             ; The checked build also looks at the character the skip was started by,
03FF                             ; which is always the one just before where it starts: "(" must end at ")",
03FF                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03FF                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
03FF                             ; place where the skip started, for the report.
03FF                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
03FF                          ENDIF      
03FF                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
03FF                          ENDIF      
03FF                          IF   1-QK   
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
03FF                          ENDIF      
03FF                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
03FF                          ENDIF      
03FF                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
03FF                          ENDIF      
03FF                          IF   1-QK   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
03FF                          ENDIF      
03FF                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
03FF                          ENDIF      
03FF                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
03FF                          ENDIF      
03FF                          IF   QK   
03FF                             ; The skip cache. Nearly every skip is one that has happened before (a loop
03FF                             ; skips the same false block on every pass), so the first scan from each
03FF                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
03FF                             ; start's low byte. Only skips that start in the program text are kept (the
03FF                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
03FF                             ; A program that changes its own text while it runs is not looked after.
03FF   ED 43 3C 09  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
0403   78                     LD   A,B   ;   checked report's place)
0404   FE 0A                  CP   PROG/256   
0406   38 1B                  JR   C,sks   ; below the program text: no cache
0408   79                     LD   A,C   
0409   87                     ADD   A,A   
040A   87                     ADD   A,A   
040B   5F                     LD   E,A   
040C   16 06                  LD   D,CPAGE   ; DE -> the entry
040E   1A                     LD   A,(DE)   
040F   B9                     CP   C   
0410   20 11                  JR   NZ,sks   
0412   1C                     INC   E   
0413   1A                     LD   A,(DE)   
0414   B8                     CP   B   
0415   20 0C                  JR   NZ,sks   
0417   1C                     INC   E   
0418   1A                     LD   A,(DE)   
0419   4F                     LD   C,A   
041A   1C                     INC   E   
041B   1A                     LD   A,(DE)   
041C   47                     LD   B,A   ; a hit: the IP is past the closer
041D   0B                     DEC   BC   
041E   0A                     LD   A,(BC)   
041F   03                     INC   BC   
0420   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
0422   C9                     RET      
0423                SKS:         
0423                          ENDIF      
0423                          IF   QK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0423                          ENDIF      
0423                          IF   QK   
0423                             ; The scan. Most characters are nothing to it, and two range tests rule
0423                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
0423   16 00                  LD   D,0   
0425   14           SQ3:      INC   D   ; an opener: one deeper
0426   0A           SQ1:      LD   A,(BC)   
0427   03                     INC   BC   
0428   FE 5E                  CP   5Eh   
042A   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
042C   FE 5B                  CP   5Bh   
042E   30 19                  JR   NC,sqb   ; [ \ ]
0430   FE 2A                  CP   2Ah   
0432   30 F2                  JR   NC,sq1   ; * to Z: nothing
0434   FE 28                  CP   28h   
0436   28 ED                  JR   Z,sq3   ; (
0438   30 19                  JR   NC,sqc   ; )
043A   FE 22                  CP   22h   
043C   28 06                  JR   Z,sqq   ; a string
043E   B7                     OR   A   
043F   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
0441                          ENDIF      
0441                          IF   QK*(1-CHECKED)   
0441   C3 00 00               JP   SKEND   ; NUL: the end of the program
0444                          ENDIF      
0444                          IF   QK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0444                          ENDIF      
0444                          IF   QK   
0444   CD F4 03     SQQ:      CALL   skipstr   ; step over the string
0447   18 DD                  JR   sq1   
0449   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
044B   28 D9                  JR   Z,sq1   ; "\" is nothing here
044D   38 D6                  JR   C,sq3   ; [
044F   3E 02                  LD   A,2   ; ]
0451   18 01                  JR   sq4   
0453   AF           SQC:      XOR   A   ; )
0454   15           SQ4:      DEC   D   
0455   20 CF                  JR   NZ,sq1   
0457                          ENDIF      
0457                          IF   QK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
0457                          ENDIF      
0457                          IF   QK   
0457                             ; The closer at this level: remember the skip (if it started in the program
0457                             ; text), and return A = 0 for ")" or 2 for "]".
0457   F5                     PUSH   AF   
0458   E5                     PUSH   HL   
0459   2A 3C 09               LD   HL,(SKPL)   
045C   7C                     LD   A,H   
045D   FE 0A                  CP   PROG/256   
045F   38 11                  JR   C,sq9   
0461   7D                     LD   A,L   
0462   87                     ADD   A,A   
0463   87                     ADD   A,A   
0464   5F                     LD   E,A   
0465   16 06                  LD   D,CPAGE   
0467   7D                     LD   A,L   
0468   12                     LD   (DE),A   
0469   1C                     INC   E   
046A   7C                     LD   A,H   
046B   12                     LD   (DE),A   
046C   1C                     INC   E   
046D   79                     LD   A,C   
046E   12                     LD   (DE),A   
046F   1C                     INC   E   
0470   78                     LD   A,B   
0471   12                     LD   (DE),A   
0472   E1           SQ9:      POP   HL   
0473   F1                     POP   AF   
0474   C9                     RET      
0475                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
0475   E5           SKCLR:    PUSH   HL   
0476   21 00 06               LD   HL,CPAGE*256   
0479   36 00        SKC1:     LD   (HL),0   
047B   2C                     INC   L   
047C   20 FB                  JR   NZ,skc1   
047E   E1                     POP   HL   
047F   C9                     RET      
0480                          ENDIF      
0480                             ;  ---- Speed-ups (base builds) -------------------------------------------
0480                             ;  The skip cache is above. These are the handlers' tails that the builds with
0480                             ;  room take, kept here, out of the handlers' first two pages.
0480                          IF   QK   
0480                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
0480                             ; multiplier (most multiplications have one, a count or a small constant).
0480   7C           MULQ:     LD   A,H   
0481   B7                     OR   A   
0482   28 05                  JR   Z,mq8   ; the multiplier is below 256
0484   7A                     LD   A,D   
0485   B7                     OR   A   
0486   20 12                  JR   NZ,mq16   
0488   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
0489                          ENDIF      
0489                          IF   QK*(1-FAST)   
0489   7D           MQ8:      LD   A,L   
048A   21 00 00               LD   HL,0   
048D   C5                     PUSH   BC   
048E   06 08                  LD   B,8   
0490   29           MQ1:      ADD   HL,HL   
0491   17                     RLA      
0492   30 01                  JR   NC,mq2   
0494   19                     ADD   HL,DE   
0495   10 F9        MQ2:      DJNZ   mq1   
0497   C1                     POP   BC   
0498                          ;*Macro unroll:  NEXT
0498                          DS   (1-CPM)*(1-FAST),0F7h   
0498   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0499   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
049A   C5           MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
049B   7C                     LD   A,H   
049C   4D                     LD   C,L   
049D   21 00 00               LD   HL,0   
04A0   06 10                  LD   B,16   
04A2   29           MQ3:      ADD   HL,HL   
04A3   CB 21                  SLA   C   
04A5   17                     RLA      
04A6   30 01                  JR   NC,mq4   
04A8   19                     ADD   HL,DE   
04A9   10 F7        MQ4:      DJNZ   mq3   
04AB   C1                     POP   BC   
04AC                          ;*Macro unroll:  NEXT
04AC                          DS   (1-CPM)*(1-FAST),0F7h   
04AC   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04AD   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04AE                          ENDIF      
04AE                          IF   FAST   
                                 ; (the fast build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
04AE                          ENDIF      
04AE                          IF   QK   
04AE                             ; A true ")" reads the block start where it is, on top of the return stack,
04AE                             ; instead of popping it and pushing it back; the break key is looked at as
04AE                             ; rpushn would.
04AE   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
04B1   FD 46 01               LD   B,(IY+1)   
04B4   E5                     PUSH   HL   
04B5   21 36 09               LD   HL,PCNT   
04B8   35                     DEC   (HL)   
04B9   E1                     POP   HL   
04BA   CC 31 05               CALL   Z,pollk   
04BD                          ;*Macro unroll:  NEXT
04BD                          DS   (1-CPM)*(1-FAST),0F7h   
04BD   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04BE   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04BF                          ENDIF      
04BF                          IF   SBASEU   
04BF                             ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
04BF                             ; or stored in the same step (x@ is the commonest pair in most programs).
04BF                             ; (A checked build checks the stacks between the two, so it keeps them apart.)
04BF   87           LOWQ:     ADD   A,A   
04C0   5F                     LD   E,A   
04C1   16 09                  LD   D,LETPAGE   ; DE -> the cell
04C3   0A                     LD   A,(BC)   
04C4   FE 40                  CP   "@"   
04C6   28 08                  JR   Z,lwf   
04C8   FE 21                  CP   "!"   
04CA   28 0D                  JR   Z,lws   
04CC   E5                     PUSH   HL   
04CD   EB                     EX   DE,HL   ; TOS = the cell's address
04CE                          ;*Macro unroll:  NEXT
04CE                          DS   (1-CPM)*(1-FAST),0F7h   
04CE   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04CF   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04D0   03           LWF:      INC   BC   ; x@: TOS = the cell's value
04D1   E5                     PUSH   HL   
04D2   EB                     EX   DE,HL   
04D3   5E                     LD   E,(HL)   
04D4   2C                     INC   L   
04D5   56                     LD   D,(HL)   
04D6   EB                     EX   DE,HL   
04D7                          ;*Macro unroll:  NEXT
04D7                          DS   (1-CPM)*(1-FAST),0F7h   
04D7   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04D8   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04D9   03           LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
04DA   EB                     EX   DE,HL   
04DB   73                     LD   (HL),E   
04DC   2C                     INC   L   
04DD   72                     LD   (HL),D   
04DE   E1                     POP   HL   
04DF                          ;*Macro unroll:  NEXT
04DF                          DS   (1-CPM)*(1-FAST),0F7h   
04DF   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04E0   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04E1                          ENDIF      
04E1                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
04E1                          ENDIF      
04E1                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
04E1                          ENDIF      
04E1                             ; =============================================================================
04E1                             ;  Dispatch table: the low byte of each handler's address, in code order
04E1                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
04E1                             ;  It must not cross a page (the dispatcher only adds to its low byte).
04E1                             ; =============================================================================
04E1                             ; The handlers of the first NPG1 characters start in the image's second page.
04E1                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
04E1                             ; differs between the builds, so the count is worked out here.
04E1                             ; (One division to a line: asm80 only rounds down when it stores a value.)
04E1                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
04E1                PGBRK:    EQU   (h_break-BASE)/256   
04E1                PGDEF:    EQU   (h_def-BASE)/256   
04E1                PGFET:    EQU   (h_fetch-BASE)/256   
04E1                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
04E1                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
04E1                          ENDIF      
04E1                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
04E1                             ; and return its value in A with the carry set; otherwise leave the IP and
04E1                             ; return with the carry clear.
04E1   0A           HEXC:     LD   A,(BC)   
04E2   D6 30                  SUB   "0"   
04E4   FE 0A                  CP   10   
04E6   38 09                  JR   C,hc1   
04E8   E6 DF                  AND   0DFh   
04EA   D6 11                  SUB   11h   
04EC   FE 06                  CP   6   
04EE   D0                     RET   NC   
04EF   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
04F1   03           HC1:      INC   BC   
04F2   C9                     RET      
04F3                             ; psgn: print HL as a signed number. Keeps BC.
04F3   CB 7C        PSGN:     BIT   7,H   
04F5   28 07                  JR   Z,pdec   
04F7                          ;*Macro unroll:  PUTK    2Dh             ; '-'
04F7                          DS   1-CPM,3Eh   ; "-"
04F7                          DS   1-CPM,2Dh   
04F7                          DS   1-CPM,0EFh   
04F7   CD                     DS   CPM,0CDh   
04F8   85                     DS   CPM,APTK&0FFh   
04F9   05                     DS   CPM,APTK/256   
04FA   2D                     DS   CPM,2Dh   
04FB                          ;*Macro unroll:  NEGH
04FB                          DS   1-CPM,0E7h   
04FB   CD                     DS   CPM,0CDh   
04FC   7A                     DS   CPM,ANEG&0FFh   
04FD   05                     DS   CPM,ANEG/256   
04FE                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
04FE                             ; Keeps BC.
04FE   11 0A 00     PDEC:     LD   DE,10   
0501   CD 88 03               CALL   udiv   ; HL = HL / 10, E = the last digit
0504   7B                     LD   A,E   
0505   F5                     PUSH   AF   
0506   7C                     LD   A,H   
0507   B5                     OR   L   
0508   C4 FE 04               CALL   NZ,pdec   
050B   F1                     POP   AF   
050C   C6 30                  ADD   A,"0"   
050E                          ;*Macro unroll:  PUTAR
050E                          DS   1-CPM,0EFh   
050E                          DS   1-CPM,0C9h   
050E   C3                     DS   CPM,0C3h   
050F   89                     DS   CPM,APUT&0FFh   
0510   05                     DS   CPM,APUT/256   
0511                             ; (The table goes here instead in the builds where, before psgn, it would
0511                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0511                             ; page: PTPAD is 0 unless it must.)
0511                          IF   (1-TABP0)*PTLATE   
0511                PTPH:     EQU   $ & 0FFh   
0511                PTPX:     EQU   (PTPH + 31) / 256   
0511                PTPAD:    EQU   PTPX * (256 - PTPH)   
0511                          DS   PTPAD   
0511                PTAB:        
0511                          ;*Macro unroll:  PTABLE
0511   91                     DB   h_store & 0FFh   
0512   98                     DB   h_str & 0FFh   
0513   C2                     DB   h_num & 0FFh   
0514   A0                     DB   h_print & 0FFh   
0515   89                     DB   h_swap & 0FFh   
0516   3F                     DB   h_and & 0FFh   
0517   BB                     DB   h_emit & 0FFh   
0518   18                     DB   h_open & 0FFh   
0519   20                     DB   h_close & 0FFh   
051A   62                     DB   h_mul & 0FFh   
051B   32                     DB   h_add & 0FFh   
051C   E0                     DB   h_cfetch & 0FFh   
051D   28                     DB   h_sub & 0FFh   
051E   8C                     DB   h_cstore & 0FFh   
051F   66                     DB   h_div & 0FFh   
0520   86                     DB   h_dup & 0FFh   
0521   8E                     DB   h_drop & 0FFh   
0522   48                     DB   h_lt & 0FFh   
0523   58                     DB   h_eq & 0FFh   
0524   49                     DB   h_gt & 0FFh   
0525   C8                     DB   h_key & 0FFh   
0526   12                     DB   h_fetch & 0FFh   
0527   F4                     DB   h_def & 0FFh   
0528   E4                     DB   h_break & 0FFh   
0529   DD                     DB   h_ret & 0FFh   
052A   63                     DB   h_xor & 0FFh   
052B   7B                     DB   h_alloc & 0FFh   
052C   C6                     DB   h_grave & 0FFh   
052D   C2                     DB   h_tor & 0FFh   
052E   6C                     DB   h_or & 0FFh   
052F   06                     DB   h_fromr & 0FFh   
0530   75                     DB   h_not & 0FFh   
0531                PTABEND:      
0531                          ENDIF      
0531                             ; =============================================================================
0531                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0531                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0531                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0531                             ;  they are the host's KEY and CONOUT routines themselves.
0531                             ; 
0531                             ;  A running program reads the keyboard only through getk and pollk, which
0531                             ;  between them give the break key its rules:
0531                             ;    - Ctrl-C stops the program;
0531                             ;    - any other key that the break check reads is held in KEYBUF for the
0531                             ;      next "?", and a newer one takes its place;
0531                             ;    - "?" (getk) takes the held key first;
0531                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0531                             ;      key like any other, but two of them within about 250 ms still stop it.
0531                             ;  Both are called straight from a handler, never from a routine under one:
0531                             ;  the checked build's report counts on finding one return address above the
0531                             ;  data stack.
0531                             ; =============================================================================
0531                          IFN   CPM   
                    RAWK:     EQU   KEY   
0531                          ENDIF      
0531                             ; pollk: the break check (see rpushn).
0531   CD 81 05     POLLK:    CALL   rawk   
0534   C8                     RET   Z   ; no key
0535   32 7A 09               LD   (KEYBUF),A   ; held for the next "?"
0538   FE 03        PK1:      CP   3   ; (getk joins here)
053A   C0                     RET   NZ   
053B                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
053B                             ; the program has turned it off, wait about 250 ms for one more key: a
053B                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
053B                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
053B   3A 7B 09     CTLC:     LD   A,(BRKOFF)   
053E   B7                     OR   A   
053F   CA 11 01     CT0:      JP   Z,brk   
0542   D5                     PUSH   DE   
0543   11 E8 03               LD   DE,250*MSLOOP   
0546   CD 81 05     CT1:      CALL   rawk   
0549   20 05                  JR   NZ,ct2   
054B   1B                     DEC   DE   
054C   7A                     LD   A,D   
054D   B3                     OR   E   
054E   20 F6                  JR   NZ,ct1   
0550   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0551   FE 03                  CP   3   
0553   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0555   B7                     OR   A   
0556   28 03                  JR   Z,ct3   
0558   32 7A 09               LD   (KEYBUF),A   
055B   3E 03        CT3:      LD   A,3   
055D   B7                     OR   A   
055E   C9                     RET      
055F                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
055F   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0560   21 7A 09               LD   HL,KEYBUF   ;   the buffer
0563   7E                     LD   A,(HL)   
0564   36 00                  LD   (HL),0   
0566   E1                     POP   HL   
0567   B7                     OR   A   
0568   C0                     RET   NZ   
0569   CD 81 05               CALL   rawk   
056C   C8                     RET   Z   
056D   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
056F                          IF   (1-CHECKED)*(1-EDITOR)   
056F                BRK:      EQU   endprog   ; the unchecked build stops without a word
056F                          ENDIF      ;   (with the editor, both stacks are cleared);
056F                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
056F                          ENDIF      
056F                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
056F                          ENDIF      
056F                          IF   CPM   
056F                             ; The routines a generic build keeps in page zero (see there). Here they are
056F                             ; out of the way of the handlers, which must fit in the image's first two
056F                             ; pages.
056F   FD 5E 00     RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
0572   FD 56 01               LD   D,(IY+1)   
0575   FD 23                  INC   IY   
0577   FD 23                  INC   IY   
0579   C9                     RET      
057A   AF           NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
057B   95                     SUB   L   
057C   6F                     LD   L,A   
057D   9F                     SBC   A,A   
057E   94                     SUB   H   
057F   67                     LD   H,A   
0580   C9                     RET      
0581                          ENDIF      
0581                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0581                          ENDIF      
0581                          IF   CPM   
0581   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0583   18 04                  JR   putc   
0585   E3           PUTK:     EX   (SP),HL   ; print the byte after the CALL
0586   7E                     LD   A,(HL)   
0587   23                     INC   HL   
0588   E3                     EX   (SP),HL   
0589                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0589                             ; printing and could swallow a key that BDOS 6 then never sees.
0589                             ; It keeps every register but A and the flags: BDOS may change any of them
0589                             ; (IX and IY too, in a Z80 BDOS or BIOS).
0589   C5           PUTC:     PUSH   BC   
058A   D5                     PUSH   DE   
058B   E5                     PUSH   HL   
058C   DD E5                  PUSH   IX   
058E   FD E5                  PUSH   IY   
0590   5F                     LD   E,A   
0591   0E 06                  LD   C,6   
0593   CD 05 00               CALL   BDOS   
0596   FD E1                  POP   IY   
0598   DD E1                  POP   IX   
059A   E1                     POP   HL   
059B   D1                     POP   DE   
059C   C1                     POP   BC   
059D   B7                     OR   A   ; (for getk)
059E   C9                     RET      
059F                          ENDIF      
059F                             ; =============================================================================
059F                             ;  Checked build: the checks and the error report
059F                             ; =============================================================================
059F                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              PUSH   IY   ; the return stack: in its page (or it has
                              POP   DE   ;   overflowed), and not above its empty
                              LD   A,D   ;   position (an underflow stays inside the
                              CP   RSPAGE   ;   page, in the guard band)
                              LD   A,E   
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              LD   IY,RSTOP   ; return stack underflow: it counts as empty
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
059F                          ENDIF      
059F                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
059F                          ENDIF      
059F                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
059F                          ENDIF      
059F                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
059F                          ENDIF      
059F                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
059F                          ENDIF      
059F                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
059F                          ENDIF      
059F                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              ;*Macro unroll:  PUTK    2Ch             ; ','
                              DS   1-CPM,3Eh   ; ","
                              DS   1-CPM,2Ch   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,2Ch   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
                                 ;                       R:n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "D:",22h   
                              LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
                              SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
                                 ;   and holds nothing; pnl left the carry clear)
                              CALL   phalf   ; the depth
                              ;*Macro unroll:  PUTK    3Ah             ; ':'
                              DS   1-CPM,3Eh   ; ":"
                              DS   1-CPM,3Ah   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Ah   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              ;*Macro unroll:  PUTK    20h             ; ' '
                              DS   1-CPM,3Eh   ; " "
                              DS   1-CPM,20h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,20h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
                              POP   HL   ;   at most one entry below its page), so
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough
                              SUB   L   
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
059F                          ENDIF      
059F                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
059F                          ENDIF      
059F                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
059F                          ENDIF      
059F                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
059F                          ENDIF      
059F                             ; =============================================================================
059F                             ;  The line editor (EDITOR = 1)
059F                             ; 
059F                             ;  The interpreter starts here, and a program that ends comes back here.
059F                             ;  There is no prompt. It follows the spec's suggested standard for a line
059F                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
059F                             ; 
059F                             ;    n text    put the text in as line n; the lines from n on move down. A
059F                             ;              number past the end (or 0) adds the line at the end.
059F                             ;    n         take line n out
059F                             ;    anything else is run at once, as B8Script. (Start such a line with a
059F                             ;    space if it would begin with a digit.)
059F                             ; 
059F                             ;  A command key ends the line too, and takes what was typed as its argument:
059F                             ; 
059F                             ;    ^G        run the program
059F                             ;    n ^L      list from line n (no number: all of it). Any key holds the
059F                             ;              list until another key is pressed; Ctrl-C ends it.
059F                             ;    n ^E      put line n in the input line; Return puts it back, changed
059F                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
059F                             ;              last time). Generic: what is typed, or pasted, from now until
059F                             ;              ^Z replaces the program; it is not echoed.
059F                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
059F                             ;              time). Generic: the text is printed, as it is.
059F                             ;    ^N        new: no program
059F                             ;    ^X        leave (to LEAVE)
059F                             ; 
059F                             ;  In the line: the left and right arrow keys move the cursor;
059F                             ;  a character goes in at the cursor; Backspace and DEL take out the one
059F                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
059F                             ;  sent to the terminal, so any terminal will do.
059F                             ; 
059F                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
059F                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
059F                             ;  125 characters; the one character after a line number separates it from
059F                             ;  the text and is not stored. The text is kept as it is typed, each line
059F                             ;  ending in CR LF, at PROG.
059F                             ; 
059F                             ;  What lasts from one line to the next: the program, the words, the
059F                             ;  variables and the data stack. An error or a break clears both stacks. The
059F                             ;  return stack starts empty for every line.
059F                             ; 
059F                             ;  Things to know:
059F                             ;    - Reset empties the program (generic builds).
059F                             ;    - A word's address points into the program, so run the program again
059F                             ;      after editing it.
059F                             ;    - Nothing is printed between a program's output and what is typed next.
059F                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
059F                             ;      a line that calls -n? and carries on afterwards runs what was typed.
059F                             ;      (The stored program never comes back to the line, so it may.)
059F                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
059F                             ;      read of the other builds.
059F                             ; 
059F                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
059F                             ;  the last line left there, with TOS pushed like the rest.
059F                             ; =============================================================================
059F                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
059F                          ENDIF      
059F                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
059F                          ENDIF      
059F                          IF   EDGEN   
                              JR   edit0   
059F                          ENDIF      
059F                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
059F                          ENDIF      
059F                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
059F                          ENDIF      
059F                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
059F                          ENDIF      
059F                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
059F                          ENDIF      
059F                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
059F                          ENDIF      
059F                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
059F                          ENDIF      
059F                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
059F                          ENDIF      
059F                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
059F                          ENDIF      
059F                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
059F                          ENDIF      
059F                             ; =============================================================================
059F                          IF   CPM   
059F                             ; The RAM pages follow the image; the heap may grow to the BDOS.
059F                START:       
059F                          ENDIF      
059F                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
059F                          ENDIF      
059F                          IF   CPM*(1-EDITOR)   
059F   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
05A2   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
05A4   CD 05 00               CALL   BDOS   ;   and the program is empty)
05A7   11 00 0A               LD   DE,PROG   
05AA   D5           LD1:      PUSH   DE   
05AB   0E 1A                  LD   C,26   ; set the DMA address
05AD   CD 05 00               CALL   BDOS   
05B0   11 5C 00               LD   DE,005Ch   
05B3   0E 14                  LD   C,20   ; read the next 128 bytes
05B5   CD 05 00               CALL   BDOS   
05B8   E1                     POP   HL   ; HL = the address this record went to
05B9   B7                     OR   A   
05BA   20 07                  JR   NZ,ld2   
05BC   11 80 00               LD   DE,128   
05BF   19                     ADD   HL,DE   
05C0   EB                     EX   DE,HL   
05C1   18 E7                  JR   ld1   
05C3   36 00        LD2:      LD   (HL),0   ; the end of the file counts as NUL
05C5   23                     INC   HL   ; the heap starts after it
05C6   01 00 0A               LD   BC,PROG   ; the IP
05C9                          ENDIF      
05C9                          IF   CPM*(1-EDITOR)*QK   
05C9   CD 75 04               CALL   skclr   ; an empty skip cache
05CC                          ENDIF      
05CC                          IF   CPM*(1-EDITOR)   
05CC   C3 50 01               JP   st2   
05CF                          ENDIF      
05CF                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:      ; &
                              POP   HL   
                              LD   A,H   
