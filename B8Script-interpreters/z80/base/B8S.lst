                    FDM:      INC   BC   ; more digits: HL = HL * 10 + the digit
                              LD   D,H   
                              LD   E,L   
                              ADD   HL,HL   
                              ADD   HL,HL   
                              ADD   HL,DE   
                              ADD   HL,HL   
                              LD   E,A   
                              LD   D,0   
                              ADD   HL,DE   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JR   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
