0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;  A port of the Z80 interpreter (z80/b8s-z80.asm); same behaviour, same
0000                             ;  memory map, same switches.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (CONIN/CONOUT/CONST at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpush and rpop (and the checks) touch it; both
0000                             ;  destroy HL, so each caller makes sure TOS is parked or dead first.
0000                             ; 
0000                             ;  (asm80 wants the vector number: RST 1 = RST 08h, RST 2 = RST 10h.)
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JMP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP D to throw the return address away.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LETPAGE..heap top.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                CONIN:    EQU   0FF00h   ; wait for a key, return it in A
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                CONST:    EQU   0FF06h   ; A = 0 if no key is waiting, else nonzero
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   All three console routines must preserve BC, DE and HL.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and CONST (~100 states each)
0000                CAP:      EQU   127   ; -n? reads at most this many characters
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
                              .ORG   0100h   
                              JMP   start   
0000                          ENDIF      
0000                          IFN   CPM   
0000                          .ORG   0000h   
0000   31 FE 81               LXI   SP,DSTOP   ; 0000h reset: the stack first,
0003   C3 6D 04               JMP   start   ;   then the rest of the startup
0006   E3           H_SWAP:   XTHL      ; 0006h the two-byte handlers fill the gaps
0007   D7                     RST   2   ;   between the vectors
0008                             ; ---- RST 08h: drop TOS, then next ------------------------------------------
0008   D1                     POP   D   ; 0008h discard the RST's return address
0009                DROP_NEXT:      
0009   E1                     POP   H   ; new TOS = NOS
000A   C3 11 00               JMP   next0   
000D   E5           H_DUP:    PUSH   H   ; 000Dh
000E   D7                     RST   2   
000F   00                     DB   0   ; 000Fh spare
0010                             ; ---- RST 10h: next character ------------------------------------------------
0010   D1                     POP   D   ; 0010h discard the RST's return address
0011                          ENDIF      
0011                             ; =============================================================================
0011                             ;  The inner loop: read one character and sort it by range.
0011                             ; 
0011                             ;    00h          end of program
0011                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0011                             ;    30h-39h      digit: read a whole number
0011                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0011                             ;    61h-7Ah      a-z: push the address of that letter's cell
0011                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0011                             ; =============================================================================
0011                NEXT0:       
0011                          IF   CHECKED   
0011                             ; Both stacks are checked once per character, not in every handler.
0011                             ; Each stack lives in one page, so it has overrun exactly when the
0011                             ; pointer's high byte has left that page. Errors are caught one cell
0011                             ; late at most; the page below each stack is a guard band.
0011   EB                     XCHG      ; DE = TOS (HL is needed for the pointers)
0012   21 00 00               LXI   H,0   
0015   39                     DAD   SP   
0016   7C                     MOV   A,H   
0017   FE 81                  CPI   DSPAGE   
0019   C2 0F 04               JNZ   e_stack   
001C   2A 34 82               LHLD   RSP   ; the return stack: in its page, and not
001F   7D                     MOV   A,L   ;   above its empty position (an underflow
0020   FE E1                  CPI   RSTOP&0FFh+1   ;   would stay inside the page, in the
0022   D2 17 04               JNC   e_rstack   ;   guard band)
0025   7C                     MOV   A,H   
0026   FE 80                  CPI   RSPAGE   
0028   C2 17 04               JNZ   e_rstack   
002B   EB                     XCHG      ; TOS back
002C                          ENDIF      
002C   0A                     LDAX   B   
002D   03                     INX   B   
002E   D6 21                  SUI   21h   ; A = c - 21h
0030   DA 73 00               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
0033   FE 0F                  CPI   0Fh   
0035   DA 66 00               JC   punct   ; 21h-2Fh: PTAB index 0-14
0038   D6 0F                  SUI   0Fh   ; A = c - 30h
003A   FE 0A                  CPI   0Ah   
003C   DA 90 00               JC   digit   ; 30h-39h
003F   FE 11                  CPI   11h   
0041   D2 49 00               JNC   ab40   
0044   C6 05                  ADI   5   ; 3Ah-40h: index 15-21
0046   C3 66 00               JMP   punct   
0049   D6 11        AB40:     SUI   11h   ; A = c - 41h
004B   FE 1A                  CPI   1Ah   
004D   DA 81 00               JC   upper   ; 41h-5Ah: A = letter index 0-25
0050   FE 20                  CPI   20h   
0052   D2 5A 00               JNC   ab60   
0055   D6 04                  SUI   4   ; 5Bh-60h: index 22-27
0057   C3 66 00               JMP   punct   
005A   FE 3A        AB60:     CPI   3Ah   
005C   DA 7B 00               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
005F   FE 3E                  CPI   3Eh   
0061   D2 11 00               JNC   next0   ; 7Fh-FFh: ignored
0064   D6 1E                  SUI   1Eh   ; 7Bh-7Eh: index 28-31
0066                             ; Punctuation: HL holds TOS, so it is parked on the stack while the table is
0066                             ; read, then swapped for the handler's address: XTHL puts TOS back in HL and
0066                             ; leaves the address on the stack for RET to jump to. The stack is balanced
0066                             ; again when the handler starts. PTAB never crosses a page (checked in the
0066                             ; listing), so only L needs adding.
0066   E5           PUNCT:    PUSH   H   
0067   87                     ADD   A   
0068   C6 96                  ADI   PTAB & 0FFh   
006A   6F                     MOV   L,A   
006B   26 00                  MVI   H,PTAB / 256   
006D   7E                     MOV   A,M   
006E   23                     INX   H   
006F   66                     MOV   H,M   
0070   6F                     MOV   L,A   ; HL = handler
0071   E3                     XTHL      
0072   C9                     RET      
0073   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
0075   C2 11 00               JNZ   next0   
0078                          IF   CPM   
                              JMP   endprog   
0078                          ENDIF      
0078                          IFN   CPM   
0078                ENDPROG:      
0078   C3 09 FF               JMP   EXIT   ; the program has ended
007B                          ENDIF      
007B                             ; a-z: push the cell's address (the cell is the variable)
007B   E5           LOWER:    PUSH   H   
007C   87                     ADD   A   
007D   6F                     MOV   L,A   
007E   26 82                  MVI   H,LETPAGE   
0080   D7                     RST   2   
0081                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0081                             ; the return stack, and the IP becomes the address in the letter's cell.
0081   E5           UPPER:    PUSH   H   ; keep TOS
0082   87                     ADD   A   
0083   6F                     MOV   L,A   
0084   26 82                  MVI   H,LETPAGE   ; HL -> cell
0086   50                     MOV   D,B   
0087   59                     MOV   E,C   ; DE = return address
0088   4E                     MOV   C,M   
0089   23                     INX   H   
008A   46                     MOV   B,M   ; IP = the word's body
008B   CD ED 00               CALL   rpush   
008E   E1                     POP   H   ; TOS back
008F   D7                     RST   2   
0090                             ; Digits: step back onto the first digit and read the whole number.
0090   E5           DIGIT:    PUSH   H   
0091   0B                     DCX   B   
0092   CD D6 00               CALL   rdnum   
0095   D7                     RST   2   
0096                             ; =============================================================================
0096                             ;  Dispatch table: one handler per punctuation character, in code order.
0096                             ;  It sits right after the inner loop so that it can't cross a page (the
0096                             ;  loop only adds to the low byte of its address).
0096                             ; =============================================================================
0096   F5 01        PTAB:     DW   h_store   ; !
0098   CE 02                  DW   h_str   ; "
009A   F6 02                  DW   h_num   ; #
009C   D5 02                  DW   h_print   ; $
009E   06 00                  DW   h_swap   ; %
00A0   AC 01                  DW   h_and   ; &
00A2   F1 02                  DW   h_emit   ; '
00A4   30 02                  DW   h_open   ; (
00A6   40 02                  DW   h_close   ; )
00A8   24 01                  DW   h_mul   ; *
00AA   04 01                  DW   h_add   ; +
00AC   FF 01                  DW   h_cfetch   ; ,
00AE   07 01                  DW   h_sub   ; -
00B0   03 02                  DW   h_cstore   ; .
00B2   40 01                  DW   h_div   ; /
00B4   0D 00                  DW   h_dup   ; :
00B6   09 00                  DW   drop_next   ; ;
00B8   CA 01                  DW   h_lt   ; <
00BA   D9 01                  DW   h_eq   ; =
00BC   C9 01                  DW   h_gt   ; >
00BE   1C 03                  DW   h_key   ; ?
00C0   F0 01                  DW   h_fetch   ; @
00C2   6E 02                  DW   h_def   ; [
00C4   54 02                  DW   h_break   ; \
00C6   63 02                  DW   h_ret   ; ]
00C8   BC 01                  DW   h_xor   ; ^
00CA   09 02                  DW   h_alloc   ; _
00CC   A3 03                  DW   h_grave   ; `
00CE   E6 01                  DW   h_tor   ; {
00D0   B4 01                  DW   h_or   ; |
00D2   EB 01                  DW   h_fromr   ; }
00D4   C4 01                  DW   h_not   ; ~
00D6                PTABEND:      
00D6                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
00D6                             ; non-digit. Values wrap at 16 bits, as the spec says.
00D6   21 00 00     RDNUM:    LXI   H,0   
00D9   0A           RDN1:     LDAX   B   
00DA   D6 30                  SUI   "0"   
00DC   FE 0A                  CPI   10   
00DE   D0                     RNC      
00DF   03                     INX   B   
00E0   54                     MOV   D,H   
00E1   5D                     MOV   E,L   
00E2   29                     DAD   H   
00E3   29                     DAD   H   
00E4   19                     DAD   D   
00E5   29                     DAD   H   ; HL * 10
00E6   5F                     MOV   E,A   
00E7   16 00                  MVI   D,0   
00E9   19                     DAD   D   
00EA   C3 D9 00               JMP   rdn1   
00ED                             ; =============================================================================
00ED                             ;  Return stack. rpush pushes DE; rpop pops into HL. RSP is the pointer (a RAM
00ED                             ;  word, growing down). Both destroy HL; rpush also keeps DE, rpop clobbers DE.
00ED                             ; =============================================================================
00ED   2A 34 82     RPUSH:    LHLD   RSP   
00F0   2B                     DCX   H   
00F1   72                     MOV   M,D   
00F2   2B                     DCX   H   
00F3   73                     MOV   M,E   
00F4   22 34 82               SHLD   RSP   
00F7   C9                     RET      
00F8   2A 34 82     RPOP:     LHLD   RSP   
00FB   5E                     MOV   E,M   
00FC   23                     INX   H   
00FD   56                     MOV   D,M   
00FE   23                     INX   H   
00FF   22 34 82               SHLD   RSP   
0102   EB                     XCHG      
0103   C9                     RET      
0104                             ; =============================================================================
0104                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
0104                             ; =============================================================================
0104   D1           H_ADD:    POP   D   
0105   19                     DAD   D   
0106   D7                     RST   2   
0107                             ; "-" has two jobs: directly before a digit it starts a negative number.
0107                             ; Otherwise a - b is a + (-b): neg16 and DAD are shorter than a byte-wise SUB/SBB.
0107   0A           H_SUB:    LDAX   B   
0108   D6 30                  SUI   "0"   
010A   FE 0A                  CPI   10   
010C   DA 15 01               JC   negnum   
010F   D1                     POP   D   
0110   CD 1D 01               CALL   neg16   
0113   19                     DAD   D   
0114   D7                     RST   2   
0115   E5           NEGNUM:   PUSH   H   
0116   CD D6 00               CALL   rdnum   
0119   CD 1D 01               CALL   neg16   
011C   D7                     RST   2   
011D                             ; neg16: HL = -HL (keeps BC, DE)
011D   AF           NEG16:    XRA   A   
011E   95                     SUB   L   
011F   6F                     MOV   L,A   
0120   9F                     SBB   A   
0121   94                     SUB   H   
0122   67                     MOV   H,A   
0123   C9                     RET      
0124                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0124                             ; multiplier is used up; only the low 16 bits are kept.
0124   D1           H_MUL:    POP   D   ; DE = multiplicand
0125   C5                     PUSH   B   
0126   44                     MOV   B,H   
0127   4D                     MOV   C,L   ; BC = multiplier
0128   21 00 00               LXI   H,0   
012B   78           MUL1:     MOV   A,B   
012C   B7                     ORA   A   ; clear carry
012D   1F                     RAR      
012E   47                     MOV   B,A   
012F   79                     MOV   A,C   
0130   1F                     RAR      
0131   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0132   D2 36 01               JNC   mul2   
0135   19                     DAD   D   
0136   EB           MUL2:     XCHG      
0137   29                     DAD   H   ; multiplicand << 1
0138   EB                     XCHG      
0139   78                     MOV   A,B   
013A   B1                     ORA   C   
013B   C2 2B 01               JNZ   mul1   
013E   C1                     POP   B   
013F   D7                     RST   2   
0140                             ; "/" ( a b -- q r ): truncates toward zero; r takes a's sign.
0140                             ; b = 0 gives q = 0, r = a. b = 2 takes a fast shift, as the spec requires.
0140   D1           H_DIV:    POP   D   ; DE = a, HL = b
0141   7C                     MOV   A,H   
0142   B5                     ORA   L   
0143   C2 49 01               JNZ   div1   
0146   E5                     PUSH   H   ; q = 0
0147   EB                     XCHG      ; r = a
0148   D7                     RST   2   
0149   2B           DIV1:     DCX   H   ; b = 2 exactly?
014A   2B                     DCX   H   
014B   7C                     MOV   A,H   
014C   B5                     ORA   L   
014D   23                     INX   H   ; (INX leaves the flags alone)
014E   23                     INX   H   
014F   C2 69 01               JNZ   divg   
0152                             ; a / 2: add 1 if a is negative, then shift right arithmetically
0152   62                     MOV   H,D   
0153   6B                     MOV   L,E   
0154   7A                     MOV   A,D   
0155   17                     RAL      ; carry = sign of a
0156   D2 5A 01               JNC   div2   
0159   23                     INX   H   
015A   7C           DIV2:     MOV   A,H   
015B   17                     RAL      ; carry = sign (of a, after the +1)
015C   7C                     MOV   A,H   
015D   1F                     RAR      ; arithmetic shift right, H
015E   67                     MOV   H,A   
015F   7D                     MOV   A,L   
0160   1F                     RAR      
0161   6F                     MOV   L,A   ; HL = q
0162   E5                     PUSH   H   
0163   29                     DAD   H   ; 2q
0164   CD 1D 01               CALL   neg16   
0167   19                     DAD   D   ; r = a - 2q
0168   D7                     RST   2   
0169   C5           DIVG:     PUSH   B   
016A   7A                     MOV   A,D   
016B   B7                     ORA   A   
016C   F5                     PUSH   PSW   ; S flag = sign of a (for r)
016D   AC                     XRA   H   
016E   F5                     PUSH   PSW   ; S flag = sign of q
016F   7C                     MOV   A,H   
0170   B7                     ORA   A   
0171   FC 1D 01               CM   neg16   ; HL = |b|
0174   EB                     XCHG      
0175   7C                     MOV   A,H   
0176   B7                     ORA   A   
0177   FC 1D 01               CM   neg16   ; HL = |a|, DE = |b|
017A   CD 8B 01               CALL   udiv   ; HL = q, BC = r
017D   F1                     POP   PSW   
017E   FC 1D 01               CM   neg16   ; q's sign
0181   EB                     XCHG      ; DE = q
0182   60                     MOV   H,B   
0183   69                     MOV   L,C   ; HL = r
0184   F1                     POP   PSW   
0185   FC 1D 01               CM   neg16   ; r's sign
0188   C1                     POP   B   
0189   D5                     PUSH   D   ; q under r
018A   D7                     RST   2   
018B                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
018B                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
018B                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
018B                             ; lives on the stack, since A is busy with the shifts.
018B   01 00 00     UDIV:     LXI   B,0   
018E   3E 10                  MVI   A,16   
0190   F5                     PUSH   PSW   
0191   29           UDV1:     DAD   H   ; next dividend bit into the carry
0192   79                     MOV   A,C   
0193   17                     RAL      
0194   4F                     MOV   C,A   
0195   78                     MOV   A,B   
0196   17                     RAL      
0197   47                     MOV   B,A   ; BC = BC*2 + bit
0198   79                     MOV   A,C   
0199   93                     SUB   E   
019A   78                     MOV   A,B   
019B   9A                     SBB   D   ; carry if BC < DE
019C   DA A4 01               JC   udv2   
019F   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
01A0   79                     MOV   A,C   
01A1   93                     SUB   E   
01A2   4F                     MOV   C,A   
01A3   2C                     INR   L   ; quotient bit
01A4   F1           UDV2:     POP   PSW   
01A5   3D                     DCR   A   
01A6   F5                     PUSH   PSW   
01A7   C2 91 01               JNZ   udv1   
01AA   F1                     POP   PSW   
01AB   C9                     RET      
01AC   D1           H_AND:    POP   D   
01AD   7C                     MOV   A,H   
01AE   A2                     ANA   D   
01AF   67                     MOV   H,A   
01B0   7D                     MOV   A,L   
01B1   A3                     ANA   E   
01B2   6F                     MOV   L,A   
01B3   D7                     RST   2   
01B4   D1           H_OR:     POP   D   
01B5   7C                     MOV   A,H   
01B6   B2                     ORA   D   
01B7   67                     MOV   H,A   
01B8   7D                     MOV   A,L   
01B9   B3                     ORA   E   
01BA   6F                     MOV   L,A   
01BB   D7                     RST   2   
01BC   D1           H_XOR:    POP   D   
01BD   7C                     MOV   A,H   
01BE   AA                     XRA   D   
01BF   67                     MOV   H,A   
01C0   7D                     MOV   A,L   
01C1   AB                     XRA   E   
01C2   6F                     MOV   L,A   
01C3   D7                     RST   2   
01C4                             ; ~x is -x - 1: shorter than complementing both bytes.
01C4   CD 1D 01     H_NOT:    CALL   neg16   
01C7   2B                     DCX   H   
01C8   D7                     RST   2   
01C9                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
01C9                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
01C9                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
01C9                             ; SBB A turns a carry into -1 or 0 with no branch.
01C9   E3           H_GT:     XTHL      ; a > b  is  b < a
01CA   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
01CB   7B                     MOV   A,E   
01CC   95                     SUB   L   
01CD   7A                     MOV   A,D   
01CE   9C                     SBB   H   
01CF   9F                     SBB   A   ; A = -1 if DE < HL unsigned
