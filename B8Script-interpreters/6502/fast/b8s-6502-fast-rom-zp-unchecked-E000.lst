E436   60                     RTS      
E437   A1 00        H_FETCH:   LDA   (0,X)   ; "@"
E439   A8                     TAY      
E43A   20 46 E4               JSR   inctos   
E43D   A1 00                  LDA   (0,X)   
E43F   95 01                  STA   1,X   
E441   94 00                  STY   0,X   
E443   60                     RTS      
E444                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E444   A1 00        TOSGET:   LDA   (0,X)   
E446   F6 00        INCTOS:   INC   0,X   
E448   D0 02                  BNE   tg1   
E44A   F6 01                  INC   1,X   
E44C   60           TG1:      RTS      
E44D                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E44D                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E44D                             ; the body"s address instead. Either way it then skips to the matching "]'.
E44D                             ; (The unchecked build takes anything that is not a letter as the space; the
E44D                             ; checked build stops on it.)
E44D                          IF   CHECKED   
                    DEF1:     CPY   #" "-"A"+256   
                              BEQ   def2   
                                 ; W: anything but a letter or a space after [. The place is that character,
                                 ; one past the [.
                              INC   PLACE   
                              BNE   eb1   
                              INC   PLACE+1   
                    EB1:      LDA   #"W"   
                              JMP   error   
E44D                          ENDIF      
E44D   20 8E EA     H_DEF:    JSR   getc   
E450   38                     SEC      
E451   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E453   A8                     TAY      ;   lands 64 bytes up
E454   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E456   C9 1A                  CMP   #26   
E458                          IF   1-CHECKED   
E458   B0 0F                  BCS   def2   ; not a letter
E45A                          ENDIF      
E45A                          IF   CHECKED   
