E1A7   7E E2                  DW   h_sub-1   ; -
E1A9   40 E2                  DW   h_cstore-1   ; .
E1AB   14 E3                  DW   h_div-1   ; /
E1AD   0A E1                  DW   push-1   ; :
E1AF   48 E2                  DW   drop-1   ; ;
E1B1   B5 E2                  DW   h_lt-1   ; <
E1B3   C7 E2                  DW   h_eq-1   ; =
E1B5   B2 E2                  DW   h_gt-1   ; >
E1B7   06 E4                  DW   h_key-1   ; ?
E1B9   F1 E3                  DW   h_fetch-1   ; @
E1BB   32 E1                  DW   h_def-1   ; [
E1BD   64 E0                  DW   h_break-1   ; \
E1BF   53 E0                  DW   h_ret-1   ; ]
E1C1   70 E2                  DW   h_xor-1   ; ^
E1C3   41 E3                  DW   h_alloc-1   ; _
E1C5   67 E4                  DW   h_grave-1   ; `
E1C7   33 E0                  DW   h_tor-1   ; {
E1C9   62 E2                  DW   h_or-1   ; |
E1CB   40 E0                  DW   h_fromr-1   ; }
E1CD   9E E2                  DW   h_not-1   ; ~
