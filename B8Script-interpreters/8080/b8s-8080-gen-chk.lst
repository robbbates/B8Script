0230                             ; =============================================================================
0230                             ;  Flow control
0230                             ; =============================================================================
0230                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0230                             ; the matching ")".
0230   7C           H_OPEN:   MOV   A,H   
0231   B5                     ORA   L   
0232   CA 3B 02               JZ   op_f   
0235   50                     MOV   D,B   
0236   59                     MOV   E,C   
0237   CD ED 00               CALL   rpush   ; (HL, the flag, is dead here)
023A   CF                     RST   1   ; = POP H, RST 2: the flag is dead, so drop it
023B   E1           OP_F:     POP   H   
023C   CD 95 02     SKIPNX:   CALL   skip   
023F   D7                     RST   2   
0240                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0240                             ; drops it and carries on.
0240   7C           H_CLOSE:   MOV   A,H   
0241   B5                     ORA   L   
0242   CA 50 02               JZ   rdrop   
0245                          IF   CHECKED   
0245   CD FD 03               CALL   chkbrk   ; Ctrl-C is checked at every loop-back
0248                          ENDIF      
0248   2A 34 82               LHLD   RSP   ; peek the block start
024B   4E                     MOV   C,M   
024C   23                     INX   H   
024D   46                     MOV   B,M   
024E   E1                     POP   H   
024F   D7                     RST   2   
0250   CD F8 00     RDROP:    CALL   rpop   ; (HL, the flag, is dead: NOS is next)
0253   CF                     RST   1   
0254                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
0254                             ; drops the block start, "]" returns. No closer at all ends the program.
0254   7C           H_BREAK:   MOV   A,H   
0255   B5                     ORA   L   
0256   C2 5A 02               JNZ   brk1   
0259   CF                     RST   1   
025A   CD 95 02     BRK1:     CALL   skip   
025D   FE 29                  CPI   ")"   
025F   CA 50 02               JZ   rdrop   
0262   E1                     POP   H   ; and fall into "]"
0263                             ; "]" returns: pop an address and jump to it.
0263   E5           H_RET:    PUSH   H   
0264   CD F8 00               CALL   rpop   
0267   44                     MOV   B,H   
0268   4D                     MOV   C,L   
0269   E1                     POP   H   
026A                          IF   CHECKED   
026A   CD FD 03               CALL   chkbrk   ; ... and at every word return
026D                          ENDIF      
026D   D7                     RST   2   
026E                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
026E                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
026E                             ; the body"s address instead. Either way it then skips to the matching "]'.
026E   0A           H_DEF:    LDAX   B   
026F   03                     INX   B   
0270   5F                     MOV   E,A   
0271   E6 DF                  ANI   0DFh   ; fold case
0273   D6 41                  SUI   "A"   
0275   FE 1A                  CPI   26   
0277   D2 89 02               JNC   def2   ; not a letter
027A   7B                     MOV   A,E   
027B   D6 41                  SUI   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
027D   87                     ADD   A   
027E   5F                     MOV   E,A   
027F   16 82                  MVI   D,LETPAGE   ; DE -> cell
0281   79                     MOV   A,C   
0282   12                     STAX   D   
0283   1C                     INR   E   
0284   78                     MOV   A,B   
0285   12                     STAX   D   
0286   C3 3C 02               JMP   skipnx   
0289                DEF2:        
0289                          IF   CHECKED   
0289   7B                     MOV   A,E   
028A   FE 20                  CPI   " "   
028C   C2 37 04               JNZ   e_brack   ; anything but a letter or a space
028F                          ENDIF      
028F   E5                     PUSH   H   ; an anonymous block: push its address
0290   60                     MOV   H,B   
0291   69                     MOV   L,C   
0292   C3 3C 02               JMP   skipnx   
0295                             ; skip: read past text to the closer at this level, and return it in A.
0295                             ; Brackets of both kinds count together; strings are stepped over whole. A
0295                             ; NUL first ends the program (for "\" with no closer; anything else that runs
0295                             ; into the NUL had unbalanced brackets anyway). D counts the open levels,
0295                             ; starting at 1 for the one we are in.
0295   16 01        SKIP:     MVI   D,1   
0297   0A           SK1:      LDAX   B   
0298   03                     INX   B   
0299   B7                     ORA   A   
029A   CA 78 00               JZ   endprog   
029D   FE 22                  CPI   22h   
029F   CC C1 02               CZ   skipstr   ; leaves A = 22h, which matches nothing below
02A2   FE 28                  CPI   "("   
02A4   CA BB 02               JZ   sk3   
02A7   FE 5B                  CPI   "["   
02A9   CA BB 02               JZ   sk3   
02AC   FE 29                  CPI   ")"   
02AE   CA B6 02               JZ   sk4   
02B1   FE 5D                  CPI   "]"   
02B3   C2 97 02               JNZ   sk1   
02B6   15           SK4:      DCR   D   
02B7   C8                     RZ      ; the closer at this level
02B8   C3 97 02               JMP   sk1   
02BB   14           SK3:      INR   D   ; an opener: one deeper (the DCR below makes
02BC   14                     INR   D   ;   it +1 net, and can't reach zero)
02BD   C3 B6 02               JMP   sk4   
02C0                             ; skipstr: IP is inside a string; step past its closing quote. ">" escapes
02C0                             ; the next character, so ">"" does not end it.
02C0   03           SS0:      INX   B   
02C1   0A           SKIPSTR:   LDAX   B   
02C2   03                     INX   B   
02C3   FE 3E                  CPI   ">"   
02C5   CA C0 02               JZ   ss0   
02C8   FE 22                  CPI   22h   
02CA   C2 C1 02               JNZ   skipstr   
02CD   C9                     RET      
