   885 00000256 C02304              <1>         shl     byte [ebx],4            ;   overwrites it
   886 00000259 0803                <1>         or      [ebx],al                ; ... and the low one joins it
   887 0000025B 43                  <1>         inc     ebx
   888                              <1>         CALLP   hexc
