E7F7                             ; udiv (QK): as the macro UDIV, and any power of two is shifts: 2, and 32,
E7F7                             ; 64, 256 and the like, which fixed point and byte work use all the time.
E7F7   A9 00        UDIV:     LDA   #0   
E7F9   95 FE                  STA   0FEh,X   
E7FB   95 FF                  STA   0FFh,X   
E7FD   A4 05                  LDY   D0   
E7FF   A5 06                  LDA   D1   
E801   D0 12                  BNE   uq1   ; 256 and up
E803   98                     TYA      
E804   F0 38                  BEQ   ud0   ; by 0: the long way (it means nothing anyway)
E806   88                     DEY      
E807   98                     TYA      
E808   25 05                  AND   D0   
E80A   D0 32                  BNE   ud0   ; not a power of two
E80C   98                     TYA      ; by 2^k below 256: r = a & (2^k - 1),
E80D   35 00                  AND   0,X   
E80F   95 FE                  STA   0FEh,X   
E811   A5 05                  LDA   D0   ;   and q = a >> k
E813   D0 1E                  BNE   uq2   ; always
E815   98           UQ1:      TYA      
E816   D0 26                  BNE   ud0   ; not a power of two
E818   A4 06                  LDY   D1   
E81A   88                     DEY      
E81B   98                     TYA      
E81C   25 06                  AND   D1   
E81E   D0 1E                  BNE   ud0   ; not a power of two
E820   98                     TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
E821   35 01                  AND   1,X   
E823   95 FF                  STA   0FFh,X   
E825   B5 00                  LDA   0,X   
E827   95 FE                  STA   0FEh,X   
E829   B5 01                  LDA   1,X   ;   and q = (a >> 8) >> (k - 8)
E82B   95 00                  STA   0,X   
E82D   A9 00                  LDA   #0   
E82F   95 01                  STA   1,X   
E831   A5 06                  LDA   D1   
