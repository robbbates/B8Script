E72A   4C F8 E6               JMP   sq1   
E72D   C9 5C        SQB:      CMP   #5Ch   
E72F   F0 C7                  BEQ   sq1   ; "\" is nothing here
E731   90 F5                  BCC   sqo   ; [
E733   C6 06        SQC:      DEC   T2   ; ) ]
E735   10 C1                  BPL   sq1   
E737   20 61 E7               JSR   sqip   ; the closer at this level: the IP past it
E73A                          ENDIF      
