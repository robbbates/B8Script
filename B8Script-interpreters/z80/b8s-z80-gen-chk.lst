01FF                             ;   at most
01FF   21 80 82               LD   HL,LINEBUF   
0202   CD 97 03     LN2:      CALL   getk   
0205   28 FB                  JR   Z,ln2   
0207   FE 0D                  CP   13   
0209   28 16                  JR   Z,ln5   
020B   FE 08                  CP   8   
020D   28 0B                  JR   Z,ln4   
020F   5F                     LD   E,A   
0210   7D                     LD   A,L   
0211   BA                     CP   D   
0212   28 EE                  JR   Z,ln2   ; full
0214   73                     LD   (HL),E   
0215   2C                     INC   L   
0216   7B                     LD   A,E   
0217   EF           LN3:      RST   28h   
0218   18 E8                  JR   ln2   
021A   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
021B   FA 17 02               JP   M,ln3   ;   unless the line was empty (L left the
021E   2C                     INC   L   ;   upper half of the page)
021F   18 E1                  JR   ln2   
0221   77           LN5:      LD   (HL),A   ; the CR
0222   2E 80                  LD   L,LINEBUF & 0FFh   
0224   F7                     RST   30h   
