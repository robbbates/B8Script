0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;  A port of the Z80 interpreter (z80/b8s-z80.asm); same behaviour, same
0000                             ;  memory map, same switches.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpush and rpop (and the checks) touch it; both
0000                             ;  destroy HL, so each caller makes sure TOS is parked or dead first.
0000                             ; 
0000                             ;  (asm80 wants the vector number: RST 1 = RST 08h, RST 2 = RST 10h.)
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JMP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP D to throw the return address away.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LETPAGE..heap top.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with ORA A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE and HL.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
0100                          .ORG   0100h   
0100   C3 2E 04               JMP   start   
0103                          ENDIF      
0103                          IFN   CPM   
                              .ORG   0000h   
                              LXI   SP,DSTOP   ; 0000h reset: the stack first,
                              JMP   start   ;   then the rest of the startup
                    H_SWAP:   XTHL      ; 0006h the two-byte handlers fill the gaps
                              RST   2   ;   between the vectors
                                 ; ---- RST 08h: drop TOS, then next ------------------------------------------
                              POP   D   ; 0008h discard the RST's return address
                    DROP_NEXT:      
                              POP   H   ; new TOS = NOS
                              JMP   next0   
                    H_DUP:    PUSH   H   ; 000Dh
                              RST   2   
                              DB   0   ; 000Fh spare
                                 ; ---- RST 10h: next character ------------------------------------------------
                              POP   D   ; 0010h discard the RST's return address
0103                          ENDIF      
0103                             ; =============================================================================
0103                             ;  The inner loop: read one character and sort it by range.
0103                             ; 
0103                             ;    00h          end of program
0103                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0103                             ;    30h-39h      digit: read a whole number
0103                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0103                             ;    61h-7Ah      a-z: push the address of that letter's cell
0103                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0103                             ; =============================================================================
0103                NEXT0:       
0103                          IF   CHECKED   
                                 ; Both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the
                                 ; pointer's high byte has left that page. Errors are caught one cell
                                 ; late at most; the page below each stack is a guard band.
                              XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,0   
                              DAD   SP   
                              MOV   A,H   
                              CPI   DSPAGE   
                              JNZ   e_stack   
                              LHLD   RSP   ; the return stack: in its page, and not
                              MOV   A,L   ;   above its empty position (an underflow
                              CPI   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              JNC   e_rstack   ;   guard band)
                              MOV   A,H   
                              CPI   RSPAGE   
                              JNZ   e_rstack   
                              XCHG      ; TOS back
0103                          ENDIF      
0103   0A                     LDAX   B   
0104   03                     INX   B   
0105   D6 21                  SUI   21h   ; A = c - 21h
0107   DA 4A 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
010A   FE 0F                  CPI   0Fh   
010C   DA 3D 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
010F   D6 0F                  SUI   0Fh   ; A = c - 30h
0111   FE 0A                  CPI   0Ah   
0113   DA 67 01               JC   digit   ; 30h-39h
0116   FE 11                  CPI   11h   
0118   D2 20 01               JNC   ab40   
011B   C6 05                  ADI   5   ; 3Ah-40h: index 15-21
011D   C3 3D 01               JMP   punct   
0120   D6 11        AB40:     SUI   11h   ; A = c - 41h
0122   FE 1A                  CPI   1Ah   
0124   DA 58 01               JC   upper   ; 41h-5Ah: A = letter index 0-25
0127   FE 20                  CPI   20h   
0129   D2 31 01               JNC   ab60   
012C   D6 04                  SUI   4   ; 5Bh-60h: index 22-27
012E   C3 3D 01               JMP   punct   
0131   FE 3A        AB60:     CPI   3Ah   
0133   DA 52 01               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0136   FE 3E                  CPI   3Eh   
0138   D2 03 01               JNC   next0   ; 7Fh-FFh: ignored
013B   D6 1E                  SUI   1Eh   ; 7Bh-7Eh: index 28-31
013D                             ; Punctuation: HL holds TOS, so it is parked on the stack while the table is
013D                             ; read, then swapped for the handler's address: XTHL puts TOS back in HL and
013D                             ; leaves the address on the stack for RET to jump to. The stack is balanced
013D                             ; again when the handler starts. PTAB never crosses a page (checked in the
013D                             ; listing), so only L needs adding.
013D   E5           PUNCT:    PUSH   H   
013E   87                     ADD   A   
013F   C6 6D                  ADI   PTAB & 0FFh   
0141   6F                     MOV   L,A   
0142   26 01                  MVI   H,PTAB / 256   
0144   7E                     MOV   A,M   
0145   23                     INX   H   
0146   66                     MOV   H,M   
0147   6F                     MOV   L,A   ; HL = handler
0148   E3                     XTHL      
0149   C9                     RET      
014A   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
014C   C2 03 01               JNZ   next0   
014F                          IF   CPM   
014F   C3 00 00               JMP   endprog   
0152                          ENDIF      
0152                          IFN   CPM   
                    ENDPROG:      
                              JMP   EXIT   ; the program has ended
0152                          ENDIF      
0152                             ; a-z: push the cell's address (the cell is the variable)
0152   E5           LOWER:    PUSH   H   
0153   87                     ADD   A   
0154   6F                     MOV   L,A   
0155   26 07                  MVI   H,LETPAGE   
0157   D7                     RST   2   
0158                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0158                             ; the return stack, and the IP becomes the address in the letter's cell.
0158   E5           UPPER:    PUSH   H   ; keep TOS
0159   87                     ADD   A   
015A   6F                     MOV   L,A   
015B   26 07                  MVI   H,LETPAGE   ; HL -> cell
015D   50                     MOV   D,B   
015E   59                     MOV   E,C   ; DE = return address
015F   4E                     MOV   C,M   
0160   23                     INX   H   
0161   46                     MOV   B,M   ; IP = the word's body
0162   CD C4 01               CALL   rpush   
0165   E1                     POP   H   ; TOS back
0166   D7                     RST   2   
0167                             ; Digits: step back onto the first digit and read the whole number.
0167   E5           DIGIT:    PUSH   H   
0168   0B                     DCX   B   
0169   CD AD 01               CALL   rdnum   
016C   D7                     RST   2   
016D                             ; =============================================================================
016D                             ;  Dispatch table: one handler per punctuation character, in code order.
016D                             ;  It sits right after the inner loop so that it can't cross a page (the
016D                             ;  loop only adds to the low byte of its address).
016D                             ; =============================================================================
016D   A7 02        PTAB:     DW   h_store   ; !
016F   50 03                  DW   h_str   ; "
0171   78 03                  DW   h_num   ; #
0173   57 03                  DW   h_print   ; $
0175   96 02                  DW   h_swap   ; %
0177   5C 02                  DW   h_and   ; &
0179   73 03                  DW   h_emit   ; '
017B   BE 02                  DW   h_open   ; (
017D   CE 02                  DW   h_close   ; )
017F   FB 01                  DW   h_mul   ; *
0181   DB 01                  DW   h_add   ; +
0183   AC 02                  DW   h_cfetch   ; ,
0185   DE 01                  DW   h_sub   ; -
0187   B0 02                  DW   h_cstore   ; .
0189   17 02                  DW   h_div   ; /
018B   0D 00                  DW   h_dup   ; :
018D   09 00                  DW   drop_next   ; ;
018F   7A 02                  DW   h_lt   ; <
0191   89 02                  DW   h_eq   ; =
0193   79 02                  DW   h_gt   ; >
0195   9E 03                  DW   h_key   ; ?
0197   A2 02                  DW   h_fetch   ; @
0199   F6 02                  DW   h_def   ; [
019B   DF 02                  DW   h_break   ; \
019D   EE 02                  DW   h_ret   ; ]
019F   6C 02                  DW   h_xor   ; ^
01A1   B3 02                  DW   h_alloc   ; _
01A3   E2 03                  DW   h_grave   ; `
01A5   98 02                  DW   h_tor   ; {
01A7   64 02                  DW   h_or   ; |
01A9   9D 02                  DW   h_fromr   ; }
01AB   74 02                  DW   h_not   ; ~
01AD                PTABEND:      
01AD                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
01AD                             ; non-digit. Values wrap at 16 bits, as the spec says.
01AD   21 00 00     RDNUM:    LXI   H,0   
01B0   0A           RDN1:     LDAX   B   
01B1   D6 30                  SUI   "0"   
01B3   FE 0A                  CPI   10   
01B5   D0                     RNC      
01B6   03                     INX   B   
01B7   54                     MOV   D,H   
01B8   5D                     MOV   E,L   
01B9   29                     DAD   H   
01BA   29                     DAD   H   
01BB   19                     DAD   D   
01BC   29                     DAD   H   ; HL * 10
01BD   5F                     MOV   E,A   
01BE   16 00                  MVI   D,0   
01C0   19                     DAD   D   
01C1   C3 B0 01               JMP   rdn1   
01C4                             ; =============================================================================
01C4                             ;  Return stack. rpush pushes DE; rpop pops into HL. RSP is the pointer (a RAM
01C4                             ;  word, growing down). Both destroy HL; rpush also keeps DE, rpop clobbers DE.
01C4                             ; =============================================================================
01C4   2A 34 07     RPUSH:    LHLD   RSP   
01C7   2B                     DCX   H   
01C8   72                     MOV   M,D   
01C9   2B                     DCX   H   
01CA   73                     MOV   M,E   
01CB   22 34 07               SHLD   RSP   
01CE   C9                     RET      
01CF   2A 34 07     RPOP:     LHLD   RSP   
01D2   5E                     MOV   E,M   
01D3   23                     INX   H   
01D4   56                     MOV   D,M   
01D5   23                     INX   H   
01D6   22 34 07               SHLD   RSP   
01D9   EB                     XCHG      
01DA   C9                     RET      
01DB                             ; =============================================================================
01DB                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
01DB                             ; =============================================================================
01DB   D1           H_ADD:    POP   D   
01DC   19                     DAD   D   
01DD   D7                     RST   2   
01DE                             ; "-" has two jobs: directly before a digit it starts a negative number.
01DE                             ; Otherwise a - b is a + (-b): neg16 and DAD are shorter than a byte-wise SUB/SBB.
01DE   0A           H_SUB:    LDAX   B   
01DF   D6 30                  SUI   "0"   
01E1   FE 0A                  CPI   10   
01E3   DA EC 01               JC   negnum   
01E6   D1                     POP   D   
01E7   CD F4 01               CALL   neg16   
01EA   19                     DAD   D   
01EB   D7                     RST   2   
01EC   E5           NEGNUM:   PUSH   H   
01ED   CD AD 01               CALL   rdnum   
01F0   CD F4 01               CALL   neg16   
01F3   D7                     RST   2   
01F4                             ; neg16: HL = -HL (keeps BC, DE)
01F4   AF           NEG16:    XRA   A   
01F5   95                     SUB   L   
01F6   6F                     MOV   L,A   
01F7   9F                     SBB   A   
01F8   94                     SUB   H   
01F9   67                     MOV   H,A   
01FA   C9                     RET      
01FB                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
01FB                             ; multiplier is used up; only the low 16 bits are kept.
01FB   D1           H_MUL:    POP   D   ; DE = multiplicand
01FC   C5                     PUSH   B   
01FD   44                     MOV   B,H   
01FE   4D                     MOV   C,L   ; BC = multiplier
01FF   21 00 00               LXI   H,0   
0202   78           MUL1:     MOV   A,B   
0203   B7                     ORA   A   ; clear carry
0204   1F                     RAR      
0205   47                     MOV   B,A   
0206   79                     MOV   A,C   
0207   1F                     RAR      
0208   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0209   D2 0D 02               JNC   mul2   
020C   19                     DAD   D   
020D   EB           MUL2:     XCHG      
020E   29                     DAD   H   ; multiplicand << 1
020F   EB                     XCHG      
0210   78                     MOV   A,B   
0211   B1                     ORA   C   
0212   C2 02 02               JNZ   mul1   
0215   C1                     POP   B   
0216   D7                     RST   2   
0217                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
0217                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0217                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0217   D1           H_DIV:    POP   D   ; DE = a, HL = b
0218   C5                     PUSH   B   
0219   7A                     MOV   A,D   
021A   B7                     ORA   A   
021B   F5                     PUSH   PSW   ; S flag = sign of a (for r)
021C   AC                     XRA   H   
021D   F5                     PUSH   PSW   ; S flag = sign of q
021E   7C                     MOV   A,H   
021F   B7                     ORA   A   
0220   FC F4 01               CM   neg16   ; HL = |b|
0223   EB                     XCHG      
0224   7C                     MOV   A,H   
0225   B7                     ORA   A   
0226   FC F4 01               CM   neg16   ; HL = |a|, DE = |b|
0229   CD 3B 02               CALL   udiv   ; HL = q, BC = r
022C   F1                     POP   PSW   
022D   FC F4 01               CM   neg16   ; q's sign
0230   EB                     XCHG      ; DE = q
0231   60                     MOV   H,B   
0232   69                     MOV   L,C   ; HL = r
0233   F1                     POP   PSW   
0234   FC F4 01               CM   neg16   ; r's sign
0237   C1                     POP   B   
0238   E5                     PUSH   H   ; r under q
0239   EB                     XCHG      ; HL = q
023A   D7                     RST   2   
023B                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
023B                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
023B                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
023B                             ; lives on the stack, since A is busy with the shifts.
023B   01 00 00     UDIV:     LXI   B,0   
023E   3E 10                  MVI   A,16   
0240   F5                     PUSH   PSW   
0241   29           UDV1:     DAD   H   ; next dividend bit into the carry
0242   79                     MOV   A,C   
0243   17                     RAL      
0244   4F                     MOV   C,A   
0245   78                     MOV   A,B   
0246   17                     RAL      
0247   47                     MOV   B,A   ; BC = BC*2 + bit
0248   79                     MOV   A,C   
0249   93                     SUB   E   
024A   78                     MOV   A,B   
024B   9A                     SBB   D   ; carry if BC < DE
024C   DA 54 02               JC   udv2   
024F   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0250   79                     MOV   A,C   
0251   93                     SUB   E   
0252   4F                     MOV   C,A   
0253   2C                     INR   L   ; quotient bit
0254   F1           UDV2:     POP   PSW   
0255   3D                     DCR   A   
0256   F5                     PUSH   PSW   
0257   C2 41 02               JNZ   udv1   
025A   F1                     POP   PSW   
025B   C9                     RET      
025C   D1           H_AND:    POP   D   
025D   7C                     MOV   A,H   
025E   A2                     ANA   D   
025F   67                     MOV   H,A   
0260   7D                     MOV   A,L   
0261   A3                     ANA   E   
0262   6F                     MOV   L,A   
0263   D7                     RST   2   
0264   D1           H_OR:     POP   D   
0265   7C                     MOV   A,H   
0266   B2                     ORA   D   
0267   67                     MOV   H,A   
0268   7D                     MOV   A,L   
0269   B3                     ORA   E   
026A   6F                     MOV   L,A   
026B   D7                     RST   2   
026C   D1           H_XOR:    POP   D   
026D   7C                     MOV   A,H   
026E   AA                     XRA   D   
026F   67                     MOV   H,A   
0270   7D                     MOV   A,L   
0271   AB                     XRA   E   
0272   6F                     MOV   L,A   
0273   D7                     RST   2   
0274                             ; ~x is -x - 1: shorter than complementing both bytes.
0274   CD F4 01     H_NOT:    CALL   neg16   
0277   2B                     DCX   H   
0278   D7                     RST   2   
0279                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0279                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0279                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0279                             ; SBB A turns a carry into -1 or 0 with no branch.
0279   E3           H_GT:     XTHL      ; a > b  is  b < a
027A   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
027B   7B                     MOV   A,E   
027C   95                     SUB   L   
027D   7A                     MOV   A,D   
027E   9C                     SBB   H   
027F   9F                     SBB   A   ; A = -1 if DE < HL unsigned
0280   6F                     MOV   L,A   
0281   7C                     MOV   A,H   
0282   AA                     XRA   D   
0283   17                     RAL      ; carry = the signs differ
0284   9F                     SBB   A   
0285   AD                     XRA   L   ; flip when they do
0286   67                     MOV   H,A   
0287   6F                     MOV   L,A   
0288   D7                     RST   2   
0289   D1           H_EQ:     POP   D   
028A   7D                     MOV   A,L   
028B   AB                     XRA   E   
028C   6F                     MOV   L,A   
028D   7C                     MOV   A,H   
028E   AA                     XRA   D   
028F   B5                     ORA   L   ; zero if equal
0290   D6 01                  SUI   1   ; carry only for zero
0292   9F                     SBB   A   
0293   67                     MOV   H,A   
0294   6F                     MOV   L,A   
0295   D7                     RST   2   
0296                             ; =============================================================================
0296                             ;  Stack
0296                             ; =============================================================================
0296                          IF   CPM   
0296   E3           H_SWAP:   XTHL      
0297   D7                     RST   2   
0298                          ENDIF      
0298   EB           H_TOR:    XCHG      ; "{" TOS to the return stack
0299   CD C4 01               CALL   rpush   
029C   CF                     RST   1   
029D   E5           H_FROMR:   PUSH   H   ; "}" return stack to TOS
029E   CD CF 01               CALL   rpop   
02A1   D7                     RST   2   
02A2                             ; =============================================================================
02A2                             ;  Storage
02A2                             ; =============================================================================
02A2   5E           H_FETCH:   MOV   E,M   ; "@"
02A3   23                     INX   H   
02A4   56                     MOV   D,M   
02A5   EB                     XCHG      
02A6   D7                     RST   2   
02A7   D1           H_STORE:   POP   D   ; "!" ( n addr -- )
02A8                          IF   CHECKED   
                              INX   H   ; both bytes must be in the program's space
                              CALL   chkst   
                              DCX   H   
02A8                          ENDIF      
02A8   73                     MOV   M,E   
02A9   23                     INX   H   
02AA   72                     MOV   M,D   
02AB   CF                     RST   1   
02AC   6E           H_CFETCH:   MOV   L,M   ; ","
02AD   26 00                  MVI   H,0   
02AF   D7                     RST   2   
02B0   D1           H_CSTORE:   POP   D   ; "." ( c addr -- )
02B1                          IF   CHECKED   
                              CALL   chkst   
02B1                          ENDIF      
02B1   73                     MOV   M,E   
02B2   CF                     RST   1   
02B3                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
02B3   EB           H_ALLOC:   XCHG      
02B4   2A 7C 07               LHLD   HEAP   
02B7   E5                     PUSH   H   
02B8   19                     DAD   D   
02B9                          IF   CHECKED   
                              JC   e_heap   ; a negative count wraps: too big
                              LDA   HLIM   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   ; the new top must stay below the limit page
02B9                          ENDIF      
02B9   22 7C 07               SHLD   HEAP   
02BC   E1                     POP   H   
02BD   D7                     RST   2   
02BE                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   PSW   
                              MOV   A,H   
                              CPI   LETPAGE   
                              JC   chk1   
                              LDA   HLIM   
                              DCR   A   
                              CMP   H   
                    CHK1:     JC   e_store   
                              POP   PSW   
                              RET      
02BE                          ENDIF      
02BE                             ; =============================================================================
02BE                             ;  Flow control
02BE                             ; =============================================================================
02BE                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
02BE                             ; the matching ")".
02BE   7C           H_OPEN:   MOV   A,H   
02BF   B5                     ORA   L   
02C0   CA C9 02               JZ   op_f   
02C3   50                     MOV   D,B   
02C4   59                     MOV   E,C   
02C5   CD C4 01               CALL   rpush   ; (HL, the flag, is dead here)
02C8   CF                     RST   1   ; = POP H, RST 2: the flag is dead, so drop it
02C9   E1           OP_F:     POP   H   
02CA   CD 17 03     SKIPNX:   CALL   skip   
02CD   D7                     RST   2   
02CE                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
02CE                             ; drops it and carries on.
02CE   7C           H_CLOSE:   MOV   A,H   
02CF   B5                     ORA   L   
02D0   CA DB 02               JZ   rdrop   
02D3                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every loop-back
02D3                          ENDIF      
02D3   2A 34 07               LHLD   RSP   ; peek the block start
02D6   4E                     MOV   C,M   
02D7   23                     INX   H   
02D8   46                     MOV   B,M   
02D9   E1                     POP   H   
02DA   D7                     RST   2   
02DB   CD CF 01     RDROP:    CALL   rpop   ; (HL, the flag, is dead: NOS is next)
02DE   CF                     RST   1   
02DF                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
02DF                             ; drops the block start, "]" returns. No closer at all ends the program.
02DF   7C           H_BREAK:   MOV   A,H   
02E0   B5                     ORA   L   
02E1   C2 E5 02               JNZ   brk1   
02E4   CF                     RST   1   
02E5   CD 17 03     BRK1:     CALL   skip   
02E8   FE 29                  CPI   ")"   
02EA   CA DB 02               JZ   rdrop   
02ED   E1                     POP   H   ; and fall into "]"
02EE                             ; "]" returns: pop an address and jump to it.
02EE   E5           H_RET:    PUSH   H   
02EF   CD CF 01               CALL   rpop   
02F2   44                     MOV   B,H   
02F3   4D                     MOV   C,L   
02F4   E1                     POP   H   
02F5                          IF   CHECKED   
                              CALL   chkbrk   ; ... and at every word return
02F5                          ENDIF      
02F5   D7                     RST   2   
02F6                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
02F6                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
02F6                             ; the body"s address instead. Either way it then skips to the matching "]'.
02F6   0A           H_DEF:    LDAX   B   
02F7   03                     INX   B   
02F8   5F                     MOV   E,A   
02F9   E6 DF                  ANI   0DFh   ; fold case
02FB   D6 41                  SUI   "A"   
02FD   FE 1A                  CPI   26   
02FF   D2 11 03               JNC   def2   ; not a letter
0302   7B                     MOV   A,E   
0303   D6 41                  SUI   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
0305   87                     ADD   A   
0306   5F                     MOV   E,A   
0307   16 07                  MVI   D,LETPAGE   ; DE -> cell
0309   79                     MOV   A,C   
030A   12                     STAX   D   
030B   1C                     INR   E   
030C   78                     MOV   A,B   
030D   12                     STAX   D   
030E   C3 CA 02               JMP   skipnx   
0311                DEF2:        
0311                          IF   CHECKED   
                              MOV   A,E   
                              CPI   " "   
                              JNZ   e_brack   ; anything but a letter or a space
0311                          ENDIF      
0311   E5                     PUSH   H   ; an anonymous block: push its address
0312   60                     MOV   H,B   
0313   69                     MOV   L,C   
0314   C3 CA 02               JMP   skipnx   
0317                             ; skip: read past text to the closer at this level, and return it in A.
0317                             ; Brackets of both kinds count together; strings are stepped over whole. A
0317                             ; NUL first ends the program (for "\" with no closer; anything else that runs
0317                             ; into the NUL had unbalanced brackets anyway). D counts the open levels,
0317                             ; starting at 1 for the one we are in.
0317   16 01        SKIP:     MVI   D,1   
0319   0A           SK1:      LDAX   B   
031A   03                     INX   B   
031B   B7                     ORA   A   
031C   CA 00 00               JZ   endprog   
031F   FE 22                  CPI   22h   
0321   CC 43 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
0324   FE 28                  CPI   "("   
0326   CA 3D 03               JZ   sk3   
0329   FE 5B                  CPI   "["   
032B   CA 3D 03               JZ   sk3   
032E   FE 29                  CPI   ")"   
0330   CA 38 03               JZ   sk4   
0333   FE 5D                  CPI   "]"   
0335   C2 19 03               JNZ   sk1   
0338   15           SK4:      DCR   D   
0339   C8                     RZ      ; the closer at this level
033A   C3 19 03               JMP   sk1   
033D   14           SK3:      INR   D   ; an opener: one deeper (the DCR below makes
033E   14                     INR   D   ;   it +1 net, and can't reach zero)
033F   C3 38 03               JMP   sk4   
0342                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0342                             ; the next character, so "/"" does not end it.
0342   03           SS0:      INX   B   
0343   0A           SKIPSTR:   LDAX   B   
0344   03                     INX   B   
0345   FE 2F                  CPI   "/"   
0347   CA 42 03               JZ   ss0   
034A   FE 22                  CPI   22h   
034C   C2 43 03               JNZ   skipstr   
034F   C9                     RET      
0350                             ; =============================================================================
0350                             ;  Console
0350                             ; =============================================================================
0350                             ; 22h pushes the address of the text after it and skips the string.
0350   E5           H_STR:    PUSH   H   
0351   60                     MOV   H,B   
0352   69                     MOV   L,C   
0353   CD 43 03               CALL   skipstr   
0356   D7                     RST   2   
0357                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
0357                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
0357                             ; that character itself.
0357   7E           H_PRINT:   MOV   A,M   
0358   23                     INX   H   
0359   FE 22                  CPI   22h   
035B   CA 72 03               JZ   prdone   
035E   FE 2F                  CPI   "/"   
0360   C2 6C 03               JNZ   pr1   
0363   7E                     MOV   A,M   
0364   23                     INX   H   
0365   FE 40                  CPI   40h   
0367   DA 6C 03               JC   pr1   
036A   E6 BF                  ANI   0BFh   
036C   CD 20 04     PR1:      CALL   putc   
036F   C3 57 03               JMP   h_print   
0372   CF           PRDONE:   RST   1   
0373   7D           H_EMIT:   MOV   A,L   ; "'"
0374   CD 20 04               CALL   putc   
0377   CF                     RST   1   
0378                             ; "#" prints TOS as a signed decimal number, with no space after it.
0378   7C           H_NUM:    MOV   A,H   
0379   B7                     ORA   A   
037A   F2 85 03               JP   num1   
037D   3E 2D                  MVI   A,"-"   
037F   CD 20 04               CALL   putc   
0382   CD F4 01               CALL   neg16   
0385   C5           NUM1:     PUSH   B   
0386   CD 8B 03               CALL   pdec   
0389   C1                     POP   B   
038A   CF                     RST   1   
038B                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
038B   11 0A 00     PDEC:     LXI   D,10   
038E   CD 3B 02               CALL   udiv   ; HL = HL / 10, BC = digit
0391   79                     MOV   A,C   
0392   F5                     PUSH   PSW   
0393   7C                     MOV   A,H   
0394   B5                     ORA   L   
0395   C4 8B 03               CNZ   pdec   
0398   F1                     POP   PSW   
0399   C6 30                  ADI   "0"   
039B   C3 20 04               JMP   putc   
039E                             ; "?" ( n -- c ) or ( -n -- addr )
039E                             ;   n > 0: wait about n ms for a key; 0 if none came
039E                             ;   n = 0: wait for a key
039E                             ;   n < 0: read a line of at most -n characters, with echo. n is not
039E                             ;          checked: the buffer holds 127 characters and the CR, so a
039E                             ;          program must ask for 127 or fewer.
039E   7C           H_KEY:    MOV   A,H   
039F   B7                     ORA   A   
03A0   FA C7 03               JM   line   
03A3   B5                     ORA   L   
03A4   C2 B1 03               JNZ   kt1   
03A7   CD 1E 04     KW:       CALL   getk   ; 0?: wait
03AA   CA A7 03               JZ   kw   
03AD   6F           KT3:      MOV   L,A   
03AE   26 00                  MVI   H,0   
03B0   D7                     RST   2   
03B1   11 28 00     KT1:      LXI   D,MSLOOP   ; one millisecond, roughly
03B4   CD 1E 04     KT2:      CALL   getk   
03B7   C2 AD 03               JNZ   kt3   
03BA   1B                     DCX   D   
03BB   7A                     MOV   A,D   
03BC   B3                     ORA   E   
03BD   C2 B4 03               JNZ   kt2   
03C0   2B                     DCX   H   
03C1   7C                     MOV   A,H   
03C2   B5                     ORA   L   
03C3   C2 B1 03               JNZ   kt1   
03C6   D7                     RST   2   ; time ran out: HL is already 0
03C7                          IF   CPM   
03C7                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
03C7                             ; own line editor). It doesn't store the CR, so it is added here.
03C7   AF           LINE:     XRA   A   
03C8   95                     SUB   L   ; A = the count (TOS is minus the count)
03C9   32 7E 07               STA   LBHDR   
03CC   C5                     PUSH   B   
03CD   11 7E 07               LXI   D,LBHDR   
03D0   0E 0A                  MVI   C,10   
03D2   CD 05 00               CALL   BDOS   
03D5   C1                     POP   B   
03D6   21 7F 07               LXI   H,LBHDR+1   
03D9   7E                     MOV   A,M   ; count (0-127)
03DA   23                     INX   H   ; HL = LINEBUF, whose low byte is 80h:
03DB   E5                     PUSH   H   
03DC   85                     ADD   L   ;   adding the count to L can't carry
03DD   6F                     MOV   L,A   
03DE   36 0D                  MVI   M,13   
03E0   E1                     POP   H   
03E1   D7                     RST   2   
03E2                          ENDIF      
03E2                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     MVI   A,LINEBUF & 0FFh   
                              SUB   L   ; (TOS is minus the count)
                              MOV   D,A   ; D = the L of a full line
                              LXI   H,LINEBUF   
                    LN2:      CALL   getk   
                              JZ   ln2   
                              CPI   13   
                              JZ   ln5   
                              CPI   8   
                              JZ   ln4   
                              MOV   E,A   
                              MOV   A,L   
                              CMP   D   
                              JZ   ln2   ; full
                              MOV   M,E   
                              INR   L   
                              MOV   A,E   
                    LN3:      CALL   putc   
                              JMP   ln2   
                    LN4:      DCR   L   ; Backspace: one back, and echo it,
                              JM   ln3   ;   unless the line was empty (L left the
                              INR   L   ;   upper half of the page)
                              JMP   ln2   
                    LN5:      MOV   M,A   ; the CR
                              MVI   L,LINEBUF & 0FFh   
                              RST   2   
03E2                          ENDIF      
03E2                             ; =============================================================================
03E2                             ;  Machine code: the grave
03E2                             ; =============================================================================
03E2                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
03E2                             ; are stored from addr until a non-hex character; then a RET (C9h) is
03E2                             ; written and its address is left. An odd last digit is consumed and dropped.
03E2                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
03E2                             ; code is entered by CALL with the data stack above the return address; it
03E2                             ; must keep BC, and on return the top cell becomes the new TOS.
03E2   0A           H_GRAVE:   LDAX   B   
03E3   CD 0D 04               CALL   hexval   
03E6   DA 07 04               JC   exec   
03E9   0A           HX1:      LDAX   B   
03EA   CD 0D 04               CALL   hexval   
03ED   DA 04 04               JC   hx2   
03F0   03                     INX   B   
03F1   87                     ADD   A   
03F2   87                     ADD   A   
03F3   87                     ADD   A   
03F4   87                     ADD   A   
03F5   57                     MOV   D,A   
03F6   0A                     LDAX   B   
03F7   CD 0D 04               CALL   hexval   
03FA   DA 04 04               JC   hx2   ; odd digit: already consumed, dropped
03FD   03                     INX   B   
03FE   B2                     ORA   D   
03FF                          IF   CHECKED   
                              CALL   chkst   
03FF                          ENDIF      
03FF   77                     MOV   M,A   
0400   23                     INX   H   
0401   C3 E9 03               JMP   hx1   
0404                HX2:         
0404                          IF   CHECKED   
                              CALL   chkst   
0404                          ENDIF      
0404   36 C9                  MVI   M,0C9h   
0406   D7                     RST   2   
0407   CD 0C 04     EXEC:     CALL   exjmp   ; the code returns here, with its top cell on
040A   E1                     POP   H   ;   the stack: that becomes the new TOS
040B   D7                     RST   2   
040C   E9           EXJMP:    PCHL      
040D                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
040D                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
040D   D6 30        HEXVAL:   SUI   "0"   
040F   FE 0A                  CPI   10   
0411   3F                     CMC      
0412   D0                     RNC      
0413   E6 DF                  ANI   0DFh   
0415   D6 11                  SUI   11h   
0417   FE 06                  CPI   6   
0419   3F                     CMC      
041A   D8                     RC      
041B   C6 0A                  ADI   10   
041D   C9                     RET      
041E                             ; =============================================================================
041E                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
041E                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
041E                             ;  Both keep BC, DE and HL. In the generic build they are the host's KEY and
041E                             ;  CONOUT routines themselves.
041E                             ; =============================================================================
041E                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
041E                          ENDIF      
041E                          IF   CHECKED   
                    GETK:     LDA   KEYBUF   ; a key held back by the break check
                              ORA   A   
                              JZ   gk1   
                              PUSH   PSW   
                              XRA   A   
                              STA   KEYBUF   
                              POP   PSW   
                              RET      
041E                          ENDIF      
041E                          IF   (1-CPM)*CHECKED   
                    GK1:      EQU   KEY   
041E                          ENDIF      
041E                          IF   CPM*(1-CHECKED)   
041E                GETK:        
041E                          ENDIF      
041E                          IF   CPM   
041E   3E FF        GK1:      MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0420                             ; (putc ends with ORA A, for the zero flag)
0420                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0420                             ; printing and could swallow a key that BDOS 6 then never sees.
0420   C5           PUTC:     PUSH   B   
0421   D5                     PUSH   D   
0422   E5                     PUSH   H   
0423   5F                     MOV   E,A   
0424   0E 06                  MVI   C,6   
0426   CD 05 00               CALL   BDOS   
0429   E1                     POP   H   
042A   D1                     POP   D   
042B   C1                     POP   B   
042C   B7                     ORA   A   
042D   C9                     RET      
042E                          ENDIF      
042E                          IFN   CPM   
                    PUTC:     EQU   CONOUT   
042E                          ENDIF      
042E                             ; =============================================================================
042E                             ;  Checked build: break key and error reports
042E                             ; =============================================================================
042E                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   LDA   KEYBUF   
                              ORA   A   
                              RNZ      ; one key is already held
                              CALL   getk   
                              RZ      
                              CPI   3   
                              JZ   e_break   
                              STA   KEYBUF   
                              RET      
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI H (the 21h), so they all fall through to `error`.
                    E_STACK:   MVI   A,"S"   ; data stack over or under
                              DB   21h   
                    E_RSTACK:   MVI   A,"R"   ; return stack over or under
                              DB   21h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C
                              DB   21h   
                    E_HEAP:   MVI   A,"H"   ; heap past the limit
                              DB   21h   
                    E_STORE:   MVI   A,"W"   ; write outside the program's space
                              DB   21h   
                    E_BRACK:   MVI   A,"D"   ; bad character after [
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                    ERROR:    LXI   SP,DSTOP   ; the stacks may be wrecked: start clean
                              CALL   putc   
                              MVI   A," "   
                              CALL   putc   
                              MVI   A,"@"   
                              CALL   putc   
                              MVI   A," "   
                              CALL   putc   
                              LXI   H,(0-PROG-1)&0FFFFh   
                              DAD   B   ; IP - (PROG+1): the character just read
                              CALL   pdec   
                              JMP   endprog   
042E                          ENDIF      
042E                             ; =============================================================================
042E                             ;  Startup
042E                             ; =============================================================================
042E                START:       
042E                          IF   CPM   
042E   31 FE 06               LXI   SP,DSTOP   
0431                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
0431   21 7F 04               LXI   H,stubs   ; RST 08h and RST 10h stubs into page zero
0434   11 08 00               LXI   D,0008h   
0437   06 0C                  MVI   B,12   
0439   7E           CPY:      MOV   A,M   
043A   12                     STAX   D   
043B   23                     INX   H   
043C   13                     INX   D   
043D   05                     DCR   B   
043E   C2 39 04               JNZ   cpy   
0441   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
0444   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
0446   CD 05 00               CALL   BDOS   ;   and the program is empty)
0449   11 00 08               LXI   D,PROG   
044C   D5           LD1:      PUSH   D   
044D   0E 1A                  MVI   C,26   ; set the DMA address
044F   CD 05 00               CALL   BDOS   
0452   11 5C 00               LXI   D,005Ch   
0455   0E 14                  MVI   C,20   ; read the next 128 bytes
0457   CD 05 00               CALL   BDOS   
045A   E1                     POP   H   ; HL = the address this record went to
045B   B7                     ORA   A   
045C   C2 67 04               JNZ   ld2   
045F   11 80 00               LXI   D,128   
0462   19                     DAD   D   
0463   EB                     XCHG      
0464   C3 4C 04               JMP   ld1   
0467   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0469   23                     INX   H   
046A   22 7C 07               SHLD   HEAP   
046D   3A 07 00               LDA   0007h   ; the BDOS page is the heap limit
0470   32 3A 07               STA   HLIM   
0473                          ENDIF      
0473                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
                              SHLD   HEAP   
0473                          ENDIF      
0473                          IF   (1-CPM)*CHECKED   
                              MVI   A,HEAPLIM   
                              STA   HLIM   
0473                          ENDIF      
0473   21 E0 05               LXI   H,RSTOP   
0476   22 34 07               SHLD   RSP   
0479                          IF   CHECKED   
                              XRA   A   
                              STA   KEYBUF   
0479                          ENDIF      
0479   01 00 08               LXI   B,PROG   
047C   C3 03 01               JMP   next0   
047F                          IF   CPM   
047F   D1           STUBS:    POP   D   ; 0008h: drop, then next
0480   E1                     POP   H   
0481   C3 03 01               JMP   next0   
0484                H_DUP:    EQU   000Dh   
0484   E5                     PUSH   H   ; 000Dh: dup
0485   D7                     RST   2   
0486   00                     DB   0   
0487   D1                     POP   D   ; 0010h: next
0488   C3 03 01               JMP   next0   
048B                ENDPROG:   EQU   0   ; warm boot
048B                DROP_NEXT:   EQU   0009h   
048B                             ; RAM pages, after the image
048B                RSPAGE:   EQU   (imgend + 255) / 256   
