0704   0E 1A                  MVI   C,26   ; set the DMA address
0706   CD 05 00               CALL   BDOS   
0709   11 5C 00               LXI   D,005Ch   
070C   0E 14                  MVI   C,20   ; read the next 128 bytes
070E   CD 05 00               CALL   BDOS   
0711   E1                     POP   H   ; HL = the address this record went to
0712   B7                     ORA   A   
0713   C2 1E 07               JNZ   ld2   
0716   11 80 00               LXI   D,128   
0719   19                     DAD   D   
071A   EB                     XCHG      
071B   C3 03 07               JMP   ld1   
