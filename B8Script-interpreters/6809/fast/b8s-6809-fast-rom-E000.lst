E1E1   27 E4                  BEQ   ln2   
E1E3   5A                     DECB      
E1E4   20 F5                  BRA   ln3   ; echo it
E1E6   A7 85        LN5:      STA   B,X   ; A = 13
E1E8   AF C4                  STX   ,U   
E1EA   39                     RTS      
