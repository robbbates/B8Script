0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                FAST:     EQU   1   ; 1 = the speed build (not with EDITOR): see "The speed build"
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QUICK:    EQU   1-(1-FAST)*(CHECKED*CPM*EDITOR+CHECKED*(1-CPM)*(1-EDITOR))   
0000                             ; (1: the speed-ups that cost bytes: every build
0000                             ;  but the two that are full, the checked
0000                             ;  generic one and the checked CP/M editor.
0000                             ;  See "Speed-ups" below)
0000                QUICKU:   EQU   QUICK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the speed build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; IY, and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QUICK builds): the page
0000                             ;   at the heap limit, which the heap never reaches
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
0000                PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
0000                ACHK:     EQU   chkstk   ; (for the speed build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
                    ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
0000                DTPG:     EQU   DTAB/256   ; (the speed build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
                    DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (speed build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (speed build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0000   AF                     XOR   A   ; 00  reset. (This byte, AFh, is also what an
0001                          ENDIF      ;     undefined word runs into: see e_hi.)
0001                          IF   1-EDGEN   
0001   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0004   18 39                  JR   init   ; 04  (the rest of the startup is close by)
0006   00 00                  DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0008                          ENDIF      
0008                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0008                          ENDIF      
0008                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0008                          ENDIF      
0008                          IF   1-CPM   
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   FD 5E 00     RPOP:     LD   E,(IY+0)   ; 08
000B   FD 56 01               LD   D,(IY+1)   
000E   18 1B                  JR   rp2   ; (the rest is at 2Bh)
0010                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0010   C6 21        CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
0012   20 1D                  JR   NZ,next0   ;     the rest are ignored
0014   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0017   00                     NOP      ; 17  spare
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1           DRP:      POP   HL   ;     new TOS = NOS
001A   18 15                  JR   next0   
001C                          ENDIF      
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D                          ;*Macro unroll:  POPR
001D   CF                     DS   1-CPM,0CFh   
001E                          DS   CPM,0CDh   
001E                          DS   CPM,AROP&0FFh   
001E                          DS   CPM,AROP/256   
001E   EB                     EX   DE,HL   
001F                          ;*Macro unroll:  NEXTZ
001F   F7                     DS   1-CPM,0F7h   
0020                          DS   CPM,0DDh   
0020                          DS   CPM,0E9h   
0020                          IF   1-CPM   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
0028                RST28:       
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B   FD 23        RP2:      INC   IY   ; 2B  the rest of rpop
002D   FD 23                  INC   IY   
002F   C9                     RET      
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                          ENDIF      
0031                          IF   CPM   
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; back to c; zero only for NUL
                              JR   NZ,next0   ; the rest are ignored
                    ENDPROG:   JP   EXIT   ; the program has ended
0031                          ENDIF      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                          IF   FAST   
0031                          ;*Macro unroll: next0:  NEXTF                   ; (the speed build: the table dispatcher)
0031   CD           NEXT0:    DS   FAST*CHECKED,0CDh   ; (the speed build: the table dispatcher)
0032   8B                     DS   FAST*CHECKED,ACHK&0FFh   
0033   05                     DS   FAST*CHECKED,ACHK/256   
0034   0A                     DS   FAST,0Ah   
0035   03                     DS   FAST,03h   
0036   EB                     DS   FAST,0EBh   
0037   6F                     DS   FAST,6Fh   
0038   26                     DS   FAST,26h   
0039   10                     DS   FAST,DTPG   
003A   7E                     DS   FAST,7Eh   
003B   24                     DS   FAST,24h   
003C   66                     DS   FAST,66h   
003D   6F                     DS   FAST,6Fh   
003E   E9                     DS   FAST,0E9h   
003F                          ENDIF      
003F                          IF   1-FAST   
                    NEXT0:       
003F                          ENDIF      
003F                          IF   CHECKED*(1-FAST)   
                              CALL   chkstk   ; both stacks are checked once per character
003F                          ENDIF      
003F                          IF   1-FAST   
                              LD   A,(BC)   
                              INC   BC   
                              SUB   21h   ; A = c - 21h
                              JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
                              CP   0Fh   
                              JR   C,punct   ; 21h-2Fh: PTAB index 0-14
                              SUB   0Fh   ; A = c - 30h
                              CP   0Ah   
                              JR   C,digit   ; 30h-39h
                              CP   11h   
                              JR   C,p3a   ; 3Ah-40h
                              SUB   11h   ; A = c - 41h
                              CP   1Ah   
                              JR   C,upper   ; 41h-5Ah: A = letter index 0-25
                              CP   20h   
                              JR   C,p5b   ; 5Bh-60h
                              CP   3Ah   
                              JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
                              CP   3Eh   
003F                          ENDIF      
003F                          IF   (1-CHECKED)*(1-FAST)   
                              JR   NC,next0   ; 7Fh-FFh: ignored
003F                          ENDIF      
003F                          IF   CHECKED*(1-FAST)   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
003F                          ENDIF      
003F                          IF   1-FAST   
                              SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
                    P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
                    P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
003F                          ENDIF      
003F                .macro PTABLE,
003F                             ; 
003F                 DB      h_store & 0FFh  ; !
003F                 DB      h_str & 0FFh    ; "
003F                 DB      h_num & 0FFh    ; #
003F                 DB      h_print & 0FFh  ; $
003F                 DB      h_swap & 0FFh   ; %
003F                 DB      h_and & 0FFh    ; &
003F                 DB      h_emit & 0FFh   ; '
003F                 DB      h_open & 0FFh   ; (
003F                 DB      h_close & 0FFh  ; )
003F                 DB      h_mul & 0FFh    ; *
003F                 DB      h_add & 0FFh    ; +
003F                 DB      h_cfetch & 0FFh ; ,
003F                 DB      h_sub & 0FFh    ; -
003F                 DB      h_cstore & 0FFh ; .
003F                 DB      h_div & 0FFh    ; /
003F                 DB      h_dup & 0FFh    ; :
003F                 DB      h_drop & 0FFh   ; ;
003F                 DB      h_lt & 0FFh     ; <
003F                 DB      h_eq & 0FFh     ; =
003F                 DB      h_gt & 0FFh     ; >
003F                 DB      h_key & 0FFh    ; ?
003F                 DB      h_fetch & 0FFh  ; @
003F                 DB      h_def & 0FFh    ; [
003F                 DB      h_break & 0FFh  ; \
003F                 DB      h_ret & 0FFh    ; ]
003F                 DB      h_xor & 0FFh    ; ^
003F                 DB      h_alloc & 0FFh  ; _
003F                 DB      h_grave & 0FFh  ; `
003F                 DB      h_tor & 0FFh    ; {
003F                 DB      h_or & 0FFh     ; |
003F                 DB      h_fromr & 0FFh  ; }
003F                 DB      h_not & 0FFh    ; ~
003F                .endm
003F                 
003F                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
003F                             ; untouched, and A, DE free.
003F                          IF   1-FAST   
                    PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
                              LD   E,A   
                              LD   D,PTAB / 256   ; (0 if the table is in page zero)
                              CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
                              LD   A,(DE)   
                              LD   E,A   ; the handler's low byte
003F                          ENDIF      
003F                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
                              LD   D,0   
003F                          ENDIF      
003F                          IF   (1-CPM)*(1-FAST)   
                              RL   D   ; its page: 0 + carry
003F                          ENDIF      
003F                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
003F                          ENDIF      
003F                          IF   1-FAST   
                              PUSH   DE   ; jump to it; the stack is balanced again
                              RET      ;   when the handler starts
003F                          ENDIF      
003F                             ; The rest of the startup: here so that the generic reset code can reach it
003F                             ; with JR. st0: find the program's NUL; the heap starts after it.
003F                             ; (The editor build has its own copy of this, next to the editor.)
003F                             ; A checked build first clears the lower half of the letter page (A = 0):
003F                             ; every variable starts at 0, every word cell holds 0000h, the address an
003F                             ; undefined word is caught at (see e_hi), and no key is held back.
003F                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
003F   21 00 82     INIT:     LD   HL,LET   
0042   77           INI1:     LD   (HL),A   
0043   2C                     INC   L   
0044   F2 42 00               JP   P,ini1   ; +00h to +7Fh
0047   01 00 83               LD   BC,PROG   ; the IP
004A                          ENDIF      
004A                          IF   (1-CPM)*(1-EDITOR)   
004A   60           ST0:      LD   H,B   
004B   69                     LD   L,C   
004C   AF                     XOR   A   
004D   BE           ST1:      CP   (HL)   
004E   23                     INC   HL   
004F   20 FC                  JR   NZ,st1   
0051                          ENDIF      
0051                          IF   1-EDITOR   
0051   22 7C 82     ST2:      LD   (HEAP),HL   
0054                          ENDIF      
0054                          IF   CHECKED*(1-EDITOR)   
0054                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
0054   E7                     DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
0055                          DS   CPM,0CDh   
0055                          DS   CPM,ANEG&0FFh   
0055                          DS   CPM,ANEG/256   
0055   22 38 82               LD   (NPEND),HL   ;   release below it
0058                          ENDIF      
0058                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0058                          ENDIF      ;   these)
0058                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0058                          ENDIF      
0058                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0058                          ENDIF      
0058                          IF   1-EDITOR   
0058                          ;*Macro unroll:  SETIX
0058   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0059   21                     DS   CPM+FAST-CPM*FAST,21h   
005A   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
005B   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
005C   FD 21 E0 80            LD   IY,RSTOP   ; the return stack is empty
0060                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0060                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0060   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0061   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0062                          ENDIF      
0062                             ; In the unchecked generic editor build the table is here, in the first
0062                             ; page, which saves loading D twice. (The other builds have no room for it
0062                             ; here: theirs is further down.)
0062                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0062                          ENDIF      
0062                             ; =============================================================================
0062                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0062                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0062                             ;  is here too: it belongs to "`" and makes the page come out right.
0062                             ; =============================================================================
0062   D1           H_XOR:    POP   DE   
0063   7C                     LD   A,H   
0064   AA                     XOR   D   
0065   67                     LD   H,A   
0066   7D                     LD   A,L   
0067   AB                     XOR   E   
0068   6F                     LD   L,A   
0069                          ;*Macro unroll:  NEXT
0069                          DS   (1-CPM)*(1-FAST),0F7h   
0069   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
006A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
006B   D1           H_OR:     POP   DE   
006C   7C                     LD   A,H   
006D   B2                     OR   D   
006E   67                     LD   H,A   
006F   7D                     LD   A,L   
0070   B3                     OR   E   
0071   6F                     LD   L,A   
0072                          ;*Macro unroll:  NEXT
0072                          DS   (1-CPM)*(1-FAST),0F7h   
0072   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0073   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0074                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0074   E7           H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0075                          DS   CPM,0CDh   
0075                          DS   CPM,ANEG&0FFh   
0075                          DS   CPM,ANEG/256   
0075   2B                     DEC   HL   
0076                          ;*Macro unroll:  NEXT
0076                          DS   (1-CPM)*(1-FAST),0F7h   
0076   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0077   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0078                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0078                             ; the same either way); TOS is the old pointer.
0078   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
007C                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
007C                          ENDIF      
007C   19                     ADD   HL,DE   ; the new top
007D                          IF   CHECKED   
007D   CD C2 05               CALL   chkhp   
0080                          ENDIF      
0080   22 7C 82               LD   (HEAP),HL   
0083   EB                     EX   DE,HL   
0084                          ;*Macro unroll:  NEXT
0084                          DS   (1-CPM)*(1-FAST),0F7h   
0084   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0085   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0086                          IF   1-CPM*CHECKED   
0086   FD 22 34 82  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
008A   CD C9 00               CALL   jphl   
008D   FD 2A 34 82            LD   IY,(RSAVE)   
0091                          ;*Macro unroll:  SETIX
0091   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0092   21                     DS   CPM+FAST-CPM*FAST,21h   
0093   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0094   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0095   E1                     POP   HL   
0096                          ;*Macro unroll:  NEXT
0096                          DS   (1-CPM)*(1-FAST),0F7h   
0096   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0097   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0098                          ENDIF      
0098                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
0098                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
0098                             ; Digits: step back onto the first digit and read the whole number.
0098   E5           DIGIT:    PUSH   HL   
0099   0B                     DEC   BC   
009A   CD 7F 03               CALL   rdnum   
009D                          ;*Macro unroll:  NEXT
009D                          DS   (1-CPM)*(1-FAST),0F7h   
009D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
009E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
009F                             ; a-z: push the cell's address (the cell is the variable)
009F                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
009F                          IF   1-QUICKU   
009F   E5           LOWER:    PUSH   HL   
00A0   87                     ADD   A,A   
00A1   6F                     LD   L,A   
00A2   26 82                  LD   H,LETPAGE   
00A4                          ;*Macro unroll:  NEXT
00A4                          DS   (1-CPM)*(1-FAST),0F7h   
00A4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
00A5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
00A6                          ENDIF      
00A6                          IF   QUICKU   
                    LOWER:    JP   lowq   
00A6                          ENDIF      
00A6                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00A6                             ; the return stack, and the IP becomes the address in the letter's cell.
00A6   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00A7   EB                     EX   DE,HL   ; park TOS
00A8   87                     ADD   A,A   
00A9   6F                     LD   L,A   
00AA   26 82                  LD   H,LETPAGE   ; HL -> cell
00AC   4E                     LD   C,(HL)   
00AD   2C                     INC   L   
00AE   46                     LD   B,(HL)   ; IP = the word's body
00AF   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B0                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B0                             ; stack, then next. Everything that pushes the return stack ends here.
00B0                             ; 
00B0                             ; The break key is looked at here, so at every word call and loop-back (and
00B0                             ; block entry and "{"), but only one time in 256: PCNT counts them.
00B0                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
00B0   D1           RPUSHN:   POP   DE   
00B1   FD 72 FF               LD   (IY-1),D   
00B4   FD 73 FE               LD   (IY-2),E   
00B7   FD 2B                  DEC   IY   
00B9   FD 2B                  DEC   IY   
00BB   E5                     PUSH   HL   
00BC   21 36 82               LD   HL,PCNT   
00BF   35                     DEC   (HL)   
00C0   E1                     POP   HL   ; (the zero flag lasts)
00C1   CC 4D 05               CALL   Z,pollk   
00C4                          ;*Macro unroll:  NEXT
00C4                          DS   (1-CPM)*(1-FAST),0F7h   
00C4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
00C5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
00C6                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
00C6   E3           H_TOR:    EX   (SP),HL   
00C7   18 E7                  JR   rpushn   
00C9   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
00CA                             ; ---- machine code: the grave -----------------------------------------------
00CA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00CA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00CA                             ; written and its address is left. An odd last digit is consumed and dropped.
00CA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00CA                             ; code is entered by CALL with the data stack above the return address; it
00CA                             ; must keep BC, and on return the top cell becomes the new TOS.
00CA   CD 01 05     H_GRAVE:   CALL   hexc   
00CD                          IF   1-CPM*CHECKED   
00CD   30 B7                  JR   NC,exec   
00CF                          ENDIF      
00CF                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
00CF                          ENDIF      
00CF   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00D0   CD 01 05               CALL   hexc   
00D3   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00D5   ED 6F                  RLD      ;   overwrites it
00D7   23                     INC   HL   ; ... and RLD shifts it up under the low one
00D8   CD 01 05               CALL   hexc   
00DB   38 F2                  JR   C,hx1   
00DD   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00DF                          ;*Macro unroll:  NEXT
00DF                          DS   (1-CPM)*(1-FAST),0F7h   
00DF   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
00E0   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
00E1                             ; ---- where the two pages meet ----------------------------------------------
00E1                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00E1                             ; are in falling code order for this), and where exactly differs between the
00E1                             ; builds: NPG1 follows. Every handler below these four must start in the
00E1                             ; second page, and every one above in the first; chktab.py checks both.
00E1                             ; "]" returns: pop an address and jump to it.
00E1                          ;*Macro unroll: h_ret:  POPR
00E1   CF           H_RET:    DS   1-CPM,0CFh   
00E2                          DS   CPM,0CDh   
00E2                          DS   CPM,AROP&0FFh   
00E2                          DS   CPM,AROP/256   
00E2   42                     LD   B,D   
00E3   4B                     LD   C,E   
00E4                          ;*Macro unroll: brk1:   NEXT
00E4                BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
00E4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
00E5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
00E6                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00E6                             ; drops the block start, "]" returns. No closer at all ends the program.
00E6   7C           H_BREAK:   LD   A,H   
00E7   B5                     OR   L   
00E8   E1                     POP   HL   
00E9   28 F9                  JR   Z,brk1   
00EB   CD A6 03               CALL   skip   
00EE   B7                     OR   A   ; skip returns 0 for ")"
00EF   20 F0                  JR   NZ,h_ret   
00F1                          ;*Macro unroll: rdrop:  POPR
00F1   CF           RDROP:    DS   1-CPM,0CFh   
00F2                          DS   CPM,0CDh   
00F2                          DS   CPM,AROP&0FFh   
00F2                          DS   CPM,AROP/256   
00F2                          ;*Macro unroll:  NEXT
00F2                          DS   (1-CPM)*(1-FAST),0F7h   
00F2   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
00F3   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
00F4                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00F4                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00F4                             ; the body"s address instead. Either way it then skips to the matching "]'.
00F4                             ; (The unchecked build takes anything that is not a letter as the space; the
00F4                             ; checked build stops on it.)
00F4   0A           H_DEF:    LD   A,(BC)   
00F5   03                     INC   BC   
00F6   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00F8   5F                     LD   E,A   ;   lands 64 bytes up
00F9   E6 DF                  AND   0DFh   ; fold case
00FB   FE 1A                  CP   26   
00FD   30 0B                  JR   NC,def2   ; not a letter
00FF   CB 23                  SLA   E   
0101   16 82                  LD   D,LETPAGE   ; DE -> cell
0103   79                     LD   A,C   
0104   12                     LD   (DE),A   
0105   1C                     INC   E   
0106   78                     LD   A,B   
0107   12                     LD   (DE),A   
0108   18 09                  JR   skipnx   
010A                DEF2:        
010A                          IF   CHECKED   
010A   7B                     LD   A,E   
010B   FE DF                  CP   " "-"A"+256   
010D   C2 FE 05               JP   NZ,e_brack   ; anything but a letter or a space
0110                          ENDIF      
0110   E5                     PUSH   HL   ; an anonymous block: push its address
0111   60                     LD   H,B   
0112   69                     LD   L,C   
0113                SKIPNX:      
0113                          IF   CHECKED   
0113   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0114                          ENDIF      ;   opener, the "[", just before where it starts
0114   CD A6 03     SKIPO:    CALL   skip   
0117                          ;*Macro unroll:  NEXT
0117                          DS   (1-CPM)*(1-FAST),0F7h   
0117   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0118   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0119   5E           H_FETCH:   LD   E,(HL)   ; "@"
011A   23                     INC   HL   
011B   56                     LD   D,(HL)   
011C   EB                     EX   DE,HL   
011D                          ;*Macro unroll:  NEXT
011D                          DS   (1-CPM)*(1-FAST),0F7h   
011D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
011E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
011F                             ; =============================================================================
011F                             ;  Handlers that must start in the image's second page.
011F                             ;  "?" is the last (with "," inside it), so its long tail may run past that
011F                             ;  page.
011F                             ; =============================================================================
011F                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
011F                             ; the matching ")".
011F   7C           H_OPEN:   LD   A,H   
0120   B5                     OR   L   
0121   E1                     POP   HL   
0122   28 F0                  JR   Z,skipo   
0124   C5                     PUSH   BC   ; the block starts at the IP
0125   18 89                  JR   rpushn   
0127                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0127                             ; drops it and carries on.
0127   7C           H_CLOSE:   LD   A,H   
0128   B5                     OR   L   
0129   E1                     POP   HL   
012A   28 C5                  JR   Z,rdrop   
012C                          IF   QUICK   
012C   C3 F0 04               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
012F                          ENDIF      
012F                          IF   1-QUICK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
012F                          ENDIF      
012F                          IF   (1-QUICK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
012F                          ENDIF      
012F                          IF   (1-QUICK)*CPM   
                              JP   rpushn   
012F                          ENDIF      
012F                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
012F                             ; "-" has two jobs: directly before a digit it starts a negative number.
012F   0A           H_SUB:    LD   A,(BC)   
0130   D6 30                  SUB   "0"   
0132   FE 0A                  CP   10   
0134   38 05                  JR   C,negnum   
0136                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0136   E7                     DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0137                          DS   CPM,0CDh   
0137                          DS   CPM,ANEG&0FFh   
0137                          DS   CPM,ANEG/256   
0137   D1           H_ADD:    POP   DE   
0138   19                     ADD   HL,DE   
0139                          ;*Macro unroll:  NEXT
0139                          DS   (1-CPM)*(1-FAST),0F7h   
0139   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
013A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
013B   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
013C   CD 7F 03               CALL   rdnum   
013F                          ;*Macro unroll:  NEGH
013F   E7                     DS   1-CPM,0E7h   
0140                          DS   CPM,0CDh   
0140                          DS   CPM,ANEG&0FFh   
0140                          DS   CPM,ANEG/256   
0140                          ;*Macro unroll:  NEXT
0140                          DS   (1-CPM)*(1-FAST),0F7h   
0140   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0141   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0142   D1           H_AND:    POP   DE   
0143   7C                     LD   A,H   
0144   A2                     AND   D   
0145   67                     LD   H,A   
0146   7D                     LD   A,L   
0147   A3                     AND   E   
0148   6F                     LD   L,A   
0149                          ;*Macro unroll:  NEXT
0149                          DS   (1-CPM)*(1-FAST),0F7h   
0149   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
014A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
014B                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
014B                             ; cells first. Flipping both sign bits turns a signed compare into an
014B                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
014B                             ; carry into -1 or 0 with no branch.
014B   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
014C   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
014D   7C                     LD   A,H   
014E   EE 80                  XOR   80h   
0150   67                     LD   H,A   
0151   7A                     LD   A,D   
0152   EE 80                  XOR   80h   
0154   57                     LD   D,A   
0155   ED 52                  SBC   HL,DE   ; carry if HL < DE
0157   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0159                          ;*Macro unroll:  NEXT
0159                          DS   (1-CPM)*(1-FAST),0F7h   
0159   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
015A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
015B   D1           H_EQ:     POP   DE   
015C   B7                     OR   A   
015D   ED 52                  SBC   HL,DE   
015F   7C                     LD   A,H   
0160   B5                     OR   L   
0161   FE 01                  CP   1   ; carry only if a - b = 0
0163   18 F2                  JR   tf   
0165                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0165                             ; multiplier shifts up through A:C.
0165                          IF   1-QUICK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0165                          ENDIF      
0165                          IF   QUICK   
0165   D1           H_MUL:    POP   DE   ; DE = multiplicand
0166   C3 40 04               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0169                          ENDIF      
0169                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0169                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0169                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0169                             ; stops on it.
0169                H_DIV:       
0169                          IF   CHECKED   
0169   7C                     LD   A,H   
016A   B5                     OR   L   
016B   CA FB 05               JP   Z,e_zero   
016E                          ENDIF      
016E   D1                     POP   DE   ; DE = a, HL = b
016F   D5                     PUSH   DE   ; a, for r's sign
0170   7A                     LD   A,D   
0171   AC                     XOR   H   
0172   F5                     PUSH   AF   ; S flag = sign of q
0173   CB 7C                  BIT   7,H   
0175   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0178   EB                     EX   DE,HL   
0179   CB 7C                  BIT   7,H   
017B   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
017E   CD 7A 02               CALL   udiv   ; HL = q, DE = r
0181   F1                     POP   AF   
0182   FC 20 00               CALL   M,neg16   ; q's sign
0185   EB                     EX   DE,HL   ; HL = r, DE = q
0186   F1                     POP   AF   ; A = a's high byte
0187   B7                     OR   A   
0188   FC 20 00               CALL   M,neg16   ; r's sign
018B   D5                     PUSH   DE   ; q under r
018C                          ;*Macro unroll:  NEXT
018C                          DS   (1-CPM)*(1-FAST),0F7h   
018C   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
018D   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
018E                             ; ---- stack and storage -----------------------------------------------------
018E   E5           H_DUP:    PUSH   HL   ; ":"
018F                          ;*Macro unroll:  NEXT
018F                          DS   (1-CPM)*(1-FAST),0F7h   
018F   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0190   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0191   E3           H_SWAP:   EX   (SP),HL   ; "%"
0192                          ;*Macro unroll:  NEXT
0192                          DS   (1-CPM)*(1-FAST),0F7h   
0192   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0193   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0194                             ; (The checked build tests the address before it takes the value off the
0194                             ; stack, so that an error report shows both.)
0194                H_CSTORE:      ; "." ( c addr -- )
0194                          IF   CHECKED   
0194   CD D7 05               CALL   chkst   
0197                          ENDIF      
0197   D1                     POP   DE   
0198   73                     LD   (HL),E   
0199                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
0199                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
0199   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
019A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
019B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
019C                H_STORE:      ; "!" ( n addr -- )
019C                          IF   CHECKED   
019C   CD D7 05               CALL   chkst   
019F                          ENDIF      
019F   D1                     POP   DE   
01A0   73                     LD   (HL),E   
01A1   23                     INC   HL   
01A2   72                     LD   (HL),D   
01A3                          ;*Macro unroll:  DROP
01A3                          DS   (1-CPM)*(1-FAST),0DFh   
01A3   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
01A4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01A5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01A6                             ; ---- console ---------------------------------------------------------------
01A6                             ; 22h pushes the address of the text after it and skips the string.
01A6   E5           H_STR:    PUSH   HL   
01A7   60                     LD   H,B   
01A8   69                     LD   L,C   
01A9   CD 95 03               CALL   skipstr   
01AC                          IF   CHECKED   
01AC   B7                     OR   A   ; 0: the text ran out before the closing quote
01AD   CA F3 05               JP   Z,e_quote   
01B0                          ENDIF      
01B0                          ;*Macro unroll:  NEXT
01B0                          DS   (1-CPM)*(1-FAST),0F7h   
01B0   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01B1   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01B2                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01B2                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01B2                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01B2                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01B2                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01B2                          ENDIF      
01B2                          IF   CHECKED   
01B2                             ; (The checked build has the loop as a routine, prstr, which the error
01B2                             ; report uses too. The address is kept meanwhile, for a report: it shows
01B2                             ; the stack as it was before the "$". /~ comes back to hp1.)
01B2   22 34 82     H_PRINT:   LD   (RSAVE),HL   
01B5   CD 13 02     HP1:      CALL   prstr   
01B8                          ;*Macro unroll:  DROP
01B8                          DS   (1-CPM)*(1-FAST),0DFh   
01B8   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
01B9   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01BA   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01BB                          ENDIF      
01BB   7D           H_EMIT:   LD   A,L   ; "'"
01BC                          ;*Macro unroll:  PUTA
01BC   EF                     DS   1-CPM,0EFh   
01BD                          DS   CPM,0CDh   
01BD                          DS   CPM,APUT&0FFh   
01BD                          DS   CPM,APUT/256   
01BD                          ;*Macro unroll: pr9:    DROP
01BD                PR9:      DS   (1-CPM)*(1-FAST),0DFh   
01BD   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
01BE   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01BF   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01C0                             ; "#" prints TOS as a signed decimal number, with no space after it.
01C0   CD 13 05     H_NUM:    CALL   psgn   
01C3                          ;*Macro unroll:  DROP
01C3                          DS   (1-CPM)*(1-FAST),0DFh   
01C3   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
01C4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01C5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01C6                             ; "?" ( n -- c ) or ( -n -- addr )
01C6                             ;   n > 0: wait about n ms for a key; 0 if none came
01C6                             ;   n = 0: wait for a key
01C6                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C6                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C6   CB 7C        H_KEY:    BIT   7,H   
01C8   20 1A                  JR   NZ,line   
01CA   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01CC   CD 7B 05     KT2:      CALL   getk   
01CF   20 0E                  JR   NZ,kt3   
01D1   1D                     DEC   E   
01D2   20 F8                  JR   NZ,kt2   
01D4   7C                     LD   A,H   ; 0? never counts down: it waits
01D5   B5                     OR   L   
01D6   28 F2                  JR   Z,kt1   
01D8   2B                     DEC   HL   
01D9   7C                     LD   A,H   
01DA   B5                     OR   L   
01DB   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01DD   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01DE   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DF   6F           KT3:      LD   L,A   
01E0   26 00                  LD   H,0   
01E2                          ;*Macro unroll:  NEXT
01E2                          DS   (1-CPM)*(1-FAST),0F7h   
01E2   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01E3   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01E4                             ; Backspace takes the last character back (and is echoed as it
01E4                             ; is), CR ends (stored, not echoed), every other key is stored and
01E4                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01E4                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01E4                             ; is the place in the line: D holds the L of a full line.
01E4   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E7   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E8   9F                     SBC   A,A   
01E9   A5                     AND   L   ; (0 for a count that is too big)
01EA   2F                     CPL      
01EB   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01EC                             ;   at most
01EC   21 80 82               LD   HL,LINEBUF   
01EF   CD 7B 05     LN2:      CALL   getk   
01F2   28 FB                  JR   Z,ln2   
01F4   FE 0D                  CP   13   
01F6   28 16                  JR   Z,ln5   
01F8   FE 08                  CP   8   
01FA   28 0B                  JR   Z,ln4   
01FC   5F                     LD   E,A   
01FD   7D                     LD   A,L   
01FE   BA                     CP   D   
01FF   28 EE                  JR   Z,ln2   ; full
0201   73                     LD   (HL),E   
0202   2C                     INC   L   
0203   7B                     LD   A,E   
0204                          ;*Macro unroll: ln3:    PUTA
0204   EF           LN3:      DS   1-CPM,0EFh   
0205                          DS   CPM,0CDh   
0205                          DS   CPM,APUT&0FFh   
0205                          DS   CPM,APUT/256   
0205   18 E8                  JR   ln2   
0207   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0208   FA 04 02               JP   M,ln3   ;   unless the line was empty (L left the
020B   2C                     INC   L   ;   upper half of the page)
020C   18 E1                  JR   ln2   
020E   77           LN5:      LD   (HL),A   ; the CR
020F   2E 80                  LD   L,LINEBUF & 0FFh   
0211                          ;*Macro unroll:  NEXT
0211                          DS   (1-CPM)*(1-FAST),0F7h   
0211   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0212   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0213                             ; =============================================================================
0213                             ;  More routines (no handler starts past this point)
0213                             ; =============================================================================
0213                          IF   CHECKED   
0213                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0213                             ; "$", and the texts of the report). A NUL first is an error: Q.
0213   7E           PRSTR:    LD   A,(HL)   
0214   23                     INC   HL   
0215   FE 22                  CP   22h   
0217   C8                     RET   Z   
0218   B7                     OR   A   
0219   CA E9 05               JP   Z,e_dollar   
021C   FE 2F                  CP   "/"   
021E   20 0C                  JR   NZ,prs1   
0220   7E                     LD   A,(HL)   
0221   23                     INC   HL   
0222   FE 60                  CP   60h   
0224   38 04                  JR   C,prs0   
0226   FE 7F                  CP   7Fh   
0228   38 11                  JR   C,pesc   
022A   E6 BF        PRS0:     AND   0BFh   
022C                          ;*Macro unroll: prs1:   PUTA
022C   EF           PRS1:     DS   1-CPM,0EFh   
022D                          DS   CPM,0CDh   
022D                          DS   CPM,APUT&0FFh   
022D                          DS   CPM,APUT/256   
022D   18 E4                  JR   prstr   
022F                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
022F                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
022F                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
022F                             ; pnl: the same, on a new line.
022F   CD 35 02     PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
0232   0D 0A 22               DB   13,10,22h   ;   the caller's text)
0235   E3           PMSG:     EX   (SP),HL   
0236   CD 13 02               CALL   prstr   
0239   E3                     EX   (SP),HL   
023A   C9                     RET      
023B                          ENDIF      
023B                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
023B                             ; HL points past it. Each goes back into the loop that prints the string
023B                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
023B                             ;    /a-/z   print the variable, as "#" does
023B                             ;    /{      clear the screen, the cursor to the top left
023B                             ;    /}      clear from the cursor to the end of the line
023B                             ;    /|  /`  show the cursor, hide it
023B                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
023B   FE 7E        PESC:     CP   7Eh   
023D   28 1C                  JR   Z,pat   
023F   11 13 02               LD   DE,PRLOOP   ; the others return into the loop
0242   D5                     PUSH   DE   
0243   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0245   30 26                  JR   NC,pcon   
0247   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0249   30 2B                  JR   NC,phide   
024B   87                     ADD   A,A   ; the variable's cell
024C   C6 40                  ADD   A,40h   
024E   E5                     PUSH   HL   
024F   6F                     LD   L,A   
0250   26 82                  LD   H,LETPAGE   
0252   7E                     LD   A,(HL)   
0253   2C                     INC   L   
0254   66                     LD   H,(HL)   
0255   6F                     LD   L,A   
0256   CD 13 05               CALL   psgn   
0259   E1                     POP   HL   
025A   C9                     RET      
025B                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
025B                             ; the checked build "$" is the routine prstr: its own return address goes
025B                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
025B                             ; its two cells are there, and is s if not, before it prints anything.
025B                PAT:         
025B                          IF   CHECKED   
025B   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
025C   21 0A 7E               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
025F   39                     ADD   HL,SP   
0260   DA B1 05               JP   C,e_under   
0263   E1                     POP   HL   
0264                          ENDIF      
0264   D1                     POP   DE   ; DE = the column
0265   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0266                          IF   1-ANS   
0266   CD 15 FF               CALL   CONAT   
0269   E1                     POP   HL   
026A   C3 B5 01               JP   PRAGAIN   
026D                             ; With ANSI = 0 the machine's routines do the rest.
026D   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
0270   FE 02                  CP   2   
0272   CA 0F FF               JP   Z,CONEOL   ; /}
0275   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
0276   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0277   C3 12 FF               JP   CONCUR   
027A                          ENDIF      
027A                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    3Bh             ; ';'
                              DS   1-CPM,3Eh   ; ";"
                              DS   1-CPM,3Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Bh   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    48h             ; 'H'
                              DS   1-CPM,3Eh   ; "H"
                              DS   1-CPM,48h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,48h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
027A                          ENDIF      
027A                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
027A                          ENDIF      
027A                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
027A                          ENDIF      
027A                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
027A                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
027A                             ; the quotient bits arrive at the bottom of C.
027A                             ; Dividing by 2 is one shift (the spec wants that fast).
027A                          IF   1-QUICK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
027A                          ENDIF      
027A                          IF   QUICK   
027A                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
027A                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
027A   7A           UDIV:     LD   A,D   
027B   B7                     OR   A   
027C   20 1A                  JR   NZ,uq1   ; 256 and up
027E   B3                     OR   E   
027F   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
0281   3D                     DEC   A   
0282   A3                     AND   E   
0283   20 2F                  JR   NZ,udv0   ; not a power of two
0285   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
0286   3D                     DEC   A   ;   r = L & (2^k - 1)
0287   A5                     AND   L   
0288   F5                     PUSH   AF   
0289   CB 3B        UQ2:      SRL   E   
028B   38 06                  JR   C,uq3   
028D   CB 3C                  SRL   H   
028F   CB 1D                  RR   L   
0291   18 F6                  JR   uq2   
0293   F1           UQ3:      POP   AF   
0294   5F                     LD   E,A   
0295   16 00                  LD   D,0   
0297   C9                     RET      
0298   7B           UQ1:      LD   A,E   
0299   B7                     OR   A   
029A   20 18                  JR   NZ,udv0   
029C   7A                     LD   A,D   
029D   3D                     DEC   A   
029E   A2                     AND   D   
029F   20 13                  JR   NZ,udv0   ; not a power of two
02A1   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
02A2   3D                     DEC   A   ;   r = HL & (2^k - 1)
02A3   A4                     AND   H   
02A4   5F                     LD   E,A   ; (the remainder's high byte,
02A5   7D                     LD   A,L   ;   and its low byte)
02A6   6C                     LD   L,H   
02A7   26 00                  LD   H,0   
02A9   CB 3A        UQ4:      SRL   D   
02AB   38 04                  JR   C,uq5   
02AD   CB 3D                  SRL   L   
02AF   18 F8                  JR   uq4   
02B1   53           UQ5:      LD   D,E   
02B2   5F                     LD   E,A   
02B3   C9                     RET      
02B4                          ENDIF      
02B4                          IF   1-FAST   
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    UDV1:     SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   ; carry is clear here: the remainder
                              JR   NC,udv2   ;   always fits in 16 bits
                              ADD   HL,DE   ; too much: put it back, and cancel the
                              DEC   C   ;   INC below
                    UDV2:     INC   C   ; a quotient bit
                              DJNZ   udv1   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
02B4                          ENDIF      
02B4                          IF   FAST   
02B4                             ; (the speed build: the same 16 rounds, unrolled)
02B4   C5           UDV0:     PUSH   BC   
