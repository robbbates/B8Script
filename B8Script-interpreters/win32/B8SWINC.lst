  1389 00000757 202E2E2E22          <1>         db      ' ...',22h
  1390 0000075C 6A08                <1>         push    8
  1391 0000075E 59                  <1>         pop     ecx
  1392 0000075F E313                <1> .ps1:   jecxz   .ps3                    ; ECX = the number of cells to show
  1393 00000761 B020                <1> .ps2:   mov     al,' '
  1394 00000763 E86FFEFFFF          <1>         call    putc
  1395 00000768 8B048C              <1>         mov     eax,[esp+ecx*4]
  1396 0000076B 51                  <1>         push    ecx
  1397 0000076C E818FEFFFF          <1>         call    psgn
  1398 00000771 59                  <1>         pop     ecx
  1399 00000772 E2ED                <1>         loop    .ps2
  1400 00000774 E856FEFFFF          <1> .ps3:   call    pmsg
  1401 00000779 2F4D2F4A52746E2022  <1>         db      '/M/JRtn ',22h
  1402 00000782 B800FF4000          <1>         mov     eax,RSTOP
  1403 00000787 29F8                <1>         sub     eax,edi
  1404 00000789 C1E802              <1>         shr     eax,2
  1405 0000078C E908FEFFFF          <1>         jmp     pdec
  1406                              <1> %endif
  1407                              <1> 
  1408                              <1> ; =============================================================================
  1409                              <1> ;  The line editor (EDITOR = 1)
  1410                              <1> ;
  1411                              <1> ;  The interpreter starts here, and a program that ends comes back here.
  1412                              <1> ;  There is no prompt. It follows the spec's suggested standard for a line
  1413                              <1> ;  editor (docs/b8script.md, Environments), and is the Z80's editor, key for
  1414                              <1> ;  key. Type a line and press Return:
  1415                              <1> ;
  1416                              <1> ;    n text    put the text in as line n; the lines from n on move down. A
  1417                              <1> ;              number past the end (or 0) adds the line at the end.
  1418                              <1> ;    n         take line n out
  1419                              <1> ;    anything else is run at once, as B8Script. (Start such a line with a
  1420                              <1> ;    space if it would begin with a digit.)
  1421                              <1> ;
  1422                              <1> ;  A command key ends the line too, and takes what was typed as its argument:
  1423                              <1> ;
  1424                              <1> ;    ^G        run the program
  1425                              <1> ;    n ^L      list from line n (no number: all of it). Any key holds the
  1426                              <1> ;              list until another key is pressed; Ctrl-C ends it.
  1427                              <1> ;    n ^E      put line n in the input line; Return puts it back, changed
  1428                              <1> ;    name ^R   read the file of that name (no name: the current one: the
  1429                              <1> ;              one from the command line, or the last one typed)
  1430                              <1> ;    name ^W   write the program to that file (no name: the current one)
  1431                              <1> ;    ^N ^N     new: no program (the key twice in a row)
  1432                              <1> ;    ^V        view: the build, both stacks, and the program's size, lines
  1433                              <1> ;              and free memory
  1434                              <1> ;    ^X        leave
  1435                              <1> ;
  1436                              <1> ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
  1437                              <1> ;  a character goes in at the cursor; Backspace and DEL take out the one
  1438                              <1> ;  before it; Esc drops the line (after Esc it waits 5 ms for a '[': Esc [ C
  1439                              <1> ;  and Esc [ D are right and left too). Only CR, LF, BS and printing
  1440                              <1> ;  characters are sent to the terminal.
  1441                              <1> ;
  1442                              <1> ;  Lines are counted, not numbered. A typed line holds 125 characters; the
  1443                              <1> ;  one character after a line number separates it from the text and is not
  1444                              <1> ;  stored. The text is kept as typed, each line ending in CR LF, at PROG. A
  1445                              <1> ;  file is read up to its first ^Z, and a last line with no line end is
  1446                              <1> ;  given one; it is written as it is, with no padding.
  1447                              <1> ;
  1448                              <1> ;  What lasts from one line to the next: the program, the words, the
  1449                              <1> ;  variables and the data stack (TOS is kept pushed while the editor runs).
  1450                              <1> ;  An error or a break clears both stacks. The return stack starts empty for
  1451                              <1> ;  every line.
  1452                              <1> ;
  1453                              <1> ;  Registers in the editor: EBX = the cursor, EDX = the end of the line
  1454                              <1> ;  (pointers into the line buffer); EDI is free (edit resets it).
  1455                              <1> ; =============================================================================
  1456                              <1> %if EDITOR
  1457                              <1> ; ^F, right arrow: one to the right, by printing the character there
  1458                              <1> right:  cmp     ebx,edx
  1459                              <1>         je      ed1                     ; at the end
  1460                              <1>         mov     al,[ebx]
  1461                              <1>         inc     ebx
  1462                              <1>         jmp     short lf1
  1463                              <1> 
  1464                              <1> ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
  1465                              <1> ; wait about 5 ms for a second key: after a '[' read on to the letter that
  1466                              <1> ; ends the sequence, and act on C (right) and D (left).
  1467                              <1> esc:    push    5
  1468                              <1>         pop     eax
  1469                              <1>         call    waitk
  1470                              <1>         jnz     .es2
  1471                              <1>         call    fin                     ; no second key: the line is dropped
  1472                              <1>         jmp     edit
  1473                              <1> .es2:   cmp     al,'['
  1474                              <1>         jne     ed1                     ; not a sequence known here
  1475                              <1> .es3:   call    ekey
  1476                              <1>         cmp     al,40h
  1477                              <1>         jb      .es3                    ; (its parameters)
  1478                              <1>         sub     al,'C'
  1479                              <1>         je      right
  1480                              <1>         dec     al                      ; 'D'?
  1481                              <1>         jne     ed1                     ; no: on into left
  1482                              <1> ; ^B, left arrow: the cursor goes one to the left
  1483                              <1> left:   cmp     bl,80h
  1484                              <1>         je      ed1                     ; at the start
  1485                              <1>         dec     ebx
  1486                              <1>         mov     al,8
  1487                              <1> lf1:    call    putc
  1488                              <1>         jmp     ed1
  1489                              <1> 
  1490                              <1> ; edit0: an error or a break: both stacks are cleared.
  1491                              <1> ; skend: a program that ended inside skip: its return address goes.
  1492                              <1> ; edend: a program that ended: TOS joins the rest of the data stack.
  1493                              <1> edit0:  mov     esp,[V(v_dstop)]
  1494                              <1>  %if CHECKED
  1495                              <1>         push    -11                     ; the report went to stderr: back to
  1496                              <1>         call    [V(iat_GetStdHandle)]   ;   stdout
  1497                              <1>         mov     [V(v_outh)],eax
  1498                              <1>  %endif
  1499                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1500                              <1> skend:  pop     eax
  1501                              <1> edend:  push    ebx
  1502                              <1> ; edit: start a new input line.
  1503                              <1> edit:   mov     edi,RSTOP               ; the return stack is empty
  1504                              <1>         xor     eax,eax
  1505                              <1>         mov     [ARENA+HELD],ax         ; no key is held, and the break key is on
  1506                              <1>         mov     [V(v_edln)],eax         ; no line is being edited
  1507                              <1>         mov     ebx,ARENA+LINEBUF       ; EBX = the cursor,
  1508                              <1>         mov     edx,ebx                 ;   EDX = the end of the line
  1509                              <1> ed1:    call    ekey
  1510                              <1>         cmp     al,7Fh
  1511                              <1>         je      bsp                     ; DEL
  1512                              <1>         cmp     al,' '
  1513                              <1>         jae     insc
  1514                              <1>         cmp     al,9
  1515                              <1>         je      insc                    ; Tab is text
  1516                              <1>         cmp     al,8
  1517                              <1>         je      bsp
  1518                              <1>         cmp     al,2
  1519                              <1>         je      left                    ; ^B
  1520                              <1>         cmp     al,6
  1521                              <1>         je      right                   ; ^F
  1522                              <1>         cmp     al,1Bh
  1523                              <1>         je      esc
  1524                              <1>         push    edi                     ; a command key? Look it up
  1525                              <1>         mov     edi,ckeys
  1526                              <1>         push    NCMD
  1527                              <1>         pop     ecx
  1528                              <1>         repne   scasb
  1529                              <1>         pop     edi
  1530                              <1>         jne     ed1                     ; no: the key is ignored
  1531                              <1>         movzx   eax,word [ctabr+ecx*2]  ; the command's address: fin returns
  1532                              <1>         add     eax,IB                  ;   to it
  1533                              <1>         push    eax
  1534                              <1> ; fin: end the input line: CR LF and a NUL after it, and a new line on the
  1535                              <1> ; terminal. Leaves ESI -> the line.
  1536                              <1> fin:    mov     word [edx],0A0Dh
  1537                              <1>         mov     esi,edx
  1538                              <1>         call    prl                     ; (prints the CR LF)
  1539                              <1>         mov     byte [esi],0
  1540                              <1>         mov     esi,ARENA+LINEBUF
  1541                              <1>         ret
  1542                              <1> 
  1543                              <1> ; Backspace, DEL: the character before the cursor goes. The cursor moves
  1544                              <1> ; left, the rest of the line moves down over it, and the last place (now a
  1545                              <1> ; space) is printed over along with the rest.
  1546                              <1> bsp:    cmp     bl,80h
  1547                              <1>         je      ed1                     ; at the start
  1548                              <1>         dec     ebx
  1549                              <1>         mov     al,8
  1550                              <1>         call    putc
  1551                              <1>         mov     ecx,ebx
  1552                              <1> .bs1:   mov     al,[ecx+1]
  1553                              <1>         mov     [ecx],al
  1554                              <1>         inc     ecx
  1555                              <1>         cmp     ecx,edx
  1556                              <1>         jne     .bs1
  1557                              <1>         mov     byte [ecx-1],' '
  1558                              <1>         dec     edx
  1559                              <1>         jmp     short ic2
  1560                              <1> ; A character goes in at the cursor: it ripples up through the rest of the
  1561                              <1> ; line, the cursor moves on, and the rest is printed again.
  1562                              <1> insc:   cmp     dl,0FDh
  1563                              <1>         je      ed1                     ; the line is full: 125 characters
  1564                              <1>         call    putc
  1565                              <1>         mov     ecx,ebx
  1566                              <1> .ic1:   xchg    al,[ecx]
  1567                              <1>         inc     ecx
  1568                              <1>         cmp     ecx,edx
  1569                              <1>         jbe     .ic1
  1570                              <1>         inc     ebx
  1571                              <1>         inc     edx
  1572                              <1>         mov     ecx,edx
  1573                              <1> ic2:    call    tail
  1574                              <1>         jmp     ed1
  1575                              <1> ; tail: print the line from the cursor to ECX, and bring the cursor back
  1576                              <1> ; with backspaces. Nothing at all if the cursor is at ECX.
  1577                              <1> tail:   mov     esi,ebx
  1578                              <1> .ta1:   cmp     esi,ecx
  1579                              <1>         je      .ta2
  1580                              <1>         lodsb
  1581                              <1>         call    putc
  1582                              <1>         jmp     .ta1
  1583                              <1> .ta2:   cmp     esi,ebx
  1584                              <1>         je      .ta3
  1585                              <1>         mov     al,8
  1586                              <1>         call    putc
  1587                              <1>         dec     esi
  1588                              <1>         jmp     .ta2
  1589                              <1> .ta3:   ret
  1590                              <1> 
  1591                              <1> ; ekey: wait for a key
  1592                              <1> ekey:   or      eax,-1
  1593                              <1>         jmp     waitk
  1594                              <1> 
  1595                              <1> ; The command keys, and where each goes (after fin). REPNE SCASB leaves ECX
  1596                              <1> ; = the number of keys after the one found, so the table is backwards. (The
  1597                              <1> ; addresses are kept as RVAs, which fit in a word.)
  1598                              <1> ckeys:  db      13, 7, 12, 5, 18, 23, 14, 22, 24
  1599                              <1> NCMD    equ     $-ckeys
  1600                              <1> ctabr:  dw      exit-IB                 ; ^X
  1601                              <1>         dw      cview-IB                   ; ^V
  1602                              <1>         dw      cnew-IB                 ; ^N
  1603                              <1>         dw      cwrite-IB                  ; ^W
  1604                              <1>         dw      cread-IB                   ; ^R
  1605                              <1>         dw      cedln-IB                   ; ^E
  1606                              <1>         dw      clist-IB                   ; ^L
  1607                              <1>         dw      crun-IB                 ; ^G
  1608                              <1>         dw      cret-IB                 ; Return
  1609                              <1> 
  1610                              <1> ; ^N ^N: no program, if the next key is ^N too
  1611                              <1> cnew:   call    ekey
  1612                              <1>         cmp     al,14
  1613                              <1>         jne     gedit
  1614                              <1>         mov     byte [ARENA+PROG],0
  1615                              <1> gedit:  jmp     edit
  1616                              <1> 
  1617                              <1> ; ^E: line n goes into the input line, to be changed. V_EDLN remembers
  1618                              <1> ; which line it was: Return puts the text back in its place.
  1619                              <1> cedln:  call    rdnum
  1620                              <1>         movzx   eax,dx
  1621                              <1>         push    eax
  1622                              <1>         call    find                    ; EDI -> the line, or the NUL
  1623                              <1>         pop     eax
  1624                              <1>         cmp     byte [edi],0
  1625                              <1>         je      gedit
  1626                              <1>         mov     [V(v_edln)],eax
  1627                              <1>         mov     ebx,ARENA+LINEBUF
  1628                              <1> .ce1:   mov     al,[edi]                ; copy it, and show it, up to its CR
  1629                              <1>         cmp     al,13                   ;   (or LF)
  1630                              <1>         je      .ce2
  1631                              <1>         cmp     al,10
  1632                              <1>         je      .ce2
  1633                              <1>         mov     [ebx],al
  1634                              <1>         call    putc
  1635                              <1>         inc     edi
  1636                              <1>         inc     ebx
  1637                              <1>         cmp     bl,0FDh                 ; (a longer line is cut at 125)
  1638                              <1>         jne     .ce1
  1639                              <1> .ce2:   mov     edx,ebx                 ; the cursor is at the line's end
  1640                              <1>         jmp     ed1
  1641                              <1> 
  1642                              <1> ; Return. If ^E put a line here, the text goes back in its place. If not:
  1643                              <1> ; a number and text is a line to put in, a number alone a line to take out,
  1644                              <1> ; and anything else is run where it is.
  1645                              <1> cret:   push    edx                     ; the end of what was typed
  1646                              <1>         mov     eax,[V(v_edln)]
  1647                              <1>         test    eax,eax
  1648                              <1>         jz      .cr1
  1649                              <1>         push    eax
  1650                              <1>         call    delln
  1651                              <1>         pop     eax
  1652                              <1>         jmp     short ins
  1653                              <1> .cr1:   call    rdnum                   ; DX = the number it starts with
  1654                              <1>         mov     eax,esi                 ; ESI's low byte is still 80h if there
  1655                              <1>         cmp     al,80h                  ;   was no number:
  1656                              <1>         je      runln                   ;   then run the line
  1657                              <1>         movzx   eax,dx
  1658                              <1>         cmp     byte [esi],13
  1659                              <1>         jne     .cr2
  1660                              <1>         pop     edx                     ; the number alone: take that line out
  1661                              <1>         call    delln
  1662                              <1>         jmp     gedit
  1663                              <1> .cr2:   inc     esi                     ; step over the one character after it
  1664                              <1> 
  1665                              <1> ; Put the text at ESI in as line EAX: open a gap of its length there, CR
  1666                              <1> ; and LF included, and copy it in.
  1667                              <1> ins:    call    find                    ; EDI -> where it goes
  1668                              <1>         pop     ecx                     ; the end of what was typed
  1669                              <1>         inc     ecx
  1670                              <1>         inc     ecx
  1671                              <1>         sub     ecx,esi                 ; the length, with its CR LF
  1672                              <1>         push    esi                     ; the text
  1673                              <1>         push    ecx                     ; its length
  1674                              <1>         push    edi                     ; where it goes
  1675                              <1>         mov     esi,edi
  1676                              <1> .in1:   lodsb                           ; find the program's NUL
  1677                              <1>         test    al,al
  1678                              <1>         jnz     .in1
  1679                              <1>         dec     esi
  1680                              <1>         mov     ecx,esi
  1681                              <1>         sub     ecx,edi
  1682                              <1>         inc     ecx                     ; the bytes to move up, NUL included
  1683                              <1>         mov     edi,esi
  1684                              <1>         add     edi,[esp+4]             ; the NUL's new place
  1685                              <1>         std
  1686                              <1>         rep     movsb                   ; move the rest of the program up
  1687                              <1>         cld
  1688                              <1>         pop     edi
  1689                              <1>         pop     ecx
  1690                              <1>         pop     esi
  1691                              <1>         rep     movsb
  1692                              <1>         jmp     gedit
  1693                              <1> 
  1694                              <1> ; ^G: run the program. runln: run the typed line (ESI -> it).
  1695                              <1> crun:   mov     esi,ARENA+PROG
  1696                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1697                              <1> runln:   pop     eax                     ; (the end of what was typed)
  1698                              <1> %endif
  1699                              <1> ; run0: start running at ESI. The heap starts after the stored program's
  1700                              <1> ; NUL. TOS is popped: the data stack is as the last line left it.
  1701 00000791 BA00024100          <1> run0:    mov     edx,ARENA+PROG
  1702 00000796 42                  <1> .st1:   inc     edx
  1703 00000797 807AFF00            <1>         cmp     byte [edx-1],0
  1704 0000079B 75F9                <1>         jne     .st1
  1705 0000079D 6689157C014100      <1>         mov     [ARENA+HEAP],dx
  1706                              <1> %if CHECKED
  1707 000007A4 0FB7C2              <1>         movzx   eax,dx                  ; '_' may not release below this
  1708 000007A7 894570              <1>         mov     [V(v_npend)],eax
  1709                              <1> %endif
  1710 000007AA 5B                  <1>         pop     ebx
  1711 000007AB FFE5                <1>         jmp     ebp
  1712                              <1> 
  1713                              <1> %if EDITOR
  1714                              <1> ; ^L: list from line n. EDX = the number of the line at ESI.
  1715                              <1> clist:  call    rdnum                   ; DX = n, or 0 if there was none:
  1716                              <1>         movzx   eax,dx
  1717                              <1>         test    eax,eax
  1718                              <1>         jnz     .li0
  1719                              <1>         inc     eax                     ;   then from line 1
  1720                              <1> .li0:   push    eax
  1721                              <1>         call    find
  1722                              <1>         pop     edx
  1723                              <1>         mov     esi,edi
  1724                              <1> .li1:   cmp     byte [esi],0
  1725                              <1>         je      gedit                   ; the end of the text
  1726                              <1>         xor     eax,eax
  1727                              <1>         call    waitk
  1728                              <1>         jz      .li3                    ; no key: carry on
  1729                              <1>         cmp     al,3
  1730                              <1>         je      gedit                   ; Ctrl-C ends the list,
  1731                              <1>         call    ekey                    ;   any other key holds it until the
  1732                              <1>         cmp     al,3                    ;   next (and a Ctrl-C then ends it)
  1733                              <1>         je      gedit
  1734                              <1> .li3:   push    edx
  1735                              <1>         xchg    eax,edx
  1736                              <1>         call    pdec                    ; the line's number,
  1737                              <1>         mov     al,' '
  1738                              <1>         call    putc                    ;   a space,
  1739                              <1>         pop     edx
  1740                              <1>         inc     edx
  1741                              <1>         call    prl                     ;   and the line
  1742                              <1>         jmp     .li1
  1743                              <1> 
  1744                              <1> ; ^V: view.
  1745                              <1> cview:  call    pmsg
  1746                              <1>  %if CHECKED
  1747                              <1>         db      'B8SWINEC 2026-11-21',22h
  1748                              <1>  %else
  1749                              <1>         db      'B8SWINE 2026-11-21',22h
  1750                              <1>  %endif
  1751                              <1>         call    pstk                    ; both stacks
  1752                              <1>         mov     edi,ARENA+PROG
  1753                              <1>         or      ecx,-1
  1754                              <1> .cv1:   inc     ecx                     ; count the lines, and find the end
  1755                              <1>         call    nxl
  1756                              <1>         jnz     .cv1
  1757                              <1>         push    ecx
  1758                              <1>         call    pmsg
  1759                              <1>         db      '/M/JProg ',22h
  1760                              <1>         lea     eax,[edi-(ARENA+PROG)]
  1761                              <1>         call    pdec                    ; the program's size
  1762                              <1>         call    pmsg
  1763                              <1>         db      '/M/JLines ',22h
  1764                              <1>         pop     eax
  1765                              <1>         call    pdec
  1766                              <1>         call    pmsg
  1767                              <1>         db      '/M/JFree ',22h
  1768                              <1>         mov     eax,ARENA+LIMIT-1
  1769                              <1>         sub     eax,edi
  1770                              <1>         call    pdec                    ; the room left for text and heap
  1771                              <1>         call    pmsg
  1772                              <1>         db      '/M/J',22h
  1773                              <1>         jmp     gedit
  1774                              <1> 
  1775                              <1> ; delln: take line EAX out: copy everything after it down over it. Keeps ESI.
  1776                              <1> delln:  push    esi
  1777                              <1>         call    find
  1778                              <1>         push    edi
  1779                              <1>         call    nxl                     ; EDI -> the next line
  1780                              <1>         mov     esi,edi
  1781                              <1>         pop     edi
  1782                              <1> .de1:   lodsb
  1783                              <1>         stosb
  1784                              <1>         test    al,al
  1785                              <1>         jnz     .de1
  1786                              <1>         pop     esi
  1787                              <1>         ret
  1788                              <1> 
  1789                              <1> ; find: EAX = a line number. Returns EDI -> that line, or -> the NUL at the
  1790                              <1> ; end of the text if there are fewer lines (or the number is 0). Keeps ESI.
  1791                              <1> find:   xchg    eax,ecx
  1792                              <1>         mov     edi,ARENA+PROG
  1793                              <1> .fi1:   dec     cx
  1794                              <1>         jz      .fi2
  1795                              <1>         call    nxl
  1796                              <1>         jnz     .fi1
  1797                              <1> .fi2:   ret
  1798                              <1> 
  1799                              <1> ; nxl: step EDI over one line, to just past its LF (and return not-zero),
  1800                              <1> ; or stop at the NUL that ends the text (and return zero).
  1801                              <1> nxl:    mov     al,[edi]
  1802                              <1>         test    al,al
  1803                              <1>         jz      .nx1
  1804                              <1>         inc     edi
  1805                              <1>         cmp     al,10
  1806                              <1>         jne     nxl
  1807                              <1>         test    al,al
  1808                              <1> .nx1:   ret
  1809                              <1> 
  1810                              <1> ; prl: print the line at ESI, to its LF; ESI -> just past it.
  1811                              <1> prl:    lodsb
  1812                              <1>         call    putc
  1813                              <1>         cmp     al,10
  1814                              <1>         jne     prl
  1815                              <1>         ret
  1816                              <1> 
  1817                              <1> ; ^R: read the file. ^W: write the file (made anew, or emptied first). A
  1818                              <1> ; name typed before the key is the file's name from now on. (A file that
  1819                              <1> ; can't be made or written is not noticed: nothing is written.)
  1820                              <1> cread:  call    setname
  1821                              <1>         call    load
  1822                              <1>         jmp     gedit
  1823                              <1> cwrite: call    setname
  1824                              <1>         mov     edi,ARENA+PROG
  1825                              <1>         xor     eax,eax
  1826                              <1>         or      ecx,-1
  1827                              <1>         repne   scasb
  1828                              <1>         not     ecx
  1829                              <1>         dec     ecx                     ; the length of the text
  1830                              <1>         push    ecx
  1831                              <1>         push    eax                     ; hTemplateFile
  1832                              <1>         push    eax                     ; dwFlagsAndAttributes
  1833                              <1>         push    2                       ; CREATE_ALWAYS
  1834                              <1>         push    eax                     ; lpSecurityAttributes
  1835                              <1>         push    eax                     ; no sharing
  1836                              <1>         push    40000000h               ; GENERIC_WRITE
  1837                              <1>         push    NAMEBUF
  1838                              <1>         call    [V(iat_CreateFileA)]
  1839                              <1>         pop     ecx
  1840                              <1>         push    eax                     ; (for CloseHandle)
  1841                              <1>         push    0
  1842                              <1>         lea     edx,[V(v_cnt)]
  1843                              <1>         push    edx
  1844                              <1>         push    ecx
  1845                              <1>         push    ARENA+PROG
  1846                              <1>         push    eax
  1847                              <1>         call    [V(iat_WriteFile)]
  1848                              <1>         call    [V(iat_CloseHandle)]
  1849                              <1>         jmp     gedit
  1850                              <1> 
  1851                              <1> ; setname: if a name was typed (the line does not start with its CR), it is
  1852                              <1> ; the file's name from now on, as typed (a Windows path).
  1853                              <1> setname:mov     esi,ARENA+LINEBUF
  1854                              <1>         cmp     byte [esi],13
  1855                              <1>         je      .sn2
  1856                              <1>         mov     edi,NAMEBUF
  1857                              <1> .sn1:   lodsb
  1858                              <1>         cmp     al,13
  1859                              <1>         jne     .sn3
  1860                              <1>         mov     al,0
  1861                              <1> .sn3:   stosb
  1862                              <1>         test    al,al
  1863                              <1>         jnz     .sn1
  1864                              <1> .sn2:   ret
  1865                              <1> %endif
