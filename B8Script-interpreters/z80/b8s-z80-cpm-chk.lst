056A   69                     LD   L,C   
056B   29                     ADD   HL,HL   
056C   39                     ADD   HL,SP   ; HL -> just above the deepest of them
056D   0C                     INC   C   
056E   0D           ER7:      DEC   C   
056F   28 11                  JR   Z,er8   
0571   2B                     DEC   HL   
0572   56                     LD   D,(HL)   
0573   2B                     DEC   HL   
0574   5E                     LD   E,(HL)   
0575   E5                     PUSH   HL   
0576   C5                     PUSH   BC   
0577   3E 20                  LD   A," "   
0579   EF                     RST   28h   
057A   EB                     EX   DE,HL   
057B   CD 99 03               CALL   psgn   
057E   C1                     POP   BC   
057F   E1                     POP   HL   
0580   18 EC                  JR   er7   
0582   CD 89 04     ER8:      CALL   pnl   
0585   52 74 6E 20 22         DB   "Rtn ",22h   
058A   D9                     EXX      
058B   E5                     PUSH   HL   
058C   D9                     EXX      
058D   D1                     POP   DE   
058E   21 E0 06               LD   HL,RSTOP   
0591   B7                     OR   A   
0592   ED 52                  SBC   HL,DE   
0594   CD 9E 05               CALL   phalf   
0597   CD 89 04               CALL   pnl   
059A   22                     DB   22h   
059B   C3 15 01               JP   endprog   
059E                             ; phalf: print half of HL, and leave it in C
059E   CB 3C        PHALF:    SRL   H   
05A0   CB 1D                  RR   L   
05A2   E5                     PUSH   HL   
05A3   CD A1 03               CALL   pdec   
05A6   C1                     POP   BC   
05A7   C9                     RET      
05A8                          ENDIF      
05A8                             ; =============================================================================
05A8                             ;  The line editor (EDITOR = 1)
05A8                             ; 
05A8                             ;  The interpreter starts here, and a program that ends comes back here. Type
05A8                             ;  a line and press Return:
05A8                             ; 
05A8                             ;    n text    put the text in as line n; the lines from n on move down.
05A8                             ;              A number past the end, or 0, adds the line at the end.
05A8                             ;    n         take line n out
05A8                             ;    0         run the program
05A8                             ;    -n        list the program from line n on (-1 lists all of it). Any key
05A8                             ;              stops the list until another key is pressed; Ctrl-C ends it.
05A8                             ;    anything else is run at once, as B8Script. (Start such a line with a
05A8                             ;    space if it would begin with a digit or a minus sign.)
05A8                             ; 
05A8                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
05A8                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
05A8                             ;  125 characters, the line number and the one character after it included;
05A8                             ;  that character is not stored. The text is kept as it is typed, each line
05A8                             ;  ending in CR LF, at PROG. Nothing is checked.
05A8                             ; 
05A8                             ;  With CPM = 1 the file named on the command line is the program to start
05A8                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
05A8                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
05A8                             ;  CP/M. Nothing is written back: there is no command to save.
05A8                             ; 
05A8                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
05A8                             ;  its report and comes back here, with both stacks empty. The place is a
05A8                             ;  line and column of the program; in a line typed here it is line 0.
05A8                             ; 
05A8                             ;  Things to know:
05A8                             ;    - Reset empties the program (generic builds).
05A8                             ;    - Words and variables last from one line to the next. A word's address
05A8                             ;      points into the program, so run the program again after editing it.
05A8                             ;    - Nothing is printed between a program's output and what is typed next.
05A8                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
05A8                             ;      a line that calls -n? and carries on afterwards runs what was typed.
05A8                             ;      (The stored program never comes back to the line, so it may.)
05A8                             ; =============================================================================
05A8                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
05A8                          ENDIF      
05A8                          IF   EDITOR   
                                 ; -n: list from line n. DE = the number of the line at HL.
                    LIST:     INC   BC   
                              CALL   rdnum   ; HL = n
                              PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,edit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,edit   ; Ctrl-C
                    LI2:      CALL   rawk   ; any other key: wait for one more
                              JR   Z,li2   
                              CP   3   
                              JR   Z,edit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; Take line n (in HL) out: copy everything after it down over it.
                    DEL:      CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
                              XOR   A   ; a key that the break check held while the
                              LD   (KEYBUF),A   ;   program ran is let go (the Ctrl-C that
05A8                          ENDIF      ;   stopped it, for one)
05A8                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
05A8                          ENDIF      
05A8                          IF   EDITOR*CPM   
                              LD   A,125   
05A8                          ENDIF      
05A8                          IF   EDITOR   
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   
                              CALL   prl   ; (print the CR LF: a new line)
                              LD   (HL),0   ;   and a NUL after that
                              PUSH   HL   ; the end of what was typed
                              LD   BC,LINEBUF   
                              LD   A,(BC)   
                              CP   "-"   
                              JR   Z,list   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0   ; no number: run the line where it is
                              LD   A,(BC)   
                              SUB   13   
                              JR   NZ,ins   ; text follows the number
                              OR   H   ; the number alone:
                              OR   L   
                              JR   NZ,del   ;   not 0: take that line out
                              LD   BC,PROG   ;   0: run the program
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
                              XOR   A   
                              LD   H,A   ; no key is held, and the break key is on: a
                              LD   L,A   ;   key left over from the last run is let go
                              LD   (KEYBUF),HL   
                              LD   HL,PROG   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
05A8                          ENDIF      
05A8                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
05A8                          ENDIF      
05A8                          IF   EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; Put the typed text in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              INC   BC   ; step over the one character after the number
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                              JR   edit   
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
05A8                          ENDIF      
05A8                             ; =============================================================================
05A8                             ;  CP/M startup (the generic build starts at address 0: see st0)
05A8                             ; =============================================================================
05A8                          IF   CPM   
05A8                             ; The RAM pages follow the image; the heap may grow to the BDOS.
05A8                START:       
05A8                          ENDIF      
05A8                          IF   CPM*CHECKED   
05A8                             ; Clear the lower half of the letter page: every variable starts at
05A8                             ; 0, every word cell holds 0000h, the address an undefined word is
05A8                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
05A8                             ; is held back.
05A8   21 00 08               LD   HL,LET   
05AB   AF                     XOR   A   
05AC   77           INI1:     LD   (HL),A   
05AD   2C                     INC   L   
05AE   F2 AC 05               JP   P,ini1   ; +00h to +7Fh
05B1                          ENDIF      
05B1                          IF   CPM   
05B1   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
05B4   11 08 00               LD   DE,0008h   
05B7   01 2C 00               LD   BC,vecend-vecs   
05BA   ED B0                  LDIR      
05BC   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
05BF   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
05C1   CD 05 00               CALL   BDOS   ;   and the program is empty)
05C4   11 00 09               LD   DE,PROG   
05C7   D5           LD1:      PUSH   DE   
05C8   0E 1A                  LD   C,26   ; set the DMA address
05CA   CD 05 00               CALL   BDOS   
05CD   11 5C 00               LD   DE,005Ch   
05D0   0E 14                  LD   C,20   ; read the next 128 bytes
05D2   CD 05 00               CALL   BDOS   
05D5   E1                     POP   HL   ; HL = the address this record went to
05D6   B7                     OR   A   
05D7   20 07                  JR   NZ,ld2   
05D9   11 80 00               LD   DE,128   
05DC   19                     ADD   HL,DE   
05DD   EB                     EX   DE,HL   
05DE   18 E7                  JR   ld1   
05E0                LD2:         
05E0                          ENDIF      
05E0                          IF   CPM*(1-EDITOR)   
05E0   36 00                  LD   (HL),0   ; the end of the file counts as NUL
05E2   23                     INC   HL   ; the heap starts after it
05E3   01 00 09               LD   BC,PROG   ; the IP
05E6   C3 76 01               JP   st2   
05E9                          ENDIF      
05E9                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
05E9                          ENDIF      
05E9                          IF   CPM   
05E9                             ; RAM pages, after the image
05E9                RSPAGE:   EQU   (imgend + 255) / 256   
05E9                DSPAGE:   EQU   RSPAGE + 1   
05E9                LETPAGE:   EQU   RSPAGE + 2   
05E9                PROG:     EQU   LETPAGE*256 + 256   
05E9                          ENDIF      
05E9                IMGEND:      


