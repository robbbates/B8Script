063D                          IF   CPM   
063D                             ; RAM pages, after the image
063D                CPAGE:    EQU   (imgend + 255) / 256   ; the skip cache (QK builds), first, so
063D                RSPAGE:   EQU   CPAGE + QK   ;   that the letter page is still the one
063D                DSPAGE:   EQU   RSPAGE + 1   ;   just below the program text
063D                LETPAGE:   EQU   RSPAGE + 2   
063D                PROG:     EQU   LETPAGE*256 + 256   
063D                          ENDIF      
063D                IMGEND:      


