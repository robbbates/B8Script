E27F   D0 02                  BNE   tg1   
E281   F6 01                  INC   1,X   
E283   60           TG1:      RTS      
E284                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E284                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E284                             ; the body"s address instead. Either way it then skips to the matching "]'.
E284                             ; (The unchecked build takes anything that is not a letter as the space; the
E284                             ; checked build stops on it.)
E284                          IF   CHECKED   
E284   C0 DF        DEF1:     CPY   #" "-"A"+256   
E286   F0 27                  BEQ   def2   
E288                             ; W: anything but a letter or a space after [. The place is that character,
E288                             ; one past the [.
E288   E6 08                  INC   PLACE   
E28A   D0 02                  BNE   eb1   
E28C   E6 09                  INC   PLACE+1   
E28E   A9 57        EB1:      LDA   #"W"   
E290   4C A3 E6               JMP   error   
E293                          ENDIF      
E293   20 89 E6     H_DEF:    JSR   getc   
E296   38                     SEC      
E297   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E299   A8                     TAY      ;   lands 64 bytes up
E29A   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E29C   C9 1A                  CMP   #26   
E29E                          IF   1-CHECKED   
                              BCS   def2   ; not a letter
E29E                          ENDIF      
E29E                          IF   CHECKED   
E29E   B0 E4                  BCS   def1   
E2A0                          ENDIF      
E2A0   98                     TYA      
E2A1   0A                     ASL      
E2A2   A8                     TAY      ; Y -> the cell
E2A3   A5 00                  LDA   IP   
E2A5   99 00 04               STA   LET,Y   
E2A8   A5 01                  LDA   IP+1   
E2AA   99 01 04               STA   LET+1,Y   
E2AD   D0 03                  BNE   dsk   ; always: no program is in page zero
E2AF   20 06 E6     DEF2:     JSR   puship   ; an anonymous block: push its address
E2B2                DSK:         
E2B2                          IF   CHECKED   
E2B2   A9 29                  LDA   #")"   ; the wrong closer for [
E2B4                          ENDIF      
E2B4   4C 9E E3               JMP   skip   
E2B7                             ; ---- machine code: the grave
E2B7                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E2B7                             ; are stored from addr until a non-hex character; then a RET (60h) is
E2B7                             ; written and its address is left. An odd last digit is consumed and dropped.
E2B7                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E2B7                             ; contract in the header.
E2B7   20 78 E6     H_GRAVE:   JSR   rdhex   
E2BA   B0 1C                  BCS   exec   
E2BC   0A           HX1:      ASL      
E2BD   0A                     ASL      
E2BE   0A                     ASL      
E2BF   0A                     ASL      
E2C0   85 04                  STA   T0   
E2C2   20 78 E6               JSR   rdhex   
E2C5   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E2C7   05 04                  ORA   T0   
E2C9   81 00                  STA   (0,X)   ; (never checked)
E2CB   20 7D E2               JSR   inctos   
E2CE   20 78 E6               JSR   rdhex   
