E276   85 02                  STA   TL   
E278   BD 00 03               LDA   DSH,X   
E27B   45 03                  EOR   TH   
E27D   90 15                  BCC   fin   ; always
E27F                             ; "-" has two jobs: directly before a digit it starts a negative number.
E27F   20 FC E1     H_SUB:    JSR   isdig   
E282   90 14                  BCC   negnum   
E284   20 A5 E2     SUB1:     JSR   neg   ; a - b = a + (-b)
E287   18           H_ADD:    CLC      
E288   BD 00 02               LDA   DSL,X   
E28B   65 02                  ADC   TL   
E28D   85 02                  STA   TL   
E28F   BD 00 03               LDA   DSH,X   
E292   65 03                  ADC   TH   ; falls into fin
E294                             ; fin: finish a two-operand op: A = the high byte of the result
E294   85 03        FIN:      STA   TH   
E296   E8                     INX      
E297   60                     RTS      
E298   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E29A   20 F0 E0               JSR   digit   ; (comes back with the carry set)
E29D   B0 06                  BCS   neg   ; always: the number, negated
E29F                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E29F   90 05        H_NOT:    BCC   neg1   ; always
E2A1                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E2A1   A5 03        ABSV:     LDA   TH   
E2A3   10 0D        NEGM:     BPL   ab9   
E2A5                             ; neg: TOS = -TOS
E2A5   38           NEG:      SEC      
E2A6   A9 00        NEG1:     LDA   #0   
E2A8   E5 02                  SBC   TL   
E2AA   85 02                  STA   TL   
E2AC   A9 00                  LDA   #0   
E2AE   E5 03                  SBC   TH   
E2B0   85 03                  STA   TH   
E2B2   60           AB9:      RTS      
E2B3                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E2B3                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E2B3   20 04 E3     H_GT:     JSR   h_swap   ; a > b is b < a
E2B6   20 BC E2     H_LT:     JSR   scmp   
E2B9   E8                     INX      ; (keeps the carry; never leaves X at 0)
E2BA   D0 17                  BNE   bool   ; always
E2BC                             ; scmp: the carry clear if NOS < TOS (signed). `< and `> use it too.
E2BC   BD 00 02     SCMP:     LDA   DSL,X   
E2BF   C5 02                  CMP   TL   
E2C1   BD 00 03               LDA   DSH,X   
E2C4   E5 03                  SBC   TH   
E2C6   70 02                  BVS   lt1   
E2C8   49 80                  EOR   #80h   
E2CA   0A           LT1:      ASL      
E2CB   60                     RTS      
E2CC   20 84 E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E2CF   05 02                  ORA   TL   
E2D1   C9 01                  CMP   #1   ; carry clear if A = 0
E2D3   A9 00        BOOL:     LDA   #0   
E2D5   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E2D7   85 02                  STA   TL   
E2D9   85 03                  STA   TH   
E2DB   60                     RTS      
E2DC                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E2DC                             ; bottom while the product comes in at the top, through A:T0 above it; after
E2DC                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E2DC   A0 10        H_MUL:    LDY   #16   
E2DE   84 05                  STY   T1   ; the round count
E2E0   A9 00                  LDA   #0   
E2E2   85 04                  STA   T0   ; A:T0 = the upper half
E2E4   46 03                  LSR   TH   
E2E6   66 02                  ROR   TL   ; the first multiplier bit
E2E8   90 0D        ML1:      BCC   ml2   
E2EA   A8                     TAY      
E2EB   18                     CLC      
E2EC   A5 04                  LDA   T0   
E2EE   7D 00 02               ADC   DSL,X   
E2F1   85 04                  STA   T0   
E2F3   98                     TYA      
E2F4   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E2F7   6A           ML2:      ROR      
E2F8   66 04                  ROR   T0   
E2FA   66 03                  ROR   TH   
E2FC   66 02                  ROR   TL   ; everything one place right; next bit out
E2FE   C6 05                  DEC   T1   
E300   D0 E6                  BNE   ml1   
E302   E8                     INX      ; drop the multiplicand
E303   60                     RTS      
E304   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E307   A5 02                  LDA   TL   
E309   9D 00 02               STA   DSL,X   
E30C   84 02                  STY   TL   
E30E   BC 00 03               LDY   DSH,X   
E311   A5 03                  LDA   TH   
E313   9D 00 03               STA   DSH,X   
E316   84 03                  STY   TH   
E318   60                     RTS      
E319                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E319                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E319                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E319                             ; it stops with Z.
E319                H_DIV:       
E319                          IF   CHECKED   
                              LDA   TL   
                              ORA   TH   
                              BEQ   e_zero   
E319                          ENDIF      
E319   BD 00 03               LDA   DSH,X   
E31C   48                     PHA      ; a's sign: for r
E31D   45 03                  EOR   TH   
E31F   48                     PHA      ; a xor b: for q
E320   20 A1 E2               JSR   absv   
E323   A5 02                  LDA   TL   
E325   85 08                  STA   D0   
E327   A5 03                  LDA   TH   
E329   85 09                  STA   D1   ; D = |b|
E32B   BD 00 02               LDA   DSL,X   
E32E   85 02                  STA   TL   
E330   BD 00 03               LDA   DSH,X   
E333   85 03                  STA   TH   
E335   20 A1 E2               JSR   absv   ; TOS = |a|
E338   20 5D E3               JSR   udiv   ; TOS = q, NOS = r
E33B   68                     PLA      
E33C   20 A3 E2               JSR   negm   ; q's sign
E33F   20 04 E3               JSR   h_swap   ; r on top
E342   68                     PLA      
E343   4C A3 E2               JMP   negm   ; r's sign
E346                             ; =============================================================================
E346                             ;  Storage
E346                             ; =============================================================================
E346                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E346                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E346                          IF   1-CHECKED   
E346   AD 7C 04     H_ALLOC:   LDA   HEAP   
E349   A8                     TAY      
E34A   65 02                  ADC   TL   
E34C   8D 7C 04               STA   HEAP   
E34F   84 02                  STY   TL   
E351   AD 7D 04               LDA   HEAP+1   
E354   A8                     TAY      
E355   65 03                  ADC   TH   
E357   8D 7D 04               STA   HEAP+1   
E35A   84 03                  STY   TH   
E35C   60                     RTS      
E35D                          ENDIF      
E35D                             ; The checked build works the new top out first, in T0 and Y, and stops with
E35D                             ; H, the count still on the stack, if it is at or past the limit, below the
E35D                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E35D                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E35D                             ; a signed number from -8000h, so the add overflows exactly when the true
E35D                             ; sum leaves 0000h-FFFFh.
E35D                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   TL   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   TH   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   TL   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   TH   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_ZERO:   LDA   #"Z"   ; divide by zero
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chk2: stop unless the cell at TOS, both its bytes, is in the program's own
                                 ; space: the page of addr+1 (CMP sets the carry if addr ends in FFh), then of
                                 ; addr. "!" and the grave's `+ and `- use it. Keeps Y.
                    CHK2:     LDA   TL   
                              CMP   #0FFh   
                              LDA   TH   
                              ADC   #0   
                              JSR   chkst   
                              LDA   TH   
                                 ; chkst: stop unless the page in A is in the program's own space, from the
                                 ; letter page up to the heap limit. Keeps Y.
                    CHKST:    CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              RTS      
E35D                          ENDIF      
E35D                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E35D                             ; cell the remainder (whatever was there is lost).
E35D                             ; Dividing by 2 is one shift (the spec wants that fast).
E35D   A9 00        UDIV:     LDA   #0   
E35F   9D 00 02               STA   DSL,X   
E362   9D 00 03               STA   DSH,X   
E365   A5 08                  LDA   D0   
E367   49 02                  EOR   #2   
E369   05 09                  ORA   D1   
E36B   D0 08                  BNE   ud0   
E36D   46 03                  LSR   TH   
E36F   66 02                  ROR   TL   ; the quotient
E371   3E 00 02               ROL   DSL,X   ; the remainder: the bit that fell out
E374   60                     RTS      
E375   A0 10        UD0:      LDY   #16   
E377   06 02        UD1:      ASL   TL   
E379   26 03                  ROL   TH   
E37B   3E 00 02               ROL   DSL,X   
E37E   3E 00 03               ROL   DSH,X   
E381   38                     SEC      
E382   BD 00 02               LDA   DSL,X   
E385   E5 08                  SBC   D0   
E387   85 04                  STA   T0   
E389   BD 00 03               LDA   DSH,X   
E38C   E5 09                  SBC   D1   
E38E   90 0A                  BCC   ud2   
E390   9D 00 03               STA   DSH,X   
E393   A5 04                  LDA   T0   
E395   9D 00 02               STA   DSL,X   
E398   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E39A   88           UD2:      DEY      
E39B   D0 DA                  BNE   ud1   
E39D   60           UD9:      RTS      
E39E                             ; =============================================================================
E39E                             ;  Console
E39E                             ; =============================================================================
E39E                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E39E   A0 00        TOSGET:   LDY   #0   
E3A0   B1 02                  LDA   (TL),Y   
E3A2   E6 02        INCTOS:   INC   TL   
E3A4   D0 02                  BNE   tg1   
E3A6   E6 03                  INC   TH   
E3A8   60           TG1:      RTS      
E3A9                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E3A9                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E3A9                             ; bit 6, so // and /" give themselves).
E3A9                             ; The checked build walks a copy of TOS along the string, so that the address
E3A9                             ; is still there if it stops with Q on a NUL.
E3A9                H_PRINT:      
E3A9                          IF   CHECKED   
                              JSR   push   ; the copy
                              JSR   pr0   
                              BNE   pdrop   ; always (drop leaves Z clear): the address
                    PR0:         
E3A9                          ENDIF      
E3A9   20 9E E3               JSR   tosget   
E3AC   C9 22                  CMP   #22h   
E3AE   F0 14                  BEQ   pdrop   
E3B0                          IF   CHECKED   
                              TAY      ; (Y is free here)
                              BEQ   e_qpr   
E3B0                          ENDIF      
E3B0   C9 2F                  CMP   #"/"   
E3B2   D0 05                  BNE   pr1   
E3B4   20 9E E3               JSR   tosget   
E3B7   29 BF                  AND   #0BFh   
E3B9   20 03 FF     PR1:      JSR   CONOUT   
E3BC                          IF   1-CHECKED   
E3BC   4C A9 E3               JMP   h_print   
E3BF                          ENDIF      
E3BF                          IF   CHECKED   
                              JMP   pr0   
                    E_QPR:    JSR   drop   ; the copy goes: the address is TOS again
                              JMP   e_quote   ; $ ran into the end
E3BF                          ENDIF      
E3BF   A5 02        H_EMIT:   LDA   TL   ; "'"
E3C1   20 03 FF               JSR   CONOUT   
E3C4   4C 49 E2     PDROP:    JMP   drop   
E3C7                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E3C7                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E3C7                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E3C7   A5 03        H_NUM:    LDA   TH   
E3C9   10 08                  BPL   pn1   
E3CB   A9 2D                  LDA   #"-"   
E3CD   20 03 FF               JSR   CONOUT   
E3D0   20 A5 E2               JSR   neg   
E3D3   CA           PN1:      DEX      ; the spare cell
E3D4   A9 0A                  LDA   #10   
E3D6   85 08                  STA   D0   
E3D8   A9 00                  LDA   #0   
E3DA   85 09                  STA   D1   
E3DC   48                     PHA      ; the end marker
E3DD   20 5D E3     PN2:      JSR   udiv   
E3E0   BD 00 02               LDA   DSL,X   
E3E3   09 30                  ORA   #"0"   
E3E5   48                     PHA      
E3E6   A5 02                  LDA   TL   
E3E8   05 03                  ORA   TH   
E3EA   D0 F1                  BNE   pn2   
E3EC   E8                     INX      
E3ED   68           PN3:      PLA      
E3EE   F0 D4                  BEQ   pdrop   
E3F0   20 03 FF               JSR   CONOUT   
E3F3   4C ED E3               JMP   pn3   
E3F6   A0 01        H_FETCH:   LDY   #1   ; "@"
E3F8   B1 02                  LDA   (TL),Y   
E3FA   48                     PHA      ; the high byte, while "," gets the low one
E3FB   20 02 E4               JSR   h_cfetch   
E3FE   68                     PLA      
E3FF   85 03                  STA   TH   
E401   60                     RTS      
E402                H_CFETCH:      ; ","
E402   A0 00                  LDY   #0   
E404   B1 02                  LDA   (TL),Y   
E406   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E408   84 03                  STY   TH   
E40A   60                     RTS      
E40B                             ; "?" ( n -- c ) or ( -n -- addr )
E40B                             ;   n > 0: wait about n ms for a key; 0 if none came
E40B                             ;   n = 0: wait for a key
E40B                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E40B                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E40B   A5 03        H_KEY:    LDA   TH   
E40D   30 28                  BMI   line   
E40F   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E411   20 77 E0     KT2:      JSR   getk   
E414   D0 1D                  BNE   kt3   
E416   88                     DEY      
E417   D0 F8                  BNE   kt2   
E419   EE 76 04               INC   SEED   ; a millisecond with no key stirs the random
E41C   D0 03                  BNE   kt5   ;   seed by one: how long a key takes to come
E41E   EE 77 04               INC   SEED+1   ;   is the one thing here that is not the
E421                KT5:         ;   same every time
E421   A5 02                  LDA   TL   ; count the millisecond off:
E423   D0 06                  BNE   kt4   
E425   A5 03                  LDA   TH   
E427   F0 E6                  BEQ   kt1   ; 0? never counts down: it waits
E429   C6 03                  DEC   TH   
E42B   C6 02        KT4:      DEC   TL   
E42D   D0 E0                  BNE   kt1   
E42F   A5 03                  LDA   TH   
E431   D0 DC                  BNE   kt1   ; A = 0 if the time ran out
E433   A0 00        KT3:      LDY   #0   
E435   F0 CF                  BEQ   cf2   ; always: TOS = A
E437                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E437                             ; (stored, not echoed), every other key is stored and echoed until the line
E437                             ; is full. Y = the length so far; TL = the most allowed.
E437   20 A5 E2     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E43A   D0 04                  BNE   ln0   
E43C   A5 02                  LDA   TL   
E43E   10 04                  BPL   ln1   
E440   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E442   85 02                  STA   TL   
E444   A0 00        LN1:      LDY   #0   
E446   F0 03                  BEQ   ln2   ; always
E448   20 03 FF     LN3:      JSR   CONOUT   
E44B   20 77 E0     LN2:      JSR   getk   
E44E   F0 FB                  BEQ   ln2   
E450   C9 0D                  CMP   #13   
E452   F0 14                  BEQ   ln5   
E454   C9 08                  CMP   #8   
E456   F0 0A                  BEQ   ln4   
E458   C4 02                  CPY   TL   
E45A   B0 EF                  BCS   ln2   ; full
E45C   99 80 04               STA   LINEBUF,Y   
E45F   C8                     INY      
E460   D0 E6                  BNE   ln3   ; always: echo it
E462   88           LN4:      DEY      ; Backspace: one back, and echo it,
E463   10 E3                  BPL   ln3   
E465   C8                     INY      ;   unless the line was empty
E466   F0 E3                  BEQ   ln2   ; always
E468   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E46B   A9 80                  LDA   #<LINEBUF   
E46D   85 02                  STA   TL   
E46F   A9 04                  LDA   #>LINEBUF   
E471   85 03                  STA   TH   
E473   60                     RTS      
E474                             ; =============================================================================
E474                             ;  The grave
E474                             ; =============================================================================
E474                             ; The grave is a prefix: with the character after it, it is one command.
E474                             ; GCH holds the characters and GLO, beside it, the low byte of each one's
E474                             ; handler (less 1, for the RTS trick). The high byte is worked out: the
E474                             ; handlers lie in the order of the table and take up less than a page, so
E474                             ; they start in one page or in two, and GK is the place in the table where
E474                             ; the second page begins (the assembler works it out, and chktab6502.py
E474                             ; checks it). A handler starts with Y = its place in the table, and ends in
E474                             ; RTS. A character that is not in the table is unsafe: the unchecked build
E474                             ; does nothing, the checked build stops with W.
E474                             ; 
E474                             ;    `!  ( addr -- )        call the machine code at addr: see the contract
E474                             ;                           in the header
E474                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
E474                             ;                           from addr until a non-hex character; then a RTS
E474                             ;                           (60h) is written and its address is left. An odd
E474                             ;                           last digit is consumed and dropped.
E474                             ;    `'  ( -- )             new line: CR LF
E474                             ;    `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
E474                             ;    `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
E474                             ;    `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
E474                             ;    `.  ( -- addr )        the address of the random seed
E474                             ;    `<  ( a b -- n )       the smaller of the two (signed)
E474                             ;    `>  ( a b -- n )       the larger
E474                             ;    `?  ( flag -- )        the cursor off (0) or on
E474                             ;    `@  ( row col -- )     the cursor to that row and column, both from 0
E474                             ;    `^  ( -- )             clear the screen and home the cursor
E474                             ;    `_  ( -- )             clear from the cursor to the end of the line
E474                H_GRAVE:      
E474                          IF   CHECKED   
                              INC   PLACE   ; the place of anything that goes wrong in
                              BNE   gr0   ;   one of these is the character after the
                              INC   PLACE+1   ;   grave
                    GR0:         
E474                          ENDIF      
E474   20 1C E2               JSR   getc   
E477   A0 0C                  LDY   #GLO-GCH-1   
E479   D9 8E E4     GR1:      CMP   GCH,Y   
E47C   F0 04                  BEQ   gr2   
E47E   88                     DEY      
E47F   10 F8                  BPL   gr1   
E481                          IF   1-CHECKED   
E481   60                     RTS      ; no such code
E482                          ENDIF      
E482                          IF   CHECKED   
                              JMP   eb1   ; no such code: W
E482                          ENDIF      
E482   C0 07        GR2:      CPY   #GK   ; carry: the second page
E484   A9 E4                  LDA   #GQ0   
E486   69 00                  ADC   #0   
E488   48                     PHA      
E489   B9 9B E4               LDA   GLO,Y   
E48C   48                     PHA      
E48D   60                     RTS      ; to the handler
E48E                             ; (The order matters: "-" just before "+", "<" at an odd place and ">" at
E48E                             ; the even one after it, and the handlers in the same order in memory.)
E48E   24 21 27     GCH:      DB   "$","!",27h   
E491   2D 2B 2E 2C 3C 3E 3F 40 5E 5F GMINUS:   DB   "-","+",".",",","<",">","?","@","^","_"   
E49B   A7           GLO:      DB   (g_hex-1) & 0FFh   
E49C   C5                     DB   (exec-1) & 0FFh   
E49D   D3                     DB   (g_nl-1) & 0FFh   
E49E   DD                     DB   (g_inc-1) & 0FFh   
E49F   DD                     DB   (g_inc-1) & 0FFh   
E4A0   F5                     DB   (g_seed-1) & 0FFh   
E4A1   FC                     DB   (g_rnd-1) & 0FFh   
E4A2   30                     DB   (g_min-1) & 0FFh   
E4A3   30                     DB   (g_min-1) & 0FFh   
E4A4   3E                     DB   (g_cur-1) & 0FFh   
E4A5   5B                     DB   (g_at-1) & 0FFh   
E4A6   81                     DB   (g_cls-1) & 0FFh   
E4A7   89                     DB   (g_eol-1) & 0FFh   
E4A8                             ; The page of each handler, and GK: 13 less the table entries whose handler
E4A8                             ; is in the second page. (One division to a line: asm80 only rounds down
E4A8                             ; when it stores a value.)
E4A8                GQ0:      EQU   (g_hex-1)/256   
E4A8                GQ1:      EQU   (exec-1)/256   
E4A8                GQ2:      EQU   (g_nl-1)/256   
E4A8                GQ3:      EQU   (g_inc-1)/256   
E4A8                GQ5:      EQU   (g_seed-1)/256   
E4A8                GQ6:      EQU   (g_rnd-1)/256   
E4A8                GQ7:      EQU   (g_min-1)/256   
E4A8                GQ9:      EQU   (g_cur-1)/256   
E4A8                GQ10:     EQU   (g_at-1)/256   
E4A8                GQ11:     EQU   (g_cls-1)/256   
E4A8                GQ12:     EQU   (g_eol-1)/256   
E4A8                GK:       EQU   13+12*GQ0-GQ1-GQ2-GQ3-GQ3-GQ5-GQ6-GQ7-GQ7-GQ9-GQ10-GQ11-GQ12   
E4A8                             ; `$ (never checked: the spec says so)
E4A8   20 05 E2     G_HEX:    JSR   rdhex   
E4AB   B0 14                  BCS   hx2   
E4AD   0A                     ASL      
E4AE   0A                     ASL      
E4AF   0A                     ASL      
E4B0   0A                     ASL      
E4B1   85 04                  STA   T0   
E4B3   20 05 E2               JSR   rdhex   
E4B6   B0 09                  BCS   hx2   ; odd digit: already consumed, dropped
E4B8   05 04                  ORA   T0   
E4BA   91 02                  STA   (TL),Y   ; Y is 0 after rdhex
E4BC   20 A2 E3               JSR   inctos   
E4BF   90 E7                  BCC   g_hex   ; always (rdhex left the carry clear)
E4C1   A9 60        HX2:      LDA   #60h   
E4C3   91 02                  STA   (TL),Y   
E4C5   60                     RTS      
E4C6                             ; `!
E4C6   A5 02        EXEC:     LDA   TL   
E4C8   85 04                  STA   T0   
E4CA   A5 03                  LDA   TH   
E4CC   85 05                  STA   T1   
E4CE   20 49 E2               JSR   drop   ; the address is consumed
E4D1   6C 04 00               JMP   (T0)   
E4D4   A9 0D        G_NL:     LDA   #13   
E4D6   20 03 FF               JSR   CONOUT   
E4D9   A9 0A                  LDA   #10   
E4DB   4C 03 FF               JMP   CONOUT   
E4DE                             ; `+ and `-: one routine. It adds 0000h with the carry set, or FFFFh with it
E4DE                             ; clear: SBC turns the carry into that 00 or FF and leaves the carry as it
E4DE                             ; was. Then "@" fetches the new value.
E4DE                G_INC:       
E4DE                          IF   CHECKED   
                              JSR   chk2   ; both bytes must be in the program's space
E4DE                          ENDIF      
E4DE   C0 04                  CPY   #GMINUS-GCH+1   ; carry: "+"
E4E0   A9 00                  LDA   #0   
E4E2   E9 00                  SBC   #0   
E4E4   85 05                  STA   T1   
E4E6   A0 00                  LDY   #0   
E4E8   71 02                  ADC   (TL),Y   
E4EA   91 02                  STA   (TL),Y   
E4EC   C8                     INY      
E4ED   A5 05                  LDA   T1   
E4EF   71 02                  ADC   (TL),Y   
E4F1   91 02                  STA   (TL),Y   
E4F3   4C F6 E3               JMP   h_fetch   
E4F6                             ; `. pushes the address of the random seed.
E4F6   A9 76        G_SEED:   LDA   #<SEED   
E4F8   A0 04                  LDY   #>SEED   
E4FA   4C 01 E1               JMP   pushay   
E4FD                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
E4FD                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
E4FD                             ; and the low ones repeat soon, so the high byte is folded into the low
E4FD                             ; (EOR) before the remainder of dividing by n is taken.
E4FD                             ; n must be 1 to 32767: the checked build stops with Z on anything less
E4FD                             ; than 1.
E4FD                G_RND:       
E4FD                          IF   CHECKED   
                              LDA   TH   
                              BMI   gr9   
                              ORA   TL   
                              BNE   gr8   
                    GR9:      JMP   e_zero   
                    GR8:         
E4FD                          ENDIF      
E4FD   AD 76 04               LDA   SEED   
E500   AC 77 04               LDY   SEED+1   
E503   20 01 E1               JSR   pushay   ; the seed,
E506   A9 05                  LDA   #05h   ;   and 261 (0105h) on top of it
E508   A0 01                  LDY   #01h   
E50A   20 01 E1               JSR   pushay   
E50D   20 DC E2               JSR   h_mul   ; TOS = seed * 261, and n is under it again
E510   20 A2 E3               JSR   inctos   
E513   A5 02                  LDA   TL   
E515   8D 76 04               STA   SEED   
E518   A5 03                  LDA   TH   
E51A   8D 77 04               STA   SEED+1   
E51D   45 02                  EOR   TL   
E51F   85 02                  STA   TL   
E521   BD 00 02               LDA   DSL,X   
E524   85 08                  STA   D0   
E526   BD 00 03               LDA   DSH,X   
E529   85 09                  STA   D1   ; D = n
E52B   20 5D E3               JSR   udiv   ; the remainder goes where n was,
E52E   4C 49 E2               JMP   drop   ;   and comes up as TOS
E531                             ; `< and `>: one routine. scmp leaves the carry clear if a < b. Y is odd for
E531                             ; "<" and even for ">" (their places in the table), so the low bit of Y plus
E531                             ; the carry is set when a, the cell below, is the one to keep.
E531   20 BC E2     G_MIN:    JSR   scmp   
E534   98                     TYA      
E535   69 00                  ADC   #0   
E537   4A                     LSR      
E538   90 03                  BCC   gm1   
E53A   4C 49 E2               JMP   drop   ; a
E53D   E8           GM1:      INX      ; b
E53E   60                     RTS      
E53F                          IF   ANSI   
E53F                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
E53F   A0 04        G_CUR:    LDY   #4   
E541   B9 57 E5     GC1:      LDA   GQ25,Y   
E544   20 03 FF               JSR   CONOUT   
E547   88                     DEY      
E548   10 F7                  BPL   gc1   
E54A   20 31 E2               JSR   flag   
E54D   F0 03                  BEQ   gc2   
E54F   A9 68                  LDA   #"h"   
E551   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E552   A9 6C        GC2:      LDA   #"l"   
E554   4C 03 FF               JMP   CONOUT   
E557   35 32 3F 5B 1B GQ25:   DB   "5","2","?","[",27   ; (printed from the end)
E55C                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
E55C   20 78 E5     G_AT:     JSR   csi   
E55F   20 04 E3               JSR   h_swap   ; the row on top
E562   20 72 E5               JSR   pinc   
E565   A9 3B                  LDA   #";"   
E567   20 03 FF               JSR   CONOUT   
E56A   20 72 E5               JSR   pinc   
E56D   A9 48                  LDA   #"H"   
E56F   4C 03 FF               JMP   CONOUT   
E572                             ; pinc: print TOS + 1, unsigned, and drop it
E572   20 A2 E3     PINC:     JSR   inctos   
E575   4C D3 E3               JMP   pn1   
E578                             ; csi: print ESC [, which starts every ANSI sequence. Keeps X and Y.
E578   A9 1B        CSI:      LDA   #27   
E57A   20 03 FF               JSR   CONOUT   
E57D   A9 5B                  LDA   #"["   
E57F   4C 03 FF               JMP   CONOUT   
E582                             ; `^: ESC [ H homes the cursor, and ESC [ J clears from there to the end of
E582                             ; the screen. `_: ESC [ K clears to the end of the line.
E582   A0 48        G_CLS:    LDY   #"H"   
E584   20 8C E5               JSR   csiy   
E587   A0 4A                  LDY   #"J"   
E589   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E58A   A0 4B        G_EOL:    LDY   #"K"   
E58C                             ; csiy: print ESC [ and the character in Y
E58C   20 78 E5     CSIY:     JSR   csi   
E58F   98                     TYA      
E590   4C 03 FF               JMP   CONOUT   
E593                          ENDIF      
E593                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    JSR   flag   ; A = 0 and Z set: off
                              JMP   CONCUR   
                    G_AT:     LDY   DSL,X   ; Y = the row
                              LDA   TL   ; A = the column
                              JSR   CONAT   
                              INX      
                              JMP   drop   
                    G_CLS:    JMP   CONCLS   
                    G_EOL:    JMP   CONEOL   
E593                          ENDIF      
E593                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
                                 ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   Rtn n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was.
                    ERROR:    PHA      ; the letter
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   D0   
                              LDY   D1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   CL   
                              LDY   CL+1   
                              JSR   prnum   ; the column
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              LDY   #0   ; the text at the place
                    ER1:      LDA   (PLACE),Y   
                              BEQ   er2   
                              CMP   #13   
                              BEQ   er2   
                              CMP   #10   
                              BEQ   er2   
                              JSR   CONOUT   
                              INY      
                              CPY   #16   
                              BNE   er1   
                    ER2:      LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "Stk "
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T1   ; T1 = how many cells to show
                              JSR   prs   
                              JSR   push   ; TOS into memory with the rest: cell i from
                                 ;   the top is at DSL+X+i now
                    ER4:      LDA   T1   ; cells T1-1 down to 0, the top last
                              BEQ   er5   
                              DEC   T1   
                              LDA   #" "   
                              JSR   CONOUT   
                              TXA      
                              CLC      
                              ADC   T1   
                              TAY      
                              LDA   DSL,Y   
                              PHA      
                              LDA   DSH,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "Rtn "
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"Stk"," "+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"Rtn"," "+80h   
                                 ; lcol: the line (D0/D1) and the column (CL) of the place, both from 1. A
                                 ; place below the program is in the -n? line buffer: line 0, and the column
                                 ; is the place in the buffer. Otherwise IP (free now: the program has
                                 ; stopped) runs from PROG to the place, counting LFs; CL keeps where the
                                 ; last line started, and the column is the place minus that, plus 1.
                    LCOL:     LDA   #0   
                              STA   D1   
                              STA   D0   
                              LDA   #<LINEBUF   
                              STA   CL   
                              LDA   #>LINEBUF   
                              STA   CL+1   
                              LDA   PLACE   
                              CMP   #<PROG   
                              LDA   PLACE+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   D0   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   CL   
                              LDA   IP+1   
                              STA   CL+1   
                    LC1:      LDA   IP   
                              CMP   PLACE   
                              LDA   IP+1   
                              SBC   PLACE+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              INC   D0   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   D1   
                              BNE   lc3   ; always
                    LC9:      LDA   PLACE   
                              SEC      
                              SBC   CL   
                              STA   CL   
                              LDA   PLACE+1   
                              SBC   CL+1   
                              STA   CL+1   
                              INC   CL   ; + 1
                              BNE   lc8   
                              INC   CL+1   
                    LC8:      RTS      
E593                          ENDIF      


