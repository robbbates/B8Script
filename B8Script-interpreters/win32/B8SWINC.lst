  1773                              <1> 
  1774                              <1> ; =============================================================================
  1775                              <1> ;  The letters and digits, the return stack's push, and the inner loop
  1776                              <1> ; =============================================================================
  1777                              <1> 
  1778                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
  1779                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
  1780 0000082C 89F2                <1> upper:  mov     edx,esi
  1781 0000082E 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
  1782                              <1> 
  1783                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
  1784                              <1> ; return stack ends here, and the true ')' comes to rpoll.
  1785                              <1> ;
  1786                              <1> ; The break key is looked at here, so at every word call and loop-back (and
  1787                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
  1788 00000836 83EF04              <1> rpush:  sub     edi,4
  1789 00000839 8917                <1>         mov     [edi],edx
  1790 0000083B FE4D6B              <1> rpoll:  dec     byte [V(v_pcnt)]
  1791 0000083E 7505                <1>         jnz     .rp1
  1792 00000840 E85AFDFFFF          <1>         call    pollk
  1793 00000845 FFE5                <1> .rp1:   jmp     ebp
  1794                              <1> 
  1795                              <1> ; =============================================================================
  1796                              <1> ;  The inner loop: read one character and sort it by range.
  1797                              <1> ;
  1798                              <1> ;    00h          end of program
  1799                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1800                              <1> ;                 build stops on 80h-FFh: X)
  1801                              <1> ;    30h-39h      digit: read a whole number
  1802                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1803                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1804                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1805                              <1> ; =============================================================================
  1806                              <1> ; Digits: step back onto the first digit and read the whole number.
  1807 00000847 53                  <1> digit:  push    ebx
  1808 00000848 4E                  <1>         dec     esi
  1809 00000849 E8A1FBFFFF          <1>         call    rdnum
  1810 0000084E FFE5                <1>         jmp     ebp
  1811                              <1> 
  1812                              <1> ; a-z: push the cell's address (the cell is the variable).
  1813 00000850 53                  <1> lower:  push    ebx
  1814 00000851 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1815 00000858 FFE5                <1>         jmp     ebp
  1816                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1817                              <1> ; next in reach)
  1818 0000085A 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1819 0000085C 750C                <1>         jnz     next                    ; the rest are ignored
  1820 0000085E E977FDFFFF          <1>         jmp     endprog
  1821                              <1> %if CHECKED
  1822 00000863 B058                <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1823 00000865 E983FAFFFF          <1>         jmp     error
  1824                              <1> %endif
  1825                              <1> next:
  1826                              <1> %if CHECKED
  1827 0000086A E82CFAFFFF          <1>         call    chkstk                  ; both stacks, once per character
  1828                              <1> %endif
  1829 0000086F 31C0                <1>         xor     eax,eax
  1830 00000871 AC                  <1>         lodsb
  1831 00000872 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1832 00000874 72E4                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1833 00000876 3C0F                <1>         cmp     al,0Fh
  1834 00000878 7224                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1835 0000087A 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1836 0000087C 3C0A                <1>         cmp     al,0Ah
  1837 0000087E 72C7                <1>         jb      digit                   ; 30h-39h
  1838 00000880 3C11                <1>         cmp     al,11h
  1839 00000882 7218                <1>         jb      p3a                     ; 3Ah-40h
  1840 00000884 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1841 00000886 3C1A                <1>         cmp     al,1Ah
  1842 00000888 72A2                <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1843 0000088A 3C20                <1>         cmp     al,20h
  1844 0000088C 720C                <1>         jb      p5b                     ; 5Bh-60h
  1845 0000088E 3C3A                <1>         cmp     al,3Ah
  1846 00000890 72BE                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1847 00000892 3C3E                <1>         cmp     al,3Eh
  1848                              <1> %if CHECKED
  1849 00000894 74D4                <1>         je      next                    ; 7Fh, DEL: ignored
  1850 00000896 73CB                <1>         jae     e_hi                    ; 80h-FFh: reserved
  1851                              <1> %else
  1852                              <1>         jae     next                    ; 7Fh-FFh: ignored
  1853                              <1> %endif
  1854 00000898 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1855 0000089A 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1856 0000089C 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1857 0000089E 8A80[75060000]      <1> punct:  mov     al,[ptab+eax]
  1858 000008A4 8D80[D9000000]      <1>         lea     eax,[hbase+eax]
  1859 000008AA FFE0                <1>         jmp     eax
  1860                              <1> 
