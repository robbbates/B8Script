0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    QUICK    1 = the speed-ups that cost bytes: a skip cache, a faster skip,
0000                             ;                 "*" and "/" quicker for small and power-of-two operands, and
0000                             ;                 more (see "Speed-ups"). 0, the default, is the smallest build.
0000                             ;    FAST     1 = the speed build: QUICK and a dispatch table besides, with
0000                             ;                 no size limit (see "The speed build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                QUICK:    EQU   0   ; 1 = the speed-ups that cost bytes (see "Speed-ups")
0000                FAST:     EQU   0   ; 1 = the speed build (not with EDITOR): see "The speed build"
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   QUICK+FAST-QUICK*FAST   ; (the speed-ups: QUICK, or the speed build)
0000                QUICKU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the speed build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; IY, and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
0000                             ;   at the heap limit, which the heap never reaches
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
0000                PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
0000                ACHK:     EQU   chkstk   ; (for the speed build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
                    ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the speed build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (speed build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (speed build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0000   AF                     XOR   A   ; 00  reset. (This byte, AFh, is also what an
0001                          ENDIF      ;     undefined word runs into: see e_hi.)
0001                          IF   1-EDGEN   
0001   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
0004   18 6C                  JR   init   ; 04  (the rest of the startup is close by)
0006   00 00                  DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0008                          ENDIF      
0008                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0008                          ENDIF      
0008                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0008                          ENDIF      
0008                          IF   1-CPM   
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   FD 5E 00     RPOP:     LD   E,(IY+0)   ; 08
000B   FD 56 01               LD   D,(IY+1)   
000E   18 1B                  JR   rp2   ; (the rest is at 2Bh)
0010                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0010   C6 21        CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
0012   20 1D                  JR   NZ,next0   ;     the rest are ignored
0014   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0017   00                     NOP      ; 17  spare
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1           DRP:      POP   HL   ;     new TOS = NOS
001A   18 15                  JR   next0   
001C                          ENDIF      
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D                          ;*Macro unroll:  POPR
001D   CF                     DS   1-CPM,0CFh   
001E                          DS   CPM,0CDh   
001E                          DS   CPM,AROP&0FFh   
001E                          DS   CPM,AROP/256   
001E   EB                     EX   DE,HL   
001F                          ;*Macro unroll:  NEXTZ
001F   F7                     DS   1-CPM,0F7h   
0020                          DS   CPM,0DDh   
0020                          DS   CPM,0E9h   
0020                          IF   1-CPM   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
0028                RST28:       
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B   FD 23        RP2:      INC   IY   ; 2B  the rest of rpop
002D   FD 23                  INC   IY   
002F   C9                     RET      
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                          ENDIF      
0031                          IF   CPM   
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; back to c; zero only for NUL
                              JR   NZ,next0   ; the rest are ignored
                    ENDPROG:   JP   EXIT   ; the program has ended
0031                          ENDIF      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the speed build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the speed build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0031                          ENDIF      
0031                          IF   1-FAST   
0031                NEXT0:       
0031                          ENDIF      
0031                          IF   CHECKED*(1-FAST)   
0031   CD AE 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034                          IF   1-FAST   
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D6                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 79                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 7B                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 6D                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          ENDIF      
0058                          IF   (1-CHECKED)*(1-FAST)   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED*(1-FAST)   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 DB 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D                          IF   1-FAST   
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                          ENDIF      
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063                          IF   1-FAST   
0063   C6 50        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE 69                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          ENDIF      
006C                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IF   (1-CPM)*(1-FAST)   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070                          IF   1-FAST   
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                          ENDIF      
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0072   21 00 82     INIT:     LD   HL,LET   
0075   77           INI1:     LD   (HL),A   
0076   2C                     INC   L   
0077   F2 75 00               JP   P,ini1   ; +00h to +7Fh
007A   01 00 83               LD   BC,PROG   ; the IP
007D                          ENDIF      
007D                          IF   (1-CPM)*(1-EDITOR)   
007D   60           ST0:      LD   H,B   
007E   69                     LD   L,C   
007F   AF                     XOR   A   
0080   BE           ST1:      CP   (HL)   
0081   23                     INC   HL   
0082   20 FC                  JR   NZ,st1   
0084                          ENDIF      
0084                          IF   1-EDITOR   
0084   22 7C 82     ST2:      LD   (HEAP),HL   
0087                          ENDIF      
0087                          IF   CHECKED*(1-EDITOR)   
0087                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
0087   E7                     DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
0088                          DS   CPM,0CDh   
0088                          DS   CPM,ANEG&0FFh   
0088                          DS   CPM,ANEG/256   
0088   22 38 82               LD   (NPEND),HL   ;   release below it
008B                          ENDIF      
008B                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
008B                          ENDIF      ;   these)
008B                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
008B                          ENDIF      
008B                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
008B                          ENDIF      
008B                          IF   1-EDITOR   
008B                          ;*Macro unroll:  SETIX
008B                          DS   CPM+FAST-CPM*FAST,0DDh   
008B                          DS   CPM+FAST-CPM*FAST,21h   
008B                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
008B                          DS   CPM+FAST-CPM*FAST,ANXT/256   
008B   FD 21 E0 80            LD   IY,RSTOP   ; the return stack is empty
008F                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
008F   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0090                          DS   CPM+FAST-CPM*FAST,0DDh   
0090                          DS   CPM+FAST-CPM*FAST,0E9h   
0090                          ENDIF      
0090                             ; In the unchecked generic editor build the table is here, in the first
0090                             ; page, which saves loading D twice. (The other builds have no room for it
0090                             ; here: theirs is further down.)
0090                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0090                          ENDIF      
0090                             ; =============================================================================
0090                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0090                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0090                             ;  is here too: it belongs to "`" and makes the page come out right.
0090                             ; =============================================================================
0090   D1           H_XOR:    POP   DE   
0091   7C                     LD   A,H   
0092   AA                     XOR   D   
0093   67                     LD   H,A   
0094   7D                     LD   A,L   
0095   AB                     XOR   E   
0096   6F                     LD   L,A   
0097                          ;*Macro unroll:  NEXT
0097   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0098                          DS   CPM+FAST-CPM*FAST,0DDh   
0098                          DS   CPM+FAST-CPM*FAST,0E9h   
0098   D1           H_OR:     POP   DE   
0099   7C                     LD   A,H   
009A   B2                     OR   D   
009B   67                     LD   H,A   
009C   7D                     LD   A,L   
009D   B3                     OR   E   
009E   6F                     LD   L,A   
009F                          ;*Macro unroll:  NEXT
009F   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00A0                          DS   CPM+FAST-CPM*FAST,0DDh   
00A0                          DS   CPM+FAST-CPM*FAST,0E9h   
00A0                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
00A0   E7           H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
00A1                          DS   CPM,0CDh   
00A1                          DS   CPM,ANEG&0FFh   
00A1                          DS   CPM,ANEG/256   
00A1   2B                     DEC   HL   
00A2                          ;*Macro unroll:  NEXT
00A2   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00A3                          DS   CPM+FAST-CPM*FAST,0DDh   
00A3                          DS   CPM+FAST-CPM*FAST,0E9h   
00A3                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
00A3                             ; the same either way); TOS is the old pointer.
00A3   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A7                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A7                          ENDIF      
00A7   19                     ADD   HL,DE   ; the new top
00A8                          IF   CHECKED   
00A8   CD E5 03               CALL   chkhp   
00AB                          ENDIF      
00AB   22 7C 82               LD   (HEAP),HL   
00AE   EB                     EX   DE,HL   
00AF                          ;*Macro unroll:  NEXT
00AF   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00B0                          DS   CPM+FAST-CPM*FAST,0DDh   
00B0                          DS   CPM+FAST-CPM*FAST,0E9h   
00B0                          IF   1-CPM*CHECKED   
00B0   FD 22 34 82  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
00B4   CD EB 00               CALL   jphl   
00B7   FD 2A 34 82            LD   IY,(RSAVE)   
00BB                          ;*Macro unroll:  SETIX
00BB                          DS   CPM+FAST-CPM*FAST,0DDh   
00BB                          DS   CPM+FAST-CPM*FAST,21h   
00BB                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
00BB                          DS   CPM+FAST-CPM*FAST,ANXT/256   
00BB   E1                     POP   HL   
00BC                          ;*Macro unroll:  NEXT
00BC   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00BD                          DS   CPM+FAST-CPM*FAST,0DDh   
00BD                          DS   CPM+FAST-CPM*FAST,0E9h   
00BD                          ENDIF      
00BD                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00BD                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00BD                             ; Digits: step back onto the first digit and read the whole number.
00BD   E5           DIGIT:    PUSH   HL   
00BE   0B                     DEC   BC   
00BF   CD BE 02               CALL   rdnum   
00C2                          ;*Macro unroll:  NEXT
00C2   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00C3                          DS   CPM+FAST-CPM*FAST,0DDh   
00C3                          DS   CPM+FAST-CPM*FAST,0E9h   
00C3                             ; a-z: push the cell's address (the cell is the variable)
00C3                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
00C3                          IF   1-QUICKU   
00C3   E5           LOWER:    PUSH   HL   
00C4   87                     ADD   A,A   
00C5   6F                     LD   L,A   
00C6   26 82                  LD   H,LETPAGE   
00C8                          ;*Macro unroll:  NEXT
00C8   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00C9                          DS   CPM+FAST-CPM*FAST,0DDh   
00C9                          DS   CPM+FAST-CPM*FAST,0E9h   
00C9                          ENDIF      
00C9                          IF   QUICKU   
                    LOWER:    JP   lowq   
00C9                          ENDIF      
00C9                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00C9                             ; the return stack, and the IP becomes the address in the letter's cell.
00C9   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00CA   EB                     EX   DE,HL   ; park TOS
00CB   87                     ADD   A,A   
00CC   6F                     LD   L,A   
00CD   26 82                  LD   H,LETPAGE   ; HL -> cell
00CF   4E                     LD   C,(HL)   
00D0   2C                     INC   L   
00D1   46                     LD   B,(HL)   ; IP = the word's body
00D2   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00D3                             ; rpushn: move the top cell of the data stack (in memory) to the return
00D3                             ; stack, then next. Everything that pushes the return stack ends here.
00D3                             ; 
00D3                             ; The break key is looked at here, so at every word call and loop-back (and
00D3                             ; block entry and "{"), but only one time in 256: PCNT counts them.
00D3                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
00D3   D1           RPUSHN:   POP   DE   
00D4   FD 72 FF               LD   (IY-1),D   
00D7   FD 73 FE               LD   (IY-2),E   
00DA   FD 2B                  DEC   IY   
00DC   FD 2B                  DEC   IY   
00DE   E5                     PUSH   HL   
00DF   21 36 82               LD   HL,PCNT   
00E2   35                     DEC   (HL)   
00E3   E1                     POP   HL   ; (the zero flag lasts)
00E4   CC 70 03               CALL   Z,pollk   
00E7                          ;*Macro unroll:  NEXT
00E7   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00E8                          DS   CPM+FAST-CPM*FAST,0DDh   
00E8                          DS   CPM+FAST-CPM*FAST,0E9h   
00E8                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
00E8   E3           H_TOR:    EX   (SP),HL   
00E9   18 E8                  JR   rpushn   
00EB   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
00EC                             ; ---- machine code: the grave -----------------------------------------------
00EC                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00EC                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00EC                             ; written and its address is left. An odd last digit is consumed and dropped.
00EC                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00EC                             ; code is entered by CALL with the data stack above the return address; it
00EC                             ; must keep BC, and on return the top cell becomes the new TOS.
00EC   CD 24 03     H_GRAVE:   CALL   hexc   
00EF                          IF   1-CPM*CHECKED   
00EF   30 BF                  JR   NC,exec   
00F1                          ENDIF      
00F1                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
00F1                          ENDIF      
00F1   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00F2   CD 24 03               CALL   hexc   
00F5   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00F7   ED 6F                  RLD      ;   overwrites it
00F9   23                     INC   HL   ; ... and RLD shifts it up under the low one
00FA   CD 24 03               CALL   hexc   
00FD   38 F2                  JR   C,hx1   
00FF   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
0101                          ;*Macro unroll:  NEXT
0101   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0102                          DS   CPM+FAST-CPM*FAST,0DDh   
0102                          DS   CPM+FAST-CPM*FAST,0E9h   
0102                             ; ---- where the two pages meet ----------------------------------------------
0102                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
0102                             ; are in falling code order for this), and where exactly differs between the
0102                             ; builds: NPG1 follows. Every handler below these four must start in the
0102                             ; second page, and every one above in the first; chktab.py checks both.
0102                             ; "]" returns: pop an address and jump to it.
0102                          ;*Macro unroll: h_ret:  POPR
0102   CF           H_RET:    DS   1-CPM,0CFh   
0103                          DS   CPM,0CDh   
0103                          DS   CPM,AROP&0FFh   
0103                          DS   CPM,AROP/256   
0103   42                     LD   B,D   
0104   4B                     LD   C,E   
0105                          ;*Macro unroll: brk1:   NEXT
0105   F7           BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
0106                          DS   CPM+FAST-CPM*FAST,0DDh   
0106                          DS   CPM+FAST-CPM*FAST,0E9h   
0106                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
0106                             ; drops the block start, "]" returns. No closer at all ends the program.
0106   7C           H_BREAK:   LD   A,H   
0107   B5                     OR   L   
0108   E1                     POP   HL   
0109   28 FA                  JR   Z,brk1   
010B   CD E5 02               CALL   skip   
010E   B7                     OR   A   ; skip returns 0 for ")"
010F   20 F1                  JR   NZ,h_ret   
0111                          ;*Macro unroll: rdrop:  POPR
0111   CF           RDROP:    DS   1-CPM,0CFh   
0112                          DS   CPM,0CDh   
0112                          DS   CPM,AROP&0FFh   
0112                          DS   CPM,AROP/256   
0112                          ;*Macro unroll:  NEXT
0112   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0113                          DS   CPM+FAST-CPM*FAST,0DDh   
0113                          DS   CPM+FAST-CPM*FAST,0E9h   
0113                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0113                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0113                             ; the body"s address instead. Either way it then skips to the matching "]'.
0113                             ; (The unchecked build takes anything that is not a letter as the space; the
0113                             ; checked build stops on it.)
0113   0A           H_DEF:    LD   A,(BC)   
0114   03                     INC   BC   
0115   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
0117   5F                     LD   E,A   ;   lands 64 bytes up
0118   E6 DF                  AND   0DFh   ; fold case
011A   FE 1A                  CP   26   
011C   30 0B                  JR   NC,def2   ; not a letter
011E   CB 23                  SLA   E   
0120   16 82                  LD   D,LETPAGE   ; DE -> cell
0122   79                     LD   A,C   
0123   12                     LD   (DE),A   
0124   1C                     INC   E   
0125   78                     LD   A,B   
0126   12                     LD   (DE),A   
0127   18 09                  JR   skipnx   
0129                DEF2:        
0129                          IF   CHECKED   
0129   7B                     LD   A,E   
012A   FE DF                  CP   " "-"A"+256   
012C   C2 21 04               JP   NZ,e_brack   ; anything but a letter or a space
012F                          ENDIF      
012F   E5                     PUSH   HL   ; an anonymous block: push its address
0130   60                     LD   H,B   
0131   69                     LD   L,C   
0132                SKIPNX:      
0132                          IF   CHECKED   
0132   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0133                          ENDIF      ;   opener, the "[", just before where it starts
0133   CD E5 02     SKIPO:    CALL   skip   
0136                          ;*Macro unroll:  NEXT
0136   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0137                          DS   CPM+FAST-CPM*FAST,0DDh   
0137                          DS   CPM+FAST-CPM*FAST,0E9h   
0137   5E           H_FETCH:   LD   E,(HL)   ; "@"
0138   23                     INC   HL   
0139   56                     LD   D,(HL)   
013A   EB                     EX   DE,HL   
013B                          ;*Macro unroll:  NEXT
013B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
013C                          DS   CPM+FAST-CPM*FAST,0DDh   
013C                          DS   CPM+FAST-CPM*FAST,0E9h   
013C                             ; =============================================================================
013C                             ;  Handlers that must start in the image's second page.
013C                             ;  "?" is the last (with "," inside it), so its long tail may run past that
013C                             ;  page.
013C                             ; =============================================================================
013C                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
013C                             ; the matching ")".
013C   7C           H_OPEN:   LD   A,H   
013D   B5                     OR   L   
013E   E1                     POP   HL   
013F   28 F2                  JR   Z,skipo   
0141   C5                     PUSH   BC   ; the block starts at the IP
0142   18 8F                  JR   rpushn   
0144                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0144                             ; drops it and carries on.
0144   7C           H_CLOSE:   LD   A,H   
0145   B5                     OR   L   
0146   E1                     POP   HL   
0147   28 C8                  JR   Z,rdrop   
0149                          IF   QK   
                              JP   closeq   ; (out of the handlers' pages: see Speed-ups)
0149                          ENDIF      
0149                          IF   1-QK   
0149                          ;*Macro unroll:  POPR                    ; pop the block start ...
0149   CF                     DS   1-CPM,0CFh   ; pop the block start ...
014A                          DS   CPM,0CDh   
014A                          DS   CPM,AROP&0FFh   
014A                          DS   CPM,AROP/256   
014A   42                     LD   B,D   
014B   4B                     LD   C,E   
014C   C5                     PUSH   BC   
014D                          ENDIF      
014D                          IF   (1-QK)*(1-CPM)   
014D   18 84                  JR   rpushn   ; ... and push it back
014F                          ENDIF      
014F                          IF   (1-QK)*CPM   
                              JP   rpushn   
014F                          ENDIF      
014F                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
014F                             ; "-" has two jobs: directly before a digit it starts a negative number.
014F   0A           H_SUB:    LD   A,(BC)   
0150   D6 30                  SUB   "0"   
0152   FE 0A                  CP   10   
0154   38 04                  JR   C,negnum   
0156                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0156   E7                     DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0157                          DS   CPM,0CDh   
0157                          DS   CPM,ANEG&0FFh   
0157                          DS   CPM,ANEG/256   
0157   D1           H_ADD:    POP   DE   
0158   19                     ADD   HL,DE   
0159                          ;*Macro unroll:  NEXT
0159   F7                     DS   (1-CPM)*(1-FAST),0F7h   
015A                          DS   CPM+FAST-CPM*FAST,0DDh   
015A                          DS   CPM+FAST-CPM*FAST,0E9h   
015A   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
015B   CD BE 02               CALL   rdnum   
015E                          ;*Macro unroll:  NEGH
015E   E7                     DS   1-CPM,0E7h   
015F                          DS   CPM,0CDh   
015F                          DS   CPM,ANEG&0FFh   
015F                          DS   CPM,ANEG/256   
015F                          ;*Macro unroll:  NEXT
015F   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0160                          DS   CPM+FAST-CPM*FAST,0DDh   
0160                          DS   CPM+FAST-CPM*FAST,0E9h   
0160   D1           H_AND:    POP   DE   
0161   7C                     LD   A,H   
0162   A2                     AND   D   
0163   67                     LD   H,A   
0164   7D                     LD   A,L   
0165   A3                     AND   E   
0166   6F                     LD   L,A   
0167                          ;*Macro unroll:  NEXT
0167   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0168                          DS   CPM+FAST-CPM*FAST,0DDh   
0168                          DS   CPM+FAST-CPM*FAST,0E9h   
0168                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0168                             ; cells first. Flipping both sign bits turns a signed compare into an
0168                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0168                             ; carry into -1 or 0 with no branch.
0168   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0169   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
016A   7C                     LD   A,H   
016B   EE 80                  XOR   80h   
016D   67                     LD   H,A   
016E   7A                     LD   A,D   
016F   EE 80                  XOR   80h   
0171   57                     LD   D,A   
0172   ED 52                  SBC   HL,DE   ; carry if HL < DE
0174   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0176                          ;*Macro unroll:  NEXT
0176   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0177                          DS   CPM+FAST-CPM*FAST,0DDh   
0177                          DS   CPM+FAST-CPM*FAST,0E9h   
0177   D1           H_EQ:     POP   DE   
0178   B7                     OR   A   
0179   ED 52                  SBC   HL,DE   
017B   7C                     LD   A,H   
017C   B5                     OR   L   
017D   FE 01                  CP   1   ; carry only if a - b = 0
017F   18 F3                  JR   tf   
0181                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0181                             ; multiplier shifts up through A:C.
0181                          IF   1-QK   
0181   D1           H_MUL:    POP   DE   ; DE = multiplicand
0182   C5                     PUSH   BC   
0183   7C                     LD   A,H   
0184   4D                     LD   C,L   ; A:C = multiplier
0185   21 00 00               LD   HL,0   
0188   06 10                  LD   B,16   
018A   29           MUL1:     ADD   HL,HL   
018B   CB 21                  SLA   C   
018D   17                     RLA      
018E   30 01                  JR   NC,mul2   
0190   19                     ADD   HL,DE   
0191   10 F7        MUL2:     DJNZ   mul1   
0193   C1                     POP   BC   
0194                          ;*Macro unroll:  NEXT
0194   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0195                          DS   CPM+FAST-CPM*FAST,0DDh   
0195                          DS   CPM+FAST-CPM*FAST,0E9h   
0195                          ENDIF      
0195                          IF   QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0195                          ENDIF      
0195                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0195                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0195                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0195                             ; stops on it.
0195                H_DIV:       
0195                          IF   CHECKED   
0195   7C                     LD   A,H   
0196   B5                     OR   L   
0197   CA 1E 04               JP   Z,e_zero   
019A                          ENDIF      
019A   D1                     POP   DE   ; DE = a, HL = b
019B   D5                     PUSH   DE   ; a, for r's sign
019C   7A                     LD   A,D   
019D   AC                     XOR   H   
019E   F5                     PUSH   AF   ; S flag = sign of q
019F   CB 7C                  BIT   7,H   
01A1   C4 20 00               CALL   NZ,neg16   ; HL = |b|
01A4   EB                     EX   DE,HL   
01A5   CB 7C                  BIT   7,H   
01A7   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
01AA   CD 96 02               CALL   udiv   ; HL = q, DE = r
01AD   F1                     POP   AF   
01AE   FC 20 00               CALL   M,neg16   ; q's sign
01B1   EB                     EX   DE,HL   ; HL = r, DE = q
01B2   F1                     POP   AF   ; A = a's high byte
01B3   B7                     OR   A   
01B4   FC 20 00               CALL   M,neg16   ; r's sign
01B7   D5                     PUSH   DE   ; q under r
01B8                          ;*Macro unroll:  NEXT
01B8   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01B9                          DS   CPM+FAST-CPM*FAST,0DDh   
01B9                          DS   CPM+FAST-CPM*FAST,0E9h   
01B9                             ; ---- stack and storage -----------------------------------------------------
01B9   E5           H_DUP:    PUSH   HL   ; ":"
01BA                          ;*Macro unroll:  NEXT
01BA   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01BB                          DS   CPM+FAST-CPM*FAST,0DDh   
01BB                          DS   CPM+FAST-CPM*FAST,0E9h   
01BB   E3           H_SWAP:   EX   (SP),HL   ; "%"
01BC                          ;*Macro unroll:  NEXT
01BC   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01BD                          DS   CPM+FAST-CPM*FAST,0DDh   
01BD                          DS   CPM+FAST-CPM*FAST,0E9h   
01BD                             ; (The checked build tests the address before it takes the value off the
01BD                             ; stack, so that an error report shows both.)
01BD                H_CSTORE:      ; "." ( c addr -- )
01BD                          IF   CHECKED   
01BD   CD FA 03               CALL   chkst   
01C0                          ENDIF      
01C0   D1                     POP   DE   
01C1   73                     LD   (HL),E   
01C2                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
01C2   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
01C3                          DS   CPM+FAST-CPM*FAST,0E1h   
01C3                          DS   CPM+FAST-CPM*FAST,0DDh   
01C3                          DS   CPM+FAST-CPM*FAST,0E9h   
01C3                H_STORE:      ; "!" ( n addr -- )
01C3                          IF   CHECKED   
01C3   CD FA 03               CALL   chkst   
01C6                          ENDIF      
01C6   D1                     POP   DE   
01C7   73                     LD   (HL),E   
01C8   23                     INC   HL   
01C9   72                     LD   (HL),D   
01CA                          ;*Macro unroll:  DROP
01CA   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01CB                          DS   CPM+FAST-CPM*FAST,0E1h   
01CB                          DS   CPM+FAST-CPM*FAST,0DDh   
01CB                          DS   CPM+FAST-CPM*FAST,0E9h   
01CB                             ; ---- console ---------------------------------------------------------------
01CB                             ; 22h pushes the address of the text after it and skips the string.
01CB   E5           H_STR:    PUSH   HL   
01CC   60                     LD   H,B   
01CD   69                     LD   L,C   
01CE   CD D4 02               CALL   skipstr   
01D1                          IF   CHECKED   
01D1   B7                     OR   A   ; 0: the text ran out before the closing quote
01D2   CA 16 04               JP   Z,e_quote   
01D5                          ENDIF      
01D5                          ;*Macro unroll:  NEXT
01D5   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01D6                          DS   CPM+FAST-CPM*FAST,0DDh   
01D6                          DS   CPM+FAST-CPM*FAST,0E9h   
01D6                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01D6                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01D6                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01D6                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01D6                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01D6                          ENDIF      
01D6                          IF   CHECKED   
01D6                             ; (The checked build has the loop as a routine, prstr, which the error
01D6                             ; report uses too. The address is kept meanwhile, for a report: it shows
01D6                             ; the stack as it was before the "$". /~ comes back to hp1.)
01D6   22 34 82     H_PRINT:   LD   (RSAVE),HL   
01D9   CD 2F 02     HP1:      CALL   prstr   
01DC                          ;*Macro unroll:  DROP
01DC   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01DD                          DS   CPM+FAST-CPM*FAST,0E1h   
01DD                          DS   CPM+FAST-CPM*FAST,0DDh   
01DD                          DS   CPM+FAST-CPM*FAST,0E9h   
01DD                          ENDIF      
01DD   7D           H_EMIT:   LD   A,L   ; "'"
01DE                          ;*Macro unroll:  PUTA
01DE   EF                     DS   1-CPM,0EFh   
01DF                          DS   CPM,0CDh   
01DF                          DS   CPM,APUT&0FFh   
01DF                          DS   CPM,APUT/256   
01DF                          ;*Macro unroll: pr9:    DROP
01DF   DF           PR9:      DS   (1-CPM)*(1-FAST),0DFh   
01E0                          DS   CPM+FAST-CPM*FAST,0E1h   
01E0                          DS   CPM+FAST-CPM*FAST,0DDh   
01E0                          DS   CPM+FAST-CPM*FAST,0E9h   
01E0                             ; "#" prints TOS as a signed decimal number, with no space after it.
01E0   CD 36 03     H_NUM:    CALL   psgn   
01E3                          ;*Macro unroll:  DROP
01E3   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01E4                          DS   CPM+FAST-CPM*FAST,0E1h   
01E4                          DS   CPM+FAST-CPM*FAST,0DDh   
01E4                          DS   CPM+FAST-CPM*FAST,0E9h   
01E4                             ; "?" ( n -- c ) or ( -n -- addr )
01E4                             ;   n > 0: wait about n ms for a key; 0 if none came
01E4                             ;   n = 0: wait for a key
01E4                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01E4                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01E4   CB 7C        H_KEY:    BIT   7,H   
01E6   20 19                  JR   NZ,line   
01E8   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01EA   CD 9E 03     KT2:      CALL   getk   
01ED   20 0E                  JR   NZ,kt3   
01EF   1D                     DEC   E   
01F0   20 F8                  JR   NZ,kt2   
01F2   7C                     LD   A,H   ; 0? never counts down: it waits
01F3   B5                     OR   L   
01F4   28 F2                  JR   Z,kt1   
01F6   2B                     DEC   HL   
01F7   7C                     LD   A,H   
01F8   B5                     OR   L   
01F9   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01FB   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01FC   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01FD   6F           KT3:      LD   L,A   
01FE   26 00                  LD   H,0   
0200                          ;*Macro unroll:  NEXT
0200   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0201                          DS   CPM+FAST-CPM*FAST,0DDh   
0201                          DS   CPM+FAST-CPM*FAST,0E9h   
0201                             ; Backspace takes the last character back (and is echoed as it
0201                             ; is), CR ends (stored, not echoed), every other key is stored and
0201                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
0201                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
0201                             ; is the place in the line: D holds the L of a full line.
0201   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
0204   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
0205   9F                     SBC   A,A   
0206   A5                     AND   L   ; (0 for a count that is too big)
0207   2F                     CPL      
0208   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
0209                             ;   at most
0209   21 80 82               LD   HL,LINEBUF   
020C   CD 9E 03     LN2:      CALL   getk   
020F   28 FB                  JR   Z,ln2   
0211   FE 0D                  CP   13   
0213   28 16                  JR   Z,ln5   
0215   FE 08                  CP   8   
0217   28 0B                  JR   Z,ln4   
0219   5F                     LD   E,A   
021A   7D                     LD   A,L   
021B   BA                     CP   D   
021C   28 EE                  JR   Z,ln2   ; full
021E   73                     LD   (HL),E   
021F   2C                     INC   L   
0220   7B                     LD   A,E   
0221                          ;*Macro unroll: ln3:    PUTA
0221   EF           LN3:      DS   1-CPM,0EFh   
0222                          DS   CPM,0CDh   
0222                          DS   CPM,APUT&0FFh   
0222                          DS   CPM,APUT/256   
0222   18 E8                  JR   ln2   
0224   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0225   FA 21 02               JP   M,ln3   ;   unless the line was empty (L left the
0228   2C                     INC   L   ;   upper half of the page)
0229   18 E1                  JR   ln2   
022B   77           LN5:      LD   (HL),A   ; the CR
022C   2E 80                  LD   L,LINEBUF & 0FFh   
022E                          ;*Macro unroll:  NEXT
022E   F7                     DS   (1-CPM)*(1-FAST),0F7h   
022F                          DS   CPM+FAST-CPM*FAST,0DDh   
022F                          DS   CPM+FAST-CPM*FAST,0E9h   
022F                             ; =============================================================================
022F                             ;  More routines (no handler starts past this point)
022F                             ; =============================================================================
022F                          IF   CHECKED   
022F                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
022F                             ; "$", and the texts of the report). A NUL first is an error: Q.
022F   7E           PRSTR:    LD   A,(HL)   
0230   23                     INC   HL   
0231   FE 22                  CP   22h   
0233   C8                     RET   Z   
0234   B7                     OR   A   
0235   CA 0C 04               JP   Z,e_dollar   
0238   FE 2F                  CP   "/"   
023A   20 0C                  JR   NZ,prs1   
023C   7E                     LD   A,(HL)   
023D   23                     INC   HL   
023E   FE 60                  CP   60h   
0240   38 04                  JR   C,prs0   
0242   FE 7F                  CP   7Fh   
0244   38 11                  JR   C,pesc   
0246   E6 BF        PRS0:     AND   0BFh   
0248                          ;*Macro unroll: prs1:   PUTA
0248   EF           PRS1:     DS   1-CPM,0EFh   
0249                          DS   CPM,0CDh   
0249                          DS   CPM,APUT&0FFh   
0249                          DS   CPM,APUT/256   
0249   18 E4                  JR   prstr   
024B                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
024B                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
024B                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
024B                             ; pnl: the same, on a new line.
024B   CD 51 02     PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
024E   0D 0A 22               DB   13,10,22h   ;   the caller's text)
0251   E3           PMSG:     EX   (SP),HL   
0252   CD 2F 02               CALL   prstr   
0255   E3                     EX   (SP),HL   
0256   C9                     RET      
0257                          ENDIF      
0257                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0257                             ; HL points past it. Each goes back into the loop that prints the string
0257                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0257                             ;    /a-/z   print the variable, as "#" does
0257                             ;    /{      clear the screen, the cursor to the top left
0257                             ;    /}      clear from the cursor to the end of the line
0257                             ;    /|  /`  show the cursor, hide it
0257                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0257   FE 7E        PESC:     CP   7Eh   
0259   28 1C                  JR   Z,pat   
025B   11 2F 02               LD   DE,PRLOOP   ; the others return into the loop
025E   D5                     PUSH   DE   
025F   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0261   30 26                  JR   NC,pcon   
0263   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0265   30 2B                  JR   NC,phide   
0267   87                     ADD   A,A   ; the variable's cell
0268   C6 40                  ADD   A,40h   
026A   E5                     PUSH   HL   
026B   6F                     LD   L,A   
026C   26 82                  LD   H,LETPAGE   
026E   7E                     LD   A,(HL)   
026F   2C                     INC   L   
0270   66                     LD   H,(HL)   
0271   6F                     LD   L,A   
0272   CD 36 03               CALL   psgn   
0275   E1                     POP   HL   
0276   C9                     RET      
0277                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0277                             ; the checked build "$" is the routine prstr: its own return address goes
0277                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0277                             ; its two cells are there, and is s if not, before it prints anything.
0277                PAT:         
0277                          IF   CHECKED   
0277   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
0278   21 0A 7E               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
027B   39                     ADD   HL,SP   
027C   DA D4 03               JP   C,e_under   
027F   E1                     POP   HL   
0280                          ENDIF      
0280   D1                     POP   DE   ; DE = the column
0281   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0282                          IF   1-ANS   
0282   CD 15 FF               CALL   CONAT   
0285   E1                     POP   HL   
0286   C3 D9 01               JP   PRAGAIN   
0289                             ; With ANSI = 0 the machine's routines do the rest.
0289   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
028C   FE 02                  CP   2   
028E   CA 0F FF               JP   Z,CONEOL   ; /}
0291   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
0292   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0293   C3 12 FF               JP   CONCUR   
0296                          ENDIF      
0296                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    3Bh             ; ';'
                              DS   1-CPM,3Eh   ; ";"
                              DS   1-CPM,3Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Bh   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    48h             ; 'H'
                              DS   1-CPM,3Eh   ; "H"
                              DS   1-CPM,48h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,48h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0296                          ENDIF      
0296                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0296                          ENDIF      
0296                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
0296                          ENDIF      
0296                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0296                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0296                             ; the quotient bits arrive at the bottom of C.
0296                             ; Dividing by 2 is one shift (the spec wants that fast).
0296                          IF   1-QK   
0296   7B           UDIV:     LD   A,E   
0297   EE 02                  XOR   2   
0299   B2                     OR   D   
029A   20 07                  JR   NZ,udv0   
029C   CB 3C                  SRL   H   
029E   CB 1D                  RR   L   ; the quotient
02A0   8F                     ADC   A,A   
02A1   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
02A2   C9                     RET      
02A3                          ENDIF      
02A3                          IF   QK   
                                 ; (The builds with room divide by any power of two with shifts: 2, and 32,
                                 ; 64, 256 and the like, which fixed point and byte work use all the time.)
                    UDIV:     LD   A,D   
                              OR   A   
                              JR   NZ,uq1   ; 256 and up
                              OR   E   
                              JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
                              DEC   A   
                              AND   E   
                              JR   NZ,udv0   ; not a power of two
                              LD   A,E   ; by 2^k below 256: q = HL >> k, and
                              DEC   A   ;   r = L & (2^k - 1)
                              AND   L   
                              PUSH   AF   
                    UQ2:      SRL   E   
                              JR   C,uq3   
                              SRL   H   
                              RR   L   
                              JR   uq2   
                    UQ3:      POP   AF   
                              LD   E,A   
                              LD   D,0   
                              RET      
                    UQ1:      LD   A,E   
                              OR   A   
                              JR   NZ,udv0   
                              LD   A,D   
                              DEC   A   
                              AND   D   
                              JR   NZ,udv0   ; not a power of two
                              LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
                              DEC   A   ;   r = HL & (2^k - 1)
                              AND   H   
                              LD   E,A   ; (the remainder's high byte,
                              LD   A,L   ;   and its low byte)
                              LD   L,H   
                              LD   H,0   
                    UQ4:      SRL   D   
                              JR   C,uq5   
                              SRL   L   
                              JR   uq4   
                    UQ5:      LD   D,E   
                              LD   E,A   
                              RET      
02A3                          ENDIF      
02A3                          IF   1-FAST   
02A3   C5           UDV0:     PUSH   BC   
02A4   7C                     LD   A,H   
02A5   4D                     LD   C,L   
02A6   21 00 00               LD   HL,0   
02A9   06 10                  LD   B,16   
02AB   CB 21        UDV1:     SLA   C   
02AD   17                     RLA      
02AE   ED 6A                  ADC   HL,HL   
02B0   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
02B2   30 02                  JR   NC,udv2   ;   always fits in 16 bits
02B4   19                     ADD   HL,DE   ; too much: put it back, and cancel the
02B5   0D                     DEC   C   ;   INC below
02B6   0C           UDV2:     INC   C   ; a quotient bit
02B7   10 F2                  DJNZ   udv1   
02B9   EB                     EX   DE,HL   ; DE = remainder
02BA   67                     LD   H,A   
02BB   69                     LD   L,C   ; HL = quotient
02BC   C1                     POP   BC   
02BD   C9                     RET      
02BE                          ENDIF      
02BE                          IF   FAST   
                                 ; (the speed build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
02BE                          ENDIF      
02BE                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
02BE                             ; non-digit. Values wrap at 16 bits, as the spec says.
02BE   21 00 00     RDNUM:    LD   HL,0   
02C1   0A           RDN1:     LD   A,(BC)   
02C2   D6 30                  SUB   "0"   
02C4   FE 0A                  CP   10   
02C6   D0                     RET   NC   
02C7   03                     INC   BC   
02C8   54                     LD   D,H   
02C9   5D                     LD   E,L   
02CA   29                     ADD   HL,HL   
02CB   29                     ADD   HL,HL   
02CC   19                     ADD   HL,DE   
02CD   29                     ADD   HL,HL   ; HL * 10
02CE   5F                     LD   E,A   
02CF   16 00                  LD   D,0   
02D1   19                     ADD   HL,DE   
02D2   18 ED                  JR   rdn1   
02D4                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02D4                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02D4                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
02D4                          ENDIF      
02D4                          IF   CHECKED   
02D4                             ; The checked build never steps over a NUL: if the text runs out first it
02D4                             ; returns A = 0 with the IP on the NUL.
02D4   0A           SKIPSTR:   LD   A,(BC)   
02D5   B7                     OR   A   
02D6   C8                     RET   Z   
02D7   03                     INC   BC   
02D8   FE 22                  CP   22h   
02DA   C8                     RET   Z   
02DB   FE 2F                  CP   "/"   
02DD   20 F5                  JR   NZ,skipstr   
02DF   0A                     LD   A,(BC)   ; the escaped character
02E0   B7                     OR   A   
02E1   C8                     RET   Z   
02E2   03                     INC   BC   
02E3   18 EF                  JR   skipstr   
02E5                          ENDIF      
02E5                             ; skip: read past text to the closer at this level, and return A = 0 if it
02E5                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02E5                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02E5                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02E5                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02E5                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02E5                             ; 
02E5                             ; The checked build also looks at the character the skip was started by,
02E5                             ; which is always the one just before where it starts: "(" must end at ")",
02E5                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02E5                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
02E5                             ; place where the skip started, for the report.
02E5                          IF   1-QK   
02E5                             ; (Without QUICK: no skip cache.)
02E5                SKIP:        
02E5                          ENDIF      
02E5                          IF   CHECKED*(1-QK)   
02E5   ED 43 3C 82            LD   (SKPL),BC   
02E9   0B                     DEC   BC   
02EA   0A                     LD   A,(BC)   
02EB   03                     INC   BC   
02EC   5F                     LD   E,A   ; E = the opener: ( [ or \
02ED                          ENDIF      
02ED                          IF   1-QK   
02ED   16 00                  LD   D,0   
02EF   14           SK3:      INC   D   ; an opener: one deeper
02F0   0A           SK1:      LD   A,(BC)   
02F1                          ENDIF      
02F1                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
02F1                          ENDIF      
02F1                          IF   CHECKED*(1-QK)   
02F1   B7                     OR   A   
02F2   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
02F4   03                     INC   BC   
02F5                          ENDIF      
02F5                          IF   1-QK   
02F5   FE 22                  CP   22h   
02F7   CC D4 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02FA   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02FC   28 F1                  JR   Z,sk3   
02FE   3D                     DEC   A   ; ")"
02FF   28 08                  JR   Z,sk4   
0301   D6 32                  SUB   "["-")"   
0303   28 EA                  JR   Z,sk3   
0305   FE 02                  CP   "]"-"["   
0307   20 E7                  JR   NZ,sk1   
0309   15           SK4:      DEC   D   
030A                          ENDIF      
030A                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
030A                          ENDIF      
030A                          IF   CHECKED*(1-QK)   
030A   20 E4                  JR   NZ,sk1   
030C   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
030D   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
030E   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0310   FE 02                  CP   2   ;   closer, and only then
0312   7A                     LD   A,D   
0313   C0                     RET   NZ   
0314   18 05                  JR   sk7   
0316   CB 53        SK6:      BIT   2,E   ; the text ran out:
0318   C2 09 FF               JP   NZ,SKEND   ;   "\" with no closer ends the program
031B   ED 4B 3C 82  SK7:      LD   BC,(SKPL)   ; N. The place is the opener
031F   3E 4E                  LD   A,"N"   
0321   C3 09 04               JP   errp   ; (errp drops skip's return address)
0324                          ENDIF      
0324                          IF   QK   
                                 ; The skip cache. Nearly every skip is one that has happened before (a loop
                                 ; skips the same false block on every pass), so the first scan from each
                                 ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
                                 ; start's low byte. Only skips that start in the program text are kept (the
                                 ; line buffer changes); the cache is emptied whenever a run starts (skclr).
                                 ; A program that changes its own text while it runs is not looked after.
                    SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
                              LD   A,B   ;   checked report's place)
                              CP   PROG/256   
                              JR   C,sks   ; below the program text: no cache
                              LD   A,C   
                              ADD   A,A   
                              ADD   A,A   
                              LD   E,A   
                              LD   D,CPAGE   ; DE -> the entry
                              LD   A,(DE)   
                              CP   C   
                              JR   NZ,sks   
                              INC   E   
                              LD   A,(DE)   
                              CP   B   
                              JR   NZ,sks   
                              INC   E   
                              LD   A,(DE)   
                              LD   C,A   
                              INC   E   
                              LD   A,(DE)   
                              LD   B,A   ; a hit: the IP is past the closer
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              SUB   ")"   ; 0 for ")", not 0 for "]"
                              RET      
                    SKS:         
0324                          ENDIF      
0324                          IF   QK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0324                          ENDIF      
0324                          IF   QK   
                                 ; The scan. Most characters are nothing to it, and two range tests rule
                                 ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                              LD   D,0   
                    SQ3:      INC   D   ; an opener: one deeper
                    SQ1:      LD   A,(BC)   
                              INC   BC   
                              CP   5Eh   
                              JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CP   5Bh   
                              JR   NC,sqb   ; [ \ ]
                              CP   2Ah   
                              JR   NC,sq1   ; * to Z: nothing
                              CP   28h   
                              JR   Z,sq3   ; (
                              JR   NC,sqc   ; )
                              CP   22h   
                              JR   Z,sqq   ; a string
                              OR   A   
                              JR   NZ,sq1   ; the rest below "(": nothing
0324                          ENDIF      
0324                          IF   QK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
0324                          ENDIF      
0324                          IF   QK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0324                          ENDIF      
0324                          IF   QK   
                    SQQ:      CALL   skipstr   ; step over the string
                              JR   sq1   
                    SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
                              JR   Z,sq1   ; "\" is nothing here
                              JR   C,sq3   ; [
                              LD   A,2   ; ]
                              JR   sq4   
                    SQC:      XOR   A   ; )
                    SQ4:      DEC   D   
                              JR   NZ,sq1   
0324                          ENDIF      
0324                          IF   QK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
0324                          ENDIF      
0324                          IF   QK   
                                 ; The closer at this level: remember the skip (if it started in the program
                                 ; text), and return A = 0 for ")" or 2 for "]".
                              PUSH   AF   
                              PUSH   HL   
                              LD   HL,(SKPL)   
                              LD   A,H   
                              CP   PROG/256   
                              JR   C,sq9   
                              LD   A,L   
                              ADD   A,A   
                              ADD   A,A   
                              LD   E,A   
                              LD   D,CPAGE   
                              LD   A,L   
                              LD   (DE),A   
                              INC   E   
                              LD   A,H   
                              LD   (DE),A   
                              INC   E   
                              LD   A,C   
                              LD   (DE),A   
                              INC   E   
                              LD   A,B   
                              LD   (DE),A   
                    SQ9:      POP   HL   
                              POP   AF   
                              RET      
                                 ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
                    SKCLR:    PUSH   HL   
                              LD   HL,CPAGE*256   
                    SKC1:     LD   (HL),0   
                              INC   L   
                              JR   NZ,skc1   
                              POP   HL   
                              RET      
0324                          ENDIF      
0324                             ;  ---- Speed-ups (QUICK builds) -------------------------------------------
0324                             ;  The skip cache is above. These are the handlers' tails that the builds with
0324                             ;  room take, kept here, out of the handlers' first two pages.
0324                          IF   QK   
                                 ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
                                 ; multiplier (most multiplications have one, a count or a small constant).
                    MULQ:     LD   A,H   
                              OR   A   
                              JR   Z,mq8   ; the multiplier is below 256
                              LD   A,D   
                              OR   A   
                              JR   NZ,mq16   
                              EX   DE,HL   ; the multiplicand is: it becomes the multiplier
0324                          ENDIF      
0324                          IF   QK*(1-FAST)   
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              PUSH   BC   
                              LD   B,8   
                    MQ1:      ADD   HL,HL   
                              RLA      
                              JR   NC,mq2   
                              ADD   HL,DE   
                    MQ2:      DJNZ   mq1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    MQ3:      ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mq4   
                              ADD   HL,DE   
                    MQ4:      DJNZ   mq3   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0324                          ENDIF      
0324                          IF   FAST   
                                 ; (the speed build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0324                          ENDIF      
0324                          IF   QK   
                                 ; A true ")" reads the block start where it is, on top of the return stack,
                                 ; instead of popping it and pushing it back; the break key is looked at as
                                 ; rpushn would.
                    CLOSEQ:   LD   C,(IY+0)   
                              LD   B,(IY+1)   
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0324                          ENDIF      
0324                          IF   QUICKU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0324                          ENDIF      
0324                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
0324                          ENDIF      
0324                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
0324                          ENDIF      
0324                             ; =============================================================================
0324                             ;  Dispatch table: the low byte of each handler's address, in code order
0324                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0324                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0324                             ; =============================================================================
0324                             ; The handlers of the first NPG1 characters start in the image's second page.
0324                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0324                             ; differs between the builds, so the count is worked out here.
0324                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0324                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0324                PGBRK:    EQU   (h_break-BASE)/256   
0324                PGDEF:    EQU   (h_def-BASE)/256   
0324                PGFET:    EQU   (h_fetch-BASE)/256   
0324                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0324                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0324                          ENDIF      
0324                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0324                             ; and return its value in A with the carry set; otherwise leave the IP and
0324                             ; return with the carry clear.
0324   0A           HEXC:     LD   A,(BC)   
0325   D6 30                  SUB   "0"   
0327   FE 0A                  CP   10   
0329   38 09                  JR   C,hc1   
032B   E6 DF                  AND   0DFh   
032D   D6 11                  SUB   11h   
032F   FE 06                  CP   6   
0331   D0                     RET   NC   
0332   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0334   03           HC1:      INC   BC   
0335   C9                     RET      
0336                             ; psgn: print HL as a signed number. Keeps BC.
0336   CB 7C        PSGN:     BIT   7,H   
0338   28 04                  JR   Z,pdec   
033A                          ;*Macro unroll:  PUTK    2Dh             ; '-'
033A   3E                     DS   1-CPM,3Eh   ; "-"
033B   2D                     DS   1-CPM,2Dh   
033C   EF                     DS   1-CPM,0EFh   
033D                          DS   CPM,0CDh   
033D                          DS   CPM,APTK&0FFh   
033D                          DS   CPM,APTK/256   
033D                          DS   CPM,2Dh   
033D                          ;*Macro unroll:  NEGH
033D   E7                     DS   1-CPM,0E7h   
033E                          DS   CPM,0CDh   
033E                          DS   CPM,ANEG&0FFh   
033E                          DS   CPM,ANEG/256   
033E                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
033E                             ; Keeps BC.
033E   11 0A 00     PDEC:     LD   DE,10   
0341   CD 96 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0344   7B                     LD   A,E   
0345   F5                     PUSH   AF   
0346   7C                     LD   A,H   
0347   B5                     OR   L   
0348   C4 3E 03               CALL   NZ,pdec   
034B   F1                     POP   AF   
034C   C6 30                  ADD   A,"0"   
034E                          ;*Macro unroll:  PUTAR
034E   EF                     DS   1-CPM,0EFh   
034F   C9                     DS   1-CPM,0C9h   
0350                          DS   CPM,0C3h   
0350                          DS   CPM,APUT&0FFh   
0350                          DS   CPM,APUT/256   
0350                             ; (The table goes here instead in the builds where, before psgn, it would
0350                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0350                             ; page: PTPAD is 0 unless it must.)
0350                          IF   (1-TABP0)*PTLATE   
0350                PTPH:     EQU   $ & 0FFh   
0350                PTPX:     EQU   (PTPH + 31) / 256   
0350                PTPAD:    EQU   PTPX * (256 - PTPH)   
0350                          DS   PTPAD   
0350                PTAB:        
0350                          ;*Macro unroll:  PTABLE
0350   C3                     DB   h_store & 0FFh   
0351   CB                     DB   h_str & 0FFh   
0352   E0                     DB   h_num & 0FFh   
0353   D6                     DB   h_print & 0FFh   
0354   BB                     DB   h_swap & 0FFh   
0355   60                     DB   h_and & 0FFh   
0356   DD                     DB   h_emit & 0FFh   
0357   3C                     DB   h_open & 0FFh   
0358   44                     DB   h_close & 0FFh   
0359   81                     DB   h_mul & 0FFh   
035A   57                     DB   h_add & 0FFh   
035B   FC                     DB   h_cfetch & 0FFh   
035C   4F                     DB   h_sub & 0FFh   
035D   BD                     DB   h_cstore & 0FFh   
035E   95                     DB   h_div & 0FFh   
035F   B9                     DB   h_dup & 0FFh   
0360   C2                     DB   h_drop & 0FFh   
0361   68                     DB   h_lt & 0FFh   
0362   77                     DB   h_eq & 0FFh   
0363   69                     DB   h_gt & 0FFh   
0364   E4                     DB   h_key & 0FFh   
0365   37                     DB   h_fetch & 0FFh   
0366   13                     DB   h_def & 0FFh   
0367   06                     DB   h_break & 0FFh   
0368   02                     DB   h_ret & 0FFh   
0369   90                     DB   h_xor & 0FFh   
036A   A3                     DB   h_alloc & 0FFh   
036B   EC                     DB   h_grave & 0FFh   
036C   E8                     DB   h_tor & 0FFh   
036D   98                     DB   h_or & 0FFh   
036E   1C                     DB   h_fromr & 0FFh   
036F   A0                     DB   h_not & 0FFh   
0370                PTABEND:      
0370                          ENDIF      
0370                             ; =============================================================================
0370                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0370                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0370                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0370                             ;  they are the host's KEY and CONOUT routines themselves.
0370                             ; 
0370                             ;  A running program reads the keyboard only through getk and pollk, which
0370                             ;  between them give the break key its rules:
0370                             ;    - Ctrl-C stops the program;
0370                             ;    - any other key that the break check reads is held in KEYBUF for the
0370                             ;      next "?", and a newer one takes its place;
0370                             ;    - "?" (getk) takes the held key first;
0370                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0370                             ;      key like any other, but two of them within about 250 ms still stop it.
0370                             ;  Both are called straight from a handler, never from a routine under one:
0370                             ;  the checked build's report counts on finding one return address above the
0370                             ;  data stack.
0370                             ; =============================================================================
0370                          IFN   CPM   
0370                RAWK:     EQU   KEY   
0370                          ENDIF      
0370                             ; pollk: the break check (see rpushn).
0370   CD 06 FF     POLLK:    CALL   rawk   
0373   C8                     RET   Z   ; no key
0374   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0377   FE 03        PK1:      CP   3   ; (getk joins here)
0379   C0                     RET   NZ   
037A                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
037A                             ; the program has turned it off, wait about 250 ms for one more key: a
037A                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
037A                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
037A   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
037D   B7                     OR   A   
037E   CA 07 04     CT0:      JP   Z,brk   
0381   D5                     PUSH   DE   
0382   11 10 27               LD   DE,250*MSLOOP   
0385   CD 06 FF     CT1:      CALL   rawk   
0388   20 05                  JR   NZ,ct2   
038A   1B                     DEC   DE   
038B   7A                     LD   A,D   
038C   B3                     OR   E   
038D   20 F6                  JR   NZ,ct1   
038F   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0390   FE 03                  CP   3   
0392   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0394   B7                     OR   A   
0395   28 03                  JR   Z,ct3   
0397   32 7A 82               LD   (KEYBUF),A   
039A   3E 03        CT3:      LD   A,3   
039C   B7                     OR   A   
039D   C9                     RET      
039E                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
039E   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
039F   21 7A 82               LD   HL,KEYBUF   ;   the buffer
03A2   7E                     LD   A,(HL)   
03A3   36 00                  LD   (HL),0   
03A5   E1                     POP   HL   
03A6   B7                     OR   A   
03A7   C0                     RET   NZ   
03A8   CD 06 FF               CALL   rawk   
03AB   C8                     RET   Z   
03AC   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
03AE                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
03AE                          ENDIF      ;   (with the editor, both stacks are cleared);
03AE                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
03AE                          ENDIF      
03AE                          IF   CHECKED   
03AE                BRK:      EQU   e_break   ;   the checked build reports B
03AE                          ENDIF      
03AE                          IF   CPM   
                                 ; The routines a generic build keeps in page zero (see there). Here they are
                                 ; out of the way of the handlers, which must fit in the image's first two
                                 ; pages.
                    RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
                              LD   D,(IY+1)   
                              INC   IY   
                              INC   IY   
                              RET      
                    NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
03AE                          ENDIF      
03AE                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
03AE                          ENDIF      
03AE                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JR   putc   
                    PUTK:     EX   (SP),HL   ; print the byte after the CALL
                              LD   A,(HL)   
                              INC   HL   
                              EX   (SP),HL   
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                                 ; It keeps every register but A and the flags: BDOS may change any of them
                                 ; (IX and IY too, in a Z80 BDOS or BIOS).
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              PUSH   IX   
                              PUSH   IY   
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              POP   IY   
                              POP   IX   
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              OR   A   ; (for getk)
                              RET      
03AE                          ENDIF      
03AE                             ; =============================================================================
03AE                             ;  Checked build: the checks and the error report
03AE                             ; =============================================================================
03AE                          IF   CHECKED   
03AE                             ; chkstk: both stacks are checked once per character, not in every handler.
03AE                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
03AE                             ; the constant carries if it is above (cells were popped that were never
03AE                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
03AE                             ; a character late at most: the bytes above DSTOP and the guard band below
03AE                             ; the page take what happens meanwhile. DE is free between characters.
03AE   EB           CHKSTK:   EX   DE,HL   
03AF   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
03B2   39                     ADD   HL,SP   
03B3   EB                     EX   DE,HL   
03B4   38 1E                  JR   C,e_under   
03B6   14                     INC   D   
03B7   20 17                  JR   NZ,e_over   
03B9   FD E5                  PUSH   IY   ; the return stack: in its page (or it has
03BB   D1                     POP   DE   ;   overflowed), and not above its empty
03BC   7A                     LD   A,D   ;   position (an underflow stays inside the
03BD   FE 80                  CP   RSPAGE   ;   page, in the guard band)
03BF   7B                     LD   A,E   
03C0   20 0B                  JR   NZ,e_rover   
03C2   FE E1                  CP   RSTOP&0FFh+1   
03C4   D8                     RET   C   
03C5   FD 21 E0 80            LD   IY,RSTOP   ; return stack underflow: it counts as empty
03C9   3E 72                  LD   A,"r"   
03CB   18 3C                  JR   errp   
03CD   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
03CF   11                     DB   11h   ; (LD DE,nn hides the next entry)
03D0   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
03D2   18 35                  JR   errp   
03D4   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
03D7   3E 73                  LD   A,"s"   
03D9   18 48                  JR   error   
03DB                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
03DB                             ; was never defined still holds 0000h, and the byte there is a reserved one
03DB                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
03DB                             ; an undefined word. The call is undone, so the place is the call itself.
03DB   04           E_HI:     INC   B   
03DC   10 3D                  DJNZ   e_resv   ; (B is as it was, and is not 0)
03DE                          ;*Macro unroll:  POPR
03DE   CF                     DS   1-CPM,0CFh   
03DF                          DS   CPM,0CDh   
03DF                          DS   CPM,AROP&0FFh   
03DF                          DS   CPM,AROP/256   
03DF   42                     LD   B,D   
03E0   4B                     LD   C,E   
03E1   3E 55                  LD   A,"U"   
03E3   18 3E                  JR   error   
03E5                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
03E5                             ; the count. Stop if the top is not below the limit page, or is below the
03E5                             ; program's end.
03E5                CHKHP:       
03E5                          ENDIF      
03E5                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03E5                          ENDIF      
03E5                          IF   CHECKED*(1-CPM)   
03E5                             ; (Here the program's space is under 32K, so a top that wrapped
03E5                             ; round always falls outside it.)
03E5   7C                     LD   A,H   
03E6   FE F0                  CP   HEAPLIM   
03E8   30 09                  JR   NC,e_heap   
03EA                          ENDIF      
03EA                          IF   CHECKED   
03EA   D5                     PUSH   DE   
03EB   EB                     EX   DE,HL   
03EC   2A 38 82               LD   HL,(NPEND)   
03EF   19                     ADD   HL,DE   ; carry: at or above the program's end
03F0   EB                     EX   DE,HL   
03F1   D1                     POP   DE   
03F2   D8                     RET   C   
03F3   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
03F4   ED 52                  SBC   HL,DE   
03F6   3E 48                  LD   A,"H"   
03F8   18 0F                  JR   errp   
03FA                             ; chkst: stop unless HL is in the program's own space: from the letter page
03FA                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
03FA                             ; whatever lies above the limit are safe. Memory above the heap top but
03FA                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
03FA                             ; It is the page of HL + 1 that is tested, so that one test serves both
03FA                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
03FA                             ; Keeps HL and BC. It runs on into its own error entry.
03FA   23           CHKST:    INC   HL   
03FB   7C                     LD   A,H   
03FC   2B                     DEC   HL   
03FD   FE 82                  CP   LETPAGE   
03FF   38 03                  JR   C,e_store   
0401                          ENDIF      
0401                          IF   CHECKED*(1-CPM)   
0401   FE F0                  CP   HEAPLIM   
0403   D8                     RET   C   
0404                          ENDIF      
0404                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0404                          ENDIF      
0404                          IF   CHECKED   
0404                             ; Error entries. Each loads its letter and then hides the next entry inside
0404                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0404   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
0406   11                     DB   11h   
0407   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0409                             ; errp: an error found inside a routine: drop its return address first.
0409   D1           ERRP:     POP   DE   
040A   18 17                  JR   error   
040C                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
040C                             ; back in TOS. prstr"s return address goes first. But if "$' had no
040C                             ; address at all (the stack was empty), it is s, found now: chkstk, called
040C                             ; one cell up, sees the stack past its empty place then.
040C   D1           E_DOLLAR:   POP   DE   
040D   E1                     POP   HL   
040E   CD AE 03               CALL   chkstk   
0411   E5                     PUSH   HL   
0412   2A 34 82               LD   HL,(RSAVE)   
0415   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
0416   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0417   4D                     LD   C,L   ;   past the opening quote, which is the place
0418   3E 51                  LD   A,"Q"   
041A   11                     DB   11h   
041B   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
041D   11                     DB   11h   
041E   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0420   11                     DB   11h   
0421   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0423                             ; error: the report, then the end. A = the letter, BC = one past the place,
0423                             ; HL = TOS, and both stacks as the report is to show them:
0423                             ; 
0423                             ;   Err X @ line,col
0423                             ;   D:n: the top 8 cells at most, bottom to top
0423                             ;   R:n
0423   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0424   5F                     LD   E,A   
0425   CD 4B 02               CALL   pnl   
0428   45 72 72 20 22         DB   "Err ",22h   
042D   7B                     LD   A,E   
042E                          ;*Macro unroll:  PUTA
042E   EF                     DS   1-CPM,0EFh   
042F                          DS   CPM,0CDh   
042F                          DS   CPM,APUT&0FFh   
042F                          DS   CPM,APUT/256   
042F   CD 51 02               CALL   pmsg   
0432   20 40 20 22            DB   " @ ",22h   
0436   0B                     DEC   BC   ; BC = the place
0437                             ; The line and column. A place below the program is in the line
0437                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0437                             ; DE = the line's number, HL = where it starts.
0437   21 80 82               LD   HL,LINEBUF   
043A   11 00 00               LD   DE,0   
043D   78                     LD   A,B   
043E   FE 83                  CP   PROG/256   
0440   38 14                  JR   C,er3   
0442   24                     INC   H   
0443   6B                     LD   L,E   ; HL = PROG
0444   13           ER1:      INC   DE   ; a new line starts at HL
0445   E5                     PUSH   HL   
0446   7D           ER2:      LD   A,L   
0447   91                     SUB   C   
0448   7C                     LD   A,H   
0449   98                     SBC   A,B   
044A   30 09                  JR   NC,er2x   ; reached the place
044C   7E                     LD   A,(HL)   
044D   23                     INC   HL   
044E   FE 0A                  CP   10   
0450   20 F4                  JR   NZ,er2   
0452   F1                     POP   AF   
0453   18 EF                  JR   er1   
0455   E1           ER2X:     POP   HL   
0456   C5           ER3:      PUSH   BC   
0457   E5                     PUSH   HL   
0458   EB                     EX   DE,HL   
0459   CD 3E 03               CALL   pdec   ; the line
045C                          ;*Macro unroll:  PUTK    2Ch             ; ','
045C   3E                     DS   1-CPM,3Eh   ; ","
045D   2C                     DS   1-CPM,2Ch   
045E   EF                     DS   1-CPM,0EFh   
045F                          DS   CPM,0CDh   
045F                          DS   CPM,APTK&0FFh   
045F                          DS   CPM,APTK/256   
045F                          DS   CPM,2Ch   
045F   D1                     POP   DE   
0460   E1                     POP   HL   
0461   B7                     OR   A   
0462   ED 52                  SBC   HL,DE   
0464   23                     INC   HL   
0465   CD 3E 03               CALL   pdec   ; the column
0468                             ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
0468                             ;                       R:n
0468                             ; TOS is in memory with the rest (pushed) by now.
0468   CD 4B 02               CALL   pnl   
046B   44 3A 22               DB   "D:",22h   
046E   21 FA 81               LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
0471   ED 72                  SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
0473                             ;   and holds nothing; pnl left the carry clear)
0473   CD B9 04               CALL   phalf   ; the depth
0476                          ;*Macro unroll:  PUTK    3Ah             ; ':'
0476   3E                     DS   1-CPM,3Eh   ; ":"
0477   3A                     DS   1-CPM,3Ah   
0478   EF                     DS   1-CPM,0EFh   
0479                          DS   CPM,0CDh   
0479                          DS   CPM,APTK&0FFh   
0479                          DS   CPM,APTK/256   
0479                          DS   CPM,3Ah   
0479   79                     LD   A,C   
047A   FE 09                  CP   9   
047C   38 0A                  JR   C,er6   
047E   CD 51 02               CALL   pmsg   
0481   20 2E 2E 2E 22         DB   " ...",22h   
0486   0E 08                  LD   C,8   
0488   26 00        ER6:      LD   H,0   ; C = the number of cells to show
048A   69                     LD   L,C   
048B   29                     ADD   HL,HL   
048C   39                     ADD   HL,SP   ; HL -> just above the deepest of them
048D   0C                     INC   C   
048E   0D           ER7:      DEC   C   
048F   28 0F                  JR   Z,er8   
0491   2B                     DEC   HL   
0492   56                     LD   D,(HL)   
0493   2B                     DEC   HL   
0494   5E                     LD   E,(HL)   
0495   E5                     PUSH   HL   
0496                          ;*Macro unroll:  PUTK    20h             ; ' '
0496   3E                     DS   1-CPM,3Eh   ; " "
0497   20                     DS   1-CPM,20h   
0498   EF                     DS   1-CPM,0EFh   
0499                          DS   CPM,0CDh   
0499                          DS   CPM,APTK&0FFh   
0499                          DS   CPM,APTK/256   
0499                          DS   CPM,20h   
0499   EB                     EX   DE,HL   
049A   CD 36 03               CALL   psgn   
049D   E1                     POP   HL   
049E   18 EE                  JR   er7   
04A0   CD 4B 02     ER8:      CALL   pnl   
04A3   52 3A 22               DB   "R:",22h   
04A6   FD E5                  PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
04A8   E1                     POP   HL   ;   at most one entry below its page), so
04A9   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough
04AB   95                     SUB   L   
04AC   6F                     LD   L,A   
04AD   26 00                  LD   H,0   
04AF   CD B9 04               CALL   phalf   
04B2   CD 4B 02               CALL   pnl   
04B5   22                     DB   22h   
04B6                          ENDIF      
04B6                          IF   CHECKED*(1-EDITOR)   
04B6   C3 14 00               JP   endprog   
04B9                          ENDIF      
04B9                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
04B9                          ENDIF      
04B9                          IF   CHECKED   
04B9                             ; phalf: print half of HL, and leave it in C.
04B9   CB 3C        PHALF:    SRL   H   
04BB   CB 1D                  RR   L   
04BD   E5                     PUSH   HL   
04BE   CD 3E 03               CALL   pdec   
04C1   C1                     POP   BC   
04C2   C9                     RET      
04C3                          ENDIF      
04C3                             ; =============================================================================
04C3                             ;  The line editor (EDITOR = 1)
04C3                             ; 
04C3                             ;  The interpreter starts here, and a program that ends comes back here.
04C3                             ;  There is no prompt. It follows the spec's suggested standard for a line
04C3                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
04C3                             ; 
04C3                             ;    n text    put the text in as line n; the lines from n on move down. A
04C3                             ;              number past the end (or 0) adds the line at the end.
04C3                             ;    n         take line n out
04C3                             ;    anything else is run at once, as B8Script. (Start such a line with a
04C3                             ;    space if it would begin with a digit.)
04C3                             ; 
04C3                             ;  A command key ends the line too, and takes what was typed as its argument:
04C3                             ; 
04C3                             ;    ^G        run the program
04C3                             ;    n ^L      list from line n (no number: all of it). Any key holds the
04C3                             ;              list until another key is pressed; Ctrl-C ends it.
04C3                             ;    n ^E      put line n in the input line; Return puts it back, changed
04C3                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
04C3                             ;              last time). Generic: what is typed, or pasted, from now until
04C3                             ;              ^Z replaces the program; it is not echoed.
04C3                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
04C3                             ;              time). Generic: the text is printed, as it is.
04C3                             ;    ^N        new: no program
04C3                             ;    ^X        leave (to LEAVE)
04C3                             ; 
04C3                             ;  In the line: the left and right arrow keys move the cursor;
04C3                             ;  a character goes in at the cursor; Backspace and DEL take out the one
04C3                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
04C3                             ;  sent to the terminal, so any terminal will do.
04C3                             ; 
04C3                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
04C3                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
04C3                             ;  125 characters; the one character after a line number separates it from
04C3                             ;  the text and is not stored. The text is kept as it is typed, each line
04C3                             ;  ending in CR LF, at PROG.
04C3                             ; 
04C3                             ;  What lasts from one line to the next: the program, the words, the
04C3                             ;  variables and the data stack. An error or a break clears both stacks. The
04C3                             ;  return stack starts empty for every line.
04C3                             ; 
04C3                             ;  Things to know:
04C3                             ;    - Reset empties the program (generic builds).
04C3                             ;    - A word's address points into the program, so run the program again
04C3                             ;      after editing it.
04C3                             ;    - Nothing is printed between a program's output and what is typed next.
04C3                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
04C3                             ;      a line that calls -n? and carries on afterwards runs what was typed.
04C3                             ;      (The stored program never comes back to the line, so it may.)
04C3                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
04C3                             ;      read of the other builds.
04C3                             ; 
04C3                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
04C3                             ;  the last line left there, with TOS pushed like the rest.
04C3                             ; =============================================================================
04C3                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
04C3                          ENDIF      
04C3                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
04C3                          ENDIF      
04C3                          IF   EDGEN   
                              JR   edit0   
04C3                          ENDIF      
04C3                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
04C3                          ENDIF      
04C3                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
04C3                          ENDIF      
04C3                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
04C3                          ENDIF      
04C3                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
04C3                          ENDIF      
04C3                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
04C3                          ENDIF      
04C3                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
04C3                          ENDIF      
04C3                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
04C3                          ENDIF      
04C3                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
04C3                          ENDIF      
04C3                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
04C3                          ENDIF      
04C3                             ; =============================================================================
04C3                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
04C3                          ENDIF      
04C3                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
04C3                          ENDIF      
04C3                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
04C3                          ENDIF      
04C3                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
04C3                          ENDIF      
04C3                          IF   CPM*(1-EDITOR)   
                              JP   st2   
04C3                          ENDIF      
04C3                          IF   FAST   
                                 ; =============================================================================
                                 ;  The speed build (FAST = 1)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the speed build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the speed build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
