E582   F0 1F                  BEQ   er5   ;   from the top is at X+2i
E584   C6 05                  DEC   T1   
E586   A9 20                  LDA   #" "   
E588   20 03 FF               JSR   CONOUT   
E58B   A5 05                  LDA   T1   
E58D   0A                     ASL      
E58E   85 06                  STA   T2   
E590   8A                     TXA      
E591   65 06                  ADC   T2   ; (the carry is clear)
E593   A8                     TAY      
E594   B9 00 00               LDA   0,Y   
E597   48                     PHA      
E598   B9 01 00               LDA   1,Y   
E59B   A8                     TAY      
E59C   68                     PLA      
E59D   20 BB E5               JSR   prnum   
E5A0   4C 80 E5               JMP   er4   
