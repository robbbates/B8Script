040D                          IF   CHECKED*(1-CPM)   
040D   FE F0                  CP   HEAPLIM   
040F   D8                     RET   C   
0410                          ENDIF      
0410                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0410                          ENDIF      
0410                          IF   CHECKED   
0410                             ; Error entries. Each loads its letter and then hides the next entry inside
0410                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0410   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
0412   11                     DB   11h   
0413   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0415                             ; errp: an error found inside a routine: drop its return address first.
0415   D1           ERRP:     POP   DE   
0416   18 0D                  JR   error   
