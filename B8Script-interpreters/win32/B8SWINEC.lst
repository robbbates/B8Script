  1224                              <1> ; =============================================================================
  1225                              <1> ;  The line editor (EDITOR = 1)
  1226                              <1> ;
  1227                              <1> ;  The interpreter starts here, and a program that ends comes back here.
  1228                              <1> ;  There is no prompt. It follows the spec's suggested standard for a line
  1229                              <1> ;  editor (docs/b8script.md, Environments), and is the Z80's editor, key for
  1230                              <1> ;  key. Type a line and press Return:
  1231                              <1> ;
  1232                              <1> ;    n text    put the text in as line n; the lines from n on move down. A
  1233                              <1> ;              number past the end (or 0) adds the line at the end.
  1234                              <1> ;    n         take line n out
  1235                              <1> ;    anything else is run at once, as B8Script. (Start such a line with a
  1236                              <1> ;    space if it would begin with a digit.)
  1237                              <1> ;
  1238                              <1> ;  A command key ends the line too, and takes what was typed as its argument:
  1239                              <1> ;
  1240                              <1> ;    ^G        run the program
  1241                              <1> ;    n ^L      list from line n (no number: all of it). Any key holds the
  1242                              <1> ;              list until another key is pressed; Ctrl-C ends it.
  1243                              <1> ;    n ^E      put line n in the input line; Return puts it back, changed
  1244                              <1> ;    name ^R   read the file of that name (no name: the current one: the
  1245                              <1> ;              one from the command line, or the last one typed)
  1246                              <1> ;    name ^W   write the program to that file (no name: the current one)
  1247                              <1> ;    ^N ^N     new: no program (the key twice in a row)
  1248                              <1> ;    ^V        view: the build, both stacks, and the program's size, lines
  1249                              <1> ;              and free memory
  1250                              <1> ;    ^X        leave
  1251                              <1> ;
  1252                              <1> ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
  1253                              <1> ;  a character goes in at the cursor; Backspace and DEL take out the one
  1254                              <1> ;  before it; Esc drops the line (after Esc it waits 5 ms for a '[': Esc [ C
  1255                              <1> ;  and Esc [ D are right and left too). Only CR, LF, BS and printing
  1256                              <1> ;  characters are sent to the terminal.
  1257                              <1> ;
  1258                              <1> ;  Lines are counted, not numbered. A typed line holds 125 characters; the
  1259                              <1> ;  one character after a line number separates it from the text and is not
  1260                              <1> ;  stored. The text is kept as typed, each line ending in CR LF, at PROG. A
  1261                              <1> ;  file is read up to its first ^Z, and a last line with no line end is
  1262                              <1> ;  given one; it is written as it is, with no padding.
  1263                              <1> ;
  1264                              <1> ;  What lasts from one line to the next: the program, the words, the
  1265                              <1> ;  variables and the data stack (TOS is kept pushed while the editor runs).
  1266                              <1> ;  An error or a break clears both stacks. The return stack starts empty for
  1267                              <1> ;  every line.
  1268                              <1> ;
  1269                              <1> ;  Registers in the editor: EBX = the cursor, EDX = the end of the line
  1270                              <1> ;  (pointers into the line buffer); EDI is free (edit resets it).
  1271                              <1> ; =============================================================================
  1272                              <1> %if EDITOR
  1273                              <1> ; ^F, right arrow: one to the right, by printing the character there
  1274 00000678 39D3                <1> right:  cmp     ebx,edx
  1275 0000067A 745F                <1>         je      ed1                     ; at the end
  1276 0000067C 8A03                <1>         mov     al,[ebx]
  1277 0000067E 43                  <1>         inc     ebx
  1278 0000067F EB2E                <1>         jmp     short lf1
  1279                              <1> 
  1280                              <1> ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
  1281                              <1> ; wait about 5 ms for a second key: after a '[' read on to the letter that
  1282                              <1> ; ends the sequence, and act on C (right) and D (left).
  1283 00000681 6A05                <1> esc:    push    5
  1284 00000683 58                  <1>         pop     eax
