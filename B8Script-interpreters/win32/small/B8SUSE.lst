   909                              <1> ; ---- Speed-ups (base builds) ---------------------------------------------
   910                              <1> ; base takes what pays on x86 of the Z80's base: the skip cache and the
   911                              <1> ; faster skip (at skip), '/' by a power of two as shifts (DIVQ), and in the
   912                              <1> ; unchecked build a variable then '@' or '!' in one step (here). The Z80's
   913                              <1> ; '*' in 8 rounds has nothing to do here: x86 has IMUL. Nor has its true
   914                              <1> ; ')': this ')' reads the block start where it is in every build.
   915                              <1> %if SBASEU
   916                              <1> ; a-z, in the unchecked base build: a variable followed by '@' or '!' is
   917                              <1> ; fetched or stored in the same step (x@ is the commonest pair in most
   918                              <1> ; programs). (A checked build checks the stacks between the two, so it keeps
   919                              <1> ; them apart.)
   920                              <1> lower:  lea     edx,[ARENA+LET+eax*2]   ; EDX -> the cell
   921                              <1>         mov     al,[esi]
   922                              <1>         cmp     al,'@'
   923                              <1>         je      .lw1
   924                              <1>         cmp     al,'!'
   925                              <1>         je      .lw2
   926                              <1>         push    ebx                     ; neither: push the cell's address
   927                              <1>         mov     ebx,edx
   928                              <1>         jmp     ebp
   929                              <1> .lw1:   inc     esi                     ; x@: TOS = the cell's value
   930                              <1>         push    ebx
   931                              <1>         mov     bx,[edx]
   932                              <1>         jmp     ebp
   933                              <1> .lw2:   inc     esi                     ; x!: the cell = TOS, and NOS comes up
   934                              <1>         mov     [edx],bx
   935                              <1>         pop     ebx
   936                              <1>         jmp     ebp
   937                              <1> %endif
   938                              <1> 
   939                              <1> ; =============================================================================
   940                              <1> ;  Checked build: the checks and the error report (here, so that the
   941                              <1> ;  handlers' bodies above reach the error entries with short jumps)
   942                              <1> ; =============================================================================
   943                              <1> %if CHECKED
   944                              <1> e_zero: mov     al,'Z'                  ; dividing by zero
   945                              <1>         jmp     error
   946                              <1> e_heap: mov     al,'H'                  ; the heap
   947                              <1>         jmp     error
   948                              <1> 
   949                              <1> ; chkst1, chkst2: stop with O unless the 1 or 2 bytes at TOS are in the
   950                              <1> ; program's space: from the letter page up to the heap limit. Memory above
   951                              <1> ; the heap top but below the limit is the program's own: Tiny BASIC keeps
   952                              <1> ; its lines there.
   953                              <1> chkst2: mov     eax,ebx
   954                              <1>         sub     ax,LET
   955                              <1>         cmp     ax,LIMIT-LET-1
   956                              <1>         jmp     short chs1
   957                              <1> chkst1: mov     eax,ebx
   958                              <1>         sub     ax,LET
   959                              <1>         cmp     ax,LIMIT-LET
   960                              <1> chs1:   jae     e_store
   961                              <1>         ret
   962                              <1> 
   963                              <1> ; chkstk: both stacks are checked once per character, not in every handler.
   964                              <1> ; A character can pop a cell or two too many, or push one too many, before
   965                              <1> ; it is seen here: the data stack has the caller's frame above it and the
   966                              <1> ; thread's stack below, and the return stack has the image's spare space on
   967                              <1> ; both sides.
   968                              <1> chkstk: lea     eax,[esp+4]
   969                              <1>         sub     eax,[V(v_dstop)]        ; minus 4 x the depth
   970                              <1>         jg      e_under
   971                              <1>         cmp     eax,-4*DSMAX
   972                              <1>         jl      e_over
   973                              <1>         cmp     di,RSTOP & 0FFFFh       ; (the return stack is in one 64K: only
   974                              <1>         ja      e_rund                  ;   the low word changes)
   975                              <1>         cmp     di,(RSTOP-4*RSMAX) & 0FFFFh
   976                              <1>         jb      e_rover
   977                              <1>         ret
   978                              <1> e_under:mov     esp,[V(v_dstop)]        ; data stack underflow: it counts as
   979                              <1>         mov     al,'s'                  ;   empty
   980                              <1>         jmp     short error
   981                              <1> e_rund: mov     edi,RSTOP               ; return stack underflow: the same.
   982                              <1>         or      esi,ARENA               ;   (A ']' or ')' may have taken an IP
   983                              <1>         mov     al,'r'                  ;   of 0 from below the stack: keep the
   984                              <1>                                         ;   place readable)
   985                              <1>         jmp     short errp
   986                              <1> e_rover:mov     al,'R'
   987                              <1>         jmp     short errp
   988                              <1> e_over: mov     al,'S'
   989                              <1>         jmp     short errp
   990                              <1> e_break:mov     al,'B'                  ; Ctrl-C (inside pollk or getk)
   991                              <1>         jmp     short errp
   992                              <1> e_store:mov     al,'O'                  ; a store outside the program's space
   993                              <1>         jmp     short errp
   994                              <1> ; e_dollar: '$' ran into a NUL: Q, with the string's address TOS again. But
   995                              <1> ; if its /~ escapes took cells that weren't there, that is s (as the next
   996                              <1> ; character's check would have said).
   997                              <1> e_dollar:pop    edx                     ; prstr's return address
   998                              <1>         cmp     esp,[V(v_dstop)]        ; (ESP = v_dstop: the cell that stands
   999                              <1>         jae     e_under                 ;   for TOS was taken too)
  1000                              <1>         mov     ebx,[V(v_str)]
  1001                              <1>         mov     al,'Q'
  1002                              <1>         jmp     short error
  1003                              <1> ; errp: an error found inside a routine: drop its return address first.
  1004                              <1> errp:   pop     edx
