011A   50                     MOV   D,B   
011B   59                     MOV   E,C   ; the block starts at the IP
011C   C3 AA 00               JMP   rpushd   
011F                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
011F                             ; drops it and carries on.
011F   7C           H_CLOSE:   MOV   A,H   
