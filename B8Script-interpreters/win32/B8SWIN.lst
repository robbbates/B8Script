  1924                              <1>         IMP     WaitForMultipleObjects
  1925                              <1>         IMP     CreateWaitableTimerExW
  1926                              <1>         IMP     SetWaitableTimer
  1927                              <1>         IMP     ReadConsoleInputA
  1928                              <1>         IMP     GetTickCount
  1929                              <1>         IMP     ExitProcess
  1930                              <1> %endmacro
