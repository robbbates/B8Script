  2368 00001994 [BA1AC0FF]          <1>         dd      dllname-IB              ; Name
  2369 00001998 [C81AC0FF]          <1>         dd      iat-IB                  ; FirstThunk: the IAT
  2370 0000199C 00<rep 14h>         <1>         times   20 db 0                 ; the null entry that ends the list
  2371                              <1> idesc_end:
  2372                              <1> %macro  IMP 1
  2373                              <1>         dd      hn_%1-IB
  2374                              <1> %endmacro
