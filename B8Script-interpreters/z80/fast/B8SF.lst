0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as line
0000                             ;                 and column, and both stacks. See `error`.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   2   ; 0 = small, 1 = base, 2 = fast (not with EDITOR) (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
0000                EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC and
                                 ; IY, and all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
                                 ;   at the heap limit, which the heap never reaches
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
                    PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
0000                ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
                    ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
0000                DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
                    DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (fast build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (fast build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 16               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM*(1-EDITOR)   
0103   C3 FE 07               JP   start   ; 03
0106                          ENDIF      
0106                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0106                          ENDIF      
0106                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0106                          ENDIF      
0106                          IF   1-CPM   
                                 ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
                    RPOP:     LD   E,(IY+0)   ; 08
                              LD   D,(IY+1)   
                              JR   rp2   ; (the rest is at 2Bh)
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
                              JR   NZ,next0   ;     the rest are ignored
                    ENDPROG:   JP   EXIT   ;     the program has ended
                              NOP      ; 17  spare
                                 ; ---- RST 18h: drop TOS, then next ------------------------------------------
                    RST18:    POP   DE   ; 18  discard the RST's return address
                    DRP:      POP   HL   ;     new TOS = NOS
                              JR   next0   
0106                          ENDIF      
0106   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
0107                          ;*Macro unroll:  POPR
0107                          DS   1-CPM,0CFh   
0107   CD                     DS   CPM,0CDh   
0108   94                     DS   CPM,AROP&0FFh   
0109   06                     DS   CPM,AROP/256   
010A   EB                     EX   DE,HL   
010B                          ;*Macro unroll:  NEXTZ
010B                          DS   1-CPM,0F7h   
010B   DD                     DS   CPM,0DDh   
010C   E9                     DS   CPM,0E9h   
010D                          IF   1-CPM   
                                 ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
                    NEG16:    XOR   A   ; 20
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
                              NOP      ; 27  spare
                                 ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
                    RST28:       
                    PUTC:     JP   CONOUT   ; 28
                    RP2:      INC   IY   ; 2B  the rest of rpop
                              INC   IY   
                              RET      
                                 ; ---- RST 30h: next character -----------------------------------------------
                    RST30:    POP   DE   ; 30  discard the RST's return address
010D                          ENDIF      
010D                          IF   CPM   
010D                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
010D   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
010F   20 03                  JR   NZ,next0   ; the rest are ignored
0111   C3 00 00     ENDPROG:   JP   EXIT   ; the program has ended
0114                          ENDIF      
0114                             ; =============================================================================
0114                             ;  The inner loop: read one character and sort it by range.
0114                             ; 
0114                             ;    00h          end of program
0114                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0114                             ;    30h-39h      digit: read a whole number
0114                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0114                             ;    61h-7Ah      a-z: push the address of that letter's cell
0114                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0114                             ; =============================================================================
0114                          IF   FAST   
0114                          ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
0114   CD           NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
0115   D6                     DS   FAST*CHECKED,ACHK&0FFh   
0116   06                     DS   FAST*CHECKED,ACHK/256   
0117   0A                     DS   FAST,0Ah   
0118   03                     DS   FAST,03h   
0119   EB                     DS   FAST,0EBh   
011A   6F                     DS   FAST,6Fh   
011B   26                     DS   FAST,26h   
011C   12                     DS   FAST,DTPG   
011D   7E                     DS   FAST,7Eh   
011E   24                     DS   FAST,24h   
011F   66                     DS   FAST,66h   
0120   6F                     DS   FAST,6Fh   
0121   E9                     DS   FAST,0E9h   
0122                          ENDIF      
0122                          IF   1-FAST   
                    NEXT0:       
0122                          ENDIF      
0122                          IF   CHECKED*(1-FAST)   
                              CALL   chkstk   ; both stacks are checked once per character
0122                          ENDIF      
0122                          IF   1-FAST   
                              LD   A,(BC)   
                              INC   BC   
                              SUB   21h   ; A = c - 21h
                              JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
                              CP   0Fh   
                              JR   C,punct   ; 21h-2Fh: PTAB index 0-14
                              SUB   0Fh   ; A = c - 30h
                              CP   0Ah   
                              JR   C,digit   ; 30h-39h
                              CP   11h   
                              JR   C,p3a   ; 3Ah-40h
                              SUB   11h   ; A = c - 41h
                              CP   1Ah   
                              JR   C,upper   ; 41h-5Ah: A = letter index 0-25
                              CP   20h   
                              JR   C,p5b   ; 5Bh-60h
                              CP   3Ah   
                              JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
                              CP   3Eh   
0122                          ENDIF      
0122                          IF   (1-CHECKED)*(1-FAST)   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0122                          ENDIF      
0122                          IF   CHECKED*(1-FAST)   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0122                          ENDIF      
0122                          IF   1-FAST   
                              SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
                    P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
                    P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0122                          ENDIF      
0122                .macro PTABLE,
0122                             ; 
0122                 DB      h_store & 0FFh  ; !
0122                 DB      h_str & 0FFh    ; "
0122                 DB      h_num & 0FFh    ; #
0122                 DB      h_print & 0FFh  ; $
0122                 DB      h_swap & 0FFh   ; %
0122                 DB      h_and & 0FFh    ; &
0122                 DB      h_emit & 0FFh   ; '
0122                 DB      h_open & 0FFh   ; (
0122                 DB      h_close & 0FFh  ; )
0122                 DB      h_mul & 0FFh    ; *
0122                 DB      h_add & 0FFh    ; +
0122                 DB      h_cfetch & 0FFh ; ,
0122                 DB      h_sub & 0FFh    ; -
0122                 DB      h_cstore & 0FFh ; .
0122                 DB      h_div & 0FFh    ; /
0122                 DB      h_dup & 0FFh    ; :
0122                 DB      h_drop & 0FFh   ; ;
0122                 DB      h_lt & 0FFh     ; <
0122                 DB      h_eq & 0FFh     ; =
0122                 DB      h_gt & 0FFh     ; >
0122                 DB      h_key & 0FFh    ; ?
0122                 DB      h_fetch & 0FFh  ; @
0122                 DB      h_def & 0FFh    ; [
0122                 DB      h_break & 0FFh  ; \
0122                 DB      h_ret & 0FFh    ; ]
0122                 DB      h_xor & 0FFh    ; ^
0122                 DB      h_alloc & 0FFh  ; _
0122                 DB      h_grave & 0FFh  ; `
0122                 DB      h_tor & 0FFh    ; {
0122                 DB      h_or & 0FFh     ; |
0122                 DB      h_fromr & 0FFh  ; }
0122                 DB      h_not & 0FFh    ; ~
0122                .endm
0122                 
0122                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0122                             ; untouched, and A, DE free.
0122                          IF   1-FAST   
                    PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
                              LD   E,A   
                              LD   D,PTAB / 256   ; (0 if the table is in page zero)
                              CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
                              LD   A,(DE)   
                              LD   E,A   ; the handler's low byte
0122                          ENDIF      
0122                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
                              LD   D,0   
0122                          ENDIF      
0122                          IF   (1-CPM)*(1-FAST)   
                              RL   D   ; its page: 0 + carry
0122                          ENDIF      
0122                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0122                          ENDIF      
0122                          IF   1-FAST   
                              PUSH   DE   ; jump to it; the stack is balanced again
                              RET      ;   when the handler starts
0122                          ENDIF      
0122                             ; The rest of the startup: here so that the generic reset code can reach it
0122                             ; with JR. st0: find the program's NUL; the heap starts after it.
0122                             ; (The editor build has its own copy of this, next to the editor.)
0122                             ; A checked build first clears the lower half of the letter page (A = 0):
0122                             ; every variable starts at 0, every word cell holds 0000h, the address an
0122                             ; undefined word is caught at (see e_hi), and no key is held back.
0122                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0122                          ENDIF      
0122                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0122                          ENDIF      
0122                          IF   1-EDITOR   
0122   22 7C 17     ST2:      LD   (HEAP),HL   
0125                          ENDIF      
0125                          IF   CHECKED*(1-EDITOR)   
0125                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
0125                          DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
0125   CD                     DS   CPM,0CDh   
0126   9F                     DS   CPM,ANEG&0FFh   
0127   06                     DS   CPM,ANEG/256   
0128   22 38 17               LD   (NPEND),HL   ;   release below it
012B                          ENDIF      
012B                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
012B                          ENDIF      ;   these)
012B                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
012B                          ENDIF      
012B                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
012B                          ENDIF      
012B                          IF   1-EDITOR   
012B                          ;*Macro unroll:  SETIX
012B   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
012C   21                     DS   CPM+FAST-CPM*FAST,21h   
012D   14                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
012E   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
012F   FD 21 E0 15            LD   IY,RSTOP   ; the return stack is empty
0133                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0133                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0133   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0134   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0135                          ENDIF      
0135                             ; In the unchecked generic editor build the table is here, in the first
0135                             ; page, which saves loading D twice. (The other builds have no room for it
0135                             ; here: theirs is further down.)
0135                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0135                          ENDIF      
0135                             ; =============================================================================
0135                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0135                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0135                             ;  is here too: it belongs to "`" and makes the page come out right.
0135                             ; =============================================================================
0135   D1           H_XOR:    POP   DE   
0136   7C                     LD   A,H   
0137   AA                     XOR   D   
0138   67                     LD   H,A   
0139   7D                     LD   A,L   
013A   AB                     XOR   E   
013B   6F                     LD   L,A   
013C                          ;*Macro unroll:  NEXT
013C                          DS   (1-CPM)*(1-FAST),0F7h   
013C   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
013D   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
013E   D1           H_OR:     POP   DE   
013F   7C                     LD   A,H   
0140   B2                     OR   D   
0141   67                     LD   H,A   
0142   7D                     LD   A,L   
0143   B3                     OR   E   
0144   6F                     LD   L,A   
0145                          ;*Macro unroll:  NEXT
0145                          DS   (1-CPM)*(1-FAST),0F7h   
0145   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0146   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0147                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0147                H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0147   CD                     DS   CPM,0CDh   
0148   9F                     DS   CPM,ANEG&0FFh   
0149   06                     DS   CPM,ANEG/256   
014A   2B                     DEC   HL   
014B                          ;*Macro unroll:  NEXT
014B                          DS   (1-CPM)*(1-FAST),0F7h   
014B   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
014C   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
014D                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
014D                             ; the same either way); TOS is the old pointer.
014D   ED 5B 7C 17  H_ALLOC:   LD   DE,(HEAP)   
0151                          IF   CHECKED*CPM   
0151   7C                     LD   A,H   ; the count's sign, for chkhp
0152                          ENDIF      
0152   19                     ADD   HL,DE   ; the new top
0153                          IF   CHECKED   
0153   CD 0F 07               CALL   chkhp   
0156                          ENDIF      
0156   22 7C 17               LD   (HEAP),HL   
0159   EB                     EX   DE,HL   
015A                          ;*Macro unroll:  NEXT
015A                          DS   (1-CPM)*(1-FAST),0F7h   
015A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
015B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
015C                          IF   1-CPM*CHECKED   
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
015C                          ENDIF      
015C                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
015C                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
015C                             ; Digits: step back onto the first digit and read the whole number.
015C   E5           DIGIT:    PUSH   HL   
015D   0B                     DEC   BC   
015E   CD 84 04               CALL   rdnum   
0161                          ;*Macro unroll:  NEXT
0161                          DS   (1-CPM)*(1-FAST),0F7h   
0161   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0162   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0163                             ; a-z: push the cell's address (the cell is the variable)
0163                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
0163                          IF   1-SBASEU   
0163   E5           LOWER:    PUSH   HL   
0164   87                     ADD   A,A   
0165   6F                     LD   L,A   
0166   26 17                  LD   H,LETPAGE   
0168                          ;*Macro unroll:  NEXT
0168                          DS   (1-CPM)*(1-FAST),0F7h   
0168   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0169   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
016A                          ENDIF      
016A                          IF   SBASEU   
                    LOWER:    JP   lowq   
016A                          ENDIF      
016A                             ; A-Z: call the word. The return address (the IP after the letter) goes on
016A                             ; the return stack, and the IP becomes the address in the letter's cell.
016A   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
016B   EB                     EX   DE,HL   ; park TOS
016C   87                     ADD   A,A   
016D   6F                     LD   L,A   
016E   26 17                  LD   H,LETPAGE   ; HL -> cell
0170   4E                     LD   C,(HL)   
0171   2C                     INC   L   
0172   46                     LD   B,(HL)   ; IP = the word's body
0173   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
0174                             ; rpushn: move the top cell of the data stack (in memory) to the return
0174                             ; stack, then next. Everything that pushes the return stack ends here.
0174                             ; 
0174                             ; The break key is looked at here, so at every word call and loop-back (and
0174                             ; block entry and "{"), but only one time in 256: PCNT counts them.
0174                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
0174   D1           RPUSHN:   POP   DE   
0175   FD 72 FF               LD   (IY-1),D   
0178   FD 73 FE               LD   (IY-2),E   
017B   FD 2B                  DEC   IY   
017D   FD 2B                  DEC   IY   
017F   E5                     PUSH   HL   
0180   21 36 17               LD   HL,PCNT   
0183   35                     DEC   (HL)   
0184   E1                     POP   HL   ; (the zero flag lasts)
0185   CC 56 06               CALL   Z,pollk   
0188                          ;*Macro unroll:  NEXT
0188                          DS   (1-CPM)*(1-FAST),0F7h   
0188   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0189   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
018A                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
018A   E3           H_TOR:    EX   (SP),HL   
018B   18 E7                  JR   rpushn   
018D   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
018E                             ; ---- machine code: the grave -----------------------------------------------
018E                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
018E                             ; are stored from addr until a non-hex character; then a RET (C9h) is
018E                             ; written and its address is left. An odd last digit is consumed and dropped.
018E                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
018E                             ; code is entered by CALL with the data stack above the return address; it
018E                             ; must keep BC, and on return the top cell becomes the new TOS.
018E   CD 06 06     H_GRAVE:   CALL   hexc   
0191                          IF   1-CPM*CHECKED   
                              JR   NC,exec   
0191                          ENDIF      
0191                          IF   CPM*CHECKED   
0191   D2 A6 06               JP   NC,exec   ; (out of the way: see rpop)
0194                          ENDIF      
0194   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
0195   CD 06 06               CALL   hexc   
0198   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
019A   ED 6F                  RLD      ;   overwrites it
019C   23                     INC   HL   ; ... and RLD shifts it up under the low one
019D   CD 06 06               CALL   hexc   
01A0   38 F2                  JR   C,hx1   
01A2   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01A4                          ;*Macro unroll:  NEXT
01A4                          DS   (1-CPM)*(1-FAST),0F7h   
01A4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01A5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01A6                             ; ---- where the two pages meet ----------------------------------------------
01A6                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01A6                             ; are in falling code order for this), and where exactly differs between the
01A6                             ; builds: NPG1 follows. Every handler below these four must start in the
01A6                             ; second page, and every one above in the first; chktab.py checks both.
01A6                             ; "]" returns: pop an address and jump to it.
01A6                          ;*Macro unroll: h_ret:  POPR
01A6                H_RET:    DS   1-CPM,0CFh   
01A6   CD                     DS   CPM,0CDh   
01A7   94                     DS   CPM,AROP&0FFh   
01A8   06                     DS   CPM,AROP/256   
01A9   42                     LD   B,D   
01AA   4B                     LD   C,E   
01AB                          ;*Macro unroll: brk1:   NEXT
01AB                BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
01AB   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01AC   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01AD                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01AD                             ; drops the block start, "]" returns. No closer at all ends the program.
01AD   7C           H_BREAK:   LD   A,H   
01AE   B5                     OR   L   
01AF   E1                     POP   HL   
01B0   28 F9                  JR   Z,brk1   
01B2   CD AB 04               CALL   skip   
01B5   B7                     OR   A   ; skip returns 0 for ")"
01B6   20 EE                  JR   NZ,h_ret   
01B8                          ;*Macro unroll: rdrop:  POPR
01B8                RDROP:    DS   1-CPM,0CFh   
01B8   CD                     DS   CPM,0CDh   
01B9   94                     DS   CPM,AROP&0FFh   
01BA   06                     DS   CPM,AROP/256   
01BB                          ;*Macro unroll:  NEXT
01BB                          DS   (1-CPM)*(1-FAST),0F7h   
01BB   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01BC   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01BD                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01BD                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01BD                             ; the body"s address instead. Either way it then skips to the matching "]'.
01BD                             ; (The unchecked build takes anything that is not a letter as the space; the
01BD                             ; checked build stops on it.)
01BD   0A           H_DEF:    LD   A,(BC)   
01BE   03                     INC   BC   
01BF   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01C1   5F                     LD   E,A   ;   lands 64 bytes up
01C2   E6 DF                  AND   0DFh   ; fold case
01C4   FE 1A                  CP   26   
01C6   30 0B                  JR   NC,def2   ; not a letter
01C8   CB 23                  SLA   E   
01CA   16 17                  LD   D,LETPAGE   ; DE -> cell
01CC   79                     LD   A,C   
01CD   12                     LD   (DE),A   
01CE   1C                     INC   E   
01CF   78                     LD   A,B   
01D0   12                     LD   (DE),A   
01D1   18 09                  JR   skipnx   
01D3                DEF2:        
01D3                          IF   CHECKED   
01D3   7B                     LD   A,E   
01D4   FE DF                  CP   " "-"A"+256   
01D6   C2 57 07               JP   NZ,e_brack   ; anything but a letter or a space
01D9                          ENDIF      
01D9   E5                     PUSH   HL   ; an anonymous block: push its address
01DA   60                     LD   H,B   
01DB   69                     LD   L,C   
01DC                SKIPNX:      
01DC                          IF   CHECKED   
01DC   0B                     DEC   BC   ; back onto the letter, so that skip finds its
01DD                          ENDIF      ;   opener, the "[", just before where it starts
01DD   CD AB 04     SKIPO:    CALL   skip   
01E0                          ;*Macro unroll:  NEXT
01E0                          DS   (1-CPM)*(1-FAST),0F7h   
01E0   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01E1   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01E2   5E           H_FETCH:   LD   E,(HL)   ; "@"
01E3   23                     INC   HL   
01E4   56                     LD   D,(HL)   
01E5   EB                     EX   DE,HL   
01E6                          ;*Macro unroll:  NEXT
01E6                          DS   (1-CPM)*(1-FAST),0F7h   
01E6   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01E7   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01E8                             ; =============================================================================
01E8                             ;  Handlers that must start in the image's second page.
01E8                             ;  "?" is the last (with "," inside it), so its long tail may run past that
01E8                             ;  page.
01E8                             ; =============================================================================
01E8                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
01E8                             ; the matching ")".
01E8   7C           H_OPEN:   LD   A,H   
01E9   B5                     OR   L   
01EA   E1                     POP   HL   
01EB   28 F0                  JR   Z,skipo   
01ED   C5                     PUSH   BC   ; the block starts at the IP
01EE   18 84                  JR   rpushn   
01F0                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
01F0                             ; drops it and carries on.
01F0   7C           H_CLOSE:   LD   A,H   
01F1   B5                     OR   L   
01F2   E1                     POP   HL   
01F3   28 C3                  JR   Z,rdrop   
01F5                          IF   QK   
01F5   C3 F5 05               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
01F8                          ENDIF      
01F8                          IF   1-QK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
01F8                          ENDIF      
01F8                          IF   (1-QK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
01F8                          ENDIF      
01F8                          IF   (1-QK)*CPM   
                              JP   rpushn   
01F8                          ENDIF      
01F8                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
01F8                             ; "-" has two jobs: directly before a digit it starts a negative number.
01F8   0A           H_SUB:    LD   A,(BC)   
01F9   D6 30                  SUB   "0"   
01FB   FE 0A                  CP   10   
01FD   38 07                  JR   C,negnum   
01FF                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
01FF                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
01FF   CD                     DS   CPM,0CDh   
0200   9F                     DS   CPM,ANEG&0FFh   
0201   06                     DS   CPM,ANEG/256   
0202   D1           H_ADD:    POP   DE   
0203   19                     ADD   HL,DE   
0204                          ;*Macro unroll:  NEXT
0204                          DS   (1-CPM)*(1-FAST),0F7h   
0204   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0205   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0206   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0207   CD 84 04               CALL   rdnum   
020A                          ;*Macro unroll:  NEGH
020A                          DS   1-CPM,0E7h   
020A   CD                     DS   CPM,0CDh   
020B   9F                     DS   CPM,ANEG&0FFh   
020C   06                     DS   CPM,ANEG/256   
020D                          ;*Macro unroll:  NEXT
020D                          DS   (1-CPM)*(1-FAST),0F7h   
020D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
020E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
020F   D1           H_AND:    POP   DE   
0210   7C                     LD   A,H   
0211   A2                     AND   D   
0212   67                     LD   H,A   
0213   7D                     LD   A,L   
0214   A3                     AND   E   
0215   6F                     LD   L,A   
0216                          ;*Macro unroll:  NEXT
0216                          DS   (1-CPM)*(1-FAST),0F7h   
0216   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0217   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0218                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0218                             ; cells first. Flipping both sign bits turns a signed compare into an
0218                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0218                             ; carry into -1 or 0 with no branch.
0218   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0219   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
021A   7C                     LD   A,H   
021B   EE 80                  XOR   80h   
021D   67                     LD   H,A   
021E   7A                     LD   A,D   
021F   EE 80                  XOR   80h   
0221   57                     LD   D,A   
0222   ED 52                  SBC   HL,DE   ; carry if HL < DE
0224   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0226                          ;*Macro unroll:  NEXT
0226                          DS   (1-CPM)*(1-FAST),0F7h   
0226   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0227   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0228   D1           H_EQ:     POP   DE   
0229   B7                     OR   A   
022A   ED 52                  SBC   HL,DE   
022C   7C                     LD   A,H   
022D   B5                     OR   L   
022E   FE 01                  CP   1   ; carry only if a - b = 0
0230   18 F2                  JR   tf   
0232                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0232                             ; multiplier shifts up through A:C.
0232                          IF   1-QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0232                          ENDIF      
0232                          IF   QK   
0232   D1           H_MUL:    POP   DE   ; DE = multiplicand
0233   C3 45 05               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0236                          ENDIF      
0236                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0236                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0236                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0236                             ; stops on it.
0236                H_DIV:       
0236                          IF   CHECKED   
0236   7C                     LD   A,H   
0237   B5                     OR   L   
0238   CA 54 07               JP   Z,e_zero   
023B                          ENDIF      
023B   D1                     POP   DE   ; DE = a, HL = b
023C   D5                     PUSH   DE   ; a, for r's sign
023D   7A                     LD   A,D   
023E   AC                     XOR   H   
023F   F5                     PUSH   AF   ; S flag = sign of q
0240   CB 7C                  BIT   7,H   
0242   C4 9F 06               CALL   NZ,neg16   ; HL = |b|
0245   EB                     EX   DE,HL   
0246   CB 7C                  BIT   7,H   
0248   C4 9F 06               CALL   NZ,neg16   ; HL = |a|, DE = |b|
024B   CD 7F 03               CALL   udiv   ; HL = q, DE = r
024E   F1                     POP   AF   
024F   FC 9F 06               CALL   M,neg16   ; q's sign
0252   EB                     EX   DE,HL   ; HL = r, DE = q
0253   F1                     POP   AF   ; A = a's high byte
0254   B7                     OR   A   
0255   FC 9F 06               CALL   M,neg16   ; r's sign
0258   D5                     PUSH   DE   ; q under r
0259                          ;*Macro unroll:  NEXT
0259                          DS   (1-CPM)*(1-FAST),0F7h   
0259   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
025A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
025B                             ; ---- stack and storage -----------------------------------------------------
025B   E5           H_DUP:    PUSH   HL   ; ":"
025C                          ;*Macro unroll:  NEXT
025C                          DS   (1-CPM)*(1-FAST),0F7h   
025C   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
025D   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
025E   E3           H_SWAP:   EX   (SP),HL   ; "%"
025F                          ;*Macro unroll:  NEXT
025F                          DS   (1-CPM)*(1-FAST),0F7h   
025F   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0260   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0261                             ; (The checked build tests the address before it takes the value off the
0261                             ; stack, so that an error report shows both.)
0261                H_CSTORE:      ; "." ( c addr -- )
0261                          IF   CHECKED   
0261   CD 2C 07               CALL   chkst   
0264                          ENDIF      
0264   D1                     POP   DE   
0265   73                     LD   (HL),E   
0266                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
0266                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
0266   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0267   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0268   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0269                H_STORE:      ; "!" ( n addr -- )
0269                          IF   CHECKED   
0269   CD 2C 07               CALL   chkst   
026C                          ENDIF      
026C   D1                     POP   DE   
026D   73                     LD   (HL),E   
026E   23                     INC   HL   
026F   72                     LD   (HL),D   
0270                          ;*Macro unroll:  DROP
0270                          DS   (1-CPM)*(1-FAST),0DFh   
0270   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0271   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0272   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0273                             ; ---- console ---------------------------------------------------------------
0273                             ; 22h pushes the address of the text after it and skips the string.
0273   E5           H_STR:    PUSH   HL   
0274   60                     LD   H,B   
0275   69                     LD   L,C   
0276   CD 9A 04               CALL   skipstr   
0279                          IF   CHECKED   
0279   B7                     OR   A   ; 0: the text ran out before the closing quote
027A   CA 4C 07               JP   Z,e_quote   
027D                          ENDIF      
027D                          ;*Macro unroll:  NEXT
027D                          DS   (1-CPM)*(1-FAST),0F7h   
027D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
027E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
027F                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
027F                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
027F                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
027F                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
027F                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
027F                          ENDIF      
027F                          IF   CHECKED   
027F                             ; (The checked build has the loop as a routine, prstr, which the error
027F                             ; report uses too. The address is kept meanwhile, for a report: it shows
027F                             ; the stack as it was before the "$". /~ comes back to hp1.)
027F   22 34 17     H_PRINT:   LD   (RSAVE),HL   
0282   CD E4 02     HP1:      CALL   prstr   
0285                          ;*Macro unroll:  DROP
0285                          DS   (1-CPM)*(1-FAST),0DFh   
0285   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0286   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0287   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0288                          ENDIF      
0288   7D           H_EMIT:   LD   A,L   ; "'"
0289                          ;*Macro unroll:  PUTA
0289                          DS   1-CPM,0EFh   
0289   CD                     DS   CPM,0CDh   
028A   C0                     DS   CPM,APUT&0FFh   
028B   06                     DS   CPM,APUT/256   
028C                          ;*Macro unroll: pr9:    DROP
028C                PR9:      DS   (1-CPM)*(1-FAST),0DFh   
028C   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
028D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
028E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
028F                             ; "#" prints TOS as a signed decimal number, with no space after it.
028F   CD 18 06     H_NUM:    CALL   psgn   
0292                          ;*Macro unroll:  DROP
0292                          DS   (1-CPM)*(1-FAST),0DFh   
0292   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0293   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0294   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0295                             ; "?" ( n -- c ) or ( -n -- addr )
0295                             ;   n > 0: wait about n ms for a key; 0 if none came
0295                             ;   n = 0: wait for a key
0295                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
0295                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
0295   CB 7C        H_KEY:    BIT   7,H   
0297   20 1A                  JR   NZ,line   
0299   1E 04        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
029B   CD 84 06     KT2:      CALL   getk   
029E   20 0E                  JR   NZ,kt3   
02A0   1D                     DEC   E   
02A1   20 F8                  JR   NZ,kt2   
02A3   7C                     LD   A,H   ; 0? never counts down: it waits
02A4   B5                     OR   L   
02A5   28 F2                  JR   Z,kt1   
02A7   2B                     DEC   HL   
02A8   7C                     LD   A,H   
02A9   B5                     OR   L   
02AA   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02AC   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02AD   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02AE   6F           KT3:      LD   L,A   
02AF   26 00                  LD   H,0   
02B1                          ;*Macro unroll:  NEXT
02B1                          DS   (1-CPM)*(1-FAST),0F7h   
02B1   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02B2   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02B3                             ; Backspace takes the last character back (and is echoed as it
02B3                             ; is), CR ends (stored, not echoed), every other key is stored and
02B3                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02B3                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02B3                             ; is the place in the line: D holds the L of a full line.
02B3   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02B6   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02B7   9F                     SBC   A,A   
02B8   A5                     AND   L   ; (0 for a count that is too big)
02B9   2F                     CPL      
02BA   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
02BB                             ;   at most
02BB   21 80 17               LD   HL,LINEBUF   
02BE   CD 84 06     LN2:      CALL   getk   
02C1   28 FB                  JR   Z,ln2   
02C3   FE 0D                  CP   13   
02C5   28 18                  JR   Z,ln5   
02C7   FE 08                  CP   8   
02C9   28 0D                  JR   Z,ln4   
02CB   5F                     LD   E,A   
02CC   7D                     LD   A,L   
02CD   BA                     CP   D   
02CE   28 EE                  JR   Z,ln2   ; full
02D0   73                     LD   (HL),E   
02D1   2C                     INC   L   
02D2   7B                     LD   A,E   
02D3                          ;*Macro unroll: ln3:    PUTA
02D3                LN3:      DS   1-CPM,0EFh   
02D3   CD                     DS   CPM,0CDh   
02D4   C0                     DS   CPM,APUT&0FFh   
02D5   06                     DS   CPM,APUT/256   
02D6   18 E6                  JR   ln2   
02D8   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
02D9   FA D3 02               JP   M,ln3   ;   unless the line was empty (L left the
02DC   2C                     INC   L   ;   upper half of the page)
02DD   18 DF                  JR   ln2   
02DF   77           LN5:      LD   (HL),A   ; the CR
02E0   2E 80                  LD   L,LINEBUF & 0FFh   
02E2                          ;*Macro unroll:  NEXT
02E2                          DS   (1-CPM)*(1-FAST),0F7h   
02E2   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02E3   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02E4                             ; =============================================================================
02E4                             ;  More routines (no handler starts past this point)
02E4                             ; =============================================================================
02E4                          IF   CHECKED   
02E4                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
02E4                             ; "$", and the texts of the report). A NUL first is an error: Q.
02E4   7E           PRSTR:    LD   A,(HL)   
02E5   23                     INC   HL   
02E6   FE 22                  CP   22h   
02E8   C8                     RET   Z   
02E9   B7                     OR   A   
02EA   CA 42 07               JP   Z,e_dollar   
02ED   FE 2F                  CP   "/"   
02EF   20 0C                  JR   NZ,prs1   
02F1   7E                     LD   A,(HL)   
02F2   23                     INC   HL   
02F3   FE 60                  CP   60h   
02F5   38 04                  JR   C,prs0   
02F7   FE 7F                  CP   7Fh   
02F9   38 13                  JR   C,pesc   
02FB   E6 BF        PRS0:     AND   0BFh   
02FD                          ;*Macro unroll: prs1:   PUTA
02FD                PRS1:     DS   1-CPM,0EFh   
02FD   CD                     DS   CPM,0CDh   
02FE   C0                     DS   CPM,APUT&0FFh   
02FF   06                     DS   CPM,APUT/256   
0300   18 E2                  JR   prstr   
0302                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0302                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0302                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0302                             ; pnl: the same, on a new line.
0302   CD 08 03     PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
0305   0D 0A 22               DB   13,10,22h   ;   the caller's text)
0308   E3           PMSG:     EX   (SP),HL   
0309   CD E4 02               CALL   prstr   
030C   E3                     EX   (SP),HL   
030D   C9                     RET      
030E                          ENDIF      
030E                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
030E                             ; HL points past it. Each goes back into the loop that prints the string
030E                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
030E                             ;    /a-/z   print the variable, as "#" does
030E                             ;    /{      clear the screen, the cursor to the top left
030E                             ;    /}      clear from the cursor to the end of the line
030E                             ;    /|  /`  show the cursor, hide it
030E                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
030E   FE 7E        PESC:     CP   7Eh   
0310   28 1C                  JR   Z,pat   
0312   11 E4 02               LD   DE,PRLOOP   ; the others return into the loop
0315   D5                     PUSH   DE   
0316   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0318   30 4A                  JR   NC,pcon   
031A   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
031C   30 37                  JR   NC,phide   
031E   87                     ADD   A,A   ; the variable's cell
031F   C6 40                  ADD   A,40h   
0321   E5                     PUSH   HL   
0322   6F                     LD   L,A   
0323   26 17                  LD   H,LETPAGE   
0325   7E                     LD   A,(HL)   
0326   2C                     INC   L   
0327   66                     LD   H,(HL)   
0328   6F                     LD   L,A   
0329   CD 18 06               CALL   psgn   
032C   E1                     POP   HL   
032D   C9                     RET      
032E                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
032E                             ; the checked build "$" is the routine prstr: its own return address goes
032E                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
032E                             ; its two cells are there, and is s if not, before it prints anything.
032E                PAT:         
032E                          IF   CHECKED   
032E   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
032F   21 0A E9               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
0332   39                     ADD   HL,SP   
0333   DA FC 06               JP   C,e_under   
0336   E1                     POP   HL   
0337                          ENDIF      
0337   D1                     POP   DE   ; DE = the column
0338   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0339                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
0339                          ENDIF      
0339                          IF   ANS   
0339   D5                     PUSH   DE   
033A   CD 78 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
033D   23                     INC   HL   
033E   CD 23 06               CALL   pdec   
0341                          ;*Macro unroll:  PUTK    3Bh             ; ';'
0341                          DS   1-CPM,3Eh   ; ";"
0341                          DS   1-CPM,3Bh   
0341                          DS   1-CPM,0EFh   
0341   CD                     DS   CPM,0CDh   
0342   BC                     DS   CPM,APTK&0FFh   
0343   06                     DS   CPM,APTK/256   
0344   3B                     DS   CPM,3Bh   
0345   E1                     POP   HL   
0346   23                     INC   HL   
0347   CD 23 06               CALL   pdec   
034A                          ;*Macro unroll:  PUTK    48h             ; 'H'
034A                          DS   1-CPM,3Eh   ; "H"
034A                          DS   1-CPM,48h   
034A                          DS   1-CPM,0EFh   
034A   CD                     DS   CPM,0CDh   
034B   BC                     DS   CPM,APTK&0FFh   
034C   06                     DS   CPM,APTK/256   
034D   48                     DS   CPM,48h   
034E   E1                     POP   HL   
034F   C3 82 02               JP   PRAGAIN   
0352                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0352   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0354   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0355   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0357                          ENDIF      
0357                          IF   ANS*CHECKED   
0357                             ; (The checked build prints the fixed parts with pmsg, which it has for the
0357                             ; report: shorter than a character at a time.)
0357   CD 08 03               CALL   pmsg   
035A   1B 5B 3F 32 35 22      DB   27,"[?25",22h   
0360   7B           PSE:      LD   A,E   ; then E
0361                          ;*Macro unroll:  PUTAR
0361                          DS   1-CPM,0EFh   
0361                          DS   1-CPM,0C9h   
0361   C3                     DS   CPM,0C3h   
0362   C0                     DS   CPM,APUT&0FFh   
0363   06                     DS   CPM,APUT/256   
0364                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
0364   3D           PCON:     DEC   A   
0365   28 EB                  JR   Z,pshow   ; /|
0367   1E 4B                  LD   E,"K"   
0369   F2 73 03               JP   P,cse   ; /}  ESC [ K
036C   1E 48                  LD   E,"H"   ; /{  ESC [ H ESC [ J
036E   CD 73 03               CALL   cse   
0371   1E 4A                  LD   E,"J"   ; (on into cse)
0373                             ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
0373   CD 78 03     CSE:      CALL   csi   
0376   18 E8                  JR   pse   
0378   CD 08 03     CSI:      CALL   pmsg   
037B   1B 5B 22               DB   27,"[",22h   
037E   C9                     RET      
037F                          ENDIF      
037F                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
037F                          ENDIF      
037F                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
037F                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
037F                             ; the quotient bits arrive at the bottom of C.
037F                             ; Dividing by 2 is one shift (the spec wants that fast).
037F                          IF   1-QK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
037F                          ENDIF      
037F                          IF   QK   
037F                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
037F                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
037F   7A           UDIV:     LD   A,D   
0380   B7                     OR   A   
0381   20 1A                  JR   NZ,uq1   ; 256 and up
0383   B3                     OR   E   
0384   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
0386   3D                     DEC   A   
0387   A3                     AND   E   
0388   20 2F                  JR   NZ,udv0   ; not a power of two
038A   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
038B   3D                     DEC   A   ;   r = L & (2^k - 1)
038C   A5                     AND   L   
038D   F5                     PUSH   AF   
038E   CB 3B        UQ2:      SRL   E   
0390   38 06                  JR   C,uq3   
0392   CB 3C                  SRL   H   
0394   CB 1D                  RR   L   
0396   18 F6                  JR   uq2   
0398   F1           UQ3:      POP   AF   
0399   5F                     LD   E,A   
039A   16 00                  LD   D,0   
039C   C9                     RET      
039D   7B           UQ1:      LD   A,E   
039E   B7                     OR   A   
039F   20 18                  JR   NZ,udv0   
03A1   7A                     LD   A,D   
03A2   3D                     DEC   A   
03A3   A2                     AND   D   
03A4   20 13                  JR   NZ,udv0   ; not a power of two
03A6   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
03A7   3D                     DEC   A   ;   r = HL & (2^k - 1)
03A8   A4                     AND   H   
03A9   5F                     LD   E,A   ; (the remainder's high byte,
03AA   7D                     LD   A,L   ;   and its low byte)
03AB   6C                     LD   L,H   
03AC   26 00                  LD   H,0   
03AE   CB 3A        UQ4:      SRL   D   
03B0   38 04                  JR   C,uq5   
03B2   CB 3D                  SRL   L   
03B4   18 F8                  JR   uq4   
03B6   53           UQ5:      LD   D,E   
03B7   5F                     LD   E,A   
03B8   C9                     RET      
03B9                          ENDIF      
03B9                          IF   1-FAST   
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    UDV1:     SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   ; carry is clear here: the remainder
                              JR   NC,udv2   ;   always fits in 16 bits
                              ADD   HL,DE   ; too much: put it back, and cancel the
                              DEC   C   ;   INC below
                    UDV2:     INC   C   ; a quotient bit
                              DJNZ   udv1   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
03B9                          ENDIF      
03B9                          IF   FAST   
03B9                             ; (the fast build: the same 16 rounds, unrolled)
03B9   C5           UDV0:     PUSH   BC   
03BA   7C                     LD   A,H   
03BB   4D                     LD   C,L   
