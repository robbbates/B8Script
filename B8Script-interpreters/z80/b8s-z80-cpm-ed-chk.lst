0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 08               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0103                          ENDIF      
0103                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0103                          ENDIF      
0103                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0103                          ENDIF      
0103                          IF   EDGEN   
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 3C 06               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 AE 05     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 E4 03               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 BC 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD 50 04               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LD   A,(BC)   
0138   03                     INC   BC   
0139   D6 21                  SUB   21h   ; A = c - 21h
013B   38 D4                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CP   0Fh   
013F   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0141   D6 0F                  SUB   0Fh   ; A = c - 30h
0143   FE 0A                  CP   0Ah   
0145   38 5F                  JR   C,digit   ; 30h-39h
0147   FE 11                  CP   11h   
0149   38 19                  JR   C,p3a   ; 3Ah-40h
014B   D6 11                  SUB   11h   ; A = c - 41h
014D   FE 1A                  CP   1Ah   
014F   38 61                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0151   FE 20                  CP   20h   
0153   38 0D                  JR   C,p5b   ; 5Bh-60h
0155   FE 3A                  CP   3Ah   
0157   38 53                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0159   FE 3E                  CP   3Eh   
015B                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
015B                          ENDIF      
015B                          IF   CHECKED   
015B   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
015D   D2 89 04               JP   NC,e_hi   ; 80h-FFh: reserved
0160                          ENDIF      
0160   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0162   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0164   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0166                .macro PTABLE,
0166                             ; 
0166                 DB      h_store & 0FFh  ; !
0166                 DB      h_str & 0FFh    ; "
0166                 DB      h_num & 0FFh    ; #
0166                 DB      h_print & 0FFh  ; $
0166                 DB      h_swap & 0FFh   ; %
0166                 DB      h_and & 0FFh    ; &
0166                 DB      h_emit & 0FFh   ; '
0166                 DB      h_open & 0FFh   ; (
0166                 DB      h_close & 0FFh  ; )
0166                 DB      h_mul & 0FFh    ; *
0166                 DB      h_add & 0FFh    ; +
0166                 DB      h_cfetch & 0FFh ; ,
0166                 DB      h_sub & 0FFh    ; -
0166                 DB      h_cstore & 0FFh ; .
0166                 DB      h_div & 0FFh    ; /
0166                 DB      h_dup & 0FFh    ; :
0166                 DB      h_drop & 0FFh   ; ;
0166                 DB      h_lt & 0FFh     ; <
0166                 DB      h_eq & 0FFh     ; =
0166                 DB      h_gt & 0FFh     ; >
0166                 DB      h_key & 0FFh    ; ?
0166                 DB      h_fetch & 0FFh  ; @
0166                 DB      h_def & 0FFh    ; [
0166                 DB      h_break & 0FFh  ; \
0166                 DB      h_ret & 0FFh    ; ]
0166                 DB      h_xor & 0FFh    ; ^
0166                 DB      h_alloc & 0FFh  ; _
0166                 DB      h_grave & 0FFh  ; `
0166                 DB      h_tor & 0FFh    ; {
0166                 DB      h_or & 0FFh     ; |
0166                 DB      h_fromr & 0FFh  ; }
0166                 DB      h_not & 0FFh    ; ~
0166                .endm
0166                 
0166                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0166                             ; untouched, and A, DE free.
0166   C6 B8        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0168   5F                     LD   E,A   
0169   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
016B   FE CE                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016D   1A                     LD   A,(DE)   
016E   5F                     LD   E,A   ; the handler's low byte
016F                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
016F                          ENDIF      
016F                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
016F                          ENDIF      
016F                          IF   CPM   
016F   16 01                  LD   D,1   
0171   30 01                  JR   NC,pu1   
0173   14                     INC   D   ; its page: 1 + carry
0174                PU1:         
0174                          ENDIF      
0174   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0175   C9                     RET      ;   when the handler starts
0176                             ; The rest of the startup: here so that the generic reset code can reach it
0176                             ; with JR. st0: find the program's NUL; the heap starts after it.
0176                             ; (The editor build has its own copy of this, next to the editor.)
0176                             ; A checked build first clears the lower half of the letter page (A = 0):
0176                             ; every variable starts at 0, every word cell holds 0000h, the address an
0176                             ; undefined word is caught at (see e_hi), and no key is held back.
0176                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0176                          ENDIF      
0176                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0176                          ENDIF      
0176                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0176                          ENDIF      
0176                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0176                          ENDIF      
0176                             ; In the unchecked generic editor build the table is here, in the first
0176                             ; page, which saves loading D twice. (The other builds have no room for it
0176                             ; here: theirs is further down.)
0176                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0176                          ENDIF      
0176                             ; =============================================================================
0176                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0176                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0176                             ;  is here too: it belongs to "`" and makes the page come out right.
0176                             ; =============================================================================
0176   D1           H_XOR:    POP   DE   
0177   7C                     LD   A,H   
0178   AA                     XOR   D   
0179   67                     LD   H,A   
017A   7D                     LD   A,L   
017B   AB                     XOR   E   
017C   6F                     LD   L,A   
017D   F7                     RST   30h   
017E   D1           H_OR:     POP   DE   
017F   7C                     LD   A,H   
0180   B2                     OR   D   
0181   67                     LD   H,A   
0182   7D                     LD   A,L   
0183   B3                     OR   E   
0184   6F                     LD   L,A   
0185   F7                     RST   30h   
0186   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0187   2B                     DEC   HL   
0188   F7                     RST   30h   
0189                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0189                             ; the same either way); TOS is the old pointer.
0189   ED 5B 7C 09  H_ALLOC:   LD   DE,(HEAP)   
018D                          IF   CHECKED*CPM   
018D   7C                     LD   A,H   ; the count's sign, for chkhp
018E                          ENDIF      
018E   19                     ADD   HL,DE   ; the new top
018F                          IF   CHECKED   
018F   CD 0E 04               CALL   chkhp   
0192                          ENDIF      
0192   22 7C 09               LD   (HEAP),HL   
0195   EB                     EX   DE,HL   
0196   F7                     RST   30h   
0197   D9           EXEC:     EXX      
0198   22 34 09               LD   (RSAVE),HL   ; machine code may change the alternates
019B   D9                     EXX      
019C   CD 2B 01               CALL   jphl   
019F   D9                     EXX      
01A0   2A 34 09               LD   HL,(RSAVE)   
01A3   D9                     EXX      
01A4   E1                     POP   HL   
01A5   F7                     RST   30h   
01A6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01A6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01A6                             ; Digits: step back onto the first digit and read the whole number.
01A6   E5           DIGIT:    PUSH   HL   
01A7   0B                     DEC   BC   
01A8   CD 28 03               CALL   rdnum   
01AB   F7                     RST   30h   
01AC                             ; a-z: push the cell's address (the cell is the variable)
01AC   E5           LOWER:    PUSH   HL   
01AD   87                     ADD   A,A   
01AE   6F                     LD   L,A   
01AF   26 09                  LD   H,LETPAGE   
01B1   F7                     RST   30h   
01B2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01B2                             ; the return stack, and the IP becomes the address in the letter's cell.
01B2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01B3   EB                     EX   DE,HL   ; park TOS
01B4   87                     ADD   A,A   
01B5   6F                     LD   L,A   
01B6   26 09                  LD   H,LETPAGE   ; HL -> cell
01B8   4E                     LD   C,(HL)   
01B9   2C                     INC   L   
01BA   46                     LD   B,(HL)   ; IP = the word's body
01BB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01BC                             ; rpushn: move the top cell of the data stack (in memory) to the return
01BC                             ; stack, then next. Everything that pushes the return stack ends here.
01BC                RPUSHN:      
01BC                          IF   CHECKED   
01BC   CD 7D 04               CALL   chkbrk   ; Ctrl-C is checked at every word call, block
01BF                          ENDIF      ;   entry, loop-back and "{"
01BF   D9                     EXX      
01C0   D1                     POP   DE   
01C1   2B                     DEC   HL   
01C2   72                     LD   (HL),D   
01C3   2B                     DEC   HL   
01C4   73                     LD   (HL),E   
01C5   D9                     EXX      
01C6   F7                     RST   30h   
01C7                             ; ---- machine code: the grave -----------------------------------------------
01C7                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01C7                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01C7                             ; written and its address is left. An odd last digit is consumed and dropped.
01C7                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01C7                             ; code is entered by CALL with the data stack above the return address; it
01C7                             ; must keep BC, and on return the top cell becomes the new TOS.
01C7   CD A6 03     H_GRAVE:   CALL   hexc   
01CA   30 CB                  JR   NC,exec   
01CC   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01CD   CD A6 03               CALL   hexc   
01D0   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01D2   ED 6F                  RLD      ;   overwrites it
01D4   23                     INC   HL   ; ... and RLD shifts it up under the low one
01D5   CD A6 03               CALL   hexc   
01D8   38 F2                  JR   C,hx1   
01DA   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01DC   F7                     RST   30h   
01DD                             ; ---- where the two pages meet ----------------------------------------------
01DD                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01DD                             ; are in falling code order for this), and where exactly differs between the
01DD                             ; builds: NPG1 follows. Every handler below these four must start in the
01DD                             ; second page, and every one above in the first; chktab.py checks both.
01DD                             ; "]" returns: pop an address and jump to it.
01DD   CF           H_RET:    RST   08h   
01DE   42                     LD   B,D   
01DF   4B                     LD   C,E   
01E0   F7           BRK1:     RST   30h   
01E1                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E1                             ; drops the block start, "]" returns. No closer at all ends the program.
01E1   7C           H_BREAK:   LD   A,H   
01E2   B5                     OR   L   
01E3   E1                     POP   HL   
01E4   28 FA                  JR   Z,brk1   
01E6   CD 4F 03               CALL   skip   
01E9   B7                     OR   A   ; skip returns 0 for ")"
01EA   20 F1                  JR   NZ,h_ret   
01EC   CF           RDROP:    RST   08h   
01ED   F7                     RST   30h   
01EE                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EE                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EE                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EE                             ; (The unchecked build takes anything that is not a letter as the space; the
01EE                             ; checked build stops on it.)
01EE   0A           H_DEF:    LD   A,(BC)   
01EF   03                     INC   BC   
01F0   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01F2   5F                     LD   E,A   ;   lands 64 bytes up
01F3   E6 DF                  AND   0DFh   ; fold case
01F5   FE 1A                  CP   26   
01F7   30 0B                  JR   NC,def2   ; not a letter
01F9   CB 23                  SLA   E   
01FB   16 09                  LD   D,LETPAGE   ; DE -> cell
01FD   79                     LD   A,C   
01FE   12                     LD   (DE),A   
01FF   1C                     INC   E   
0200   78                     LD   A,B   
0201   12                     LD   (DE),A   
0202   18 09                  JR   skipnx   
0204                DEF2:        
0204                          IF   CHECKED   
0204   7B                     LD   A,E   
0205   FE DF                  CP   " "-"A"+256   
0207   C2 A9 04               JP   NZ,e_brack   ; anything but a letter or a space
020A                          ENDIF      
020A   E5                     PUSH   HL   ; an anonymous block: push its address
020B   60                     LD   H,B   
020C   69                     LD   L,C   
020D                SKIPNX:      
020D                          IF   CHECKED   
020D   0B                     DEC   BC   ; back onto the letter, so that skip finds its
020E                          ENDIF      ;   opener, the "[", just before where it starts
020E   CD 4F 03     SKIPO:    CALL   skip   
0211   F7                     RST   30h   
0212   5E           H_FETCH:   LD   E,(HL)   ; "@"
0213   23                     INC   HL   
0214   56                     LD   D,(HL)   
0215   EB                     EX   DE,HL   
0216   F7                     RST   30h   
0217                             ; =============================================================================
0217                             ;  Handlers that must start in the image's second page.
0217                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0217                             ;  page.
0217                             ; =============================================================================
0217                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0217                             ; the matching ")".
0217   7C           H_OPEN:   LD   A,H   
0218   B5                     OR   L   
0219   E1                     POP   HL   
021A   28 F2                  JR   Z,skipo   
021C   C5                     PUSH   BC   ; the block starts at the IP
021D   18 9D                  JR   rpushn   
021F                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
021F                             ; drops it and carries on.
021F   7C           H_CLOSE:   LD   A,H   
0220   B5                     OR   L   
0221   E1                     POP   HL   
0222   28 C8                  JR   Z,rdrop   
0224   CF                     RST   08h   ; pop the block start ...
0225   42                     LD   B,D   
0226   4B                     LD   C,E   
0227   C5                     PUSH   BC   
0228   18 92                  JR   rpushn   ; ... and push it back
022A                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022A                             ; "-" has two jobs: directly before a digit it starts a negative number.
022A   0A           H_SUB:    LD   A,(BC)   
022B   D6 30                  SUB   "0"   
022D   FE 0A                  CP   10   
022F   38 04                  JR   C,negnum   
0231   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0232   D1           H_ADD:    POP   DE   
0233   19                     ADD   HL,DE   
0234   F7                     RST   30h   
0235   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0236   CD 28 03               CALL   rdnum   
0239   E7                     RST   20h   
023A   F7                     RST   30h   
023B   D1           H_AND:    POP   DE   
023C   7C                     LD   A,H   
023D   A2                     AND   D   
023E   67                     LD   H,A   
023F   7D                     LD   A,L   
0240   A3                     AND   E   
0241   6F                     LD   L,A   
0242   F7                     RST   30h   
0243                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0243                             ; cells first. Flipping both sign bits turns a signed compare into an
0243                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0243                             ; carry into -1 or 0 with no branch.
0243   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0244   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0245   7C                     LD   A,H   
0246   EE 80                  XOR   80h   
0248   67                     LD   H,A   
0249   7A                     LD   A,D   
024A   EE 80                  XOR   80h   
024C   57                     LD   D,A   
024D   ED 52                  SBC   HL,DE   ; carry if HL < DE
024F   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0251   F7                     RST   30h   
0252   D1           H_EQ:     POP   DE   
0253   B7                     OR   A   
0254   ED 52                  SBC   HL,DE   
0256   7C                     LD   A,H   
0257   B5                     OR   L   
0258   FE 01                  CP   1   ; carry only if a - b = 0
025A   18 F3                  JR   tf   
025C                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
025C                             ; multiplier shifts up through A:C.
025C   D1           H_MUL:    POP   DE   ; DE = multiplicand
025D   C5                     PUSH   BC   
025E   7C                     LD   A,H   
025F   4D                     LD   C,L   ; A:C = multiplier
0260   21 00 00               LD   HL,0   
0263   06 10                  LD   B,16   
0265   29           MUL1:     ADD   HL,HL   
0266   CB 21                  SLA   C   
0268   17                     RLA      
0269   30 01                  JR   NC,mul2   
026B   19                     ADD   HL,DE   
026C   10 F7        MUL2:     DJNZ   mul1   
026E   C1                     POP   BC   
026F   F7                     RST   30h   
0270                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0270                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0270                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0270                             ; stops on it.
0270                H_DIV:       
0270                          IF   CHECKED   
0270   7C                     LD   A,H   
0271   B5                     OR   L   
0272   CA A6 04               JP   Z,e_zero   
0275                          ENDIF      
0275   D1                     POP   DE   ; DE = a, HL = b
0276   C5                     PUSH   BC   ; free BC for udiv
0277   D5                     PUSH   DE   ; a, for r's sign
0278   7A                     LD   A,D   
0279   AC                     XOR   H   
027A   F5                     PUSH   AF   ; S flag = sign of q
027B   CB 7C                  BIT   7,H   
027D   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0280   EB                     EX   DE,HL   
0281   CB 7C                  BIT   7,H   
0283   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0286   CD 02 03               CALL   udiv   ; HL = q, DE = r
0289   F1                     POP   AF   
028A   FC 20 01               CALL   M,neg16   ; q's sign
028D   EB                     EX   DE,HL   ; HL = r, DE = q
028E   F1                     POP   AF   ; A = a's high byte
028F   B7                     OR   A   
0290   FC 20 01               CALL   M,neg16   ; r's sign
0293   C1                     POP   BC   
0294   D5                     PUSH   DE   ; q under r
0295   F7                     RST   30h   
0296                             ; ---- stack and storage -----------------------------------------------------
0296   E5           H_DUP:    PUSH   HL   ; ":"
0297   F7                     RST   30h   
0298   E3           H_SWAP:   EX   (SP),HL   ; "%"
0299   F7                     RST   30h   
029A                             ; (The checked build tests the address before it takes the value off the
029A                             ; stack, so that an error report shows both.)
029A                H_CSTORE:      ; "." ( c addr -- )
029A                          IF   CHECKED   
029A   CD FD 03               CALL   chkst   
029D                          ENDIF      
029D   D1                     POP   DE   
029E   73                     LD   (HL),E   
029F   DF           H_DROP:   RST   18h   ; ";" is this one byte
02A0                H_STORE:      ; "!" ( n addr -- )
02A0                          IF   CHECKED   
02A0   CD FD 03               CALL   chkst   
02A3                          ENDIF      
02A3   D1                     POP   DE   
02A4   73                     LD   (HL),E   
02A5   23                     INC   HL   
02A6   72                     LD   (HL),D   
02A7   DF                     RST   18h   
02A8                             ; ---- console ---------------------------------------------------------------
02A8                             ; 22h pushes the address of the text after it and skips the string.
02A8   E5           H_STR:    PUSH   HL   
02A9   60                     LD   H,B   
02AA   69                     LD   L,C   
02AB   CD 3E 03               CALL   skipstr   
02AE                          IF   CHECKED   
02AE   B7                     OR   A   ; 0: the text ran out before the closing quote
02AF   CA 9E 04               JP   Z,e_quote   
02B2                          ENDIF      
02B2   F7                     RST   30h   
02B3                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02B3                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02B3                             ; bit 6, so // and /" give themselves).
02B3                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
02B3                          ENDIF      
02B3                          IF   CHECKED   
02B3                             ; (The checked build has the loop as a routine, prstr, which the error
02B3                             ; report uses too. The address is kept on the stack meanwhile: a report
02B3                             ; shows the stack as it was before the "$".)
02B3   E5           H_PRINT:   PUSH   HL   
02B4   CD 2A 04               CALL   prstr   
02B7   D1                     POP   DE   
02B8   DF                     RST   18h   
02B9                          ENDIF      
02B9   7D           H_EMIT:   LD   A,L   ; "'"
02BA   EF                     RST   28h   
02BB   DF           PR9:      RST   18h   
02BC                             ; "#" prints TOS as a signed decimal number, with no space after it.
02BC   C5           H_NUM:    PUSH   BC   
02BD   CD 8C 03               CALL   psgn   
02C0   C1                     POP   BC   
02C1   DF                     RST   18h   
02C2                             ; "?" ( n -- c ) or ( -n -- addr )
02C2                             ;   n > 0: wait about n ms for a key; 0 if none came
02C2                             ;   n = 0: wait for a key
02C2                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C2                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C2   CB 7C        H_KEY:    BIT   7,H   
02C4   20 19                  JR   NZ,line   
02C6   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02C8   CD D8 03     KT2:      CALL   getk   
02CB   20 0E                  JR   NZ,kt3   
02CD   1D                     DEC   E   
02CE   20 F8                  JR   NZ,kt2   
02D0   7C                     LD   A,H   ; 0? never counts down: it waits
02D1   B5                     OR   L   
02D2   28 F2                  JR   Z,kt1   
02D4   2B                     DEC   HL   
02D5   7C                     LD   A,H   
02D6   B5                     OR   L   
02D7   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02D9   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02DA   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02DB   6F           KT3:      LD   L,A   
02DC   26 00                  LD   H,0   
02DE   F7                     RST   30h   
02DF                          IF   CPM   
02DF                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02DF                             ; own line editor). It doesn't store the CR, so it is added here.
02DF   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E2   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02E3   9F                     SBC   A,A   
02E4   A5                     AND   L   ; (0 for a count that is too big)
02E5   EE 7F                  XOR   127   ; A = the count, 127 at most
02E7                          ENDIF      
02E7                          IF   CPM*EDITOR   
02E7   CD ED 02               CALL   rdline   ; (the editor calls rdline too)
02EA   2E 80                  LD   L,LINEBUF & 0FFh   
02EC   F7                     RST   30h   
02ED                             ; rdline: read a line of at most A characters; HL -> the CR that ends it
02ED                RDLINE:      
02ED                          ENDIF      
02ED                          IF   CPM   
02ED   32 7E 09               LD   (LBHDR),A   
02F0   11 7E 09               LD   DE,LBHDR   
02F3   3E 0A                  LD   A,10   
02F5   CD F0 03               CALL   bdosx   
02F8   21 7F 09               LD   HL,LBHDR+1   
02FB   7E                     LD   A,(HL)   ; the count typed (0-127)
02FC   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
02FD   85                     ADD   A,L   ;   adding the count to L can't carry
02FE   6F                     LD   L,A   
02FF   36 0D                  LD   (HL),13   
0301                          ENDIF      
0301                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
0301                          ENDIF      
0301                          IF   CPM*EDITOR   
0301   C9                     RET      
0302                          ENDIF      
0302                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
0302                          ENDIF      
0302                          IFN   CPM   
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
0302                          ENDIF      ;   at most
0302                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
0302                          ENDIF      
0302                          IFN   CPM   
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
0302                          ENDIF      
0302                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
0302                          ENDIF      
0302                          IF   EDGEN   
                              RET      
0302                          ENDIF      
0302                             ; =============================================================================
0302                             ;  More routines (no handler starts past this point)
0302                             ; =============================================================================
0302                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0302                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0302                             ; while the quotient bits arrive at the bottom of C.
0302                             ; Dividing by 2 is one shift (the spec wants that fast).
0302   7B           UDIV:     LD   A,E   
0303   EE 02                  XOR   2   
0305   B2                     OR   D   
0306   20 07                  JR   NZ,udv0   
0308   CB 3C                  SRL   H   
030A   CB 1D                  RR   L   ; the quotient
030C   8F                     ADC   A,A   
030D   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
030E   C9                     RET      
030F   7C           UDV0:     LD   A,H   
0310   4D                     LD   C,L   
0311   21 00 00               LD   HL,0   
0314   06 10                  LD   B,16   
0316   CB 21        UDV1:     SLA   C   
0318   17                     RLA      
0319   ED 6A                  ADC   HL,HL   
031B   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
031D   30 02                  JR   NC,udv2   ;   always fits in 16 bits
031F   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0320   0D                     DEC   C   ;   INC below
0321   0C           UDV2:     INC   C   ; a quotient bit
0322   10 F2                  DJNZ   udv1   
0324   EB                     EX   DE,HL   ; DE = remainder
0325   67                     LD   H,A   
0326   69                     LD   L,C   ; HL = quotient
0327   C9                     RET      
0328                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0328                             ; non-digit. Values wrap at 16 bits, as the spec says.
0328   21 00 00     RDNUM:    LD   HL,0   
032B   0A           RDN1:     LD   A,(BC)   
032C   D6 30                  SUB   "0"   
032E   FE 0A                  CP   10   
0330   D0                     RET   NC   
0331   03                     INC   BC   
0332   54                     LD   D,H   
0333   5D                     LD   E,L   
0334   29                     ADD   HL,HL   
0335   29                     ADD   HL,HL   
0336   19                     ADD   HL,DE   
0337   29                     ADD   HL,HL   ; HL * 10
0338   5F                     LD   E,A   
0339   16 00                  LD   D,0   
033B   19                     ADD   HL,DE   
033C   18 ED                  JR   rdn1   
033E                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
033E                             ; the next character, so "/"" does not end it. Leaves A = 22h.
033E                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
033E                          ENDIF      
033E                          IF   CHECKED   
033E                             ; The checked build never steps over a NUL: if the text runs out first it
033E                             ; returns A = 0 with the IP on the NUL.
033E   0A           SKIPSTR:   LD   A,(BC)   
033F   B7                     OR   A   
0340   C8                     RET   Z   
0341   03                     INC   BC   
0342   FE 22                  CP   22h   
0344   C8                     RET   Z   
0345   FE 2F                  CP   "/"   
0347   20 F5                  JR   NZ,skipstr   
0349   0A                     LD   A,(BC)   ; the escaped character
034A   B7                     OR   A   
034B   C8                     RET   Z   
034C   03                     INC   BC   
034D   18 EF                  JR   skipstr   
034F                          ENDIF      
034F                             ; skip: read past text to the closer at this level, and return A = 0 if it
034F                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
034F                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
034F                             ; no closer; anything else that runs into the NUL had unbalanced brackets
034F                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
034F                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
034F                             ; 
034F                             ; The checked build also looks at the character the skip was started by,
034F                             ; which is always the one just before where it starts: "(" must end at ")",
034F                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
034F                             ; quote counts as running into it. "\" takes either closer. IX keeps the
034F                             ; place where the skip started, for the report.
034F                SKIP:        
034F                          IF   CHECKED   
034F   C5                     PUSH   BC   
0350   DD E1                  POP   IX   
0352   0B                     DEC   BC   
0353   0A                     LD   A,(BC)   
0354   03                     INC   BC   
0355   5F                     LD   E,A   ; E = the opener: ( [ or \
0356                          ENDIF      
0356   16 00                  LD   D,0   
0358   14           SK3:      INC   D   ; an opener: one deeper
0359   0A           SK1:      LD   A,(BC)   
035A                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,endprog   
035A                          ENDIF      
035A                          IF   CHECKED   
035A   B7                     OR   A   
035B   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
035D   03                     INC   BC   
035E                          ENDIF      
035E   FE 22                  CP   22h   
0360   CC 3E 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0363   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0365   28 F1                  JR   Z,sk3   
0367   3D                     DEC   A   ; ")"
0368   28 08                  JR   Z,sk4   
036A   D6 32                  SUB   "["-")"   
036C   28 EA                  JR   Z,sk3   
036E   FE 02                  CP   "]"-"["   
0370   20 E7                  JR   NZ,sk1   
0372   15           SK4:      DEC   D   
0373                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0373                          ENDIF      
0373                          IF   CHECKED   
0373   20 E4                  JR   NZ,sk1   
0375   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0376   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0377   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0379   FE 02                  CP   2   ;   closer, and only then
037B   7A                     LD   A,D   
037C   C0                     RET   NZ   
037D   18 05                  JR   sk7   
037F   CB 53        SK6:      BIT   2,E   ; the text ran out:
0381   C2 15 01               JP   NZ,endprog   ;   "\" with no closer ends the program
0384   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0386   C1                     POP   BC   
0387   3E 4E                  LD   A,"N"   
0389   C3 9B 04               JP   errp   ; (errp drops skip's return address)
038C                          ENDIF      
038C                             ; psgn: print HL as a signed number. Uses BC.
038C   CB 7C        PSGN:     BIT   7,H   
038E   28 04                  JR   Z,pdec   
0390   3E 2D                  LD   A,"-"   
0392   EF                     RST   28h   
0393   E7                     RST   20h   
0394                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0394                             ; Uses BC.
0394   11 0A 00     PDEC:     LD   DE,10   
0397   CD 02 03               CALL   udiv   ; HL = HL / 10, E = the last digit
039A   7B                     LD   A,E   
039B   F5                     PUSH   AF   
039C   7C                     LD   A,H   
039D   B5                     OR   L   
039E   C4 94 03               CALL   NZ,pdec   
03A1   F1                     POP   AF   
03A2   C6 30                  ADD   A,"0"   
03A4   EF                     RST   28h   
03A5   C9                     RET      
03A6                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03A6                             ; and return its value in A with the carry set; otherwise leave the IP and
03A6                             ; return with the carry clear.
03A6   0A           HEXC:     LD   A,(BC)   
03A7   D6 30                  SUB   "0"   
03A9   FE 0A                  CP   10   
03AB   38 09                  JR   C,hc1   
03AD   E6 DF                  AND   0DFh   
03AF   D6 11                  SUB   11h   
03B1   FE 06                  CP   6   
03B3   D0                     RET   NC   
03B4   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03B6   03           HC1:      INC   BC   
03B7   C9                     RET      
03B8                             ; =============================================================================
03B8                             ;  Dispatch table: the low byte of each handler's address, in code order
03B8                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03B8                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03B8                             ; =============================================================================
03B8                             ; The handlers of the first NPG1 characters start in the image's second page.
03B8                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03B8                             ; differs between the builds, so the count is worked out here.
03B8                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03B8                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03B8                PGBRK:    EQU   (h_break-BASE)/256   
03B8                PGDEF:    EQU   (h_def-BASE)/256   
03B8                PGFET:    EQU   (h_fetch-BASE)/256   
03B8                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03B8                          IF   1-TABP0   
03B8                PTAB:        
03B8                          ;*Macro unroll:  PTABLE
03B8   A0                     DB   h_store & 0FFh   
03B9   A8                     DB   h_str & 0FFh   
03BA   BC                     DB   h_num & 0FFh   
03BB   B3                     DB   h_print & 0FFh   
03BC   98                     DB   h_swap & 0FFh   
03BD   3B                     DB   h_and & 0FFh   
03BE   B9                     DB   h_emit & 0FFh   
03BF   17                     DB   h_open & 0FFh   
03C0   1F                     DB   h_close & 0FFh   
03C1   5C                     DB   h_mul & 0FFh   
03C2   32                     DB   h_add & 0FFh   
03C3   DA                     DB   h_cfetch & 0FFh   
03C4   2A                     DB   h_sub & 0FFh   
03C5   9A                     DB   h_cstore & 0FFh   
03C6   70                     DB   h_div & 0FFh   
03C7   96                     DB   h_dup & 0FFh   
03C8   9F                     DB   h_drop & 0FFh   
03C9   43                     DB   h_lt & 0FFh   
03CA   52                     DB   h_eq & 0FFh   
03CB   44                     DB   h_gt & 0FFh   
03CC   C2                     DB   h_key & 0FFh   
03CD   12                     DB   h_fetch & 0FFh   
03CE   EE                     DB   h_def & 0FFh   
03CF   E1                     DB   h_break & 0FFh   
03D0   DD                     DB   h_ret & 0FFh   
03D1   76                     DB   h_xor & 0FFh   
03D2   89                     DB   h_alloc & 0FFh   
03D3   C7                     DB   h_grave & 0FFh   
03D4   2C                     DB   h_tor & 0FFh   
03D5   7E                     DB   h_or & 0FFh   
03D6   1C                     DB   h_fromr & 0FFh   
03D7   86                     DB   h_not & 0FFh   
03D8                PTABEND:      
03D8                          ENDIF      
03D8                             ; =============================================================================
03D8                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
03D8                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
03D8                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
03D8                             ;  KEY and CONOUT routines themselves.
03D8                             ; =============================================================================
03D8                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
03D8                          ENDIF      
03D8                          IF   CHECKED   
03D8   E5           GETK:     PUSH   HL   ; a key held back by the break check goes
03D9   21 36 09               LD   HL,KEYBUF   ;   first, and is taken out of the buffer
03DC   7E                     LD   A,(HL)   
03DD   36 00                  LD   (HL),0   
03DF   E1                     POP   HL   
03E0   B7                     OR   A   
03E1   C0                     RET   NZ   
03E2                          ENDIF      
03E2                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
03E2                          ENDIF      
03E2                          IF   CPM*(1-CHECKED)   
                    GETK:        
03E2                          ENDIF      
03E2                          IF   CPM   
03E2   3E FF                  LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03E4                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
03E4                             ; printing and could swallow a key that BDOS 6 then never sees.
03E4   D5           PUTC:     PUSH   DE   
03E5   E5                     PUSH   HL   
03E6   5F                     LD   E,A   
03E7   3E 06                  LD   A,6   
03E9   CD F0 03               CALL   bdosx   
03EC   E1                     POP   HL   
03ED   D1                     POP   DE   
03EE   B7                     OR   A   ; (for getk)
03EF   C9                     RET      
03F0                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
03F0   C5           BDOSX:    PUSH   BC   
03F1   D9                     EXX      
03F2   E5                     PUSH   HL   
03F3   D9                     EXX      
03F4   4F                     LD   C,A   
03F5   CD 05 00               CALL   BDOS   
03F8   D9                     EXX      
03F9   E1                     POP   HL   
03FA   D9                     EXX      
03FB   C1                     POP   BC   
03FC   C9                     RET      
03FD                          ENDIF      
03FD                             ; =============================================================================
03FD                             ;  Checked build: the checks and the error report
03FD                             ; =============================================================================
03FD                          IF   CHECKED   
03FD                             ; chkst: stop unless HL is in the program's own space: from the letter page
03FD                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
03FD                             ; whatever lies above the limit are safe. Memory above the heap top but
03FD                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
03FD                             ; It is the page of HL + 1 that is tested, so that one test serves both
03FD                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
03FD                             ; Keeps HL and BC.
03FD   23           CHKST:    INC   HL   
03FE   7C                     LD   A,H   
03FF   2B                     DEC   HL   
0400   FE 09                  CP   LETPAGE   
0402   38 07                  JR   C,chs1   
0404                          ENDIF      
0404                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0404                          ENDIF      
0404                          IF   CHECKED*CPM   
0404   5F                     LD   E,A   
0405   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0408   3D                     DEC   A   
0409   BB                     CP   E   
040A   D0                     RET   NC   
040B                          ENDIF      
040B                          IF   CHECKED   
040B   C3 99 04     CHS1:     JP   e_store   
040E                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
040E                             ; the count. Stop if the top is not below the limit page, or is below the
040E                             ; program's end.
040E                CHKHP:       
040E                          ENDIF      
040E                          IF   CHECKED*CPM   
040E                             ; With this much room a top that wrapped round can land back in
040E                             ; range, so the add is tested too: growing (A, the count's high
040E                             ; byte, is positive) must not carry, and releasing must.
040E   1F                     RRA      ; the carry comes in above the sign:
040F   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
0411   87                     ADD   A,A   
0412   38 10                  JR   C,e_heap   
0414   3A 07 00               LD   A,(0007h)   
0417   3D                     DEC   A   
0418   BC                     CP   H   
0419   38 09                  JR   C,e_heap   
041B                          ENDIF      
041B                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
041B                          ENDIF      
041B                          IF   CHECKED   
041B   D5                     PUSH   DE   
041C   EB                     EX   DE,HL   
041D   2A 38 09               LD   HL,(NPEND)   
0420   19                     ADD   HL,DE   ; carry: at or above the program's end
0421   EB                     EX   DE,HL   
0422   D1                     POP   DE   
0423   D8                     RET   C   
0424   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0425   ED 52                  SBC   HL,DE   
0427   C3 96 04               JP   e_heap1   
042A                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
042A                             ; "$", and the error report's texts). A NUL first is an error: Q.
042A   7E           PRSTR:    LD   A,(HL)   
042B   23                     INC   HL   
042C   FE 22                  CP   22h   
042E   C8                     RET   Z   
042F   B7                     OR   A   
0430   28 0B                  JR   Z,e_dollar   
0432   FE 2F                  CP   "/"   
0434   20 04                  JR   NZ,prs1   
0436   7E                     LD   A,(HL)   
0437   23                     INC   HL   
0438   E6 BF                  AND   0BFh   
043A   EF           PRS1:     RST   28h   
043B   18 ED                  JR   prstr   
043D   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
043E   E1                     POP   HL   ;   and put the string's address back in TOS
043F   3E 51                  LD   A,"Q"   
0441   C3 AB 04               JP   error   
0444                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0444                             ; pnl: the same, on a new line.
0444   3E 0D        PNL:      LD   A,13   
0446   EF                     RST   28h   
0447   3E 0A                  LD   A,10   
0449   EF                     RST   28h   
044A   E3           PMSG:     EX   (SP),HL   
044B   CD 2A 04               CALL   prstr   
044E   E3                     EX   (SP),HL   
044F   C9                     RET      
0450                             ; chkstk: both stacks are checked once per character, not in every handler.
0450                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0450                             ; the constant carries if it is above (cells were popped that were never
0450                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0450                             ; a character late at most: the bytes above DSTOP and the guard band below
0450                             ; the page take what happens meanwhile. DE is free between characters.
0450   EB           CHKSTK:   EX   DE,HL   
0451   21 05 F7               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0454   39                     ADD   HL,SP   
0455   EB                     EX   DE,HL   
0456   38 1E                  JR   C,e_under   
0458   14                     INC   D   
0459   20 17                  JR   NZ,e_over   
045B   D9                     EXX      ; the return stack: in its page (or it has
045C   7C                     LD   A,H   ;   overflowed), and not above its empty
045D   FE 07                  CP   RSPAGE   ;   position (an underflow stays inside the
045F   7D                     LD   A,L   ;   page, in the guard band)
0460   D9                     EXX      
0461   20 0C                  JR   NZ,e_rover   
0463   FE E1                  CP   RSTOP&0FFh+1   
0465   D8                     RET   C   
0466   D9                     EXX      ; return stack underflow: it counts as empty
0467   21 E0 07               LD   HL,RSTOP   
046A   D9                     EXX      
046B   3E 72                  LD   A,"r"   
046D   18 2C                  JR   errp   
046F   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0471   11                     DB   11h   ; (LD DE,nn hides the next entry)
0472   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0474   18 25                  JR   errp   
0476   31 FC 08     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0479   3E 73                  LD   A,"s"   
047B   18 2E                  JR   error   
047D                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
047D                             ; else is held for the next "?".
047D   CD D8 03     CHKBRK:   CALL   getk   
0480   C8                     RET   Z   
0481   FE 03                  CP   3   
0483   28 0E                  JR   Z,e_break   
0485   32 36 09               LD   (KEYBUF),A   
0488   C9                     RET      
0489                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0489                             ; was never defined still holds 0000h, and the byte there is a reserved one
0489                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0489                             ; an undefined word. The call is undone, so the place is the call itself.
0489   04           E_HI:     INC   B   
048A   10 17                  DJNZ   e_resv   ; (B is as it was, and is not 0)
048C   CF                     RST   08h   
048D   42                     LD   B,D   
048E   4B                     LD   C,E   
048F   3E 55                  LD   A,"U"   
0491   18 18                  JR   error   
0493                             ; Error entries. Each loads its letter and then hides the next entry inside
0493                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0493   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside chkbrk)
0495   11                     DB   11h   
0496   3E 48        E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
0498   11                     DB   11h   
0499   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
049B                             ; errp: an error found inside a routine: drop its return address first.
049B   D1           ERRP:     POP   DE   
049C   18 0D                  JR   error   
049E   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
049F   4D                     LD   C,L   ;   past the opening quote, which is the place
04A0   3E 51                  LD   A,"Q"   
04A2   11                     DB   11h   
04A3   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
04A5   11                     DB   11h   
04A6   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
04A8   11                     DB   11h   
04A9   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
04AB                             ; error: the report, then the end. A = the letter, BC = one past the place,
04AB                             ; HL = TOS, and both stacks as the report is to show them:
04AB                             ; 
04AB                             ;   Err X @ line,col
04AB                             ;   up to 16 characters of the text from the place
04AB                             ;   Stk n: the top 8 cells at most, bottom to top
04AB                             ;   Rtn n
04AB   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
04AC   5F                     LD   E,A   
04AD   CD 44 04               CALL   pnl   
04B0   45 72 72 20 22         DB   "Err ",22h   
04B5   7B                     LD   A,E   
04B6   EF                     RST   28h   
04B7   CD 4A 04               CALL   pmsg   
04BA   20 40 20 22            DB   " @ ",22h   
04BE   0B                     DEC   BC   ; BC = the place
04BF                             ; The line and column. A place below the program is in the line
04BF                             ; buffer: line 0. Otherwise count the LFs from the program's start;
04BF                             ; DE = the line's number, HL = where it starts.
04BF   21 80 09               LD   HL,LINEBUF   
04C2   11 00 00               LD   DE,0   
04C5   78                     LD   A,B   
04C6   FE 0A                  CP   PROG/256   
04C8   38 14                  JR   C,er3   
04CA   24                     INC   H   
04CB   6B                     LD   L,E   ; HL = PROG
04CC   13           ER1:      INC   DE   ; a new line starts at HL
04CD   E5                     PUSH   HL   
04CE   7D           ER2:      LD   A,L   
04CF   91                     SUB   C   
04D0   7C                     LD   A,H   
04D1   98                     SBC   A,B   
04D2   30 09                  JR   NC,er2x   ; reached the place
04D4   7E                     LD   A,(HL)   
04D5   23                     INC   HL   
04D6   FE 0A                  CP   10   
04D8   20 F4                  JR   NZ,er2   
04DA   F1                     POP   AF   
04DB   18 EF                  JR   er1   
04DD   E1           ER2X:     POP   HL   
04DE   C5           ER3:      PUSH   BC   
04DF   E5                     PUSH   HL   
04E0   EB                     EX   DE,HL   
04E1   CD 94 03               CALL   pdec   ; the line
04E4   3E 2C                  LD   A,","   
04E6   EF                     RST   28h   
04E7   D1                     POP   DE   
04E8   E1                     POP   HL   
04E9   E5                     PUSH   HL   
04EA   B7                     OR   A   
04EB   ED 52                  SBC   HL,DE   
04ED   23                     INC   HL   
04EE   CD 94 03               CALL   pdec   ; the column
04F1   CD 44 04               CALL   pnl   
04F4   22                     DB   22h   
04F5   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
04F6   06 10                  LD   B,16   ;   if the line or the program ends first
04F8   7E           ER4:      LD   A,(HL)   
04F9   23                     INC   HL   
04FA   B7                     OR   A   
04FB   28 0F                  JR   Z,er5   
04FD   FE 0D                  CP   13   
04FF   28 0B                  JR   Z,er5   
0501   FE 0A                  CP   10   
0503   28 07                  JR   Z,er5   
0505                          ENDIF      
0505                          IF   CHECKED*CPM   
0505   FE 1A                  CP   1Ah   ; (the ^Z that pads a file's last record ends
0507   28 03                  JR   Z,er5   ;   the text too: some terminals clear the
0509                          ENDIF      ;   screen on it)
0509                          IF   CHECKED   
0509   EF                     RST   28h   
050A   10 EC                  DJNZ   er4   
050C   CD 44 04     ER5:      CALL   pnl   
050F   53 74 6B 20 22         DB   "Stk ",22h   
0514   21 FA 08               LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
0517   B7                     OR   A   ;   first value and holds nothing)
0518   ED 72                  SBC   HL,SP   
051A   CD 65 05               CALL   phalf   ; the depth
051D   3E 3A                  LD   A,":"   
051F   EF                     RST   28h   
0520   79                     LD   A,C   
0521   FE 09                  CP   9   
0523   38 0A                  JR   C,er6   
0525   CD 4A 04               CALL   pmsg   
0528   20 2E 2E 2E 22         DB   " ...",22h   
052D   0E 08                  LD   C,8   
052F   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0531   69                     LD   L,C   
0532   29                     ADD   HL,HL   
0533   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0534   0C                     INC   C   
0535   0D           ER7:      DEC   C   
0536   28 11                  JR   Z,er8   
0538   2B                     DEC   HL   
0539   56                     LD   D,(HL)   
053A   2B                     DEC   HL   
053B   5E                     LD   E,(HL)   
053C   E5                     PUSH   HL   
053D   C5                     PUSH   BC   
053E   3E 20                  LD   A," "   
0540   EF                     RST   28h   
0541   EB                     EX   DE,HL   
0542   CD 8C 03               CALL   psgn   
0545   C1                     POP   BC   
0546   E1                     POP   HL   
0547   18 EC                  JR   er7   
0549   CD 44 04     ER8:      CALL   pnl   
054C   52 74 6E 20 22         DB   "Rtn ",22h   
0551   D9                     EXX      
0552   E5                     PUSH   HL   
0553   D9                     EXX      
0554   D1                     POP   DE   
0555   21 E0 07               LD   HL,RSTOP   
0558   B7                     OR   A   
0559   ED 52                  SBC   HL,DE   
055B   CD 65 05               CALL   phalf   
055E   CD 44 04               CALL   pnl   
0561   22                     DB   22h   
0562   C3 15 01               JP   endprog   
0565                             ; phalf: print half of HL, and leave it in C
0565   CB 3C        PHALF:    SRL   H   
0567   CB 1D                  RR   L   
0569   E5                     PUSH   HL   
056A   CD 94 03               CALL   pdec   
056D   C1                     POP   BC   
056E   C9                     RET      
056F                          ENDIF      
056F                             ; =============================================================================
056F                             ;  The line editor (EDITOR = 1)
056F                             ; 
056F                             ;  The interpreter starts here, and a program that ends comes back here. Type
056F                             ;  a line and press Return:
056F                             ; 
056F                             ;    n text    put the text in as line n; the lines from n on move down.
056F                             ;              A number past the end, or 0, adds the line at the end.
056F                             ;    n         take line n out
056F                             ;    0         run the program
056F                             ;    -n        list the program from line n on (-1 lists all of it). Any key
056F                             ;              stops the list until another key is pressed; Ctrl-C ends it.
056F                             ;    anything else is run at once, as B8Script. (Start such a line with a
056F                             ;    space if it would begin with a digit or a minus sign.)
056F                             ; 
056F                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
056F                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
056F                             ;  125 characters, the line number and the one character after it included;
056F                             ;  that character is not stored. The text is kept as it is typed, each line
056F                             ;  ending in CR LF, at PROG. Nothing is checked.
056F                             ; 
056F                             ;  With CPM = 1 the file named on the command line is the program to start
056F                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
056F                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
056F                             ;  CP/M. Nothing is written back: there is no command to save.
056F                             ; 
056F                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
056F                             ;  its report and comes back here, with both stacks empty. The place is a
056F                             ;  line and column of the program; in a line typed here it is line 0.
056F                             ; 
056F                             ;  Things to know:
056F                             ;    - Reset empties the program (generic builds).
056F                             ;    - Words and variables last from one line to the next. A word's address
056F                             ;      points into the program, so run the program again after editing it.
056F                             ;    - Nothing is printed between a program's output and what is typed next.
056F                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
056F                             ;      a line that calls -n? and carries on afterwards runs what was typed.
056F                             ;      (The stored program never comes back to the line, so it may.)
056F                             ; =============================================================================
056F                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
056F                          ENDIF      
056F                          IF   EDITOR   
056F                             ; -n: list from line n. DE = the number of the line at HL.
056F   03           LIST:     INC   BC   
0570   CD 28 03               CALL   rdnum   ; HL = n
0573   E5                     PUSH   HL   
0574   CD 1B 06               CALL   find   
0577   D1                     POP   DE   
0578   7E           LI1:      LD   A,(HL)   
0579   B7                     OR   A   
057A   28 32                  JR   Z,edit   ; the end of the text
057C   CD D8 03               CALL   getk   
057F   28 0D                  JR   Z,li3   ; no key: carry on
0581   FE 03                  CP   3   
0583   28 29                  JR   Z,edit   ; Ctrl-C
0585   CD D8 03     LI2:      CALL   getk   ; any other key: wait for one more
0588   28 FB                  JR   Z,li2   
058A   FE 03                  CP   3   
058C   28 20                  JR   Z,edit   
058E   E5           LI3:      PUSH   HL   
058F   D5                     PUSH   DE   
0590   EB                     EX   DE,HL   
0591   CD 94 03               CALL   pdec   ; the line's number,
0594   3E 20                  LD   A," "   
0596   EF                     RST   28h   ;   a space,
0597   D1                     POP   DE   
0598   E1                     POP   HL   
0599   13                     INC   DE   
059A   CD 33 06               CALL   prl   ;   and the line
059D   18 D9                  JR   li1   
059F                             ; Take line n (in HL) out: copy everything after it down over it.
059F   CD 1B 06     DEL:      CALL   find   
05A2   54                     LD   D,H   
05A3   5D                     LD   E,L   
05A4   CD 29 06               CALL   nxl   ; HL -> the next line
05A7   7E           DE1:      LD   A,(HL)   
05A8   12                     LD   (DE),A   
05A9   23                     INC   HL   
05AA   13                     INC   DE   
05AB   B7                     OR   A   
05AC   20 F9                  JR   NZ,de1   ; and fall into the editor
05AE   31 FC 08     EDIT:     LD   SP,DSTOP   
05B1                          ENDIF      
05B1                          IF   EDITOR*CPM*CHECKED   
05B1                             ; A key that the break check held back while a program ran is let
05B1                             ; go: BDOS 10 would not see it, and it would turn up in the next
05B1                             ; program that asked for a key. (This also serves at the start.)
05B1   AF                     XOR   A   
05B2   32 36 09               LD   (KEYBUF),A   
05B5                          ENDIF      
05B5                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
05B5                          ENDIF      
05B5                          IF   EDITOR*CPM   
05B5   3E 7D                  LD   A,125   
05B7                          ENDIF      
05B7                          IF   EDITOR   
05B7   CD ED 02               CALL   rdline   ; HL -> the CR that ended the line
05BA   2C                     INC   L   
05BB   36 0A                  LD   (HL),10   ; a LF after it,
05BD   2D                     DEC   L   
05BE   CD 33 06               CALL   prl   ; (print the CR LF: a new line)
05C1   36 00                  LD   (HL),0   ;   and a NUL after that
05C3   E5                     PUSH   HL   ; the end of what was typed
05C4   01 80 09               LD   BC,LINEBUF   
05C7   0A                     LD   A,(BC)   
05C8   FE 2D                  CP   "-"   
05CA   28 A3                  JR   Z,list   
05CC   CD 28 03               CALL   rdnum   ; HL = the number it starts with, BC -> after
05CF   79                     LD   A,C   ; C is still 80h if there was no number:
05D0   87                     ADD   A,A   ;   only then is twice it 0
05D1   28 0C                  JR   Z,st0   ; no number: run the line where it is
05D3   0A                     LD   A,(BC)   
05D4   D6 0D                  SUB   13   
05D6   20 1D                  JR   NZ,ins   ; text follows the number
05D8   B4                     OR   H   ; the number alone:
05D9   B5                     OR   L   
05DA   20 C3                  JR   NZ,del   ;   not 0: take that line out
05DC   01 00 0A               LD   BC,PROG   ;   0: run the program
05DF                             ; st0: start running at BC. The heap starts after the stored program's NUL.
05DF   E1           ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
05E0   21 00 0A               LD   HL,PROG   
05E3   AF                     XOR   A   
05E4   BE           ST1:      CP   (HL)   
05E5   23                     INC   HL   
05E6   20 FC                  JR   NZ,st1   
05E8   22 7C 09               LD   (HEAP),HL   
05EB                          ENDIF      
05EB                          IF   EDITOR*CHECKED   
05EB   E7                     RST   20h   ; minus the heap"s first address: "_' may not
05EC   22 38 09               LD   (NPEND),HL   ;   release below it
05EF                          ENDIF      
05EF                          IF   EDITOR   
05EF   D9                     EXX      
05F0   21 E0 07               LD   HL,RSTOP   ; the return stack is empty
05F3   D9                     EXX      
05F4   F7                     RST   30h   ; (its return address is thrown away)
05F5                             ; Put the typed text in as line n (in HL): open a gap of its length there,
05F5                             ; CR and LF included, and copy it in.
05F5   CD 1B 06     INS:      CALL   find   ; HL -> where it goes
05F8   03                     INC   BC   ; step over the one character after the number
05F9   D1                     POP   DE   ; the end of what was typed
05FA   7B                     LD   A,E   
05FB   91                     SUB   C   ; A = the length of the text, with its CR LF
05FC   C5                     PUSH   BC   ; the text
05FD   4F                     LD   C,A   
05FE   06 00                  LD   B,0   
0600   C5                     PUSH   BC   ; its length
0601   54                     LD   D,H   
0602   5D                     LD   E,L   ; DE = where it goes
0603   AF                     XOR   A   
0604   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0605   ED B1                  CPIR      ; HL -> one past the program's NUL
0607   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0609   44                     LD   B,H   
060A   4D                     LD   C,L   
060B   19                     ADD   HL,DE   
060C   2B                     DEC   HL   ; HL -> the NUL
060D   EB                     EX   DE,HL   
060E   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
060F   E5                     PUSH   HL   
0610   19                     ADD   HL,DE   ; the NUL's new place
0611   EB                     EX   DE,HL   
0612   ED B8                  LDDR      ; move the rest of the program up
0614   C1                     POP   BC   ; the length
0615   D1                     POP   DE   ; where it goes
0616   E1                     POP   HL   ; the text
0617   ED B0                  LDIR      
0619   18 93                  JR   edit   
061B                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
061B                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
061B   EB           FIND:     EX   DE,HL   
061C   21 00 0A               LD   HL,PROG   
061F   1B           FI1:      DEC   DE   
0620   7A                     LD   A,D   
0621   B3                     OR   E   
0622   C8                     RET   Z   
0623   CD 29 06               CALL   nxl   
0626   20 F7                  JR   NZ,fi1   
0628   C9                     RET      
0629                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0629                             ; stop at the NUL that ends the text (and return zero).
0629   7E           NXL:      LD   A,(HL)   
062A   B7                     OR   A   
062B   C8                     RET   Z   
062C   23                     INC   HL   
062D   FE 0A                  CP   10   
062F   20 F8                  JR   NZ,nxl   
0631   B7                     OR   A   
0632   C9                     RET      
0633                             ; prl: print the line at HL, to its LF; HL -> just past it.
0633   7E           PRL:      LD   A,(HL)   
0634   EF                     RST   28h   
0635   7E                     LD   A,(HL)   
0636   23                     INC   HL   
0637   FE 0A                  CP   10   
0639   20 F8                  JR   NZ,prl   
063B   C9                     RET      
063C                          ENDIF      
063C                             ; =============================================================================
063C                             ;  CP/M startup (the generic build starts at address 0: see st0)
063C                             ; =============================================================================
063C                          IF   CPM   
063C                             ; The RAM pages follow the image; the heap may grow to the BDOS.
063C                START:       
063C                          ENDIF      
063C                          IF   CPM*CHECKED   
063C                             ; Clear the lower half of the letter page: every variable starts at
063C                             ; 0, every word cell holds 0000h, the address an undefined word is
063C                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
063C                             ; is held back.
063C   21 00 09               LD   HL,LET   
063F   AF                     XOR   A   
0640   77           INI1:     LD   (HL),A   
0641   2C                     INC   L   
0642   F2 40 06               JP   P,ini1   ; +00h to +7Fh
0645                          ENDIF      
0645                          IF   CPM   
0645   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
0648   11 08 00               LD   DE,0008h   
064B   01 2C 00               LD   BC,vecend-vecs   
064E   ED B0                  LDIR      
0650   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
0653   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
0655   CD 05 00               CALL   BDOS   ;   and the program is empty)
0658   11 00 0A               LD   DE,PROG   
065B   D5           LD1:      PUSH   DE   
065C   0E 1A                  LD   C,26   ; set the DMA address
065E   CD 05 00               CALL   BDOS   
0661   11 5C 00               LD   DE,005Ch   
0664   0E 14                  LD   C,20   ; read the next 128 bytes
0666   CD 05 00               CALL   BDOS   
0669   E1                     POP   HL   ; HL = the address this record went to
066A   B7                     OR   A   
066B   20 07                  JR   NZ,ld2   
066D   11 80 00               LD   DE,128   
0670   19                     ADD   HL,DE   
0671   EB                     EX   DE,HL   
0672   18 E7                  JR   ld1   
0674                LD2:         
0674                          ENDIF      
0674                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0674                          ENDIF      
0674                          IF   CPM*EDITOR   
0674                             ; The editor wants the text to end where the file's text ends: at
0674                             ; the first ^Z (1Ah), which pads a text file's last record. One more
0674                             ; goes after the last record, so the search always stops. And every
0674                             ; line must end in LF: a last line without one is given a CR LF.
0674   36 1A                  LD   (HL),1Ah   
0676   21 FF 09               LD   HL,PROG-1   
0679   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
067B   23           TR1:      INC   HL   
067C   5F                     LD   E,A   ; E = the character before this one
067D   7E                     LD   A,(HL)   
067E   FE 1A                  CP   1Ah   
0680   20 F9                  JR   NZ,tr1   
0682   7B                     LD   A,E   
0683   FE 0A                  CP   10   
0685   28 06                  JR   Z,tr2   
0687   36 0D                  LD   (HL),13   
0689   23                     INC   HL   
068A   36 0A                  LD   (HL),10   
068C   23                     INC   HL   
068D   36 00        TR2:      LD   (HL),0   
068F   C3 AE 05               JP   edit   
0692                          ENDIF      
0692                          IF   CPM   
0692                             ; RAM pages, after the image
0692                RSPAGE:   EQU   (imgend + 255) / 256   
0692                DSPAGE:   EQU   RSPAGE + 1   
0692                LETPAGE:   EQU   RSPAGE + 2   
0692                PROG:     EQU   LETPAGE*256 + 256   
0692                          ENDIF      
0692                IMGEND:      


