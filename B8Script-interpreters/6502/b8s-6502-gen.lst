E2FF   60                     RTS      
E300   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E303   A5 02                  LDA   TL   
E305   9D 00 02               STA   DSL,X   
E308   84 02                  STY   TL   
E30A   BC 00 03               LDY   DSH,X   
E30D   A5 03                  LDA   TH   
E30F   9D 00 03               STA   DSH,X   
E312   84 03                  STY   TH   
E314   60                     RTS      
E315                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E315                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E315                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E315                             ; it stops with Z.
E315                H_DIV:       
E315                          IF   CHECKED   
                              LDA   TL   
                              ORA   TH   
                              BEQ   e_zero   
E315                          ENDIF      
E315   BD 00 03               LDA   DSH,X   
E318   48                     PHA      ; a's sign: for r
E319   45 03                  EOR   TH   
E31B   48                     PHA      ; a xor b: for q
E31C   20 A1 E2               JSR   absv   
E31F   A5 02                  LDA   TL   
E321   85 08                  STA   D0   
E323   A5 03                  LDA   TH   
E325   85 09                  STA   D1   ; D = |b|
E327   BD 00 02               LDA   DSL,X   
E32A   85 02                  STA   TL   
E32C   BD 00 03               LDA   DSH,X   
E32F   85 03                  STA   TH   
E331   20 A1 E2               JSR   absv   ; TOS = |a|
E334   20 59 E3               JSR   udiv   ; TOS = q, NOS = r
E337   68                     PLA      
E338   20 A3 E2               JSR   negm   ; q's sign
E33B   20 00 E3               JSR   h_swap   ; r on top
E33E   68                     PLA      
E33F   4C A3 E2               JMP   negm   ; r's sign
E342                             ; =============================================================================
E342                             ;  Storage
E342                             ; =============================================================================
E342                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E342                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E342                          IF   1-CHECKED   
E342   AD 7C 04     H_ALLOC:   LDA   HEAP   
E345   A8                     TAY      
E346   65 02                  ADC   TL   
E348   8D 7C 04               STA   HEAP   
E34B   84 02                  STY   TL   
E34D   AD 7D 04               LDA   HEAP+1   
E350   A8                     TAY      
E351   65 03                  ADC   TH   
E353   8D 7D 04               STA   HEAP+1   
E356   84 03                  STY   TH   
E358   60                     RTS      
E359                          ENDIF      
E359                             ; The checked build works the new top out first, in T0 and Y, and stops with
E359                             ; H, the count still on the stack, if it is at or past the limit, below the
E359                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E359                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E359                             ; a signed number from -8000h, so the add overflows exactly when the true
E359                             ; sum leaves 0000h-FFFFh.
E359                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   TL   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   TH   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   TL   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   TH   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_ZERO:   LDA   #"Z"   ; divide by zero
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the page in A is in the program's own space, from the
                                 ; letter page up to the heap limit. Keeps Y.
                    CHKST:    CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              RTS      
E359                          ENDIF      
E359                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E359                             ; cell the remainder (whatever was there is lost).
E359                             ; Dividing by 2 is one shift (the spec wants that fast).
E359   A9 00        UDIV:     LDA   #0   
E35B   9D 00 02               STA   DSL,X   
E35E   9D 00 03               STA   DSH,X   
E361   A5 08                  LDA   D0   
E363   49 02                  EOR   #2   
E365   05 09                  ORA   D1   
E367   D0 08                  BNE   ud0   
E369   46 03                  LSR   TH   
E36B   66 02                  ROR   TL   ; the quotient
E36D   3E 00 02               ROL   DSL,X   ; the remainder: the bit that fell out
E370   60                     RTS      
E371   A0 10        UD0:      LDY   #16   
E373   06 02        UD1:      ASL   TL   
E375   26 03                  ROL   TH   
E377   3E 00 02               ROL   DSL,X   
E37A   3E 00 03               ROL   DSH,X   
E37D   38                     SEC      
E37E   BD 00 02               LDA   DSL,X   
E381   E5 08                  SBC   D0   
E383   85 04                  STA   T0   
E385   BD 00 03               LDA   DSH,X   
E388   E5 09                  SBC   D1   
E38A   90 0A                  BCC   ud2   
E38C   9D 00 03               STA   DSH,X   
E38F   A5 04                  LDA   T0   
E391   9D 00 02               STA   DSL,X   
E394   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E396   88           UD2:      DEY      
E397   D0 DA                  BNE   ud1   
E399   60           UD9:      RTS      
E39A                             ; =============================================================================
E39A                             ;  Console
E39A                             ; =============================================================================
E39A                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E39A   A0 00        TOSGET:   LDY   #0   
E39C   B1 02                  LDA   (TL),Y   
E39E   E6 02        INCTOS:   INC   TL   
E3A0   D0 02                  BNE   tg1   
E3A2   E6 03                  INC   TH   
E3A4   60           TG1:      RTS      
E3A5                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E3A5                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E3A5                             ; bit 6, so // and /" give themselves).
E3A5                             ; The checked build walks a copy of TOS along the string, so that the address
E3A5                             ; is still there if it stops with Q on a NUL.
E3A5                H_PRINT:      
E3A5                          IF   CHECKED   
                              JSR   push   ; the copy
                              JSR   pr0   
                              BNE   pdrop   ; always (drop leaves Z clear): the address
                    PR0:         
E3A5                          ENDIF      
E3A5   20 9A E3               JSR   tosget   
E3A8   C9 22                  CMP   #22h   
E3AA   F0 14                  BEQ   pdrop   
E3AC                          IF   CHECKED   
                              TAY      ; (Y is free here)
                              BEQ   e_qpr   
E3AC                          ENDIF      
E3AC   C9 2F                  CMP   #"/"   
E3AE   D0 05                  BNE   pr1   
E3B0   20 9A E3               JSR   tosget   
E3B3   29 BF                  AND   #0BFh   
E3B5   20 03 FF     PR1:      JSR   CONOUT   
E3B8                          IF   1-CHECKED   
E3B8   4C A5 E3               JMP   h_print   
E3BB                          ENDIF      
E3BB                          IF   CHECKED   
                              JMP   pr0   
                    E_QPR:    JSR   drop   ; the copy goes: the address is TOS again
                              JMP   e_quote   ; $ ran into the end
E3BB                          ENDIF      
E3BB   A5 02        H_EMIT:   LDA   TL   ; "'"
E3BD   20 03 FF               JSR   CONOUT   
E3C0   4C 49 E2     PDROP:    JMP   drop   
E3C3                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E3C3                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E3C3                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E3C3   A5 03        H_NUM:    LDA   TH   
E3C5   10 08                  BPL   pn1   
E3C7   A9 2D                  LDA   #"-"   
E3C9   20 03 FF               JSR   CONOUT   
E3CC   20 A5 E2               JSR   neg   
E3CF   CA           PN1:      DEX      ; the spare cell
E3D0   A9 0A                  LDA   #10   
E3D2   85 08                  STA   D0   
E3D4   A9 00                  LDA   #0   
E3D6   85 09                  STA   D1   
E3D8   48                     PHA      ; the end marker
E3D9   20 59 E3     PN2:      JSR   udiv   
E3DC   BD 00 02               LDA   DSL,X   
E3DF   09 30                  ORA   #"0"   
E3E1   48                     PHA      
E3E2   A5 02                  LDA   TL   
E3E4   05 03                  ORA   TH   
E3E6   D0 F1                  BNE   pn2   
E3E8   E8                     INX      
E3E9   68           PN3:      PLA      
E3EA   F0 D4                  BEQ   pdrop   
E3EC   20 03 FF               JSR   CONOUT   
E3EF   4C E9 E3               JMP   pn3   
E3F2   A0 01        H_FETCH:   LDY   #1   ; "@"
E3F4   B1 02                  LDA   (TL),Y   
E3F6   48                     PHA      ; the high byte, while "," gets the low one
E3F7   20 FE E3               JSR   h_cfetch   
E3FA   68                     PLA      
E3FB   85 03                  STA   TH   
E3FD   60                     RTS      
E3FE                H_CFETCH:      ; ","
E3FE   A0 00                  LDY   #0   
E400   B1 02                  LDA   (TL),Y   
E402   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E404   84 03                  STY   TH   
E406   60                     RTS      
E407                             ; "?" ( n -- c ) or ( -n -- addr )
E407                             ;   n > 0: wait about n ms for a key; 0 if none came
E407                             ;   n = 0: wait for a key
E407                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E407                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E407   A5 03        H_KEY:    LDA   TH   
E409   30 20                  BMI   line   
E40B   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E40D   20 77 E0     KT2:      JSR   getk   
E410   D0 15                  BNE   kt3   
E412   88                     DEY      
E413   D0 F8                  BNE   kt2   
E415   A5 02                  LDA   TL   ; count the millisecond off:
E417   D0 06                  BNE   kt4   
E419   A5 03                  LDA   TH   
E41B   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E41D   C6 03                  DEC   TH   
E41F   C6 02        KT4:      DEC   TL   
E421   D0 E8                  BNE   kt1   
E423   A5 03                  LDA   TH   
E425   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E427   A0 00        KT3:      LDY   #0   
E429   F0 D7                  BEQ   cf2   ; always: TOS = A
E42B                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E42B                             ; (stored, not echoed), every other key is stored and echoed until the line
E42B                             ; is full. Y = the length so far; TL = the most allowed.
E42B   20 A5 E2     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E42E   D0 04                  BNE   ln0   
E430   A5 02                  LDA   TL   
E432   10 04                  BPL   ln1   
E434   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E436   85 02                  STA   TL   
E438   A0 00        LN1:      LDY   #0   
E43A   F0 03                  BEQ   ln2   ; always
E43C   20 03 FF     LN3:      JSR   CONOUT   
E43F   20 77 E0     LN2:      JSR   getk   
E442   F0 FB                  BEQ   ln2   
E444   C9 0D                  CMP   #13   
E446   F0 14                  BEQ   ln5   
E448   C9 08                  CMP   #8   
E44A   F0 0A                  BEQ   ln4   
E44C   C4 02                  CPY   TL   
E44E   B0 EF                  BCS   ln2   ; full
E450   99 80 04               STA   LINEBUF,Y   
E453   C8                     INY      
E454   D0 E6                  BNE   ln3   ; always: echo it
E456   88           LN4:      DEY      ; Backspace: one back, and echo it,
E457   10 E3                  BPL   ln3   
E459   C8                     INY      ;   unless the line was empty
E45A   F0 E3                  BEQ   ln2   ; always
E45C   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E45F   A9 80                  LDA   #<LINEBUF   
E461   85 02                  STA   TL   
E463   A9 04                  LDA   #>LINEBUF   
E465   85 03                  STA   TH   
E467   60                     RTS      
E468                             ; =============================================================================
E468                             ;  Machine code: the grave
E468                             ; =============================================================================
E468                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E468                             ; are stored from addr until a non-hex character; then a RET (60h) is
E468                             ; written and its address is left. An odd last digit is consumed and dropped.
E468                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E468                             ; contract in the header.
E468   20 05 E2     H_GRAVE:   JSR   rdhex   
E46B   B0 1C                  BCS   exec   
E46D   0A           HX1:      ASL      
E46E   0A                     ASL      
E46F   0A                     ASL      
E470   0A                     ASL      
E471   85 04                  STA   T0   
E473   20 05 E2               JSR   rdhex   
E476   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E478   05 04                  ORA   T0   
E47A   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
E47C   20 9E E3               JSR   inctos   
E47F   20 05 E2               JSR   rdhex   
E482   90 E9                  BCC   hx1   
E484   A9 60        HX2:      LDA   #60h   
E486   91 02                  STA   (TL),Y   
E488   60                     RTS      
E489   A5 02        EXEC:     LDA   TL   
E48B   85 04                  STA   T0   
E48D   A5 03                  LDA   TH   
E48F   85 05                  STA   T1   
E491   20 49 E2               JSR   drop   ; the address is consumed
E494   6C 04 00               JMP   (T0)   
E497                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
                                 ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   Rtn n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was.
                    ERROR:    PHA      ; the letter
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   D0   
                              LDY   D1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   CL   
                              LDY   CL+1   
                              JSR   prnum   ; the column
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              LDY   #0   ; the text at the place
                    ER1:      LDA   (PLACE),Y   
                              BEQ   er2   
                              CMP   #13   
                              BEQ   er2   
                              CMP   #10   
                              BEQ   er2   
                              JSR   CONOUT   
                              INY      
                              CPY   #16   
                              BNE   er1   
                    ER2:      LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "Stk "
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T1   ; T1 = how many cells to show
                              JSR   prs   
                              JSR   push   ; TOS into memory with the rest: cell i from
                                 ;   the top is at DSL+X+i now
                    ER4:      LDA   T1   ; cells T1-1 down to 0, the top last
                              BEQ   er5   
                              DEC   T1   
                              LDA   #" "   
                              JSR   CONOUT   
                              TXA      
                              CLC      
                              ADC   T1   
                              TAY      
                              LDA   DSL,Y   
                              PHA      
                              LDA   DSH,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "Rtn "
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"Stk"," "+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"Rtn"," "+80h   
                                 ; lcol: the line (D0/D1) and the column (CL) of the place, both from 1. A
                                 ; place below the program is in the -n? line buffer: line 0, and the column
                                 ; is the place in the buffer. Otherwise IP (free now: the program has
                                 ; stopped) runs from PROG to the place, counting LFs; CL keeps where the
                                 ; last line started, and the column is the place minus that, plus 1.
                    LCOL:     LDA   #0   
                              STA   D1   
                              STA   D0   
                              LDA   #<LINEBUF   
                              STA   CL   
                              LDA   #>LINEBUF   
                              STA   CL+1   
                              LDA   PLACE   
                              CMP   #<PROG   
                              LDA   PLACE+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   D0   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   CL   
                              LDA   IP+1   
                              STA   CL+1   
                    LC1:      LDA   IP   
                              CMP   PLACE   
                              LDA   IP+1   
                              SBC   PLACE+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              INC   D0   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   D1   
                              BNE   lc3   ; always
                    LC9:      LDA   PLACE   
                              SEC      
                              SBC   CL   
                              STA   CL   
                              LDA   PLACE+1   
                              SBC   CL+1   
                              STA   CL+1   
                              INC   CL   ; + 1
                              BNE   lc8   
                              INC   CL+1   
                    LC8:      RTS      
E497                          ENDIF      


