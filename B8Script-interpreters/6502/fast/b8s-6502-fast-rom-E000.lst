E90C                          ENDIF      
E90C                          IF   QK*(1-FAST)   
                                 ; (QK: with an operand below 256, 8 rounds, not 16: that one becomes the
                                 ; multiplier, so the product's low byte comes out of TL and its high byte is
                                 ; left in T0. Most multiplications have one: a count or a small constant.)
                    H_MUL:    LDA   TH   
                              BEQ   mq8   ; the multiplier is below 256
                              LDA   DSH,X   
                              BNE   mq16   
                              JSR   h_swap   ; the multiplicand is: it becomes the multiplier
                    MQ8:      LDY   #8   
                              LDA   #0   
                              STA   T0   
                              LSR   TL   
                    MQ1:      BCC   mq2   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              LDA   T1   
                              ADC   DSH,X   
                    MQ2:      ROR      
                              ROR   T0   
                              ROR   TL   
                              DEY      
                              BNE   mq1   
                              LDA   T0   
                              STA   TH   
                              INX      
                              RTS      
                    MQ16:        
E90C                          ENDIF      
E90C                          IF   1-QK   
                    H_MUL:       
E90C                          ENDIF      
E90C                          IF   1-FAST   
                              LDY   #16   ; the round count
                              LDA   #0   
                              STA   T0   ; A:T0 = the upper half
                              LSR   TH   
                              ROR   TL   ; the first multiplier bit
                    ML1:      BCC   ml2   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              LDA   T1   
                              ADC   DSH,X   ; upper half += the multiplicand
                    ML2:      ROR      
                              ROR   T0   
                              ROR   TH   
                              ROR   TL   ; everything one place right; next bit out
                              DEY      
                              BNE   ml1   
                              INX      ; drop the multiplicand
                              RTS      
E90C                          ENDIF      
E90C   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E90F   A5 02                  LDA   TL   
E911   9D 00 02               STA   DSL,X   
E914   84 02                  STY   TL   
E916   BC 00 03               LDY   DSH,X   
E919   A5 03                  LDA   TH   
E91B   9D 00 03               STA   DSH,X   
E91E   84 03                  STY   TH   
E920   60                     RTS      
E921                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E921                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b, r is pushed
E921                             ; and gets the sign of a. Unchecked, dividing by zero returns two cells of no
E921                             ; meaning; checked, it stops with Z.
E921                H_DIV:       
E921                          IF   CHECKED   
E921   A5 02                  LDA   TL   
E923   05 03                  ORA   TH   
E925   F0 5F                  BEQ   e_zero   
E927                          ENDIF      
E927   BD 00 03               LDA   DSH,X   
E92A   48                     PHA      ; a's sign: for r
E92B   45 03                  EOR   TH   
E92D   48                     PHA      ; a xor b: for q
E92E   20 B0 E6               JSR   absv   
E931   A5 02                  LDA   TL   
E933   85 08                  STA   D0   
E935   A5 03                  LDA   TH   
E937   85 09                  STA   D1   ; D = |b|
E939   20 58 E6               JSR   drop   ; TOS = a
E93C   20 B0 E6               JSR   absv   ; TOS = |a|
E93F   20 9A E9               JSR   udiv   ; TOS = q, T0/T1 = r
E942   68                     PLA      
E943   20 B2 E6               JSR   negm   ; q's sign
E946   A5 04                  LDA   T0   
E948   A4 05                  LDY   T1   
E94A   20 5F E3               JSR   pushay   ; r on top
E94D   68                     PLA      
E94E   4C B2 E6               JMP   negm   ; r's sign
E951                             ; =============================================================================
E951                             ;  Storage
E951                             ; =============================================================================
E951                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E951                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E951                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   TL   
                              STA   HEAP   
                              STY   TL   
                              LDA   HEAP+1   
                              TAY      
                              ADC   TH   
                              STA   HEAP+1   
                              STY   TH   
                              RTS      
E951                          ENDIF      
E951                             ; The checked build works the new top out first, in T0 and Y, and stops with
E951                             ; H, the count still on the stack, if it is at or past the limit, below the
E951                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E951                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E951                             ; a signed number from -8000h, so the add overflows exactly when the true
E951                             ; sum leaves 0000h-FFFFh.
E951                          IF   CHECKED   
E951   AD 7C 04     H_ALLOC:   LDA   HEAP   
E954   65 02                  ADC   TL   
E956   85 04                  STA   T0   
E958   AD 7D 04               LDA   HEAP+1   
E95B   49 80                  EOR   #80h   
E95D   65 03                  ADC   TH   
E95F   70 28                  BVS   e_heap   ; wrapped
E961   49 80                  EOR   #80h   ; the new top's high byte
E963   C9 DF                  CMP   #HEAPLIM   
E965   B0 22                  BCS   e_heap   ; at or past the limit
E967   A8                     TAY      
E968   A5 04                  LDA   T0   
E96A   CD 38 04               CMP   PEND   
E96D   98                     TYA      
E96E   ED 39 04               SBC   PEND+1   
E971   90 16                  BCC   e_heap   ; below the program's end
E973   AD 7C 04               LDA   HEAP   
E976   85 02                  STA   TL   
E978   A5 04                  LDA   T0   
E97A   8D 7C 04               STA   HEAP   
E97D   AD 7D 04               LDA   HEAP+1   
E980   85 03                  STA   TH   
E982   8C 7D 04               STY   HEAP+1   
E985   60                     RTS      
E986                             ; Errors found by handlers. The stacks are as they were before the handler.
E986   A9 5A        E_ZERO:   LDA   #"Z"   ; divide by zero
E988   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E989   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E98B   2C                     DB   2Ch   
E98C   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E98E   4C 24 EC               JMP   error   
E991                             ; chkst: stop unless the page in A is in the program's own space, from the
E991                             ; letter page up to the heap limit. Keeps Y.
E991   C9 04        CHKST:    CMP   #LETPAGE   
E993   90 F7                  BCC   e_store   
E995   C9 DF                  CMP   #HEAPLIM   
E997   B0 F3                  BCS   e_store   
E999   60                     RTS      
E99A                          ENDIF      
E99A                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and T0/T1
E99A                             ; the remainder. The low byte of each trial subtraction waits on the
E99A                             ; hardware stack.
E99A                             ; Dividing by 2 is one shift (the spec wants that fast).
E99A   A9 00        UDIV:     LDA   #0   
E99C   85 04                  STA   T0   
E99E   85 05                  STA   T1   
E9A0                          IF   1-QK   
                              LDA   D0   
                              EOR   #2   
                              ORA   D1   
                              BNE   ud0   
                              LSR   TH   
                              ROR   TL   ; the quotient
                              ROL   T0   ; the remainder: the bit that fell out
                              RTS      
E9A0                          ENDIF      
E9A0                          IF   QK   
E9A0                             ; (QK: any power of two is shifts: 2, and 32, 64, 256 and the like, which
E9A0                             ; fixed point and byte work use all the time.)
E9A0   A4 08                  LDY   D0   
E9A2   A5 09                  LDA   D1   
E9A4   D0 12                  BNE   uq1   ; 256 and up
E9A6   98                     TYA      
E9A7   F0 38                  BEQ   ud0   ; by 0: the long way (it means nothing anyway)
E9A9   88                     DEY      
E9AA   98                     TYA      
E9AB   25 08                  AND   D0   
E9AD   D0 32                  BNE   ud0   ; not a power of two
E9AF   98                     TYA      ; by 2^k below 256: r = a & (2^k - 1),
E9B0   25 02                  AND   TL   
E9B2   85 04                  STA   T0   
E9B4   A5 08                  LDA   D0   ;   and q = a >> k
E9B6   D0 1E                  BNE   uq2   ; always
E9B8   98           UQ1:      TYA      
E9B9   D0 26                  BNE   ud0   ; not a power of two
E9BB   A4 09                  LDY   D1   
E9BD   88                     DEY      
E9BE   98                     TYA      
E9BF   25 09                  AND   D1   
E9C1   D0 1E                  BNE   ud0   ; not a power of two
E9C3   98                     TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
E9C4   25 03                  AND   TH   
E9C6   85 05                  STA   T1   
E9C8   A5 02                  LDA   TL   
E9CA   85 04                  STA   T0   
E9CC   A5 03                  LDA   TH   ;   and q = (a >> 8) >> (k - 8)
E9CE   85 02                  STA   TL   
E9D0   A9 00                  LDA   #0   
E9D2   85 03                  STA   TH   
E9D4   A5 09                  LDA   D1   
E9D6   4A           UQ2:      LSR      ; a bit of 2^k: one shift for each 0 below
E9D7   B0 07                  BCS   uq9   ;   the 1
E9D9   46 03        UQ3:      LSR   TH   
E9DB   66 02                  ROR   TL   
E9DD   4A                     LSR      
E9DE   90 F9                  BCC   uq3   
E9E0   60           UQ9:      RTS      
E9E1                          ENDIF      
E9E1                          IF   FAST   
E9E1                UD0:         ; (the fast build: the 16 rounds unrolled)
E9E1   06 02                  ASL   TL   
E9E3   26 03                  ROL   TH   
E9E5   26 04                  ROL   T0   
