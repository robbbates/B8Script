0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Required Notice: Copyright 2026 Robb Bates (https://github.com/robbbates)
0000                             ;  Licence: PolyForm Noncommercial License 1.0.0 (LICENSE.md at the top of
0000                             ;  the repository, or https://polyformproject.org/licenses/noncommercial/1.0.0)
0000                             ;  Spec: docs/b8script.md (2026-11-24). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page ($00-$09). b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's three-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   D:2: 5 0
0000                             ;                   R:0
0000                             ;                 and then goes to EXIT.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build").
0000                             ;  The base and fast builds use one more RAM page, for the skip cache: the page
0000                             ;  at the heap limit, which is DF00h in them (E000h in the others).
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   2   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ;  The fast build (SPEED = 2) dispatches through a full table instead: see
0000                             ;  "The fast build" at the end.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                SKL:      EQU   T1   ; (QK) 05 and 08: where a skip started, for
0000                SKH:      EQU   D0   ;   the skip cache
0000                V:        EQU   T0   ; (FAST) 04-05 the dispatcher's jump vector
0000                          IF   1-CHECKED   
                    KEYBUF:   EQU   07h   ; a key held back by the break check (0: none)
0000                          ENDIF      
0000                          IF   CHECKED   
0000                PLACE:    EQU   06h   ; 06-07 (T2 and $07) the address of the
0000                             ;   character being run, for the error report:
0000                             ;   no handler of the checked build uses T2.
0000                             ;   (Machine code may change T2: that matters
0000                             ;   only if it also leaves a stack overrun,
0000                             ;   whose report then shows a wrong place.)
0000                RSV:      EQU   LET+35h   ; S as it was before this character
0000                KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
0000                             ; The error report runs after the program, so it may use the zero page that
0000                             ; machine code has ($0A-$0F):
0000                CL:       EQU   0Ah   ; 0A-0B where the reported line starts
0000                          ENDIF      
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PEND at +38, KEYBUF (the held
0000                             ;               key; $07 in the unchecked build) at +7A; and every build's:
0000                             ;               CDOWN at +79, BRKOFF (the break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    DF00       CPAGE (QK builds only): the skip cache, at the heap limit
0000                             ;    E000       the interpreter (ROM). In the fast build its first two
0000                             ;               pages are the dispatch table, and start is at E200
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these. All four must keep X;
0000                             ; they may change A, Y and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if the carry is set,
0000                             ;     hide it if the carry is clear
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row A, column Y, both
0000                             ;     counted from 0
0000                          ENDIF      
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h-QK   ; the heap must stay below E000h (a page);
0000                             ;   below DF00h in the QK builds, where
0000                CPAGE:    EQU   HEAPLIM   ;   DF00h is the skip cache's page: the page
0000                             ;   at the heap limit, which the heap never reaches
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                CDOWN:    EQU   LET+79h   ; the break check's countdown (see pnext)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
0000                             ; The fast build's dispatcher (SPEED = 2; see "The fast build"), inline at
0000                             ; the end of its own entries. NEXTF reads the next character and jumps
0000                             ; through the table:
0000                             ;     LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
0000                             ;     LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
0000                             ; NEXTA is the same from INC IP on: the character is already in A, and IP is
0000                             ; still at it (it skips the LDY and the LDA); NEXTY is the same with the
0000                             ; character in Y (it skips the TAY too). In the checked build all three are
0000                             ; JMP fnext, which checks the stacks first. (The bytes are written out with
0000                             ; DS, because asm80 does not nest an IF in a macro inside another IF; and
0000                             ; DS takes the addresses as these equates.)
0000                          IF   FAST   
0000                ADTL:     EQU   DTL   
0000                ADTH:     EQU   DTH   
0000                AFNX:     EQU   fnext   
0000                          ENDIF      
0000                          IF   1-FAST   
                    ADTL:     EQU   0   
                    ADTH:     EQU   0   
                    AFNX:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      1-CHECKED,0A0h  ; LDY #0
0000                 DS      1-CHECKED,0
0000                 DS      1-CHECKED,0B1h  ; LDA (IP),Y
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTA,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTY,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                FTAB:     EQU   0E000h   ; (FAST: the fast build's table, two pages,
E200                          .ORG   FTAB+FAST*512   ;   comes first, and the code after it)
E200                             ; =============================================================================
E200                             ;  Startup: find the NUL, the heap starts after it
E200                             ; =============================================================================
E200   A2 FF        START:    LDX   #0FFh   
E202   9A                     TXS      ; return stack empty
E203                          IF   CHECKED   
E203                             ; The first half of the letter page is zeroed: every variable, every
E203                             ; cell of the interpreter's own (no key held back), and every word
E203                             ; cell, which then points at 0000h: calling an undefined word stops
E203                             ; with U (see e_undef).
E203   E8                     INX      
E204   8A                     TXA      ; A = 0
E205   A0 7F                  LDY   #7Fh   
E207   99 00 04     STZ:      STA   LET,Y   
E20A   88                     DEY      
E20B   10 FA                  BPL   stz   
E20D                          ENDIF      
E20D                          IF   QK   
E20D   A9 00                  LDA   #0   ; an empty skip cache (a start of 0000h
E20F   A8                     TAY      ;   matches no skip)
E210   99 00 DF     SKC:      STA   CPAGE*256,Y   
E213   C8                     INY      
E214   D0 FA                  BNE   skc   
E216                          ENDIF      
E216   20 27 E6               JSR   rstip   
E219   20 1B E6     ST1:      JSR   getc   
E21C   D0 FB                  BNE   st1   ; IP ends just past the NUL
E21E                          IF   1-CHECKED   
                              STA   KEYBUF   ; (A = 0) no key held, the break key on
                              STA   BRKOFF   
E21E                          ENDIF      
E21E   A5 00                  LDA   IP   
E220   8D 7C 04               STA   HEAP   
E223                          IF   CHECKED   
E223   8D 38 04               STA   PEND   
E226                          ENDIF      
E226   A5 01                  LDA   IP+1   
E228   8D 7D 04               STA   HEAP+1   
E22B                          IF   CHECKED   
E22B   8D 39 04               STA   PEND+1   
E22E                          ENDIF      
E22E   20 27 E6               JSR   rstip   
E231   A2 FC                  LDX   #DSE   
E233                             ; =============================================================================
E233                             ;  The inner loop
E233                             ; =============================================================================
E233                             ; -----------------------------------------------------------------------------
E233                             ;  The break key. A running program reads the keyboard only through getk
E233                             ;  (for "?") and pnext (the break check), which between them give the break
E233                             ;  key its rules:
E233                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E233                             ;      build, with the report (B) in the checked one;
E233                             ;    - any other key that the break check reads is held in KEYBUF for the
E233                             ;      next "?", and a newer one takes its place;
E233                             ;    - "?" (getk) takes the held key first;
E233                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E233                             ;      key like any other, but two of them within about 250 ms still stop it.
E233                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E233                             ; -----------------------------------------------------------------------------
E233                             ; pnext: the break check, then (falling through) next. A word call, a true
E233                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E233                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E233                             ; falls in here too, which does no harm.)
E233   CE 79 04     PNEXT:    DEC   CDOWN   
E236   D0 0B                  BNE   next   
E238   20 06 FF     PKEY:     JSR   KEY   
E23B   F0 06                  BEQ   next   ; no key
E23D   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E240   20 BF E2               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E243                NEXT:        
E243                          IF   FAST   
E243   4C E8 EC               JMP   fnext   ; (the fast build: see "The fast build")
E246                          ENDIF      
E246                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE: an
                                 ; underflow moves X up to FDh or FEh (no handler moves X by more
                                 ; than 2, but "$", whose /~ escapes each look first), and an
                                 ; overflow wraps it from 00h to FFh.
                                 ; S is kept in RSV, for the report's R: line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_stack   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E246                          ENDIF      
E246                          IF   1-FAST   
                              JSR   step   
                              JMP   next   
E246                          ENDIF      
E246                          IF   CHECKED   
E246                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E246                             ; empty.
E246   AD 35 04     E_RSTACK:   LDA   RSV   
E249   C9 10                  CMP   #10h   
E24B   A9 52                  LDA   #"R"   
E24D   B0 13                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E24F   A9 FF                  LDA   #0FFh   
E251   8D 35 04               STA   RSV   ; S wrapped to 01h: R:0
E254   A9 72                  LDA   #"r"   
E256   D0 0A                  BNE   ejmp   ; always
E258   E0 FF        E_STACK:   CPX   #0FFh   
E25A   A9 53                  LDA   #"S"   
E25C   B0 04                  BCS   ejmp   ; X wrapped from 00h to FFh: an overflow
E25E   A2 FC                  LDX   #DSE   ; an underflow: D:0
E260   A9 73                  LDA   #"s"   
E262   4C 24 EC     EJMP:     JMP   error   
E265                          ENDIF      
E265                             ; The handlers that work on the return stack sit here, where short branches
E265                             ; reach next and pnext.
E265                             ; "{" TOS to the return stack, "}" return stack to TOS
E265   68           H_TOR:    PLA      
E266   68                     PLA      
E267   A5 03                  LDA   TH   
E269   48                     PHA      
E26A   A5 02                  LDA   TL   
E26C   48                     PHA      
E26D   20 58 E6               JSR   drop   
E270   D0 D1                  BNE   next   ; always
E272   68           H_FROMR:   PLA      
E273   68                     PLA      
E274   20 69 E3               JSR   push   
E277   68                     PLA      
E278   85 02                  STA   TL   
E27A   68                     PLA      
E27B   85 03                  STA   TH   
E27D   90 C4                  BCC   next   ; always: the carry is clear on the way in
E27F                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E27F                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E27F                             ; it is here, the address popped is pushed back.
E27F   20 30 E6     H_CLOSE:   JSR   flag   
E282   F0 22                  BEQ   rdrop   
E284                          IF   1-QK   
                              DB   24h   ; (BIT zp: steps over the SEC)
E284                          ENDIF      
E284                          IF   QK   
E284   4C 75 E3               JMP   closeq   ; (QK: see Speed-ups)
E287                          ENDIF      
E287                             ; "]" returns: pull an address and jump to it.
E287   38           H_RET:    SEC      
E288   68                     PLA      
E289   68                     PLA      ; drop the step frame
E28A   68                     PLA      
E28B   85 00                  STA   IP   
E28D   68                     PLA      
E28E   85 01                  STA   IP+1   
E290   B0 B1                  BCS   next   
E292   48                     PHA      ; ")": keep the block start
E293   A5 00                  LDA   IP   
E295   48                     PHA      
E296   90 9B                  BCC   pnext   ; always: a loop-back, with the break check
E298                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E298                             ; drops the block start, "]" returns.
E298   20 30 E6     H_BREAK:   JSR   flag   
E29B   F0 26                  BEQ   gk9   ; (an RTS)
E29D                          IF   CHECKED   
E29D   A9 00                  LDA   #0   ; \ takes either closer
E29F                          ENDIF      
E29F   20 DD E3               JSR   skip   
E2A2   C9 29                  CMP   #")"   
E2A4   D0 E1                  BNE   h_ret   
E2A6   68           RDROP:    PLA      
E2A7   68                     PLA      
E2A8   68                     PLA      
E2A9   68                     PLA      ; (the block start's high byte: never 0)
E2AA                          IF   1-QK   
                              BNE   next   ; always
E2AA                          ENDIF      
E2AA                          IF   QK   
E2AA   4C 43 E2               JMP   next   ; (closeq moved next out of reach)
E2AD                          ENDIF      
E2AD                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E2AD                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E2AD                             ; taken out of KEYBUF.
E2AD   AD 7A 04     GETK:     LDA   KEYBUF   
E2B0   F0 08                  BEQ   gk1   
E2B2   48                     PHA      
E2B3   A9 00                  LDA   #0   
E2B5   8D 7A 04               STA   KEYBUF   
E2B8   68                     PLA      
E2B9   60                     RTS      
E2BA   20 06 FF     GK1:      JSR   KEY   
E2BD   F0 04                  BEQ   gk9   
E2BF                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E2BF                             ; back if it comes back at all.
E2BF   C9 03        CHK3:     CMP   #3   
E2C1   F0 01                  BEQ   ctlc   
E2C3   60           GK9:      RTS      
E2C4                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E2C4                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E2C4                             ; looks: D0 counts the 256s, D1 runs on from whatever it holds) for one more
E2C4                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E2C4                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E2C4   AD 7B 04     CTLC:     LDA   BRKOFF   
E2C7   F0 1D                  BEQ   cbreak   
E2C9   A9 28                  LDA   #CWAIT+1   
E2CB   85 08                  STA   D0   
E2CD   20 06 FF     CT2:      JSR   KEY   
E2D0   D0 0A                  BNE   ct3   
E2D2   C6 09                  DEC   D1   
E2D4   D0 F7                  BNE   ct2   
E2D6   C6 08                  DEC   D0   
E2D8   D0 F3                  BNE   ct2   
E2DA   F0 07                  BEQ   ct9   ; always: none came
E2DC   C9 03        CT3:      CMP   #3   
E2DE   F0 06                  BEQ   cbreak   
E2E0   8D 7A 04               STA   KEYBUF   
E2E3   A9 03        CT9:      LDA   #3   
E2E5   60                     RTS      
E2E6                          IF   1-CHECKED   
                    CBREAK:   EQU   endprog   ; the unchecked build stops without a word
E2E6                          ENDIF      
E2E6                          IF   CHECKED   
E2E6                CBREAK:   EQU   e_break   ; the checked build reports B
E2E6                          ENDIF      
E2E6                          IF   CHECKED   
E2E6   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E2E8   2C                     DB   2Ch   
E2E9   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E2EB   4C 24 EC     EJMP3:    JMP   error   
E2EE                          ENDIF      
E2EE                          IF   CHECKED   
E2EE                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E2EE                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E2EE                             ; the call reads a NUL with IP in page zero, where no program can be. The
E2EE                             ; call is undone first: the step frame and the return address come off the
E2EE                             ; hardware stack, and the place is the call letter (the return address - 1).
E2EE   68           E_UNDEF:   PLA      
E2EF   68                     PLA      ; the step frame
E2F0   68                     PLA      
E2F1   38                     SEC      
E2F2   E9 01                  SBC   #1   
E2F4   85 06                  STA   PLACE   
E2F6   68                     PLA      
E2F7   E9 00                  SBC   #0   
E2F9   85 07                  STA   PLACE+1   
E2FB   EE 35 04               INC   RSV   
E2FE   EE 35 04               INC   RSV   ; R: does not count the call
E301   A9 55                  LDA   #"U"   
E303   D0 E6                  BNE   ejmp3   ; always
E305                          ENDIF      
E305                             ; step: read one character and sort it by range.
E305                             ;    00h          end of program
E305                             ;    01h-20h, 7Fh-FFh   ignored
E305                             ;    30h-39h      digit: read a whole number
E305                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E305                             ;    61h-7Ah      a-z: push the address of that letter's cell
E305                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E305                             ; Every way out of the sort has the carry clear, except "ignored". A checked
E305                             ; build stops on 80h-FFh (X) and still ignores DEL.
E305   20 1B E6     STEP:     JSR   getc   ; flags follow A
E308   F0 38                  BEQ   endprog   
E30A   38                     SEC      
E30B   E9 21                  SBC   #21h   ; A = c - 21h
E30D   90 32                  BCC   ign   ; 01h-20h
E30F   C9 0F                  CMP   #0Fh   
E311   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E313   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E315   C9 0A                  CMP   #10   
E317   90 35                  BCC   digit   
E319   C9 11                  CMP   #11h   
E31B   90 18                  BCC   p3a   ; 3Ah-40h
E31D   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E31F   C9 1A                  CMP   #1Ah   
E321   90 26                  BCC   upper   ; 41h-5Ah
E323   C9 20                  CMP   #20h   
E325   90 0C                  BCC   p5b   ; 5Bh-60h
E327   C9 3A                  CMP   #3Ah   
E329                          IF   1-SBASEU   
E329   90 2B                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E32B                          ENDIF      
E32B                          IF   SBASEU   
                              BCC   lowq   ; 61h-7Ah: A = 20h-39h
E32B                          ENDIF      
E32B   C9 3E                  CMP   #3Eh   
E32D                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E32D                          ENDIF      
E32D                          IF   CHECKED   
E32D   F0 12                  BEQ   ign   ; 7Fh
E32F   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
E331                          ENDIF      
E331                             ; The three adjustments below chain. Each ADC adds the carry the one
E331                             ; before it left, which the constants allow for.
E331   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E333   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E335   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E337   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E338   A8                     TAY      
E339   B9 91 E5               LDA   PTAB+1,Y   
E33C   48                     PHA      
E33D   B9 90 E5               LDA   PTAB,Y   
E340   48                     PHA      
E341   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E342                             ; directly, it just ends an ignored character.
E342                ENDPROG:      
E342                          IF   CHECKED   
E342   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E344   F0 A8                  BEQ   e_undef   
E346                          ENDIF      
E346   4C 09 FF               JMP   EXIT   
E349                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E349                             ; the return stack, and the IP becomes the address in the letter's cell.
E349   0A           UPPER:    ASL      
E34A   A8                     TAY      
E34B   38                     SEC      
E34C   B0 44                  BCS   pushn   ; always
E34E                             ; Digits: the first one is in A; read the rest of the number.
E34E   A0 00        DIGIT:    LDY   #0   
E350   20 5F E3               JSR   pushay   
E353   4C F5 E5               JMP   rdnum   
E356                             ; a-z: push the cell's address (the cell is the variable)
E356   0A           LOWER:    ASL      
E357   A0 04                  LDY   #>LET   
E359   D0 04                  BNE   pushay   ; always
E35B   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E35D   A4 01                  LDY   IP+1   
E35F                             ; pushay: push a cell: A = its low byte, Y = its high byte
E35F   48           PUSHAY:   PHA      
E360   20 69 E3               JSR   push   
E363   68                     PLA      
E364   85 02                  STA   TL   
E366   84 03                  STY   TH   
E368   60                     RTS      
E369   CA           PUSH:     DEX      ; ":" and every push (keeps Y)
E36A   A5 02                  LDA   TL   
E36C   9D 00 02               STA   DSL,X   
E36F   A5 03                  LDA   TH   
E371   9D 00 03               STA   DSH,X   
E374   60                     RTS      
E375                          IF   SBASEU   
                                 ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
                                 ; fetched or stored in the same step (x@ is the commonest pair in most
                                 ; programs). A checked build checks the stacks between the two, so it keeps
                                 ; them apart. (pvar calls lower, which only pushes.)
                    LOWQ:     ASL      
                              STA   T0   ; the cell's offset in the letter page
                              LDY   #0   
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   lwf   
                              CMP   #"!"   
                              BEQ   lws   
                              LDA   T0   
                              LDY   #>LET   
                              BNE   pushay   ; always: the address
                    LWF:      JSR   incip   ; x@: TOS = the cell's value
                              JSR   push   
                              LDY   T0   
                              LDA   LET,Y   
                              STA   TL   
                              LDA   LET+1,Y   
                              STA   TH   
                              RTS      
                    LWS:      JSR   incip   ; x!: the cell = TOS, and NOS comes up
                              LDY   T0   
                              LDA   TL   
                              STA   LET,Y   
                              LDA   TH   
                              STA   LET+1,Y   
                              JMP   drop   
E375                          ENDIF      
E375                          IF   QK   
E375                             ;  ---- Speed-ups (QK builds) ---------------------------------------------
E375                             ;  The skip cache and the faster skip are at skip, "*" at h_mul and "/" at
E375                             ;  udiv; x@ and x! (unchecked) at lowq, above.
E375                             ; A true ")" reads the block start where it is, under the step frame,
E375                             ; instead of popping it and pushing it back. The break key is looked at as
E375                             ; pnext would.
E375   8A           CLOSEQ:   TXA      ; (TSX trashes X)
E376   BA                     TSX      
E377   BC 03 01               LDY   103h,X   
E37A   84 00                  STY   IP   
E37C   BC 04 01               LDY   104h,X   
E37F   84 01                  STY   IP+1   
E381   AA                     TAX      
E382   CE 79 04               DEC   CDOWN   
E385   F0 01                  BEQ   cq1   
E387   60                     RTS      ; into the loop
E388   68           CQ1:      PLA      
E389   68                     PLA      ; the step frame
E38A   4C 38 E2               JMP   pkey   
E38D                          ENDIF      
E38D                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E38D                             ; the matching ")".
E38D   20 30 E6     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E390                          IF   1-CHECKED   
                              BEQ   skip   
E390                          ENDIF      
E390                          IF   CHECKED   
E390   F0 26                  BEQ   skpar   
E392                          ENDIF      
E392                             ; pushn: take the step frame off, push the reading position on the return
E392                             ; stack, and go on. With the carry set (a word call) the reading position
E392                             ; then becomes the address in the letter cell at LET,Y.
E392   68           PUSHN:    PLA      
E393   68                     PLA      ; drop the step frame
E394   A5 01                  LDA   IP+1   
E396   48                     PHA      
E397   A5 00                  LDA   IP   
E399   48                     PHA      
E39A   90 0A                  BCC   nxt   
E39C   B9 00 04               LDA   LET,Y   
E39F   85 00                  STA   IP   
E3A1   B9 01 04               LDA   LET+1,Y   
E3A4   85 01                  STA   IP+1   
E3A6   4C 33 E2     NXT:      JMP   pnext   
E3A9                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E3A9                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E3A9                             ; the body"s address instead. Either way it then skips to the matching "]'.
E3A9                             ; (The unchecked build takes anything that is not a letter as the space; the
E3A9                             ; checked build stops on it.)
E3A9                          IF   CHECKED   
E3A9   C0 DF        DEF1:     CPY   #" "-"A"+256   
E3AB   F0 2B                  BEQ   def2   
E3AD                             ; W: anything but a letter or a space after [. The place is that character,
E3AD                             ; one past the [.
E3AD   E6 06                  INC   PLACE   
E3AF   D0 02                  BNE   eb1   
E3B1   E6 07                  INC   PLACE+1   
E3B3   A9 57        EB1:      LDA   #"W"   
E3B5                          ENDIF      
E3B5                          IF   CHECKED*(1-QK)   
                              BNE   ejmp2   ; always
E3B5                          ENDIF      
E3B5                          IF   CHECKED*QK   
E3B5   4C 24 EC               JMP   error   ; (the skip cache moved ejmp2 out of reach)
E3B8                          ENDIF      
E3B8                          IF   CHECKED   
E3B8                             ; A false ( skips: the wrong closer for it is ].
E3B8   A9 5D        SKPAR:    LDA   #"]"   
E3BA   D0 21                  BNE   skip   ; always
E3BC                          ENDIF      
E3BC   20 1B E6     H_DEF:    JSR   getc   
E3BF   38                     SEC      
E3C0   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E3C2   A8                     TAY      ;   lands 64 bytes up
E3C3   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E3C5   C9 1A                  CMP   #26   
E3C7                          IF   1-CHECKED   
                              BCS   def2   ; not a letter
E3C7                          ENDIF      
E3C7                          IF   CHECKED   
E3C7   B0 E0                  BCS   def1   
E3C9                          ENDIF      
E3C9   98                     TYA      
E3CA   0A                     ASL      
E3CB   A8                     TAY      ; Y -> the cell
E3CC   A5 00                  LDA   IP   
E3CE   99 00 04               STA   LET,Y   
E3D1   A5 01                  LDA   IP+1   
E3D3   99 01 04               STA   LET+1,Y   
E3D6   D0 03                  BNE   skdef   ; always: no program is in page zero
E3D8   20 5B E3     DEF2:     JSR   puship   ; an anonymous block: push its address
E3DB                SKDEF:       
E3DB                          IF   CHECKED   
E3DB   A9 29                  LDA   #")"   ; the wrong closer for [
E3DD                          ENDIF      
E3DD                             ; skip: read past text to the closer at this level, and return it in A.
E3DD                             ; Brackets of both kinds count together; strings are stepped over whole. A
E3DD                             ; NUL first ends the program.
E3DD                             ; In the checked build A holds, on the way in, the wrong closer for the
E3DD                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E3DD                             ; which takes either. Meeting the wrong closer at this level, or the end
E3DD                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E3DD                             ; which then ends the program as before.
E3DD                SKIP:        
E3DD                          IF   CHECKED   
E3DD   85 04                  STA   T0   
E3DF                          ENDIF      
E3DF                          IF   1-QK   
                              LDA   #0   
                              STA   D1   ; depth
                    SK1:      JSR   getc   
E3DF                          ENDIF      
E3DF                          IF   (1-QK)*(1-CHECKED)   
                              BEQ   endprog   
E3DF                          ENDIF      
E3DF                          IF   (1-QK)*CHECKED   
                              BEQ   sknul   
E3DF                          ENDIF      
E3DF                          IF   1-QK   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 22h (11h when checked), which
                                 ;   matches nothing below
E3DF                          ENDIF      
E3DF                          IF   (1-QK)*CHECKED   
                              BEQ   sknul   ; the string ran into the end
E3DF                          ENDIF      
E3DF                          IF   1-QK   
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   D1   
                              BPL   sk1   
E3DF                          ENDIF      
E3DF                          IF   (1-QK)*CHECKED   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
E3DF                          ENDIF      
E3DF                          IF   1-QK   
                              RTS      ; the closer at this level
                    SK3:      INC   D1   
                              BNE   sk1   
E3DF                          ENDIF      
E3DF                          IF   QK   
E3DF                             ; The skip cache (QK builds). Nearly every skip is one that has happened
E3DF                             ; before (a loop skips the same false block on every pass), so the first
E3DF                             ; scan from each place is remembered: 64 entries of {start, the closer's
E3DF                             ; address}, in CPAGE, found by the start's low byte times 4. Only skips that
E3DF                             ; start in the program text are kept (the line buffer changes); the cache is
E3DF                             ; emptied when the program starts. A program that changes its own text while
E3DF                             ; it runs is not looked after.
E3DF   A5 01                  LDA   IP+1   
E3E1   C9 05                  CMP   #>PROG   
E3E3   90 24                  BCC   sks   ; below the program text: no cache
E3E5   A5 00                  LDA   IP   
E3E7   0A                     ASL      
E3E8   0A                     ASL      
E3E9   A8                     TAY      ; Y -> the entry
E3EA   A5 00                  LDA   IP   
E3EC   D9 00 DF               CMP   CPAGE*256,Y   
E3EF   D0 18                  BNE   sks   
E3F1   A5 01                  LDA   IP+1   
E3F3   D9 01 DF               CMP   CPAGE*256+1,Y   
E3F6   D0 11                  BNE   sks   
E3F8   B9 02 DF               LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
E3FB   85 00                  STA   IP   ;   read
E3FD   B9 03 DF               LDA   CPAGE*256+3,Y   
E400   85 01                  STA   IP+1   
E402   A0 00                  LDY   #0   
E404   B1 00                  LDA   (IP),Y   
E406   4C 1E E6               JMP   incip   
E409   A5 00        SKS:      LDA   IP   
E40B   85 05                  STA   SKL   
E40D   A5 01                  LDA   IP+1   
E40F   85 08                  STA   SKH   
E411   A0 00                  LDY   #0   
E413   84 09                  STY   D1   ; depth
E415                             ; The scan reads at IP+Y. Most characters are nothing to it, and two range
E415                             ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
E415   B1 00        SQ1:      LDA   (IP),Y   
E417   C8                     INY      
E418   F0 1D                  BEQ   sqw   
E41A   C9 5E        SQ2:      CMP   #5Eh   
E41C   B0 F7                  BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E41E   C9 5B                  CMP   #5Bh   
E420   B0 2A                  BCS   sqb   ; [ \ ]
E422   C9 2A                  CMP   #2Ah   
E424   B0 EF                  BCS   sq1   ; * to Z: nothing
E426   C9 28                  CMP   #28h   
E428   F0 1D                  BEQ   sqo   ; (
E42A   B0 26                  BCS   sqc   ; )
E42C   C9 22                  CMP   #22h   
E42E   F0 0B                  BEQ   sqq   ; a string
E430   C9 01                  CMP   #1   
E432   B0 E1                  BCS   sq1   ; the rest below "(": nothing
E434                          ENDIF      
E434                          IF   QK*(1-CHECKED)   
                              JMP   EXIT   ; NUL: the end of the program
E434                          ENDIF      
E434                          IF   QK*CHECKED   
E434   4C 91 E4               JMP   sknul   
E437                          ENDIF      
E437                          IF   QK   
E437   E6 01        SQW:      INC   IP+1   ; Y went round: on into the next page
E439   D0 DF                  BNE   sq2   ; always
E43B   20 84 E4     SQQ:      JSR   sqip   ; a string: step over it
E43E   20 B7 E4               JSR   skipstr   
E441                          ENDIF      
E441                          IF   QK*CHECKED   
E441   F0 4E                  BEQ   sknul   ; the string ran into the end
E443                          ENDIF      
E443                          IF   QK   
E443   A0 00                  LDY   #0   
E445   F0 CE                  BEQ   sq1   ; always
E447   E6 09        SQO:      INC   D1   ; an opener
E449   4C 15 E4               JMP   sq1   
E44C   C9 5C        SQB:      CMP   #5Ch   
E44E   F0 C5                  BEQ   sq1   ; "\" is nothing here
E450   90 F5                  BCC   sqo   ; [
E452   C6 09        SQC:      DEC   D1   ; ) ]
E454   10 BF                  BPL   sq1   
E456   20 84 E4               JSR   sqip   ; the closer at this level: the IP past it
E459                          ENDIF      
E459                          IF   QK*CHECKED   
E459   C5 04                  CMP   T0   
E45B   F0 4C                  BEQ   e_nest   ; the wrong kind
E45D                          ENDIF      
E45D                          IF   QK   
E45D   48                     PHA      
E45E   A5 08                  LDA   SKH   ; remember the skip, if it started in the
E460   C9 05                  CMP   #>PROG   ;   program text
E462   90 1E                  BCC   sq9   
E464   A5 05                  LDA   SKL   
E466   0A                     ASL      
E467   0A                     ASL      
E468   A8                     TAY      
E469   A5 05                  LDA   SKL   
E46B   99 00 DF               STA   CPAGE*256,Y   
E46E   A5 08                  LDA   SKH   
E470   99 01 DF               STA   CPAGE*256+1,Y   
E473   A5 00                  LDA   IP   
E475   38                     SEC      
E476   E9 01                  SBC   #1   
E478   99 02 DF               STA   CPAGE*256+2,Y   ; the closer's address
E47B   A5 01                  LDA   IP+1   
E47D   E9 00                  SBC   #0   
E47F   99 03 DF               STA   CPAGE*256+3,Y   
E482   68           SQ9:      PLA      
E483   60                     RTS      ; the closer at this level
E484                             ; sqip: IP = IP + Y. Keeps A.
E484   48           SQIP:     PHA      
E485   98                     TYA      
E486   18                     CLC      
E487   65 00                  ADC   IP   
E489   85 00                  STA   IP   
E48B   90 02                  BCC   sp1   
E48D   E6 01                  INC   IP+1   
E48F   68           SP1:      PLA      
E490   60                     RTS      
E491                          ENDIF      
E491                          IF   CHECKED   
E491   A5 04        SKNUL:    LDA   T0   
E493   D0 14                  BNE   e_nest   ; ( and [ stop with N
E495   4C 09 FF               JMP   EXIT   ; \ ends the program
E498                             ; The end of "$" (h_print): the string's address goes back into TOS; then a
E498                             ; closing quote drops it, and a NUL (the carry clear) is Q.
E498   68           PQ:       PLA      
E499   85 02                  STA   TL   
E49B   68                     PLA      
E49C   85 03                  STA   TH   
E49E   B0 5D                  BCS   pdrop   
E4A0   E0 FC                  CPX   #DSE   ; a NUL: Q, unless "$" had nothing on the
E4A2   A9 73                  LDA   #"s"   ;   stack at all (X at the empty mark): s
E4A4   B0 05                  BCS   ejmp2   
E4A6   A9 51        E_QUOTE:   LDA   #"Q"   ; a string runs into the end
E4A8   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E4A9   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E4AB   4C 24 EC     EJMP2:    JMP   error   ;   or the end: the place is the opener
E4AE                          ENDIF      
E4AE                             ; 22h pushes the address of the text after it and skips the string.
E4AE   20 5B E3     H_STR:    JSR   puship   
E4B1                          IF   CHECKED   
E4B1   20 B7 E4               JSR   skipstr   
E4B4   F0 F0                  BEQ   e_quote   ; it ran into the end: the place is the 22h
E4B6   60                     RTS      
E4B7                          ENDIF      
E4B7                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E4B7                             ; the next character, so "/"" does not end it.
E4B7                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E4B7                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E4B7                             ; text ended first (a NUL, also one just after "/").
E4B7                          IF   1-CHECKED   
                    SKIPSTR:   JSR   getc   
                              CMP   #"/"   
                              BEQ   ss0   
                              CMP   #22h   
                              BNE   skipstr   
                              RTS      
                    SS0:      JSR   incip   
                              BNE   skipstr   ; A is "/" here
E4B7                          ENDIF      
E4B7                          IF   CHECKED   
E4B7   20 1B E6     SKIPSTR:   JSR   getc   
E4BA   F0 09                  BEQ   ss9   ; the end
E4BC   C9 2F                  CMP   #"/"   
E4BE   D0 06                  BNE   ss1   
E4C0   20 1B E6               JSR   getc   ; the escaped character
E4C3   D0 F2                  BNE   skipstr   
E4C5   60           SS9:      RTS      ; the end, just after "/"
E4C6   C9 22        SS1:      CMP   #22h   
E4C8   D0 ED                  BNE   skipstr   
E4CA   4A                     LSR      ; A = 11h, Z clear
E4CB   60                     RTS      
E4CC                          ENDIF      
E4CC                             ; =============================================================================
E4CC                             ;  Console
E4CC                             ; =============================================================================
E4CC                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E4CC                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E4CC                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
E4CC                             ; no bit 6, so // and /" give themselves). TOS walks along the string; the
E4CC                             ; checked build keeps the address on the hardware stack meanwhile, for a Q
E4CC                             ; report (see pq).
E4CC                          IF   CHECKED   
E4CC   A5 03        H_PRINT:   LDA   TH   
E4CE   48                     PHA      
E4CF   A5 02                  LDA   TL   
E4D1   48                     PHA      
E4D2   90 03                  BCC   pr0   ; always: the carry is clear on the way in
E4D4                          ENDIF      
E4D4                          IF   1-CHECKED   
                    H_PRINT:   EQU   pr0   
E4D4                          ENDIF      
E4D4   20 0B E5     PESC0:    JSR   pesc   ; (an escape, and back into the loop)
E4D7   20 00 E5     PR0:      JSR   tosget   
E4DA   C9 22                  CMP   #22h   
E4DC                          IF   1-CHECKED   
                              BEQ   pdrop   
E4DC                          ENDIF      
E4DC                          IF   CHECKED   
E4DC   F0 BA                  BEQ   pq   ; the closing quote, with the carry set
E4DE   A8                     TAY      ; (Y is free here)
E4DF   F0 B7                  BEQ   pq   ; a NUL, with the carry clear
E4E1                          ENDIF      
E4E1   C9 2F                  CMP   #"/"   
E4E3   D0 0D                  BNE   pr1   
E4E5   20 00 E5               JSR   tosget   
E4E8   C9 60                  CMP   #60h   
E4EA   90 04                  BCC   pr2   
E4EC   C9 7F                  CMP   #7Fh   
E4EE   90 E4                  BCC   pesc0   ; 60h-7Eh, and the carry is clear
E4F0   29 BF        PR2:      AND   #0BFh   
E4F2   20 03 FF     PR1:      JSR   CONOUT   
E4F5   4C D7 E4               JMP   pr0   
E4F8   A5 02        H_EMIT:   LDA   TL   ; "'"
E4FA   20 03 FF               JSR   CONOUT   
E4FD   4C 58 E6     PDROP:    JMP   drop   
E500                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E500   A0 00        TOSGET:   LDY   #0   
E502   B1 02                  LDA   (TL),Y   
E504   E6 02        INCTOS:   INC   TL   
E506   D0 02                  BNE   tg1   
E508   E6 03                  INC   TH   
E50A   60           TG1:      RTS      
E50B                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E50B                             ; the carry is clear. Each returns into the loop.
E50B                             ;    /a-/z   print the variable, as "#" does
E50B                             ;    /{      clear the screen, the cursor to the top left
E50B                             ;    /}      clear from the cursor to the end of the line
E50B                             ;    /|  /`  show the cursor, hide it
E50B                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E50B                             ;            from 0. The two cells under TOS (the string's address) go.
E50B                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E50B                             ; E6h-FFh with it clear.
E50B                          IF   1-ANSI   
E50B                             ; With ANSI = 0 the machine's routines do the work.
E50B   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E50D   90 0D                  BCC   pe1   
E50F   F0 08                  BEQ   pcls   ; {
E511   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E512   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E514   B0 0D                  BCS   pat   ; ~
E516   4C 0F FF               JMP   CONEOL   ; }
E519   4C 0C FF     PCLS:     JMP   CONCLS   
E51C   C9 E6        PE1:      CMP   #0E6h   
E51E   B0 15                  BCS   pvar   
E520   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E523                          ENDIF      
E523                             ; /~: the column is NOS, the row the cell under it.
E523                PAT:         
E523                          IF   CHECKED   
E523   E0 FA                  CPX   #DSE-2   ; fewer than two cells under TOS: s
E525   B0 0B                  BCS   e_atu   
E527                          ENDIF      
E527                          IF   1-ANSI   
E527   BC 00 02               LDY   DSL,X   ; the column
E52A   BD 01 02               LDA   DSL+1,X   ; the row
E52D   E8                     INX      
E52E   E8                     INX      
E52F   4C 15 FF               JMP   CONAT   
E532                          ENDIF      
E532                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). The row's cell and TOS change
                                 ; places first: then "#" prints the row and drops it, prints the column and
                                 ; drops it, and TOS is the string's address again.
                              INX      
                              JSR   h_swap   
                              DEX      
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E532                          ENDIF      
E532                          IF   CHECKED   
E532   4C 58 E2     E_ATU:    JMP   e_stack   ; (X is FAh-FCh: an underflow)
E535                          ENDIF      
E535                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E535                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' (next)
E535                             ; prints it and drops it: TOS is the string's address again.
E535   69 39        PVAR:     ADC   #39h   
E537   20 56 E3               JSR   lower   
E53A   20 82 EB               JSR   h_fetch   
E53D                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E53D                             ; digits are divided off and held on the hardware stack, ended by a 0.
E53D   A5 03        H_NUM:    LDA   TH   
E53F   10 08                  BPL   pn1   
E541   A9 2D                  LDA   #"-"   
E543   20 03 FF               JSR   CONOUT   
E546   20 B4 E6               JSR   neg   
E549   A9 0A        PN1:      LDA   #10   
E54B   85 08                  STA   D0   
E54D   A9 00                  LDA   #0   
E54F   85 09                  STA   D1   
E551   48                     PHA      ; the end marker
E552   20 9A E9     PN2:      JSR   udiv   
E555   A5 04                  LDA   T0   ; the remainder
E557   09 30                  ORA   #"0"   
E559   48                     PHA      
E55A   A5 02                  LDA   TL   
E55C   05 03                  ORA   TH   
E55E   D0 F2                  BNE   pn2   
E560   68           PN3:      PLA      
E561   F0 9A                  BEQ   pdrop   
E563   20 03 FF               JSR   CONOUT   
E566   4C 60 E5               JMP   pn3   
E569                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into. (It sits here, just above prs, for that.)
                    PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh). Y is 0, as
                                 ;   tosget leaves it, and M_CLS is the first
                                 ;   message: Y already points at it
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E569                          ENDIF      
E569                          IF   CHECKED+ANSI   
E569                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E569                             ; past it, at the next message.
E569   B9 77 E5     PRS:      LDA   MSG,Y   
E56C   48                     PHA      
E56D   29 7F                  AND   #7Fh   
E56F   20 03 FF               JSR   CONOUT   
E572   C8                     INY      
E573   68                     PLA      
E574   10 F3                  BPL   prs   
E576   60                     RTS      
E577                MSG:         
E577                          ENDIF      
E577                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   ; (the first: pesc counts on it)
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
E577                          ENDIF      
E577                          IF   CHECKED   
E577   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E57D   20 40 A0               DB   " @"," "+80h   
E580   0D 8A        M_NL:     DB   13,10+80h   
E582   0D 0A 44 BA  M_STK:    DB   13,10,"D",":"+80h   
E586   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E58B   BA           M_C:      DB   ":"+80h   
E58C   0D 0A 52 BA  M_RTN:    DB   13,10,"R",":"+80h   
E590                          ENDIF      
E590                             ; =============================================================================
E590                             ;  Dispatch table: one handler per punctuation character, in code order.
E590                             ;  Entries are handler-1 for the RTS trick.
E590                             ; =============================================================================
E590   38 E6        PTAB:     DW   h_store-1   ; !
E592   AD E4                  DW   h_str-1   ; "
E594   3C E5                  DW   h_num-1   ; #
E596   CB E4                  DW   h_print-1   ; $
E598   0B E9                  DW   h_swap-1   ; %
E59A   63 E6                  DW   h_and-1   ; &
E59C   F7 E4                  DW   h_emit-1   ; '
E59E   8C E3                  DW   h_open-1   ; (
E5A0   7E E2                  DW   h_close-1   ; )
E5A2   E6 E6                  DW   h_mul-1   ; *
E5A4   95 E6                  DW   h_add-1   ; +
E5A6   8D EB                  DW   h_cfetch-1   ; ,
E5A8   8D E6                  DW   h_sub-1   ; -
E5AA   4A E6                  DW   h_cstore-1   ; .
E5AC   20 E9                  DW   h_div-1   ; /
E5AE   68 E3                  DW   push-1   ; :
E5B0   57 E6                  DW   drop-1   ; ;
E5B2   C4 E6                  DW   h_lt-1   ; <
E5B4   D6 E6                  DW   h_eq-1   ; =
E5B6   C1 E6                  DW   h_gt-1   ; >
E5B8   96 EB                  DW   h_key-1   ; ?
E5BA   81 EB                  DW   h_fetch-1   ; @
E5BC   BB E3                  DW   h_def-1   ; [
E5BE   97 E2                  DW   h_break-1   ; \
E5C0   86 E2                  DW   h_ret-1   ; ]
E5C2   7F E6                  DW   h_xor-1   ; ^
E5C4   50 E9                  DW   h_alloc-1   ; _
E5C6   F4 EB                  DW   h_grave-1   ; `
E5C8   64 E2                  DW   h_tor-1   ; {
E5CA   71 E6                  DW   h_or-1   ; |
E5CC   71 E2                  DW   h_fromr-1   ; }
E5CE   AD E6                  DW   h_not-1   ; ~
E5D0                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E5D0                             ; test is at the bottom so the loop closes with a branch. Returns with the
E5D0                             ; carry set.
E5D0   20 1E E6     RD1:      JSR   incip   ; (keeps A = the digit)
E5D3   06 02                  ASL   TL   
E5D5   26 03                  ROL   TH   ; x2
E5D7   18                     CLC      
E5D8   65 02                  ADC   TL   
E5DA   85 04                  STA   T0   
E5DC   A5 03                  LDA   TH   
E5DE   69 00                  ADC   #0   
E5E0   A8                     TAY      ; Y:T0 = x2 + digit
E5E1   06 02                  ASL   TL   
E5E3   26 03                  ROL   TH   
E5E5   06 02                  ASL   TL   
E5E7   26 03                  ROL   TH   ; x8
E5E9   18                     CLC      
E5EA   A5 02                  LDA   TL   
E5EC   65 04                  ADC   T0   
E5EE   85 02                  STA   TL   
E5F0   98                     TYA      
E5F1   65 03                  ADC   TH   
E5F3   85 03                  STA   TH   ; x8 + x2 + digit
E5F5   20 FB E5     RDNUM:    JSR   isdig   
E5F8   90 D6                  BCC   rd1   
E5FA   60                     RTS      
E5FB                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E5FB                             ; digit. Y = 0.
E5FB   20 16 E6     ISDIG:    JSR   peek   
E5FE   38                     SEC      
E5FF   E9 30                  SBC   #"0"   
E601   C9 0A                  CMP   #10   
E603   60                     RTS      
E604                             ; =============================================================================
E604                             ;  Reading the program
E604                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E604                             ;    getc: the same, then IP moves on; flags follow A
E604                             ;    incip: IP moves on; keeps A, the carry and Y
E604                             ; =============================================================================
E604                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E604                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E604                             ; Y = 0.
E604   20 FB E5     RDHEX:    JSR   isdig   
E607   90 0A                  BCC   rh1   
E609   29 DF                  AND   #0DFh   
E60B   E9 11                  SBC   #11h   ; (the carry is set)
E60D   C9 06                  CMP   #6   
E60F   B0 04                  BCS   rh9   
E611   69 0A                  ADC   #10   
E613   90 09        RH1:      BCC   incip   ; always: the carry is clear
E615   60           RH9:      RTS      
E616   A0 00        PEEK:     LDY   #0   
E618   B1 00                  LDA   (IP),Y   
E61A   60                     RTS      
E61B   20 16 E6     GETC:     JSR   peek   
E61E   E6 00        INCIP:    INC   IP   
E620   D0 02                  BNE   ic1   
E622   E6 01                  INC   IP+1   
E624   09 00        IC1:      ORA   #0   
E626   60                     RTS      
E627                             ; rstip: point IP at the start of the program
E627   A9 00        RSTIP:    LDA   #<PROG   
E629   85 00                  STA   IP   
E62B   A9 05                  LDA   #>PROG   
E62D   85 01                  STA   IP+1   
E62F   60                     RTS      
E630                             ; =============================================================================
E630                             ;  Stack
E630                             ; =============================================================================
E630                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E630   A5 02        FLAG:     LDA   TL   
E632   05 03                  ORA   TH   
E634   20 58 E6               JSR   drop   
E637   A8                     TAY      ; (drop's INX changed the flags)
E638   60                     RTS      
E639                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E639                H_STORE:      
E639                          IF   CHECKED   
E639   A5 02                  LDA   TL   ; both bytes must be in the program's space:
E63B   69 01                  ADC   #1   ; check the page of addr+1 (the carry is
E63D   A5 03                  LDA   TH   ; clear on the way in)
E63F   69 00                  ADC   #0   
E641   20 91 E9               JSR   chkst   
E644                          ENDIF      
E644   BD 00 03               LDA   DSH,X   
E647   A0 01                  LDY   #1   
E649   91 02                  STA   (TL),Y   
E64B                H_CSTORE:      ; "." ( c addr -- )
E64B                          IF   CHECKED   
E64B   A5 03                  LDA   TH   
E64D   20 91 E9               JSR   chkst   
E650                          ENDIF      
E650   BD 00 02               LDA   DSL,X   
E653   A0 00                  LDY   #0   
E655   91 02                  STA   (TL),Y   
E657   E8                     INX      ; falls into drop
E658                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E658                             ; it returns with Z clear.
E658   BC 00 02     DROP:     LDY   DSL,X   
E65B   84 02                  STY   TL   
E65D   BC 00 03               LDY   DSH,X   
E660   84 03                  STY   TH   
E662   E8                     INX      
E663   60                     RTS      
E664                             ; =============================================================================
E664                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E664                             ; =============================================================================
E664                             ; The logic operators leave the carry as they found it, clear, so they can
E664                             ; branch to fin.
E664   BD 00 02     H_AND:    LDA   DSL,X   
E667   25 02                  AND   TL   
E669   85 02                  STA   TL   
E66B   BD 00 03               LDA   DSH,X   
E66E   25 03                  AND   TH   
E670   90 31                  BCC   fin   ; always
E672   BD 00 02     H_OR:     LDA   DSL,X   
E675   05 02                  ORA   TL   
E677   85 02                  STA   TL   
E679   BD 00 03               LDA   DSH,X   
E67C   05 03                  ORA   TH   
E67E   90 23                  BCC   fin   ; always
E680   BD 00 02     H_XOR:    LDA   DSL,X   
E683   45 02                  EOR   TL   
E685   85 02                  STA   TL   
E687   BD 00 03               LDA   DSH,X   
E68A   45 03                  EOR   TH   
E68C   90 15                  BCC   fin   ; always
E68E                             ; "-" has two jobs: directly before a digit it starts a negative number.
E68E   20 FB E5     H_SUB:    JSR   isdig   
E691   90 14                  BCC   negnum   
E693   20 B4 E6     SUB1:     JSR   neg   ; a - b = a + (-b)
E696   18           H_ADD:    CLC      
E697   BD 00 02               LDA   DSL,X   
E69A   65 02                  ADC   TL   
E69C   85 02                  STA   TL   
E69E   BD 00 03               LDA   DSH,X   
E6A1   65 03                  ADC   TH   ; falls into fin
E6A3                             ; fin: finish a two-operand op: A = the high byte of the result
E6A3   85 03        FIN:      STA   TH   
E6A5   E8                     INX      
E6A6   60                     RTS      
E6A7   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E6A9   20 4E E3               JSR   digit   ; (comes back with the carry set)
E6AC   B0 06                  BCS   neg   ; always: the number, negated
E6AE                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E6AE   90 05        H_NOT:    BCC   neg1   ; always
E6B0                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E6B0   A5 03        ABSV:     LDA   TH   
E6B2   10 0D        NEGM:     BPL   ab9   
E6B4                             ; neg: TOS = -TOS
E6B4   38           NEG:      SEC      
E6B5   A9 00        NEG1:     LDA   #0   
E6B7   E5 02                  SBC   TL   
E6B9   85 02                  STA   TL   
E6BB   A9 00                  LDA   #0   
E6BD   E5 03                  SBC   TH   
E6BF   85 03                  STA   TH   
E6C1   60           AB9:      RTS      
E6C2                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E6C2                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E6C2   20 0C E9     H_GT:     JSR   h_swap   ; a > b is b < a
E6C5   BD 00 02     H_LT:     LDA   DSL,X   
E6C8   C5 02                  CMP   TL   
E6CA   BD 00 03               LDA   DSH,X   
E6CD   E5 03                  SBC   TH   
E6CF   70 02                  BVS   lt1   
E6D1   49 80                  EOR   #80h   
E6D3   0A           LT1:      ASL      
E6D4   E8                     INX      ; (keeps the carry; never leaves X at 0)
E6D5   D0 07                  BNE   bool   ; always
E6D7   20 93 E6     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E6DA   05 02                  ORA   TL   
E6DC   C9 01                  CMP   #1   ; carry clear if A = 0
