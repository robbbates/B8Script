  1277 000005F5 75E0                <1>         jne     .sk1
  1278 000005F7 49                  <1> .sk4:   dec     ecx
  1279 000005F8 75DD                <1>         jnz     .sk1
  1280                              <1> %if CHECKED
  1281 000005FA 30C4                <1>         xor     ah,al                   ; the closer at this level: 0 or 2. Bit
  1282 000005FC 80E406              <1>         and     ah,6                    ;   1 of the opener is 0 for '(' and 1
  1283 000005FF 80FC02              <1>         cmp     ah,2                    ;   for '[', and only the backslash has
  1284 00000602 740A                <1>         je      .sk7                    ;   bit 2: so this is 2 for the wrong
  1285                              <1>                                         ;   closer, and only then
  1286 00000604 C3                  <1>         ret
  1287 00000605 F6C404              <1> .sk6:   test    ah,4                    ; the text ran out:
  1288 00000608 0F8544FFFFFF        <1>         jnz     SKEND                   ;   '\' with no closer ends the program
  1289 0000060E 8B7564              <1> .sk7:   mov     esi,[V(v_skat)]         ; N. The place is the opener
  1290 00000611 B04E                <1>         mov     al,'N'
  1291 00000613 E9E9FCFFFF          <1>         jmp     errp                    ; (errp drops skip's return address)
  1292                              <1> %else
