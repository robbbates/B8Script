   784 00000253 C02304              <1>         shl     byte [ebx],4            ;   overwrites it
   785 00000256 0803                <1>         or      [ebx],al                ; ... and the low one joins it
   786 00000258 43                  <1>         inc     ebx
   787                              <1>         CALLP   hexc
