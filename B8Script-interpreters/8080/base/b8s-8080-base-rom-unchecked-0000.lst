0269                             ; psgn: print HL as a signed number. Uses BC.
0269   7C           PSGN:     MOV   A,H   
026A   B7                     ORA   A   
026B   F2 72 02               JP   pdec   
026E   3E 2D                  MVI   A,"-"   
0270                          ;*Macro unroll:  PUTA
0270   EF                     DS   1-CPM,0EFh   
0271                          DS   CPM,0CDh   
0271                          DS   CPM,APUT&0FFh   
0271                          DS   CPM,APUT/256   
0271                          ;*Macro unroll:  NEGH
0271   E7                     DS   1-CPM,0E7h   
0272                          DS   CPM,0CDh   
0272                          DS   CPM,ANEG&0FFh   
0272                          DS   CPM,ANEG/256   
0272                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0272                             ; Uses BC.
0272   11 0A 00     PDEC:     LXI   D,10   
0275   CD 11 02               CALL   udiv   ; HL = HL / 10, C = the last digit
0278   79                     MOV   A,C   
0279   F5                     PUSH   PSW   
027A   7C                     MOV   A,H   
027B   B5                     ORA   L   
027C   C4 72 02               CNZ   pdec   
027F   F1                     POP   PSW   
