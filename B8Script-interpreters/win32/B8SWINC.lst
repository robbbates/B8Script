   538                              <1> ; =============================================================================
   539                              <1> ;  Punctuation handlers. PTAB holds one byte per character: its handler's
   540                              <1> ;  distance from hbase, so every handler starts in the 256 bytes from hbase
   541                              <1> ;  (PT checks it). Only the starts must be there: the last handler, '$',
   542                              <1> ;  runs on past the window, and '[', '`' (and '_' and '/' in a checked
   543                              <1> ;  build) are stubs that jump to their bodies after it. Each handler starts
   544                              <1> ;  with EBX = TOS and EAX, ECX, EDX free, and ends with JMP EBP.
   545                              <1> ;  (Two other layouts were tried: handlers 2-aligned with the table holding
   546                              <1> ;  half the distance, which costs a NOP after every handler of odd length,
   547                              <1> ;  about 22 bytes; and the Z80's two 256-byte windows, whose dispatcher is 7
   548                              <1> ;  bytes longer and whose handlers must be in table order, which costs near
   549                              <1> ;  jumps.)
   550                              <1> ; =============================================================================
   551                              <1> hbase:
   552                              <1> ; ']' returns: pop an address and jump to it.
   553 00000101 8B37                <1> h_ret:  mov     esi,[edi]
   554 00000103 AF                  <1> rdrop:  scasd                           ; drop the return stack's top
   555 00000104 FFE5                <1> nx:     jmp     ebp
   556                              <1> 
   557                              <1> ; '\' ( flag -- ): true skips to the next ')' or ']' at this level; ')'
   558                              <1> ; drops the block start, ']' returns. No closer at all ends the program.
   559 00000106 6685DB              <1> h_break:test    bx,bx
   560 00000109 5B                  <1>         pop     ebx
   561 0000010A 74F8                <1>         jz      nx
   562 0000010C E8BD040000          <1>         call    skip
   563 00000111 84C0                <1>         test    al,al                   ; skip returns 0 for ')'
   564 00000113 75EC                <1>         jnz     h_ret
   565 00000115 EBEC                <1>         jmp     rdrop
   566                              <1> 
   567                              <1> ; ')' ( flag -- ): true jumps back to the block start (and keeps it); false
   568                              <1> ; drops it and carries on. The loop-back looks at the break key.
   569 00000117 6685DB              <1> h_close:test    bx,bx
   570 0000011A 5B                  <1>         pop     ebx
   571 0000011B 74E6                <1>         jz      rdrop
   572 0000011D 8B37                <1>         mov     esi,[edi]
   573 0000011F EBC9                <1>         jmp     rpoll
   574                              <1> 
   575                              <1> ; '(' ( flag -- ): true pushes the block start and enters; false skips to
   576                              <1> ; the matching ')'.
   577 00000121 6685DB              <1> h_open: test    bx,bx
   578 00000124 5B                  <1>         pop     ebx
   579 00000125 0F84F1000000        <1>         jz      skipo
   580 0000012B 89F2                <1>         mov     edx,esi
   581 0000012D EBB6                <1>         jmp     rpush
   582                              <1> 
   583                              <1> ; '{' TOS to the return stack, '}' back.
   584 0000012F 89DA                <1> h_tor:  mov     edx,ebx
   585 00000131 5B                  <1>         pop     ebx
   586 00000132 EBB1                <1>         jmp     rpush
   587 00000134 53                  <1> h_fromr:push    ebx
   588 00000135 8B1F                <1>         mov     ebx,[edi]
   589 00000137 EBCA                <1>         jmp     rdrop
