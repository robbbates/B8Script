04A9                             ; psgn: print HL as a signed number. Uses BC.
04A9   7C           PSGN:     MOV   A,H   
04AA   B7                     ORA   A   
04AB   F2 B6 04               JP   pdec   
04AE   3E 2D                  MVI   A,"-"   
04B0                          ;*Macro unroll:  PUTA
04B0                          DS   1-CPM,0EFh   
04B0   CD                     DS   CPM,0CDh   
04B1   D4                     DS   CPM,APUT&0FFh   
04B2   06                     DS   CPM,APUT/256   
04B3                          ;*Macro unroll:  NEGH
04B3                          DS   1-CPM,0E7h   
04B3   CD                     DS   CPM,0CDh   
04B4   27                     DS   CPM,ANEG&0FFh   
04B5   01                     DS   CPM,ANEG/256   
04B6                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
04B6                             ; Uses BC.
04B6   11 0A 00     PDEC:     LXI   D,10   
04B9   CD FD 02               CALL   udiv   ; HL = HL / 10, C = the last digit
04BC   79                     MOV   A,C   
04BD   F5                     PUSH   PSW   
04BE   7C                     MOV   A,H   
04BF   B5                     ORA   L   
