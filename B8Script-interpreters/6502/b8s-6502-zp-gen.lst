E379                             ; `+ and `-: one routine, which adds 1 or -1 (FFFFh): Y says which. The cell
E379                             ; is reached a byte at a time through the top cell, which moves on between.
E379                G_INC:       
E379                          IF   CHECKED   
                              JSR   chkst   ; each byte"s address is tested, as for "!'
E379                          ENDIF      
E379   C0 0C                  CPY   #GPLUS-GTAB+3   ; carry: "-"
E37B   A9 00                  LDA   #0   
E37D   90 02                  BCC   gi1   
E37F   A9 FF                  LDA   #0FFh   
