F1E3                          IF   CHECKED   
F1E3   25 12                  BCS   sk9   ; (or FFh, with the carry set: unclosed)
F1E5                          ENDIF      
F1E5   80 28        SK2:      SUBA   #"("   
F1E7   27 0F                  BEQ   sk3   
F1E9   4A                     DECA      ; ")"
F1EA   27 08                  BEQ   sk4   
F1EC   80 32                  SUBA   #"["-")"   
F1EE   27 08                  BEQ   sk3   
F1F0   81 02                  CMPA   #"]"-"["   
F1F2   26 E5                  BNE   sk1   
F1F4   5A           SK4:      DECB      
F1F5   2A E2                  BPL   sk1   
