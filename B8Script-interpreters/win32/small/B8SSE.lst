  1184 000004BB 3DFEFFFF7F          <1>         cmp     eax,7FFFFFFEh
  1185 000004C0 7320                <1>         jae     .wk1                    ; 1 ms or more, and not INFINITE,
  1186 000004C2 85FF                <1>         test    edi,edi                 ;   uses it
  1187 000004C4 741C                <1>         jz      .wk1
