E2D5   81 00                  STA   (0,X)   
E2D7   60                     RTS      
E2D8   B5 00        EXEC:     LDA   0,X   
E2DA   85 04                  STA   T0   
E2DC   B5 01                  LDA   1,X   
E2DE   85 05                  STA   T1   
