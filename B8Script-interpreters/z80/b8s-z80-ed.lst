0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        Dividing by zero is not checked. -n? does no more editing than
0000                             ;        Backspace.
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet
0001   32 00 83               LD   (PROG),A   
0004                          ENDIF      
0004                          IF   EDGEN*(1-CHECKED)   
0004   C3 E7 02               JP   edit   ; 04
0007                          ENDIF      
0007                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0007                          ENDIF      
0007                          IF   EDGEN   
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 E7 02     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 CC 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 DA                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 75                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 77                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 69                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D   C6 6A        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 00                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE 80                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0066                          ENDIF      
0066                          IFN   CPM   
0066   CB 12                  RL   D   ; its page: 0 + carry
0068                          ENDIF      
0068                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0068                          ENDIF      
0068   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0069   C9                     RET      ;   when the handler starts
006A                             ; The rest of the startup: here so that the generic reset code can reach it
006A                             ; with JR. st0: find the program's NUL; the heap starts after it.
006A                             ; (The editor build has its own copy of this, next to the editor.)
006A                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
006A                          ENDIF      
006A                          IF   CHECKED*(1-EDITOR)   
                              XOR   A   
                              LD   (KEYBUF),A   ; no key held back
006A                          ENDIF      
006A                          IF   1-EDITOR   
                              RST   30h   ; (its return address is thrown away)
006A                          ENDIF      
006A                             ; In the unchecked generic editor build the table is here, in the first
006A                             ; page, which saves loading D twice. (The other builds have no room for it
006A                             ; here: theirs is further down.)
006A                          IF   TABP0   
006A                PTAB:        
006A                          ;*Macro unroll:  PTABLE
006A   9E                     DB   h_store & 0FFh   
006B   A3                     DB   h_str & 0FFh   
006C   BE                     DB   h_num & 0FFh   
006D   AA                     DB   h_print & 0FFh   
006E   99                     DB   h_swap & 0FFh   
006F   41                     DB   h_and & 0FFh   
0070   BB                     DB   h_emit & 0FFh   
0071   1D                     DB   h_open & 0FFh   
0072   25                     DB   h_close & 0FFh   
0073   62                     DB   h_mul & 0FFh   
0074   38                     DB   h_add & 0FFh   
0075   E4                     DB   h_cfetch & 0FFh   
0076   30                     DB   h_sub & 0FFh   
0077   9B                     DB   h_cstore & 0FFh   
0078   76                     DB   h_div & 0FFh   
0079   97                     DB   h_dup & 0FFh   
007A   9D                     DB   h_drop & 0FFh   
007B   49                     DB   h_lt & 0FFh   
007C   58                     DB   h_eq & 0FFh   
007D   4A                     DB   h_gt & 0FFh   
007E   CC                     DB   h_key & 0FFh   
007F   18                     DB   h_fetch & 0FFh   
0080   FB                     DB   h_def & 0FFh   
0081   EE                     DB   h_break & 0FFh   
0082   EA                     DB   h_ret & 0FFh   
0083   8A                     DB   h_xor & 0FFh   
0084   9D                     DB   h_alloc & 0FFh   
0085   D4                     DB   h_grave & 0FFh   
0086   2C                     DB   h_tor & 0FFh   
0087   92                     DB   h_or & 0FFh   
0088   1C                     DB   h_fromr & 0FFh   
0089   9A                     DB   h_not & 0FFh   
008A                PTABEND:      
008A                          ENDIF      
008A                             ; =============================================================================
008A                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
008A                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
008A                             ;  is here too: it belongs to "`" and makes the page come out right.
008A                             ; =============================================================================
008A   D1           H_XOR:    POP   DE   
008B   7C                     LD   A,H   
008C   AA                     XOR   D   
008D   67                     LD   H,A   
008E   7D                     LD   A,L   
008F   AB                     XOR   E   
0090   6F                     LD   L,A   
0091   F7                     RST   30h   
0092   D1           H_OR:     POP   DE   
0093   7C                     LD   A,H   
0094   B2                     OR   D   
0095   67                     LD   H,A   
0096   7D                     LD   A,L   
0097   B3                     OR   E   
0098   6F                     LD   L,A   
0099   F7                     RST   30h   
009A   E7           H_NOT:    RST   20h   ; ~x = -x - 1
009B   2B                     DEC   HL   
009C   F7                     RST   30h   
009D                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
009D   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A1   19                     ADD   HL,DE   ; the new top
00A2                          IF   CHECKED   
                              CALL   chkhp   
00A2                          ENDIF      
00A2   22 7C 82               LD   (HEAP),HL   
00A5   EB                     EX   DE,HL   
00A6   F7                     RST   30h   
00A7   D9           EXEC:     EXX      
00A8   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00AB   D9                     EXX      
00AC   CD 2B 00               CALL   jphl   
00AF   D9                     EXX      
00B0   2A 34 82               LD   HL,(RSAVE)   
00B3   D9                     EXX      
00B4   E1                     POP   HL   
00B5   F7                     RST   30h   
00B6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00B6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00B6                             ; Digits: step back onto the first digit and read the whole number.
00B6   E5           DIGIT:    PUSH   HL   
00B7   0B                     DEC   BC   
00B8   CD 41 02               CALL   rdnum   
00BB   F7                     RST   30h   
00BC                             ; a-z: push the cell's address (the cell is the variable)
00BC   E5           LOWER:    PUSH   HL   
00BD   87                     ADD   A,A   
00BE   6F                     LD   L,A   
00BF   26 82                  LD   H,LETPAGE   
00C1   F7                     RST   30h   
00C2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00C2                             ; the return stack, and the IP becomes the address in the letter's cell.
00C2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00C3   EB                     EX   DE,HL   ; park TOS
00C4   87                     ADD   A,A   
00C5   6F                     LD   L,A   
00C6   26 82                  LD   H,LETPAGE   ; HL -> cell
00C8   4E                     LD   C,(HL)   
00C9   2C                     INC   L   
00CA   46                     LD   B,(HL)   ; IP = the word's body
00CB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00CC                             ; rpushn: move the top cell of the data stack (in memory) to the return
00CC                             ; stack, then next. Everything that pushes the return stack ends here.
00CC                RPUSHN:      
00CC                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every word call, block
00CC                          ENDIF      ;   entry, loop-back and "{"
00CC   D9                     EXX      
00CD   D1                     POP   DE   
00CE   2B                     DEC   HL   
00CF   72                     LD   (HL),D   
00D0   2B                     DEC   HL   
00D1   73                     LD   (HL),E   
00D2   D9                     EXX      
00D3   F7                     RST   30h   
00D4                             ; ---- machine code: the grave -----------------------------------------------
00D4                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00D4                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00D4                             ; written and its address is left. An odd last digit is consumed and dropped.
00D4                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00D4                             ; code is entered by CALL with the data stack above the return address; it
00D4                             ; must keep BC, and on return the top cell becomes the new TOS.
00D4   CD 96 02     H_GRAVE:   CALL   hexc   
00D7   30 CE                  JR   NC,exec   
00D9                HX1:         
00D9                          IF   CHECKED   
                              CALL   chkst   
00D9                          ENDIF      
00D9   77                     LD   (HL),A   ; the high digit goes in first ...
00DA   CD 96 02               CALL   hexc   
00DD   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00DF   ED 6F                  RLD      ;   overwrites it
00E1   23                     INC   HL   ; ... and RLD shifts it up under the low one
00E2   CD 96 02               CALL   hexc   
00E5   38 F2                  JR   C,hx1   
00E7                HX2:         
00E7                          IF   CHECKED   
                              CALL   chkst   
00E7                          ENDIF      
00E7   36 C9                  LD   (HL),0C9h   
00E9   F7                     RST   30h   
00EA                             ; ---- where the two pages meet ----------------------------------------------
00EA                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00EA                             ; are in falling code order for this), and where exactly differs between the
00EA                             ; builds: NPG1 follows. Every handler below these four must start in the
00EA                             ; second page, and every one above in the first; chktab.py checks both.
00EA                             ; "]" returns: pop an address and jump to it.
00EA   CF           H_RET:    RST   08h   
00EB   42                     LD   B,D   
00EC   4B                     LD   C,E   
00ED   F7           BRK1:     RST   30h   
00EE                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00EE                             ; drops the block start, "]" returns. No closer at all ends the program.
00EE   7C           H_BREAK:   LD   A,H   
00EF   B5                     OR   L   
00F0   E1                     POP   HL   
00F1   28 FA                  JR   Z,brk1   
00F3   CD 63 02               CALL   skip   
00F6   B7                     OR   A   ; skip returns 0 for ")"
00F7   20 F1                  JR   NZ,h_ret   
00F9   CF           RDROP:    RST   08h   
00FA   F7                     RST   30h   
00FB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00FB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00FB                             ; the body"s address instead. Either way it then skips to the matching "]'.
00FB                             ; (The unchecked build takes anything that is not a letter as the space; the
00FB                             ; checked build stops on it.)
00FB   0A           H_DEF:    LD   A,(BC)   
00FC   03                     INC   BC   
00FD   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00FF   5F                     LD   E,A   ;   lands 64 bytes up
0100   E6 DF                  AND   0DFh   ; fold case
0102   FE 1A                  CP   26   
0104   30 0B                  JR   NC,def2   ; not a letter
0106   CB 23                  SLA   E   
0108   16 82                  LD   D,LETPAGE   ; DE -> cell
010A   79                     LD   A,C   
010B   12                     LD   (DE),A   
010C   1C                     INC   E   
010D   78                     LD   A,B   
010E   12                     LD   (DE),A   
010F   18 03                  JR   skipnx   
0111                DEF2:        
0111                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0111                          ENDIF      
0111   E5                     PUSH   HL   ; an anonymous block: push its address
0112   60                     LD   H,B   
0113   69                     LD   L,C   
0114   CD 63 02     SKIPNX:   CALL   skip   
0117   F7                     RST   30h   
0118   5E           H_FETCH:   LD   E,(HL)   ; "@"
0119   23                     INC   HL   
011A   56                     LD   D,(HL)   
011B   EB                     EX   DE,HL   
011C   F7                     RST   30h   
011D                             ; =============================================================================
011D                             ;  Handlers that must start in the image's second page.
011D                             ;  "?" is the last (with "," inside it), so its long tail may run past that
011D                             ;  page.
011D                             ; =============================================================================
011D                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
011D                             ; the matching ")".
011D   7C           H_OPEN:   LD   A,H   
011E   B5                     OR   L   
011F   E1                     POP   HL   
0120   28 F2                  JR   Z,skipnx   
0122   C5                     PUSH   BC   ; the block starts at the IP
0123   18 A7                  JR   rpushn   
0125                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0125                             ; drops it and carries on.
0125   7C           H_CLOSE:   LD   A,H   
0126   B5                     OR   L   
0127   E1                     POP   HL   
0128   28 CF                  JR   Z,rdrop   
012A   CF                     RST   08h   ; pop the block start ...
012B   42                     LD   B,D   
012C   4B                     LD   C,E   
012D   C5                     PUSH   BC   
012E   18 9C                  JR   rpushn   ; ... and push it back
0130                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0130                             ; "-" has two jobs: directly before a digit it starts a negative number.
0130   0A           H_SUB:    LD   A,(BC)   
0131   D6 30                  SUB   "0"   
0133   FE 0A                  CP   10   
0135   38 04                  JR   C,negnum   
0137   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0138   D1           H_ADD:    POP   DE   
0139   19                     ADD   HL,DE   
013A   F7                     RST   30h   
013B   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
013C   CD 41 02               CALL   rdnum   
013F   E7                     RST   20h   
0140   F7                     RST   30h   
0141   D1           H_AND:    POP   DE   
0142   7C                     LD   A,H   
0143   A2                     AND   D   
0144   67                     LD   H,A   
0145   7D                     LD   A,L   
0146   A3                     AND   E   
0147   6F                     LD   L,A   
0148   F7                     RST   30h   
0149                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0149                             ; cells first. Flipping both sign bits turns a signed compare into an
0149                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0149                             ; carry into -1 or 0 with no branch.
0149   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
014A   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
014B   7C                     LD   A,H   
014C   EE 80                  XOR   80h   
014E   67                     LD   H,A   
014F   7A                     LD   A,D   
0150   EE 80                  XOR   80h   
0152   57                     LD   D,A   
0153   ED 52                  SBC   HL,DE   ; carry if HL < DE
0155   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0157   F7                     RST   30h   
0158   D1           H_EQ:     POP   DE   
0159   B7                     OR   A   
015A   ED 52                  SBC   HL,DE   
015C   7C                     LD   A,H   
015D   B5                     OR   L   
015E   FE 01                  CP   1   ; carry only if a - b = 0
0160   18 F3                  JR   tf   
0162                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0162                             ; multiplier shifts up through A:C.
0162   D1           H_MUL:    POP   DE   ; DE = multiplicand
0163   C5                     PUSH   BC   
0164   7C                     LD   A,H   
0165   4D                     LD   C,L   ; A:C = multiplier
0166   21 00 00               LD   HL,0   
0169   06 10                  LD   B,16   
016B   29           MUL1:     ADD   HL,HL   
016C   CB 21                  SLA   C   
016E   17                     RLA      
016F   30 01                  JR   NC,mul2   
0171   19                     ADD   HL,DE   
0172   10 F7        MUL2:     DJNZ   mul1   
0174   C1                     POP   BC   
0175   F7                     RST   30h   
0176                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0176                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0176                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0176   D1           H_DIV:    POP   DE   ; DE = a, HL = b
0177   C5                     PUSH   BC   ; free BC for udiv
0178   D5                     PUSH   DE   ; a, for r's sign
0179   7A                     LD   A,D   
017A   AC                     XOR   H   
017B   F5                     PUSH   AF   ; S flag = sign of q
017C   CB 7C                  BIT   7,H   
017E   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0181   EB                     EX   DE,HL   
0182   CB 7C                  BIT   7,H   
0184   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0187   CD 1B 02               CALL   udiv   ; HL = q, DE = r
018A   F1                     POP   AF   
018B   FC 20 00               CALL   M,neg16   ; q's sign
018E   EB                     EX   DE,HL   ; HL = r, DE = q
018F   F1                     POP   AF   ; A = a's high byte
0190   B7                     OR   A   
0191   FC 20 00               CALL   M,neg16   ; r's sign
0194   C1                     POP   BC   
0195   D5                     PUSH   DE   ; q under r
0196   F7                     RST   30h   
0197                             ; ---- stack and storage -----------------------------------------------------
0197   E5           H_DUP:    PUSH   HL   ; ":"
0198   F7                     RST   30h   
0199   E3           H_SWAP:   EX   (SP),HL   ; "%"
019A   F7                     RST   30h   
019B   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
019C                          IF   CHECKED   
                              CALL   chkst   
019C                          ENDIF      
019C   73                     LD   (HL),E   
019D   DF           H_DROP:   RST   18h   ; ";" is this one byte
019E   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
019F                          IF   CHECKED   
                              INC   HL   ; both bytes must be in the program's space
                              CALL   chkst   
                              DEC   HL   
019F                          ENDIF      
019F   73                     LD   (HL),E   
01A0   23                     INC   HL   
01A1   72                     LD   (HL),D   
01A2   DF                     RST   18h   
01A3                             ; ---- console ---------------------------------------------------------------
01A3                             ; 22h pushes the address of the text after it and skips the string.
01A3   E5           H_STR:    PUSH   HL   
01A4   60                     LD   H,B   
01A5   69                     LD   L,C   
01A6   CD 58 02               CALL   skipstr   
01A9   F7                     RST   30h   
01AA                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01AA                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01AA                             ; bit 6, so // and /" give themselves).
01AA   7E           H_PRINT:   LD   A,(HL)   
01AB   23                     INC   HL   
01AC   FE 22                  CP   22h   
01AE   28 0D                  JR   Z,pr9   
01B0   FE 2F                  CP   "/"   
01B2   20 04                  JR   NZ,pr1   
01B4   7E                     LD   A,(HL)   
01B5   23                     INC   HL   
01B6   E6 BF                  AND   0BFh   
01B8   EF           PR1:      RST   28h   
01B9   18 EF                  JR   h_print   
01BB   7D           H_EMIT:   LD   A,L   ; "'"
01BC   EF                     RST   28h   
01BD   DF           PR9:      RST   18h   
01BE                             ; "#" prints TOS as a signed decimal number, with no space after it.
01BE   CB 7C        H_NUM:    BIT   7,H   
01C0   28 04                  JR   Z,num1   
01C2   3E 2D                  LD   A,"-"   
01C4   EF                     RST   28h   
01C5   E7                     RST   20h   
01C6   C5           NUM1:     PUSH   BC   
01C7   CD 84 02               CALL   pdec   
01CA   C1                     POP   BC   
01CB   DF                     RST   18h   
01CC                             ; "?" ( n -- c ) or ( -n -- addr )
01CC                             ;   n > 0: wait about n ms for a key; 0 if none came
01CC                             ;   n = 0: wait for a key
01CC                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01CC                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01CC   CB 7C        H_KEY:    BIT   7,H   
01CE   20 19                  JR   NZ,line   
01D0   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01D2   CD 06 FF     KT2:      CALL   getk   
01D5   20 0E                  JR   NZ,kt3   
01D7   1D                     DEC   E   
01D8   20 F8                  JR   NZ,kt2   
01DA   7C                     LD   A,H   ; 0? never counts down: it waits
01DB   B5                     OR   L   
01DC   28 F2                  JR   Z,kt1   
01DE   2B                     DEC   HL   
01DF   7C                     LD   A,H   
01E0   B5                     OR   L   
01E1   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01E3   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01E4   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01E5   6F           KT3:      LD   L,A   
01E6   26 00                  LD   H,0   
01E8   F7                     RST   30h   
01E9                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
01E9                          ENDIF      
01E9                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
01E9                          ENDIF      
01E9                          IF   CPM   
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01E9                          ENDIF      
01E9                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
01E9                          ENDIF      
01E9                          IF   CPM*EDITOR   
                              RET      
01E9                          ENDIF      
01E9                          IFN   CPM   
01E9                             ; Generic: Backspace takes the last character back (and is echoed as
01E9                             ; it is), CR ends (stored, not echoed), every other key is stored and
01E9                             ; echoed until the line is full. The line buffer starts at offset 80h
01E9                             ; of its page, so L alone is the place in the line: D holds the L of
01E9                             ; a full line.
01E9                          ENDIF      
01E9                          IFN   CPM   
01E9   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01EC   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01ED   9F                     SBC   A,A   
01EE   A5                     AND   L   ; (0 for a count that is too big)
01EF   2F                     CPL      
01F0   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01F1                          ENDIF      ;   at most
01F1                          IF   EDGEN   
01F1   CD F7 01               CALL   rdline   ; (the editor calls rdline too)
01F4   2E 80                  LD   L,LINEBUF & 0FFh   
01F6   F7                     RST   30h   
01F7                             ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
01F7                RDLINE:      
01F7                          ENDIF      
01F7                          IFN   CPM   
01F7   21 80 82               LD   HL,LINEBUF   
01FA   CD 06 FF     LN2:      CALL   getk   
01FD   28 FB                  JR   Z,ln2   
01FF   FE 0D                  CP   13   
0201   28 16                  JR   Z,ln5   
0203   FE 08                  CP   8   
0205   28 0B                  JR   Z,ln4   
0207   5F                     LD   E,A   
0208   7D                     LD   A,L   
0209   BA                     CP   D   
020A   28 EE                  JR   Z,ln2   ; full
020C   73                     LD   (HL),E   
020D   2C                     INC   L   
020E   7B                     LD   A,E   
020F   EF           LN3:      RST   28h   
0210   18 E8                  JR   ln2   
0212   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0213   FA 0F 02               JP   M,ln3   ;   unless the line was empty (L left the
0216   2C                     INC   L   ;   upper half of the page)
0217   18 E1                  JR   ln2   
0219   77           LN5:      LD   (HL),A   ; the CR
021A                          ENDIF      
021A                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
021A                          ENDIF      
021A                          IF   EDGEN   
021A   C9                     RET      
021B                          ENDIF      
021B                             ; =============================================================================
021B                             ;  More routines (no handler starts past this point)
021B                             ; =============================================================================
021B                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
021B                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
021B                             ; while the quotient bits arrive at the bottom of C.
021B                             ; Dividing by 2 is one shift (the spec wants that fast).
021B   7B           UDIV:     LD   A,E   
021C   EE 02                  XOR   2   
021E   B2                     OR   D   
021F   20 07                  JR   NZ,udv0   
0221   CB 3C                  SRL   H   
0223   CB 1D                  RR   L   ; the quotient
0225   8F                     ADC   A,A   
0226   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0227   C9                     RET      
0228   7C           UDV0:     LD   A,H   
0229   4D                     LD   C,L   
022A   21 00 00               LD   HL,0   
022D   06 10                  LD   B,16   
022F   CB 21        UDV1:     SLA   C   
0231   17                     RLA      
0232   ED 6A                  ADC   HL,HL   
0234   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0236   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0238   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0239   0D                     DEC   C   ;   INC below
023A   0C           UDV2:     INC   C   ; a quotient bit
023B   10 F2                  DJNZ   udv1   
023D   EB                     EX   DE,HL   ; DE = remainder
023E   67                     LD   H,A   
023F   69                     LD   L,C   ; HL = quotient
0240   C9                     RET      
0241                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0241                             ; non-digit. Values wrap at 16 bits, as the spec says.
0241   21 00 00     RDNUM:    LD   HL,0   
0244   0A           RDN1:     LD   A,(BC)   
0245   D6 30                  SUB   "0"   
0247   FE 0A                  CP   10   
0249   D0                     RET   NC   
024A   03                     INC   BC   
024B   54                     LD   D,H   
024C   5D                     LD   E,L   
024D   29                     ADD   HL,HL   
024E   29                     ADD   HL,HL   
024F   19                     ADD   HL,DE   
0250   29                     ADD   HL,HL   ; HL * 10
0251   5F                     LD   E,A   
0252   16 00                  LD   D,0   
0254   19                     ADD   HL,DE   
0255   18 ED                  JR   rdn1   
0257                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0257                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0257   03           SS0:      INC   BC   
0258   0A           SKIPSTR:   LD   A,(BC)   
0259   03                     INC   BC   
025A   FE 2F                  CP   "/"   
025C   28 F9                  JR   Z,ss0   
025E   FE 22                  CP   22h   
0260   20 F6                  JR   NZ,skipstr   
0262   C9                     RET      
0263                             ; skip: read past text to the closer at this level, and return A = 0 if it
0263                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0263                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0263                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0263                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0263                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0263   16 00        SKIP:     LD   D,0   
0265   14           SK3:      INC   D   ; an opener: one deeper
0266   0A           SK1:      LD   A,(BC)   
0267   03                     INC   BC   
0268   B7                     OR   A   
0269   CA 15 00               JP   Z,endprog   
026C   FE 22                  CP   22h   
026E   CC 58 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0271   D6 28                  SUB   "("   
0273   28 F0                  JR   Z,sk3   
0275   3D                     DEC   A   ; ")"
0276   28 08                  JR   Z,sk4   
0278   D6 32                  SUB   "["-")"   
027A   28 E9                  JR   Z,sk3   
027C   FE 02                  CP   "]"-"["   
027E   20 E6                  JR   NZ,sk1   
0280   15           SK4:      DEC   D   
0281   C8                     RET   Z   ; the closer at this level
0282   18 E2                  JR   sk1   
0284                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0284                             ; Uses BC.
0284   11 0A 00     PDEC:     LD   DE,10   
0287   CD 1B 02               CALL   udiv   ; HL = HL / 10, E = the last digit
028A   7B                     LD   A,E   
028B   F5                     PUSH   AF   
028C   7C                     LD   A,H   
028D   B5                     OR   L   
028E   C4 84 02               CALL   NZ,pdec   
0291   F1                     POP   AF   
0292   C6 30                  ADD   A,"0"   
0294   EF                     RST   28h   
0295   C9                     RET      
0296                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0296                             ; and return its value in A with the carry set; otherwise leave the IP and
0296                             ; return with the carry clear.
0296   0A           HEXC:     LD   A,(BC)   
0297   D6 30                  SUB   "0"   
0299   FE 0A                  CP   10   
029B   38 09                  JR   C,hc1   
029D   E6 DF                  AND   0DFh   
029F   D6 11                  SUB   11h   
02A1   FE 06                  CP   6   
02A3   D0                     RET   NC   
02A4   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02A6   03           HC1:      INC   BC   
02A7   C9                     RET      
02A8                             ; =============================================================================
02A8                             ;  Dispatch table: the low byte of each handler's address, in code order
02A8                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02A8                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02A8                             ; =============================================================================
02A8                             ; The handlers of the first NPG1 characters start in the image's second page.
02A8                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02A8                             ; differs between the builds, so the count is worked out here.
02A8                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02A8                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02A8                PGBRK:    EQU   (h_break-BASE)/256   
02A8                PGDEF:    EQU   (h_def-BASE)/256   
02A8                PGFET:    EQU   (h_fetch-BASE)/256   
02A8                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02A8                          IF   1-TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02A8                          ENDIF      
02A8                             ; =============================================================================
02A8                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02A8                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
02A8                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
02A8                             ;  KEY and CONOUT routines themselves.
02A8                             ; =============================================================================
02A8                          IF   (1-CPM)*(1-CHECKED)   
02A8                GETK:     EQU   KEY   ; the host's routine does the whole job
02A8                          ENDIF      
02A8                          IF   CHECKED   
                    GETK:     PUSH   HL   ; a key held back by the break check goes
                              LD   HL,KEYBUF   ;   first, and is taken out of the buffer
                              LD   A,(HL)   
                              LD   (HL),0   
                              POP   HL   
                              OR   A   
                              RET   NZ   
02A8                          ENDIF      
02A8                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
02A8                          ENDIF      
02A8                          IF   CPM*(1-CHECKED)   
                    GETK:        
02A8                          ENDIF      
02A8                          IF   CPM   
                              LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
02A8                          ENDIF      
02A8                             ; =============================================================================
02A8                             ;  Checked build: the checks and the error report
02A8                             ; =============================================================================
02A8                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the pointer's
                                 ; high byte has left that page. Errors are caught one cell late at most; the
                                 ; page below each stack is a guard band. (The call itself is on the data
                                 ; stack, but in the same page whenever the stack is in range.)
                    CHKSTK:   LD   (SPTMP),SP   
                              LD   A,(SPTMP+1)   
                              CP   DSPAGE   
                              JR   NZ,e_stack   
                              EXX      ; the return stack: in its page, and not
                              LD   A,L   ;   above its empty position (an underflow
                              CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              LD   A,H   ;   guard band)
                              EXX      
                              JR   NC,e_rstack   
                              CP   RSPAGE   
                              RET   Z   
                              JR   e_rstack   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   CALL   getk   
                              RET   Z   
                              CP   3   
                              JR   Z,e_break   
                              LD   (KEYBUF),A   
                              RET      
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   AF   
                              LD   A,H   
                              CP   LETPAGE   
                              JR   C,e_store   
02A8                          ENDIF      
02A8                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              JR   NC,e_store   
02A8                          ENDIF      
02A8                          IF   CHECKED*CPM   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   H   
                              JR   C,e_store   
02A8                          ENDIF      
02A8                          IF   CHECKED   
                              POP   AF   
                              RET      
                                 ; chkhp: stop if working out the new heap top carried (a negative count
                                 ; wraps: too big), or if the new top in HL is not below the limit page.
                    CHKHP:    JR   C,e_heap   
02A8                          ENDIF      
02A8                          IF   CHECKED*(1-CPM)   
                              LD   A,H   
                              CP   HEAPLIM   
                              RET   C   
02A8                          ENDIF      
02A8                          IF   CHECKED*CPM   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              RET   NC   
02A8                          ENDIF      
02A8                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
                    E_HEAP:   LD   A,"H"   ; heap past the limit
                              DB   21h   
                    E_STORE:   LD   A,"W"   ; write outside the program's space
                              DB   21h   
                    E_STACK:   LD   A,"S"   ; data stack over or under
                              DB   21h   
                    E_RSTACK:   LD   A,"R"   ; return stack over or under
                              DB   21h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C
                              DB   21h   
                    E_BRACK:   LD   A,"D"   ; bad character after [
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                    ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
                              RST   28h   
                              LD   A," "   
                              RST   28h   
                              LD   A,"@"   
                              RST   28h   
                              LD   A," "   
                              RST   28h   
                              LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
                              ADD   HL,BC   ;   just read: HL = its offset
                              CALL   pdec   
                              JP   endprog   
02A8                          ENDIF      
02A8                             ; =============================================================================
02A8                             ;  The line editor (EDITOR = 1)
02A8                             ; 
02A8                             ;  The interpreter starts here, and a program that ends comes back here. Type
02A8                             ;  a line and press Return:
02A8                             ; 
02A8                             ;    n text    put the text in as line n; the lines from n on move down.
02A8                             ;              A number past the end, or 0, adds the line at the end.
02A8                             ;    n         take line n out
02A8                             ;    0         run the program
02A8                             ;    -n        list the program from line n on (-1 lists all of it). Any key
02A8                             ;              stops the list until another key is pressed; Ctrl-C ends it.
02A8                             ;    anything else is run at once, as B8Script. (Start such a line with a
02A8                             ;    space if it would begin with a digit or a minus sign.)
02A8                             ; 
02A8                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
02A8                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
02A8                             ;  125 characters, the line number and the one character after it included;
02A8                             ;  that character is not stored. The text is kept as it is typed, each line
02A8                             ;  ending in CR LF, at PROG. Nothing is checked.
02A8                             ; 
02A8                             ;  With CPM = 1 the file named on the command line is the program to start
02A8                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
02A8                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
02A8                             ;  CP/M. Nothing is written back: there is no command to save.
02A8                             ; 
02A8                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
02A8                             ;  its letter and place and comes back here. The place is counted from the
02A8                             ;  start of the program, so in a line typed here it is 65408 plus the
02A8                             ;  character's place in the line (the line buffer is 128 bytes below the
02A8                             ;  program).
02A8                             ; 
02A8                             ;  Things to know:
02A8                             ;    - Reset empties the program (generic builds).
02A8                             ;    - Words and variables last from one line to the next. A word's address
02A8                             ;      points into the program, so run the program again after editing it.
02A8                             ;    - Nothing is printed between a program's output and what is typed next.
02A8                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
02A8                             ;      a line that calls -n? and carries on afterwards runs what was typed.
02A8                             ;      (The stored program never comes back to the line, so it may.)
02A8                             ; =============================================================================
02A8                          IF   EDGEN*CHECKED   
                    INIT:     LD   (KEYBUF),A   ; (A = 0) reset: no key held back
                              JR   edit   
02A8                          ENDIF      
02A8                          IF   EDITOR   
02A8                             ; -n: list from line n. DE = the number of the line at HL.
02A8   03           LIST:     INC   BC   
02A9   CD 41 02               CALL   rdnum   ; HL = n
02AC   E5                     PUSH   HL   
02AD   CD 4C 03               CALL   find   
02B0   D1                     POP   DE   
02B1   7E           LI1:      LD   A,(HL)   
02B2   B7                     OR   A   
02B3   28 32                  JR   Z,edit   ; the end of the text
02B5   CD 06 FF               CALL   getk   
02B8   28 0D                  JR   Z,li3   ; no key: carry on
02BA   FE 03                  CP   3   
02BC   28 29                  JR   Z,edit   ; Ctrl-C
02BE   CD 06 FF     LI2:      CALL   getk   ; any other key: wait for one more
02C1   28 FB                  JR   Z,li2   
02C3   FE 03                  CP   3   
02C5   28 20                  JR   Z,edit   
02C7   E5           LI3:      PUSH   HL   
02C8   D5                     PUSH   DE   
02C9   EB                     EX   DE,HL   
02CA   CD 84 02               CALL   pdec   ; the line's number,
02CD   3E 20                  LD   A," "   
02CF   EF                     RST   28h   ;   a space,
02D0   D1                     POP   DE   
02D1   E1                     POP   HL   
02D2   13                     INC   DE   
02D3   CD 64 03               CALL   prl   ;   and the line
02D6   18 D9                  JR   li1   
02D8                             ; Take line n (in HL) out: copy everything after it down over it.
02D8   CD 4C 03     DEL:      CALL   find   
02DB   54                     LD   D,H   
02DC   5D                     LD   E,L   
02DD   CD 5A 03               CALL   nxl   ; HL -> the next line
02E0   7E           DE1:      LD   A,(HL)   
02E1   12                     LD   (DE),A   
02E2   23                     INC   HL   
02E3   13                     INC   DE   
02E4   B7                     OR   A   
02E5   20 F9                  JR   NZ,de1   ; and fall into the editor
02E7   31 FE 81     EDIT:     LD   SP,DSTOP   
02EA                          ENDIF      
02EA                          IF   EDITOR*CPM*CHECKED   
                                 ; A key that the break check held back while a program ran is let
                                 ; go: BDOS 10 would not see it, and it would turn up in the next
                                 ; program that asked for a key. (This also serves at the start.)
                              XOR   A   
                              LD   (KEYBUF),A   
02EA                          ENDIF      
02EA                          IF   EDGEN   
02EA   16 FD                  LD   D,0FDh   ; 125 characters at most
02EC                          ENDIF      
02EC                          IF   EDITOR*CPM   
                              LD   A,125   
02EC                          ENDIF      
02EC                          IF   EDITOR   
02EC   CD F7 01               CALL   rdline   ; HL -> the CR that ended the line
02EF   2C                     INC   L   
02F0   36 0A                  LD   (HL),10   ; a LF after it,
02F2   2D                     DEC   L   
02F3   CD 64 03               CALL   prl   ; (print the CR LF: a new line)
02F6   36 00                  LD   (HL),0   ;   and a NUL after that
02F8   E5                     PUSH   HL   ; the end of what was typed
02F9   01 80 82               LD   BC,LINEBUF   
02FC   0A                     LD   A,(BC)   
02FD   FE 2D                  CP   "-"   
02FF   28 A7                  JR   Z,list   
0301   CD 41 02               CALL   rdnum   ; HL = the number it starts with, BC -> after
0304   79                     LD   A,C   ; C is still 80h if there was no number:
0305   87                     ADD   A,A   ;   only then is twice it 0
0306   28 0C                  JR   Z,st0   ; no number: run the line where it is
0308   0A                     LD   A,(BC)   
0309   D6 0D                  SUB   13   
030B   20 19                  JR   NZ,ins   ; text follows the number
030D   B4                     OR   H   ; the number alone:
030E   B5                     OR   L   
030F   20 C7                  JR   NZ,del   ;   not 0: take that line out
0311   01 00 83               LD   BC,PROG   ;   0: run the program
0314                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0314   E1           ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
0315   21 00 83               LD   HL,PROG   
0318   AF                     XOR   A   
0319   BE           ST1:      CP   (HL)   
031A   23                     INC   HL   
031B   20 FC                  JR   NZ,st1   
031D   22 7C 82               LD   (HEAP),HL   
0320   D9                     EXX      
0321   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
0324   D9                     EXX      
0325   F7                     RST   30h   ; (its return address is thrown away)
0326                             ; Put the typed text in as line n (in HL): open a gap of its length there,
0326                             ; CR and LF included, and copy it in.
0326   CD 4C 03     INS:      CALL   find   ; HL -> where it goes
0329   03                     INC   BC   ; step over the one character after the number
032A   D1                     POP   DE   ; the end of what was typed
032B   7B                     LD   A,E   
032C   91                     SUB   C   ; A = the length of the text, with its CR LF
032D   C5                     PUSH   BC   ; the text
032E   4F                     LD   C,A   
032F   06 00                  LD   B,0   
0331   C5                     PUSH   BC   ; its length
0332   54                     LD   D,H   
0333   5D                     LD   E,L   ; DE = where it goes
0334   AF                     XOR   A   
0335   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0336   ED B1                  CPIR      ; HL -> one past the program's NUL
0338   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
033A   44                     LD   B,H   
033B   4D                     LD   C,L   
033C   19                     ADD   HL,DE   
033D   2B                     DEC   HL   ; HL -> the NUL
033E   EB                     EX   DE,HL   
033F   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0340   E5                     PUSH   HL   
0341   19                     ADD   HL,DE   ; the NUL's new place
0342   EB                     EX   DE,HL   
0343   ED B8                  LDDR      ; move the rest of the program up
0345   C1                     POP   BC   ; the length
0346   D1                     POP   DE   ; where it goes
0347   E1                     POP   HL   ; the text
0348   ED B0                  LDIR      
034A   18 9B                  JR   edit   
034C                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
034C                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
034C   EB           FIND:     EX   DE,HL   
034D   21 00 83               LD   HL,PROG   
0350   1B           FI1:      DEC   DE   
0351   7A                     LD   A,D   
0352   B3                     OR   E   
0353   C8                     RET   Z   
0354   CD 5A 03               CALL   nxl   
0357   20 F7                  JR   NZ,fi1   
0359   C9                     RET      
035A                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
035A                             ; stop at the NUL that ends the text (and return zero).
035A   7E           NXL:      LD   A,(HL)   
035B   B7                     OR   A   
035C   C8                     RET   Z   
035D   23                     INC   HL   
035E   FE 0A                  CP   10   
0360   20 F8                  JR   NZ,nxl   
0362   B7                     OR   A   
0363   C9                     RET      
0364                             ; prl: print the line at HL, to its LF; HL -> just past it.
0364   7E           PRL:      LD   A,(HL)   
0365   EF                     RST   28h   
0366   7E                     LD   A,(HL)   
0367   23                     INC   HL   
0368   FE 0A                  CP   10   
036A   20 F8                  JR   NZ,prl   
036C   C9                     RET      
036D                          ENDIF      
036D                             ; =============================================================================
036D                             ;  CP/M startup (the generic build starts at address 0: see st0)
036D                             ; =============================================================================
036D                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:    LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:         
036D                          ENDIF      
036D                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
036D                          ENDIF      
036D                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
036D                          ENDIF      
036D                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
036D                          ENDIF      
036D                IMGEND:      


