0297   E5           H_DUP:    PUSH   H   ; ":"
0298                          ;*Macro unroll:  NEXT
0298                          DS   (1-CPM)*(1-FAST),0F7h   
0298   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0299   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
029A   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
029B   E3           H_SWAP:   XTHL      ; "%"
029C                          ;*Macro unroll:  NEXT
029C                          DS   (1-CPM)*(1-FAST),0F7h   
029C   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
029D   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
029E   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
