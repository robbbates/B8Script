F2B9   1F 31        NEGT:     TFR   U,X   
F2BB   EC 84        NEGX:     LDD   ,X   ; negx: negate the cell at X
F2BD   40                     NEGA      
F2BE   50                     NEGB      
F2BF   82 00                  SBCA   #0   
F2C1   ED 84                  STD   ,X   
F2C3   39           NG9:      RTS      
F2C4   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F2C6   2A FB                  BPL   ng9   
F2C8   20 F1                  BRA   negx   
F2CA                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F2CA                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F2CA                             ; the TOS cell the remainder. The remainder is built in D (always < the
F2CA                             ; divisor, so 2R+1 fits in 16 bits).
F2CA   8E 00 10     UDIV:     LDX   #16   
F2CD   4F                     CLRA      
F2CE   5F                     CLRB      
