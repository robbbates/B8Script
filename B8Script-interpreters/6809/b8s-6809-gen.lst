F248   A7 01                  STA   1,X   
F24A   8C                     FCB   8Ch   ; (CMPX #: steps over the LDX)
F24B   AE C4        H_CSTORE:   LDX   ,U   ; "." ( c addr -- )
F24D                          IF   CHECKED   
                              JSR   chkst   
F24D                          ENDIF      
F24D   33 42                  LEAU   2,U   
F24F   37 06                  PULU   D   
F251   E7 84                  STB   ,X   
F253   39                     RTS      
F254                             ; "#" prints TOS as a signed decimal number, with no space after it.
