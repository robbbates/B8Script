  1267 000004DC 7421                <1>         jz      .wk8
  1268 000004DE 6A00                <1>         push    0
  1269 000004E0 8D454F              <1>         lea     eax,[V(v_cnt)]
  1270 000004E3 50                  <1>         push    eax
