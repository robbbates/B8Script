059B                             ; line, the cursor moves on, and the rest is printed again.
059B   47           INSC:     LD   B,A   
059C   7B                     LD   A,E   
059D   FE FD                  CP   0FDh   
059F   28 99                  JR   Z,ed1   ; the line is full: 125 characters
05A1   78                     LD   A,B   
05A2   EF                     RST   28h   
05A3   E5                     PUSH   HL   
05A4   7E           IC1:      LD   A,(HL)   
05A5   70                     LD   (HL),B   
05A6   47                     LD   B,A   
05A7   7D                     LD   A,L   
05A8   2C                     INC   L   
05A9   BB                     CP   E   
05AA   20 F8                  JR   NZ,ic1   
05AC   E1                     POP   HL   
05AD   2C                     INC   L   
05AE   1C                     INC   E   
05AF   53                     LD   D,E   
05B0   CD B5 05     IC2:      CALL   tail   
05B3   18 85                  JR   ed1   
