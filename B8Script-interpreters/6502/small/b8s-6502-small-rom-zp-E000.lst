                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_GT:    LDA   0,X   ; > (b < a)
                              CMP   2,X   
                              LDA   1,X   
                              SBC   3,X   
                              BVS   fgt1   
                              EOR   #80h   
                    FGT1:     ASL      
                              INX      
                              INX      
                              LDA   #0   
                              ADC   #0FFh   
                              STA   0,X   
                              STA   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
