  1023 000004F0 50                  <1>         push    eax
  1024 000004F1 FF755A              <1>         push    dword [V(v_hin)]
  1025 000004F4 FF55B6              <1>         call    [V(iat_ReadConsoleInputA)]
  1026 000004F7 807D4201            <1>         cmp     byte [V(v_rec)],1       ; KEY_EVENT
  1027 000004FB 75D9                <1>         jne     .wk1
