024D   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
024E                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
024E                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
024E                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
024E                             ; SBB A turns a carry into -1 or 0 with no branch.
024E   E3           H_GT:     XTHL      ; a > b  is  b < a
024F   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0250   7B                     MOV   A,E   
0251   95                     SUB   L   
0252   7A                     MOV   A,D   
0253   9C                     SBB   H   
