   385                              <1> 
   386                              <1> ; '_' ( n -- addr ): the heap pointer moves by n, a signed count; TOS is
   387                              <1> ; the old pointer. The checked build stops with H if the new top is not
   388                              <1> ; below the limit or is below the program's end (done in 32 bits, so a top
   389                              <1> ; that wraps round is caught too).
   390                              <1> %macro  ALLOCCODE 0
   391                              <1> alloc1: movzx   edx,word [ARENA+HEAP]
   392                              <1> %if CHECKED
   393                              <1>         movsx   eax,bx
   394                              <1>         add     eax,edx
   395                              <1>         cmp     eax,LIMIT
   396                              <1>         jae     e_heap
   397                              <1>         cmp     eax,[V(v_npend)]
   398                              <1>         jb      e_heap
   399                              <1> %endif
   400                              <1>         add     [ARENA+HEAP],bx
   401                              <1>         mov     bx,dx
   402                              <1>         jmp     ebp
   403                              <1> %endmacro
   404                              <1> 
   405                              <1> ; '/' ( a b -- q r ): truncates toward zero, and r takes a's sign: x86's
   406                              <1> ; IDIV does exactly that. It is done in 32 bits, so that -32768 / -1 (whose
   407                              <1> ; quotient, 32768, does not fit in 16) wraps as the spec says instead of
   408                              <1> ; faulting. Dividing by 0 skips the IDIV in an unchecked build (two cells of
   409                              <1> ; no meaning: a and its sign); the checked build stops with Z. (The handler
   410                              <1> ; itself in an unchecked build; in a checked one its body, div1.)
   411                              <1> %macro  DIVCODE 0
   412                              <1> %if CHECKED
   413                              <1>         test    bx,bx
   414                              <1>         jz      e_zero
   415                              <1> %endif
   416                              <1>         pop     eax
   417                              <1>         movsx   ecx,bx
   418                              <1>         cwde
   419                              <1>         cdq
   420                              <1> %if CHECKED=0
   421                              <1>         jecxz   %%z
   422                              <1> %endif
   423                              <1>         idiv    ecx
   424                              <1> %%z:    mov     bx,ax
   425                              <1>         push    ebx                     ; q
   426                              <1>         mov     bx,dx                   ; r on top
   427                              <1>         jmp     ebp
   428                              <1> %endmacro
   429                              <1> 
   430                              <1> ; PRLOOPCODE: the loop of '$' (h_print; in a checked build the routine
   431                              <1> ; prstr). It prints from EBX to the closing quote.
   432                              <1> %macro  PRLOOPCODE 0
   433                              <1> %%pr:   mov     al,[ebx]
   434                              <1>         inc     ebx
   435                              <1>         cmp     al,22h
   436                              <1> %if CHECKED
   437                              <1>         je      %%pr9
   438                              <1>         test    al,al
   439                              <1>         jz      e_dollar                ; a NUL first: Q
   440                              <1> %else
   441                              <1>         je      h_drop
   442                              <1> %endif
   443                              <1>         cmp     al,'/'
   444                              <1>         jne     prput
   445                              <1>         movzx   eax,byte [ebx]
   446                              <1>         inc     ebx
   447                              <1>         cmp     al,60h
   448                              <1>         jb      %%pr0
   449                              <1>         cmp     al,7Fh
   450                              <1>         jb      pesc
   451                              <1> %%pr0:  and     al,0BFh
   452                              <1> prput:  CALLP   putc                    ; (/~ comes here with its 'H')
   453                              <1>         jmp     %%pr
   454                              <1> %if CHECKED
   455                              <1> %%pr9:  ret
   456                              <1> %endif
   457                              <1> %endmacro
   458                              <1> 
   459                              <1> ; PESCCODE: prstr (checked builds) and the escapes of '$'. (After the
   460                              <1> ; bodies of '[' and '`' in an unchecked build, so that h_print's loop
   461                              <1> ; reaches pesc; after the report in a checked one.)
   462                              <1> %macro  PESCCODE 0
   463                              <1> %if CHECKED
   464                              <1> ; prstr: print the string at EBX, to its closing quote, decoding '/' (this
   465                              <1> ; is '$', and the texts of the report). EBX is left past the quote. A NUL
   466                              <1> ; first is an error: Q.
   467                              <1> prstr:  PRLOOPCODE
   468                              <1> PRLOOP  equ     prstr                   ; (where the escapes go back to)
   469                              <1> %else
   470                              <1> PRLOOP  equ     h_print
   471                              <1> %endif
   472                              <1> 
   473                              <1> ; /~ ( row col addr -- ): the two cells under the string's address go.
   474                              <1> ; It comes before pesc: from there the short jumps reach h_print's loop.
   475                              <1> ; In a checked build the loop is the routine prstr: its return address
   476                              <1> ; goes, and hp1 calls it again afterwards. There each /~ first looks that
   477                              <1> ; its two cells are there, and is s if not, before it prints anything.
   478                              <1> pat:
   479                              <1> %if CHECKED
   480                              <1>         pop     eax
   481                              <1>         lea     eax,[esp+8]             ; ESP + 8 at the empty mark or above:
   482                              <1>         cmp     eax,[V(v_dstop)]        ;   the row or the column isn't there
   483                              <1>         jae     e_under
   484                              <1> %endif
   485                              <1>         call    pcsi
   486                              <1>         pop     eax                     ; the column
   487                              <1>         xchg    eax,[esp]               ; the row (the column waits)
   488                              <1>         call    psgn1
   489                              <1>         mov     al,';'
   490                              <1>         CALLP   putc
   491                              <1>         pop     eax
   492                              <1>         call    psgn1
   493                              <1>         mov     al,'H'
   494                              <1> %if CHECKED
   495                              <1>         CALLP   putc
   496                              <1>         jmp     hp1
   497                              <1> %else
   498                              <1>         jmp     prput
   499                              <1> %endif
   500                              <1> 
   501                              <1> ; pesc: the escapes of '$'. EAX = the character after the '/', 60h to 7Eh,
   502                              <1> ; and EBX points past it. Each goes back into the loop (PRLOOP), but /~ has
   503                              <1> ; the stack to see to.
   504                              <1> ;    /a-/z   print the variable, as '#' does
   505                              <1> ;    /{      clear the screen, the cursor to the top left: ESC [ H ESC [ J
   506                              <1> ;    /}      clear from the cursor to the end of the line: ESC [ K
   507                              <1> ;    /|  /`  show the cursor, hide it: ESC [ ? 2 5 h, ESC [ ? 2 5 l
   508                              <1> ;    /~      ( row col -- ) the cursor to that row and column, from 0:
   509                              <1> ;            ESC [ row+1 ; col+1 H
   510                              <1> pesc:   cmp     al,7Eh
   511                              <1>         je      pat
   512                              <1>         push    PRLOOP                  ; (the others return into the loop)
   513                              <1>         cmp     al,7Bh
   514                              <1>         jae     pcon
   515                              <1>         cmp     al,60h
   516                              <1>         je      phide
   517                              <1>         mov     ax,[ARENA+LET-2*41h+eax*2]  ; a-z: the variable's cell (as in
   518                              <1>         jmp     psgn                    ;   `lower`)
   519                              <1> pcon:   mov     eax,[ptails-4*7Bh+eax*4] ; { | }
   520                              <1> pseq:   push    eax                     ; ESC [ and then the bytes of EAX
   521                              <1>         call    pcsi
   522                              <1>         pop     eax
   523                              <1>         jmp     pch
   524                              <1> phide:  mov     eax,6C35323Fh           ; ? 2 5 l
   525                              <1>         jmp     pseq
   526                              <1> ptails: dd      4A5B1B48h               ; {  H ESC [ J
   527                              <1>         dd      6835323Fh               ; |  ? 2 5 h
   528                              <1>         dd      4Bh                     ; }  K
   529                              <1> ; pcsi: print ESC [. pch: print the bytes of EAX, from the low one up to the
   530                              <1> ; last that is not 0 (at least one). Both use EAX.
   531                              <1> pcsi:   mov     eax,5B1Bh
   532                              <1> pch:    CALLP   putc
   533                              <1>         shr     eax,8
   534                              <1>         jnz     pch
   535                              <1>         ret
   536                              <1> %endmacro
   537                              <1> 
   538                              <1> ; =============================================================================
   539                              <1> ;  Punctuation handlers. PTAB holds one byte per character: its handler's
   540                              <1> ;  distance from hbase, so every handler starts in the 256 bytes from hbase
   541                              <1> ;  (PT checks it). Only the starts must be there: the last handler, '$',
   542                              <1> ;  runs on past the window, and '[', '`' (and '_' and '/' in a checked
   543                              <1> ;  build) are stubs that jump to their bodies after it. Each handler starts
   544                              <1> ;  with EBX = TOS and EAX, ECX, EDX free, and ends with JMP EBP.
   545                              <1> ;  (Two other layouts were tried: handlers 2-aligned with the table holding
   546                              <1> ;  half the distance, which costs a NOP after every handler of odd length,
   547                              <1> ;  about 22 bytes; and the Z80's two 256-byte windows, whose dispatcher is 7
   548                              <1> ;  bytes longer and whose handlers must be in table order, which costs near
   549                              <1> ;  jumps.)
   550                              <1> ; =============================================================================
   551                              <1> hbase:
   552                              <1> ; ']' returns: pop an address and jump to it.
   553 00000111 8B37                <1> h_ret:  mov     esi,[edi]
   554 00000113 AF                  <1> rdrop:  scasd                           ; drop the return stack's top
   555 00000114 FFE5                <1> nx:     jmp     ebp
   556                              <1> 
   557                              <1> ; '\' ( flag -- ): true skips to the next ')' or ']' at this level; ')'
   558                              <1> ; drops the block start, ']' returns. No closer at all ends the program.
   559 00000116 6685DB              <1> h_break:test    bx,bx
   560 00000119 5B                  <1>         pop     ebx
   561 0000011A 74F8                <1>         jz      nx
   562 0000011C E8DD040000          <1>         call    skip
   563 00000121 84C0                <1>         test    al,al                   ; skip returns 0 for ')'
   564 00000123 75EC                <1>         jnz     h_ret
   565 00000125 EBEC                <1>         jmp     rdrop
   566                              <1> 
   567                              <1> ; ')' ( flag -- ): true jumps back to the block start (and keeps it); false
   568                              <1> ; drops it and carries on. The loop-back looks at the break key.
   569 00000127 6685DB              <1> h_close:test    bx,bx
   570 0000012A 5B                  <1>         pop     ebx
   571 0000012B 74E6                <1>         jz      rdrop
   572 0000012D 8B37                <1>         mov     esi,[edi]
   573 0000012F EBCB                <1>         jmp     rpoll
   574                              <1> 
   575                              <1> ; '(' ( flag -- ): true pushes the block start and enters; false skips to
   576                              <1> ; the matching ')'.
   577 00000131 6685DB              <1> h_open: test    bx,bx
   578 00000134 5B                  <1>         pop     ebx
   579 00000135 0F84F1000000        <1>         jz      skipo
   580 0000013B 89F2                <1>         mov     edx,esi
   581 0000013D EBB8                <1>         jmp     rpush
   582                              <1> 
   583                              <1> ; '{' TOS to the return stack, '}' back.
   584 0000013F 89DA                <1> h_tor:  mov     edx,ebx
   585 00000141 5B                  <1>         pop     ebx
   586 00000142 EBB3                <1>         jmp     rpush
   587 00000144 53                  <1> h_fromr:push    ebx
   588 00000145 8B1F                <1>         mov     ebx,[edi]
   589 00000147 EBCA                <1>         jmp     rdrop
   590                              <1> 
   591                              <1> ; '@' fetches a cell.
   592 00000149 668B1B              <1> h_fetch:mov     bx,[ebx]
   593 0000014C FFE5                <1>         jmp     ebp
   594                              <1> 
   595                              <1> ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
   596                              <1> ; '-' has two jobs: directly before a digit it starts a negative number.
   597 0000014E 8A06                <1> h_sub:  mov     al,[esi]
   598 00000150 2C30                <1>         sub     al,'0'
   599 00000152 3C0A                <1>         cmp     al,10
   600 00000154 72B2                <1>         jb      negnum
   601 00000156 66F7DB              <1>         neg     bx                      ; a - b = a + (-b): on into '+'
   602 00000159 5A                  <1> h_add:  pop     edx
   603 0000015A 6601D3              <1>         add     bx,dx
   604 0000015D FFE5                <1>         jmp     ebp
   605                              <1> 
   606 0000015F 5A                  <1> h_and:  pop     edx
   607 00000160 6621D3              <1>         and     bx,dx
   608 00000163 FFE5                <1>         jmp     ebp
   609 00000165 5A                  <1> h_or:   pop     edx
   610 00000166 6609D3              <1>         or      bx,dx
   611 00000169 FFE5                <1>         jmp     ebp
   612 0000016B 5A                  <1> h_xor:  pop     edx
   613 0000016C 6631D3              <1>         xor     bx,dx
   614 0000016F FFE5                <1>         jmp     ebp
   615 00000171 66F7D3              <1> h_not:  not     bx
   616 00000174 FFE5                <1>         jmp     ebp
   617 00000176 5A                  <1> h_mul:  pop     edx
   618 00000177 660FAFDA            <1>         imul    bx,dx                   ; the low 16 bits, signed or not
   619 0000017B FFE5                <1>         jmp     ebp
   620                              <1> 
   621                              <1> ; Signed compares. '<' swaps the two cells and is then '>': a > b is b < a.
   622                              <1> ; Flipping both sign bits turns the signed compare into an unsigned one, and
   623                              <1> ; SBB turns the carry into -1 or 0 with no branch.
   624 0000017D 871C24              <1> h_lt:   xchg    ebx,[esp]
   625 00000180 5A                  <1> h_gt:   pop     edx                     ; DX = a, BX = b
   626 00000181 80F780              <1>         xor     bh,80h
   627 00000184 80F680              <1>         xor     dh,80h
   628 00000187 6639D3              <1>         cmp     bx,dx                   ; carry if b < a
   629 0000018A 6619DB              <1> tf:     sbb     bx,bx
   630 0000018D FFE5                <1>         jmp     ebp
   631 0000018F 5A                  <1> h_eq:   pop     edx
   632 00000190 6629D3              <1>         sub     bx,dx
   633 00000193 6683FB01            <1>         cmp     bx,1                    ; carry only if a - b = 0
   634 00000197 EBF1                <1>         jmp     tf
   635                              <1> 
   636                              <1> 
   637                              <1> %if CHECKED
   638 00000199 E9EA000000          <1> h_div:  jmp     div1                    ; ('/': its body is after the window)
   639                              <1> %else
   640                              <1> h_div:  DIVCODE
   641                              <1> %endif
   642                              <1> 
   643                              <1> ; ---- stack and storage -----------------------------------------------------
   644 0000019E 53                  <1> h_dup:  push    ebx
   645 0000019F FFE5                <1>         jmp     ebp
   646 000001A1 871C24              <1> h_swap: xchg    ebx,[esp]
