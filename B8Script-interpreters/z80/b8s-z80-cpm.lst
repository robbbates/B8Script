02E9   CD 5C 04     LN2:      CALL   getk   
02EC   28 FB                  JR   Z,ln2   
02EE   FE 0D                  CP   13   
02F0   28 16                  JR   Z,ln5   
02F2   FE 08                  CP   8   
02F4   28 0B                  JR   Z,ln4   
02F6   5F                     LD   E,A   
02F7   7D                     LD   A,L   
02F8   BA                     CP   D   
02F9   28 EE                  JR   Z,ln2   ; full
02FB   73                     LD   (HL),E   
02FC   2C                     INC   L   
02FD   7B                     LD   A,E   
