   555                              <1> ; ---- the grave --------------------------------------------------------------
   556                              <1> ; The grave is a prefix: with the character after it, it is one command.
   557                              <1> ; gtab holds each character with its handler's distance from gbase. A
   558                              <1> ; handler starts with AL = the character and EBX = TOS, and ends with JMP
   559                              <1> ; EBP. A character that is not in the table is unsafe: the unchecked build
   560                              <1> ; searches on through memory, the checked build stops with W.
   561                              <1> ;
   562                              <1> ;   `!  ( addr -- )        call the machine code at addr (the contract is below)
   563                              <1> ;   `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
   564                              <1> ;                          from addr until a non-hex character; then a RET
   565                              <1> ;                          (C3h) is written and its address is left. An odd
   566                              <1> ;                          last digit is consumed and its byte is
   567                              <1> ;                          overwritten by the RET. (Never range-checked.)
   568                              <1> ;   `'  ( -- )             new line: CR LF
   569                              <1> ;   `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
   570                              <1> ;   `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
   571                              <1> ;   `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
   572                              <1> ;   `.  ( -- addr )        the address of the random seed
   573                              <1> ;   `<  ( a b -- n )       the smaller of the two (signed)
   574                              <1> ;   `>  ( a b -- n )       the larger
   575                              <1> ;   `?  ( flag -- )        the cursor off (0) or on
   576                              <1> ;   `@  ( row col -- )     the cursor to that row and column, both from 0
   577                              <1> ;   `^  ( -- )             clear the screen and home the cursor
   578                              <1> ;   `_  ( -- )             clear from the cursor to the end of the line
   579                              <1> ;
   580                              <1> ; The four console codes send ANSI escape sequences: the startup has put
   581                              <1> ; the console in its virtual terminal mode, so it obeys them as a terminal
   582                              <1> ; does.
   583 000001DF AC                  <1> grave1: lodsb
   584 000001E0 BA[D7020000]        <1>         mov     edx,gtab-2
   585 000001E5 42                  <1> .g1:    inc     edx
   586 000001E6 42                  <1>         inc     edx
   587                              <1> %if CHECKED
   588                              <1>         cmp     byte [edx],0            ; the end of the table: W. The place
   589                              <1>         je      e_brack                 ;   is the character
