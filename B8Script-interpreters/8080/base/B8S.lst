078E   6F                     MOV   L,A   
078F   7C                     MOV   A,H   
0790   9A                     SBB   D   
0791   67                     MOV   H,A   
0792   C9                     RET      
0793                          ENDIF      
0793                             ; =============================================================================
0793                             ;  Startup
0793                             ; =============================================================================
0793                START:       
0793                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
0793                          ENDIF      
0793                          IF   QK   
0793   21 00 08               LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
0796   AF                     XRA   A   ;   start of 0000h matches no skip)
0797   77           SKC1:     MOV   M,A   
0798   2C                     INR   L   
0799   C2 97 07               JNZ   skc1   
079C                          ENDIF      
079C                          IF   CHECKED   
079C                             ; Clear the lower half of the letter page: every variable starts at
079C                             ; 0, every word cell holds 0000h, the address an undefined word is
079C                             ; caught at (see e_hi), and no key is held back.
079C   21 00 0B               LXI   H,LET   
079F   AF                     XRA   A   
07A0   77           INI1:     MOV   M,A   
07A1   2C                     INR   L   
07A2   F2 A0 07               JP   ini1   ; +00h to +7Fh
07A5                          ENDIF      
07A5                          IF   CPM   
07A5                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
07A5   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
07A8   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
07AA   CD 05 00               CALL   BDOS   ;   and the program is empty)
07AD   11 00 0C               LXI   D,PROG   
07B0   D5           LD1:      PUSH   D   
07B1   0E 1A                  MVI   C,26   ; set the DMA address
07B3   CD 05 00               CALL   BDOS   
07B6   11 5C 00               LXI   D,005Ch   
07B9   0E 14                  MVI   C,20   ; read the next 128 bytes
07BB   CD 05 00               CALL   BDOS   
07BE   E1                     POP   H   ; HL = the address this record went to
07BF   B7                     ORA   A   
07C0   C2 CB 07               JNZ   ld2   
07C3   11 80 00               LXI   D,128   
07C6   19                     DAD   D   
07C7   EB                     XCHG      
07C8   C3 B0 07               JMP   ld1   
07CB   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
07CD   23                     INX   H   ; the heap starts after it
07CE                          ENDIF      
07CE                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
07CE                          ENDIF      
07CE   22 7C 0B               SHLD   HEAP   
07D1                          IF   CHECKED   
07D1                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
07D1                          DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
07D1   CD                     DS   CPM,0CDh   
07D2   27                     DS   CPM,ANEG&0FFh   
07D3   01                     DS   CPM,ANEG/256   
07D4   22 38 0B               SHLD   NPEND   ;   release below it
07D7                          ENDIF      
07D7   21 E0 09               LXI   H,RSTOP   ; the return stack is empty
07DA   22 34 0B               SHLD   RSP   
07DD                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
07DD                          ENDIF      ;   checked build has cleared these)
07DD                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
07DD                          ENDIF      
07DD                          IF   1-CHECKED   
                              SHLD   KEYBUF   
07DD                          ENDIF      
07DD   01 00 0C               LXI   B,PROG   ; the IP
07E0                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
07E0                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
07E0   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
07E1   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
07E2   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
07E3                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
                                 ; 
                                 ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
                                 ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
                                 ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
                                 ;  the letters and digits have one entry each, which knows its cell or its
                                 ;  value already.
                                 ; =============================================================================
                    FTSTORE:   XCHG      ; !
                              JMP   h_store   
                    FTSTR:    XCHG      ; "
                              JMP   h_str   
                    FTNUM:    XCHG      ; #
                              JMP   h_num   
                    FTPRINT:   XCHG      ; $
                              JMP   h_print   
                    FTEMIT:   XCHG      ; '
                              JMP   h_emit   
                    FTCSTORE:   XCHG      ; .
                              JMP   h_cstore   
                    FTDIV:    XCHG      ; /
                              JMP   h_div   
                    FTKEY:    XCHG      ; ?
                              JMP   h_key   
                    FTDEF:    XCHG      ; [
                              JMP   h_def   
                    FTBREAK:   XCHG      ; \
                              JMP   h_break   
                    FTALLOC:   XCHG      ; _
                              JMP   h_alloc   
                    FTGRAVE:   XCHG      ; `
                              JMP   h_grave   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:   POP   H   ; +
                              DAD   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:   LDAX   B   ; -
                              SUI   "0"   
                              CPI   10   
                              JC   fs_neg   
                              POP   H   
                              MOV   A,L   
                              SUB   E   
                              MOV   E,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   D,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   XCHG      ; a digit next: a negative number
                              JMP   negnum   
                    FS_DUP:   PUSH   D   ; :
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:   POP   H   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
