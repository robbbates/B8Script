E82A                          IF   QK*(1-FAST)   
                                 ; (QK: with an operand below 256, 8 rounds, not 16: that one becomes the
                                 ; multiplier, so the product's low byte comes out of TL and its high byte is
                                 ; left in T0. Most multiplications have one: a count or a small constant.)
                    H_MUL:    LDA   TH   
                              BEQ   mq8   ; the multiplier is below 256
                              LDA   DSH,X   
                              BNE   mq16   
                              JSR   h_swap   ; the multiplicand is: it becomes the multiplier
                    MQ8:      LDY   #8   
                              LDA   #0   
                              STA   T0   
                              LSR   TL   
                    MQ1:      BCC   mq2   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              LDA   T1   
                              ADC   DSH,X   
                    MQ2:      ROR      
                              ROR   T0   
                              ROR   TL   
                              DEY      
                              BNE   mq1   
                              LDA   T0   
                              STA   TH   
                              INX      
                              RTS      
                    MQ16:        
E82A                          ENDIF      
E82A                          IF   1-QK   
                    H_MUL:       
E82A                          ENDIF      
E82A                          IF   1-FAST   
                              LDY   #16   ; the round count
                              LDA   #0   
                              STA   T0   ; A:T0 = the upper half
                              LSR   TH   
                              ROR   TL   ; the first multiplier bit
                    ML1:      BCC   ml2   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              LDA   T1   
                              ADC   DSH,X   ; upper half += the multiplicand
                    ML2:      ROR      
                              ROR   T0   
                              ROR   TH   
                              ROR   TL   ; everything one place right; next bit out
                              DEY      
                              BNE   ml1   
                              INX      ; drop the multiplicand
                              RTS      
E82A                          ENDIF      
E82A   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E82D   A5 02                  LDA   TL   
E82F   9D 00 02               STA   DSL,X   
E832   84 02                  STY   TL   
E834   BC 00 03               LDY   DSH,X   
E837   A5 03                  LDA   TH   
E839   9D 00 03               STA   DSH,X   
E83C   84 03                  STY   TH   
E83E   60                     RTS      
E83F                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E83F                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b, r is pushed
E83F                             ; and gets the sign of a. Unchecked, dividing by zero returns two cells of no
E83F                             ; meaning; checked, it stops with Z.
E83F                H_DIV:       
E83F                          IF   CHECKED   
                              LDA   TL   
                              ORA   TH   
                              BEQ   e_zero   
E83F                          ENDIF      
E83F   BD 00 03               LDA   DSH,X   
E842   48                     PHA      ; a's sign: for r
E843   45 03                  EOR   TH   
E845   48                     PHA      ; a xor b: for q
E846   20 CE E5               JSR   absv   
E849   A5 02                  LDA   TL   
E84B   85 08                  STA   D0   
E84D   A5 03                  LDA   TH   
E84F   85 09                  STA   D1   ; D = |b|
E851   20 76 E5               JSR   drop   ; TOS = a
E854   20 CE E5               JSR   absv   ; TOS = |a|
E857   20 80 E8               JSR   udiv   ; TOS = q, T0/T1 = r
E85A   68                     PLA      
E85B   20 D0 E5               JSR   negm   ; q's sign
E85E   A5 04                  LDA   T0   
E860   A4 05                  LDY   T1   
E862   20 0A E3               JSR   pushay   ; r on top
E865   68                     PLA      
E866   4C D0 E5               JMP   negm   ; r's sign
E869                             ; =============================================================================
E869                             ;  Storage
E869                             ; =============================================================================
E869                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E869                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E869                          IF   1-CHECKED   
E869   AD 7C 04     H_ALLOC:   LDA   HEAP   
E86C   A8                     TAY      
E86D   65 02                  ADC   TL   
E86F   8D 7C 04               STA   HEAP   
E872   84 02                  STY   TL   
E874   AD 7D 04               LDA   HEAP+1   
E877   A8                     TAY      
E878   65 03                  ADC   TH   
E87A   8D 7D 04               STA   HEAP+1   
E87D   84 03                  STY   TH   
E87F   60                     RTS      
E880                          ENDIF      
E880                             ; The checked build works the new top out first, in T0 and Y, and stops with
E880                             ; H, the count still on the stack, if it is at or past the limit, below the
E880                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E880                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E880                             ; a signed number from -8000h, so the add overflows exactly when the true
E880                             ; sum leaves 0000h-FFFFh.
E880                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   TL   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   TH   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   TL   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   TH   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_ZERO:   LDA   #"Z"   ; divide by zero
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the page in A is in the program's own space, from the
                                 ; letter page up to the heap limit. Keeps Y.
                    CHKST:    CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              RTS      
E880                          ENDIF      
E880                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and T0/T1
E880                             ; the remainder. The low byte of each trial subtraction waits on the
E880                             ; hardware stack.
E880                             ; Dividing by 2 is one shift (the spec wants that fast).
E880   A9 00        UDIV:     LDA   #0   
E882   85 04                  STA   T0   
E884   85 05                  STA   T1   
E886                          IF   1-QK   
                              LDA   D0   
                              EOR   #2   
                              ORA   D1   
                              BNE   ud0   
                              LSR   TH   
                              ROR   TL   ; the quotient
                              ROL   T0   ; the remainder: the bit that fell out
                              RTS      
E886                          ENDIF      
E886                          IF   QK   
E886                             ; (QK: any power of two is shifts: 2, and 32, 64, 256 and the like, which
E886                             ; fixed point and byte work use all the time.)
E886   A4 08                  LDY   D0   
E888   A5 09                  LDA   D1   
E88A   D0 12                  BNE   uq1   ; 256 and up
E88C   98                     TYA      
E88D   F0 38                  BEQ   ud0   ; by 0: the long way (it means nothing anyway)
E88F   88                     DEY      
E890   98                     TYA      
E891   25 08                  AND   D0   
E893   D0 32                  BNE   ud0   ; not a power of two
E895   98                     TYA      ; by 2^k below 256: r = a & (2^k - 1),
E896   25 02                  AND   TL   
E898   85 04                  STA   T0   
E89A   A5 08                  LDA   D0   ;   and q = a >> k
E89C   D0 1E                  BNE   uq2   ; always
E89E   98           UQ1:      TYA      
E89F   D0 26                  BNE   ud0   ; not a power of two
E8A1   A4 09                  LDY   D1   
E8A3   88                     DEY      
E8A4   98                     TYA      
E8A5   25 09                  AND   D1   
E8A7   D0 1E                  BNE   ud0   ; not a power of two
E8A9   98                     TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
E8AA   25 03                  AND   TH   
E8AC   85 05                  STA   T1   
E8AE   A5 02                  LDA   TL   
E8B0   85 04                  STA   T0   
E8B2   A5 03                  LDA   TH   ;   and q = (a >> 8) >> (k - 8)
E8B4   85 02                  STA   TL   
E8B6   A9 00                  LDA   #0   
E8B8   85 03                  STA   TH   
E8BA   A5 09                  LDA   D1   
E8BC   4A           UQ2:      LSR      ; a bit of 2^k: one shift for each 0 below
E8BD   B0 07                  BCS   uq9   ;   the 1
E8BF   46 03        UQ3:      LSR   TH   
E8C1   66 02                  ROR   TL   
E8C3   4A                     LSR      
E8C4   90 F9                  BCC   uq3   
E8C6   60           UQ9:      RTS      
E8C7                          ENDIF      
