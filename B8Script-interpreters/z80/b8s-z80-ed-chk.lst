0680   CD 62 04               CALL   pnl   
0683   50 72 6F 67 20 22      DB   "Prog ",22h   
0689   CD 9B 02               CALL   pdec   ; the program's size
068C   E1                     POP   HL   
068D   CD 62 04               CALL   pnl   
0690   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
0697   CD 9B 02               CALL   pdec   
069A   D1                     POP   DE   
069B                          ENDIF      
069B                          IF   EDGEN   
069B   21 FF EF               LD   HL,HEAPLIM*256-1   
069E                          ENDIF      
069E                          IF   EDITOR*CPM   
                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
069E                          ENDIF      
069E                          IF   EDITOR   
069E   B7                     OR   A   
069F   ED 52                  SBC   HL,DE   
06A1   CD 62 04               CALL   pnl   
06A4   46 72 65 65 20 22      DB   "Free ",22h   
06AA   CD 9B 02               CALL   pdec   ; the room left for text and heap
06AD   CD 62 04               CALL   pnl   
06B0   22                     DB   22h   
06B1   C3 BE 04     GED1:     JP   edit   
06B4                             ; delln: take line n (in HL) out: copy everything after it down over it.
06B4   CD C4 06     DELLN:    CALL   find   
06B7   54                     LD   D,H   
06B8   5D                     LD   E,L   
06B9   CD D2 06               CALL   nxl   ; HL -> the next line
06BC   7E           DE1:      LD   A,(HL)   
06BD   12                     LD   (DE),A   
06BE   23                     INC   HL   
06BF   13                     INC   DE   
06C0   B7                     OR   A   
06C1   20 F9                  JR   NZ,de1   
06C3   C9                     RET      
06C4                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
06C4                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
06C4   EB           FIND:     EX   DE,HL   
06C5   21 00 83               LD   HL,PROG   
06C8   1B           FI1:      DEC   DE   
06C9   7A                     LD   A,D   
06CA   B3                     OR   E   
06CB   C8                     RET   Z   
06CC   CD D2 06               CALL   nxl   
06CF   20 F7                  JR   NZ,fi1   
06D1   C9                     RET      
06D2                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
06D2                             ; stop at the NUL that ends the text (and return zero).
06D2   7E           NXL:      LD   A,(HL)   
06D3   B7                     OR   A   
06D4   C8                     RET   Z   
06D5   23                     INC   HL   
06D6   FE 0A                  CP   10   
06D8   20 F8                  JR   NZ,nxl   
06DA   B7                     OR   A   
06DB   C9                     RET      
06DC                             ; prl: print the line at HL, to its LF; HL -> just past it.
06DC   7E           PRL:      LD   A,(HL)   
06DD   EF                     RST   28h   
06DE   7E                     LD   A,(HL)   
06DF   23                     INC   HL   
06E0   FE 0A                  CP   10   
06E2   20 F8                  JR   NZ,prl   
06E4   C9                     RET      
06E5                          ENDIF      
06E5                          IF   EDGEN   
06E5                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
06E5                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
06E5                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
06E5                             ; line with no end is given one. Nothing is echoed, and there is no check
06E5                             ; for running out of memory.
06E5   21 FF 82     CREAD:    LD   HL,PROG-1   
06E8   3E 0A                  LD   A,10   
06EA   FE                     DB   0FEh   ; (CP n: steps over the LD A,13)
06EB   3E 0D        RD1:      LD   A,13   ; a LF alone ends a line
06ED   77           RD2:      LD   (HL),A   
06EE   23                     INC   HL   
06EF   FE 0D                  CP   13   
06F1   3E 0A                  LD   A,10   
06F3   28 F8                  JR   Z,rd2   ; after a CR goes a LF
06F5   CD 5E 05     RD3:      CALL   ekey   
06F8   FE 1A                  CP   1Ah   
06FA   28 0B                  JR   Z,rd4   
06FC   FE 0A                  CP   10   
06FE   20 ED                  JR   NZ,rd2   
0700   2B                     DEC   HL   
0701   BE                     CP   (HL)   
0702   23                     INC   HL   
0703   28 F0                  JR   Z,rd3   ; (the LF is dropped)
0705   18 E4                  JR   rd1   
0707   2B           RD4:      DEC   HL   
0708   7E                     LD   A,(HL)   
0709   23                     INC   HL   
070A   FE 0A                  CP   10   
070C   28 06                  JR   Z,rd5   
070E   36 0D                  LD   (HL),13   
0710   23                     INC   HL   
0711   36 0A                  LD   (HL),10   
0713   23                     INC   HL   
0714   36 00        RD5:      LD   (HL),0   
0716   18 99                  JR   ged1   
0718                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
0718   21 00 83     CWRITE:   LD   HL,PROG   
071B   7E           CW1:      LD   A,(HL)   
071C   B7                     OR   A   
071D   28 92                  JR   Z,ged1   
071F   EF                     RST   28h   
0720   23                     INC   HL   
0721   18 F8                  JR   cw1   
0723                          ENDIF      
0723                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record.
                    CWRITE:   CALL   setname   
                              CALL   fcbclr   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              INC   A   
                              JP   Z,edit   ; no room in the directory
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              PUSH   DE   
                              LD   C,26   ; set the DMA address: the record is written
                              CALL   BDOS   ;   from where it lies
                              LD   C,21   ; write
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the CFCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              RET   Z   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              RET   Z   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                                 ; fcbclr: clear the CFCB after its name, as it must be before a file is opened
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF.
                    LOAD:     CALL   fcbclr   
                              LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   C,20   ; read the next 128 bytes
                              CALL   fbdos   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0723                          ENDIF      
0723                             ; =============================================================================
0723                             ;  CP/M startup (the generic build starts at address 0: see st0)
0723                             ; =============================================================================
0723                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0723                          ENDIF      
0723                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0723                          ENDIF      
0723                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
0723                          ENDIF      
0723                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0723                          ENDIF      
0723                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0723                          ENDIF      
0723                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0723                          ENDIF      
0723                IMGEND:      


