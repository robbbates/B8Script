E1AC   A9 00                  LDA   #0   
E1AE   95 01                  STA   1,X   
E1B0   60                     RTS      
E1B1                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E1B1                             ; drops it and carries on. It uses "]"s code, entered past its SEC: with the
E1B1                             ; carry clear, as it is here, the address popped is pushed back.
E1B1   20 16 E6     H_CLOSE:   JSR   flag   
E1B4   F0 6E                  BEQ   rdrop   
E1B6                          IF   1-QK   
                              BNE   ret1   ; always
E1B6                          ENDIF      
E1B6                          IF   QK   
E1B6   4C 86 E3               JMP   closeq   ; (QK: see Speed-ups)
E1B9                          ENDIF      
E1B9                             ; "?" ( n -- c ) or ( -n -- addr )
E1B9                             ;   n > 0: wait about n ms for a key; 0 if none came
E1B9                             ;   n = 0: wait for a key
E1B9                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E1B9                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E1B9   B5 01        H_KEY:    LDA   1,X   
E1BB   30 1E                  BMI   line   
E1BD   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E1BF   20 5F E5     KT2:      JSR   getk   
E1C2   D0 E6                  BNE   seta   
E1C4   88                     DEY      
E1C5   D0 F8                  BNE   kt2   
E1C7   B5 00                  LDA   0,X   ; count the millisecond off:
E1C9   D0 06                  BNE   kt4   
E1CB   B5 01                  LDA   1,X   
E1CD   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E1CF   D6 01                  DEC   1,X   
E1D1   D6 00        KT4:      DEC   0,X   
E1D3   D0 E8                  BNE   kt1   
E1D5   B5 01                  LDA   1,X   
E1D7   D0 E4                  BNE   kt1   
E1D9   F0 CF                  BEQ   seta   ; always: the time ran out, A = 0
E1DB                             ; ---- no handler starts between here and the next heading --------------------
E1DB                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E1DB                             ; (stored, not echoed), every other key is stored and echoed until the line
E1DB                             ; is full. Y = the length so far; T0 = the most allowed.
E1DB   20 17 E1     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E1DE   D0 04                  BNE   ln0   
E1E0   B5 00                  LDA   0,X   
E1E2   10 02                  BPL   ln1   
E1E4   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E1E6   85 04        LN1:      STA   T0   
E1E8   A0 00                  LDY   #0   
E1EA   F0 03                  BEQ   ln2   ; always
E1EC   20 03 FF     LN3:      JSR   CONOUT   
E1EF   20 5F E5     LN2:      JSR   getk   
E1F2   F0 FB                  BEQ   ln2   
E1F4   C9 0D                  CMP   #13   
E1F6   F0 14                  BEQ   ln5   
E1F8   C9 08                  CMP   #8   
E1FA   F0 0A                  BEQ   ln4   
E1FC   C4 04                  CPY   T0   
E1FE   B0 EF                  BCS   ln2   ; full
E200   99 80 04               STA   LINEBUF,Y   
E203   C8                     INY      
E204   D0 E6                  BNE   ln3   ; always: echo it
E206   88           LN4:      DEY      ; Backspace: one back, and echo it,
E207   10 E3                  BPL   ln3   
E209   C8                     INY      ;   unless the line was empty
E20A   F0 E3                  BEQ   ln2   ; always
E20C   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E20F   A9 80                  LDA   #<LINEBUF   
E211   A0 04                  LDY   #>LINEBUF   
E213   4C 11 E6               JMP   setay   ; TOS = the line's address
