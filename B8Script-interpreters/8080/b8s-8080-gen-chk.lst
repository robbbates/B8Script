031E   FA 45 03               JM   line   
0321   B5                     ORA   L   
0322   C2 2F 03               JNZ   kt1   
0325                KW:          
0325                          IF   (1-CPM)*(1-CHECKED)   
                              CALL   CONIN   ; 0?: wait (the generic console can block)
0325                          ENDIF      
0325                          IF   1-(1-CPM)*(1-CHECKED)   
0325   CD E5 03               CALL   getk   ; 0?: wait
0328   CA 25 03               JZ   kw   
032B                          ENDIF      
032B   6F           KT3:      MOV   L,A   
032C   26 00                  MVI   H,0   
032E   D7                     RST   2   
032F   11 28 00     KT1:      LXI   D,MSLOOP   ; one millisecond, roughly
0332   CD E5 03     KT2:      CALL   getk   
0335   C2 2B 03               JNZ   kt3   
0338   1B                     DCX   D   
0339   7A                     MOV   A,D   
033A   B3                     ORA   E   
033B   C2 32 03               JNZ   kt2   
033E   2B                     DCX   H   
033F   7C                     MOV   A,H   
0340   B5                     ORA   L   
0341   C2 2F 03               JNZ   kt1   
0344   D7                     RST   2   ; time ran out: HL is already 0
0345   CD 1D 01     LINE:     CALL   neg16   ; HL = the count
0348   7C                     MOV   A,H   
0349   B7                     ORA   A   
034A   C2 53 03               JNZ   ln0   
034D   7D                     MOV   A,L   
034E   FE 80                  CPI   CAP+1   
0350   DA 55 03               JC   ln1   
0353   3E 7F        LN0:      MVI   A,CAP   
0355                LN1:         
0355                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                              STA   LBHDR   
                              PUSH   B   
                              LXI   D,LBHDR   
                              MVI   C,10   
                              CALL   BDOS   
                              POP   B   
                              LXI   H,LBHDR+1   
                              MOV   A,M   ; count (0-127)
                              INX   H   ; HL = LINEBUF, whose low byte is 80h:
                              PUSH   H   
                              ADD   L   ;   adding the count to L can't carry
                              MOV   L,A   
                              MVI   M,13   
                              POP   H   
                              RST   2   
0355                          ENDIF      
0355                          IFN   CPM   
0355                             ; Generic: Backspace and DEL erase, CR ends (stored, not echoed),
0355                             ; other control keys are ignored, and a full line takes only those.
0355   C5                     PUSH   B   
0356   4F                     MOV   C,A   ; C = max
0357   06 00                  MVI   B,0   ; B = length
0359   21 80 82               LXI   H,LINEBUF   
035C                          ENDIF      
035C                LN2:         
035C                          IF   (1-CPM)*(1-CHECKED)   
                              CALL   CONIN   ; (the generic console can block)
035C                          ENDIF      
035C                          IF   (1-CPM)*CHECKED   
035C   CD E5 03               CALL   getk   
035F   CA 5C 03               JZ   ln2   
0362                          ENDIF      
0362                          IFN   CPM   
0362   FE 0D                  CPI   13   
0364   CA 9C 03               JZ   ln5   
0367   FE 08                  CPI   8   
0369   CA 86 03               JZ   ln4   
036C   FE 7F                  CPI   7Fh   
036E   CA 86 03               JZ   ln4   
0371   FE 20                  CPI   " "   
0373   DA 5C 03               JC   ln2   
0376   5F                     MOV   E,A   
0377   78                     MOV   A,B   
0378   B9                     CMP   C   
0379   D2 5C 03               JNC   ln2   ; full
037C   73                     MOV   M,E   
037D   23                     INX   H   
037E   04                     INR   B   
037F   7B                     MOV   A,E   
0380   CD 03 FF     LN3:      CALL   putc   
0383   C3 5C 03               JMP   ln2   
0386   78           LN4:      MOV   A,B   
0387   B7                     ORA   A   
0388   CA 5C 03               JZ   ln2   
038B   05                     DCR   B   
038C   2B                     DCX   H   
038D   3E 08                  MVI   A,8   
038F   CD 03 FF               CALL   putc   
0392   3E 20                  MVI   A," "   
0394   CD 03 FF               CALL   putc   
0397   3E 08                  MVI   A,8   
0399   C3 80 03               JMP   ln3   
