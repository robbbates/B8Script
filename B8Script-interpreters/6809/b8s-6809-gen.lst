F21B   A6 41        H_EMIT:   LDA   1,U   ; "'"
F21D   8D 4A                  BSR   putc   
F21F   33 42        H_DROP:   LEAU   2,U   ; ";"
F221   39                     RTS      
F222                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
F222                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
F222                             ; bit 6, so // and /" give themselves).
