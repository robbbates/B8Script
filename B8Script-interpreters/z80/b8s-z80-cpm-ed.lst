069D   23                     INC   HL   
069E   FE 0A                  CP   10   
06A0   20 F8                  JR   NZ,nxl   
06A2   B7                     OR   A   
06A3   C9                     RET      
06A4                             ; prl: print the line at HL, to its LF; HL -> just past it.
06A4   7E           PRL:      LD   A,(HL)   
06A5   EF                     RST   28h   
06A6   7E                     LD   A,(HL)   
06A7   23                     INC   HL   
06A8   FE 0A                  CP   10   
06AA   20 F8                  JR   NZ,prl   
06AC   C9                     RET      
06AD                          ENDIF      
06AD                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
06AD                          ENDIF      
06AD                          IF   EDITOR*CPM   
06AD                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
06AD                             ;   put the one from the command line
06AD                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
06AD                             ; from now on.
06AD   CD 04 07     CREAD:    CALL   setname   
06B0   CD 43 07               CALL   load   
06B3   C3 96 04               JP   edit   
06B6                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
06B6                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
06B6                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
06B6                             ; full disk or directory is not noticed: the calls fail and that is all.)
06B6   CD 04 07     CWRITE:   CALL   setname   
06B9   0E 13                  LD   C,19   ; delete
06BB   CD 3D 07               CALL   fbdos   
06BE   0E 16                  LD   C,22   ; make
06C0   CD 3D 07               CALL   fbdos   
06C3   21 00 0B               LD   HL,PROG   
06C6   AF                     XOR   A   
06C7   BE           CW1:      CP   (HL)   
06C8   23                     INC   HL   
06C9   20 FC                  JR   NZ,cw1   
06CB   2B                     DEC   HL   ; HL -> the NUL
06CC   E5                     PUSH   HL   
06CD   06 80                  LD   B,128   
06CF   36 1A        CW2:      LD   (HL),1Ah   
06D1   23                     INC   HL   
06D2   10 FB                  DJNZ   cw2   
06D4   E1                     POP   HL   
06D5   11 00 0B               LD   DE,PROG   
06D8   7B           CW3:      LD   A,E   ; a record that starts before the end is written
06D9   95                     SUB   L   
06DA   7A                     LD   A,D   
06DB   9C                     SBC   A,H   
06DC   30 09                  JR   NC,cw4   
06DE   E5                     PUSH   HL   
06DF   0E 15                  LD   C,21   ; write, from where the record lies
06E1   CD F1 06               CALL   frec   
06E4   E1                     POP   HL   
06E5   18 F1                  JR   cw3   
06E7   36 00        CW4:      LD   (HL),0   ; the NUL again
06E9   0E 10                  LD   C,16   ; close
06EB   CD 3D 07               CALL   fbdos   
06EE   C3 96 04               JP   edit   
06F1                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
06F1                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
06F1   D5           FREC:     PUSH   DE   
06F2   C5                     PUSH   BC   
06F3   0E 1A                  LD   C,26   ; set the DMA address
06F5   CD 05 00               CALL   BDOS   
06F8   C1                     POP   BC   
06F9   CD 3D 07               CALL   fbdos   
06FC   E1                     POP   HL   
06FD   11 80 00               LD   DE,128   
0700   EB                     EX   DE,HL   
0701   19                     ADD   HL,DE   
0702   EB                     EX   DE,HL   
0703   C9                     RET      
0704                             ; setname: if a name was typed (the line does not start with its CR), put it
0704                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
0704                             ; is the current one. Then, name or no name, clear the FCB after the name,
0704                             ; as it must be before a file is opened or made.
0704   11 80 0A     SETNAME:   LD   DE,LINEBUF   
0707   1A                     LD   A,(DE)   
0708   FE 0D                  CP   13   
070A   28 26                  JR   Z,fcbclr   
070C   21 5C 00               LD   HL,CFCB   
070F   36 00                  LD   (HL),0   ; the current drive
0711   06 0B                  LD   B,11   
0713   2C           SN1:      INC   L   
0714   36 20                  LD   (HL)," "   
0716   10 FB                  DJNZ   sn1   
0718   2E 5D                  LD   L,CFCB+1   
071A   1A           SN2:      LD   A,(DE)   
071B   13                     INC   DE   
071C   FE 0D                  CP   13   
071E   28 12                  JR   Z,fcbclr   
0720   FE 2E                  CP   "."   
0722   20 04                  JR   NZ,sn3   
0724   2E 65                  LD   L,CFCB+9   ; the type
0726   18 F2                  JR   sn2   
0728   FE 61        SN3:      CP   "a"   
072A   38 02                  JR   C,sn4   
072C   E6 5F                  AND   5Fh   ; a capital
072E   77           SN4:      LD   (HL),A   
072F   2C                     INC   L   
0730   18 E8                  JR   sn2   
0732   21 68 00     FCBCLR:   LD   HL,CFCB+12   
0735   06 18                  LD   B,24   
0737   36 00        FC1:      LD   (HL),0   
0739   23                     INC   HL   
073A   10 FB                  DJNZ   fc1   
073C   C9                     RET      
073D                             ; fbdos: BDOS function C on the file
073D   11 5C 00     FBDOS:    LD   DE,CFCB   
0740   C3 05 00               JP   BDOS   
0743                             ; load: read the file into PROG. No such file: no program. The text ends at
0743                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0743                             ; goes after the last record, so the search always stops. And every line
0743                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
0743                             ; clear after its name: the CCP left it so, or setname did.)
0743   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
0745   CD 3D 07               CALL   fbdos   ;   too)
0748   11 00 0B               LD   DE,PROG   
074B   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
074D   CD F1 06               CALL   frec   
0750   B7                     OR   A   
0751   28 F8                  JR   Z,ld1   
0753   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
0755   21 FF 0A               LD   HL,PROG-1   
0758   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
075A   23           TR1:      INC   HL   
075B   5F                     LD   E,A   ; E = the character before this one
075C   7E                     LD   A,(HL)   
075D   FE 1A                  CP   1Ah   
075F   20 F9                  JR   NZ,tr1   
0761   7B                     LD   A,E   
0762   FE 0A                  CP   10   
0764   28 06                  JR   Z,tr2   
0766   36 0D                  LD   (HL),13   
0768   23                     INC   HL   
0769   36 0A                  LD   (HL),10   
076B   23                     INC   HL   
076C   36 00        TR2:      LD   (HL),0   
076E   C9                     RET      
076F                          ENDIF      
076F                             ; =============================================================================
076F                          IF   CPM   
076F                             ; The RAM pages follow the image; the heap may grow to the BDOS.
076F                START:       
076F                          ENDIF      
076F                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
076F                          ENDIF      
076F                          IF   CPM   
076F   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
0772   11 08 00               LD   DE,0008h   
0775   01 2C 00               LD   BC,vecend-vecs   
0778   ED B0                  LDIR      
077A                          ENDIF      
077A                          IF   CPM*EDITOR   
077A   CD 43 07               CALL   load   ; the file named on the command line
077D   C3 90 04               JP   edit0   
0780                          ENDIF      
0780                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0780                          ENDIF      
0780                          IF   CPM   
0780                             ; RAM pages, after the image
0780                RSPAGE:   EQU   (imgend + 255) / 256   
0780                DSPAGE:   EQU   RSPAGE + 1   
0780                LETPAGE:   EQU   RSPAGE + 2   
0780                PROG:     EQU   LETPAGE*256 + 256   
0780                          ENDIF      
0780                IMGEND:      


