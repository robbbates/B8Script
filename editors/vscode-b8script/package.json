{
  "name": "b8script",
  "displayName": "B8Script",
  "description": "Syntax highlighting for B8Script, the one-character postfix language",
  "version": "0.1.0",
  "publisher": "b8script",
  "license": "MIT",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "b8script",
        "aliases": ["B8Script", "b8script"],
        "extensions": [".b8s", ".B8S"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "b8script",
        "scopeName": "source.b8script",
        "path": "./syntaxes/b8script.tmLanguage.json"
      }
    ]
  }
}
