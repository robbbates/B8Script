                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FVAF:     LDY   #40h   
                              JMP   fvat   
                    FVAS:     LDY   #40h   
                              JMP   fvst   
                    FVB:      LDY   #0   ; b
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   fvbf   
                              CMP   #"!"   
                              BEQ   fvbs   
                              DEX      ; not @ or !: push the address
                              DEX      
                              LDY   #42h   
                              STY   0,X   
                              LDY   #>LET   
                              STY   1,X   
                              ;*Macro unroll:  NEXTA
                              DS   1-CHECKED,0E6h   
