E380                NEXT:        
E380                             ; Both stacks are checked once per character, after it has run. The
E380                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E380                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E380                             ; more than one entry). The data stack has when X is above DSE (an
E380                             ; underflow) or below DSFULL (an overflow). No handler moves X by
E380                             ; more than 4, so X is caught before it wraps; an overrun by a cell
E380                             ; or two writes on the scratch bytes below or above the stack.
E380                             ; S is kept in RSV, for the report's Rtn line (an error found inside
E380                             ; a handler has its own calls on the hardware stack), and the place
E380                             ; of the character about to run in PLACE.
E380   8A                     TXA      ; TSX trashes X: keep it in A
E381   BA                     TSX      
E382   8E 35 04               STX   RSV   
E385   E0 20                  CPX   #RSLIM   
E387   AA                     TAX      ; TAX leaves the carry alone
E388   90 18                  BCC   e_rstack   
E38A   E0 F1                  CPX   #DSE+1   
E38C   B0 26                  BCS   e_sund   
E38E   E0 10                  CPX   #DSFULL   
E390   90 27                  BCC   e_sovr   
E392   A5 00                  LDA   IP   
E394   8D 36 04               STA   PLACE   
E397   A5 01                  LDA   IP+1   
E399   8D 37 04               STA   PLACE+1   
E39C   20 55 E4               JSR   step   
E39F   4C 80 E3               JMP   next   
E3A2                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E3A2                             ; empty.
E3A2   AD 35 04     E_RSTACK:   LDA   RSV   
E3A5   C9 10                  CMP   #10h   
E3A7   A9 52                  LDA   #"R"   
E3A9   B0 10                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E3AB   A9 FF                  LDA   #0FFh   
E3AD   8D 35 04               STA   RSV   ; S wrapped to 01h: Rtn 0
E3B0   A9 72                  LDA   #"r"   
E3B2   D0 07                  BNE   ejmp   ; always
E3B4   A2 F0        E_SUND:   LDX   #DSE   ; Stk 0
E3B6   A9 73                  LDA   #"s"   
E3B8   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E3B9   A9 53        E_SOVR:   LDA   #"S"   
E3BB   4C 43 E5     EJMP:     JMP   error   
E3BE                             ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
E3BE                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E3BE                             ; which takes either. Meeting the wrong closer at this level, or the end
E3BE                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E3BE                             ; which then ends the program as before.
E3BE   85 04        SKIP:     STA   T0   
E3C0   A9 00                  LDA   #0   
E3C2   85 06                  STA   T2   ; depth
E3C4   20 29 E5     SK1:      JSR   getc   
E3C7   F0 26                  BEQ   sknul   
E3C9   C9 22                  CMP   #22h   
E3CB   D0 05                  BNE   sk2   
E3CD   20 5F E0               JSR   skipstr   ; leaves A = 11h, which matches nothing below
E3D0   F0 1D                  BEQ   sknul   ; the string ran into the end
E3D2   C9 28        SK2:      CMP   #"("   
E3D4   F0 15                  BEQ   sk3   
E3D6   C9 5B                  CMP   #"["   
E3D8   F0 11                  BEQ   sk3   
E3DA   C9 29                  CMP   #")"   
E3DC   F0 04                  BEQ   sk4   
E3DE   C9 5D                  CMP   #"]"   
E3E0   D0 E2                  BNE   sk1   
E3E2   C6 06        SK4:      DEC   T2   
E3E4   10 DE                  BPL   sk1   
E3E6   C5 04                  CMP   T0   
E3E8   F0 0C                  BEQ   e_nest   ; the wrong kind
E3EA   60                     RTS      ; the closer at this level
E3EB   E6 06        SK3:      INC   T2   
E3ED   D0 D5                  BNE   sk1   
E3EF   A5 04        SKNUL:    LDA   T0   
E3F1   D0 03                  BNE   e_nest   ; ( and [ stop with N
E3F3   4C 09 FF               JMP   EXIT   ; \ ends the program
E3F6   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E3F8   4C 43 E5               JMP   error   ;   or the end: the place is the opener
E3FB                          ENDIF      
E3FB                          IF   1-CHECKED   
                    CBREAK:   EQU   endp   ; the unchecked build stops without a word
E3FB                          ENDIF      
E3FB                          IF   CHECKED   
E3FB                CBREAK:   EQU   e_break   ; the checked build reports B
E3FB                          ENDIF      
E3FB                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E3FB                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E3FB                             ; taken out of KEYBUF.
E3FB   AD 7A 04     GETK:     LDA   KEYBUF   
E3FE   F0 08                  BEQ   gk1   
E400   48                     PHA      
E401   A9 00                  LDA   #0   
E403   8D 7A 04               STA   KEYBUF   
E406   68                     PLA      
E407   60                     RTS      
E408   20 06 FF     GK1:      JSR   KEY   
E40B   F0 04                  BEQ   gk9   
E40D   C9 03                  CMP   #3   
E40F   F0 01                  BEQ   ctlc   ; Ctrl-C: ctlc gives the 03h back, if at all
E411   60           GK9:      RTS      
E412                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E412                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E412                             ; looks: D0 counts the 256s, D1 runs on from whatever it holds) for one more
E412                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E412                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E412   AD 7B 04     CTLC:     LDA   BRKOFF   
E415   F0 1D                  BEQ   cbreak   
E417   A9 28                  LDA   #CWAIT+1   
