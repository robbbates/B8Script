E539   A0 10        UD0:      LDY   #16   
E53B   06 02        UD1:      ASL   TL   
E53D   26 03                  ROL   TH   
E53F   26 04                  ROL   T0   
E541   26 05                  ROL   T1   
E543   38                     SEC      
E544   A5 04                  LDA   T0   
E546   E5 08                  SBC   D0   
E548   48                     PHA      
E549   A5 05                  LDA   T1   
E54B   E5 09                  SBC   D1   
E54D   90 08                  BCC   ud2   
E54F   85 05                  STA   T1   
E551   68                     PLA      
E552   85 04                  STA   T0   
E554   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E556   24                     DB   24h   ; (BIT zp: steps over the PLA)
E557   68           UD2:      PLA      
E558   88                     DEY      
E559   D0 E0                  BNE   ud1   
E55B   60                     RTS      
E55C                          ENDIF      
E55C                             ; =============================================================================
E55C                             ;  Fetches, and the keyboard
E55C                             ; =============================================================================
E55C   A0 01        H_FETCH:   LDY   #1   ; "@"
E55E   B1 02                  LDA   (TL),Y   
E560   48                     PHA      ; the high byte, while "," gets the low one
E561   20 68 E5               JSR   h_cfetch   
E564   68                     PLA      
E565   85 03                  STA   TH   
E567   60                     RTS      
E568                H_CFETCH:      ; ","
E568   A0 00                  LDY   #0   
E56A   B1 02                  LDA   (TL),Y   
E56C   85 02        CF2:      STA   TL   ; TOS = A (low), Y (high)
E56E   84 03                  STY   TH   
E570   60                     RTS      
E571                             ; "?" ( n -- c ) or ( -n -- addr )
E571                             ;   n > 0: wait about n ms for a key; 0 if none came
E571                             ;   n = 0: wait for a key
E571                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E571                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E571   A5 03        H_KEY:    LDA   TH   
E573   30 20                  BMI   line   
E575   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E577   20 83 E0     KT2:      JSR   getk   
E57A   D0 15                  BNE   kt3   
E57C   88                     DEY      
E57D   D0 F8                  BNE   kt2   
E57F   A5 02                  LDA   TL   ; count the millisecond off:
E581   D0 06                  BNE   kt4   
E583   A5 03                  LDA   TH   
E585   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E587   C6 03                  DEC   TH   
E589   C6 02        KT4:      DEC   TL   
E58B   D0 E8                  BNE   kt1   
E58D   A5 03                  LDA   TH   
E58F   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E591   A0 00        KT3:      LDY   #0   
E593   F0 D7                  BEQ   cf2   ; always: TOS = A
E595                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E595                             ; (stored, not echoed), every other key is stored and echoed until the line
E595                             ; is full. Y = the length so far; TL = the most allowed.
E595   20 0F E4     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E598   D0 04                  BNE   ln0   
E59A   A5 02                  LDA   TL   
E59C   10 04                  BPL   ln1   
E59E   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E5A0   85 02                  STA   TL   
E5A2   A0 00        LN1:      LDY   #0   
E5A4   F0 03                  BEQ   ln2   ; always
E5A6   20 03 FF     LN3:      JSR   CONOUT   
E5A9   20 83 E0     LN2:      JSR   getk   
E5AC   F0 FB                  BEQ   ln2   
E5AE   C9 0D                  CMP   #13   
E5B0   F0 14                  BEQ   ln5   
E5B2   C9 08                  CMP   #8   
E5B4   F0 0A                  BEQ   ln4   
E5B6   C4 02                  CPY   TL   
E5B8   B0 EF                  BCS   ln2   ; full
E5BA   99 80 04               STA   LINEBUF,Y   
E5BD   C8                     INY      
E5BE   D0 E6                  BNE   ln3   ; always: echo it
E5C0   88           LN4:      DEY      ; Backspace: one back, and echo it,
E5C1   10 E3                  BPL   ln3   
E5C3   C8                     INY      ;   unless the line was empty
E5C4   F0 E3                  BEQ   ln2   ; always
E5C6   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E5C9   A9 80                  LDA   #<LINEBUF   
E5CB   A0 04                  LDY   #>LINEBUF   
E5CD   D0 9D                  BNE   cf2   ; always: TOS = the line's address
E5CF                             ; =============================================================================
E5CF                             ;  Machine code: the grave
E5CF                             ; =============================================================================
E5CF                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E5CF                             ; are stored from addr until a non-hex character; then a RET (60h) is
E5CF                             ; written and its address is left. An odd last digit is consumed and dropped.
E5CF                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E5CF                             ; contract in the header.
E5CF   20 6F E3     H_GRAVE:   JSR   rdhex   
E5D2   B0 1C                  BCS   exec   
E5D4   0A           HX1:      ASL      
E5D5   0A                     ASL      
E5D6   0A                     ASL      
E5D7   0A                     ASL      
E5D8   85 04                  STA   T0   
E5DA   20 6F E3               JSR   rdhex   
E5DD   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E5DF   05 04                  ORA   T0   
E5E1   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
E5E3   20 9D E2               JSR   inctos   
E5E6   20 6F E3               JSR   rdhex   
E5E9   90 E9                  BCC   hx1   
E5EB   A9 60        HX2:      LDA   #60h   
E5ED   91 02                  STA   (TL),Y   
E5EF   60                     RTS      
E5F0   A5 02        EXEC:     LDA   TL   
E5F2   85 04                  STA   T0   
E5F4   A5 03                  LDA   TH   
E5F6   85 05                  STA   T1   
E5F8   20 B3 E3               JSR   drop   ; the address is consumed
E5FB   6C 04 00               JMP   (T0)   
E5FE                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   R:n CR LF
                                 ; The numbers go through "#" (h_num), each pushed over the data stack first
                                 ; and popped again by "#", so the stack is shown as it was.
                    ERROR:    PHA      ; the letter
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                                 ; The line and the column of the place, both from 1. The line is counted in
                                 ; a cell pushed over the data stack (TOS). A place below the program is in
                                 ; the -n? line buffer: line 0, and the column is the place in the buffer.
                                 ; Otherwise IP (free now: the program has stopped) runs from PROG to the
                                 ; place, counting LFs; CL keeps where the last line started, and the column
                                 ; is the place minus that, plus 1.
                              LDA   #<LINEBUF   
                              STA   CL   
                              LDA   #>LINEBUF   
                              STA   CL+1   
                              LDA   #0   
                              TAY      
                              JSR   pushay   ; TOS = the line, 0 so far
                              LDA   PLACE   
                              CMP   #<PROG   
                              LDA   PLACE+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   TL   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   CL   
                              LDA   IP+1   
                              STA   CL+1   
                    LC1:      LDA   IP   
                              CMP   PLACE   
                              LDA   IP+1   
                              SBC   PLACE+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              JSR   inctos   ; an LF: a new line starts after it
                              BNE   lc3   ; always (Z clear: fewer than 65536 lines)
                    LC9:      JSR   h_num   ; the line (and it is dropped)
                              LDA   #","   
                              JSR   CONOUT   
                              SEC      
                              LDA   PLACE   
                              SBC   CL   
                              PHA      
                              LDA   PLACE+1   
                              SBC   CL+1   
                              TAY      
                              PLA      
                              JSR   pushay   
                              JSR   inctos   ; + 1
                              JSR   h_num   ; the column
                              LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "D:"
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T2   ; T2 = how many cells to show (the place
                                 ;   is no longer needed)
                              JSR   prs   
                              JSR   push   ; TOS into memory with the rest: cell i from
                                 ;   the top is at DSL+X+i now
                    ER4:      LDA   T2   ; cells T2-1 down to 0, the top last
                              BEQ   er5   
                              DEC   T2   
                              LDA   #" "   
                              JSR   CONOUT   
                              TXA      
                              CLC      
                              ADC   T2   
                              TAY      
                              LDA   DSL,Y   
                              PHA      
                              LDA   DSH,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "R:"
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
E5FE                          ENDIF      
E5FE                             ; =============================================================================
E5FE                             ;  The fast build (SPEED = 2)
E5FE                             ; 
E5FE                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
E5FE                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
E5FE                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
E5FE                             ;  so there is no JSR and no RTS per character:
E5FE                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
E5FE                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
E5FE                             ;  The letters and digits have one entry each, which knows its cell or its
E5FE                             ;  value already; the commonest punctuation is written for the table; the
E5FE                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
E5FE                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
E5FE                             ;  and the clear carry they expect.
E5FE                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
E5FE                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
E5FE                             ;  stacks first, as next does in the other builds.
E5FE                             ;  Everything here is read-only: the image can be ROM, as the others are.
E5FE                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
E5FE                             ;  starts after it.
E5FE                             ; =============================================================================
E5FE                          IF   FAST   
                                 ; fnext: the dispatcher, after the checks of the checked build
                    FNEXT:       
E5FE                          ENDIF      
E5FE                          IF   FAST*CHECKED   
                                 ; (the same checks as next in the other checked builds)
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      
                              BCS   fn1   
                              JMP   e_rstack   
                    FN1:      CPX   #DSE+1   
                              BCC   fn3   
                              JMP   e_stack   
                    FN3:      LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E5FE                          ENDIF      
E5FE                          IF   FAST   
                              LDY   #0   
                              LDA   (IP),Y   
                              INC   IP   
                              BNE   fn4   
                              INC   IP+1   
                    FN4:      TAY      
                              LDA   DTL,Y   
                              STA   V   
                              LDA   DTH,Y   
                              STA   V+1   
                              JMP   (V)   
                                 ; fpoll: the break check of pnext, as a subroutine, for the entries that
                                 ; look at the keyboard (a word call, a true ( and a true ))
                    FPOLL:    JSR   KEY   
                              BEQ   fp9   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JMP   chk3   ; (Ctrl-C: back only if the break key is off)
                    FP9:      RTS      
                                 ; The thunks: the rest of the punctuation, through the ordinary handlers
                    FT_STR:   CLC      ; "
                              JSR   h_str   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_NUM:   CLC      ; #
                              JSR   h_num   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_PRT:   CLC      ; $
                              JSR   h_print   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_EMIT:   CLC      ; '
                              JSR   h_emit   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_DIV:   CLC      ; /
                              JSR   h_div   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_KEY:   CLC      ; ?
                              JSR   h_key   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_DEF:   CLC      ; [
                              JSR   h_def   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_BRK:   CLC      ; \
                              JSR   h_break   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_ALC:   CLC      ; _
                              JSR   h_alloc   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_GRV:   CLC      ; `
                              JSR   h_grave   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_TOR:   CLC      ; {
                              JSR   h_tor   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_FRR:   CLC      ; }
                              JSR   h_fromr   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
E5FE                          ENDIF      
E5FE                          IF   FAST*CHECKED   
                    FT_STO:   CLC      ; ! (checked: it checks the address)
                              JSR   h_store   
                              JMP   fnext   
                    FT_CST:   CLC      ; . (the same)
                              JSR   h_cstore   
                              JMP   fnext   
E5FE                          ENDIF      
E5FE                          IF   FAST   
                                 ; The commonest punctuation, written for the table
                    FS_ADD:   CLC      ; +
                              LDA   DSL,X   
                              ADC   TL   
                              STA   TL   
                              LDA   DSH,X   
                              ADC   TH   
                              STA   TH   
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_SUB:   LDY   #0   ; -
                              LDA   (IP),Y   
                              CMP   #3Ah   
                              BCS   fsb1   
                              CMP   #30h   
                              BCS   fsb2   ; a digit next: a negative number
                    FSB1:     SEC      
                              LDA   DSL,X   
                              SBC   TL   
                              STA   TL   
                              LDA   DSH,X   
                              SBC   TH   
                              STA   TH   
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FSB2:     JSR   negnum   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_DUP:   DEX      ; :
                              LDA   TL   
                              STA   DSL,X   
                              LDA   TH   
                              STA   DSH,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
