0535                             ;  Startup
0535                             ; =============================================================================
0535                START:       
0535                          IF   CPM   
0535   31 FE 07               LXI   SP,DSTOP   
0538                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
0538   21 8A 05               LXI   H,stubs   ; RST 08h and RST 10h stubs into page zero
053B   11 08 00               LXI   D,0008h   
053E   06 0C                  MVI   B,12   
0540   7E           CPY:      MOV   A,M   
0541   12                     STAX   D   
0542   23                     INX   H   
0543   13                     INX   D   
0544   05                     DCR   B   
0545   C2 40 05               JNZ   cpy   
0548   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
054B   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
054D   CD 05 00               CALL   BDOS   ;   and the program is empty)
0550   11 00 09               LXI   D,PROG   
0553   D5           LD1:      PUSH   D   
0554   0E 1A                  MVI   C,26   ; set the DMA address
0556   CD 05 00               CALL   BDOS   
0559   11 5C 00               LXI   D,005Ch   
055C   0E 14                  MVI   C,20   ; read the next 128 bytes
055E   CD 05 00               CALL   BDOS   
0561   E1                     POP   H   ; HL = the address this record went to
0562   B7                     ORA   A   
0563   C2 6E 05               JNZ   ld2   
0566   11 80 00               LXI   D,128   
0569   19                     DAD   D   
056A   EB                     XCHG      
056B   C3 53 05               JMP   ld1   
056E   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0570   23                     INX   H   
0571   22 7C 08               SHLD   HEAP   
0574   3A 07 00               LDA   0007h   ; the BDOS page is the heap limit
0577   32 3A 08               STA   HLIM   
057A                          ENDIF      
057A                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
                              SHLD   HEAP   
057A                          ENDIF      
057A                          IF   (1-CPM)*CHECKED   
                              MVI   A,HEAPLIM   
                              STA   HLIM   
057A                          ENDIF      
057A   21 E0 06               LXI   H,RSTOP   
057D   22 34 08               SHLD   RSP   
0580                          IF   CHECKED   
0580   AF                     XRA   A   
0581   32 36 08               STA   KEYBUF   
0584                          ENDIF      
0584   01 00 09               LXI   B,PROG   
0587   C3 03 01               JMP   next0   
058A                          IF   CPM   
058A   D1           STUBS:    POP   D   ; 0008h: drop, then next
058B   E1                     POP   H   
058C   C3 03 01               JMP   next0   
058F                H_DUP:    EQU   000Dh   
058F   E5                     PUSH   H   ; 000Dh: dup
0590   D7                     RST   2   
0591   00                     DB   0   
0592   D1                     POP   D   ; 0010h: next
0593   C3 03 01               JMP   next0   
0596                ENDPROG:   EQU   0   ; warm boot
0596                DROP_NEXT:   EQU   0009h   
0596                             ; RAM pages, after the image
0596                RSPAGE:   EQU   (imgend + 255) / 256   
0596                DSPAGE:   EQU   RSPAGE + 1   
0596                LETPAGE:   EQU   RSPAGE + 2   
0596                PROG:     EQU   LETPAGE*256 + 256   
0596                          ENDIF      
0596                IMGEND:      


