02C1                             ; "?" ( n -- c ) or ( -n -- addr )
02C1                             ;   n > 0: wait about n ms for a key; 0 if none came
02C1                             ;   n = 0: wait for a key
02C1                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C1                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C1   CB 7C        H_KEY:    BIT   7,H   
02C3   20 19                  JR   NZ,line   
02C5   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02C7   CD 5C 04     KT2:      CALL   getk   
02CA   20 0E                  JR   NZ,kt3   
02CC   1D                     DEC   E   
02CD   20 F8                  JR   NZ,kt2   
02CF   7C                     LD   A,H   ; 0? never counts down: it waits
02D0   B5                     OR   L   
02D1   28 F2                  JR   Z,kt1   
02D3   2B                     DEC   HL   
02D4   7C                     LD   A,H   
02D5   B5                     OR   L   
02D6   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02D8   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02D9   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02DA   6F           KT3:      LD   L,A   
02DB   26 00                  LD   H,0   
02DD   F7                     RST   30h   
02DE                             ; Backspace takes the last character back (and is echoed as
02DE                             ; it is), CR ends (stored, not echoed), every other key is stored and
02DE                             ; echoed until the line is full. The line buffer starts at offset 80h
02DE                             ; of its page, so L alone is the place in the line: D holds the L of
02DE                             ; a full line.
02DE   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E1   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02E2   9F                     SBC   A,A   
02E3   A5                     AND   L   ; (0 for a count that is too big)
02E4   2F                     CPL      
