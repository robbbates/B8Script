  1889                              <1> ; =============================================================================
  1890                              <1> ;  The inner loop: read one character and sort it by range.
  1891                              <1> ;
  1892                              <1> ;    00h          end of program
  1893                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1894                              <1> ;                 build stops on 80h-FFh: X)
  1895                              <1> ;    30h-39h      digit: read a whole number
  1896                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1897                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1898                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1899                              <1> ; =============================================================================
  1900                              <1> ; Digits: step back onto the first digit and read the whole number.
  1901 00000640 53                  <1> digit:  push    ebx
  1902 00000641 4E                  <1>         dec     esi
  1903                              <1>         CALLP   rdnum
   192                              <2>  %if P_%1
   193                              <2>  call [V(p_%1)]
   194                              <2>  %else
   195 00000642 E844FEFFFF          <2>  call %1
   196                              <2>  %endif
  1904 00000647 FFE5                <1>         jmp     ebp
  1905                              <1> 
  1906                              <1> ; a-z: push the cell's address (the cell is the variable).
  1907 00000649 53                  <1> lower:  push    ebx
  1908 0000064A 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1909 00000651 FFE5                <1>         jmp     ebp
  1910                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1911                              <1> ; next in reach)
  1912 00000653 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1913 00000655 7505                <1>         jnz     next                    ; the rest are ignored
  1914 00000657 E94EFDFFFF          <1>         jmp     endprog
  1915                              <1> %if CHECKED
  1916                              <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1917                              <1>         jmp     error
  1918                              <1> %endif
  1919                              <1> next:
  1920                              <1> %if CHECKED
  1921                              <1>         call    chkstk                  ; both stacks, once per character
  1922                              <1> %endif
  1923 0000065C 31C0                <1>         xor     eax,eax
  1924 0000065E AC                  <1>         lodsb
  1925 0000065F 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1926 00000661 72F0                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1927 00000663 3C0F                <1>         cmp     al,0Fh
  1928 00000665 7226                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1929 00000667 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1930 00000669 3C0A                <1>         cmp     al,0Ah
  1931 0000066B 72D3                <1>         jb      digit                   ; 30h-39h
  1932 0000066D 3C11                <1>         cmp     al,11h
  1933 0000066F 721A                <1>         jb      p3a                     ; 3Ah-40h
  1934 00000671 2C11                <1>         sub     al,11h                  ; AL = c - 41h
