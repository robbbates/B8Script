0476                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0476                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0476                          IF   1-CHECKED   
0476   03           SS0:      INC   BC   
0477   0A           SKIPSTR:   LD   A,(BC)   
0478   03                     INC   BC   
0479   FE 2F                  CP   "/"   
047B   28 F9                  JR   Z,ss0   
047D   FE 22                  CP   22h   
047F   20 F6                  JR   NZ,skipstr   
0481   C9                     RET      
0482                          ENDIF      
0482                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0482                          ENDIF      
0482                             ; skip: read past text to the closer at this level, and return A = 0 if it
0482                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0482                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0482                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0482                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0482                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0482                             ; 
0482                             ; The checked build also looks at the character the skip was started by,
0482                             ; which is always the one just before where it starts: "(" must end at ")",
0482                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0482                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
0482                             ; place where the skip started, for the report.
0482                          IF   1-QK   
                                 ; (Without QUICK: no skip cache.)
                    SKIP:        
0482                          ENDIF      
0482                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0482                          ENDIF      
0482                          IF   1-QK   
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
0482                          ENDIF      
0482                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0482                          ENDIF      
0482                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0482                          ENDIF      
0482                          IF   1-QK   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
0482                          ENDIF      
0482                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0482                          ENDIF      
0482                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0482                          ENDIF      
0482                          IF   QK   
0482                             ; The skip cache. Nearly every skip is one that has happened before (a loop
0482                             ; skips the same false block on every pass), so the first scan from each
0482                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
0482                             ; start's low byte. Only skips that start in the program text are kept (the
0482                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
0482                             ; A program that changes its own text while it runs is not looked after.
0482   ED 43 3C 16  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
0486   78                     LD   A,B   ;   checked report's place)
0487   FE 17                  CP   PROG/256   
0489   38 1B                  JR   C,sks   ; below the program text: no cache
048B   79                     LD   A,C   
048C   87                     ADD   A,A   
048D   87                     ADD   A,A   
048E   5F                     LD   E,A   
048F   16 13                  LD   D,CPAGE   ; DE -> the entry
0491   1A                     LD   A,(DE)   
0492   B9                     CP   C   
0493   20 11                  JR   NZ,sks   
0495   1C                     INC   E   
0496   1A                     LD   A,(DE)   
0497   B8                     CP   B   
0498   20 0C                  JR   NZ,sks   
049A   1C                     INC   E   
049B   1A                     LD   A,(DE)   
049C   4F                     LD   C,A   
049D   1C                     INC   E   
049E   1A                     LD   A,(DE)   
049F   47                     LD   B,A   ; a hit: the IP is past the closer
04A0   0B                     DEC   BC   
04A1   0A                     LD   A,(BC)   
04A2   03                     INC   BC   
04A3   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
04A5   C9                     RET      
04A6                SKS:         
04A6                          ENDIF      
04A6                          IF   QK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
04A6                          ENDIF      
04A6                          IF   QK   
04A6                             ; The scan. Most characters are nothing to it, and two range tests rule
04A6                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
04A6   16 00                  LD   D,0   
04A8   14           SQ3:      INC   D   ; an opener: one deeper
04A9   0A           SQ1:      LD   A,(BC)   
04AA   03                     INC   BC   
04AB   FE 5E                  CP   5Eh   
04AD   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
04AF   FE 5B                  CP   5Bh   
04B1   30 19                  JR   NC,sqb   ; [ \ ]
04B3   FE 2A                  CP   2Ah   
04B5   30 F2                  JR   NC,sq1   ; * to Z: nothing
04B7   FE 28                  CP   28h   
04B9   28 ED                  JR   Z,sq3   ; (
04BB   30 19                  JR   NC,sqc   ; )
04BD   FE 22                  CP   22h   
04BF   28 06                  JR   Z,sqq   ; a string
04C1   B7                     OR   A   
04C2   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
04C4                          ENDIF      
04C4                          IF   QK*(1-CHECKED)   
04C4   C3 00 00               JP   SKEND   ; NUL: the end of the program
04C7                          ENDIF      
04C7                          IF   QK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
04C7                          ENDIF      
04C7                          IF   QK   
04C7   CD 77 04     SQQ:      CALL   skipstr   ; step over the string
04CA   18 DD                  JR   sq1   
04CC   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
04CE   28 D9                  JR   Z,sq1   ; "\" is nothing here
04D0   38 D6                  JR   C,sq3   ; [
04D2   3E 02                  LD   A,2   ; ]
04D4   18 01                  JR   sq4   
04D6   AF           SQC:      XOR   A   ; )
04D7   15           SQ4:      DEC   D   
04D8   20 CF                  JR   NZ,sq1   
04DA                          ENDIF      
04DA                          IF   QK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
04DA                          ENDIF      
04DA                          IF   QK   
04DA                             ; The closer at this level: remember the skip (if it started in the program
04DA                             ; text), and return A = 0 for ")" or 2 for "]".
04DA   F5                     PUSH   AF   
04DB   E5                     PUSH   HL   
04DC   2A 3C 16               LD   HL,(SKPL)   
04DF   7C                     LD   A,H   
04E0   FE 17                  CP   PROG/256   
04E2   38 11                  JR   C,sq9   
04E4   7D                     LD   A,L   
04E5   87                     ADD   A,A   
04E6   87                     ADD   A,A   
04E7   5F                     LD   E,A   
04E8   16 13                  LD   D,CPAGE   
04EA   7D                     LD   A,L   
04EB   12                     LD   (DE),A   
04EC   1C                     INC   E   
04ED   7C                     LD   A,H   
04EE   12                     LD   (DE),A   
04EF   1C                     INC   E   
04F0   79                     LD   A,C   
04F1   12                     LD   (DE),A   
04F2   1C                     INC   E   
04F3   78                     LD   A,B   
04F4   12                     LD   (DE),A   
04F5   E1           SQ9:      POP   HL   
04F6   F1                     POP   AF   
04F7   C9                     RET      
04F8                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
04F8   E5           SKCLR:    PUSH   HL   
04F9   21 00 13               LD   HL,CPAGE*256   
04FC   36 00        SKC1:     LD   (HL),0   
04FE   2C                     INC   L   
04FF   20 FB                  JR   NZ,skc1   
0501   E1                     POP   HL   
0502   C9                     RET      
0503                          ENDIF      
0503                             ;  ---- Speed-ups (QUICK builds) -------------------------------------------
0503                             ;  The skip cache is above. These are the handlers' tails that the builds with
0503                             ;  room take, kept here, out of the handlers' first two pages.
0503                          IF   QK   
0503                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
0503                             ; multiplier (most multiplications have one, a count or a small constant).
0503   7C           MULQ:     LD   A,H   
0504   B7                     OR   A   
0505   28 05                  JR   Z,mq8   ; the multiplier is below 256
0507   7A                     LD   A,D   
0508   B7                     OR   A   
0509   20 2F                  JR   NZ,mq16   
050B   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
050C                          ENDIF      
050C                          IF   QK*(1-FAST)   
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              PUSH   BC   
                              LD   B,8   
                    MQ1:      ADD   HL,HL   
                              RLA      
                              JR   NC,mq2   
                              ADD   HL,DE   
                    MQ2:      DJNZ   mq1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    MQ3:      ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mq4   
                              ADD   HL,DE   
                    MQ4:      DJNZ   mq3   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
050C                          ENDIF      
050C                          IF   FAST   
050C                             ; (the speed build: the same rounds, unrolled)
050C   7D           MQ8:      LD   A,L   
050D   21 00 00               LD   HL,0   
0510   29                     ADD   HL,HL   
0511   17                     RLA      
0512   30 01                  JR   NC,mur0   
0514   19                     ADD   HL,DE   
0515                MUR0:        
0515   29                     ADD   HL,HL   
0516   17                     RLA      
0517   30 01                  JR   NC,mur1   
0519   19                     ADD   HL,DE   
051A                MUR1:        
051A   29                     ADD   HL,HL   
051B   17                     RLA      
051C   30 01                  JR   NC,mur2   
051E   19                     ADD   HL,DE   
051F                MUR2:        
051F   29                     ADD   HL,HL   
0520   17                     RLA      
0521   30 01                  JR   NC,mur3   
0523   19                     ADD   HL,DE   
0524                MUR3:        
0524   29                     ADD   HL,HL   
0525   17                     RLA      
0526   30 01                  JR   NC,mur4   
0528   19                     ADD   HL,DE   
0529                MUR4:        
0529   29                     ADD   HL,HL   
052A   17                     RLA      
052B   30 01                  JR   NC,mur5   
052D   19                     ADD   HL,DE   
052E                MUR5:        
052E   29                     ADD   HL,HL   
052F   17                     RLA      
0530   30 01                  JR   NC,mur6   
0532   19                     ADD   HL,DE   
0533                MUR6:        
0533   29                     ADD   HL,HL   
0534   17                     RLA      
0535   30 01                  JR   NC,mur7   
0537   19                     ADD   HL,DE   
0538                MUR7:        
0538                          ;*Macro unroll:  NEXT
0538                          DS   (1-CPM)*(1-FAST),0F7h   
0538   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0539   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
053A   C5           MQ16:     PUSH   BC   
053B   7C                     LD   A,H   
053C   4D                     LD   C,L   
053D   21 00 00               LD   HL,0   
0540   29                     ADD   HL,HL   
0541   CB 21                  SLA   C   
0543   17                     RLA      
0544   30 01                  JR   NC,mus0   
0546   19                     ADD   HL,DE   
0547                MUS0:        
0547   29                     ADD   HL,HL   
0548   CB 21                  SLA   C   
054A   17                     RLA      
054B   30 01                  JR   NC,mus1   
054D   19                     ADD   HL,DE   
