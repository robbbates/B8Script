0480   67                     LD   H,A   
0481   69                     LD   L,C   ; HL = quotient
0482   C1                     POP   BC   
0483   C9                     RET      
0484                          ENDIF      
0484                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0484                             ; non-digit. Values wrap at 16 bits, as the spec says.
0484   21 00 00     RDNUM:    LD   HL,0   
0487   0A           RDN1:     LD   A,(BC)   
0488   D6 30                  SUB   "0"   
048A   FE 0A                  CP   10   
048C   D0                     RET   NC   
048D   03                     INC   BC   
048E   54                     LD   D,H   
048F   5D                     LD   E,L   
0490   29                     ADD   HL,HL   
0491   29                     ADD   HL,HL   
0492   19                     ADD   HL,DE   
0493   29                     ADD   HL,HL   ; HL * 10
0494   5F                     LD   E,A   
0495   16 00                  LD   D,0   
0497   19                     ADD   HL,DE   
0498   18 ED                  JR   rdn1   
049A                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
049A                             ; the next character, so "/"" does not end it. Leaves A = 22h.
049A                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
049A                          ENDIF      
049A                          IF   CHECKED   
049A                             ; The checked build never steps over a NUL: if the text runs out first it
049A                             ; returns A = 0 with the IP on the NUL.
049A   0A           SKIPSTR:   LD   A,(BC)   
049B   B7                     OR   A   
049C   C8                     RET   Z   
049D   03                     INC   BC   
049E   FE 22                  CP   22h   
04A0   C8                     RET   Z   
04A1   FE 2F                  CP   "/"   
04A3   20 F5                  JR   NZ,skipstr   
04A5   0A                     LD   A,(BC)   ; the escaped character
04A6   B7                     OR   A   
04A7   C8                     RET   Z   
04A8   03                     INC   BC   
04A9   18 EF                  JR   skipstr   
04AB                          ENDIF      
04AB                             ; skip: read past text to the closer at this level, and return A = 0 if it
04AB                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
04AB                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
04AB                             ; no closer; anything else that runs into the NUL had unbalanced brackets
04AB                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
04AB                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
04AB                             ; 
04AB                             ; The checked build also looks at the character the skip was started by,
04AB                             ; which is always the one just before where it starts: "(" must end at ")",
04AB                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
04AB                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
04AB                             ; place where the skip started, for the report.
04AB                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
04AB                          ENDIF      
04AB                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
04AB                          ENDIF      
04AB                          IF   1-QK   
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
04AB                          ENDIF      
04AB                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
04AB                          ENDIF      
04AB                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
04AB                          ENDIF      
04AB                          IF   1-QK   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
04AB                          ENDIF      
04AB                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
04AB                          ENDIF      
04AB                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
04AB                          ENDIF      
04AB                          IF   QK   
04AB                             ; The skip cache. Nearly every skip is one that has happened before (a loop
04AB                             ; skips the same false block on every pass), so the first scan from each
04AB                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
04AB                             ; start's low byte. Only skips that start in the program text are kept (the
04AB                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
04AB                             ; A program that changes its own text while it runs is not looked after.
04AB   ED 43 3C 17  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
04AF   78                     LD   A,B   ;   checked report's place)
04B0   FE 18                  CP   PROG/256   
04B2   38 1B                  JR   C,sks   ; below the program text: no cache
04B4   79                     LD   A,C   
04B5   87                     ADD   A,A   
04B6   87                     ADD   A,A   
04B7   5F                     LD   E,A   
04B8   16 14                  LD   D,CPAGE   ; DE -> the entry
04BA   1A                     LD   A,(DE)   
04BB   B9                     CP   C   
04BC   20 11                  JR   NZ,sks   
04BE   1C                     INC   E   
04BF   1A                     LD   A,(DE)   
04C0   B8                     CP   B   
04C1   20 0C                  JR   NZ,sks   
04C3   1C                     INC   E   
04C4   1A                     LD   A,(DE)   
04C5   4F                     LD   C,A   
04C6   1C                     INC   E   
04C7   1A                     LD   A,(DE)   
04C8   47                     LD   B,A   ; a hit: the IP is past the closer
04C9   0B                     DEC   BC   
04CA   0A                     LD   A,(BC)   
04CB   03                     INC   BC   
04CC   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
04CE   C9                     RET      
04CF                SKS:         
04CF                          ENDIF      
04CF                          IF   QK*CHECKED   
04CF   0B                     DEC   BC   
04D0   0A                     LD   A,(BC)   
04D1   03                     INC   BC   
04D2   5F                     LD   E,A   ; E = the opener: ( [ or \
04D3                          ENDIF      
04D3                          IF   QK   
04D3                             ; The scan. Most characters are nothing to it, and two range tests rule
04D3                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
04D3   16 00                  LD   D,0   
04D5   14           SQ3:      INC   D   ; an opener: one deeper
04D6   0A           SQ1:      LD   A,(BC)   
04D7   03                     INC   BC   
04D8   FE 5E                  CP   5Eh   
04DA   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
04DC   FE 5B                  CP   5Bh   
04DE   30 25                  JR   NC,sqb   ; [ \ ]
04E0   FE 2A                  CP   2Ah   
04E2   30 F2                  JR   NC,sq1   ; * to Z: nothing
04E4   FE 28                  CP   28h   
04E6   28 ED                  JR   Z,sq3   ; (
04E8   30 25                  JR   NC,sqc   ; )
04EA   FE 22                  CP   22h   
04EC   28 12                  JR   Z,sqq   ; a string
04EE   B7                     OR   A   
04EF   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
04F1                          ENDIF      
04F1                          IF   QK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
04F1                          ENDIF      
04F1                          IF   QK*CHECKED   
04F1   0B                     DEC   BC   ; NUL: the IP stays on it
04F2   CB 53                  BIT   2,E   ; the text ran out:
04F4   C2 00 00               JP   NZ,SKEND   ;   "\" with no closer ends the program
04F7   ED 4B 3C 17  SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
04FB   3E 4E                  LD   A,"N"   
04FD   C3 3F 07               JP   errp   ; (errp drops skip's return address)
0500                          ENDIF      
0500                          IF   QK   
0500   CD 9A 04     SQQ:      CALL   skipstr   ; step over the string
0503   18 D1                  JR   sq1   
0505   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
0507   28 CD                  JR   Z,sq1   ; "\" is nothing here
0509   38 CA                  JR   C,sq3   ; [
050B   3E 02                  LD   A,2   ; ]
050D   18 01                  JR   sq4   
050F   AF           SQC:      XOR   A   ; )
0510   15           SQ4:      DEC   D   
0511   20 C3                  JR   NZ,sq1   
0513                          ENDIF      
0513                          IF   QK*CHECKED   
0513   57                     LD   D,A   ; the closer at this level (as above): 2 here
0514   AB                     XOR   E   ;   means the wrong closer
0515   E6 06                  AND   6   
0517   FE 02                  CP   2   
0519   7A                     LD   A,D   
051A   28 DB                  JR   Z,sq7   
051C                          ENDIF      
051C                          IF   QK   
051C                             ; The closer at this level: remember the skip (if it started in the program
051C                             ; text), and return A = 0 for ")" or 2 for "]".
051C   F5                     PUSH   AF   
051D   E5                     PUSH   HL   
051E   2A 3C 17               LD   HL,(SKPL)   
0521   7C                     LD   A,H   
0522   FE 18                  CP   PROG/256   
0524   38 11                  JR   C,sq9   
0526   7D                     LD   A,L   
0527   87                     ADD   A,A   
0528   87                     ADD   A,A   
0529   5F                     LD   E,A   
052A   16 14                  LD   D,CPAGE   
052C   7D                     LD   A,L   
052D   12                     LD   (DE),A   
052E   1C                     INC   E   
052F   7C                     LD   A,H   
0530   12                     LD   (DE),A   
0531   1C                     INC   E   
0532   79                     LD   A,C   
0533   12                     LD   (DE),A   
0534   1C                     INC   E   
0535   78                     LD   A,B   
0536   12                     LD   (DE),A   
0537   E1           SQ9:      POP   HL   
0538   F1                     POP   AF   
0539   C9                     RET      
053A                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
053A   E5           SKCLR:    PUSH   HL   
053B   21 00 14               LD   HL,CPAGE*256   
053E   36 00        SKC1:     LD   (HL),0   
0540   2C                     INC   L   
0541   20 FB                  JR   NZ,skc1   
0543   E1                     POP   HL   
0544   C9                     RET      
0545                          ENDIF      
0545                             ;  ---- Speed-ups (base builds) -------------------------------------------
0545                             ;  The skip cache is above. These are the handlers' tails that the builds with
0545                             ;  room take, kept here, out of the handlers' first two pages.
0545                          IF   QK   
0545                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
0545                             ; multiplier (most multiplications have one, a count or a small constant).
0545   7C           MULQ:     LD   A,H   
0546   B7                     OR   A   
0547   28 05                  JR   Z,mq8   ; the multiplier is below 256
0549   7A                     LD   A,D   
054A   B7                     OR   A   
054B   20 2F                  JR   NZ,mq16   
054D   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
054E                          ENDIF      
054E                          IF   QK*(1-FAST)   
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              PUSH   BC   
                              LD   B,8   
                    MQ1:      ADD   HL,HL   
                              RLA      
                              JR   NC,mq2   
                              ADD   HL,DE   
                    MQ2:      DJNZ   mq1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    MQ3:      ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mq4   
                              ADD   HL,DE   
                    MQ4:      DJNZ   mq3   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
054E                          ENDIF      
054E                          IF   FAST   
054E                             ; (the fast build: the same rounds, unrolled)
054E   7D           MQ8:      LD   A,L   
054F   21 00 00               LD   HL,0   
0552   29                     ADD   HL,HL   
0553   17                     RLA      
0554   30 01                  JR   NC,mur0   
0556   19                     ADD   HL,DE   
0557                MUR0:        
0557   29                     ADD   HL,HL   
0558   17                     RLA      
0559   30 01                  JR   NC,mur1   
055B   19                     ADD   HL,DE   
055C                MUR1:        
055C   29                     ADD   HL,HL   
055D   17                     RLA      
055E   30 01                  JR   NC,mur2   
0560   19                     ADD   HL,DE   
0561                MUR2:        
0561   29                     ADD   HL,HL   
0562   17                     RLA      
0563   30 01                  JR   NC,mur3   
0565   19                     ADD   HL,DE   
0566                MUR3:        
0566   29                     ADD   HL,HL   
0567   17                     RLA      
0568   30 01                  JR   NC,mur4   
056A   19                     ADD   HL,DE   
056B                MUR4:        
056B   29                     ADD   HL,HL   
056C   17                     RLA      
056D   30 01                  JR   NC,mur5   
056F   19                     ADD   HL,DE   
0570                MUR5:        
0570   29                     ADD   HL,HL   
0571   17                     RLA      
0572   30 01                  JR   NC,mur6   
0574   19                     ADD   HL,DE   
0575                MUR6:        
0575   29                     ADD   HL,HL   
0576   17                     RLA      
0577   30 01                  JR   NC,mur7   
0579   19                     ADD   HL,DE   
057A                MUR7:        
057A                          ;*Macro unroll:  NEXT
057A                          DS   (1-CPM)*(1-FAST),0F7h   
057A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
057B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
057C   C5           MQ16:     PUSH   BC   
057D   7C                     LD   A,H   
057E   4D                     LD   C,L   
057F   21 00 00               LD   HL,0   
0582   29                     ADD   HL,HL   
0583   CB 21                  SLA   C   
0585   17                     RLA      
0586   30 01                  JR   NC,mus0   
0588   19                     ADD   HL,DE   
0589                MUS0:        
0589   29                     ADD   HL,HL   
058A   CB 21                  SLA   C   
058C   17                     RLA      
058D   30 01                  JR   NC,mus1   
058F   19                     ADD   HL,DE   
0590                MUS1:        
0590   29                     ADD   HL,HL   
0591   CB 21                  SLA   C   
0593   17                     RLA      
0594   30 01                  JR   NC,mus2   
0596   19                     ADD   HL,DE   
0597                MUS2:        
0597   29                     ADD   HL,HL   
0598   CB 21                  SLA   C   
059A   17                     RLA      
059B   30 01                  JR   NC,mus3   
059D   19                     ADD   HL,DE   
059E                MUS3:        
059E   29                     ADD   HL,HL   
059F   CB 21                  SLA   C   
05A1   17                     RLA      
05A2   30 01                  JR   NC,mus4   
05A4   19                     ADD   HL,DE   
05A5                MUS4:        
05A5   29                     ADD   HL,HL   
05A6   CB 21                  SLA   C   
05A8   17                     RLA      
05A9   30 01                  JR   NC,mus5   
05AB   19                     ADD   HL,DE   
05AC                MUS5:        
05AC   29                     ADD   HL,HL   
05AD   CB 21                  SLA   C   
05AF   17                     RLA      
05B0   30 01                  JR   NC,mus6   
05B2   19                     ADD   HL,DE   
05B3                MUS6:        
05B3   29                     ADD   HL,HL   
05B4   CB 21                  SLA   C   
05B6   17                     RLA      
05B7   30 01                  JR   NC,mus7   
05B9   19                     ADD   HL,DE   
05BA                MUS7:        
05BA   29                     ADD   HL,HL   
05BB   CB 21                  SLA   C   
05BD   17                     RLA      
05BE   30 01                  JR   NC,mus8   
05C0   19                     ADD   HL,DE   
05C1                MUS8:        
05C1   29                     ADD   HL,HL   
05C2   CB 21                  SLA   C   
05C4   17                     RLA      
05C5   30 01                  JR   NC,mus9   
05C7   19                     ADD   HL,DE   
05C8                MUS9:        
05C8   29                     ADD   HL,HL   
05C9   CB 21                  SLA   C   
05CB   17                     RLA      
05CC   30 01                  JR   NC,mus10   
05CE   19                     ADD   HL,DE   
05CF                MUS10:       
05CF   29                     ADD   HL,HL   
05D0   CB 21                  SLA   C   
05D2   17                     RLA      
05D3   30 01                  JR   NC,mus11   
05D5   19                     ADD   HL,DE   
05D6                MUS11:       
05D6   29                     ADD   HL,HL   
05D7   CB 21                  SLA   C   
05D9   17                     RLA      
05DA   30 01                  JR   NC,mus12   
05DC   19                     ADD   HL,DE   
05DD                MUS12:       
05DD   29                     ADD   HL,HL   
05DE   CB 21                  SLA   C   
05E0   17                     RLA      
05E1   30 01                  JR   NC,mus13   
05E3   19                     ADD   HL,DE   
05E4                MUS13:       
05E4   29                     ADD   HL,HL   
05E5   CB 21                  SLA   C   
05E7   17                     RLA      
05E8   30 01                  JR   NC,mus14   
05EA   19                     ADD   HL,DE   
05EB                MUS14:       
05EB   29                     ADD   HL,HL   
05EC   CB 21                  SLA   C   
05EE   17                     RLA      
05EF   30 01                  JR   NC,mus15   
05F1   19                     ADD   HL,DE   
05F2                MUS15:       
05F2   C1                     POP   BC   
05F3                          ;*Macro unroll:  NEXT
05F3                          DS   (1-CPM)*(1-FAST),0F7h   
05F3   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
05F4   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
05F5                          ENDIF      
05F5                          IF   QK   
05F5                             ; A true ")" reads the block start where it is, on top of the return stack,
05F5                             ; instead of popping it and pushing it back; the break key is looked at as
05F5                             ; rpushn would.
05F5   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
05F8   FD 46 01               LD   B,(IY+1)   
05FB   E5                     PUSH   HL   
05FC   21 36 17               LD   HL,PCNT   
05FF   35                     DEC   (HL)   
0600   E1                     POP   HL   
0601   CC 56 06               CALL   Z,pollk   
0604                          ;*Macro unroll:  NEXT
0604                          DS   (1-CPM)*(1-FAST),0F7h   
0604   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0605   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0606                          ENDIF      
0606                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0606                          ENDIF      
0606                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
0606                          ENDIF      
0606                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
0606                          ENDIF      
0606                             ; =============================================================================
0606                             ;  Dispatch table: the low byte of each handler's address, in code order
0606                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0606                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0606                             ; =============================================================================
0606                             ; The handlers of the first NPG1 characters start in the image's second page.
0606                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0606                             ; differs between the builds, so the count is worked out here.
0606                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0606                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0606                PGBRK:    EQU   (h_break-BASE)/256   
0606                PGDEF:    EQU   (h_def-BASE)/256   
0606                PGFET:    EQU   (h_fetch-BASE)/256   
0606                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0606                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0606                          ENDIF      
0606                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0606                             ; and return its value in A with the carry set; otherwise leave the IP and
0606                             ; return with the carry clear.
0606   0A           HEXC:     LD   A,(BC)   
0607   D6 30                  SUB   "0"   
0609   FE 0A                  CP   10   
060B   38 09                  JR   C,hc1   
060D   E6 DF                  AND   0DFh   
060F   D6 11                  SUB   11h   
0611   FE 06                  CP   6   
0613   D0                     RET   NC   
0614   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0616   03           HC1:      INC   BC   
0617   C9                     RET      
0618                             ; psgn: print HL as a signed number. Keeps BC.
0618   CB 7C        PSGN:     BIT   7,H   
061A   28 07                  JR   Z,pdec   
061C                          ;*Macro unroll:  PUTK    2Dh             ; '-'
061C                          DS   1-CPM,3Eh   ; "-"
061C                          DS   1-CPM,2Dh   
061C                          DS   1-CPM,0EFh   
061C   CD                     DS   CPM,0CDh   
061D   BC                     DS   CPM,APTK&0FFh   
061E   06                     DS   CPM,APTK/256   
061F   2D                     DS   CPM,2Dh   
0620                          ;*Macro unroll:  NEGH
0620                          DS   1-CPM,0E7h   
0620   CD                     DS   CPM,0CDh   
0621   9F                     DS   CPM,ANEG&0FFh   
0622   06                     DS   CPM,ANEG/256   
0623                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0623                             ; Keeps BC.
0623   11 0A 00     PDEC:     LD   DE,10   
0626   CD 7F 03               CALL   udiv   ; HL = HL / 10, E = the last digit
0629   7B                     LD   A,E   
062A   F5                     PUSH   AF   
062B   7C                     LD   A,H   
062C   B5                     OR   L   
062D   C4 23 06               CALL   NZ,pdec   
0630   F1                     POP   AF   
0631   C6 30                  ADD   A,"0"   
0633                          ;*Macro unroll:  PUTAR
0633                          DS   1-CPM,0EFh   
0633                          DS   1-CPM,0C9h   
0633   C3                     DS   CPM,0C3h   
0634   C0                     DS   CPM,APUT&0FFh   
0635   06                     DS   CPM,APUT/256   
0636                             ; (The table goes here instead in the builds where, before psgn, it would
0636                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0636                             ; page: PTPAD is 0 unless it must.)
0636                          IF   (1-TABP0)*PTLATE   
0636                PTPH:     EQU   $ & 0FFh   
0636                PTPX:     EQU   (PTPH + 31) / 256   
0636                PTPAD:    EQU   PTPX * (256 - PTPH)   
0636                          DS   PTPAD   
0636                PTAB:        
0636                          ;*Macro unroll:  PTABLE
0636   69                     DB   h_store & 0FFh   
0637   73                     DB   h_str & 0FFh   
0638   8F                     DB   h_num & 0FFh   
0639   7F                     DB   h_print & 0FFh   
063A   5E                     DB   h_swap & 0FFh   
063B   0F                     DB   h_and & 0FFh   
063C   88                     DB   h_emit & 0FFh   
063D   E8                     DB   h_open & 0FFh   
063E   F0                     DB   h_close & 0FFh   
063F   32                     DB   h_mul & 0FFh   
0640   02                     DB   h_add & 0FFh   
0641   AD                     DB   h_cfetch & 0FFh   
0642   F8                     DB   h_sub & 0FFh   
0643   61                     DB   h_cstore & 0FFh   
0644   36                     DB   h_div & 0FFh   
0645   5B                     DB   h_dup & 0FFh   
0646   66                     DB   h_drop & 0FFh   
0647   18                     DB   h_lt & 0FFh   
0648   28                     DB   h_eq & 0FFh   
0649   19                     DB   h_gt & 0FFh   
064A   95                     DB   h_key & 0FFh   
064B   E2                     DB   h_fetch & 0FFh   
064C   BD                     DB   h_def & 0FFh   
064D   AD                     DB   h_break & 0FFh   
064E   A6                     DB   h_ret & 0FFh   
064F   35                     DB   h_xor & 0FFh   
0650   4D                     DB   h_alloc & 0FFh   
0651   8E                     DB   h_grave & 0FFh   
0652   8A                     DB   h_tor & 0FFh   
0653   3E                     DB   h_or & 0FFh   
0654   06                     DB   h_fromr & 0FFh   
0655   47                     DB   h_not & 0FFh   
0656                PTABEND:      
0656                          ENDIF      
0656                             ; =============================================================================
0656                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0656                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0656                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0656                             ;  they are the host's KEY and CONOUT routines themselves.
0656                             ; 
0656                             ;  A running program reads the keyboard only through getk and pollk, which
0656                             ;  between them give the break key its rules:
0656                             ;    - Ctrl-C stops the program;
0656                             ;    - any other key that the break check reads is held in KEYBUF for the
0656                             ;      next "?", and a newer one takes its place;
0656                             ;    - "?" (getk) takes the held key first;
0656                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0656                             ;      key like any other, but two of them within about 250 ms still stop it.
0656                             ;  Both are called straight from a handler, never from a routine under one:
0656                             ;  the checked build's report counts on finding one return address above the
0656                             ;  data stack.
0656                             ; =============================================================================
0656                          IFN   CPM   
                    RAWK:     EQU   KEY   
0656                          ENDIF      
0656                             ; pollk: the break check (see rpushn).
0656   CD B8 06     POLLK:    CALL   rawk   
0659   C8                     RET   Z   ; no key
065A   32 7A 17               LD   (KEYBUF),A   ; held for the next "?"
065D   FE 03        PK1:      CP   3   ; (getk joins here)
065F   C0                     RET   NZ   
0660                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0660                             ; the program has turned it off, wait about 250 ms for one more key: a
0660                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0660                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0660   3A 7B 17     CTLC:     LD   A,(BRKOFF)   
0663   B7                     OR   A   
0664   CA 3D 07     CT0:      JP   Z,brk   
0667   D5                     PUSH   DE   
0668   11 E8 03               LD   DE,250*MSLOOP   
066B   CD B8 06     CT1:      CALL   rawk   
066E   20 05                  JR   NZ,ct2   
0670   1B                     DEC   DE   
0671   7A                     LD   A,D   
0672   B3                     OR   E   
0673   20 F6                  JR   NZ,ct1   
0675   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0676   FE 03                  CP   3   
0678   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
067A   B7                     OR   A   
067B   28 03                  JR   Z,ct3   
067D   32 7A 17               LD   (KEYBUF),A   
0680   3E 03        CT3:      LD   A,3   
0682   B7                     OR   A   
0683   C9                     RET      
0684                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0684   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0685   21 7A 17               LD   HL,KEYBUF   ;   the buffer
0688   7E                     LD   A,(HL)   
0689   36 00                  LD   (HL),0   
068B   E1                     POP   HL   
068C   B7                     OR   A   
068D   C0                     RET   NZ   
068E   CD B8 06               CALL   rawk   
0691   C8                     RET   Z   
0692   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0694                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0694                          ENDIF      ;   (with the editor, both stacks are cleared);
0694                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0694                          ENDIF      
0694                          IF   CHECKED   
0694                BRK:      EQU   e_break   ;   the checked build reports B
0694                          ENDIF      
0694                          IF   CPM   
0694                             ; The routines a generic build keeps in page zero (see there). Here they are
0694                             ; out of the way of the handlers, which must fit in the image's first two
0694                             ; pages.
0694   FD 5E 00     RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
0697   FD 56 01               LD   D,(IY+1)   
069A   FD 23                  INC   IY   
069C   FD 23                  INC   IY   
069E   C9                     RET      
069F   AF           NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
06A0   95                     SUB   L   
06A1   6F                     LD   L,A   
06A2   9F                     SBC   A,A   
06A3   94                     SUB   H   
06A4   67                     LD   H,A   
06A5   C9                     RET      
06A6                          ENDIF      
06A6                          IF   CPM*CHECKED   ; (the checked builds need the room)
06A6   FD 22 34 17  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
06AA   CD 8D 01               CALL   jphl   
06AD   FD 2A 34 17            LD   IY,(RSAVE)   
06B1                          ;*Macro unroll:  SETIX
06B1   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
06B2   21                     DS   CPM+FAST-CPM*FAST,21h   
06B3   14                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
06B4   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
06B5   E1                     POP   HL   
06B6                          ;*Macro unroll:  NEXT
06B6                          DS   (1-CPM)*(1-FAST),0F7h   
06B6   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
06B7   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
06B8                          ENDIF      
06B8                          IF   CPM   
06B8   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
06BA   18 04                  JR   putc   
06BC   E3           PUTK:     EX   (SP),HL   ; print the byte after the CALL
06BD   7E                     LD   A,(HL)   
06BE   23                     INC   HL   
06BF   E3                     EX   (SP),HL   
06C0                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
06C0                             ; printing and could swallow a key that BDOS 6 then never sees.
06C0                             ; It keeps every register but A and the flags: BDOS may change any of them
06C0                             ; (IX and IY too, in a Z80 BDOS or BIOS).
06C0   C5           PUTC:     PUSH   BC   
06C1   D5                     PUSH   DE   
06C2   E5                     PUSH   HL   
06C3   DD E5                  PUSH   IX   
06C5   FD E5                  PUSH   IY   
06C7   5F                     LD   E,A   
06C8   0E 06                  LD   C,6   
06CA   CD 05 00               CALL   BDOS   
06CD   FD E1                  POP   IY   
06CF   DD E1                  POP   IX   
06D1   E1                     POP   HL   
06D2   D1                     POP   DE   
06D3   C1                     POP   BC   
06D4   B7                     OR   A   ; (for getk)
06D5   C9                     RET      
06D6                          ENDIF      
06D6                             ; =============================================================================
06D6                             ;  Checked build: the checks and the error report
06D6                             ; =============================================================================
06D6                          IF   CHECKED   
06D6                             ; chkstk: both stacks are checked once per character, not in every handler.
06D6                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
06D6                             ; the constant carries if it is above (cells were popped that were never
06D6                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
06D6                             ; a character late at most: the bytes above DSTOP and the guard band below
06D6                             ; the page take what happens meanwhile. DE is free between characters.
06D6   EB           CHKSTK:   EX   DE,HL   
06D7   21 05 E9               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
06DA   39                     ADD   HL,SP   
06DB   EB                     EX   DE,HL   
06DC   38 1E                  JR   C,e_under   
06DE   14                     INC   D   
06DF   20 17                  JR   NZ,e_over   
06E1   FD E5                  PUSH   IY   ; the return stack: in its page (or it has
06E3   D1                     POP   DE   ;   overflowed), and not above its empty
06E4   7A                     LD   A,D   ;   position (an underflow stays inside the
06E5   FE 15                  CP   RSPAGE   ;   page, in the guard band)
06E7   7B                     LD   A,E   
06E8   20 0B                  JR   NZ,e_rover   
06EA   FE E1                  CP   RSTOP&0FFh+1   
06EC   D8                     RET   C   
06ED   FD 21 E0 15            LD   IY,RSTOP   ; return stack underflow: it counts as empty
06F1   3E 72                  LD   A,"r"   
06F3   18 4A                  JR   errp   
06F5   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
06F7   11                     DB   11h   ; (LD DE,nn hides the next entry)
06F8   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
06FA   18 43                  JR   errp   
06FC   31 FC 16     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
06FF   3E 73                  LD   A,"s"   
0701   18 56                  JR   error   
0703                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0703                             ; was never defined still holds 0000h, and the byte there is a reserved one
0703                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0703                             ; an undefined word. The call is undone, so the place is the call itself.
0703   04           E_HI:     INC   B   
0704   10 4B                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0706                          ;*Macro unroll:  POPR
0706                          DS   1-CPM,0CFh   
0706   CD                     DS   CPM,0CDh   
0707   94                     DS   CPM,AROP&0FFh   
0708   06                     DS   CPM,AROP/256   
0709   42                     LD   B,D   
070A   4B                     LD   C,E   
070B   3E 55                  LD   A,"U"   
070D   18 4A                  JR   error   
070F                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
070F                             ; the count. Stop if the top is not below the limit page, or is below the
070F                             ; program's end.
070F                CHKHP:       
070F                          ENDIF      
070F                          IF   CHECKED*CPM   
070F                             ; With this much room a top that wrapped round can land back in
070F                             ; range, so the add is tested too: growing (A, the count's high
070F                             ; byte, is positive) must not carry, and releasing must.
070F   1F                     RRA      ; the carry comes in above the sign:
0710   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
0712   87                     ADD   A,A   
0713   38 10                  JR   C,e_heap   
0715   3A 07 00               LD   A,(0007h)   
0718   3D                     DEC   A   
0719   BC                     CP   H   
071A   38 09                  JR   C,e_heap   
071C                          ENDIF      
071C                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
071C                          ENDIF      
071C                          IF   CHECKED   
071C   D5                     PUSH   DE   
071D   EB                     EX   DE,HL   
071E   2A 38 17               LD   HL,(NPEND)   
0721   19                     ADD   HL,DE   ; carry: at or above the program's end
0722   EB                     EX   DE,HL   
0723   D1                     POP   DE   
0724   D8                     RET   C   
0725   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0726   ED 52                  SBC   HL,DE   
0728   3E 48                  LD   A,"H"   
072A   18 13                  JR   errp   
072C                             ; chkst: stop unless HL is in the program's own space: from the letter page
072C                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
072C                             ; whatever lies above the limit are safe. Memory above the heap top but
072C                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
072C                             ; It is the page of HL + 1 that is tested, so that one test serves both
072C                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
072C                             ; Keeps HL and BC. It runs on into its own error entry.
072C   23           CHKST:    INC   HL   
072D   7C                     LD   A,H   
072E   2B                     DEC   HL   
072F   FE 17                  CP   LETPAGE   
0731   38 07                  JR   C,e_store   
0733                          ENDIF      
0733                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0733                          ENDIF      
0733                          IF   CHECKED*CPM   
0733   5F                     LD   E,A   
0734   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0737   3D                     DEC   A   
0738   BB                     CP   E   
0739   D0                     RET   NC   
073A                          ENDIF      
073A                          IF   CHECKED   
073A                             ; Error entries. Each loads its letter and then hides the next entry inside
073A                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
073A   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
073C   11                     DB   11h   
073D   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
073F                             ; errp: an error found inside a routine: drop its return address first.
073F   D1           ERRP:     POP   DE   
0740   18 17                  JR   error   
0742                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
0742                             ; back in TOS. prstr"s return address goes first. But if "$' had no
0742                             ; address at all (the stack was empty), it is s, found now: chkstk, called
0742                             ; one cell up, sees the stack past its empty place then.
0742   D1           E_DOLLAR:   POP   DE   
0743   E1                     POP   HL   
0744   CD D6 06               CALL   chkstk   
0747   E5                     PUSH   HL   
0748   2A 34 17               LD   HL,(RSAVE)   
074B   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
074C   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
074D   4D                     LD   C,L   ;   past the opening quote, which is the place
074E   3E 51                  LD   A,"Q"   
0750   11                     DB   11h   
0751   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
0753   11                     DB   11h   
0754   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0756   11                     DB   11h   
0757   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0759                             ; error: the report, then the end. A = the letter, BC = one past the place,
0759                             ; HL = TOS, and both stacks as the report is to show them:
0759                             ; 
0759                             ;   Err X @ line,col
0759                             ;   D:n: the top 8 cells at most, bottom to top
0759                             ;   R:n
0759   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
075A   5F                     LD   E,A   
075B   CD 02 03               CALL   pnl   
075E   45 72 72 20 22         DB   "Err ",22h   
0763   7B                     LD   A,E   
0764                          ;*Macro unroll:  PUTA
0764                          DS   1-CPM,0EFh   
0764   CD                     DS   CPM,0CDh   
0765   C0                     DS   CPM,APUT&0FFh   
0766   06                     DS   CPM,APUT/256   
0767   CD 08 03               CALL   pmsg   
076A   20 40 20 22            DB   " @ ",22h   
076E   0B                     DEC   BC   ; BC = the place
076F                             ; The line and column. A place below the program is in the line
076F                             ; buffer: line 0. Otherwise count the LFs from the program's start;
076F                             ; DE = the line's number, HL = where it starts.
076F   21 80 17               LD   HL,LINEBUF   
0772   11 00 00               LD   DE,0   
0775   78                     LD   A,B   
0776   FE 18                  CP   PROG/256   
0778   38 14                  JR   C,er3   
077A   24                     INC   H   
077B   6B                     LD   L,E   ; HL = PROG
077C   13           ER1:      INC   DE   ; a new line starts at HL
077D   E5                     PUSH   HL   
077E   7D           ER2:      LD   A,L   
077F   91                     SUB   C   
0780   7C                     LD   A,H   
0781   98                     SBC   A,B   
0782   30 09                  JR   NC,er2x   ; reached the place
0784   7E                     LD   A,(HL)   
0785   23                     INC   HL   
0786   FE 0A                  CP   10   
0788   20 F4                  JR   NZ,er2   
078A   F1                     POP   AF   
078B   18 EF                  JR   er1   
078D   E1           ER2X:     POP   HL   
078E   C5           ER3:      PUSH   BC   
078F   E5                     PUSH   HL   
0790   EB                     EX   DE,HL   
0791   CD 23 06               CALL   pdec   ; the line
0794                          ;*Macro unroll:  PUTK    2Ch             ; ','
0794                          DS   1-CPM,3Eh   ; ","
0794                          DS   1-CPM,2Ch   
0794                          DS   1-CPM,0EFh   
0794   CD                     DS   CPM,0CDh   
0795   BC                     DS   CPM,APTK&0FFh   
0796   06                     DS   CPM,APTK/256   
0797   2C                     DS   CPM,2Ch   
0798   D1                     POP   DE   
0799   E1                     POP   HL   
079A   B7                     OR   A   
079B   ED 52                  SBC   HL,DE   
079D   23                     INC   HL   
079E   CD 23 06               CALL   pdec   ; the column
07A1                             ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
07A1                             ;                       R:n
07A1                             ; TOS is in memory with the rest (pushed) by now.
07A1   CD 02 03               CALL   pnl   
07A4   44 3A 22               DB   "D:",22h   
07A7   21 FA 16               LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
07AA   ED 72                  SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
07AC                             ;   and holds nothing; pnl left the carry clear)
07AC   CD F4 07               CALL   phalf   ; the depth
07AF                          ;*Macro unroll:  PUTK    3Ah             ; ':'
07AF                          DS   1-CPM,3Eh   ; ":"
07AF                          DS   1-CPM,3Ah   
07AF                          DS   1-CPM,0EFh   
07AF   CD                     DS   CPM,0CDh   
07B0   BC                     DS   CPM,APTK&0FFh   
07B1   06                     DS   CPM,APTK/256   
07B2   3A                     DS   CPM,3Ah   
07B3   79                     LD   A,C   
07B4   FE 09                  CP   9   
07B6   38 0A                  JR   C,er6   
07B8   CD 08 03               CALL   pmsg   
07BB   20 2E 2E 2E 22         DB   " ...",22h   
07C0   0E 08                  LD   C,8   
07C2   26 00        ER6:      LD   H,0   ; C = the number of cells to show
07C4   69                     LD   L,C   
07C5   29                     ADD   HL,HL   
07C6   39                     ADD   HL,SP   ; HL -> just above the deepest of them
07C7   0C                     INC   C   
07C8   0D           ER7:      DEC   C   
07C9   28 10                  JR   Z,er8   
07CB   2B                     DEC   HL   
07CC   56                     LD   D,(HL)   
07CD   2B                     DEC   HL   
07CE   5E                     LD   E,(HL)   
07CF   E5                     PUSH   HL   
07D0                          ;*Macro unroll:  PUTK    20h             ; ' '
07D0                          DS   1-CPM,3Eh   ; " "
07D0                          DS   1-CPM,20h   
07D0                          DS   1-CPM,0EFh   
07D0   CD                     DS   CPM,0CDh   
07D1   BC                     DS   CPM,APTK&0FFh   
07D2   06                     DS   CPM,APTK/256   
07D3   20                     DS   CPM,20h   
07D4   EB                     EX   DE,HL   
07D5   CD 18 06               CALL   psgn   
07D8   E1                     POP   HL   
07D9   18 ED                  JR   er7   
07DB   CD 02 03     ER8:      CALL   pnl   
07DE   52 3A 22               DB   "R:",22h   
07E1   FD E5                  PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
07E3   E1                     POP   HL   ;   at most one entry below its page), so
07E4   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough
07E6   95                     SUB   L   
07E7   6F                     LD   L,A   
07E8   26 00                  LD   H,0   
07EA   CD F4 07               CALL   phalf   
07ED   CD 02 03               CALL   pnl   
07F0   22                     DB   22h   
07F1                          ENDIF      
07F1                          IF   CHECKED*(1-EDITOR)   
07F1   C3 11 01               JP   endprog   
07F4                          ENDIF      
07F4                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
07F4                          ENDIF      
07F4                          IF   CHECKED   
07F4                             ; phalf: print half of HL, and leave it in C.
07F4   CB 3C        PHALF:    SRL   H   
07F6   CB 1D                  RR   L   
07F8   E5                     PUSH   HL   
07F9   CD 23 06               CALL   pdec   
07FC   C1                     POP   BC   
07FD   C9                     RET      
07FE                          ENDIF      
07FE                             ; =============================================================================
07FE                             ;  The line editor (EDITOR = 1)
07FE                             ; 
07FE                             ;  The interpreter starts here, and a program that ends comes back here.
07FE                             ;  There is no prompt. It follows the spec's suggested standard for a line
07FE                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
07FE                             ; 
07FE                             ;    n text    put the text in as line n; the lines from n on move down. A
07FE                             ;              number past the end (or 0) adds the line at the end.
07FE                             ;    n         take line n out
07FE                             ;    anything else is run at once, as B8Script. (Start such a line with a
07FE                             ;    space if it would begin with a digit.)
07FE                             ; 
07FE                             ;  A command key ends the line too, and takes what was typed as its argument:
07FE                             ; 
07FE                             ;    ^G        run the program
07FE                             ;    n ^L      list from line n (no number: all of it). Any key holds the
07FE                             ;              list until another key is pressed; Ctrl-C ends it.
07FE                             ;    n ^E      put line n in the input line; Return puts it back, changed
07FE                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
07FE                             ;              last time). Generic: what is typed, or pasted, from now until
07FE                             ;              ^Z replaces the program; it is not echoed.
07FE                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
07FE                             ;              time). Generic: the text is printed, as it is.
07FE                             ;    ^N        new: no program
07FE                             ;    ^X        leave (to LEAVE)
07FE                             ; 
07FE                             ;  In the line: the left and right arrow keys move the cursor;
07FE                             ;  a character goes in at the cursor; Backspace and DEL take out the one
07FE                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
07FE                             ;  sent to the terminal, so any terminal will do.
07FE                             ; 
07FE                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
07FE                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
07FE                             ;  125 characters; the one character after a line number separates it from
07FE                             ;  the text and is not stored. The text is kept as it is typed, each line
07FE                             ;  ending in CR LF, at PROG.
07FE                             ; 
07FE                             ;  What lasts from one line to the next: the program, the words, the
07FE                             ;  variables and the data stack. An error or a break clears both stacks. The
07FE                             ;  return stack starts empty for every line.
07FE                             ; 
07FE                             ;  Things to know:
07FE                             ;    - Reset empties the program (generic builds).
07FE                             ;    - A word's address points into the program, so run the program again
07FE                             ;      after editing it.
07FE                             ;    - Nothing is printed between a program's output and what is typed next.
07FE                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
07FE                             ;      a line that calls -n? and carries on afterwards runs what was typed.
07FE                             ;      (The stored program never comes back to the line, so it may.)
07FE                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
07FE                             ;      read of the other builds.
07FE                             ; 
07FE                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
07FE                             ;  the last line left there, with TOS pushed like the rest.
07FE                             ; =============================================================================
07FE                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
07FE                          ENDIF      
07FE                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
07FE                          ENDIF      
07FE                          IF   EDGEN   
                              JR   edit0   
07FE                          ENDIF      
07FE                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
07FE                          ENDIF      
07FE                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
07FE                          ENDIF      
07FE                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
07FE                          ENDIF      
07FE                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
07FE                          ENDIF      
07FE                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
07FE                          ENDIF      
07FE                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
07FE                          ENDIF      
07FE                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
07FE                          ENDIF      
07FE                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
07FE                          ENDIF      
07FE                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
07FE                          ENDIF      
07FE                             ; =============================================================================
07FE                          IF   CPM   
07FE                             ; The RAM pages follow the image; the heap may grow to the BDOS.
07FE                START:       
07FE                          ENDIF      
07FE                          IF   CPM*CHECKED*(1-EDITOR)   
07FE                             ; Clear the lower half of the letter page (as the editor build does
07FE                             ; at its start).
07FE   21 00 17               LD   HL,LET   
0801   AF                     XOR   A   
0802   77           INI1:     LD   (HL),A   
0803   2C                     INC   L   
0804   F2 02 08               JP   P,ini1   ; +00h to +7Fh
0807                          ENDIF      
0807                          IF   CPM*(1-EDITOR)   
0807   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
080A   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
080C   CD 05 00               CALL   BDOS   ;   and the program is empty)
080F   11 00 18               LD   DE,PROG   
0812   D5           LD1:      PUSH   DE   
0813   0E 1A                  LD   C,26   ; set the DMA address
0815   CD 05 00               CALL   BDOS   
0818   11 5C 00               LD   DE,005Ch   
081B   0E 14                  LD   C,20   ; read the next 128 bytes
081D   CD 05 00               CALL   BDOS   
0820   E1                     POP   HL   ; HL = the address this record went to
0821   B7                     OR   A   
0822   20 07                  JR   NZ,ld2   
0824   11 80 00               LD   DE,128   
0827   19                     ADD   HL,DE   
0828   EB                     EX   DE,HL   
0829   18 E7                  JR   ld1   
082B   36 00        LD2:      LD   (HL),0   ; the end of the file counts as NUL
082D   23                     INC   HL   ; the heap starts after it
082E   01 00 18               LD   BC,PROG   ; the IP
0831                          ENDIF      
0831                          IF   CPM*(1-EDITOR)*QK   
0831   CD 3A 05               CALL   skclr   ; an empty skip cache
0834                          ENDIF      
0834                          IF   CPM*(1-EDITOR)   
0834   C3 22 01               JP   st2   
0837                          ENDIF      
0837                          IF   FAST   
0837                             ; =============================================================================
0837                             ;  The fast build (SPEED = 2)
0837                             ; 
0837                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
0837                             ;  addresses in one page and the high bytes in the next. The dispatcher (at
0837                             ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
0837                             ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
0837                             ;  IX = next0, as in the CP/M builds):
0837                             ; 
0837                             ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
0837                             ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
0837                             ; 
0837                             ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
0837                             ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
0837                             ;  digits have one entry each, which knows its cell or its value already.
0837                             ; =============================================================================
0837   EB           FTSTORE:   EX   DE,HL   ; !
0838   C3 69 02               JP   h_store   
083B   EB           FTSTR:    EX   DE,HL   ; "
083C   C3 73 02               JP   h_str   
083F   EB           FTNUM:    EX   DE,HL   ; #
0840   C3 8F 02               JP   h_num   
0843   EB           FTPRINT:   EX   DE,HL   ; $
0844   C3 7F 02               JP   h_print   
0847   EB           FTSWAP:   EX   DE,HL   ; %
0848   C3 5E 02               JP   h_swap   
084B   EB           FTAND:    EX   DE,HL   ; &
084C   C3 0F 02               JP   h_and   
084F   EB           FTEMIT:   EX   DE,HL   ; '
0850   C3 88 02               JP   h_emit   
0853   EB           FTOPEN:   EX   DE,HL   ; (
0854   C3 E8 01               JP   h_open   
0857   EB           FTCLOSE:   EX   DE,HL   ; )
0858   C3 F0 01               JP   h_close   
085B   EB           FTMUL:    EX   DE,HL   ; *
085C   C3 32 02               JP   h_mul   
085F   EB           FTADD:    EX   DE,HL   ; +
0860   C3 02 02               JP   h_add   
0863   EB           FTCFETCH:   EX   DE,HL   ; ,
0864   C3 AD 02               JP   h_cfetch   
0867   EB           FTSUB:    EX   DE,HL   ; -
0868   C3 F8 01               JP   h_sub   
086B   EB           FTCSTORE:   EX   DE,HL   ; .
086C   C3 61 02               JP   h_cstore   
086F   EB           FTDIV:    EX   DE,HL   ; /
0870   C3 36 02               JP   h_div   
0873   EB           FTDUP:    EX   DE,HL   ; :
0874   C3 5B 02               JP   h_dup   
0877   EB           FTDROP:   EX   DE,HL   ; ;
0878   C3 66 02               JP   h_drop   
087B   EB           FTLT:     EX   DE,HL   ; <
087C   C3 18 02               JP   h_lt   
087F   EB           FTEQ:     EX   DE,HL   ; =
0880   C3 28 02               JP   h_eq   
0883   EB           FTGT:     EX   DE,HL   ; >
0884   C3 19 02               JP   h_gt   
0887   EB           FTKEY:    EX   DE,HL   ; ?
0888   C3 95 02               JP   h_key   
088B   EB           FTFETCH:   EX   DE,HL   ; @
088C   C3 E2 01               JP   h_fetch   
088F   EB           FTDEF:    EX   DE,HL   ; [
0890   C3 BD 01               JP   h_def   
0893   EB           FTBREAK:   EX   DE,HL   ; \
0894   C3 AD 01               JP   h_break   
0897   EB           FTRET:    EX   DE,HL   ; ]
0898   C3 A6 01               JP   h_ret   
089B   EB           FTXOR:    EX   DE,HL   ; ^
089C   C3 35 01               JP   h_xor   
089F   EB           FTALLOC:   EX   DE,HL   ; _
08A0   C3 4D 01               JP   h_alloc   
08A3   EB           FTGRAVE:   EX   DE,HL   ; `
08A4   C3 8E 01               JP   h_grave   
08A7   EB           FTTOR:    EX   DE,HL   ; {
08A8   C3 8A 01               JP   h_tor   
08AB   EB           FTOR:     EX   DE,HL   ; |
08AC   C3 3E 01               JP   h_or   
08AF   EB           FTFROMR:   EX   DE,HL   ; }
08B0   C3 06 01               JP   h_fromr   
08B3   EB           FTNOT:    EX   DE,HL   ; ~
08B4   C3 47 01               JP   h_not   
08B7                             ; The commonest punctuation, written for the fast build: TOS in DE on the
08B7                             ; way in, and the dispatcher inline on the way out.
08B7                FS_ADD:      ; +
08B7   E1                     POP   HL   
08B8   19                     ADD   HL,DE   
08B9                          ;*Macro unroll:  NEXTF
08B9   CD                     DS   FAST*CHECKED,0CDh   
08BA   D6                     DS   FAST*CHECKED,ACHK&0FFh   
08BB   06                     DS   FAST*CHECKED,ACHK/256   
