E5B0   37 06        FS_ADD:   PULU   D   ; +
E5B2   E3 C4                  ADDD   ,U   
E5B4   ED C4                  STD   ,U   
E5B6                          ;*Macro unroll:  NEXTF
E5B6   BD                     DS   CHECKED,0BDh   
E5B7   E4                     DS   CHECKED,ACHK/256   
E5B8   A2                     DS   CHECKED,ACHK&0FFh   
E5B9   E6 A0                  LDB   ,Y+   
E5BB   8E EE 9E               LDX   #FTAB   
E5BE   3A                     ABX      
