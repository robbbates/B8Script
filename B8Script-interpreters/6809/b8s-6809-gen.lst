F22F   E3 C4                  ADDD   ,U   
F231   20 38                  BRA   st   
F233   EC C1        H_AND:    LDD   ,U++   
F235   A4 C4                  ANDA   ,U   
F237   E4 41                  ANDB   1,U   
F239   20 30                  BRA   st   
F23B   EC C1        H_OR:     LDD   ,U++   
F23D   AA C4                  ORA   ,U   
F23F   EA 41                  ORB   1,U   
F241   20 28                  BRA   st   
F243   EC C1        H_XOR:    LDD   ,U++   
F245   A8 C4                  EORA   ,U   
F247   E8 41                  EORB   1,U   
F249   20 20                  BRA   st   
F24B   63 C4        H_NOT:    COM   ,U   
F24D   63 41                  COM   1,U   
F24F   39                     RTS      
F250                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F250   EC 42        CMP:      LDD   2,U   
F252   10 A3 C1               CMPD   ,U++   
F255   39                     RTS      
F256   8D F8        H_LT:     BSR   cmp   
F258   2D 0E                  BLT   true   
F25A   4F           FALSE:    CLRA      
F25B   5F                     CLRB      
F25C   20 0D                  BRA   st   
F25E   8D F0        H_GT:     BSR   cmp   
F260   2E 06                  BGT   true   
F262   20 F6                  BRA   false   
F264   8D EA        H_EQ:     BSR   cmp   
F266   26 F2                  BNE   false   
F268   CC FF FF     TRUE:     LDD   #-1   
F26B   ED C4        ST:       STD   ,U   
F26D   39                     RTS      
F26E                             ; =============================================================================
F26E                             ;  Stack
F26E                             ; =============================================================================
F26E   EC C4        H_DUP:    LDD   ,U   
F270   36 06                  PSHU   D   
F272   39                     RTS      
F273   37 16        H_SWAP:   PULU   D,X   
F275   36 06                  PSHU   D   
F277   36 10                  PSHU   X   
F279   39                     RTS      
F27A                             ; =============================================================================
F27A                             ;  Storage. The cells in RAM are little-endian: the byte order is swapped
F27A                             ;  between the stack (big-endian) and memory.
F27A                             ; =============================================================================
F27A   AE C4        H_FETCH:   LDX   ,U   ; "@"
F27C   E6 84                  LDB   ,X   
F27E   A6 01                  LDA   1,X   
F280   20 E9                  BRA   st   
F282   AE C4        H_CFETCH:   LDX   ,U   ; ","
F284   E6 84                  LDB   ,X   
F286   4F                     CLRA      
F287   20 E2                  BRA   st   
F289   AE C1        H_STORE:   LDX   ,U++   ; "!" ( n addr -- )
F28B                          IF   CHECKED   
                              BSR   chkst   ; both bytes must be in the program's space
                              LEAX   1,X   
                              BSR   chkst   
                              LEAX   -1,X   
F28B                          ENDIF      
F28B   37 06                  PULU   D   
F28D   E7 84                  STB   ,X   ; little-endian
F28F   A7 01                  STA   1,X   
F291   39                     RTS      
F292   AE C1        H_CSTORE:   LDX   ,U++   ; "." ( c addr -- )
F294                          IF   CHECKED   
                              BSR   chkst   
F294                          ENDIF      
F294   37 06                  PULU   D   
F296   E7 84                  STB   ,X   
F298   39                     RTS      
F299                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
F299   D6 7C        H_ALLOC:   LDB   <HEAP   
F29B   96 7D                  LDA   <HEAP+1   
F29D   1F 01                  TFR   D,X   ; the old pointer
F29F   E3 C4                  ADDD   ,U   
F2A1                          IF   CHECKED   
                              LBCS   e_heap   ; a negative count wraps: too big
                              CMPD   #HEAPLIM*256   
                              LBHS   e_heap   
F2A1                          ENDIF      
F2A1   D7 7C                  STB   <HEAP   
F2A3   97 7D                  STA   <HEAP+1   
F2A5   AF C4                  STX   ,U   
F2A7   39                     RTS      
F2A8                          IF   CHECKED   
                                 ; chkst: stop unless X is in the program's own space: from the letter page
                                 ; up to HEAPLIM, so the interpreter's stacks and whatever lies above the
                                 ; limit are safe. Memory above the heap top but below the limit is the
                                 ; program's own: Tiny BASIC keeps its lines there. Keeps every register.
                    CHKST:    CMPX   #LET   
                              LBLO   e_store   
                              CMPX   #HEAPLIM*256   
                              LBHS   e_store   
                              RTS      
F2A8                          ENDIF      
F2A8                             ; =============================================================================
F2A8                             ;  Flow control helpers
F2A8                             ; =============================================================================
F2A8                             ; =============================================================================
F2A8                             ;  Console
F2A8                             ; =============================================================================
F2A8                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
F2A8                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
F2A8                             ; that character itself.
F2A8   AE C4        H_PRINT:   LDX   ,U   
F2AA   A6 80        PR0:      LDA   ,X+   
F2AC   81 22                  CMPA   #22h   
F2AE   27 14                  BEQ   drop   
F2B0   81 2F                  CMPA   #"/"   
F2B2   26 08                  BNE   pr1   
F2B4   A6 80                  LDA   ,X+   
F2B6   81 40                  CMPA   #40h   
F2B8   25 02                  BLO   pr1   
F2BA   84 BF                  ANDA   #0BFh   
F2BC   8D 14        PR1:      BSR   putc   
F2BE   20 EA                  BRA   pr0   
F2C0   A6 41        H_EMIT:   LDA   1,U   ; "'"
F2C2   8D 0E                  BSR   putc   
F2C4   33 42        DROP:     LEAU   2,U   ; ";"
F2C6   39                     RTS      
F2C7                             ; =============================================================================
F2C7                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
F2C7                             ;  A = 0 with the zero flag set when none is waiting. It keeps B, X, Y, U.
F2C7                             ; =============================================================================
F2C7                GETK:        
F2C7                          IF   CHECKED   
                              LDA   <KEYBUF   ; a key held back by the break check
                              BEQ   gk1   
                              CLR   <KEYBUF   
                              TSTA      
                              RTS      
                    GK1:         
F2C7                          ENDIF      
F2C7   BD FF 06               JSR   CONST   
F2CA   4D                     TSTA      
F2CB   27 04                  BEQ   gk9   
F2CD   BD FF 00               JSR   CONIN   
F2D0   4D                     TSTA      
F2D1   39           GK9:      RTS      
F2D2                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   LDA   <KEYBUF   
                              BNE   cb9   ; one key is already held
                              BSR   getk   
                              BEQ   cb9   
                              CMPA   #3   
                              LBEQ   e_break   
                              STA   <KEYBUF   
                    CB9:      RTS      
F2D2                          ENDIF      
F2D2   7E FF 03     PUTC:     JMP   CONOUT   
F2D5                             ; "?" ( n -- c ) or ( -n -- addr )
F2D5                             ;   n > 0: wait about n ms for a key; 0 if none came
F2D5                             ;   n = 0: wait for a key
F2D5                             ;   n < 0: read a line of at most -n characters (capped at CAP) with echo
F2D5   AE C4        H_KEY:    LDX   ,U   
F2D7   2B 16                  BMI   line   
F2D9   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F2DB   8D EA        KT2:      BSR   getk   
F2DD   26 0B                  BNE   kt3   
F2DF   5A                     DECB      
F2E0   26 F9                  BNE   kt2   
F2E2   30 1F                  LEAX   -1,X   
F2E4   26 F3                  BNE   kt1   ; A = 0 if the time ran out
F2E6   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F2E8   27 EF                  BEQ   kt1   ;   run it again, until a key comes
F2EA   6F C4        KT3:      CLR   ,U   
F2EC   A7 41                  STA   1,U   
F2EE   39                     RTS      
F2EF   4F           LINE:     CLRA      
F2F0   5F                     CLRB      
F2F1   A3 C4                  SUBD   ,U   ; D = the count
F2F3   10 83 00 7F            CMPD   #CAP   
F2F7   23 02                  BLS   ln1   
F2F9   C6 7F                  LDB   #CAP   
F2FB   D7 35        LN1:      STB   <MAXV   
F2FD   8E 82 80               LDX   #LINEBUF   
F300   5F                     CLRB      ; B = length
F301                             ; Backspace and DEL erase, CR ends (stored, not echoed), other
F301                             ; control keys are ignored, and a full line takes only those.
F301   8D C4        LN2:      BSR   getk   
F303   27 FC                  BEQ   ln2   
F305   81 0D                  CMPA   #13   
F307   27 2B                  BEQ   ln5   
F309   81 08                  CMPA   #8   
F30B   27 13                  BEQ   ln4   
F30D   81 7F                  CMPA   #7Fh   
F30F   27 0F                  BEQ   ln4   
F311   81 20                  CMPA   #" "   
F313   25 EC                  BLO   ln2   
F315   D1 35                  CMPB   <MAXV   
F317   24 E8                  BHS   ln2   ; full
F319   A7 80                  STA   ,X+   
F31B   5C                     INCB      
F31C   8D B4                  BSR   putc   
F31E   20 E1                  BRA   ln2   
F320   5D           LN4:      TSTB      
F321   27 DE                  BEQ   ln2   
F323   5A                     DECB      
F324   30 1F                  LEAX   -1,X   
F326   86 08                  LDA   #8   
F328   8D A8                  BSR   putc   
F32A   86 20                  LDA   #" "   
F32C   8D A4                  BSR   putc   
F32E   86 08                  LDA   #8   
F330   8D A0                  BSR   putc   
F332   20 CD                  BRA   ln2   
F334   A7 84        LN5:      STA   ,X   ; A = 13
F336   CC 82 80               LDD   #LINEBUF   
F339   ED C4                  STD   ,U   
F33B   39                     RTS      
F33C                             ; =============================================================================
F33C                             ;  Machine code: the grave
F33C                             ; =============================================================================
F33C                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
F33C                             ; are stored from addr until a non-hex character; then a RTS (39h) is
F33C                             ; written and its address is left. An odd last digit is consumed and dropped.
F33C                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
F33C                             ; code is entered by JSR (the dispatcher's own), with the address already
F33C                             ; popped: U points at the top data cell (big-endian, 2 bytes, stack grows
F33C                             ; down) and the return address is on top of S. The code may pop and push
F33C                             ; data cells by changing U; on return the cell at ,U is the new TOS. It must
F33C                             ; keep Y (the interpreter's reading position), DP and S (balanced), and
F33C                             ; return with RTS. A, B, X, CC may change.
F33C   8D 21        H_GRAVE:   BSR   hexc   ; the digit after the grave, if any
F33E   24 1B                  BCC   exec   
F340   AE C4                  LDX   ,U   
F342   48           HX1:      ASLA      
F343   48                     ASLA      
F344   48                     ASLA      
F345   48                     ASLA      
F346                          IF   CHECKED   
                              JSR   chkst   
F346                          ENDIF      
F346   A7 84                  STA   ,X   ; the high nibble; an odd digit is overwritten
F348   8D 15                  BSR   hexc   
F34A   24 08                  BCC   hx2   ; odd digit: already consumed, dropped
F34C   AA 84                  ORA   ,X   
F34E   A7 80                  STA   ,X+   
F350   8D 0D                  BSR   hexc   
F352   25 EE                  BCS   hx1   
F354                HX2:         
F354                          IF   CHECKED   
                              JSR   chkst   
F354                          ENDIF      
F354   86 39                  LDA   #39h   ; RTS
F356   A7 84                  STA   ,X   
F358   AF C4                  STX   ,U   
F35A   39                     RTS      
F35B   AE C1        EXEC:     LDX   ,U++   
F35D   6E 84                  JMP   ,X   ; the code's RTS returns to the dispatcher
F35F                             ; hexc: read the character at IP. If it is a hex digit (0-9, A-F, a-f), return
F35F                             ; its value 0-15 in A with carry set and step over it; otherwise return with
F35F                             ; carry clear and the IP unchanged.
F35F   A6 A4        HEXC:     LDA   ,Y   
F361   80 30                  SUBA   #"0"   
F363   81 0A                  CMPA   #10   
F365   25 0C                  BLO   hv1   ; C = 1
F367   84 DF                  ANDA   #0DFh   
F369   80 11                  SUBA   #11h   
F36B   81 06                  CMPA   #6   
F36D   24 06                  BHS   hv9   ; C = 0
F36F   8B 0A                  ADDA   #10   
F371   81 10                  CMPA   #16   ; C = 1
F373   31 21        HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
F375   39           HV9:      RTS      
F376                             ; =============================================================================
F376                             ;  Checked build: break key and error reports
F376                             ; =============================================================================
F376                          IF   CHECKED   
                    E_STACK:   BSR   error   
                              FCB   "stac","k"+80h   
                    E_RSTACK:   BSR   error   
                              FCB   "retur","n"+80h   
                    E_BREAK:   BSR   error   
                              FCB   "brea","k"+80h   
                    E_HEAP:   BSR   error   
                              FCB   "hea","p"+80h   
                    E_STORE:   BSR   error   
                              FCB   "stor","e"+80h   
                    E_BRACK:   BSR   error   
                              FCB   "["+80h   
                                 ; error: print CR LF, the word after the BSR (last character has bit 7
                                 ; set), " at " and the offset of the reading position in the program.
                    ERROR:    PULS   X   ; X -> the word
                              LDS   #RSTOP   ; the stacks may be wrecked: start clean
                              LDU   #DSTOP   
                              PSHS   X   
                              LDX   #crlf   
                              BSR   puts7   
                              PULS   X   
                              BSR   puts7   
                              LDX   #aat   
                              BSR   puts7   
                              TFR   Y,D   
                              SUBD   #PROG+1   ; the character just read
                              PSHU   D   
                              JSR   pdec   
                              JMP   EXIT   
                                 ; puts7: print the characters at X up to one with bit 7 set (inclusive)
                    PUTS7:    LDA   ,X+   
                              PSHS   A   
                              ANDA   #7Fh   
                              JSR   CONOUT   
                              TST   ,S+   
                              BPL   puts7   
                              RTS      
                    CRLF:     FCB   13,10+80h   
                    AAT:      FCB   " at"," "+80h   
F376                          ENDIF      
F376                IMGEND:      


