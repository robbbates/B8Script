   375 000000F4 FFE5                <1> .rp1:   jmp     ebp
   376                              <1> 
   377                              <1> ; negnum, for '-'
   378 000000F6 53                  <1> negnum: push    ebx
   379                              <1>         CALLP   rdnum
   192                              <2>  %if P_%1
   193                              <2>  call [V(p_%1)]
