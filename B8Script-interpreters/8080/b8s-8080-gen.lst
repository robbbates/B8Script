                    HP1:      CALL   prstr   
                              RST   3   
01CC                          ENDIF      
01CC   7D           H_EMIT:   MOV   A,L   ; "'"
01CD   EF                     RST   5   
01CE   DF           H_DROP:   RST   3   ; ";" is this one byte
01CF                             ; "#" prints TOS as a signed decimal number, with no space after it.
01CF   C5           H_NUM:    PUSH   B   
01D0   CD A0 02               CALL   psgn   
01D3   C1                     POP   B   
01D4   DF                     RST   3   
01D5                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              RST   6   
01D5                          ENDIF      
01D5                             ; "?" ( n -- c ) or ( -n -- addr )
01D5                             ;   n > 0: wait about n ms for a key; 0 if none came
01D5                             ;   n = 0: wait for a key
01D5                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01D5                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01D5   7C           H_KEY:    MOV   A,H   
01D6   B7                     ORA   A   
01D7   FA F7 01               JM   line   
01DA   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
01DC   CD 6F 03     KT2:      CALL   getk   
01DF   C2 F3 01               JNZ   kt3   
01E2   1D                     DCR   E   
01E3   C2 DC 01               JNZ   kt2   
01E6   7C                     MOV   A,H   ; 0? never counts down: it waits
01E7   B5                     ORA   L   
01E8   CA DA 01               JZ   kt1   
01EB   2B                     DCX   H   
01EC   7C                     MOV   A,H   
01ED   B5                     ORA   L   
01EE   C2 DA 01               JNZ   kt1   ; A = 0 if the time ran out
01F1                          IF   1-CHECKED   
01F1   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
01F2   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01F3                          ENDIF      
01F3   6F           KT3:      MOV   L,A   
01F4   26 00                  MVI   H,0   
01F6   F7                     RST   6   
01F7                             ; Backspace takes the last character back (and is echoed as
01F7                             ; it is), CR ends (stored, not echoed), every other key is stored and
01F7                             ; echoed until the line is full. The line buffer starts at offset 80h
01F7                             ; of its page, so L alone is the place in the line: D holds the L of
01F7                             ; a full line.
01F7   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
01FA   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
01FB   9F                     SBB   A   
01FC   A5                     ANA   L   ; (0 for a count that is too big)
01FD   2F                     CMA      
01FE   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
01FF                             ;   at most
01FF   21 80 82               LXI   H,LINEBUF   
0202   CD 6F 03     LN2:      CALL   getk   
0205   CA 02 02               JZ   ln2   
0208   FE 0D                  CPI   13   
020A   CA 27 02               JZ   ln5   
020D   FE 08                  CPI   8   
020F   CA 1F 02               JZ   ln4   
0212   5F                     MOV   E,A   
0213   7D                     MOV   A,L   
0214   BA                     CMP   D   
0215   CA 02 02               JZ   ln2   ; full
0218   73                     MOV   M,E   
0219   2C                     INR   L   
021A   7B                     MOV   A,E   
021B   EF           LN3:      RST   5   
021C   C3 02 02               JMP   ln2   
021F   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0220   FA 1B 02               JM   ln3   ;   unless the line was empty (L left the
0223   2C                     INR   L   ;   upper half of the page)
0224   C3 02 02               JMP   ln2   
0227   77           LN5:      MOV   M,A   ; the CR
0228   2E 80                  MVI   L,LINEBUF & 0FFh   
022A   F7                     RST   6   
022B                             ; =============================================================================
022B                             ;  Dispatch table: the low byte of each handler's address, in code order.
022B                             ;  It must not cross a page (the dispatcher only adds to its low byte).
022B                             ; =============================================================================
022B                             ; The handlers of the first NPG1 characters start in the image's second page.
022B                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
022B                             ; differs between the builds, so the count is worked out here.
022B                             ; (One division to a line: asm80 only rounds down when it stores a value.)
022B                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
022B                PGBRK:    EQU   (h_break-BASE)/256   
022B                PGDEF:    EQU   (h_def-BASE)/256   
022B                PGFET:    EQU   (h_fetch-BASE)/256   
022B                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
022B   9F           PTAB:     DB   h_store & 0FFh   ; !
022C   A7                     DB   h_str & 0FFh   ; "
022D   CF                     DB   h_num & 0FFh   ; #
022E   AE                     DB   h_print & 0FFh   ; $
022F   9D                     DB   h_swap & 0FFh   ; %
0230   37                     DB   h_and & 0FFh   ; &
0231   CC                     DB   h_emit & 0FFh   ; '
0232   13                     DB   h_open & 0FFh   ; (
0233   1F                     DB   h_close & 0FFh   ; )
0234   5C                     DB   h_mul & 0FFh   ; *
0235   34                     DB   h_add & 0FFh   ; +
0236   F2                     DB   h_cfetch & 0FFh   ; ,
0237   2B                     DB   h_sub & 0FFh   ; -
0238   A4                     DB   h_cstore & 0FFh   ; .
0239   78                     DB   h_div & 0FFh   ; /
023A   9B                     DB   h_dup & 0FFh   ; :
023B   CE                     DB   h_drop & 0FFh   ; ;
023C   40                     DB   h_lt & 0FFh   ; <
023D   4F                     DB   h_eq & 0FFh   ; =
023E   3F                     DB   h_gt & 0FFh   ; >
023F   D5                     DB   h_key & 0FFh   ; ?
0240   0E                     DB   h_fetch & 0FFh   ; @
0241   EE                     DB   h_def & 0FFh   ; [
0242   DF                     DB   h_break & 0FFh   ; \
0243   DA                     DB   h_ret & 0FFh   ; ]
0244   7C                     DB   h_xor & 0FFh   ; ^
0245   8F                     DB   h_alloc & 0FFh   ; _
0246   BD                     DB   h_grave & 0FFh   ; `
0247   14                     DB   h_tor & 0FFh   ; {
0248   84                     DB   h_or & 0FFh   ; |
0249   1D                     DB   h_fromr & 0FFh   ; }
024A   8C                     DB   h_not & 0FFh   ; ~
024B                PTABEND:      
024B                             ; =============================================================================
024B                             ;  Routines (no handler starts past this point)
024B                             ; =============================================================================
024B                             ; Digits: step back onto the first digit and read the whole number.
024B   E5           DIGIT:    PUSH   H   
024C   0B                     DCX   B   
024D   CD 57 02               CALL   rdnum   
0250   F7                     RST   6   
0251                             ; negnum: "-" directly before a digit: read the number, negate it.
0251   E5           NEGNUM:   PUSH   H   
0252   CD 57 02               CALL   rdnum   
0255   E7                     RST   4   
0256   F7                     RST   6   
0257                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0257                             ; non-digit. Values wrap at 16 bits, as the spec says.
0257   21 00 00     RDNUM:    LXI   H,0   
025A   0A           RDN1:     LDAX   B   
025B   D6 30                  SUI   "0"   
025D   FE 0A                  CPI   10   
025F   D0                     RNC      
0260   03                     INX   B   
0261   54                     MOV   D,H   
0262   5D                     MOV   E,L   
0263   29                     DAD   H   
0264   29                     DAD   H   
0265   19                     DAD   D   
0266   29                     DAD   H   ; HL * 10
0267   5F                     MOV   E,A   
0268   16 00                  MVI   D,0   
026A   19                     DAD   D   
026B   C3 5A 02               JMP   rdn1   
026E                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
026E                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
026E                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
026E                             ; lives on the stack, since A is busy with the shifts.
026E                             ; Dividing by 2 is one shift (the spec wants that fast).
026E   01 00 00     UDIV:     LXI   B,0   
0271   7B                     MOV   A,E   
0272   EE 02                  XRI   2   
0274   B2                     ORA   D   
0275   C2 82 02               JNZ   udv0   
0278   B4                     ORA   H   ; A was 0, and the carry is clear
0279   1F                     RAR      
027A   67                     MOV   H,A   
027B   7D                     MOV   A,L   
027C   1F                     RAR      
027D   6F                     MOV   L,A   ; the quotient
027E   78                     MOV   A,B   
027F   17                     RAL      
0280   4F                     MOV   C,A   ; the remainder: the bit that fell out
0281   C9                     RET      
0282   3E 10        UDV0:     MVI   A,16   
0284   F5                     PUSH   PSW   
0285   29           UDV1:     DAD   H   ; next dividend bit into the carry
0286   79                     MOV   A,C   
0287   17                     RAL      
0288   4F                     MOV   C,A   
0289   78                     MOV   A,B   
028A   17                     RAL      
028B   47                     MOV   B,A   ; BC = BC*2 + bit
028C   79                     MOV   A,C   
028D   93                     SUB   E   
028E   78                     MOV   A,B   
028F   9A                     SBB   D   ; carry if BC < DE
0290   DA 98 02               JC   udv2   
0293   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0294   79                     MOV   A,C   
0295   93                     SUB   E   
0296   4F                     MOV   C,A   
0297   2C                     INR   L   ; quotient bit
0298   F1           UDV2:     POP   PSW   
0299   3D                     DCR   A   
029A   F5                     PUSH   PSW   
029B   C2 85 02               JNZ   udv1   
029E   F1                     POP   PSW   
029F   C9                     RET      
02A0                             ; psgn: print HL as a signed number. Uses BC.
02A0   7C           PSGN:     MOV   A,H   
02A1   B7                     ORA   A   
02A2   F2 A9 02               JP   pdec   
02A5   3E 2D                  MVI   A,"-"   
02A7   EF                     RST   5   
02A8   E7                     RST   4   
02A9                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02A9                             ; Uses BC.
02A9   11 0A 00     PDEC:     LXI   D,10   
02AC   CD 6E 02               CALL   udiv   ; HL = HL / 10, C = the last digit
02AF   79                     MOV   A,C   
02B0   F5                     PUSH   PSW   
02B1   7C                     MOV   A,H   
02B2   B5                     ORA   L   
02B3   C4 A9 02               CNZ   pdec   
02B6   F1                     POP   PSW   
02B7   C6 30                  ADI   "0"   
02B9   EF                     RST   5   
02BA   C9                     RET      
02BB                             ;-----------------------------------------------------------------------------
02BB                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
02BB                             ; HL points past it. Each goes back into the loop that prints the string
02BB                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
02BB                             ;    /a-/z   print the variable, as "#" does
02BB                             ;    /{      clear the screen, the cursor to the top left
02BB                             ;    /}      clear from the cursor to the end of the line
02BB                             ;    /|  /`  show the cursor, hide it
02BB                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
02BB   FE 7E        PESC:     CPI   7Eh   
02BD   CA E0 02               JZ   pat   
02C0   11 AE 01               LXI   D,PRLOOP   ; the others return into the loop
02C3   D5                     PUSH   D   
02C4   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
02C6   D2 E9 02               JNC   pcon   
02C9   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
02CB   D2 F2 02               JNC   phide   
02CE   87                     ADD   A   ; the variable's cell
02CF   C6 40                  ADI   40h   
02D1   E5                     PUSH   H   
02D2   C5                     PUSH   B   
02D3   6F                     MOV   L,A   
02D4   26 82                  MVI   H,LETPAGE   
02D6   7E                     MOV   A,M   
02D7   2C                     INR   L   
02D8   66                     MOV   H,M   
02D9   6F                     MOV   L,A   
02DA   CD A0 02               CALL   psgn   
02DD   C1                     POP   B   
02DE   E1                     POP   H   
02DF   C9                     RET      
02E0                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
02E0                             ; the checked build "$" is the routine prstr: its own return address goes
02E0                             ; first, and hp1 calls it again afterwards. There a /~ that takes cells
02E0                             ; that aren"t there is s after the "$' (or at its NUL: see e_dollar), as for
02E0                             ; any other character. chkstk stops a /~ only when the stack is already
02E0                             ; past its empty place, so that, however many there are, what they write
02E0                             ; stays in the spare bytes above the stack.
02E0                PAT:         
02E0                          IF   CHECKED   
                              POP   D   
                              CALL   chkstk   
02E0                          ENDIF      
02E0   D1                     POP   D   ; DE = the column
02E1   E3                     XTHL      ; HL = the row; the text pointer is kept
02E2                          IF   1-ANS   
02E2   CD 15 FF               CALL   CONAT   
02E5   E1                     POP   H   
02E6   C3 AE 01               JMP   PRAGAIN   
02E9                             ; With ANSI = 0 the machine's routines do the rest.
02E9   CA 0C FF     PCON:     JZ   CONCLS   ; /{
02EC   FE 02                  CPI   2   
02EE   CA 0F FF               JZ   CONEOL   ; /}
02F1   FE                     DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
02F2   AF           PHIDE:    XRA   A   ; /`  (A = 0: hide)
02F3   C3 12 FF               JMP   CONCUR   
02F6                          ENDIF      
02F6                          IF   ANS   
                              PUSH   B   ; (pdec uses BC)
                              PUSH   D   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INX   H   
                              CALL   pdec   
                              MVI   A,";"   
                              RST   5   
                              POP   H   
                              INX   H   
                              CALL   pdec   
                              MVI   A,"H"   
                              RST   5   
                              POP   B   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
                    PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
                              MVI   A,"?"   
                              CALL   csia   
                              MVI   A,"2"   
                              RST   5   
                              MVI   A,"5"   
                              RST   5   
                              MOV   A,E   
                              RST   5   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DCR   A   
                              JZ   pshow   ; /|
                              MVI   A,"K"   
                              JP   csia   ; /}  ESC [ K
                              MVI   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              MVI   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
                    CSIA:     PUSH   PSW   
                              CALL   csi   
                              POP   PSW   
                              RST   5   
                              RET      
                    CSI:      MVI   A,27   
                              RST   5   
                              MVI   A,"["   
                              RST   5   
                              RET      
02F6                          ENDIF      
02F6                             ; skip: read past text to the closer at this level, and return A = 0 if it
02F6                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02F6                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02F6                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02F6                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02F6                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
02F6                             ; 
02F6                             ; The checked build also looks at the character the skip was started by,
02F6                             ; which is always the one just before where it starts: "(" must end at ")",
02F6                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02F6                             ; quote counts as running into it. "\" takes either closer. The place where
02F6                             ; the skip started is kept on the stack, for the report.
02F6                SKIP:        
02F6                          IF   CHECKED   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
02F6                          ENDIF      
02F6   16 00                  MVI   D,0   
02F8   14           SK3:      INR   D   ; an opener: one deeper
02F9   0A           SK1:      LDAX   B   
02FA                          IF   1-CHECKED   
02FA   03                     INX   B   
02FB   B7                     ORA   A   
02FC   CA 79 00               JZ   endprog   
02FF                          ENDIF      
02FF                          IF   CHECKED   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
02FF                          ENDIF      
02FF   FE 22                  CPI   22h   
0301   CC 1D 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
0304   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
0306   CA F8 02               JZ   sk3   
0309   3D                     DCR   A   ; ")"
030A   CA 17 03               JZ   sk4   
030D   D6 32                  SUI   "["-")"   
030F   CA F8 02               JZ   sk3   
0312   FE 02                  CPI   "]"-"["   
0314   C2 F9 02               JNZ   sk1   
0317   15           SK4:      DCR   D   
0318                          IF   1-CHECKED   
0318   C8                     RZ      ; the closer at this level
0319   C3 F9 02               JMP   sk1   
031C                          ENDIF      
031C                          IF   CHECKED   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
031C                          ENDIF      
031C                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
031C                             ; the next character, so "/"" does not end it. Leaves A = 22h.
031C                          IF   1-CHECKED   
031C   03           SS0:      INX   B   
031D   0A           SKIPSTR:   LDAX   B   
031E   03                     INX   B   
031F   FE 2F                  CPI   "/"   
0321   CA 1C 03               JZ   ss0   
0324   FE 22                  CPI   22h   
0326   C2 1D 03               JNZ   skipstr   
0329   C9                     RET      
032A                          ENDIF      
032A                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
032A                          ENDIF      
032A                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
032A                             ; and return its value in A with the carry set; otherwise leave the IP and
032A                             ; return with the carry clear.
032A   0A           HEXC:     LDAX   B   
032B   D6 30                  SUI   "0"   
032D   FE 0A                  CPI   10   
032F   DA 3B 03               JC   hc1   
0332   E6 DF                  ANI   0DFh   
0334   D6 11                  SUI   11h   
0336   FE 06                  CPI   6   
0338   D0                     RNC      
0339   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
033B   03           HC1:      INX   B   
033C   C9                     RET      
033D                             ; =============================================================================
033D                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
033D                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
033D                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
033D                             ;  the host's KEY and CONOUT routines themselves.
033D                             ; 
033D                             ;  A running program reads the keyboard only through getk and pollk, which
033D                             ;  between them give the break key its rules:
033D                             ;    - Ctrl-C stops the program;
033D                             ;    - any other key that the break check reads is held in KEYBUF for the
033D                             ;      next "?", and a newer one takes its place;
033D                             ;    - "?" (getk) takes the held key first;
033D                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
033D                             ;      key like any other, but two of them within about 250 ms still stop it.
033D                             ;  Both are called straight from a handler, never from a routine under one:
033D                             ;  the checked build's report counts on finding one return address above the
033D                             ;  data stack, and TOS in HL.
033D                             ; =============================================================================
033D                          IFN   CPM   
033D                RAWK:     EQU   KEY   
033D                          ENDIF      
033D                             ; pollk: the break check (see rpushd).
033D   CD 06 FF     POLLK:    CALL   rawk   
0340   C8                     RZ      ; no key
0341   32 7A 82               STA   KEYBUF   ; held for the next "?"
0344   FE 03        PK1:      CPI   3   ; (getk joins here)
0346   C0                     RNZ      
0347                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0347                             ; the program has turned it off, wait about 250 ms for one more key: a
0347                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0347                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0347   3A 7B 82     CTLC:     LDA   BRKOFF   
034A   B7                     ORA   A   
034B   CA 79 00               JZ   brk   
034E   D5                     PUSH   D   
034F   11 10 27               LXI   D,250*MSLOOP   
0352   CD 06 FF     CT1:      CALL   rawk   
0355   C2 5E 03               JNZ   ct2   
0358   1B                     DCX   D   
0359   7A                     MOV   A,D   
035A   B3                     ORA   E   
035B   C2 52 03               JNZ   ct1   
035E   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
035F   FE 03                  CPI   3   
0361   CA 79 00               JZ   brk   
0364   B7                     ORA   A   
0365   CA 6B 03               JZ   ct3   
0368   32 7A 82               STA   KEYBUF   
036B   3E 03        CT3:      MVI   A,3   
036D   B7                     ORA   A   
036E   C9                     RET      
036F                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
036F   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
0370   21 7A 82               LXI   H,KEYBUF   ;   the buffer
0373   7E                     MOV   A,M   
0374   36 00                  MVI   M,0   
0376   E1                     POP   H   
0377   B7                     ORA   A   
0378   C0                     RNZ      
0379   CD 06 FF               CALL   rawk   
037C   C8                     RZ      
037D   C3 44 03               JMP   pk1   ; Ctrl-C? If not, that is the key
0380                          IF   1-CHECKED   
0380                BRK:      EQU   endprog   ; the unchecked build stops without a word;
0380                          ENDIF      
0380                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
0380                          ENDIF      
0380                          IF   CPM   
                    RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
0380                          ENDIF      
0380                             ; =============================================================================
0380                             ;  Checked build: the checks and the error report
0380                             ; =============================================================================
0380                          IF   CHECKED   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
0380                          ENDIF      
0380                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
0380                          ENDIF      
0380                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
0380                          ENDIF      
0380                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address (errp drops
                              MVI   A,"H"   ;   the old top)
                              JMP   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
0380                          ENDIF      
0380                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
0380                          ENDIF      
0380                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
0380                          ENDIF      
0380                          IF   CHECKED   
                                 ; Two error entries for errors found inside a routine: the first hides the
                                 ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
                                 ; return address.
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   prs0   
                              CPI   7Fh   
                              JC   pesc   
                    PRS0:     ANI   0BFh   
                    PRS1:     RST   5   
                              JMP   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              RST   5   
                              MVI   A,10   
                              RST   5   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              RST   1   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr's return address goes first. But if a /~ took cells
                                 ; that weren't there, it is s, found now: chkstk, called one cell up, sees
                                 ; the stack past its empty place then.
                    E_DOLLAR:   POP   D   
                              POP   H   
                              CALL   chkstk   
                              PUSH   H   
                              LHLD   PSAVE   
                              DB   11h   ; (LXI D hides e_quote's first two bytes)
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              RST   5   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              RST   5   
                              POP   D   
                              POP   H   
                              PUSH   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   H   ; the text, as it is: 16 characters, or fewer
                              MVI   B,16   ;   if the line or the program ends first
                    ER4:      MOV   A,M   
                              INX   H   
                              ORA   A   
                              JZ   er5   
                              CPI   13   
                              JZ   er5   
                              CPI   10   
                              JZ   er5   
0380                          ENDIF      
0380                          IF   CHECKED*CPM   
                              CPI   1Ah   ; (the ^Z that pads a file's last record ends
                              JZ   er5   ;   the text too: some terminals clear the
0380                          ENDIF      ;   screen on it)
0380                          IF   CHECKED   
                              RST   5   
                              DCR   B   
                              JNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
                              DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
                              RST   4   ;   first value and holds nothing)
                              MOV   A,H   
                              CALL   phal2   ; the depth
                              MVI   A,":"   
                              RST   5   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              RST   5   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                    PHAL2:    ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
0380                          ENDIF      
0380                             ; =============================================================================
0380                             ;  Startup
0380                             ; =============================================================================
0380                START:       
0380                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
0380                          ENDIF      
0380                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
0380                          ENDIF      
0380                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   H,vecs   ; the RST routines go down into page zero
                              LXI   D,0008h   
                              MVI   B,vecend-vecs   
                    CPY:      MOV   A,M   
                              STAX   D   
                              INX   H   
                              INX   D   
                              DCR   B   
                              JNZ   cpy   
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
0380                          ENDIF      
0380                          IFN   CPM   
0380   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
0383   7E           FNUL:     MOV   A,M   
0384   23                     INX   H   
0385   B7                     ORA   A   
0386   C2 83 03               JNZ   fnul   
0389                          ENDIF      
0389   22 7C 82               SHLD   HEAP   
038C                          IF   CHECKED   
                              RST   4   ; minus the heap"s first address: "_' may not
                              SHLD   NPEND   ;   release below it
038C                          ENDIF      
038C   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
038F   22 34 82               SHLD   RSP   
0392                          IF   (1-CHECKED)*(1-CPM)   
0392   67                     MOV   H,A   ; (A = 0, from the search for the NUL) no key
0393   6F                     MOV   L,A   ;   is held, and the break key is on (the
0394                          ENDIF      ;   checked build has cleared these)
0394                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0394                          ENDIF      
0394                          IF   1-CHECKED   
0394   22 7A 82               SHLD   KEYBUF   
0397                          ENDIF      
0397   01 00 83               LXI   B,PROG   ; the IP
039A   F7                     RST   6   ; (its return address is thrown away)
039B                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
039B                          ENDIF      
039B                IMGEND:      


