0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Motorola 6809
0000                             ;  Required Notice: Copyright 2026 Robb Bates (https://github.com/robbbates)
0000                             ;  Licence: PolyForm Noncommercial License 1.0.0 (LICENSE.md at the top of
0000                             ;  the repository, or https://polyformproject.org/licenses/noncommercial/1.0.0)
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ;  Follows the design of the Z80 interpreter (z80/b8s-z80.asm).
0000                             ; 
0000                             ;  The switches, in the EQU lines below (CPM is always 0: the 6809 has no
0000                             ;  CP/M; the line is kept only so that build.sh works):
0000                             ;    CHECKED  0 = no checks (spec: an unchecked build checks nothing)
0000                             ;             1 = a checked build: variables start at 0, words start
0000                             ;                 undefined, and every error in the spec's table stops the
0000                             ;                 program with the three-line report, then goes to EXIT:
0000                             ;                   Err X @ line,col
0000                             ;                   D:n: ... v v v      (n = depth, then the top 8 values)
0000                             ;                   R:n
0000                             ;                 S/s data stack over/underflow, R/r return stack over/
0000                             ;                 underflow, H heap, O store outside the program's space,
0000                             ;                 W bad character after [, U undefined word, Q no closing
0000                             ;                 quote, X reserved byte, Z divide by zero, N unbalanced or
0000                             ;                 mismatched brackets, B Ctrl-C.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost few bytes: a
0000                             ;                 skip cache, a faster skip, "*" quicker when a high byte is
0000                             ;                 0, "/" by any power of two as a shift, and (unchecked) a
0000                             ;                 variable and its "@" or "!" in one step. See "Speed-ups".
0000                             ;                 The heap limit is a page lower (EF00h): the skip cache has
0000                             ;                 the page above it.
0000                             ;             2 = fast: base, and a dispatch table besides, with
0000                             ;                 no size limit. See "The fast build". The image starts at
0000                             ;                 E000h, the heap limit is DF00h and the skip cache is at
0000                             ;                 DF00h-DFFFh.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (the unchecked build goes
0000                             ;  to EXIT without a word): see the console layer below for the rules, the
0000                             ;  held key and the break-off cell at 827Bh.
0000                             ; 
0000                             ;  Assembler: asm80, M6809 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0 (no CP/M on the 6809)
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   2   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  base build takes; the fast build has its own)
0000                             ; (asm80 can't nest IF, and IF takes any value
0000                             ;  but 0 as true, so IF CHECKED+QK means "either")
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    Y    IP: the address of the next program character to read
0000                             ;    U    the data stack pointer. The stack grows down and U points at the
0000                             ;         top cell (TOS); nothing is cached in a register, because every
0000                             ;         dispatch needs A, B and X as scratch. Cells are big-endian here.
0000                             ;         (Only the stacks are big-endian: cells in RAM that the program can
0000                             ;         see - variables, the heap pointer, anything @ and ! reach - are
0000                             ;         little-endian, as the spec says, so @ and ! swap the bytes.)
0000                             ;    S    the return stack. A word call is a plain push of Y. Entries are
0000                             ;         2 bytes, big-endian. Handlers are called with JSR, so the return
0000                             ;         address of the dispatcher is on top of S while a handler runs.
0000                             ;    DP   the letter page, so the letter-page variables below cost 2-byte
0000                             ;         direct addressing. Nothing else may change DP.
0000                             ;    A B X are scratch. Every handler is entered by JSR and ends in RTS (one
0000                             ;    byte). A handler that pushes or pops the return stack first pulls the
0000                             ;    dispatcher's return address into X (PULS X) and ends with JMP ,X.
0000                             ; 
0000                             ;  Dispatch (unchecked build). PTAB holds one byte per punctuation character:
0000                             ;  the low byte of the handler's distance from PTAB. The handlers of the last
0000                             ;  characters (in code order) start within 256 bytes after PTAB, the handlers
0000                             ;  of the first NPG1 characters in the 256 bytes after that. The assembler
0000                             ;  works NPG1 out from where five handlers landed, and testing/chktab09.py
0000                             ;  checks the layout. The checked build is bigger than that reach, so its
0000                             ;  table holds whole addresses instead. (The fast build has neither: its
0000                             ;  table, FTAB, has an address for every byte. See "The fast build".)
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM areas:
0000                             ; 
0000                             ;    8000h-80FFh  return stack (S); empty = 8100h. Unchecked: 127 entries.
0000                             ;                 Checked: 96 entries (S down to 8040h); the 64 bytes below
0000                             ;                 are a guard band for what a handler, the console routines
0000                             ;                 and interrupts push on top of a full stack before the check
0000                             ;                 runs (the escapes of "$" take up to 22 of them, so 42 are
0000                             ;                 left for CONOUT and interrupts).
0000                             ;    8100h-81FFh  data stack (U). Unchecked: 127 cells, empty = 8200h.
0000                             ;                 Checked: 125 cells (U from 81FCh, empty, down to 8102h):
0000                             ;                 the 4 bytes above are a guard band, so a handler that runs
0000                             ;                 on an empty stack writes there and not on the letter
0000                             ;                 cells. A push past the last cell lands on 8100h, still in
0000                             ;                 this page, and the program stops with S. (It must not
0000                             ;                 reach 80FEh: with the return stack empty, the handler's
0000                             ;                 own return address is there. pdec's cell for its divisor,
0000                             ;                 under "#" or a /a in "$" on a full stack, lands on 8100h
0000                             ;                 too.)
0000                             ;    8200h-82FFh  letter page (LET): A..Z at +00h..+33h, a..z at +40h..+73h
0000                             ;                 (a word cell is always 64 bytes below its variable), the
0000                             ;                 heap pointer at +7Ch (= z10+), interpreter variables in the
0000                             ;                 gaps, and the -n? line buffer at +80h..+FFh. The break-off
0000                             ;                 cell is at +7Bh (827Bh); +7Ah is free.
0000                             ;    8300h-       PROG, the program text, NUL-terminated; the heap starts
0000                             ;                 after the NUL and grows to HEAPLIM*256 (F000h; EF00h
0000                             ;                 with base, DF00h in the fast build)
0000                             ;    EF00h-EFFFh  base: the skip cache (CPAGE), the page at the heap limit,
0000                             ;                 which the heap never reaches. (Fast build: DF00h-DFFFh.)
0000                             ;    F000h-       this image (ROM). The reset vector (FFFEh) must point to
0000                             ;                 `start` (see the listing); the image does not contain it.
0000                             ;                 (The fast build's image starts at E000h.)
0000                             ;    FF03h-FF17h  the console routines (CONOUT, KEY, and with ANSI = 0
0000                             ;                 CONCLS, CONEOL, CONCUR, CONAT) and EXIT are supplied by
0000                             ;                 the system and need no space here.
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LET..HEAPLIM*256.
0000                             ; -----------------------------------------------------------------------------
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (end the
0000                             ;   routine with TSTA / RTS, or a plain LDA).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   Both are called with JSR. They may change A and CC and must preserve
0000                             ;   B, X, Y, U and DP.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these as subroutines (each
0000                             ; ends with RTS). All four may change A, B, X and CC, and must keep Y, U
0000                             ; and DP.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row X, column D, both counted
0000                             ;     from 0
0000                          ENDIF      
0000                RSPAGE:   EQU   80h   
0000                DSPAGE:   EQU   81h   
0000                LETPAGE:   EQU   82h   
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                             ; (the checked startup counts on it being
0000                             ; the page after LETPAGE)
0000                ROM:      EQU   0F000h-FAST*1000h   ; where the image starts (the fast build: E000h)
0000                HEAPLIM:   EQU   ROM/256-QK   ; the heap must stay below F000h (a page);
0000                             ;   with base EF00h, the fast build DF00h
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (base and the fast
0000                             ;   build): the page at the heap limit
0000                MSLOOP:   EQU   20   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (direct-page offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   7Ch   ; z10+, the heap pointer (little-endian)
0000                KEYBUF:   EQU   34h   ; gap after Z: a key held back by the break check
0000                COUNT:    EQU   35h   ; the break check's countdown (1 look in 256)
0000                AT:       EQU   36h   ; checked: the address of the character being
0000                             ;   run (big-endian), the place an error reports
0000                PEND:     EQU   38h   ; checked: the program's end, the first byte
0000                             ;   after its NUL (big-endian): the heap's floor
0000                SSAV:     EQU   3Ah   ; checked: S as each character starts (big-
0000                             ;   endian): the return stack an error reports
0000                PSAV:     EQU   3Ch   ; checked: the address "$" prints from (big-
0000                             ;   endian), put back on the stack for a Q
0000                BRKOFF:   EQU   7Bh   ; the break-off cell (827Bh, z9+): 0 = the
0000                             ;   break key is on
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+100h   ; empty return stack
0000                RSLIM:    EQU   RSPAGE*256+40h   ; checked: S may go no lower between characters
0000                RSREP:    EQU   RSTOP-16   ; checked: S while the error report runs
0000                DSTOP:    EQU   DSPAGE*256+100h-4*CHECKED   ; empty data stack (a guard if checked)
0000                DSLIM:    EQU   DSPAGE*256+2   ; checked: U may go no lower between characters
0000                             ; The fast build's dispatcher, inline at the end of each of its own entries
0000                             ; (see "The fast build", at the end). The checked one calls fchk first.
0000                             ; (A count of 0 makes DS write nothing; DS needs fchk's address before the
0000                             ; first use, so fchk comes first in that part.)
0000                          IF   FAST*CHECKED   
0000                ACHK:     EQU   fchk   
0000                          ENDIF      
0000                          IF   1-FAST*CHECKED   
                    ACHK:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      CHECKED,0BDh    ; (checked: JSR fchk)
0000                 DS      CHECKED,ACHK/256
0000                 DS      CHECKED,ACHK&0FFh
0000                 LDB     ,Y+             ; the character,
0000                 LDX     #FTAB
0000                 ABX
0000                 ABX                     ;   its entry in the table,
0000                 JMP     [,X]            ;   and its handler
0000                .endm
0000                 
E000                          .ORG   ROM   
E000                             ; =============================================================================
E000                             ;  Startup
E000                             ; =============================================================================
E000   10 CE 81 00  START:    LDS   #RSTOP   
E004   CE 81 FC               LDU   #DSTOP   
E007                          IF   QK   
E007                             ; Empty the skip cache: a start of 0000h matches no skip.
E007   8E DF 00               LDX   #CPAGE*256   
E00A   5F                     CLRB      
E00B   6F 80        SKZ:      CLR   ,X+   
E00D   5A                     DECB      
E00E   26 FB                  BNE   skz   
E010                          ENDIF      
E010   86 82                  LDA   #LETPAGE   
E012   1F 8B                  TFR   A,DP   
E014                          IF   CHECKED   
E014                             ; Zero the whole letter page: every variable starts at 0, every word
E014                             ; cell at 0 (undefined: a call stops with U), and so do the
E014                             ; interpreter's own cells in the gaps (KEYBUF and the rest). A is
E014                             ; still LETPAGE; 256 rounds leave X at the next page, PROG.
E014   5F                     CLRB      
E015   1F 01                  TFR   D,X   
E017   6F 80        SZ:       CLR   ,X+   
E019   5A                     DECB      
E01A   26 FB                  BNE   sz   
E01C                          ENDIF      
E01C                          IF   1-CHECKED   
                              CLR   <KEYBUF   ; no key held
                              CLR   <BRKOFF   ; the break key is on
                              LDX   #PROG   
E01C                          ENDIF      
E01C   1F 12                  TFR   X,Y   ; the reading position; the heap starts
E01E   A6 80        SC:       LDA   ,X+   ;   after the program's NUL
E020   26 FC                  BNE   sc   
E022   1F 10                  TFR   X,D   
E024   D7 7C                  STB   <HEAP   ; (little-endian)
E026   97 7D                  STA   <HEAP+1   
E028                          IF   CHECKED   
E028   9F 38                  STX   <PEND   ; the heap may never go below this
E02A                          ENDIF      
E02A                             ; =============================================================================
E02A                             ;  The inner loop: read one character and sort it by range.
E02A                             ; 
E02A                             ;    00h          end of program
E02A                             ;    01h-20h, 7Fh       ignored (control, space, DEL)
E02A                             ;    80h-FFh      reserved: ignored, or X in the checked build
E02A                             ;    30h-39h      digit: read a whole number
E02A                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E02A                             ;    61h-7Ah      a-z: push the address of that letter's cell
E02A                             ;    the rest     punctuation: JSR through PTAB, 32 entries, in code order
E02A                             ; =============================================================================
E02A                          IF   FAST   
E02A   7E E4 C3               JMP   fnext   ; (the fast build has its own: see the end)
E02D                          ENDIF      
E02D                          IF   1-FAST   
                    NEXT:        
E02D                          ENDIF      
E02D                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, not in every handler:
                                 ; the pointer minus its limit, taken as unsigned, must be no more
                                 ; than the stack's size. Below the limit (an overflow) it wraps to
                                 ; FFxxh, and the compare leaves N set; above the empty point (an
                                 ; underflow) it is just over the size, and N is clear.
                              LEAX   (0-DSLIM)&0FFFFh,U   
                              CMPX   #DSTOP-DSLIM   
                              BHI   e_ds   
                              LEAX   (0-RSLIM)&0FFFFh,S   
                              CMPX   #RSTOP-RSLIM   
                              BHI   e_rs   
                              STY   <AT   ; the place, should this character fail
                              STS   <SSAV   ; and the return stack, as it is now
E02D                          ENDIF      
E02D                          IF   1-FAST   
                              LDA   ,Y+   
                              BEQ   fin   ; NUL ends the program
                              SUBA   #21h   ; A = c - 21h
                              BLO   next   ; 01h-20h ignored
                              CMPA   #0Fh   
                              BLO   punct   ; 21h-2Fh: PTAB index 0-14
                              CMPA   #19h   
                              BLO   digit   ; 30h-39h
                              CMPA   #20h   
                              BLO   p3a   ; 3Ah-40h: A = 19h-1Fh
                              SUBA   #20h   ; A = c - 41h
                              CMPA   #1Ah   
                              BLO   upper   ; 41h-5Ah: A = letter index 0-25
                              CMPA   #20h   
                              BLO   p5b   ; 5Bh-60h
                              CMPA   #3Ah   
                              BLO   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
                              CMPA   #3Eh   
E02D                          ENDIF      
E02D                          IF   (1-CHECKED)*(1-FAST)   
                              BHS   next   ; 7Fh-FFh: ignored
E02D                          ENDIF      
E02D                          IF   CHECKED*(1-FAST)   
                              BEQ   next   ; 7Fh (DEL): ignored
                              BHI   e_resv   ; 80h-FFh: reserved
E02D                          ENDIF      
E02D                          IF   1-FAST   
                              SUBA   #1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
                    P5B:      ADDA   #6   ; 5Bh-60h: -4 in all, index 22-27
                    P3A:      SUBA   #0Ah   ; 3Ah-40h: index 15-21
                                 ; Punctuation: A = the PTAB index.
                    PUNCT:    LDX   #PTAB   
E02D                          ENDIF      
E02D                          IF   (1-CHECKED)*(1-FAST)   
                                 ; The handler is at PTAB + D, where B is the table byte and A is 1
                                 ; for the first NPG1 characters, 0 for the rest.
                              LDB   A,X   
                              CMPA   #NPG1   ; carry: one of the first NPG1
                              LDA   #0   ; (leaves the carry alone)
                              ROLA      
                              JSR   D,X   ; the handler ends in RTS
E02D                          ENDIF      
E02D                          IF   CHECKED*(1-FAST)   
                              ASLA      ; the table holds whole addresses
                              JSR   [A,X]   
E02D                          ENDIF      
E02D                          IF   1-FAST   
                              BRA   next   
                                 ; Digits: step back onto the first digit and read the whole number.
                    DIGIT:    LEAY   -1,Y   
                              BSR   rdnum   
                              BRA   next   
E02D                          ENDIF      
E02D                             ; a-z: push the cell's address (the cell is the variable)
E02D                             ;  (the unchecked base build does x@ and x! in one step)
E02D                          IF   (1-SBASEU)*(1-FAST)   
                    LOWER:    BSR   cellx   
                              PSHU   X   
                              BRA   next   
E02D                          ENDIF      
E02D                          IF   SBASEU   
                                 ; a-z, unchecked base: a variable followed by "@" or "!" is fetched or
                                 ; stored in the same step (x@ is the commonest pair in most programs). A
                                 ; checked build checks the stacks between the two, so it keeps them apart.
                    LOWER:    ASLA      ; (cellx, inline)
                              LDX   #LET   
                              LEAX   A,X   
                              LDB   ,Y   
                              CMPB   #"@"   
                              BEQ   lwf   
                              CMPB   #"!"   
                              BEQ   lws   
                              PSHU   X   
                              BRA   next   
                    LWF:      LEAY   1,Y   ; x@: the cell's value (little-endian)
                              LDB   ,X   
                              LDA   1,X   
                              PSHU   D   
                              BRA   next   
                    LWS:      LEAY   1,Y   ; x!: the cell = TOS
                              PULU   D   
                              STB   ,X   
                              STA   1,X   
                              BRA   next   
E02D                          ENDIF      
E02D                             ; A-Z: call the word. The IP (the address after the letter) goes on the
E02D                             ; return stack, and the IP becomes the address in the letter's cell.
E02D                             ; Checked: a cell still 0 (high byte 0) was never defined, since every
E02D                             ; address in the program's space is 8200h or more. The call has not been
E02D                             ; made yet, so the report shows the stacks as they were.
E02D                          IF   1-FAST   
                    UPPER:    BSR   cellx   
                              LDB   ,X   
                              LDA   1,X   
E02D                          ENDIF      
E02D                          IF   CHECKED*(1-FAST)   
                              BEQ   e_undef   
E02D                          ENDIF      
E02D                          IF   1-FAST   
                              PSHS   Y   
                              TFR   D,Y   
                              BSR   pollk   ; the break check, at every word call
                              BRA   next   
E02D                          ENDIF      
E02D                             ; =============================================================================
E02D                             ;  Checked build: the error entries.
E02D                             ; 
E02D                             ;  Each entry loads its letter and then hides the next entry inside a 3-byte
E02D                             ;  CMPX # (the 8Ch), so that a run of them falls through to one place. The
E02D                             ;  place an error reports is the address in AT, which the inner loop sets to
E02D                             ;  each character before it runs it; the one error that reports another
E02D                             ;  place (W, at the character after the [) changes AT before it comes.
E02D                             ; 
E02D                             ;  The report counts the return stack from SSAV, which the inner loop sets
E02D                             ;  to S before each character, so an error may come from any depth of
E02D                             ;  calls: a handler, chkst under one, or ctlc under "?" or the break check.
E02D                             ;  (An r sets SSAV to the empty stack.) The inner loop's own entries are
E02D                             ;  here, where its short branches reach them; those reached from a handler
E02D                             ;  are after h_cstore, just ahead of the report.
E02D                             ; =============================================================================
E02D                          IF   CHECKED   
E02D                             ; ---- reached from the inner loop -------------------------------------------
E02D                             ; The stack checks branch here with N set for an overflow (the pointer is
E02D                             ; below its limit) and clear for an underflow. After an underflow that stack
E02D                             ; counts as empty.
E02D   2B 11        E_DS:     BMI   e_S   
E02F   CE 81 FC               LDU   #DSTOP   ; s
E032   86 73                  LDA   #"s"   
E034   20 18                  BRA   eall   
E036   2B 0B        E_RS:     BMI   e_R   
E038   8E 81 00               LDX   #RSTOP   ; r
E03B   9F 3A                  STX   <SSAV   
E03D   86 72                  LDA   #"r"   
E03F   8C                     FCB   8Ch   
E040   86 53        E_S:      LDA   #"S"   
E042   8C                     FCB   8Ch   
E043   86 52        E_R:      LDA   #"R"   
E045   8C                     FCB   8Ch   
E046   86 58        E_RESV:   LDA   #"X"   ; a reserved byte (80h-FFh) outside a string
E048   8C                     FCB   8Ch   
E049   86 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (from ctlc, at any depth)
E04B   8C                     FCB   8Ch   
E04C   86 55        E_UNDEF:   LDA   #"U"   ; a word never defined (its cell is still 0)
E04E   7E E2 92     EALL:     JMP   error   
E051                          ENDIF      
E051   7E FF 09     FIN:      JMP   EXIT   ; the program has ended
E054                             ; cellx: A = letter index (0-25, or 32-57 for lowercase) -> X = cell address
E054   48           CELLX:    ASLA      
E055   8E 82 00               LDX   #LET   
E058   30 86                  LEAX   A,X   
E05A   39                     RTS      
E05B                             ; isdig: A = the character at IP minus "0"; the carry is set if it is a digit
E05B   A6 A4        ISDIG:    LDA   ,Y   
E05D   80 30                  SUBA   #"0"   
E05F   81 0A                  CMPA   #10   
E061   39           AB9:      RTS      
E062                             ; rdnum: read decimal digits at IP and push the value; IP is left on the
E062                             ; first non-digit. Values wrap at 16 bits, as the spec says. The running
E062                             ; value lives in the new top cell: V = V*10 + digit.
E062   4F           RDNUM:    CLRA      
E063   5F                     CLRB      
E064   36 06                  PSHU   D   
E066   8D F3        RD1:      BSR   isdig   
E068   24 F7                  BHS   ab9   
E06A   EC C4                  LDD   ,U   
E06C   58                     ASLB      
E06D   49                     ROLA      
E06E   58                     ASLB      
E06F   49                     ROLA      
E070   E3 C4                  ADDD   ,U   ; 5V
E072   58                     ASLB      
E073   49                     ROLA      ; 10V
E074   EB A0                  ADDB   ,Y+   ; and the digit, read again
E076   89 00                  ADCA   #0   
E078   83 00 30               SUBD   #30h   ; minus "0" (asm80 would put a quoted "0"
E07B                             ;   in the high byte of a 16-bit operand)
E07B   ED C4                  STD   ,U   
E07D   20 E7                  BRA   rd1   
E07F                             ; =============================================================================
E07F                             ;  Console layer: the break key. A running program reads the keyboard only
E07F                             ;  through pollk and getk, which between them give the break key its rules:
E07F                             ;    - Ctrl-C (03h) stops the program;
E07F                             ;    - any other key that the break check reads is held in KEYBUF for the
E07F                             ;      next "?", and a newer one takes its place;
E07F                             ;    - "?" (getk) takes the held key first;
E07F                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E07F                             ;      key like any other, but two of them within about 250 ms still stop it.
E07F                             ;  On a break the unchecked build ends without a word (EXIT); the checked
E07F                             ;  one reports B. All three keep B, X, Y and U.
E07F                             ; =============================================================================
E07F                             ; pollk: the break check, at every word call and every true ")" loop-back.
E07F                             ; It looks at the keyboard only once in 256 calls.
E07F   0A 35        POLLK:    DEC   <COUNT   
E081   26 37                  BNE   cc9   
E083   BD FF 06     PK1:      JSR   KEY   ; (the fast build counts down itself)
E086   27 32                  BEQ   cc9   ; no key
E088   97 34                  STA   <KEYBUF   ; held for the next "?"
E08A   20 0C                  BRA   ctlc   
E08C                             ; getk: a key for "?", or A = 0 with the zero flag set if there is none.
E08C   96 34        GETK:     LDA   <KEYBUF   ; a held key goes first, and is taken out of
E08E   0F 34                  CLR   <KEYBUF   ;   the buffer (it has been through ctlc)
E090   4D                     TSTA      
E091   26 27                  BNE   cc9   
E093   BD FF 06               JSR   KEY   
E096   27 22                  BEQ   cc9   
E098                             ; ctlc: a key has been read. If it is Ctrl-C and the break key is on, that
E098                             ; is the end. If the program has turned it off, wait about 250 ms for one
E098                             ; more key: a second Ctrl-C is the end too; any other key is held (the
E098                             ; newest wins), and the Ctrl-C goes on: A = 3, zero flag clear.
E098   81 03        CTLC:     CMPA   #3   
E09A   26 1E                  BNE   cc9   
E09C   0D 7B                  TST   <BRKOFF   
E09E   27 A9                  BEQ   brk   
E0A0   34 10                  PSHS   X   
E0A2   8E 13 88               LDX   #250*MSLOOP   
E0A5   BD FF 06     CC1:      JSR   KEY   
E0A8   26 06                  BNE   cc2   
E0AA   30 1F                  LEAX   -1,X   
E0AC   26 F7                  BNE   cc1   
E0AE   20 06                  BRA   cc3   
E0B0   81 03        CC2:      CMPA   #3   
E0B2   27 95                  BEQ   brk   
E0B4   97 34                  STA   <KEYBUF   
E0B6   86 03        CC3:      LDA   #3   
E0B8   35 10                  PULS   X   
E0BA   39           CC9:      RTS      
E0BB                          IF   1-CHECKED   
                    BRK:      EQU   fin   ; the unchecked build stops without a word;
E0BB                          ENDIF      
E0BB                          IF   CHECKED   
E0BB                BRK:      EQU   e_break   ;   the checked build reports B (the report
E0BB                          ENDIF      ;   takes S from SSAV, so the depth of the
E0BB                             ;   calls here doesn't matter)
E0BB                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
E0BB                             ; and return its value in A with the carry set; otherwise leave the IP and
E0BB                             ; return with the carry clear.
E0BB                             ; (In the unchecked build it is here, ahead of the table, to leave room in
E0BB                             ; the two ranges after it; the checked build has it next to the grave, and
E0BB                             ; so does the unchecked base build, which needs its bytes there instead.)
E0BB                          IF   (1-CHECKED)*(1-QK)   
                    HEXC:     BSR   isdig   
                              BLO   hv1   ; C = 1
                              ANDA   #0DFh   
                              SUBA   #11h   
                              CMPA   #6   
                              BHS   hv9   ; C = 0
                              SUBA   #0F6h   ; + 10, and sets the carry
                    HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
                    HV9:      RTS      
E0BB                          ENDIF      
E0BB                             ; =============================================================================
E0BB                             ;  Dispatch table, in code order.
E0BB                             ; 
E0BB                             ;  Unchecked build: one byte per character, the low byte of the handler's
E0BB                             ;  distance from PTAB. NPG1 is how many characters, from the start, have
E0BB                             ;  handlers more than 255 bytes past PTAB. ] \ [ @ ? sit where the two ranges
E0BB                             ;  meet (in falling code order for this), and which side each lands on is
E0BB                             ;  worked out here. (One division to a line: asm80 only rounds down when it
E0BB                             ;  stores a value.)
E0BB                             ; 
E0BB                             ;  Checked build: it has more code than the two ranges hold, so its table
E0BB                             ;  holds whole addresses and there are no rules about where handlers go.
E0BB                             ; 
E0BB                             ;  The unchecked base build keeps to the same rules: its skip and udiv are
E0BB                             ;  out in the tail, and hexc comes into the first range, where the checked
E0BB                             ;  build has it. The fast build has no PTAB (see "The fast build").
E0BB                             ; =============================================================================
E0BB                          IF   (1-CHECKED)*(1-FAST)   
                    PGRET:    EQU   (h_ret-PTAB)/256   ; 0 = first range, 1 = second
                    PGBRK:    EQU   (h_break-PTAB)/256   
                    PGDEF:    EQU   (h_def-PTAB)/256   
                    PGFET:    EQU   (h_fetch-PTAB)/256   
                    PGKEY:    EQU   (h_key-PTAB)/256   
                    NPG1:     EQU   20 + PGKEY + PGFET + PGDEF + PGBRK + PGRET   
E0BB                          ENDIF      
E0BB                PTAB:        
E0BB                          IF   (1-CHECKED)*(1-FAST)   
                              FCB   (h_store-PTAB) & 0FFh   ; !
                              FCB   (h_str-PTAB) & 0FFh   ; "
                              FCB   (h_num-PTAB) & 0FFh   ; #
                              FCB   (h_print-PTAB) & 0FFh   ; $
                              FCB   (h_swap-PTAB) & 0FFh   ; %
                              FCB   (h_and-PTAB) & 0FFh   ; &
                              FCB   (h_emit-PTAB) & 0FFh   ; '
                              FCB   (h_open-PTAB) & 0FFh   ; (
                              FCB   (h_close-PTAB) & 0FFh   ; )
                              FCB   (h_mul-PTAB) & 0FFh   ; *
                              FCB   (h_add-PTAB) & 0FFh   ; +
                              FCB   (h_cfetch-PTAB) & 0FFh   ; ,
                              FCB   (h_sub-PTAB) & 0FFh   ; -
                              FCB   (h_cstore-PTAB) & 0FFh   ; .
                              FCB   (h_div-PTAB) & 0FFh   ; /
                              FCB   (h_dup-PTAB) & 0FFh   ; :
                              FCB   (h_drop-PTAB) & 0FFh   ; ;
                              FCB   (h_lt-PTAB) & 0FFh   ; <
                              FCB   (h_eq-PTAB) & 0FFh   ; =
                              FCB   (h_gt-PTAB) & 0FFh   ; >
                              FCB   (h_key-PTAB) & 0FFh   ; ?
                              FCB   (h_fetch-PTAB) & 0FFh   ; @
                              FCB   (h_def-PTAB) & 0FFh   ; [
                              FCB   (h_break-PTAB) & 0FFh   ; \
                              FCB   (h_ret-PTAB) & 0FFh   ; ]
                              FCB   (h_xor-PTAB) & 0FFh   ; ^
                              FCB   (h_alloc-PTAB) & 0FFh   ; _
                              FCB   (h_grave-PTAB) & 0FFh   ; `
                              FCB   (h_tor-PTAB) & 0FFh   ; {
                              FCB   (h_or-PTAB) & 0FFh   ; |
                              FCB   (h_fromr-PTAB) & 0FFh   ; }
                              FCB   (h_not-PTAB) & 0FFh   ; ~
E0BB                          ENDIF      
E0BB                          IF   CHECKED*(1-FAST)   
                              FDB   h_store   ; !
                              FDB   h_str   ; "
                              FDB   h_num   ; #
                              FDB   h_print   ; $
                              FDB   h_swap   ; %
                              FDB   h_and   ; &
                              FDB   h_emit   ; '
                              FDB   h_open   ; (
                              FDB   h_close   ; )
                              FDB   h_mul   ; *
                              FDB   h_add   ; +
                              FDB   h_cfetch   ; ,
                              FDB   h_sub   ; -
                              FDB   h_cstore   ; .
                              FDB   h_div   ; /
                              FDB   h_dup   ; :
                              FDB   h_drop   ; ;
                              FDB   h_lt   ; <
                              FDB   h_eq   ; =
                              FDB   h_gt   ; >
                              FDB   h_key   ; ?
                              FDB   h_fetch   ; @
                              FDB   h_def   ; [
                              FDB   h_break   ; \
                              FDB   h_ret   ; ]
                              FDB   h_xor   ; ^
                              FDB   h_alloc   ; _
                              FDB   h_grave   ; `
                              FDB   h_tor   ; {
                              FDB   h_or   ; |
                              FDB   h_fromr   ; }
                              FDB   h_not   ; ~
E0BB                          ENDIF      
E0BB                PTABEND:      
E0BB                             ; =============================================================================
E0BB                             ;  Handlers that must start in the first range (within 255 bytes of PTAB)
E0BB                             ;  in the unchecked build: ^ _ ` 00bbIHwg ~
E0BB                             ; =============================================================================
E0BB   EC C1        H_OR:     LDD   ,U++   
E0BD   AA C4                  ORA   ,U   
E0BF   EA 41                  ORB   1,U   
E0C1   20 06                  BRA   st0   
E0C3   EC C1        H_XOR:    LDD   ,U++   
E0C5   A8 C4                  EORA   ,U   
E0C7   E8 41                  EORB   1,U   
E0C9   ED C4        ST0:      STD   ,U   
E0CB   39                     RTS      
E0CC   63 C4        H_NOT:    COM   ,U   
E0CE   63 41                  COM   1,U   
E0D0   39                     RTS      
E0D1                             ; "{" ( n -- ) R: ( -- n )     The dispatcher's return address comes off the
E0D1                             ; return stack first (PULS X) and is jumped to at the end.
E0D1   35 10        H_TOR:    PULS   X   
E0D3   37 06                  PULU   D   
E0D5   34 06                  PSHS   D   
E0D7   6E 84                  JMP   ,X   
E0D9                             ; "}" ( -- n ) R: ( n -- )    The dispatcher's return address comes off
E0D9                             ; into D and the entry under it into X; D is then jumped to.
E0D9   35 16        H_FROMR:   PULS   D,X   
E0DB   36 10                  PSHU   X   
E0DD   1F 05                  TFR   D,PC   
E0DF                             ; "_" ( n -- addr ): the heap pointer moves by n (signed: a 16-bit add);
E0DF                             ; TOS is the old pointer.
E0DF                             ; Checked: the new top must be at least the program's end (PEND) and below
E0DF                             ; the limit page. That also catches an add that wraps: the top is always
E0DF                             ; 8301h-EFFFh and n is -32768..32767, so a sum that carries past FFFFh
E0DF                             ; lands below 7000h, and one that borrows can't happen.
E0DF   D6 7C        H_ALLOC:   LDB   <HEAP   
E0E1   96 7D                  LDA   <HEAP+1   
E0E3   1F 01                  TFR   D,X   ; the old pointer
E0E5   E3 C4                  ADDD   ,U   
E0E7                          IF   CHECKED   
E0E7   10 93 38               CMPD   <PEND   
E0EA   25 04                  BLO   ah9   ; below the program's end
E0EC   81 DF                  CMPA   #HEAPLIM   
E0EE   25 04                  BLO   ah1   ; the new top must stay below the limit page
E0F0   86 48        AH9:      LDA   #"H"   
E0F2   20 5A                  BRA   ejmp   ; (with [ below)
E0F4                AH1:         
E0F4                          ENDIF      
E0F4   D7 7C                  STB   <HEAP   
E0F6   97 7D                  STA   <HEAP+1   
E0F8   AF C4                  STX   ,U   
E0FA   39                     RTS      
E0FB                             ; ---- machine code: the grave -----------------------------------------------
E0FB                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E0FB                             ; are stored from addr until a non-hex character; then a RTS (39h) is
E0FB                             ; written and its address is left. An odd last digit is consumed and dropped.
E0FB                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
E0FB                             ; code is entered by JSR (the dispatcher's own), with the address already
E0FB                             ; popped: U points at the top data cell (big-endian, 2 bytes, stack grows
E0FB                             ; down) and the return address is on top of S. The code may pop and push
E0FB                             ; data cells by changing U; on return the cell at ,U is the new TOS. It must
E0FB                             ; keep Y (the interpreter's reading position), DP and S (balanced), and
E0FB                             ; return with RTS. A, B, X, CC may change.
E0FB                             ; Neither the loader's stores nor the code are checked, in either build.
E0FB   8D 1E        H_GRAVE:   BSR   hexc   ; the digit after the grave, if any
E0FD   24 1A                  BCC   exec   
E0FF   AE C4                  LDX   ,U   
E101   C6 10        HX1:      LDB   #16   
E103   3D                     MUL      ; B = the digit, moved up to the high half
E104   E7 84                  STB   ,X   ; (an odd digit is overwritten by the RTS)
E106   8D 13                  BSR   hexc   
E108   24 08                  BCC   hx2   ; odd digit: already consumed, dropped
E10A   AA 84                  ORA   ,X   
E10C   A7 80                  STA   ,X+   
E10E   8D 0B                  BSR   hexc   
E110   25 EF                  BCS   hx1   
E112   86 39        HX2:      LDA   #39h   ; RTS
E114   A7 84                  STA   ,X   
E116   AF C4                  STX   ,U   
E118   39                     RTS      
E119   37 80        EXEC:     PULU   PC   ; jump to it: the code's RTS returns to the
E11B                             ;   dispatcher
E11B                          IF   CHECKED+QK   
E11B   BD E0 5B     HEXC:     JSR   isdig   
E11E   25 0A                  BLO   hv1   ; C = 1
E120   84 DF                  ANDA   #0DFh   
E122   80 11                  SUBA   #11h   
E124   81 06                  CMPA   #6   
E126   24 04                  BHS   hv9   ; C = 0
E128   80 F6                  SUBA   #0F6h   ; + 10, and sets the carry
E12A   31 21        HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
E12C   39           HV9:      RTS      
E12D                          ENDIF      
E12D                             ; ---- where the two ranges meet ---------------------------------------------
E12D                             ; The first range ends somewhere among the next five handlers, ] \ [ @ ?
E12D                             ; (they are in falling code order for this): NPG1 follows. Every handler
E12D                             ; below them must start in the second range, and every one above in the
E12D                             ; first.
E12D                             ; "]" returns: pop an address and jump to it. (PULS X,Y: the dispatcher's
E12D                             ; return address into X, then the saved IP into Y.)
E12D   35 30        H_RET:    PULS   X,Y   
E12F   6E 84                  JMP   ,X   
E131                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E131                             ; drops the block start, "]" returns. No closer at all ends the program.
E131   EC C1        H_BREAK:   LDD   ,U++   
E133                          IF   1-QK   
                              BEQ   sk9   ; false: nothing to do
                              BSR   skip   
E133                          ENDIF      
E133                          IF   QK   
E133   27 F7                  BEQ   hv9   ; false: nothing to do (hexc's RTS)
E135   BD E4 12               JSR   skip   ; (base: in the tail, with its cache)
E138                          ENDIF      
E138   4D                     TSTA      ; skip returns 0 for ")"
E139                          IF   CHECKED   
E139   10 2B FF 14            LBMI   fin   ; (and FFh for the NUL: the program ends)
E13D                          ENDIF      
E13D   26 EE                  BNE   h_ret   
E13F   35 16        RDROP:    PULS   D,X   ; the return address and the block start
E141   1F 05                  TFR   D,PC   ; back to the dispatcher
E143                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E143                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E143                             ; the body"s address instead. Either way it then skips to the matching "]'.
E143                             ; (The unchecked build takes anything that is not a letter as the space; the
E143                             ; checked build stops on it.)
E143                          IF   CHECKED   
E143   81 DF        DEF1:     CMPA   #" "-"A"+256   
E145   27 20                  BEQ   def2   
E147   31 3F                  LEAY   -1,Y   ; anything but a letter or a space: W. The
E149   10 9F 36               STY   <AT   ;   place is that character, just read
E14C   86 57                  LDA   #"W"   
E14E   7E E2 92     EJMP:     JMP   error   ; (H and N come here too)
E151                          ENDIF      
E151   A6 A0        H_DEF:    LDA   ,Y+   
E153   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E155   1F 89                  TFR   A,B   ;   lands 64 bytes up
E157   C4 DF                  ANDB   #0DFh   ; fold case
E159   C1 1A                  CMPB   #26   
E15B                          IF   1-CHECKED   
                              BHS   def2   ; not a letter
E15B                          ENDIF      
E15B                          IF   CHECKED   
E15B   24 E6                  BHS   def1   
E15D                          ENDIF      
E15D   BD E0 54               JSR   cellx   
E160   1F 20                  TFR   Y,D   
E162   E7 84                  STB   ,X   ; little-endian
E164   A7 01                  STA   1,X   
E166   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
E167   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
E169                          IF   (1-CHECKED)*(1-QK)   
                                 ; fall into skip
E169                          ENDIF      
E169                          IF   QK*(1-CHECKED)   
                              JMP   skip   ; (base: in the tail, with its cache)
E169                          ENDIF      
E169                          IF   CHECKED   
E169                             ; Checked: the skip must end at a "]" (A = 2), or for a false "(",
E169                             ; which comes to opf, at a ")" (A = 0). Anything else stops with N.
E169                          ENDIF      
E169                          IF   CHECKED*(1-QK)   
                              BSR   skip   
                              SUBA   #2   
                              FCB   8Ch   ; (CMPX #: steps over the BSR)
                    OPF:      BSR   skip   
                              TSTA      
                              BEQ   sk9   ; (an RTS)
                              LDA   #"N"   
                              BRA   ejmp   
E169                          ENDIF      
E169                          IF   CHECKED*QK   
E169   BD E4 12               JSR   skip   ; (base: in the tail, with its cache)
E16C   80 02                  SUBA   #2   
E16E   20 03                  BRA   of1   
E170   BD E4 12     OPF:      JSR   skip   
E173   4D           OF1:      TSTA      
E174   27 B6                  BEQ   hv9   ; (an RTS: hexc's)
E176   86 4E                  LDA   #"N"   
E178   20 D4                  BRA   ejmp   
E17A                          ENDIF      
E17A                             ; skip: read past text to the closer at this level, and return A = 0 if it
E17A                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
E17A                             ; strings are stepped over whole. B counts the open levels.
E17A                             ; Unchecked: a NUL first ends the program (for "\" with no closer; anything
E17A                             ; else that runs into the NUL had unbalanced brackets anyway).
E17A                             ; Checked: a NUL, or a string that runs into it, returns A = FFh, and the
E17A                             ; caller decides: "\" ends the program, "(" and "[" stop with N, as they do
E17A                             ; for a closer of the other kind. The place is the opener, still in AT.
E17A                             ; (base has its own, with the skip cache, in the tail: see "Speed-ups".)
E17A                          IF   1-QK   
                    SKIP:     CLRB      
                    SK1:      LDA   ,Y+   
E17A                          ENDIF      
E17A                          IF   (1-CHECKED)*(1-QK)   
                              LBEQ   fin   
E17A                          ENDIF      
E17A                          IF   CHECKED*(1-QK)   
                              BEQ   ssn   ; A = FFh
E17A                          ENDIF      
E17A                          IF   1-QK   
                              CMPA   #22h   
                              BNE   sk2   
                              BSR   skipstr   ; leaves A = 22h, which matches nothing below
E17A                          ENDIF      
E17A                          IF   CHECKED*(1-QK)   
                              BCS   sk9   ; (or FFh, with the carry set: unclosed)
E17A                          ENDIF      
E17A                          IF   1-QK   
                    SK2:      SUBA   #"("   
                              BEQ   sk3   
                              DECA      ; ")"
                              BEQ   sk4   
                              SUBA   #"["-")"   
                              BEQ   sk3   
                              CMPA   #"]"-"["   
                              BNE   sk1   
                    SK4:      DECB      
                              BPL   sk1   
                    SK9:      RTS      ; the closer at this level
                    SK3:      INCB      
                              BRA   sk1   
E17A                          ENDIF      
E17A                             ; 22h, checked build (the unchecked one is with the handlers below).
E17A                             ; Checked: a NUL ends the string too, even right after a "/"; skipstr then
E17A                             ; returns A = FFh with the carry set (the carry is clear at the quote), and
E17A                             ; """ stops with Q, the string's address already pushed. (skip comes here
E17A                             ; for its own NUL as well.)
E17A                          IF   CHECKED   
E17A   36 20        H_STR:    PSHU   Y   
E17C   8D 09                  BSR   skipstr   
E17E   10 25 01 0E            LBCS   e_quote   
E182   39                     RTS      
E183   A6 A0        SS0:      LDA   ,Y+   ; the character after the "/"
E185   27 0D                  BEQ   ssn   
E187   A6 A0        SKIPSTR:   LDA   ,Y+   
E189   27 09                  BEQ   ssn   
E18B   81 2F                  CMPA   #"/"   
E18D   27 F4                  BEQ   ss0   
E18F   81 22                  CMPA   #22h   
E191   26 F4                  BNE   skipstr   
E193   39                     RTS      ; the quote: C = 0
E194   80 01        SSN:      SUBA   #1   ; the NUL: A = FFh, C = 1
E196   39                     RTS      
E197                          ENDIF      
E197   AE C4        H_FETCH:   LDX   ,U   ; "@" (the cell in memory is little-endian)
E199   A6 01                  LDA   1,X   
E19B   20 5D                  BRA   cf1   
E19D                             ; "?" ( n -- c ) or ( -n -- addr )
E19D                             ;   n > 0: wait about n ms for a key; 0 if none came
E19D                             ;   n = 0: wait for a key
E19D                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E19D                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E19D   AE C4        H_KEY:    LDX   ,U   
E19F   2B 17                  BMI   line   
E1A1   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
E1A3   BD E0 8C     KT2:      JSR   getk   
E1A6   26 0B                  BNE   kt3   
E1A8   5A                     DECB      
E1A9   26 F8                  BNE   kt2   
E1AB   30 1F                  LEAX   -1,X   
E1AD   26 F2                  BNE   kt1   ; A = 0 if the time ran out
E1AF   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
E1B1   27 EE                  BEQ   kt1   ;   run it again, until a key comes
E1B3   6F C4        KT3:      CLR   ,U   
E1B5   A7 41                  STA   1,U   
E1B7   39                     RTS      
