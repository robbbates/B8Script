0618   FE E1                  CPI   RSTOP&0FFh+1   
061A   D2 1F 06               JNC   e_runder   
061D   EB                     XCHG      ; TOS back
061E   C9                     RET      
061F   21 E0 80     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
0622   22 34 82               SHLD   RSP   
0625   3E 72                  MVI   A,"r"   
0627   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
0628   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
062A   21                     DB   21h   
062B   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
062D   EB                     XCHG      ; TOS back
062E   C3 60 06               JMP   errp   
