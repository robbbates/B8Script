                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   uv5   
                              STA   0FFh,X   
                              STY   0FEh,X   
                              INC   0,X   
                    UV5:         
                              ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              TAY      
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   uv6   
                              STA   0FFh,X   
                              STY   0FEh,X   
                              INC   0,X   
                    UV6:         
                              ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              TAY      
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   uv7   
                              STA   0FFh,X   
                              STY   0FEh,X   
                              INC   0,X   
                    UV7:         
                              ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              TAY      
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   uv8   
                              STA   0FFh,X   
                              STY   0FEh,X   
                              INC   0,X   
                    UV8:         
                              ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              TAY      
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   uv9   
                              STA   0FFh,X   
                              STY   0FEh,X   
                              INC   0,X   
                    UV9:         
                              ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
