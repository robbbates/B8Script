04D3   53 74 6B 20 22         DB   "Stk ",22h   
04D8   21 06 7E               LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
04DB   39                     DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
04DC   E7                     RST   4   ;   first value and holds nothing)
04DD   7C                     MOV   A,H   
04DE   CD 2C 05               CALL   phal2   ; the depth
04E1   3E 3A                  MVI   A,":"   
04E3   EF                     RST   5   
04E4   79                     MOV   A,C   
04E5   FE 09                  CPI   9   
04E7   DA F4 04               JC   er6   
04EA   CD 05 04               CALL   pmsg   
04ED   20 2E 2E 2E 22         DB   " ...",22h   
04F2   0E 08                  MVI   C,8   
04F4   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
04F6   69                     MOV   L,C   
04F7   29                     DAD   H   
04F8   39                     DAD   SP   ; HL -> just above the deepest of them
04F9   0C                     INR   C   
04FA   0D           ER7:      DCR   C   
04FB   CA 10 05               JZ   er8   
04FE   2B                     DCX   H   
04FF   56                     MOV   D,M   
0500   2B                     DCX   H   
0501   5E                     MOV   E,M   
0502   E5                     PUSH   H   
0503   C5                     PUSH   B   
0504   3E 20                  MVI   A," "   
0506   EF                     RST   5   
0507   EB                     XCHG      
0508   CD AA 02               CALL   psgn   
050B   C1                     POP   B   
050C   E1                     POP   H   
050D   C3 FA 04               JMP   er7   
0510   CD FF 03     ER8:      CALL   pnl   
0513   52 74 6E 20 22         DB   "Rtn ",22h   
0518   2A 34 82               LHLD   RSP   
051B   EB                     XCHG      
051C   21 E0 80               LXI   H,RSTOP   
051F   CD 29 05               CALL   phalf   
0522   CD FF 03               CALL   pnl   
0525   22                     DB   22h   
0526   C3 7F 00               JMP   endprog   
0529                             ; phalf: print half of HL - DE, and leave it in BC
0529   CD 38 05     PHALF:    CALL   sub16   
052C   B7           PHAL2:    ORA   A   ; (A = H; this clears the carry)
052D   1F                     RAR      
052E   67                     MOV   H,A   
052F   7D                     MOV   A,L   
0530   1F                     RAR      
0531   6F                     MOV   L,A   
0532   E5                     PUSH   H   
0533   CD B3 02               CALL   pdec   
0536   C1                     POP   B   
0537   C9                     RET      
0538                             ; sub16: HL = HL - DE. Leaves A = H.
0538   7D           SUB16:    MOV   A,L   
0539   93                     SUB   E   
053A   6F                     MOV   L,A   
053B   7C                     MOV   A,H   
053C   9A                     SBB   D   
053D   67                     MOV   H,A   
053E   C9                     RET      
053F                          ENDIF      
053F                             ; =============================================================================
053F                             ;  Startup
053F                             ; =============================================================================
053F                START:       
053F                          IF   (1-CPM)*CHECKED   
053F   31 FC 81               LXI   SP,DSTOP   
0542                          ENDIF      
0542                          IF   CHECKED   
0542                             ; Clear the lower half of the letter page: every variable starts at
0542                             ; 0, every word cell holds 0000h, the address an undefined word is
0542                             ; caught at (see e_hi), and no key is held back.
0542   21 00 82               LXI   H,LET   
0545   AF                     XRA   A   
0546   77           INI1:     MOV   M,A   
0547   2C                     INR   L   
0548   F2 46 05               JP   ini1   ; +00h to +7Fh
054B                          ENDIF      
054B                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   H,vecs   ; the RST routines go down into page zero
                              LXI   D,0008h   
                              MVI   B,vecend-vecs   
                    CPY:      MOV   A,M   
                              STAX   D   
                              INX   H   
                              INX   D   
                              DCR   B   
                              JNZ   cpy   
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
054B                          ENDIF      
054B                          IFN   CPM   
054B   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
054E   7E           FNUL:     MOV   A,M   
054F   23                     INX   H   
0550   B7                     ORA   A   
0551   C2 4E 05               JNZ   fnul   
0554                          ENDIF      
0554   22 7C 82               SHLD   HEAP   
0557                          IF   CHECKED   
0557   E7                     RST   4   ; minus the heap"s first address: "_' may not
0558   22 38 82               SHLD   NPEND   ;   release below it
055B                          ENDIF      
055B   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
055E   22 34 82               SHLD   RSP   
0561                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
0561                          ENDIF      ;   checked build has cleared these)
0561                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0561                          ENDIF      
0561                          IF   1-CHECKED   
                              SHLD   KEYBUF   
0561                          ENDIF      
0561   01 00 83               LXI   B,PROG   ; the IP
0564   F7                     RST   6   ; (its return address is thrown away)
0565                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0565                          ENDIF      
0565                IMGEND:      


