  2407                              <1> ; =============================================================================
  2408                              <1> ;  The inner loop: read one character and sort it by range.
  2409                              <1> ;
  2410                              <1> ;    00h          end of program
  2411                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  2412                              <1> ;                 build stops on 80h-FFh: X)
  2413                              <1> ;    30h-39h      digit: read a whole number
  2414                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  2415                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  2416                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  2417                              <1> ;
  2418                              <1> ;  (The fast build has none of this: `next` is its table's dispatcher. See
  2419                              <1> ;  "The fast build".)
  2420                              <1> ; =============================================================================
  2421                              <1> %if FAST == 0
  2422                              <1> ; Digits: step back onto the first digit and read the whole number.
  2423                              <1> digit:  push    ebx
  2424                              <1>         dec     esi
  2425                              <1>         CALLP   rdnum
  2426                              <1>         jmp     ebp
  2427                              <1> 
  2428                              <1>  %if SBASEU == 0
  2429                              <1> ; a-z: push the cell's address (the cell is the variable). (The unchecked
  2430                              <1> ; base build does x@ and x! in one step: its `lower` is after the window.)
  2431                              <1> lower:  push    ebx
  2432                              <1>         lea     ebx,[ARENA+LET+eax*2]
  2433                              <1>         jmp     ebp
  2434                              <1>  %endif
  2435                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  2436                              <1> ; next in reach)
  2437                              <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  2438                              <1>         jnz     next                    ; the rest are ignored
  2439                              <1>         jmp     endprog
  2440                              <1> %endif
  2441                              <1> %if CHECKED
  2442                              <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  2443                              <1>         jmp     error
  2444                              <1> %endif
  2445                              <1> %if FAST
  2446                              <1> next:   NEXTF                           ; (the fast build: through the table)
  2446                              <2> next: 
   247                              <2> %if CHECKED
   248                              <2>  call chkstk
   249                              <2> %endif
   250 00001F70 0FB606              <2>  movzx eax,byte [esi]
   251 00001F73 46                  <2>  inc esi
   252 00001F74 FF2485[CC140000]    <2>  jmp [dtab+eax*4]
  2447                              <1> %else
  2448                              <1> next:
  2449                              <1> %if CHECKED
  2450                              <1>         call    chkstk                  ; both stacks, once per character
  2451                              <1> %endif
  2452                              <1>         xor     eax,eax
  2453                              <1>         lodsb
  2454                              <1>         sub     al,21h                  ; AL = c - 21h
  2455                              <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  2456                              <1>         cmp     al,0Fh
  2457                              <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  2458                              <1>         sub     al,0Fh                  ; AL = c - 30h
  2459                              <1>         cmp     al,0Ah
  2460                              <1>         jb      digit                   ; 30h-39h
  2461                              <1>         cmp     al,11h
  2462                              <1>         jb      p3a                     ; 3Ah-40h
  2463                              <1>         sub     al,11h                  ; AL = c - 41h
  2464                              <1>         cmp     al,1Ah
  2465                              <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  2466                              <1>         cmp     al,20h
  2467                              <1>         jb      p5b                     ; 5Bh-60h
  2468                              <1>         cmp     al,3Ah
  2469                              <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  2470                              <1>         cmp     al,3Eh
  2471                              <1> %if CHECKED
  2472                              <1>         je      next                    ; 7Fh, DEL: ignored
  2473                              <1>         jae     e_hi                    ; 80h-FFh: reserved
  2474                              <1> %else
  2475                              <1>         jae     next                    ; 7Fh-FFh: ignored
  2476                              <1> %endif
  2477                              <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  2478                              <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  2479                              <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  2480                              <1> punct:  mov     al,[ptab+eax]
  2481                              <1>         lea     eax,[hbase+eax]
  2482                              <1>         jmp     eax
  2483                              <1> %endif
