   730                              <1> 
   731                              <1> ; '[' followed by a letter stores the body's address in that letter's cell:
   732                              <1> ; uppercase is a word, lowercase a variable. Followed by a space it pushes
   733                              <1> ; the body's address instead. Either way it then skips to the matching ']'.
   734                              <1> ; (The unchecked build takes anything that is not a letter as the space; the
   735                              <1> ; checked build stops on it with W.)
   736 000001F8 31C0                <1> def1:   xor     eax,eax
   737 000001FA AC                  <1>         lodsb
   738 000001FB 2C41                <1>         sub     al,'A'                  ; a letter gives 0-25 or 32-57:
   739 000001FD 89C2                <1>         mov     edx,eax                 ;   lowercase lands 64 bytes up
   740 000001FF 24DF                <1>         and     al,0DFh                 ; (fold case)
