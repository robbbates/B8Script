F10F                          ENDIF      
F10F                          IF   CHECKED   
                              FDB   h_store   ; !
                              FDB   h_str   ; "
                              FDB   h_num   ; #
                              FDB   h_print   ; $
                              FDB   h_swap   ; %
                              FDB   h_and   ; &
                              FDB   h_emit   ; '
                              FDB   h_open   ; (
                              FDB   h_close   ; )
                              FDB   h_mul   ; *
                              FDB   h_add   ; +
                              FDB   h_cfetch   ; ,
                              FDB   h_sub   ; -
                              FDB   h_cstore   ; .
                              FDB   h_div   ; /
                              FDB   h_dup   ; :
                              FDB   h_drop   ; ;
                              FDB   h_lt   ; <
                              FDB   h_eq   ; =
                              FDB   h_gt   ; >
                              FDB   h_key   ; ?
                              FDB   h_fetch   ; @
                              FDB   h_def   ; [
                              FDB   h_break   ; \
                              FDB   h_ret   ; ]
                              FDB   h_xor   ; ^
                              FDB   h_alloc   ; _
                              FDB   h_grave   ; `
                              FDB   h_tor   ; {
                              FDB   h_or   ; |
                              FDB   h_fromr   ; }
                              FDB   h_not   ; ~
F10F                          ENDIF      
F10F                PTABEND:      
F10F                             ; =============================================================================
F10F                             ;  Handlers that must start in the first range (within 255 bytes of PTAB)
F10F                             ;  in the unchecked build: ^ _ ` 00bbIHwg ~
F10F                             ; =============================================================================
F10F   EC C1        H_OR:     LDD   ,U++   
F111   AA C4                  ORA   ,U   
F113   EA 41                  ORB   1,U   
F115   20 06                  BRA   st0   
F117   EC C1        H_XOR:    LDD   ,U++   
F119   A8 C4                  EORA   ,U   
F11B   E8 41                  EORB   1,U   
F11D   ED C4        ST0:      STD   ,U   
F11F   39                     RTS      
F120   63 C4        H_NOT:    COM   ,U   
F122   63 41                  COM   1,U   
F124   39                     RTS      
F125                             ; "{" ( n -- ) R: ( -- n )     The dispatcher's return address comes off the
F125                             ; return stack first (PULS X) and is jumped to at the end.
F125   35 10        H_TOR:    PULS   X   
F127   37 06                  PULU   D   
F129   34 06                  PSHS   D   
F12B   6E 84                  JMP   ,X   
F12D                             ; "}" ( -- n ) R: ( n -- )    The dispatcher's return address comes off
F12D                             ; into D and the entry under it into X; D is then jumped to.
F12D   35 16        H_FROMR:   PULS   D,X   
F12F   36 10                  PSHU   X   
F131   1F 05                  TFR   D,PC   
F133                             ; "_" ( n -- addr ): the heap pointer moves by n (signed: a 16-bit add);
F133                             ; TOS is the old pointer.
F133                             ; Checked: the new top must be at least the program's end (PEND) and below
F133                             ; the limit page. That also catches an add that wraps: the top is always
F133                             ; 8301h-EFFFh and n is -32768..32767, so a sum that carries past FFFFh
F133                             ; lands below 7000h, and one that borrows can't happen.
F133   D6 7C        H_ALLOC:   LDB   <HEAP   
F135   96 7D                  LDA   <HEAP+1   
F137   1F 01                  TFR   D,X   ; the old pointer
F139   E3 C4                  ADDD   ,U   
F13B                          IF   CHECKED   
                              CMPD   <PEND   
                              BLO   ah9   ; below the program's end
                              CMPA   #HEAPLIM   
                              BLO   ah1   ; the new top must stay below the limit page
                    AH9:      LDA   #"H"   
                              BRA   ejmp   ; (with [ below)
                    AH1:         
F13B                          ENDIF      
F13B   D7 7C                  STB   <HEAP   
F13D   97 7D                  STA   <HEAP+1   
F13F   AF C4                  STX   ,U   
F141   39                     RTS      
F142                             ; ---- machine code: the grave -----------------------------------------------
F142                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
F142                             ; are stored from addr until a non-hex character; then a RTS (39h) is
F142                             ; written and its address is left. An odd last digit is consumed and dropped.
F142                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
F142                             ; code is entered by JSR (the dispatcher's own), with the address already
F142                             ; popped: U points at the top data cell (big-endian, 2 bytes, stack grows
F142                             ; down) and the return address is on top of S. The code may pop and push
F142                             ; data cells by changing U; on return the cell at ,U is the new TOS. It must
F142                             ; keep Y (the interpreter's reading position), DP and S (balanced), and
F142                             ; return with RTS. A, B, X, CC may change.
F142                             ; Neither the loader's stores nor the code are checked, in either build.
F142   8D 9A        H_GRAVE:   BSR   hexc   ; the digit after the grave, if any
F144   24 1A                  BCC   exec   
F146   AE C4                  LDX   ,U   
F148   C6 10        HX1:      LDB   #16   
F14A   3D                     MUL      ; B = the digit, moved up to the high half
F14B   E7 84                  STB   ,X   ; (an odd digit is overwritten by the RTS)
F14D   8D 8F                  BSR   hexc   
F14F   24 08                  BCC   hx2   ; odd digit: already consumed, dropped
F151   AA 84                  ORA   ,X   
F153   A7 80                  STA   ,X+   
F155   8D 87                  BSR   hexc   
F157   25 EF                  BCS   hx1   
F159   86 39        HX2:      LDA   #39h   ; RTS
F15B   A7 84                  STA   ,X   
F15D   AF C4                  STX   ,U   
F15F   39                     RTS      
F160   37 80        EXEC:     PULU   PC   ; jump to it: the code's RTS returns to the
F162                             ;   dispatcher
F162                          IF   CHECKED   
                    HEXC:     JSR   isdig   
                              BLO   hv1   ; C = 1
                              ANDA   #0DFh   
                              SUBA   #11h   
                              CMPA   #6   
                              BHS   hv9   ; C = 0
                              SUBA   #0F6h   ; + 10, and sets the carry
                    HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
                    HV9:      RTS      
F162                          ENDIF      
F162                             ; ---- where the two ranges meet ---------------------------------------------
F162                             ; The first range ends somewhere among the next five handlers, ] \ [ @ ?
F162                             ; (they are in falling code order for this): NPG1 follows. Every handler
F162                             ; below them must start in the second range, and every one above in the
F162                             ; first.
F162                             ; "]" returns: pop an address and jump to it. (PULS X,Y: the dispatcher's
F162                             ; return address into X, then the saved IP into Y.)
F162   35 30        H_RET:    PULS   X,Y   
F164   6E 84                  JMP   ,X   
F166                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F166                             ; drops the block start, "]" returns. No closer at all ends the program.
F166   EC C1        H_BREAK:   LDD   ,U++   
F168   27 40                  BEQ   sk9   ; false: nothing to do
F16A   8D 1F                  BSR   skip   
F16C   4D                     TSTA      ; skip returns 0 for ")"
F16D                          IF   CHECKED   
                              LBMI   fin   ; (and FFh for the NUL: the program ends)
F16D                          ENDIF      
F16D   26 F3                  BNE   h_ret   
F16F   35 16        RDROP:    PULS   D,X   ; the return address and the block start
F171   1F 05                  TFR   D,PC   ; back to the dispatcher
F173                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F173                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F173                             ; the body"s address instead. Either way it then skips to the matching "]'.
F173                             ; (The unchecked build takes anything that is not a letter as the space; the
F173                             ; checked build stops on it.)
F173                          IF   CHECKED   
                    DEF1:     CMPA   #" "-"A"+256   
                              BEQ   def2   
                              LEAY   -1,Y   ; anything but a letter or a space: W. The
                              STY   <AT   ;   place is that character, just read
                              LDA   #"W"   
                    EJMP:     JMP   error   ; (H and N come here too)
F173                          ENDIF      
F173   A6 A0        H_DEF:    LDA   ,Y+   
F175   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
F177   1F 89                  TFR   A,B   ;   lands 64 bytes up
F179   C4 DF                  ANDB   #0DFh   ; fold case
F17B   C1 1A                  CMPB   #26   
F17D                          IF   1-CHECKED   
F17D   24 0A                  BHS   def2   ; not a letter
F17F                          ENDIF      
F17F                          IF   CHECKED   
                              BHS   def1   
F17F                          ENDIF      
F17F   BD F0 76               JSR   cellx   
F182   1F 20                  TFR   Y,D   
F184   E7 84                  STB   ,X   ; little-endian
F186   A7 01                  STA   1,X   
F188   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F189   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F18B                          IF   1-CHECKED   
F18B                             ; fall into skip
F18B                          ENDIF      
F18B                          IF   CHECKED   
                                 ; Checked: the skip must end at a "]" (A = 2), or for a false "(",
                                 ; which comes to opf, at a ")" (A = 0). Anything else stops with N.
                              BSR   skip   
                              SUBA   #2   
                              FCB   8Ch   ; (CMPX #: steps over the BSR)
                    OPF:      BSR   skip   
                              TSTA      
                              BEQ   sk9   ; (an RTS)
                              LDA   #"N"   
                              BRA   ejmp   
F18B                          ENDIF      
F18B                             ; skip: read past text to the closer at this level, and return A = 0 if it
F18B                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F18B                             ; strings are stepped over whole. B counts the open levels.
F18B                             ; Unchecked: a NUL first ends the program (for "\" with no closer; anything
F18B                             ; else that runs into the NUL had unbalanced brackets anyway).
F18B                             ; Checked: a NUL, or a string that runs into it, returns A = FFh, and the
F18B                             ; caller decides: "\" ends the program, "(" and "[" stop with N, as they do
F18B                             ; for a closer of the other kind. The place is the opener, still in AT.
F18B   5F           SKIP:     CLRB      
F18C   A6 A0        SK1:      LDA   ,Y+   
F18E                          IF   1-CHECKED   
F18E   10 27 FE E1            LBEQ   fin   
F192                          ENDIF      
F192                          IF   CHECKED   
                              BEQ   ssn   ; A = FFh
F192                          ENDIF      
F192   81 22                  CMPA   #22h   
F194   26 02                  BNE   sk2   
F196   8D 79                  BSR   skipstr   ; leaves A = 22h, which matches nothing below
F198                          IF   CHECKED   
                              BCS   sk9   ; (or FFh, with the carry set: unclosed)
F198                          ENDIF      
F198   80 28        SK2:      SUBA   #"("   
F19A   27 0F                  BEQ   sk3   
F19C   4A                     DECA      ; ")"
F19D   27 08                  BEQ   sk4   
F19F   80 32                  SUBA   #"["-")"   
F1A1   27 08                  BEQ   sk3   
F1A3   81 02                  CMPA   #"]"-"["   
F1A5   26 E5                  BNE   sk1   
F1A7   5A           SK4:      DECB      
F1A8   2A E2                  BPL   sk1   
F1AA   39           SK9:      RTS      ; the closer at this level
F1AB   5C           SK3:      INCB      
F1AC   20 DE                  BRA   sk1   
F1AE                             ; 22h, checked build (the unchecked one is with the handlers below).
F1AE                             ; Checked: a NUL ends the string too, even right after a "/"; skipstr then
F1AE                             ; returns A = FFh with the carry set (the carry is clear at the quote), and
F1AE                             ; """ stops with Q, the string's address already pushed. (skip comes here
F1AE                             ; for its own NUL as well.)
F1AE                          IF   CHECKED   
                    H_STR:    PSHU   Y   
                              BSR   skipstr   
                              LBCS   e_quote   
                              RTS      
                    SS0:      LDA   ,Y+   ; the character after the "/"
                              BEQ   ssn   
                    SKIPSTR:   LDA   ,Y+   
                              BEQ   ssn   
                              CMPA   #"/"   
                              BEQ   ss0   
                              CMPA   #22h   
                              BNE   skipstr   
                              RTS      ; the quote: C = 0
                    SSN:      SUBA   #1   ; the NUL: A = FFh, C = 1
                              RTS      
F1AE                          ENDIF      
F1AE   AE C4        H_FETCH:   LDX   ,U   ; "@" (the cell in memory is little-endian)
F1B0   A6 01                  LDA   1,X   
F1B2   20 6B                  BRA   cf1   
F1B4                             ; "?" ( n -- c ) or ( -n -- addr )
F1B4                             ;   n > 0: wait about n ms for a key; 0 if none came
F1B4                             ;   n = 0: wait for a key
F1B4                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
F1B4                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
F1B4   AE C4        H_KEY:    LDX   ,U   
F1B6   2B 17                  BMI   line   
F1B8   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F1BA   BD F0 AF     KT2:      JSR   getk   
F1BD   26 0B                  BNE   kt3   
F1BF   5A                     DECB      
F1C0   26 F8                  BNE   kt2   
F1C2   30 1F                  LEAX   -1,X   
F1C4   26 F2                  BNE   kt1   ; A = 0 if the time ran out
F1C6   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F1C8   27 EE                  BEQ   kt1   ;   run it again, until a key comes
F1CA   6F C4        KT3:      CLR   ,U   
F1CC   A7 41                  STA   1,U   
F1CE   39                     RTS      
F1CF                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F1CF                             ; (stored, not echoed), every other key is stored and echoed until the line
F1CF                             ; is full. B = the length so far; the low byte of the top cell becomes the
F1CF                             ; most allowed (it holds minus the count on entry).
F1CF   8C FF 81     LINE:     CMPX   #-127   ; (X = TOS, minus the count)
F1D2   24 04                  BHS   ln1   
F1D4   86 81                  LDA   #-127   ; more than 127 is taken as 127
F1D6   A7 41                  STA   1,U   
F1D8   60 41        LN1:      NEG   1,U   
F1DA   8E 82 80               LDX   #LINEBUF   
F1DD   5F                     CLRB      
F1DE   BD F0 AF     LN2:      JSR   getk   
F1E1   27 FB                  BEQ   ln2   
F1E3   81 0D                  CMPA   #13   
F1E5   27 16                  BEQ   ln5   
F1E7   81 08                  CMPA   #8   
F1E9   27 0C                  BEQ   ln4   
F1EB   E1 41                  CMPB   1,U   
F1ED   24 EF                  BHS   ln2   ; full
F1EF   A7 85                  STA   B,X   
F1F1   5C                     INCB      
F1F2   BD FF 03     LN3:      JSR   CONOUT   
F1F5   20 E7                  BRA   ln2   
F1F7   5D           LN4:      TSTB      ; Backspace: nothing to take back?
F1F8   27 E4                  BEQ   ln2   
F1FA   5A                     DECB      
F1FB   20 F5                  BRA   ln3   ; echo it
F1FD   A7 85        LN5:      STA   B,X   ; A = 13
F1FF   AF C4                  STX   ,U   
F201   39                     RTS      
F202                             ; =============================================================================
F202                             ;  Handlers that must start in the second range (unchecked build).
F202                             ; =============================================================================
F202                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
F202                             ; the matching ")".
F202   EC C1        H_OPEN:   LDD   ,U++   
F204                          IF   1-CHECKED   
F204   27 85                  BEQ   skip   ; tail call: skip ends in RTS
F206                          ENDIF      
F206                          IF   CHECKED   
                              LBEQ   opf   ; checked: skip, and check the closer
F206                          ENDIF      
F206   35 10                  PULS   X   
F208   34 20                  PSHS   Y   
F20A   6E 84                  JMP   ,X   
F20C                             ; 22h pushes the address of the text after it and skips the string.
F20C                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
F20C                             ; the next character, so "/"" does not end it. Leaves A = 22h. (The checked
F20C                             ; build's is after skip.)
F20C                          IF   1-CHECKED   
F20C   36 20        H_STR:    PSHU   Y   
F20E   8C                     FCB   8Ch   ; (CMPX #: steps over the LEAY)
F20F   31 21        SS0:      LEAY   1,Y   
F211   A6 A0        SKIPSTR:   LDA   ,Y+   
F213   81 2F                  CMPA   #"/"   
F215   27 F8                  BEQ   ss0   
F217   81 22                  CMPA   #22h   
F219   26 F6                  BNE   skipstr   
F21B   39                     RTS      
F21C                          ENDIF      
F21C   AE C4        H_CFETCH:   LDX   ,U   ; ","
F21E   4F                     CLRA      
F21F   E6 84        CF1:      LDB   ,X   
F221   ED C4                  STD   ,U   
F223   39                     RTS      
F224                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F224                             ; drops it and carries on.
F224   EC C1        H_CLOSE:   LDD   ,U++   
F226   10 27 FF 45            LBEQ   rdrop   
F22A   10 AE 62               LDY   2,S   ; the block start, under the return address
F22D   7E F0 A2               JMP   pollk   ; the break check, at every loop-back
F230                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
F230                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F230                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F230   A6 43        H_MUL:    LDA   3,U   
F232   E6 C4                  LDB   ,U   
F234   3D                     MUL      ; al*bh
F235   E7 C4                  STB   ,U   ; (bh is no longer needed)
F237   A6 42                  LDA   2,U   
F239   E6 41                  LDB   1,U   
F23B   3D                     MUL      ; ah*bl
F23C   EB C4                  ADDB   ,U   
F23E   E7 C4                  STB   ,U   ; the cross terms, low byte
F240   A6 43                  LDA   3,U   
F242   E6 41                  LDB   1,U   
F244   3D                     MUL      ; al*bl
F245   AB C4                  ADDA   ,U   
F247   33 42                  LEAU   2,U   
F249   ED C4                  STD   ,U   
F24B   39                     RTS      
F24C                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F24C   8D 18        H_GT:     BSR   h_swap   ; a > b is b < a
F24E   8D 10        H_LT:     BSR   cmp   
F250   2D 02                  BLT   true   
F252   5F           FALSE:    CLRB      
F253   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F254   C6 FF        TRUE:     LDB   #0FFh   
F256   1D                     SEX      ; D = 0000 or FFFF
F257   ED C4                  STD   ,U   
F259   39                     RTS      
F25A   8D 04        H_EQ:     BSR   cmp   
F25C   27 F6                  BEQ   true   
F25E   20 F2                  BRA   false   
F260   EC 42        CMP:      LDD   2,U   
F262   10 A3 C1               CMPD   ,U++   
F265   39                     RTS      
F266                             ; ---- stack, and printing ----------------------------------------------------
F266   37 16        H_SWAP:   PULU   D,X   ; "%"
F268   36 06                  PSHU   D   
F26A   36 10                  PSHU   X   
F26C   39                     RTS      
F26D   EC C4        H_DUP:    LDD   ,U   ; ":"
F26F   36 06                  PSHU   D   
F271   39                     RTS      
F272   A6 41        H_EMIT:   LDA   1,U   ; "'"
F274                          IF   1-CHECKED   
F274   8D 49                  BSR   putc   
F276                          ENDIF      
F276                          IF   CHECKED   
                              JSR   CONOUT   ; (the checked build's report is in the way)
F276                          ENDIF      
F276   33 42        H_DROP:   LEAU   2,U   ; ";"
F278   39                     RTS      
F279                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
F279                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
F279                             ; bit 6, so // and /" give themselves).
F279                             ; Checked: a NUL (not one escaped by "/") stops with Q, the string's address
F279                             ; still on the stack.
F279   AE C4        H_PRINT:   LDX   ,U   
F27B   A6 80        PR0:      LDA   ,X+   
F27D                          IF   CHECKED   
                              LBEQ   e_quote   
F27D                          ENDIF      
F27D   81 22                  CMPA   #22h   
F27F   27 F5                  BEQ   h_drop   
F281   81 2F                  CMPA   #"/"   
F283   26 04                  BNE   pr1   
F285   A6 80                  LDA   ,X+   
F287   84 BF                  ANDA   #0BFh   
F289                PR1:         
F289                          IF   1-CHECKED   
F289   8D 34                  BSR   putc   
F28B                          ENDIF      
F28B                          IF   CHECKED   
                              JSR   CONOUT   
F28B                          ENDIF      
F28B   20 EE                  BRA   pr0   
F28D                             ; "!" ( n addr -- ) is "." with the high byte stored first. The cell in
F28D                             ; memory is little-endian.
F28D                             ; Checked: both bytes must be in the program's space, and they are tested
F28D                             ; before either is stored (chkst stops with O, the stack untouched).
F28D   AE C4        H_STORE:   LDX   ,U   
F28F                          IF   1-CHECKED   
F28F   A6 42                  LDA   2,U   
F291   A7 01                  STA   1,X   
F293                          ENDIF      
F293                          IF   CHECKED   
                              BSR   chkst   
                              LEAX   1,X   
                              BSR   chkst   
                              LDA   2,U   
                              STA   ,X   
                                 ; and fall into ".", which loads X again (and checks it again)
F293                          ENDIF      
F293                          IF   1-CHECKED   
F293   8C                     FCB   8Ch   ; (CMPX #: steps over the LDX)
F294                          ENDIF      
F294   AE C4        H_CSTORE:   LDX   ,U   ; "." ( c addr -- )
F296                          IF   CHECKED   
                              BSR   chkst   
F296                          ENDIF      
F296   33 42                  LEAU   2,U   
F298   37 06                  PULU   D   
F29A   E7 84                  STB   ,X   
F29C   39                     RTS      
F29D                          IF   CHECKED   
                                 ; ---- reached from a handler ------------------------------------------------
                                 ; chkst: stop with O unless X is in the program's own space: from the letter
                                 ; page up to HEAPLIM, so the interpreter's stacks and whatever lies above the
                                 ; limit are safe. Memory above the heap top but below the limit is the
                                 ; program's own: Tiny BASIC keeps its lines there. Keeps every register.
                    CHKST:    CMPX   #LET   
                              BLO   cs9   
                              CMPX   #HEAPLIM*256   
                              BHS   cs9   
                              RTS      ; in range
                    CS9:      LDA   #"O"   
                              FCB   8Ch   
                    E_ZERO:   LDA   #"Z"   ; / by zero
                              FCB   8Ch   
                    E_QUOTE:   LDA   #"Q"   ; " or $ ran into the NUL
                                 ; and fall into error. (H, W and N have their own entries, near
                                 ; their handlers, at ejmp.)
                                 ; =============================================================================
                                 ;  Checked build: the error report. A = the letter, AT = the place; U is
                                 ;  as the program left it, and SSAV holds S as the failing character began
                                 ;  (see "the error entries" after `upper`).
                                 ;  It sits here, ahead of h_num, pdec and putc, so that it reaches them with
                                 ;  short calls. Prints
                                 ; 
                                 ;     CR LF
                                 ;     Err X @ line,col CR LF
                                 ;     <up to 16 raw characters from the place, ending early at CR, LF, NUL>
                                 ;     CR LF
                                 ;     Stk n:[ ...][ v]*  CR LF     (the top 8 cells, bottom to top, signed)
                                 ;     Rtn n CR LF
                                 ; 
                                 ;  and goes to EXIT. Line and column count from 1: the line is one more
                                 ;  than the LFs between PROG and the place, the column the distance from the
                                 ;  last LF (or from PROG-1). A place below PROG is in the -n? line buffer:
                                 ;  line 0, column = its offset there + 1. Numbers other than the cells are
                                 ;  printed unsigned (pdec), the cells signed (h_num).
                                 ; 
                                 ;  The data stack may be one cell past its limit (S, U = 80FEh): the
                                 ;  report's own cells then reach 8 bytes further down, to 80F6h, into the
                                 ;  return stack page, so the report runs on a fresh return stack at RSREP
                                 ;  (80F0h), below those bytes.
                                 ; =============================================================================
                    ERROR:    LDS   #RSREP   
                              TFR   A,B   ; the letter (pmsg and CONOUT keep B)
                              BSR   pmsg   
                              FCB   13,10,"Err"," "+80h   
                              TFR   B,A   
                              JSR   CONOUT   
                              BSR   pmsg   
                              FCB   " @"," "+80h   
                                 ; the place: Y counts the lines, X walks, the cell at ,U holds the
                                 ; address of the last LF (PROG-1 to begin with)
                              LDY   #0   
                              LDX   #LINEBUF-1   
                              PSHU   X   
                              LDX   #PROG-1   
                              CMPX   <AT   
                              BHS   lc3   ; the place is below PROG: line 0
                              STX   ,U   
                    LC1:      LEAY   1,Y   ; a line
                    LC2:      LEAX   1,X   
                              CMPX   <AT   
                              BHS   lc3   
                              LDA   ,X   
                              CMPA   #10   
                              BNE   lc2   
                              STX   ,U   
                              BRA   lc1   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                                 ; (It sits here, in the middle of the report, where all its calls reach.)
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              JSR   putc   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
                    LC3:      LDD   <AT   
                              SUBD   ,U   
                              STD   ,U   ; the column
                              PSHU   Y   
                              JSR   pdec   ; the line
                              BSR   pmsg   
                              FCB   ","+80h   
                              BSR   pdec   ; the column
                              BSR   pmsg   
                              FCB   13,10+80h   
                                 ; the text at the place
                              LDX   <AT   
                              LDB   #16   
                    TX1:      LDA   ,X+   
                              BEQ   tx9   
                              CMPA   #10   
                              BEQ   tx9   
                              CMPA   #13   
                              BEQ   tx9   
                              BSR   putc   
                              DECB      
                              BNE   tx1   
                    TX9:      BSR   pmsg   
                              FCB   13,10,"Stk"," "+80h   
                                 ; the data stack: its depth, then its top 8 cells, from Y down to
                                 ; the program's top cell, at ,U.
                              PSHS   U   ; where the walk ends
                              LDD   #DSTOP   
                              SUBD   ,S   
                              BSR   pdh   ; the depth (pdec leaves U as it was)
                              BSR   pmsg   
                              FCB   ":"+80h   
                              LEAY   16,U   ; past the 8th cell from the top ...
                              CMPY   #DSTOP   
                              BHS   sl1   
                              BSR   pmsg   ; (there are more than 8)
                              FCB   " ..","."+80h   
                              BRA   sl2   
                    SL1:      LDY   #DSTOP   ; ... or the whole stack, if no more than 8
                    SL2:      CMPY   ,S   
                              BLS   sl9   
                              LDD   ,--Y   
                              PSHU   D   
                              BSR   pmsg   
                              FCB   " "+80h   
                              BSR   h_num   
                              BRA   sl2   
                    SL9:      BSR   pmsg   
                              FCB   13,10,"Rtn"," "+80h   
                              LDD   #RSTOP   ; the return stack's depth, (RSTOP - S) / 2,
                              SUBD   <SSAV   ;   S as it was when this character began
                              BSR   pdh   
                              JSR   pmsg   
                              FCB   13,10+80h   
                              JMP   EXIT   
                                 ; pdh: print D/2 (a depth: D is twice it), unsigned.
                    PDH:      LSRA      
                              RORB      
                              PSHU   D   
                              BRA   pdec   
F29D                          ENDIF      
F29D                             ; "#" prints TOS as a signed decimal number, with no space after it.
F29D   6D C4        H_NUM:    TST   ,U   
F29F   2A 06                  BPL   pdec   
F2A1   86 2D                  LDA   #"-"   
F2A3   8D 1A                  BSR   putc   
F2A5   8D 58                  BSR   negt   
F2A7                             ; pdec: print the top cell as unsigned and drop it, by recursion on /10
F2A7   CC 00 0A     PDEC:     LDD   #10   
F2AA   36 06                  PSHU   D   
F2AC   8D 62                  BSR   udiv   ; NOS = quotient, TOS = digit
F2AE   37 06                  PULU   D   ; the digit
F2B0   34 04                  PSHS   B   
F2B2   EC C4                  LDD   ,U   
F2B4   27 03                  BEQ   pd1   
F2B6   8D EF                  BSR   pdec   ; (it drops the quotient)
F2B8   8C                     FCB   8Ch   ; (CMPX #: steps over the LEAU)
F2B9   33 42        PD1:      LEAU   2,U   ; drop the zero quotient
F2BB   35 02                  PULS   A   
F2BD   8B 30                  ADDA   #"0"   ; and fall into putc
F2BF   7E FF 03     PUTC:     JMP   CONOUT   
F2C2                             ; ---- more arithmetic ---------------------------------------------------------
F2C2   EC C1        H_AND:    LDD   ,U++   
F2C4   A4 C4                  ANDA   ,U   
F2C6   E4 41                  ANDB   1,U   
F2C8   20 04                  BRA   st   
F2CA   EC C1        H_ADD:    LDD   ,U++   
F2CC   E3 C4                  ADDD   ,U   
F2CE   ED C4        ST:       STD   ,U   
F2D0   39                     RTS      
F2D1                             ; "-" has two jobs: directly before a digit it starts a negative number.
F2D1   BD F0 7D     H_SUB:    JSR   isdig   
F2D4   25 26                  BLO   negnum   
F2D6   EC 42                  LDD   2,U   
F2D8   A3 C1                  SUBD   ,U++   
F2DA   20 F2                  BRA   st   
F2DC                             ; ---- the tail ---------------------------------------------------------------
F2DC                             ; "/" is the last handler, so what follows its first byte may lie past the
F2DC                             ; second range: the divide itself and the routines after it.
F2DC                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
F2DC                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F2DC                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
F2DC                             ; it stops with Z, both operands still on the stack.
F2DC                H_DIV:       
F2DC                          IF   CHECKED   
                              LDD   ,U   
                              LBEQ   e_zero   
F2DC                          ENDIF      
F2DC   A6 42                  LDA   2,U   
F2DE   34 02                  PSHS   A   ; a's sign: for r
F2E0   A8 C4                  EORA   ,U   
F2E2   34 02                  PSHS   A   ; a xor b: for q
F2E4   30 42                  LEAX   2,U   
F2E6   8D 22                  BSR   absx   ; |a|
F2E8   1F 31                  TFR   U,X   
F2EA   8D 1E                  BSR   absx   ; |b|
F2EC   8D 22                  BSR   udiv   ; NOS = q, TOS = r
F2EE   30 42                  LEAX   2,U   
F2F0   6D E0                  TST   ,S+   
F2F2   2A 02                  BPL   dv1   
F2F4   8D 0B                  BSR   negx   ; q's sign
F2F6   6D E0        DV1:      TST   ,S+   
F2F8   2A 0F                  BPL   ng9   
F2FA   20 03                  BRA   negt   ; r's sign
F2FC   BD F0 84     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F2FF   1F 31        NEGT:     TFR   U,X   
F301   EC 84        NEGX:     LDD   ,X   ; negx: negate the cell at X
F303   40                     NEGA      
F304   50                     NEGB      
F305   82 00                  SBCA   #0   
F307   ED 84                  STD   ,X   
F309   39           NG9:      RTS      
F30A   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F30C   2A FB                  BPL   ng9   
F30E   20 F1                  BRA   negx   
F310                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F310                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F310                             ; the TOS cell the remainder. The remainder is built in D (always < the
F310                             ; divisor, so 2R+1 fits in 16 bits).
F310                             ; Dividing by 2 is one shift (the spec wants that fast).
F310   EC C4        UDIV:     LDD   ,U   
F312   83 00 02               SUBD   #2   
F315   26 07                  BNE   ud0   
F317   64 42                  LSR   2,U   
F319   66 43                  ROR   3,U   ; the quotient
F31B   59                     ROLB      ; the remainder: the bit that fell out (D was 0)
F31C   20 18                  BRA   ud3   
F31E   8E 00 10     UD0:      LDX   #16   
F321   4F                     CLRA      
F322   5F                     CLRB      
F323   68 43        UD1:      ASL   3,U   
F325   69 42                  ROL   2,U   ; the dividend's top bit ...
F327   59                     ROLB      
F328   49                     ROLA      ; ... into the remainder
F329   10 A3 C4               CMPD   ,U   
F32C   25 04                  BLO   ud2   
F32E   A3 C4                  SUBD   ,U   
F330   6C 43                  INC   3,U   ; a quotient bit
F332   30 1F        UD2:      LEAX   -1,X   
F334   26 ED                  BNE   ud1   
F336   ED C4        UD3:      STD   ,U   
F338   39                     RTS      
F339                IMGEND:      


