  1480 000007DB FEC8                <1>         dec     al                      ; 'D'?
  1481 000007DD 7534                <1>         jne     ed1                     ; no: on into left
  1482                              <1> ; ^B, left arrow: the cursor goes one to the left
  1483 000007DF 80FB80              <1> left:   cmp     bl,80h
