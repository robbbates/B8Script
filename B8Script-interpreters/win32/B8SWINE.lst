  1721                              <1> 
  1722                              <1> ; =============================================================================
  1723                              <1> ;  The letters and digits, the return stack's push, and the inner loop
  1724                              <1> ; =============================================================================
  1725                              <1> 
  1726                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
  1727                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
  1728 00000978 89F2                <1> upper:  mov     edx,esi
  1729 0000097A 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
  1730                              <1> 
  1731                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
  1732                              <1> ; return stack ends here, and the true ')' comes to rpoll.
  1733                              <1> ;
  1734                              <1> ; The break key is looked at here, so at every word call and loop-back (and
  1735                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
  1736 00000982 83EF04              <1> rpush:  sub     edi,4
  1737 00000985 8917                <1>         mov     [edi],edx
  1738 00000987 FE4D60              <1> rpoll:  dec     byte [V(v_pcnt)]
  1739 0000098A 7505                <1>         jnz     .rp1
  1740 0000098C E852FAFFFF          <1>         call    pollk
  1741 00000991 FFE5                <1> .rp1:   jmp     ebp
  1742                              <1> 
  1743                              <1> ; =============================================================================
  1744                              <1> ;  The inner loop: read one character and sort it by range.
  1745                              <1> ;
  1746                              <1> ;    00h          end of program
  1747                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1748                              <1> ;                 build stops on 80h-FFh: X)
  1749                              <1> ;    30h-39h      digit: read a whole number
  1750                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1751                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1752                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1753                              <1> ; =============================================================================
  1754                              <1> ; Digits: step back onto the first digit and read the whole number.
  1755 00000993 53                  <1> digit:  push    ebx
  1756 00000994 4E                  <1>         dec     esi
  1757 00000995 E810F9FFFF          <1>         call    rdnum
  1758 0000099A FFE5                <1>         jmp     ebp
  1759                              <1> 
  1760                              <1> ; a-z: push the cell's address (the cell is the variable).
  1761 0000099C 53                  <1> lower:  push    ebx
  1762 0000099D 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1763 000009A4 FFE5                <1>         jmp     ebp
  1764                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1765                              <1> ; next in reach)
  1766 000009A6 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1767 000009A8 7505                <1>         jnz     next                    ; the rest are ignored
  1768 000009AA E96FFAFFFF          <1>         jmp     endprog
  1769                              <1> %if CHECKED
  1770                              <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1771                              <1>         jmp     error
  1772                              <1> %endif
  1773                              <1> next:
  1774                              <1> %if CHECKED
  1775                              <1>         call    chkstk                  ; both stacks, once per character
  1776                              <1> %endif
  1777 000009AF 31C0                <1>         xor     eax,eax
  1778 000009B1 AC                  <1>         lodsb
  1779 000009B2 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1780 000009B4 72F0                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1781 000009B6 3C0F                <1>         cmp     al,0Fh
  1782 000009B8 7222                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1783 000009BA 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1784 000009BC 3C0A                <1>         cmp     al,0Ah
  1785 000009BE 72D3                <1>         jb      digit                   ; 30h-39h
  1786 000009C0 3C11                <1>         cmp     al,11h
  1787 000009C2 7216                <1>         jb      p3a                     ; 3Ah-40h
  1788 000009C4 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1789 000009C6 3C1A                <1>         cmp     al,1Ah
  1790 000009C8 72AE                <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1791 000009CA 3C20                <1>         cmp     al,20h
  1792 000009CC 720A                <1>         jb      p5b                     ; 5Bh-60h
  1793 000009CE 3C3A                <1>         cmp     al,3Ah
  1794 000009D0 72CA                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1795 000009D2 3C3E                <1>         cmp     al,3Eh
  1796                              <1> %if CHECKED
  1797                              <1>         je      next                    ; 7Fh, DEL: ignored
  1798                              <1>         jae     e_hi                    ; 80h-FFh: reserved
  1799                              <1> %else
  1800 000009D4 73D9                <1>         jae     next                    ; 7Fh-FFh: ignored
  1801                              <1> %endif
  1802 000009D6 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1803 000009D8 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1804 000009DA 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1805 000009DC 8A80[0E080000]      <1> punct:  mov     al,[ptab+eax]
  1806 000009E2 8D80[DF000000]      <1>         lea     eax,[hbase+eax]
  1807 000009E8 FFE0                <1>         jmp     eax
