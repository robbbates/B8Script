E9D6                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E9D6                             ; the carry is clear. Each returns into the loop.
E9D6                             ;    /a-/z   print the variable, as "#" does
E9D6                             ;    /{      clear the screen, the cursor to the top left
E9D6                             ;    /}      clear from the cursor to the end of the line
E9D6                             ;    /|  /`  show the cursor, hide it
E9D6                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E9D6                             ;            from 0. The two cells under the string's address go.
E9D6                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E9D6                             ; E6h-FFh with it clear.
E9D6                          IF   1-ANSI   
E9D6                             ; With ANSI = 0 the machine's routines do the work.
E9D6   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E9D8   90 0D                  BCC   pe1   
E9DA   F0 08                  BEQ   pcls   ; {
E9DC   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E9DD   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E9DF   B0 26                  BCS   pat   ; ~
E9E1   4C 0F FF               JMP   CONEOL   ; }
E9E4   4C 0C FF     PCLS:     JMP   CONCLS   
E9E7   C9 E6        PE1:      CMP   #0E6h   
E9E9   B0 03                  BCS   pvar   
E9EB   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E9EE                          ENDIF      
E9EE                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E9EE                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' prints
E9EE                             ; it and drops it: TOS is the string's address again.
E9EE   69 39        PVAR:     ADC   #39h   
E9F0   20 03 EB               JSR   lowp   
E9F3   20 6E E4               JSR   h_fetch   
E9F6   4C 9B E2               JMP   h_num   
E9F9                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into.
                    PESC:     LDY   #M_CLS-MSG   
                              SBC   #7Ah   ; (the carry is clear: - 7Bh)
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E9F9                          ENDIF      
E9F9                          IF   CHECKED+ANSI   
E9F9                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E9F9                             ; past it, at the next message.
E9F9   B9 26 EC     PRS:      LDA   MSG,Y   
E9FC   48                     PHA      
E9FD   29 7F                  AND   #7Fh   
E9FF   20 03 FF               JSR   CONOUT   
EA02   C8                     INY      
EA03   68                     PLA      
EA04   10 F3                  BPL   prs   
EA06   60                     RTS      
EA07                          ENDIF      
EA07                             ; /~: the row is at 4,X, the column at 2,X, the string's address at 0,X.
EA07                PAT:         
EA07                          IF   CHECKED   
EA07   E0 EB                  CPX   #DSE-5   ; fewer than two cells under TOS: s
EA09   B0 35                  BCS   e_sund   
EA0B                          ENDIF      
EA0B                          IF   1-ANSI   
EA0B   B5 04                  LDA   4,X   ; the row
EA0D   B4 02                  LDY   2,X   ; the column
EA0F   20 15 FF               JSR   CONAT   
EA12   20 15 EA               JSR   nip   ; two nips leave the address, 4 bytes up
EA15   20 D6 E2     NIP:      JSR   h_swap   ; nip: ( a b -- b )
EA18   4C 35 E3               JMP   drop   
EA1B                          ENDIF      
EA1B                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). Three swaps put the row on top
                                 ; and the address under the column: "#" prints the row and drops it, prints
                                 ; the column and drops it, and TOS is the string's address again.
                              JSR   h_swap   
                              INX      
                              INX      
                              JSR   h_swap   
                              DEX      
                              DEX      
                              JSR   h_swap   
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
EA1B                          ENDIF      
EA1B                          IF   CHECKED   
EA1B                             ; The checked build's inner loop, out of page 1, where it would not fit,
EA1B                             ; and its break check (described with the unchecked one in page 1).
EA1B                             ; pnext: the break check, then (falling through) next. A word call, a true
EA1B                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
EA1B                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
EA1B                             ; falls in here too, which does no harm.)
EA1B   CE 79 04     PNEXT:    DEC   CDOWN   
EA1E   D0 0B                  BNE   next   
EA20   20 06 FF     PKEY:     JSR   KEY   
EA23   F0 06                  BEQ   next   ; no key
EA25   8D 7A 04               STA   KEYBUF   ; held for the next "?"
EA28   20 68 EA               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
EA2B                NEXT:        
EA2B                          ENDIF      
EA2B                          IF   CHECKED*FAST   
EA2B   4C 91 EC               JMP   fnext   ; (the fast build: see "The fast build")
EA2E                          ENDIF      
EA2E                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE (an
                                 ; underflow) or below DSFULL (an overflow). No handler moves X by
                                 ; more than 4 (but "$", whose /~ escapes each look first), so X is
                                 ; caught before it wraps; an overrun by a cell or two writes on the
                                 ; scratch bytes below or above the stack.
                                 ; S is kept in RSV, for the report's R: line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_sund   
                              CPX   #DSFULL   
                              BCC   e_sovr   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
                              JSR   step   
                              JMP   next   
EA2E                          ENDIF      
EA2E                          IF   CHECKED   
EA2E                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
EA2E                             ; empty.
EA2E   AD 35 04     E_RSTACK:   LDA   RSV   
EA31   C9 10                  CMP   #10h   
EA33   A9 52                  LDA   #"R"   
EA35   B0 10                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
EA37   A9 FF                  LDA   #0FFh   
EA39   8D 35 04               STA   RSV   ; S wrapped to 01h: R:0
EA3C   A9 72                  LDA   #"r"   
EA3E   D0 07                  BNE   ejmp   ; always
EA40   A2 F0        E_SUND:   LDX   #DSE   ; D:0
EA42   A9 73                  LDA   #"s"   
EA44   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
EA45   A9 53        E_SOVR:   LDA   #"S"   
EA47   4C 9A EB     EJMP:     JMP   error   
EA4A                             ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
EA4A                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
EA4A                             ; which takes either. Meeting the wrong closer at this level, or the end
EA4A                             ; (a NUL, or a string that runs into it), stops with N, except for \,
EA4A                             ; which then ends the program as before.
EA4A                          ENDIF      
EA4A                          IF   CHECKED*(1-QK)   
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
EA4A                          ENDIF      
EA4A                          IF   CHECKED   
EA4A   A5 04        SKNUL:    LDA   T0   
EA4C   D0 03                  BNE   e_nest   ; ( and [ stop with N
EA4E   4C 09 FF               JMP   EXIT   ; \ ends the program
EA51   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
EA53   4C 9A EB               JMP   error   ;   or the end: the place is the opener
EA56                          ENDIF      
EA56                          IF   1-CHECKED   
                    CBREAK:   EQU   endp   ; the unchecked build stops without a word
EA56                          ENDIF      
EA56                          IF   CHECKED   
EA56                CBREAK:   EQU   e_break   ; the checked build reports B
EA56                          ENDIF      
EA56                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
EA56                             ; set when there is none. Keeps X and Y. The held key goes first, and is
EA56                             ; taken out of KEYBUF.
EA56   AD 7A 04     GETK:     LDA   KEYBUF   
EA59   F0 08                  BEQ   gk1   
EA5B   48                     PHA      
EA5C   A9 00                  LDA   #0   
EA5E   8D 7A 04               STA   KEYBUF   
EA61   68                     PLA      
EA62   60                     RTS      
EA63   20 06 FF     GK1:      JSR   KEY   
EA66   F0 04                  BEQ   gk9   
EA68                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
EA68                             ; back if it comes back at all.
EA68   C9 03        CHK3:     CMP   #3   
EA6A   F0 01                  BEQ   ctlc   
EA6C   60           GK9:      RTS      
EA6D                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
EA6D                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
EA6D                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
EA6D                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
EA6D                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
EA6D   AD 7B 04     CTLC:     LDA   BRKOFF   
EA70   F0 1D                  BEQ   cbreak   
EA72   A9 28                  LDA   #CWAIT+1   
EA74   85 05                  STA   T1   
EA76   20 06 FF     CT2:      JSR   KEY   
EA79   D0 0A                  BNE   ct3   
EA7B   C6 06                  DEC   T2   
EA7D   D0 F7                  BNE   ct2   
EA7F   C6 05                  DEC   T1   
EA81   D0 F3                  BNE   ct2   
EA83   F0 07                  BEQ   ct9   ; always: none came
EA85   C9 03        CT3:      CMP   #3   
EA87   F0 06                  BEQ   cbreak   
EA89   8D 7A 04               STA   KEYBUF   
EA8C   A9 03        CT9:      LDA   #3   
EA8E   60                     RTS      
EA8F                          IF   CHECKED   
EA8F   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
EA91   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
EA92   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
EA94   4C 9A EB     EJMP2:    JMP   error   
EA97                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
EA97                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
EA97                             ; the call reads a NUL with IP in page zero, where no program can be. The
EA97                             ; call is undone first: the step frame and the return address come off the
EA97                             ; hardware stack, and the place is the call letter (the return address - 1).
EA97   68           E_UNDEF:   PLA      
EA98   68                     PLA      ; the step frame
EA99   68                     PLA      
EA9A   38                     SEC      
EA9B   E9 01                  SBC   #1   
EA9D   85 08                  STA   PLACE   
EA9F   68                     PLA      
EAA0   E9 00                  SBC   #0   
EAA2   85 09                  STA   PLACE+1   
EAA4   EE 35 04               INC   RSV   
EAA7   EE 35 04               INC   RSV   ; R: does not count the call
EAAA   A9 55                  LDA   #"U"   
EAAC   D0 E6                  BNE   ejmp2   ; always
EAAE                          ENDIF      
EAAE                             ; step: read one character and sort it by range.
EAAE                             ;    00h          end of program
EAAE                             ;    01h-20h, 7Fh-FFh   ignored
EAAE                             ;    30h-39h      digit: read a whole number
EAAE                             ;    41h-5Ah      A-Z: call the word in that letter's cell
EAAE                             ;    61h-7Ah      a-z: push the address of that letter's cell
EAAE                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
EAAE   20 80 EB     STEP:     JSR   getc   ; flags follow A
EAB1   F0 3D                  BEQ   endp   
EAB3   38                     SEC      
EAB4   E9 21                  SBC   #21h   ; A = c - 21h
EAB6   90 37                  BCC   ign   ; 01h-20h
EAB8   C9 0F                  CMP   #0Fh   
EABA   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
EABC   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
EABE   C9 0A                  CMP   #10   
EAC0   90 72                  BCC   digit   
EAC2   C9 11                  CMP   #11h   
EAC4   90 18                  BCC   p3a   ; 3Ah-40h
EAC6   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
EAC8   C9 1A                  CMP   #1Ah   
EACA   90 2B                  BCC   upper   ; 41h-5Ah
EACC   C9 20                  CMP   #20h   
EACE   90 0C                  BCC   p5b   ; 5Bh-60h
EAD0   C9 3A                  CMP   #3Ah   
EAD2   90 2F                  BCC   lower   ; 61h-7Ah: A = 20h-39h
EAD4   C9 3E                  CMP   #3Eh   
EAD6                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
EAD6                          ENDIF      
EAD6                          IF   CHECKED   
EAD6   F0 17                  BEQ   ign   ; 7Fh
EAD8   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
EADA                          ENDIF      
EADA                             ; The three adjustments below chain. Each ADC adds the carry the one
EADA                             ; before it left, which the constants allow for.
EADA   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
EADC   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
EADE   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
EAE0                             ; Punctuation: A = the index. The handler's page is the first, plus one if
EAE0                             ; the index is N1 or more, plus one more if it is N2 or more.
EAE0   C9 08        PUNCT:    CMP   #N1   
EAE2   A8                     TAY      
EAE3   A9 70                  LDA   #HALFPG   
EAE5   2A                     ROL      ; the first page, or the second (carry clear)
EAE6   C0 15                  CPY   #N2   
EAE8   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
EAEA   48                     PHA      
EAEB   B9 14 EB               LDA   PTAB,Y   
EAEE   48                     PHA      
EAEF   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
EAF0                             ; directly, it just ends an ignored character.
EAF0                ENDP:        ; the program has ended
EAF0                          IF   CHECKED   
EAF0   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
EAF2   F0 A3                  BEQ   e_undef   
EAF4                          ENDIF      
EAF4   4C 09 FF               JMP   EXIT   
EAF7                             ; A-Z: call the word. The return address (the IP after the letter) goes on
EAF7                             ; the return stack, and the IP becomes the address in the letter's cell.
EAF7   0A           UPPER:    ASL      
EAF8   A8                     TAY      
EAF9   38                     SEC      
EAFA   4C F7 E2               JMP   pushn   
EAFD   A5 00        PUSHIP:   LDA   IP   ; push the reading position
EAFF   A4 01                  LDY   IP+1   
EB01   D0 03                  BNE   pushay   ; always: no program is in page zero
EB03                             ; a-z: push the cell's address (the cell is the variable)
EB03                             ;  (the unchecked QK builds do x@ and x! in one step: lowq)
EB03                          IF   SBASEU   
                    LOWER:    JMP   lowq   
                    LOWP:        
EB03                          ENDIF      
EB03                          IF   1-SBASEU   
EB03                LOWER:       
EB03                LOWP:        
EB03                          ENDIF      
EB03   0A                     ASL      
EB04   A0 04                  LDY   #>LET   
EB06                             ; pushay: push a cell: A = its low byte, Y = its high byte
EB06   CA           PUSHAY:   DEX      
EB07   CA                     DEX      
EB08   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
EB0A   94 01                  STY   1,X   
EB0C   60                     RTS      
EB0D                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
EB0D   E8           FLAG:     INX      
EB0E   E8                     INX      
EB0F   B5 FE                  LDA   0FEh,X   
EB11   15 FF                  ORA   0FFh,X   
EB13   60                     RTS      
EB14                             ; =============================================================================
EB14                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
EB14                             ;  character, in code order.
EB14                             ; =============================================================================
EB14   C6           PTAB:     DB   (h_store-1) & 0FFh   ; !
EB15   74                     DB   (h_str-1) & 0FFh   ; "
EB16   9A                     DB   (h_num-1) & 0FFh   ; #
EB17   48                     DB   (h_print-1) & 0FFh   ; $
EB18   D5                     DB   (h_swap-1) & 0FFh   ; %
EB19   E6                     DB   (h_and-1) & 0FFh   ; &
EB1A   92                     DB   (h_emit-1) & 0FFh   ; '
EB1B   F1                     DB   (h_open-1) & 0FFh   ; (
EB1C   B0                     DB   (h_close-1) & 0FFh   ; )
EB1D   76                     DB   (h_mul-1) & 0FFh   ; *
EB1E   40                     DB   (h_add-1) & 0FFh   ; +
EB1F   A7                     DB   (h_cfetch-1) & 0FFh   ; ,
EB20   37                     DB   (h_sub-1) & 0FFh   ; -
EB21   2B                     DB   (h_cstore-1) & 0FFh   ; .
EB22   7E                     DB   (h_div-1) & 0FFh   ; /
EB23   24                     DB   (h_dup-1) & 0FFh   ; :
EB24   34                     DB   (drop-1) & 0FFh   ; ;
EB25   55                     DB   (h_lt-1) & 0FFh   ; <
EB26   66                     DB   (h_eq-1) & 0FFh   ; =
EB27   52                     DB   (h_gt-1) & 0FFh   ; >
EB28   B8                     DB   (h_key-1) & 0FFh   ; ?
EB29   6D                     DB   (h_fetch-1) & 0FFh   ; @
EB2A   92                     DB   (h_def-1) & 0FFh   ; [
EB2B   15                     DB   (h_break-1) & 0FFh   ; \
EB2C   29                     DB   (h_ret-1) & 0FFh   ; ]
EB2D   57                     DB   (h_xor-1) & 0FFh   ; ^
EB2E   E4                     DB   (h_alloc-1) & 0FFh   ; _
EB2F   B6                     DB   (h_grave-1) & 0FFh   ; `
EB30   3B                     DB   (h_tor-1) & 0FFh   ; {
EB31   62                     DB   (h_or-1) & 0FFh   ; |
EB32   47                     DB   (h_fromr-1) & 0FFh   ; }
EB33   54                     DB   (h_not-1) & 0FFh   ; ~
EB34                             ; Digits: the first one is in A; read the rest of the number.
EB34   A0 00        DIGIT:    LDY   #0   
EB36   20 06 EB               JSR   pushay   
EB39                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
EB39                             ; Returns with the carry set.
EB39   20 66 EB     RDNUM:    JSR   isdig   
EB3C   B0 4D                  BCS   ic9   ; (an RTS)
EB3E   20 83 EB               JSR   incip   ; (keeps A = the digit)
EB41   16 00                  ASL   0,X   
EB43   36 01                  ROL   1,X   ; x2
EB45   18                     CLC      
EB46   75 00                  ADC   0,X   
EB48   85 04                  STA   T0   
EB4A   B5 01                  LDA   1,X   
EB4C   69 00                  ADC   #0   
EB4E   A8                     TAY      ; Y:T0 = x2 + digit
EB4F   16 00                  ASL   0,X   
EB51   36 01                  ROL   1,X   
EB53   16 00                  ASL   0,X   
EB55   36 01                  ROL   1,X   ; x8
EB57   18                     CLC      
EB58   B5 00                  LDA   0,X   
EB5A   65 04                  ADC   T0   
EB5C   95 00                  STA   0,X   
EB5E   98                     TYA      
EB5F   75 01                  ADC   1,X   
EB61   95 01                  STA   1,X   ; x8 + x2 + digit
EB63   4C 39 EB               JMP   rdnum   
EB66                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
EB66                             ; digit. Y = 0.
EB66   20 8C EB     ISDIG:    JSR   peek   
EB69   38                     SEC      
EB6A   E9 30                  SBC   #"0"   
EB6C   C9 0A                  CMP   #10   
EB6E   60                     RTS      
EB6F                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
EB6F                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
EB6F   20 66 EB     RDHEX:    JSR   isdig   
EB72   90 0F                  BCC   incip   
EB74   29 DF                  AND   #0DFh   
EB76   E9 11                  SBC   #11h   ; (the carry is set)
EB78   C9 06                  CMP   #6   
EB7A   B0 0F                  BCS   ic9   
EB7C   69 0A                  ADC   #10   
EB7E   D0 03                  BNE   incip   ; always
EB80                             ; Reading the program
EB80                             ;    peek: A = the character at IP, IP unchanged, Y = 0
EB80                             ;    getc: the same, then IP moves on; flags follow A
EB80                             ;    incip: IP moves on; keeps A, the carry and Y
EB80   20 8C EB     GETC:     JSR   peek   
EB83   E6 00        INCIP:    INC   IP   
EB85   D0 02                  BNE   ic1   
EB87   E6 01                  INC   IP+1   
EB89   09 00        IC1:      ORA   #0   
EB8B   60           IC9:      RTS      
EB8C   A0 00        PEEK:     LDY   #0   
EB8E   B1 00                  LDA   (IP),Y   
EB90   60                     RTS      
EB91                             ; rstip: point IP at the start of the program
EB91   A9 00        RSTIP:    LDA   #<PROG   
EB93   85 00                  STA   IP   
EB95   A9 05                  LDA   #>PROG   
EB97   85 01                  STA   IP+1   
EB99   60                     RTS      
EB9A                          IF   CHECKED   
EB9A                             ; =============================================================================
EB9A                             ;  Checked build: the error report
EB9A                             ; =============================================================================
EB9A                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
EB9A                             ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
EB9A                             ; overflowed or underflowed hardware stack wraps inside its page, and only
EB9A                             ; its depth is shown.
EB9A                             ;   CR LF
EB9A                             ;   Err X @ line,col CR LF
EB9A                             ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
EB9A                             ;   R:n CR LF
EB9A                             ; The numbers go through "#" (prnum), which pushes them over the data stack
EB9A                             ; and pops them again, so the stack is shown as it was. With the stack full
EB9A                             ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
EB9A   48           ERROR:    PHA      ; the letter
EB9B   A5 08                  LDA   PLACE   
EB9D   85 02                  STA   P   
EB9F   A5 09                  LDA   PLACE+1   
EBA1   85 03                  STA   P+1   ; (CO is the report's scratch from here on)
EBA3   A0 00                  LDY   #M_ERR-MSG   
EBA5   20 F9 E9               JSR   prs   ; CR LF "Err "
EBA8   68                     PLA      
EBA9   20 03 FF               JSR   CONOUT   
EBAC   20 F9 E9               JSR   prs   ; " @ " (it follows M_ERR)
EBAF   20 3F EC               JSR   lcol   
EBB2   A5 0A                  LDA   LN   
EBB4   A4 0B                  LDY   LN+1   
EBB6   20 20 EC               JSR   prnum   ; the line
EBB9   A9 2C                  LDA   #","   
EBBB   20 03 FF               JSR   CONOUT   
EBBE   A5 08                  LDA   CO   
EBC0   A4 09                  LDY   CO+1   
EBC2   20 20 EC               JSR   prnum   ; the column
EBC5   A0 0B                  LDY   #M_STK-MSG   
EBC7   20 F9 E9               JSR   prs   ; CR LF "D:"
EBCA   8A                     TXA      
EBCB   49 FF                  EOR   #0FFh   
EBCD   38                     SEC      
EBCE   E9 0F                  SBC   #0FFh-DSE   
EBD0   4A                     LSR      ; the depth, (DSE - X) / 2
EBD1   48                     PHA      
EBD2   20 1E EC               JSR   prnum8   
EBD5   68                     PLA      
EBD6   A0 14                  LDY   #M_C-MSG   ; ":"
EBD8   C9 09                  CMP   #9   
EBDA   90 04                  BCC   er3   
EBDC   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
EBDE   A0 0F                  LDY   #M_CD-MSG   
EBE0   85 08        ER3:      STA   CO   ; CO = how many cells to show
EBE2   20 F9 E9               JSR   prs   
EBE5   A5 08        ER4:      LDA   CO   ; cells CO-1 down to 0, the top last: cell i
EBE7   F0 1F                  BEQ   er5   ;   from the top is at X+2i
EBE9   C6 08                  DEC   CO   
EBEB   A9 20                  LDA   #" "   
EBED   20 03 FF               JSR   CONOUT   
EBF0   A5 08                  LDA   CO   
EBF2   0A                     ASL      
EBF3   85 09                  STA   CO+1   
EBF5   8A                     TXA      
EBF6   65 09                  ADC   CO+1   ; (the carry is clear)
EBF8   A8                     TAY      
EBF9   B9 00 00               LDA   0,Y   
EBFC   48                     PHA      
EBFD   B9 01 00               LDA   1,Y   
EC00   A8                     TAY      
EC01   68                     PLA      
EC02   20 20 EC               JSR   prnum   
EC05   4C E5 EB               JMP   er4   
EC08   A0 15        ER5:      LDY   #M_RTN-MSG   
EC0A   20 F9 E9               JSR   prs   ; CR LF "R:"
EC0D   AD 35 04               LDA   RSV   
EC10   49 FF                  EOR   #0FFh   
EC12   4A                     LSR      ; (FFh - S) / 2 entries
EC13   20 1E EC               JSR   prnum8   
EC16   A0 09                  LDY   #M_NL-MSG   
EC18   20 F9 E9               JSR   prs   
EC1B   4C 09 FF               JMP   EXIT   
EC1E                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
EC1E                             ; prnum8: the same for A alone, 0-255.
EC1E   A0 00        PRNUM8:   LDY   #0   
EC20   20 06 EB     PRNUM:    JSR   pushay   
EC23   4C 9B E2               JMP   h_num   
EC26                          ENDIF      
EC26                          IF   CHECKED+ANSI   
EC26                MSG:         
EC26                          ENDIF      
EC26                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
EC26                          ENDIF      
EC26                          IF   CHECKED   
EC26   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
EC2C   20 40 A0               DB   " @"," "+80h   
EC2F   0D 8A        M_NL:     DB   13,10+80h   
EC31   0D 0A 44 BA  M_STK:    DB   13,10,"D",":"+80h   
EC35   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
EC3A   BA           M_C:      DB   ":"+80h   
EC3B   0D 0A 52 BA  M_RTN:    DB   13,10,"R",":"+80h   
EC3F                          ENDIF      
EC3F                          IF   CHECKED   
EC3F                             ; lcol: the line (LN) and the column (CO) of the place at P, both from
EC3F                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
EC3F                             ; column is the place in the buffer. Otherwise IP (free now: the program has
EC3F                             ; stopped) runs from PROG to the place, counting LFs; CO keeps where the
EC3F                             ; last line started, and the column is the place minus that, plus 1.
EC3F   A9 00        LCOL:     LDA   #0   
EC41   85 0B                  STA   LN+1   
EC43   85 0A                  STA   LN   
EC45   A9 80                  LDA   #<LINEBUF   
EC47   85 08                  STA   CO   
EC49   A9 04                  LDA   #>LINEBUF   
EC4B   85 09                  STA   CO+1   
EC4D   A5 02                  LDA   P   
EC4F   C9 00                  CMP   #<PROG   
EC51   A5 03                  LDA   P+1   
EC53   E9 05                  SBC   #>PROG   
EC55   90 26                  BCC   lc9   ; below the program: line 0
EC57   E6 0A                  INC   LN   
EC59   20 91 EB               JSR   rstip   
EC5C   A5 00        LC3:      LDA   IP   ; a line starts here
EC5E   85 08                  STA   CO   
EC60   A5 01                  LDA   IP+1   
EC62   85 09                  STA   CO+1   
EC64   A5 00        LC1:      LDA   IP   
EC66   C5 02                  CMP   P   
EC68   A5 01                  LDA   IP+1   
EC6A   E5 03                  SBC   P+1   
EC6C   B0 0F                  BCS   lc9   ; at the place
EC6E   20 80 EB               JSR   getc   
EC71   C9 0A                  CMP   #10   
EC73   D0 EF                  BNE   lc1   
EC75   E6 0A                  INC   LN   ; an LF: a new line starts after it
EC77   D0 E3                  BNE   lc3   
EC79   E6 0B                  INC   LN+1   
EC7B   D0 DF                  BNE   lc3   ; always
EC7D   A5 02        LC9:      LDA   P   
EC7F   38                     SEC      
EC80   E5 08                  SBC   CO   
EC82   85 08                  STA   CO   
EC84   A5 03                  LDA   P+1   
EC86   E5 09                  SBC   CO+1   
EC88   85 09                  STA   CO+1   
EC8A   E6 08                  INC   CO   ; + 1
EC8C   D0 02                  BNE   lc8   
EC8E   E6 09                  INC   CO+1   
EC90   60           LC8:      RTS      
EC91                          ENDIF      
EC91                             ; =============================================================================
EC91                             ;  The fast build (SPEED = 2)
EC91                             ; 
EC91                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
EC91                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
EC91                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
EC91                             ;  so there is no JSR and no RTS per character:
EC91                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
EC91                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
EC91                             ;  The letters and digits have one entry each, which knows its cell or its
EC91                             ;  value already; the commonest punctuation is written for the table; the
EC91                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
EC91                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
EC91                             ;  and the clear carry they expect.
EC91                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
EC91                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
EC91                             ;  stacks first, as next does in the other builds.
EC91                             ;  Everything here is read-only: the image can be ROM, as the others are.
EC91                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
EC91                             ;  starts after it.
EC91                             ; =============================================================================
EC91                          IF   FAST   
EC91                             ; fnext: the dispatcher, after the checks of the checked build
EC91                FNEXT:       
EC91                          ENDIF      
EC91                          IF   FAST*CHECKED   
EC91                             ; (the same checks as next in the other checked builds)
EC91   8A                     TXA      ; TSX trashes X: keep it in A
EC92   BA                     TSX      
EC93   8E 35 04               STX   RSV   
EC96   E0 20                  CPX   #RSLIM   
EC98   AA                     TAX      
EC99   B0 03                  BCS   fn1   
EC9B   4C 2E EA               JMP   e_rstack   
EC9E   E0 F1        FN1:      CPX   #DSE+1   
ECA0   B0 07                  BCS   fn2   
ECA2   E0 10                  CPX   #DSFULL   
ECA4   B0 06                  BCS   fn3   
ECA6   4C 45 EA               JMP   e_sovr   
ECA9   4C 40 EA     FN2:      JMP   e_sund   
ECAC   A5 00        FN3:      LDA   IP   
ECAE   85 08                  STA   PLACE   
ECB0   A5 01                  LDA   IP+1   
ECB2   85 09                  STA   PLACE+1   
ECB4                          ENDIF      
ECB4                          IF   FAST   
ECB4   A0 00                  LDY   #0   
ECB6   B1 00                  LDA   (IP),Y   
ECB8   E6 00                  INC   IP   
ECBA   D0 02                  BNE   fn4   
ECBC   E6 01                  INC   IP+1   
ECBE   A8           FN4:      TAY      
ECBF   B9 00 E0               LDA   DTL,Y   
ECC2   85 04                  STA   V   
ECC4   B9 00 E1               LDA   DTH,Y   
ECC7   85 05                  STA   V+1   
ECC9   6C 04 00               JMP   (V)   
ECCC                             ; fpoll: the break check of pnext, as a subroutine, for the entries that
ECCC                             ; look at the keyboard (a word call, a true ( and a true ))
ECCC   20 06 FF     FPOLL:    JSR   KEY   
ECCF   F0 06                  BEQ   fp9   ; no key
ECD1   8D 7A 04               STA   KEYBUF   ; held for the next "?"
ECD4   4C 68 EA               JMP   chk3   ; (Ctrl-C: back only if the break key is off)
ECD7   60           FP9:      RTS      
ECD8                             ; The thunks: the rest of the punctuation, through the ordinary handlers
ECD8   18           FT_STR:   CLC      ; "
ECD9   20 75 E2               JSR   h_str   
ECDC   4C 91 EC               JMP   fnext   ; (rare enough: the shared dispatcher)
ECDF   18           FT_NUM:   CLC      ; #
ECE0   20 9B E2               JSR   h_num   
ECE3   4C 91 EC               JMP   fnext   ; (rare enough: the shared dispatcher)
ECE6   18           FT_PRT:   CLC      ; $
ECE7   20 49 E2               JSR   h_print   
ECEA   4C 91 EC               JMP   fnext   ; (rare enough: the shared dispatcher)
ECED   18           FT_EMIT:   CLC      ; '
ECEE   20 93 E2               JSR   h_emit   
ECF1   4C 91 EC               JMP   fnext   ; (rare enough: the shared dispatcher)
ECF4   18           FT_DIV:   CLC      ; /
ECF5   20 7F E3               JSR   h_div   
ECF8                          ;*Macro unroll:  NEXTF
ECF8                          DS   1-CHECKED,0A0h   
ECF8                          DS   1-CHECKED,0   
ECF8                          DS   1-CHECKED,0B1h   
ECF8                          DS   1-CHECKED,IP   
ECF8                          DS   1-CHECKED,0E6h   
ECF8                          DS   1-CHECKED,IP   
ECF8                          DS   1-CHECKED,0D0h   
ECF8                          DS   1-CHECKED,2   
ECF8                          DS   1-CHECKED,0E6h   
ECF8                          DS   1-CHECKED,IP+1   
ECF8                          DS   1-CHECKED,0A8h   
ECF8                          DS   1-CHECKED,0B9h   
ECF8                          DS   1-CHECKED,ADTL&0FFh   
ECF8                          DS   1-CHECKED,ADTL/256   
ECF8                          DS   1-CHECKED,85h   
ECF8                          DS   1-CHECKED,V   
ECF8                          DS   1-CHECKED,0B9h   
ECF8                          DS   1-CHECKED,ADTH&0FFh   
ECF8                          DS   1-CHECKED,ADTH/256   
ECF8                          DS   1-CHECKED,85h   
ECF8                          DS   1-CHECKED,V+1   
ECF8                          DS   1-CHECKED,6Ch   
ECF8                          DS   1-CHECKED,V   
ECF8                          DS   1-CHECKED,0   
ECF8   4C                     DS   CHECKED,4Ch   
ECF9   91                     DS   CHECKED,AFNX&0FFh   
ECFA   EC                     DS   CHECKED,AFNX/256   
ECFB   18           FT_KEY:   CLC      ; ?
ECFC   20 B9 E3               JSR   h_key   
ECFF   4C 91 EC               JMP   fnext   ; (rare enough: the shared dispatcher)
ED02   18           FT_DEF:   CLC      ; [
ED03   20 93 E4               JSR   h_def   
ED06                          ;*Macro unroll:  NEXTF
ED06                          DS   1-CHECKED,0A0h   
ED06                          DS   1-CHECKED,0   
ED06                          DS   1-CHECKED,0B1h   
ED06                          DS   1-CHECKED,IP   
ED06                          DS   1-CHECKED,0E6h   
ED06                          DS   1-CHECKED,IP   
ED06                          DS   1-CHECKED,0D0h   
ED06                          DS   1-CHECKED,2   
ED06                          DS   1-CHECKED,0E6h   
ED06                          DS   1-CHECKED,IP+1   
ED06                          DS   1-CHECKED,0A8h   
ED06                          DS   1-CHECKED,0B9h   
ED06                          DS   1-CHECKED,ADTL&0FFh   
ED06                          DS   1-CHECKED,ADTL/256   
ED06                          DS   1-CHECKED,85h   
ED06                          DS   1-CHECKED,V   
ED06                          DS   1-CHECKED,0B9h   
ED06                          DS   1-CHECKED,ADTH&0FFh   
ED06                          DS   1-CHECKED,ADTH/256   
ED06                          DS   1-CHECKED,85h   
