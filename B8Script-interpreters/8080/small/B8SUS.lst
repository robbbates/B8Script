0569                          IF   FAST   
                    FS_NUL:   JMP   endprog   ; NUL: the end of the program
                              ;*Macro unroll: fign:   NEXTD                   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
                    FIGN:     DS   FAST*CHECKED,0EBh   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
