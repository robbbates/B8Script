E38F   11 83 81 FC            CMPU   #DSTOP   ; "$" with nothing on the stack: s, before it
E393   10 22 FC 96            LBHI   e_ds   ;   prints from an address of no meaning (N
E397   10 9F 3C               STY   <PSAV   ;   is clear: an underflow)
E39A                          ENDIF      
