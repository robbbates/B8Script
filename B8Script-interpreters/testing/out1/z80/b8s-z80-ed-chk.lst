04A6   69                     LD   L,C   
04A7   29                     ADD   HL,HL   
04A8   39                     ADD   HL,SP   ; HL -> just above the deepest of them
04A9   0C                     INC   C   
04AA   0D           ER7:      DEC   C   
04AB   28 0F                  JR   Z,er8   
04AD   2B                     DEC   HL   
04AE   56                     LD   D,(HL)   
04AF   2B                     DEC   HL   
04B0   5E                     LD   E,(HL)   
04B1   E5                     PUSH   HL   
04B2   3E 20                  LD   A," "   
04B4   EF                     RST   28h   
04B5   EB                     EX   DE,HL   
04B6   CD 43 03               CALL   psgn   
04B9   E1                     POP   HL   
04BA   18 EE                  JR   er7   
04BC   CD 21 02     ER8:      CALL   pnl   
