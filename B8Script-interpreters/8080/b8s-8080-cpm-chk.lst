0733                          ENDIF      ;   checked build has cleared these)
0733                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0733                          ENDIF      
0733                          IF   1-CHECKED   
                              SHLD   KEYBUF   
0733                          ENDIF      
