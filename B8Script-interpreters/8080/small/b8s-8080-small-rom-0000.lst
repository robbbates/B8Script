02AA                          ENDIF      
02AA                             ; psgn: print HL as a signed number. Uses BC.
02AA   7C           PSGN:     MOV   A,H   
02AB   B7                     ORA   A   
02AC   F2 B3 02               JP   pdec   
02AF   3E 2D                  MVI   A,"-"   
02B1                          ;*Macro unroll:  PUTA
02B1   EF                     DS   1-CPM,0EFh   
02B2                          DS   CPM,0CDh   
02B2                          DS   CPM,APUT&0FFh   
02B2                          DS   CPM,APUT/256   
02B2                          ;*Macro unroll:  NEGH
02B2   E7                     DS   1-CPM,0E7h   
02B3                          DS   CPM,0CDh   
02B3                          DS   CPM,ANEG&0FFh   
02B3                          DS   CPM,ANEG/256   
02B3                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02B3                             ; Uses BC.
02B3   11 0A 00     PDEC:     LXI   D,10   
02B6   CD 78 02               CALL   udiv   ; HL = HL / 10, C = the last digit
02B9   79                     MOV   A,C   
02BA   F5                     PUSH   PSW   
02BB   7C                     MOV   A,H   
02BC   B5                     ORA   L   
02BD   C4 B3 02               CNZ   pdec   
02C0   F1                     POP   PSW   
02C1   C6 30                  ADI   "0"   
02C3                          ;*Macro unroll:  PUTA
02C3   EF                     DS   1-CPM,0EFh   
02C4                          DS   CPM,0CDh   
02C4                          DS   CPM,APUT&0FFh   
02C4                          DS   CPM,APUT/256   
02C4   C9                     RET      
02C5                             ; (The table goes here instead in the builds where, before the routines, it
02C5                             ; would cross a page: PTLATE. If it would cross one here too, it starts on
02C5                             ; the next page: PTPAD is 0 unless it must.)
02C5                          IF   (1-FAST)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02C5                          ENDIF      
02C5                          IF   1-CHECKED   
                                 ; "$" prints the string at TOS (see h_print).
                    PRLP:     MOV   A,M   
                              INX   H   
                              CPI   22h   
                              JZ   h_drop   
                              CPI   "/"   
                              JNZ   pr1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   pr0   
                              CPI   7Fh   
                              JC   pesc   
                    PR0:      ANI   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prlp   
02C5                          ENDIF      
02C5                             ;-----------------------------------------------------------------------------
02C5                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
02C5                             ; HL points past it. Each goes back into the loop that prints the string
02C5                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
02C5                             ;    /a-/z   print the variable, as "#" does
02C5                             ;    /{      clear the screen, the cursor to the top left
02C5                             ;    /}      clear from the cursor to the end of the line
02C5                             ;    /|  /`  show the cursor, hide it
02C5                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
02C5   FE 7E        PESC:     CPI   7Eh   
02C7   CA EA 02               JZ   pat   
02CA   11 DF 03               LXI   D,PRLOOP   ; the others return into the loop
02CD   D5                     PUSH   D   
02CE   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
02D0   D2 FC 02               JNC   pcon   
02D3   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
02D5   D2 05 03               JNC   phide   
02D8   87                     ADD   A   ; the variable's cell
02D9   C6 40                  ADI   40h   
02DB   E5                     PUSH   H   
02DC   C5                     PUSH   B   
02DD   6F                     MOV   L,A   
02DE   26 82                  MVI   H,LETPAGE   
02E0   7E                     MOV   A,M   
02E1   2C                     INR   L   
02E2   66                     MOV   H,M   
02E3   6F                     MOV   L,A   
02E4   CD AA 02               CALL   psgn   
02E7   C1                     POP   B   
02E8   E1                     POP   H   
02E9   C9                     RET      
02EA                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
02EA                             ; the checked build "$" is the routine prstr: its own return address goes
02EA                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
02EA                             ; its two cells are there, and is s if not, before it prints anything.
02EA                PAT:         
02EA                          IF   CHECKED   
02EA   E3                     XTHL      ; the text pointer over prstr's return address
02EB   21 0A 7E               LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
02EE   39                     DAD   SP   
02EF   DA 3A 04               JC   e_under   
02F2   E1                     POP   H   
02F3                          ENDIF      
02F3   D1                     POP   D   ; DE = the column
02F4   E3                     XTHL      ; HL = the row; the text pointer is kept
02F5                          IF   1-ANS   
02F5   CD 15 FF               CALL   CONAT   
02F8   E1                     POP   H   
02F9   C3 D0 01               JMP   PRAGAIN   
02FC                             ; With ANSI = 0 the machine's routines do the rest.
02FC   CA 0C FF     PCON:     JZ   CONCLS   ; /{
02FF   FE 02                  CPI   2   
0301   CA 0F FF               JZ   CONEOL   ; /}
0304   FE                     DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
0305   AF           PHIDE:    XRA   A   ; /`  (A = 0: hide)
0306   C3 12 FF               JMP   CONCUR   
0309                          ENDIF      
0309                          IF   ANS   
                              PUSH   B   ; (pdec uses BC)
                              PUSH   D   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INX   H   
                              CALL   pdec   
                              MVI   A,";"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   H   
                              INX   H   
                              CALL   pdec   
                              MVI   A,"H"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   B   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
                    PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
                              MVI   A,"?"   
                              CALL   csia   
                              MVI   A,"2"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"5"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DCR   A   
                              JZ   pshow   ; /|
                              MVI   A,"K"   
                              JP   csia   ; /}  ESC [ K
                              MVI   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              MVI   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
                    CSIA:     PUSH   PSW   
                              CALL   csi   
                              POP   PSW   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                    CSI:      MVI   A,27   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"["   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
0309                          ENDIF      
0309                             ; skip: read past text to the closer at this level, and return A = 0 if it
0309                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0309                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0309                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0309                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0309                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
0309                             ; 
0309                             ; The checked build also looks at the character the skip was started by,
0309                             ; which is always the one just before where it starts: "(" must end at ")",
0309                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0309                             ; quote counts as running into it. "\" takes either closer. The place where
0309                             ; the skip started is kept on the stack, for the report.
0309                          IF   1-QK   
0309                             ; (Without base: no skip cache.)
0309                SKIP:        
0309                          ENDIF      
0309                          IF   CHECKED*(1-QK)   
0309   C5                     PUSH   B   
030A   0B                     DCX   B   
030B   0A                     LDAX   B   
030C   03                     INX   B   
030D   5F                     MOV   E,A   ; E = the opener: ( [ or \
030E                          ENDIF      
030E                          IF   1-QK   
030E   16 00                  MVI   D,0   
0310   14           SK3:      INR   D   ; an opener: one deeper
0311   0A           SK1:      LDAX   B   
0312                          ENDIF      
0312                          IF   (1-CHECKED)*(1-QK)   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
0312                          ENDIF      
0312                          IF   CHECKED*(1-QK)   
0312   B7                     ORA   A   
0313   CA 41 03               JZ   sk6   ; (the IP stays on the NUL)
0316   03                     INX   B   
0317                          ENDIF      
0317                          IF   1-QK   
0317   FE 22                  CPI   22h   
0319   CC 4D 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
031C   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
031E   CA 10 03               JZ   sk3   
0321   3D                     DCR   A   ; ")"
0322   CA 2F 03               JZ   sk4   
0325   D6 32                  SUI   "["-")"   
0327   CA 10 03               JZ   sk3   
032A   FE 02                  CPI   "]"-"["   
032C   C2 11 03               JNZ   sk1   
032F   15           SK4:      DCR   D   
0330                          ENDIF      
0330                          IF   (1-CHECKED)*(1-QK)   
                              RZ      ; the closer at this level
                              JMP   sk1   
0330                          ENDIF      
0330                          IF   CHECKED*(1-QK)   
0330   C2 11 03               JNZ   sk1   
0333   57                     MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0334   AB                     XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
0335   E6 06                  ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
0337   FE 02                  CPI   2   ;   closer, and only then
0339   7A                     MOV   A,D   
033A   D1                     POP   D   ; (where the skip started)
033B   C0                     RNZ      
033C   42                     MOV   B,D   ; N. The place is the opener
033D   4B                     MOV   C,E   
033E   C3 48 03               JMP   sk7   
0341   7B           SK6:      MOV   A,E   ; the text ran out:
0342   E6 04                  ANI   4   
0344   C2 7F 00               JNZ   endprog   ;   "\" with no closer ends the program
0347   C1                     POP   B   
0348   3E 4E        SK7:      MVI   A,"N"   
034A   C3 69 04               JMP   errp   ; (errp drops skip's return address)
034D                          ENDIF      
034D                          IF   QK   
                                 ; The skip cache. Nearly every skip is one that has happened before (a loop
                                 ; skips the same false block on every pass), so the first scan from each
                                 ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
                                 ; by the start's low byte (times 4). Only skips that start in the program
                                 ; text are kept (the line buffer changes); the cache is emptied whenever a
                                 ; run starts (see start). A program that changes its own text while it
                                 ; runs is not looked after.
                    SKIP:     MOV   A,B   
                              CPI   PROG/256   
                              JC   sks   ; below the program text: no cache
                              MOV   A,C   
                              ADD   A   
                              ADD   A   
                              MOV   E,A   
                              MVI   D,CPAGE   ; DE -> the entry
                              LDAX   D   
                              CMP   C   
                              JNZ   sks   
                              INR   E   
                              LDAX   D   
                              CMP   B   
                              JNZ   sks   
                              INR   E   
                              LDAX   D   
                              MOV   C,A   
                              INR   E   
                              LDAX   D   
                              MOV   B,A   ; a hit: the IP is past the closer
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              SUI   ")"   ; 0 for ")", not 0 for "]"
                              RET      
                    SKS:      PUSH   B   ; where it starts: the cache's key (and the
034D                          ENDIF      ;   checked report's place)
034D                          IF   QK*CHECKED   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
034D                          ENDIF      
034D                          IF   QK   
                                 ; The scan. Most characters are nothing to it, and two range tests rule
                                 ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                              MVI   D,0   
                    SQ3:      INR   D   ; an opener: one deeper
                    SQ1:      LDAX   B   
                              INX   B   
                              CPI   5Eh   
                              JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CPI   5Bh   
                              JNC   sqb   ; [ \ ]
                              CPI   2Ah   
                              JNC   sq1   ; * to Z: nothing
                              CPI   28h   
                              JZ   sq3   ; (
                              JNC   sqc   ; )
                              CPI   22h   
                              JZ   sqq   ; a string
                              ORA   A   
                              JNZ   sq1   ; the rest below "(": nothing
034D                          ENDIF      
034D                          IF   QK*(1-CHECKED)   
                              JMP   endprog   ; NUL: the end of the program
034D                          ENDIF      
034D                          IF   QK*CHECKED   
                              DCX   B   ; NUL: the IP stays on it
                              MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SQ7:      MVI   A,"N"   ; N. The place is the opener
                              JMP   errp   ; (errp drops skip's return address)
034D                          ENDIF      
034D                          IF   QK   
                    SQQ:      CALL   skipstr   ; step over the string
                              JMP   sq1   
                    SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
                              JZ   sq1   ; "\" is nothing here
                              JC   sq3   ; [
                              MVI   A,2   ; ]
                              DB   0FEh   ; (CPI: steps over the XRA)
                    SQC:      XRA   A   ; )
                    SQ4:      DCR   D   
                              JNZ   sq1   
034D                          ENDIF      
034D                          IF   QK*CHECKED   
                              MOV   D,A   ; the closer at this level (as above): 2 here
                              XRA   E   ;   means the wrong closer
                              ANI   6   
                              CPI   2   
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              JNZ   sq8   
                              MOV   B,D   
                              MOV   C,E   
                              JMP   sq7   
                    SQ8:         
034D                          ENDIF      
034D                          IF   QK*(1-CHECKED)   
                              POP   D   ; where the skip started
034D                          ENDIF      
034D                          IF   QK   
                                 ; The closer at this level: remember the skip (if it started in the program
                                 ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
                              PUSH   H   
                              MOV   H,A   
                              MOV   A,D   
                              CPI   PROG/256   
                              JC   sq9   
                              MOV   A,E   
                              ADD   A   
                              ADD   A   
                              MOV   L,A   
                              MOV   A,H   
                              MVI   H,CPAGE   
                              MOV   M,E   
                              INR   L   
                              MOV   M,D   
                              INR   L   
                              MOV   M,C   
                              INR   L   
                              MOV   M,B   
                              POP   H   
                              RET      
                    SQ9:      MOV   A,H   
                              POP   H   
                              RET      
034D                          ENDIF      
034D                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
034D                             ; the next character, so "/"" does not end it. Leaves A = 22h.
034D                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
034D                          ENDIF      
034D                          IF   CHECKED   
034D                             ; The checked build never steps over a NUL: if the text runs out first it
034D                             ; returns A = 0 with the IP on the NUL.
034D   0A           SKIPSTR:   LDAX   B   
034E   B7                     ORA   A   
034F   C8                     RZ      
0350   03                     INX   B   
0351   FE 22                  CPI   22h   
0353   C8                     RZ      
0354   FE 2F                  CPI   "/"   
0356   C2 4D 03               JNZ   skipstr   
0359   0A                     LDAX   B   ; the escaped character
035A   B7                     ORA   A   
035B   C8                     RZ      
035C   03                     INX   B   
035D   C3 4D 03               JMP   skipstr   
0360                          ENDIF      
0360                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0360                             ; and return its value in A with the carry set; otherwise leave the IP and
0360                             ; return with the carry clear.
0360   0A           HEXC:     LDAX   B   
0361   D6 30                  SUI   "0"   
0363   FE 0A                  CPI   10   
0365   DA 71 03               JC   hc1   
0368   E6 DF                  ANI   0DFh   
036A   D6 11                  SUI   11h   
036C   FE 06                  CPI   6   
036E   D0                     RNC      
036F   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
0371   03           HC1:      INX   B   
0372   C9                     RET      
0373                             ;  ---- Speed-ups (base builds) -------------------------------------------
0373                             ;  The skip cache and "/" by a power of two are above. These are the
0373                             ;  handlers' tails that the builds with room take, kept here, out of the
0373                             ;  handlers' first two pages.
0373                          IF   QK   
                                 ; "*" with an operand below 256: that one becomes the multiplier, a byte in
                                 ; A, and the loop stops as soon as its bits are used up (most
                                 ; multiplications have one, a count or a small constant). With both at 256
                                 ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
                                 ; shifted in above it says when), and its high byte goes on as a small one.
                                 ; DE = NOS, HL = TOS.
                    MULQ:     MOV   A,H   
                              ORA   A   
                              JZ   mq8   ; the multiplier is below 256
                              MOV   A,D   
                              ORA   A   
                              JNZ   mq16   
                              XCHG      ; the multiplicand is: it becomes the multiplier
                    MQ8:      MOV   A,L   
                              LXI   H,0   
                              ORA   A   ; (clears the carry)
                              JZ   mq9   
                    MQ1:      RAR      ; the next bit
                              JNC   mq2   
                              DAD   D   
                    MQ2:      XCHG      
                              DAD   H   ; multiplicand << 1
                              XCHG      
                              ORA   A   ; bits left? (and clears the carry)
                              JNZ   mq1   
                              ;*Macro unroll: mq9:    NEXTQ
                    MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ANXT&0FFh   
                              DS   CPM*(1-FAST),ANXT/256   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    MQ16:     PUSH   B   
                              MOV   B,H   ; the high byte, for later
                              MOV   A,L   
                              LXI   H,0   
                              STC      ; the marker
                              RAR      
                    MQ3:      JNC   mq4   
                              DAD   D   
                    MQ4:      XCHG      
                              DAD   H   
                              XCHG      
                              CPI   1   ; only the marker left: 8 rounds done (and
                              RAR      ;   the carry was clear for the shift)
                              JNZ   mq3   
                              MOV   A,B   
                              POP   B   
                              ORA   A   
                              JMP   mq1   ; the high byte, as a small multiplier
                                 ; A true ")" reads the block start where it is, on top of the return stack,
                                 ; instead of popping it and pushing it back; the break key is looked at as
                                 ; rpushd would.
                    CLOSEQ:   LHLD   RSP   
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXTQ
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ANXT&0FFh   
                              DS   CPM*(1-FAST),ANXT/256   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0373                          ENDIF      
0373                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWER:    EQU   lowq   
                    LOWQ:     ADD   A   
                              MOV   E,A   
                              MVI   D,LETPAGE   ; DE -> the cell
                              LDAX   B   
                              CPI   "@"   
                              JZ   lwf   
                              CPI   "!"   
                              JZ   lws   
                              PUSH   H   
                              XCHG      ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWF:      INX   B   ; x@: TOS = the cell's value
                              PUSH   H   
                              XCHG      
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              XCHG      
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
                              XCHG      
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0373                          ENDIF      
0373                             ; =============================================================================
0373                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0373                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0373                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
0373                             ;  the host's KEY and CONOUT routines themselves.
0373                             ; 
0373                             ;  A running program reads the keyboard only through getk and pollk, which
0373                             ;  between them give the break key its rules:
0373                             ;    - Ctrl-C stops the program;
0373                             ;    - any other key that the break check reads is held in KEYBUF for the
0373                             ;      next "?", and a newer one takes its place;
0373                             ;    - "?" (getk) takes the held key first;
0373                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0373                             ;      key like any other, but two of them within about 250 ms still stop it.
0373                             ;  Both are called straight from a handler, never from a routine under one:
0373                             ;  the checked build's report counts on finding one return address above the
0373                             ;  data stack, and TOS in HL.
0373                             ; =============================================================================
0373                          IFN   CPM   
0373                RAWK:     EQU   KEY   
0373                          ENDIF      
0373                             ; pollk: the break check (see rpushd).
0373   CD 06 FF     POLLK:    CALL   rawk   
0376   C8                     RZ      ; no key
0377   32 7A 82               STA   KEYBUF   ; held for the next "?"
037A   FE 03        PK1:      CPI   3   ; (getk joins here)
037C   C0                     RNZ      
037D                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
037D                             ; the program has turned it off, wait about 250 ms for one more key: a
037D                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
037D                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
037D   3A 7B 82     CTLC:     LDA   BRKOFF   
0380   B7                     ORA   A   
0381   CA DA 03               JZ   brk   
0384   D5                     PUSH   D   
0385   11 10 27               LXI   D,250*MSLOOP   
0388   CD 06 FF     CT1:      CALL   rawk   
038B   C2 94 03               JNZ   ct2   
038E   1B                     DCX   D   
038F   7A                     MOV   A,D   
0390   B3                     ORA   E   
0391   C2 88 03               JNZ   ct1   
0394   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
0395   FE 03                  CPI   3   
0397   CA DA 03               JZ   brk   
039A   B7                     ORA   A   
039B   CA A1 03               JZ   ct3   
039E   32 7A 82               STA   KEYBUF   
03A1   3E 03        CT3:      MVI   A,3   
03A3   B7                     ORA   A   
03A4   C9                     RET      
03A5                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
03A5   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
03A6   21 7A 82               LXI   H,KEYBUF   ;   the buffer
03A9   7E                     MOV   A,M   
03AA   36 00                  MVI   M,0   
03AC   E1                     POP   H   
03AD   B7                     ORA   A   
03AE   C0                     RNZ      
03AF   CD 06 FF               CALL   rawk   
03B2   C8                     RZ      
03B3   C3 7A 03               JMP   pk1   ; Ctrl-C? If not, that is the key
03B6                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
03B6                          ENDIF      
03B6                          IF   CHECKED   
03B6                BRK:      EQU   e_break   ;   the checked build reports B
03B6                          ENDIF      
03B6                          IF   CPM   
                                 ; (In a CP/M build the letters and digits are here, out of the way of the
                                 ; handlers, which must fit in the image's first two pages. The same code as
                                 ; in the generic build.)
                                 ; ---- the letters and digits --------------------------------------------------
                                 ; a-z: push the cell's address (the cell is the variable)
03B6                          ENDIF      
03B6                          IF   CPM*(1-SBASEU)   
                    LOWER:    PUSH   H   
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
03B6                          ENDIF      
03B6                          IF   CPM   
                                 ; A-Z: call the word. The return address (the IP after the letter) goes on
                                 ; the return stack, and the IP becomes the address in the letter's cell.
                    UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   ; HL -> cell
                              MOV   D,B   
                              MOV   E,C   ; DE = the return address
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   ; IP = the word's body, and fall into rpushd
                                 ; rpushd: push DE on the return stack, then pop TOS off the data stack and
                                 ; go on. Every push of the return stack ends here: for a word call the cell
                                 ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
                                 ; the one that was used up.
                                 ; 
                                 ; The break key is looked at here, so at every word call and loop-back (and
                                 ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
                                 ; the keyboard can be slow (it is a BDOS call under CP/M).
                    RPUSHD:   LHLD   RSP   
                              DCX   H   
                              MOV   M,D   
                              DCX   H   
                              MOV   M,E   
                              SHLD   RSP   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
03B6                          ENDIF      
03B6                             ; =============================================================================
03B6                             ;  Checked build: the checks and the error report
03B6                             ; =============================================================================
03B6                          IF   CHECKED   
03B6                             ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
03B6                             ; it, and the old top is on the stack under the return address. Stop if the
03B6                             ; new top is not below the limit page, or is below the program's end.
03B6                CHKHP:       
03B6                          ENDIF      
03B6                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
03B6                          ENDIF      
03B6                          IF   CHECKED*(1-CPM)   
03B6                             ; (Here the program's space is under 32K, so a top that wrapped
03B6                             ; round always falls outside it.)
03B6   7C                     MOV   A,H   
03B7   FE F0                  CPI   HEAPLIM   
03B9   D2 C5 03               JNC   e_heap   
03BC                          ENDIF      
03BC                          IF   CHECKED   
03BC   EB                     XCHG      
03BD   E5                     PUSH   H   ; the count
03BE   2A 38 82               LHLD   NPEND   
03C1   19                     DAD   D   ; carry: at or above the program's end
03C2   E1                     POP   H   
03C3   EB                     XCHG      
03C4   D8                     RC      
03C5   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
03C6   D1                     POP   D   ;   and drop the return address (errp drops
03C7   3E 48                  MVI   A,"H"   ;   the old top)
03C9   C3 69 04               JMP   errp   
03CC                             ; chkst: stop unless HL is in the program's own space: from the letter page
03CC                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
03CC                             ; whatever lies above the limit are safe. Memory above the heap top but
03CC                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
03CC                             ; It is the page of HL + 1 that is tested, so that one test serves both
03CC                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
03CC                             ; Keeps HL and BC. It runs on into its own error entry.
03CC   23           CHKST:    INX   H   
03CD   7C                     MOV   A,H   
03CE   2B                     DCX   H   
03CF   FE 82                  CPI   LETPAGE   
03D1   DA D7 03               JC   e_store   
03D4                          ENDIF      
03D4                          IF   CHECKED*(1-CPM)   
03D4   FE F0                  CPI   HEAPLIM   
03D6   D8                     RC      
03D7                          ENDIF      
03D7                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
03D7                          ENDIF      
03D7                          IF   CHECKED   
03D7                             ; Two error entries for errors found inside a routine: the first hides the
03D7                             ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
03D7                             ; return address.
03D7   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
03D9   11                     DB   11h   
03DA   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
03DC   C3 69 04               JMP   errp   
03DF                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
03DF                             ; "$", and the error report's texts). A NUL first is an error: Q.
03DF   7E           PRSTR:    MOV   A,M   
03E0   23                     INX   H   
03E1   FE 22                  CPI   22h   
03E3   C8                     RZ      
03E4   B7                     ORA   A   
03E5   CA 51 04               JZ   e_dollar   
03E8   FE 2F                  CPI   "/"   
03EA   C2 FB 03               JNZ   prs1   
03ED   7E                     MOV   A,M   
03EE   23                     INX   H   
03EF   FE 60                  CPI   60h   
03F1   DA F9 03               JC   prs0   
03F4   FE 7F                  CPI   7Fh   
03F6   DA C5 02               JC   pesc   
03F9   E6 BF        PRS0:     ANI   0BFh   
03FB                          ;*Macro unroll: prs1:   PUTA
03FB   EF           PRS1:     DS   1-CPM,0EFh   
03FC                          DS   CPM,0CDh   
03FC                          DS   CPM,APUT&0FFh   
03FC                          DS   CPM,APUT/256   
03FC   C3 DF 03               JMP   prstr   
03FF                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
03FF                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
03FF                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
03FF                             ; pnl: the same, on a new line.
03FF   3E 0D        PNL:      MVI   A,13   
0401                          ;*Macro unroll:  PUTA
0401   EF                     DS   1-CPM,0EFh   
0402                          DS   CPM,0CDh   
0402                          DS   CPM,APUT&0FFh   
0402                          DS   CPM,APUT/256   
0402   3E 0A                  MVI   A,10   
0404                          ;*Macro unroll:  PUTA
0404   EF                     DS   1-CPM,0EFh   
0405                          DS   CPM,0CDh   
0405                          DS   CPM,APUT&0FFh   
0405                          DS   CPM,APUT/256   
0405   E3           PMSG:     XTHL      
0406   CD DF 03               CALL   prstr   
0409   E3                     XTHL      
040A   C9                     RET      
040B                             ; chkstk: both stacks are checked once per character, not in every handler.
040B                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
040B                             ; the constant carries if it is above (cells were popped that were never
040B                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
040B                             ; a character late at most: the bytes above DSTOP and the guard band below
040B                             ; the page take what happens meanwhile.
040B   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
040C   21 05 7E               LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
040F   39                     DAD   SP   
0410   DA 3A 04               JC   e_under   
0413   24                     INR   H   
0414   C2 34 04               JNZ   e_over   
0417   2A 34 82               LHLD   RSP   ; the return stack: in its page (or it has
041A   7C                     MOV   A,H   ;   overflowed), and not above its empty
041B   FE 80                  CPI   RSPAGE   ;   position (an underflow stays inside the
041D   C2 31 04               JNZ   e_rover   ;   page, in the guard band)
0420   7D                     MOV   A,L   
0421   FE E1                  CPI   RSTOP&0FFh+1   
0423   D2 28 04               JNC   e_runder   
0426   EB                     XCHG      ; TOS back
0427   C9                     RET      
0428   21 E0 80     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
042B   22 34 82               SHLD   RSP   
042E   3E 72                  MVI   A,"r"   
0430   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
0431   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
0433   21                     DB   21h   
0434   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
0436   EB                     XCHG      ; TOS back
0437   C3 69 04               JMP   errp   
043A   31 FC 81     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
043D   3E 73                  MVI   A,"s"   
043F   C3 6A 04               JMP   error   
0442                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0442                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
0442                             ; every build: if the IP is in page zero, this was a call of an undefined
0442                             ; word. The call is undone, so the place is the call itself.
0442   04           E_HI:     INR   B   
0443   05                     DCR   B   
0444   C2 60 04               JNZ   e_resv   
0447   E5                     PUSH   H   
0448                          ;*Macro unroll:  POPR
0448   CF                     DS   1-CPM,0CFh   
0449                          DS   CPM,0CDh   
0449                          DS   CPM,AROP&0FFh   
0449                          DS   CPM,AROP/256   
0449   44                     MOV   B,H   
044A   4D                     MOV   C,L   
044B   E1                     POP   H   
044C   3E 55                  MVI   A,"U"   
044E   C3 6A 04               JMP   error   
0451                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
0451                             ; back in TOS. prstr"s return address goes first. But if "$' had no
0451                             ; address at all (the stack was empty), it is s, found now: chkstk, called
0451                             ; one cell up, sees the stack past its empty place then.
0451   D1           E_DOLLAR:   POP   D   
0452   E1                     POP   H   
0453   CD 0B 04               CALL   chkstk   
0456   E5                     PUSH   H   
0457   2A 3A 82               LHLD   PSAVE   
045A   11                     DB   11h   ; (LXI D hides e_quote's first two bytes)
045B                             ; Error entries. Each loads its letter and then hides the next entry inside
045B                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
045B   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
045C   4D                     MOV   C,L   ;   past the opening quote, which is the place
045D   3E 51                  MVI   A,"Q"   
045F   11                     DB   11h   
0460   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
0462   11                     DB   11h   
0463   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
0465   11                     DB   11h   
0466   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
0468   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
0469                             ; errp: an error found inside a routine: drop its return address first.
0469   D1           ERRP:     POP   D   
046A                             ; error: the report, then the end. A = the letter, BC = one past the place,
046A                             ; HL = TOS, and both stacks as the report is to show them:
046A                             ; 
046A                             ;   Err X @ line,col
046A                             ;   D:n: the top 8 cells at most, bottom to top
046A                             ;   R:n
046A   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
046B   5F                     MOV   E,A   
046C   CD FF 03               CALL   pnl   
046F   45 72 72 20 22         DB   "Err ",22h   
0474   7B                     MOV   A,E   
0475                          ;*Macro unroll:  PUTA
0475   EF                     DS   1-CPM,0EFh   
0476                          DS   CPM,0CDh   
0476                          DS   CPM,APUT&0FFh   
0476                          DS   CPM,APUT/256   
0476   CD 05 04               CALL   pmsg   
0479   20 40 20 22            DB   " @ ",22h   
047D   0B                     DCX   B   ; BC = the place
047E                             ; The line and column. A place below the program is in the line
047E                             ; buffer: line 0. Otherwise count the LFs from the program's start;
047E                             ; DE = the line's number, HL = where it starts.
047E   21 80 82               LXI   H,LINEBUF   
0481   11 00 00               LXI   D,0   
0484   78                     MOV   A,B   
0485   FE 83                  CPI   PROG/256   
0487   DA A1 04               JC   er3   
048A   24                     INR   H   
048B   6B                     MOV   L,E   ; HL = PROG
048C   13           ER1:      INX   D   ; a new line starts at HL
048D   E5                     PUSH   H   
048E   7D           ER2:      MOV   A,L   
048F   91                     SUB   C   
0490   7C                     MOV   A,H   
0491   98                     SBB   B   
0492   D2 A0 04               JNC   er2x   ; reached the place
0495   7E                     MOV   A,M   
0496   23                     INX   H   
0497   FE 0A                  CPI   10   
0499   C2 8E 04               JNZ   er2   
049C   F1                     POP   PSW   
049D   C3 8C 04               JMP   er1   
04A0   E1           ER2X:     POP   H   
04A1   C5           ER3:      PUSH   B   
04A2   E5                     PUSH   H   
04A3   EB                     XCHG      
04A4   CD B3 02               CALL   pdec   ; the line
04A7   3E 2C                  MVI   A,","   
04A9                          ;*Macro unroll:  PUTA
04A9   EF                     DS   1-CPM,0EFh   
04AA                          DS   CPM,0CDh   
04AA                          DS   CPM,APUT&0FFh   
04AA                          DS   CPM,APUT/256   
04AA   D1                     POP   D   
04AB   E1                     POP   H   
04AC   CD 17 05               CALL   sub16   
04AF   23                     INX   H   
04B0   CD B3 02               CALL   pdec   ; the column
04B3   CD FF 03               CALL   pnl   
04B6   44 3A 22               DB   "D:",22h   
04B9   21 06 7E               LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
04BC   39                     DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
04BD                          ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
04BD   E7                     DS   1-CPM,0E7h   ;   first value and holds nothing)
04BE                          DS   CPM,0CDh   
04BE                          DS   CPM,ANEG&0FFh   
04BE                          DS   CPM,ANEG/256   
04BE   7C                     MOV   A,H   
04BF   CD 0B 05               CALL   phal2   ; the depth
04C2   3E 3A                  MVI   A,":"   
04C4                          ;*Macro unroll:  PUTA
04C4   EF                     DS   1-CPM,0EFh   
04C5                          DS   CPM,0CDh   
04C5                          DS   CPM,APUT&0FFh   
04C5                          DS   CPM,APUT/256   
04C5   79                     MOV   A,C   
04C6   FE 09                  CPI   9   
04C8   DA D5 04               JC   er6   
04CB   CD 05 04               CALL   pmsg   
04CE   20 2E 2E 2E 22         DB   " ...",22h   
04D3   0E 08                  MVI   C,8   
04D5   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
04D7   69                     MOV   L,C   
04D8   29                     DAD   H   
04D9   39                     DAD   SP   ; HL -> just above the deepest of them
04DA   0C                     INR   C   
04DB   0D           ER7:      DCR   C   
04DC   CA F1 04               JZ   er8   
04DF   2B                     DCX   H   
04E0   56                     MOV   D,M   
04E1   2B                     DCX   H   
04E2   5E                     MOV   E,M   
04E3   E5                     PUSH   H   
04E4   C5                     PUSH   B   
04E5   3E 20                  MVI   A," "   
04E7                          ;*Macro unroll:  PUTA
04E7   EF                     DS   1-CPM,0EFh   
04E8                          DS   CPM,0CDh   
04E8                          DS   CPM,APUT&0FFh   
04E8                          DS   CPM,APUT/256   
04E8   EB                     XCHG      
04E9   CD AA 02               CALL   psgn   
04EC   C1                     POP   B   
04ED   E1                     POP   H   
04EE   C3 DB 04               JMP   er7   
04F1   CD FF 03     ER8:      CALL   pnl   
04F4   52 3A 22               DB   "R:",22h   
04F7   2A 34 82               LHLD   RSP   
04FA   EB                     XCHG      
04FB   21 E0 80               LXI   H,RSTOP   
04FE   CD 08 05               CALL   phalf   
0501   CD FF 03               CALL   pnl   
0504   22                     DB   22h   
0505   C3 7F 00               JMP   endprog   
0508                             ; phalf: print half of HL - DE, and leave it in BC
0508   CD 17 05     PHALF:    CALL   sub16   
050B   B7           PHAL2:    ORA   A   ; (A = H; this clears the carry)
050C   1F                     RAR      
050D   67                     MOV   H,A   
050E   7D                     MOV   A,L   
050F   1F                     RAR      
0510   6F                     MOV   L,A   
0511   E5                     PUSH   H   
0512   CD B3 02               CALL   pdec   
0515   C1                     POP   B   
0516   C9                     RET      
0517                             ; sub16: HL = HL - DE. Leaves A = H.
0517   7D           SUB16:    MOV   A,L   
0518   93                     SUB   E   
0519   6F                     MOV   L,A   
051A   7C                     MOV   A,H   
051B   9A                     SBB   D   
051C   67                     MOV   H,A   
051D   C9                     RET      
051E                          ENDIF      
051E                             ; =============================================================================
051E                             ;  Startup
051E                             ; =============================================================================
051E                START:       
051E                          IF   (1-CPM)*CHECKED   
051E   31 FC 81               LXI   SP,DSTOP   
0521                          ENDIF      
0521                          IF   QK   
                              LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
                              XRA   A   ;   start of 0000h matches no skip)
                    SKC1:     MOV   M,A   
                              INR   L   
                              JNZ   skc1   
0521                          ENDIF      
0521                          IF   CHECKED   
0521                             ; Clear the lower half of the letter page: every variable starts at
0521                             ; 0, every word cell holds 0000h, the address an undefined word is
0521                             ; caught at (see e_hi), and no key is held back.
0521   21 00 82               LXI   H,LET   
0524   AF                     XRA   A   
0525   77           INI1:     MOV   M,A   
0526   2C                     INR   L   
0527   F2 25 05               JP   ini1   ; +00h to +7Fh
052A                          ENDIF      
052A                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
052A                          ENDIF      
052A                          IFN   CPM   
052A   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
052D   7E           FNUL:     MOV   A,M   
052E   23                     INX   H   
052F   B7                     ORA   A   
0530   C2 2D 05               JNZ   fnul   
0533                          ENDIF      
0533   22 7C 82               SHLD   HEAP   
0536                          IF   CHECKED   
0536                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
0536   E7                     DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
0537                          DS   CPM,0CDh   
0537                          DS   CPM,ANEG&0FFh   
0537                          DS   CPM,ANEG/256   
0537   22 38 82               SHLD   NPEND   ;   release below it
053A                          ENDIF      
053A   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
053D   22 34 82               SHLD   RSP   
0540                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
0540                          ENDIF      ;   checked build has cleared these)
0540                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0540                          ENDIF      
0540                          IF   1-CHECKED   
                              SHLD   KEYBUF   
0540                          ENDIF      
0540   01 00 83               LXI   B,PROG   ; the IP
0543                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0543   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0544                          DS   CPM+FAST-CPM*FAST,0C3h   
0544                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0544                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0544                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
                                 ; 
                                 ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
                                 ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
                                 ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
                                 ;  the letters and digits have one entry each, which knows its cell or its
                                 ;  value already.
                                 ; =============================================================================
                    FTSTORE:   XCHG      ; !
                              JMP   h_store   
                    FTSTR:    XCHG      ; "
                              JMP   h_str   
                    FTNUM:    XCHG      ; #
                              JMP   h_num   
                    FTPRINT:   XCHG      ; $
                              JMP   h_print   
                    FTEMIT:   XCHG      ; '
                              JMP   h_emit   
                    FTCSTORE:   XCHG      ; .
                              JMP   h_cstore   
                    FTDIV:    XCHG      ; /
                              JMP   h_div   
                    FTKEY:    XCHG      ; ?
                              JMP   h_key   
                    FTDEF:    XCHG      ; [
                              JMP   h_def   
                    FTBREAK:   XCHG      ; \
                              JMP   h_break   
                    FTALLOC:   XCHG      ; _
                              JMP   h_alloc   
                    FTGRAVE:   XCHG      ; `
                              JMP   h_grave   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:   POP   H   ; +
                              DAD   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:   LDAX   B   ; -
                              SUI   "0"   
                              CPI   10   
                              JC   fs_neg   
                              POP   H   
                              MOV   A,L   
                              SUB   E   
                              MOV   E,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   D,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   XCHG      ; a digit next: a negative number
                              JMP   negnum   
                    FS_DUP:   PUSH   D   ; :
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:   POP   H   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:   POP   H   ; %
                              PUSH   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:   XCHG      ; @
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:   LDAX   D   ; ,
                              MOV   E,A   
                              MVI   D,0   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:    POP   H   ; < (HL = a, DE = b: the borrow of a - b, flipped if the signs differ)
                              MOV   A,L   
                              SUB   E   
                              MOV   A,H   
                              SBB   D   
                              SBB   A   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              RAL      
                              SBB   A   
                              XRA   L   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:    POP   H   ; > (b < a: the borrow of b - a)
                              MOV   A,E   
                              SUB   L   
                              MOV   A,D   
                              SBB   H   
                              SBB   A   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              RAL      
                              SBB   A   
                              XRA   L   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
