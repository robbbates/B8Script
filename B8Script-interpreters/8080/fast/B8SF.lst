04D0                             ; psgn: print HL as a signed number. Uses BC.
04D0   7C           PSGN:     MOV   A,H   
04D1   B7                     ORA   A   
04D2   F2 DD 04               JP   pdec   
04D5   3E 2D                  MVI   A,"-"   
04D7                          ;*Macro unroll:  PUTA
04D7                          DS   1-CPM,0EFh   
04D7   CD                     DS   CPM,0CDh   
04D8   0C                     DS   CPM,APUT&0FFh   
04D9   07                     DS   CPM,APUT/256   
04DA                          ;*Macro unroll:  NEGH
04DA                          DS   1-CPM,0E7h   
04DA   CD                     DS   CPM,0CDh   
04DB   27                     DS   CPM,ANEG&0FFh   
04DC   01                     DS   CPM,ANEG/256   
04DD                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
04DD                             ; Uses BC.
04DD   11 0A 00     PDEC:     LXI   D,10   
04E0   CD 24 03               CALL   udiv   ; HL = HL / 10, C = the last digit
04E3   79                     MOV   A,C   
04E4   F5                     PUSH   PSW   
04E5   7C                     MOV   A,H   
04E6   B5                     ORA   L   
04E7   C4 DD 04               CNZ   pdec   
04EA   F1                     POP   PSW   
04EB   C6 30                  ADI   "0"   
04ED                          ;*Macro unroll:  PUTA
04ED                          DS   1-CPM,0EFh   
04ED   CD                     DS   CPM,0CDh   
04EE   0C                     DS   CPM,APUT&0FFh   
04EF   07                     DS   CPM,APUT/256   
