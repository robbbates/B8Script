E518   6E 94                  JMP   [,X]   
E51A   BD E2 51     FT_EMIT:   JSR   h_emit   ; '
E51D                          ;*Macro unroll:  NEXTF
E51D   BD                     DS   CHECKED,0BDh   
E51E   E4                     DS   CHECKED,ACHK/256   
E51F   A2                     DS   CHECKED,ACHK&0FFh   
E520   E6 A0                  LDB   ,Y+   
E522   8E EE 9E               LDX   #FTAB   
E525   3A                     ABX      
E526   3A                     ABX      
E527   6E 94                  JMP   [,X]   
E529   BD E2 74     FT_CSTORE:   JSR   h_cstore   ; .
E52C                          ;*Macro unroll:  NEXTF
E52C   BD                     DS   CHECKED,0BDh   
E52D   E4                     DS   CHECKED,ACHK/256   
E52E   A2                     DS   CHECKED,ACHK&0FFh   
E52F   E6 A0                  LDB   ,Y+   
E531   8E EE 9E               LDX   #FTAB   
E534   3A                     ABX      
E535   3A                     ABX      
E536   6E 94                  JMP   [,X]   
E538   BD E3 64     FT_DIV:   JSR   h_div   ; /
E53B                          ;*Macro unroll:  NEXTF
E53B   BD                     DS   CHECKED,0BDh   
E53C   E4                     DS   CHECKED,ACHK/256   
E53D   A2                     DS   CHECKED,ACHK&0FFh   
E53E   E6 A0                  LDB   ,Y+   
E540   8E EE 9E               LDX   #FTAB   
E543   3A                     ABX      
E544   3A                     ABX      
E545   6E 94                  JMP   [,X]   
E547   BD E1 9D     FT_KEY:   JSR   h_key   ; ?
E54A                          ;*Macro unroll:  NEXTF
E54A   BD                     DS   CHECKED,0BDh   
E54B   E4                     DS   CHECKED,ACHK/256   
E54C   A2                     DS   CHECKED,ACHK&0FFh   
E54D   E6 A0                  LDB   ,Y+   
E54F   8E EE 9E               LDX   #FTAB   
E552   3A                     ABX      
