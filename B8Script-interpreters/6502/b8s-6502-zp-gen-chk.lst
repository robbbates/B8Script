E1C3   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E1C5   20 28 E5     KT2:      JSR   getk   
E1C8   D0 E7                  BNE   seta   
E1CA   88                     DEY      
E1CB   D0 F8                  BNE   kt2   
E1CD   EE 76 04               INC   SEED   ; a millisecond with no key stirs the random
E1D0   D0 03                  BNE   kt5   ;   seed by one: how long a key takes to come
E1D2   EE 77 04               INC   SEED+1   ;   is the one thing here that is not the
E1D5                KT5:         ;   same every time
