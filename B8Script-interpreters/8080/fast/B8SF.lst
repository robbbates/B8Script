0179   87                     ADD   A   
017A   87                     ADD   A   
017B   87                     ADD   A   
017C   57                     MOV   D,A   ; the high digit
017D   CD 29 06               CALL   hexc   
0180   D2 8C 01               JNC   hx2   ; odd digit: consumed and dropped
0183   B2                     ORA   D   
0184   77                     MOV   M,A   
0185   23                     INX   H   
0186   CD 29 06               CALL   hexc   
0189   DA 78 01               JC   hx1   
