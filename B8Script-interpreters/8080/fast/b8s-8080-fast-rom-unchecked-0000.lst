03DA                             ; "$" prints the string at TOS (see h_print).
03DA   7E           PRLP:     MOV   A,M   
03DB   23                     INX   H   
03DC   FE 22                  CPI   22h   
03DE   CA 85 01               JZ   h_drop   
03E1   FE 2F                  CPI   "/"   
03E3   C2 F4 03               JNZ   pr1   
03E6   7E                     MOV   A,M   
03E7   23                     INX   H   
03E8   FE 60                  CPI   60h   
03EA   DA F2 03               JC   pr0   
03ED   FE 7F                  CPI   7Fh   
03EF   DA F8 03               JC   pesc   
03F2   E6 BF        PR0:      ANI   0BFh   
03F4                          ;*Macro unroll: pr1:    PUTA
03F4   EF           PR1:      DS   1-CPM,0EFh   
03F5                          DS   CPM,0CDh   
03F5                          DS   CPM,APUT&0FFh   
03F5                          DS   CPM,APUT/256   
03F5   C3 DA 03               JMP   prlp   
03F8                          ENDIF      
03F8                             ;-----------------------------------------------------------------------------
03F8                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
03F8                             ; HL points past it. Each goes back into the loop that prints the string
03F8                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
03F8                             ;    /a-/z   print the variable, as "#" does
03F8                             ;    /{      clear the screen, the cursor to the top left
03F8                             ;    /}      clear from the cursor to the end of the line
03F8                             ;    /|  /`  show the cursor, hide it
03F8                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
03F8   FE 7E        PESC:     CPI   7Eh   
03FA   CA 1D 04               JZ   pat   
03FD   11 DA 03               LXI   D,PRLOOP   ; the others return into the loop
0400   D5                     PUSH   D   
0401   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0403   D2 26 04               JNC   pcon   
0406   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0408   D2 2F 04               JNC   phide   
040B   87                     ADD   A   ; the variable's cell
040C   C6 40                  ADI   40h   
040E   E5                     PUSH   H   
040F   C5                     PUSH   B   
0410   6F                     MOV   L,A   
0411   26 82                  MVI   H,LETPAGE   
0413   7E                     MOV   A,M   
0414   2C                     INR   L   
0415   66                     MOV   H,M   
0416   6F                     MOV   L,A   
0417   CD BF 03               CALL   psgn   
041A   C1                     POP   B   
041B   E1                     POP   H   
041C   C9                     RET      
041D                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
041D                             ; the checked build "$" is the routine prstr: its own return address goes
041D                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
041D                             ; its two cells are there, and is s if not, before it prints anything.
041D                PAT:         
041D                          IF   CHECKED   
                              XTHL      ; the text pointer over prstr's return address
                              LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              DAD   SP   
                              JC   e_under   
                              POP   H   
041D                          ENDIF      
041D   D1                     POP   D   ; DE = the column
041E   E3                     XTHL      ; HL = the row; the text pointer is kept
041F                          IF   1-ANS   
041F   CD 15 FF               CALL   CONAT   
0422   E1                     POP   H   
0423   C3 DA 03               JMP   PRAGAIN   
0426                             ; With ANSI = 0 the machine's routines do the rest.
0426   CA 0C FF     PCON:     JZ   CONCLS   ; /{
0429   FE 02                  CPI   2   
042B   CA 0F FF               JZ   CONEOL   ; /}
042E   FE                     DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
042F   AF           PHIDE:    XRA   A   ; /`  (A = 0: hide)
0430   C3 12 FF               JMP   CONCUR   
0433                          ENDIF      
0433                          IF   ANS   
                              PUSH   B   ; (pdec uses BC)
                              PUSH   D   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INX   H   
                              CALL   pdec   
                              MVI   A,";"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   H   
                              INX   H   
                              CALL   pdec   
                              MVI   A,"H"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   B   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
                    PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
                              MVI   A,"?"   
                              CALL   csia   
                              MVI   A,"2"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"5"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DCR   A   
                              JZ   pshow   ; /|
                              MVI   A,"K"   
                              JP   csia   ; /}  ESC [ K
                              MVI   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              MVI   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
                    CSIA:     PUSH   PSW   
                              CALL   csi   
                              POP   PSW   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                    CSI:      MVI   A,27   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"["   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
0433                          ENDIF      
0433                             ; skip: read past text to the closer at this level, and return A = 0 if it
0433                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0433                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0433                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0433                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0433                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
0433                             ; 
0433                             ; The checked build also looks at the character the skip was started by,
0433                             ; which is always the one just before where it starts: "(" must end at ")",
0433                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0433                             ; quote counts as running into it. "\" takes either closer. The place where
0433                             ; the skip started is kept on the stack, for the report.
0433                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
0433                          ENDIF      
0433                          IF   CHECKED*(1-QK)   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
0433                          ENDIF      
0433                          IF   1-QK   
                              MVI   D,0   
                    SK3:      INR   D   ; an opener: one deeper
                    SK1:      LDAX   B   
0433                          ENDIF      
0433                          IF   (1-CHECKED)*(1-QK)   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
0433                          ENDIF      
0433                          IF   CHECKED*(1-QK)   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
0433                          ENDIF      
0433                          IF   1-QK   
                              CPI   22h   
                              CZ   skipstr   ; leaves A = 22h, which matches nothing below
                              SUI   "("   ;   (or 0, and then the NUL is read next)
                              JZ   sk3   
                              DCR   A   ; ")"
                              JZ   sk4   
                              SUI   "["-")"   
                              JZ   sk3   
                              CPI   "]"-"["   
                              JNZ   sk1   
                    SK4:      DCR   D   
0433                          ENDIF      
0433                          IF   (1-CHECKED)*(1-QK)   
                              RZ      ; the closer at this level
                              JMP   sk1   
0433                          ENDIF      
0433                          IF   CHECKED*(1-QK)   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
0433                          ENDIF      
0433                          IF   QK   
0433                             ; The skip cache. Nearly every skip is one that has happened before (a loop
0433                             ; skips the same false block on every pass), so the first scan from each
0433                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
0433                             ; by the start's low byte (times 4). Only skips that start in the program
0433                             ; text are kept (the line buffer changes); the cache is emptied whenever a
0433                             ; run starts (see start). A program that changes its own text while it
0433                             ; runs is not looked after.
0433   78           SKIP:     MOV   A,B   
0434   FE 83                  CPI   PROG/256   
0436   DA 56 04               JC   sks   ; below the program text: no cache
0439   79                     MOV   A,C   
043A   87                     ADD   A   
043B   87                     ADD   A   
043C   5F                     MOV   E,A   
043D   16 F0                  MVI   D,CPAGE   ; DE -> the entry
043F   1A                     LDAX   D   
0440   B9                     CMP   C   
0441   C2 56 04               JNZ   sks   
0444   1C                     INR   E   
0445   1A                     LDAX   D   
0446   B8                     CMP   B   
0447   C2 56 04               JNZ   sks   
044A   1C                     INR   E   
044B   1A                     LDAX   D   
044C   4F                     MOV   C,A   
044D   1C                     INR   E   
044E   1A                     LDAX   D   
044F   47                     MOV   B,A   ; a hit: the IP is past the closer
0450   0B                     DCX   B   
0451   0A                     LDAX   B   
0452   03                     INX   B   
0453   D6 29                  SUI   ")"   ; 0 for ")", not 0 for "]"
0455   C9                     RET      
0456   C5           SKS:      PUSH   B   ; where it starts: the cache's key (and the
0457                          ENDIF      ;   checked report's place)
0457                          IF   QK*CHECKED   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
0457                          ENDIF      
0457                          IF   QK   
0457                             ; The scan. Most characters are nothing to it, and two range tests rule
0457                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
0457   16 00                  MVI   D,0   
0459   14           SQ3:      INR   D   ; an opener: one deeper
045A   0A           SQ1:      LDAX   B   
045B   03                     INX   B   
045C   FE 5E                  CPI   5Eh   
045E   D2 5A 04               JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
0461   FE 5B                  CPI   5Bh   
0463   D2 85 04               JNC   sqb   ; [ \ ]
0466   FE 2A                  CPI   2Ah   
0468   D2 5A 04               JNC   sq1   ; * to Z: nothing
046B   FE 28                  CPI   28h   
046D   CA 59 04               JZ   sq3   ; (
0470   D2 90 04               JNC   sqc   ; )
0473   FE 22                  CPI   22h   
0475   CA 7F 04               JZ   sqq   ; a string
0478   B7                     ORA   A   
0479   C2 5A 04               JNZ   sq1   ; the rest below "(": nothing
047C                          ENDIF      
047C                          IF   QK*(1-CHECKED)   
047C   C3 3C 00               JMP   endprog   ; NUL: the end of the program
047F                          ENDIF      
047F                          IF   QK*CHECKED   
                              DCX   B   ; NUL: the IP stays on it
                              MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SQ7:      MVI   A,"N"   ; N. The place is the opener
                              JMP   errp   ; (errp drops skip's return address)
047F                          ENDIF      
047F                          IF   QK   
047F   CD B2 04     SQQ:      CALL   skipstr   ; step over the string
0482   C3 5A 04               JMP   sq1   
0485   D6 5C        SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
0487   CA 5A 04               JZ   sq1   ; "\" is nothing here
048A   DA 59 04               JC   sq3   ; [
048D   3E 02                  MVI   A,2   ; ]
048F   FE                     DB   0FEh   ; (CPI: steps over the XRA)
0490   AF           SQC:      XRA   A   ; )
0491   15           SQ4:      DCR   D   
0492   C2 5A 04               JNZ   sq1   
0495                          ENDIF      
0495                          IF   QK*CHECKED   
                              MOV   D,A   ; the closer at this level (as above): 2 here
                              XRA   E   ;   means the wrong closer
                              ANI   6   
                              CPI   2   
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              JNZ   sq8   
                              MOV   B,D   
                              MOV   C,E   
                              JMP   sq7   
                    SQ8:         
0495                          ENDIF      
0495                          IF   QK*(1-CHECKED)   
0495   D1                     POP   D   ; where the skip started
0496                          ENDIF      
0496                          IF   QK   
0496                             ; The closer at this level: remember the skip (if it started in the program
0496                             ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
0496   E5                     PUSH   H   
0497   67                     MOV   H,A   
0498   7A                     MOV   A,D   
0499   FE 83                  CPI   PROG/256   
049B   DA AE 04               JC   sq9   
049E   7B                     MOV   A,E   
049F   87                     ADD   A   
04A0   87                     ADD   A   
04A1   6F                     MOV   L,A   
04A2   7C                     MOV   A,H   
04A3   26 F0                  MVI   H,CPAGE   
04A5   73                     MOV   M,E   
04A6   2C                     INR   L   
04A7   72                     MOV   M,D   
04A8   2C                     INR   L   
04A9   71                     MOV   M,C   
04AA   2C                     INR   L   
04AB   70                     MOV   M,B   
04AC   E1                     POP   H   
04AD   C9                     RET      
04AE   7C           SQ9:      MOV   A,H   
04AF   E1                     POP   H   
04B0   C9                     RET      
04B1                          ENDIF      
04B1                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
04B1                             ; the next character, so "/"" does not end it. Leaves A = 22h.
04B1                          IF   1-CHECKED   
04B1   03           SS0:      INX   B   
04B2   0A           SKIPSTR:   LDAX   B   
04B3   03                     INX   B   
04B4   FE 2F                  CPI   "/"   
04B6   CA B1 04               JZ   ss0   
04B9   FE 22                  CPI   22h   
04BB   C2 B2 04               JNZ   skipstr   
04BE   C9                     RET      
04BF                          ENDIF      
04BF                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
04BF                          ENDIF      
04BF                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
04BF                             ; and return its value in A with the carry set; otherwise leave the IP and
04BF                             ; return with the carry clear.
04BF   0A           HEXC:     LDAX   B   
04C0   D6 30                  SUI   "0"   
04C2   FE 0A                  CPI   10   
04C4   DA D0 04               JC   hc1   
04C7   E6 DF                  ANI   0DFh   
04C9   D6 11                  SUI   11h   
04CB   FE 06                  CPI   6   
04CD   D0                     RNC      
04CE   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
04D0   03           HC1:      INX   B   
04D1   C9                     RET      
04D2                             ;  ---- Speed-ups (base builds) -------------------------------------------
04D2                             ;  The skip cache and "/" by a power of two are above. These are the
04D2                             ;  handlers' tails that the builds with room take, kept here, out of the
04D2                             ;  handlers' first two pages.
04D2                          IF   QK   
04D2                             ; "*" with an operand below 256: that one becomes the multiplier, a byte in
04D2                             ; A, and the loop stops as soon as its bits are used up (most
04D2                             ; multiplications have one, a count or a small constant). With both at 256
04D2                             ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
04D2                             ; shifted in above it says when), and its high byte goes on as a small one.
04D2                             ; DE = NOS, HL = TOS.
04D2   7C           MULQ:     MOV   A,H   
04D3   B7                     ORA   A   
04D4   CA DD 04               JZ   mq8   ; the multiplier is below 256
04D7   7A                     MOV   A,D   
04D8   B7                     ORA   A   
04D9   C2 FC 04               JNZ   mq16   
04DC   EB                     XCHG      ; the multiplicand is: it becomes the multiplier
04DD   7D           MQ8:      MOV   A,L   
04DE   21 00 00               LXI   H,0   
04E1   B7                     ORA   A   ; (clears the carry)
04E2   CA F1 04               JZ   mq9   
04E5   1F           MQ1:      RAR      ; the next bit
04E6   D2 EA 04               JNC   mq2   
04E9   19                     DAD   D   
04EA   EB           MQ2:      XCHG      
04EB   29                     DAD   H   ; multiplicand << 1
04EC   EB                     XCHG      
04ED   B7                     ORA   A   ; bits left? (and clears the carry)
04EE   C2 E5 04               JNZ   mq1   
04F1                          ;*Macro unroll: mq9:    NEXTQ
04F1                MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
04F1                          DS   CPM*(1-FAST),0C3h   
04F1                          DS   CPM*(1-FAST),ANXT&0FFh   
04F1                          DS   CPM*(1-FAST),ANXT/256   
04F1                          DS   FAST*CHECKED,0CDh   
04F1                          DS   FAST*CHECKED,ACHK&0FFh   
04F1                          DS   FAST*CHECKED,ACHK/256   
04F1   0A                     DS   FAST,0Ah   
04F2   03                     DS   FAST,03h   
04F3   EB                     DS   FAST,0EBh   
04F4   6F                     DS   FAST,6Fh   
04F5   26                     DS   FAST,26h   
04F6   0F                     DS   FAST,DTPG   
04F7   7E                     DS   FAST,7Eh   
04F8   24                     DS   FAST,24h   
04F9   66                     DS   FAST,66h   
04FA   6F                     DS   FAST,6Fh   
04FB   E9                     DS   FAST,0E9h   
04FC   C5           MQ16:     PUSH   B   
04FD   44                     MOV   B,H   ; the high byte, for later
04FE   7D                     MOV   A,L   
04FF   21 00 00               LXI   H,0   
0502   37                     STC      ; the marker
0503   1F                     RAR      
0504   D2 08 05     MQ3:      JNC   mq4   
0507   19                     DAD   D   
0508   EB           MQ4:      XCHG      
0509   29                     DAD   H   
050A   EB                     XCHG      
050B   FE 01                  CPI   1   ; only the marker left: 8 rounds done (and
050D   1F                     RAR      ;   the carry was clear for the shift)
050E   C2 04 05               JNZ   mq3   
0511   78                     MOV   A,B   
0512   C1                     POP   B   
0513   B7                     ORA   A   
0514   C3 E5 04               JMP   mq1   ; the high byte, as a small multiplier
0517                             ; A true ")" reads the block start where it is, on top of the return stack,
0517                             ; instead of popping it and pushing it back; the break key is looked at as
0517                             ; rpushd would.
0517   2A 34 82     CLOSEQ:   LHLD   RSP   
051A   4E                     MOV   C,M   
051B   23                     INX   H   
051C   46                     MOV   B,M   
051D   21 36 82               LXI   H,BRKCNT   
0520   35                     DCR   M   
0521   E1                     POP   H   ; (keeps the flags)
0522   CC 30 05               CZ   pollk   
0525                          ;*Macro unroll:  NEXTQ
0525                          DS   (1-CPM)*(1-FAST),0F7h   
0525                          DS   CPM*(1-FAST),0C3h   
0525                          DS   CPM*(1-FAST),ANXT&0FFh   
0525                          DS   CPM*(1-FAST),ANXT/256   
0525                          DS   FAST*CHECKED,0CDh   
0525                          DS   FAST*CHECKED,ACHK&0FFh   
0525                          DS   FAST*CHECKED,ACHK/256   
0525   0A                     DS   FAST,0Ah   
0526   03                     DS   FAST,03h   
0527   EB                     DS   FAST,0EBh   
0528   6F                     DS   FAST,6Fh   
0529   26                     DS   FAST,26h   
052A   0F                     DS   FAST,DTPG   
052B   7E                     DS   FAST,7Eh   
052C   24                     DS   FAST,24h   
052D   66                     DS   FAST,66h   
052E   6F                     DS   FAST,6Fh   
052F   E9                     DS   FAST,0E9h   
0530                          ENDIF      
0530                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWER:    EQU   lowq   
                    LOWQ:     ADD   A   
                              MOV   E,A   
                              MVI   D,LETPAGE   ; DE -> the cell
                              LDAX   B   
                              CPI   "@"   
                              JZ   lwf   
                              CPI   "!"   
                              JZ   lws   
                              PUSH   H   
                              XCHG      ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWF:      INX   B   ; x@: TOS = the cell's value
                              PUSH   H   
                              XCHG      
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              XCHG      
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
                              XCHG      
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0530                          ENDIF      
0530                             ; =============================================================================
0530                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0530                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0530                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
0530                             ;  the host's KEY and CONOUT routines themselves.
0530                             ; 
0530                             ;  A running program reads the keyboard only through getk and pollk, which
0530                             ;  between them give the break key its rules:
0530                             ;    - Ctrl-C stops the program;
0530                             ;    - any other key that the break check reads is held in KEYBUF for the
0530                             ;      next "?", and a newer one takes its place;
0530                             ;    - "?" (getk) takes the held key first;
0530                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0530                             ;      key like any other, but two of them within about 250 ms still stop it.
0530                             ;  Both are called straight from a handler, never from a routine under one:
0530                             ;  the checked build's report counts on finding one return address above the
0530                             ;  data stack, and TOS in HL.
0530                             ; =============================================================================
0530                          IFN   CPM   
0530                RAWK:     EQU   KEY   
0530                          ENDIF      
0530                             ; pollk: the break check (see rpushd).
0530   CD 06 FF     POLLK:    CALL   rawk   
0533   C8                     RZ      ; no key
0534   32 7A 82               STA   KEYBUF   ; held for the next "?"
0537   FE 03        PK1:      CPI   3   ; (getk joins here)
0539   C0                     RNZ      
053A                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
053A                             ; the program has turned it off, wait about 250 ms for one more key: a
053A                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
053A                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
053A   3A 7B 82     CTLC:     LDA   BRKOFF   
053D   B7                     ORA   A   
053E   CA 3C 00               JZ   brk   
0541   D5                     PUSH   D   
0542   11 10 27               LXI   D,250*MSLOOP   
0545   CD 06 FF     CT1:      CALL   rawk   
0548   C2 51 05               JNZ   ct2   
054B   1B                     DCX   D   
054C   7A                     MOV   A,D   
054D   B3                     ORA   E   
054E   C2 45 05               JNZ   ct1   
0551   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
0552   FE 03                  CPI   3   
0554   CA 3C 00               JZ   brk   
0557   B7                     ORA   A   
0558   CA 5E 05               JZ   ct3   
055B   32 7A 82               STA   KEYBUF   
055E   3E 03        CT3:      MVI   A,3   
0560   B7                     ORA   A   
0561   C9                     RET      
0562                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0562   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
0563   21 7A 82               LXI   H,KEYBUF   ;   the buffer
0566   7E                     MOV   A,M   
0567   36 00                  MVI   M,0   
0569   E1                     POP   H   
056A   B7                     ORA   A   
056B   C0                     RNZ      
056C   CD 06 FF               CALL   rawk   
056F   C8                     RZ      
0570   C3 37 05               JMP   pk1   ; Ctrl-C? If not, that is the key
0573                          IF   1-CHECKED   
0573                BRK:      EQU   endprog   ; the unchecked build stops without a word;
0573                          ENDIF      
0573                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
0573                          ENDIF      
0573                          IF   CPM   
                                 ; (In a CP/M build the letters and digits are here, out of the way of the
                                 ; handlers, which must fit in the image's first two pages. The same code as
                                 ; in the generic build.)
                                 ; ---- the letters and digits --------------------------------------------------
                                 ; a-z: push the cell's address (the cell is the variable)
0573                          ENDIF      
0573                          IF   CPM*(1-SBASEU)   
                    LOWER:    PUSH   H   
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0573                          ENDIF      
0573                          IF   CPM   
                                 ; A-Z: call the word. The return address (the IP after the letter) goes on
                                 ; the return stack, and the IP becomes the address in the letter's cell.
                    UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   ; HL -> cell
                              MOV   D,B   
                              MOV   E,C   ; DE = the return address
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   ; IP = the word's body, and fall into rpushd
                                 ; rpushd: push DE on the return stack, then pop TOS off the data stack and
                                 ; go on. Every push of the return stack ends here: for a word call the cell
                                 ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
                                 ; the one that was used up.
                                 ; 
                                 ; The break key is looked at here, so at every word call and loop-back (and
                                 ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
                                 ; the keyboard can be slow (it is a BDOS call under CP/M).
                    RPUSHD:   LHLD   RSP   
                              DCX   H   
                              MOV   M,D   
                              DCX   H   
                              MOV   M,E   
                              SHLD   RSP   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
0573                          ENDIF      
0573                             ; =============================================================================
0573                             ;  Checked build: the checks and the error report
0573                             ; =============================================================================
0573                          IF   CHECKED   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
0573                          ENDIF      
0573                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
0573                          ENDIF      
0573                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
0573                          ENDIF      
0573                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address (errp drops
                              MVI   A,"H"   ;   the old top)
                              JMP   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
0573                          ENDIF      
0573                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
0573                          ENDIF      
0573                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
0573                          ENDIF      
0573                          IF   CHECKED   
                                 ; Two error entries for errors found inside a routine: the first hides the
                                 ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
                                 ; return address.
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   prs0   
                              CPI   7Fh   
                              JC   pesc   
                    PRS0:     ANI   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,10   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   D   
                              POP   H   
                              CALL   chkstk   
                              PUSH   H   
                              LHLD   PSAVE   
                              DB   11h   ; (LXI D hides e_quote's first two bytes)
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   D   
                              POP   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   "D:",22h   
                              LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
                              DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
                              ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
                              DS   1-CPM,0E7h   ;   first value and holds nothing)
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              MOV   A,H   
                              CALL   phal2   ; the depth
                              MVI   A,":"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                    PHAL2:    ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
0573                          ENDIF      
0573                             ; =============================================================================
0573                             ;  Startup
0573                             ; =============================================================================
0573                START:       
0573                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
0573                          ENDIF      
0573                          IF   QK   
0573   21 00 F0               LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
0576   AF                     XRA   A   ;   start of 0000h matches no skip)
0577   77           SKC1:     MOV   M,A   
0578   2C                     INR   L   
0579   C2 77 05               JNZ   skc1   
057C                          ENDIF      
057C                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
057C                          ENDIF      
057C                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
057C                          ENDIF      
057C                          IFN   CPM   
057C   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
057F   7E           FNUL:     MOV   A,M   
0580   23                     INX   H   
0581   B7                     ORA   A   
0582   C2 7F 05               JNZ   fnul   
0585                          ENDIF      
0585   22 7C 82               SHLD   HEAP   
0588                          IF   CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              SHLD   NPEND   ;   release below it
0588                          ENDIF      
0588   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
058B   22 34 82               SHLD   RSP   
058E                          IF   (1-CHECKED)*(1-CPM)   
058E   67                     MOV   H,A   ; (A = 0, from the search for the NUL) no key
058F   6F                     MOV   L,A   ;   is held, and the break key is on (the
0590                          ENDIF      ;   checked build has cleared these)
0590                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0590                          ENDIF      
0590                          IF   1-CHECKED   
0590   22 7A 82               SHLD   KEYBUF   
0593                          ENDIF      
0593   01 00 83               LXI   B,PROG   ; the IP
0596                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0596                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0596   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0597   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0598   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0599                          IF   FAST   
0599                             ; =============================================================================
0599                             ;  The fast build (SPEED = 2)
0599                             ; 
0599                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
0599                             ;  addresses in one page and the high bytes in the next. The dispatcher (at
0599                             ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
0599                             ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
0599                             ; 
0599                             ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
0599                             ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
0599                             ; 
0599                             ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
0599                             ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
0599                             ;  the letters and digits have one entry each, which knows its cell or its
0599                             ;  value already.
0599                             ; =============================================================================
0599   EB           FTSTORE:   XCHG      ; !
059A   C3 69 01               JMP   h_store   
059D   EB           FTSTR:    XCHG      ; "
059E   C3 77 01               JMP   h_str   
05A1   EB           FTNUM:    XCHG      ; #
05A2   C3 89 01               JMP   h_num   
05A5   EB           FTPRINT:   XCHG      ; $
05A6   C3 80 01               JMP   h_print   
05A9   EB           FTEMIT:   XCHG      ; '
05AA   C3 83 01               JMP   h_emit   
05AD   EB           FTCSTORE:   XCHG      ; .
05AE   C3 71 01               JMP   h_cstore   
05B1   EB           FTDIV:    XCHG      ; /
05B2   C3 3C 01               JMP   h_div   
05B5   EB           FTKEY:    XCHG      ; ?
05B6   C3 92 01               JMP   h_key   
05B9   EB           FTDEF:    XCHG      ; [
05BA   C3 C2 00               JMP   h_def   
05BD   EB           FTBREAK:   XCHG      ; \
05BE   C3 B3 00               JMP   h_break   
05C1   EB           FTALLOC:   XCHG      ; _
05C2   C3 58 00               JMP   h_alloc   
05C5   EB           FTGRAVE:   XCHG      ; `
05C6   C3 8C 00               JMP   h_grave   
05C9                             ; The commonest punctuation, written for the fast build: TOS in DE on the
05C9                             ; way in, and the dispatcher inline on the way out.
05C9   E1           FS_ADD:   POP   H   ; +
05CA   19                     DAD   D   
05CB                          ;*Macro unroll:  NEXTF
05CB                          DS   FAST*CHECKED,0CDh   
05CB                          DS   FAST*CHECKED,ACHK&0FFh   
05CB                          DS   FAST*CHECKED,ACHK/256   
05CB   0A                     DS   FAST,0Ah   
05CC   03                     DS   FAST,03h   
05CD   EB                     DS   FAST,0EBh   
05CE   6F                     DS   FAST,6Fh   
05CF   26                     DS   FAST,26h   
05D0   0F                     DS   FAST,DTPG   
05D1   7E                     DS   FAST,7Eh   
05D2   24                     DS   FAST,24h   
05D3   66                     DS   FAST,66h   
05D4   6F                     DS   FAST,6Fh   
05D5   E9                     DS   FAST,0E9h   
05D6   0A           FS_SUB:   LDAX   B   ; -
05D7   D6 30                  SUI   "0"   
05D9   FE 0A                  CPI   10   
05DB   DA EF 05               JC   fs_neg   
05DE   E1                     POP   H   
05DF   7D                     MOV   A,L   
05E0   93                     SUB   E   
05E1   5F                     MOV   E,A   
05E2   7C                     MOV   A,H   
05E3   9A                     SBB   D   
05E4   57                     MOV   D,A   
05E5                          ;*Macro unroll:  NEXTD
05E5                          DS   FAST*CHECKED,0EBh   
05E5                          DS   FAST*CHECKED,0CDh   
05E5                          DS   FAST*CHECKED,ACHK&0FFh   
05E5                          DS   FAST*CHECKED,ACHK/256   
05E5   0A                     DS   FAST,0Ah   
05E6   03                     DS   FAST,03h   
05E7                          DS   FAST*CHECKED,0EBh   
05E7   6F                     DS   FAST,6Fh   
05E8   26                     DS   FAST,26h   
05E9   0F                     DS   FAST,DTPG   
05EA   7E                     DS   FAST,7Eh   
05EB   24                     DS   FAST,24h   
05EC   66                     DS   FAST,66h   
05ED   6F                     DS   FAST,6Fh   
05EE   E9                     DS   FAST,0E9h   
05EF   EB           FS_NEG:   XCHG      ; a digit next: a negative number
05F0   C3 F4 01               JMP   negnum   
05F3   D5           FS_DUP:   PUSH   D   ; :
05F4                          ;*Macro unroll:  NEXTD
05F4                          DS   FAST*CHECKED,0EBh   
05F4                          DS   FAST*CHECKED,0CDh   
05F4                          DS   FAST*CHECKED,ACHK&0FFh   
05F4                          DS   FAST*CHECKED,ACHK/256   
05F4   0A                     DS   FAST,0Ah   
05F5   03                     DS   FAST,03h   
05F6                          DS   FAST*CHECKED,0EBh   
05F6   6F                     DS   FAST,6Fh   
05F7   26                     DS   FAST,26h   
05F8   0F                     DS   FAST,DTPG   
05F9   7E                     DS   FAST,7Eh   
05FA   24                     DS   FAST,24h   
05FB   66                     DS   FAST,66h   
05FC   6F                     DS   FAST,6Fh   
05FD   E9                     DS   FAST,0E9h   
05FE   E1           FS_DROP:   POP   H   ; ;
05FF                          ;*Macro unroll:  NEXTF
05FF                          DS   FAST*CHECKED,0CDh   
05FF                          DS   FAST*CHECKED,ACHK&0FFh   
05FF                          DS   FAST*CHECKED,ACHK/256   
05FF   0A                     DS   FAST,0Ah   
0600   03                     DS   FAST,03h   
0601   EB                     DS   FAST,0EBh   
0602   6F                     DS   FAST,6Fh   
0603   26                     DS   FAST,26h   
0604   0F                     DS   FAST,DTPG   
0605   7E                     DS   FAST,7Eh   
0606   24                     DS   FAST,24h   
0607   66                     DS   FAST,66h   
0608   6F                     DS   FAST,6Fh   
0609   E9                     DS   FAST,0E9h   
060A   E1           FS_SWAP:   POP   H   ; %
060B   D5                     PUSH   D   
060C                          ;*Macro unroll:  NEXTF
060C                          DS   FAST*CHECKED,0CDh   
060C                          DS   FAST*CHECKED,ACHK&0FFh   
060C                          DS   FAST*CHECKED,ACHK/256   
060C   0A                     DS   FAST,0Ah   
060D   03                     DS   FAST,03h   
060E   EB                     DS   FAST,0EBh   
060F   6F                     DS   FAST,6Fh   
0610   26                     DS   FAST,26h   
0611   0F                     DS   FAST,DTPG   
0612   7E                     DS   FAST,7Eh   
0613   24                     DS   FAST,24h   
0614   66                     DS   FAST,66h   
0615   6F                     DS   FAST,6Fh   
0616   E9                     DS   FAST,0E9h   
0617   EB           FS_FET:   XCHG      ; @
0618   5E                     MOV   E,M   
0619   23                     INX   H   
061A   56                     MOV   D,M   
061B                          ;*Macro unroll:  NEXTD
061B                          DS   FAST*CHECKED,0EBh   
061B                          DS   FAST*CHECKED,0CDh   
061B                          DS   FAST*CHECKED,ACHK&0FFh   
061B                          DS   FAST*CHECKED,ACHK/256   
061B   0A                     DS   FAST,0Ah   
061C   03                     DS   FAST,03h   
061D                          DS   FAST*CHECKED,0EBh   
061D   6F                     DS   FAST,6Fh   
061E   26                     DS   FAST,26h   
061F   0F                     DS   FAST,DTPG   
0620   7E                     DS   FAST,7Eh   
0621   24                     DS   FAST,24h   
0622   66                     DS   FAST,66h   
0623   6F                     DS   FAST,6Fh   
0624   E9                     DS   FAST,0E9h   
0625   1A           FS_CFET:   LDAX   D   ; ,
0626   5F                     MOV   E,A   
0627   16 00                  MVI   D,0   
0629                          ;*Macro unroll:  NEXTD
