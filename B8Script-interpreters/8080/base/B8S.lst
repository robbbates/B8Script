03DC   3E 2D                  MVI   A,"-"   
03DE                          ;*Macro unroll:  PUTA
03DE                          DS   1-CPM,0EFh   
03DE   CD                     DS   CPM,0CDh   
03DF   FD                     DS   CPM,APUT&0FFh   
03E0   05                     DS   CPM,APUT/256   
03E1                          ;*Macro unroll:  NEGH
03E1                          DS   1-CPM,0E7h   
03E1   CD                     DS   CPM,0CDh   
03E2   27                     DS   CPM,ANEG&0FFh   
03E3   01                     DS   CPM,ANEG/256   
03E4                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03E4                             ; Uses BC.
03E4   11 0A 00     PDEC:     LXI   D,10   
03E7   CD 7F 03               CALL   udiv   ; HL = HL / 10, C = the last digit
03EA   79                     MOV   A,C   
03EB   F5                     PUSH   PSW   
03EC   7C                     MOV   A,H   
03ED   B5                     ORA   L   
03EE   C4 E4 03               CNZ   pdec   
03F1   F1                     POP   PSW   
03F2   C6 30                  ADI   "0"   
03F4                          ;*Macro unroll:  PUTA
03F4                          DS   1-CPM,0EFh   
03F4   CD                     DS   CPM,0CDh   
03F5   FD                     DS   CPM,APUT&0FFh   
03F6   05                     DS   CPM,APUT/256   
