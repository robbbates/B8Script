   446                              <1> 
   447                              <1> ; '_' ( n -- addr ): the heap pointer moves by n, a signed count; TOS is
   448                              <1> ; the old pointer. The checked build stops with H if the new top is not
   449                              <1> ; below the limit or is below the program's end (done in 32 bits, so a top
   450                              <1> ; that wraps round is caught too).
   451                              <1> %macro  ALLOCCODE 0
   452                              <1> alloc1: movzx   edx,word [ARENA+HEAP]
   453                              <1> %if CHECKED
   454                              <1>         movsx   eax,bx
   455                              <1>         add     eax,edx
   456                              <1>         cmp     eax,LIMIT
   457                              <1>         jae     e_heap
   458                              <1>         cmp     eax,[V(v_npend)]
   459                              <1>         jb      e_heap
   460                              <1> %endif
   461                              <1>         add     [ARENA+HEAP],bx
   462                              <1>         mov     bx,dx
   463                              <1>         jmp     ebp
   464                              <1> %endmacro
   465                              <1> 
   466                              <1> ; '/' ( a b -- q r ): truncates toward zero, and r takes a's sign: x86's
   467                              <1> ; IDIV does exactly that. It is done in 32 bits, so that -32768 / -1 (whose
   468                              <1> ; quotient, 32768, does not fit in 16) wraps as the spec says instead of
   469                              <1> ; faulting. Dividing by 0 skips the IDIV in an unchecked build (two cells of
   470                              <1> ; no meaning: a and its sign); the checked build stops with Z. (The handler
   471                              <1> ; itself in an unchecked build; in a checked or base one its body, div1;
   472                              <1> ; the fast build's fs_div is another copy.)
   473                              <1> %macro  DIVCODE 0
   474                              <1> %if CHECKED
   475                              <1>         test    bx,bx
   476                              <1>         jz      e_zero
   477                              <1> %endif
   478                              <1>         pop     eax
   479                              <1>         movsx   ecx,bx
   480                              <1> %if QK
   481                              <1>         lea     edx,[ecx-1]             ; (base: b a power of two? See DIVQ)
   482                              <1>         test    edx,ecx
   483                              <1>         jz      %%p
   484                              <1> %%o:
   485                              <1> %endif
   486                              <1>         cwde
   487                              <1>         cdq
   488                              <1> %if CHECKED=0
   489                              <1>         jecxz   %%z
   490                              <1> %endif
   491                              <1>         idiv    ecx
   492                              <1> %%z:    mov     bx,ax
   493                              <1>         push    ebx                     ; q
   494                              <1>         mov     bx,dx                   ; r on top
   495                              <1>         NEXTJ
   496                              <1> %if QK
   497                              <1> %%p:    DIVQ    %%o, %%z
   498                              <1> %endif
   499                              <1> %endmacro
   500                              <1> 
   501                              <1> ; DIVQ (base): '/' by a power of two, 2^k with k from 0 to 14, is shifts,
   502                              <1> ; with IDIV's results: |a| >> k and |a| & (b - 1), both negated if a < 0
   503                              <1> ; (-32768 is its own |a|, as an unsigned 16 bits). EAX = a (its low word),
   504                              <1> ; ECX = b, EDX = b - 1. (A power of two or 0: an unchecked build divides by
   505                              <1> ; 0 the regular way, at %1.) On to %2 with AX = q and DX = r. Shifts cost
   506                              <1> ; more instructions than one IDIV, but far fewer cycles: IDIV takes 20 to
   507                              <1> ; 40 (12 on the newest), the shifts a handful.
   508                              <1> %macro  DIVQ 2
   509                              <1> %if CHECKED=0
   510                              <1>         jecxz   %1
   511                              <1> %endif
   512                              <1>         bsf     ecx,ecx                 ; k
   513                              <1>         test    ax,ax
   514                              <1>         js      %%n
   515                              <1>         and     dx,ax                   ; r
   516                              <1>         shr     ax,cl                   ; q
   517                              <1>         jmp     %2
   518                              <1> %%n:    neg     ax                      ; |a|
   519                              <1>         and     dx,ax
   520                              <1>         shr     ax,cl
   521                              <1>         neg     ax                      ; q
   522                              <1>         neg     dx                      ; r
   523                              <1>         jmp     %2
   524                              <1> %endmacro
   525                              <1> 
   526                              <1> ; PRLOOPCODE: the loop of '$' (h_print; in a checked build the routine
   527                              <1> ; prstr). It prints from EBX to the closing quote.
   528                              <1> %macro  PRLOOPCODE 0
   529                              <1> %%pr:   mov     al,[ebx]
   530                              <1>         inc     ebx
   531                              <1>         cmp     al,22h
   532                              <1> %if CHECKED
   533                              <1>         je      %%pr9
   534                              <1>         test    al,al
   535                              <1>         jz      e_dollar                ; a NUL first: Q
   536                              <1> %else
   537                              <1>         je      h_drop
   538                              <1> %endif
   539                              <1>         cmp     al,'/'
   540                              <1>         jne     prput
   541                              <1>         movzx   eax,byte [ebx]
   542                              <1>         inc     ebx
   543                              <1>         cmp     al,60h
   544                              <1>         jb      %%pr0
   545                              <1>         cmp     al,7Fh
   546                              <1>         jb      pesc
   547                              <1> %%pr0:  and     al,0BFh
   548                              <1> prput:  CALLP   putc                    ; (/~ comes here with its 'H')
   549                              <1>         jmp     %%pr
   550                              <1> %if CHECKED
   551                              <1> %%pr9:  ret
   552                              <1> %endif
   553                              <1> %endmacro
   554                              <1> 
   555                              <1> ; PESCCODE: prstr (checked builds) and the escapes of '$'. (After the
   556                              <1> ; bodies of '[' and '`' in an unchecked build, so that h_print's loop
   557                              <1> ; reaches pesc; after the report in a checked one.)
   558                              <1> %macro  PESCCODE 0
   559                              <1> %if CHECKED
   560                              <1> ; prstr: print the string at EBX, to its closing quote, decoding '/' (this
   561                              <1> ; is '$', and the texts of the report). EBX is left past the quote. A NUL
   562                              <1> ; first is an error: Q.
   563                              <1> prstr:  PRLOOPCODE
   564                              <1> PRLOOP  equ     prstr                   ; (where the escapes go back to)
   565                              <1> %else
   566                              <1> PRLOOP  equ     h_print
   567                              <1> %endif
   568                              <1> 
   569                              <1> ; /~ ( row col addr -- ): the two cells under the string's address go.
   570                              <1> ; It comes before pesc: from there the short jumps reach h_print's loop.
   571                              <1> ; In a checked build the loop is the routine prstr: its return address
   572                              <1> ; goes, and hp1 calls it again afterwards. There each /~ first looks that
   573                              <1> ; its two cells are there, and is s if not, before it prints anything.
   574                              <1> pat:
   575                              <1> %if CHECKED
   576                              <1>         pop     eax
   577                              <1>         lea     eax,[esp+8]             ; ESP + 8 at the empty mark or above:
   578                              <1>         cmp     eax,[V(v_dstop)]        ;   the row or the column isn't there
   579                              <1>         jae     e_under
   580                              <1> %endif
   581                              <1>         call    pcsi
   582                              <1>         pop     eax                     ; the column
   583                              <1>         xchg    eax,[esp]               ; the row (the column waits)
   584                              <1>         call    psgn1
   585                              <1>         mov     al,';'
   586                              <1>         CALLP   putc
   587                              <1>         pop     eax
   588                              <1>         call    psgn1
   589                              <1>         mov     al,'H'
   590                              <1> %if CHECKED
   591                              <1>         CALLP   putc
   592                              <1>         jmp     hp1
   593                              <1> %else
   594                              <1>         jmp     prput
   595                              <1> %endif
   596                              <1> 
   597                              <1> ; pesc: the escapes of '$'. EAX = the character after the '/', 60h to 7Eh,
   598                              <1> ; and EBX points past it. Each goes back into the loop (PRLOOP), but /~ has
   599                              <1> ; the stack to see to.
   600                              <1> ;    /a-/z   print the variable, as '#' does
   601                              <1> ;    /{      clear the screen, the cursor to the top left: ESC [ H ESC [ J
   602                              <1> ;    /}      clear from the cursor to the end of the line: ESC [ K
   603                              <1> ;    /|  /`  show the cursor, hide it: ESC [ ? 2 5 h, ESC [ ? 2 5 l
   604                              <1> ;    /~      ( row col -- ) the cursor to that row and column, from 0:
   605                              <1> ;            ESC [ row+1 ; col+1 H
   606                              <1> pesc:   cmp     al,7Eh
   607                              <1>         je      pat
   608                              <1>         push    PRLOOP                  ; (the others return into the loop)
   609                              <1>         cmp     al,7Bh
   610                              <1>         jae     pcon
   611                              <1>         cmp     al,60h
   612                              <1>         je      phide
   613                              <1>         mov     ax,[ARENA+LET-2*41h+eax*2]  ; a-z: the variable's cell (as in
   614                              <1>         jmp     psgn                    ;   `lower`)
   615                              <1> pcon:   mov     eax,[ptails-4*7Bh+eax*4] ; { | }
   616                              <1> pseq:   push    eax                     ; ESC [ and then the bytes of EAX
   617                              <1>         call    pcsi
   618                              <1>         pop     eax
   619                              <1>         jmp     pch
   620                              <1> phide:  mov     eax,6C35323Fh           ; ? 2 5 l
   621                              <1>         jmp     pseq
   622                              <1> ptails: dd      4A5B1B48h               ; {  H ESC [ J
   623                              <1>         dd      6835323Fh               ; |  ? 2 5 h
   624                              <1>         dd      4Bh                     ; }  K
   625                              <1> ; pcsi: print ESC [. pch: print the bytes of EAX, from the low one up to the
   626                              <1> ; last that is not 0 (at least one). Both use EAX.
   627                              <1> pcsi:   mov     eax,5B1Bh
   628                              <1> pch:    CALLP   putc
   629                              <1>         shr     eax,8
   630                              <1>         jnz     pch
   631                              <1>         ret
   632                              <1> %endmacro
   633                              <1> 
   634                              <1> ; =============================================================================
   635                              <1> ;  Punctuation handlers. PTAB holds one byte per character: its handler's
   636                              <1> ;  distance from hbase, so every handler starts in the 256 bytes from hbase
   637                              <1> ;  (PT checks it). Only the starts must be there: the last handler, '$',
   638                              <1> ;  runs on past the window, and '[', '`' (and '_' in a checked build, and
   639                              <1> ;  '/' in a checked or base one) are stubs that jump to their bodies after
   640                              <1> ;  it. Each handler starts
   641                              <1> ;  with EBX = TOS and EAX, ECX, EDX free, and ends with JMP EBP.
   642                              <1> ;  (Two other layouts were tried: handlers 2-aligned with the table holding
   643                              <1> ;  half the distance, which costs a NOP after every handler of odd length,
   644                              <1> ;  about 22 bytes; and the Z80's two 256-byte windows, whose dispatcher is 7
   645                              <1> ;  bytes longer and whose handlers must be in table order, which costs near
   646                              <1> ;  jumps.)
   647                              <1> ; =============================================================================
   648                              <1> hbase:
   649                              <1> ; ']' returns: pop an address and jump to it.
   650 000000FB 8B37                <1> h_ret:  mov     esi,[edi]
   651 000000FD AF                  <1> rdrop:  scasd                           ; drop the return stack's top
   652 000000FE FFE5                <1> nx:     jmp     ebp
   653                              <1> 
   654                              <1> ; '\' ( flag -- ): true skips to the next ')' or ']' at this level; ')'
   655                              <1> ; drops the block start, ']' returns. No closer at all ends the program.
   656 00000100 6685DB              <1> h_break:test    bx,bx
   657 00000103 5B                  <1>         pop     ebx
   658 00000104 74F8                <1>         jz      nx
   659 00000106 E809030000          <1>         call    skip
   660 0000010B 84C0                <1>         test    al,al                   ; skip returns 0 for ')'
   661 0000010D 75EC                <1>         jnz     h_ret
   662 0000010F EBEC                <1>         jmp     rdrop
   663                              <1> 
   664                              <1> ; ')' ( flag -- ): true jumps back to the block start (and keeps it); false
   665                              <1> ; drops it and carries on. The loop-back looks at the break key.
   666 00000111 6685DB              <1> h_close:test    bx,bx
   667 00000114 5B                  <1>         pop     ebx
   668 00000115 74E6                <1>         jz      rdrop
   669 00000117 8B37                <1>         mov     esi,[edi]
   670 00000119 EBC9                <1>         jmp     rpoll
   671                              <1> 
   672                              <1> ; '(' ( flag -- ): true pushes the block start and enters; false skips to
   673                              <1> ; the matching ')'.
   674 0000011B 6685DB              <1> h_open: test    bx,bx
   675 0000011E 5B                  <1>         pop     ebx
   676 0000011F 0F8408010000        <1>         jz      skipo
   677 00000125 89F2                <1>         mov     edx,esi
   678 00000127 EBB6                <1>         jmp     rpush
   679                              <1> 
   680                              <1> ; '{' TOS to the return stack, '}' back.
   681 00000129 89DA                <1> h_tor:  mov     edx,ebx
   682 0000012B 5B                  <1>         pop     ebx
   683 0000012C EBB1                <1>         jmp     rpush
   684 0000012E 53                  <1> h_fromr:push    ebx
   685 0000012F 8B1F                <1>         mov     ebx,[edi]
   686 00000131 EBCA                <1>         jmp     rdrop
   687                              <1> 
   688                              <1> ; '@' fetches a cell.
   689 00000133 668B1B              <1> h_fetch:mov     bx,[ebx]
   690 00000136 FFE5                <1>         jmp     ebp
   691                              <1> 
   692                              <1> ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
   693                              <1> ; '-' has two jobs: directly before a digit it starts a negative number.
   694 00000138 8A06                <1> h_sub:  mov     al,[esi]
   695 0000013A 2C30                <1>         sub     al,'0'
   696 0000013C 3C0A                <1>         cmp     al,10
   697 0000013E 72B0                <1>         jb      negnum
   698 00000140 66F7DB              <1>         neg     bx                      ; a - b = a + (-b): on into '+'
   699 00000143 5A                  <1> h_add:  pop     edx
   700 00000144 6601D3              <1>         add     bx,dx
   701 00000147 FFE5                <1>         jmp     ebp
   702                              <1> 
   703 00000149 5A                  <1> h_and:  pop     edx
   704 0000014A 6621D3              <1>         and     bx,dx
   705 0000014D FFE5                <1>         jmp     ebp
   706 0000014F 5A                  <1> h_or:   pop     edx
   707 00000150 6609D3              <1>         or      bx,dx
   708 00000153 FFE5                <1>         jmp     ebp
   709 00000155 5A                  <1> h_xor:  pop     edx
   710 00000156 6631D3              <1>         xor     bx,dx
   711 00000159 FFE5                <1>         jmp     ebp
   712 0000015B 66F7D3              <1> h_not:  not     bx
   713 0000015E FFE5                <1>         jmp     ebp
   714 00000160 5A                  <1> h_mul:  pop     edx
   715 00000161 660FAFDA            <1>         imul    bx,dx                   ; the low 16 bits, signed or not
   716 00000165 FFE5                <1>         jmp     ebp
   717                              <1> 
   718                              <1> ; Signed compares. '<' swaps the two cells and is then '>': a > b is b < a.
   719                              <1> ; Flipping both sign bits turns the signed compare into an unsigned one, and
   720                              <1> ; SBB turns the carry into -1 or 0 with no branch.
   721 00000167 871C24              <1> h_lt:   xchg    ebx,[esp]
   722 0000016A 5A                  <1> h_gt:   pop     edx                     ; DX = a, BX = b
   723 0000016B 80F780              <1>         xor     bh,80h
   724 0000016E 80F680              <1>         xor     dh,80h
   725 00000171 6639D3              <1>         cmp     bx,dx                   ; carry if b < a
   726 00000174 6619DB              <1> tf:     sbb     bx,bx
   727 00000177 FFE5                <1>         jmp     ebp
   728 00000179 5A                  <1> h_eq:   pop     edx
   729 0000017A 6629D3              <1>         sub     bx,dx
   730 0000017D 6683FB01            <1>         cmp     bx,1                    ; carry only if a - b = 0
   731 00000181 EBF1                <1>         jmp     tf
   732                              <1> 
   733                              <1> 
   734                              <1> %if CHECKED || QK
   735                              <1> h_div:  jmp     div1                    ; ('/': its body is after the window)
   736                              <1> %else
   737                              <1> h_div:  DIVCODE
   737                              <2> h_div: 
