E2B6   A5 01                  LDA   IP+1   
E2B8   99 01 04               STA   LET+1,Y   
E2BB   D0 03                  BNE   dsk   ; always: no program is in page zero
E2BD   20 B8 E5     DEF2:     JSR   puship   ; an anonymous block: push its address
E2C0                DSK:         
E2C0                          IF   CHECKED   
E2C0   A9 29                  LDA   #")"   ; the wrong closer for [
E2C2                          ENDIF      
E2C2   4C D4 E4               JMP   skip   
E2C5                             ; ---- the grave
E2C5                             ; The grave is a prefix: with the character after it, it is one command.
E2C5                             ; GCH (after the three pages, with the handlers) holds the characters and
E2C5                             ; GLO, beside it, the low byte of each one's handler, less 1 for the RTS
E2C5                             ; trick. The high byte is worked out: the handlers lie in the order of the
E2C5                             ; table and take up less than a page, so they start in one page or in two,
E2C5                             ; and GK is the place in the table where the second page begins (the
E2C5                             ; assembler works it out, and chktab6502.py checks it). A handler starts
E2C5                             ; with Y = its place in the table, and ends in RTS. A character that is not
E2C5                             ; in the table is unsafe: the unchecked build does nothing, the checked
E2C5                             ; build stops with W.
E2C5                H_GRAVE:      
E2C5                          IF   CHECKED   
E2C5   E6 08                  INC   PLACE   ; the place of anything that goes wrong in
E2C7   D0 02                  BNE   gr0   ;   one of these is the character after the
E2C9   E6 09                  INC   PLACE+1   ;   grave
E2CB                GR0:         
E2CB                          ENDIF      
E2CB   20 3D E6               JSR   getc   
E2CE   A0 0C                  LDY   #GLO-GCH-1   
E2D0   D9 69 E3     GR1:      CMP   GCH,Y   
E2D3   F0 06                  BEQ   gr2   
E2D5   88                     DEY      
E2D6   10 F8                  BPL   gr1   
E2D8                          IF   1-CHECKED   
                              RTS      ; no such code
E2D8                          ENDIF      
E2D8                          IF   CHECKED   
E2D8   4C 9C E2               JMP   eb1   ; no such code: W
E2DB                          ENDIF      
E2DB   C0 06        GR2:      CPY   #GK   ; carry: the second page
E2DD   A9 E3                  LDA   #GQ0   
E2DF   69 00                  ADC   #0   
E2E1   48                     PHA      
E2E2   B9 76 E3               LDA   GLO,Y   
E2E5   48                     PHA      
E2E6   60                     RTS      ; to the handler
E2E7                             ; ---- "_" is the last handler: its body may leave the page
E2E7                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E2E7                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E2E7                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   0,X   
                              STA   HEAP   
                              STY   0,X   
                              LDA   HEAP+1   
                              TAY      
                              ADC   1,X   
                              STA   HEAP+1   
                              STY   1,X   
                              RTS      
E2E7                          ENDIF      
E2E7                             ; The checked build works the new top out first, in T0 and Y, and stops with
E2E7                             ; H, the count still on the stack, if it is at or past the limit, below the
E2E7                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E2E7                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E2E7                             ; a signed number from -8000h, so the add overflows exactly when the true
E2E7                             ; sum leaves 0000h-FFFFh.
E2E7                          IF   CHECKED   
E2E7   AD 7C 04     H_ALLOC:   LDA   HEAP   
E2EA   75 00                  ADC   0,X   
E2EC   85 04                  STA   T0   
E2EE   AD 7D 04               LDA   HEAP+1   
E2F1   49 80                  EOR   #80h   
E2F3   75 01                  ADC   1,X   
E2F5   70 25                  BVS   e_heap   ; wrapped
E2F7   49 80                  EOR   #80h   ; the new top's high byte
E2F9   C9 E0                  CMP   #HEAPLIM   
E2FB   B0 1F                  BCS   e_heap   ; at or past the limit
E2FD   A8                     TAY      
E2FE   A5 04                  LDA   T0   
E300   CD 38 04               CMP   PEND   
E303   98                     TYA      
E304   ED 39 04               SBC   PEND+1   
E307   90 13                  BCC   e_heap   ; below the program's end
E309   AD 7C 04               LDA   HEAP   
E30C   95 00                  STA   0,X   
E30E   A5 04                  LDA   T0   
E310   8D 7C 04               STA   HEAP   
E313   AD 7D 04               LDA   HEAP+1   
E316   95 01                  STA   1,X   
E318   8C 7D 04               STY   HEAP+1   
E31B   60                     RTS      
E31C                             ; Errors found by handlers. The stacks are as they were before the handler.
E31C   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E31E   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E31F   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E321   4C 57 E6               JMP   error   
E324                             ; chkst: stop unless the address in the top cell is in the program's own
E324                             ; space, from the letter page up to the heap limit. Keeps A and Y.
E324   48           CHKST:    PHA      
E325   B5 01                  LDA   1,X   
E327   C9 04                  CMP   #LETPAGE   
E329   90 F4                  BCC   e_store   
E32B   C9 E0                  CMP   #HEAPLIM   
E32D   B0 F0                  BCS   e_store   
E32F   68                     PLA      
E330   60                     RTS      
E331                          ENDIF      
E331                             ; =============================================================================
E331                             ;  The rest: no handler starts past this point
E331                             ; =============================================================================
