E26E   A1 00        H_FETCH:   LDA   (0,X)   ; "@"
E270   A8                     TAY      
E271   20 7D E2               JSR   inctos   
E274   A1 00                  LDA   (0,X)   
E276   95 01                  STA   1,X   
E278   94 00                  STY   0,X   
E27A   60                     RTS      
E27B                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E27B   A1 00        TOSGET:   LDA   (0,X)   
