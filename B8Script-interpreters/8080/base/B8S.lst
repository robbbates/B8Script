028E   F1                     POP   PSW   
028F   FC 27 01               CM   neg16   ; r's sign
0292   C1                     POP   B   
0293   D5                     PUSH   D   ; q under r
0294                          ;*Macro unroll:  NEXT
0294                          DS   (1-CPM)*(1-FAST),0F7h   
0294   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0295   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0296   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
