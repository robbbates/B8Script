E4B8                          ENDIF      
E4B8                             ; skpo: a false ( skips (the checked build: ] is the wrong closer for it)
E4B8                          IF   FAST*CHECKED   
                    SKPO:     LDA   #"]"   
                              JMP   skip   
E4B8                          ENDIF      
E4B8                          IF   FAST*(1-CHECKED)   
                    SKPO:     JMP   skip   
                                 ; ! and . (unchecked)
                    FT_STO:   LDY   #0   ; !
                              LDA   DSL,X   
                              STA   (TL),Y   
                              INY      
                              LDA   DSH,X   
                              STA   (TL),Y   
                              INX      
                              LDA   DSL,X   
