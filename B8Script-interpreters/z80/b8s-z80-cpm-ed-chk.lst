030B                             ;  More routines (no handler starts past this point)
030B                             ; =============================================================================
030B                          IF   CHECKED   
030B                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
030B                             ; "$", and the texts of the report). A NUL first is an error: Q.
030B   7E           PRSTR:    LD   A,(HL)   
030C   23                     INC   HL   
030D   FE 22                  CP   22h   
030F   C8                     RET   Z   
0310   B7                     OR   A   
0311   28 1F                  JR   Z,e_dollar   
0313   FE 2F                  CP   "/"   
0315   20 0C                  JR   NZ,prs1   
0317   7E                     LD   A,(HL)   
0318   23                     INC   HL   
0319   FE 60                  CP   60h   
031B   38 04                  JR   C,prs0   
031D   FE 7F                  CP   7Fh   
031F   38 1A                  JR   C,pesc   
0321   E6 BF        PRS0:     AND   0BFh   
0323   EF           PRS1:     RST   28h   
0324   18 E5                  JR   prstr   
0326                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0326                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0326                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0326                             ; pnl: the same, on a new line.
0326   3E 0D        PNL:      LD   A,13   
0328   EF                     RST   28h   
0329   3E 0A                  LD   A,10   
032B   EF                     RST   28h   
