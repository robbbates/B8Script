E464   99 01 04               STA   LET+1,Y   
E467   D0 03                  BNE   dsk   ; always: no program is in page zero
E469   20 02 EA     DEF2:     JSR   puship   ; an anonymous block: push its address
E46C                DSK:         
E46C                          IF   CHECKED   
                              LDA   #")"   ; the wrong closer for [
E46C                          ENDIF      
E46C   4C C2 E6               JMP   skip   
E46F                             ; ---- machine code: the grave
E46F                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E46F                             ; are stored from addr until a non-hex character; then a RET (60h) is
E46F                             ; written and its address is left. An odd last digit is consumed and dropped.
E46F                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E46F                             ; contract in the header.
E46F   20 74 EA     H_GRAVE:   JSR   rdhex   
E472   B0 1C                  BCS   exec   
E474   0A           HX1:      ASL      
E475   0A                     ASL      
E476   0A                     ASL      
E477   0A                     ASL      
E478   85 04                  STA   T0   
E47A   20 74 EA               JSR   rdhex   
E47D   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E47F   05 04                  ORA   T0   
E481   81 00                  STA   (0,X)   ; (never checked)
E483   20 46 E4               JSR   inctos   
E486   20 74 EA               JSR   rdhex   
E489   90 E9                  BCC   hx1   
E48B   A9 60        HX2:      LDA   #60h   
E48D   81 00                  STA   (0,X)   
E48F   60                     RTS      
E490   B5 00        EXEC:     LDA   0,X   
E492   85 04                  STA   T0   
E494   B5 01                  LDA   1,X   
E496   85 05                  STA   T1   
E498   E8                     INX      ; the address is consumed
E499   E8                     INX      
E49A   6C 04 00               JMP   (T0)   
E49D                             ; ---- "_" is the last handler: its body may leave the page
E49D                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E49D                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E49D                          IF   1-CHECKED   
E49D   AD 7C 04     H_ALLOC:   LDA   HEAP   
E4A0   A8                     TAY      
E4A1   75 00                  ADC   0,X   
E4A3   8D 7C 04               STA   HEAP   
E4A6   94 00                  STY   0,X   
E4A8   AD 7D 04               LDA   HEAP+1   
E4AB   A8                     TAY      
E4AC   75 01                  ADC   1,X   
E4AE   8D 7D 04               STA   HEAP+1   
E4B1   94 01                  STY   1,X   
E4B3   60                     RTS      
E4B4                          ENDIF      
E4B4                             ; The checked build works the new top out first, in T0 and Y, and stops with
E4B4                             ; H, the count still on the stack, if it is at or past the limit, below the
E4B4                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E4B4                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E4B4                             ; a signed number from -8000h, so the add overflows exactly when the true
E4B4                             ; sum leaves 0000h-FFFFh.
E4B4                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   0,X   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   1,X   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   0,X   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   1,X   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the address in the top cell is in the program's own
                                 ; space, from the letter page up to the heap limit. Keeps A and Y.
                    CHKST:    PHA      
                              LDA   1,X   
                              CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              PLA      
                              RTS      
E4B4                          ENDIF      
E4B4                             ; =============================================================================
E4B4                             ;  The rest: no handler starts past this point
