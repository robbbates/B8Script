F19F   8E 82 80               LDX   #LINEBUF   
F1A2   5F                     CLRB      
F1A3   BD FF 06     LN2:      JSR   getk   
F1A6   27 FB                  BEQ   ln2   
F1A8   81 0D                  CMPA   #13   
F1AA   27 16                  BEQ   ln5   
F1AC   81 08                  CMPA   #8   
F1AE   27 0C                  BEQ   ln4   
