                    H_STORE:   LDX   ,U   
                              BSR   chkst   
                              LEAX   1,X   
                              BSR   chkst   
                              LDA   2,U   
                              STA   ,X   
                                 ; and fall into ".", which loads X again (and checks it again)
E217                          ENDIF      
