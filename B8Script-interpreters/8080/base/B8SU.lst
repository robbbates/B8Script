03B8                          DS   1-CPM,0E7h   
03B8   CD                     DS   CPM,0CDh   
03B9   27                     DS   CPM,ANEG&0FFh   
03BA   01                     DS   CPM,ANEG/256   
03BB                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03BB                             ; Uses BC.
03BB   11 0A 00     PDEC:     LXI   D,10   
03BE   CD 56 03               CALL   udiv   ; HL = HL / 10, C = the last digit
03C1   79                     MOV   A,C   
03C2   F5                     PUSH   PSW   
03C3   7C                     MOV   A,H   
03C4   B5                     ORA   L   
03C5   C4 BB 03               CNZ   pdec   
03C8   F1                     POP   PSW   
03C9   C6 30                  ADI   "0"   
