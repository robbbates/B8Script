                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUL:      PSHS   Y   ; L
                              LDB   <16h   
                              LDA   <17h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuL1   
                              JSR   pk1   
