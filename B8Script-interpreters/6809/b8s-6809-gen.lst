0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Motorola 6809
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;  Follows the design of the Z80 interpreter (z80/b8s-z80.asm).
0000                             ; 
0000                             ;  Two builds, selected by the CHECKED line below (CPM is always 0: the 6809
0000                             ;  has no CP/M; the line is kept only so that build.sh works):
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80, M6809 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0 (no CP/M on the 6809)
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    Y    IP: the address of the next program character to read
0000                             ;    U    the data stack pointer. The stack grows down and U points at the
0000                             ;         top cell (TOS); nothing is cached in a register, because every
0000                             ;         dispatch needs A, B and X as scratch. Cells are big-endian here.
0000                             ;         (Only the stacks are big-endian: cells in RAM that the program can
0000                             ;         see - variables, the heap pointer, anything @ and ! reach - are
0000                             ;         little-endian, as the spec says, so @ and ! swap the bytes.)
0000                             ;    S    the return stack. A word call is a plain push of Y. Entries are
0000                             ;         2 bytes, big-endian. Handlers are called with JSR, so the return
0000                             ;         address of the dispatcher is on top of S while a handler runs.
0000                             ;    DP   the letter page, so the letter-page variables below cost 2-byte
0000                             ;         direct addressing. Nothing else may change DP.
0000                             ;    A B X are scratch. Every handler is entered by JSR [A,X] and ends in RTS
0000                             ;    (one byte); the handlers that push or pop the return stack first throw
0000                             ;    the dispatcher's return address away (LEAS 2,S) and end in BRA next.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM areas:
0000                             ; 
0000                             ;    8000h-80FFh  return stack, 127 entries; empty = 8100h; S stays inside
0000                             ;    8100h-81FFh  data stack, 127 cells; empty = 8200h; U stays inside
0000                             ;    8200h-82FFh  letter page (LET): A..Z at +00h..+33h, a..z at +40h..+73h
0000                             ;                 (a word cell is always 64 bytes below its variable), the
0000                             ;                 heap pointer at +7Ch (= z10+), interpreter variables in the
0000                             ;                 gaps, and the -n? line buffer at +80h..+FFh
0000                             ;    8300h-       PROG, the program text, NUL-terminated; the heap starts
0000                             ;                 after the NUL and grows to HEAPLIM*256 (F000h)
0000                             ;    F000h-       this image (ROM). The reset vector (FFFEh) must point to
0000                             ;                 `start` (F003h); the image does not contain it.
0000                             ;    FF03h-FF0Bh  the console routines (CONOUT, KEY) and EXIT are supplied
0000                             ;                 by the system and need no space here.
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LET..HEAPLIM*256.
0000                             ; -----------------------------------------------------------------------------
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (end the
0000                             ;   routine with TSTA / RTS, or a plain LDA).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   Both are called with JSR. They may change A and CC and must preserve
0000                             ;   B, X, Y, U and DP.
0000                RSPAGE:   EQU   80h   
0000                DSPAGE:   EQU   81h   
0000                LETPAGE:   EQU   82h   
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                MSLOOP:   EQU   20   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (direct-page offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   7Ch   ; z10+, the heap pointer (little-endian)
0000                KEYBUF:   EQU   34h   ; gap after Z: a key held back by the break check
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+100h   ; empty return stack
0000                DSTOP:    EQU   DSPAGE*256+100h   ; empty data stack
F000                          .ORG   0F000h   
F000                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F000                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F000                             ; the body"s address instead. Either way it then skips to the matching "]'.
F000   A6 A0        H_DEF:    LDA   ,Y+   
F002   1F 89                  TFR   A,B   
F004   C4 DF                  ANDB   #0DFh   ; fold case
F006   C0 41                  SUBB   #"A"   
F008   C1 1A                  CMPB   #26   
F00A   24 0D                  BHS   def2   ; not a letter
F00C   80 41                  SUBA   #"A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
F00E   BD F0 F7               JSR   cellx   
F011   1F 20                  TFR   Y,D   
F013   E7 84                  STB   ,X   ; little-endian
F015   A7 01                  STA   1,X   
F017   20 02                  BRA   skip   
F019                DEF2:        
F019                          IF   CHECKED   
                              CMPA   #" "   
                              LBNE   e_brack   ; anything but a letter or a space
F019                          ENDIF      
F019   36 20                  PSHU   Y   ; an anonymous block: push its address
F01B                             ; fall into skip
F01B                             ; skip: read past text to the closer at this level, and return it in A.
F01B                             ; Brackets of both kinds count together; strings are stepped over whole. A
F01B                             ; NUL first ends the program (for "\" with no closer; anything else that runs
F01B                             ; into the NUL had unbalanced brackets anyway).
F01B   5F           SKIP:     CLRB      ; B = nesting level
F01C   A6 A0        SK1:      LDA   ,Y+   
F01E   27 67                  BEQ   fin   
F020   81 22                  CMPA   #22h   
F022   26 04                  BNE   sk2   
F024   8D 1B                  BSR   skipstr   
F026   20 F4                  BRA   sk1   
F028   81 28        SK2:      CMPA   #"("   
F02A   27 10                  BEQ   sk3   
F02C   81 5B                  CMPA   #"["   
F02E   27 0C                  BEQ   sk3   
F030   81 29                  CMPA   #")"   
F032   27 04                  BEQ   sk4   
F034   81 5D                  CMPA   #"]"   
F036   26 E4                  BNE   sk1   
F038   5A           SK4:      DECB      
F039   2A E1                  BPL   sk1   
F03B   39                     RTS      ; the closer at this level
F03C   5C           SK3:      INCB      
F03D   20 DD                  BRA   sk1   
F03F                             ; 22h pushes the address of the text after it and skips the string.
F03F   36 20        H_STR:    PSHU   Y   
F041                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
F041                             ; the next character, so "/"" does not end it.
F041   A6 A0        SKIPSTR:   LDA   ,Y+   
F043   81 2F                  CMPA   #"/"   
F045   26 04                  BNE   ss1   
F047   31 21                  LEAY   1,Y   
F049   20 F6                  BRA   skipstr   
F04B   81 22        SS1:      CMPA   #22h   
F04D   26 F2                  BNE   skipstr   
F04F   39                     RTS      
F050                             ; =============================================================================
F050                             ;  Handlers that use the return stack. The dispatcher's return address is on
F050                             ;  top of S when they start; they discard it (LEAS 2,S) and finish with
F050                             ;  BRA next, or leave it and finish with RTS when they don't touch S.
F050                             ; =============================================================================
F050                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
F050                             ; the matching ")".
F050   EC C1        H_OPEN:   LDD   ,U++   
F052   27 C7                  BEQ   skip   ; tail call: skip ends in RTS
F054   32 62                  LEAS   2,S   
F056   34 20                  PSHS   Y   
F058   20 4D                  BRA   next   
F05A                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F05A                             ; drops it and carries on.
F05A   EC C1        H_CLOSE:   LDD   ,U++   
F05C   27 04                  BEQ   rdrop   
F05E                          IF   CHECKED   
                              JSR   chkbrk   ; Ctrl-C is checked at every loop-back
F05E                          ENDIF      
F05E   10 AE 62               LDY   2,S   ; the block start, under the return address
F061   39                     RTS      
F062   32 64        RDROP:    LEAS   4,S   ; the return address and the block start
F064   20 41                  BRA   next   
F066                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F066                             ; drops the block start, "]" returns. No closer at all ends the program.
F066   EC C1        H_BREAK:   LDD   ,U++   
F068   26 01                  BNE   brk1   
F06A   39                     RTS      
F06B   8D AE        BRK1:     BSR   skip   
F06D   81 29                  CMPA   #")"   
F06F   27 F1                  BEQ   rdrop   
F071                             ; fall into "]"
F071                             ; "]" returns: pop an address and jump to it.
F071   32 62        H_RET:    LEAS   2,S   
F073   35 20                  PULS   Y   
F075                          IF   CHECKED   
                              JSR   chkbrk   ; ... and at every word return
F075                          ENDIF      
F075   20 30                  BRA   next   
F077                             ; "{" ( n -- ) R: ( -- n )
F077   EC C1        H_TOR:    LDD   ,U++   
F079   32 62                  LEAS   2,S   
F07B   34 06                  PSHS   D   
F07D   20 28                  BRA   next   
F07F                             ; "}" ( -- n ) R: ( n -- )
F07F   32 62        H_FROMR:   LEAS   2,S   
F081   35 06                  PULS   D   
F083   36 06                  PSHU   D   
F085   20 20                  BRA   next   
F087   7E FF 09     FIN:      JMP   EXIT   ; the program has ended
F08A                             ; =============================================================================
F08A                             ;  Startup
F08A                             ; =============================================================================
F08A   10 CE 81 00  START:    LDS   #RSTOP   
F08E   CE 82 00               LDU   #DSTOP   
F091   86 82                  LDA   #LETPAGE   
F093   1F 8B                  TFR   A,DP   
F095   10 8E 83 00            LDY   #PROG   ; the heap starts after the program's NUL
F099   6D A0        SC:       TST   ,Y+   
F09B   26 FC                  BNE   sc   
F09D   1F 20                  TFR   Y,D   
F09F   D7 7C                  STB   <HEAP   
F0A1   97 7D                  STA   <HEAP+1   
F0A3                          IF   CHECKED   
                              CLR   <KEYBUF   
F0A3                          ENDIF      
F0A3   10 8E 83 00            LDY   #PROG   
F0A7                             ; =============================================================================
F0A7                             ;  The inner loop: read one character and sort it by range.
F0A7                             ; 
F0A7                             ;    00h          end of program
F0A7                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
F0A7                             ;    30h-39h      digit: read a whole number
F0A7                             ;    41h-5Ah      A-Z: call the word in that letter's cell
F0A7                             ;    61h-7Ah      a-z: push the address of that letter's cell
F0A7                             ;    the rest     punctuation: JSR through PTAB, 32 entries, in code order
F0A7                             ; =============================================================================
F0A7                NEXT:        
F0A7                          IF   CHECKED   
                                 ; Both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, and "empty" is the first address of
                                 ; the page above, so a stack is in range exactly when the address
                                 ; one below its pointer is in the page (127 entries or cells).
                              LEAX   -1,U   
                              TFR   X,D   
                              CMPA   #DSPAGE   
                              LBNE   e_stack   
                              LEAX   -1,S   
                              TFR   X,D   
                              CMPA   #RSPAGE   
                              LBNE   e_rstack   
F0A7                          ENDIF      
F0A7   A6 A0                  LDA   ,Y+   
F0A9   27 DC                  BEQ   fin   ; NUL ends the program
F0AB   80 21                  SUBA   #21h   ; A = c - 21h
F0AD   25 F8                  BLO   next   ; 01h-20h ignored
F0AF   81 0F                  CMPA   #0Fh   
F0B1   25 20                  BLO   punct   ; 21h-2Fh: PTAB index 0-14
F0B3   80 0F                  SUBA   #0Fh   ; A = c - 30h
F0B5   81 0A                  CMPA   #0Ah   
F0B7   25 26                  BLO   digit   ; 30h-39h
F0B9   81 11                  CMPA   #11h   
F0BB   25 14                  BLO   p3a   ; 3Ah-40h: index 15-21
F0BD   80 11                  SUBA   #11h   ; A = c - 41h
F0BF   81 1A                  CMPA   #1Ah   
F0C1   25 28                  BLO   upper   ; 41h-5Ah: A = letter index 0-25
F0C3   81 20                  CMPA   #20h   
F0C5   25 14                  BLO   p5b   ; 5Bh-60h: index 22-27
F0C7   81 3A                  CMPA   #3Ah   
F0C9   25 1A                  BLO   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
F0CB   81 3E                  CMPA   #3Eh   
F0CD   24 D8                  BHS   next   ; 7Fh-FFh: ignored
F0CF   80 23                  SUBA   #23h   ; 7Bh-7Eh: with the ADDA below, index 28-31
F0D1   8B 05        P3A:      ADDA   #5   ; 3Ah-40h: index 15-21
F0D3   48           PUNCT:    ASLA      ; PTAB entries are 2 bytes; A <= 62
F0D4   8E F0 FE               LDX   #PTAB   
F0D7   AD 96                  JSR   [A,X]   ; the handler ends in RTS
F0D9   20 CC                  BRA   next   
F0DB   80 04        P5B:      SUBA   #4   
F0DD   20 F4                  BRA   punct   
F0DF                             ; Digits: step back onto the first digit and read the whole number.
F0DF   31 3F        DIGIT:    LEAY   -1,Y   
F0E1   8D 5B                  BSR   rdnum   
F0E3   20 C2                  BRA   next   
F0E5                             ; a-z: push the cell's address (the cell is the variable)
F0E5   8D 10        LOWER:    BSR   cellx   
F0E7   36 10                  PSHU   X   
F0E9   20 BC                  BRA   next   
F0EB                             ; A-Z: call the word. The IP (the address after the letter) goes on the
F0EB                             ; return stack, and the IP becomes the address in the letter's cell.
F0EB   8D 0A        UPPER:    BSR   cellx   
F0ED   34 20                  PSHS   Y   
F0EF   E6 84                  LDB   ,X   
F0F1   A6 01                  LDA   1,X   
F0F3   1F 02                  TFR   D,Y   
F0F5   20 B0                  BRA   next   
F0F7                             ; cellx: A = letter index (0-25, or 32-57 for lowercase) -> X = cell address
F0F7   48           CELLX:    ASLA      
F0F8   8E 82 00               LDX   #LET   
F0FB   30 86                  LEAX   A,X   
F0FD   39                     RTS      
F0FE                             ; =============================================================================
F0FE                             ;  Dispatch table: one handler per punctuation character, in code order.
F0FE                             ; =============================================================================
F0FE   F2 61        PTAB:     FDB   h_store   ; !
F100   F0 3F                  FDB   h_str   ; "
F102   F1 C2                  FDB   h_num   ; #
F104   F2 80                  FDB   h_print   ; $
F106   F2 4B                  FDB   h_swap   ; %
F108   F2 0B                  FDB   h_and   ; &
F10A   F2 98                  FDB   h_emit   ; '
F10C   F0 50                  FDB   h_open   ; (
F10E   F0 5A                  FDB   h_close   ; )
F110   F1 E9                  FDB   h_mul   ; *
F112   F2 05                  FDB   h_add   ; +
F114   F2 5A                  FDB   h_cfetch   ; ,
F116   F1 60                  FDB   h_sub   ; -
F118   F2 6A                  FDB   h_cstore   ; .
F11A   F1 82                  FDB   h_div   ; /
F11C   F2 46                  FDB   h_dup   ; :
F11E   F2 9C                  FDB   drop   ; ;
F120   F2 2E                  FDB   h_lt   ; <
F122   F2 3C                  FDB   h_eq   ; =
F124   F2 36                  FDB   h_gt   ; >
F126   F2 A2                  FDB   h_key   ; ?
F128   F2 52                  FDB   h_fetch   ; @
F12A   F0 00                  FDB   h_def   ; [
F12C   F0 66                  FDB   h_break   ; \
F12E   F0 71                  FDB   h_ret   ; ]
F130   F2 1B                  FDB   h_xor   ; ^
F132   F2 71                  FDB   h_alloc   ; _
F134   F2 EB                  FDB   h_grave   ; `
F136   F0 77                  FDB   h_tor   ; {
F138   F2 13                  FDB   h_or   ; |
F13A   F0 7F                  FDB   h_fromr   ; }
F13C   F2 23                  FDB   h_not   ; ~
F13E                             ; rdnum: read decimal digits at IP and push the value; IP is left on the
F13E                             ; first non-digit. Values wrap at 16 bits, as the spec says. The running
F13E                             ; value lives in the new top cell: V = V*10 + digit.
F13E   4F           RDNUM:    CLRA      
F13F   5F                     CLRB      
F140   36 06                  PSHU   D   
F142   A6 A4        RD1:      LDA   ,Y   
F144   80 30                  SUBA   #"0"   
F146   81 0A                  CMPA   #10   
F148   24 37                  BHS   ab9   
F14A   31 21                  LEAY   1,Y   
F14C   34 02                  PSHS   A   
F14E   EC C4                  LDD   ,U   
F150   58                     ASLB      
F151   49                     ROLA      
F152   58                     ASLB      
F153   49                     ROLA      
F154   E3 C4                  ADDD   ,U   ; 5V
F156   58                     ASLB      
F157   49                     ROLA      ; 10V
F158   EB E0                  ADDB   ,S+   
F15A   89 00                  ADCA   #0   
F15C   ED C4                  STD   ,U   
F15E   20 E2                  BRA   rd1   
F160                             ; =============================================================================
F160                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
F160                             ; =============================================================================
F160                             ; "-" has two jobs: directly before a digit it starts a negative number.
F160   A6 A4        H_SUB:    LDA   ,Y   
F162   80 30                  SUBA   #"0"   
F164   81 0A                  CMPA   #10   
F166   25 0D                  BLO   negnum   
F168   EC 42                  LDD   2,U   
F16A   A3 C1                  SUBD   ,U++   
F16C   ED C4                  STD   ,U   
F16E   39                     RTS      
F16F                             ; absx: negate the cell at X if it is negative. negt: negate the top cell.
F16F                             ; negx: negate the cell at X.
F16F   6D 84        ABSX:     TST   ,X   
F171   2A 0E                  BPL   ab9   
F173   20 04                  BRA   negx   
F175   8D C7        NEGNUM:   BSR   rdnum   ; a negative literal: read it, then negate
F177   1F 31        NEGT:     TFR   U,X   
F179   EC 84        NEGX:     LDD   ,X   
F17B   40                     NEGA      
F17C   50                     NEGB      
F17D   82 00                  SBCA   #0   
F17F   ED 84                  STD   ,X   
F181   39           AB9:      RTS      
F182                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
F182                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F182                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
F182   A6 42        H_DIV:    LDA   2,U   
F184   34 02                  PSHS   A   ; a's sign: for r
F186   A8 C4                  EORA   ,U   
F188   34 02                  PSHS   A   ; a xor b: for q
F18A   30 42                  LEAX   2,U   
F18C   8D E1                  BSR   absx   ; |a|
F18E   1F 31                  TFR   U,X   
F190   8D DD                  BSR   absx   ; |b|
F192   8D 13                  BSR   udiv   ; NOS = q, TOS = r
F194   BD F2 4B               JSR   h_swap   ; NOS = r, TOS = q
F197   1F 31                  TFR   U,X   
F199   6D E0                  TST   ,S+   
F19B   2A 02                  BPL   dv1   
F19D   8D DA                  BSR   negx   ; q's sign
F19F   30 42        DV1:      LEAX   2,U   
F1A1   6D E0                  TST   ,S+   
F1A3   2A DC                  BPL   ab9   
F1A5   20 D2                  BRA   negx   ; r's sign
F1A7                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F1A7                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F1A7                             ; the TOS cell the remainder. The remainder is built in D (always < the
F1A7                             ; divisor, so 2R+1 fits in 16 bits).
F1A7   8E 00 10     UDIV:     LDX   #16   
F1AA   4F                     CLRA      
F1AB   5F                     CLRB      
F1AC   68 43        UD1:      ASL   3,U   
F1AE   69 42                  ROL   2,U   ; the dividend's top bit ...
F1B0   59                     ROLB      
F1B1   49                     ROLA      ; ... into the remainder
F1B2   10 A3 C4               CMPD   ,U   
F1B5   25 04                  BLO   ud2   
F1B7   A3 C4                  SUBD   ,U   
F1B9   6C 43                  INC   3,U   ; a quotient bit
F1BB   30 1F        UD2:      LEAX   -1,X   
F1BD   26 ED                  BNE   ud1   
F1BF   ED C4                  STD   ,U   
F1C1   39                     RTS      
F1C2                             ; "#" prints TOS as a signed decimal number, with no space after it.
F1C2   6D C4        H_NUM:    TST   ,U   
F1C4   2A 07                  BPL   pdec   
F1C6   86 2D                  LDA   #"-"   
F1C8   BD FF 03               JSR   CONOUT   
F1CB   8D AA                  BSR   negt   
F1CD                             ; pdec: print the top cell as unsigned and drop it, by recursion on /10
F1CD   CC 00 0A     PDEC:     LDD   #10   
F1D0   36 06                  PSHU   D   
F1D2   8D D3                  BSR   udiv   ; NOS = quotient, TOS = digit
F1D4   37 06                  PULU   D   ; the digit
F1D6   34 04                  PSHS   B   
F1D8   EC C4                  LDD   ,U   
F1DA   27 04                  BEQ   pd1   
F1DC   8D EF                  BSR   pdec   
F1DE   20 02                  BRA   pd2   
F1E0   33 42        PD1:      LEAU   2,U   ; drop the zero quotient
F1E2   35 02        PD2:      PULS   A   
F1E4   8B 30                  ADDA   #"0"   
F1E6   7E FF 03               JMP   CONOUT   
F1E9                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F1E9                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F1E9   A6 43        H_MUL:    LDA   3,U   
F1EB   E6 C4                  LDB   ,U   
F1ED   3D                     MUL      ; al*bh
F1EE   E7 C4                  STB   ,U   ; (bh is no longer needed)
F1F0   A6 42                  LDA   2,U   
F1F2   E6 41                  LDB   1,U   
F1F4   3D                     MUL      ; ah*bl
F1F5   EB C4                  ADDB   ,U   
