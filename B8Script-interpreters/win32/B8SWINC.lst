  1333                              <1> ; =============================================================================
  1334                              <1> ;  Routines
  1335                              <1> ; =============================================================================
  1336                              <1> 
  1337                              <1> ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
  1338                              <1> ; and return its value in AL with the carry set; otherwise leave the IP and
  1339                              <1> ; return with the carry clear.
  1340 00000667 8A06                <1> hexc:   mov     al,[esi]
  1341 00000669 2C30                <1>         sub     al,'0'
  1342 0000066B 3C0A                <1>         cmp     al,10
  1343 0000066D 720A                <1>         jb      .hc1
  1344 0000066F 24DF                <1>         and     al,0DFh
  1345 00000671 2C11                <1>         sub     al,11h
  1346 00000673 3C06                <1>         cmp     al,6
  1347 00000675 7303                <1>         jae     .hc2
  1348 00000677 2CF6                <1>         sub     al,0F6h                 ; + 10, and sets the carry
  1349 00000679 46                  <1> .hc1:   inc     esi
  1350 0000067A C3                  <1> .hc2:   ret
  1351                              <1> 
  1352                              <1> ; rdnum: read decimal digits at IP into BX (and DX); IP is left on the
  1353                              <1> ; first non-digit. Values wrap at 16 bits, as the spec says.
  1354 0000067B 31D2                <1> rdnum:  xor     edx,edx
  1355 0000067D 0FB606              <1> .rn1:   movzx   eax,byte [esi]
  1356 00000680 2C30                <1>         sub     al,'0'
  1357 00000682 3C0A                <1>         cmp     al,10
  1358 00000684 7308                <1>         jae     .rn2
