   906                              <1> ; ---- Speed-ups (base builds) ---------------------------------------------
   907                              <1> ; base takes what pays on x86 of the Z80's base: the skip cache and the
   908                              <1> ; faster skip (at skip), '/' by a power of two as shifts (DIVQ), and in the
   909                              <1> ; unchecked build a variable then '@' or '!' in one step (here). The Z80's
   910                              <1> ; '*' in 8 rounds has nothing to do here: x86 has IMUL. Nor has its true
   911                              <1> ; ')': this ')' reads the block start where it is in every build.
   912                              <1> %if SBASEU
   913                              <1> ; a-z, in the unchecked base build: a variable followed by '@' or '!' is
   914                              <1> ; fetched or stored in the same step (x@ is the commonest pair in most
   915                              <1> ; programs). (A checked build checks the stacks between the two, so it keeps
   916                              <1> ; them apart.)
   917 00000316 8D940000014100      <1> lower:  lea     edx,[ARENA+LET+eax*2]   ; EDX -> the cell
   918 0000031D 8A06                <1>         mov     al,[esi]
   919 0000031F 3C40                <1>         cmp     al,'@'
   920 00000321 7409                <1>         je      .lw1
   921 00000323 3C21                <1>         cmp     al,'!'
   922 00000325 740C                <1>         je      .lw2
   923 00000327 53                  <1>         push    ebx                     ; neither: push the cell's address
   924 00000328 89D3                <1>         mov     ebx,edx
   925 0000032A FFE5                <1>         jmp     ebp
   926 0000032C 46                  <1> .lw1:   inc     esi                     ; x@: TOS = the cell's value
   927 0000032D 53                  <1>         push    ebx
   928 0000032E 668B1A              <1>         mov     bx,[edx]
   929 00000331 FFE5                <1>         jmp     ebp
   930 00000333 46                  <1> .lw2:   inc     esi                     ; x!: the cell = TOS, and NOS comes up
   931 00000334 66891A              <1>         mov     [edx],bx
   932 00000337 5B                  <1>         pop     ebx
   933 00000338 FFE5                <1>         jmp     ebp
   934                              <1> %endif
