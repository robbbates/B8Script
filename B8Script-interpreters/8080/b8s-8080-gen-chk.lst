0300   E5           G_SEED:   PUSH   H   
0301   21 76 82               LXI   H,SEED   
0304   F7                     RST   6   
0305                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
0305                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
0305                             ; and the low ones repeat soon, so the high byte is folded into the low
0305                             ; (XOR) before the remainder of dividing by n is taken.
0305                             ; n must be 1 to 32767: the checked build stops with Z on anything less
0305                             ; than 1.
0305                G_RND:       
0305                          IF   CHECKED   
0305   2B                     DCX   H   
0306   7C                     MOV   A,H   ; n - 1 negative: n is 0 or less
0307   23                     INX   H   
0308   B7                     ORA   A   
0309   FA EF 04               JM   e_zero   
030C                          ENDIF      
