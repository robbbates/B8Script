  1608                              <1>         push    0
  1609                              <1>         lea     edx,[V(v_cnt)]
  1610                              <1>         push    edx
  1611                              <1>         push    ecx
  1612                              <1>         push    ARENA+PROG
  1613                              <1>         push    eax
  1614                              <1>         call    [V(iat_WriteFile)]
  1615                              <1>         call    [V(iat_CloseHandle)]
  1616                              <1>         jmp     gedit
  1617                              <1> 
  1618                              <1> ; setname: if a name was typed (the line does not start with its CR), it is
  1619                              <1> ; the file's name from now on, as typed (a Windows path).
