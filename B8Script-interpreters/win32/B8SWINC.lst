     1                                  %define CHECKED 1
     2                                  %define EDITOR 0
     3                                  [map all B8SWINC.map]
     4                                  %include "/home/user/B8Script/B8Script-interpreters/win32/b8s-win32.asm"
     1                              <1> ; =============================================================================
     2                              <1> ;  B8Script interpreter for 32-bit Windows (x86, console subsystem)
     3                              <1> ;  Spec: docs/b8script.md (2026-11-23).
     4                              <1> ;
     5                              <1> ;  Assembler: NASM 2.16, flat binary output: the PE header is laid out by
     6                              <1> ;  hand at the top of this file, so the output IS the .EXE:
     7                              <1> ;
     8                              <1> ;      nasm -f bin -o B8SWIN.EXE b8s-win32.asm
     9                              <1> ;      nasm -f bin -DCHECKED=1 -o B8SWINC.EXE b8s-win32.asm
    10                              <1> ;      nasm -f bin -DEDITOR=1 -o B8SWINE.EXE b8s-win32.asm
    11                              <1> ;      nasm -f bin -DEDITOR=1 -DCHECKED=1 -o B8SWINEC.EXE b8s-win32.asm
    12                              <1> ;
    13                              <1> ;  Two switches (the defaults below, or -D on the command line):
    14                              <1> ;    CHECKED  0 = no checks (spec: the programmer is responsible)
    15                              <1> ;             1 = starts with every variable at 0 and every word undefined,
    16                              <1> ;                 and stops on every error in the spec's table (and Ctrl-C)
    17                              <1> ;                 with the four-line report, on the standard error handle.
    18                              <1> ;    EDITOR   0 = a runner: B8SWIN PROG.B8S loads the file, runs it, exits
    19                              <1> ;             1 = the line editor of the spec's suggested standard (the same
    20                              <1> ;                 editor as the Z80's, key for key); the file named on the
    21                              <1> ;                 command line is the program to start with.
    22                              <1> ;
    23                              <1> ;  In every build Ctrl-C stops a running program (an unchecked runner stops
    24                              <1> ;  without a word): see the console layer for the rules, the held key and
    25                              <1> ;  the break-off cell.
    26                              <1> ; =============================================================================
    27                              <1> 
    28                              <1> %ifndef CHECKED
    29                              <1> %define CHECKED 0
    30                              <1> %endif
    31                              <1> %ifndef EDITOR
    32                              <1> %define EDITOR  0
    33                              <1> %endif
    34                              <1> 
    35                              <1> ; -----------------------------------------------------------------------------
    36                              <1> ;  The machine model
    37                              <1> ;
    38                              <1> ;  B8Script is defined for a 64 KB machine with 16-bit cells, and that is what
    39                              <1> ;  runs here. The 64 KB arena sits at ARENA (00410000h), a multiple of 64 KB,
    40                              <1> ;  inside the image (its last 64 KB of uninitialised space): the B8Script
    41                              <1> ;  address a is the byte at ARENA + a. Because the arena is 64 KB aligned,
    42                              <1> ;  "ARENA + a" is simply a 32-bit register whose high word is 0041h and whose
    43                              <1> ;  low word is a. Every cell the interpreter keeps in a 32-bit register or
    44                              <1> ;  stack slot is kept in that form, so it is at once the 16-bit cell (its low
    45                              <1> ;  word) and a pointer to that cell's address:
    46                              <1> ;
    47                              <1> ;    EBX  TOS. 16-bit operations work on BX; EBX's high word is always 0041h,
    48                              <1> ;         so [EBX] is the byte TOS points at.
    49                              <1> ;    ESI  IP: a pointer to the next program character (LODSB reads it).
    50                              <1> ;    ESP  the data stack: one dword per cell, low word the cell, high word
    51                              <1> ;         0041h. [ESP] is NOS. It is the thread's own stack (the API calls
    52                              <1> ;         push their arguments below it). V_DSTOP holds ESP for the empty
    53                              <1> ;         stack.
    54                              <1> ;    EDI  the return stack pointer: dword entries (IP values and cells parked
    55                              <1> ;         with '{', all in the same form), growing down from RSTOP. A pop is
    56                              <1> ;         MOV r,[EDI] / SCASD (SCASD only steps EDI on by 4).
    57                              <1> ;    EBP  the address of `next`: every handler ends with JMP EBP (2 bytes),
    58                              <1> ;         and the interpreter's own variables and the import address table
    59                              <1> ;         lie within 127 bytes of `next`, so [EBP+d8] reaches them in 3-byte
    60                              <1> ;         instructions. (V() below names them.)
    61                              <1> ;    EAX ECX EDX  scratch. (The Windows API keeps EBX, ESI, EDI and EBP.)
    62                              <1> ;
    63                              <1> ;  Memory map of the arena (B8Script addresses):
    64                              <1> ;    0000h-00FFh  page zero: unused, and left zero. An undefined word's cell
    65                              <1> ;                 holds 0000h, so calling it runs into the NUL at 0000h; the
    66                              <1> ;                 checked build sees that the IP is 0001h there and reports U.
    67                              <1> ;    0100h        the letter page: A-Z at +00h..+33h, a-z at +40h..+73h (a
    68                              <1> ;                 word's cell is 64 bytes below its variable's), the held key
    69                              <1> ;                 at +7Ah, the break-off cell at +7Bh, the heap pointer at +7Ch,
    70                              <1> ;                 and the -n? line buffer at +80h..+FFh (127 characters and CR;
    71                              <1> ;                 the editor's input line uses it too)
    72                              <1> ;    0200h        PROG: the program text, ending in NUL; the heap starts after
    73                              <1> ;                 the NUL and may grow up to the heap limit, FF00h
    74                              <1> ;    FF00h-FFFFh  above the limit: not the program's (unused)
    75                              <1> ;  The stacks are outside the arena: the return stack is 112 entries below
    76                              <1> ;  RSTOP (in the image's uninitialised space below the arena) and the data
    77                              <1> ;  stack is the thread's stack (127 cells in the checked builds, as deep as
    78                              <1> ;  the 1 MB stack reserve allows in the others).
    79                              <1> ;
    80                              <1> ;  The whole image (code, arena) is one section, readable, writable and
    81                              <1> ;  executable, so machine code can run in the arena (see h_grave).
    82                              <1> ; -----------------------------------------------------------------------------
    83                              <1> 
    84                              <1> IB      equ     400000h         ; ImageBase
    85                              <1> SECTVA  equ     1000h           ; the section's RVA
    86                              <1> ARENA   equ     410000h         ; the 64 KB B8Script memory (RVA 10000h)
    87                              <1> IMGSIZE equ     20000h          ; SizeOfImage: the arena is its last 64 KB
    88                              <1> 
    89                              <1> LET     equ     0100h           ; the letter page (a B8Script address)
    90                              <1> HELD    equ     LET+7Ah         ; a key read by the break check, held for the
    91                              <1>                                 ;   next '?' (0: none)
    92                              <1> BRKOFF  equ     LET+7Bh         ; the break-off cell: a non-zero byte here
    93                              <1>                                 ;   makes Ctrl-C a key like any other
    94                              <1> SEED    equ     LET+76h         ; the random seed (a cell): the one whose
    95                              <1>                                 ;   address `. gives. It starts as the tick
    96                              <1>                                 ;   count, and a key that '?' waits for adds
    97                              <1>                                 ;   the tick count again
    98                              <1> HEAP    equ     LET+7Ch         ; the heap pointer (a cell)
    99                              <1> LINEBUF equ     LET+80h         ; the -n? line buffer
   100                              <1> PROG    equ     0200h           ; the program text
   101                              <1> HEAPLIM equ     0FFh            ; the heap limit, as a page: FF00h
   102                              <1> LIMIT   equ     HEAPLIM*256
   103                              <1> MAXFILE equ     LIMIT-PROG-3    ; the most a file may bring (room for CR LF NUL)
   104                              <1> 
   105                              <1> RSTOP   equ     IB+0FF00h       ; the empty return stack (it grows down)
   106                              <1> RSMAX   equ     112             ; return stack entries (checked builds)
   107                              <1> DSMAX   equ     127             ; data stack cells (checked builds)
   108                              <1> NAMEBUF equ     IB+0F000h       ; the file's name, as typed (up to 3.5 KB)
   109                              <1> 
   110                              <1> ; -----------------------------------------------------------------------------
   111                              <1> ;  The PE header, by the documented rules: a 64-byte DOS header whose
   112                              <1> ;  e_lfanew points at the PE signature, the COFF header, the PE32 optional
   113                              <1> ;  header with its 16 data directories, and one section header. Then zeros
   114                              <1> ;  up to SizeOfHeaders (200h, one FileAlignment).
   115                              <1> ; -----------------------------------------------------------------------------
   116                              <1>         bits    32
   117                              <1>         section hdr start=0 vstart=IB
   118 00000000 4D5A                <1>         dw      'MZ'                    ; e_magic
   119 00000002 00<rep 3Ah>         <1>         times   3Ch-($-$$) db 0
   120 0000003C [4000C0FF]          <1>         dd      pe-IB                   ; e_lfanew
   121 00000040 50450000            <1> pe:     db      'PE',0,0
   122 00000044 4C01                <1>         dw      14Ch                    ; Machine: i386
   123 00000046 0100                <1>         dw      1                       ; NumberOfSections
   124 00000048 00000000            <1>         dd      0                       ; TimeDateStamp
   125 0000004C 0000000000000000    <1>         dd      0, 0                    ; no COFF symbols
   126 00000054 E000                <1>         dw      opthdr_end-opthdr       ; SizeOfOptionalHeader (224)
   127 00000056 0F01                <1>         dw      010Fh                   ; RELOCS_STRIPPED, EXECUTABLE_IMAGE,
   128                              <1>                                         ;   LINE_NUMS_STRIPPED,
   129                              <1>                                         ;   LOCAL_SYMS_STRIPPED, 32BIT_MACHINE
   130 00000058 0B01                <1> opthdr: dw      10Bh                    ; PE32
   131 0000005A 0100                <1>         db      1, 0                    ; linker version
   132 0000005C 000A0000            <1>         dd      RAWSIZE                 ; SizeOfCode
   133 00000060 000A0000            <1>         dd      RAWSIZE                 ; SizeOfInitializedData
   134 00000064 00000000            <1>         dd      0                       ; SizeOfUninitializedData
   135 00000068 [0000C0FF]          <1>         dd      start-IB                ; AddressOfEntryPoint
   136 0000006C 00100000            <1>         dd      SECTVA                  ; BaseOfCode
   137 00000070 00100000            <1>         dd      SECTVA                  ; BaseOfData
   138 00000074 00004000            <1>         dd      IB                      ; ImageBase
   139 00000078 00100000            <1>         dd      1000h                   ; SectionAlignment
   140 0000007C 00020000            <1>         dd      200h                    ; FileAlignment
   141 00000080 04000000            <1>         dw      4, 0                    ; OS version 4.0
   142 00000084 00000000            <1>         dw      0, 0                    ; image version
   143 00000088 04000000            <1>         dw      4, 0                    ; subsystem version 4.0
   144 0000008C 00000000            <1>         dd      0                       ; Win32VersionValue
   145 00000090 00000200            <1>         dd      IMGSIZE                 ; SizeOfImage
   146 00000094 00020000            <1>         dd      200h                    ; SizeOfHeaders
   147 00000098 00000000            <1>         dd      0                       ; CheckSum
   148 0000009C 0300                <1>         dw      3                       ; Subsystem: Windows console
   149 0000009E 0000                <1>         dw      0                       ; DllCharacteristics: none
   150 000000A0 0000100000100000    <1>         dd      100000h, 1000h          ; stack reserve, commit
   151 000000A8 0000100000100000    <1>         dd      100000h, 1000h          ; heap reserve, commit
   152 000000B0 00000000            <1>         dd      0                       ; LoaderFlags
   153 000000B4 10000000            <1>         dd      16                      ; NumberOfRvaAndSizes
   154 000000B8 0000000000000000    <1>         dd      0, 0                    ; 0 export
   155 000000C0 [B007C0FF]28000000  <1>         dd      idesc-IB, idesc_end-idesc ; 1 import
   156 000000C8 00000000<rep 14h>   <1>         times   10*2 dd 0               ; 2-11
   157 00000118 [2009C0FF]3C000000  <1>         dd      iat-IB, iat_end-iat     ; 12 IAT
   158 00000120 00000000<rep 6h>    <1>         times   3*2 dd 0                ; 13-15
   159                              <1> opthdr_end:
   160 00000138 2E74657874000000    <1>         db      '.text',0,0,0           ; the one section
   161 00000140 00F00100            <1>         dd      IMGSIZE-SECTVA          ; VirtualSize: code, then zeros up to
   162                              <1>                                         ;   the arena's end
   163 00000144 00100000            <1>         dd      SECTVA                  ; VirtualAddress
   164 00000148 000A0000            <1>         dd      RAWSIZE                 ; SizeOfRawData
   165 0000014C 00020000            <1>         dd      200h                    ; PointerToRawData
   166 00000150 0000000000000000    <1>         dd      0, 0                    ; no relocations, no line numbers
   167 00000158 00000000            <1>         dw      0, 0
   168 0000015C 600000E0            <1>         dd      0E0000060h              ; code, initialised data, execute,
   169                              <1>                                         ;   read, write
   170 00000160 00<rep A0h>         <1>         times   200h-($-$$) db 0
   171                              <1> 
   172                              <1> ; =============================================================================
   173                              <1> ;  The code
   174                              <1> ; =============================================================================
   175                              <1>         section text start=200h vstart=IB+SECTVA
   176                              <1> tstart:
   177                              <1> %define V(x) ebp+(x)-next               ; a variable or IAT slot near `next`
   178                              <1> 
   179                              <1> ; ---- startup ----------------------------------------------------------------
   180                              <1> ; The data stack starts empty; the cell pushed here stands for TOS, as when
   181                              <1> ; the editor has the stack in memory: the run starts by popping it.
   182 00000000 BD[9A090000]        <1> start:  mov     ebp,next
   183 00000005 BE00024100          <1>         mov     esi,ARENA+PROG
   184 0000000A 896566              <1>         mov     [V(v_dstop)],esp
   185 0000000D 56                  <1>         push    esi                     ; (the cell that stands for TOS)
   186 0000000E 6AF6                <1>         push    -10                     ; STD_INPUT_HANDLE
   187 00000010 FF5586              <1>         call    [V(iat_GetStdHandle)]
   188 00000013 89455A              <1>         mov     [V(v_hin)],eax
   189 00000016 6AF5                <1>         push    -11                     ; STD_OUTPUT_HANDLE
   190 00000018 FF5586              <1>         call    [V(iat_GetStdHandle)]
   191 0000001B 894562              <1>         mov     [V(v_outh)],eax
   192                              <1>         ; Raw keys: no echo, no line editing, Ctrl-C as a key (mode 0). If
   193                              <1>         ; the input is not a console, GetConsoleMode fails, and the keys are
   194                              <1>         ; read as bytes with ReadFile (see waitk).
   195 0000001E 8D4D6C              <1>         lea     ecx,[V(v_mode)]
   196 00000021 51                  <1>         push    ecx
   197 00000022 FF755A              <1>         push    dword [V(v_hin)]
   198 00000025 FF558A              <1>         call    [V(iat_GetConsoleMode)]
   199 00000028 88456A              <1>         mov     [V(v_iscon)],al
   200 0000002B 6A00                <1>         push    0
   201 0000002D FF755A              <1>         push    dword [V(v_hin)]
   202 00000030 FF558E              <1>         call    [V(iat_SetConsoleMode)]
   203                              <1>         ; ANSI escape sequences: the output mode becomes processed output,
   204                              <1>         ; wrap at the end of a line and virtual terminal processing (1+2+4),
   205                              <1>         ; so the console obeys ESC [ ... as a terminal does. 1+2 is the
   206                              <1>         ; console's usual output mode. On Windows before 10, or when the
   207                              <1>         ; output is not a console, the call fails and nothing changes. The
   208                              <1>         ; mode is left on at the end, which does no harm.
   209 00000033 6A07                <1>         push    7
   210 00000035 FF7562              <1>         push    dword [V(v_outh)]
   211 00000038 FF558E              <1>         call    [V(iat_SetConsoleMode)]
   212                              <1>         ; A high-resolution waitable timer for the timed waits of '?' (Windows
   213                              <1>         ; 10 1803 and later). A plain wait only ends on the system's tick,
   214                              <1>         ; every 15.6 ms, so 1? would take about 16 ms. Older Windows refuses
   215                              <1>         ; the flag; then v_htm is 0 and the waits are plain ones.
   216 0000003B 6803001F00          <1>         push    1F0003h                 ; TIMER_ALL_ACCESS
   217 00000040 6A02                <1>         push    2                       ; CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
   218 00000042 6A00                <1>         push    0
   219 00000044 6A00                <1>         push    0
   220 00000046 FF55AA              <1>         call    [V(iat_CreateWaitableTimerExW)]
   221 00000049 89455E              <1>         mov     [V(v_htm)],eax
   222                              <1>         ; The command line: the program's own name, then the file's.
   223                              <1>         ; The random seed starts as the time: this memory is always zero at
   224                              <1>         ; the start, so without it every run would draw the same numbers.
   225 0000004C FF55B6              <1>         call    [V(iat_GetTickCount)]
   226 0000004F 66A376014100        <1>         mov     [ARENA+SEED],ax
   227 00000055 FF5592              <1>         call    [V(iat_GetCommandLineA)]
   228 00000058 96                  <1>         xchg    eax,esi
   229 00000059 E819000000          <1>         call    token
   230 0000005E E814000000          <1>         call    token
   231 00000063 E833000000          <1>         call    load                    ; (no file, or no such file: no text)
   232 00000068 BF00FF4000          <1>         mov     edi,RSTOP               ; the return stack is empty
   233                              <1> %if EDITOR
   234                              <1>         jmp     edit
   235                              <1> %else
   236 0000006D BE00024100          <1>         mov     esi,ARENA+PROG          ; the IP
   237 00000072 E9FA060000          <1>         jmp     run0
   238                              <1> %endif
   239                              <1> 
   240                              <1> ; token: copy the next word of the command line at ESI to NAMEBUF, ending
   241                              <1> ; in NUL. A word is ended by a space, or is in double quotes. ESI is left
   242                              <1> ; after it (on the NUL at the end of the line, so another token is empty).
   243 00000077 BF00F04000          <1> token:  mov     edi,NAMEBUF
   244 0000007C AC                  <1> .sp:    lodsb
   245 0000007D 3C20                <1>         cmp     al,' '
   246 0000007F 74FB                <1>         je      .sp
   247 00000081 B420                <1>         mov     ah,' '
   248 00000083 3C22                <1>         cmp     al,22h
   249 00000085 7503                <1>         jne     .ch
   250 00000087 88C4                <1>         mov     ah,al                   ; a quoted word ends at the quote
   251 00000089 AC                  <1>         lodsb
   252 0000008A 84C0                <1> .ch:    test    al,al
   253 0000008C 7408                <1>         jz      .nul
   254 0000008E 38E0                <1>         cmp     al,ah
   255 00000090 7405                <1>         je      .end
   256 00000092 AA                  <1>         stosb
   257 00000093 AC                  <1>         lodsb
   258 00000094 EBF4                <1>         jmp     .ch
   259 00000096 4E                  <1> .nul:   dec     esi
   260 00000097 C60700              <1> .end:   mov     byte [edi],0
   261 0000009A C3                  <1>         ret
   262                              <1> 
   263                              <1> ; load: read the file named in NAMEBUF into PROG, and end the text with a
   264                              <1> ; NUL. No such file (or no name): no text, since ReadFile on the failed
   265                              <1> ; handle reads nothing (it sets the count to 0 first).
   266 0000009B 31C0                <1> load:   xor     eax,eax
   267 0000009D 50                  <1>         push    eax                     ; hTemplateFile
   268 0000009E 50                  <1>         push    eax                     ; dwFlagsAndAttributes
   269 0000009F 6A03                <1>         push    3                       ; OPEN_EXISTING
   270 000000A1 50                  <1>         push    eax                     ; lpSecurityAttributes
   271 000000A2 6A01                <1>         push    1                       ; FILE_SHARE_READ
   272 000000A4 6800000080          <1>         push    80000000h               ; GENERIC_READ
   273 000000A9 6800F04000          <1>         push    NAMEBUF
   274 000000AE FF5596              <1>         call    [V(iat_CreateFileA)]
   275 000000B1 50                  <1>         push    eax                     ; (for CloseHandle)
   276 000000B2 6A00                <1>         push    0
   277 000000B4 8D4D56              <1>         lea     ecx,[V(v_cnt)]
   278 000000B7 51                  <1>         push    ecx
   279 000000B8 68FDFC0000          <1>         push    MAXFILE
   280 000000BD 6800024100          <1>         push    ARENA+PROG
   281 000000C2 50                  <1>         push    eax
   282 000000C3 FF559A              <1>         call    [V(iat_ReadFile)]
   283                              <1> %if EDITOR
   284                              <1>         call    [V(iat_CloseHandle)]
   285                              <1> %else
   286 000000C6 58                  <1>         pop     eax                     ; (the handle stays open)
   287                              <1> %endif
   288 000000C7 8B7556              <1>         mov     esi,[V(v_cnt)]
   289 000000CA 81C600024100        <1>         add     esi,ARENA+PROG
   290 000000D0 C60600              <1>         mov     byte [esi],0            ; the end of the file counts as NUL
   291                              <1> %if EDITOR
   292                              <1>         ; The editor's text ends at the file's first ^Z (as in the CP/M
   293                              <1>         ; builds) or NUL, and every line must end in LF: a last line
   294                              <1>         ; without one is given a CR LF.
   295                              <1>         mov     esi,ARENA+PROG
   296                              <1>         mov     al,10                   ; (a file with no text needs nothing)
   297                              <1> .ld1:   mov     ah,al                   ; AH = the character before
   298                              <1>         lodsb
   299                              <1>         cmp     al,1Ah
   300                              <1>         je      .ld2
   301                              <1>         test    al,al
   302                              <1>         jnz     .ld1
   303                              <1> .ld2:   dec     esi
   304                              <1>         cmp     ah,10
   305                              <1>         je      .ld3
   306                              <1>         mov     word [esi],0A0Dh
   307                              <1>         inc     esi
   308                              <1>         inc     esi
   309                              <1> .ld3:   mov     byte [esi],0
   310                              <1> %endif
   311 000000D3 C3                  <1>         ret
   312                              <1> 
   313                              <1> ; exit: put the console's input mode back as it was, and leave.
   314 000000D4 FF756C              <1> exit:   push    dword [V(v_mode)]
   315 000000D7 FF755A              <1>         push    dword [V(v_hin)]
   316 000000DA FF558E              <1>         call    [V(iat_SetConsoleMode)]
   317 000000DD 6A00                <1>         push    0
   318 000000DF FF55BA              <1>         call    [V(iat_ExitProcess)]
   319                              <1> 
   320                              <1> ; LINECODE is the -n? routine, `line`. It goes after the bodies of the
   321                              <1> ; handlers in an unchecked build, after the checks in a checked one: where
   322                              <1> ; the short jumps reach the furthest.
   323                              <1> %macro  LINECODE 0
   324                              <1> ; -n?: Backspace takes the last character back (and is echoed as it is),
   325                              <1> ; CR ends (stored, not echoed), every other key is stored and echoed until
   326                              <1> ; the line is full. The buffer is at offset 80h of the letter page, so DL
   327                              <1> ; alone is the place in the line; BL is the DL of a full line.
   328                              <1> line:   mov     ax,bx
   329                              <1>         neg     ax                      ; the count (8000h for -32768)
   330                              <1>         cmp     ax,127
   331                              <1>         jbe     .ln1
   332                              <1>         mov     al,127
   333                              <1> .ln1:   add     al,80h
   334                              <1>         mov     bl,al
   335                              <1>         mov     edx,ARENA+LINEBUF
   336                              <1>         xor     ecx,ecx                 ; getk waits for ever
   337                              <1> .ln2:   call    getk
   338                              <1>         cmp     al,13
   339                              <1>         je      .ln5
   340                              <1>         cmp     al,8
   341                              <1>         je      .ln4
   342                              <1>         cmp     dl,bl
   343                              <1>         je      .ln2                    ; full
   344                              <1>         mov     [edx],al
   345                              <1>         inc     edx
   346                              <1> .ln3:   call    putc
   347                              <1>         jmp     .ln2
   348                              <1> .ln4:   dec     dl                      ; Backspace: one back, and echo it,
   349                              <1>         js      .ln3                    ;   unless the line was empty (DL left
   350                              <1>         inc     dl                      ;   the upper half of the page)
   351                              <1>         jmp     .ln2
   352                              <1> .ln5:   mov     [edx],al                ; the CR
