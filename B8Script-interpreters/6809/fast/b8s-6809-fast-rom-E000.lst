                    H_STR:    PSHU   Y   
                              FCB   8Ch   ; (CMPX #: steps over the LEAY)
                    SS0:      LEAY   1,Y   
                    SKIPSTR:   LDA   ,Y+   
                              CMPA   #"/"   
                              BEQ   ss0   
                              CMPA   #22h   
                              BNE   skipstr   
                              RTS      
E1F7                          ENDIF      
