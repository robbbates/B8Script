  1153 0000049A 8D4C240C            <1>         lea     ecx,[esp+12]
  1154 0000049E 8D54241C            <1>         lea     edx,[esp+28]
  1155 000004A2 6A00                <1>         push    0                       ; lpOverlapped
  1156 000004A4 51                  <1>         push    ecx                     ; lpNumberOfBytesWritten
  1157 000004A5 6A01                <1>         push    1
  1158 000004A7 52                  <1>         push    edx
  1159 000004A8 FF7552              <1>         push    dword [V(v_outh)]
  1160 000004AB FF559F              <1>         call    [V(iat_WriteFile)]
  1161 000004AE 61                  <1>         popad
