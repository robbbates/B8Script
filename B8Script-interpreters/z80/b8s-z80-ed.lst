0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC and HL'; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 08 04               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 45 04     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 CC 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 DA                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 75                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 77                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 69                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          IF   1-CHECKED   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D   C6 6A        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 00                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE 80                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0066                          ENDIF      
0066                          IFN   CPM   
0066   CB 12                  RL   D   ; its page: 0 + carry
0068                          ENDIF      
0068                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0068                          ENDIF      
0068   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0069   C9                     RET      ;   when the handler starts
006A                             ; The rest of the startup: here so that the generic reset code can reach it
006A                             ; with JR. st0: find the program's NUL; the heap starts after it.
006A                             ; (The editor build has its own copy of this, next to the editor.)
006A                             ; A checked build first clears the lower half of the letter page (A = 0):
006A                             ; every variable starts at 0, every word cell holds 0000h, the address an
006A                             ; undefined word is caught at (see e_hi), and no key is held back.
006A                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006A                          ENDIF      
006A                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
006A                          ENDIF      
006A                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
006A                          ENDIF      ;   these)
006A                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
006A                          ENDIF      
006A                             ; In the unchecked generic editor build the table is here, in the first
006A                             ; page, which saves loading D twice. (The other builds have no room for it
006A                             ; here: theirs is further down.)
006A                          IF   TABP0   
006A                PTAB:        
006A                          ;*Macro unroll:  PTABLE
006A   9E                     DB   h_store & 0FFh   
006B   A3                     DB   h_str & 0FFh   
006C   B1                     DB   h_num & 0FFh   
006D   AA                     DB   h_print & 0FFh   
006E   99                     DB   h_swap & 0FFh   
006F   41                     DB   h_and & 0FFh   
0070   AE                     DB   h_emit & 0FFh   
0071   1D                     DB   h_open & 0FFh   
0072   25                     DB   h_close & 0FFh   
0073   62                     DB   h_mul & 0FFh   
0074   38                     DB   h_add & 0FFh   
0075   D8                     DB   h_cfetch & 0FFh   
0076   30                     DB   h_sub & 0FFh   
0077   9B                     DB   h_cstore & 0FFh   
0078   76                     DB   h_div & 0FFh   
0079   97                     DB   h_dup & 0FFh   
007A   9D                     DB   h_drop & 0FFh   
007B   49                     DB   h_lt & 0FFh   
007C   58                     DB   h_eq & 0FFh   
007D   4A                     DB   h_gt & 0FFh   
007E   B7                     DB   h_key & 0FFh   
007F   18                     DB   h_fetch & 0FFh   
0080   FB                     DB   h_def & 0FFh   
0081   EE                     DB   h_break & 0FFh   
0082   EA                     DB   h_ret & 0FFh   
0083   8A                     DB   h_xor & 0FFh   
0084   9D                     DB   h_alloc & 0FFh   
0085   D8                     DB   h_grave & 0FFh   
0086   2C                     DB   h_tor & 0FFh   
0087   92                     DB   h_or & 0FFh   
0088   1C                     DB   h_fromr & 0FFh   
0089   9A                     DB   h_not & 0FFh   
008A                PTABEND:      
008A                          ENDIF      
008A                             ; =============================================================================
008A                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
008A                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
008A                             ;  is here too: it belongs to "`" and makes the page come out right.
008A                             ; =============================================================================
008A   D1           H_XOR:    POP   DE   
008B   7C                     LD   A,H   
008C   AA                     XOR   D   
008D   67                     LD   H,A   
008E   7D                     LD   A,L   
008F   AB                     XOR   E   
0090   6F                     LD   L,A   
0091   F7                     RST   30h   
0092   D1           H_OR:     POP   DE   
0093   7C                     LD   A,H   
0094   B2                     OR   D   
0095   67                     LD   H,A   
0096   7D                     LD   A,L   
0097   B3                     OR   E   
0098   6F                     LD   L,A   
0099   F7                     RST   30h   
009A   E7           H_NOT:    RST   20h   ; ~x = -x - 1
009B   2B                     DEC   HL   
009C   F7                     RST   30h   
009D                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
009D                             ; the same either way); TOS is the old pointer.
009D   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A1                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A1                          ENDIF      
00A1   19                     ADD   HL,DE   ; the new top
00A2                          IF   CHECKED   
                              CALL   chkhp   
00A2                          ENDIF      
00A2   22 7C 82               LD   (HEAP),HL   
00A5   EB                     EX   DE,HL   
00A6   F7                     RST   30h   
00A7   D9           EXEC:     EXX      
00A8   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00AB   D9                     EXX      
00AC   CD 2B 00               CALL   jphl   
00AF   D9                     EXX      
00B0   2A 34 82               LD   HL,(RSAVE)   
00B3   D9                     EXX      
00B4   E1                     POP   HL   
00B5   F7                     RST   30h   
00B6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00B6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00B6                             ; Digits: step back onto the first digit and read the whole number.
00B6   E5           DIGIT:    PUSH   HL   
00B7   0B                     DEC   BC   
00B8   CD 31 02               CALL   rdnum   
00BB   F7                     RST   30h   
00BC                             ; a-z: push the cell's address (the cell is the variable)
00BC   E5           LOWER:    PUSH   HL   
00BD   87                     ADD   A,A   
00BE   6F                     LD   L,A   
00BF   26 82                  LD   H,LETPAGE   
00C1   F7                     RST   30h   
00C2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00C2                             ; the return stack, and the IP becomes the address in the letter's cell.
00C2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00C3   EB                     EX   DE,HL   ; park TOS
00C4   87                     ADD   A,A   
00C5   6F                     LD   L,A   
00C6   26 82                  LD   H,LETPAGE   ; HL -> cell
00C8   4E                     LD   C,(HL)   
00C9   2C                     INC   L   
00CA   46                     LD   B,(HL)   ; IP = the word's body
00CB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00CC                             ; rpushn: move the top cell of the data stack (in memory) to the return
00CC                             ; stack, then next. Everything that pushes the return stack ends here.
00CC                             ; 
00CC                             ; The break key is looked at here, so at every word call and loop-back (and
00CC                             ; block entry and "{"), but only one time in 256: B', which nothing else
00CC                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00CC                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00CC                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00CC                             ; both ways out.)
00CC   D9           RPUSHN:   EXX      
00CD   D1                     POP   DE   
00CE   2B                     DEC   HL   
00CF   72                     LD   (HL),D   
00D0   2B                     DEC   HL   
00D1   73                     LD   (HL),E   
00D2   05                     DEC   B   
00D3   D9                     EXX      
00D4   CC 5C 03               CALL   Z,pollk   
00D7   F7                     RST   30h   
00D8                             ; ---- the grave -------------------------------------------------------------
00D8                             ; The grave is a prefix: with the character after it, it is one command.
00D8                             ; The characters are tested one after another, each SUB taking off the step
00D8                             ; from the one before, so A is 0 (and the carry clear) when a handler is
00D8                             ; reached. Two are here, where they keep the first page as full as the
00D8                             ; layout needs; grave2 has the rest.
00D8                             ; 
00D8                             ;   `!  ( addr -- )  calls the machine code at TOS. The code is entered by
00D8                             ;       CALL with the data stack above the return address; it must keep BC,
00D8                             ;       and on return the top cell becomes the new TOS.
00D8                             ;   `'  ( -- )  new line: CR LF
00D8   0A           H_GRAVE:   LD   A,(BC)   
00D9   03                     INC   BC   
00DA   D6 21                  SUB   "!"   
00DC   28 C9                  JR   Z,exec   
00DE   D6 06                  SUB   27h-"!"   ; "'"
00E0   C2 C3 02               JP   NZ,grave2   
00E3   3E 0D                  LD   A,13   
00E5   EF                     RST   28h   
00E6   3E 0A                  LD   A,10   
00E8   EF                     RST   28h   
00E9   F7                     RST   30h   
00EA                             ; ---- where the two pages meet ----------------------------------------------
00EA                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00EA                             ; are in falling code order for this), and where exactly differs between the
00EA                             ; builds: NPG1 follows. Every handler below these four must start in the
00EA                             ; second page, and every one above in the first; chktab.py checks both.
00EA                             ; "]" returns: pop an address and jump to it.
00EA   CF           H_RET:    RST   08h   
00EB   42                     LD   B,D   
00EC   4B                     LD   C,E   
00ED   F7           BRK1:     RST   30h   
00EE                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00EE                             ; drops the block start, "]" returns. No closer at all ends the program.
00EE   7C           H_BREAK:   LD   A,H   
00EF   B5                     OR   L   
00F0   E1                     POP   HL   
00F1   28 FA                  JR   Z,brk1   
00F3   CD 53 02               CALL   skip   
00F6   B7                     OR   A   ; skip returns 0 for ")"
00F7   20 F1                  JR   NZ,h_ret   
00F9   CF           RDROP:    RST   08h   
00FA   F7                     RST   30h   
00FB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00FB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00FB                             ; the body"s address instead. Either way it then skips to the matching "]'.
00FB                             ; (The unchecked build takes anything that is not a letter as the space; the
00FB                             ; checked build stops on it.)
00FB   0A           H_DEF:    LD   A,(BC)   
00FC   03                     INC   BC   
00FD   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00FF   5F                     LD   E,A   ;   lands 64 bytes up
0100   E6 DF                  AND   0DFh   ; fold case
0102   FE 1A                  CP   26   
0104   30 0B                  JR   NC,def2   ; not a letter
0106   CB 23                  SLA   E   
0108   16 82                  LD   D,LETPAGE   ; DE -> cell
010A   79                     LD   A,C   
010B   12                     LD   (DE),A   
010C   1C                     INC   E   
010D   78                     LD   A,B   
010E   12                     LD   (DE),A   
010F   18 03                  JR   skipnx   
0111                DEF2:        
0111                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0111                          ENDIF      
0111   E5                     PUSH   HL   ; an anonymous block: push its address
0112   60                     LD   H,B   
0113   69                     LD   L,C   
0114                SKIPNX:      
0114                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0114                          ENDIF      ;   opener, the "[", just before where it starts
0114   CD 53 02     SKIPO:    CALL   skip   
0117   F7                     RST   30h   
0118   5E           H_FETCH:   LD   E,(HL)   ; "@"
0119   23                     INC   HL   
011A   56                     LD   D,(HL)   
011B   EB                     EX   DE,HL   
011C   F7                     RST   30h   
011D                             ; =============================================================================
011D                             ;  Handlers that must start in the image's second page.
011D                             ;  "?" is the last (with "," inside it), so its long tail may run past that
011D                             ;  page.
011D                             ; =============================================================================
011D                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
011D                             ; the matching ")".
011D   7C           H_OPEN:   LD   A,H   
011E   B5                     OR   L   
011F   E1                     POP   HL   
0120   28 F2                  JR   Z,skipo   
0122   C5                     PUSH   BC   ; the block starts at the IP
0123   18 A7                  JR   rpushn   
0125                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0125                             ; drops it and carries on.
0125   7C           H_CLOSE:   LD   A,H   
0126   B5                     OR   L   
0127   E1                     POP   HL   
0128   28 CF                  JR   Z,rdrop   
012A   CF                     RST   08h   ; pop the block start ...
012B   42                     LD   B,D   
012C   4B                     LD   C,E   
012D   C5                     PUSH   BC   
012E   18 9C                  JR   rpushn   ; ... and push it back
0130                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0130                             ; "-" has two jobs: directly before a digit it starts a negative number.
0130   0A           H_SUB:    LD   A,(BC)   
0131   D6 30                  SUB   "0"   
0133   FE 0A                  CP   10   
0135   38 04                  JR   C,negnum   
0137   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0138   D1           H_ADD:    POP   DE   
0139   19                     ADD   HL,DE   
013A   F7                     RST   30h   
013B   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
013C   CD 31 02               CALL   rdnum   
013F   E7                     RST   20h   
0140   F7                     RST   30h   
0141   D1           H_AND:    POP   DE   
0142   7C                     LD   A,H   
0143   A2                     AND   D   
0144   67                     LD   H,A   
0145   7D                     LD   A,L   
0146   A3                     AND   E   
0147   6F                     LD   L,A   
0148   F7                     RST   30h   
0149                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0149                             ; cells first. Flipping both sign bits turns a signed compare into an
0149                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0149                             ; carry into -1 or 0 with no branch.
0149   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
014A   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
014B   7C                     LD   A,H   
014C   EE 80                  XOR   80h   
014E   67                     LD   H,A   
014F   7A                     LD   A,D   
0150   EE 80                  XOR   80h   
0152   57                     LD   D,A   
0153   ED 52                  SBC   HL,DE   ; carry if HL < DE
0155   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0157   F7                     RST   30h   
0158   D1           H_EQ:     POP   DE   
0159   B7                     OR   A   
015A   ED 52                  SBC   HL,DE   
015C   7C                     LD   A,H   
015D   B5                     OR   L   
015E   FE 01                  CP   1   ; carry only if a - b = 0
0160   18 F3                  JR   tf   
0162                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0162                             ; multiplier shifts up through A:C.
0162   D1           H_MUL:    POP   DE   ; DE = multiplicand
0163   C5                     PUSH   BC   
0164   7C                     LD   A,H   
0165   4D                     LD   C,L   ; A:C = multiplier
0166   21 00 00               LD   HL,0   
0169   06 10                  LD   B,16   
016B   29           MUL1:     ADD   HL,HL   
016C   CB 21                  SLA   C   
016E   17                     RLA      
016F   30 01                  JR   NC,mul2   
0171   19                     ADD   HL,DE   
0172   10 F7        MUL2:     DJNZ   mul1   
0174   C1                     POP   BC   
0175   F7                     RST   30h   
0176                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0176                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0176                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0176                             ; stops on it.
0176                H_DIV:       
0176                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0176                          ENDIF      
0176   D1                     POP   DE   ; DE = a, HL = b
0177   C5                     PUSH   BC   ; free BC for udiv
0178   D5                     PUSH   DE   ; a, for r's sign
0179   7A                     LD   A,D   
017A   AC                     XOR   H   
017B   F5                     PUSH   AF   ; S flag = sign of q
017C   CB 7C                  BIT   7,H   
017E   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0181   EB                     EX   DE,HL   
0182   CB 7C                  BIT   7,H   
0184   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0187   CD 0B 02               CALL   udiv   ; HL = q, DE = r
018A   F1                     POP   AF   
018B   FC 20 00               CALL   M,neg16   ; q's sign
018E   EB                     EX   DE,HL   ; HL = r, DE = q
018F   F1                     POP   AF   ; A = a's high byte
0190   B7                     OR   A   
0191   FC 20 00               CALL   M,neg16   ; r's sign
0194   C1                     POP   BC   
0195   D5                     PUSH   DE   ; q under r
0196   F7                     RST   30h   
0197                             ; ---- stack and storage -----------------------------------------------------
0197   E5           H_DUP:    PUSH   HL   ; ":"
0198   F7                     RST   30h   
0199   E3           H_SWAP:   EX   (SP),HL   ; "%"
019A   F7                     RST   30h   
019B                             ; (The checked build tests the address before it takes the value off the
019B                             ; stack, so that an error report shows both.)
019B                H_CSTORE:      ; "." ( c addr -- )
019B                          IF   CHECKED   
                              CALL   chkst   
019B                          ENDIF      
019B   D1                     POP   DE   
019C   73                     LD   (HL),E   
019D   DF           H_DROP:   RST   18h   ; ";" is this one byte
019E                H_STORE:      ; "!" ( n addr -- )
019E                          IF   CHECKED   
                              CALL   chkst   
019E                          ENDIF      
019E   D1                     POP   DE   
019F   73                     LD   (HL),E   
01A0   23                     INC   HL   
01A1   72                     LD   (HL),D   
01A2   DF                     RST   18h   
01A3                             ; ---- console ---------------------------------------------------------------
01A3                             ; 22h pushes the address of the text after it and skips the string.
01A3   E5           H_STR:    PUSH   HL   
01A4   60                     LD   H,B   
01A5   69                     LD   L,C   
01A6   CD 48 02               CALL   skipstr   
01A9                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01A9                          ENDIF      
01A9   F7                     RST   30h   
01AA                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01AA                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01AA                             ; bit 6, so // and /" give themselves).
01AA                          IF   (1-CHECKED)*(1-EDITOR)   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
01AA                          ENDIF      
01AA                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
01AA                          ENDIF      
01AA                          IF   (1-CHECKED)*EDITOR   
01AA                             ; (With the editor the loop is a routine, prstr, which ^V uses too.)
01AA   CD EC 03     H_PRINT:   CALL   prstr   
01AD   DF                     RST   18h   
01AE                          ENDIF      
01AE   7D           H_EMIT:   LD   A,L   ; "'"
01AF   EF                     RST   28h   
01B0   DF           PR9:      RST   18h   
01B1                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B1   C5           H_NUM:    PUSH   BC   
01B2   CD 74 02               CALL   psgn   
01B5   C1                     POP   BC   
01B6   DF                     RST   18h   
01B7                             ; "?" ( n -- c ) or ( -n -- addr )
01B7                             ;   n > 0: wait about n ms for a key; 0 if none came
01B7                             ;   n = 0: wait for a key
01B7                             ;          (both stir the random seed while they wait: see kt2)
01B7                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01B7                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01B7   CB 7C        H_KEY:    BIT   7,H   
01B9   20 22                  JR   NZ,line   
01BB   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01BD   CD 8A 03     KT2:      CALL   getk   
01C0   20 17                  JR   NZ,kt3   
01C2   1D                     DEC   E   
01C3   20 F8                  JR   NZ,kt2   
01C5   EB                     EX   DE,HL   ; a millisecond with no key stirs the random
01C6   2A 76 82               LD   HL,(SEED)   ;   seed by one: how long a key takes to come
01C9   23                     INC   HL   ;   is the one thing here that is not the
01CA   22 76 82               LD   (SEED),HL   ;   same every time
01CD   EB                     EX   DE,HL   
01CE   7C                     LD   A,H   ; 0? never counts down: it waits
01CF   B5                     OR   L   
01D0   28 E9                  JR   Z,kt1   
01D2   2B                     DEC   HL   
01D3   7C                     LD   A,H   
01D4   B5                     OR   L   
01D5   20 E4                  JR   NZ,kt1   ; A = 0 if the time ran out
01D7   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01D8   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01D9   6F           KT3:      LD   L,A   
01DA   26 00                  LD   H,0   
01DC   F7                     RST   30h   
01DD                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01DD                          ENDIF      
01DD                          IFN   CPM   
01DD                             ; Generic: Backspace takes the last character back (and is echoed as
01DD                             ; it is), CR ends (stored, not echoed), every other key is stored and
01DD                             ; echoed until the line is full. The line buffer starts at offset 80h
01DD                             ; of its page, so L alone is the place in the line: D holds the L of
01DD                             ; a full line.
01DD   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E0   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E1   9F                     SBC   A,A   
01E2   A5                     AND   L   ; (0 for a count that is too big)
01E3   2F                     CPL      
01E4   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E5                             ;   at most
01E5   21 80 82               LD   HL,LINEBUF   
01E8   CD 8A 03     LN2:      CALL   getk   
01EB   28 FB                  JR   Z,ln2   
01ED   FE 0D                  CP   13   
01EF   28 16                  JR   Z,ln5   
01F1   FE 08                  CP   8   
01F3   28 0B                  JR   Z,ln4   
01F5   5F                     LD   E,A   
01F6   7D                     LD   A,L   
01F7   BA                     CP   D   
01F8   28 EE                  JR   Z,ln2   ; full
01FA   73                     LD   (HL),E   
01FB   2C                     INC   L   
01FC   7B                     LD   A,E   
01FD   EF           LN3:      RST   28h   
01FE   18 E8                  JR   ln2   
0200   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0201   FA FD 01               JP   M,ln3   ;   unless the line was empty (L left the
0204   2C                     INC   L   ;   upper half of the page)
0205   18 E1                  JR   ln2   
0207   77           LN5:      LD   (HL),A   ; the CR
0208                          ENDIF      
0208   2E 80                  LD   L,LINEBUF & 0FFh   
020A   F7                     RST   30h   
020B                             ; =============================================================================
020B                             ;  More routines (no handler starts past this point)
020B                             ; =============================================================================
020B                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
020B                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
020B                             ; while the quotient bits arrive at the bottom of C.
020B                             ; Dividing by 2 is one shift (the spec wants that fast).
020B   7B           UDIV:     LD   A,E   
020C   EE 02                  XOR   2   
020E   B2                     OR   D   
020F   20 07                  JR   NZ,udv0   
0211   CB 3C                  SRL   H   
0213   CB 1D                  RR   L   ; the quotient
0215   8F                     ADC   A,A   
0216   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0217   C9                     RET      
0218   7C           UDV0:     LD   A,H   
0219   4D                     LD   C,L   
021A   21 00 00               LD   HL,0   
021D   06 10                  LD   B,16   
021F   CB 21        UDV1:     SLA   C   
0221   17                     RLA      
0222   ED 6A                  ADC   HL,HL   
0224   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0226   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0228   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0229   0D                     DEC   C   ;   INC below
022A   0C           UDV2:     INC   C   ; a quotient bit
022B   10 F2                  DJNZ   udv1   
022D   EB                     EX   DE,HL   ; DE = remainder
022E   67                     LD   H,A   
022F   69                     LD   L,C   ; HL = quotient
0230   C9                     RET      
0231                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0231                             ; non-digit. Values wrap at 16 bits, as the spec says.
0231   21 00 00     RDNUM:    LD   HL,0   
0234   0A           RDN1:     LD   A,(BC)   
0235   D6 30                  SUB   "0"   
0237   FE 0A                  CP   10   
0239   D0                     RET   NC   
023A   03                     INC   BC   
023B   54                     LD   D,H   
023C   5D                     LD   E,L   
023D   29                     ADD   HL,HL   
023E   29                     ADD   HL,HL   
023F   19                     ADD   HL,DE   
0240   29                     ADD   HL,HL   ; HL * 10
0241   5F                     LD   E,A   
0242   16 00                  LD   D,0   
0244   19                     ADD   HL,DE   
0245   18 ED                  JR   rdn1   
0247                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0247                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0247                          IF   1-CHECKED   
0247   03           SS0:      INC   BC   
0248   0A           SKIPSTR:   LD   A,(BC)   
0249   03                     INC   BC   
024A   FE 2F                  CP   "/"   
024C   28 F9                  JR   Z,ss0   
024E   FE 22                  CP   22h   
0250   20 F6                  JR   NZ,skipstr   
0252   C9                     RET      
0253                          ENDIF      
0253                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0253                          ENDIF      
0253                             ; skip: read past text to the closer at this level, and return A = 0 if it
0253                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0253                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0253                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0253                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0253                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0253                             ; 
0253                             ; The checked build also looks at the character the skip was started by,
0253                             ; which is always the one just before where it starts: "(" must end at ")",
0253                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0253                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0253                             ; place where the skip started, for the report.
0253                SKIP:        
0253                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0253                          ENDIF      
0253   16 00                  LD   D,0   
0255   14           SK3:      INC   D   ; an opener: one deeper
0256   0A           SK1:      LD   A,(BC)   
0257                          IF   1-CHECKED   
0257   03                     INC   BC   
0258   B7                     OR   A   
0259   CA 44 04               JP   Z,SKEND   ; (the end of the program)
025C                          ENDIF      
025C                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
025C                          ENDIF      
025C   FE 22                  CP   22h   
025E   CC 48 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0261   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0263   28 F0                  JR   Z,sk3   
0265   3D                     DEC   A   ; ")"
0266   28 08                  JR   Z,sk4   
0268   D6 32                  SUB   "["-")"   
026A   28 E9                  JR   Z,sk3   
026C   FE 02                  CP   "]"-"["   
026E   20 E6                  JR   NZ,sk1   
0270   15           SK4:      DEC   D   
0271                          IF   1-CHECKED   
0271   C8                     RET   Z   ; the closer at this level
0272   18 E2                  JR   sk1   
0274                          ENDIF      
0274                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0274                          ENDIF      
0274                             ; psgn: print HL as a signed number. Uses BC.
0274   CB 7C        PSGN:     BIT   7,H   
0276   28 04                  JR   Z,pdec   
0278   3E 2D                  LD   A,"-"   
027A   EF                     RST   28h   
027B   E7                     RST   20h   
027C                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
027C                             ; Uses BC.
027C   11 0A 00     PDEC:     LD   DE,10   
027F   CD 0B 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0282   7B                     LD   A,E   
0283   F5                     PUSH   AF   
0284   7C                     LD   A,H   
0285   B5                     OR   L   
0286   C4 7C 02               CALL   NZ,pdec   
0289   F1                     POP   AF   
028A   C6 30                  ADD   A,"0"   
028C   EF                     RST   28h   
028D   C9                     RET      
028E                             ; =============================================================================
028E                             ;  The grave's other codes. h_grave comes here with A = the character minus
028E                             ;  27h, not zero; the tests carry on from there.
028E                             ; 
028E                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
028E                             ;        from addr until a non-hex character; then a RET (C9h) is written
028E                             ;        and its address is left. An odd last digit is consumed and dropped.
028E                             ;    `+  ( addr -- n )   add 1 to the cell at addr and leave its new value
028E                             ;    `,  ( n -- r )      a random number from 0 to n-1 (n is 1 to 32767)
028E                             ;    `-  ( addr -- n )   subtract 1 from the cell at addr, the same way
028E                             ;    `.  ( -- addr )     the address of the random seed
028E                             ;    `<  ( a b -- n )    the smaller of the two (signed)
028E                             ;    `>  ( a b -- n )    the larger
028E                             ;    `?  ( flag -- )     the cursor off (0) or on
028E                             ;    `@  ( row col -- )  the cursor to that row and column, both from 0
028E                             ;    `^  ( -- )          clear the screen and home the cursor
028E                             ;    `_  ( -- )          clear from the cursor to the end of the line
028E                             ; 
028E                             ;  Any other character is unsafe: the unchecked build takes it as "_", the
028E                             ;  checked build stops with W.
028E                             ; =============================================================================
028E                             ; (The console codes are here, before the tests, to be in reach of them.)
028E                          IF   ANSI   
028E                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
028E   CD BC 02     G_CUR:    CALL   csi   
0291   3E 3F                  LD   A,"?"   
0293   EF                     RST   28h   
0294   3E 32                  LD   A,"2"   
0296   EF                     RST   28h   
0297   3E 35                  LD   A,"5"   
0299   EF                     RST   28h   
029A   7C                     LD   A,H   
029B   B5                     OR   L   
029C   3E 6C                  LD   A,"l"   
029E   28 02                  JR   Z,gc1   
02A0   3E 68                  LD   A,"h"   
02A2   EF           GC1:      RST   28h   
02A3   DF                     RST   18h   
02A4                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
02A4   D1           G_AT:     POP   DE   ; DE = the row
02A5   C5                     PUSH   BC   ; (pdec uses BC)
02A6   E5                     PUSH   HL   ; the column
02A7   EB                     EX   DE,HL   
02A8   CD BC 02               CALL   csi   
02AB   23                     INC   HL   
02AC   CD 7C 02               CALL   pdec   
02AF   3E 3B                  LD   A,";"   
02B1   EF                     RST   28h   
02B2   E1                     POP   HL   
02B3   23                     INC   HL   
02B4   CD 7C 02               CALL   pdec   
02B7   3E 48                  LD   A,"H"   
02B9   EF                     RST   28h   
02BA   C1                     POP   BC   
02BB   DF                     RST   18h   
02BC                             ; csi: print ESC [, which starts every ANSI sequence. Keeps all but A.
02BC   3E 1B        CSI:      LD   A,27   
02BE   EF                     RST   28h   
02BF   3E 5B                  LD   A,"["   
02C1   EF                     RST   28h   
02C2   C9                     RET      
02C3                          ENDIF      
02C3                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    LD   A,H   
                              OR   L   
                              CALL   CONCUR   
                              RST   18h   
                    G_AT:     POP   DE   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   18h   
02C3                          ENDIF      
02C3   C6 03        GRAVE2:   ADD   A,27h-"$"   ; "$"
02C5   20 13                  JR   NZ,gv1   
02C7   CD 4A 03     HX1:      CALL   hexc   
02CA   30 0B                  JR   NC,hx2   
02CC   77                     LD   (HL),A   ; the high digit goes in first ...
02CD   CD 4A 03               CALL   hexc   
02D0   30 05                  JR   NC,hx2   ; odd digit: consumed, and the RET below
02D2   ED 6F                  RLD      ;   overwrites it
02D4   23                     INC   HL   ; ... and RLD shifts it up under the low one
02D5   18 F0                  JR   hx1   
02D7   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
02D9   F7                     RST   30h   
02DA   D6 07        GV1:      SUB   "+"-"$"   
02DC   28 2C                  JR   Z,g_inc   
02DE   3D                     DEC   A   ; ","
02DF   28 3C                  JR   Z,g_rnd   
02E1   3D                     DEC   A   ; "-"
02E2   28 25                  JR   Z,g_dec   
02E4   3D                     DEC   A   ; "."
02E5   28 31                  JR   Z,g_seed   
02E7   D6 0E                  SUB   "<"-"."   
02E9   28 4D                  JR   Z,g_min   
02EB   D6 02                  SUB   ">"-"<"   
02ED   28 48                  JR   Z,g_max   
02EF   3D                     DEC   A   ; "?"
02F0   28 9C                  JR   Z,g_cur   
02F2   3D                     DEC   A   ; "@"
02F3   28 AF                  JR   Z,g_at   
02F5   D6 1E                  SUB   "^"-"@"   ; "^" leaves 0 and "_" leaves 1
02F7                          IF   CHECKED   
                              CP   2   
                              JP   NC,e_brack   ; anything else: W. The place is the character
                              OR   A   
02F7                          ENDIF      
02F7                          IF   ANSI   
02F7   20 07                  JR   NZ,ge1   
02F9   CD BC 02               CALL   csi   ; "^": ESC [ H homes the cursor, and then
02FC   3E 48                  LD   A,"H"   ;   ESC [ J clears from there to the end of
02FE   EF                     RST   28h   ;   the screen
02FF   AF                     XOR   A   
0300   C6 4A        GE1:      ADD   A,"J"   ; "_": ESC [ K clears to the end of the line
0302   5F                     LD   E,A   
0303   CD BC 02               CALL   csi   
0306   7B                     LD   A,E   
0307   EF                     RST   28h   
0308   F7                     RST   30h   
0309                          ENDIF      
0309                          IF   1-ANSI   
                              JR   NZ,ge1   
                              CALL   CONCLS   
                              RST   30h   
                    GE1:      CALL   CONEOL   
                              RST   30h   
0309                          ENDIF      
0309                             ; `+ and `-. The carry says which: set to add.
0309                          IF   1-CHECKED   
0309   3E           G_DEC:    DB   3Eh   ; (LD A,n: steps over the SCF, and "-" comes
030A   37           G_INC:    SCF      ;   here with the carry clear)
030B                          ENDIF      
030B                          IF   CHECKED   
                                 ; (The checked build tests the address first, as "!" does, and then looks at
                                 ; the character again: the test has used the flags.)
                    G_INC:       
                    G_DEC:    CALL   chkst   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              CP   ","   ; carry for "+"
030B                          ENDIF      
030B   5E                     LD   E,(HL)   
030C   23                     INC   HL   
030D   56                     LD   D,(HL)   
030E   30 02                  JR   NC,gi1   
0310   13                     INC   DE   
0311   13                     INC   DE   
0312   1B           GI1:      DEC   DE   
0313   72                     LD   (HL),D   
0314   2B                     DEC   HL   
0315   73                     LD   (HL),E   
0316   EB                     EX   DE,HL   ; the new value is TOS
0317   F7                     RST   30h   
0318                             ; `. pushes the address of the random seed.
0318   E5           G_SEED:   PUSH   HL   
0319   21 76 82               LD   HL,SEED   
031C   F7                     RST   30h   
031D                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
031D                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
031D                             ; and the low ones repeat soon, so the high byte is folded into the low
031D                             ; (XOR) before the remainder of dividing by n is taken.
031D                             ; n must be 1 to 32767: the checked build stops with Z on anything less
031D                             ; than 1.
031D                G_RND:       
031D                          IF   CHECKED   
                              DEC   HL   
                              BIT   7,H   ; n - 1 negative: n is 0 or less
                              INC   HL   
                              JP   NZ,e_zero   
031D                          ENDIF      
031D   EB                     EX   DE,HL   ; DE = n
031E   C5                     PUSH   BC   
031F   2A 76 82               LD   HL,(SEED)   
0322   44                     LD   B,H   
0323   4D                     LD   C,L   
0324   29                     ADD   HL,HL   
0325   29                     ADD   HL,HL   
0326   09                     ADD   HL,BC   ; * 5
0327   7C                     LD   A,H   
0328   81                     ADD   A,C   
0329   67                     LD   H,A   ; + * 256: * 261
032A   23                     INC   HL   
032B   22 76 82               LD   (SEED),HL   
032E   7C                     LD   A,H   
032F   AD                     XOR   L   
0330   6F                     LD   L,A   
0331   CD 0B 02               CALL   udiv   ; DE = the remainder
0334   EB                     EX   DE,HL   
0335   C1                     POP   BC   
0336   F7                     RST   30h   
0337                             ; `< and `>. The carry says which: set for the larger. The two are put in
0337                             ; order, HL the smaller and DE the larger, and then swapped for ">".
0337                             ; b < a (signed) is the borrow of b - a, turned round if the two signs
0337                             ; differ: RRA puts the borrow in bit 7, where the two XORs meet it.
0337   37           G_MAX:    SCF      ; ("<" comes in with the carry clear)
0338   D1           G_MIN:    POP   DE   ; DE = a, HL = b
0339   F5                     PUSH   AF   
033A   7D                     LD   A,L   
033B   93                     SUB   E   
033C   7C                     LD   A,H   
033D   9A                     SBC   A,D   
033E   1F                     RRA      
033F   AC                     XOR   H   
0340   AA                     XOR   D   
0341   17                     RLA      ; carry: b < a
0342   38 01                  JR   C,gm2   
0344   EB                     EX   DE,HL   
0345   F1           GM2:      POP   AF   
0346   30 01                  JR   NC,gm3   
0348   EB                     EX   DE,HL   
0349   F7           GM3:      RST   30h   
034A                             ; =============================================================================
034A                             ;  Dispatch table: the low byte of each handler's address, in code order
034A                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
034A                             ;  It must not cross a page (the dispatcher only adds to its low byte).
034A                             ; =============================================================================
034A                             ; The handlers of the first NPG1 characters start in the image's second page.
034A                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
034A                             ; differs between the builds, so the count is worked out here.
034A                             ; (One division to a line: asm80 only rounds down when it stores a value.)
034A                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
034A                PGBRK:    EQU   (h_break-BASE)/256   
034A                PGDEF:    EQU   (h_def-BASE)/256   
034A                PGFET:    EQU   (h_fetch-BASE)/256   
034A                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
034A                          IF   1-TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
034A                          ENDIF      
034A                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
034A                             ; and return its value in A with the carry set; otherwise leave the IP and
034A                             ; return with the carry clear.
034A   0A           HEXC:     LD   A,(BC)   
034B   D6 30                  SUB   "0"   
034D   FE 0A                  CP   10   
034F   38 09                  JR   C,hc1   
0351   E6 DF                  AND   0DFh   
0353   D6 11                  SUB   11h   
0355   FE 06                  CP   6   
0357   D0                     RET   NC   
0358   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
035A   03           HC1:      INC   BC   
035B   C9                     RET      
035C                             ; =============================================================================
035C                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
035C                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
035C                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
035C                             ;  they are the host's KEY and CONOUT routines themselves.
035C                             ; 
035C                             ;  A running program reads the keyboard only through getk and pollk, which
035C                             ;  between them give the break key its rules:
035C                             ;    - Ctrl-C stops the program;
035C                             ;    - any other key that the break check reads is held in KEYBUF for the
035C                             ;      next "?", and a newer one takes its place;
035C                             ;    - "?" (getk) takes the held key first;
035C                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
035C                             ;      key like any other, but two of them within about 250 ms still stop it.
035C                             ;  Both are called straight from a handler, never from a routine under one:
035C                             ;  the checked build's report counts on finding one return address above the
035C                             ;  data stack.
035C                             ; =============================================================================
035C                          IFN   CPM   
035C                RAWK:     EQU   KEY   
035C                          ENDIF      
035C                             ; pollk: the break check (see rpushn).
035C   CD 06 FF     POLLK:    CALL   rawk   
035F   C8                     RET   Z   ; no key
0360   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0363   FE 03        PK1:      CP   3   ; (getk joins here)
0365   C0                     RET   NZ   
0366                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0366                             ; the program has turned it off, wait about 250 ms for one more key: a
0366                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0366                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0366   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0369   B7                     OR   A   
036A   CA 40 04     CT0:      JP   Z,brk   
036D   D5                     PUSH   DE   
036E   11 10 27               LD   DE,250*MSLOOP   
0371   CD 06 FF     CT1:      CALL   rawk   
0374   20 05                  JR   NZ,ct2   
0376   1B                     DEC   DE   
0377   7A                     LD   A,D   
0378   B3                     OR   E   
0379   20 F6                  JR   NZ,ct1   
037B   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
037C   FE 03                  CP   3   
037E   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0380   B7                     OR   A   
0381   28 03                  JR   Z,ct3   
0383   32 7A 82               LD   (KEYBUF),A   
0386   3E 03        CT3:      LD   A,3   
0388   B7                     OR   A   
0389   C9                     RET      
038A                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
038A   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
038B   21 7A 82               LD   HL,KEYBUF   ;   the buffer
038E   7E                     LD   A,(HL)   
038F   36 00                  LD   (HL),0   
0391   E1                     POP   HL   
0392   B7                     OR   A   
0393   C0                     RET   NZ   
0394   CD 06 FF               CALL   rawk   
0397   C8                     RET   Z   
0398   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
039A                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
039A                          ENDIF      ;   (with the editor, both stacks are cleared);
039A                          IF   (1-CHECKED)*EDITOR   
039A                BRK:      EQU   edit0   
039A                          ENDIF      
039A                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
039A                          ENDIF      
039A                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
039A                          ENDIF      
039A                             ; =============================================================================
039A                             ;  Checked build: the checks and the error report
039A                             ; =============================================================================
039A                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
039A                          ENDIF      
039A                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
039A                          ENDIF      
039A                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
039A                          ENDIF      
039A                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
039A                          ENDIF      
039A                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
039A                          ENDIF      
039A                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
039A                          ENDIF      
039A                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
039A                          ENDIF      
039A                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
039A                          ENDIF      ;   screen on it)
039A                          IF   CHECKED   
                              RST   28h   
                              DJNZ   er4   
                    ER5:         ; (without the editor: on into pstk)
039A                          ENDIF      
039A                          IF   CHECKED*EDITOR   
                              CALL   pstk   
                              CALL   pnl   
                              DB   22h   
                              JP   edit0   ; back to the editor, with both stacks cleared
039A                          ENDIF      
039A                             ; =============================================================================
039A                             ;  Routines that the checked build's report and the editor share
039A                             ; =============================================================================
039A                SPADJ:    EQU   2*EDITOR   ; (with the editor pstk is called, not fallen
039A                             ;   into: the stack is one address deeper)
039A                          IF   CHECKED+EDITOR   
039A                             ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
039A                             ;                             Rtn n
039A                             ; TOS must be in memory with the rest (pushed). In a build without the
039A                             ; editor this is the end of `error`, which runs on into it.
039A   CD FC 03     PSTK:     CALL   pnl   
039D   53 74 6B 20 22         DB   "Stk ",22h   
03A2   21 08 7E               LD   HL,(2+SPADJ-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
03A5   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
03A6   E7                     RST   20h   ;   with the first value and holds nothing)
03A7   CD E2 03               CALL   phalf   ; the depth
03AA   3E 3A                  LD   A,":"   
03AC   EF                     RST   28h   
03AD   79                     LD   A,C   
03AE   FE 09                  CP   9   
03B0   38 0A                  JR   C,er6   
03B2   CD 02 04               CALL   pmsg   
03B5   20 2E 2E 2E 22         DB   " ...",22h   
03BA   0E 08                  LD   C,8   
03BC   26 00        ER6:      LD   H,0   ; C = the number of cells to show
03BE   69                     LD   L,C   
03BF   29                     ADD   HL,HL   
03C0   39                     ADD   HL,SP   ; HL -> just above the deepest of them
03C1                          ENDIF      
03C1                          IF   EDITOR   
03C1   23                     INC   HL   
03C2   23                     INC   HL   
03C3                          ENDIF      
03C3                          IF   CHECKED+EDITOR   
03C3   0C                     INC   C   
03C4   0D           ER7:      DEC   C   
03C5   28 11                  JR   Z,er8   
03C7   2B                     DEC   HL   
03C8   56                     LD   D,(HL)   
03C9   2B                     DEC   HL   
03CA   5E                     LD   E,(HL)   
03CB   E5                     PUSH   HL   
03CC   C5                     PUSH   BC   
03CD   3E 20                  LD   A," "   
03CF   EF                     RST   28h   
03D0   EB                     EX   DE,HL   
03D1   CD 74 02               CALL   psgn   
03D4   C1                     POP   BC   
03D5   E1                     POP   HL   
03D6   18 EC                  JR   er7   
03D8   CD FC 03     ER8:      CALL   pnl   
03DB                          ENDIF      
03DB                          IF   (1-CHECKED)*EDITOR   
03DB   52 74 6E 20 30 22      DB   "Rtn 0",22h   ; (only ^V comes here, and at the editor the
03E1   C9                     RET      ;   return stack is always empty)
03E2                          ENDIF      
03E2                          IF   CHECKED   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
03E2                          ENDIF      
03E2                          IF   CHECKED*(1-EDITOR)   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
03E2                          ENDIF      
03E2                          IF   CHECKED+EDITOR   
03E2                             ; phalf: print half of HL, and leave it in C. (With the editor, pstk ends by
03E2                             ; running on into this.)
03E2   CB 3C        PHALF:    SRL   H   
03E4   CB 1D                  RR   L   
03E6   E5                     PUSH   HL   
03E7   CD 7C 02               CALL   pdec   
03EA   C1                     POP   BC   
03EB   C9                     RET      
03EC                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
03EC                             ; "$", and the texts of the report and the editor). In the checked build a
03EC                             ; NUL first is an error: Q.
03EC   7E           PRSTR:    LD   A,(HL)   
03ED   23                     INC   HL   
03EE   FE 22                  CP   22h   
03F0   C8                     RET   Z   
03F1                          ENDIF      
03F1                          IF   CHECKED   
                              OR   A   
                              JR   Z,e_dollar   
03F1                          ENDIF      
03F1                          IF   CHECKED+EDITOR   
03F1   FE 2F                  CP   "/"   
03F3   20 04                  JR   NZ,prs1   
03F5   7E                     LD   A,(HL)   
03F6   23                     INC   HL   
03F7   E6 BF                  AND   0BFh   
03F9   EF           PRS1:     RST   28h   
03FA   18 F0                  JR   prstr   
03FC                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
03FC                             ; pnl: the same, on a new line.
03FC   3E 0D        PNL:      LD   A,13   
03FE   EF                     RST   28h   
03FF   3E 0A                  LD   A,10   
0401   EF                     RST   28h   
0402   E3           PMSG:     EX   (SP),HL   
0403   CD EC 03               CALL   prstr   
0406   E3                     EX   (SP),HL   
0407   C9                     RET      
0408                          ENDIF      
0408                          IF   CHECKED   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              POP   HL   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
0408                          ENDIF      
0408                             ; =============================================================================
0408                             ;  The line editor (EDITOR = 1)
0408                             ; 
0408                             ;  The interpreter starts here, and a program that ends comes back here.
0408                             ;  There is no prompt. It follows the spec's suggested standard for a line
0408                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0408                             ; 
0408                             ;    n text    put the text in as line n; the lines from n on move down. A
0408                             ;              number past the end (or 0) adds the line at the end.
0408                             ;    n         take line n out
0408                             ;    anything else is run at once, as B8Script. (Start such a line with a
0408                             ;    space if it would begin with a digit.)
0408                             ; 
0408                             ;  A command key ends the line too, and takes what was typed as its argument:
0408                             ; 
0408                             ;    ^G        run the program
0408                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0408                             ;              list until another key is pressed; Ctrl-C ends it.
0408                             ;    n ^E      put line n in the input line; Return puts it back, changed
0408                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0408                             ;              last time). Generic: what is typed, or pasted, from now until
0408                             ;              ^Z replaces the program; it is not echoed.
0408                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0408                             ;              time). Generic: the text is printed, as it is.
0408                             ;    ^N ^N     new: no program (the key twice in a row)
0408                             ;    ^V        view: the build, both stacks, and the program's size, lines
0408                             ;              and free memory
0408                             ;    ^X        leave (to LEAVE)
0408                             ; 
0408                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
0408                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0408                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0408                             ;  sent to the terminal, so any terminal will do.
0408                             ; 
0408                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0408                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0408                             ;  125 characters; the one character after a line number separates it from
0408                             ;  the text and is not stored. The text is kept as it is typed, each line
0408                             ;  ending in CR LF, at PROG.
0408                             ; 
0408                             ;  What lasts from one line to the next: the program, the words, the
0408                             ;  variables and the data stack. An error or a break clears both stacks. The
0408                             ;  return stack starts empty for every line.
0408                             ; 
0408                             ;  Things to know:
0408                             ;    - Reset empties the program (generic builds).
0408                             ;    - A word's address points into the program, so run the program again
0408                             ;      after editing it.
0408                             ;    - Nothing is printed between a program's output and what is typed next.
0408                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0408                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0408                             ;      (The stored program never comes back to the line, so it may.)
0408                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0408                             ;      read of the other builds (BDOS 10 under CP/M).
0408                             ; 
0408                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0408                             ;  the last line left there, with TOS pushed like the rest.
0408                             ; =============================================================================
0408                          IF   EDGEN   
0408                INIT:        ; reset (A = 0)
0408                          ENDIF      
0408                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0408                          ENDIF      
0408                          IF   EDGEN   
0408   18 36                  JR   edit0   
040A                          ENDIF      
040A                          IF   EDITOR   
040A                             ; ^F, right arrow: one to the right, by printing the character there
040A   7D           RIGHT:    LD   A,L   
040B   BB                     CP   E   
040C   28 4A                  JR   Z,ed1   ; at the end
040E   7E                     LD   A,(HL)   
040F   2C                     INC   L   
0410   18 2B                  JR   lf1   
0412                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0412                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0412                             ; ends the sequence, and act on C (right) and D (left).
0412   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0415   CD 06 FF     ES1:      CALL   rawk   
0418   20 0A                  JR   NZ,es2   
041A   0B                     DEC   BC   
041B   78                     LD   A,B   
041C   B1                     OR   C   
041D   20 F6                  JR   NZ,es1   
041F   CD 8D 04               CALL   fin   ; no second key: the line is dropped
0422   18 22                  JR   edit   
0424   FE 5B        ES2:      CP   "["   
0426   20 30                  JR   NZ,ed1   ; not a sequence known here
0428   CD E6 04     ES3:      CALL   ekey   
042B   FE 40                  CP   40h   
042D   38 F9                  JR   C,es3   ; (its parameters)
042F   D6 43                  SUB   "C"   
0431   28 D7                  JR   Z,right   
0433   3D                     DEC   A   ; "D"?
0434   20 22                  JR   NZ,ed1   ; no: on into left
0436                             ; ^B, left arrow: the cursor goes one to the left
0436   7D           LEFT:     LD   A,L   
0437   87                     ADD   A,A   
0438   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
043A   2D                     DEC   L   
043B   3E 08                  LD   A,8   
043D   EF           LF1:      RST   28h   
043E   18 18                  JR   ed1   
0440                             ; edit0: reset, an error or a break: both stacks are cleared.
0440                             ; skend: a program that ended inside skip: its return address goes.
0440                             ; edend: a program that ended: TOS joins the rest of the data stack.
0440   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0443   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0444   D1           SKEND:    POP   DE   
0445   E5           EDEND:    PUSH   HL   
0446                             ; edit: start a new input line.
0446   D9           EDIT:     EXX      
0447   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
044A   D9                     EXX      
044B   21 00 00               LD   HL,0   
044E   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0451   22 3A 82               LD   (EDLN),HL   ; no line is being edited
0454   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
0457   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0458   CD E6 04     ED1:      CALL   ekey   
045B   FE 7F                  CP   7Fh   
045D   28 40                  JR   Z,bsp   ; DEL
045F   FE 20                  CP   " "   
0461   30 56                  JR   NC,insc   
0463   FE 09                  CP   9   
0465   28 52                  JR   Z,insc   ; Tab is text
0467   FE 08                  CP   8   
0469   28 34                  JR   Z,bsp   
046B   FE 02                  CP   2   
046D   28 C7                  JR   Z,left   ; ^B
046F   FE 06                  CP   6   
0471   28 97                  JR   Z,right   ; ^F
0473   FE 1B                  CP   1Bh   
0475   28 9B                  JR   Z,esc   
0477   E5                     PUSH   HL   ; a command key? Look it up
0478   21 EC 04               LD   HL,cmds   
047B   06 09                  LD   B,NCMD   
047D   BE           ED2:      CP   (HL)   
047E   23                     INC   HL   
047F   28 07                  JR   Z,ed3   
0481   23                     INC   HL   
0482   23                     INC   HL   
0483   10 F8                  DJNZ   ed2   
0485   E1                     POP   HL   
0486   18 D0                  JR   ed1   ; no: the key is ignored
0488   7E           ED3:      LD   A,(HL)   
0489   23                     INC   HL   
048A   66                     LD   H,(HL)   
048B   6F                     LD   L,A   
048C   E3                     EX   (SP),HL   ; the command's address: fin returns to it
048D                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
048D                             ; terminal. Leaves BC -> the line and HL -> the NUL.
048D   26 82        FIN:      LD   H,LETPAGE   
048F   6B                     LD   L,E   
0490   36 0D                  LD   (HL),13   
0492   2C                     INC   L   
0493   36 0A                  LD   (HL),10   
0495   2D                     DEC   L   
0496   CD 50 06               CALL   prl   ; (prints the CR LF)
0499   36 00                  LD   (HL),0   
049B   01 80 82               LD   BC,LINEBUF   
049E   C9                     RET      
049F                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
049F                             ; left, the rest of the line moves down over it, and the last place (now a
049F                             ; space) is printed over along with the rest.
049F   7D           BSP:      LD   A,L   
04A0   87                     ADD   A,A   
04A1   28 B5                  JR   Z,ed1   ; at the start
04A3   2D                     DEC   L   
04A4   3E 08                  LD   A,8   
04A6   EF                     RST   28h   
04A7   E5                     PUSH   HL   
04A8   2C           BS1:      INC   L   
04A9   7E                     LD   A,(HL)   
04AA   2D                     DEC   L   
04AB   77                     LD   (HL),A   
04AC   2C                     INC   L   
04AD   7D                     LD   A,L   
04AE   BB                     CP   E   
04AF   20 F7                  JR   NZ,bs1   
04B1   2D                     DEC   L   
04B2   36 20                  LD   (HL)," "   
04B4   E1                     POP   HL   
04B5   53                     LD   D,E   
04B6   1D                     DEC   E   
04B7   18 15                  JR   ic2   
04B9                             ; A character goes in at the cursor: it ripples up through the rest of the
04B9                             ; line, the cursor moves on, and the rest is printed again.
04B9   47           INSC:     LD   B,A   
04BA   7B                     LD   A,E   
04BB   FE FD                  CP   0FDh   
04BD   28 99                  JR   Z,ed1   ; the line is full: 125 characters
04BF   78                     LD   A,B   
04C0   EF                     RST   28h   
04C1   E5                     PUSH   HL   
04C2   7E           IC1:      LD   A,(HL)   
04C3   70                     LD   (HL),B   
04C4   47                     LD   B,A   
04C5   7D                     LD   A,L   
04C6   2C                     INC   L   
04C7   BB                     CP   E   
04C8   20 F8                  JR   NZ,ic1   
04CA   E1                     POP   HL   
04CB   2C                     INC   L   
04CC   1C                     INC   E   
04CD   53                     LD   D,E   
04CE   CD D3 04     IC2:      CALL   tail   
04D1   18 85                  JR   ed1   
04D3                             ; tail: print the line from the cursor to D (a low byte), and bring the
04D3                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
04D3   4D           TAIL:     LD   C,L   
04D4   7D           TA1:      LD   A,L   
04D5   BA                     CP   D   
04D6   28 05                  JR   Z,ta2   
04D8   7E                     LD   A,(HL)   
04D9   EF                     RST   28h   
04DA   2C                     INC   L   
04DB   18 F7                  JR   ta1   
04DD   7D           TA2:      LD   A,L   
04DE   B9                     CP   C   
04DF   C8                     RET   Z   
04E0   3E 08                  LD   A,8   
04E2   EF                     RST   28h   
04E3   2D                     DEC   L   
04E4   18 F7                  JR   ta2   
04E6                             ; ekey: wait for a key
04E6   CD 06 FF     EKEY:     CALL   rawk   
04E9   28 FB                  JR   Z,ekey   
04EB   C9                     RET      
04EC                             ; The command keys, and where each goes (after fin).
04EC   0D           CMDS:     DB   13   
04ED   3F 05                  DW   cret   
04EF   07                     DB   7   ; ^G
04F0   87 05                  DW   crun   
04F2   0C                     DB   12   ; ^L
04F3   99 05                  DW   clist   
04F5   05                     DB   5   ; ^E
04F6   15 05                  DW   cedln   
04F8   12                     DB   18   ; ^R
04F9   59 06                  DW   cread   
04FB   17                     DB   23   ; ^W
04FC   86 06                  DW   cwrite   
04FE   0E                     DB   14   ; ^N
04FF   07 05                  DW   cnew   
0501   16                     DB   22   ; ^V
0502   C9 05                  DW   cview   
0504   18                     DB   24   ; ^X
0505   09 FF                  DW   LEAVE   
0507                NCMD:     EQU   9   
0507                             ; ^N ^N: no program, if the next key is ^N too
0507   CD E6 04     CNEW:     CALL   ekey   
050A   FE 0E                  CP   14   
050C   20 04                  JR   NZ,ged0   
050E   AF                     XOR   A   
050F   32 00 83               LD   (PROG),A   
0512   C3 46 04     GED0:     JP   edit   
0515                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0515                             ; line it was: Return puts the text back in its place.
0515   CD 31 02     CEDLN:    CALL   rdnum   
0518   E5                     PUSH   HL   
0519   CD 38 06               CALL   find   ; HL -> the line, or the NUL if there is none
051C   D1                     POP   DE   
051D   7E                     LD   A,(HL)   
051E   B7                     OR   A   
051F   28 F1                  JR   Z,ged0   
0521   ED 53 3A 82            LD   (EDLN),DE   
0525   11 80 82               LD   DE,LINEBUF   
0528   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0529   FE 0D                  CP   13   
052B   28 0D                  JR   Z,ce2   
052D   FE 0A                  CP   10   
052F   28 09                  JR   Z,ce2   
0531   12                     LD   (DE),A   
0532   EF                     RST   28h   
0533   23                     INC   HL   
0534   1C                     INC   E   
0535   7B                     LD   A,E   
0536   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0538   20 EE                  JR   NZ,ce1   
053A   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
053B   5D                     LD   E,L   
053C   C3 58 04               JP   ed1   
053F                             ; Return. If ^E put a line here, the text goes back in its place. If not:
053F                             ; a number and text is a line to put in, a number alone a line to take out,
053F                             ; and anything else is run where it is.
053F   E5           CRET:     PUSH   HL   ; the end of what was typed
0540   2A 3A 82               LD   HL,(EDLN)   
0543   7C                     LD   A,H   
0544   B5                     OR   L   
0545   28 07                  JR   Z,cr1   
0547   E5                     PUSH   HL   
0548   CD 28 06               CALL   delln   
054B   E1                     POP   HL   
054C   18 13                  JR   ins   
054E   CD 31 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0551   79                     LD   A,C   ; C is still 80h if there was no number:
0552   87                     ADD   A,A   ;   only then is twice it 0
0553   28 36                  JR   Z,st0p   ; no number: run the line
0555   0A                     LD   A,(BC)   
0556   FE 0D                  CP   13   
0558   20 06                  JR   NZ,cr2   
055A   D1                     POP   DE   ; the number alone: take that line out
055B   CD 28 06               CALL   delln   
055E   18 24                  JR   gedit   
0560   03           CR2:      INC   BC   ; step over the one character after the number
0561                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0561                             ; CR and LF included, and copy it in.
0561   CD 38 06     INS:      CALL   find   ; HL -> where it goes
0564   D1                     POP   DE   ; the end of what was typed
0565   7B                     LD   A,E   
0566   91                     SUB   C   ; A = the length of the text, with its CR LF
0567   C5                     PUSH   BC   ; the text
0568   4F                     LD   C,A   
0569   06 00                  LD   B,0   
056B   C5                     PUSH   BC   ; its length
056C   54                     LD   D,H   
056D   5D                     LD   E,L   ; DE = where it goes
056E   AF                     XOR   A   
056F   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0570   ED B1                  CPIR      ; HL -> one past the program's NUL
0572   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0574   44                     LD   B,H   
0575   4D                     LD   C,L   
0576   19                     ADD   HL,DE   
0577   2B                     DEC   HL   ; HL -> the NUL
0578   EB                     EX   DE,HL   
0579   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
057A   E5                     PUSH   HL   
057B   19                     ADD   HL,DE   ; the NUL's new place
057C   EB                     EX   DE,HL   
057D   ED B8                  LDDR      ; move the rest of the program up
057F   C1                     POP   BC   ; the length
0580   D1                     POP   DE   ; where it goes
0581   E1                     POP   HL   ; the text
0582   ED B0                  LDIR      
0584   C3 46 04     GEDIT:    JP   edit   
0587                             ; ^G: run the program. st0p: run the typed line (BC -> it).
0587   01 00 83     CRUN:     LD   BC,PROG   
058A   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
058B   E1           ST0P:     POP   HL   ; (the end of what was typed)
058C                             ; st0: start running at BC. The heap starts after the stored program's NUL.
058C   21 00 83     ST0:      LD   HL,PROG   
058F   AF                     XOR   A   
0590   BE           ST1:      CP   (HL)   
0591   23                     INC   HL   
0592   20 FC                  JR   NZ,st1   
0594   22 7C 82               LD   (HEAP),HL   
0597                          ENDIF      
0597                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0597                          ENDIF      
0597                          IF   EDITOR   
0597   E1                     POP   HL   ; TOS: the data stack is as the last line left it
0598   F7                     RST   30h   ; (its return address is thrown away)
0599                             ; ^L: list from line n. DE = the number of the line at HL.
0599   CD 31 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
059C   7C                     LD   A,H   
059D   B5                     OR   L   
059E   20 01                  JR   NZ,li0   
05A0   2C                     INC   L   ;   then from line 1
05A1   E5           LI0:      PUSH   HL   
05A2   CD 38 06               CALL   find   
05A5   D1                     POP   DE   
05A6   7E           LI1:      LD   A,(HL)   
05A7   B7                     OR   A   
05A8   28 DA                  JR   Z,gedit   ; the end of the text
05AA   CD 06 FF               CALL   rawk   
05AD   28 09                  JR   Z,li3   ; no key: carry on
05AF   FE 03                  CP   3   
05B1   C4 E6 04               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
05B4   FE 03                  CP   3   
05B6   28 CC                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
05B8   E5           LI3:      PUSH   HL   
05B9   D5                     PUSH   DE   
05BA   EB                     EX   DE,HL   
05BB   CD 7C 02               CALL   pdec   ; the line's number,
05BE   3E 20                  LD   A," "   
05C0   EF                     RST   28h   ;   a space,
05C1   D1                     POP   DE   
05C2   E1                     POP   HL   
05C3   13                     INC   DE   
05C4   CD 50 06               CALL   prl   ;   and the line
05C7   18 DD                  JR   li1   
05C9                             ; ^V: view.
05C9   CD 02 04     CVIEW:    CALL   pmsg   
05CC   42 38 53 5A 38 30 45   DB   "B8SZ80E"   
05D3                          ENDIF      
05D3                          IF   EDITOR*CHECKED   
                              DB   "C"   
05D3                          ENDIF      
05D3                          IF   EDITOR   
05D3   20 32 30 32 36 2D 31 31 2D 32 31 22 DB   " 2026-11-21",22h   
05DF   CD 9A 03               CALL   pstk   ; both stacks
05E2   21 00 83               LD   HL,PROG   
05E5   11 FF FF               LD   DE,0FFFFh   
05E8   13           CV1:      INC   DE   ; count the lines, and find the end
05E9   CD 46 06               CALL   nxl   
05EC   20 FA                  JR   NZ,cv1   
05EE   E5                     PUSH   HL   ; the NUL
05EF   D5                     PUSH   DE   ; the lines
05F0   11 00 7D               LD   DE,(0-PROG)&0FFFFh   
05F3   19                     ADD   HL,DE   
05F4   CD FC 03               CALL   pnl   
05F7   50 72 6F 67 20 22      DB   "Prog ",22h   
05FD   CD 7C 02               CALL   pdec   ; the program's size
0600   E1                     POP   HL   
0601   CD FC 03               CALL   pnl   
0604   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
060B   CD 7C 02               CALL   pdec   
060E   D1                     POP   DE   
060F                          ENDIF      
060F                          IF   EDGEN   
060F   21 FF EF               LD   HL,HEAPLIM*256-1   
0612                          ENDIF      
0612                          IF   EDITOR*CPM   
                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
0612                          ENDIF      
0612                          IF   EDITOR   
0612   B7                     OR   A   
0613   ED 52                  SBC   HL,DE   
0615   CD FC 03               CALL   pnl   
0618   46 72 65 65 20 22      DB   "Free ",22h   
061E   CD 7C 02               CALL   pdec   ; the room left for text and heap
0621   CD FC 03               CALL   pnl   
0624   22                     DB   22h   
0625   C3 46 04     GED1:     JP   edit   
0628                             ; delln: take line n (in HL) out: copy everything after it down over it.
0628   CD 38 06     DELLN:    CALL   find   
062B   54                     LD   D,H   
062C   5D                     LD   E,L   
062D   CD 46 06               CALL   nxl   ; HL -> the next line
0630   7E           DE1:      LD   A,(HL)   
0631   12                     LD   (DE),A   
0632   23                     INC   HL   
0633   13                     INC   DE   
0634   B7                     OR   A   
0635   20 F9                  JR   NZ,de1   
0637   C9                     RET      
0638                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0638                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0638   EB           FIND:     EX   DE,HL   
0639   21 00 83               LD   HL,PROG   
063C   1B           FI1:      DEC   DE   
063D   7A                     LD   A,D   
063E   B3                     OR   E   
063F   C8                     RET   Z   
0640   CD 46 06               CALL   nxl   
0643   20 F7                  JR   NZ,fi1   
0645   C9                     RET      
0646                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0646                             ; stop at the NUL that ends the text (and return zero).
0646   7E           NXL:      LD   A,(HL)   
0647   B7                     OR   A   
0648   C8                     RET   Z   
0649   23                     INC   HL   
064A   FE 0A                  CP   10   
064C   20 F8                  JR   NZ,nxl   
064E   B7                     OR   A   
064F   C9                     RET      
0650                             ; prl: print the line at HL, to its LF; HL -> just past it.
0650   7E           PRL:      LD   A,(HL)   
0651   EF                     RST   28h   
0652   7E                     LD   A,(HL)   
0653   23                     INC   HL   
0654   FE 0A                  CP   10   
0656   20 F8                  JR   NZ,prl   
0658   C9                     RET      
0659                          ENDIF      
0659                          IF   EDGEN   
0659                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
0659                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
0659                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
0659                             ; line with no end is given one. Nothing is echoed, and there is no check
0659                             ; for running out of memory.
0659   21 FF 82     CREAD:    LD   HL,PROG-1   
065C   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
065E   23                     INC   HL   ;   the line buffer's last, and spare)
065F   CD E6 04     RD1:      CALL   ekey   
0662   4F                     LD   C,A   
0663   FE 1A                  CP   1Ah   
0665   20 02                  JR   NZ,rd2   
0667   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
0669   FE 0A        RD2:      CP   10   
066B   20 07                  JR   NZ,rd3   
066D   2B                     DEC   HL   
066E   BE                     CP   (HL)   
066F   23                     INC   HL   
0670   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
0672   3E 0D                  LD   A,13   ; anywhere else it ends the line
0674   77           RD3:      LD   (HL),A   
0675   23                     INC   HL   
0676   FE 0D                  CP   13   
0678   20 03                  JR   NZ,rd4   
067A   36 0A                  LD   (HL),10   ; after a CR goes a LF
067C   23                     INC   HL   
067D   79           RD4:      LD   A,C   
067E   FE 1A                  CP   1Ah   
0680   20 DD                  JR   NZ,rd1   
0682   36 00                  LD   (HL),0   
0684   18 9F                  JR   ged1   
0686                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
0686   21 00 83     CWRITE:   LD   HL,PROG   
0689   7E           CW1:      LD   A,(HL)   
068A   B7                     OR   A   
068B   28 98                  JR   Z,ged1   
068D   EF                     RST   28h   
068E   23                     INC   HL   
068F   18 F8                  JR   cw1   
0691                          ENDIF      
0691                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0691                          ENDIF      
0691                             ; =============================================================================
0691                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0691                          ENDIF      
0691                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0691                          ENDIF      
0691                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
0691                          ENDIF      
0691                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0691                          ENDIF      
0691                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0691                          ENDIF      
0691                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0691                          ENDIF      
