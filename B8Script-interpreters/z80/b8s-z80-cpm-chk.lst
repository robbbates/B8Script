0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        "/" leaves ( r q ), the quotient on top; dividing by zero is not
0000                             ;        checked. -n? does no more editing than Backspace.
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = generic build with a small line editor built in (see the
0000                             ;                 end of this file). It needs CPM = 0 and CHECKED = 0.
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor (generic only)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                EXIT:     EQU   0000h   ; warm boot
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   1-EDITOR   
0100   31 FE 06               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   EDITOR   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
                              JP   edit   ; 04
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 3D 04               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 00 00     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 C1 03               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 C5 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD DA 03               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LD   A,(BC)   
0138   03                     INC   BC   
0139   D6 21                  SUB   21h   ; A = c - 21h
013B   38 D4                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CP   0Fh   
013F   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0141   D6 0F                  SUB   0Fh   ; A = c - 30h
0143   FE 0A                  CP   0Ah   
0145   38 68                  JR   C,digit   ; 30h-39h
0147   FE 11                  CP   11h   
0149   38 16                  JR   C,p3a   ; 3Ah-40h
014B   D6 11                  SUB   11h   ; A = c - 41h
014D   FE 1A                  CP   1Ah   
014F   38 6A                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0151   FE 20                  CP   20h   
0153   38 0A                  JR   C,p5b   ; 5Bh-60h
0155   FE 3A                  CP   3Ah   
0157   38 5C                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0159   FE 3E                  CP   3Eh   
015B   30 D7                  JR   NC,next0   ; 7Fh-FFh: ignored
015D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
015F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0161   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0163                .macro PTABLE,
0163                             ; 
0163                 DB      h_store & 0FFh  ; !
0163                 DB      h_str & 0FFh    ; "
0163                 DB      h_num & 0FFh    ; #
0163                 DB      h_print & 0FFh  ; $
0163                 DB      h_swap & 0FFh   ; %
0163                 DB      h_and & 0FFh    ; &
0163                 DB      h_emit & 0FFh   ; '
0163                 DB      h_open & 0FFh   ; (
0163                 DB      h_close & 0FFh  ; )
0163                 DB      h_mul & 0FFh    ; *
0163                 DB      h_add & 0FFh    ; +
0163                 DB      h_cfetch & 0FFh ; ,
0163                 DB      h_sub & 0FFh    ; -
0163                 DB      h_cstore & 0FFh ; .
0163                 DB      h_div & 0FFh    ; /
0163                 DB      h_dup & 0FFh    ; :
0163                 DB      h_drop & 0FFh   ; ;
0163                 DB      h_lt & 0FFh     ; <
0163                 DB      h_eq & 0FFh     ; =
0163                 DB      h_gt & 0FFh     ; >
0163                 DB      h_key & 0FFh    ; ?
0163                 DB      h_fetch & 0FFh  ; @
0163                 DB      h_def & 0FFh    ; [
0163                 DB      h_break & 0FFh  ; \
0163                 DB      h_ret & 0FFh    ; ]
0163                 DB      h_xor & 0FFh    ; ^
0163                 DB      h_alloc & 0FFh  ; _
0163                 DB      h_grave & 0FFh  ; `
0163                 DB      h_tor & 0FFh    ; {
0163                 DB      h_or & 0FFh     ; |
0163                 DB      h_fromr & 0FFh  ; }
0163                 DB      h_not & 0FFh    ; ~
0163                .endm
0163                 
0163                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0163                             ; untouched, and A, DE free.
0163   C6 95        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0165   5F                     LD   E,A   
0166   16 03                  LD   D,PTAB / 256   ; (0 in the editor build)
0168   FE AB                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016A   1A                     LD   A,(DE)   
016B   5F                     LD   E,A   ; the handler's low byte
016C                          IF   (1-CPM)*(1-EDITOR)   
                              LD   D,0   
016C                          ENDIF      
016C                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
016C                          ENDIF      
016C                          IF   CPM   
016C   16 01                  LD   D,1   
016E   30 01                  JR   NC,pu1   
0170   14                     INC   D   ; its page: 1 + carry
0171                PU1:         
0171                          ENDIF      
0171   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0172   C9                     RET      ;   when the handler starts
0173                             ; The rest of the startup: here so that the generic reset code can reach it
0173                             ; with JR. st0: find the program's NUL; the heap starts after it.
0173                             ; (The editor build has its own copy of this, next to the editor.)
0173                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0173                          ENDIF      
0173                          IF   1-EDITOR   
0173   22 7C 07     ST2:      LD   (HEAP),HL   
0176   D9                     EXX      
0177   21 E0 05               LD   HL,RSTOP   ; the return stack is empty
017A   D9                     EXX      
017B                          ENDIF      
017B                          IF   CHECKED*(1-EDITOR)   
017B   AF                     XOR   A   
017C   32 36 07               LD   (KEYBUF),A   ; no key held back
017F                          ENDIF      
017F                          IF   1-EDITOR   
017F   F7                     RST   30h   ; (its return address is thrown away)
0180                          ENDIF      
0180                             ; In the editor build the table is here, in the first page, which saves
0180                             ; loading D twice. (The other builds have no room for it here: theirs is
0180                             ; further down.)
0180                          IF   EDITOR   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0180                          ENDIF      
0180                             ; =============================================================================
0180                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0180                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0180                             ;  is here too: it belongs to "`" and makes the page come out right.
0180                             ; =============================================================================
0180   D1           H_XOR:    POP   DE   
0181   7C                     LD   A,H   
0182   AA                     XOR   D   
0183   67                     LD   H,A   
0184   7D                     LD   A,L   
0185   AB                     XOR   E   
0186   6F                     LD   L,A   
0187   F7                     RST   30h   
0188   D1           H_OR:     POP   DE   
0189   7C                     LD   A,H   
018A   B2                     OR   D   
018B   67                     LD   H,A   
018C   7D                     LD   A,L   
018D   B3                     OR   E   
018E   6F                     LD   L,A   
018F   F7                     RST   30h   
0190   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0191   2B                     DEC   HL   
0192   F7                     RST   30h   
0193                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
0193   ED 5B 7C 07  H_ALLOC:   LD   DE,(HEAP)   
0197   19                     ADD   HL,DE   ; the new top
0198                          IF   CHECKED   
0198   CD 0D 04               CALL   chkhp   
019B                          ENDIF      
019B   22 7C 07               LD   (HEAP),HL   
019E   EB                     EX   DE,HL   
019F   F7                     RST   30h   
01A0   D9           EXEC:     EXX      
01A1   22 34 07               LD   (RSAVE),HL   ; machine code may change the alternates
01A4   D9                     EXX      
01A5   CD 2B 01               CALL   jphl   
01A8   D9                     EXX      
01A9   2A 34 07               LD   HL,(RSAVE)   
01AC   D9                     EXX      
01AD   E1                     POP   HL   
01AE   F7                     RST   30h   
01AF                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01AF                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01AF                             ; Digits: step back onto the first digit and read the whole number.
01AF   E5           DIGIT:    PUSH   HL   
01B0   0B                     DEC   BC   
01B1   CD 2E 03               CALL   rdnum   
01B4   F7                     RST   30h   
01B5                             ; a-z: push the cell's address (the cell is the variable)
01B5   E5           LOWER:    PUSH   HL   
01B6   87                     ADD   A,A   
01B7   6F                     LD   L,A   
01B8   26 07                  LD   H,LETPAGE   
01BA   F7                     RST   30h   
01BB                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01BB                             ; the return stack, and the IP becomes the address in the letter's cell.
01BB   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01BC   EB                     EX   DE,HL   ; park TOS
01BD   87                     ADD   A,A   
01BE   6F                     LD   L,A   
01BF   26 07                  LD   H,LETPAGE   ; HL -> cell
01C1   4E                     LD   C,(HL)   
01C2   2C                     INC   L   
01C3   46                     LD   B,(HL)   ; IP = the word's body
01C4   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01C5                             ; rpushn: move the top cell of the data stack (in memory) to the return
01C5                             ; stack, then next. Everything that pushes the return stack ends here.
01C5                RPUSHN:      
01C5                          IF   CHECKED   
01C5   CD F2 03               CALL   chkbrk   ; Ctrl-C is checked at every word call, block
01C8                          ENDIF      ;   entry, loop-back and "{"
01C8   D9                     EXX      
01C9   D1                     POP   DE   
01CA   2B                     DEC   HL   
01CB   72                     LD   (HL),D   
01CC   2B                     DEC   HL   
01CD   73                     LD   (HL),E   
01CE   D9                     EXX      
01CF   F7                     RST   30h   
01D0                             ; ---- machine code: the grave -----------------------------------------------
01D0                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01D0                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01D0                             ; written and its address is left. An odd last digit is consumed and dropped.
01D0                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01D0                             ; code is entered by CALL with the data stack above the return address; it
01D0                             ; must keep BC, and on return the top cell becomes the new TOS.
01D0   CD 83 03     H_GRAVE:   CALL   hexc   
01D3   30 CB                  JR   NC,exec   
01D5                HX1:         
01D5                          IF   CHECKED   
01D5   CD FE 03               CALL   chkst   
01D8                          ENDIF      
01D8   77                     LD   (HL),A   ; the high digit goes in first ...
01D9   CD 83 03               CALL   hexc   
01DC   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01DE   ED 6F                  RLD      ;   overwrites it
01E0   23                     INC   HL   ; ... and RLD shifts it up under the low one
01E1   CD 83 03               CALL   hexc   
01E4   38 EF                  JR   C,hx1   
01E6                HX2:         
01E6                          IF   CHECKED   
01E6   CD FE 03               CALL   chkst   
01E9                          ENDIF      
01E9   36 C9                  LD   (HL),0C9h   
01EB   F7                     RST   30h   
01EC                             ; ---- where the two pages meet ----------------------------------------------
01EC                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01EC                             ; are in falling code order for this), and where exactly differs between the
01EC                             ; builds: NPG1 follows. Every handler below these four must start in the
01EC                             ; second page, and every one above in the first; chktab.py checks both.
01EC                             ; "]" returns: pop an address and jump to it.
01EC   CF           H_RET:    RST   08h   
01ED   42                     LD   B,D   
01EE   4B                     LD   C,E   
01EF   F7           BRK1:     RST   30h   
01F0                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01F0                             ; drops the block start, "]" returns. No closer at all ends the program.
01F0   7C           H_BREAK:   LD   A,H   
01F1   B5                     OR   L   
01F2   E1                     POP   HL   
01F3   28 FA                  JR   Z,brk1   
01F5   CD 50 03               CALL   skip   
01F8   B7                     OR   A   ; skip returns 0 for ")"
01F9   20 F1                  JR   NZ,h_ret   
01FB   CF           RDROP:    RST   08h   
01FC   F7                     RST   30h   
01FD                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01FD                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01FD                             ; the body"s address instead. Either way it then skips to the matching "]'.
01FD                             ; (The unchecked build takes anything below "A" as the space, and anything
01FD                             ; from "A" up as a letter.)
01FD   0A           H_DEF:    LD   A,(BC)   
01FE   03                     INC   BC   
01FF                          IF   CHECKED   
01FF   FE 20                  CP   " "   
0201   28 18                  JR   Z,def2   
0203   5F                     LD   E,A   
0204   E6 DF                  AND   0DFh   ; fold case
0206   D6 41                  SUB   "A"   
0208   FE 1A                  CP   26   
020A   D2 24 04               JP   NC,e_brack   ; anything but a letter or a space
020D   7B                     LD   A,E   
020E                          ENDIF      
020E   D6 41                  SUB   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
0210                          IF   1-CHECKED   
                              JR   C,def2   
0210                          ENDIF      
0210   87                     ADD   A,A   
0211   5F                     LD   E,A   
0212   16 07                  LD   D,LETPAGE   ; DE -> cell
0214   79                     LD   A,C   
0215   12                     LD   (DE),A   
0216   1C                     INC   E   
0217   78                     LD   A,B   
0218   12                     LD   (DE),A   
0219   18 03                  JR   skipnx   
021B   E5           DEF2:     PUSH   HL   ; an anonymous block: push its address
021C   60                     LD   H,B   
021D   69                     LD   L,C   
021E   CD 50 03     SKIPNX:   CALL   skip   
0221   F7                     RST   30h   
0222   5E           H_FETCH:   LD   E,(HL)   ; "@"
0223   23                     INC   HL   
0224   56                     LD   D,(HL)   
0225   EB                     EX   DE,HL   
0226   F7                     RST   30h   
0227                             ; =============================================================================
0227                             ;  Handlers that must start in the image's second page.
0227                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0227                             ;  page.
0227                             ; =============================================================================
0227                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0227                             ; the matching ")".
0227   7C           H_OPEN:   LD   A,H   
0228   B5                     OR   L   
0229   E1                     POP   HL   
022A   28 F2                  JR   Z,skipnx   
022C   C5                     PUSH   BC   ; the block starts at the IP
022D   18 96                  JR   rpushn   
022F                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
022F                             ; drops it and carries on.
022F   7C           H_CLOSE:   LD   A,H   
0230   B5                     OR   L   
0231   E1                     POP   HL   
0232   28 C7                  JR   Z,rdrop   
0234   CF                     RST   08h   ; pop the block start ...
0235   42                     LD   B,D   
0236   4B                     LD   C,E   
0237   C5                     PUSH   BC   
0238   18 8B                  JR   rpushn   ; ... and push it back
023A                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
023A                             ; "-" has two jobs: directly before a digit it starts a negative number.
023A   0A           H_SUB:    LD   A,(BC)   
023B   D6 30                  SUB   "0"   
023D   FE 0A                  CP   10   
023F   38 04                  JR   C,negnum   
0241   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0242   D1           H_ADD:    POP   DE   
0243   19                     ADD   HL,DE   
0244   F7                     RST   30h   
0245   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0246   CD 2E 03               CALL   rdnum   
0249   E7                     RST   20h   
024A   F7                     RST   30h   
024B   D1           H_AND:    POP   DE   
024C   7C                     LD   A,H   
024D   A2                     AND   D   
024E   67                     LD   H,A   
024F   7D                     LD   A,L   
0250   A3                     AND   E   
0251   6F                     LD   L,A   
0252   F7                     RST   30h   
0253                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0253                             ; cells first. Flipping both sign bits turns a signed compare into an
0253                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0253                             ; carry into -1 or 0 with no branch.
0253   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0254   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0255   7C                     LD   A,H   
0256   EE 80                  XOR   80h   
0258   67                     LD   H,A   
0259   7A                     LD   A,D   
025A   EE 80                  XOR   80h   
025C   57                     LD   D,A   
025D   ED 52                  SBC   HL,DE   ; carry if HL < DE
025F   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0261   F7                     RST   30h   
0262   D1           H_EQ:     POP   DE   
0263   B7                     OR   A   
0264   ED 52                  SBC   HL,DE   
0266   7C                     LD   A,H   
0267   B5                     OR   L   
0268   FE 01                  CP   1   ; carry only if a - b = 0
026A   18 F3                  JR   tf   
026C                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
026C                             ; multiplier shifts up through A:C.
026C   D1           H_MUL:    POP   DE   ; DE = multiplicand
026D   C5                     PUSH   BC   
026E   7C                     LD   A,H   
026F   4D                     LD   C,L   ; A:C = multiplier
0270   21 00 00               LD   HL,0   
0273   06 10                  LD   B,16   
0275   29           MUL1:     ADD   HL,HL   
0276   CB 21                  SLA   C   
0278   17                     RLA      
0279   30 01                  JR   NC,mul2   
027B   19                     ADD   HL,DE   
027C   10 F7        MUL2:     DJNZ   mul1   
027E   C1                     POP   BC   
027F   F7                     RST   30h   
0280                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
0280                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0280                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0280   D1           H_DIV:    POP   DE   ; DE = a, HL = b
0281   C5                     PUSH   BC   ; free BC for udiv
0282   D5                     PUSH   DE   ; a, for r's sign
0283   7A                     LD   A,D   
0284   AC                     XOR   H   
0285   F5                     PUSH   AF   ; S flag = sign of q
0286   CB 7C                  BIT   7,H   
0288   C4 20 01               CALL   NZ,neg16   ; HL = |b|
028B   EB                     EX   DE,HL   
028C   CB 7C                  BIT   7,H   
028E   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0291   CD 15 03               CALL   udiv   ; HL = q, DE = r
0294   F1                     POP   AF   
0295   FC 20 01               CALL   M,neg16   ; q's sign
0298   EB                     EX   DE,HL   ; HL = r, DE = q
0299   F1                     POP   AF   ; A = a's high byte
029A   B7                     OR   A   
029B   FC 20 01               CALL   M,neg16   ; r's sign
029E   EB                     EX   DE,HL   ; HL = q, DE = r
029F   C1                     POP   BC   
02A0   D5                     PUSH   DE   ; r under q
02A1   F7                     RST   30h   
02A2                             ; ---- stack and storage -----------------------------------------------------
02A2   E5           H_DUP:    PUSH   HL   ; ":"
02A3   F7                     RST   30h   
02A4   E3           H_SWAP:   EX   (SP),HL   ; "%"
02A5   F7                     RST   30h   
02A6   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
02A7                          IF   CHECKED   
02A7   CD FE 03               CALL   chkst   
02AA                          ENDIF      
02AA   73                     LD   (HL),E   
02AB   DF           H_DROP:   RST   18h   ; ";" is this one byte
02AC   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
02AD                          IF   CHECKED   
02AD   23                     INC   HL   ; both bytes must be in the program's space
02AE   CD FE 03               CALL   chkst   
02B1   2B                     DEC   HL   
02B2                          ENDIF      
02B2   73                     LD   (HL),E   
02B3   23                     INC   HL   
02B4   72                     LD   (HL),D   
02B5   DF                     RST   18h   
02B6                             ; ---- console ---------------------------------------------------------------
02B6                             ; 22h pushes the address of the text after it and skips the string.
02B6   E5           H_STR:    PUSH   HL   
02B7   60                     LD   H,B   
02B8   69                     LD   L,C   
02B9   CD 45 03               CALL   skipstr   
02BC   F7                     RST   30h   
02BD                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02BD                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02BD                             ; bit 6, so // and /" give themselves).
02BD   7E           H_PRINT:   LD   A,(HL)   
02BE   23                     INC   HL   
02BF   FE 22                  CP   22h   
02C1   28 0D                  JR   Z,pr9   
02C3   FE 2F                  CP   "/"   
02C5   20 04                  JR   NZ,pr1   
02C7   7E                     LD   A,(HL)   
02C8   23                     INC   HL   
02C9   E6 BF                  AND   0BFh   
02CB   EF           PR1:      RST   28h   
02CC   18 EF                  JR   h_print   
02CE   7D           H_EMIT:   LD   A,L   ; "'"
02CF   EF                     RST   28h   
02D0   DF           PR9:      RST   18h   
02D1                             ; "#" prints TOS as a signed decimal number, with no space after it.
02D1   CB 7C        H_NUM:    BIT   7,H   
02D3   28 04                  JR   Z,num1   
02D5   3E 2D                  LD   A,"-"   
02D7   EF                     RST   28h   
02D8   E7                     RST   20h   
02D9   C5           NUM1:     PUSH   BC   
02DA   CD 71 03               CALL   pdec   
02DD   C1                     POP   BC   
02DE   DF                     RST   18h   
02DF                             ; "?" ( n -- c ) or ( -n -- addr )
02DF                             ;   n > 0: wait about n ms for a key; 0 if none came
02DF                             ;   n = 0: wait for a key
02DF                             ;   n < 0: read a line of at most -n characters, with echo. n is not
02DF                             ;          checked: the buffer holds 127 characters and the CR, so a
02DF                             ;          program must ask for 127 or fewer.
02DF   CB 7C        H_KEY:    BIT   7,H   
02E1   20 19                  JR   NZ,line   
02E3   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02E5   CD B5 03     KT2:      CALL   getk   
02E8   20 0E                  JR   NZ,kt3   
02EA   1D                     DEC   E   
02EB   20 F8                  JR   NZ,kt2   
02ED   7C                     LD   A,H   ; 0? never counts down: it waits
02EE   B5                     OR   L   
02EF   28 F2                  JR   Z,kt1   
02F1   2B                     DEC   HL   
02F2   7C                     LD   A,H   
02F3   B5                     OR   L   
02F4   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02F6   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02F7   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02F8   6F           KT3:      LD   L,A   
02F9   26 00                  LD   H,0   
02FB   F7                     RST   30h   
02FC                          IF   CPM   
02FC                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02FC                             ; own line editor). It doesn't store the CR, so it is added here.
02FC   AF           LINE:     XOR   A   
02FD   95                     SUB   L   ; A = the count (TOS is minus the count)
02FE   32 7E 07               LD   (LBHDR),A   
0301   11 7E 07               LD   DE,LBHDR   
0304   3E 0A                  LD   A,10   
0306   CD CD 03               CALL   bdosx   
0309   21 7F 07               LD   HL,LBHDR+1   
030C   7E                     LD   A,(HL)   ; the count typed (0-127)
030D   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
030E   85                     ADD   A,L   ;   adding the count to L can't carry
030F   6F                     LD   L,A   
0310   36 0D                  LD   (HL),13   
0312   2E 80                  LD   L,LINEBUF & 0FFh   
0314   F7                     RST   30h   
0315                          ENDIF      
0315                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
0315                          ENDIF      
0315                          IF   EDITOR   
                    LINE:     CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most -L characters; HL -> the CR that ends it
                    RDLINE:      
0315                          ENDIF      
0315                          IF   (1-CPM)*(1-EDITOR)   
                    LINE:        
0315                          ENDIF      
0315                          IFN   CPM   
                              LD   A,LINEBUF & 0FFh   
                              SUB   L   ; (TOS is minus the count)
                              LD   D,A   ; D = the L of a full line
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
0315                          ENDIF      
0315                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
0315                          ENDIF      
0315                          IF   EDITOR   
                              RET      
0315                          ENDIF      
0315                             ; =============================================================================
0315                             ;  More routines (no handler starts past this point)
0315                             ; =============================================================================
0315                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0315                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0315                             ; while the quotient bits arrive at the bottom of C.
0315   7C           UDIV:     LD   A,H   
0316   4D                     LD   C,L   
0317   21 00 00               LD   HL,0   
031A   06 10                  LD   B,16   
031C   CB 21        UDV1:     SLA   C   
031E   17                     RLA      
031F   ED 6A                  ADC   HL,HL   
0321   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0323   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0325   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0326   0D                     DEC   C   ;   INC below
0327   0C           UDV2:     INC   C   ; a quotient bit
0328   10 F2                  DJNZ   udv1   
032A   EB                     EX   DE,HL   ; DE = remainder
032B   67                     LD   H,A   
032C   69                     LD   L,C   ; HL = quotient
032D   C9                     RET      
032E                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
032E                             ; non-digit. Values wrap at 16 bits, as the spec says.
032E   21 00 00     RDNUM:    LD   HL,0   
0331   0A           RDN1:     LD   A,(BC)   
0332   D6 30                  SUB   "0"   
0334   FE 0A                  CP   10   
0336   D0                     RET   NC   
0337   03                     INC   BC   
0338   54                     LD   D,H   
0339   5D                     LD   E,L   
033A   29                     ADD   HL,HL   
033B   29                     ADD   HL,HL   
033C   19                     ADD   HL,DE   
033D   29                     ADD   HL,HL   ; HL * 10
033E   5F                     LD   E,A   
033F   16 00                  LD   D,0   
0341   19                     ADD   HL,DE   
0342   18 ED                  JR   rdn1   
0344                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0344                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0344   03           SS0:      INC   BC   
0345   0A           SKIPSTR:   LD   A,(BC)   
0346   03                     INC   BC   
0347   FE 2F                  CP   "/"   
0349   28 F9                  JR   Z,ss0   
034B   FE 22                  CP   22h   
034D   20 F6                  JR   NZ,skipstr   
034F   C9                     RET      
0350                             ; skip: read past text to the closer at this level, and return A = 0 if it
0350                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0350                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0350                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0350                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0350                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0350   16 00        SKIP:     LD   D,0   
0352   14           SK3:      INC   D   ; an opener: one deeper
0353   0A           SK1:      LD   A,(BC)   
0354   03                     INC   BC   
0355   B7                     OR   A   
0356   CA 15 01               JP   Z,endprog   
0359   FE 22                  CP   22h   
035B   CC 45 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
035E   D6 28                  SUB   "("   
0360   28 F0                  JR   Z,sk3   
0362   3D                     DEC   A   ; ")"
0363   28 08                  JR   Z,sk4   
0365   D6 32                  SUB   "["-")"   
0367   28 E9                  JR   Z,sk3   
0369   FE 02                  CP   "]"-"["   
036B   20 E6                  JR   NZ,sk1   
036D   15           SK4:      DEC   D   
036E   C8                     RET   Z   ; the closer at this level
036F   18 E2                  JR   sk1   
0371                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0371                             ; Uses BC.
0371   11 0A 00     PDEC:     LD   DE,10   
0374   CD 15 03               CALL   udiv   ; HL = HL / 10, E = the last digit
0377   7B                     LD   A,E   
0378   F5                     PUSH   AF   
0379   7C                     LD   A,H   
037A   B5                     OR   L   
037B   C4 71 03               CALL   NZ,pdec   
037E   F1                     POP   AF   
037F   C6 30                  ADD   A,"0"   
0381   EF                     RST   28h   
0382   C9                     RET      
0383                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0383                             ; and return its value in A with the carry set; otherwise leave the IP and
0383                             ; return with the carry clear.
0383   0A           HEXC:     LD   A,(BC)   
0384   D6 30                  SUB   "0"   
0386   FE 0A                  CP   10   
0388   38 09                  JR   C,hc1   
038A   E6 DF                  AND   0DFh   
038C   D6 11                  SUB   11h   
038E   FE 06                  CP   6   
0390   D0                     RET   NC   
0391   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0393   03           HC1:      INC   BC   
0394   C9                     RET      
0395                             ; =============================================================================
0395                             ;  Dispatch table: the low byte of each handler's address, in code order
0395                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0395                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0395                             ; =============================================================================
0395                             ; The handlers of the first NPG1 characters start in the image's second page.
0395                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0395                             ; differs between the builds, so the count is worked out here.
0395                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0395                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0395                PGBRK:    EQU   (h_break-BASE)/256   
0395                PGDEF:    EQU   (h_def-BASE)/256   
0395                PGFET:    EQU   (h_fetch-BASE)/256   
0395                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0395                          IF   1-EDITOR   
0395                PTAB:        
0395                          ;*Macro unroll:  PTABLE
0395   AC                     DB   h_store & 0FFh   
0396   B6                     DB   h_str & 0FFh   
0397   D1                     DB   h_num & 0FFh   
0398   BD                     DB   h_print & 0FFh   
0399   A4                     DB   h_swap & 0FFh   
039A   4B                     DB   h_and & 0FFh   
039B   CE                     DB   h_emit & 0FFh   
039C   27                     DB   h_open & 0FFh   
039D   2F                     DB   h_close & 0FFh   
039E   6C                     DB   h_mul & 0FFh   
039F   42                     DB   h_add & 0FFh   
03A0   F7                     DB   h_cfetch & 0FFh   
03A1   3A                     DB   h_sub & 0FFh   
03A2   A6                     DB   h_cstore & 0FFh   
03A3   80                     DB   h_div & 0FFh   
03A4   A2                     DB   h_dup & 0FFh   
03A5   AB                     DB   h_drop & 0FFh   
03A6   53                     DB   h_lt & 0FFh   
03A7   62                     DB   h_eq & 0FFh   
03A8   54                     DB   h_gt & 0FFh   
03A9   DF                     DB   h_key & 0FFh   
03AA   22                     DB   h_fetch & 0FFh   
03AB   FD                     DB   h_def & 0FFh   
03AC   F0                     DB   h_break & 0FFh   
03AD   EC                     DB   h_ret & 0FFh   
03AE   80                     DB   h_xor & 0FFh   
03AF   93                     DB   h_alloc & 0FFh   
03B0   D0                     DB   h_grave & 0FFh   
03B1   2C                     DB   h_tor & 0FFh   
03B2   88                     DB   h_or & 0FFh   
03B3   1C                     DB   h_fromr & 0FFh   
03B4   90                     DB   h_not & 0FFh   
03B5                PTABEND:      
03B5                          ENDIF      
03B5                             ; =============================================================================
03B5                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
03B5                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
03B5                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
03B5                             ;  KEY and CONOUT routines themselves.
03B5                             ; =============================================================================
03B5                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
03B5                          ENDIF      
03B5                          IF   CHECKED   
03B5   E5           GETK:     PUSH   HL   ; a key held back by the break check goes
03B6   21 36 07               LD   HL,KEYBUF   ;   first, and is taken out of the buffer
03B9   7E                     LD   A,(HL)   
03BA   36 00                  LD   (HL),0   
03BC   E1                     POP   HL   
03BD   B7                     OR   A   
03BE   C0                     RET   NZ   
03BF                          ENDIF      
03BF                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
03BF                          ENDIF      
03BF                          IF   CPM*(1-CHECKED)   
                    GETK:        
03BF                          ENDIF      
03BF                          IF   CPM   
03BF   3E FF                  LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03C1                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
03C1                             ; printing and could swallow a key that BDOS 6 then never sees.
03C1   D5           PUTC:     PUSH   DE   
03C2   E5                     PUSH   HL   
03C3   5F                     LD   E,A   
03C4   3E 06                  LD   A,6   
03C6   CD CD 03               CALL   bdosx   
03C9   E1                     POP   HL   
03CA   D1                     POP   DE   
03CB   B7                     OR   A   ; (for getk)
03CC   C9                     RET      
03CD                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
03CD   C5           BDOSX:    PUSH   BC   
03CE   D9                     EXX      
03CF   E5                     PUSH   HL   
03D0   D9                     EXX      
03D1   4F                     LD   C,A   
03D2   CD 05 00               CALL   BDOS   
03D5   D9                     EXX      
03D6   E1                     POP   HL   
03D7   D9                     EXX      
03D8   C1                     POP   BC   
03D9   C9                     RET      
03DA                          ENDIF      
03DA                             ; =============================================================================
03DA                             ;  Checked build: the checks and the error report
03DA                             ; =============================================================================
03DA                          IF   CHECKED   
03DA                             ; chkstk: both stacks are checked once per character, not in every handler.
03DA                             ; Each stack lives in one page, so it has overrun exactly when the pointer's
03DA                             ; high byte has left that page. Errors are caught one cell late at most; the
03DA                             ; page below each stack is a guard band. (The call itself is on the data
03DA                             ; stack, but in the same page whenever the stack is in range.)
03DA   ED 73 38 07  CHKSTK:   LD   (SPTMP),SP   
03DE   3A 39 07               LD   A,(SPTMP+1)   
03E1   FE 06                  CP   DSPAGE   
03E3   20 36                  JR   NZ,e_stack   
03E5   D9                     EXX      ; the return stack: in its page, and not
03E6   7D                     LD   A,L   ;   above its empty position (an underflow
03E7   FE E1                  CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
03E9   7C                     LD   A,H   ;   guard band)
03EA   D9                     EXX      
03EB   30 31                  JR   NC,e_rstack   
03ED   FE 05                  CP   RSPAGE   
03EF   C8                     RET   Z   
03F0   18 2C                  JR   e_rstack   
03F2                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
03F2                             ; else is held for the next "?".
03F2   CD B5 03     CHKBRK:   CALL   getk   
03F5   C8                     RET   Z   
03F6   FE 03                  CP   3   
03F8   28 27                  JR   Z,e_break   
03FA   32 36 07               LD   (KEYBUF),A   
03FD   C9                     RET      
03FE                             ; chkst: stop unless HL is in the program's own space: from the letter page
03FE                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
03FE                             ; whatever lies above the limit are safe. Memory above the heap top but
03FE                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
03FE                             ; Keeps every register.
03FE   F5           CHKST:    PUSH   AF   
03FF   7C                     LD   A,H   
0400   FE 07                  CP   LETPAGE   
0402   38 14                  JR   C,e_store   
0404                          ENDIF      
0404                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              JR   NC,e_store   
0404                          ENDIF      
0404                          IF   CHECKED*CPM   
0404   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0407   3D                     DEC   A   
0408   BC                     CP   H   
0409   38 0D                  JR   C,e_store   
040B                          ENDIF      
040B                          IF   CHECKED   
040B   F1                     POP   AF   
040C   C9                     RET      
040D                             ; chkhp: stop if working out the new heap top carried (a negative count
040D                             ; wraps: too big), or if the new top in HL is not below the limit page.
040D   38 06        CHKHP:    JR   C,e_heap   
040F                          ENDIF      
040F                          IF   CHECKED*(1-CPM)   
                              LD   A,H   
                              CP   HEAPLIM   
                              RET   C   
040F                          ENDIF      
040F                          IF   CHECKED*CPM   
040F   3A 07 00               LD   A,(0007h)   
0412   3D                     DEC   A   
0413   BC                     CP   H   
0414   D0                     RET   NC   
0415                          ENDIF      
0415                          IF   CHECKED   
0415                             ; Error entries. Each loads its letter and then hides the next entry inside
0415                             ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
0415   3E 48        E_HEAP:   LD   A,"H"   ; heap past the limit
0417   21                     DB   21h   
0418   3E 57        E_STORE:   LD   A,"W"   ; write outside the program's space
041A   21                     DB   21h   
041B   3E 53        E_STACK:   LD   A,"S"   ; data stack over or under
041D   21                     DB   21h   
041E   3E 52        E_RSTACK:   LD   A,"R"   ; return stack over or under
0420   21                     DB   21h   
0421   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C
0423   21                     DB   21h   
0424   3E 44        E_BRACK:   LD   A,"D"   ; bad character after [
0426                             ; error: print the letter in A, " @ " and the offset in the program of the
0426                             ; character just read, then end. For example: S @ 245
0426   31 FE 06     ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
0429   EF                     RST   28h   
042A   3E 20                  LD   A," "   
042C   EF                     RST   28h   
042D   3E 40                  LD   A,"@"   
042F   EF                     RST   28h   
0430   3E 20                  LD   A," "   
0432   EF                     RST   28h   
0433   21 FF F7               LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
0436   09                     ADD   HL,BC   ;   just read: HL = its offset
0437   CD 71 03               CALL   pdec   
043A   C3 15 01               JP   endprog   
043D                          ENDIF      
043D                             ; =============================================================================
043D                             ;  The line editor (EDITOR = 1)
043D                             ; 
043D                             ;  The interpreter starts here, and a program that ends comes back here. Type
043D                             ;  a line and press Return:
043D                             ; 
043D                             ;    n text    put the text in as line n; the lines from n on move down.
043D                             ;              A number past the end adds the line at the end.
043D                             ;    n         take line n out
043D                             ;    0         list the program
043D                             ;    anything that does not start with a digit is run at once, as B8Script
043D                             ; 
043D                             ;  To run the program, jump to it from such a line:  33536{]   (33536 is
043D                             ;  PROG, 8300h). Lines are counted, not numbered: there are no line numbers in
043D                             ;  the text. Line numbers go from 1 to 128, a line holds 125 characters, and
043D                             ;  nothing is checked. The text is stored as it is typed, each line ending in
043D                             ;  CR LF, at PROG; the space after the line number is stored too.
043D                             ; 
043D                             ;  A line is put in one character at a time, each one rippling the rest of
043D                             ;  the program up by a byte: small code, but slow in a long program.
043D                             ; 
043D                             ;  Things to know:
043D                             ;    - Reset empties the program.
043D                             ;    - The list shows no line numbers and only the first 128 lines. A line
043D                             ;      number above 128 lists part of the program on its way to the line.
043D                             ;    - Words and variables last from one line to the next. A word's address
043D                             ;      points into the program, so run the program again after editing it.
043D                             ;    - Nothing is printed between a program's output and what is typed next.
043D                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
043D                             ;      a line that calls -n? and carries on afterwards runs what was typed.
043D                             ;      (A program started with {] never comes back to the line, so it may.)
043D                             ; =============================================================================
043D                          IF   EDITOR   
                                 ; a line number came first: L = the number, BC -> what follows it
                    ED1:      LD   D,L   ; D counts down to the line wanted. From 0 it
                              LD   HL,PROG   ;   wraps to FFh: bit 7 of D makes nxl list.
                    F1:       DEC   D   
                              JR   Z,found   
                              CALL   nxl   ; step over one line
                              OR   A   
                              JR   NZ,f1   ; (A = 0: that was the end of the text)
                    FOUND:    LD   A,(BC)   ; HL -> line n, or the end of the text
                              CP   13   
                              JR   Z,del   ; nothing after the number: take the line out
                                 ; Put the typed text in at HL: CR, LF and all, up to the NUL after them.
                    INS:      LD   A,(BC)   
                              INC   BC   
                              OR   A   
                              JR   Z,edit   
                              PUSH   HL   
                              LD   D,A   ; D = the byte to put down
                    IN1:      LD   A,(HL)   ; pick up the byte that was there,
                              LD   (HL),D   ;   put ours down,
                              INC   HL   
                              LD   D,A   ;   and carry the old one on,
                              OR   A   
                              JR   NZ,in1   ;   until the NUL has been moved
                              LD   (HL),A   ; the new NUL
                              POP   HL   
                              INC   HL   
                              JR   ins   
                                 ; Take the line at HL out: copy everything after it down over it.
                    DEL:      PUSH   HL   
                              CALL   nxl   ; HL -> the next line (D is 0 here: no listing)
                              POP   DE   
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
                              LD   L,83h   ; (minus 125)
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   ; (D is FDh after rdline: bit 7 is set, so
                              CALL   nxl   ;   nxl echoes the CR LF as a new line)
                              LD   (HL),0   ;   and a NUL after that
                              LD   BC,LINEBUF   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   NZ,ed1   ; there was a number
                                 ; No number: run the line where it is (BC = LINEBUF).
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; nxl: step HL over one line, to just past its LF, and return A = 10; or stop
                                 ; at the NUL that ends the text and return A = 0. If bit 7 of D is set, print
                                 ; the line on the way.
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              BIT   7,D   
                              JR   Z,nx2   
                              RST   28h   
                    NX2:      LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              RET      
043D                          ENDIF      
043D                             ; =============================================================================
043D                             ;  CP/M startup (the generic build starts at address 0: see st0)
043D                             ; =============================================================================
043D                          IF   CPM   
043D                             ; The RAM pages follow the image; the heap may grow to the BDOS.
043D   21 08 01     START:    LD   HL,vecs   ; the RST routines go down into page zero
0440   11 08 00               LD   DE,0008h   
0443   01 2C 00               LD   BC,vecend-vecs   
0446   ED B0                  LDIR      
0448   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
044B   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
044D   CD 05 00               CALL   BDOS   ;   and the program is empty)
0450   11 00 08               LD   DE,PROG   
0453   D5           LD1:      PUSH   DE   
0454   0E 1A                  LD   C,26   ; set the DMA address
0456   CD 05 00               CALL   BDOS   
0459   11 5C 00               LD   DE,005Ch   
045C   0E 14                  LD   C,20   ; read the next 128 bytes
045E   CD 05 00               CALL   BDOS   
0461   E1                     POP   HL   ; HL = the address this record went to
0462   B7                     OR   A   
0463   20 07                  JR   NZ,ld2   
0465   11 80 00               LD   DE,128   
0468   19                     ADD   HL,DE   
0469   EB                     EX   DE,HL   
046A   18 E7                  JR   ld1   
046C   36 00        LD2:      LD   (HL),0   ; the end of the file counts as NUL
046E   23                     INC   HL   ; the heap starts after it
046F   01 00 08               LD   BC,PROG   ; the IP
0472   C3 73 01               JP   st2   
0475                          ENDIF      
0475                          IF   CPM   
0475                             ; RAM pages, after the image
0475                RSPAGE:   EQU   (imgend + 255) / 256   
0475                DSPAGE:   EQU   RSPAGE + 1   
0475                LETPAGE:   EQU   RSPAGE + 2   
0475                PROG:     EQU   LETPAGE*256 + 256   
0475                          ENDIF      
0475                IMGEND:      


