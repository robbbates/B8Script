  1068 00000537 89C8                <1>         mov     eax,ecx
  1069 00000539 85C0                <1>         test    eax,eax
  1070 0000053B 7501                <1>         jnz     .gk1
  1071 0000053D 48                  <1>         dec     eax                     ; (-1: INFINITE)
  1072 0000053E E872FFFFFF          <1> .gk1:   call    waitk
  1073 00000543 750F                <1>         jnz     pk1                     ; Ctrl-C? If not, that is the key
  1074 00000545 C3                  <1> gk9:    ret
  1075                              <1> ; pollk: the break check (see rpoll).
  1076 00000546 31C0                <1> pollk:  xor     eax,eax
  1077 00000548 E868FFFFFF          <1>         call    waitk
  1078 0000054D 74F6                <1>         jz      gk9                     ; no key
  1079 0000054F A27A014100          <1>         mov     [ARENA+HELD],al         ; held for the next '?'
  1080 00000554 3C03                <1> pk1:    cmp     al,3
  1081 00000556 75ED                <1>         jne     gk9
  1082                              <1> ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
  1083                              <1> ; the program has turned it off, wait about 250 ms for one more key: a
  1084                              <1> ; second Ctrl-C is the end too; any other key is held (the newest wins),
  1085                              <1> ; and the Ctrl-C goes to the program: returns AL = 3, zero flag clear.
  1086 00000558 803D7B01410000      <1> ctlc:   cmp     byte [ARENA+BRKOFF],0
  1087 0000055F 0F845AFDFFFF        <1> .ct0:   jz      brk
  1088 00000565 B8FA000000          <1>         mov     eax,250
  1089 0000056A E846FFFFFF          <1>         call    waitk
  1090 0000056F 3C03                <1>         cmp     al,3
  1091 00000571 74EC                <1>         je      .ct0                    ; (the zero flag takes the JZ there)
  1092 00000573 84C0                <1>         test    al,al
  1093 00000575 7405                <1>         jz      .ct3
  1094 00000577 A27A014100          <1>         mov     [ARENA+HELD],al
  1095 0000057C B003                <1> .ct3:   mov     al,3
  1096 0000057E 84C0                <1>         test    al,al
  1097 00000580 C3                  <1>         ret
  1098                              <1> 
  1099                              <1> %if CHECKED=0
  1100                              <1>  %if EDITOR
  1101                              <1> brk     equ     edit0                   ; the editor: back, both stacks cleared
  1102                              <1>  %else
  1103                              <1> brk     equ     exit                    ; the runner stops without a word
  1104                              <1>  %endif
  1105                              <1> %else
  1106                              <1> brk     equ     e_break                 ; the checked build reports B
  1107                              <1> %endif
  1108                              <1> %if EDITOR
  1109                              <1> SKEND   equ     skend                   ; a program that ends goes back to the
  1110                              <1> %else                                   ;   editor, also when it ends inside skip
  1111                              <1> SKEND   equ     exit
  1112                              <1> %endif
  1113                              <1> 
  1114                              <1> ; endprog: the inner loop read the NUL that ends the program. In the checked
  1115                              <1> ; build an IP of 0001h means the NUL at 0000h, where every undefined word's
  1116                              <1> ; cell points: U, with the call undone, so the place is the call itself.
  1117                              <1> endprog:
  1118                              <1> %if CHECKED
  1119 00000581 6683FE01            <1>         cmp     si,1                    ; (ESI is in the arena)
  1120 00000585 750A                <1>         jne     .ep1
  1121 00000587 8B37                <1>         mov     esi,[edi]
  1122 00000589 AF                  <1>         scasd
  1123 0000058A B055                <1>         mov     al,'U'
  1124 0000058C E943FDFFFF          <1>         jmp     error
  1125                              <1> .ep1:
  1126                              <1> %endif
  1127                              <1> %if EDITOR
  1128                              <1>         jmp     edend
  1129                              <1> %else
  1130 00000591 E91CFBFFFF          <1>         jmp     exit
  1131                              <1> %endif
  1132                              <1> 
  1133                              <1> 
  1134                              <1> %if CHECKED+EDITOR
  1135                              <1> ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
  1136                              <1> ;                             Rtn n
  1137                              <1> ; TOS must be in memory with the rest (pushed), and pstk is called: so the
  1138                              <1> ; top cell is at [ESP+4] here, and the depth is 2 less than the dwords
  1139                              <1> ; down to V_DSTOP (the call, and the cell that stands for TOS when the stack
  1140                              <1> ; is empty).
  1141 00000596 E8FBFEFFFF          <1> pstk:   call    pmsg
  1142 0000059B 2F4D2F4A53746B2022  <1>         db      '/M/JStk ',22h
  1143 000005A4 8B4562              <1>         mov     eax,[V(v_dstop)]
  1144 000005A7 29E0                <1>         sub     eax,esp
  1145 000005A9 C1E802              <1>         shr     eax,2
  1146 000005AC 48                  <1>         dec     eax
  1147 000005AD 48                  <1>         dec     eax
  1148 000005AE 50                  <1>         push    eax
  1149 000005AF E8ACFEFFFF          <1>         call    pdec                    ; the depth
  1150 000005B4 B03A                <1>         mov     al,':'
  1151 000005B6 E8E3FEFFFF          <1>         call    putc
  1152 000005BB 59                  <1>         pop     ecx
  1153 000005BC 83F909              <1>         cmp     ecx,9
  1154 000005BF 720D                <1>         jb      .ps1
  1155 000005C1 E8D0FEFFFF          <1>         call    pmsg
  1156 000005C6 202E2E2E22          <1>         db      ' ...',22h
  1157 000005CB 6A08                <1>         push    8
  1158 000005CD 59                  <1>         pop     ecx
  1159 000005CE E313                <1> .ps1:   jecxz   .ps3                    ; ECX = the number of cells to show
  1160 000005D0 B020                <1> .ps2:   mov     al,' '
  1161 000005D2 E8C7FEFFFF          <1>         call    putc
  1162 000005D7 8B048C              <1>         mov     eax,[esp+ecx*4]
  1163 000005DA 51                  <1>         push    ecx
  1164 000005DB E870FEFFFF          <1>         call    psgn
  1165 000005E0 59                  <1>         pop     ecx
  1166 000005E1 E2ED                <1>         loop    .ps2
  1167 000005E3 E8AEFEFFFF          <1> .ps3:   call    pmsg
  1168 000005E8 2F4D2F4A52746E2022  <1>         db      '/M/JRtn ',22h
  1169 000005F1 B800FF4000          <1>         mov     eax,RSTOP
  1170 000005F6 29F8                <1>         sub     eax,edi
  1171 000005F8 C1E802              <1>         shr     eax,2
  1172 000005FB E960FEFFFF          <1>         jmp     pdec
  1173                              <1> %endif
  1174                              <1> 
  1175                              <1> ; =============================================================================
  1176                              <1> ;  The line editor (EDITOR = 1)
  1177                              <1> ;
  1178                              <1> ;  The interpreter starts here, and a program that ends comes back here.
  1179                              <1> ;  There is no prompt. It follows the spec's suggested standard for a line
  1180                              <1> ;  editor (docs/b8script.md, Environments), and is the Z80's editor, key for
  1181                              <1> ;  key. Type a line and press Return:
  1182                              <1> ;
  1183                              <1> ;    n text    put the text in as line n; the lines from n on move down. A
  1184                              <1> ;              number past the end (or 0) adds the line at the end.
  1185                              <1> ;    n         take line n out
  1186                              <1> ;    anything else is run at once, as B8Script. (Start such a line with a
  1187                              <1> ;    space if it would begin with a digit.)
  1188                              <1> ;
  1189                              <1> ;  A command key ends the line too, and takes what was typed as its argument:
  1190                              <1> ;
  1191                              <1> ;    ^G        run the program
  1192                              <1> ;    n ^L      list from line n (no number: all of it). Any key holds the
  1193                              <1> ;              list until another key is pressed; Ctrl-C ends it.
  1194                              <1> ;    n ^E      put line n in the input line; Return puts it back, changed
  1195                              <1> ;    name ^R   read the file of that name (no name: the current one: the
  1196                              <1> ;              one from the command line, or the last one typed)
  1197                              <1> ;    name ^W   write the program to that file (no name: the current one)
  1198                              <1> ;    ^N ^N     new: no program (the key twice in a row)
  1199                              <1> ;    ^V        view: the build, both stacks, and the program's size, lines
  1200                              <1> ;              and free memory
  1201                              <1> ;    ^X        leave
  1202                              <1> ;
  1203                              <1> ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
  1204                              <1> ;  a character goes in at the cursor; Backspace and DEL take out the one
  1205                              <1> ;  before it; Esc drops the line (after Esc it waits 5 ms for a '[': Esc [ C
  1206                              <1> ;  and Esc [ D are right and left too). Only CR, LF, BS and printing
  1207                              <1> ;  characters are sent to the terminal.
  1208                              <1> ;
  1209                              <1> ;  Lines are counted, not numbered. A typed line holds 125 characters; the
  1210                              <1> ;  one character after a line number separates it from the text and is not
  1211                              <1> ;  stored. The text is kept as typed, each line ending in CR LF, at PROG. A
  1212                              <1> ;  file is read up to its first ^Z, and a last line with no line end is
  1213                              <1> ;  given one; it is written as it is, with no padding.
  1214                              <1> ;
  1215                              <1> ;  What lasts from one line to the next: the program, the words, the
  1216                              <1> ;  variables and the data stack (TOS is kept pushed while the editor runs).
  1217                              <1> ;  An error or a break clears both stacks. The return stack starts empty for
  1218                              <1> ;  every line.
  1219                              <1> ;
  1220                              <1> ;  Registers in the editor: EBX = the cursor, EDX = the end of the line
  1221                              <1> ;  (pointers into the line buffer); EDI is free (edit resets it).
  1222                              <1> ; =============================================================================
  1223                              <1> %if EDITOR
  1224                              <1> ; ^F, right arrow: one to the right, by printing the character there
  1225                              <1> right:  cmp     ebx,edx
  1226                              <1>         je      ed1                     ; at the end
  1227                              <1>         mov     al,[ebx]
  1228                              <1>         inc     ebx
  1229                              <1>         jmp     short lf1
  1230                              <1> 
  1231                              <1> ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
  1232                              <1> ; wait about 5 ms for a second key: after a '[' read on to the letter that
  1233                              <1> ; ends the sequence, and act on C (right) and D (left).
  1234                              <1> esc:    push    5
  1235                              <1>         pop     eax
  1236                              <1>         call    waitk
  1237                              <1>         jnz     .es2
  1238                              <1>         call    fin                     ; no second key: the line is dropped
  1239                              <1>         jmp     edit
  1240                              <1> .es2:   cmp     al,'['
  1241                              <1>         jne     ed1                     ; not a sequence known here
  1242                              <1> .es3:   call    ekey
  1243                              <1>         cmp     al,40h
  1244                              <1>         jb      .es3                    ; (its parameters)
  1245                              <1>         sub     al,'C'
  1246                              <1>         je      right
  1247                              <1>         dec     al                      ; 'D'?
  1248                              <1>         jne     ed1                     ; no: on into left
  1249                              <1> ; ^B, left arrow: the cursor goes one to the left
  1250                              <1> left:   cmp     bl,80h
  1251                              <1>         je      ed1                     ; at the start
  1252                              <1>         dec     ebx
  1253                              <1>         mov     al,8
  1254                              <1> lf1:    call    putc
  1255                              <1>         jmp     ed1
  1256                              <1> 
  1257                              <1> ; edit0: an error or a break: both stacks are cleared.
  1258                              <1> ; skend: a program that ended inside skip: its return address goes.
  1259                              <1> ; edend: a program that ended: TOS joins the rest of the data stack.
  1260                              <1> edit0:  mov     esp,[V(v_dstop)]
  1261                              <1>  %if CHECKED
  1262                              <1>         push    -11                     ; the report went to stderr: back to
  1263                              <1>         call    [V(iat_GetStdHandle)]   ;   stdout
  1264                              <1>         mov     [V(v_outh)],eax
  1265                              <1>  %endif
  1266                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1267                              <1> skend:  pop     eax
  1268                              <1> edend:  push    ebx
  1269                              <1> ; edit: start a new input line.
  1270                              <1> edit:   mov     edi,RSTOP               ; the return stack is empty
  1271                              <1>         xor     eax,eax
  1272                              <1>         mov     [ARENA+HELD],ax         ; no key is held, and the break key is on
  1273                              <1>         mov     [V(v_edln)],eax         ; no line is being edited
  1274                              <1>         mov     ebx,ARENA+LINEBUF       ; EBX = the cursor,
  1275                              <1>         mov     edx,ebx                 ;   EDX = the end of the line
  1276                              <1> ed1:    call    ekey
  1277                              <1>         cmp     al,7Fh
  1278                              <1>         je      bsp                     ; DEL
  1279                              <1>         cmp     al,' '
  1280                              <1>         jae     insc
  1281                              <1>         cmp     al,9
  1282                              <1>         je      insc                    ; Tab is text
  1283                              <1>         cmp     al,8
  1284                              <1>         je      bsp
  1285                              <1>         cmp     al,2
  1286                              <1>         je      left                    ; ^B
  1287                              <1>         cmp     al,6
  1288                              <1>         je      right                   ; ^F
  1289                              <1>         cmp     al,1Bh
  1290                              <1>         je      esc
  1291                              <1>         push    edi                     ; a command key? Look it up
  1292                              <1>         mov     edi,ckeys
  1293                              <1>         push    NCMD
  1294                              <1>         pop     ecx
  1295                              <1>         repne   scasb
  1296                              <1>         pop     edi
  1297                              <1>         jne     ed1                     ; no: the key is ignored
  1298                              <1>         movzx   eax,word [ctabr+ecx*2]  ; the command's address: fin returns
  1299                              <1>         add     eax,IB                  ;   to it
  1300                              <1>         push    eax
  1301                              <1> ; fin: end the input line: CR LF and a NUL after it, and a new line on the
  1302                              <1> ; terminal. Leaves ESI -> the line.
  1303                              <1> fin:    mov     word [edx],0A0Dh
  1304                              <1>         mov     esi,edx
  1305                              <1>         call    prl                     ; (prints the CR LF)
  1306                              <1>         mov     byte [esi],0
  1307                              <1>         mov     esi,ARENA+LINEBUF
  1308                              <1>         ret
  1309                              <1> 
  1310                              <1> ; Backspace, DEL: the character before the cursor goes. The cursor moves
  1311                              <1> ; left, the rest of the line moves down over it, and the last place (now a
  1312                              <1> ; space) is printed over along with the rest.
  1313                              <1> bsp:    cmp     bl,80h
  1314                              <1>         je      ed1                     ; at the start
  1315                              <1>         dec     ebx
  1316                              <1>         mov     al,8
  1317                              <1>         call    putc
  1318                              <1>         mov     ecx,ebx
  1319                              <1> .bs1:   mov     al,[ecx+1]
  1320                              <1>         mov     [ecx],al
  1321                              <1>         inc     ecx
  1322                              <1>         cmp     ecx,edx
  1323                              <1>         jne     .bs1
  1324                              <1>         mov     byte [ecx-1],' '
  1325                              <1>         dec     edx
  1326                              <1>         jmp     short ic2
  1327                              <1> ; A character goes in at the cursor: it ripples up through the rest of the
  1328                              <1> ; line, the cursor moves on, and the rest is printed again.
  1329                              <1> insc:   cmp     dl,0FDh
  1330                              <1>         je      ed1                     ; the line is full: 125 characters
  1331                              <1>         call    putc
  1332                              <1>         mov     ecx,ebx
  1333                              <1> .ic1:   xchg    al,[ecx]
  1334                              <1>         inc     ecx
  1335                              <1>         cmp     ecx,edx
  1336                              <1>         jbe     .ic1
  1337                              <1>         inc     ebx
  1338                              <1>         inc     edx
  1339                              <1>         mov     ecx,edx
  1340                              <1> ic2:    call    tail
  1341                              <1>         jmp     ed1
  1342                              <1> ; tail: print the line from the cursor to ECX, and bring the cursor back
  1343                              <1> ; with backspaces. Nothing at all if the cursor is at ECX.
  1344                              <1> tail:   mov     esi,ebx
  1345                              <1> .ta1:   cmp     esi,ecx
  1346                              <1>         je      .ta2
  1347                              <1>         lodsb
  1348                              <1>         call    putc
  1349                              <1>         jmp     .ta1
  1350                              <1> .ta2:   cmp     esi,ebx
  1351                              <1>         je      .ta3
  1352                              <1>         mov     al,8
  1353                              <1>         call    putc
  1354                              <1>         dec     esi
  1355                              <1>         jmp     .ta2
  1356                              <1> .ta3:   ret
  1357                              <1> 
  1358                              <1> ; ekey: wait for a key
  1359                              <1> ekey:   or      eax,-1
  1360                              <1>         jmp     waitk
  1361                              <1> 
  1362                              <1> ; The command keys, and where each goes (after fin). REPNE SCASB leaves ECX
  1363                              <1> ; = the number of keys after the one found, so the table is backwards. (The
  1364                              <1> ; addresses are kept as RVAs, which fit in a word.)
  1365                              <1> ckeys:  db      13, 7, 12, 5, 18, 23, 14, 22, 24
  1366                              <1> NCMD    equ     $-ckeys
  1367                              <1> ctabr:  dw      exit-IB                 ; ^X
  1368                              <1>         dw      cview-IB                   ; ^V
  1369                              <1>         dw      cnew-IB                 ; ^N
  1370                              <1>         dw      cwrite-IB                  ; ^W
  1371                              <1>         dw      cread-IB                   ; ^R
  1372                              <1>         dw      cedln-IB                   ; ^E
  1373                              <1>         dw      clist-IB                   ; ^L
  1374                              <1>         dw      crun-IB                 ; ^G
  1375                              <1>         dw      cret-IB                 ; Return
  1376                              <1> 
  1377                              <1> ; ^N ^N: no program, if the next key is ^N too
  1378                              <1> cnew:   call    ekey
  1379                              <1>         cmp     al,14
  1380                              <1>         jne     gedit
  1381                              <1>         mov     byte [ARENA+PROG],0
  1382                              <1> gedit:  jmp     edit
  1383                              <1> 
  1384                              <1> ; ^E: line n goes into the input line, to be changed. V_EDLN remembers
  1385                              <1> ; which line it was: Return puts the text back in its place.
  1386                              <1> cedln:  call    rdnum
  1387                              <1>         movzx   eax,dx
  1388                              <1>         push    eax
  1389                              <1>         call    find                    ; EDI -> the line, or the NUL
  1390                              <1>         pop     eax
  1391                              <1>         cmp     byte [edi],0
  1392                              <1>         je      gedit
  1393                              <1>         mov     [V(v_edln)],eax
  1394                              <1>         mov     ebx,ARENA+LINEBUF
  1395                              <1> .ce1:   mov     al,[edi]                ; copy it, and show it, up to its CR
  1396                              <1>         cmp     al,13                   ;   (or LF)
  1397                              <1>         je      .ce2
  1398                              <1>         cmp     al,10
  1399                              <1>         je      .ce2
  1400                              <1>         mov     [ebx],al
  1401                              <1>         call    putc
  1402                              <1>         inc     edi
  1403                              <1>         inc     ebx
  1404                              <1>         cmp     bl,0FDh                 ; (a longer line is cut at 125)
  1405                              <1>         jne     .ce1
  1406                              <1> .ce2:   mov     edx,ebx                 ; the cursor is at the line's end
  1407                              <1>         jmp     ed1
  1408                              <1> 
  1409                              <1> ; Return. If ^E put a line here, the text goes back in its place. If not:
  1410                              <1> ; a number and text is a line to put in, a number alone a line to take out,
  1411                              <1> ; and anything else is run where it is.
  1412                              <1> cret:   push    edx                     ; the end of what was typed
  1413                              <1>         mov     eax,[V(v_edln)]
  1414                              <1>         test    eax,eax
  1415                              <1>         jz      .cr1
  1416                              <1>         push    eax
  1417                              <1>         call    delln
  1418                              <1>         pop     eax
  1419                              <1>         jmp     short ins
  1420                              <1> .cr1:   call    rdnum                   ; DX = the number it starts with
  1421                              <1>         mov     eax,esi                 ; ESI's low byte is still 80h if there
  1422                              <1>         cmp     al,80h                  ;   was no number:
  1423                              <1>         je      runln                   ;   then run the line
  1424                              <1>         movzx   eax,dx
  1425                              <1>         cmp     byte [esi],13
  1426                              <1>         jne     .cr2
  1427                              <1>         pop     edx                     ; the number alone: take that line out
  1428                              <1>         call    delln
  1429                              <1>         jmp     gedit
  1430                              <1> .cr2:   inc     esi                     ; step over the one character after it
  1431                              <1> 
  1432                              <1> ; Put the text at ESI in as line EAX: open a gap of its length there, CR
  1433                              <1> ; and LF included, and copy it in.
  1434                              <1> ins:    call    find                    ; EDI -> where it goes
  1435                              <1>         pop     ecx                     ; the end of what was typed
  1436                              <1>         inc     ecx
  1437                              <1>         inc     ecx
  1438                              <1>         sub     ecx,esi                 ; the length, with its CR LF
  1439                              <1>         push    esi                     ; the text
  1440                              <1>         push    ecx                     ; its length
  1441                              <1>         push    edi                     ; where it goes
  1442                              <1>         mov     esi,edi
  1443                              <1> .in1:   lodsb                           ; find the program's NUL
  1444                              <1>         test    al,al
  1445                              <1>         jnz     .in1
  1446                              <1>         dec     esi
  1447                              <1>         mov     ecx,esi
  1448                              <1>         sub     ecx,edi
  1449                              <1>         inc     ecx                     ; the bytes to move up, NUL included
  1450                              <1>         mov     edi,esi
  1451                              <1>         add     edi,[esp+4]             ; the NUL's new place
  1452                              <1>         std
  1453                              <1>         rep     movsb                   ; move the rest of the program up
  1454                              <1>         cld
  1455                              <1>         pop     edi
  1456                              <1>         pop     ecx
  1457                              <1>         pop     esi
  1458                              <1>         rep     movsb
  1459                              <1>         jmp     gedit
  1460                              <1> 
  1461                              <1> ; ^G: run the program. runln: run the typed line (ESI -> it).
