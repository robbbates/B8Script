E233   C6 FF        TRUE:     LDB   #0FFh   
E235   1D                     SEX      ; D = 0000 or FFFF
E236   ED C4                  STD   ,U   
E238   39                     RTS      
E239   8D 04        H_EQ:     BSR   cmp   
