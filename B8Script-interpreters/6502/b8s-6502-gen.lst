E4B5   A5 02        EXEC:     LDA   TL   
E4B7   85 04                  STA   T0   
E4B9   A5 03                  LDA   TH   
E4BB   85 05                  STA   T1   
E4BD   20 80 E1               JSR   drop   ; the address is consumed
E4C0   6C 04 00               JMP   (T0)   
E4C3                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E4C3                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E4C3   20 48 E1     RDHEX:    JSR   peek   
E4C6   38                     SEC      
E4C7   E9 30                  SBC   #"0"   
