0739                          IF   FAST*(1-CHECKED)   
                                 ; a-z, unchecked: a variable followed by "@" or "!" is fetched or stored in
                                 ; the same step.
                    FVA:      LD   HL,LET+40h+0   ; a
                              LD   A,(BC)   
                              CP   "@"   
                              JP   Z,fvat   
                              CP   "!"   
                              JP   Z,fvst   
