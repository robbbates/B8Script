0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (CONIN/CONOUT/CONST at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpush and rpop (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP DE to throw the return address away.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                CONIN:    EQU   0FF00h   ; wait for a key, return it in A
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                CONST:    EQU   0FF06h   ; A = 0 if no key is waiting, else nonzero
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   All three console routines must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms: each pass
0000                             ; calls getk once, so tune it for your clock
0000                             ; and your CONST routine
0000                CAP:      EQU   127   ; -n? reads at most this many characters
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
                              .ORG   0100h   
                              JP   start   
0000                          ENDIF      
0000                          IFN   CPM   
0000                          .ORG   0000h   
0000   C3 5C 03               JP   start   ; 0000h reset
0003                ENDPROG:      
0003   C3 09 FF               JP   EXIT   ; 0003h the program has ended
0006   E5           H_DUP:    PUSH   HL   ; 0006h ":" (two-byte handlers fill the gaps)
0007   D7                     RST   10h   
0008                             ; ---- RST 08h: drop TOS, then next ------------------------------------------
0008   D1                     POP   DE   ; 0008h discard the RST's return address
0009                DROP_NEXT:      
0009   E1                     POP   HL   ; new TOS = NOS
000A   18 05                  JR   next0   
000C   E3           H_SWAP:   EX   (SP),HL   ; 000Ch "%"
000D   D7                     RST   10h   
000E   00 00                  DB   0,0   ; 000Eh spare
0010                             ; ---- RST 10h: next character ------------------------------------------------
0010   D1                     POP   DE   ; 0010h discard the RST's return address
0011                          ENDIF      
0011                             ; =============================================================================
0011                             ;  The inner loop: read one character and sort it by range.
0011                             ; 
0011                             ;    00h          end of program
0011                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0011                             ;    30h-39h      digit: read a whole number
0011                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0011                             ;    61h-7Ah      a-z: push the address of that letter's cell
0011                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0011                             ; =============================================================================
0011                NEXT0:       
0011                          IF   CHECKED   
                                 ; Both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the
                                 ; pointer's high byte has left that page. Errors are caught one cell
                                 ; late at most; the page below each stack is a guard band.
                              LD   (SPTMP),SP   
                              LD   A,(SPTMP+1)   
                              CP   DSPAGE   
                              JP   NZ,e_stack   
                              EXX      ; the return stack: in its page, and not
                              LD   A,L   ;   above its empty position (an underflow
                              CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              LD   A,H   ;   guard band)
                              EXX      
                              JP   NC,e_rstack   
                              CP   RSPAGE   
                              JP   NZ,e_rstack   
0011                          ENDIF      
0011   0A                     LD   A,(BC)   
0012   03                     INC   BC   
0013   D6 21                  SUB   21h   ; A = c - 21h
0015   38 38                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0017   FE 0F                  CP   0Fh   
0019   38 26                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
001B   D6 0F                  SUB   0Fh   ; A = c - 30h
001D   FE 0A                  CP   0Ah   
001F   38 4A                  JR   C,digit   ; 30h-39h
0021   FE 11                  CP   11h   
0023   30 04                  JR   NC,ab40   
0025   C6 05                  ADD   A,5   ; 3Ah-40h: index 15-21
0027   18 18                  JR   punct   
0029   D6 11        AB40:     SUB   11h   ; A = c - 41h
002B   FE 1A                  CP   1Ah   
002D   38 2D                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
002F   FE 20                  CP   20h   
0031   30 04                  JR   NC,ab60   
0033   D6 04                  SUB   4   ; 5Bh-60h: index 22-27
0035   18 0A                  JR   punct   
0037   FE 3A        AB60:     CP   3Ah   
0039   38 1B                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
003B   FE 3E                  CP   3Eh   
003D   30 D2                  JR   NC,next0   ; 7Fh-FFh: ignored
003F   D6 1E                  SUB   1Eh   ; 7Bh-7Eh: index 28-31
0041                             ; Punctuation: HL holds TOS, so it is parked in DE while the table is read.
0041                             ; PTAB never crosses a page (checked at assembly), so only L needs adding.
0041   EB           PUNCT:    EX   DE,HL   ; DE = TOS
0042   87                     ADD   A,A   
0043   C6 71                  ADD   A,PTAB & 0FFh   
0045   6F                     LD   L,A   
0046   26 00                  LD   H,PTAB / 256   
0048   7E                     LD   A,(HL)   
0049   2C                     INC   L   
004A   66                     LD   H,(HL)   
004B   6F                     LD   L,A   ; HL = handler
004C   EB                     EX   DE,HL   ; HL = TOS, DE = handler
004D   D5                     PUSH   DE   ; jump to it; the stack is balanced again
004E   C9                     RET      ;   when the handler starts
004F   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
0051   20 BE                  JR   NZ,next0   
0053   C3 03 00               JP   endprog   
0056                             ; a-z: push the cell's address (the cell is the variable)
0056   E5           LOWER:    PUSH   HL   
0057   87                     ADD   A,A   
0058   6F                     LD   L,A   
0059   26 82                  LD   H,LETPAGE   
005B   D7                     RST   10h   
005C                             ; A-Z: call the word. The return address (the IP after the letter) goes on
005C                             ; the return stack, and the IP becomes the address in the letter's cell.
005C   E5           UPPER:    PUSH   HL   ; keep TOS
005D   87                     ADD   A,A   
005E   6F                     LD   L,A   
005F   26 82                  LD   H,LETPAGE   ; HL -> cell
0061   5E                     LD   E,(HL)   
0062   2C                     INC   L   
0063   56                     LD   D,(HL)   ; DE = the word's body
0064   E1                     POP   HL   ; TOS back
0065   CD C7 00               CALL   rpush   ; push the return address (IP)
0068   42                     LD   B,D   
0069   4B                     LD   C,E   ; IP = body
006A   D7                     RST   10h   
006B                             ; Digits: step back onto the first digit and read the whole number.
006B   E5           DIGIT:    PUSH   HL   
006C   0B                     DEC   BC   
006D   CD B1 00               CALL   rdnum   
0070   D7                     RST   10h   
0071                             ; =============================================================================
0071                             ;  Dispatch table: one handler per punctuation character, in code order.
0071                             ;  It sits right after the inner loop so that it can't cross a page (the
0071                             ;  loop only adds to the low byte of its address).
0071                             ; =============================================================================
0071   B4 01        PTAB:     DW   h_store   ; !
0073   51 02                  DW   h_str   ; "
0075   75 02                  DW   h_num   ; #
0077   58 02                  DW   h_print   ; $
0079   0C 00                  DW   h_swap   ; %
007B   66 01                  DW   h_and   ; &
007D   70 02                  DW   h_emit   ; '
007F   C7 01                  DW   h_open   ; (
0081   D4 01                  DW   h_close   ; )
0083   F8 00                  DW   h_mul   ; *
0085   D9 00                  DW   h_add   ; +
0087   9C 02                  DW   h_cfetch   ; ,
0089   DC 00                  DW   h_sub   ; -
008B   B9 01                  DW   h_cstore   ; .
008D   0E 01                  DW   h_div   ; /
008F   06 00                  DW   h_dup   ; :
0091   09 00                  DW   drop_next   ; ;
0093   86 01                  DW   h_lt   ; <
0095   96 01                  DW   h_eq   ; =
0097   83 01                  DW   h_gt   ; >
0099   9F 02                  DW   h_key   ; ?
009B   AF 01                  DW   h_fetch   ; @
009D   FB 01                  DW   h_def   ; [
009F   E6 01                  DW   h_break   ; \
00A1   F5 01                  DW   h_ret   ; ]
00A3   76 01                  DW   h_xor   ; ^
00A5   BC 01                  DW   h_alloc   ; _
00A7   13 03                  DW   h_grave   ; `
00A9   A1 01                  DW   h_tor   ; {
00AB   6E 01                  DW   h_or   ; |
00AD   A9 01                  DW   h_fromr   ; }
00AF   7E 01                  DW   h_not   ; ~
00B1                PTABEND:      
00B1                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
00B1                             ; non-digit. Values wrap at 16 bits, as the spec says.
00B1   21 00 00     RDNUM:    LD   HL,0   
00B4   0A           RDN1:     LD   A,(BC)   
00B5   D6 30                  SUB   "0"   
00B7   FE 0A                  CP   10   
00B9   D0                     RET   NC   
00BA   03                     INC   BC   
00BB   54                     LD   D,H   
00BC   5D                     LD   E,L   
00BD   29                     ADD   HL,HL   
00BE   29                     ADD   HL,HL   
00BF   19                     ADD   HL,DE   
00C0   29                     ADD   HL,HL   ; HL * 10
00C1   5F                     LD   E,A   
00C2   16 00                  LD   D,0   
00C4   19                     ADD   HL,DE   
00C5   18 ED                  JR   rdn1   
00C7                             ; =============================================================================
00C7                             ;  Return stack. rpush pushes BC (nearly always the IP); rpop pops into DE.
00C7                             ;  HL' is the pointer. Both go through the Z80 stack to cross between the
00C7                             ;  register sets.
00C7                             ; =============================================================================
00C7   C5           RPUSH:    PUSH   BC   
00C8   D9                     EXX      
00C9   D1                     POP   DE   
00CA   2B                     DEC   HL   
00CB   72                     LD   (HL),D   
00CC   2B                     DEC   HL   
00CD   73                     LD   (HL),E   
00CE   D9                     EXX      
00CF   C9                     RET      
00D0   D9           RPOP:     EXX      
00D1   5E                     LD   E,(HL)   
00D2   23                     INC   HL   
00D3   56                     LD   D,(HL)   
00D4   23                     INC   HL   
00D5   D5                     PUSH   DE   
00D6   D9                     EXX      
00D7   D1                     POP   DE   
00D8   C9                     RET      
00D9                             ; =============================================================================
00D9                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
00D9                             ; =============================================================================
00D9   D1           H_ADD:    POP   DE   
00DA   19                     ADD   HL,DE   
00DB   D7                     RST   10h   
00DC                             ; "-" has two jobs: directly before a digit it starts a negative number.
00DC   0A           H_SUB:    LD   A,(BC)   
00DD   D6 30                  SUB   "0"   
00DF   FE 0A                  CP   10   
00E1   38 06                  JR   C,negnum   
00E3   CD F1 00               CALL   neg16   ; a - b = a + (-b)
00E6   D1                     POP   DE   
00E7   19                     ADD   HL,DE   
00E8   D7                     RST   10h   
00E9   E5           NEGNUM:   PUSH   HL   
00EA   CD B1 00               CALL   rdnum   
00ED   CD F1 00               CALL   neg16   
00F0   D7                     RST   10h   
00F1                             ; neg16: HL = -HL (keeps BC, DE)
00F1   AF           NEG16:    XOR   A   
00F2   95                     SUB   L   
00F3   6F                     LD   L,A   
00F4   9F                     SBC   A,A   
00F5   94                     SUB   H   
00F6   67                     LD   H,A   
00F7   C9                     RET      
00F8                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept.
00F8   D1           H_MUL:    POP   DE   ; DE = multiplicand
00F9   C5                     PUSH   BC   
00FA   44                     LD   B,H   
00FB   4D                     LD   C,L   ; BC = multiplier
00FC   21 00 00               LD   HL,0   
00FF   3E 10                  LD   A,16   
0101   29           MUL1:     ADD   HL,HL   
0102   CB 21                  SLA   C   
0104   CB 10                  RL   B   
0106   30 01                  JR   NC,mul2   
0108   19                     ADD   HL,DE   
0109   3D           MUL2:     DEC   A   
010A   20 F5                  JR   NZ,mul1   
010C   C1                     POP   BC   
010D   D7                     RST   10h   
010E                             ; "/" ( a b -- q r ): truncates toward zero; r takes a's sign.
010E                             ; b = 0 gives q = 0, r = a. The spec requires dividing by 2 to be fast, so
010E                             ; |b| = 2 takes a one-bit shift instead of the 16-round loop; the signs are
010E                             ; handled once, for both paths: divide |a| by |b|, then q gets the sign of
010E                             ; a XOR b and r the sign of a.
010E   D1           H_DIV:    POP   DE   ; DE = a, HL = b
010F   7C                     LD   A,H   
0110   B5                     OR   L   
0111   20 03                  JR   NZ,div1   
0113   E5                     PUSH   HL   ; b = 0: q = 0
0114   EB                     EX   DE,HL   ;        r = a
0115   D7                     RST   10h   
0116   C5           DIV1:     PUSH   BC   ; free BC for udiv
0117   7A                     LD   A,D   
0118   B7                     OR   A   
0119   F5                     PUSH   AF   ; S flag = sign of a (for r)
011A   AC                     XOR   H   
011B   F5                     PUSH   AF   ; S flag = sign of q
011C   CB 7C                  BIT   7,H   
011E   C4 F1 00               CALL   NZ,neg16   ; HL = |b|
0121   EB                     EX   DE,HL   
0122   CB 7C                  BIT   7,H   
0124   C4 F1 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0127   7B                     LD   A,E   
0128   EE 02                  XOR   2   
012A   B2                     OR   D   
012B   20 0D                  JR   NZ,div2   
012D   CB 3C                  SRL   H   ; |b| = 2: q = |a| >> 1 ...
012F   CB 1D                  RR   L   
0131   44                     LD   B,H   
0132   4D                     LD   C,L   
0133   21 00 00               LD   HL,0   ; ... and r = the bit shifted out
0136   ED 6A                  ADC   HL,HL   
0138   18 03                  JR   div3   
013A   CD 4D 01     DIV2:     CALL   udiv   ; BC = q, HL = r
013D   F1           DIV3:     POP   AF   
013E   E5                     PUSH   HL   
013F   60                     LD   H,B   
0140   69                     LD   L,C   
0141   FC F1 00               CALL   M,neg16   ; q's sign
0144   D1                     POP   DE   ; DE = r
0145   F1                     POP   AF   
0146   EB                     EX   DE,HL   ; HL = r, DE = q
0147   FC F1 00               CALL   M,neg16   ; r's sign
014A   C1                     POP   BC   
014B   D5                     PUSH   DE   ; q under r
014C   D7                     RST   10h   
014D                             ; udiv: unsigned HL / DE. Returns BC = quotient, HL = remainder.
014D                             ; Uses A, BC; the caller saves the IP.
014D   44           UDIV:     LD   B,H   
014E   4D                     LD   C,L   
014F   21 00 00               LD   HL,0   
0152   3E 10                  LD   A,16   
0154   CB 21        UDV1:     SLA   C   
0156   CB 10                  RL   B   
0158   ED 6A                  ADC   HL,HL   
015A   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
015C   30 03                  JR   NC,udv2   ;   always fits in 16 bits
015E   19                     ADD   HL,DE   
015F   18 01                  JR   udv3   
0161   0C           UDV2:     INC   C   
0162   3D           UDV3:     DEC   A   
0163   20 EF                  JR   NZ,udv1   
0165   C9                     RET      
0166   D1           H_AND:    POP   DE   
0167   7C                     LD   A,H   
0168   A2                     AND   D   
0169   67                     LD   H,A   
016A   7D                     LD   A,L   
016B   A3                     AND   E   
016C   6F                     LD   L,A   
016D   D7                     RST   10h   
016E   D1           H_OR:     POP   DE   
016F   7C                     LD   A,H   
0170   B2                     OR   D   
0171   67                     LD   H,A   
0172   7D                     LD   A,L   
0173   B3                     OR   E   
0174   6F                     LD   L,A   
0175   D7                     RST   10h   
0176   D1           H_XOR:    POP   DE   
0177   7C                     LD   A,H   
0178   AA                     XOR   D   
0179   67                     LD   H,A   
017A   7D                     LD   A,L   
017B   AB                     XOR   E   
017C   6F                     LD   L,A   
017D   D7                     RST   10h   
017E   CD F1 00     H_NOT:    CALL   neg16   ; ~x = -x - 1
0181   2B                     DEC   HL   
0182   D7                     RST   10h   
0183                             ; Signed compares. Flipping both sign bits turns a signed compare into an
0183                             ; unsigned one; SBC HL,HL then turns the carry into -1 or 0 with no branch.
0183   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0184   18 02                  JR   cmp   
0186   D1           H_LT:     POP   DE   ; a < b: HL = a, DE = b
0187   EB                     EX   DE,HL   
0188   7C           CMP:      LD   A,H   
0189   EE 80                  XOR   80h   
018B   67                     LD   H,A   
018C   7A                     LD   A,D   
018D   EE 80                  XOR   80h   
018F   57                     LD   D,A   
0190   B7                     OR   A   
0191   ED 52                  SBC   HL,DE   ; carry if HL < DE
0193   ED 62                  SBC   HL,HL   
0195   D7                     RST   10h   
0196   D1           H_EQ:     POP   DE   
0197   B7                     OR   A   
0198   ED 52                  SBC   HL,DE   
019A   21 00 00               LD   HL,0   
019D   20 01                  JR   NZ,eq1   
019F   2B                     DEC   HL   
01A0   D7           EQ1:      RST   10h   
01A1                             ; =============================================================================
01A1                             ;  Stack
01A1                             ; =============================================================================
01A1                          IF   CPM   ; (the generic build has these in page zero)
                    H_DUP:    PUSH   HL   
                              RST   10h   
                    H_SWAP:   EX   (SP),HL   
                              RST   10h   
01A1                          ENDIF      
01A1   C5           H_TOR:    PUSH   BC   ; "{" TOS to the return stack
01A2   44                     LD   B,H   
01A3   4D                     LD   C,L   
01A4   CD C7 00               CALL   rpush   
01A7   C1                     POP   BC   
01A8   CF                     RST   08h   
01A9   E5           H_FROMR:   PUSH   HL   ; "}" return stack to TOS
01AA   CD D0 00               CALL   rpop   
01AD   EB                     EX   DE,HL   
01AE   D7                     RST   10h   
01AF                             ; =============================================================================
01AF                             ;  Storage
01AF                             ; =============================================================================
01AF   5E           H_FETCH:   LD   E,(HL)   ; "@"
01B0   23                     INC   HL   
01B1   56                     LD   D,(HL)   
01B2   EB                     EX   DE,HL   
01B3   D7                     RST   10h   
01B4   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
01B5                          IF   CHECKED   
                              INC   HL   ; both bytes must be in the program's space
                              CALL   chkst   
                              DEC   HL   
01B5                          ENDIF      
01B5   73                     LD   (HL),E   
01B6   23                     INC   HL   
01B7   72                     LD   (HL),D   
01B8   CF                     RST   08h   
01B9   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
01BA                          IF   CHECKED   
                              CALL   chkst   
01BA                          ENDIF      
01BA   73                     LD   (HL),E   
01BB   CF                     RST   08h   
01BC                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
01BC   EB           H_ALLOC:   EX   DE,HL   
01BD   2A 7C 82               LD   HL,(HEAP)   
01C0   E5                     PUSH   HL   
01C1   19                     ADD   HL,DE   
01C2                          IF   CHECKED   
                              JP   C,e_heap   ; a negative count wraps: too big
                              LD   A,(HLIM)   
                              DEC   A   
                              CP   H   
                              JP   C,e_heap   ; the new top must stay below the limit page
01C2                          ENDIF      
01C2   22 7C 82               LD   (HEAP),HL   
01C5   E1                     POP   HL   
01C6   D7                     RST   10h   
01C7                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   AF   
                              LD   A,H   
                              CP   LETPAGE   
                              JR   C,chk1   
                              LD   A,(HLIM)   
                              DEC   A   
                              CP   H   
                    CHK1:     JP   C,e_store   
                              POP   AF   
                              RET      
01C7                          ENDIF      
01C7                             ; =============================================================================
01C7                             ;  Flow control
01C7                             ; =============================================================================
01C7                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
01C7                             ; the matching ")".
01C7   7C           H_OPEN:   LD   A,H   
01C8   B5                     OR   L   
01C9   E1                     POP   HL   
01CA   28 04                  JR   Z,skipnx   
01CC   CD C7 00               CALL   rpush   ; the block starts at the IP
01CF   D7                     RST   10h   
01D0   CD 19 02     SKIPNX:   CALL   skip   
01D3   D7                     RST   10h   
01D4                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
01D4                             ; drops it and carries on.
01D4   7C           H_CLOSE:   LD   A,H   
01D5   B5                     OR   L   
01D6   E1                     POP   HL   
01D7   28 09                  JR   Z,rdrop   
01D9                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every loop-back
01D9                          ENDIF      
01D9   CD D0 00               CALL   rpop   ; peek: pop the block start ...
01DC   42                     LD   B,D   
01DD   4B                     LD   C,E   
01DE   CD C7 00               CALL   rpush   ; ... and push it back
01E1   D7                     RST   10h   
01E2   CD D0 00     RDROP:    CALL   rpop   
01E5   D7                     RST   10h   
01E6                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E6                             ; drops the block start, "]" returns. No closer at all ends the program.
01E6   7C           H_BREAK:   LD   A,H   
01E7   B5                     OR   L   
01E8   E1                     POP   HL   
01E9   28 09                  JR   Z,brk1   
01EB   CD 19 02               CALL   skip   
01EE   FE 29                  CP   ")"   
01F0   28 F0                  JR   Z,rdrop   
01F2   18 01                  JR   h_ret   
01F4   D7           BRK1:     RST   10h   
01F5                             ; "]" returns: pop an address and jump to it.
01F5   CD D0 00     H_RET:    CALL   rpop   
01F8   42                     LD   B,D   
01F9   4B                     LD   C,E   
01FA                          IF   CHECKED   
                              CALL   chkbrk   ; ... and at every word return
01FA                          ENDIF      
01FA   D7                     RST   10h   
01FB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01FB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01FB                             ; the body"s address instead. Either way it then skips to the matching "]'.
01FB   0A           H_DEF:    LD   A,(BC)   
01FC   03                     INC   BC   
01FD   5F                     LD   E,A   
01FE   E6 DF                  AND   0DFh   ; fold case
0200   D6 41                  SUB   "A"   
0202   FE 1A                  CP   26   
0204   30 0E                  JR   NC,def2   ; not a letter
0206   7B                     LD   A,E   
0207   D6 41                  SUB   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
0209   87                     ADD   A,A   
020A   5F                     LD   E,A   
020B   16 82                  LD   D,LETPAGE   ; DE -> cell
020D   79                     LD   A,C   
020E   12                     LD   (DE),A   
020F   1C                     INC   E   
0210   78                     LD   A,B   
0211   12                     LD   (DE),A   
0212   18 BC                  JR   skipnx   
0214                DEF2:        
0214                          IF   CHECKED   
                              LD   A,E   
                              CP   " "   
                              JP   NZ,e_brack   ; anything but a letter or a space
0214                          ENDIF      
0214   E5                     PUSH   HL   ; an anonymous block: push its address
0215   60                     LD   H,B   
0216   69                     LD   L,C   
0217   18 B7                  JR   skipnx   
0219                             ; skip: read past text to the closer at this level, and return it in A.
0219                             ; Brackets of both kinds count together; strings are stepped over whole. A
0219                             ; NUL first ends the program (for "\" with no closer; anything else that runs
0219                             ; into the NUL had unbalanced brackets anyway).
0219   16 00        SKIP:     LD   D,0   
021B   0A           SK1:      LD   A,(BC)   
021C   03                     INC   BC   
021D   B7                     OR   A   
021E   CA 03 00               JP   Z,endprog   
0221   FE 22                  CP   22h   
0223   20 05                  JR   NZ,sk2   
0225   CD 43 02               CALL   skipstr   
0228   18 F1                  JR   sk1   
022A   FE 28        SK2:      CP   "("   
022C   28 12                  JR   Z,sk3   
022E   FE 5B                  CP   "["   
0230   28 0E                  JR   Z,sk3   
0232   FE 29                  CP   ")"   
0234   28 04                  JR   Z,sk4   
0236   FE 5D                  CP   "]"   
0238   20 E1                  JR   NZ,sk1   
023A   14           SK4:      INC   D   
023B   15                     DEC   D   
023C   C8                     RET   Z   ; the closer at this level
023D   15                     DEC   D   
023E   18 DB                  JR   sk1   
0240   14           SK3:      INC   D   
0241   18 D8                  JR   sk1   
0243                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0243                             ; the next character, so "/"" does not end it.
0243   0A           SKIPSTR:   LD   A,(BC)   
0244   03                     INC   BC   
0245   FE 2F                  CP   "/"   
0247   20 03                  JR   NZ,ss1   
0249   03                     INC   BC   
024A   18 F7                  JR   skipstr   
024C   FE 22        SS1:      CP   22h   
024E   20 F3                  JR   NZ,skipstr   
0250   C9                     RET      
0251                             ; =============================================================================
0251                             ;  Console
0251                             ; =============================================================================
0251                             ; 22h pushes the address of the text after it and skips the string.
0251   E5           H_STR:    PUSH   HL   
0252   60                     LD   H,B   
0253   69                     LD   L,C   
0254   CD 43 02               CALL   skipstr   
0257   D7                     RST   10h   
0258                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
0258                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
0258                             ; that character itself.
0258   7E           H_PRINT:   LD   A,(HL)   
0259   23                     INC   HL   
025A   FE 22                  CP   22h   
025C   28 11                  JR   Z,prdone   
025E   FE 2F                  CP   "/"   
0260   20 08                  JR   NZ,pr1   
0262   7E                     LD   A,(HL)   
0263   23                     INC   HL   
0264   FE 40                  CP   40h   
0266   38 02                  JR   C,pr1   
0268   E6 BF                  AND   0BFh   
026A   CD 03 FF     PR1:      CALL   putc   
026D   18 E9                  JR   h_print   
026F   CF           PRDONE:   RST   08h   
0270   7D           H_EMIT:   LD   A,L   ; "'"
0271   CD 03 FF               CALL   putc   
0274   CF                     RST   08h   
0275                             ; "#" prints TOS as a signed decimal number, with no space after it.
0275   CB 7C        H_NUM:    BIT   7,H   
0277   28 08                  JR   Z,num1   
0279   3E 2D                  LD   A,"-"   
027B   CD 03 FF               CALL   putc   
027E   CD F1 00               CALL   neg16   
0281   C5           NUM1:     PUSH   BC   
0282   CD 87 02               CALL   pdec   
0285   C1                     POP   BC   
0286   CF                     RST   08h   
0287                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
0287   11 0A 00     PDEC:     LD   DE,10   
028A   CD 4D 01               CALL   udiv   ; BC = HL / 10, HL = digit
028D   7D                     LD   A,L   
028E   F5                     PUSH   AF   
028F   60                     LD   H,B   
0290   69                     LD   L,C   
0291   7C                     LD   A,H   
0292   B5                     OR   L   
0293   C4 87 02               CALL   NZ,pdec   
0296   F1                     POP   AF   
0297   C6 30                  ADD   A,"0"   
0299   C3 03 FF               JP   putc   
029C   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
029D   18 1A                  JR   kt3   
029F                             ; "?" ( n -- c ) or ( -n -- addr )
029F                             ;   n > 0: wait about n ms for a key; 0 if none came
029F                             ;   n = 0: wait for a key
029F                             ;   n < 0: read a line of at most -n characters (capped at CAP) with echo
029F   CB 7C        H_KEY:    BIT   7,H   
02A1   20 1A                  JR   NZ,line   
02A3   11 28 00     KT1:      LD   DE,MSLOOP   ; one millisecond, roughly
02A6   CD 52 03     KT2:      CALL   getk   
02A9   20 0E                  JR   NZ,kt3   
02AB   1B                     DEC   DE   
02AC   7A                     LD   A,D   
02AD   B3                     OR   E   
02AE   20 F6                  JR   NZ,kt2   
02B0   7C                     LD   A,H   ; 0? never counts down: it waits
02B1   B5                     OR   L   
02B2   28 EF                  JR   Z,kt1   
02B4   2B                     DEC   HL   
02B5   7C                     LD   A,H   
02B6   B5                     OR   L   
02B7   20 EA                  JR   NZ,kt1   ; A = 0 if the time ran out
02B9   6F           KT3:      LD   L,A   
02BA   26 00                  LD   H,0   
02BC   D7                     RST   10h   
02BD   CD F1 00     LINE:     CALL   neg16   ; HL = the count
02C0   7C                     LD   A,H   
02C1   B7                     OR   A   
02C2   20 05                  JR   NZ,ln0   
02C4   7D                     LD   A,L   
02C5   FE 80                  CP   CAP+1   
02C7   38 02                  JR   C,ln1   
02C9   3E 7F        LN0:      LD   A,CAP   
02CB                LN1:         
02CB                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                              LD   (LBHDR),A   
                              PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   DE,LBHDR   
                              LD   C,10   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              LD   HL,LBHDR+1   
                              LD   E,(HL)   ; count
                              LD   D,0   
                              INC   HL   ; HL = LINEBUF
                              PUSH   HL   
                              ADD   HL,DE   
                              LD   (HL),13   
                              POP   HL   
                              RST   10h   
02CB                          ENDIF      
02CB                          IFN   CPM   
02CB                             ; Generic: Backspace and DEL erase, CR ends (stored, not echoed),
02CB                             ; other control keys are ignored, and a full line takes only those.
02CB   C5                     PUSH   BC   
02CC   4F                     LD   C,A   ; C = max
02CD   06 00                  LD   B,0   ; B = length
02CF   21 80 82               LD   HL,LINEBUF   
02D2   CD 52 03     LN2:      CALL   getk   
02D5   28 FB                  JR   Z,ln2   
02D7   FE 0D                  CP   13   
02D9   28 31                  JR   Z,ln5   
02DB   FE 08                  CP   8   
02DD   28 16                  JR   Z,ln4   
02DF   FE 7F                  CP   7Fh   
02E1   28 12                  JR   Z,ln4   
02E3   FE 20                  CP   " "   
02E5   38 EB                  JR   C,ln2   
02E7   5F                     LD   E,A   
02E8   78                     LD   A,B   
02E9   B9                     CP   C   
02EA   30 E6                  JR   NC,ln2   ; full
02EC   73                     LD   (HL),E   
02ED   23                     INC   HL   
02EE   04                     INC   B   
02EF   7B                     LD   A,E   
02F0   CD 03 FF               CALL   putc   
02F3   18 DD                  JR   ln2   
02F5   78           LN4:      LD   A,B   
02F6   B7                     OR   A   
02F7   28 D9                  JR   Z,ln2   
02F9   05                     DEC   B   
02FA   2B                     DEC   HL   
02FB   3E 08                  LD   A,8   
02FD   CD 03 FF               CALL   putc   
0300   3E 20                  LD   A," "   
0302   CD 03 FF               CALL   putc   
0305   3E 08                  LD   A,8   
0307   CD 03 FF               CALL   putc   
030A   18 C6                  JR   ln2   
030C   36 0D        LN5:      LD   (HL),13   
030E   C1                     POP   BC   
030F   21 80 82               LD   HL,LINEBUF   
0312   D7                     RST   10h   
0313                          ENDIF      
0313                             ; =============================================================================
0313                             ;  Machine code: the grave
0313                             ; =============================================================================
0313                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
0313                             ; are stored from addr until a non-hex character; then a RET (C9h) is
0313                             ; written and its address is left. An odd last digit is consumed and dropped.
0313                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
0313                             ; code is entered by CALL with the data stack above the return address; it
0313                             ; must keep BC, and on return the top cell becomes the new TOS.
0313   0A           H_GRAVE:   LD   A,(BC)   
0314   CD 41 03               CALL   hexval   
0317   38 17                  JR   C,exec   
0319   0A           HX1:      LD   A,(BC)   
031A   CD 41 03               CALL   hexval   
031D   38 0E                  JR   C,hx2   
031F   03                     INC   BC   
0320                          IF   CHECKED   
                              CALL   chkst   
0320                          ENDIF      
0320   77                     LD   (HL),A   ; the high digit goes in first ...
0321   0A                     LD   A,(BC)   
0322   CD 41 03               CALL   hexval   
0325   38 06                  JR   C,hx2   ; odd digit: consumed, and the RET below
0327   03                     INC   BC   ;   overwrites it
0328   ED 6F                  RLD      ; ... and RLD shifts it up under the low one
032A   23                     INC   HL   
032B   18 EC                  JR   hx1   
032D                HX2:         
032D                          IF   CHECKED   
                              CALL   chkst   
032D                          ENDIF      
032D   36 C9                  LD   (HL),0C9h   
032F   D7                     RST   10h   
0330   D9           EXEC:     EXX      
0331   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
0334   D9                     EXX      
0335   11 3A 03               LD   DE,exret   
0338   D5                     PUSH   DE   
0339   E9                     JP   (HL)   
033A   D9           EXRET:    EXX      
033B   2A 34 82               LD   HL,(RSAVE)   
033E   D9                     EXX      
033F   E1                     POP   HL   
0340   D7                     RST   10h   
0341                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
0341                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
0341   D6 30        HEXVAL:   SUB   "0"   
0343   FE 0A                  CP   10   
0345   3F                     CCF      
0346   D0                     RET   NC   
0347   E6 DF                  AND   0DFh   
0349   D6 11                  SUB   11h   
034B   FE 06                  CP   6   
034D   3F                     CCF      
034E   D8                     RET   C   
034F   C6 0A                  ADD   A,10   
0351   C9                     RET      
0352                             ; =============================================================================
0352                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
0352                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
0352                             ;  Both keep BC, DE, HL and HL'.
0352                             ; =============================================================================
0352                GETK:        
0352                          IF   CHECKED   
                              LD   A,(KEYBUF)   ; a key held back by the break check
                              OR   A   
                              JR   Z,gk1   
                              PUSH   AF   
                              XOR   A   
                              LD   (KEYBUF),A   
                              POP   AF   
                              RET      
                    GK1:         
0352                          ENDIF      
0352                          IF   CPM   
                              LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              CALL   putc   
                              OR   A   
                              RET      
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              RET      
0352                          ENDIF      
0352                          IFN   CPM   
0352   CD 06 FF               CALL   CONST   
0355   B7                     OR   A   
0356   C8                     RET   Z   
0357   CD 00 FF               CALL   CONIN   
035A   B7                     OR   A   
035B   C9                     RET      
035C                PUTC:     EQU   CONOUT   
035C                          ENDIF      
035C                             ; =============================================================================
035C                             ;  Checked build: break key and error reports
035C                             ; =============================================================================
035C                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   LD   A,(KEYBUF)   
                              OR   A   
                              RET   NZ   ; one key is already held
                              CALL   getk   
                              RET   Z   
                              CP   3   
                              JR   Z,e_break   
                              LD   (KEYBUF),A   
                              RET      
                    E_STACK:   CALL   error   
                              DB   "stac","k"+80h   
                    E_RSTACK:   CALL   error   
                              DB   "retur","n"+80h   
                    E_BREAK:   CALL   error   
                              DB   "brea","k"+80h   
                    E_HEAP:   CALL   error   
                              DB   "hea","p"+80h   
                    E_STORE:   CALL   error   
                              DB   "stor","e"+80h   
                    E_BRACK:   CALL   error   
                              DB   "["+80h   
                                 ; error: print CR LF, the word after the CALL (last character has bit 7
                                 ; set), " at " and the offset of the reading position in the program.
                    ERROR:    POP   HL   ; HL -> the word
                              LD   SP,DSTOP   ; the stacks may be wrecked: start clean
                              LD   A,13   
                              CALL   putc   
                              LD   A,10   
                              CALL   putc   
                    ER1:      LD   A,(HL)   
                              INC   HL   
                              PUSH   AF   
                              AND   7Fh   
                              CALL   putc   
                              POP   AF   
                              RLA      
                              JR   NC,er1   
                              LD   HL,er2   
                    ER3:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er4   
                              CALL   putc   
                              JR   er3   
                    ER4:      LD   H,B   
                              LD   L,C   
                              LD   DE,PROG+1   ; the character just read
                              OR   A   
                              SBC   HL,DE   
                              CALL   pdec   
                              JP   endprog   
                    ER2:      DB   " at ",0   
035C                          ENDIF      
035C                             ; =============================================================================
035C                             ;  Startup
035C                             ; =============================================================================
035C                START:       
035C                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LD   SP,DSTOP   
                              LD   HL,stubs   ; RST 08h and RST 10h stubs into page zero
                              LD   DE,0008h   
                              LD   BC,13   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   
                              CALL   BDOS   
                              INC   A   
                              JP   Z,0   ; no such file: back to CP/M
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              OR   A   
                              JR   Z,ld1   
                              LD   HL,-128   ; the failed read left nothing: back up
                              ADD   HL,DE   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   
                              LD   (HEAP),HL   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              LD   (HLIM),A   
035C                          ENDIF      
035C                          IFN   CPM   
035C   31 FE 81               LD   SP,DSTOP   
035F   21 00 83               LD   HL,PROG   ; the heap starts after the program's NUL
0362   AF                     XOR   A   
0363   47                     LD   B,A   
0364   4F                     LD   C,A   
0365   ED B1                  CPIR      
0367   22 7C 82               LD   (HEAP),HL   
036A                          ENDIF      
036A                          IF   (1-CPM)*CHECKED   
                              LD   A,HEAPLIM   
                              LD   (HLIM),A   
036A                          ENDIF      
036A   D9                     EXX      
036B   21 E0 80               LD   HL,RSTOP   
036E   D9                     EXX      
036F                          IF   CHECKED   
                              XOR   A   
                              LD   (KEYBUF),A   
036F                          ENDIF      
036F   01 00 83               LD   BC,PROG   
0372   C3 11 00               JP   next0   
0375                          IF   CPM   
                    STUBS:    POP   DE   ; 0008h: drop, then next
                              POP   HL   
                              JP   next0   
                              DB   0,0,0   
                              POP   DE   ; 0010h: next
                              JP   next0   
                    ENDPROG:   EQU   0   ; warm boot
                    DROP_NEXT:   EQU   0009h   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0375                          ENDIF      
0375                IMGEND:      


