05A1   79                     LD   A,C   ; C is still 80h if there was no number:
05A2   87                     ADD   A,A   ;   only then is twice it 0
05A3   28 36                  JR   Z,st0p   ; no number: run the line
05A5   0A                     LD   A,(BC)   
05A6   FE 0D                  CP   13   
05A8   20 06                  JR   NZ,cr2   
05AA   D1                     POP   DE   ; the number alone: take that line out
05AB   CD 7C 06               CALL   delln   
05AE   18 24                  JR   gedit   
05B0   03           CR2:      INC   BC   ; step over the one character after the number
