0199   E5           H_DUP:    PUSH   HL   ; ":"
019A   F7                     RST   30h   
019B   E3           H_SWAP:   EX   (SP),HL   ; "%"
019C   F7                     RST   30h   
019D                             ; (The checked build tests the address before it takes the value off the
019D                             ; stack, so that an error report shows both.)
019D                H_CSTORE:      ; "." ( c addr -- )
019D                          IF   CHECKED   
                              CALL   chkst   
019D                          ENDIF      
019D   D1                     POP   DE   
019E   73                     LD   (HL),E   
019F   DF           H_DROP:   RST   18h   ; ";" is this one byte
01A0                H_STORE:      ; "!" ( n addr -- )
01A0                          IF   CHECKED   
                              CALL   chkst   
01A0                          ENDIF      
01A0   D1                     POP   DE   
01A1   73                     LD   (HL),E   
01A2   23                     INC   HL   
01A3   72                     LD   (HL),D   
01A4   DF                     RST   18h   
01A5                             ; ---- console ---------------------------------------------------------------
01A5                             ; 22h pushes the address of the text after it and skips the string.
01A5   E5           H_STR:    PUSH   HL   
01A6   60                     LD   H,B   
01A7   69                     LD   L,C   
01A8   CD BF 02               CALL   skipstr   
01AB                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01AB                          ENDIF      
01AB   F7                     RST   30h   
01AC                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01AC                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01AC                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
01AC                             ; no bit 6, so // and /" give themselves).
01AC                          IF   1-PRSUB   
01AC   7E           H_PRINT:   LD   A,(HL)   
01AD   23                     INC   HL   
01AE   FE 22                  CP   22h   
01B0   28 15                  JR   Z,pr9   
01B2   FE 2F                  CP   "/"   
01B4   20 0C                  JR   NZ,pr1   
01B6   7E                     LD   A,(HL)   
01B7   23                     INC   HL   
01B8   FE 60                  CP   60h   
01BA   38 04                  JR   C,pr0   
01BC   FE 7F                  CP   7Fh   
01BE   38 57                  JR   C,pesc   
01C0   E6 BF        PR0:      AND   0BFh   
01C2   EF           PR1:      RST   28h   
01C3   18 E7                  JR   h_print   
01C5                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
01C5                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01C5                          ENDIF      
01C5                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
