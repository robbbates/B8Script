0161   B5                     ORA   L   ; zero if equal
0162   D6 01                  SUI   1   ; carry only for zero
0164   9F                     SBB   A   
0165   67                     MOV   H,A   
0166   6F                     MOV   L,A   
0167                          ;*Macro unroll:  NEXT
0167   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0168                          DS   CPM+FAST-CPM*FAST,0C3h   
0168                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0168                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0168                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0168                             ; multiplier is used up; only the low 16 bits are kept.
0168                          IF   QK   
0168   D1           H_MUL:    POP   D   ; DE = multiplicand
0169   C3 D4 03               JMP   mulq   ; (out of the handlers' pages: see Speed-ups)
016C                          ENDIF      
016C                          IF   1-QK   
                    H_MUL:    POP   D   ; DE = multiplicand
                              PUSH   B   
                              MOV   B,H   
                              MOV   C,L   ; BC = multiplier
                              LXI   H,0   
                    MUL1:     MOV   A,B   
                              ORA   A   ; clear carry
                              RAR      
                              MOV   B,A   
                              MOV   A,C   
                              RAR      
                              MOV   C,A   ; BC >> 1, carry = the bit shifted out
                              JNC   mul2   
                              DAD   D   
                    MUL2:     XCHG      
                              DAD   H   ; multiplicand << 1
                              XCHG      
                              MOV   A,B   
                              ORA   C   
                              JNZ   mul1   
                              POP   B   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
016C                          ENDIF      
016C                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
016C                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
016C                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
016C                             ; stops on it.
016C                H_DIV:       
016C                          IF   CHECKED   
016C   7C                     MOV   A,H   
016D   B5                     ORA   L   
016E   CA 0E 05               JZ   e_zero   
0171                          ENDIF      
0171   D1                     POP   D   ; DE = a, HL = b
0172   C5                     PUSH   B   
0173   7A                     MOV   A,D   
0174   B7                     ORA   A   
0175   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0176   AC                     XRA   H   
0177   F5                     PUSH   PSW   ; S flag = sign of q
0178   7C                     MOV   A,H   
0179   B7                     ORA   A   
017A   FC 20 00               CM   neg16   ; HL = |b|
017D   EB                     XCHG      
017E   7C                     MOV   A,H   
017F   B7                     ORA   A   
0180   FC 20 00               CM   neg16   ; HL = |a|, DE = |b|
0183   CD 5C 02               CALL   udiv   ; HL = q, BC = r
0186   F1                     POP   PSW   
