0207   73                     MOV   M,E   
0208   CF                     RST   1   
0209                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
0209   EB           H_ALLOC:   XCHG      
020A   2A 7C 82               LHLD   HEAP   
020D   E5                     PUSH   H   
020E   19                     DAD   D   
020F                          IF   CHECKED   
020F   DA 28 04               JC   e_heap   ; a negative count wraps: too big
0212   3A 3A 82               LDA   HLIM   
0215   3D                     DCR   A   
0216   BC                     CMP   H   
0217   DA 28 04               JC   e_heap   ; the new top must stay below the limit page
021A                          ENDIF      
021A   22 7C 82               SHLD   HEAP   
021D   E1                     POP   H   
021E   D7                     RST   2   
021F                          IF   CHECKED   
021F                             ; chkst: stop unless HL is in the program's own space: from the letter page
021F                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
021F                             ; whatever lies above the limit are safe. Memory above the heap top but
021F                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
021F                             ; Keeps every register.
021F   F5           CHKST:    PUSH   PSW   
0220   7C                     MOV   A,H   
0221   FE 82                  CPI   LETPAGE   
0223   DA 2B 02               JC   chk1   
0226   3A 3A 82               LDA   HLIM   
0229   3D                     DCR   A   
022A   BC                     CMP   H   
022B   DA 2F 04     CHK1:     JC   e_store   
