0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 47 03               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 84 03     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 CC 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 DA                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 75                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 77                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 69                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          IF   1-CHECKED   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D   C6 6A        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 00                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE 80                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0066                          ENDIF      
0066                          IFN   CPM   
0066   CB 12                  RL   D   ; its page: 0 + carry
0068                          ENDIF      
0068                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0068                          ENDIF      
0068   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0069   C9                     RET      ;   when the handler starts
006A                             ; The rest of the startup: here so that the generic reset code can reach it
006A                             ; with JR. st0: find the program's NUL; the heap starts after it.
006A                             ; (The editor build has its own copy of this, next to the editor.)
006A                             ; A checked build first clears the lower half of the letter page (A = 0):
006A                             ; every variable starts at 0, every word cell holds 0000h, the address an
006A                             ; undefined word is caught at (see e_hi), and no key is held back.
006A                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006A                          ENDIF      
006A                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
006A                          ENDIF      
006A                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
006A                          ENDIF      ;   these)
006A                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
006A                          ENDIF      
006A                             ; In the unchecked generic editor build the table is here, in the first
006A                             ; page, which saves loading D twice. (The other builds have no room for it
006A                             ; here: theirs is further down.)
006A                          IF   TABP0   
006A                PTAB:        
006A                          ;*Macro unroll:  PTABLE
006A   A2                     DB   h_store & 0FFh   
006B   A7                     DB   h_str & 0FFh   
006C   B5                     DB   h_num & 0FFh   
006D   AE                     DB   h_print & 0FFh   
006E   9D                     DB   h_swap & 0FFh   
006F   45                     DB   h_and & 0FFh   
0070   B2                     DB   h_emit & 0FFh   
0071   21                     DB   h_open & 0FFh   
0072   29                     DB   h_close & 0FFh   
0073   66                     DB   h_mul & 0FFh   
0074   3C                     DB   h_add & 0FFh   
0075   D3                     DB   h_cfetch & 0FFh   
0076   34                     DB   h_sub & 0FFh   
0077   9F                     DB   h_cstore & 0FFh   
0078   7A                     DB   h_div & 0FFh   
0079   9B                     DB   h_dup & 0FFh   
007A   A1                     DB   h_drop & 0FFh   
007B   4D                     DB   h_lt & 0FFh   
007C   5C                     DB   h_eq & 0FFh   
007D   4E                     DB   h_gt & 0FFh   
007E   BB                     DB   h_key & 0FFh   
007F   1C                     DB   h_fetch & 0FFh   
0080   FF                     DB   h_def & 0FFh   
0081   F2                     DB   h_break & 0FFh   
0082   EE                     DB   h_ret & 0FFh   
0083   8A                     DB   h_xor & 0FFh   
0084   9D                     DB   h_alloc & 0FFh   
0085   D8                     DB   h_grave & 0FFh   
0086   2C                     DB   h_tor & 0FFh   
0087   92                     DB   h_or & 0FFh   
0088   1C                     DB   h_fromr & 0FFh   
0089   9A                     DB   h_not & 0FFh   
008A                PTABEND:      
008A                          ENDIF      
008A                             ; =============================================================================
008A                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
008A                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
008A                             ;  is here too: it belongs to "`" and makes the page come out right.
008A                             ; =============================================================================
008A   D1           H_XOR:    POP   DE   
008B   7C                     LD   A,H   
008C   AA                     XOR   D   
008D   67                     LD   H,A   
008E   7D                     LD   A,L   
008F   AB                     XOR   E   
0090   6F                     LD   L,A   
0091   F7                     RST   30h   
0092   D1           H_OR:     POP   DE   
0093   7C                     LD   A,H   
0094   B2                     OR   D   
0095   67                     LD   H,A   
0096   7D                     LD   A,L   
0097   B3                     OR   E   
0098   6F                     LD   L,A   
0099   F7                     RST   30h   
009A   E7           H_NOT:    RST   20h   ; ~x = -x - 1
009B   2B                     DEC   HL   
009C   F7                     RST   30h   
009D                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
009D                             ; the same either way); TOS is the old pointer.
009D   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A1                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A1                          ENDIF      
00A1   19                     ADD   HL,DE   ; the new top
00A2                          IF   CHECKED   
                              CALL   chkhp   
00A2                          ENDIF      
00A2   22 7C 82               LD   (HEAP),HL   
00A5   EB                     EX   DE,HL   
00A6   F7                     RST   30h   
00A7   D9           EXEC:     EXX      
00A8   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00AB   D9                     EXX      
00AC   CD 2B 00               CALL   jphl   
00AF   D9                     EXX      
00B0   2A 34 82               LD   HL,(RSAVE)   
00B3   D9                     EXX      
00B4   E1                     POP   HL   
00B5   F7                     RST   30h   
00B6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00B6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00B6                             ; Digits: step back onto the first digit and read the whole number.
00B6   E5           DIGIT:    PUSH   HL   
00B7   0B                     DEC   BC   
00B8   CD 2C 02               CALL   rdnum   
00BB   F7                     RST   30h   
00BC                             ; a-z: push the cell's address (the cell is the variable)
00BC   E5           LOWER:    PUSH   HL   
00BD   87                     ADD   A,A   
00BE   6F                     LD   L,A   
00BF   26 82                  LD   H,LETPAGE   
00C1   F7                     RST   30h   
00C2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00C2                             ; the return stack, and the IP becomes the address in the letter's cell.
00C2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00C3   EB                     EX   DE,HL   ; park TOS
00C4   87                     ADD   A,A   
00C5   6F                     LD   L,A   
00C6   26 82                  LD   H,LETPAGE   ; HL -> cell
00C8   4E                     LD   C,(HL)   
00C9   2C                     INC   L   
00CA   46                     LD   B,(HL)   ; IP = the word's body
00CB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00CC                             ; rpushn: move the top cell of the data stack (in memory) to the return
00CC                             ; stack, then next. Everything that pushes the return stack ends here.
00CC                             ; 
00CC                             ; The break key is looked at here, so at every word call and loop-back (and
00CC                             ; block entry and "{"), but only one time in 256: B', which nothing else
00CC                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00CC                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00CC                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00CC                             ; both ways out.)
00CC   D9           RPUSHN:   EXX      
00CD   D1                     POP   DE   
00CE   2B                     DEC   HL   
00CF   72                     LD   (HL),D   
00D0   2B                     DEC   HL   
00D1   73                     LD   (HL),E   
00D2   05                     DEC   B   
00D3   D9                     EXX      
00D4   CC 9B 02               CALL   Z,pollk   
00D7   F7                     RST   30h   
00D8                             ; ---- machine code: the grave -----------------------------------------------
00D8                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00D8                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00D8                             ; written and its address is left. An odd last digit is consumed and dropped.
00D8                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00D8                             ; code is entered by CALL with the data stack above the return address; it
00D8                             ; must keep BC, and on return the top cell becomes the new TOS.
00D8   CD 89 02     H_GRAVE:   CALL   hexc   
00DB   30 CA                  JR   NC,exec   
00DD   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00DE   CD 89 02               CALL   hexc   
00E1   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00E3   ED 6F                  RLD      ;   overwrites it
00E5   23                     INC   HL   ; ... and RLD shifts it up under the low one
00E6   CD 89 02               CALL   hexc   
00E9   38 F2                  JR   C,hx1   
00EB   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00ED   F7                     RST   30h   
00EE                             ; ---- where the two pages meet ----------------------------------------------
00EE                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00EE                             ; are in falling code order for this), and where exactly differs between the
00EE                             ; builds: NPG1 follows. Every handler below these four must start in the
00EE                             ; second page, and every one above in the first; chktab.py checks both.
00EE                             ; "]" returns: pop an address and jump to it.
00EE   CF           H_RET:    RST   08h   
00EF   42                     LD   B,D   
00F0   4B                     LD   C,E   
00F1   F7           BRK1:     RST   30h   
00F2                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00F2                             ; drops the block start, "]" returns. No closer at all ends the program.
00F2   7C           H_BREAK:   LD   A,H   
00F3   B5                     OR   L   
00F4   E1                     POP   HL   
00F5   28 FA                  JR   Z,brk1   
00F7   CD 4E 02               CALL   skip   
00FA   B7                     OR   A   ; skip returns 0 for ")"
00FB   20 F1                  JR   NZ,h_ret   
00FD   CF           RDROP:    RST   08h   
00FE   F7                     RST   30h   
00FF                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00FF                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00FF                             ; the body"s address instead. Either way it then skips to the matching "]'.
00FF                             ; (The unchecked build takes anything that is not a letter as the space; the
00FF                             ; checked build stops on it.)
00FF   0A           H_DEF:    LD   A,(BC)   
0100   03                     INC   BC   
0101   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
0103   5F                     LD   E,A   ;   lands 64 bytes up
0104   E6 DF                  AND   0DFh   ; fold case
0106   FE 1A                  CP   26   
0108   30 0B                  JR   NC,def2   ; not a letter
010A   CB 23                  SLA   E   
010C   16 82                  LD   D,LETPAGE   ; DE -> cell
010E   79                     LD   A,C   
010F   12                     LD   (DE),A   
0110   1C                     INC   E   
0111   78                     LD   A,B   
0112   12                     LD   (DE),A   
0113   18 03                  JR   skipnx   
0115                DEF2:        
0115                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0115                          ENDIF      
0115   E5                     PUSH   HL   ; an anonymous block: push its address
0116   60                     LD   H,B   
0117   69                     LD   L,C   
0118                SKIPNX:      
0118                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0118                          ENDIF      ;   opener, the "[", just before where it starts
0118   CD 4E 02     SKIPO:    CALL   skip   
011B   F7                     RST   30h   
011C   5E           H_FETCH:   LD   E,(HL)   ; "@"
011D   23                     INC   HL   
011E   56                     LD   D,(HL)   
011F   EB                     EX   DE,HL   
0120   F7                     RST   30h   
0121                             ; =============================================================================
0121                             ;  Handlers that must start in the image's second page.
0121                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0121                             ;  page.
0121                             ; =============================================================================
0121                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0121                             ; the matching ")".
0121   7C           H_OPEN:   LD   A,H   
0122   B5                     OR   L   
0123   E1                     POP   HL   
0124   28 F2                  JR   Z,skipo   
0126   C5                     PUSH   BC   ; the block starts at the IP
0127   18 A3                  JR   rpushn   
0129                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0129                             ; drops it and carries on.
0129   7C           H_CLOSE:   LD   A,H   
012A   B5                     OR   L   
012B   E1                     POP   HL   
012C   28 CF                  JR   Z,rdrop   
012E   CF                     RST   08h   ; pop the block start ...
012F   42                     LD   B,D   
0130   4B                     LD   C,E   
0131   C5                     PUSH   BC   
0132   18 98                  JR   rpushn   ; ... and push it back
0134                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0134                             ; "-" has two jobs: directly before a digit it starts a negative number.
0134   0A           H_SUB:    LD   A,(BC)   
0135   D6 30                  SUB   "0"   
0137   FE 0A                  CP   10   
0139   38 04                  JR   C,negnum   
013B   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
013C   D1           H_ADD:    POP   DE   
013D   19                     ADD   HL,DE   
013E   F7                     RST   30h   
013F   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0140   CD 2C 02               CALL   rdnum   
0143   E7                     RST   20h   
0144   F7                     RST   30h   
0145   D1           H_AND:    POP   DE   
0146   7C                     LD   A,H   
0147   A2                     AND   D   
0148   67                     LD   H,A   
0149   7D                     LD   A,L   
014A   A3                     AND   E   
014B   6F                     LD   L,A   
014C   F7                     RST   30h   
014D                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
014D                             ; cells first. Flipping both sign bits turns a signed compare into an
014D                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
014D                             ; carry into -1 or 0 with no branch.
014D   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
014E   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
014F   7C                     LD   A,H   
0150   EE 80                  XOR   80h   
0152   67                     LD   H,A   
0153   7A                     LD   A,D   
0154   EE 80                  XOR   80h   
0156   57                     LD   D,A   
0157   ED 52                  SBC   HL,DE   ; carry if HL < DE
0159   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
015B   F7                     RST   30h   
015C   D1           H_EQ:     POP   DE   
015D   B7                     OR   A   
015E   ED 52                  SBC   HL,DE   
0160   7C                     LD   A,H   
0161   B5                     OR   L   
0162   FE 01                  CP   1   ; carry only if a - b = 0
0164   18 F3                  JR   tf   
0166                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0166                             ; multiplier shifts up through A:C.
0166   D1           H_MUL:    POP   DE   ; DE = multiplicand
0167   C5                     PUSH   BC   
0168   7C                     LD   A,H   
0169   4D                     LD   C,L   ; A:C = multiplier
016A   21 00 00               LD   HL,0   
016D   06 10                  LD   B,16   
016F   29           MUL1:     ADD   HL,HL   
0170   CB 21                  SLA   C   
0172   17                     RLA      
0173   30 01                  JR   NC,mul2   
0175   19                     ADD   HL,DE   
0176   10 F7        MUL2:     DJNZ   mul1   
0178   C1                     POP   BC   
0179   F7                     RST   30h   
017A                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
017A                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
017A                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
017A                             ; stops on it.
017A                H_DIV:       
017A                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
017A                          ENDIF      
017A   D1                     POP   DE   ; DE = a, HL = b
017B   C5                     PUSH   BC   ; free BC for udiv
017C   D5                     PUSH   DE   ; a, for r's sign
017D   7A                     LD   A,D   
017E   AC                     XOR   H   
017F   F5                     PUSH   AF   ; S flag = sign of q
0180   CB 7C                  BIT   7,H   
0182   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0185   EB                     EX   DE,HL   
0186   CB 7C                  BIT   7,H   
0188   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
018B   CD 06 02               CALL   udiv   ; HL = q, DE = r
018E   F1                     POP   AF   
018F   FC 20 00               CALL   M,neg16   ; q's sign
0192   EB                     EX   DE,HL   ; HL = r, DE = q
0193   F1                     POP   AF   ; A = a's high byte
0194   B7                     OR   A   
0195   FC 20 00               CALL   M,neg16   ; r's sign
0198   C1                     POP   BC   
0199   D5                     PUSH   DE   ; q under r
019A   F7                     RST   30h   
019B                             ; ---- stack and storage -----------------------------------------------------
019B   E5           H_DUP:    PUSH   HL   ; ":"
019C   F7                     RST   30h   
019D   E3           H_SWAP:   EX   (SP),HL   ; "%"
019E   F7                     RST   30h   
019F                             ; (The checked build tests the address before it takes the value off the
019F                             ; stack, so that an error report shows both.)
019F                H_CSTORE:      ; "." ( c addr -- )
019F                          IF   CHECKED   
                              CALL   chkst   
019F                          ENDIF      
019F   D1                     POP   DE   
01A0   73                     LD   (HL),E   
01A1   DF           H_DROP:   RST   18h   ; ";" is this one byte
01A2                H_STORE:      ; "!" ( n addr -- )
01A2                          IF   CHECKED   
                              CALL   chkst   
01A2                          ENDIF      
01A2   D1                     POP   DE   
01A3   73                     LD   (HL),E   
01A4   23                     INC   HL   
01A5   72                     LD   (HL),D   
01A6   DF                     RST   18h   
01A7                             ; ---- console ---------------------------------------------------------------
01A7                             ; 22h pushes the address of the text after it and skips the string.
01A7   E5           H_STR:    PUSH   HL   
01A8   60                     LD   H,B   
01A9   69                     LD   L,C   
01AA   CD 43 02               CALL   skipstr   
01AD                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01AD                          ENDIF      
01AD   F7                     RST   30h   
01AE                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01AE                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01AE                             ; bit 6, so // and /" give themselves).
01AE                          IF   (1-CHECKED)*(1-EDITOR)   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
01AE                          ENDIF      
01AE                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
01AE                          ENDIF      
01AE                          IF   (1-CHECKED)*EDITOR   
01AE                             ; (With the editor the loop is a routine, prstr, which ^V uses too.)
01AE   CD 2B 03     H_PRINT:   CALL   prstr   
01B1   DF                     RST   18h   
01B2                          ENDIF      
01B2   7D           H_EMIT:   LD   A,L   ; "'"
01B3   EF                     RST   28h   
01B4   DF           PR9:      RST   18h   
01B5                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B5   C5           H_NUM:    PUSH   BC   
01B6   CD 6F 02               CALL   psgn   
01B9   C1                     POP   BC   
01BA   DF                     RST   18h   
01BB                             ; "?" ( n -- c ) or ( -n -- addr )
01BB                             ;   n > 0: wait about n ms for a key; 0 if none came
01BB                             ;   n = 0: wait for a key
01BB                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BB                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BB   CB 7C        H_KEY:    BIT   7,H   
01BD   20 19                  JR   NZ,line   
01BF   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C1   CD C9 02     KT2:      CALL   getk   
01C4   20 0E                  JR   NZ,kt3   
01C6   1D                     DEC   E   
01C7   20 F8                  JR   NZ,kt2   
01C9   7C                     LD   A,H   ; 0? never counts down: it waits
01CA   B5                     OR   L   
01CB   28 F2                  JR   Z,kt1   
01CD   2B                     DEC   HL   
01CE   7C                     LD   A,H   
01CF   B5                     OR   L   
01D0   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01D2   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01D3   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01D4   6F           KT3:      LD   L,A   
01D5   26 00                  LD   H,0   
01D7   F7                     RST   30h   
01D8                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01D8                          ENDIF      
01D8                          IFN   CPM   
01D8                             ; Generic: Backspace takes the last character back (and is echoed as
01D8                             ; it is), CR ends (stored, not echoed), every other key is stored and
01D8                             ; echoed until the line is full. The line buffer starts at offset 80h
01D8                             ; of its page, so L alone is the place in the line: D holds the L of
01D8                             ; a full line.
01D8   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01DB   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01DC   9F                     SBC   A,A   
01DD   A5                     AND   L   ; (0 for a count that is too big)
01DE   2F                     CPL      
01DF   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E0                             ;   at most
01E0   21 80 82               LD   HL,LINEBUF   
01E3   CD C9 02     LN2:      CALL   getk   
01E6   28 FB                  JR   Z,ln2   
01E8   FE 0D                  CP   13   
01EA   28 16                  JR   Z,ln5   
01EC   FE 08                  CP   8   
01EE   28 0B                  JR   Z,ln4   
01F0   5F                     LD   E,A   
01F1   7D                     LD   A,L   
01F2   BA                     CP   D   
01F3   28 EE                  JR   Z,ln2   ; full
01F5   73                     LD   (HL),E   
01F6   2C                     INC   L   
01F7   7B                     LD   A,E   
01F8   EF           LN3:      RST   28h   
01F9   18 E8                  JR   ln2   
01FB   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
01FC   FA F8 01               JP   M,ln3   ;   unless the line was empty (L left the
01FF   2C                     INC   L   ;   upper half of the page)
0200   18 E1                  JR   ln2   
0202   77           LN5:      LD   (HL),A   ; the CR
0203                          ENDIF      
0203   2E 80                  LD   L,LINEBUF & 0FFh   
0205   F7                     RST   30h   
0206                             ; =============================================================================
0206                             ;  More routines (no handler starts past this point)
0206                             ; =============================================================================
0206                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0206                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0206                             ; while the quotient bits arrive at the bottom of C.
0206                             ; Dividing by 2 is one shift (the spec wants that fast).
0206   7B           UDIV:     LD   A,E   
0207   EE 02                  XOR   2   
0209   B2                     OR   D   
020A   20 07                  JR   NZ,udv0   
020C   CB 3C                  SRL   H   
020E   CB 1D                  RR   L   ; the quotient
0210   8F                     ADC   A,A   
0211   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0212   C9                     RET      
0213   7C           UDV0:     LD   A,H   
0214   4D                     LD   C,L   
0215   21 00 00               LD   HL,0   
0218   06 10                  LD   B,16   
021A   CB 21        UDV1:     SLA   C   
021C   17                     RLA      
021D   ED 6A                  ADC   HL,HL   
021F   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0221   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0223   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0224   0D                     DEC   C   ;   INC below
0225   0C           UDV2:     INC   C   ; a quotient bit
0226   10 F2                  DJNZ   udv1   
0228   EB                     EX   DE,HL   ; DE = remainder
0229   67                     LD   H,A   
022A   69                     LD   L,C   ; HL = quotient
022B   C9                     RET      
022C                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
022C                             ; non-digit. Values wrap at 16 bits, as the spec says.
022C   21 00 00     RDNUM:    LD   HL,0   
022F   0A           RDN1:     LD   A,(BC)   
0230   D6 30                  SUB   "0"   
0232   FE 0A                  CP   10   
0234   D0                     RET   NC   
0235   03                     INC   BC   
0236   54                     LD   D,H   
0237   5D                     LD   E,L   
0238   29                     ADD   HL,HL   
0239   29                     ADD   HL,HL   
023A   19                     ADD   HL,DE   
023B   29                     ADD   HL,HL   ; HL * 10
023C   5F                     LD   E,A   
023D   16 00                  LD   D,0   
023F   19                     ADD   HL,DE   
0240   18 ED                  JR   rdn1   
0242                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0242                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0242                          IF   1-CHECKED   
0242   03           SS0:      INC   BC   
0243   0A           SKIPSTR:   LD   A,(BC)   
0244   03                     INC   BC   
0245   FE 2F                  CP   "/"   
0247   28 F9                  JR   Z,ss0   
0249   FE 22                  CP   22h   
024B   20 F6                  JR   NZ,skipstr   
024D   C9                     RET      
024E                          ENDIF      
024E                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
024E                          ENDIF      
024E                             ; skip: read past text to the closer at this level, and return A = 0 if it
024E                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
024E                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
024E                             ; no closer; anything else that runs into the NUL had unbalanced brackets
024E                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
024E                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
024E                             ; 
024E                             ; The checked build also looks at the character the skip was started by,
024E                             ; which is always the one just before where it starts: "(" must end at ")",
024E                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
024E                             ; quote counts as running into it. "\" takes either closer. IX keeps the
024E                             ; place where the skip started, for the report.
024E                SKIP:        
024E                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
024E                          ENDIF      
024E   16 00                  LD   D,0   
0250   14           SK3:      INC   D   ; an opener: one deeper
0251   0A           SK1:      LD   A,(BC)   
0252                          IF   1-CHECKED   
0252   03                     INC   BC   
0253   B7                     OR   A   
0254   CA 83 03               JP   Z,SKEND   ; (the end of the program)
0257                          ENDIF      
0257                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0257                          ENDIF      
0257   FE 22                  CP   22h   
0259   CC 43 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
025C   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
025E   28 F0                  JR   Z,sk3   
0260   3D                     DEC   A   ; ")"
0261   28 08                  JR   Z,sk4   
0263   D6 32                  SUB   "["-")"   
0265   28 E9                  JR   Z,sk3   
0267   FE 02                  CP   "]"-"["   
0269   20 E6                  JR   NZ,sk1   
026B   15           SK4:      DEC   D   
026C                          IF   1-CHECKED   
026C   C8                     RET   Z   ; the closer at this level
026D   18 E2                  JR   sk1   
026F                          ENDIF      
026F                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
026F                          ENDIF      
026F                             ; psgn: print HL as a signed number. Uses BC.
026F   CB 7C        PSGN:     BIT   7,H   
0271   28 04                  JR   Z,pdec   
0273   3E 2D                  LD   A,"-"   
0275   EF                     RST   28h   
0276   E7                     RST   20h   
0277                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0277                             ; Uses BC.
0277   11 0A 00     PDEC:     LD   DE,10   
027A   CD 06 02               CALL   udiv   ; HL = HL / 10, E = the last digit
027D   7B                     LD   A,E   
027E   F5                     PUSH   AF   
027F   7C                     LD   A,H   
0280   B5                     OR   L   
0281   C4 77 02               CALL   NZ,pdec   
0284   F1                     POP   AF   
0285   C6 30                  ADD   A,"0"   
0287   EF                     RST   28h   
0288   C9                     RET      
0289                             ; =============================================================================
0289                             ;  Dispatch table: the low byte of each handler's address, in code order
0289                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0289                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0289                             ; =============================================================================
0289                             ; The handlers of the first NPG1 characters start in the image's second page.
0289                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0289                             ; differs between the builds, so the count is worked out here.
0289                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0289                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0289                PGBRK:    EQU   (h_break-BASE)/256   
0289                PGDEF:    EQU   (h_def-BASE)/256   
0289                PGFET:    EQU   (h_fetch-BASE)/256   
0289                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0289                          IF   1-TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0289                          ENDIF      
0289                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0289                             ; and return its value in A with the carry set; otherwise leave the IP and
0289                             ; return with the carry clear.
0289   0A           HEXC:     LD   A,(BC)   
028A   D6 30                  SUB   "0"   
028C   FE 0A                  CP   10   
028E   38 09                  JR   C,hc1   
0290   E6 DF                  AND   0DFh   
0292   D6 11                  SUB   11h   
0294   FE 06                  CP   6   
0296   D0                     RET   NC   
0297   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0299   03           HC1:      INC   BC   
029A   C9                     RET      
029B                             ; =============================================================================
029B                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
029B                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
029B                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
029B                             ;  they are the host's KEY and CONOUT routines themselves.
029B                             ; 
029B                             ;  A running program reads the keyboard only through getk and pollk, which
029B                             ;  between them give the break key its rules:
029B                             ;    - Ctrl-C stops the program;
029B                             ;    - any other key that the break check reads is held in KEYBUF for the
029B                             ;      next "?", and a newer one takes its place;
029B                             ;    - "?" (getk) takes the held key first;
029B                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
029B                             ;      key like any other, but two of them within about 250 ms still stop it.
029B                             ;  Both are called straight from a handler, never from a routine under one:
029B                             ;  the checked build's report counts on finding one return address above the
029B                             ;  data stack.
029B                             ; =============================================================================
029B                          IFN   CPM   
029B                RAWK:     EQU   KEY   
029B                          ENDIF      
029B                             ; pollk: the break check (see rpushn).
029B   CD 06 FF     POLLK:    CALL   rawk   
029E   C8                     RET   Z   ; no key
029F   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
02A2   FE 03        PK1:      CP   3   ; (getk joins here)
02A4   C0                     RET   NZ   
02A5                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
02A5                             ; the program has turned it off, wait about 250 ms for one more key: a
02A5                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
02A5                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
02A5   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
02A8   B7                     OR   A   
02A9   CA 7F 03     CT0:      JP   Z,brk   
02AC   D5                     PUSH   DE   
02AD   11 10 27               LD   DE,250*MSLOOP   
02B0   CD 06 FF     CT1:      CALL   rawk   
02B3   20 05                  JR   NZ,ct2   
02B5   1B                     DEC   DE   
02B6   7A                     LD   A,D   
02B7   B3                     OR   E   
02B8   20 F6                  JR   NZ,ct1   
02BA   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
02BB   FE 03                  CP   3   
02BD   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
02BF   B7                     OR   A   
02C0   28 03                  JR   Z,ct3   
02C2   32 7A 82               LD   (KEYBUF),A   
02C5   3E 03        CT3:      LD   A,3   
02C7   B7                     OR   A   
02C8   C9                     RET      
02C9                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
02C9   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
02CA   21 7A 82               LD   HL,KEYBUF   ;   the buffer
02CD   7E                     LD   A,(HL)   
02CE   36 00                  LD   (HL),0   
02D0   E1                     POP   HL   
02D1   B7                     OR   A   
02D2   C0                     RET   NZ   
02D3   CD 06 FF               CALL   rawk   
02D6   C8                     RET   Z   
02D7   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
02D9                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
02D9                          ENDIF      ;   (with the editor, both stacks are cleared);
02D9                          IF   (1-CHECKED)*EDITOR   
02D9                BRK:      EQU   edit0   
02D9                          ENDIF      
02D9                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
02D9                          ENDIF      
02D9                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
02D9                          ENDIF      
02D9                             ; =============================================================================
02D9                             ;  Checked build: the checks and the error report
02D9                             ; =============================================================================
02D9                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
02D9                          ENDIF      
02D9                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
02D9                          ENDIF      
02D9                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
02D9                          ENDIF      
02D9                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
02D9                          ENDIF      
02D9                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
02D9                          ENDIF      
02D9                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
02D9                          ENDIF      
02D9                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
02D9                          ENDIF      
02D9                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
02D9                          ENDIF      ;   screen on it)
02D9                          IF   CHECKED   
                              RST   28h   
                              DJNZ   er4   
                    ER5:         ; (without the editor: on into pstk)
02D9                          ENDIF      
02D9                          IF   CHECKED*EDITOR   
                              CALL   pstk   
                              CALL   pnl   
                              DB   22h   
                              JP   edit0   ; back to the editor, with both stacks cleared
02D9                          ENDIF      
02D9                             ; =============================================================================
02D9                             ;  Routines that the checked build's report and the editor share
02D9                             ; =============================================================================
02D9                SPADJ:    EQU   2*EDITOR   ; (with the editor pstk is called, not fallen
02D9                             ;   into: the stack is one address deeper)
02D9                          IF   CHECKED+EDITOR   
02D9                             ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
02D9                             ;                             Rtn n
02D9                             ; TOS must be in memory with the rest (pushed). In a build without the
02D9                             ; editor this is the end of `error`, which runs on into it.
02D9   CD 3B 03     PSTK:     CALL   pnl   
02DC   53 74 6B 20 22         DB   "Stk ",22h   
02E1   21 08 7E               LD   HL,(2+SPADJ-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
02E4   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
02E5   E7                     RST   20h   ;   with the first value and holds nothing)
02E6   CD 21 03               CALL   phalf   ; the depth
02E9   3E 3A                  LD   A,":"   
02EB   EF                     RST   28h   
02EC   79                     LD   A,C   
02ED   FE 09                  CP   9   
02EF   38 0A                  JR   C,er6   
02F1   CD 41 03               CALL   pmsg   
02F4   20 2E 2E 2E 22         DB   " ...",22h   
02F9   0E 08                  LD   C,8   
02FB   26 00        ER6:      LD   H,0   ; C = the number of cells to show
02FD   69                     LD   L,C   
02FE   29                     ADD   HL,HL   
02FF   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0300                          ENDIF      
0300                          IF   EDITOR   
0300   23                     INC   HL   
0301   23                     INC   HL   
0302                          ENDIF      
0302                          IF   CHECKED+EDITOR   
0302   0C                     INC   C   
0303   0D           ER7:      DEC   C   
0304   28 11                  JR   Z,er8   
0306   2B                     DEC   HL   
0307   56                     LD   D,(HL)   
0308   2B                     DEC   HL   
0309   5E                     LD   E,(HL)   
030A   E5                     PUSH   HL   
030B   C5                     PUSH   BC   
030C   3E 20                  LD   A," "   
030E   EF                     RST   28h   
030F   EB                     EX   DE,HL   
0310   CD 6F 02               CALL   psgn   
0313   C1                     POP   BC   
0314   E1                     POP   HL   
0315   18 EC                  JR   er7   
0317   CD 3B 03     ER8:      CALL   pnl   
031A                          ENDIF      
031A                          IF   (1-CHECKED)*EDITOR   
031A   52 74 6E 20 30 22      DB   "Rtn 0",22h   ; (only ^V comes here, and at the editor the
0320   C9                     RET      ;   return stack is always empty)
0321                          ENDIF      
0321                          IF   CHECKED   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
0321                          ENDIF      
0321                          IF   CHECKED*(1-EDITOR)   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
0321                          ENDIF      
0321                          IF   CHECKED+EDITOR   
0321                             ; phalf: print half of HL, and leave it in C. (With the editor, pstk ends by
0321                             ; running on into this.)
0321   CB 3C        PHALF:    SRL   H   
0323   CB 1D                  RR   L   
0325   E5                     PUSH   HL   
0326   CD 77 02               CALL   pdec   
0329   C1                     POP   BC   
032A   C9                     RET      
032B                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
032B                             ; "$", and the texts of the report and the editor). In the checked build a
032B                             ; NUL first is an error: Q.
032B   7E           PRSTR:    LD   A,(HL)   
032C   23                     INC   HL   
032D   FE 22                  CP   22h   
032F   C8                     RET   Z   
0330                          ENDIF      
0330                          IF   CHECKED   
                              OR   A   
                              JR   Z,e_dollar   
0330                          ENDIF      
0330                          IF   CHECKED+EDITOR   
0330   FE 2F                  CP   "/"   
0332   20 04                  JR   NZ,prs1   
0334   7E                     LD   A,(HL)   
0335   23                     INC   HL   
0336   E6 BF                  AND   0BFh   
0338   EF           PRS1:     RST   28h   
0339   18 F0                  JR   prstr   
033B                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
033B                             ; pnl: the same, on a new line.
033B   3E 0D        PNL:      LD   A,13   
033D   EF                     RST   28h   
033E   3E 0A                  LD   A,10   
0340   EF                     RST   28h   
0341   E3           PMSG:     EX   (SP),HL   
0342   CD 2B 03               CALL   prstr   
0345   E3                     EX   (SP),HL   
0346   C9                     RET      
0347                          ENDIF      
0347                          IF   CHECKED   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              POP   HL   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
0347                          ENDIF      
0347                             ; =============================================================================
0347                             ;  The line editor (EDITOR = 1)
0347                             ; 
0347                             ;  The interpreter starts here, and a program that ends comes back here.
0347                             ;  There is no prompt. It follows the spec's suggested standard for a line
0347                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0347                             ; 
0347                             ;    n text    put the text in as line n; the lines from n on move down. A
0347                             ;              number past the end (or 0) adds the line at the end.
0347                             ;    n         take line n out
0347                             ;    anything else is run at once, as B8Script. (Start such a line with a
0347                             ;    space if it would begin with a digit.)
0347                             ; 
0347                             ;  A command key ends the line too, and takes what was typed as its argument:
0347                             ; 
0347                             ;    ^G        run the program
0347                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0347                             ;              list until another key is pressed; Ctrl-C ends it.
0347                             ;    n ^E      put line n in the input line; Return puts it back, changed
0347                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0347                             ;              last time). Generic: what is typed, or pasted, from now until
0347                             ;              ^Z replaces the program; it is not echoed.
0347                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0347                             ;              time). Generic: the text is printed, as it is.
0347                             ;    ^N ^N     new: no program (the key twice in a row)
0347                             ;    ^V        view: the build, both stacks, and the program's size, lines
0347                             ;              and free memory
0347                             ;    ^X        leave (to LEAVE)
0347                             ; 
0347                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
0347                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0347                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0347                             ;  sent to the terminal, so any terminal will do.
0347                             ; 
0347                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0347                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0347                             ;  125 characters; the one character after a line number separates it from
0347                             ;  the text and is not stored. The text is kept as it is typed, each line
0347                             ;  ending in CR LF, at PROG.
0347                             ; 
0347                             ;  What lasts from one line to the next: the program, the words, the
0347                             ;  variables and the data stack. An error or a break clears both stacks. The
0347                             ;  return stack starts empty for every line.
0347                             ; 
0347                             ;  Things to know:
0347                             ;    - Reset empties the program (generic builds).
0347                             ;    - A word's address points into the program, so run the program again
0347                             ;      after editing it.
0347                             ;    - Nothing is printed between a program's output and what is typed next.
0347                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0347                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0347                             ;      (The stored program never comes back to the line, so it may.)
0347                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0347                             ;      read of the other builds (BDOS 10 under CP/M).
0347                             ; 
0347                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0347                             ;  the last line left there, with TOS pushed like the rest.
0347                             ; =============================================================================
0347                          IF   EDGEN   
0347                INIT:        ; reset (A = 0)
0347                          ENDIF      
0347                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0347                          ENDIF      
0347                          IF   EDGEN   
0347   18 36                  JR   edit0   
0349                          ENDIF      
0349                          IF   EDITOR   
0349                             ; ^F, right arrow: one to the right, by printing the character there
0349   7D           RIGHT:    LD   A,L   
034A   BB                     CP   E   
034B   28 4A                  JR   Z,ed1   ; at the end
034D   7E                     LD   A,(HL)   
034E   2C                     INC   L   
034F   18 2B                  JR   lf1   
0351                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0351                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0351                             ; ends the sequence, and act on C (right) and D (left).
0351   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0354   CD 06 FF     ES1:      CALL   rawk   
0357   20 0A                  JR   NZ,es2   
0359   0B                     DEC   BC   
035A   78                     LD   A,B   
035B   B1                     OR   C   
035C   20 F6                  JR   NZ,es1   
035E   CD CC 03               CALL   fin   ; no second key: the line is dropped
0361   18 22                  JR   edit   
0363   FE 5B        ES2:      CP   "["   
0365   20 30                  JR   NZ,ed1   ; not a sequence known here
0367   CD 25 04     ES3:      CALL   ekey   
036A   FE 40                  CP   40h   
036C   38 F9                  JR   C,es3   ; (its parameters)
036E   D6 43                  SUB   "C"   
0370   28 D7                  JR   Z,right   
0372   3D                     DEC   A   ; "D"?
0373   20 22                  JR   NZ,ed1   ; no: on into left
0375                             ; ^B, left arrow: the cursor goes one to the left
0375   7D           LEFT:     LD   A,L   
0376   87                     ADD   A,A   
0377   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
0379   2D                     DEC   L   
037A   3E 08                  LD   A,8   
037C   EF           LF1:      RST   28h   
037D   18 18                  JR   ed1   
037F                             ; edit0: reset, an error or a break: both stacks are cleared.
037F                             ; skend: a program that ended inside skip: its return address goes.
037F                             ; edend: a program that ended: TOS joins the rest of the data stack.
037F   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0382   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0383   D1           SKEND:    POP   DE   
0384   E5           EDEND:    PUSH   HL   
0385                             ; edit: start a new input line.
0385   D9           EDIT:     EXX      
0386   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
0389   D9                     EXX      
038A   21 00 00               LD   HL,0   
038D   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0390   22 3A 82               LD   (EDLN),HL   ; no line is being edited
0393   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
0396   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0397   CD 25 04     ED1:      CALL   ekey   
039A   FE 7F                  CP   7Fh   
039C   28 40                  JR   Z,bsp   ; DEL
039E   FE 20                  CP   " "   
03A0   30 56                  JR   NC,insc   
03A2   FE 09                  CP   9   
03A4   28 52                  JR   Z,insc   ; Tab is text
03A6   FE 08                  CP   8   
03A8   28 34                  JR   Z,bsp   
03AA   FE 02                  CP   2   
03AC   28 C7                  JR   Z,left   ; ^B
03AE   FE 06                  CP   6   
03B0   28 97                  JR   Z,right   ; ^F
03B2   FE 1B                  CP   1Bh   
03B4   28 9B                  JR   Z,esc   
03B6   E5                     PUSH   HL   ; a command key? Look it up
03B7   21 2B 04               LD   HL,cmds   
03BA   06 09                  LD   B,NCMD   
03BC   BE           ED2:      CP   (HL)   
03BD   23                     INC   HL   
03BE   28 07                  JR   Z,ed3   
03C0   23                     INC   HL   
03C1   23                     INC   HL   
03C2   10 F8                  DJNZ   ed2   
03C4   E1                     POP   HL   
03C5   18 D0                  JR   ed1   ; no: the key is ignored
03C7   7E           ED3:      LD   A,(HL)   
03C8   23                     INC   HL   
03C9   66                     LD   H,(HL)   
03CA   6F                     LD   L,A   
03CB   E3                     EX   (SP),HL   ; the command's address: fin returns to it
03CC                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
03CC                             ; terminal. Leaves BC -> the line and HL -> the NUL.
03CC   26 82        FIN:      LD   H,LETPAGE   
03CE   6B                     LD   L,E   
03CF   36 0D                  LD   (HL),13   
03D1   2C                     INC   L   
03D2   36 0A                  LD   (HL),10   
03D4   2D                     DEC   L   
03D5   CD 8F 05               CALL   prl   ; (prints the CR LF)
03D8   36 00                  LD   (HL),0   
03DA   01 80 82               LD   BC,LINEBUF   
03DD   C9                     RET      
03DE                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
03DE                             ; left, the rest of the line moves down over it, and the last place (now a
03DE                             ; space) is printed over along with the rest.
03DE   7D           BSP:      LD   A,L   
03DF   87                     ADD   A,A   
03E0   28 B5                  JR   Z,ed1   ; at the start
03E2   2D                     DEC   L   
03E3   3E 08                  LD   A,8   
03E5   EF                     RST   28h   
03E6   E5                     PUSH   HL   
03E7   2C           BS1:      INC   L   
03E8   7E                     LD   A,(HL)   
03E9   2D                     DEC   L   
03EA   77                     LD   (HL),A   
03EB   2C                     INC   L   
03EC   7D                     LD   A,L   
03ED   BB                     CP   E   
03EE   20 F7                  JR   NZ,bs1   
03F0   2D                     DEC   L   
03F1   36 20                  LD   (HL)," "   
03F3   E1                     POP   HL   
03F4   53                     LD   D,E   
03F5   1D                     DEC   E   
03F6   18 15                  JR   ic2   
03F8                             ; A character goes in at the cursor: it ripples up through the rest of the
03F8                             ; line, the cursor moves on, and the rest is printed again.
03F8   47           INSC:     LD   B,A   
03F9   7B                     LD   A,E   
03FA   FE FD                  CP   0FDh   
03FC   28 99                  JR   Z,ed1   ; the line is full: 125 characters
03FE   78                     LD   A,B   
03FF   EF                     RST   28h   
0400   E5                     PUSH   HL   
0401   7E           IC1:      LD   A,(HL)   
0402   70                     LD   (HL),B   
0403   47                     LD   B,A   
0404   7D                     LD   A,L   
0405   2C                     INC   L   
0406   BB                     CP   E   
0407   20 F8                  JR   NZ,ic1   
0409   E1                     POP   HL   
040A   2C                     INC   L   
040B   1C                     INC   E   
040C   53                     LD   D,E   
040D   CD 12 04     IC2:      CALL   tail   
0410   18 85                  JR   ed1   
0412                             ; tail: print the line from the cursor to D (a low byte), and bring the
0412                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0412   4D           TAIL:     LD   C,L   
0413   7D           TA1:      LD   A,L   
0414   BA                     CP   D   
0415   28 05                  JR   Z,ta2   
0417   7E                     LD   A,(HL)   
0418   EF                     RST   28h   
0419   2C                     INC   L   
041A   18 F7                  JR   ta1   
041C   7D           TA2:      LD   A,L   
041D   B9                     CP   C   
041E   C8                     RET   Z   
041F   3E 08                  LD   A,8   
0421   EF                     RST   28h   
0422   2D                     DEC   L   
0423   18 F7                  JR   ta2   
0425                             ; ekey: wait for a key
0425   CD 06 FF     EKEY:     CALL   rawk   
0428   28 FB                  JR   Z,ekey   
042A   C9                     RET      
042B                             ; The command keys, and where each goes (after fin).
042B   0D           CMDS:     DB   13   
042C   7E 04                  DW   cret   
042E   07                     DB   7   ; ^G
042F   C6 04                  DW   crun   
0431   0C                     DB   12   ; ^L
0432   D8 04                  DW   clist   
0434   05                     DB   5   ; ^E
0435   54 04                  DW   cedln   
0437   12                     DB   18   ; ^R
0438   98 05                  DW   cread   
043A   17                     DB   23   ; ^W
043B   C5 05                  DW   cwrite   
043D   0E                     DB   14   ; ^N
043E   46 04                  DW   cnew   
0440   16                     DB   22   ; ^V
0441   08 05                  DW   cview   
0443   18                     DB   24   ; ^X
0444   09 FF                  DW   LEAVE   
0446                NCMD:     EQU   9   
0446                             ; ^N ^N: no program, if the next key is ^N too
0446   CD 25 04     CNEW:     CALL   ekey   
0449   FE 0E                  CP   14   
044B   20 04                  JR   NZ,ged0   
044D   AF                     XOR   A   
044E   32 00 83               LD   (PROG),A   
0451   C3 85 03     GED0:     JP   edit   
0454                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0454                             ; line it was: Return puts the text back in its place.
0454   CD 2C 02     CEDLN:    CALL   rdnum   
0457   E5                     PUSH   HL   
0458   CD 77 05               CALL   find   ; HL -> the line, or the NUL if there is none
045B   D1                     POP   DE   
045C   7E                     LD   A,(HL)   
045D   B7                     OR   A   
045E   28 F1                  JR   Z,ged0   
0460   ED 53 3A 82            LD   (EDLN),DE   
0464   11 80 82               LD   DE,LINEBUF   
0467   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0468   FE 0D                  CP   13   
046A   28 0D                  JR   Z,ce2   
046C   FE 0A                  CP   10   
046E   28 09                  JR   Z,ce2   
0470   12                     LD   (DE),A   
0471   EF                     RST   28h   
0472   23                     INC   HL   
0473   1C                     INC   E   
0474   7B                     LD   A,E   
0475   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0477   20 EE                  JR   NZ,ce1   
0479   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
047A   5D                     LD   E,L   
047B   C3 97 03               JP   ed1   
047E                             ; Return. If ^E put a line here, the text goes back in its place. If not:
047E                             ; a number and text is a line to put in, a number alone a line to take out,
047E                             ; and anything else is run where it is.
047E   E5           CRET:     PUSH   HL   ; the end of what was typed
047F   2A 3A 82               LD   HL,(EDLN)   
0482   7C                     LD   A,H   
0483   B5                     OR   L   
0484   28 07                  JR   Z,cr1   
0486   E5                     PUSH   HL   
0487   CD 67 05               CALL   delln   
048A   E1                     POP   HL   
048B   18 13                  JR   ins   
048D   CD 2C 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0490   79                     LD   A,C   ; C is still 80h if there was no number:
0491   87                     ADD   A,A   ;   only then is twice it 0
0492   28 36                  JR   Z,st0p   ; no number: run the line
0494   0A                     LD   A,(BC)   
0495   FE 0D                  CP   13   
0497   20 06                  JR   NZ,cr2   
0499   D1                     POP   DE   ; the number alone: take that line out
049A   CD 67 05               CALL   delln   
049D   18 24                  JR   gedit   
049F   03           CR2:      INC   BC   ; step over the one character after the number
04A0                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
04A0                             ; CR and LF included, and copy it in.
04A0   CD 77 05     INS:      CALL   find   ; HL -> where it goes
04A3   D1                     POP   DE   ; the end of what was typed
04A4   7B                     LD   A,E   
04A5   91                     SUB   C   ; A = the length of the text, with its CR LF
04A6   C5                     PUSH   BC   ; the text
04A7   4F                     LD   C,A   
04A8   06 00                  LD   B,0   
04AA   C5                     PUSH   BC   ; its length
04AB   54                     LD   D,H   
04AC   5D                     LD   E,L   ; DE = where it goes
04AD   AF                     XOR   A   
04AE   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
04AF   ED B1                  CPIR      ; HL -> one past the program's NUL
04B1   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
04B3   44                     LD   B,H   
04B4   4D                     LD   C,L   
04B5   19                     ADD   HL,DE   
04B6   2B                     DEC   HL   ; HL -> the NUL
04B7   EB                     EX   DE,HL   
04B8   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
04B9   E5                     PUSH   HL   
04BA   19                     ADD   HL,DE   ; the NUL's new place
04BB   EB                     EX   DE,HL   
04BC   ED B8                  LDDR      ; move the rest of the program up
04BE   C1                     POP   BC   ; the length
04BF   D1                     POP   DE   ; where it goes
04C0   E1                     POP   HL   ; the text
04C1   ED B0                  LDIR      
04C3   C3 85 03     GEDIT:    JP   edit   
04C6                             ; ^G: run the program. st0p: run the typed line (BC -> it).
04C6   01 00 83     CRUN:     LD   BC,PROG   
04C9   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
04CA   E1           ST0P:     POP   HL   ; (the end of what was typed)
04CB                             ; st0: start running at BC. The heap starts after the stored program's NUL.
04CB   21 00 83     ST0:      LD   HL,PROG   
04CE   AF                     XOR   A   
04CF   BE           ST1:      CP   (HL)   
04D0   23                     INC   HL   
04D1   20 FC                  JR   NZ,st1   
04D3   22 7C 82               LD   (HEAP),HL   
04D6                          ENDIF      
04D6                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
04D6                          ENDIF      
04D6                          IF   EDITOR   
04D6   E1                     POP   HL   ; TOS: the data stack is as the last line left it
04D7   F7                     RST   30h   ; (its return address is thrown away)
04D8                             ; ^L: list from line n. DE = the number of the line at HL.
04D8   CD 2C 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
04DB   7C                     LD   A,H   
04DC   B5                     OR   L   
04DD   20 01                  JR   NZ,li0   
04DF   2C                     INC   L   ;   then from line 1
04E0   E5           LI0:      PUSH   HL   
04E1   CD 77 05               CALL   find   
04E4   D1                     POP   DE   
04E5   7E           LI1:      LD   A,(HL)   
04E6   B7                     OR   A   
04E7   28 DA                  JR   Z,gedit   ; the end of the text
04E9   CD 06 FF               CALL   rawk   
04EC   28 09                  JR   Z,li3   ; no key: carry on
04EE   FE 03                  CP   3   
04F0   C4 25 04               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
04F3   FE 03                  CP   3   
04F5   28 CC                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
04F7   E5           LI3:      PUSH   HL   
04F8   D5                     PUSH   DE   
04F9   EB                     EX   DE,HL   
04FA   CD 77 02               CALL   pdec   ; the line's number,
04FD   3E 20                  LD   A," "   
04FF   EF                     RST   28h   ;   a space,
0500   D1                     POP   DE   
0501   E1                     POP   HL   
0502   13                     INC   DE   
0503   CD 8F 05               CALL   prl   ;   and the line
0506   18 DD                  JR   li1   
0508                             ; ^V: view.
0508   CD 41 03     CVIEW:    CALL   pmsg   
050B   42 38 53 5A 38 30 45   DB   "B8SZ80E"   
0512                          ENDIF      
0512                          IF   EDITOR*CHECKED   
                              DB   "C"   
0512                          ENDIF      
0512                          IF   EDITOR   
0512   20 32 30 32 36 2D 31 31 2D 32 31 22 DB   " 2026-11-21",22h   
051E   CD D9 02               CALL   pstk   ; both stacks
0521   21 00 83               LD   HL,PROG   
0524   11 FF FF               LD   DE,0FFFFh   
0527   13           CV1:      INC   DE   ; count the lines, and find the end
0528   CD 85 05               CALL   nxl   
052B   20 FA                  JR   NZ,cv1   
052D   E5                     PUSH   HL   ; the NUL
052E   D5                     PUSH   DE   ; the lines
052F   11 00 7D               LD   DE,(0-PROG)&0FFFFh   
0532   19                     ADD   HL,DE   
0533   CD 3B 03               CALL   pnl   
0536   50 72 6F 67 20 22      DB   "Prog ",22h   
053C   CD 77 02               CALL   pdec   ; the program's size
053F   E1                     POP   HL   
0540   CD 3B 03               CALL   pnl   
0543   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
054A   CD 77 02               CALL   pdec   
054D   D1                     POP   DE   
054E                          ENDIF      
054E                          IF   EDGEN   
054E   21 FF EF               LD   HL,HEAPLIM*256-1   
0551                          ENDIF      
0551                          IF   EDITOR*CPM   
                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
0551                          ENDIF      
0551                          IF   EDITOR   
0551   B7                     OR   A   
0552   ED 52                  SBC   HL,DE   
0554   CD 3B 03               CALL   pnl   
0557   46 72 65 65 20 22      DB   "Free ",22h   
055D   CD 77 02               CALL   pdec   ; the room left for text and heap
0560   CD 3B 03               CALL   pnl   
0563   22                     DB   22h   
0564   C3 85 03     GED1:     JP   edit   
0567                             ; delln: take line n (in HL) out: copy everything after it down over it.
0567   CD 77 05     DELLN:    CALL   find   
056A   54                     LD   D,H   
056B   5D                     LD   E,L   
056C   CD 85 05               CALL   nxl   ; HL -> the next line
056F   7E           DE1:      LD   A,(HL)   
0570   12                     LD   (DE),A   
0571   23                     INC   HL   
0572   13                     INC   DE   
0573   B7                     OR   A   
0574   20 F9                  JR   NZ,de1   
0576   C9                     RET      
0577                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0577                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0577   EB           FIND:     EX   DE,HL   
0578   21 00 83               LD   HL,PROG   
057B   1B           FI1:      DEC   DE   
057C   7A                     LD   A,D   
057D   B3                     OR   E   
057E   C8                     RET   Z   
057F   CD 85 05               CALL   nxl   
0582   20 F7                  JR   NZ,fi1   
0584   C9                     RET      
0585                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0585                             ; stop at the NUL that ends the text (and return zero).
0585   7E           NXL:      LD   A,(HL)   
0586   B7                     OR   A   
0587   C8                     RET   Z   
0588   23                     INC   HL   
0589   FE 0A                  CP   10   
058B   20 F8                  JR   NZ,nxl   
058D   B7                     OR   A   
058E   C9                     RET      
058F                             ; prl: print the line at HL, to its LF; HL -> just past it.
058F   7E           PRL:      LD   A,(HL)   
0590   EF                     RST   28h   
0591   7E                     LD   A,(HL)   
0592   23                     INC   HL   
0593   FE 0A                  CP   10   
0595   20 F8                  JR   NZ,prl   
0597   C9                     RET      
0598                          ENDIF      
0598                          IF   EDGEN   
0598                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
0598                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
0598                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
0598                             ; line with no end is given one. Nothing is echoed, and there is no check
0598                             ; for running out of memory.
0598   21 FF 82     CREAD:    LD   HL,PROG-1   
059B   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
059D   23                     INC   HL   ;   the line buffer's last, and spare)
059E   CD 25 04     RD1:      CALL   ekey   
05A1   4F                     LD   C,A   
05A2   FE 1A                  CP   1Ah   
05A4   20 02                  JR   NZ,rd2   
05A6   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
05A8   FE 0A        RD2:      CP   10   
05AA   20 07                  JR   NZ,rd3   
05AC   2B                     DEC   HL   
05AD   BE                     CP   (HL)   
05AE   23                     INC   HL   
05AF   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
05B1   3E 0D                  LD   A,13   ; anywhere else it ends the line
05B3   77           RD3:      LD   (HL),A   
05B4   23                     INC   HL   
05B5   FE 0D                  CP   13   
05B7   20 03                  JR   NZ,rd4   
05B9   36 0A                  LD   (HL),10   ; after a CR goes a LF
05BB   23                     INC   HL   
05BC   79           RD4:      LD   A,C   
05BD   FE 1A                  CP   1Ah   
05BF   20 DD                  JR   NZ,rd1   
05C1   36 00                  LD   (HL),0   
05C3   18 9F                  JR   ged1   
05C5                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
05C5   21 00 83     CWRITE:   LD   HL,PROG   
05C8   7E           CW1:      LD   A,(HL)   
05C9   B7                     OR   A   
05CA   28 98                  JR   Z,ged1   
05CC   EF                     RST   28h   
05CD   23                     INC   HL   
05CE   18 F8                  JR   cw1   
05D0                          ENDIF      
05D0                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
05D0                          ENDIF      
05D0                             ; =============================================================================
05D0                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
05D0                          ENDIF      
05D0                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
05D0                          ENDIF      
05D0                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
05D0                          ENDIF      
05D0                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
05D0                          ENDIF      
05D0                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
05D0                          ENDIF      
05D0                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
05D0                          ENDIF      
05D0                IMGEND:      


