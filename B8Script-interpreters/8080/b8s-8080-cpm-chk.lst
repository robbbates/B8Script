05C4   7C                     MOV   A,H   ;   overflowed), and not above its empty
05C5   FE 08                  CPI   RSPAGE   ;   position (an underflow stays inside the
05C7   C2 DB 05               JNZ   e_rover   ;   page, in the guard band)
05CA   7D                     MOV   A,L   
05CB   FE E1                  CPI   RSTOP&0FFh+1   
05CD   D2 D2 05               JNC   e_runder   
05D0   EB                     XCHG      ; TOS back
05D1   C9                     RET      
05D2   21 E0 08     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
05D5   22 34 0A               SHLD   RSP   
05D8   3E 72                  MVI   A,"r"   
05DA   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
05DB   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
05DD   21                     DB   21h   
05DE   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
05E0   EB                     XCHG      ; TOS back
05E1   C3 09 06               JMP   errp   
05E4   31 FC 09     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
05E7   3E 73                  MVI   A,"s"   
05E9   C3 0A 06               JMP   error   
05EC                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
05EC                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
05EC                             ; every build: if the IP is in page zero, this was a call of an undefined
05EC                             ; word. The call is undone, so the place is the call itself.
05EC   04           E_HI:     INR   B   
05ED   05                     DCR   B   
05EE   C2 00 06               JNZ   e_resv   
05F1   E5                     PUSH   H   
05F2   CF                     RST   1   
05F3   44                     MOV   B,H   
05F4   4D                     MOV   C,L   
05F5   E1                     POP   H   
05F6   3E 55                  MVI   A,"U"   
05F8   C3 0A 06               JMP   error   
05FB                             ; Error entries. Each loads its letter and then hides the next entry inside
05FB                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
05FB   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
05FC   4D                     MOV   C,L   ;   past the opening quote, which is the place
05FD   3E 51                  MVI   A,"Q"   
05FF   11                     DB   11h   
0600   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
0602   11                     DB   11h   
0603   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
0605   11                     DB   11h   
0606   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
0608   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
0609                             ; errp: an error found inside a routine: drop its return address first.
0609   D1           ERRP:     POP   D   
060A                             ; error: the report, then the end. A = the letter, BC = one past the place,
060A                             ; HL = TOS, and both stacks as the report is to show them:
060A                             ; 
060A                             ;   Err X @ line,col
060A                             ;   up to 16 characters of the text from the place
060A                             ;   Stk n: the top 8 cells at most, bottom to top
060A                             ;   Rtn n
060A   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
060B   5F                     MOV   E,A   
060C   CD A9 05               CALL   pnl   
060F   45 72 72 20 22         DB   "Err ",22h   
0614   7B                     MOV   A,E   
0615   EF                     RST   5   
0616   CD AF 05               CALL   pmsg   
0619   20 40 20 22            DB   " @ ",22h   
061D   0B                     DCX   B   ; BC = the place
061E                             ; The line and column. A place below the program is in the line
061E                             ; buffer: line 0. Otherwise count the LFs from the program's start;
061E                             ; DE = the line's number, HL = where it starts.
061E   21 80 0A               LXI   H,LINEBUF   
0621   11 00 00               LXI   D,0   
0624   78                     MOV   A,B   
0625   FE 0B                  CPI   PROG/256   
0627   DA 41 06               JC   er3   
062A   24                     INR   H   
062B   6B                     MOV   L,E   ; HL = PROG
062C   13           ER1:      INX   D   ; a new line starts at HL
062D   E5                     PUSH   H   
062E   7D           ER2:      MOV   A,L   
062F   91                     SUB   C   
0630   7C                     MOV   A,H   
0631   98                     SBB   B   
0632   D2 40 06               JNC   er2x   ; reached the place
0635   7E                     MOV   A,M   
0636   23                     INX   H   
0637   FE 0A                  CPI   10   
0639   C2 2E 06               JNZ   er2   
063C   F1                     POP   PSW   
063D   C3 2C 06               JMP   er1   
0640   E1           ER2X:     POP   H   
0641   C5           ER3:      PUSH   B   
0642   E5                     PUSH   H   
0643   EB                     XCHG      
0644   CD 86 04               CALL   pdec   ; the line
0647   3E 2C                  MVI   A,","   
0649   EF                     RST   5   
064A   D1                     POP   D   
064B   E1                     POP   H   
064C   E5                     PUSH   H   
064D   CD DD 06               CALL   sub16   
0650   23                     INX   H   
0651   CD 86 04               CALL   pdec   ; the column
0654   CD A9 05               CALL   pnl   
0657   22                     DB   22h   
0658   E1                     POP   H   ; the text, as it is: 16 characters, or fewer
0659   06 10                  MVI   B,16   ;   if the line or the program ends first
065B   7E           ER4:      MOV   A,M   
065C   23                     INX   H   
065D   B7                     ORA   A   
065E   CA 75 06               JZ   er5   
0661   FE 0D                  CPI   13   
0663   CA 75 06               JZ   er5   
0666   FE 0A                  CPI   10   
0668   CA 75 06               JZ   er5   
066B                          ENDIF      
066B                          IF   CHECKED*CPM   
066B   FE 1A                  CPI   1Ah   ; (the ^Z that pads a file's last record ends
066D   CA 75 06               JZ   er5   ;   the text too: some terminals clear the
0670                          ENDIF      ;   screen on it)
0670                          IF   CHECKED   
0670   EF                     RST   5   
0671   05                     DCR   B   
0672   C2 5B 06               JNZ   er4   
0675   CD A9 05     ER5:      CALL   pnl   
0678   53 74 6B 20 22         DB   "Stk ",22h   
067D   21 06 F6               LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
0680   39                     DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
0681   E7                     RST   4   ;   first value and holds nothing)
0682   7C                     MOV   A,H   
0683   CD D1 06               CALL   phal2   ; the depth
0686   3E 3A                  MVI   A,":"   
0688   EF                     RST   5   
0689   79                     MOV   A,C   
068A   FE 09                  CPI   9   
068C   DA 99 06               JC   er6   
068F   CD AF 05               CALL   pmsg   
0692   20 2E 2E 2E 22         DB   " ...",22h   
0697   0E 08                  MVI   C,8   
0699   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
069B   69                     MOV   L,C   
069C   29                     DAD   H   
069D   39                     DAD   SP   ; HL -> just above the deepest of them
069E   0C                     INR   C   
069F   0D           ER7:      DCR   C   
06A0   CA B5 06               JZ   er8   
06A3   2B                     DCX   H   
06A4   56                     MOV   D,M   
06A5   2B                     DCX   H   
06A6   5E                     MOV   E,M   
06A7   E5                     PUSH   H   
06A8   C5                     PUSH   B   
06A9   3E 20                  MVI   A," "   
06AB   EF                     RST   5   
06AC   EB                     XCHG      
06AD   CD 7D 04               CALL   psgn   
06B0   C1                     POP   B   
06B1   E1                     POP   H   
06B2   C3 9F 06               JMP   er7   
06B5   CD A9 05     ER8:      CALL   pnl   
06B8   52 74 6E 20 22         DB   "Rtn ",22h   
06BD   2A 34 0A               LHLD   RSP   
06C0   EB                     XCHG      
06C1   21 E0 08               LXI   H,RSTOP   
06C4   CD CE 06               CALL   phalf   
06C7   CD A9 05               CALL   pnl   
06CA   22                     DB   22h   
06CB   C3 83 01               JMP   endprog   
06CE                             ; phalf: print half of HL - DE, and leave it in BC
06CE   CD DD 06     PHALF:    CALL   sub16   
06D1   B7           PHAL2:    ORA   A   ; (A = H; this clears the carry)
06D2   1F                     RAR      
06D3   67                     MOV   H,A   
06D4   7D                     MOV   A,L   
06D5   1F                     RAR      
06D6   6F                     MOV   L,A   
06D7   E5                     PUSH   H   
06D8   CD 86 04               CALL   pdec   
06DB   C1                     POP   B   
06DC   C9                     RET      
06DD                             ; sub16: HL = HL - DE. Leaves A = H.
06DD   7D           SUB16:    MOV   A,L   
06DE   93                     SUB   E   
06DF   6F                     MOV   L,A   
06E0   7C                     MOV   A,H   
