   631 0000017F 5A                  <1> h_eq:   pop     edx
   632 00000180 6629D3              <1>         sub     bx,dx
   633 00000183 6683FB01            <1>         cmp     bx,1                    ; carry only if a - b = 0
   634 00000187 EBF1                <1>         jmp     tf
   635                              <1> 
