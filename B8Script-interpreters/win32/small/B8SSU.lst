  1595                              <1> ; =============================================================================
  1596                              <1> ;  The line editor (EDITOR = 1)
  1597                              <1> ;
  1598                              <1> ;  The interpreter starts here, and a program that ends comes back here.
  1599                              <1> ;  There is no prompt. It follows the spec's suggested standard for a line
  1600                              <1> ;  editor (docs/b8script.md, Environments), and is the Z80's editor, key for
  1601                              <1> ;  key. Type a line and press Return:
  1602                              <1> ;
  1603                              <1> ;    n text    put the text in as line n; the lines from n on move down. A
  1604                              <1> ;              number past the end (or 0) adds the line at the end.
  1605                              <1> ;    n         take line n out
  1606                              <1> ;    anything else is run at once, as B8Script. (Start such a line with a
  1607                              <1> ;    space if it would begin with a digit.)
  1608                              <1> ;
  1609                              <1> ;  A command key ends the line too, and takes what was typed as its argument:
  1610                              <1> ;
  1611                              <1> ;    ^G        run the program
  1612                              <1> ;    n ^L      list from line n (no number: all of it). Any key holds the
  1613                              <1> ;              list until another key is pressed; Ctrl-C ends it.
  1614                              <1> ;    n ^E      put line n in the input line; Return puts it back, changed
  1615                              <1> ;    name ^R   read the file of that name (no name: the current one: the
  1616                              <1> ;              one from the command line, or the last one typed)
  1617                              <1> ;    name ^W   write the program to that file (no name: the current one)
  1618                              <1> ;    ^N        new: no program
  1619                              <1> ;    ^X        leave
  1620                              <1> ;
  1621                              <1> ;  Any other control key does nothing.
  1622                              <1> ;
  1623                              <1> ;  In the line: the left and right arrow keys move the cursor (^B and ^F do
  1624                              <1> ;  nothing);
  1625                              <1> ;  a character goes in at the cursor; Backspace and DEL take out the one
  1626                              <1> ;  before it; Esc drops the line (after Esc it waits 5 ms for a '[': Esc [ C
  1627                              <1> ;  and Esc [ D are right and left too). Only CR, LF, BS and printing
  1628                              <1> ;  characters are sent to the terminal.
  1629                              <1> ;
  1630                              <1> ;  Lines are counted, not numbered. A typed line holds 125 characters; the
  1631                              <1> ;  one character after a line number separates it from the text and is not
  1632                              <1> ;  stored. The text is kept as typed, each line ending in CR LF, at PROG. A
  1633                              <1> ;  file is read up to its first ^Z, and a last line with no line end is
  1634                              <1> ;  given one; it is written as it is, with no padding.
  1635                              <1> ;
  1636                              <1> ;  What lasts from one line to the next: the program, the words, the
  1637                              <1> ;  variables and the data stack (TOS is kept pushed while the editor runs).
  1638                              <1> ;  An error or a break clears both stacks. The return stack starts empty for
  1639                              <1> ;  every line.
  1640                              <1> ;
  1641                              <1> ;  Registers in the editor: EBX = the cursor, EDX = the end of the line
  1642                              <1> ;  (pointers into the line buffer); EDI is free (edit resets it).
  1643                              <1> ; =============================================================================
  1644                              <1> %if EDITOR
  1645                              <1> ; ^E: line n goes into the input line, to be changed. V_EDLN remembers
  1646                              <1> ; which line it was: Return puts the text back in its place.
  1647                              <1> cedln:  CALLP   rdnum
  1648                              <1>         xchg    eax,edx                 ; (find and V_EDLN use only the low
  1649                              <1>         push    eax                     ;   word)
  1650                              <1>         CALLP   find                    ; EDI -> the line, or the NUL
  1651                              <1>         pop     eax
  1652                              <1>         cmp     byte [edi],0
  1653                              <1>         je      .ce9
  1654                              <1>         mov     [V(v_edln)],eax
  1655                              <1>         mov     ebx,ARENA+LINEBUF
  1656                              <1> .ce1:   mov     al,[edi]                ; copy it, and show it, up to its CR
  1657                              <1>         cmp     al,13                   ;   (or LF)
  1658                              <1>         je      .ce2
  1659                              <1>         cmp     al,10
  1660                              <1>         je      .ce2
  1661                              <1>         mov     [ebx],al
  1662                              <1>         CALLP   putc
  1663                              <1>         inc     edi
  1664                              <1>         inc     ebx
  1665                              <1>         cmp     bl,0FDh                 ; (a longer line is cut at 125)
  1666                              <1>         jne     .ce1
  1667                              <1> .ce2:   mov     edx,ebx                 ; the cursor is at the line's end
  1668                              <1>         pop     eax                     ; (not back to edit: on with the line)
  1669                              <1>         jmp     ed1
  1670                              <1> .ce9:   ret
  1671                              <1> 
  1672                              <1> ; right arrow: one to the right, by printing the character there
  1673                              <1> right:  cmp     ebx,edx
  1674                              <1>         je      ed1                     ; at the end
  1675                              <1>         mov     al,[ebx]
  1676                              <1>         inc     ebx
  1677                              <1>         jmp     short lf1
  1678                              <1> 
  1679                              <1> ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
  1680                              <1> ; wait about 5 ms for a second key: after a '[' read on to the letter that
  1681                              <1> ; ends the sequence, and act on C (right) and D (left).
  1682                              <1> esc:    push    5
  1683                              <1>         pop     eax
  1684                              <1>         CALLP   waitk
  1685                              <1>         jnz     .es2
  1686                              <1>         call    fin                     ; no second key: the line is dropped
  1687                              <1>         jmp     edit
  1688                              <1> .es2:   cmp     al,'['
  1689                              <1>         jne     ed1                     ; not a sequence known here
  1690                              <1> .es3:   CALLP   ekey
  1691                              <1>         cmp     al,40h
  1692                              <1>         jb      .es3                    ; (its parameters)
  1693                              <1>         sub     al,'C'
  1694                              <1>         je      right
  1695                              <1>         dec     al                      ; 'D'?
  1696                              <1>         jne     ed1                     ; no: on into left
  1697                              <1> ; left arrow: the cursor goes one to the left
  1698                              <1> left:   cmp     bl,80h
  1699                              <1>         je      ed1                     ; at the start
  1700                              <1>         dec     ebx
  1701                              <1>         mov     al,8
  1702                              <1> lf1:    CALLP   putc
  1703                              <1>         jmp     ed1
  1704                              <1> 
  1705                              <1> ; edit0: an error or a break: both stacks are cleared, and the cursor is
  1706                              <1> ;   shown, in case the program had hidden it and could not show it again.
  1707                              <1> ; skend: a program that ended inside skip: its return address goes.
  1708                              <1> ; edend: a program that ended: TOS joins the rest of the data stack.
  1709                              <1> edit0:  mov     esp,[V(v_dstop)]
  1710                              <1>  %if CHECKED
  1711                              <1>         push    -11                     ; the report went to stderr: back to
  1712                              <1>         call    [V(iat_GetStdHandle)]   ;   stdout
  1713                              <1>         mov     [V(v_outh)],eax
  1714                              <1>         mov     ebx,esi                 ; (the report's texts moved EBX out of
  1715                              <1>  %endif                                 ;   the arena: the cell for TOS)
  1716                              <1>         mov     eax,6835323Fh           ; ESC [ ? 2 5 h: show the cursor
  1717                              <1>         call    pseq
  1718                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1719                              <1> skend:  pop     eax
  1720                              <1> edend:  push    ebx
  1721                              <1> ; edit: start a new input line.
  1722                              <1> edit:   mov     edi,RSTOP               ; the return stack is empty
  1723                              <1>         xor     eax,eax
  1724                              <1>         mov     [ARENA+HELD],ax         ; no key is held, and the break key is on
  1725                              <1>         mov     [V(v_edln)],eax         ; no line is being edited
  1726                              <1>         mov     ebx,ARENA+LINEBUF       ; EBX = the cursor,
  1727                              <1>         mov     edx,ebx                 ;   EDX = the end of the line
  1728                              <1> ed1:    CALLP   ekey
  1729                              <1>         cmp     al,7Fh
  1730                              <1>         je      bsp                     ; DEL
  1731                              <1>         cmp     al,' '
  1732                              <1>         jae     insc
  1733                              <1>         cmp     al,9
  1734                              <1>         je      insc                    ; Tab is text
  1735                              <1>         cmp     al,8
  1736                              <1>         je      bsp
  1737                              <1>         cmp     al,1Ch
  1738                              <1>         je      left                    ; the left arrow key (see waitk)
  1739                              <1>         cmp     al,1Eh
  1740                              <1>         je      right                   ; the right arrow key
  1741                              <1>         cmp     al,1Bh
  1742                              <1>         je      esc
  1743                              <1>         push    edi                     ; a command key? Look it up
  1744                              <1>         mov     edi,ckeys
  1745                              <1>         push    NCMD
  1746                              <1>         pop     ecx
  1747                              <1>         repne   scasb
  1748                              <1>         pop     edi
  1749                              <1>         jne     ed1                     ; no: the key is ignored
  1750                              <1>         push    edit                    ; the command returns to edit
  1751                              <1>         mov     eax,ebp                 ; the command's address (the high word
  1752                              <1>         mov     ax,[ctabr+ecx*2]        ;   is next's): fin returns to it
  1753                              <1>         push    eax
  1754                              <1> ; fin: end the input line: CR LF and a NUL after it, and a new line on the
  1755                              <1> ; terminal. Leaves ESI -> the line.
  1756                              <1> fin:    mov     word [edx],0A0Dh
  1757                              <1>         mov     esi,edx
  1758                              <1>         call    prl                     ; (prints the CR LF)
  1759                              <1>         mov     byte [esi],0
  1760                              <1>         mov     esi,ARENA+LINEBUF
  1761                              <1>         ret
  1762                              <1> 
  1763                              <1> ; Backspace, DEL: the character before the cursor goes. The cursor moves
  1764                              <1> ; left, the rest of the line moves down over it, and the last place (now a
  1765                              <1> ; space) is printed over along with the rest.
  1766                              <1> bsp:    cmp     bl,80h
  1767                              <1>         je      ed1                     ; at the start
  1768                              <1>         dec     ebx
  1769                              <1>         mov     al,8
  1770                              <1>         CALLP   putc
  1771                              <1>         mov     ecx,ebx
  1772                              <1> .bs1:   mov     al,[ecx+1]
  1773                              <1>         mov     [ecx],al
  1774                              <1>         inc     ecx
  1775                              <1>         cmp     ecx,edx
  1776                              <1>         jne     .bs1
  1777                              <1>         mov     byte [ecx-1],' '
  1778                              <1>         dec     edx
  1779                              <1>         jmp     short ic2
  1780                              <1> ; A character goes in at the cursor: it ripples up through the rest of the
  1781                              <1> ; line, the cursor moves on, and the rest is printed again.
  1782                              <1> insc:   cmp     dl,0FDh
  1783                              <1>         je      ed1                     ; the line is full: 125 characters
  1784                              <1>         CALLP   putc
  1785                              <1>         mov     ecx,ebx
  1786                              <1> .ic1:   xchg    al,[ecx]
  1787                              <1>         inc     ecx
  1788                              <1>         cmp     ecx,edx
  1789                              <1>         jbe     .ic1
  1790                              <1>         inc     ebx
  1791                              <1>         inc     edx
  1792                              <1>         mov     ecx,edx
  1793                              <1> ; ic2: print the line from the cursor to ECX, and bring the cursor back
  1794                              <1> ; with backspaces. Nothing at all if the cursor is at ECX.
  1795                              <1> ic2:    mov     esi,ebx
  1796                              <1> .ta1:   cmp     esi,ecx
  1797                              <1>         je      .ta2
  1798                              <1>         lodsb
  1799                              <1>         CALLP   putc
  1800                              <1>         jmp     .ta1
  1801                              <1> .ta2:   cmp     esi,ebx
  1802                              <1>         je      .ta3
  1803                              <1>         mov     al,8
  1804                              <1>         CALLP   putc
  1805                              <1>         dec     esi
  1806                              <1>         jmp     .ta2
  1807                              <1> .ta3:   jmp     ed1
  1808                              <1> 
  1809                              <1> ; ekey: wait for a key
  1810                              <1> ekey:   or      eax,-1
  1811                              <1>         JMPP    waitk
  1812                              <1> 
  1813                              <1> ; The command keys, and where each goes (after fin, which returns to the
  1814                              <1> ; command; the command returns to edit, which is under it on the stack).
  1815                              <1> ; REPNE SCASB leaves ECX = the number of keys after the one found, so the
  1816                              <1> ; table is backwards. (The addresses are kept as their low words: the code
  1817                              <1> ; is all in the one 64 KB as `next`.)
  1818                              <1> ckeys:  db      13, 7, 12, 5, 18, 23, 14, 24
  1819                              <1> NCMD    equ     $-ckeys
  1820                              <1> ctabr:  dw      exit-IB                 ; ^X
  1821                              <1>         dw      cnew-IB                 ; ^N
  1822                              <1>         dw      cwrite-IB               ; ^W
  1823                              <1>         dw      cread-IB                ; ^R
  1824                              <1>         dw      cedln-IB                ; ^E
  1825                              <1>         dw      clist-IB                ; ^L
  1826                              <1>         dw      crun-IB                 ; ^G
  1827                              <1>         dw      cret-IB                 ; Return
  1828                              <1> 
  1829                              <1> ; ^N: no program
  1830                              <1> cnew:   mov     byte [ARENA+PROG],0
  1831                              <1>         ret
  1832                              <1> 
  1833                              <1> ; delln: take line EAX out: copy everything after it down over it. Keeps ESI.
  1834                              <1> delln:  push    esi
  1835                              <1>         CALLP   find
  1836                              <1>         push    edi
  1837                              <1>         call    nxl                     ; EDI -> the next line
  1838                              <1>         mov     esi,edi
  1839                              <1>         pop     edi
  1840                              <1> .de1:   lodsb
  1841                              <1>         stosb
  1842                              <1>         test    al,al
  1843                              <1>         jnz     .de1
  1844                              <1>         pop     esi
  1845                              <1>         ret
  1846                              <1> 
  1847                              <1> ; Return. If ^E put a line here, the text goes back in its place. If not:
  1848                              <1> ; a number and text is a line to put in, a number alone a line to take out,
  1849                              <1> ; and anything else is run where it is.
  1850                              <1> cret:   push    edx                     ; the end of what was typed
  1851                              <1>         mov     eax,[V(v_edln)]
  1852                              <1>         test    eax,eax
  1853                              <1>         jz      .cr1
  1854                              <1>         push    eax
  1855                              <1>         call    delln
  1856                              <1>         pop     eax
  1857                              <1>         jmp     short ins
  1858                              <1> .cr1:   CALLP   rdnum                   ; DX = the number it starts with
  1859                              <1>         mov     eax,esi                 ; ESI's low byte is still 80h if there
  1860                              <1>         cmp     al,80h                  ;   was no number:
  1861                              <1>         je      runln                   ;   then run the line
  1862                              <1>         xchg    eax,edx
  1863                              <1>         cmp     byte [esi],13
  1864                              <1>         jne     .cr2
  1865                              <1>         pop     edx                     ; the number alone: take that line out
  1866                              <1>         jmp     delln
  1867                              <1> .cr2:   inc     esi                     ; step over the one character after it
  1868                              <1> 
  1869                              <1> ; Put the text at ESI in as line EAX: open a gap of its length there, CR
  1870                              <1> ; and LF included, and copy it in.
  1871                              <1> ins:    CALLP   find                    ; EDI -> where it goes
  1872                              <1>         pop     ecx                     ; the end of what was typed
  1873                              <1>         inc     ecx
  1874                              <1>         inc     ecx
  1875                              <1>         sub     ecx,esi                 ; the length, with its CR LF
  1876                              <1>         push    esi                     ; the text
  1877                              <1>         push    ecx                     ; its length
  1878                              <1>         push    edi                     ; where it goes
  1879                              <1>         mov     esi,edi
  1880                              <1> .in1:   lodsb                           ; find the program's NUL
  1881                              <1>         test    al,al
  1882                              <1>         jnz     .in1
  1883                              <1>         dec     esi
  1884                              <1>         mov     ecx,esi
  1885                              <1>         sub     ecx,edi
  1886                              <1>         inc     ecx                     ; the bytes to move up, NUL included
  1887                              <1>         mov     edi,esi
  1888                              <1>         add     edi,[esp+4]             ; the NUL's new place
  1889                              <1>         std
  1890                              <1>         rep     movsb                   ; move the rest of the program up
  1891                              <1>         cld
  1892                              <1>         pop     edi
  1893                              <1>         pop     ecx
  1894                              <1>         pop     esi
  1895                              <1>         rep     movsb
  1896                              <1>         ret
  1897                              <1> 
  1898                              <1> ; ^G: run the program. runln: run the typed line (ESI -> it).
  1899                              <1> crun:   mov     esi,ARENA+PROG
  1900                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1901                              <1> runln:  pop     eax                     ; (the end of what was typed)
  1902                              <1>         pop     eax                     ; (the return to edit: a program that
  1903                              <1>                                         ;   ends goes to edend)
  1904                              <1>         RUN0CODE
  1905                              <1> 
  1906                              <1> ; ^L: list from line n. EDX = the number of the line at ESI.
  1907                              <1> clist:  CALLP   rdnum                   ; DX = n, or 0 if there was none:
  1908                              <1>         movzx   eax,dx
  1909                              <1>         test    eax,eax
  1910                              <1>         jnz     .li0
  1911                              <1>         inc     eax                     ;   then from line 1
  1912                              <1> .li0:   push    eax
  1913                              <1>         CALLP   find
  1914                              <1>         pop     edx
  1915                              <1>         mov     esi,edi
  1916                              <1> .li1:   cmp     byte [esi],0
  1917                              <1>         je      .li9                    ; the end of the text
  1918                              <1>         xor     eax,eax
  1919                              <1>         CALLP   waitk
  1920                              <1>         jz      .li3                    ; no key: carry on
  1921                              <1>         cmp     al,3
  1922                              <1>         je      .li9                    ; Ctrl-C ends the list,
  1923                              <1>         CALLP   ekey                    ;   any other key holds it until the
  1924                              <1>         cmp     al,3                    ;   next (and a Ctrl-C then ends it)
  1925                              <1> .li9:   je      fi9
  1926                              <1> .li3:   push    edx
  1927                              <1>         xchg    eax,edx
  1928                              <1>         CALLP   pdec                    ; the line's number,
  1929                              <1>         mov     al,' '
  1930                              <1>         CALLP   putc                    ;   a space,
  1931                              <1>         pop     edx
  1932                              <1>         inc     edx
  1933                              <1>         call    prl                     ;   and the line
  1934                              <1>         jmp     .li1
  1935                              <1> 
  1936                              <1> ; find: EAX = a line number. Returns EDI -> that line, or -> the NUL at the
  1937                              <1> ; end of the text if there are fewer lines (or the number is 0). Keeps ESI.
  1938                              <1> find:   xchg    eax,ecx
  1939                              <1>         mov     edi,ARENA+PROG
  1940                              <1> .fi1:   dec     cx
  1941                              <1>         jz      fi9
  1942                              <1>         call    nxl
  1943                              <1>         jnz     .fi1
  1944                              <1> fi9:    ret
  1945                              <1> 
  1946                              <1> ; nxl: step EDI over one line, to just past its LF (and return not-zero),
  1947                              <1> ; or stop at the NUL that ends the text (and return zero).
  1948                              <1> nxl:    mov     al,[edi]
  1949                              <1>         test    al,al
  1950                              <1>         jz      .nx1
  1951                              <1>         inc     edi
  1952                              <1>         cmp     al,10
  1953                              <1>         jne     nxl
  1954                              <1>         test    al,al
  1955                              <1> .nx1:   ret
  1956                              <1> 
  1957                              <1> ; prl: print the line at ESI, to its LF; ESI -> just past it.
  1958                              <1> prl:    lodsb
  1959                              <1>         CALLP   putc
  1960                              <1>         cmp     al,10
  1961                              <1>         jne     prl
  1962                              <1>         ret
  1963                              <1> 
  1964                              <1> ; ^R: read the file (cread, at load). ^W: write the file (made anew, or
  1965                              <1> ; emptied first). A name typed before the key is the file's name from now
  1966                              <1> ; on. (A file that can't be made or written is not noticed: nothing is
  1967                              <1> ; written.)
  1968                              <1> cwrite: call    setname
  1969                              <1>         mov     edi,ARENA+PROG
  1970                              <1>         xor     eax,eax
  1971                              <1>         or      ecx,-1
  1972                              <1>         repne   scasb
  1973                              <1>         not     ecx
  1974                              <1>         dec     ecx                     ; the length of the text
  1975                              <1>         push    ecx
  1976                              <1>         push    eax                     ; hTemplateFile
  1977                              <1>         push    eax                     ; dwFlagsAndAttributes
  1978                              <1>         push    2                       ; CREATE_ALWAYS
  1979                              <1>         push    eax                     ; lpSecurityAttributes
  1980                              <1>         push    eax                     ; no sharing
  1981                              <1>         push    40000000h               ; GENERIC_WRITE
  1982                              <1>         push    NAMEBUF
  1983                              <1>         call    [V(iat_CreateFileA)]
  1984                              <1>         pop     ecx
  1985                              <1>         push    eax                     ; (for CloseHandle)
  1986                              <1>         push    0
  1987                              <1>         lea     edx,[V(v_cnt)]
  1988                              <1>         push    edx
  1989                              <1>         push    ecx
  1990                              <1>         push    ARENA+PROG
  1991                              <1>         push    eax
  1992                              <1>         call    [V(iat_WriteFile)]
  1993                              <1>         call    [V(iat_CloseHandle)]
  1994                              <1>         ret
  1995                              <1> 
  1996                              <1> ; setname: if a name was typed (the line does not start with its CR), it is
  1997                              <1> ; the file's name from now on, as typed (a Windows path).
  1998                              <1> setname:mov     esi,ARENA+LINEBUF
  1999                              <1>         cmp     byte [esi],13
  2000                              <1>         je      .sn2
  2001                              <1>         mov     edi,NAMEBUF
  2002                              <1> .sn1:   lodsb
  2003                              <1>         stosb
  2004                              <1>         cmp     al,13
  2005                              <1>         jne     .sn1
  2006                              <1>         mov     byte [edi-1],0          ; (the CR becomes the NUL)
  2007                              <1> .sn2:   ret
  2008                              <1> %endif
  2009                              <1> 
  2010                              <1> ; The dispatch table: each handler's distance from hbase (an error if it
  2011                              <1> ; is not in the window).
  2012                              <1> %macro  PT 1
  2013                              <1>         db      (%1-hbase) & 0FFh
  2014                              <1>         times   -((%1-hbase) > 255) db 0
  2015                              <1> %endmacro
  2016                              <1> %if FAST == 0
  2017                              <1> ptab:   PT h_store      ; !
  2017                              <2> ptab: 
  2013 000004A2 A8                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2018                              <1>         PT h_str        ; "
  2013 000004A3 AF                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2019                              <1>         PT h_num        ; #
  2013 000004A4 C0                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2020                              <1>         PT h_print      ; $
  2013 000004A5 FA                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2021                              <1>         PT h_swap       ; %
  2013 000004A6 9E                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2022                              <1>         PT h_and        ; &
  2013 000004A7 4E                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2023                              <1>         PT h_emit       ; '
  2013 000004A8 B9                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2024                              <1>         PT h_open       ; (
  2013 000004A9 20                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2025                              <1>         PT h_close      ; )
  2013 000004AA 16                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2026                              <1>         PT h_mul        ; *
  2013 000004AB 65                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2027                              <1>         PT h_add        ; +
  2013 000004AC 48                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2028                              <1>         PT h_cfetch     ; ,
  2013 000004AD C9                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2029                              <1>         PT h_sub        ; -
  2013 000004AE 3D                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2030                              <1>         PT h_cstore     ; .
  2013 000004AF A3                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2031                              <1>         PT h_div        ; /
  2013 000004B0 88                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2032                              <1>         PT h_dup        ; :
  2013 000004B1 9B                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2033                              <1>         PT h_drop       ; ;
  2013 000004B2 AC                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2034                              <1>         PT h_lt         ; <
  2013 000004B3 6C                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2035                              <1>         PT h_eq         ; =
  2013 000004B4 7E                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2036                              <1>         PT h_gt         ; >
  2013 000004B5 6F                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2037                              <1>         PT h_key        ; ?
  2013 000004B6 E8                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2038                              <1>         PT h_fetch      ; @
  2013 000004B7 38                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2039                              <1>         PT h_def        ; [
  2013 000004B8 D1                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2040                              <1>         PT h_break      ; backslash
  2013 000004B9 05                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2041                              <1>         PT h_ret        ; ]
  2013 000004BA 00                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2042                              <1>         PT h_xor        ; ^
  2013 000004BB 5A                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2043                              <1>         PT h_alloc      ; _
  2013 000004BC D5                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2044                              <1>         PT h_grave      ; `
  2013 000004BD D3                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2045                              <1>         PT h_tor        ; {
  2013 000004BE 2E                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2046                              <1>         PT h_or         ; |
  2013 000004BF 54                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2047                              <1>         PT h_fromr      ; }
  2013 000004C0 33                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2048                              <1>         PT h_not        ; ~
  2013 000004C1 60                  <2>  db (%1-hbase) & 0FFh
  2014                              <2>  times -((%1-hbase) > 255) db 0
  2049                              <1> %else
  2050                              <1> ; =============================================================================
  2051                              <1> ;  The fast build (SPEED = 2)
  2052                              <1> ;
  2053                              <1> ;  The inner loop is a table of 256 handlers, one per character, and the
  2054                              <1> ;  dispatcher (NEXTF: MOVZX EAX,BYTE [ESI] / INC ESI / JMP [dtab+EAX*4]) is
  2055                              <1> ;  `next` and is inline at the end of the fast build's own handlers. Those
  2056                              <1> ;  are: one per letter and digit, which knows its cell or its value, and the
  2057                              <1> ;  commonest punctuation (fs_). The rest of the table is the regular
  2058                              <1> ;  handlers, which end with JMP EBP, into `next`.
  2059                              <1> ;
  2060                              <1> ;  A digit's handler pushes its value; the character after it goes through
  2061                              <1> ;  dtabd, which is dtab but for the digits: those go on with the number
  2062                              <1> ;  (fdm). (In the checked build anything else in dtabd is fdx, which goes back
  2063                              <1> ;  through `next`, for its check of the stacks once the number is read.)
  2064                              <1> ; =============================================================================
  2065                              <1> %assign i 0
  2066                              <1> %rep 10
  2067                              <1> fd%[i]: push    ebx                     ; 0-9: a number starts
  2068                              <1>         mov     ebx,ARENA+i
  2069                              <1>         NEXTD
  2070                              <1> %assign i i+1
  2071                              <1> %endrep
  2072                              <1> fdm:    imul    bx,bx,10                ; another digit (EAX = it)
  2073                              <1>         sub     al,'0'
  2074                              <1>         add     bx,ax
  2075                              <1>         NEXTD
  2076                              <1> %if CHECKED
  2077                              <1> fdx:    dec     esi                     ; the number has ended: the character
  2078                              <1>         jmp     ebp                     ;   after it goes through next
  2079                              <1> %endif
  2080                              <1> 
  2081                              <1> ; A-Z: call the word. The return address goes on the return stack, the IP
  2082                              <1> ; becomes the word's body, and the break key is looked at as at rpush.
  2083                              <1> %assign i 0
  2084                              <1> %rep 26
  2085                              <1> fu%[i]: sub     edi,4
  2086                              <1>         mov     [edi],esi
  2087                              <1>         mov     si,[ARENA+LET+2*i]
  2088                              <1>         dec     byte [V(v_pcnt)]
  2089                              <1>         jz      fpoll
  2090                              <1>         NEXTF
  2091                              <1> %assign i i+1
  2092                              <1> %endrep
  2093                              <1> fpoll:  call    pollk                   ; (one time in 256)
  2094                              <1>         jmp     ebp
  2095                              <1> 
  2096                              <1> ; a-z: push the cell's address. In the unchecked build a variable followed
  2097                              <1> ; by '@' or '!' is fetched or stored in the same step.
  2098                              <1> %assign i 0
  2099                              <1> %rep 26
  2100                              <1> %if CHECKED
  2101                              <1> fv%[i]: push    ebx
  2102                              <1>         mov     ebx,ARENA+LET+40h+2*i
  2103                              <1>         NEXTF
  2104                              <1> %else
  2105                              <1> fv%[i]: cmp     byte [esi],'@'
  2106                              <1>         jne     .v1
  2107                              <1>         push    ebx                     ; x@
  2108                              <1>         mov     bx,[ARENA+LET+40h+2*i]
  2109                              <1>         inc     esi
  2110                              <1>         NEXTF
  2111                              <1> .v1:    cmp     byte [esi],'!'
  2112                              <1>         jne     .v2
  2113                              <1>         mov     [ARENA+LET+40h+2*i],bx  ; x!
  2114                              <1>         pop     ebx
  2115                              <1>         inc     esi
  2116                              <1>         NEXTF
  2117                              <1> .v2:    push    ebx
  2118                              <1>         mov     ebx,ARENA+LET+40h+2*i
  2119                              <1>         NEXTF
  2120                              <1> %endif
  2121                              <1> %assign i i+1
  2122                              <1> %endrep
  2123                              <1> 
  2124                              <1> ; The commonest punctuation, written for the fast build (as the regular
  2125                              <1> ; handlers, but with the dispatcher inline; and '%' without XCHG with
  2126                              <1> ; memory, which is locked, and slow).
  2127                              <1> fs_add: pop     edx                     ; +
  2128                              <1>         add     bx,dx
  2129                              <1>         NEXTF
  2130                              <1> fs_sub: mov     al,[esi]                ; -
  2131                              <1>         sub     al,'0'
  2132                              <1>         cmp     al,10
  2133                              <1>         jb      negnum                  ; (a negative number)
  2134                              <1>         pop     edx
  2135                              <1>         sub     dx,bx
  2136                              <1>         mov     bx,dx
  2137                              <1>         NEXTF
  2138                              <1> fs_mul: pop     edx                     ; *
  2139                              <1>         imul    bx,dx
  2140                              <1>         NEXTF
  2141                              <1> %undef  NEXTJ
  2142                              <1> %define NEXTJ   NEXTF
  2143                              <1> fs_div: DIVCODE                         ; /
  2144                              <1> %undef  NEXTJ
  2145                              <1> %define NEXTJ   jmp ebp
  2146                              <1> fs_and: pop     edx                     ; &
  2147                              <1>         and     bx,dx
  2148                              <1>         NEXTF
  2149                              <1> fs_or:  pop     edx                     ; |
  2150                              <1>         or      bx,dx
  2151                              <1>         NEXTF
  2152                              <1> fs_xor: pop     edx                     ; ^
  2153                              <1>         xor     bx,dx
  2154                              <1>         NEXTF
  2155                              <1> fs_not: not     bx                      ; ~
  2156                              <1>         NEXTF
  2157                              <1> fs_lt:  pop     edx                     ; <  (DX = a, BX = b: carry if a < b)
  2158                              <1>         xor     dh,80h
  2159                              <1>         xor     bh,80h
  2160                              <1>         cmp     dx,bx
  2161                              <1>         sbb     bx,bx
  2162                              <1>         NEXTF
  2163                              <1> fs_gt:  pop     edx                     ; >  (carry if b < a)
  2164                              <1>         xor     dh,80h
  2165                              <1>         xor     bh,80h
  2166                              <1>         cmp     bx,dx
  2167                              <1>         sbb     bx,bx
  2168                              <1>         NEXTF
  2169                              <1> fs_eq:  pop     edx                     ; =
  2170                              <1>         sub     bx,dx
  2171                              <1>         cmp     bx,1
  2172                              <1>         sbb     bx,bx
  2173                              <1>         NEXTF
  2174                              <1> fs_dup: push    ebx                     ; :
  2175                              <1>         NEXTF
  2176                              <1> fs_drop:pop     ebx                     ; ;
  2177                              <1>         NEXTF
  2178                              <1> fs_swap:pop     edx                     ; %
  2179                              <1>         push    ebx
  2180                              <1>         mov     ebx,edx
  2181                              <1>         NEXTF
  2182                              <1> fs_fet: mov     bx,[ebx]                ; @
  2183                              <1>         NEXTF
  2184                              <1> fs_cfet:mov     bl,[ebx]                ; ,
  2185                              <1>         mov     bh,0
  2186                              <1>         NEXTF
  2187                              <1> fs_store:                               ; !
  2188                              <1> %if CHECKED
  2189                              <1>         call    chkst2
  2190                              <1> %endif
  2191                              <1>         pop     edx
  2192                              <1>         mov     [ebx],dx
  2193                              <1>         pop     ebx
  2194                              <1>         NEXTF
  2195                              <1> fs_cstore:                              ; .
  2196                              <1> %if CHECKED
  2197                              <1>         call    chkst1
  2198                              <1> %endif
  2199                              <1>         pop     edx
  2200                              <1>         mov     [ebx],dl
  2201                              <1>         pop     ebx
  2202                              <1>         NEXTF
  2203                              <1> fs_open:test    bx,bx                   ; (
  2204                              <1>         pop     ebx
  2205                              <1>         jz      .op1
  2206                              <1>         sub     edi,4                   ; the block start
  2207                              <1>         mov     [edi],esi
  2208                              <1>         dec     byte [V(v_pcnt)]
  2209                              <1>         jz      fpoll
  2210                              <1>         NEXTF
  2211                              <1> .op1:   call    skip
  2212                              <1>         NEXTF
  2213                              <1> fs_close:test   bx,bx                   ; )
  2214                              <1>         pop     ebx
  2215                              <1>         jz      .cl1
  2216                              <1>         mov     esi,[edi]               ; the block start, read where it is
  2217                              <1>         dec     byte [V(v_pcnt)]
  2218                              <1>         jz      fpoll
  2219                              <1>         NEXTF
  2220                              <1> .cl1:   add     edi,4
  2221                              <1>         NEXTF
  2222                              <1> fs_ret: mov     esi,[edi]               ; ]
  2223                              <1>         add     edi,4
  2224                              <1>         NEXTF
  2225                              <1> fs_break:test   bx,bx                   ; backslash
  2226                              <1>         pop     ebx
  2227                              <1>         jz      .br2
  2228                              <1>         call    skip
  2229                              <1>         test    al,al                   ; ')': the block start goes; ']' returns
  2230                              <1>         jz      .br1
  2231                              <1>         mov     esi,[edi]
  2232                              <1> .br1:   add     edi,4
  2233                              <1> .br2:   NEXTF
  2234                              <1> fs_tor: sub     edi,4                   ; {
  2235                              <1>         mov     [edi],ebx
  2236                              <1>         pop     ebx
  2237                              <1>         dec     byte [V(v_pcnt)]
  2238                              <1>         jz      fpoll
  2239                              <1>         NEXTF
  2240                              <1> fs_fromr:push   ebx                     ; }
  2241                              <1>         mov     ebx,[edi]
  2242                              <1>         add     edi,4
  2243                              <1>         NEXTF
  2244                              <1> fign:   NEXTF                           ; control characters, space, DEL (and
  2245                              <1>                                         ;   80h-FFh unchecked): nothing
  2246                              <1> 
  2247                              <1> ; The tables. The punctuation's handlers, by character:
  2248                              <1> %define FP_33   fs_store                ; !
  2249                              <1> %define FP_34   h_str                   ; "
  2250                              <1> %define FP_35   h_num                   ; #
  2251                              <1> %define FP_36   h_print                 ; $
  2252                              <1> %define FP_37   fs_swap                 ; %
  2253                              <1> %define FP_38   fs_and                  ; &
  2254                              <1> %define FP_39   h_emit                  ; '
  2255                              <1> %define FP_40   fs_open                 ; (
  2256                              <1> %define FP_41   fs_close                ; )
  2257                              <1> %define FP_42   fs_mul                  ; *
  2258                              <1> %define FP_43   fs_add                  ; +
  2259                              <1> %define FP_44   fs_cfet                 ; ,
  2260                              <1> %define FP_45   fs_sub                  ; -
  2261                              <1> %define FP_46   fs_cstore               ; .
  2262                              <1> %define FP_47   fs_div                  ; /
  2263                              <1> %define FP_58   fs_dup                  ; :
  2264                              <1> %define FP_59   fs_drop                 ; ;
  2265                              <1> %define FP_60   fs_lt                   ; <
  2266                              <1> %define FP_61   fs_eq                   ; =
  2267                              <1> %define FP_62   fs_gt                   ; >
  2268                              <1> %define FP_63   h_key                   ; ?
  2269                              <1> %define FP_64   fs_fet                  ; @
  2270                              <1> %define FP_91   h_def                   ; [
  2271                              <1> %define FP_92   fs_break                ; backslash
  2272                              <1> %define FP_93   fs_ret                  ; ]
  2273                              <1> %define FP_94   fs_xor                  ; ^
  2274                              <1> %define FP_95   h_alloc                 ; _
  2275                              <1> %define FP_96   h_grave                 ; `
  2276                              <1> %define FP_123  fs_tor                  ; {
  2277                              <1> %define FP_124  fs_or                   ; |
  2278                              <1> %define FP_125  fs_fromr                ; }
  2279                              <1> %define FP_126  fs_not                  ; ~
  2280                              <1> ; DENT c, after: the entry for character c in dtab (after 0) or dtabd (1)
  2281                              <1> %macro  DENT 2
  2282                              <1>  %assign c %1
  2283                              <1>  %if c >= 30h && c <= 39h
  2284                              <1>   %if %2
  2285                              <1>         dd      fdm
  2286                              <1>   %else
  2287                              <1>    %assign d c-30h
  2288                              <1>         dd      fd%[d]
  2289                              <1>   %endif
  2290                              <1>  %elif %2 && CHECKED
  2291                              <1>         dd      fdx
  2292                              <1>  %elif c == 0
  2293                              <1>         dd      endprog                 ; NUL: the end of the program
  2294                              <1>  %elif c < 21h || c == 7Fh
  2295                              <1>         dd      fign
  2296                              <1>  %elif c >= 80h
  2297                              <1>   %if CHECKED
  2298                              <1>         dd      e_hi                    ; reserved (X)
  2299                              <1>   %else
  2300                              <1>         dd      fign
  2301                              <1>   %endif
  2302                              <1>  %elif c >= 41h && c <= 5Ah
  2303                              <1>   %assign d c-41h
  2304                              <1>         dd      fu%[d]
  2305                              <1>  %elif c >= 61h && c <= 7Ah
  2306                              <1>   %assign d c-61h
  2307                              <1>         dd      fv%[d]
  2308                              <1>  %else
  2309                              <1>         dd      FP_%[c]
  2310                              <1>  %endif
  2311                              <1> %endmacro
  2312                              <1>         align   4, db 0
  2313                              <1> dtab:
  2314                              <1> %assign j 0
  2315                              <1> %rep 256
  2316                              <1>         DENT    j, 0
  2317                              <1> %assign j j+1
  2318                              <1> %endrep
  2319                              <1> dtabd:
  2320                              <1> %assign j 0
  2321                              <1> %rep 256
  2322                              <1>         DENT    j, 1
  2323                              <1> %assign j j+1
  2324                              <1> %endrep
  2325                              <1> ; sktab: for skip, 1 for the six characters that count there
  2326                              <1> sktab:
  2327                              <1> %assign j 0
  2328                              <1> %rep 256
  2329                              <1>  %if j == 0 || j == 22h || j == 28h || j == 29h || j == 5Bh || j == 5Dh
  2330                              <1>         db      1
  2331                              <1>  %else
  2332                              <1>         db      0
  2333                              <1>  %endif
  2334                              <1> %assign j j+1
  2335                              <1> %endrep
  2336                              <1> %endif
