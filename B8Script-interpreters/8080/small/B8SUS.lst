03A8                             ; psgn: print HL as a signed number. Uses BC.
03A8   7C           PSGN:     MOV   A,H   
03A9   B7                     ORA   A   
03AA   F2 B5 03               JP   pdec   
03AD   3E 2D                  MVI   A,"-"   
03AF                          ;*Macro unroll:  PUTA
03AF                          DS   1-CPM,0EFh   
03AF   CD                     DS   CPM,0CDh   
03B0   1D                     DS   CPM,APUT&0FFh   
03B1   05                     DS   CPM,APUT/256   
03B2                          ;*Macro unroll:  NEGH
03B2                          DS   1-CPM,0E7h   
03B2   CD                     DS   CPM,0CDh   
03B3   27                     DS   CPM,ANEG&0FFh   
03B4   01                     DS   CPM,ANEG/256   
03B5                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03B5                             ; Uses BC.
03B5   11 0A 00     PDEC:     LXI   D,10   
03B8   CD 76 03               CALL   udiv   ; HL = HL / 10, C = the last digit
03BB   79                     MOV   A,C   
03BC   F5                     PUSH   PSW   
03BD   7C                     MOV   A,H   
03BE   B5                     ORA   L   
03BF   C4 B5 03               CNZ   pdec   
03C2   F1                     POP   PSW   
03C3   C6 30                  ADI   "0"   
03C5                          ;*Macro unroll:  PUTA
03C5                          DS   1-CPM,0EFh   
03C5   CD                     DS   CPM,0CDh   
03C6   1D                     DS   CPM,APUT&0FFh   
03C7   05                     DS   CPM,APUT/256   
03C8   C9                     RET      
03C9                             ; (The table goes here instead in the builds where, before the routines, it
03C9                             ; would cross a page: PTLATE. If it would cross one here too, it starts on
03C9                             ; the next page: PTPAD is 0 unless it must.)
03C9                          IF   (1-FAST)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
03C9                          ENDIF      
03C9                          IF   1-CHECKED   
03C9                             ; "$" prints the string at TOS (see h_print).
03C9   7E           PRLP:     MOV   A,M   
03CA   23                     INX   H   
03CB   FE 22                  CPI   22h   
03CD   CA C6 02               JZ   h_drop   
03D0   FE 2F                  CPI   "/"   
03D2   C2 E3 03               JNZ   pr1   
03D5   7E                     MOV   A,M   
03D6   23                     INX   H   
03D7   FE 60                  CPI   60h   
03D9   DA E1 03               JC   pr0   
03DC   FE 7F                  CPI   7Fh   
03DE   DA E9 03               JC   pesc   
03E1   E6 BF        PR0:      ANI   0BFh   
03E3                          ;*Macro unroll: pr1:    PUTA
03E3                PR1:      DS   1-CPM,0EFh   
03E3   CD                     DS   CPM,0CDh   
03E4   1D                     DS   CPM,APUT&0FFh   
03E5   05                     DS   CPM,APUT/256   
03E6   C3 C9 03               JMP   prlp   
03E9                          ENDIF      
03E9                             ;-----------------------------------------------------------------------------
03E9                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
03E9                             ; HL points past it. Each goes back into the loop that prints the string
03E9                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
03E9                             ;    /a-/z   print the variable, as "#" does
03E9                             ;    /{      clear the screen, the cursor to the top left
03E9                             ;    /}      clear from the cursor to the end of the line
03E9                             ;    /|  /`  show the cursor, hide it
03E9                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
03E9   FE 7E        PESC:     CPI   7Eh   
03EB   CA 0E 04               JZ   pat   
03EE   11 C9 03               LXI   D,PRLOOP   ; the others return into the loop
03F1   D5                     PUSH   D   
03F2   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
03F4   D2 46 04               JNC   pcon   
03F7   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
03F9   D2 30 04               JNC   phide   
03FC   87                     ADD   A   ; the variable's cell
03FD   C6 40                  ADI   40h   
03FF   E5                     PUSH   H   
0400   C5                     PUSH   B   
0401   6F                     MOV   L,A   
0402   26 08                  MVI   H,LETPAGE   
0404   7E                     MOV   A,M   
0405   2C                     INR   L   
0406   66                     MOV   H,M   
0407   6F                     MOV   L,A   
0408   CD A8 03               CALL   psgn   
040B   C1                     POP   B   
040C   E1                     POP   H   
040D   C9                     RET      
040E                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
040E                             ; the checked build "$" is the routine prstr: its own return address goes
040E                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
040E                             ; its two cells are there, and is s if not, before it prints anything.
040E                PAT:         
040E                          IF   CHECKED   
                              XTHL      ; the text pointer over prstr's return address
                              LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              DAD   SP   
                              JC   e_under   
                              POP   H   
040E                          ENDIF      
040E   D1                     POP   D   ; DE = the column
040F   E3                     XTHL      ; HL = the row; the text pointer is kept
0410                          IF   1-ANS   
                              CALL   CONAT   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JZ   CONCLS   ; /{
                              CPI   2   
                              JZ   CONEOL   ; /}
                              DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
                    PHIDE:    XRA   A   ; /`  (A = 0: hide)
                              JMP   CONCUR   
0410                          ENDIF      
0410                          IF   ANS   
0410   C5                     PUSH   B   ; (pdec uses BC)
0411   D5                     PUSH   D   
0412   CD 5F 04               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0415   23                     INX   H   
0416   CD B5 03               CALL   pdec   
0419   3E 3B                  MVI   A,";"   
041B                          ;*Macro unroll:  PUTA
041B                          DS   1-CPM,0EFh   
041B   CD                     DS   CPM,0CDh   
041C   1D                     DS   CPM,APUT&0FFh   
041D   05                     DS   CPM,APUT/256   
041E   E1                     POP   H   
041F   23                     INX   H   
0420   CD B5 03               CALL   pdec   
0423   3E 48                  MVI   A,"H"   
0425                          ;*Macro unroll:  PUTA
0425                          DS   1-CPM,0EFh   
0425   CD                     DS   CPM,0CDh   
0426   1D                     DS   CPM,APUT&0FFh   
0427   05                     DS   CPM,APUT/256   
0428   C1                     POP   B   
0429   E1                     POP   H   
042A   C3 C9 03               JMP   PRAGAIN   
042D                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
042D   1E 68        PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
042F   DA                     DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
0430   1E 6C        PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
0432   3E 3F                  MVI   A,"?"   
0434   CD 56 04               CALL   csia   
0437   3E 32                  MVI   A,"2"   
0439                          ;*Macro unroll:  PUTA
0439                          DS   1-CPM,0EFh   
0439   CD                     DS   CPM,0CDh   
043A   1D                     DS   CPM,APUT&0FFh   
043B   05                     DS   CPM,APUT/256   
043C   3E 35                  MVI   A,"5"   
043E                          ;*Macro unroll:  PUTA
043E                          DS   1-CPM,0EFh   
043E   CD                     DS   CPM,0CDh   
043F   1D                     DS   CPM,APUT&0FFh   
0440   05                     DS   CPM,APUT/256   
0441   7B                     MOV   A,E   
0442                          ;*Macro unroll:  PUTA
0442                          DS   1-CPM,0EFh   
0442   CD                     DS   CPM,0CDh   
0443   1D                     DS   CPM,APUT&0FFh   
0444   05                     DS   CPM,APUT/256   
0445   C9                     RET      
0446                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0446   3D           PCON:     DCR   A   
0447   CA 2D 04               JZ   pshow   ; /|
044A   3E 4B                  MVI   A,"K"   
044C   F2 56 04               JP   csia   ; /}  ESC [ K
044F   3E 48                  MVI   A,"H"   ; /{  ESC [ H ESC [ J
0451   CD 56 04               CALL   csia   
0454   3E 4A                  MVI   A,"J"   ; (on into csia)
0456                             ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
0456   F5           CSIA:     PUSH   PSW   
0457   CD 5F 04               CALL   csi   
045A   F1                     POP   PSW   
045B                          ;*Macro unroll:  PUTA
045B                          DS   1-CPM,0EFh   
045B   CD                     DS   CPM,0CDh   
045C   1D                     DS   CPM,APUT&0FFh   
045D   05                     DS   CPM,APUT/256   
045E   C9                     RET      
045F   3E 1B        CSI:      MVI   A,27   
0461                          ;*Macro unroll:  PUTA
0461                          DS   1-CPM,0EFh   
0461   CD                     DS   CPM,0CDh   
0462   1D                     DS   CPM,APUT&0FFh   
0463   05                     DS   CPM,APUT/256   
0464   3E 5B                  MVI   A,"["   
0466                          ;*Macro unroll:  PUTA
0466                          DS   1-CPM,0EFh   
0466   CD                     DS   CPM,0CDh   
0467   1D                     DS   CPM,APUT&0FFh   
0468   05                     DS   CPM,APUT/256   
0469   C9                     RET      
046A                          ENDIF      
046A                             ; skip: read past text to the closer at this level, and return A = 0 if it
046A                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
046A                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
046A                             ; no closer; anything else that runs into the NUL had unbalanced brackets
046A                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
046A                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
046A                             ; 
046A                             ; The checked build also looks at the character the skip was started by,
046A                             ; which is always the one just before where it starts: "(" must end at ")",
046A                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
046A                             ; quote counts as running into it. "\" takes either closer. The place where
046A                             ; the skip started is kept on the stack, for the report.
046A                          IF   1-QK   
046A                             ; (Without base: no skip cache.)
046A                SKIP:        
046A                          ENDIF      
046A                          IF   CHECKED*(1-QK)   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
046A                          ENDIF      
046A                          IF   1-QK   
046A   16 00                  MVI   D,0   
046C   14           SK3:      INR   D   ; an opener: one deeper
046D   0A           SK1:      LDAX   B   
046E                          ENDIF      
046E                          IF   (1-CHECKED)*(1-QK)   
046E   03                     INX   B   
046F   B7                     ORA   A   
0470   CA 7F 01               JZ   endprog   
0473                          ENDIF      
0473                          IF   CHECKED*(1-QK)   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
0473                          ENDIF      
0473                          IF   1-QK   
0473   FE 22                  CPI   22h   
0475   CC 91 04               CZ   skipstr   ; leaves A = 22h, which matches nothing below
0478   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
047A   CA 6C 04               JZ   sk3   
047D   3D                     DCR   A   ; ")"
047E   CA 8B 04               JZ   sk4   
0481   D6 32                  SUI   "["-")"   
0483   CA 6C 04               JZ   sk3   
0486   FE 02                  CPI   "]"-"["   
0488   C2 6D 04               JNZ   sk1   
048B   15           SK4:      DCR   D   
048C                          ENDIF      
048C                          IF   (1-CHECKED)*(1-QK)   
048C   C8                     RZ      ; the closer at this level
048D   C3 6D 04               JMP   sk1   
0490                          ENDIF      
0490                          IF   CHECKED*(1-QK)   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
0490                          ENDIF      
0490                          IF   QK   
                                 ; The skip cache. Nearly every skip is one that has happened before (a loop
                                 ; skips the same false block on every pass), so the first scan from each
                                 ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
                                 ; by the start's low byte (times 4). Only skips that start in the program
                                 ; text are kept (the line buffer changes); the cache is emptied whenever a
                                 ; run starts (see start). A program that changes its own text while it
                                 ; runs is not looked after.
                    SKIP:     MOV   A,B   
                              CPI   PROG/256   
                              JC   sks   ; below the program text: no cache
                              MOV   A,C   
                              ADD   A   
                              ADD   A   
                              MOV   E,A   
                              MVI   D,CPAGE   ; DE -> the entry
                              LDAX   D   
                              CMP   C   
                              JNZ   sks   
                              INR   E   
                              LDAX   D   
                              CMP   B   
                              JNZ   sks   
                              INR   E   
                              LDAX   D   
                              MOV   C,A   
                              INR   E   
                              LDAX   D   
                              MOV   B,A   ; a hit: the IP is past the closer
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              SUI   ")"   ; 0 for ")", not 0 for "]"
                              RET      
                    SKS:      PUSH   B   ; where it starts: the cache's key (and the
0490                          ENDIF      ;   checked report's place)
0490                          IF   QK*CHECKED   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
0490                          ENDIF      
0490                          IF   QK   
                                 ; The scan. Most characters are nothing to it, and two range tests rule
                                 ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                              MVI   D,0   
                    SQ3:      INR   D   ; an opener: one deeper
                    SQ1:      LDAX   B   
                              INX   B   
                              CPI   5Eh   
                              JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CPI   5Bh   
                              JNC   sqb   ; [ \ ]
                              CPI   2Ah   
                              JNC   sq1   ; * to Z: nothing
                              CPI   28h   
                              JZ   sq3   ; (
                              JNC   sqc   ; )
                              CPI   22h   
                              JZ   sqq   ; a string
                              ORA   A   
                              JNZ   sq1   ; the rest below "(": nothing
0490                          ENDIF      
0490                          IF   QK*(1-CHECKED)   
                              JMP   endprog   ; NUL: the end of the program
0490                          ENDIF      
0490                          IF   QK*CHECKED   
                              DCX   B   ; NUL: the IP stays on it
                              MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SQ7:      MVI   A,"N"   ; N. The place is the opener
                              JMP   errp   ; (errp drops skip's return address)
0490                          ENDIF      
0490                          IF   QK   
                    SQQ:      CALL   skipstr   ; step over the string
                              JMP   sq1   
                    SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
                              JZ   sq1   ; "\" is nothing here
                              JC   sq3   ; [
                              MVI   A,2   ; ]
                              DB   0FEh   ; (CPI: steps over the XRA)
                    SQC:      XRA   A   ; )
                    SQ4:      DCR   D   
                              JNZ   sq1   
0490                          ENDIF      
0490                          IF   QK*CHECKED   
                              MOV   D,A   ; the closer at this level (as above): 2 here
                              XRA   E   ;   means the wrong closer
                              ANI   6   
                              CPI   2   
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              JNZ   sq8   
                              MOV   B,D   
                              MOV   C,E   
                              JMP   sq7   
                    SQ8:         
0490                          ENDIF      
0490                          IF   QK*(1-CHECKED)   
                              POP   D   ; where the skip started
0490                          ENDIF      
0490                          IF   QK   
                                 ; The closer at this level: remember the skip (if it started in the program
                                 ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
                              PUSH   H   
                              MOV   H,A   
                              MOV   A,D   
                              CPI   PROG/256   
                              JC   sq9   
                              MOV   A,E   
                              ADD   A   
                              ADD   A   
                              MOV   L,A   
                              MOV   A,H   
                              MVI   H,CPAGE   
                              MOV   M,E   
                              INR   L   
                              MOV   M,D   
                              INR   L   
                              MOV   M,C   
                              INR   L   
                              MOV   M,B   
                              POP   H   
                              RET      
                    SQ9:      MOV   A,H   
                              POP   H   
                              RET      
0490                          ENDIF      
0490                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0490                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0490                          IF   1-CHECKED   
0490   03           SS0:      INX   B   
0491   0A           SKIPSTR:   LDAX   B   
0492   03                     INX   B   
0493   FE 2F                  CPI   "/"   
0495   CA 90 04               JZ   ss0   
0498   FE 22                  CPI   22h   
049A   C2 91 04               JNZ   skipstr   
049D   C9                     RET      
049E                          ENDIF      
049E                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
049E                          ENDIF      
049E                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
049E                             ; and return its value in A with the carry set; otherwise leave the IP and
049E                             ; return with the carry clear.
049E   0A           HEXC:     LDAX   B   
049F   D6 30                  SUI   "0"   
04A1   FE 0A                  CPI   10   
04A3   DA AF 04               JC   hc1   
04A6   E6 DF                  ANI   0DFh   
04A8   D6 11                  SUI   11h   
04AA   FE 06                  CPI   6   
04AC   D0                     RNC      
04AD   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
04AF   03           HC1:      INX   B   
04B0   C9                     RET      
04B1                             ;  ---- Speed-ups (base builds) -------------------------------------------
04B1                             ;  The skip cache and "/" by a power of two are above. These are the
04B1                             ;  handlers' tails that the builds with room take, kept here, out of the
04B1                             ;  handlers' first two pages.
04B1                          IF   QK   
                                 ; "*" with an operand below 256: that one becomes the multiplier, a byte in
                                 ; A, and the loop stops as soon as its bits are used up (most
                                 ; multiplications have one, a count or a small constant). With both at 256
                                 ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
                                 ; shifted in above it says when), and its high byte goes on as a small one.
                                 ; DE = NOS, HL = TOS.
                    MULQ:     MOV   A,H   
                              ORA   A   
                              JZ   mq8   ; the multiplier is below 256
                              MOV   A,D   
                              ORA   A   
                              JNZ   mq16   
                              XCHG      ; the multiplicand is: it becomes the multiplier
                    MQ8:      MOV   A,L   
                              LXI   H,0   
                              ORA   A   ; (clears the carry)
                              JZ   mq9   
                    MQ1:      RAR      ; the next bit
                              JNC   mq2   
                              DAD   D   
                    MQ2:      XCHG      
                              DAD   H   ; multiplicand << 1
                              XCHG      
                              ORA   A   ; bits left? (and clears the carry)
                              JNZ   mq1   
                              ;*Macro unroll: mq9:    NEXTQ
                    MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ANXT&0FFh   
                              DS   CPM*(1-FAST),ANXT/256   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    MQ16:     PUSH   B   
                              MOV   B,H   ; the high byte, for later
                              MOV   A,L   
                              LXI   H,0   
                              STC      ; the marker
                              RAR      
                    MQ3:      JNC   mq4   
                              DAD   D   
                    MQ4:      XCHG      
                              DAD   H   
                              XCHG      
                              CPI   1   ; only the marker left: 8 rounds done (and
                              RAR      ;   the carry was clear for the shift)
                              JNZ   mq3   
                              MOV   A,B   
                              POP   B   
                              ORA   A   
                              JMP   mq1   ; the high byte, as a small multiplier
                                 ; A true ")" reads the block start where it is, on top of the return stack,
                                 ; instead of popping it and pushing it back; the break key is looked at as
                                 ; rpushd would.
                    CLOSEQ:   LHLD   RSP   
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXTQ
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ANXT&0FFh   
                              DS   CPM*(1-FAST),ANXT/256   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
04B1                          ENDIF      
04B1                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWER:    EQU   lowq   
                    LOWQ:     ADD   A   
                              MOV   E,A   
                              MVI   D,LETPAGE   ; DE -> the cell
                              LDAX   B   
                              CPI   "@"   
                              JZ   lwf   
                              CPI   "!"   
                              JZ   lws   
                              PUSH   H   
                              XCHG      ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWF:      INX   B   ; x@: TOS = the cell's value
                              PUSH   H   
                              XCHG      
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              XCHG      
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
                              XCHG      
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
04B1                          ENDIF      
04B1                             ; =============================================================================
04B1                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
04B1                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
04B1                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
04B1                             ;  the host's KEY and CONOUT routines themselves.
04B1                             ; 
04B1                             ;  A running program reads the keyboard only through getk and pollk, which
04B1                             ;  between them give the break key its rules:
04B1                             ;    - Ctrl-C stops the program;
04B1                             ;    - any other key that the break check reads is held in KEYBUF for the
04B1                             ;      next "?", and a newer one takes its place;
04B1                             ;    - "?" (getk) takes the held key first;
04B1                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
04B1                             ;      key like any other, but two of them within about 250 ms still stop it.
04B1                             ;  Both are called straight from a handler, never from a routine under one:
04B1                             ;  the checked build's report counts on finding one return address above the
04B1                             ;  data stack, and TOS in HL.
04B1                             ; =============================================================================
04B1                          IFN   CPM   
                    RAWK:     EQU   KEY   
04B1                          ENDIF      
04B1                             ; pollk: the break check (see rpushd).
04B1   CD 1B 05     POLLK:    CALL   rawk   
04B4   C8                     RZ      ; no key
04B5   32 7A 08               STA   KEYBUF   ; held for the next "?"
04B8   FE 03        PK1:      CPI   3   ; (getk joins here)
04BA   C0                     RNZ      
04BB                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
04BB                             ; the program has turned it off, wait about 250 ms for one more key: a
04BB                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
04BB                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
04BB   3A 7B 08     CTLC:     LDA   BRKOFF   
04BE   B7                     ORA   A   
04BF   CA 7F 01               JZ   brk   
04C2   D5                     PUSH   D   
04C3   11 E8 03               LXI   D,250*MSLOOP   
04C6   CD 1B 05     CT1:      CALL   rawk   
04C9   C2 D2 04               JNZ   ct2   
04CC   1B                     DCX   D   
04CD   7A                     MOV   A,D   
04CE   B3                     ORA   E   
04CF   C2 C6 04               JNZ   ct1   
04D2   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
04D3   FE 03                  CPI   3   
04D5   CA 7F 01               JZ   brk   
04D8   B7                     ORA   A   
04D9   CA DF 04               JZ   ct3   
04DC   32 7A 08               STA   KEYBUF   
04DF   3E 03        CT3:      MVI   A,3   
04E1   B7                     ORA   A   
04E2   C9                     RET      
04E3                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04E3   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
04E4   21 7A 08               LXI   H,KEYBUF   ;   the buffer
04E7   7E                     MOV   A,M   
04E8   36 00                  MVI   M,0   
04EA   E1                     POP   H   
04EB   B7                     ORA   A   
04EC   C0                     RNZ      
04ED   CD 1B 05               CALL   rawk   
04F0   C8                     RZ      
04F1   C3 B8 04               JMP   pk1   ; Ctrl-C? If not, that is the key
04F4                          IF   1-CHECKED   
04F4                BRK:      EQU   endprog   ; the unchecked build stops without a word;
04F4                          ENDIF      
04F4                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
04F4                          ENDIF      
04F4                          IF   CPM   
04F4                             ; (In a CP/M build the letters and digits are here, out of the way of the
04F4                             ; handlers, which must fit in the image's first two pages. The same code as
04F4                             ; in the generic build.)
04F4                             ; ---- the letters and digits --------------------------------------------------
04F4                             ; a-z: push the cell's address (the cell is the variable)
04F4                          ENDIF      
04F4                          IF   CPM*(1-SBASEU)   
04F4   E5           LOWER:    PUSH   H   
04F5   87                     ADD   A   
04F6   6F                     MOV   L,A   
04F7   26 08                  MVI   H,LETPAGE   
04F9                          ;*Macro unroll:  NEXT
04F9                          DS   (1-CPM)*(1-FAST),0F7h   
04F9   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
04FA   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
04FB   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
04FC                          ENDIF      
04FC                          IF   CPM   
04FC                             ; A-Z: call the word. The return address (the IP after the letter) goes on
04FC                             ; the return stack, and the IP becomes the address in the letter's cell.
04FC   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
04FD   87                     ADD   A   
04FE   6F                     MOV   L,A   
04FF   26 08                  MVI   H,LETPAGE   ; HL -> cell
0501   50                     MOV   D,B   
0502   59                     MOV   E,C   ; DE = the return address
0503   4E                     MOV   C,M   
0504   23                     INX   H   
0505   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
0506                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
0506                             ; go on. Every push of the return stack ends here: for a word call the cell
0506                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
0506                             ; the one that was used up.
0506                             ; 
0506                             ; The break key is looked at here, so at every word call and loop-back (and
0506                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
0506                             ; the keyboard can be slow (it is a BDOS call under CP/M).
0506   2A 34 08     RPUSHD:   LHLD   RSP   
0509   2B                     DCX   H   
050A   72                     MOV   M,D   
050B   2B                     DCX   H   
050C   73                     MOV   M,E   
050D   22 34 08               SHLD   RSP   
0510   21 36 08               LXI   H,BRKCNT   
0513   35                     DCR   M   
0514   E1                     POP   H   ; (keeps the flags)
0515   CC B1 04               CZ   pollk   
0518                          ;*Macro unroll:  NEXT
0518                          DS   (1-CPM)*(1-FAST),0F7h   
0518   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0519   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
051A   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
051B   3E FF        RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
051D                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
051D                             ; printing and could swallow a key that BDOS 6 then never sees.
051D   C5           PUTC:     PUSH   B   
051E   D5                     PUSH   D   
051F   E5                     PUSH   H   
0520   5F                     MOV   E,A   
0521   0E 06                  MVI   C,6   
0523   CD 05 00               CALL   BDOS   
0526   E1                     POP   H   
0527   D1                     POP   D   
0528   C1                     POP   B   
0529   B7                     ORA   A   ; (for getk)
052A   C9                     RET      
052B                          ENDIF      
052B                             ; =============================================================================
052B                             ;  Checked build: the checks and the error report
052B                             ; =============================================================================
052B                          IF   CHECKED   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
052B                          ENDIF      
052B                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
052B                          ENDIF      
052B                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
052B                          ENDIF      
052B                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address (errp drops
                              MVI   A,"H"   ;   the old top)
                              JMP   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
052B                          ENDIF      
052B                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
052B                          ENDIF      
052B                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
052B                          ENDIF      
052B                          IF   CHECKED   
                                 ; Two error entries for errors found inside a routine: the first hides the
                                 ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
                                 ; return address.
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   prs0   
                              CPI   7Fh   
                              JC   pesc   
                    PRS0:     ANI   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,10   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   D   
                              POP   H   
                              CALL   chkstk   
                              PUSH   H   
                              LHLD   PSAVE   
                              DB   11h   ; (LXI D hides e_quote's first two bytes)
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   D   
                              POP   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   "D:",22h   
                              LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
                              DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
                              ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
                              DS   1-CPM,0E7h   ;   first value and holds nothing)
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              MOV   A,H   
                              CALL   phal2   ; the depth
                              MVI   A,":"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                    PHAL2:    ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
052B                          ENDIF      
052B                             ; =============================================================================
052B                             ;  Startup
052B                             ; =============================================================================
052B                START:       
052B                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
052B                          ENDIF      
052B                          IF   QK   
                              LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
                              XRA   A   ;   start of 0000h matches no skip)
                    SKC1:     MOV   M,A   
                              INR   L   
                              JNZ   skc1   
052B                          ENDIF      
052B                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
052B                          ENDIF      
052B                          IF   CPM   
052B                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
052B   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
052E   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
0530   CD 05 00               CALL   BDOS   ;   and the program is empty)
0533   11 00 09               LXI   D,PROG   
0536   D5           LD1:      PUSH   D   
0537   0E 1A                  MVI   C,26   ; set the DMA address
0539   CD 05 00               CALL   BDOS   
053C   11 5C 00               LXI   D,005Ch   
053F   0E 14                  MVI   C,20   ; read the next 128 bytes
0541   CD 05 00               CALL   BDOS   
0544   E1                     POP   H   ; HL = the address this record went to
0545   B7                     ORA   A   
0546   C2 51 05               JNZ   ld2   
0549   11 80 00               LXI   D,128   
054C   19                     DAD   D   
054D   EB                     XCHG      
054E   C3 36 05               JMP   ld1   
0551   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0553   23                     INX   H   ; the heap starts after it
0554                          ENDIF      
0554                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
0554                          ENDIF      
0554   22 7C 08               SHLD   HEAP   
0557                          IF   CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              SHLD   NPEND   ;   release below it
0557                          ENDIF      
0557   21 E0 06               LXI   H,RSTOP   ; the return stack is empty
055A   22 34 08               SHLD   RSP   
055D                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
055D                          ENDIF      ;   checked build has cleared these)
055D                          IF   (1-CHECKED)*CPM   
055D   21 00 00               LXI   H,0   
0560                          ENDIF      
0560                          IF   1-CHECKED   
0560   22 7A 08               SHLD   KEYBUF   
0563                          ENDIF      
0563   01 00 09               LXI   B,PROG   ; the IP
0566                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0566                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0566   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0567   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0568   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0569                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
                                 ; 
                                 ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
                                 ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
                                 ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
                                 ;  the letters and digits have one entry each, which knows its cell or its
                                 ;  value already.
                                 ; =============================================================================
                    FTSTORE:   XCHG      ; !
                              JMP   h_store   
                    FTSTR:    XCHG      ; "
                              JMP   h_str   
                    FTNUM:    XCHG      ; #
                              JMP   h_num   
                    FTPRINT:   XCHG      ; $
                              JMP   h_print   
                    FTEMIT:   XCHG      ; '
                              JMP   h_emit   
                    FTCSTORE:   XCHG      ; .
                              JMP   h_cstore   
                    FTDIV:    XCHG      ; /
                              JMP   h_div   
                    FTKEY:    XCHG      ; ?
                              JMP   h_key   
                    FTDEF:    XCHG      ; [
                              JMP   h_def   
                    FTBREAK:   XCHG      ; \
                              JMP   h_break   
                    FTALLOC:   XCHG      ; _
                              JMP   h_alloc   
                    FTGRAVE:   XCHG      ; `
                              JMP   h_grave   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:   POP   H   ; +
                              DAD   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:   LDAX   B   ; -
                              SUI   "0"   
                              CPI   10   
                              JC   fs_neg   
                              POP   H   
                              MOV   A,L   
                              SUB   E   
                              MOV   E,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   D,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   XCHG      ; a digit next: a negative number
                              JMP   negnum   
                    FS_DUP:   PUSH   D   ; :
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:   POP   H   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:   POP   H   ; %
                              PUSH   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:   XCHG      ; @
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:   LDAX   D   ; ,
                              MOV   E,A   
                              MVI   D,0   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:    POP   H   ; < (HL = a, DE = b: the borrow of a - b, flipped if the signs differ)
                              MOV   A,L   
                              SUB   E   
                              MOV   A,H   
                              SBB   D   
                              SBB   A   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              RAL      
                              SBB   A   
                              XRA   L   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:    POP   H   ; > (b < a: the borrow of b - a)
                              MOV   A,E   
                              SUB   L   
                              MOV   A,D   
                              SBB   H   
                              SBB   A   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              RAL      
                              SBB   A   
                              XRA   L   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_EQ:    POP   H   ; =
                              MOV   A,L   
                              XRA   E   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              ORA   L   
                              SUI   1   
                              SBB   A   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:   POP   H   ; &
                              MOV   A,H   
                              ANA   D   
                              MOV   D,A   
                              MOV   A,L   
                              ANA   E   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
