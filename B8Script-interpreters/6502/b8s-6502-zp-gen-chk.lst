E4D0   70                     DB   (h_fetch-1) & 0FFh   ; @
E4D1   97                     DB   (h_def-1) & 0FFh   ; [
E4D2   18                     DB   (h_break-1) & 0FFh   ; \
E4D3   2C                     DB   (h_ret-1) & 0FFh   ; ]
E4D4   5A                     DB   (h_xor-1) & 0FFh   ; ^
E4D5   E9                     DB   (h_alloc-1) & 0FFh   ; _
