                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_MUL:      ; *
                              POP   HL   ; (the two the other way round: the same)
                              JP   mulq   
                    FS_OPEN:      ; (
                              LD   A,D   
                              OR   E   
                              POP   HL   
                              JR   Z,fs_op0   
                              PUSH   BC   ; the block start
                              JP   rpushn   
                    FS_OP0:   CALL   skip   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
