  1907                              <1> ; =============================================================================
  1908                              <1> ;  The inner loop: read one character and sort it by range.
  1909                              <1> ;
  1910                              <1> ;    00h          end of program
  1911                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1912                              <1> ;                 build stops on 80h-FFh: X)
  1913                              <1> ;    30h-39h      digit: read a whole number
  1914                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1915                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1916                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1917                              <1> ; =============================================================================
  1918                              <1> ; Digits: step back onto the first digit and read the whole number.
  1919 00000848 53                  <1> digit:  push    ebx
  1920 00000849 4E                  <1>         dec     esi
  1921                              <1>         CALLP   rdnum
   192                              <2>  %if P_%1
   193                              <2>  call [V(p_%1)]
   194                              <2>  %else
   195 0000084A E834FEFFFF          <2>  call %1
   196                              <2>  %endif
  1922 0000084F FFE5                <1>         jmp     ebp
  1923                              <1> 
  1924                              <1> ; a-z: push the cell's address (the cell is the variable).
  1925 00000851 53                  <1> lower:  push    ebx
  1926 00000852 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1927 00000859 FFE5                <1>         jmp     ebp
  1928                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1929                              <1> ; next in reach)
  1930 0000085B 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1931 0000085D 750C                <1>         jnz     next                    ; the rest are ignored
  1932 0000085F E9F7FCFFFF          <1>         jmp     endprog
  1933                              <1> %if CHECKED
  1934 00000864 B058                <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1935 00000866 E9A1FAFFFF          <1>         jmp     error
  1936                              <1> %endif
  1937                              <1> next:
  1938                              <1> %if CHECKED
  1939 0000086B E83FFAFFFF          <1>         call    chkstk                  ; both stacks, once per character
  1940                              <1> %endif
  1941 00000870 31C0                <1>         xor     eax,eax
  1942 00000872 AC                  <1>         lodsb
  1943 00000873 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1944 00000875 72E4                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1945 00000877 3C0F                <1>         cmp     al,0Fh
  1946 00000879 7228                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1947 0000087B 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1948 0000087D 3C0A                <1>         cmp     al,0Ah
  1949 0000087F 72C7                <1>         jb      digit                   ; 30h-39h
  1950 00000881 3C11                <1>         cmp     al,11h
  1951 00000883 721C                <1>         jb      p3a                     ; 3Ah-40h
  1952 00000885 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1953 00000887 3C1A                <1>         cmp     al,1Ah
  1954 00000889 0F824CF8FFFF        <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1955 0000088F 3C20                <1>         cmp     al,20h
  1956 00000891 720C                <1>         jb      p5b                     ; 5Bh-60h
  1957 00000893 3C3A                <1>         cmp     al,3Ah
  1958 00000895 72BA                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1959 00000897 3C3E                <1>         cmp     al,3Eh
  1960                              <1> %if CHECKED
  1961 00000899 74D0                <1>         je      next                    ; 7Fh, DEL: ignored
  1962 0000089B 73C7                <1>         jae     e_hi                    ; 80h-FFh: reserved
  1963                              <1> %else
  1964                              <1>         jae     next                    ; 7Fh-FFh: ignored
  1965                              <1> %endif
  1966 0000089D 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1967 0000089F 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1968 000008A1 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1969 000008A3 8A80[A2060000]      <1> punct:  mov     al,[ptab+eax]
  1970 000008A9 8D80[01010000]      <1>         lea     eax,[hbase+eax]
  1971 000008AF FFE0                <1>         jmp     eax
