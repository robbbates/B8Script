0366   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
0367   3D                     DEC   A   ;   r = L & (2^k - 1)
0368   A5                     AND   L   
0369   F5                     PUSH   AF   
036A   CB 3B        UQ2:      SRL   E   
036C   38 06                  JR   C,uq3   
036E   CB 3C                  SRL   H   
0370   CB 1D                  RR   L   
0372   18 F6                  JR   uq2   
0374   F1           UQ3:      POP   AF   
0375   5F                     LD   E,A   
0376   16 00                  LD   D,0   
0378   C9                     RET      
0379   7B           UQ1:      LD   A,E   
037A   B7                     OR   A   
037B   20 18                  JR   NZ,udv0   
037D   7A                     LD   A,D   
037E   3D                     DEC   A   
037F   A2                     AND   D   
0380   20 13                  JR   NZ,udv0   ; not a power of two
0382   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
0383   3D                     DEC   A   ;   r = HL & (2^k - 1)
0384   A4                     AND   H   
0385   5F                     LD   E,A   ; (the remainder's high byte,
0386   7D                     LD   A,L   ;   and its low byte)
0387   6C                     LD   L,H   
0388   26 00                  LD   H,0   
038A   CB 3A        UQ4:      SRL   D   
038C   38 04                  JR   C,uq5   
038E   CB 3D                  SRL   L   
0390   18 F8                  JR   uq4   
0392   53           UQ5:      LD   D,E   
0393   5F                     LD   E,A   
0394   C9                     RET      
0395                          ENDIF      
0395                          IF   1-FAST   
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    UDV1:     SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   ; carry is clear here: the remainder
                              JR   NC,udv2   ;   always fits in 16 bits
                              ADD   HL,DE   ; too much: put it back, and cancel the
                              DEC   C   ;   INC below
                    UDV2:     INC   C   ; a quotient bit
                              DJNZ   udv1   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
0395                          ENDIF      
