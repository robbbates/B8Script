  1222 0000052C 50                  <1>         push    eax
  1223 0000052D FF7514              <1>         push    dword [V(v_hin)]
  1224 00000530 FF55CD              <1>         call    [V(iat_ReadConsoleInputA)]
  1225 00000533 807D3A01            <1>         cmp     byte [V(v_rec)],1       ; KEY_EVENT
  1226 00000537 75D5                <1>         jne     .wk1
  1227 00000539 807D3E00            <1>         cmp     byte [V(v_rec)+4],0     ; bKeyDown
  1228 0000053D 74CF                <1>         je      .wk1
