0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-CPM*EDITOR*(1-CHECKED)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; HL', and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 B2 04               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 FC 04     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 B7 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 83 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 5D                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 5F                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 51                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 AF 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 25        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE 3B                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0072                          ENDIF      
0072                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0072                          ENDIF      
0072                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0072                          ENDIF      ;   these)
0072                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0072                          ENDIF      
0072                             ; In the unchecked generic editor build the table is here, in the first
0072                             ; page, which saves loading D twice. (The other builds have no room for it
0072                             ; here: theirs is further down.)
0072                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0072                          ENDIF      
0072                             ; =============================================================================
0072                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0072                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0072                             ;  is here too: it belongs to "`" and makes the page come out right.
0072                             ; =============================================================================
0072   D1           H_XOR:    POP   DE   
0073   7C                     LD   A,H   
0074   AA                     XOR   D   
0075   67                     LD   H,A   
0076   7D                     LD   A,L   
0077   AB                     XOR   E   
0078   6F                     LD   L,A   
0079   F7                     RST   30h   
007A   D1           H_OR:     POP   DE   
007B   7C                     LD   A,H   
007C   B2                     OR   D   
007D   67                     LD   H,A   
007E   7D                     LD   A,L   
007F   B3                     OR   E   
0080   6F                     LD   L,A   
0081   F7                     RST   30h   
0082   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0083   2B                     DEC   HL   
0084   F7                     RST   30h   
0085                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0085                             ; the same either way); TOS is the old pointer.
0085   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0089                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0089                          ENDIF      
0089   19                     ADD   HL,DE   ; the new top
008A                          IF   CHECKED   
008A   CD B9 03               CALL   chkhp   
008D                          ENDIF      
008D   22 7C 82               LD   (HEAP),HL   
0090   EB                     EX   DE,HL   
0091   F7                     RST   30h   
0092   D9           EXEC:     EXX      
0093   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
0096   D9                     EXX      
0097   CD 2B 00               CALL   jphl   
009A   D9                     EXX      
009B   2A 34 82               LD   HL,(RSAVE)   
009E   D9                     EXX      
009F   E1                     POP   HL   
00A0   F7                     RST   30h   
00A1                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00A1                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00A1                             ; Digits: step back onto the first digit and read the whole number.
00A1   E5           DIGIT:    PUSH   HL   
00A2   0B                     DEC   BC   
00A3   CD 95 02               CALL   rdnum   
00A6   F7                     RST   30h   
00A7                             ; a-z: push the cell's address (the cell is the variable)
00A7   E5           LOWER:    PUSH   HL   
00A8   87                     ADD   A,A   
00A9   6F                     LD   L,A   
00AA   26 82                  LD   H,LETPAGE   
00AC   F7                     RST   30h   
00AD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00AD                             ; the return stack, and the IP becomes the address in the letter's cell.
00AD   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00AE   EB                     EX   DE,HL   ; park TOS
00AF   87                     ADD   A,A   
00B0   6F                     LD   L,A   
00B1   26 82                  LD   H,LETPAGE   ; HL -> cell
00B3   4E                     LD   C,(HL)   
00B4   2C                     INC   L   
00B5   46                     LD   B,(HL)   ; IP = the word's body
00B6   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B7                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B7                             ; stack, then next. Everything that pushes the return stack ends here.
00B7                             ; 
00B7                             ; The break key is looked at here, so at every word call and loop-back (and
00B7                             ; block entry and "{"), but only one time in 256: B', which nothing else
00B7                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00B7                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00B7                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00B7                             ; both ways out.)
00B7   D9           RPUSHN:   EXX      
00B8   D1                     POP   DE   
00B9   2B                     DEC   HL   
00BA   72                     LD   (HL),D   
00BB   2B                     DEC   HL   
00BC   73                     LD   (HL),E   
00BD   05                     DEC   B   
00BE   D9                     EXX      
00BF   CC 45 03               CALL   Z,pollk   
00C2   F7                     RST   30h   
00C3                             ; ---- machine code: the grave -----------------------------------------------
00C3                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00C3                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00C3                             ; written and its address is left. An odd last digit is consumed and dropped.
00C3                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00C3                             ; code is entered by CALL with the data stack above the return address; it
00C3                             ; must keep BC, and on return the top cell becomes the new TOS.
00C3   CD F9 02     H_GRAVE:   CALL   hexc   
00C6   30 CA                  JR   NC,exec   
00C8   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00C9   CD F9 02               CALL   hexc   
00CC   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00CE   ED 6F                  RLD      ;   overwrites it
00D0   23                     INC   HL   ; ... and RLD shifts it up under the low one
00D1   CD F9 02               CALL   hexc   
00D4   38 F2                  JR   C,hx1   
00D6   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00D8   F7                     RST   30h   
00D9                             ; ---- where the two pages meet ----------------------------------------------
00D9                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00D9                             ; are in falling code order for this), and where exactly differs between the
00D9                             ; builds: NPG1 follows. Every handler below these four must start in the
00D9                             ; second page, and every one above in the first; chktab.py checks both.
00D9                             ; "]" returns: pop an address and jump to it.
00D9   CF           H_RET:    RST   08h   
00DA   42                     LD   B,D   
00DB   4B                     LD   C,E   
00DC   F7           BRK1:     RST   30h   
00DD                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00DD                             ; drops the block start, "]" returns. No closer at all ends the program.
00DD   7C           H_BREAK:   LD   A,H   
00DE   B5                     OR   L   
00DF   E1                     POP   HL   
00E0   28 FA                  JR   Z,brk1   
00E2   CD BC 02               CALL   skip   
00E5   B7                     OR   A   ; skip returns 0 for ")"
00E6   20 F1                  JR   NZ,h_ret   
00E8   CF           RDROP:    RST   08h   
00E9   F7                     RST   30h   
00EA                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00EA                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00EA                             ; the body"s address instead. Either way it then skips to the matching "]'.
00EA                             ; (The unchecked build takes anything that is not a letter as the space; the
00EA                             ; checked build stops on it.)
00EA   0A           H_DEF:    LD   A,(BC)   
00EB   03                     INC   BC   
00EC   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00EE   5F                     LD   E,A   ;   lands 64 bytes up
00EF   E6 DF                  AND   0DFh   ; fold case
00F1   FE 1A                  CP   26   
00F3   30 0B                  JR   NC,def2   ; not a letter
00F5   CB 23                  SLA   E   
00F7   16 82                  LD   D,LETPAGE   ; DE -> cell
00F9   79                     LD   A,C   
00FA   12                     LD   (DE),A   
00FB   1C                     INC   E   
00FC   78                     LD   A,B   
00FD   12                     LD   (DE),A   
00FE   18 09                  JR   skipnx   
0100                DEF2:        
0100                          IF   CHECKED   
0100   7B                     LD   A,E   
0101   FE DF                  CP   " "-"A"+256   
0103   C2 F5 03               JP   NZ,e_brack   ; anything but a letter or a space
0106                          ENDIF      
0106   E5                     PUSH   HL   ; an anonymous block: push its address
0107   60                     LD   H,B   
0108   69                     LD   L,C   
0109                SKIPNX:      
0109                          IF   CHECKED   
0109   0B                     DEC   BC   ; back onto the letter, so that skip finds its
010A                          ENDIF      ;   opener, the "[", just before where it starts
010A   CD BC 02     SKIPO:    CALL   skip   
010D   F7                     RST   30h   
010E   5E           H_FETCH:   LD   E,(HL)   ; "@"
010F   23                     INC   HL   
0110   56                     LD   D,(HL)   
0111   EB                     EX   DE,HL   
0112   F7                     RST   30h   
0113                             ; =============================================================================
0113                             ;  Handlers that must start in the image's second page.
0113                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0113                             ;  page.
0113                             ; =============================================================================
0113                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0113                             ; the matching ")".
0113   7C           H_OPEN:   LD   A,H   
0114   B5                     OR   L   
0115   E1                     POP   HL   
0116   28 F2                  JR   Z,skipo   
0118   C5                     PUSH   BC   ; the block starts at the IP
0119   18 9C                  JR   rpushn   
011B                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
011B                             ; drops it and carries on.
011B   7C           H_CLOSE:   LD   A,H   
011C   B5                     OR   L   
011D   E1                     POP   HL   
011E   28 C8                  JR   Z,rdrop   
0120   CF                     RST   08h   ; pop the block start ...
0121   42                     LD   B,D   
0122   4B                     LD   C,E   
0123   C5                     PUSH   BC   
0124   18 91                  JR   rpushn   ; ... and push it back
0126                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0126                             ; "-" has two jobs: directly before a digit it starts a negative number.
0126   0A           H_SUB:    LD   A,(BC)   
0127   D6 30                  SUB   "0"   
0129   FE 0A                  CP   10   
012B   38 04                  JR   C,negnum   
012D   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
012E   D1           H_ADD:    POP   DE   
012F   19                     ADD   HL,DE   
0130   F7                     RST   30h   
0131   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0132   CD 95 02               CALL   rdnum   
0135   E7                     RST   20h   
0136   F7                     RST   30h   
0137   D1           H_AND:    POP   DE   
0138   7C                     LD   A,H   
0139   A2                     AND   D   
013A   67                     LD   H,A   
013B   7D                     LD   A,L   
013C   A3                     AND   E   
013D   6F                     LD   L,A   
013E   F7                     RST   30h   
013F                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
013F                             ; cells first. Flipping both sign bits turns a signed compare into an
013F                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
013F                             ; carry into -1 or 0 with no branch.
013F   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0140   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0141   7C                     LD   A,H   
0142   EE 80                  XOR   80h   
0144   67                     LD   H,A   
0145   7A                     LD   A,D   
0146   EE 80                  XOR   80h   
0148   57                     LD   D,A   
0149   ED 52                  SBC   HL,DE   ; carry if HL < DE
014B   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
014D   F7                     RST   30h   
014E   D1           H_EQ:     POP   DE   
014F   B7                     OR   A   
0150   ED 52                  SBC   HL,DE   
0152   7C                     LD   A,H   
0153   B5                     OR   L   
0154   FE 01                  CP   1   ; carry only if a - b = 0
0156   18 F3                  JR   tf   
0158                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0158                             ; multiplier shifts up through A:C.
0158   D1           H_MUL:    POP   DE   ; DE = multiplicand
0159   C5                     PUSH   BC   
015A   7C                     LD   A,H   
015B   4D                     LD   C,L   ; A:C = multiplier
015C   21 00 00               LD   HL,0   
015F   06 10                  LD   B,16   
0161   29           MUL1:     ADD   HL,HL   
0162   CB 21                  SLA   C   
0164   17                     RLA      
0165   30 01                  JR   NC,mul2   
0167   19                     ADD   HL,DE   
0168   10 F7        MUL2:     DJNZ   mul1   
016A   C1                     POP   BC   
016B   F7                     RST   30h   
016C                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
016C                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
016C                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
016C                             ; stops on it.
016C                H_DIV:       
016C                          IF   CHECKED   
016C   7C                     LD   A,H   
016D   B5                     OR   L   
016E   CA F2 03               JP   Z,e_zero   
0171                          ENDIF      
0171   D1                     POP   DE   ; DE = a, HL = b
0172   D5                     PUSH   DE   ; a, for r's sign
0173   7A                     LD   A,D   
0174   AC                     XOR   H   
0175   F5                     PUSH   AF   ; S flag = sign of q
0176   CB 7C                  BIT   7,H   
0178   C4 20 00               CALL   NZ,neg16   ; HL = |b|
017B   EB                     EX   DE,HL   
017C   CB 7C                  BIT   7,H   
017E   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0181   CD 6D 02               CALL   udiv   ; HL = q, DE = r
0184   F1                     POP   AF   
0185   FC 20 00               CALL   M,neg16   ; q's sign
0188   EB                     EX   DE,HL   ; HL = r, DE = q
0189   F1                     POP   AF   ; A = a's high byte
018A   B7                     OR   A   
018B   FC 20 00               CALL   M,neg16   ; r's sign
018E   D5                     PUSH   DE   ; q under r
018F   F7                     RST   30h   
0190                             ; ---- stack and storage -----------------------------------------------------
0190   E5           H_DUP:    PUSH   HL   ; ":"
0191   F7                     RST   30h   
0192   E3           H_SWAP:   EX   (SP),HL   ; "%"
0193   F7                     RST   30h   
0194                             ; (The checked build tests the address before it takes the value off the
0194                             ; stack, so that an error report shows both.)
0194                H_CSTORE:      ; "." ( c addr -- )
0194                          IF   CHECKED   
0194   CD CE 03               CALL   chkst   
0197                          ENDIF      
0197   D1                     POP   DE   
0198   73                     LD   (HL),E   
0199   DF           H_DROP:   RST   18h   ; ";" is this one byte
019A                H_STORE:      ; "!" ( n addr -- )
019A                          IF   CHECKED   
019A   CD CE 03               CALL   chkst   
019D                          ENDIF      
019D   D1                     POP   DE   
019E   73                     LD   (HL),E   
019F   23                     INC   HL   
01A0   72                     LD   (HL),D   
01A1   DF                     RST   18h   
01A2                             ; ---- console ---------------------------------------------------------------
01A2                             ; 22h pushes the address of the text after it and skips the string.
01A2   E5           H_STR:    PUSH   HL   
01A3   60                     LD   H,B   
01A4   69                     LD   L,C   
01A5   CD AB 02               CALL   skipstr   
01A8                          IF   CHECKED   
01A8   B7                     OR   A   ; 0: the text ran out before the closing quote
01A9   CA EA 03               JP   Z,e_quote   
01AC                          ENDIF      
01AC   F7                     RST   30h   
01AD                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01AD                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01AD                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01AD                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01AD                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01AD                          ENDIF      
01AD                          IF   CHECKED   
01AD                             ; (The checked build has the loop as a routine, prstr, which the error
01AD                             ; report uses too. The address is kept meanwhile, for a report: it shows
01AD                             ; the stack as it was before the "$". /~ comes back to hp1.)
01AD   22 34 82     H_PRINT:   LD   (RSAVE),HL   
01B0   CD 06 02     HP1:      CALL   prstr   
01B3   DF                     RST   18h   
01B4                          ENDIF      
01B4   7D           H_EMIT:   LD   A,L   ; "'"
01B5   EF                     RST   28h   
01B6   DF           PR9:      RST   18h   
01B7                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B7   CD 0B 03     H_NUM:    CALL   psgn   
01BA   DF                     RST   18h   
01BB                             ; "?" ( n -- c ) or ( -n -- addr )
01BB                             ;   n > 0: wait about n ms for a key; 0 if none came
01BB                             ;   n = 0: wait for a key
01BB                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BB                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BB   CB 7C        H_KEY:    BIT   7,H   
01BD   20 19                  JR   NZ,line   
01BF   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C1   CD 73 03     KT2:      CALL   getk   
01C4   20 0E                  JR   NZ,kt3   
01C6   1D                     DEC   E   
01C7   20 F8                  JR   NZ,kt2   
01C9   7C                     LD   A,H   ; 0? never counts down: it waits
01CA   B5                     OR   L   
01CB   28 F2                  JR   Z,kt1   
01CD   2B                     DEC   HL   
01CE   7C                     LD   A,H   
01CF   B5                     OR   L   
01D0   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01D2   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01D3   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01D4   6F           KT3:      LD   L,A   
01D5   26 00                  LD   H,0   
01D7   F7                     RST   30h   
01D8                             ; Backspace takes the last character back (and is echoed as it
01D8                             ; is), CR ends (stored, not echoed), every other key is stored and
01D8                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01D8                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01D8                             ; is the place in the line: D holds the L of a full line.
01D8   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01DB   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01DC   9F                     SBC   A,A   
01DD   A5                     AND   L   ; (0 for a count that is too big)
01DE   2F                     CPL      
01DF   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E0                             ;   at most
01E0   21 80 82               LD   HL,LINEBUF   
01E3   CD 73 03     LN2:      CALL   getk   
01E6   28 FB                  JR   Z,ln2   
01E8   FE 0D                  CP   13   
01EA   28 16                  JR   Z,ln5   
01EC   FE 08                  CP   8   
01EE   28 0B                  JR   Z,ln4   
01F0   5F                     LD   E,A   
01F1   7D                     LD   A,L   
01F2   BA                     CP   D   
01F3   28 EE                  JR   Z,ln2   ; full
01F5   73                     LD   (HL),E   
01F6   2C                     INC   L   
01F7   7B                     LD   A,E   
01F8   EF           LN3:      RST   28h   
01F9   18 E8                  JR   ln2   
01FB   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
01FC   FA F8 01               JP   M,ln3   ;   unless the line was empty (L left the
01FF   2C                     INC   L   ;   upper half of the page)
0200   18 E1                  JR   ln2   
0202   77           LN5:      LD   (HL),A   ; the CR
0203   2E 80                  LD   L,LINEBUF & 0FFh   
0205   F7                     RST   30h   
0206                             ; =============================================================================
0206                             ;  More routines (no handler starts past this point)
0206                             ; =============================================================================
0206                          IF   CHECKED   
0206                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0206                             ; "$", and the texts of the report). A NUL first is an error: Q.
0206   7E           PRSTR:    LD   A,(HL)   
0207   23                     INC   HL   
0208   FE 22                  CP   22h   
020A   C8                     RET   Z   
020B   B7                     OR   A   
020C   CA E0 03               JP   Z,e_dollar   
020F   FE 2F                  CP   "/"   
0211   20 0C                  JR   NZ,prs1   
0213   7E                     LD   A,(HL)   
0214   23                     INC   HL   
0215   FE 60                  CP   60h   
0217   38 04                  JR   C,prs0   
0219   FE 7F                  CP   7Fh   
021B   38 11                  JR   C,pesc   
021D   E6 BF        PRS0:     AND   0BFh   
021F   EF           PRS1:     RST   28h   
0220   18 E4                  JR   prstr   
0222                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0222                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0222                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0222                             ; pnl: the same, on a new line.
0222   3E 0D        PNL:      LD   A,13   
0224   EF                     RST   28h   
0225   3E 0A                  LD   A,10   
0227   EF                     RST   28h   
0228   E3           PMSG:     EX   (SP),HL   
0229   CD 06 02               CALL   prstr   
022C   E3                     EX   (SP),HL   
022D   C9                     RET      
022E                          ENDIF      
022E                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
022E                             ; HL points past it. Each goes back into the loop that prints the string
022E                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
022E                             ;    /a-/z   print the variable, as "#" does
022E                             ;    /{      clear the screen, the cursor to the top left
022E                             ;    /}      clear from the cursor to the end of the line
022E                             ;    /|  /`  show the cursor, hide it
022E                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
022E   FE 7E        PESC:     CP   7Eh   
0230   28 1C                  JR   Z,pat   
0232   11 06 02               LD   DE,PRLOOP   ; the others return into the loop
0235   D5                     PUSH   DE   
0236   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0238   30 26                  JR   NC,pcon   
023A   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
023C   30 2B                  JR   NC,phide   
023E   87                     ADD   A,A   ; the variable's cell
023F   C6 40                  ADD   A,40h   
0241   E5                     PUSH   HL   
0242   6F                     LD   L,A   
0243   26 82                  LD   H,LETPAGE   
0245   7E                     LD   A,(HL)   
0246   2C                     INC   L   
0247   66                     LD   H,(HL)   
0248   6F                     LD   L,A   
0249   CD 0B 03               CALL   psgn   
024C   E1                     POP   HL   
024D   C9                     RET      
024E                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
024E                             ; the checked build "$" is the routine prstr: its own return address goes
024E                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
024E                             ; its two cells are there, and is s if not, before it prints anything.
024E                PAT:         
024E                          IF   CHECKED   
024E   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
024F   21 0A 7E               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
0252   39                     ADD   HL,SP   
0253   DA A8 03               JP   C,e_under   
0256   E1                     POP   HL   
0257                          ENDIF      
0257   D1                     POP   DE   ; DE = the column
0258   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0259                          IF   1-ANS   
0259   CD 15 FF               CALL   CONAT   
025C   E1                     POP   HL   
025D   C3 B0 01               JP   PRAGAIN   
0260                             ; With ANSI = 0 the machine's routines do the rest.
0260   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
0263   FE 02                  CP   2   
0265   CA 0F FF               JP   Z,CONEOL   ; /}
0268   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
0269   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
026A   C3 12 FF               JP   CONCUR   
026D                          ENDIF      
026D                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              LD   A,";"   
                              RST   28h   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              LD   A,"H"   
                              RST   28h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
026D                          ENDIF      
026D                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              RST   28h   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
026D                          ENDIF      
026D                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              LD   A,"2"   
                              RST   28h   
                              LD   A,"5"   
                              RST   28h   
                              LD   A,E   
                              RST   28h   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              RST   28h   
                              RET      
                    CSI:      PUSH   AF   
                              LD   A,27   
                              RST   28h   
                              LD   A,"["   
                              RST   28h   
                              POP   AF   
                              RET      
026D                          ENDIF      
026D                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
026D                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
026D                             ; the quotient bits arrive at the bottom of C.
026D                             ; Dividing by 2 is one shift (the spec wants that fast).
026D   7B           UDIV:     LD   A,E   
026E   EE 02                  XOR   2   
0270   B2                     OR   D   
0271   20 07                  JR   NZ,udv0   
0273   CB 3C                  SRL   H   
0275   CB 1D                  RR   L   ; the quotient
0277   8F                     ADC   A,A   
0278   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0279   C9                     RET      
027A   C5           UDV0:     PUSH   BC   
027B   7C                     LD   A,H   
027C   4D                     LD   C,L   
027D   21 00 00               LD   HL,0   
0280   06 10                  LD   B,16   
0282   CB 21        UDV1:     SLA   C   
0284   17                     RLA      
0285   ED 6A                  ADC   HL,HL   
0287   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0289   30 02                  JR   NC,udv2   ;   always fits in 16 bits
028B   19                     ADD   HL,DE   ; too much: put it back, and cancel the
028C   0D                     DEC   C   ;   INC below
028D   0C           UDV2:     INC   C   ; a quotient bit
028E   10 F2                  DJNZ   udv1   
0290   EB                     EX   DE,HL   ; DE = remainder
0291   67                     LD   H,A   
0292   69                     LD   L,C   ; HL = quotient
0293   C1                     POP   BC   
0294   C9                     RET      
0295                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0295                             ; non-digit. Values wrap at 16 bits, as the spec says.
0295   21 00 00     RDNUM:    LD   HL,0   
0298   0A           RDN1:     LD   A,(BC)   
0299   D6 30                  SUB   "0"   
029B   FE 0A                  CP   10   
029D   D0                     RET   NC   
029E   03                     INC   BC   
029F   54                     LD   D,H   
02A0   5D                     LD   E,L   
02A1   29                     ADD   HL,HL   
02A2   29                     ADD   HL,HL   
02A3   19                     ADD   HL,DE   
02A4   29                     ADD   HL,HL   ; HL * 10
02A5   5F                     LD   E,A   
02A6   16 00                  LD   D,0   
02A8   19                     ADD   HL,DE   
02A9   18 ED                  JR   rdn1   
02AB                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02AB                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02AB                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
02AB                          ENDIF      
02AB                          IF   CHECKED   
02AB                             ; The checked build never steps over a NUL: if the text runs out first it
02AB                             ; returns A = 0 with the IP on the NUL.
02AB   0A           SKIPSTR:   LD   A,(BC)   
02AC   B7                     OR   A   
02AD   C8                     RET   Z   
02AE   03                     INC   BC   
02AF   FE 22                  CP   22h   
02B1   C8                     RET   Z   
02B2   FE 2F                  CP   "/"   
02B4   20 F5                  JR   NZ,skipstr   
02B6   0A                     LD   A,(BC)   ; the escaped character
02B7   B7                     OR   A   
02B8   C8                     RET   Z   
02B9   03                     INC   BC   
02BA   18 EF                  JR   skipstr   
02BC                          ENDIF      
02BC                             ; skip: read past text to the closer at this level, and return A = 0 if it
02BC                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02BC                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02BC                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02BC                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02BC                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02BC                             ; 
02BC                             ; The checked build also looks at the character the skip was started by,
02BC                             ; which is always the one just before where it starts: "(" must end at ")",
02BC                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02BC                             ; quote counts as running into it. "\" takes either closer. IX keeps the
02BC                             ; place where the skip started, for the report.
02BC                SKIP:        
02BC                          IF   CHECKED   
02BC   C5                     PUSH   BC   
02BD   DD E1                  POP   IX   
02BF   0B                     DEC   BC   
02C0   0A                     LD   A,(BC)   
02C1   03                     INC   BC   
02C2   5F                     LD   E,A   ; E = the opener: ( [ or \
02C3                          ENDIF      
02C3   16 00                  LD   D,0   
02C5   14           SK3:      INC   D   ; an opener: one deeper
02C6   0A           SK1:      LD   A,(BC)   
02C7                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
02C7                          ENDIF      
02C7                          IF   CHECKED   
02C7   B7                     OR   A   
02C8   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
02CA   03                     INC   BC   
02CB                          ENDIF      
02CB   FE 22                  CP   22h   
02CD   CC AB 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02D0   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02D2   28 F1                  JR   Z,sk3   
02D4   3D                     DEC   A   ; ")"
02D5   28 08                  JR   Z,sk4   
02D7   D6 32                  SUB   "["-")"   
02D9   28 EA                  JR   Z,sk3   
02DB   FE 02                  CP   "]"-"["   
02DD   20 E7                  JR   NZ,sk1   
02DF   15           SK4:      DEC   D   
02E0                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
02E0                          ENDIF      
02E0                          IF   CHECKED   
02E0   20 E4                  JR   NZ,sk1   
02E2   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
02E3   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
02E4   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
02E6   FE 02                  CP   2   ;   closer, and only then
02E8   7A                     LD   A,D   
02E9   C0                     RET   NZ   
02EA   18 05                  JR   sk7   
02EC   CB 53        SK6:      BIT   2,E   ; the text ran out:
02EE   C2 FB 04               JP   NZ,SKEND   ;   "\" with no closer ends the program
02F1   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
02F3   C1                     POP   BC   
02F4   3E 4E                  LD   A,"N"   
02F6   C3 DD 03               JP   errp   ; (errp drops skip's return address)
02F9                          ENDIF      
02F9                             ; =============================================================================
02F9                             ;  Dispatch table: the low byte of each handler's address, in code order
02F9                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02F9                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02F9                             ; =============================================================================
02F9                             ; The handlers of the first NPG1 characters start in the image's second page.
02F9                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02F9                             ; differs between the builds, so the count is worked out here.
02F9                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02F9                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02F9                PGBRK:    EQU   (h_break-BASE)/256   
02F9                PGDEF:    EQU   (h_def-BASE)/256   
02F9                PGFET:    EQU   (h_fetch-BASE)/256   
02F9                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02F9                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02F9                          ENDIF      
02F9                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02F9                             ; and return its value in A with the carry set; otherwise leave the IP and
02F9                             ; return with the carry clear.
02F9   0A           HEXC:     LD   A,(BC)   
02FA   D6 30                  SUB   "0"   
02FC   FE 0A                  CP   10   
02FE   38 09                  JR   C,hc1   
0300   E6 DF                  AND   0DFh   
0302   D6 11                  SUB   11h   
0304   FE 06                  CP   6   
0306   D0                     RET   NC   
0307   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0309   03           HC1:      INC   BC   
030A   C9                     RET      
030B                             ; psgn: print HL as a signed number. Keeps BC.
030B   CB 7C        PSGN:     BIT   7,H   
030D   28 04                  JR   Z,pdec   
030F   3E 2D                  LD   A,"-"   
0311   EF                     RST   28h   
0312   E7                     RST   20h   
0313                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0313                             ; Keeps BC.
0313   11 0A 00     PDEC:     LD   DE,10   
0316   CD 6D 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0319   7B                     LD   A,E   
031A   F5                     PUSH   AF   
031B   7C                     LD   A,H   
031C   B5                     OR   L   
031D   C4 13 03               CALL   NZ,pdec   
0320   F1                     POP   AF   
0321   C6 30                  ADD   A,"0"   
0323   EF                     RST   28h   
0324   C9                     RET      
0325                             ; (The table goes here instead in the builds where, before psgn, it would
0325                             ; cross a page: PTLATE.)
0325                          IF   (1-TABP0)*PTLATE   
0325                PTAB:        
0325                          ;*Macro unroll:  PTABLE
0325   9A                     DB   h_store & 0FFh   
0326   A2                     DB   h_str & 0FFh   
0327   B7                     DB   h_num & 0FFh   
0328   AD                     DB   h_print & 0FFh   
0329   92                     DB   h_swap & 0FFh   
032A   37                     DB   h_and & 0FFh   
032B   B4                     DB   h_emit & 0FFh   
032C   13                     DB   h_open & 0FFh   
032D   1B                     DB   h_close & 0FFh   
032E   58                     DB   h_mul & 0FFh   
032F   2E                     DB   h_add & 0FFh   
0330   D3                     DB   h_cfetch & 0FFh   
0331   26                     DB   h_sub & 0FFh   
0332   94                     DB   h_cstore & 0FFh   
0333   6C                     DB   h_div & 0FFh   
0334   90                     DB   h_dup & 0FFh   
0335   99                     DB   h_drop & 0FFh   
0336   3F                     DB   h_lt & 0FFh   
0337   4E                     DB   h_eq & 0FFh   
0338   40                     DB   h_gt & 0FFh   
0339   BB                     DB   h_key & 0FFh   
033A   0E                     DB   h_fetch & 0FFh   
033B   EA                     DB   h_def & 0FFh   
033C   DD                     DB   h_break & 0FFh   
033D   D9                     DB   h_ret & 0FFh   
033E   72                     DB   h_xor & 0FFh   
033F   85                     DB   h_alloc & 0FFh   
0340   C3                     DB   h_grave & 0FFh   
0341   2C                     DB   h_tor & 0FFh   
0342   7A                     DB   h_or & 0FFh   
0343   1C                     DB   h_fromr & 0FFh   
0344   82                     DB   h_not & 0FFh   
0345                PTABEND:      
0345                          ENDIF      
0345                             ; =============================================================================
0345                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0345                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0345                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
0345                             ;  they are the host's KEY and CONOUT routines themselves.
0345                             ; 
0345                             ;  A running program reads the keyboard only through getk and pollk, which
0345                             ;  between them give the break key its rules:
0345                             ;    - Ctrl-C stops the program;
0345                             ;    - any other key that the break check reads is held in KEYBUF for the
0345                             ;      next "?", and a newer one takes its place;
0345                             ;    - "?" (getk) takes the held key first;
0345                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0345                             ;      key like any other, but two of them within about 250 ms still stop it.
0345                             ;  Both are called straight from a handler, never from a routine under one:
0345                             ;  the checked build's report counts on finding one return address above the
0345                             ;  data stack.
0345                             ; =============================================================================
0345                          IFN   CPM   
0345                RAWK:     EQU   KEY   
0345                          ENDIF      
0345                             ; pollk: the break check (see rpushn).
0345   CD 06 FF     POLLK:    CALL   rawk   
0348   C8                     RET   Z   ; no key
0349   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
034C   FE 03        PK1:      CP   3   ; (getk joins here)
034E   C0                     RET   NZ   
034F                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
034F                             ; the program has turned it off, wait about 250 ms for one more key: a
034F                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
034F                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
034F   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0352   B7                     OR   A   
0353   CA DB 03     CT0:      JP   Z,brk   
0356   D5                     PUSH   DE   
0357   11 10 27               LD   DE,250*MSLOOP   
035A   CD 06 FF     CT1:      CALL   rawk   
035D   20 05                  JR   NZ,ct2   
035F   1B                     DEC   DE   
0360   7A                     LD   A,D   
0361   B3                     OR   E   
0362   20 F6                  JR   NZ,ct1   
0364   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0365   FE 03                  CP   3   
0367   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0369   B7                     OR   A   
036A   28 03                  JR   Z,ct3   
036C   32 7A 82               LD   (KEYBUF),A   
036F   3E 03        CT3:      LD   A,3   
0371   B7                     OR   A   
0372   C9                     RET      
0373                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0373   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0374   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0377   7E                     LD   A,(HL)   
0378   36 00                  LD   (HL),0   
037A   E1                     POP   HL   
037B   B7                     OR   A   
037C   C0                     RET   NZ   
037D   CD 06 FF               CALL   rawk   
0380   C8                     RET   Z   
0381   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0383                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0383                          ENDIF      ;   (with the editor, both stacks are cleared);
0383                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0383                          ENDIF      
0383                          IF   CHECKED   
0383                BRK:      EQU   e_break   ;   the checked build reports B
0383                          ENDIF      
0383                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0383                          ENDIF      
0383                             ; =============================================================================
0383                             ;  Checked build: the checks and the error report
0383                             ; =============================================================================
0383                          IF   CHECKED   
0383                             ; chkstk: both stacks are checked once per character, not in every handler.
0383                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0383                             ; the constant carries if it is above (cells were popped that were never
0383                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0383                             ; a character late at most: the bytes above DSTOP and the guard band below
0383                             ; the page take what happens meanwhile. DE is free between characters.
0383   EB           CHKSTK:   EX   DE,HL   
0384   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0387   39                     ADD   HL,SP   
0388   EB                     EX   DE,HL   
0389   38 1D                  JR   C,e_under   
038B   14                     INC   D   
038C   20 16                  JR   NZ,e_over   
038E   D9                     EXX      ; the return stack: in its page (or it has
038F   7C                     LD   A,H   ;   overflowed), and not above its empty
0390   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
0392   7D                     LD   A,L   ;   page, in the guard band)
0393   D9                     EXX      
0394   20 0B                  JR   NZ,e_rover   
0396   FE E1                  CP   RSTOP&0FFh+1   
0398   D8                     RET   C   
0399   D9                     EXX      ; return stack underflow: it counts as empty
039A   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
039C   D9                     EXX      
039D   3E 72                  LD   A,"r"   
039F   18 3C                  JR   errp   
03A1   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
03A3   11                     DB   11h   ; (LD DE,nn hides the next entry)
03A4   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
03A6   18 35                  JR   errp   
03A8   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
03AB   3E 73                  LD   A,"s"   
03AD   18 48                  JR   error   
03AF                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
03AF                             ; was never defined still holds 0000h, and the byte there is a reserved one
03AF                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
03AF                             ; an undefined word. The call is undone, so the place is the call itself.
03AF   04           E_HI:     INC   B   
03B0   10 3D                  DJNZ   e_resv   ; (B is as it was, and is not 0)
03B2   CF                     RST   08h   
03B3   42                     LD   B,D   
03B4   4B                     LD   C,E   
03B5   3E 55                  LD   A,"U"   
03B7   18 3E                  JR   error   
03B9                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
03B9                             ; the count. Stop if the top is not below the limit page, or is below the
03B9                             ; program's end.
03B9                CHKHP:       
03B9                          ENDIF      
03B9                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03B9                          ENDIF      
03B9                          IF   CHECKED*(1-CPM)   
03B9                             ; (Here the program's space is under 32K, so a top that wrapped
03B9                             ; round always falls outside it.)
03B9   7C                     LD   A,H   
03BA   FE F0                  CP   HEAPLIM   
03BC   30 09                  JR   NC,e_heap   
03BE                          ENDIF      
03BE                          IF   CHECKED   
03BE   D5                     PUSH   DE   
03BF   EB                     EX   DE,HL   
03C0   2A 38 82               LD   HL,(NPEND)   
03C3   19                     ADD   HL,DE   ; carry: at or above the program's end
03C4   EB                     EX   DE,HL   
03C5   D1                     POP   DE   
03C6   D8                     RET   C   
03C7   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
03C8   ED 52                  SBC   HL,DE   
03CA   3E 48                  LD   A,"H"   
03CC   18 0F                  JR   errp   
03CE                             ; chkst: stop unless HL is in the program's own space: from the letter page
03CE                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
03CE                             ; whatever lies above the limit are safe. Memory above the heap top but
03CE                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
03CE                             ; It is the page of HL + 1 that is tested, so that one test serves both
03CE                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
03CE                             ; Keeps HL and BC. It runs on into its own error entry.
03CE   23           CHKST:    INC   HL   
03CF   7C                     LD   A,H   
03D0   2B                     DEC   HL   
03D1   FE 82                  CP   LETPAGE   
03D3   38 03                  JR   C,e_store   
03D5                          ENDIF      
03D5                          IF   CHECKED*(1-CPM)   
03D5   FE F0                  CP   HEAPLIM   
03D7   D8                     RET   C   
03D8                          ENDIF      
03D8                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03D8                          ENDIF      
03D8                          IF   CHECKED   
03D8                             ; Error entries. Each loads its letter and then hides the next entry inside
03D8                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
03D8   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
03DA   11                     DB   11h   
03DB   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
03DD                             ; errp: an error found inside a routine: drop its return address first.
03DD   D1           ERRP:     POP   DE   
03DE   18 17                  JR   error   
03E0                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
03E0                             ; back in TOS. prstr"s return address goes first. But if "$' had no
03E0                             ; address at all (the stack was empty), it is s, found now: chkstk, called
03E0                             ; one cell up, sees the stack past its empty place then.
03E0   D1           E_DOLLAR:   POP   DE   
03E1   E1                     POP   HL   
03E2   CD 83 03               CALL   chkstk   
03E5   E5                     PUSH   HL   
03E6   2A 34 82               LD   HL,(RSAVE)   
03E9   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
03EA   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
03EB   4D                     LD   C,L   ;   past the opening quote, which is the place
03EC   3E 51                  LD   A,"Q"   
03EE   11                     DB   11h   
03EF   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
03F1   11                     DB   11h   
03F2   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
03F4   11                     DB   11h   
03F5   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
03F7                             ; error: the report, then the end. A = the letter, BC = one past the place,
03F7                             ; HL = TOS, and both stacks as the report is to show them:
03F7                             ; 
03F7                             ;   Err X @ line,col
03F7                             ;   up to 16 characters of the text from the place
03F7                             ;   Stk n: the top 8 cells at most, bottom to top
03F7                             ;   Rtn n
03F7   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
03F8   5F                     LD   E,A   
03F9   CD 22 02               CALL   pnl   
03FC   45 72 72 20 22         DB   "Err ",22h   
0401   7B                     LD   A,E   
0402   EF                     RST   28h   
0403   CD 28 02               CALL   pmsg   
0406   20 40 20 22            DB   " @ ",22h   
040A   0B                     DEC   BC   ; BC = the place
040B                             ; The line and column. A place below the program is in the line
040B                             ; buffer: line 0. Otherwise count the LFs from the program's start;
040B                             ; DE = the line's number, HL = where it starts.
040B   21 80 82               LD   HL,LINEBUF   
040E   11 00 00               LD   DE,0   
0411   78                     LD   A,B   
0412   FE 83                  CP   PROG/256   
0414   38 14                  JR   C,er3   
0416   24                     INC   H   
0417   6B                     LD   L,E   ; HL = PROG
0418   13           ER1:      INC   DE   ; a new line starts at HL
0419   E5                     PUSH   HL   
041A   7D           ER2:      LD   A,L   
041B   91                     SUB   C   
041C   7C                     LD   A,H   
041D   98                     SBC   A,B   
041E   30 09                  JR   NC,er2x   ; reached the place
0420   7E                     LD   A,(HL)   
0421   23                     INC   HL   
0422   FE 0A                  CP   10   
0424   20 F4                  JR   NZ,er2   
0426   F1                     POP   AF   
0427   18 EF                  JR   er1   
0429   E1           ER2X:     POP   HL   
042A   C5           ER3:      PUSH   BC   
042B   E5                     PUSH   HL   
042C   EB                     EX   DE,HL   
042D   CD 13 03               CALL   pdec   ; the line
0430   3E 2C                  LD   A,","   
0432   EF                     RST   28h   
0433   D1                     POP   DE   
0434   E1                     POP   HL   
0435   E5                     PUSH   HL   
0436   B7                     OR   A   
0437   ED 52                  SBC   HL,DE   
0439   23                     INC   HL   
043A   CD 13 03               CALL   pdec   ; the column
043D   CD 22 02               CALL   pnl   
0440   22                     DB   22h   
0441   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
0442   06 10                  LD   B,16   ;   if the line or the program ends first
0444   7E           ER4:      LD   A,(HL)   
0445   23                     INC   HL   
0446   B7                     OR   A   
0447   28 0B                  JR   Z,er5   
0449   FE 0D                  CP   13   
044B   28 07                  JR   Z,er5   
044D   FE 0A                  CP   10   
044F   28 03                  JR   Z,er5   
0451                          ENDIF      
0451                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0451                          ENDIF      ;   screen on it. The editor's loader ends
0451                          IF   CHECKED   ;   the text at the first ^Z.)
0451   EF                     RST   28h   
0452   10 F0                  DJNZ   er4   
0454                ER5:         ; (on into the two stack lines)
0454                             ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
0454                             ;                       Rtn n
0454                             ; TOS is in memory with the rest (pushed) by now.
0454   CD 22 02               CALL   pnl   
0457   53 74 6B 20 22         DB   "Stk ",22h   
045C   21 06 7E               LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
045F   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
0460   E7                     RST   20h   ;   with the first value and holds nothing)
0461   CD A8 04               CALL   phalf   ; the depth
0464   3E 3A                  LD   A,":"   
0466   EF                     RST   28h   
0467   79                     LD   A,C   
0468   FE 09                  CP   9   
046A   38 0A                  JR   C,er6   
046C   CD 28 02               CALL   pmsg   
046F   20 2E 2E 2E 22         DB   " ...",22h   
0474   0E 08                  LD   C,8   
0476   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0478   69                     LD   L,C   
0479   29                     ADD   HL,HL   
047A   39                     ADD   HL,SP   ; HL -> just above the deepest of them
047B   0C                     INC   C   
047C   0D           ER7:      DEC   C   
047D   28 0F                  JR   Z,er8   
047F   2B                     DEC   HL   
0480   56                     LD   D,(HL)   
0481   2B                     DEC   HL   
0482   5E                     LD   E,(HL)   
0483   E5                     PUSH   HL   
0484   3E 20                  LD   A," "   
0486   EF                     RST   28h   
0487   EB                     EX   DE,HL   
0488   CD 0B 03               CALL   psgn   
048B   E1                     POP   HL   
048C   18 EE                  JR   er7   
048E   CD 22 02     ER8:      CALL   pnl   
0491   52 74 6E 20 22         DB   "Rtn ",22h   
0496   D9                     EXX      ; RSTOP - HL' is under 256 (the pointer is
0497   3E E0                  LD   A,RSTOP&0FFh   ;   at most one entry below its page), so
0499   95                     SUB   L   ;   the low bytes are enough
049A   D9                     EXX      
049B   6F                     LD   L,A   
049C   26 00                  LD   H,0   
049E   CD A8 04               CALL   phalf   
04A1   CD 22 02               CALL   pnl   
04A4   22                     DB   22h   
04A5                          ENDIF      
04A5                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
04A5                          ENDIF      
04A5                          IF   CHECKED*EDITOR   
04A5   C3 F2 04               JP   edit0   ; back to the editor, with both stacks cleared
04A8                          ENDIF      
04A8                          IF   CHECKED   
04A8                             ; phalf: print half of HL, and leave it in C.
04A8   CB 3C        PHALF:    SRL   H   
04AA   CB 1D                  RR   L   
04AC   E5                     PUSH   HL   
04AD   CD 13 03               CALL   pdec   
04B0   C1                     POP   BC   
04B1   C9                     RET      
04B2                          ENDIF      
04B2                             ; =============================================================================
04B2                             ;  The line editor (EDITOR = 1)
04B2                             ; 
04B2                             ;  The interpreter starts here, and a program that ends comes back here.
04B2                             ;  There is no prompt. It follows the spec's suggested standard for a line
04B2                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
04B2                             ; 
04B2                             ;    n text    put the text in as line n; the lines from n on move down. A
04B2                             ;              number past the end (or 0) adds the line at the end.
04B2                             ;    n         take line n out
04B2                             ;    anything else is run at once, as B8Script. (Start such a line with a
04B2                             ;    space if it would begin with a digit.)
04B2                             ; 
04B2                             ;  A command key ends the line too, and takes what was typed as its argument:
04B2                             ; 
04B2                             ;    ^G        run the program
04B2                             ;    n ^L      list from line n (no number: all of it). Any key holds the
04B2                             ;              list until another key is pressed; Ctrl-C ends it.
04B2                             ;    n ^E      put line n in the input line; Return puts it back, changed
04B2                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
04B2                             ;              last time). Generic: what is typed, or pasted, from now until
04B2                             ;              ^Z replaces the program; it is not echoed.
04B2                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
04B2                             ;              time). Generic: the text is printed, as it is.
04B2                             ;    ^N ^N     new: no program (the key twice in a row)
04B2                             ;    ^X        leave (to LEAVE)
04B2                             ; 
04B2                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
04B2                             ;  a character goes in at the cursor; Backspace and DEL take out the one
04B2                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
04B2                             ;  sent to the terminal, so any terminal will do.
04B2                             ; 
04B2                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
04B2                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
04B2                             ;  125 characters; the one character after a line number separates it from
04B2                             ;  the text and is not stored. The text is kept as it is typed, each line
04B2                             ;  ending in CR LF, at PROG.
04B2                             ; 
04B2                             ;  What lasts from one line to the next: the program, the words, the
04B2                             ;  variables and the data stack. An error or a break clears both stacks. The
04B2                             ;  return stack starts empty for every line.
04B2                             ; 
04B2                             ;  Things to know:
04B2                             ;    - Reset empties the program (generic builds).
04B2                             ;    - A word's address points into the program, so run the program again
04B2                             ;      after editing it.
04B2                             ;    - Nothing is printed between a program's output and what is typed next.
04B2                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
04B2                             ;      a line that calls -n? and carries on afterwards runs what was typed.
04B2                             ;      (The stored program never comes back to the line, so it may.)
04B2                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
04B2                             ;      read of the other builds.
04B2                             ; 
04B2                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
04B2                             ;  the last line left there, with TOS pushed like the rest.
04B2                             ; =============================================================================
04B2                          IF   EDGEN   
04B2                INIT:        ; reset (A = 0)
04B2                          ENDIF      
04B2                          IF   EDGEN*CHECKED   
04B2                             ; Clear the lower half of the letter page: every variable starts at 0, and
04B2                             ; every word cell holds 0000h, the address an undefined word is caught at
04B2                             ; (see e_hi).
04B2   21 00 82               LD   HL,LET   
04B5   77           INI1:     LD   (HL),A   
04B6   2C                     INC   L   
04B7   F2 B5 04               JP   P,ini1   ; +00h to +7Fh
04BA                          ENDIF      
04BA                          IF   EDGEN   
04BA   18 36                  JR   edit0   
04BC                          ENDIF      
04BC                          IF   EDITOR   
04BC                             ; ^F, right arrow: one to the right, by printing the character there
04BC   7D           RIGHT:    LD   A,L   
04BD   BB                     CP   E   
04BE   28 4F                  JR   Z,ed1   ; at the end
04C0   7E                     LD   A,(HL)   
04C1   2C                     INC   L   
04C2   18 2B                  JR   lf1   
04C4                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
04C4                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
04C4                             ; ends the sequence, and act on C (right) and D (left).
04C4   01 C8 00     ESC:      LD   BC,5*MSLOOP   
04C7   CD 06 FF     ES1:      CALL   rawk   
04CA   20 0A                  JR   NZ,es2   
04CC   0B                     DEC   BC   
04CD   78                     LD   A,B   
04CE   B1                     OR   C   
04CF   20 F6                  JR   NZ,es1   
04D1   CD 44 05               CALL   fin   ; no second key: the line is dropped
04D4   18 27                  JR   edit   
04D6   FE 5B        ES2:      CP   "["   
04D8   20 35                  JR   NZ,ed1   ; not a sequence known here
04DA   CD 9D 05     ES3:      CALL   ekey   
04DD   FE 40                  CP   40h   
04DF   38 F9                  JR   C,es3   ; (its parameters)
04E1   D6 43                  SUB   "C"   
04E3   28 D7                  JR   Z,right   
04E5   3D                     DEC   A   ; "D"?
04E6   20 27                  JR   NZ,ed1   ; no: on into left
04E8                             ; ^B, left arrow: the cursor goes one to the left
04E8   7D           LEFT:     LD   A,L   
04E9   87                     ADD   A,A   
04EA   28 23                  JR   Z,ed1   ; (L = 80h: at the start)
04EC   2D                     DEC   L   
04ED   3E 08                  LD   A,8   
04EF   EF           LF1:      RST   28h   
04F0   18 1D                  JR   ed1   
04F2                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
04F2                             ;   is shown, in case the program had hidden it and could not show it again.
04F2                             ; skend: a program that ended inside skip: its return address goes.
04F2                             ; edend: a program that ended: TOS joins the rest of the data stack.
04F2   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
04F5                          ENDIF      
04F5                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
04F5                          ENDIF      
04F5                          IF   EDITOR*(1-ANS)   
04F5   3E 01                  LD   A,1   
04F7   CD 12 FF               CALL   CONCUR   ; show the cursor
04FA                          ENDIF      
04FA                          IF   EDITOR   
04FA   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
04FB   D1           SKEND:    POP   DE   
04FC   E5           EDEND:    PUSH   HL   
04FD                             ; edit: start a new input line.
04FD   D9           EDIT:     EXX      
04FE   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
0501   D9                     EXX      
0502   21 00 00               LD   HL,0   
0505   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0508   22 3A 82               LD   (EDLN),HL   ; no line is being edited
050B   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
050E   5D                     LD   E,L   ;   E = the end of the line (its low byte)
050F   CD 9D 05     ED1:      CALL   ekey   
0512   FE 7F                  CP   7Fh   
0514   28 40                  JR   Z,bsp   ; DEL
0516   FE 20                  CP   " "   
0518   30 56                  JR   NC,insc   
051A   FE 09                  CP   9   
051C   28 52                  JR   Z,insc   ; Tab is text
051E   FE 08                  CP   8   
0520   28 34                  JR   Z,bsp   
0522   FE 02                  CP   2   
0524   28 C2                  JR   Z,left   ; ^B
0526   FE 06                  CP   6   
0528   28 92                  JR   Z,right   ; ^F
052A   FE 1B                  CP   1Bh   
052C   28 96                  JR   Z,esc   
052E   E5                     PUSH   HL   ; a command key? Look it up
052F   21 A3 05               LD   HL,cmds   
0532   06 08                  LD   B,NCMD   
0534   BE           ED2:      CP   (HL)   
0535   23                     INC   HL   
0536   28 07                  JR   Z,ed3   
0538   23                     INC   HL   
0539   23                     INC   HL   
053A   10 F8                  DJNZ   ed2   
053C   E1                     POP   HL   
053D   18 D0                  JR   ed1   ; no: the key is ignored
053F   7E           ED3:      LD   A,(HL)   
0540   23                     INC   HL   
0541   66                     LD   H,(HL)   
0542   6F                     LD   L,A   
0543   E3                     EX   (SP),HL   ; the command's address: fin returns to it
0544                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
0544                             ; terminal. Leaves BC -> the line and HL -> the NUL.
0544   26 82        FIN:      LD   H,LETPAGE   
0546   6B                     LD   L,E   
0547   36 0D                  LD   (HL),13   
0549   2C                     INC   L   
054A   36 0A                  LD   (HL),10   
054C   2D                     DEC   L   
054D   CD A9 06               CALL   prl   ; (prints the CR LF)
0550   36 00                  LD   (HL),0   
0552   01 80 82               LD   BC,LINEBUF   
0555   C9                     RET      
0556                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
0556                             ; left, the rest of the line moves down over it, and the last place (now a
0556                             ; space) is printed over along with the rest.
0556   7D           BSP:      LD   A,L   
0557   87                     ADD   A,A   
0558   28 B5                  JR   Z,ed1   ; at the start
055A   2D                     DEC   L   
055B   3E 08                  LD   A,8   
055D   EF                     RST   28h   
055E   E5                     PUSH   HL   
055F   2C           BS1:      INC   L   
0560   7E                     LD   A,(HL)   
0561   2D                     DEC   L   
0562   77                     LD   (HL),A   
0563   2C                     INC   L   
0564   7D                     LD   A,L   
0565   BB                     CP   E   
0566   20 F7                  JR   NZ,bs1   
0568   2D                     DEC   L   
0569   36 20                  LD   (HL)," "   
056B   E1                     POP   HL   
056C   53                     LD   D,E   
056D   1D                     DEC   E   
056E   18 15                  JR   ic2   
0570                             ; A character goes in at the cursor: it ripples up through the rest of the
0570                             ; line, the cursor moves on, and the rest is printed again.
0570   47           INSC:     LD   B,A   
0571   7B                     LD   A,E   
0572   FE FD                  CP   0FDh   
0574   28 99                  JR   Z,ed1   ; the line is full: 125 characters
0576   78                     LD   A,B   
0577   EF                     RST   28h   
0578   E5                     PUSH   HL   
0579   7E           IC1:      LD   A,(HL)   
057A   70                     LD   (HL),B   
057B   47                     LD   B,A   
057C   7D                     LD   A,L   
057D   2C                     INC   L   
057E   BB                     CP   E   
057F   20 F8                  JR   NZ,ic1   
0581   E1                     POP   HL   
0582   2C                     INC   L   
0583   1C                     INC   E   
0584   53                     LD   D,E   
0585   CD 8A 05     IC2:      CALL   tail   
0588   18 85                  JR   ed1   
058A                             ; tail: print the line from the cursor to D (a low byte), and bring the
058A                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
058A   4D           TAIL:     LD   C,L   
058B   7D           TA1:      LD   A,L   
058C   BA                     CP   D   
058D   28 05                  JR   Z,ta2   
058F   7E                     LD   A,(HL)   
0590   EF                     RST   28h   
0591   2C                     INC   L   
0592   18 F7                  JR   ta1   
0594   7D           TA2:      LD   A,L   
0595   B9                     CP   C   
0596   C8                     RET   Z   
0597   3E 08                  LD   A,8   
0599   EF                     RST   28h   
059A   2D                     DEC   L   
059B   18 F7                  JR   ta2   
059D                             ; ekey: wait for a key
059D   CD 06 FF     EKEY:     CALL   rawk   
05A0   28 FB                  JR   Z,ekey   
05A2   C9                     RET      
05A3                             ; The command keys, and where each goes (after fin).
05A3   0D           CMDS:     DB   13   
05A4   F3 05                  DW   cret   
05A6   07                     DB   7   ; ^G
05A7   3B 06                  DW   crun   
05A9   0C                     DB   12   ; ^L
05AA   51 06                  DW   clist   
05AC   05                     DB   5   ; ^E
05AD   C9 05                  DW   cedln   
05AF   12                     DB   18   ; ^R
05B0   B5 06                  DW   cread   
05B2   17                     DB   23   ; ^W
05B3   E2 06                  DW   cwrite   
05B5   0E                     DB   14   ; ^N
05B6   BB 05                  DW   cnew   
05B8   18                     DB   24   ; ^X
05B9   09 FF                  DW   LEAVE   
05BB                NCMD:     EQU   8   
05BB                             ; ^N ^N: no program, if the next key is ^N too
05BB   CD 9D 05     CNEW:     CALL   ekey   
05BE   FE 0E                  CP   14   
05C0   20 04                  JR   NZ,ged0   
05C2   AF                     XOR   A   
05C3   32 00 83               LD   (PROG),A   
05C6   C3 FD 04     GED0:     JP   edit   
05C9                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
05C9                             ; line it was: Return puts the text back in its place.
05C9   CD 95 02     CEDLN:    CALL   rdnum   
05CC   E5                     PUSH   HL   
05CD   CD 91 06               CALL   find   ; HL -> the line, or the NUL if there is none
05D0   D1                     POP   DE   
05D1   7E                     LD   A,(HL)   
05D2   B7                     OR   A   
05D3   28 F1                  JR   Z,ged0   
05D5   ED 53 3A 82            LD   (EDLN),DE   
05D9   11 80 82               LD   DE,LINEBUF   
05DC   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
05DD   FE 0D                  CP   13   
05DF   28 0D                  JR   Z,ce2   
05E1   FE 0A                  CP   10   
05E3   28 09                  JR   Z,ce2   
05E5   12                     LD   (DE),A   
05E6   EF                     RST   28h   
05E7   23                     INC   HL   
05E8   1C                     INC   E   
05E9   7B                     LD   A,E   
05EA   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
05EC   20 EE                  JR   NZ,ce1   
05EE   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
05EF   5D                     LD   E,L   
05F0   C3 0F 05               JP   ed1   
05F3                             ; Return. If ^E put a line here, the text goes back in its place. If not:
05F3                             ; a number and text is a line to put in, a number alone a line to take out,
05F3                             ; and anything else is run where it is.
05F3   E5           CRET:     PUSH   HL   ; the end of what was typed
05F4   2A 3A 82               LD   HL,(EDLN)   
05F7   7C                     LD   A,H   
05F8   B5                     OR   L   
05F9   28 07                  JR   Z,cr1   
05FB   E5                     PUSH   HL   
05FC   CD 81 06               CALL   delln   
05FF   E1                     POP   HL   
0600   18 13                  JR   ins   
0602   CD 95 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0605   79                     LD   A,C   ; C is still 80h if there was no number:
0606   87                     ADD   A,A   ;   only then is twice it 0
0607   28 36                  JR   Z,st0p   ; no number: run the line
0609   0A                     LD   A,(BC)   
060A   FE 0D                  CP   13   
060C   20 06                  JR   NZ,cr2   
060E   D1                     POP   DE   ; the number alone: take that line out
060F   CD 81 06               CALL   delln   
0612   18 24                  JR   gedit   
0614   03           CR2:      INC   BC   ; step over the one character after the number
0615                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0615                             ; CR and LF included, and copy it in.
0615   CD 91 06     INS:      CALL   find   ; HL -> where it goes
0618   D1                     POP   DE   ; the end of what was typed
0619   7B                     LD   A,E   
061A   91                     SUB   C   ; A = the length of the text, with its CR LF
061B   C5                     PUSH   BC   ; the text
061C   4F                     LD   C,A   
061D   06 00                  LD   B,0   
061F   C5                     PUSH   BC   ; its length
0620   54                     LD   D,H   
0621   5D                     LD   E,L   ; DE = where it goes
0622   AF                     XOR   A   
0623   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0624   ED B1                  CPIR      ; HL -> one past the program's NUL
0626   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0628   44                     LD   B,H   
0629   4D                     LD   C,L   
062A   19                     ADD   HL,DE   
062B   2B                     DEC   HL   ; HL -> the NUL
062C   EB                     EX   DE,HL   
062D   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
062E   E5                     PUSH   HL   
062F   19                     ADD   HL,DE   ; the NUL's new place
0630   EB                     EX   DE,HL   
0631   ED B8                  LDDR      ; move the rest of the program up
0633   C1                     POP   BC   ; the length
0634   D1                     POP   DE   ; where it goes
0635   E1                     POP   HL   ; the text
0636   ED B0                  LDIR      
0638   C3 FD 04     GEDIT:    JP   edit   
063B                             ; ^G: run the program. st0p: run the typed line (BC -> it).
063B   01 00 83     CRUN:     LD   BC,PROG   
063E   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
063F   E1           ST0P:     POP   HL   ; (the end of what was typed)
0640                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0640   21 00 83     ST0:      LD   HL,PROG   
0643   AF                     XOR   A   
0644   BE           ST1:      CP   (HL)   
0645   23                     INC   HL   
0646   20 FC                  JR   NZ,st1   
0648   22 7C 82               LD   (HEAP),HL   
064B                          ENDIF      
064B                          IF   EDITOR*CHECKED   
064B   E7                     RST   20h   ; minus the heap"s first address: "_' may not
064C   22 38 82               LD   (NPEND),HL   ;   release below it
064F                          ENDIF      
064F                          IF   EDITOR   
064F   E1                     POP   HL   ; TOS: the data stack is as the last line left it
0650   F7                     RST   30h   ; (its return address is thrown away)
0651                             ; ^L: list from line n. DE = the number of the line at HL.
0651   CD 95 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
0654   7C                     LD   A,H   
0655   B5                     OR   L   
0656   20 01                  JR   NZ,li0   
0658   2C                     INC   L   ;   then from line 1
0659   E5           LI0:      PUSH   HL   
065A   CD 91 06               CALL   find   
065D   D1                     POP   DE   
065E   7E           LI1:      LD   A,(HL)   
065F   B7                     OR   A   
0660   28 D6                  JR   Z,gedit   ; the end of the text
0662   CD 06 FF               CALL   rawk   
0665   28 09                  JR   Z,li3   ; no key: carry on
0667   FE 03                  CP   3   
0669   C4 9D 05               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
066C   FE 03                  CP   3   
066E   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
0670   E5           LI3:      PUSH   HL   
0671   D5                     PUSH   DE   
0672   EB                     EX   DE,HL   
0673   CD 13 03               CALL   pdec   ; the line's number,
0676   3E 20                  LD   A," "   
0678   EF                     RST   28h   ;   a space,
0679   D1                     POP   DE   
067A   E1                     POP   HL   
067B   13                     INC   DE   
067C   CD A9 06               CALL   prl   ;   and the line
067F   18 DD                  JR   li1   
0681                             ; delln: take line n (in HL) out: copy everything after it down over it.
0681   CD 91 06     DELLN:    CALL   find   
0684   54                     LD   D,H   
0685   5D                     LD   E,L   
0686   CD 9F 06               CALL   nxl   ; HL -> the next line
0689   7E           DE1:      LD   A,(HL)   
068A   12                     LD   (DE),A   
068B   23                     INC   HL   
068C   13                     INC   DE   
068D   B7                     OR   A   
068E   20 F9                  JR   NZ,de1   
0690   C9                     RET      
0691                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0691                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0691   EB           FIND:     EX   DE,HL   
0692   21 00 83               LD   HL,PROG   
0695   1B           FI1:      DEC   DE   
0696   7A                     LD   A,D   
0697   B3                     OR   E   
0698   C8                     RET   Z   
0699   CD 9F 06               CALL   nxl   
069C   20 F7                  JR   NZ,fi1   
069E   C9                     RET      
069F                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
069F                             ; stop at the NUL that ends the text (and return zero).
069F   7E           NXL:      LD   A,(HL)   
06A0   B7                     OR   A   
06A1   C8                     RET   Z   
06A2   23                     INC   HL   
06A3   FE 0A                  CP   10   
06A5   20 F8                  JR   NZ,nxl   
06A7   B7                     OR   A   
06A8   C9                     RET      
06A9                             ; prl: print the line at HL, to its LF; HL -> just past it.
06A9   7E           PRL:      LD   A,(HL)   
06AA   EF                     RST   28h   
06AB   7E                     LD   A,(HL)   
06AC   23                     INC   HL   
06AD   FE 0A                  CP   10   
06AF   20 F8                  JR   NZ,prl   
06B1   C9                     RET      
06B2                          ENDIF      
06B2                          IF   EDGEN   
06B2   C3 FD 04     GED1:     JP   edit   
06B5                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
06B5                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
06B5                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
06B5                             ; line with no end is given one. Nothing is echoed, and there is no check
06B5                             ; for running out of memory.
06B5   21 FF 82     CREAD:    LD   HL,PROG-1   
06B8   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
06BA   23                     INC   HL   ;   the line buffer's last, and spare)
06BB   CD 9D 05     RD1:      CALL   ekey   
06BE   4F                     LD   C,A   
06BF   FE 1A                  CP   1Ah   
06C1   20 02                  JR   NZ,rd2   
06C3   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
06C5   FE 0A        RD2:      CP   10   
06C7   20 07                  JR   NZ,rd3   
06C9   2B                     DEC   HL   
06CA   BE                     CP   (HL)   
06CB   23                     INC   HL   
06CC   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
06CE   3E 0D                  LD   A,13   ; anywhere else it ends the line
06D0   77           RD3:      LD   (HL),A   
06D1   23                     INC   HL   
06D2   FE 0D                  CP   13   
06D4   20 03                  JR   NZ,rd4   
06D6   36 0A                  LD   (HL),10   ; after a CR goes a LF
06D8   23                     INC   HL   
06D9   79           RD4:      LD   A,C   
06DA   FE 1A                  CP   1Ah   
06DC   20 DD                  JR   NZ,rd1   
06DE   36 00                  LD   (HL),0   
06E0   18 D0                  JR   ged1   
06E2                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
06E2   21 00 83     CWRITE:   LD   HL,PROG   
06E5   7E           CW1:      LD   A,(HL)   
06E6   B7                     OR   A   
06E7   28 C9                  JR   Z,ged1   
06E9   EF                     RST   28h   
06EA   23                     INC   HL   
06EB   18 F8                  JR   cw1   
06ED                          ENDIF      
06ED                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
06ED                          ENDIF      
06ED                             ; =============================================================================
06ED                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
06ED                          ENDIF      
06ED                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
06ED                          ENDIF      
06ED                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
06ED                          ENDIF      
06ED                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
06ED                          ENDIF      
06ED                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
06ED                          ENDIF      
06ED                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
06ED                          ENDIF      
06ED                IMGEND:      


