  2283                              <1> ; DENT c, after: the entry for character c in dtab (after 0) or dtabd (1)
  2284                              <1> %macro  DENT 2
  2285                              <1>  %assign c %1
  2286                              <1>  %if c >= 30h && c <= 39h
  2287                              <1>   %if %2
  2288                              <1>         dd      fdm
  2289                              <1>   %else
  2290                              <1>    %assign d c-30h
  2291                              <1>         dd      fd%[d]
  2292                              <1>   %endif
  2293                              <1>  %elif %2 && CHECKED
  2294                              <1>         dd      fdx
  2295                              <1>  %elif c == 0
  2296                              <1>         dd      endprog                 ; NUL: the end of the program
  2297                              <1>  %elif c < 21h || c == 7Fh
  2298                              <1>         dd      fign
  2299                              <1>  %elif c >= 80h
  2300                              <1>   %if CHECKED
  2301                              <1>         dd      e_hi                    ; reserved (X)
  2302                              <1>   %else
  2303                              <1>         dd      fign
  2304                              <1>   %endif
  2305                              <1>  %elif c >= 41h && c <= 5Ah
  2306                              <1>   %assign d c-41h
  2307                              <1>         dd      fu%[d]
  2308                              <1>  %elif c >= 61h && c <= 7Ah
  2309                              <1>   %assign d c-61h
  2310                              <1>         dd      fv%[d]
  2311                              <1>  %else
  2312                              <1>         dd      FP_%[c]
  2313                              <1>  %endif
  2314                              <1> %endmacro
  2315                              <1>         align   4, db 0
  2316                              <1> dtab:
  2317                              <1> %assign j 0
  2318                              <1> %rep 256
  2319                              <1>         DENT    j, 0
  2320                              <1> %assign j j+1
  2321                              <1> %endrep
  2319                              <2>  DENT j, 0
  2285                              <3>  %assign c %1
  2286                              <3>  %if c >= 30h && c <= 39h
  2287                              <3>  %if %2
  2288                              <3>  dd fdm
  2289                              <3>  %else
  2290                              <3>  %assign d c-30h
  2291                              <3>  dd fd%[d]
  2292                              <3>  %endif
