0781   1F                     RAR      
0782   67                     MOV   H,A   
0783   7D                     MOV   A,L   
0784   1F                     RAR      
0785   6F                     MOV   L,A   
0786   E5                     PUSH   H   
0787   CD E4 03               CALL   pdec   
078A   C1                     POP   B   
078B   C9                     RET      
