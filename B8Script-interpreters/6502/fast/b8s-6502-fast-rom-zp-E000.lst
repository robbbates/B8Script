E7C9   48                     PHA      
E7CA   B4 FE                  LDY   0FEh,X   ; the entry, if the skip is kept
E7CC   C0 01                  CPY   #1   
E7CE   F0 0F                  BEQ   sq9   
E7D0   A5 00                  LDA   IP   
E7D2   38                     SEC      
E7D3   E9 01                  SBC   #1   
E7D5   99 02 02               STA   CPAGE*256+2,Y   ; the closer's address
E7D8   A5 01                  LDA   IP+1   
E7DA   E9 00                  SBC   #0   
E7DC   99 03 02               STA   CPAGE*256+3,Y   
E7DF   68           SQ9:      PLA      
E7E0   60                     RTS      ; the closer at this level
E7E1                             ; sqip: IP = IP + Y. Keeps A.
E7E1   48           SQIP:     PHA      
E7E2   98                     TYA      
E7E3   18                     CLC      
E7E4   65 00                  ADC   IP   
E7E6   85 00                  STA   IP   
