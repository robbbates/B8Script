0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as
0000                             ;                 line and column, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC and HL'; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 09               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 5C 07               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 F1 04     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 9D 04               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 B2 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0134                          ENDIF      
0134   0A                     LD   A,(BC)   
0135   03                     INC   BC   
0136   D6 21                  SUB   21h   ; A = c - 21h
0138   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013A   FE 0F                  CP   0Fh   
013C   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
013E   D6 0F                  SUB   0Fh   ; A = c - 30h
0140   FE 0A                  CP   0Ah   
0142   38 58                  JR   C,digit   ; 30h-39h
0144   FE 11                  CP   11h   
0146   38 16                  JR   C,p3a   ; 3Ah-40h
0148   D6 11                  SUB   11h   ; A = c - 41h
014A   FE 1A                  CP   1Ah   
014C   38 5A                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
014E   FE 20                  CP   20h   
0150   38 0A                  JR   C,p5b   ; 5Bh-60h
0152   FE 3A                  CP   3Ah   
0154   38 4C                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0156   FE 3E                  CP   3Eh   
0158                          IF   1-CHECKED   
0158   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
015A                          ENDIF      
015A                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
015A                          ENDIF      
015A   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
015C   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
015E   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0160                .macro PTABLE,
0160                             ; 
0160                 DB      h_store & 0FFh  ; !
0160                 DB      h_str & 0FFh    ; "
0160                 DB      h_num & 0FFh    ; #
0160                 DB      h_print & 0FFh  ; $
0160                 DB      h_swap & 0FFh   ; %
0160                 DB      h_and & 0FFh    ; &
0160                 DB      h_emit & 0FFh   ; '
0160                 DB      h_open & 0FFh   ; (
0160                 DB      h_close & 0FFh  ; )
0160                 DB      h_mul & 0FFh    ; *
0160                 DB      h_add & 0FFh    ; +
0160                 DB      h_cfetch & 0FFh ; ,
0160                 DB      h_sub & 0FFh    ; -
0160                 DB      h_cstore & 0FFh ; .
0160                 DB      h_div & 0FFh    ; /
0160                 DB      h_dup & 0FFh    ; :
0160                 DB      h_drop & 0FFh   ; ;
0160                 DB      h_lt & 0FFh     ; <
0160                 DB      h_eq & 0FFh     ; =
0160                 DB      h_gt & 0FFh     ; >
0160                 DB      h_key & 0FFh    ; ?
0160                 DB      h_fetch & 0FFh  ; @
0160                 DB      h_def & 0FFh    ; [
0160                 DB      h_break & 0FFh  ; \
0160                 DB      h_ret & 0FFh    ; ]
0160                 DB      h_xor & 0FFh    ; ^
0160                 DB      h_alloc & 0FFh  ; _
0160                 DB      h_grave & 0FFh  ; `
0160                 DB      h_tor & 0FFh    ; {
0160                 DB      h_or & 0FFh     ; |
0160                 DB      h_fromr & 0FFh  ; }
0160                 DB      h_not & 0FFh    ; ~
0160                .endm
0160                 
0160                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0160                             ; untouched, and A, DE free.
0160   C6 2B        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0162   5F                     LD   E,A   
0163   16 04                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0165   FE 40                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0167   1A                     LD   A,(DE)   
0168   5F                     LD   E,A   ; the handler's low byte
0169                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0169                          ENDIF      
0169                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
0169                          ENDIF      
0169                          IF   CPM   
0169   16 01                  LD   D,1   
016B   30 01                  JR   NC,pu1   
016D   14                     INC   D   ; its page: 1 + carry
016E                PU1:         
016E                          ENDIF      
016E   D5                     PUSH   DE   ; jump to it; the stack is balanced again
016F   C9                     RET      ;   when the handler starts
0170                             ; The rest of the startup: here so that the generic reset code can reach it
0170                             ; with JR. st0: find the program's NUL; the heap starts after it.
0170                             ; (The editor build has its own copy of this, next to the editor.)
0170                             ; A checked build first clears the lower half of the letter page (A = 0):
0170                             ; every variable starts at 0, every word cell holds 0000h, the address an
0170                             ; undefined word is caught at (see e_hi), and no key is held back.
0170                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0170                          ENDIF      
0170                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0170                          ENDIF      
0170                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0170                          ENDIF      
0170                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0170                          ENDIF      
0170                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0170                          ENDIF      ;   these)
0170                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0170                          ENDIF      
0170                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0170                          ENDIF      
0170                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0170                          ENDIF      
0170                             ; In the unchecked generic editor build the table is here, in the first
0170                             ; page, which saves loading D twice. (The other builds have no room for it
0170                             ; here: theirs is further down.)
0170                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0170                          ENDIF      
0170                             ; =============================================================================
0170                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0170                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0170                             ;  is here too: it belongs to "`" and makes the page come out right.
0170                             ; =============================================================================
0170   D1           H_XOR:    POP   DE   
0171   7C                     LD   A,H   
0172   AA                     XOR   D   
0173   67                     LD   H,A   
0174   7D                     LD   A,L   
0175   AB                     XOR   E   
0176   6F                     LD   L,A   
0177   F7                     RST   30h   
0178   D1           H_OR:     POP   DE   
0179   7C                     LD   A,H   
017A   B2                     OR   D   
017B   67                     LD   H,A   
017C   7D                     LD   A,L   
017D   B3                     OR   E   
017E   6F                     LD   L,A   
017F   F7                     RST   30h   
0180   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0181   2B                     DEC   HL   
0182   F7                     RST   30h   
0183                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0183                             ; the same either way); TOS is the old pointer.
0183   ED 5B 7C 0A  H_ALLOC:   LD   DE,(HEAP)   
0187                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0187                          ENDIF      
0187   19                     ADD   HL,DE   ; the new top
0188                          IF   CHECKED   
                              CALL   chkhp   
0188                          ENDIF      
0188   22 7C 0A               LD   (HEAP),HL   
018B   EB                     EX   DE,HL   
018C   F7                     RST   30h   
018D   D9           EXEC:     EXX      
018E   22 34 0A               LD   (RSAVE),HL   ; machine code may change the alternates
0191   D9                     EXX      
0192   CD 2B 01               CALL   jphl   
0195   D9                     EXX      
0196   2A 34 0A               LD   HL,(RSAVE)   
0199   D9                     EXX      
019A   E1                     POP   HL   
019B   F7                     RST   30h   
019C                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
019C                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
019C                             ; Digits: step back onto the first digit and read the whole number.
019C   E5           DIGIT:    PUSH   HL   
019D   0B                     DEC   BC   
019E   CD 15 03               CALL   rdnum   
01A1   F7                     RST   30h   
01A2                             ; a-z: push the cell's address (the cell is the variable)
01A2   E5           LOWER:    PUSH   HL   
01A3   87                     ADD   A,A   
01A4   6F                     LD   L,A   
01A5   26 0A                  LD   H,LETPAGE   
01A7   F7                     RST   30h   
01A8                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01A8                             ; the return stack, and the IP becomes the address in the letter's cell.
01A8   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01A9   EB                     EX   DE,HL   ; park TOS
01AA   87                     ADD   A,A   
01AB   6F                     LD   L,A   
01AC   26 0A                  LD   H,LETPAGE   ; HL -> cell
01AE   4E                     LD   C,(HL)   
01AF   2C                     INC   L   
01B0   46                     LD   B,(HL)   ; IP = the word's body
01B1   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01B2                             ; rpushn: move the top cell of the data stack (in memory) to the return
01B2                             ; stack, then next. Everything that pushes the return stack ends here.
01B2                             ; 
01B2                             ; The break key is looked at here, so at every word call and loop-back (and
01B2                             ; block entry and "{"), but only one time in 256: B', which nothing else
01B2                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
01B2                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
01B2                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
01B2                             ; both ways out.)
01B2   D9           RPUSHN:   EXX      
01B3   D1                     POP   DE   
01B4   2B                     DEC   HL   
01B5   72                     LD   (HL),D   
01B6   2B                     DEC   HL   
01B7   73                     LD   (HL),E   
01B8   05                     DEC   B   
01B9   D9                     EXX      
01BA   CC 5D 04               CALL   Z,pollk   
01BD   F7                     RST   30h   
01BE                             ; ---- the grave -------------------------------------------------------------
01BE                             ; The grave is a prefix: with the character after it, it is one command.
01BE                             ; The characters are tested one after another, each SUB taking off the step
01BE                             ; from the one before, so A is 0 (and the carry clear) when a handler is
01BE                             ; reached. Two are here, where they keep the first page as full as the
01BE                             ; layout needs; grave2 has the rest.
01BE                             ; 
01BE                             ;   `!  ( addr -- )  calls the machine code at TOS. The code is entered by
01BE                             ;       CALL with the data stack above the return address; it must keep BC,
01BE                             ;       and on return the top cell becomes the new TOS.
01BE                             ;   `'  ( -- )  new line: CR LF
01BE   0A           H_GRAVE:   LD   A,(BC)   
01BF   03                     INC   BC   
01C0   D6 21                  SUB   "!"   
01C2   28 C9                  JR   Z,exec   
01C4   D6 06                  SUB   27h-"!"   ; "'"
01C6   C2 72 03               JP   NZ,grave2   
01C9   3E 0D                  LD   A,13   
01CB   EF                     RST   28h   
01CC   3E 0A                  LD   A,10   
01CE   EF                     RST   28h   
01CF   F7                     RST   30h   
01D0                             ; ---- where the two pages meet ----------------------------------------------
01D0                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D0                             ; are in falling code order for this), and where exactly differs between the
01D0                             ; builds: NPG1 follows. Every handler below these four must start in the
01D0                             ; second page, and every one above in the first; chktab.py checks both.
01D0                             ; "]" returns: pop an address and jump to it.
01D0   CF           H_RET:    RST   08h   
01D1   42                     LD   B,D   
01D2   4B                     LD   C,E   
01D3   F7           BRK1:     RST   30h   
01D4                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01D4                             ; drops the block start, "]" returns. No closer at all ends the program.
01D4   7C           H_BREAK:   LD   A,H   
01D5   B5                     OR   L   
01D6   E1                     POP   HL   
01D7   28 FA                  JR   Z,brk1   
01D9   CD 37 03               CALL   skip   
01DC   B7                     OR   A   ; skip returns 0 for ")"
01DD   20 F1                  JR   NZ,h_ret   
01DF   CF           RDROP:    RST   08h   
01E0   F7                     RST   30h   
01E1                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01E1                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01E1                             ; the body"s address instead. Either way it then skips to the matching "]'.
01E1                             ; (The unchecked build takes anything that is not a letter as the space; the
01E1                             ; checked build stops on it.)
01E1   0A           H_DEF:    LD   A,(BC)   
01E2   03                     INC   BC   
01E3   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01E5   5F                     LD   E,A   ;   lands 64 bytes up
01E6   E6 DF                  AND   0DFh   ; fold case
01E8   FE 1A                  CP   26   
01EA   30 0B                  JR   NC,def2   ; not a letter
01EC   CB 23                  SLA   E   
01EE   16 0A                  LD   D,LETPAGE   ; DE -> cell
01F0   79                     LD   A,C   
01F1   12                     LD   (DE),A   
01F2   1C                     INC   E   
01F3   78                     LD   A,B   
01F4   12                     LD   (DE),A   
01F5   18 03                  JR   skipnx   
01F7                DEF2:        
01F7                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
01F7                          ENDIF      
01F7   E5                     PUSH   HL   ; an anonymous block: push its address
01F8   60                     LD   H,B   
01F9   69                     LD   L,C   
01FA                SKIPNX:      
01FA                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
01FA                          ENDIF      ;   opener, the "[", just before where it starts
01FA   CD 37 03     SKIPO:    CALL   skip   
01FD   F7                     RST   30h   
01FE   5E           H_FETCH:   LD   E,(HL)   ; "@"
01FF   23                     INC   HL   
0200   56                     LD   D,(HL)   
0201   EB                     EX   DE,HL   
0202   F7                     RST   30h   
0203                             ; =============================================================================
0203                             ;  Handlers that must start in the image's second page.
0203                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0203                             ;  page.
0203                             ; =============================================================================
0203                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0203                             ; the matching ")".
0203   7C           H_OPEN:   LD   A,H   
0204   B5                     OR   L   
0205   E1                     POP   HL   
0206   28 F2                  JR   Z,skipo   
0208   C5                     PUSH   BC   ; the block starts at the IP
0209   18 A7                  JR   rpushn   
020B                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
020B                             ; drops it and carries on.
020B   7C           H_CLOSE:   LD   A,H   
020C   B5                     OR   L   
020D   E1                     POP   HL   
020E   28 CF                  JR   Z,rdrop   
0210   CF                     RST   08h   ; pop the block start ...
0211   42                     LD   B,D   
0212   4B                     LD   C,E   
0213   C5                     PUSH   BC   
0214   18 9C                  JR   rpushn   ; ... and push it back
0216                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0216                             ; "-" has two jobs: directly before a digit it starts a negative number.
0216   0A           H_SUB:    LD   A,(BC)   
0217   D6 30                  SUB   "0"   
0219   FE 0A                  CP   10   
021B   38 04                  JR   C,negnum   
021D   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
021E   D1           H_ADD:    POP   DE   
021F   19                     ADD   HL,DE   
0220   F7                     RST   30h   
0221   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0222   CD 15 03               CALL   rdnum   
0225   E7                     RST   20h   
0226   F7                     RST   30h   
0227   D1           H_AND:    POP   DE   
0228   7C                     LD   A,H   
0229   A2                     AND   D   
022A   67                     LD   H,A   
022B   7D                     LD   A,L   
022C   A3                     AND   E   
022D   6F                     LD   L,A   
022E   F7                     RST   30h   
022F                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
022F                             ; cells first. Flipping both sign bits turns a signed compare into an
022F                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
022F                             ; carry into -1 or 0 with no branch.
022F   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0230   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0231   7C                     LD   A,H   
0232   EE 80                  XOR   80h   
0234   67                     LD   H,A   
0235   7A                     LD   A,D   
0236   EE 80                  XOR   80h   
0238   57                     LD   D,A   
0239   ED 52                  SBC   HL,DE   ; carry if HL < DE
023B   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
023D   F7                     RST   30h   
023E   D1           H_EQ:     POP   DE   
023F   B7                     OR   A   
0240   ED 52                  SBC   HL,DE   
0242   7C                     LD   A,H   
0243   B5                     OR   L   
0244   FE 01                  CP   1   ; carry only if a - b = 0
0246   18 F3                  JR   tf   
0248                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0248                             ; multiplier shifts up through A:C.
0248   D1           H_MUL:    POP   DE   ; DE = multiplicand
0249   C5                     PUSH   BC   
024A   7C                     LD   A,H   
024B   4D                     LD   C,L   ; A:C = multiplier
024C   21 00 00               LD   HL,0   
024F   06 10                  LD   B,16   
0251   29           MUL1:     ADD   HL,HL   
0252   CB 21                  SLA   C   
0254   17                     RLA      
0255   30 01                  JR   NC,mul2   
0257   19                     ADD   HL,DE   
0258   10 F7        MUL2:     DJNZ   mul1   
025A   C1                     POP   BC   
025B   F7                     RST   30h   
025C                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
025C                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
025C                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
025C                             ; stops on it.
025C                H_DIV:       
025C                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
025C                          ENDIF      
025C   D1                     POP   DE   ; DE = a, HL = b
025D   C5                     PUSH   BC   ; free BC for udiv
025E   D5                     PUSH   DE   ; a, for r's sign
025F   7A                     LD   A,D   
0260   AC                     XOR   H   
0261   F5                     PUSH   AF   ; S flag = sign of q
0262   CB 7C                  BIT   7,H   
0264   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0267   EB                     EX   DE,HL   
0268   CB 7C                  BIT   7,H   
026A   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
026D   CD EF 02               CALL   udiv   ; HL = q, DE = r
0270   F1                     POP   AF   
0271   FC 20 01               CALL   M,neg16   ; q's sign
0274   EB                     EX   DE,HL   ; HL = r, DE = q
0275   F1                     POP   AF   ; A = a's high byte
0276   B7                     OR   A   
0277   FC 20 01               CALL   M,neg16   ; r's sign
027A   C1                     POP   BC   
027B   D5                     PUSH   DE   ; q under r
027C   F7                     RST   30h   
027D                             ; ---- stack and storage -----------------------------------------------------
027D   E5           H_DUP:    PUSH   HL   ; ":"
027E   F7                     RST   30h   
027F   E3           H_SWAP:   EX   (SP),HL   ; "%"
0280   F7                     RST   30h   
0281                             ; (The checked build tests the address before it takes the value off the
0281                             ; stack, so that an error report shows both.)
0281                H_CSTORE:      ; "." ( c addr -- )
0281                          IF   CHECKED   
                              CALL   chkst   
0281                          ENDIF      
0281   D1                     POP   DE   
0282   73                     LD   (HL),E   
0283   DF           H_DROP:   RST   18h   ; ";" is this one byte
0284                H_STORE:      ; "!" ( n addr -- )
0284                          IF   CHECKED   
                              CALL   chkst   
0284                          ENDIF      
0284   D1                     POP   DE   
0285   73                     LD   (HL),E   
0286   23                     INC   HL   
0287   72                     LD   (HL),D   
0288   DF                     RST   18h   
0289                             ; ---- console ---------------------------------------------------------------
0289                             ; 22h pushes the address of the text after it and skips the string.
0289   E5           H_STR:    PUSH   HL   
028A   60                     LD   H,B   
028B   69                     LD   L,C   
028C   CD 2C 03               CALL   skipstr   
028F                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
028F                          ENDIF      
028F   F7                     RST   30h   
0290                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
0290                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
0290                             ; bit 6, so // and /" give themselves).
0290                          IF   1-CHECKED   
0290   7E           H_PRINT:   LD   A,(HL)   
0291   23                     INC   HL   
0292   FE 22                  CP   22h   
0294   28 0D                  JR   Z,pr9   
0296   FE 2F                  CP   "/"   
0298   20 04                  JR   NZ,pr1   
029A   7E                     LD   A,(HL)   
029B   23                     INC   HL   
029C   E6 BF                  AND   0BFh   
029E   EF           PR1:      RST   28h   
029F   18 EF                  JR   h_print   
02A1                          ENDIF      
02A1                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
02A1                          ENDIF      
02A1   7D           H_EMIT:   LD   A,L   ; "'"
02A2   EF                     RST   28h   
02A3   DF           PR9:      RST   18h   
02A4                             ; "#" prints TOS as a signed decimal number, with no space after it.
02A4   C5           H_NUM:    PUSH   BC   
02A5   CD 58 03               CALL   psgn   
02A8   C1                     POP   BC   
02A9   DF                     RST   18h   
02AA                             ; "?" ( n -- c ) or ( -n -- addr )
02AA                             ;   n > 0: wait about n ms for a key; 0 if none came
02AA                             ;   n = 0: wait for a key
02AA                             ;          (both stir the random seed while they wait: see kt2)
02AA                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02AA                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02AA   CB 7C        H_KEY:    BIT   7,H   
02AC   20 22                  JR   NZ,line   
02AE   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02B0   CD 8B 04     KT2:      CALL   getk   
02B3   20 17                  JR   NZ,kt3   
02B5   1D                     DEC   E   
02B6   20 F8                  JR   NZ,kt2   
02B8   EB                     EX   DE,HL   ; a millisecond with no key stirs the random
02B9   2A 76 0A               LD   HL,(SEED)   ;   seed by one: how long a key takes to come
02BC   23                     INC   HL   ;   is the one thing here that is not the
02BD   22 76 0A               LD   (SEED),HL   ;   same every time
02C0   EB                     EX   DE,HL   
02C1   7C                     LD   A,H   ; 0? never counts down: it waits
02C2   B5                     OR   L   
02C3   28 E9                  JR   Z,kt1   
02C5   2B                     DEC   HL   
02C6   7C                     LD   A,H   
02C7   B5                     OR   L   
02C8   20 E4                  JR   NZ,kt1   ; A = 0 if the time ran out
02CA   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02CB   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02CC   6F           KT3:      LD   L,A   
02CD   26 00                  LD   H,0   
02CF   F7                     RST   30h   
02D0                          IF   CPM   
02D0                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02D0                             ; own line editor). It doesn't store the CR, so it is added here.
02D0   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02D3   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02D4   9F                     SBC   A,A   
02D5   A5                     AND   L   ; (0 for a count that is too big)
02D6   EE 7F                  XOR   127   ; A = the count, 127 at most
02D8   32 7E 0A               LD   (LBHDR),A   
02DB   11 7E 0A               LD   DE,LBHDR   
02DE   3E 0A                  LD   A,10   
02E0   CD A9 04               CALL   bdosx   
02E3   21 7F 0A               LD   HL,LBHDR+1   
02E6   7E                     LD   A,(HL)   ; the count typed (0-127)
02E7   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
02E8   85                     ADD   A,L   ;   adding the count to L can't carry
02E9   6F                     LD   L,A   
02EA   36 0D                  LD   (HL),13   
02EC                          ENDIF      
02EC                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
                                 ;   at most
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
02EC                          ENDIF      
02EC   2E 80                  LD   L,LINEBUF & 0FFh   
02EE   F7                     RST   30h   
02EF                             ; =============================================================================
02EF                             ;  More routines (no handler starts past this point)
02EF                             ; =============================================================================
02EF                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
02EF                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
02EF                             ; while the quotient bits arrive at the bottom of C.
02EF                             ; Dividing by 2 is one shift (the spec wants that fast).
02EF   7B           UDIV:     LD   A,E   
02F0   EE 02                  XOR   2   
02F2   B2                     OR   D   
02F3   20 07                  JR   NZ,udv0   
02F5   CB 3C                  SRL   H   
02F7   CB 1D                  RR   L   ; the quotient
02F9   8F                     ADC   A,A   
02FA   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
02FB   C9                     RET      
02FC   7C           UDV0:     LD   A,H   
02FD   4D                     LD   C,L   
02FE   21 00 00               LD   HL,0   
0301   06 10                  LD   B,16   
0303   CB 21        UDV1:     SLA   C   
0305   17                     RLA      
0306   ED 6A                  ADC   HL,HL   
0308   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
030A   30 02                  JR   NC,udv2   ;   always fits in 16 bits
030C   19                     ADD   HL,DE   ; too much: put it back, and cancel the
030D   0D                     DEC   C   ;   INC below
030E   0C           UDV2:     INC   C   ; a quotient bit
030F   10 F2                  DJNZ   udv1   
0311   EB                     EX   DE,HL   ; DE = remainder
0312   67                     LD   H,A   
0313   69                     LD   L,C   ; HL = quotient
0314   C9                     RET      
0315                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0315                             ; non-digit. Values wrap at 16 bits, as the spec says.
0315   21 00 00     RDNUM:    LD   HL,0   
0318   0A           RDN1:     LD   A,(BC)   
0319   D6 30                  SUB   "0"   
031B   FE 0A                  CP   10   
031D   D0                     RET   NC   
031E   03                     INC   BC   
031F   54                     LD   D,H   
0320   5D                     LD   E,L   
0321   29                     ADD   HL,HL   
0322   29                     ADD   HL,HL   
0323   19                     ADD   HL,DE   
0324   29                     ADD   HL,HL   ; HL * 10
0325   5F                     LD   E,A   
0326   16 00                  LD   D,0   
0328   19                     ADD   HL,DE   
0329   18 ED                  JR   rdn1   
032B                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
032B                             ; the next character, so "/"" does not end it. Leaves A = 22h.
032B                          IF   1-CHECKED   
032B   03           SS0:      INC   BC   
032C   0A           SKIPSTR:   LD   A,(BC)   
032D   03                     INC   BC   
032E   FE 2F                  CP   "/"   
0330   28 F9                  JR   Z,ss0   
0332   FE 22                  CP   22h   
0334   20 F6                  JR   NZ,skipstr   
0336   C9                     RET      
0337                          ENDIF      
0337                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0337                          ENDIF      
0337                             ; skip: read past text to the closer at this level, and return A = 0 if it
0337                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0337                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0337                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0337                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0337                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0337                             ; 
0337                             ; The checked build also looks at the character the skip was started by,
0337                             ; which is always the one just before where it starts: "(" must end at ")",
0337                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0337                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0337                             ; place where the skip started, for the report.
0337                SKIP:        
0337                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0337                          ENDIF      
0337   16 00                  LD   D,0   
0339   14           SK3:      INC   D   ; an opener: one deeper
033A   0A           SK1:      LD   A,(BC)   
033B                          IF   1-CHECKED   
033B   03                     INC   BC   
033C   B7                     OR   A   
033D   CA F0 04               JP   Z,SKEND   ; (the end of the program)
0340                          ENDIF      
0340                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0340                          ENDIF      
0340   FE 22                  CP   22h   
0342   CC 2C 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0345   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0347   28 F0                  JR   Z,sk3   
0349   3D                     DEC   A   ; ")"
034A   28 08                  JR   Z,sk4   
034C   D6 32                  SUB   "["-")"   
034E   28 E9                  JR   Z,sk3   
0350   FE 02                  CP   "]"-"["   
0352   20 E6                  JR   NZ,sk1   
0354   15           SK4:      DEC   D   
0355                          IF   1-CHECKED   
0355   C8                     RET   Z   ; the closer at this level
0356   18 E2                  JR   sk1   
0358                          ENDIF      
0358                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0358                          ENDIF      
0358                             ; psgn: print HL as a signed number. Uses BC.
0358   CB 7C        PSGN:     BIT   7,H   
035A   28 04                  JR   Z,pdec   
035C   3E 2D                  LD   A,"-"   
035E   EF                     RST   28h   
035F   E7                     RST   20h   
0360                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0360                             ; Uses BC.
0360   11 0A 00     PDEC:     LD   DE,10   
0363   CD EF 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0366   7B                     LD   A,E   
0367   F5                     PUSH   AF   
0368   7C                     LD   A,H   
0369   B5                     OR   L   
036A   C4 60 03               CALL   NZ,pdec   
036D   F1                     POP   AF   
036E   C6 30                  ADD   A,"0"   
0370   EF                     RST   28h   
0371   C9                     RET      
0372                             ; =============================================================================
0372                             ;  The grave's other codes. h_grave comes here with A = the character minus
0372                             ;  27h, not zero; the tests carry on from there. The four characters from
0372                             ;  "+" to "." follow one another, so one range test finds them and two
0372                             ;  rotates tell them apart.
0372                             ; 
0372                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
0372                             ;        from addr until a non-hex character; then a RET (C9h) is written
0372                             ;        and its address is left. An odd last digit is consumed and dropped.
0372                             ;    `+  ( addr -- n )   add 1 to the cell at addr and leave its new value
0372                             ;    `,  ( n -- r )      a random number from 0 to n-1 (n is 1 to 32767)
0372                             ;    `-  ( addr -- n )   subtract 1 from the cell at addr, the same way
0372                             ;    `.  ( -- addr )     the address of the random seed
0372                             ;    `<  ( a b -- n )    the smaller of the two (signed)
0372                             ;    `>  ( a b -- n )    the larger
0372                             ;    `?  ( flag -- )     the cursor off (0) or on
0372                             ;    `@  ( row col -- )  the cursor to that row and column, both from 0
0372                             ;    `^  ( -- )          clear the screen and home the cursor
0372                             ;    `_  ( -- )          clear from the cursor to the end of the line
0372                             ; 
0372                             ;  Any other character is unsafe: the unchecked build takes it as "_", the
0372                             ;  checked build stops with W.
0372                             ; =============================================================================
0372   D6 04        GRAVE2:   SUB   "+"-27h   ; "+" "," "-" "." leave 0 to 3
0374   FE 04                  CP   4   
0376   30 32                  JR   NC,gv2   
0378   1F                     RRA      ; carry: "," or "."; bit 0 of A: "-" or "."
0379   38 0E                  JR   C,gv3   
037B                             ; `+ and `-: one routine.
037B                          IF   CHECKED   
                              LD   D,A   ; (the checked build tests the address first,
                              CALL   chkst   ;   as "!" does: the test uses A, and under
                              LD   A,D   ;   CP/M E too)
037B                          ENDIF      
037B   5E                     LD   E,(HL)   
037C   23                     INC   HL   
037D   56                     LD   D,(HL)   
037E   1F                     RRA      ; carry: "-"
037F   38 02                  JR   C,gi1   
0381   13                     INC   DE   
0382   13                     INC   DE   
0383   1B           GI1:      DEC   DE   
0384   72                     LD   (HL),D   
0385   2B                     DEC   HL   
0386   73                     LD   (HL),E   
0387   EB                     EX   DE,HL   ; the new value is TOS
0388   F7                     RST   30h   
0389   1F           GV3:      RRA      ; carry: "."
038A   38 19                  JR   C,g_seed   
038C                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
038C                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
038C                             ; and the low ones repeat soon, so the high byte is folded into the low
038C                             ; (XOR) before the remainder of dividing by n is taken.
038C                             ; n must be 1 to 32767: the checked build stops with Z on anything less
038C                             ; than 1.
038C                G_RND:       
038C                          IF   CHECKED   
                              DEC   HL   
                              BIT   7,H   ; n - 1 negative: n is 0 or less
                              INC   HL   
                              JP   NZ,e_zero   
038C                          ENDIF      
038C   EB                     EX   DE,HL   ; DE = n
038D   C5                     PUSH   BC   
038E   2A 76 0A               LD   HL,(SEED)   
0391   44                     LD   B,H   
0392   4D                     LD   C,L   
0393   29                     ADD   HL,HL   
0394   29                     ADD   HL,HL   
0395   09                     ADD   HL,BC   ; * 5
0396   23                     INC   HL   ; + 1
0397   7C                     LD   A,H   
0398   81                     ADD   A,C   
0399   67                     LD   H,A   ; + * 256: * 261 + 1
039A   22 76 0A               LD   (SEED),HL   
039D   AD                     XOR   L   ; (A is still the high byte)
039E   6F                     LD   L,A   
039F   CD EF 02               CALL   udiv   ; DE = the remainder
03A2   EB                     EX   DE,HL   
03A3   C1                     POP   BC   
03A4   F7                     RST   30h   
03A5                             ; `. pushes the address of the random seed.
03A5   E5           G_SEED:   PUSH   HL   
03A6   21 76 0A               LD   HL,SEED   
03A9   F7                     RST   30h   
03AA   C6 07        GV2:      ADD   A,"+"-"$"   ; "$"
03AC   20 13                  JR   NZ,gv4   
03AE   CD 4B 04     HX1:      CALL   hexc   
03B1   30 0B                  JR   NC,hx2   
03B3   77                     LD   (HL),A   ; the high digit goes in first ...
03B4   CD 4B 04               CALL   hexc   
03B7   30 05                  JR   NC,hx2   ; odd digit: consumed, and the RET below
03B9   ED 6F                  RLD      ;   overwrites it
03BB   23                     INC   HL   ; ... and RLD shifts it up under the low one
03BC   18 F0                  JR   hx1   
03BE   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
03C0   F7                     RST   30h   
03C1   D6 18        GV4:      SUB   "<"-"$"   
03C3   28 1F                  JR   Z,g_min   
03C5   D6 02                  SUB   ">"-"<"   
03C7   28 1A                  JR   Z,g_max   
03C9   3D                     DEC   A   ; "?"
03CA   28 2A                  JR   Z,g_cur   
03CC   3D                     DEC   A   ; "@"
03CD   28 3D                  JR   Z,g_at   
03CF   D6 1E                  SUB   "^"-"@"   ; "^" leaves 0 and "_" leaves 1
03D1                          IF   CHECKED   
                              CP   2   
                              JP   NC,e_brack   ; anything else: W. The place is the character
                              OR   A   
03D1                          ENDIF      
03D1                          IF   ANSI   
03D1   20 07                  JR   NZ,ge1   
03D3   CD 24 04               CALL   csi   ; "^": ESC [ H homes the cursor, and then
03D6   3E 48                  LD   A,"H"   ;   ESC [ J clears from there to the end of
03D8   EF                     RST   28h   ;   the screen
03D9   AF                     XOR   A   
03DA   C6 4A        GE1:      ADD   A,"J"   ; "_": ESC [ K clears to the end of the line
03DC   5F                     LD   E,A   
03DD   CD 24 04               CALL   csi   
03E0   7B                     LD   A,E   
03E1   EF                     RST   28h   
03E2   F7                     RST   30h   
03E3                          ENDIF      
03E3                          IF   1-ANSI   
                              JR   NZ,ge1   
                              CALL   CONCLS   
                              RST   30h   
                    GE1:      CALL   CONEOL   
                              RST   30h   
03E3                          ENDIF      
03E3                             ; `< and `>. The carry says which: set for the larger. The two are put in
03E3                             ; order, HL the smaller and DE the larger, and then swapped for ">".
03E3                             ; b < a (signed) is the borrow of b - a, turned round if the two signs
03E3                             ; differ: RRA puts the borrow in bit 7, where the two XORs meet it.
03E3   37           G_MAX:    SCF      ; ("<" comes in with the carry clear)
03E4   D1           G_MIN:    POP   DE   ; DE = a, HL = b
03E5   F5                     PUSH   AF   
03E6   7D                     LD   A,L   
03E7   93                     SUB   E   
03E8   7C                     LD   A,H   
03E9   9A                     SBC   A,D   
03EA   1F                     RRA      
03EB   AC                     XOR   H   
03EC   AA                     XOR   D   
03ED   17                     RLA      ; carry: b < a
03EE   38 01                  JR   C,gm2   
03F0   EB                     EX   DE,HL   
03F1   F1           GM2:      POP   AF   
03F2   30 01                  JR   NC,gm3   
03F4   EB                     EX   DE,HL   
03F5   F7           GM3:      RST   30h   
03F6                          IF   ANSI   
03F6                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
03F6   CD 24 04     G_CUR:    CALL   csi   
03F9   3E 3F                  LD   A,"?"   
03FB   EF                     RST   28h   
03FC   3E 32                  LD   A,"2"   
03FE   EF                     RST   28h   
03FF   3E 35                  LD   A,"5"   
0401   EF                     RST   28h   
0402   7C                     LD   A,H   
0403   B5                     OR   L   
0404   3E 6C                  LD   A,"l"   
0406   28 02                  JR   Z,gc1   
0408   3E 68                  LD   A,"h"   
040A   EF           GC1:      RST   28h   
040B   DF                     RST   18h   
040C                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
040C   D1           G_AT:     POP   DE   ; DE = the row
040D   C5                     PUSH   BC   ; (pdec uses BC)
040E   E5                     PUSH   HL   ; the column
040F   EB                     EX   DE,HL   
0410   CD 24 04               CALL   csi   
0413   23                     INC   HL   
0414   CD 60 03               CALL   pdec   
0417   3E 3B                  LD   A,";"   
0419   EF                     RST   28h   
041A   E1                     POP   HL   
041B   23                     INC   HL   
041C   CD 60 03               CALL   pdec   
041F   3E 48                  LD   A,"H"   
0421   EF                     RST   28h   
0422   C1                     POP   BC   
0423   DF                     RST   18h   
0424                             ; csi: print ESC [, which starts every ANSI sequence. Keeps all but A.
0424   3E 1B        CSI:      LD   A,27   
0426   EF                     RST   28h   
0427   3E 5B                  LD   A,"["   
0429   EF                     RST   28h   
042A   C9                     RET      
042B                          ENDIF      
042B                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    LD   A,H   
                              OR   L   
                              CALL   CONCUR   
                              RST   18h   
                    G_AT:     POP   DE   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   18h   
042B                          ENDIF      
042B                             ; =============================================================================
042B                             ;  Dispatch table: the low byte of each handler's address, in code order
042B                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
042B                             ;  It must not cross a page (the dispatcher only adds to its low byte).
042B                             ; =============================================================================
042B                             ; The handlers of the first NPG1 characters start in the image's second page.
042B                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
042B                             ; differs between the builds, so the count is worked out here.
042B                             ; (One division to a line: asm80 only rounds down when it stores a value.)
042B                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
042B                PGBRK:    EQU   (h_break-BASE)/256   
042B                PGDEF:    EQU   (h_def-BASE)/256   
042B                PGFET:    EQU   (h_fetch-BASE)/256   
042B                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
042B                          IF   1-TABP0   
042B                PTAB:        
042B                          ;*Macro unroll:  PTABLE
042B   84                     DB   h_store & 0FFh   
042C   89                     DB   h_str & 0FFh   
042D   A4                     DB   h_num & 0FFh   
042E   90                     DB   h_print & 0FFh   
042F   7F                     DB   h_swap & 0FFh   
0430   27                     DB   h_and & 0FFh   
0431   A1                     DB   h_emit & 0FFh   
0432   03                     DB   h_open & 0FFh   
0433   0B                     DB   h_close & 0FFh   
0434   48                     DB   h_mul & 0FFh   
0435   1E                     DB   h_add & 0FFh   
0436   CB                     DB   h_cfetch & 0FFh   
0437   16                     DB   h_sub & 0FFh   
0438   81                     DB   h_cstore & 0FFh   
0439   5C                     DB   h_div & 0FFh   
043A   7D                     DB   h_dup & 0FFh   
043B   83                     DB   h_drop & 0FFh   
043C   2F                     DB   h_lt & 0FFh   
043D   3E                     DB   h_eq & 0FFh   
043E   30                     DB   h_gt & 0FFh   
043F   AA                     DB   h_key & 0FFh   
0440   FE                     DB   h_fetch & 0FFh   
0441   E1                     DB   h_def & 0FFh   
0442   D4                     DB   h_break & 0FFh   
0443   D0                     DB   h_ret & 0FFh   
0444   70                     DB   h_xor & 0FFh   
0445   83                     DB   h_alloc & 0FFh   
0446   BE                     DB   h_grave & 0FFh   
0447   2C                     DB   h_tor & 0FFh   
0448   78                     DB   h_or & 0FFh   
0449   1C                     DB   h_fromr & 0FFh   
044A   80                     DB   h_not & 0FFh   
044B                PTABEND:      
044B                          ENDIF      
044B                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
044B                             ; and return its value in A with the carry set; otherwise leave the IP and
044B                             ; return with the carry clear.
044B   0A           HEXC:     LD   A,(BC)   
044C   D6 30                  SUB   "0"   
044E   FE 0A                  CP   10   
0450   38 09                  JR   C,hc1   
0452   E6 DF                  AND   0DFh   
0454   D6 11                  SUB   11h   
0456   FE 06                  CP   6   
0458   D0                     RET   NC   
0459   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
045B   03           HC1:      INC   BC   
045C   C9                     RET      
045D                             ; =============================================================================
045D                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
045D                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
045D                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
045D                             ;  they are the host's KEY and CONOUT routines themselves.
045D                             ; 
045D                             ;  A running program reads the keyboard only through getk and pollk, which
045D                             ;  between them give the break key its rules:
045D                             ;    - Ctrl-C stops the program;
045D                             ;    - any other key that the break check reads is held in KEYBUF for the
045D                             ;      next "?", and a newer one takes its place;
045D                             ;    - "?" (getk) takes the held key first;
045D                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
045D                             ;      key like any other, but two of them within about 250 ms still stop it.
045D                             ;  Both are called straight from a handler, never from a routine under one:
045D                             ;  the checked build's report counts on finding one return address above the
045D                             ;  data stack.
045D                             ; =============================================================================
045D                          IFN   CPM   
                    RAWK:     EQU   KEY   
045D                          ENDIF      
045D                             ; pollk: the break check (see rpushn).
045D   CD 9B 04     POLLK:    CALL   rawk   
0460   C8                     RET   Z   ; no key
0461   32 7A 0A               LD   (KEYBUF),A   ; held for the next "?"
0464   FE 03        PK1:      CP   3   ; (getk joins here)
0466   C0                     RET   NZ   
0467                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0467                             ; the program has turned it off, wait about 250 ms for one more key: a
0467                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0467                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0467   3A 7B 0A     CTLC:     LD   A,(BRKOFF)   
046A   B7                     OR   A   
046B   CA EC 04     CT0:      JP   Z,brk   
046E   D5                     PUSH   DE   
046F   11 10 27               LD   DE,250*MSLOOP   
0472   CD 9B 04     CT1:      CALL   rawk   
0475   20 05                  JR   NZ,ct2   
0477   1B                     DEC   DE   
0478   7A                     LD   A,D   
0479   B3                     OR   E   
047A   20 F6                  JR   NZ,ct1   
047C   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
047D   FE 03                  CP   3   
047F   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0481   B7                     OR   A   
0482   28 03                  JR   Z,ct3   
0484   32 7A 0A               LD   (KEYBUF),A   
0487   3E 03        CT3:      LD   A,3   
0489   B7                     OR   A   
048A   C9                     RET      
048B                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
048B   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
048C   21 7A 0A               LD   HL,KEYBUF   ;   the buffer
048F   7E                     LD   A,(HL)   
0490   36 00                  LD   (HL),0   
0492   E1                     POP   HL   
0493   B7                     OR   A   
0494   C0                     RET   NZ   
0495   CD 9B 04               CALL   rawk   
0498   C8                     RET   Z   
0499   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
049B                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
049B                          ENDIF      ;   (with the editor, both stacks are cleared);
049B                          IF   (1-CHECKED)*EDITOR   
049B                BRK:      EQU   edit0   
049B                          ENDIF      
049B                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
049B                          ENDIF      
049B                          IF   CPM   
049B   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
049D                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
049D                             ; printing and could swallow a key that BDOS 6 then never sees.
049D   D5           PUTC:     PUSH   DE   
049E   E5                     PUSH   HL   
049F   5F                     LD   E,A   
04A0   3E 06                  LD   A,6   
04A2   CD A9 04               CALL   bdosx   
04A5   E1                     POP   HL   
04A6   D1                     POP   DE   
04A7   B7                     OR   A   ; (for getk)
04A8   C9                     RET      
04A9                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
04A9   C5           BDOSX:    PUSH   BC   
04AA   D9                     EXX      
04AB   E5                     PUSH   HL   
04AC   D9                     EXX      
04AD   4F                     LD   C,A   
04AE   CD 05 00               CALL   BDOS   
04B1   D9                     EXX      
04B2   E1                     POP   HL   
04B3   D9                     EXX      
04B4   C1                     POP   BC   
04B5   C9                     RET      
04B6                          ENDIF      
04B6                             ; =============================================================================
04B6                             ;  Checked build: the checks and the error report
04B6                             ; =============================================================================
04B6                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
04B6                          ENDIF      
04B6                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
04B6                          ENDIF      
04B6                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
04B6                          ENDIF      
04B6                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
04B6                          ENDIF      
04B6                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
04B6                          ENDIF      
04B6                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
04B6                          ENDIF      
04B6                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop prstr's return
                              POP   HL   ;   address, put the string's address back in
                              DB   11h   ;   TOS, and step over the next two bytes: Q
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
                                 ;                       Rtn n
                                 ; TOS is in memory with the rest (pushed).
                              CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
                              ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
                              RST   20h   ;   with the first value and holds nothing)
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,B   ; C = the number of cells to show (B is 0:
                                 ;   phalf left the depth in BC)
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              PUSH   BC   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   BC   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      ; twice the depth is RSTOP less the pointer:
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough, since even an
                              SUB   L   ;   overflowing stack holds under 128 entries
                              EXX      
                              LD   L,A   
                              LD   H,B   ; (B is still 0)
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
04B6                          ENDIF      
04B6                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
04B6                          ENDIF      
04B6                          IF   CHECKED*EDITOR   
                              JP   edit0   ; back to the editor, with both stacks cleared
04B6                          ENDIF      
04B6                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A
                                 ; NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
04B6                          ENDIF      
04B6                             ; =============================================================================
04B6                             ;  The line editor (EDITOR = 1)
04B6                             ; 
04B6                             ;  The interpreter starts here, and a program that ends comes back here.
04B6                             ;  There is no prompt. It follows the spec's suggested standard for a line
04B6                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
04B6                             ; 
04B6                             ;    n text    put the text in as line n; the lines from n on move down. A
04B6                             ;              number past the end (or 0) adds the line at the end.
04B6                             ;    n         take line n out
04B6                             ;    anything else is run at once, as B8Script. (Start such a line with a
04B6                             ;    space if it would begin with a digit.)
04B6                             ; 
04B6                             ;  A command key ends the line too, and takes what was typed as its argument:
04B6                             ; 
04B6                             ;    ^G        run the program
04B6                             ;    n ^L      list from line n (no number: all of it). Any key holds the
04B6                             ;              list until another key is pressed; Ctrl-C ends it.
04B6                             ;    n ^E      put line n in the input line; Return puts it back, changed
04B6                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
04B6                             ;              last time). Generic: what is typed, or pasted, from now until
04B6                             ;              ^Z replaces the program; it is not echoed.
04B6                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
04B6                             ;              time). Generic: the text is printed, as it is.
04B6                             ;    ^N ^N     new: no program (the key twice in a row)
04B6                             ;    ^X        leave (to LEAVE)
04B6                             ; 
04B6                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
04B6                             ;  a character goes in at the cursor; Backspace and DEL take out the one
04B6                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
04B6                             ;  sent to the terminal, so any terminal will do.
04B6                             ; 
04B6                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
04B6                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
04B6                             ;  125 characters; the one character after a line number separates it from
04B6                             ;  the text and is not stored. The text is kept as it is typed, each line
04B6                             ;  ending in CR LF, at PROG.
04B6                             ; 
04B6                             ;  What lasts from one line to the next: the program, the words, the
04B6                             ;  variables and the data stack. An error or a break clears both stacks. The
04B6                             ;  return stack starts empty for every line.
04B6                             ; 
04B6                             ;  Things to know:
04B6                             ;    - Reset empties the program (generic builds).
04B6                             ;    - A word's address points into the program, so run the program again
04B6                             ;      after editing it.
04B6                             ;    - Nothing is printed between a program's output and what is typed next.
04B6                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
04B6                             ;      a line that calls -n? and carries on afterwards runs what was typed.
04B6                             ;      (The stored program never comes back to the line, so it may.)
04B6                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
04B6                             ;      read of the other builds (BDOS 10 under CP/M).
04B6                             ; 
04B6                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
04B6                             ;  the last line left there, with TOS pushed like the rest.
04B6                             ; =============================================================================
04B6                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
04B6                          ENDIF      
04B6                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
04B6                          ENDIF      
04B6                          IF   EDGEN   
                              JR   edit0   
04B6                          ENDIF      
04B6                          IF   EDITOR   
04B6                             ; ^F, right arrow: one to the right, by printing the character there
04B6   7D           RIGHT:    LD   A,L   
04B7   BB                     CP   E   
04B8   28 4A                  JR   Z,ed1   ; at the end
04BA   7E                     LD   A,(HL)   
04BB   2C                     INC   L   
04BC   18 2B                  JR   lf1   
04BE                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
04BE                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
04BE                             ; ends the sequence, and act on C (right) and D (left).
04BE   01 C8 00     ESC:      LD   BC,5*MSLOOP   
04C1   CD 9B 04     ES1:      CALL   rawk   
04C4   20 0A                  JR   NZ,es2   
04C6   0B                     DEC   BC   
04C7   78                     LD   A,B   
04C8   B1                     OR   C   
04C9   20 F6                  JR   NZ,es1   
04CB   CD 39 05               CALL   fin   ; no second key: the line is dropped
04CE   18 22                  JR   edit   
04D0   FE 5B        ES2:      CP   "["   
04D2   20 30                  JR   NZ,ed1   ; not a sequence known here
04D4   CD 92 05     ES3:      CALL   ekey   
04D7   FE 40                  CP   40h   
04D9   38 F9                  JR   C,es3   ; (its parameters)
04DB   D6 43                  SUB   "C"   
04DD   28 D7                  JR   Z,right   
04DF   3D                     DEC   A   ; "D"?
04E0   20 22                  JR   NZ,ed1   ; no: on into left
04E2                             ; ^B, left arrow: the cursor goes one to the left
04E2   7D           LEFT:     LD   A,L   
04E3   87                     ADD   A,A   
04E4   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
04E6   2D                     DEC   L   
04E7   3E 08                  LD   A,8   
04E9   EF           LF1:      RST   28h   
04EA   18 18                  JR   ed1   
04EC                             ; edit0: reset, an error or a break: both stacks are cleared.
04EC                             ; skend: a program that ended inside skip: its return address goes.
04EC                             ; edend: a program that ended: TOS joins the rest of the data stack.
04EC   31 FA 09     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
04EF   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
04F0   D1           SKEND:    POP   DE   
04F1   E5           EDEND:    PUSH   HL   
04F2                             ; edit: start a new input line.
04F2   D9           EDIT:     EXX      
04F3   21 E0 08               LD   HL,RSTOP   ; the return stack is empty
04F6   D9                     EXX      
04F7   21 00 00               LD   HL,0   
04FA   22 7A 0A               LD   (KEYBUF),HL   ; no key is held, and the break key is on
04FD   22 3A 0A               LD   (EDLN),HL   ; no line is being edited
0500   21 80 0A               LD   HL,LINEBUF   ; HL = the cursor,
0503   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0504   CD 92 05     ED1:      CALL   ekey   
0507   FE 7F                  CP   7Fh   
0509   28 40                  JR   Z,bsp   ; DEL
050B   FE 20                  CP   " "   
050D   30 56                  JR   NC,insc   
050F   FE 09                  CP   9   
0511   28 52                  JR   Z,insc   ; Tab is text
0513   FE 08                  CP   8   
0515   28 34                  JR   Z,bsp   
0517   FE 02                  CP   2   
0519   28 C7                  JR   Z,left   ; ^B
051B   FE 06                  CP   6   
051D   28 97                  JR   Z,right   ; ^F
051F   FE 1B                  CP   1Bh   
0521   28 9B                  JR   Z,esc   
0523   E5                     PUSH   HL   ; a command key? Look it up
0524   21 98 05               LD   HL,cmds   
0527   06 08                  LD   B,NCMD   
0529   BE           ED2:      CP   (HL)   
052A   23                     INC   HL   
052B   28 07                  JR   Z,ed3   
052D   23                     INC   HL   
052E   23                     INC   HL   
052F   10 F8                  DJNZ   ed2   
0531   E1                     POP   HL   
0532   18 D0                  JR   ed1   ; no: the key is ignored
0534   7E           ED3:      LD   A,(HL)   
0535   23                     INC   HL   
0536   66                     LD   H,(HL)   
0537   6F                     LD   L,A   
0538   E3                     EX   (SP),HL   ; the command's address: fin returns to it
0539                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
0539                             ; terminal. Leaves BC -> the line and HL -> the NUL.
0539   26 0A        FIN:      LD   H,LETPAGE   
053B   6B                     LD   L,E   
053C   36 0D                  LD   (HL),13   
053E   2C                     INC   L   
053F   36 0A                  LD   (HL),10   
0541   2D                     DEC   L   
0542   CD 96 06               CALL   prl   ; (prints the CR LF)
0545   36 00                  LD   (HL),0   
0547   01 80 0A               LD   BC,LINEBUF   
054A   C9                     RET      
054B                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
054B                             ; left, the rest of the line moves down over it, and the last place (now a
054B                             ; space) is printed over along with the rest.
054B   7D           BSP:      LD   A,L   
054C   87                     ADD   A,A   
054D   28 B5                  JR   Z,ed1   ; at the start
054F   2D                     DEC   L   
0550   3E 08                  LD   A,8   
0552   EF                     RST   28h   
0553   E5                     PUSH   HL   
0554   2C           BS1:      INC   L   
0555   7E                     LD   A,(HL)   
0556   2D                     DEC   L   
0557   77                     LD   (HL),A   
0558   2C                     INC   L   
0559   7D                     LD   A,L   
055A   BB                     CP   E   
055B   20 F7                  JR   NZ,bs1   
055D   2D                     DEC   L   
055E   36 20                  LD   (HL)," "   
0560   E1                     POP   HL   
0561   53                     LD   D,E   
0562   1D                     DEC   E   
0563   18 15                  JR   ic2   
0565                             ; A character goes in at the cursor: it ripples up through the rest of the
0565                             ; line, the cursor moves on, and the rest is printed again.
0565   47           INSC:     LD   B,A   
0566   7B                     LD   A,E   
0567   FE FD                  CP   0FDh   
0569   28 99                  JR   Z,ed1   ; the line is full: 125 characters
056B   78                     LD   A,B   
056C   EF                     RST   28h   
056D   E5                     PUSH   HL   
056E   7E           IC1:      LD   A,(HL)   
056F   70                     LD   (HL),B   
0570   47                     LD   B,A   
0571   7D                     LD   A,L   
0572   2C                     INC   L   
0573   BB                     CP   E   
0574   20 F8                  JR   NZ,ic1   
0576   E1                     POP   HL   
0577   2C                     INC   L   
0578   1C                     INC   E   
0579   53                     LD   D,E   
057A   CD 7F 05     IC2:      CALL   tail   
057D   18 85                  JR   ed1   
057F                             ; tail: print the line from the cursor to D (a low byte), and bring the
057F                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
057F   4D           TAIL:     LD   C,L   
0580   7D           TA1:      LD   A,L   
0581   BA                     CP   D   
0582   28 05                  JR   Z,ta2   
0584   7E                     LD   A,(HL)   
0585   EF                     RST   28h   
0586   2C                     INC   L   
0587   18 F7                  JR   ta1   
0589   7D           TA2:      LD   A,L   
058A   B9                     CP   C   
058B   C8                     RET   Z   
058C   3E 08                  LD   A,8   
058E   EF                     RST   28h   
058F   2D                     DEC   L   
0590   18 F7                  JR   ta2   
0592                             ; ekey: wait for a key
0592   CD 9B 04     EKEY:     CALL   rawk   
0595   28 FB                  JR   Z,ekey   
0597   C9                     RET      
0598                             ; The command keys, and where each goes (after fin).
0598   0D           CMDS:     DB   13   
0599   E4 05                  DW   cret   
059B   07                     DB   7   ; ^G
059C   2C 06                  DW   crun   
059E   0C                     DB   12   ; ^L
059F   3E 06                  DW   clist   
05A1   05                     DB   5   ; ^E
05A2   BD 05                  DW   cedln   
05A4   12                     DB   18   ; ^R
05A5   29 07                  DW   cread   
05A7   17                     DB   23   ; ^W
05A8   9F 06                  DW   cwrite   
05AA   0E                     DB   14   ; ^N
05AB   B0 05                  DW   cnew   
05AD   18                     DB   24   ; ^X
05AE   00 00                  DW   LEAVE   
05B0                NCMD:     EQU   8   
05B0                             ; ^N ^N: no program, if the next key is ^N too
05B0   CD 92 05     CNEW:     CALL   ekey   
05B3   FE 0E                  CP   14   
05B5   20 04                  JR   NZ,ged0   
05B7   AF                     XOR   A   
05B8   32 00 0B               LD   (PROG),A   
05BB   18 6C        GED0:     JR   gedit   
05BD                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
05BD                             ; line it was: Return puts the text back in its place.
05BD   CD 15 03     CEDLN:    CALL   rdnum   
05C0   22 3A 0A               LD   (EDLN),HL   ; (no such line: `edit` clears it again)
05C3   CD 7E 06               CALL   find   ; HL -> the line, or the NUL if there is none
05C6   7E                     LD   A,(HL)   
05C7   B7                     OR   A   
05C8   28 F1                  JR   Z,ged0   
05CA   11 80 0A               LD   DE,LINEBUF   
05CD   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
05CE   FE 0D                  CP   13   
05D0   28 0D                  JR   Z,ce2   
05D2   FE 0A                  CP   10   
05D4   28 09                  JR   Z,ce2   
05D6   12                     LD   (DE),A   
05D7   EF                     RST   28h   
05D8   23                     INC   HL   
05D9   1C                     INC   E   
05DA   7B                     LD   A,E   
05DB   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
05DD   20 EE                  JR   NZ,ce1   
05DF   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
05E0   5D                     LD   E,L   
05E1   C3 04 05               JP   ed1   
05E4                             ; Return. If ^E put a line here, the text goes back in its place. If not:
05E4                             ; a number and text is a line to put in, a number alone a line to take out,
05E4                             ; and anything else is run where it is.
05E4   E5           CRET:     PUSH   HL   ; the end of what was typed
05E5   2A 3A 0A               LD   HL,(EDLN)   
05E8   7C                     LD   A,H   
05E9   B5                     OR   L   
05EA   28 07                  JR   Z,cr1   
05EC   E5                     PUSH   HL   
05ED   CD 6E 06               CALL   delln   
05F0   E1                     POP   HL   
05F1   18 13                  JR   ins   
05F3   CD 15 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
05F6   79                     LD   A,C   ; C is still 80h if there was no number:
05F7   87                     ADD   A,A   ;   only then is twice it 0
05F8   28 36                  JR   Z,st0p   ; no number: run the line
05FA   0A                     LD   A,(BC)   
05FB   FE 0D                  CP   13   
05FD   20 06                  JR   NZ,cr2   
05FF   D1                     POP   DE   ; the number alone: take that line out
0600   CD 6E 06               CALL   delln   
0603   18 24                  JR   gedit   
0605   03           CR2:      INC   BC   ; step over the one character after the number
0606                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0606                             ; CR and LF included, and copy it in.
0606   CD 7E 06     INS:      CALL   find   ; HL -> where it goes
0609   D1                     POP   DE   ; the end of what was typed
060A   7B                     LD   A,E   
060B   91                     SUB   C   ; A = the length of the text, with its CR LF
060C   C5                     PUSH   BC   ; the text
060D   4F                     LD   C,A   
060E   06 00                  LD   B,0   
0610   C5                     PUSH   BC   ; its length
0611   54                     LD   D,H   
0612   5D                     LD   E,L   ; DE = where it goes
0613   AF                     XOR   A   
0614   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0615   ED B1                  CPIR      ; HL -> one past the program's NUL
0617   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0619   44                     LD   B,H   
061A   4D                     LD   C,L   
061B   19                     ADD   HL,DE   
061C   2B                     DEC   HL   ; HL -> the NUL
061D   EB                     EX   DE,HL   
061E   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
061F   E5                     PUSH   HL   
0620   19                     ADD   HL,DE   ; the NUL's new place
0621   EB                     EX   DE,HL   
0622   ED B8                  LDDR      ; move the rest of the program up
0624   C1                     POP   BC   ; the length
0625   D1                     POP   DE   ; where it goes
0626   E1                     POP   HL   ; the text
0627   ED B0                  LDIR      
0629   C3 F2 04     GEDIT:    JP   edit   
062C                             ; ^G: run the program. st0p: run the typed line (BC -> it).
062C   01 00 0B     CRUN:     LD   BC,PROG   
062F   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
0630   E1           ST0P:     POP   HL   ; (the end of what was typed)
0631                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0631   21 00 0B     ST0:      LD   HL,PROG   
0634   AF                     XOR   A   
0635   BE           ST1:      CP   (HL)   
0636   23                     INC   HL   
0637   20 FC                  JR   NZ,st1   
0639   22 7C 0A               LD   (HEAP),HL   
063C                          ENDIF      
063C                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
063C                          ENDIF      
063C                          IF   EDITOR   
063C   E1                     POP   HL   ; TOS: the data stack is as the last line left it
063D   F7                     RST   30h   ; (its return address is thrown away)
063E                             ; ^L: list from line n. DE = the number of the line at HL.
063E   CD 15 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
0641   7C                     LD   A,H   
0642   B5                     OR   L   
0643   20 01                  JR   NZ,li0   
0645   2C                     INC   L   ;   then from line 1
0646   E5           LI0:      PUSH   HL   
0647   CD 7E 06               CALL   find   
064A   D1                     POP   DE   
064B   7E           LI1:      LD   A,(HL)   
064C   B7                     OR   A   
064D   28 DA                  JR   Z,gedit   ; the end of the text
064F   CD 9B 04               CALL   rawk   
0652   28 09                  JR   Z,li3   ; no key: carry on
0654   FE 03                  CP   3   
0656   C4 92 05               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
0659   FE 03                  CP   3   
065B   28 CC                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
065D   E5           LI3:      PUSH   HL   
065E   D5                     PUSH   DE   
065F   EB                     EX   DE,HL   
0660   CD 60 03               CALL   pdec   ; the line's number,
0663   3E 20                  LD   A," "   
0665   EF                     RST   28h   ;   a space,
0666   D1                     POP   DE   
0667   E1                     POP   HL   
0668   13                     INC   DE   
0669   CD 96 06               CALL   prl   ;   and the line
066C   18 DD                  JR   li1   
066E                             ; delln: take line n (in HL) out: copy everything after it down over it.
066E   CD 7E 06     DELLN:    CALL   find   
0671   54                     LD   D,H   
0672   5D                     LD   E,L   
0673   CD 8C 06               CALL   nxl   ; HL -> the next line
0676   7E           DE1:      LD   A,(HL)   
0677   12                     LD   (DE),A   
0678   23                     INC   HL   
0679   13                     INC   DE   
067A   B7                     OR   A   
067B   20 F9                  JR   NZ,de1   
067D   C9                     RET      
067E                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
067E                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
067E   EB           FIND:     EX   DE,HL   
067F   21 00 0B               LD   HL,PROG   
0682   1B           FI1:      DEC   DE   
0683   7A                     LD   A,D   
0684   B3                     OR   E   
0685   C8                     RET   Z   
0686   CD 8C 06               CALL   nxl   
0689   20 F7                  JR   NZ,fi1   
068B   C9                     RET      
068C                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
068C                             ; stop at the NUL that ends the text (and return zero).
068C   7E           NXL:      LD   A,(HL)   
068D   B7                     OR   A   
068E   C8                     RET   Z   
068F   23                     INC   HL   
0690   FE 0A                  CP   10   
0692   20 F8                  JR   NZ,nxl   
0694   B7                     OR   A   
0695   C9                     RET      
0696                             ; prl: print the line at HL, to its LF; HL -> just past it.
0696   7E           PRL:      LD   A,(HL)   
0697   EF                     RST   28h   
0698   7E                     LD   A,(HL)   
0699   23                     INC   HL   
069A   FE 0A                  CP   10   
069C   20 F8                  JR   NZ,prl   
069E   C9                     RET      
069F                          ENDIF      
069F                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                    GED1:     JP   edit   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
069F                          ENDIF      
069F                          IF   EDITOR*CPM   
069F                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
069F                             ;   put the one from the command line
069F                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
069F                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
069F                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
069F                             ; full disk or directory is not noticed: the calls fail and that is all.)
069F   CD F0 06     CWRITE:   CALL   setname   
06A2   0E 13                  LD   C,19   ; delete
06A4   CD D8 06               CALL   fbdos   
06A7   0E 16                  LD   C,22   ; make
06A9   CD D8 06               CALL   fbdos   
06AC   21 00 0B               LD   HL,PROG   
06AF   AF                     XOR   A   
06B0   BE           CW1:      CP   (HL)   
06B1   23                     INC   HL   
06B2   20 FC                  JR   NZ,cw1   
06B4   2B                     DEC   HL   ; HL -> the NUL
06B5   E5                     PUSH   HL   
06B6   06 80                  LD   B,128   
06B8   36 1A        CW2:      LD   (HL),1Ah   
06BA   23                     INC   HL   
06BB   10 FB                  DJNZ   cw2   
06BD   E1                     POP   HL   
06BE   11 00 0B               LD   DE,PROG   
06C1   7B           CW3:      LD   A,E   ; a record that starts before the end is written
06C2   95                     SUB   L   
06C3   7A                     LD   A,D   
06C4   9C                     SBC   A,H   
06C5   30 09                  JR   NC,cw4   
06C7   E5                     PUSH   HL   
06C8   0E 15                  LD   C,21   ; write, from where the record lies
06CA   CD DE 06               CALL   frec   
06CD   E1                     POP   HL   
06CE   18 F1                  JR   cw3   
06D0   36 00        CW4:      LD   (HL),0   ; the NUL again
06D2   0E 10                  LD   C,16   ; close,
06D4   21 F2 04               LD   HL,edit   ;   and from there back to the editor
06D7   E5                     PUSH   HL   
06D8                             ; fbdos: BDOS function C on the file. (^W ends by running on into it.)
06D8   11 5C 00     FBDOS:    LD   DE,CFCB   
06DB   C3 05 00               JP   BDOS   
06DE                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
06DE                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
06DE   D5           FREC:     PUSH   DE   
06DF   C5                     PUSH   BC   
06E0   0E 1A                  LD   C,26   ; set the DMA address
06E2   CD 05 00               CALL   BDOS   
06E5   C1                     POP   BC   
06E6   CD D8 06               CALL   fbdos   
06E9   D1                     POP   DE   
06EA   21 80 00               LD   HL,128   
06ED   19                     ADD   HL,DE   
06EE   EB                     EX   DE,HL   
06EF   C9                     RET      
06F0                             ; setname: if a name was typed (the line does not start with its CR), put it
06F0                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
06F0                             ; is the current one. Then, name or no name, clear the FCB after the name,
06F0                             ; as it must be before a file is opened or made.
06F0   11 80 0A     SETNAME:   LD   DE,LINEBUF   
06F3   1A                     LD   A,(DE)   
06F4   FE 0D                  CP   13   
06F6   28 26                  JR   Z,fcbclr   
06F8   21 5C 00               LD   HL,CFCB   
06FB   36 00                  LD   (HL),0   ; the current drive
06FD   06 0B                  LD   B,11   
06FF   2C           SN1:      INC   L   
0700   36 20                  LD   (HL)," "   
0702   10 FB                  DJNZ   sn1   
0704   2E 5D                  LD   L,CFCB+1   
0706   1A           SN2:      LD   A,(DE)   
0707   13                     INC   DE   
0708   FE 0D                  CP   13   
070A   28 12                  JR   Z,fcbclr   
070C   FE 2E                  CP   "."   
070E   20 04                  JR   NZ,sn3   
0710   2E 65                  LD   L,CFCB+9   ; the type
0712   18 F2                  JR   sn2   
0714   FE 61        SN3:      CP   "a"   
0716   38 02                  JR   C,sn4   
0718   E6 5F                  AND   5Fh   ; a capital
071A   77           SN4:      LD   (HL),A   
071B   2C                     INC   L   
071C   18 E8                  JR   sn2   
071E   21 68 00     FCBCLR:   LD   HL,CFCB+12   
0721   06 18                  LD   B,24   
0723   36 00        FC1:      LD   (HL),0   
0725   23                     INC   HL   
0726   10 FB                  DJNZ   fc1   
0728   C9                     RET      
0729                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
0729                             ; from now on. It runs on into load, which returns to the editor.
0729   CD F0 06     CREAD:    CALL   setname   
072C   21 F2 04               LD   HL,edit   
072F   E5                     PUSH   HL   
0730                             ; load: read the file into PROG. No such file: no program. The text ends at
0730                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0730                             ; goes after the last record, so the search always stops. And every line
0730                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
0730                             ; clear after its name: the CCP left it so, or setname did.)
0730   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
0732   CD D8 06               CALL   fbdos   ;   too)
0735   11 00 0B               LD   DE,PROG   
0738   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
073A   CD DE 06               CALL   frec   
073D   B7                     OR   A   
073E   28 F8                  JR   Z,ld1   
0740   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
0742   21 FF 0A               LD   HL,PROG-1   
0745   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
0747   23           TR1:      INC   HL   
0748   5F                     LD   E,A   ; E = the character before this one
0749   7E                     LD   A,(HL)   
074A   FE 1A                  CP   1Ah   
074C   20 F9                  JR   NZ,tr1   
074E   7B                     LD   A,E   
074F   FE 0A                  CP   10   
0751   28 06                  JR   Z,tr2   
0753   36 0D                  LD   (HL),13   
0755   23                     INC   HL   
0756   36 0A                  LD   (HL),10   
0758   23                     INC   HL   
0759   36 00        TR2:      LD   (HL),0   
075B   C9                     RET      
075C                          ENDIF      
075C                             ; =============================================================================
075C                          IF   CPM   
075C                             ; The RAM pages follow the image; the heap may grow to the BDOS.
075C                START:       
075C                          ENDIF      
075C                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
075C                          ENDIF      
075C                          IF   CPM   
075C   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
075F   11 08 00               LD   DE,0008h   
0762   01 2C 00               LD   BC,vecend-vecs   
0765   ED B0                  LDIR      
0767                          ENDIF      
0767                          IF   CPM*EDITOR   
0767   CD 30 07               CALL   load   ; the file named on the command line
076A   C3 EC 04               JP   edit0   
076D                          ENDIF      
076D                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
076D                          ENDIF      
076D                          IF   CPM   
076D                             ; RAM pages, after the image
076D                RSPAGE:   EQU   (imgend + 255) / 256   
076D                DSPAGE:   EQU   RSPAGE + 1   
076D                LETPAGE:   EQU   RSPAGE + 2   
076D                PROG:     EQU   LETPAGE*256 + 256   
076D                          ENDIF      
076D                IMGEND:      


