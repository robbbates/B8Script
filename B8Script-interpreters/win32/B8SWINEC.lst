   702                              <1> 
   703                              <1> ; '?' ( n -- c ) or ( -n -- addr )
   704                              <1> ;   n > 0: wait about n ms for a key; 0 if none came
   705                              <1> ;   n = 0: wait for a key
   706                              <1> ;   n < 0: read a line of at most -n characters (127 at most), with echo
   707 000001EC 84FF                <1> h_key:  test    bh,bh
   708 000001EE 0F8854040000        <1>         js      line
