  1014 000004BD 53                  <1>         push    ebx
  1015 000004BE FF755A              <1>         push    dword [V(v_hin)]
  1016 000004C1 FF55B2              <1>         call    [V(iat_WaitForSingleObject)]
  1017 000004C4 85C0                <1>         test    eax,eax
  1018 000004C6 7559                <1>         jnz     .wk8                    ; WAIT_TIMEOUT: no key
  1019 000004C8 8D4556              <1>         lea     eax,[V(v_cnt)]
  1020 000004CB 50                  <1>         push    eax
  1021 000004CC 6A01                <1>         push    1
