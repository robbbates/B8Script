   809                              <1> ; =============================================================================
   810                              <1> ;  Checked build: the checks and the error report (here, so that the
   811                              <1> ;  handlers' bodies above reach the error entries with short jumps)
   812                              <1> ; =============================================================================
   813                              <1> %if CHECKED
   814                              <1> e_zero: mov     al,'Z'                  ; dividing by zero
   815                              <1>         jmp     error
   816                              <1> e_heap: mov     al,'H'                  ; the heap
   817                              <1>         jmp     error
   818                              <1> 
   819                              <1> ; chkst1, chkst2: stop with O unless the 1 or 2 bytes at TOS are in the
   820                              <1> ; program's space: from the letter page up to the heap limit. Memory above
   821                              <1> ; the heap top but below the limit is the program's own: Tiny BASIC keeps
   822                              <1> ; its lines there.
   823                              <1> chkst2: mov     eax,ebx
   824                              <1>         sub     ax,LET
   825                              <1>         cmp     ax,LIMIT-LET-1
   826                              <1>         jmp     short chs1
   827                              <1> chkst1: mov     eax,ebx
   828                              <1>         sub     ax,LET
   829                              <1>         cmp     ax,LIMIT-LET
   830                              <1> chs1:   jae     e_store
   831                              <1>         ret
   832                              <1> 
   833                              <1> ; chkstk: both stacks are checked once per character, not in every handler.
   834                              <1> ; A character can pop a cell or two too many, or push one too many, before
   835                              <1> ; it is seen here: the data stack has the caller's frame above it and the
   836                              <1> ; thread's stack below, and the return stack has the image's spare space on
   837                              <1> ; both sides.
   838                              <1> chkstk: lea     eax,[esp+4]
   839                              <1>         sub     eax,[V(v_dstop)]        ; minus 4 x the depth
   840                              <1>         jg      e_under
   841                              <1>         cmp     eax,-4*DSMAX
   842                              <1>         jl      e_over
   843                              <1>         cmp     di,RSTOP & 0FFFFh       ; (the return stack is in one 64K: only
   844                              <1>         ja      e_rund                  ;   the low word changes)
   845                              <1>         cmp     di,(RSTOP-4*RSMAX) & 0FFFFh
   846                              <1>         jb      e_rover
   847                              <1>         ret
   848                              <1> e_under:mov     esp,[V(v_dstop)]        ; data stack underflow: it counts as
   849                              <1>         mov     al,'s'                  ;   empty
   850                              <1>         jmp     short error
   851                              <1> e_rund: mov     edi,RSTOP               ; return stack underflow: the same.
   852                              <1>         or      esi,ARENA               ;   (A ']' or ')' may have taken an IP
   853                              <1>         mov     al,'r'                  ;   of 0 from below the stack: keep the
   854                              <1>                                         ;   place readable)
   855                              <1>         jmp     short errp
   856                              <1> e_rover:mov     al,'R'
   857                              <1>         jmp     short errp
   858                              <1> e_over: mov     al,'S'
   859                              <1>         jmp     short errp
   860                              <1> e_break:mov     al,'B'                  ; Ctrl-C (inside pollk or getk)
   861                              <1>         jmp     short errp
   862                              <1> e_store:mov     al,'O'                  ; a store outside the program's space
   863                              <1>         jmp     short errp
   864                              <1> ; e_dollar: '$' ran into a NUL: Q, with the string's address TOS again. But
   865                              <1> ; if its /~ escapes took cells that weren't there, that is s (as the next
   866                              <1> ; character's check would have said).
