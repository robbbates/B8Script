   563 0000011C E809030000          <1>         call    skip
   564 00000121 84C0                <1>         test    al,al                   ; skip returns 0 for ')'
   565 00000123 75EC                <1>         jnz     h_ret
   566 00000125 EBEC                <1>         jmp     rdrop
   567                              <1> 
   568                              <1> ; ')' ( flag -- ): true jumps back to the block start (and keeps it); false
   569                              <1> ; drops it and carries on. The loop-back looks at the break key.
   570 00000127 6685DB              <1> h_close:test    bx,bx
   571 0000012A 5B                  <1>         pop     ebx
   572 0000012B 74E6                <1>         jz      rdrop
