                    GETK:     EQU   KEY   ; the host's routine does the whole job
F198                          ENDIF      
F198                             ; ---- where the two ranges meet ---------------------------------------------
F198                             ; The first range ends somewhere among the next five handlers, ] \ [ @ ?
F198                             ; (they are in falling code order for this): NPG1 follows. Every handler
F198                             ; below them must start in the second range, and every one above in the
F198                             ; first.
F198                             ; "]" returns: pop an address and jump to it. (PULS X,Y: the dispatcher's
F198                             ; return address into X, then the saved IP into Y.)
F198                H_RET:       
F198                          IF   CHECKED   
F198   BD F3 92               JSR   chkbrk   ; Ctrl-C is checked at every word return
F19B                          ENDIF      
F19B   35 30                  PULS   X,Y   
F19D   6E 84                  JMP   ,X   
F19F                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F19F                             ; drops the block start, "]" returns. No closer at all ends the program.
F19F   EC C1        H_BREAK:   LDD   ,U++   
F1A1   27 47                  BEQ   sk9   ; false: nothing to do
F1A3   8D 26                  BSR   skip   
F1A5   4D                     TSTA      ; skip returns 0 for ")"
F1A6   26 F0                  BNE   h_ret   
F1A8   35 16        RDROP:    PULS   D,X   ; the return address and the block start
F1AA   1F 05                  TFR   D,PC   ; back to the dispatcher
F1AC                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F1AC                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F1AC                             ; the body"s address instead. Either way it then skips to the matching "]'.
F1AC                             ; (The unchecked build takes anything that is not a letter as the space; the
F1AC                             ; checked build stops on it.)
F1AC                          IF   CHECKED   
F1AC   81 DF        DEF1:     CMPA   #" "-"A"+256   
F1AE   27 19                  BEQ   def2   
F1B0   16 FE 5C               LBRA   e_brack   ; anything but a letter or a space
F1B3                          ENDIF      
F1B3   A6 A0        H_DEF:    LDA   ,Y+   
F1B5   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
F1B7   1F 89                  TFR   A,B   ;   lands 64 bytes up
F1B9   C4 DF                  ANDB   #0DFh   ; fold case
F1BB   C1 1A                  CMPB   #26   
F1BD                          IF   1-CHECKED   
                              BHS   def2   ; not a letter
F1BD                          ENDIF      
F1BD                          IF   CHECKED   
F1BD   24 ED                  BHS   def1   
F1BF                          ENDIF      
F1BF   BD F0 B3               JSR   cellx   
F1C2   1F 20                  TFR   Y,D   
F1C4   E7 84                  STB   ,X   ; little-endian
F1C6   A7 01                  STA   1,X   
F1C8   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F1C9   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F1CB                             ; fall into skip
F1CB                             ; skip: read past text to the closer at this level, and return A = 0 if it
F1CB                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F1CB                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
F1CB                             ; no closer; anything else that runs into the NUL had unbalanced brackets
F1CB                             ; anyway). B counts the open levels.
F1CB   5F           SKIP:     CLRB      
F1CC   A6 A0        SK1:      LDA   ,Y+   
F1CE   10 27 FE 62            LBEQ   fin   
F1D2   81 22                  CMPA   #22h   
F1D4   26 02                  BNE   sk2   
F1D6   8D 79                  BSR   skipstr   ; leaves A = 22h, which matches nothing below
F1D8   80 28        SK2:      SUBA   #"("   
F1DA   27 0F                  BEQ   sk3   
F1DC   4A                     DECA      ; ")"
F1DD   27 08                  BEQ   sk4   
F1DF   80 32                  SUBA   #"["-")"   
F1E1   27 08                  BEQ   sk3   
F1E3   81 02                  CMPA   #"]"-"["   
F1E5   26 E5                  BNE   sk1   
F1E7   5A           SK4:      DECB      
F1E8   2A E2                  BPL   sk1   
F1EA   39           SK9:      RTS      ; the closer at this level
F1EB   5C           SK3:      INCB      
F1EC   20 DE                  BRA   sk1   
F1EE   AE C4        H_FETCH:   LDX   ,U   ; "@" (the cell in memory is little-endian)
F1F0   A6 01                  LDA   1,X   
F1F2   20 6B                  BRA   cf1   
F1F4                             ; "?" ( n -- c ) or ( -n -- addr )
F1F4                             ;   n > 0: wait about n ms for a key; 0 if none came
F1F4                             ;   n = 0: wait for a key
F1F4                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
F1F4                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
F1F4   AE C4        H_KEY:    LDX   ,U   
F1F6   2B 17                  BMI   line   
F1F8   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F1FA   BD F3 9F     KT2:      JSR   getk   
F1FD   26 0B                  BNE   kt3   
F1FF   5A                     DECB      
F200   26 F8                  BNE   kt2   
F202   30 1F                  LEAX   -1,X   
F204   26 F2                  BNE   kt1   ; A = 0 if the time ran out
F206   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F208   27 EE                  BEQ   kt1   ;   run it again, until a key comes
F20A   6F C4        KT3:      CLR   ,U   
F20C   A7 41                  STA   1,U   
F20E   39                     RTS      
F20F                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F20F                             ; (stored, not echoed), every other key is stored and echoed until the line
F20F                             ; is full. B = the length so far; the low byte of the top cell becomes the
F20F                             ; most allowed (it holds minus the count on entry).
F20F   8C FF 81     LINE:     CMPX   #-127   ; (X = TOS, minus the count)
F212   24 04                  BHS   ln1   
F214   86 81                  LDA   #-127   ; more than 127 is taken as 127
F216   A7 41                  STA   1,U   
F218   60 41        LN1:      NEG   1,U   
F21A   8E 82 80               LDX   #LINEBUF   
F21D   5F                     CLRB      
F21E   BD F3 9F     LN2:      JSR   getk   
F221   27 FB                  BEQ   ln2   
F223   81 0D                  CMPA   #13   
F225   27 16                  BEQ   ln5   
F227   81 08                  CMPA   #8   
F229   27 0C                  BEQ   ln4   
F22B   E1 41                  CMPB   1,U   
F22D   24 EF                  BHS   ln2   ; full
F22F   A7 85                  STA   B,X   
F231   5C                     INCB      
F232   BD FF 03     LN3:      JSR   CONOUT   
F235   20 E7                  BRA   ln2   
F237   5D           LN4:      TSTB      ; Backspace: nothing to take back?
F238   27 E4                  BEQ   ln2   
F23A   5A                     DECB      
F23B   20 F5                  BRA   ln3   ; echo it
F23D   A7 85        LN5:      STA   B,X   ; A = 13
F23F   AF C4                  STX   ,U   
F241   39                     RTS      
F242                             ; =============================================================================
F242                             ;  Handlers that must start in the second range (unchecked build).
F242                             ; =============================================================================
F242                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
F242                             ; the matching ")".
F242   EC C1        H_OPEN:   LDD   ,U++   
F244   27 85                  BEQ   skip   ; tail call: skip ends in RTS
F246   35 10                  PULS   X   
F248   34 20                  PSHS   Y   
F24A   6E 84                  JMP   ,X   
F24C                             ; 22h pushes the address of the text after it and skips the string.
F24C   36 20        H_STR:    PSHU   Y   
F24E   8C                     FCB   8Ch   ; (CMPX #: steps over the LEAY)
F24F                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
F24F                             ; the next character, so "/"" does not end it. Leaves A = 22h.
F24F   31 21        SS0:      LEAY   1,Y   
F251   A6 A0        SKIPSTR:   LDA   ,Y+   
F253   81 2F                  CMPA   #"/"   
F255   27 F8                  BEQ   ss0   
F257   81 22                  CMPA   #22h   
F259   26 F6                  BNE   skipstr   
F25B   39                     RTS      
F25C   AE C4        H_CFETCH:   LDX   ,U   ; ","
F25E   4F                     CLRA      
F25F   E6 84        CF1:      LDB   ,X   
F261   ED C4                  STD   ,U   
F263   39                     RTS      
F264                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F264                             ; drops it and carries on.
F264   EC C1        H_CLOSE:   LDD   ,U++   
F266   10 27 FF 3E            LBEQ   rdrop   
F26A                          IF   CHECKED   
F26A   BD F3 92               JSR   chkbrk   ; Ctrl-C is checked at every loop-back
F26D                          ENDIF      
F26D   10 AE 62               LDY   2,S   ; the block start, under the return address
F270   39                     RTS      
F271                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
F271                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F271                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F271   A6 43        H_MUL:    LDA   3,U   
F273   E6 C4                  LDB   ,U   
F275   3D                     MUL      ; al*bh
F276   E7 C4                  STB   ,U   ; (bh is no longer needed)
F278   A6 42                  LDA   2,U   
F27A   E6 41                  LDB   1,U   
