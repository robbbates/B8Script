0569                          IF   CPM   
0569                             ; RAM pages, after the image
0569                CPAGE:    EQU   (imgend + 255) / 256   ; the skip cache (QK builds), first, so
0569                RSPAGE:   EQU   CPAGE + QK   ;   that the letter page is still the one
0569                DSPAGE:   EQU   RSPAGE + 1   ;   just below the program text
0569                LETPAGE:   EQU   RSPAGE + 2   
0569                PROG:     EQU   LETPAGE*256 + 256   
0569                          ENDIF      
