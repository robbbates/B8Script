034D   CD 7C 03     G_CUR:    CALL   csi   
0350   3E 3F                  MVI   A,"?"   
0352   EF                     RST   5   
0353   3E 32                  MVI   A,"2"   
0355   EF                     RST   5   
0356   3E 35                  MVI   A,"5"   
0358   EF                     RST   5   
0359   7C                     MOV   A,H   
035A   B5                     ORA   L   
035B   3E 6C                  MVI   A,"l"   
035D   CA 62 03               JZ   gc1   
0360   3E 68                  MVI   A,"h"   
0362   EF           GC1:      RST   5   
0363   DF                     RST   3   
0364                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
0364   D1           G_AT:     POP   D   ; DE = the row
0365   C5                     PUSH   B   ; (pdec uses BC)
0366   E5                     PUSH   H   ; the column
0367   EB                     XCHG      
0368   CD 7C 03               CALL   csi   
036B   23                     INX   H   
036C   CD 90 03               CALL   pdec   
036F   3E 3B                  MVI   A,";"   
0371   EF                     RST   5   
0372   E1                     POP   H   
0373   23                     INX   H   
0374   CD 90 03               CALL   pdec   
0377   3E 48                  MVI   A,"H"   
0379   EF                     RST   5   
037A   C1                     POP   B   
037B   DF                     RST   3   
