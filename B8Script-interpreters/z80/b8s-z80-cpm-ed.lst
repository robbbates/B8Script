052E                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
052E   4D           TAIL:     LD   C,L   
052F   7D           TA1:      LD   A,L   
0530   BA                     CP   D   
0531   28 05                  JR   Z,ta2   
0533   7E                     LD   A,(HL)   
0534   EF                     RST   28h   
0535   2C                     INC   L   
0536   18 F7                  JR   ta1   
0538   7D           TA2:      LD   A,L   
0539   B9                     CP   C   
053A   C8                     RET   Z   
053B   3E 08                  LD   A,8   
053D   EF                     RST   28h   
053E   2D                     DEC   L   
053F   18 F7                  JR   ta2   
0541                             ; ekey: wait for a key
0541   CD D0 03     EKEY:     CALL   rawk   
0544   28 FB                  JR   Z,ekey   
0546   C9                     RET      
0547                             ; The command keys, and where each goes (after fin).
0547   0D           CMDS:     DB   13   
0548   A1 05                  DW   cret   
054A   07                     DB   7   ; ^G
054B   E9 05                  DW   crun   
054D   0C                     DB   12   ; ^L
054E   FB 05                  DW   clist   
0550   05                     DB   5   ; ^E
0551   70 05                  DW   cedln   
0553   12                     DB   18   ; ^R
0554   C7 06                  DW   cread   
0556   17                     DB   23   ; ^W
0557   D0 06                  DW   cwrite   
