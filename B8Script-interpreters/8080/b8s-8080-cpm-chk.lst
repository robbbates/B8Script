0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;  A port of the Z80 interpreter (z80/b8s-z80.asm); same behaviour, same
0000                             ;  memory map, same switches.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (CONIN/CONOUT/CONST at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpush and rpop (and the checks) touch it; both
0000                             ;  destroy HL, so each caller makes sure TOS is parked or dead first.
0000                             ; 
0000                             ;  (asm80 wants the vector number: RST 1 = RST 08h, RST 2 = RST 10h.)
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JMP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP D to throw the return address away.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LETPAGE..heap top.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    CONIN:    EQU   0FF00h   ; wait for a key, return it in A
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    CONST:    EQU   0FF06h   ; A = 0 if no key is waiting, else nonzero
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   All three console routines must preserve BC, DE and HL.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and CONST (~100 states each)
0000                CAP:      EQU   127   ; -n? reads at most this many characters
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
0100                          .ORG   0100h   
0100   C3 35 05               JMP   start   
0103                          ENDIF      
0103                          IFN   CPM   
                              .ORG   0000h   
                              LXI   SP,DSTOP   ; 0000h reset: the stack first,
                              JMP   start   ;   then the rest of the startup
                    H_SWAP:   XTHL      ; 0006h the two-byte handlers fill the gaps
                              RST   2   ;   between the vectors
                                 ; ---- RST 08h: drop TOS, then next ------------------------------------------
                              POP   D   ; 0008h discard the RST's return address
                    DROP_NEXT:      
                              POP   H   ; new TOS = NOS
                              JMP   next0   
                    H_DUP:    PUSH   H   ; 000Dh
                              RST   2   
                              DB   0   ; 000Fh spare
                                 ; ---- RST 10h: next character ------------------------------------------------
                              POP   D   ; 0010h discard the RST's return address
0103                          ENDIF      
0103                             ; =============================================================================
0103                             ;  The inner loop: read one character and sort it by range.
0103                             ; 
0103                             ;    00h          end of program
0103                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0103                             ;    30h-39h      digit: read a whole number
0103                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0103                             ;    61h-7Ah      a-z: push the address of that letter's cell
0103                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0103                             ; =============================================================================
0103                NEXT0:       
0103                          IF   CHECKED   
0103                             ; Both stacks are checked once per character, not in every handler.
0103                             ; Each stack lives in one page, so it has overrun exactly when the
0103                             ; pointer's high byte has left that page. Errors are caught one cell
0103                             ; late at most; the page below each stack is a guard band.
0103   EB                     XCHG      ; DE = TOS (HL is needed for the pointers)
0104   21 00 00               LXI   H,0   
0107   39                     DAD   SP   
0108   7C                     MOV   A,H   
0109   FE 07                  CPI   DSPAGE   
010B   C2 D7 04               JNZ   e_stack   
010E   2A 34 08               LHLD   RSP   ; the return stack: in its page, and not
0111   7D                     MOV   A,L   ;   above its empty position (an underflow
0112   FE E1                  CPI   RSTOP&0FFh+1   ;   would stay inside the page, in the
0114   D2 DF 04               JNC   e_rstack   ;   guard band)
0117   7C                     MOV   A,H   
0118   FE 06                  CPI   RSPAGE   
011A   C2 DF 04               JNZ   e_rstack   
011D   EB                     XCHG      ; TOS back
011E                          ENDIF      
011E   0A                     LDAX   B   
011F   03                     INX   B   
0120   D6 21                  SUI   21h   ; A = c - 21h
0122   DA 65 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
0125   FE 0F                  CPI   0Fh   
0127   DA 58 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
012A   D6 0F                  SUI   0Fh   ; A = c - 30h
012C   FE 0A                  CPI   0Ah   
012E   DA 82 01               JC   digit   ; 30h-39h
0131   FE 11                  CPI   11h   
0133   D2 3B 01               JNC   ab40   
0136   C6 05                  ADI   5   ; 3Ah-40h: index 15-21
0138   C3 58 01               JMP   punct   
013B   D6 11        AB40:     SUI   11h   ; A = c - 41h
013D   FE 1A                  CPI   1Ah   
013F   DA 73 01               JC   upper   ; 41h-5Ah: A = letter index 0-25
0142   FE 20                  CPI   20h   
0144   D2 4C 01               JNC   ab60   
0147   D6 04                  SUI   4   ; 5Bh-60h: index 22-27
0149   C3 58 01               JMP   punct   
014C   FE 3A        AB60:     CPI   3Ah   
014E   DA 6D 01               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0151   FE 3E                  CPI   3Eh   
0153   D2 03 01               JNC   next0   ; 7Fh-FFh: ignored
0156   D6 1E                  SUI   1Eh   ; 7Bh-7Eh: index 28-31
0158                             ; Punctuation: HL holds TOS, so it is parked on the stack while the table is
0158                             ; read, then swapped for the handler's address: XTHL puts TOS back in HL and
0158                             ; leaves the address on the stack for RET to jump to. The stack is balanced
0158                             ; again when the handler starts. PTAB never crosses a page (checked in the
0158                             ; listing), so only L needs adding.
0158   E5           PUNCT:    PUSH   H   
0159   87                     ADD   A   
015A   C6 88                  ADI   PTAB & 0FFh   
015C   6F                     MOV   L,A   
015D   26 01                  MVI   H,PTAB / 256   
015F   7E                     MOV   A,M   
0160   23                     INX   H   
0161   66                     MOV   H,M   
0162   6F                     MOV   L,A   ; HL = handler
0163   E3                     XTHL      
0164   C9                     RET      
0165   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
0167   C2 03 01               JNZ   next0   
016A                          IF   CPM   
016A   C3 00 00               JMP   endprog   
016D                          ENDIF      
016D                          IFN   CPM   
                    ENDPROG:      
                              JMP   EXIT   ; the program has ended
016D                          ENDIF      
016D                             ; a-z: push the cell's address (the cell is the variable)
016D   E5           LOWER:    PUSH   H   
016E   87                     ADD   A   
016F   6F                     MOV   L,A   
0170   26 08                  MVI   H,LETPAGE   
0172   D7                     RST   2   
0173                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0173                             ; the return stack, and the IP becomes the address in the letter's cell.
0173   E5           UPPER:    PUSH   H   ; keep TOS
0174   87                     ADD   A   
0175   6F                     MOV   L,A   
0176   26 08                  MVI   H,LETPAGE   ; HL -> cell
0178   50                     MOV   D,B   
0179   59                     MOV   E,C   ; DE = return address
017A   4E                     MOV   C,M   
017B   23                     INX   H   
017C   46                     MOV   B,M   ; IP = the word's body
017D   CD DF 01               CALL   rpush   
0180   E1                     POP   H   ; TOS back
0181   D7                     RST   2   
0182                             ; Digits: step back onto the first digit and read the whole number.
0182   E5           DIGIT:    PUSH   H   
0183   0B                     DCX   B   
0184   CD C8 01               CALL   rdnum   
0187   D7                     RST   2   
0188                             ; =============================================================================
0188                             ;  Dispatch table: one handler per punctuation character, in code order.
0188                             ;  It sits right after the inner loop so that it can't cross a page (the
0188                             ;  loop only adds to the low byte of its address).
0188                             ; =============================================================================
0188   E9 02        PTAB:     DW   h_store   ; !
018A   C2 03                  DW   h_str   ; "
018C   EA 03                  DW   h_num   ; #
018E   C9 03                  DW   h_print   ; $
0190   D8 02                  DW   h_swap   ; %
0192   9E 02                  DW   h_and   ; &
0194   E5 03                  DW   h_emit   ; '
0196   24 03                  DW   h_open   ; (
0198   34 03                  DW   h_close   ; )
019A   16 02                  DW   h_mul   ; *
019C   F6 01                  DW   h_add   ; +
019E   F3 02                  DW   h_cfetch   ; ,
01A0   F9 01                  DW   h_sub   ; -
01A2   F7 02                  DW   h_cstore   ; .
01A4   32 02                  DW   h_div   ; /
01A6   0D 00                  DW   h_dup   ; :
01A8   09 00                  DW   drop_next   ; ;
01AA   BC 02                  DW   h_lt   ; <
01AC   CB 02                  DW   h_eq   ; =
01AE   BB 02                  DW   h_gt   ; >
01B0   10 04                  DW   h_key   ; ?
01B2   E4 02                  DW   h_fetch   ; @
01B4   62 03                  DW   h_def   ; [
01B6   48 03                  DW   h_break   ; \
01B8   57 03                  DW   h_ret   ; ]
01BA   AE 02                  DW   h_xor   ; ^
01BC   FD 02                  DW   h_alloc   ; _
01BE   62 04                  DW   h_grave   ; `
01C0   DA 02                  DW   h_tor   ; {
01C2   A6 02                  DW   h_or   ; |
01C4   DF 02                  DW   h_fromr   ; }
01C6   B6 02                  DW   h_not   ; ~
01C8                PTABEND:      
01C8                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
01C8                             ; non-digit. Values wrap at 16 bits, as the spec says.
01C8   21 00 00     RDNUM:    LXI   H,0   
01CB   0A           RDN1:     LDAX   B   
01CC   D6 30                  SUI   "0"   
01CE   FE 0A                  CPI   10   
01D0   D0                     RNC      
01D1   03                     INX   B   
01D2   54                     MOV   D,H   
01D3   5D                     MOV   E,L   
01D4   29                     DAD   H   
01D5   29                     DAD   H   
01D6   19                     DAD   D   
01D7   29                     DAD   H   ; HL * 10
01D8   5F                     MOV   E,A   
01D9   16 00                  MVI   D,0   
01DB   19                     DAD   D   
01DC   C3 CB 01               JMP   rdn1   
01DF                             ; =============================================================================
01DF                             ;  Return stack. rpush pushes DE; rpop pops into HL. RSP is the pointer (a RAM
01DF                             ;  word, growing down). Both destroy HL; rpush also keeps DE, rpop clobbers DE.
01DF                             ; =============================================================================
01DF   2A 34 08     RPUSH:    LHLD   RSP   
01E2   2B                     DCX   H   
01E3   72                     MOV   M,D   
01E4   2B                     DCX   H   
01E5   73                     MOV   M,E   
01E6   22 34 08               SHLD   RSP   
01E9   C9                     RET      
01EA   2A 34 08     RPOP:     LHLD   RSP   
01ED   5E                     MOV   E,M   
01EE   23                     INX   H   
01EF   56                     MOV   D,M   
01F0   23                     INX   H   
01F1   22 34 08               SHLD   RSP   
01F4   EB                     XCHG      
01F5   C9                     RET      
01F6                             ; =============================================================================
01F6                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
01F6                             ; =============================================================================
01F6   D1           H_ADD:    POP   D   
01F7   19                     DAD   D   
01F8   D7                     RST   2   
01F9                             ; "-" has two jobs: directly before a digit it starts a negative number.
01F9                             ; Otherwise a - b is a + (-b): neg16 and DAD are shorter than a byte-wise SUB/SBB.
01F9   0A           H_SUB:    LDAX   B   
01FA   D6 30                  SUI   "0"   
01FC   FE 0A                  CPI   10   
01FE   DA 07 02               JC   negnum   
0201   D1                     POP   D   
0202   CD 0F 02               CALL   neg16   
0205   19                     DAD   D   
0206   D7                     RST   2   
0207   E5           NEGNUM:   PUSH   H   
0208   CD C8 01               CALL   rdnum   
020B   CD 0F 02               CALL   neg16   
020E   D7                     RST   2   
020F                             ; neg16: HL = -HL (keeps BC, DE)
020F   AF           NEG16:    XRA   A   
0210   95                     SUB   L   
0211   6F                     MOV   L,A   
0212   9F                     SBB   A   
0213   94                     SUB   H   
0214   67                     MOV   H,A   
0215   C9                     RET      
0216                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0216                             ; multiplier is used up; only the low 16 bits are kept.
0216   D1           H_MUL:    POP   D   ; DE = multiplicand
0217   C5                     PUSH   B   
0218   44                     MOV   B,H   
0219   4D                     MOV   C,L   ; BC = multiplier
021A   21 00 00               LXI   H,0   
021D   78           MUL1:     MOV   A,B   
021E   B7                     ORA   A   ; clear carry
021F   1F                     RAR      
0220   47                     MOV   B,A   
0221   79                     MOV   A,C   
0222   1F                     RAR      
0223   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0224   D2 28 02               JNC   mul2   
0227   19                     DAD   D   
0228   EB           MUL2:     XCHG      
0229   29                     DAD   H   ; multiplicand << 1
022A   EB                     XCHG      
022B   78                     MOV   A,B   
022C   B1                     ORA   C   
022D   C2 1D 02               JNZ   mul1   
0230   C1                     POP   B   
0231   D7                     RST   2   
0232                             ; "/" ( a b -- q r ): truncates toward zero; r takes a's sign.
0232                             ; b = 0 gives q = 0, r = a. b = 2 takes a fast shift, as the spec requires.
0232   D1           H_DIV:    POP   D   ; DE = a, HL = b
0233   7C                     MOV   A,H   
0234   B5                     ORA   L   
0235   C2 3B 02               JNZ   div1   
0238   E5                     PUSH   H   ; q = 0
0239   EB                     XCHG      ; r = a
023A   D7                     RST   2   
023B   2B           DIV1:     DCX   H   ; b = 2 exactly?
023C   2B                     DCX   H   
023D   7C                     MOV   A,H   
023E   B5                     ORA   L   
023F   23                     INX   H   ; (INX leaves the flags alone)
0240   23                     INX   H   
0241   C2 5B 02               JNZ   divg   
0244                             ; a / 2: add 1 if a is negative, then shift right arithmetically
0244   62                     MOV   H,D   
0245   6B                     MOV   L,E   
0246   7A                     MOV   A,D   
0247   17                     RAL      ; carry = sign of a
0248   D2 4C 02               JNC   div2   
024B   23                     INX   H   
024C   7C           DIV2:     MOV   A,H   
024D   17                     RAL      ; carry = sign (of a, after the +1)
024E   7C                     MOV   A,H   
024F   1F                     RAR      ; arithmetic shift right, H
0250   67                     MOV   H,A   
0251   7D                     MOV   A,L   
0252   1F                     RAR      
0253   6F                     MOV   L,A   ; HL = q
0254   E5                     PUSH   H   
0255   29                     DAD   H   ; 2q
0256   CD 0F 02               CALL   neg16   
0259   19                     DAD   D   ; r = a - 2q
025A   D7                     RST   2   
025B   C5           DIVG:     PUSH   B   
025C   7A                     MOV   A,D   
025D   B7                     ORA   A   
025E   F5                     PUSH   PSW   ; S flag = sign of a (for r)
025F   AC                     XRA   H   
0260   F5                     PUSH   PSW   ; S flag = sign of q
0261   7C                     MOV   A,H   
0262   B7                     ORA   A   
0263   FC 0F 02               CM   neg16   ; HL = |b|
0266   EB                     XCHG      
0267   7C                     MOV   A,H   
0268   B7                     ORA   A   
0269   FC 0F 02               CM   neg16   ; HL = |a|, DE = |b|
026C   CD 7D 02               CALL   udiv   ; HL = q, BC = r
026F   F1                     POP   PSW   
0270   FC 0F 02               CM   neg16   ; q's sign
0273   EB                     XCHG      ; DE = q
0274   60                     MOV   H,B   
0275   69                     MOV   L,C   ; HL = r
0276   F1                     POP   PSW   
0277   FC 0F 02               CM   neg16   ; r's sign
027A   C1                     POP   B   
027B   D5                     PUSH   D   ; q under r
027C   D7                     RST   2   
027D                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
027D                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
027D                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
027D                             ; lives on the stack, since A is busy with the shifts.
027D   01 00 00     UDIV:     LXI   B,0   
0280   3E 10                  MVI   A,16   
0282   F5                     PUSH   PSW   
0283   29           UDV1:     DAD   H   ; next dividend bit into the carry
0284   79                     MOV   A,C   
0285   17                     RAL      
0286   4F                     MOV   C,A   
0287   78                     MOV   A,B   
0288   17                     RAL      
0289   47                     MOV   B,A   ; BC = BC*2 + bit
028A   79                     MOV   A,C   
028B   93                     SUB   E   
028C   78                     MOV   A,B   
028D   9A                     SBB   D   ; carry if BC < DE
028E   DA 96 02               JC   udv2   
0291   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0292   79                     MOV   A,C   
0293   93                     SUB   E   
0294   4F                     MOV   C,A   
0295   2C                     INR   L   ; quotient bit
0296   F1           UDV2:     POP   PSW   
0297   3D                     DCR   A   
0298   F5                     PUSH   PSW   
0299   C2 83 02               JNZ   udv1   
029C   F1                     POP   PSW   
029D   C9                     RET      
029E   D1           H_AND:    POP   D   
029F   7C                     MOV   A,H   
02A0   A2                     ANA   D   
02A1   67                     MOV   H,A   
02A2   7D                     MOV   A,L   
02A3   A3                     ANA   E   
02A4   6F                     MOV   L,A   
02A5   D7                     RST   2   
02A6   D1           H_OR:     POP   D   
02A7   7C                     MOV   A,H   
02A8   B2                     ORA   D   
02A9   67                     MOV   H,A   
02AA   7D                     MOV   A,L   
02AB   B3                     ORA   E   
02AC   6F                     MOV   L,A   
02AD   D7                     RST   2   
02AE   D1           H_XOR:    POP   D   
02AF   7C                     MOV   A,H   
02B0   AA                     XRA   D   
02B1   67                     MOV   H,A   
02B2   7D                     MOV   A,L   
02B3   AB                     XRA   E   
02B4   6F                     MOV   L,A   
02B5   D7                     RST   2   
02B6                             ; ~x is -x - 1: shorter than complementing both bytes.
02B6   CD 0F 02     H_NOT:    CALL   neg16   
02B9   2B                     DCX   H   
02BA   D7                     RST   2   
02BB                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
02BB                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
02BB                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
02BB                             ; SBB A turns a carry into -1 or 0 with no branch.
02BB   E3           H_GT:     XTHL      ; a > b  is  b < a
02BC   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
02BD   7B                     MOV   A,E   
02BE   95                     SUB   L   
02BF   7A                     MOV   A,D   
02C0   9C                     SBB   H   
02C1   9F                     SBB   A   ; A = -1 if DE < HL unsigned
02C2   6F                     MOV   L,A   
02C3   7C                     MOV   A,H   
02C4   AA                     XRA   D   
02C5   17                     RAL      ; carry = the signs differ
02C6   9F                     SBB   A   
02C7   AD                     XRA   L   ; flip when they do
02C8   67                     MOV   H,A   
02C9   6F                     MOV   L,A   
02CA   D7                     RST   2   
02CB   D1           H_EQ:     POP   D   
02CC   7D                     MOV   A,L   
02CD   AB                     XRA   E   
02CE   6F                     MOV   L,A   
02CF   7C                     MOV   A,H   
02D0   AA                     XRA   D   
02D1   B5                     ORA   L   ; zero if equal
02D2   D6 01                  SUI   1   ; carry only for zero
02D4   9F                     SBB   A   
02D5   67                     MOV   H,A   
02D6   6F                     MOV   L,A   
02D7   D7                     RST   2   
