E1BC                             ; "?" ( n -- c ) or ( -n -- addr )
E1BC                             ;   n > 0: wait about n ms for a key; 0 if none came
E1BC                             ;   n = 0: wait for a key
E1BC                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E1BC                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E1BC   B5 01        H_KEY:    LDA   1,X   
