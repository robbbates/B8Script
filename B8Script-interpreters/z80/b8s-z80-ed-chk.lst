0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-CPM*EDITOR*(1-CHECKED)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; HL'; CONCLS, CONEOL and CONCUR also DE and HL.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 AD 04               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 F7 04     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 B7 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 7E 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 5D                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 5F                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 51                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 AA 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 20        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE 36                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0072                          ENDIF      
0072                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0072                          ENDIF      
0072                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0072                          ENDIF      ;   these)
0072                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0072                          ENDIF      
0072                             ; In the unchecked generic editor build the table is here, in the first
0072                             ; page, which saves loading D twice. (The other builds have no room for it
0072                             ; here: theirs is further down.)
0072                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0072                          ENDIF      
0072                             ; =============================================================================
0072                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0072                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0072                             ;  is here too: it belongs to "`" and makes the page come out right.
0072                             ; =============================================================================
0072   D1           H_XOR:    POP   DE   
0073   7C                     LD   A,H   
0074   AA                     XOR   D   
0075   67                     LD   H,A   
0076   7D                     LD   A,L   
0077   AB                     XOR   E   
0078   6F                     LD   L,A   
0079   F7                     RST   30h   
007A   D1           H_OR:     POP   DE   
007B   7C                     LD   A,H   
007C   B2                     OR   D   
007D   67                     LD   H,A   
007E   7D                     LD   A,L   
007F   B3                     OR   E   
0080   6F                     LD   L,A   
0081   F7                     RST   30h   
0082   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0083   2B                     DEC   HL   
0084   F7                     RST   30h   
0085                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0085                             ; the same either way); TOS is the old pointer.
0085   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0089                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0089                          ENDIF      
0089   19                     ADD   HL,DE   ; the new top
008A                          IF   CHECKED   
008A   CD B4 03               CALL   chkhp   
008D                          ENDIF      
008D   22 7C 82               LD   (HEAP),HL   
0090   EB                     EX   DE,HL   
0091   F7                     RST   30h   
0092   D9           EXEC:     EXX      
0093   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
0096   D9                     EXX      
0097   CD 2B 00               CALL   jphl   
009A   D9                     EXX      
009B   2A 34 82               LD   HL,(RSAVE)   
009E   D9                     EXX      
009F   E1                     POP   HL   
00A0   F7                     RST   30h   
00A1                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00A1                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00A1                             ; Digits: step back onto the first digit and read the whole number.
00A1   E5           DIGIT:    PUSH   HL   
00A2   0B                     DEC   BC   
00A3   CD 90 02               CALL   rdnum   
00A6   F7                     RST   30h   
00A7                             ; a-z: push the cell's address (the cell is the variable)
00A7   E5           LOWER:    PUSH   HL   
00A8   87                     ADD   A,A   
00A9   6F                     LD   L,A   
00AA   26 82                  LD   H,LETPAGE   
00AC   F7                     RST   30h   
00AD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00AD                             ; the return stack, and the IP becomes the address in the letter's cell.
00AD   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00AE   EB                     EX   DE,HL   ; park TOS
00AF   87                     ADD   A,A   
00B0   6F                     LD   L,A   
00B1   26 82                  LD   H,LETPAGE   ; HL -> cell
00B3   4E                     LD   C,(HL)   
00B4   2C                     INC   L   
00B5   46                     LD   B,(HL)   ; IP = the word's body
00B6   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B7                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B7                             ; stack, then next. Everything that pushes the return stack ends here.
00B7                             ; 
00B7                             ; The break key is looked at here, so at every word call and loop-back (and
00B7                             ; block entry and "{"), but only one time in 256: B', which nothing else
00B7                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00B7                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00B7                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00B7                             ; both ways out.)
00B7   D9           RPUSHN:   EXX      
00B8   D1                     POP   DE   
00B9   2B                     DEC   HL   
00BA   72                     LD   (HL),D   
00BB   2B                     DEC   HL   
00BC   73                     LD   (HL),E   
00BD   05                     DEC   B   
00BE   D9                     EXX      
00BF   CC 40 03               CALL   Z,pollk   
00C2   F7                     RST   30h   
00C3                             ; ---- machine code: the grave -----------------------------------------------
00C3                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00C3                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00C3                             ; written and its address is left. An odd last digit is consumed and dropped.
00C3                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00C3                             ; code is entered by CALL with the data stack above the return address; it
00C3                             ; must keep BC, and on return the top cell becomes the new TOS.
00C3   CD F4 02     H_GRAVE:   CALL   hexc   
00C6   30 CA                  JR   NC,exec   
00C8   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00C9   CD F4 02               CALL   hexc   
00CC   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00CE   ED 6F                  RLD      ;   overwrites it
00D0   23                     INC   HL   ; ... and RLD shifts it up under the low one
00D1   CD F4 02               CALL   hexc   
00D4   38 F2                  JR   C,hx1   
00D6   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00D8   F7                     RST   30h   
00D9                             ; ---- where the two pages meet ----------------------------------------------
00D9                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00D9                             ; are in falling code order for this), and where exactly differs between the
00D9                             ; builds: NPG1 follows. Every handler below these four must start in the
00D9                             ; second page, and every one above in the first; chktab.py checks both.
00D9                             ; "]" returns: pop an address and jump to it.
00D9   CF           H_RET:    RST   08h   
00DA   42                     LD   B,D   
00DB   4B                     LD   C,E   
00DC   F7           BRK1:     RST   30h   
00DD                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00DD                             ; drops the block start, "]" returns. No closer at all ends the program.
00DD   7C           H_BREAK:   LD   A,H   
00DE   B5                     OR   L   
00DF   E1                     POP   HL   
00E0   28 FA                  JR   Z,brk1   
00E2   CD B7 02               CALL   skip   
00E5   B7                     OR   A   ; skip returns 0 for ")"
00E6   20 F1                  JR   NZ,h_ret   
00E8   CF           RDROP:    RST   08h   
00E9   F7                     RST   30h   
00EA                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00EA                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00EA                             ; the body"s address instead. Either way it then skips to the matching "]'.
00EA                             ; (The unchecked build takes anything that is not a letter as the space; the
00EA                             ; checked build stops on it.)
00EA   0A           H_DEF:    LD   A,(BC)   
00EB   03                     INC   BC   
00EC   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00EE   5F                     LD   E,A   ;   lands 64 bytes up
00EF   E6 DF                  AND   0DFh   ; fold case
00F1   FE 1A                  CP   26   
00F3   30 0B                  JR   NC,def2   ; not a letter
00F5   CB 23                  SLA   E   
00F7   16 82                  LD   D,LETPAGE   ; DE -> cell
00F9   79                     LD   A,C   
00FA   12                     LD   (DE),A   
00FB   1C                     INC   E   
00FC   78                     LD   A,B   
00FD   12                     LD   (DE),A   
00FE   18 09                  JR   skipnx   
0100                DEF2:        
0100                          IF   CHECKED   
0100   7B                     LD   A,E   
0101   FE DF                  CP   " "-"A"+256   
0103   C2 F0 03               JP   NZ,e_brack   ; anything but a letter or a space
0106                          ENDIF      
0106   E5                     PUSH   HL   ; an anonymous block: push its address
0107   60                     LD   H,B   
0108   69                     LD   L,C   
0109                SKIPNX:      
0109                          IF   CHECKED   
0109   0B                     DEC   BC   ; back onto the letter, so that skip finds its
010A                          ENDIF      ;   opener, the "[", just before where it starts
010A   CD B7 02     SKIPO:    CALL   skip   
010D   F7                     RST   30h   
010E   5E           H_FETCH:   LD   E,(HL)   ; "@"
010F   23                     INC   HL   
0110   56                     LD   D,(HL)   
0111   EB                     EX   DE,HL   
0112   F7                     RST   30h   
0113                             ; =============================================================================
0113                             ;  Handlers that must start in the image's second page.
0113                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0113                             ;  page.
0113                             ; =============================================================================
0113                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0113                             ; the matching ")".
0113   7C           H_OPEN:   LD   A,H   
0114   B5                     OR   L   
0115   E1                     POP   HL   
0116   28 F2                  JR   Z,skipo   
0118   C5                     PUSH   BC   ; the block starts at the IP
0119   18 9C                  JR   rpushn   
011B                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
011B                             ; drops it and carries on.
011B   7C           H_CLOSE:   LD   A,H   
011C   B5                     OR   L   
011D   E1                     POP   HL   
011E   28 C8                  JR   Z,rdrop   
0120   CF                     RST   08h   ; pop the block start ...
0121   42                     LD   B,D   
0122   4B                     LD   C,E   
0123   C5                     PUSH   BC   
0124   18 91                  JR   rpushn   ; ... and push it back
0126                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0126                             ; "-" has two jobs: directly before a digit it starts a negative number.
0126   0A           H_SUB:    LD   A,(BC)   
0127   D6 30                  SUB   "0"   
0129   FE 0A                  CP   10   
012B   38 04                  JR   C,negnum   
012D   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
012E   D1           H_ADD:    POP   DE   
012F   19                     ADD   HL,DE   
0130   F7                     RST   30h   
0131   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0132   CD 90 02               CALL   rdnum   
0135   E7                     RST   20h   
0136   F7                     RST   30h   
0137   D1           H_AND:    POP   DE   
0138   7C                     LD   A,H   
0139   A2                     AND   D   
013A   67                     LD   H,A   
013B   7D                     LD   A,L   
013C   A3                     AND   E   
013D   6F                     LD   L,A   
013E   F7                     RST   30h   
013F                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
013F                             ; cells first. Flipping both sign bits turns a signed compare into an
013F                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
013F                             ; carry into -1 or 0 with no branch.
013F   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0140   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0141   7C                     LD   A,H   
0142   EE 80                  XOR   80h   
0144   67                     LD   H,A   
0145   7A                     LD   A,D   
0146   EE 80                  XOR   80h   
0148   57                     LD   D,A   
0149   ED 52                  SBC   HL,DE   ; carry if HL < DE
014B   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
014D   F7                     RST   30h   
014E   D1           H_EQ:     POP   DE   
014F   B7                     OR   A   
0150   ED 52                  SBC   HL,DE   
0152   7C                     LD   A,H   
0153   B5                     OR   L   
0154   FE 01                  CP   1   ; carry only if a - b = 0
0156   18 F3                  JR   tf   
0158                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0158                             ; multiplier shifts up through A:C.
0158   D1           H_MUL:    POP   DE   ; DE = multiplicand
0159   C5                     PUSH   BC   
015A   7C                     LD   A,H   
015B   4D                     LD   C,L   ; A:C = multiplier
015C   21 00 00               LD   HL,0   
015F   06 10                  LD   B,16   
0161   29           MUL1:     ADD   HL,HL   
0162   CB 21                  SLA   C   
0164   17                     RLA      
0165   30 01                  JR   NC,mul2   
0167   19                     ADD   HL,DE   
0168   10 F7        MUL2:     DJNZ   mul1   
016A   C1                     POP   BC   
016B   F7                     RST   30h   
016C                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
016C                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
016C                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
016C                             ; stops on it.
016C                H_DIV:       
016C                          IF   CHECKED   
016C   7C                     LD   A,H   
016D   B5                     OR   L   
016E   CA ED 03               JP   Z,e_zero   
0171                          ENDIF      
0171   D1                     POP   DE   ; DE = a, HL = b
0172   D5                     PUSH   DE   ; a, for r's sign
0173   7A                     LD   A,D   
0174   AC                     XOR   H   
0175   F5                     PUSH   AF   ; S flag = sign of q
0176   CB 7C                  BIT   7,H   
0178   C4 20 00               CALL   NZ,neg16   ; HL = |b|
017B   EB                     EX   DE,HL   
017C   CB 7C                  BIT   7,H   
017E   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0181   CD 68 02               CALL   udiv   ; HL = q, DE = r
0184   F1                     POP   AF   
0185   FC 20 00               CALL   M,neg16   ; q's sign
0188   EB                     EX   DE,HL   ; HL = r, DE = q
0189   F1                     POP   AF   ; A = a's high byte
018A   B7                     OR   A   
018B   FC 20 00               CALL   M,neg16   ; r's sign
018E   D5                     PUSH   DE   ; q under r
018F   F7                     RST   30h   
0190                             ; ---- stack and storage -----------------------------------------------------
0190   E5           H_DUP:    PUSH   HL   ; ":"
0191   F7                     RST   30h   
0192   E3           H_SWAP:   EX   (SP),HL   ; "%"
0193   F7                     RST   30h   
0194                             ; (The checked build tests the address before it takes the value off the
0194                             ; stack, so that an error report shows both.)
0194                H_CSTORE:      ; "." ( c addr -- )
0194                          IF   CHECKED   
0194   CD C9 03               CALL   chkst   
0197                          ENDIF      
0197   D1                     POP   DE   
0198   73                     LD   (HL),E   
0199   DF           H_DROP:   RST   18h   ; ";" is this one byte
019A                H_STORE:      ; "!" ( n addr -- )
019A                          IF   CHECKED   
019A   CD C9 03               CALL   chkst   
019D                          ENDIF      
019D   D1                     POP   DE   
019E   73                     LD   (HL),E   
019F   23                     INC   HL   
01A0   72                     LD   (HL),D   
01A1   DF                     RST   18h   
01A2                             ; ---- console ---------------------------------------------------------------
01A2                             ; 22h pushes the address of the text after it and skips the string.
01A2   E5           H_STR:    PUSH   HL   
01A3   60                     LD   H,B   
01A4   69                     LD   L,C   
01A5   CD A6 02               CALL   skipstr   
01A8                          IF   CHECKED   
01A8   B7                     OR   A   ; 0: the text ran out before the closing quote
01A9   CA E5 03               JP   Z,e_quote   
01AC                          ENDIF      
01AC   F7                     RST   30h   
01AD                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01AD                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01AD                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01AD                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01AD                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01AD                          ENDIF      
01AD                          IF   CHECKED   
01AD                             ; (The checked build has the loop as a routine, prstr, which the error
01AD                             ; report uses too. The address is kept meanwhile, for a report: it shows
01AD                             ; the stack as it was before the "$". /~ comes back to hp1.)
01AD   22 34 82     H_PRINT:   LD   (RSAVE),HL   
01B0   CD 06 02     HP1:      CALL   prstr   
01B3   DF                     RST   18h   
01B4                          ENDIF      
01B4   7D           H_EMIT:   LD   A,L   ; "'"
01B5   EF                     RST   28h   
01B6   DF           PR9:      RST   18h   
01B7                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B7   CD 06 03     H_NUM:    CALL   psgn   
01BA   DF                     RST   18h   
01BB                             ; "?" ( n -- c ) or ( -n -- addr )
01BB                             ;   n > 0: wait about n ms for a key; 0 if none came
01BB                             ;   n = 0: wait for a key
01BB                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BB                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BB   CB 7C        H_KEY:    BIT   7,H   
01BD   20 19                  JR   NZ,line   
01BF   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C1   CD 6E 03     KT2:      CALL   getk   
01C4   20 0E                  JR   NZ,kt3   
01C6   1D                     DEC   E   
01C7   20 F8                  JR   NZ,kt2   
01C9   7C                     LD   A,H   ; 0? never counts down: it waits
01CA   B5                     OR   L   
01CB   28 F2                  JR   Z,kt1   
01CD   2B                     DEC   HL   
01CE   7C                     LD   A,H   
01CF   B5                     OR   L   
01D0   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01D2   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01D3   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01D4   6F           KT3:      LD   L,A   
01D5   26 00                  LD   H,0   
01D7   F7                     RST   30h   
01D8                             ; Backspace takes the last character back (and is echoed as it
01D8                             ; is), CR ends (stored, not echoed), every other key is stored and
01D8                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01D8                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01D8                             ; is the place in the line: D holds the L of a full line.
01D8   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01DB   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01DC   9F                     SBC   A,A   
01DD   A5                     AND   L   ; (0 for a count that is too big)
01DE   2F                     CPL      
01DF   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E0                             ;   at most
01E0   21 80 82               LD   HL,LINEBUF   
01E3   CD 6E 03     LN2:      CALL   getk   
01E6   28 FB                  JR   Z,ln2   
01E8   FE 0D                  CP   13   
01EA   28 16                  JR   Z,ln5   
01EC   FE 08                  CP   8   
01EE   28 0B                  JR   Z,ln4   
01F0   5F                     LD   E,A   
01F1   7D                     LD   A,L   
01F2   BA                     CP   D   
01F3   28 EE                  JR   Z,ln2   ; full
01F5   73                     LD   (HL),E   
01F6   2C                     INC   L   
01F7   7B                     LD   A,E   
01F8   EF           LN3:      RST   28h   
01F9   18 E8                  JR   ln2   
01FB   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
01FC   FA F8 01               JP   M,ln3   ;   unless the line was empty (L left the
01FF   2C                     INC   L   ;   upper half of the page)
0200   18 E1                  JR   ln2   
0202   77           LN5:      LD   (HL),A   ; the CR
0203   2E 80                  LD   L,LINEBUF & 0FFh   
0205   F7                     RST   30h   
0206                             ; =============================================================================
0206                             ;  More routines (no handler starts past this point)
0206                             ; =============================================================================
0206                          IF   CHECKED   
0206                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0206                             ; "$", and the texts of the report). A NUL first is an error: Q.
0206   7E           PRSTR:    LD   A,(HL)   
0207   23                     INC   HL   
0208   FE 22                  CP   22h   
020A   C8                     RET   Z   
020B   B7                     OR   A   
020C   CA DB 03               JP   Z,e_dollar   
020F   FE 2F                  CP   "/"   
0211   20 0C                  JR   NZ,prs1   
0213   7E                     LD   A,(HL)   
0214   23                     INC   HL   
0215   FE 60                  CP   60h   
0217   38 04                  JR   C,prs0   
0219   FE 7F                  CP   7Fh   
021B   38 11                  JR   C,pesc   
021D   E6 BF        PRS0:     AND   0BFh   
021F   EF           PRS1:     RST   28h   
0220   18 E4                  JR   prstr   
0222                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0222                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0222                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0222                             ; pnl: the same, on a new line.
0222   3E 0D        PNL:      LD   A,13   
0224   EF                     RST   28h   
0225   3E 0A                  LD   A,10   
0227   EF                     RST   28h   
0228   E3           PMSG:     EX   (SP),HL   
0229   CD 06 02               CALL   prstr   
022C   E3                     EX   (SP),HL   
022D   C9                     RET      
022E                          ENDIF      
022E                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
022E                             ; HL points past it. Each goes back into the loop that prints the string
022E                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
022E                             ;    /a-/z   print the variable, as "#" does
022E                             ;    /{      clear the screen, the cursor to the top left
022E                             ;    /}      clear from the cursor to the end of the line
022E                             ;    /|  /`  show the cursor, hide it
022E                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
022E   FE 7E        PESC:     CP   7Eh   
0230   28 1C                  JR   Z,pat   
0232   11 06 02               LD   DE,PRLOOP   ; the others return into the loop
0235   D5                     PUSH   DE   
0236   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0238   30 21                  JR   NC,pcon   
023A   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
023C   30 26                  JR   NC,phide   
023E   87                     ADD   A,A   ; the variable's cell
023F   C6 40                  ADD   A,40h   
0241   E5                     PUSH   HL   
0242   6F                     LD   L,A   
0243   26 82                  LD   H,LETPAGE   
0245   7E                     LD   A,(HL)   
0246   2C                     INC   L   
0247   66                     LD   H,(HL)   
0248   6F                     LD   L,A   
0249   CD 06 03               CALL   psgn   
024C   E1                     POP   HL   
024D   C9                     RET      
024E                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
024E                             ; the checked build "$" is the routine prstr: its own return address goes
024E                             ; first, and hp1 calls it again afterwards. There a /~ that takes cells
024E                             ; that aren"t there is s after the "$' (or at its NUL: see e_dollar), as for
024E                             ; any other character. chkstk stops a /~ only when the stack is already
024E                             ; past its empty place, so that, however many there are, what they write
024E                             ; stays in the spare bytes above the stack.
024E                PAT:         
024E                          IF   CHECKED   
024E   D1                     POP   DE   
024F   CD 7E 03               CALL   chkstk   
0252                          ENDIF      
0252   D1                     POP   DE   ; DE = the column
0253   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0254                          IF   1-ANS   
0254   CD 15 FF               CALL   CONAT   
0257   E1                     POP   HL   
0258   C3 B0 01               JP   PRAGAIN   
025B                             ; With ANSI = 0 the machine's routines do the rest.
025B   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
025E   FE 02                  CP   2   
0260   CA 0F FF               JP   Z,CONEOL   ; /}
0263   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
0264   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0265   C3 12 FF               JP   CONCUR   
0268                          ENDIF      
0268                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              LD   A,";"   
                              RST   28h   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              LD   A,"H"   
                              RST   28h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
                              LD   A,"?"   
                              CALL   csia   
                              LD   A,"2"   
                              RST   28h   
                              LD   A,"5"   
                              RST   28h   
                              LD   A,E   
                              RST   28h   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              RST   28h   
                              RET      
                    CSI:      PUSH   AF   
                              LD   A,27   
                              RST   28h   
                              LD   A,"["   
                              RST   28h   
                              POP   AF   
                              RET      
0268                          ENDIF      
0268                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0268                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0268                             ; the quotient bits arrive at the bottom of C.
0268                             ; Dividing by 2 is one shift (the spec wants that fast).
0268   7B           UDIV:     LD   A,E   
0269   EE 02                  XOR   2   
026B   B2                     OR   D   
026C   20 07                  JR   NZ,udv0   
026E   CB 3C                  SRL   H   
0270   CB 1D                  RR   L   ; the quotient
0272   8F                     ADC   A,A   
0273   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0274   C9                     RET      
0275   C5           UDV0:     PUSH   BC   
0276   7C                     LD   A,H   
0277   4D                     LD   C,L   
0278   21 00 00               LD   HL,0   
027B   06 10                  LD   B,16   
027D   CB 21        UDV1:     SLA   C   
027F   17                     RLA      
0280   ED 6A                  ADC   HL,HL   
0282   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0284   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0286   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0287   0D                     DEC   C   ;   INC below
0288   0C           UDV2:     INC   C   ; a quotient bit
0289   10 F2                  DJNZ   udv1   
028B   EB                     EX   DE,HL   ; DE = remainder
028C   67                     LD   H,A   
028D   69                     LD   L,C   ; HL = quotient
028E   C1                     POP   BC   
028F   C9                     RET      
0290                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0290                             ; non-digit. Values wrap at 16 bits, as the spec says.
0290   21 00 00     RDNUM:    LD   HL,0   
0293   0A           RDN1:     LD   A,(BC)   
0294   D6 30                  SUB   "0"   
0296   FE 0A                  CP   10   
0298   D0                     RET   NC   
0299   03                     INC   BC   
029A   54                     LD   D,H   
029B   5D                     LD   E,L   
029C   29                     ADD   HL,HL   
029D   29                     ADD   HL,HL   
029E   19                     ADD   HL,DE   
029F   29                     ADD   HL,HL   ; HL * 10
02A0   5F                     LD   E,A   
02A1   16 00                  LD   D,0   
02A3   19                     ADD   HL,DE   
02A4   18 ED                  JR   rdn1   
02A6                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02A6                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02A6                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
02A6                          ENDIF      
02A6                          IF   CHECKED   
02A6                             ; The checked build never steps over a NUL: if the text runs out first it
02A6                             ; returns A = 0 with the IP on the NUL.
02A6   0A           SKIPSTR:   LD   A,(BC)   
02A7   B7                     OR   A   
02A8   C8                     RET   Z   
02A9   03                     INC   BC   
02AA   FE 22                  CP   22h   
02AC   C8                     RET   Z   
02AD   FE 2F                  CP   "/"   
02AF   20 F5                  JR   NZ,skipstr   
02B1   0A                     LD   A,(BC)   ; the escaped character
02B2   B7                     OR   A   
02B3   C8                     RET   Z   
02B4   03                     INC   BC   
02B5   18 EF                  JR   skipstr   
02B7                          ENDIF      
02B7                             ; skip: read past text to the closer at this level, and return A = 0 if it
02B7                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02B7                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02B7                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02B7                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02B7                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02B7                             ; 
02B7                             ; The checked build also looks at the character the skip was started by,
02B7                             ; which is always the one just before where it starts: "(" must end at ")",
02B7                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02B7                             ; quote counts as running into it. "\" takes either closer. IX keeps the
02B7                             ; place where the skip started, for the report.
02B7                SKIP:        
02B7                          IF   CHECKED   
02B7   C5                     PUSH   BC   
02B8   DD E1                  POP   IX   
02BA   0B                     DEC   BC   
02BB   0A                     LD   A,(BC)   
02BC   03                     INC   BC   
02BD   5F                     LD   E,A   ; E = the opener: ( [ or \
02BE                          ENDIF      
02BE   16 00                  LD   D,0   
02C0   14           SK3:      INC   D   ; an opener: one deeper
02C1   0A           SK1:      LD   A,(BC)   
02C2                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
02C2                          ENDIF      
02C2                          IF   CHECKED   
02C2   B7                     OR   A   
02C3   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
02C5   03                     INC   BC   
02C6                          ENDIF      
02C6   FE 22                  CP   22h   
02C8   CC A6 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02CB   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02CD   28 F1                  JR   Z,sk3   
02CF   3D                     DEC   A   ; ")"
02D0   28 08                  JR   Z,sk4   
02D2   D6 32                  SUB   "["-")"   
02D4   28 EA                  JR   Z,sk3   
02D6   FE 02                  CP   "]"-"["   
02D8   20 E7                  JR   NZ,sk1   
02DA   15           SK4:      DEC   D   
02DB                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
02DB                          ENDIF      
02DB                          IF   CHECKED   
02DB   20 E4                  JR   NZ,sk1   
02DD   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
02DE   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
02DF   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
02E1   FE 02                  CP   2   ;   closer, and only then
02E3   7A                     LD   A,D   
02E4   C0                     RET   NZ   
02E5   18 05                  JR   sk7   
02E7   CB 53        SK6:      BIT   2,E   ; the text ran out:
02E9   C2 F6 04               JP   NZ,SKEND   ;   "\" with no closer ends the program
02EC   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
02EE   C1                     POP   BC   
02EF   3E 4E                  LD   A,"N"   
02F1   C3 D8 03               JP   errp   ; (errp drops skip's return address)
02F4                          ENDIF      
02F4                             ; =============================================================================
02F4                             ;  Dispatch table: the low byte of each handler's address, in code order
02F4                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02F4                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02F4                             ; =============================================================================
02F4                             ; The handlers of the first NPG1 characters start in the image's second page.
02F4                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02F4                             ; differs between the builds, so the count is worked out here.
02F4                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02F4                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02F4                PGBRK:    EQU   (h_break-BASE)/256   
02F4                PGDEF:    EQU   (h_def-BASE)/256   
02F4                PGFET:    EQU   (h_fetch-BASE)/256   
02F4                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02F4                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02F4                          ENDIF      
02F4                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02F4                             ; and return its value in A with the carry set; otherwise leave the IP and
02F4                             ; return with the carry clear.
02F4   0A           HEXC:     LD   A,(BC)   
02F5   D6 30                  SUB   "0"   
02F7   FE 0A                  CP   10   
02F9   38 09                  JR   C,hc1   
02FB   E6 DF                  AND   0DFh   
02FD   D6 11                  SUB   11h   
02FF   FE 06                  CP   6   
0301   D0                     RET   NC   
0302   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0304   03           HC1:      INC   BC   
0305   C9                     RET      
0306                             ; psgn: print HL as a signed number. Keeps BC.
0306   CB 7C        PSGN:     BIT   7,H   
0308   28 04                  JR   Z,pdec   
030A   3E 2D                  LD   A,"-"   
030C   EF                     RST   28h   
030D   E7                     RST   20h   
030E                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
030E                             ; Keeps BC.
030E   11 0A 00     PDEC:     LD   DE,10   
0311   CD 68 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0314   7B                     LD   A,E   
0315   F5                     PUSH   AF   
0316   7C                     LD   A,H   
0317   B5                     OR   L   
0318   C4 0E 03               CALL   NZ,pdec   
031B   F1                     POP   AF   
031C   C6 30                  ADD   A,"0"   
031E   EF                     RST   28h   
031F   C9                     RET      
0320                             ; (The table goes here instead in the builds where, before psgn, it would
0320                             ; cross a page: PTLATE.)
0320                          IF   (1-TABP0)*PTLATE   
0320                PTAB:        
0320                          ;*Macro unroll:  PTABLE
0320   9A                     DB   h_store & 0FFh   
0321   A2                     DB   h_str & 0FFh   
0322   B7                     DB   h_num & 0FFh   
0323   AD                     DB   h_print & 0FFh   
0324   92                     DB   h_swap & 0FFh   
0325   37                     DB   h_and & 0FFh   
0326   B4                     DB   h_emit & 0FFh   
0327   13                     DB   h_open & 0FFh   
0328   1B                     DB   h_close & 0FFh   
0329   58                     DB   h_mul & 0FFh   
032A   2E                     DB   h_add & 0FFh   
032B   D3                     DB   h_cfetch & 0FFh   
032C   26                     DB   h_sub & 0FFh   
032D   94                     DB   h_cstore & 0FFh   
032E   6C                     DB   h_div & 0FFh   
032F   90                     DB   h_dup & 0FFh   
0330   99                     DB   h_drop & 0FFh   
0331   3F                     DB   h_lt & 0FFh   
0332   4E                     DB   h_eq & 0FFh   
0333   40                     DB   h_gt & 0FFh   
0334   BB                     DB   h_key & 0FFh   
0335   0E                     DB   h_fetch & 0FFh   
0336   EA                     DB   h_def & 0FFh   
0337   DD                     DB   h_break & 0FFh   
0338   D9                     DB   h_ret & 0FFh   
0339   72                     DB   h_xor & 0FFh   
033A   85                     DB   h_alloc & 0FFh   
033B   C3                     DB   h_grave & 0FFh   
033C   2C                     DB   h_tor & 0FFh   
033D   7A                     DB   h_or & 0FFh   
033E   1C                     DB   h_fromr & 0FFh   
033F   82                     DB   h_not & 0FFh   
0340                PTABEND:      
0340                          ENDIF      
0340                             ; =============================================================================
0340                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0340                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0340                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
0340                             ;  they are the host's KEY and CONOUT routines themselves.
0340                             ; 
0340                             ;  A running program reads the keyboard only through getk and pollk, which
0340                             ;  between them give the break key its rules:
0340                             ;    - Ctrl-C stops the program;
0340                             ;    - any other key that the break check reads is held in KEYBUF for the
0340                             ;      next "?", and a newer one takes its place;
0340                             ;    - "?" (getk) takes the held key first;
0340                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0340                             ;      key like any other, but two of them within about 250 ms still stop it.
0340                             ;  Both are called straight from a handler, never from a routine under one:
0340                             ;  the checked build's report counts on finding one return address above the
0340                             ;  data stack.
0340                             ; =============================================================================
0340                          IFN   CPM   
0340                RAWK:     EQU   KEY   
0340                          ENDIF      
0340                             ; pollk: the break check (see rpushn).
0340   CD 06 FF     POLLK:    CALL   rawk   
0343   C8                     RET   Z   ; no key
0344   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0347   FE 03        PK1:      CP   3   ; (getk joins here)
0349   C0                     RET   NZ   
034A                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
034A                             ; the program has turned it off, wait about 250 ms for one more key: a
034A                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
034A                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
034A   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
034D   B7                     OR   A   
034E   CA D6 03     CT0:      JP   Z,brk   
0351   D5                     PUSH   DE   
0352   11 10 27               LD   DE,250*MSLOOP   
0355   CD 06 FF     CT1:      CALL   rawk   
0358   20 05                  JR   NZ,ct2   
035A   1B                     DEC   DE   
035B   7A                     LD   A,D   
035C   B3                     OR   E   
035D   20 F6                  JR   NZ,ct1   
035F   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0360   FE 03                  CP   3   
0362   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0364   B7                     OR   A   
0365   28 03                  JR   Z,ct3   
0367   32 7A 82               LD   (KEYBUF),A   
036A   3E 03        CT3:      LD   A,3   
036C   B7                     OR   A   
036D   C9                     RET      
036E                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
036E   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
036F   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0372   7E                     LD   A,(HL)   
0373   36 00                  LD   (HL),0   
0375   E1                     POP   HL   
0376   B7                     OR   A   
0377   C0                     RET   NZ   
0378   CD 06 FF               CALL   rawk   
037B   C8                     RET   Z   
037C   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
037E                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
037E                          ENDIF      ;   (with the editor, both stacks are cleared);
037E                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
037E                          ENDIF      
037E                          IF   CHECKED   
037E                BRK:      EQU   e_break   ;   the checked build reports B
037E                          ENDIF      
037E                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
037E                          ENDIF      
037E                             ; =============================================================================
037E                             ;  Checked build: the checks and the error report
037E                             ; =============================================================================
037E                          IF   CHECKED   
037E                             ; chkstk: both stacks are checked once per character, not in every handler.
037E                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
037E                             ; the constant carries if it is above (cells were popped that were never
037E                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
037E                             ; a character late at most: the bytes above DSTOP and the guard band below
037E                             ; the page take what happens meanwhile. DE is free between characters.
037E   EB           CHKSTK:   EX   DE,HL   
037F   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0382   39                     ADD   HL,SP   
0383   EB                     EX   DE,HL   
0384   38 1D                  JR   C,e_under   
0386   14                     INC   D   
0387   20 16                  JR   NZ,e_over   
0389   D9                     EXX      ; the return stack: in its page (or it has
038A   7C                     LD   A,H   ;   overflowed), and not above its empty
038B   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
038D   7D                     LD   A,L   ;   page, in the guard band)
038E   D9                     EXX      
038F   20 0B                  JR   NZ,e_rover   
0391   FE E1                  CP   RSTOP&0FFh+1   
0393   D8                     RET   C   
0394   D9                     EXX      ; return stack underflow: it counts as empty
0395   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
0397   D9                     EXX      
0398   3E 72                  LD   A,"r"   
039A   18 3C                  JR   errp   
039C   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
039E   11                     DB   11h   ; (LD DE,nn hides the next entry)
039F   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
03A1   18 35                  JR   errp   
03A3   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
03A6   3E 73                  LD   A,"s"   
03A8   18 48                  JR   error   
03AA                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
03AA                             ; was never defined still holds 0000h, and the byte there is a reserved one
03AA                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
03AA                             ; an undefined word. The call is undone, so the place is the call itself.
03AA   04           E_HI:     INC   B   
03AB   10 3D                  DJNZ   e_resv   ; (B is as it was, and is not 0)
03AD   CF                     RST   08h   
03AE   42                     LD   B,D   
03AF   4B                     LD   C,E   
03B0   3E 55                  LD   A,"U"   
03B2   18 3E                  JR   error   
03B4                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
03B4                             ; the count. Stop if the top is not below the limit page, or is below the
03B4                             ; program's end.
03B4                CHKHP:       
03B4                          ENDIF      
03B4                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03B4                          ENDIF      
03B4                          IF   CHECKED*(1-CPM)   
03B4                             ; (Here the program's space is under 32K, so a top that wrapped
03B4                             ; round always falls outside it.)
03B4   7C                     LD   A,H   
03B5   FE F0                  CP   HEAPLIM   
03B7   30 09                  JR   NC,e_heap   
03B9                          ENDIF      
03B9                          IF   CHECKED   
03B9   D5                     PUSH   DE   
03BA   EB                     EX   DE,HL   
03BB   2A 38 82               LD   HL,(NPEND)   
03BE   19                     ADD   HL,DE   ; carry: at or above the program's end
03BF   EB                     EX   DE,HL   
03C0   D1                     POP   DE   
03C1   D8                     RET   C   
03C2   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
03C3   ED 52                  SBC   HL,DE   
03C5   3E 48                  LD   A,"H"   
03C7   18 0F                  JR   errp   
03C9                             ; chkst: stop unless HL is in the program's own space: from the letter page
03C9                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
03C9                             ; whatever lies above the limit are safe. Memory above the heap top but
03C9                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
03C9                             ; It is the page of HL + 1 that is tested, so that one test serves both
03C9                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
03C9                             ; Keeps HL and BC. It runs on into its own error entry.
03C9   23           CHKST:    INC   HL   
03CA   7C                     LD   A,H   
03CB   2B                     DEC   HL   
03CC   FE 82                  CP   LETPAGE   
03CE   38 03                  JR   C,e_store   
03D0                          ENDIF      
03D0                          IF   CHECKED*(1-CPM)   
03D0   FE F0                  CP   HEAPLIM   
03D2   D8                     RET   C   
03D3                          ENDIF      
03D3                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03D3                          ENDIF      
03D3                          IF   CHECKED   
03D3                             ; Error entries. Each loads its letter and then hides the next entry inside
03D3                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
03D3   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
03D5   11                     DB   11h   
03D6   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
03D8                             ; errp: an error found inside a routine: drop its return address first.
03D8   D1           ERRP:     POP   DE   
03D9   18 17                  JR   error   
03DB                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
03DB                             ; back in TOS. prstr's return address goes first. But if a /~ took cells
03DB                             ; that weren't there, it is s, found now: chkstk, called one cell up, sees
03DB                             ; the stack past its empty place then.
03DB   D1           E_DOLLAR:   POP   DE   
03DC   E1                     POP   HL   
03DD   CD 7E 03               CALL   chkstk   
03E0   E5                     PUSH   HL   
03E1   2A 34 82               LD   HL,(RSAVE)   
03E4   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
03E5   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
03E6   4D                     LD   C,L   ;   past the opening quote, which is the place
03E7   3E 51                  LD   A,"Q"   
03E9   11                     DB   11h   
03EA   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
03EC   11                     DB   11h   
03ED   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
03EF   11                     DB   11h   
03F0   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
03F2                             ; error: the report, then the end. A = the letter, BC = one past the place,
03F2                             ; HL = TOS, and both stacks as the report is to show them:
03F2                             ; 
03F2                             ;   Err X @ line,col
03F2                             ;   up to 16 characters of the text from the place
03F2                             ;   Stk n: the top 8 cells at most, bottom to top
03F2                             ;   Rtn n
03F2   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
03F3   5F                     LD   E,A   
03F4   CD 22 02               CALL   pnl   
03F7   45 72 72 20 22         DB   "Err ",22h   
03FC   7B                     LD   A,E   
03FD   EF                     RST   28h   
03FE   CD 28 02               CALL   pmsg   
0401   20 40 20 22            DB   " @ ",22h   
0405   0B                     DEC   BC   ; BC = the place
0406                             ; The line and column. A place below the program is in the line
0406                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0406                             ; DE = the line's number, HL = where it starts.
0406   21 80 82               LD   HL,LINEBUF   
0409   11 00 00               LD   DE,0   
040C   78                     LD   A,B   
040D   FE 83                  CP   PROG/256   
040F   38 14                  JR   C,er3   
0411   24                     INC   H   
0412   6B                     LD   L,E   ; HL = PROG
0413   13           ER1:      INC   DE   ; a new line starts at HL
0414   E5                     PUSH   HL   
0415   7D           ER2:      LD   A,L   
0416   91                     SUB   C   
0417   7C                     LD   A,H   
0418   98                     SBC   A,B   
0419   30 09                  JR   NC,er2x   ; reached the place
041B   7E                     LD   A,(HL)   
041C   23                     INC   HL   
041D   FE 0A                  CP   10   
041F   20 F4                  JR   NZ,er2   
0421   F1                     POP   AF   
0422   18 EF                  JR   er1   
0424   E1           ER2X:     POP   HL   
0425   C5           ER3:      PUSH   BC   
0426   E5                     PUSH   HL   
0427   EB                     EX   DE,HL   
0428   CD 0E 03               CALL   pdec   ; the line
042B   3E 2C                  LD   A,","   
042D   EF                     RST   28h   
042E   D1                     POP   DE   
042F   E1                     POP   HL   
0430   E5                     PUSH   HL   
0431   B7                     OR   A   
0432   ED 52                  SBC   HL,DE   
0434   23                     INC   HL   
0435   CD 0E 03               CALL   pdec   ; the column
0438   CD 22 02               CALL   pnl   
043B   22                     DB   22h   
043C   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
043D   06 10                  LD   B,16   ;   if the line or the program ends first
043F   7E           ER4:      LD   A,(HL)   
0440   23                     INC   HL   
0441   B7                     OR   A   
0442   28 0B                  JR   Z,er5   
0444   FE 0D                  CP   13   
0446   28 07                  JR   Z,er5   
0448   FE 0A                  CP   10   
044A   28 03                  JR   Z,er5   
044C                          ENDIF      
044C                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
044C                          ENDIF      ;   screen on it. The editor's loader ends
044C                          IF   CHECKED   ;   the text at the first ^Z.)
044C   EF                     RST   28h   
044D   10 F0                  DJNZ   er4   
044F                ER5:         ; (on into the two stack lines)
044F                             ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
044F                             ;                       Rtn n
044F                             ; TOS is in memory with the rest (pushed) by now.
044F   CD 22 02               CALL   pnl   
0452   53 74 6B 20 22         DB   "Stk ",22h   
0457   21 06 7E               LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
045A   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
045B   E7                     RST   20h   ;   with the first value and holds nothing)
045C   CD A3 04               CALL   phalf   ; the depth
045F   3E 3A                  LD   A,":"   
0461   EF                     RST   28h   
0462   79                     LD   A,C   
0463   FE 09                  CP   9   
0465   38 0A                  JR   C,er6   
0467   CD 28 02               CALL   pmsg   
046A   20 2E 2E 2E 22         DB   " ...",22h   
046F   0E 08                  LD   C,8   
0471   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0473   69                     LD   L,C   
0474   29                     ADD   HL,HL   
0475   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0476   0C                     INC   C   
0477   0D           ER7:      DEC   C   
0478   28 0F                  JR   Z,er8   
047A   2B                     DEC   HL   
047B   56                     LD   D,(HL)   
047C   2B                     DEC   HL   
047D   5E                     LD   E,(HL)   
047E   E5                     PUSH   HL   
047F   3E 20                  LD   A," "   
0481   EF                     RST   28h   
0482   EB                     EX   DE,HL   
0483   CD 06 03               CALL   psgn   
0486   E1                     POP   HL   
0487   18 EE                  JR   er7   
0489   CD 22 02     ER8:      CALL   pnl   
048C   52 74 6E 20 22         DB   "Rtn ",22h   
0491   D9                     EXX      ; RSTOP - HL' is under 256 (the pointer is
0492   3E E0                  LD   A,RSTOP&0FFh   ;   at most one entry below its page), so
0494   95                     SUB   L   ;   the low bytes are enough
0495   D9                     EXX      
0496   6F                     LD   L,A   
0497   26 00                  LD   H,0   
0499   CD A3 04               CALL   phalf   
049C   CD 22 02               CALL   pnl   
049F   22                     DB   22h   
04A0                          ENDIF      
04A0                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
04A0                          ENDIF      
04A0                          IF   CHECKED*EDITOR   
04A0   C3 ED 04               JP   edit0   ; back to the editor, with both stacks cleared
04A3                          ENDIF      
04A3                          IF   CHECKED   
04A3                             ; phalf: print half of HL, and leave it in C.
04A3   CB 3C        PHALF:    SRL   H   
04A5   CB 1D                  RR   L   
04A7   E5                     PUSH   HL   
04A8   CD 0E 03               CALL   pdec   
04AB   C1                     POP   BC   
04AC   C9                     RET      
04AD                          ENDIF      
04AD                             ; =============================================================================
04AD                             ;  The line editor (EDITOR = 1)
04AD                             ; 
04AD                             ;  The interpreter starts here, and a program that ends comes back here.
04AD                             ;  There is no prompt. It follows the spec's suggested standard for a line
04AD                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
04AD                             ; 
04AD                             ;    n text    put the text in as line n; the lines from n on move down. A
04AD                             ;              number past the end (or 0) adds the line at the end.
04AD                             ;    n         take line n out
04AD                             ;    anything else is run at once, as B8Script. (Start such a line with a
04AD                             ;    space if it would begin with a digit.)
04AD                             ; 
04AD                             ;  A command key ends the line too, and takes what was typed as its argument:
04AD                             ; 
04AD                             ;    ^G        run the program
04AD                             ;    n ^L      list from line n (no number: all of it). Any key holds the
04AD                             ;              list until another key is pressed; Ctrl-C ends it.
04AD                             ;    n ^E      put line n in the input line; Return puts it back, changed
04AD                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
04AD                             ;              last time). Generic: what is typed, or pasted, from now until
04AD                             ;              ^Z replaces the program; it is not echoed.
04AD                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
04AD                             ;              time). Generic: the text is printed, as it is.
04AD                             ;    ^N ^N     new: no program (the key twice in a row)
04AD                             ;    ^X        leave (to LEAVE)
04AD                             ; 
04AD                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
04AD                             ;  a character goes in at the cursor; Backspace and DEL take out the one
04AD                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
04AD                             ;  sent to the terminal, so any terminal will do.
04AD                             ; 
04AD                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
04AD                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
04AD                             ;  125 characters; the one character after a line number separates it from
04AD                             ;  the text and is not stored. The text is kept as it is typed, each line
04AD                             ;  ending in CR LF, at PROG.
04AD                             ; 
04AD                             ;  What lasts from one line to the next: the program, the words, the
04AD                             ;  variables and the data stack. An error or a break clears both stacks. The
04AD                             ;  return stack starts empty for every line.
04AD                             ; 
04AD                             ;  Things to know:
04AD                             ;    - Reset empties the program (generic builds).
04AD                             ;    - A word's address points into the program, so run the program again
04AD                             ;      after editing it.
04AD                             ;    - Nothing is printed between a program's output and what is typed next.
04AD                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
04AD                             ;      a line that calls -n? and carries on afterwards runs what was typed.
04AD                             ;      (The stored program never comes back to the line, so it may.)
04AD                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
04AD                             ;      read of the other builds.
04AD                             ; 
04AD                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
04AD                             ;  the last line left there, with TOS pushed like the rest.
04AD                             ; =============================================================================
04AD                          IF   EDGEN   
04AD                INIT:        ; reset (A = 0)
04AD                          ENDIF      
04AD                          IF   EDGEN*CHECKED   
04AD                             ; Clear the lower half of the letter page: every variable starts at 0, and
04AD                             ; every word cell holds 0000h, the address an undefined word is caught at
04AD                             ; (see e_hi).
04AD   21 00 82               LD   HL,LET   
04B0   77           INI1:     LD   (HL),A   
04B1   2C                     INC   L   
04B2   F2 B0 04               JP   P,ini1   ; +00h to +7Fh
04B5                          ENDIF      
04B5                          IF   EDGEN   
04B5   18 36                  JR   edit0   
04B7                          ENDIF      
04B7                          IF   EDITOR   
04B7                             ; ^F, right arrow: one to the right, by printing the character there
04B7   7D           RIGHT:    LD   A,L   
04B8   BB                     CP   E   
04B9   28 4F                  JR   Z,ed1   ; at the end
04BB   7E                     LD   A,(HL)   
04BC   2C                     INC   L   
04BD   18 2B                  JR   lf1   
04BF                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
04BF                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
04BF                             ; ends the sequence, and act on C (right) and D (left).
04BF   01 C8 00     ESC:      LD   BC,5*MSLOOP   
04C2   CD 06 FF     ES1:      CALL   rawk   
04C5   20 0A                  JR   NZ,es2   
04C7   0B                     DEC   BC   
04C8   78                     LD   A,B   
04C9   B1                     OR   C   
04CA   20 F6                  JR   NZ,es1   
04CC   CD 3F 05               CALL   fin   ; no second key: the line is dropped
04CF   18 27                  JR   edit   
04D1   FE 5B        ES2:      CP   "["   
04D3   20 35                  JR   NZ,ed1   ; not a sequence known here
04D5   CD 98 05     ES3:      CALL   ekey   
04D8   FE 40                  CP   40h   
04DA   38 F9                  JR   C,es3   ; (its parameters)
04DC   D6 43                  SUB   "C"   
04DE   28 D7                  JR   Z,right   
04E0   3D                     DEC   A   ; "D"?
04E1   20 27                  JR   NZ,ed1   ; no: on into left
04E3                             ; ^B, left arrow: the cursor goes one to the left
04E3   7D           LEFT:     LD   A,L   
04E4   87                     ADD   A,A   
04E5   28 23                  JR   Z,ed1   ; (L = 80h: at the start)
04E7   2D                     DEC   L   
04E8   3E 08                  LD   A,8   
04EA   EF           LF1:      RST   28h   
04EB   18 1D                  JR   ed1   
04ED                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
04ED                             ;   is shown, in case the program had hidden it and could not show it again.
04ED                             ; skend: a program that ended inside skip: its return address goes.
04ED                             ; edend: a program that ended: TOS joins the rest of the data stack.
04ED   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
04F0                          ENDIF      
04F0                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
04F0                          ENDIF      
04F0                          IF   EDITOR*(1-ANS)   
04F0   3E 01                  LD   A,1   
04F2   CD 12 FF               CALL   CONCUR   ; show the cursor
04F5                          ENDIF      
04F5                          IF   EDITOR   
04F5   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
04F6   D1           SKEND:    POP   DE   
04F7   E5           EDEND:    PUSH   HL   
04F8                             ; edit: start a new input line.
04F8   D9           EDIT:     EXX      
04F9   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
04FC   D9                     EXX      
04FD   21 00 00               LD   HL,0   
0500   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0503   22 3A 82               LD   (EDLN),HL   ; no line is being edited
0506   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
0509   5D                     LD   E,L   ;   E = the end of the line (its low byte)
050A   CD 98 05     ED1:      CALL   ekey   
050D   FE 7F                  CP   7Fh   
050F   28 40                  JR   Z,bsp   ; DEL
0511   FE 20                  CP   " "   
0513   30 56                  JR   NC,insc   
0515   FE 09                  CP   9   
0517   28 52                  JR   Z,insc   ; Tab is text
0519   FE 08                  CP   8   
051B   28 34                  JR   Z,bsp   
051D   FE 02                  CP   2   
051F   28 C2                  JR   Z,left   ; ^B
0521   FE 06                  CP   6   
0523   28 92                  JR   Z,right   ; ^F
0525   FE 1B                  CP   1Bh   
0527   28 96                  JR   Z,esc   
0529   E5                     PUSH   HL   ; a command key? Look it up
052A   21 9E 05               LD   HL,cmds   
052D   06 08                  LD   B,NCMD   
052F   BE           ED2:      CP   (HL)   
0530   23                     INC   HL   
0531   28 07                  JR   Z,ed3   
0533   23                     INC   HL   
0534   23                     INC   HL   
0535   10 F8                  DJNZ   ed2   
0537   E1                     POP   HL   
0538   18 D0                  JR   ed1   ; no: the key is ignored
053A   7E           ED3:      LD   A,(HL)   
053B   23                     INC   HL   
053C   66                     LD   H,(HL)   
053D   6F                     LD   L,A   
053E   E3                     EX   (SP),HL   ; the command's address: fin returns to it
053F                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
053F                             ; terminal. Leaves BC -> the line and HL -> the NUL.
053F   26 82        FIN:      LD   H,LETPAGE   
0541   6B                     LD   L,E   
0542   36 0D                  LD   (HL),13   
0544   2C                     INC   L   
0545   36 0A                  LD   (HL),10   
0547   2D                     DEC   L   
0548   CD A4 06               CALL   prl   ; (prints the CR LF)
054B   36 00                  LD   (HL),0   
054D   01 80 82               LD   BC,LINEBUF   
0550   C9                     RET      
0551                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
0551                             ; left, the rest of the line moves down over it, and the last place (now a
0551                             ; space) is printed over along with the rest.
0551   7D           BSP:      LD   A,L   
0552   87                     ADD   A,A   
0553   28 B5                  JR   Z,ed1   ; at the start
0555   2D                     DEC   L   
0556   3E 08                  LD   A,8   
0558   EF                     RST   28h   
0559   E5                     PUSH   HL   
055A   2C           BS1:      INC   L   
055B   7E                     LD   A,(HL)   
055C   2D                     DEC   L   
055D   77                     LD   (HL),A   
055E   2C                     INC   L   
055F   7D                     LD   A,L   
0560   BB                     CP   E   
0561   20 F7                  JR   NZ,bs1   
0563   2D                     DEC   L   
0564   36 20                  LD   (HL)," "   
0566   E1                     POP   HL   
0567   53                     LD   D,E   
0568   1D                     DEC   E   
0569   18 15                  JR   ic2   
056B                             ; A character goes in at the cursor: it ripples up through the rest of the
056B                             ; line, the cursor moves on, and the rest is printed again.
056B   47           INSC:     LD   B,A   
056C   7B                     LD   A,E   
056D   FE FD                  CP   0FDh   
056F   28 99                  JR   Z,ed1   ; the line is full: 125 characters
0571   78                     LD   A,B   
0572   EF                     RST   28h   
0573   E5                     PUSH   HL   
0574   7E           IC1:      LD   A,(HL)   
0575   70                     LD   (HL),B   
0576   47                     LD   B,A   
0577   7D                     LD   A,L   
0578   2C                     INC   L   
0579   BB                     CP   E   
057A   20 F8                  JR   NZ,ic1   
057C   E1                     POP   HL   
057D   2C                     INC   L   
057E   1C                     INC   E   
057F   53                     LD   D,E   
0580   CD 85 05     IC2:      CALL   tail   
0583   18 85                  JR   ed1   
0585                             ; tail: print the line from the cursor to D (a low byte), and bring the
0585                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0585   4D           TAIL:     LD   C,L   
0586   7D           TA1:      LD   A,L   
0587   BA                     CP   D   
0588   28 05                  JR   Z,ta2   
058A   7E                     LD   A,(HL)   
058B   EF                     RST   28h   
058C   2C                     INC   L   
058D   18 F7                  JR   ta1   
058F   7D           TA2:      LD   A,L   
0590   B9                     CP   C   
0591   C8                     RET   Z   
0592   3E 08                  LD   A,8   
0594   EF                     RST   28h   
0595   2D                     DEC   L   
0596   18 F7                  JR   ta2   
0598                             ; ekey: wait for a key
0598   CD 06 FF     EKEY:     CALL   rawk   
059B   28 FB                  JR   Z,ekey   
059D   C9                     RET      
059E                             ; The command keys, and where each goes (after fin).
059E   0D           CMDS:     DB   13   
059F   EE 05                  DW   cret   
05A1   07                     DB   7   ; ^G
05A2   36 06                  DW   crun   
05A4   0C                     DB   12   ; ^L
05A5   4C 06                  DW   clist   
05A7   05                     DB   5   ; ^E
05A8   C4 05                  DW   cedln   
05AA   12                     DB   18   ; ^R
05AB   B0 06                  DW   cread   
05AD   17                     DB   23   ; ^W
05AE   DD 06                  DW   cwrite   
05B0   0E                     DB   14   ; ^N
05B1   B6 05                  DW   cnew   
05B3   18                     DB   24   ; ^X
05B4   09 FF                  DW   LEAVE   
05B6                NCMD:     EQU   8   
05B6                             ; ^N ^N: no program, if the next key is ^N too
05B6   CD 98 05     CNEW:     CALL   ekey   
05B9   FE 0E                  CP   14   
05BB   20 04                  JR   NZ,ged0   
05BD   AF                     XOR   A   
05BE   32 00 83               LD   (PROG),A   
05C1   C3 F8 04     GED0:     JP   edit   
05C4                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
05C4                             ; line it was: Return puts the text back in its place.
05C4   CD 90 02     CEDLN:    CALL   rdnum   
05C7   E5                     PUSH   HL   
05C8   CD 8C 06               CALL   find   ; HL -> the line, or the NUL if there is none
05CB   D1                     POP   DE   
05CC   7E                     LD   A,(HL)   
05CD   B7                     OR   A   
05CE   28 F1                  JR   Z,ged0   
05D0   ED 53 3A 82            LD   (EDLN),DE   
05D4   11 80 82               LD   DE,LINEBUF   
05D7   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
05D8   FE 0D                  CP   13   
05DA   28 0D                  JR   Z,ce2   
05DC   FE 0A                  CP   10   
05DE   28 09                  JR   Z,ce2   
05E0   12                     LD   (DE),A   
05E1   EF                     RST   28h   
05E2   23                     INC   HL   
05E3   1C                     INC   E   
05E4   7B                     LD   A,E   
05E5   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
05E7   20 EE                  JR   NZ,ce1   
05E9   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
05EA   5D                     LD   E,L   
05EB   C3 0A 05               JP   ed1   
05EE                             ; Return. If ^E put a line here, the text goes back in its place. If not:
05EE                             ; a number and text is a line to put in, a number alone a line to take out,
05EE                             ; and anything else is run where it is.
05EE   E5           CRET:     PUSH   HL   ; the end of what was typed
05EF   2A 3A 82               LD   HL,(EDLN)   
05F2   7C                     LD   A,H   
05F3   B5                     OR   L   
05F4   28 07                  JR   Z,cr1   
05F6   E5                     PUSH   HL   
05F7   CD 7C 06               CALL   delln   
05FA   E1                     POP   HL   
05FB   18 13                  JR   ins   
05FD   CD 90 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0600   79                     LD   A,C   ; C is still 80h if there was no number:
0601   87                     ADD   A,A   ;   only then is twice it 0
0602   28 36                  JR   Z,st0p   ; no number: run the line
0604   0A                     LD   A,(BC)   
0605   FE 0D                  CP   13   
0607   20 06                  JR   NZ,cr2   
0609   D1                     POP   DE   ; the number alone: take that line out
060A   CD 7C 06               CALL   delln   
060D   18 24                  JR   gedit   
060F   03           CR2:      INC   BC   ; step over the one character after the number
0610                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0610                             ; CR and LF included, and copy it in.
0610   CD 8C 06     INS:      CALL   find   ; HL -> where it goes
0613   D1                     POP   DE   ; the end of what was typed
0614   7B                     LD   A,E   
0615   91                     SUB   C   ; A = the length of the text, with its CR LF
0616   C5                     PUSH   BC   ; the text
0617   4F                     LD   C,A   
0618   06 00                  LD   B,0   
061A   C5                     PUSH   BC   ; its length
061B   54                     LD   D,H   
061C   5D                     LD   E,L   ; DE = where it goes
061D   AF                     XOR   A   
061E   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
061F   ED B1                  CPIR      ; HL -> one past the program's NUL
0621   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0623   44                     LD   B,H   
0624   4D                     LD   C,L   
0625   19                     ADD   HL,DE   
0626   2B                     DEC   HL   ; HL -> the NUL
0627   EB                     EX   DE,HL   
0628   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0629   E5                     PUSH   HL   
062A   19                     ADD   HL,DE   ; the NUL's new place
062B   EB                     EX   DE,HL   
062C   ED B8                  LDDR      ; move the rest of the program up
062E   C1                     POP   BC   ; the length
062F   D1                     POP   DE   ; where it goes
0630   E1                     POP   HL   ; the text
0631   ED B0                  LDIR      
0633   C3 F8 04     GEDIT:    JP   edit   
0636                             ; ^G: run the program. st0p: run the typed line (BC -> it).
0636   01 00 83     CRUN:     LD   BC,PROG   
0639   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
063A   E1           ST0P:     POP   HL   ; (the end of what was typed)
063B                             ; st0: start running at BC. The heap starts after the stored program's NUL.
063B   21 00 83     ST0:      LD   HL,PROG   
063E   AF                     XOR   A   
063F   BE           ST1:      CP   (HL)   
0640   23                     INC   HL   
0641   20 FC                  JR   NZ,st1   
0643   22 7C 82               LD   (HEAP),HL   
0646                          ENDIF      
0646                          IF   EDITOR*CHECKED   
0646   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0647   22 38 82               LD   (NPEND),HL   ;   release below it
064A                          ENDIF      
064A                          IF   EDITOR   
064A   E1                     POP   HL   ; TOS: the data stack is as the last line left it
064B   F7                     RST   30h   ; (its return address is thrown away)
064C                             ; ^L: list from line n. DE = the number of the line at HL.
064C   CD 90 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
064F   7C                     LD   A,H   
0650   B5                     OR   L   
0651   20 01                  JR   NZ,li0   
0653   2C                     INC   L   ;   then from line 1
0654   E5           LI0:      PUSH   HL   
0655   CD 8C 06               CALL   find   
0658   D1                     POP   DE   
0659   7E           LI1:      LD   A,(HL)   
065A   B7                     OR   A   
065B   28 D6                  JR   Z,gedit   ; the end of the text
065D   CD 06 FF               CALL   rawk   
0660   28 09                  JR   Z,li3   ; no key: carry on
0662   FE 03                  CP   3   
0664   C4 98 05               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
0667   FE 03                  CP   3   
0669   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
066B   E5           LI3:      PUSH   HL   
066C   D5                     PUSH   DE   
066D   EB                     EX   DE,HL   
066E   CD 0E 03               CALL   pdec   ; the line's number,
0671   3E 20                  LD   A," "   
0673   EF                     RST   28h   ;   a space,
0674   D1                     POP   DE   
0675   E1                     POP   HL   
0676   13                     INC   DE   
0677   CD A4 06               CALL   prl   ;   and the line
067A   18 DD                  JR   li1   
067C                             ; delln: take line n (in HL) out: copy everything after it down over it.
067C   CD 8C 06     DELLN:    CALL   find   
067F   54                     LD   D,H   
0680   5D                     LD   E,L   
0681   CD 9A 06               CALL   nxl   ; HL -> the next line
0684   7E           DE1:      LD   A,(HL)   
0685   12                     LD   (DE),A   
0686   23                     INC   HL   
0687   13                     INC   DE   
0688   B7                     OR   A   
0689   20 F9                  JR   NZ,de1   
068B   C9                     RET      
068C                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
068C                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
068C   EB           FIND:     EX   DE,HL   
068D   21 00 83               LD   HL,PROG   
0690   1B           FI1:      DEC   DE   
0691   7A                     LD   A,D   
0692   B3                     OR   E   
0693   C8                     RET   Z   
0694   CD 9A 06               CALL   nxl   
0697   20 F7                  JR   NZ,fi1   
0699   C9                     RET      
069A                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
069A                             ; stop at the NUL that ends the text (and return zero).
069A   7E           NXL:      LD   A,(HL)   
069B   B7                     OR   A   
069C   C8                     RET   Z   
069D   23                     INC   HL   
069E   FE 0A                  CP   10   
06A0   20 F8                  JR   NZ,nxl   
06A2   B7                     OR   A   
06A3   C9                     RET      
06A4                             ; prl: print the line at HL, to its LF; HL -> just past it.
06A4   7E           PRL:      LD   A,(HL)   
06A5   EF                     RST   28h   
06A6   7E                     LD   A,(HL)   
06A7   23                     INC   HL   
06A8   FE 0A                  CP   10   
06AA   20 F8                  JR   NZ,prl   
06AC   C9                     RET      
06AD                          ENDIF      
06AD                          IF   EDGEN   
06AD   C3 F8 04     GED1:     JP   edit   
06B0                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
06B0                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
06B0                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
06B0                             ; line with no end is given one. Nothing is echoed, and there is no check
06B0                             ; for running out of memory.
06B0   21 FF 82     CREAD:    LD   HL,PROG-1   
06B3   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
06B5   23                     INC   HL   ;   the line buffer's last, and spare)
06B6   CD 98 05     RD1:      CALL   ekey   
06B9   4F                     LD   C,A   
06BA   FE 1A                  CP   1Ah   
06BC   20 02                  JR   NZ,rd2   
06BE   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
06C0   FE 0A        RD2:      CP   10   
06C2   20 07                  JR   NZ,rd3   
06C4   2B                     DEC   HL   
06C5   BE                     CP   (HL)   
06C6   23                     INC   HL   
06C7   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
06C9   3E 0D                  LD   A,13   ; anywhere else it ends the line
06CB   77           RD3:      LD   (HL),A   
06CC   23                     INC   HL   
06CD   FE 0D                  CP   13   
06CF   20 03                  JR   NZ,rd4   
06D1   36 0A                  LD   (HL),10   ; after a CR goes a LF
06D3   23                     INC   HL   
06D4   79           RD4:      LD   A,C   
06D5   FE 1A                  CP   1Ah   
06D7   20 DD                  JR   NZ,rd1   
06D9   36 00                  LD   (HL),0   
06DB   18 D0                  JR   ged1   
06DD                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
06DD   21 00 83     CWRITE:   LD   HL,PROG   
06E0   7E           CW1:      LD   A,(HL)   
06E1   B7                     OR   A   
06E2   28 C9                  JR   Z,ged1   
06E4   EF                     RST   28h   
06E5   23                     INC   HL   
06E6   18 F8                  JR   cw1   
06E8                          ENDIF      
06E8                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
06E8                          ENDIF      
06E8                             ; =============================================================================
06E8                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
06E8                          ENDIF      
06E8                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
06E8                          ENDIF      
06E8                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
06E8                          ENDIF      
06E8                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
06E8                          ENDIF      
06E8                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
06E8                          ENDIF      
06E8                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
06E8                          ENDIF      
06E8                IMGEND:      


