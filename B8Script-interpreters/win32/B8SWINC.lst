  1395                              <1> ;  The line editor (EDITOR = 1)
  1396                              <1> ;
  1397                              <1> ;  The interpreter starts here, and a program that ends comes back here.
  1398                              <1> ;  There is no prompt. It follows the spec's suggested standard for a line
  1399                              <1> ;  editor (docs/b8script.md, Environments), and is the Z80's editor, key for
  1400                              <1> ;  key. Type a line and press Return:
  1401                              <1> ;
  1402                              <1> ;    n text    put the text in as line n; the lines from n on move down. A
  1403                              <1> ;              number past the end (or 0) adds the line at the end.
  1404                              <1> ;    n         take line n out
  1405                              <1> ;    anything else is run at once, as B8Script. (Start such a line with a
  1406                              <1> ;    space if it would begin with a digit.)
  1407                              <1> ;
  1408                              <1> ;  A command key ends the line too, and takes what was typed as its argument:
  1409                              <1> ;
  1410                              <1> ;    ^G        run the program
  1411                              <1> ;    n ^L      list from line n (no number: all of it). Any key holds the
  1412                              <1> ;              list until another key is pressed; Ctrl-C ends it.
  1413                              <1> ;    n ^E      put line n in the input line; Return puts it back, changed
  1414                              <1> ;    name ^R   read the file of that name (no name: the current one: the
  1415                              <1> ;              one from the command line, or the last one typed)
  1416                              <1> ;    name ^W   write the program to that file (no name: the current one)
  1417                              <1> ;    ^N ^N     new: no program (the key twice in a row)
  1418                              <1> ;    ^V        view: the build, both stacks, and the program's size, lines
  1419                              <1> ;              and free memory
  1420                              <1> ;    ^X        leave
  1421                              <1> ;
  1422                              <1> ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
  1423                              <1> ;  a character goes in at the cursor; Backspace and DEL take out the one
  1424                              <1> ;  before it; Esc drops the line (after Esc it waits 5 ms for a '[': Esc [ C
  1425                              <1> ;  and Esc [ D are right and left too). Only CR, LF, BS and printing
  1426                              <1> ;  characters are sent to the terminal.
  1427                              <1> ;
  1428                              <1> ;  Lines are counted, not numbered. A typed line holds 125 characters; the
  1429                              <1> ;  one character after a line number separates it from the text and is not
  1430                              <1> ;  stored. The text is kept as typed, each line ending in CR LF, at PROG. A
  1431                              <1> ;  file is read up to its first ^Z, and a last line with no line end is
  1432                              <1> ;  given one; it is written as it is, with no padding.
  1433                              <1> ;
  1434                              <1> ;  What lasts from one line to the next: the program, the words, the
  1435                              <1> ;  variables and the data stack (TOS is kept pushed while the editor runs).
  1436                              <1> ;  An error or a break clears both stacks. The return stack starts empty for
  1437                              <1> ;  every line.
  1438                              <1> ;
  1439                              <1> ;  Registers in the editor: EBX = the cursor, EDX = the end of the line
  1440                              <1> ;  (pointers into the line buffer); EDI is free (edit resets it).
  1441                              <1> ; =============================================================================
  1442                              <1> %if EDITOR
  1443                              <1> ; ^F, right arrow: one to the right, by printing the character there
  1444                              <1> right:  cmp     ebx,edx
  1445                              <1>         je      ed1                     ; at the end
  1446                              <1>         mov     al,[ebx]
  1447                              <1>         inc     ebx
  1448                              <1>         jmp     short lf1
  1449                              <1> 
  1450                              <1> ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
  1451                              <1> ; wait about 5 ms for a second key: after a '[' read on to the letter that
  1452                              <1> ; ends the sequence, and act on C (right) and D (left).
  1453                              <1> esc:    push    5
  1454                              <1>         pop     eax
  1455                              <1>         call    waitk
  1456                              <1>         jnz     .es2
  1457                              <1>         call    fin                     ; no second key: the line is dropped
  1458                              <1>         jmp     edit
  1459                              <1> .es2:   cmp     al,'['
  1460                              <1>         jne     ed1                     ; not a sequence known here
  1461                              <1> .es3:   call    ekey
  1462                              <1>         cmp     al,40h
  1463                              <1>         jb      .es3                    ; (its parameters)
  1464                              <1>         sub     al,'C'
  1465                              <1>         je      right
  1466                              <1>         dec     al                      ; 'D'?
  1467                              <1>         jne     ed1                     ; no: on into left
  1468                              <1> ; ^B, left arrow: the cursor goes one to the left
  1469                              <1> left:   cmp     bl,80h
  1470                              <1>         je      ed1                     ; at the start
  1471                              <1>         dec     ebx
  1472                              <1>         mov     al,8
  1473                              <1> lf1:    call    putc
  1474                              <1>         jmp     ed1
  1475                              <1> 
  1476                              <1> ; edit0: an error or a break: both stacks are cleared.
  1477                              <1> ; skend: a program that ended inside skip: its return address goes.
  1478                              <1> ; edend: a program that ended: TOS joins the rest of the data stack.
  1479                              <1> edit0:  mov     esp,[V(v_dstop)]
  1480                              <1>  %if CHECKED
  1481                              <1>         push    -11                     ; the report went to stderr: back to
  1482                              <1>         call    [V(iat_GetStdHandle)]   ;   stdout
  1483                              <1>         mov     [V(v_outh)],eax
  1484                              <1>  %endif
  1485                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1486                              <1> skend:  pop     eax
  1487                              <1> edend:  push    ebx
  1488                              <1> ; edit: start a new input line.
  1489                              <1> edit:   mov     edi,RSTOP               ; the return stack is empty
  1490                              <1>         xor     eax,eax
  1491                              <1>         mov     [ARENA+HELD],ax         ; no key is held, and the break key is on
  1492                              <1>         mov     [V(v_edln)],eax         ; no line is being edited
  1493                              <1>         mov     ebx,ARENA+LINEBUF       ; EBX = the cursor,
  1494                              <1>         mov     edx,ebx                 ;   EDX = the end of the line
  1495                              <1> ed1:    call    ekey
  1496                              <1>         cmp     al,7Fh
  1497                              <1>         je      bsp                     ; DEL
  1498                              <1>         cmp     al,' '
  1499                              <1>         jae     insc
  1500                              <1>         cmp     al,9
  1501                              <1>         je      insc                    ; Tab is text
  1502                              <1>         cmp     al,8
  1503                              <1>         je      bsp
  1504                              <1>         cmp     al,2
  1505                              <1>         je      left                    ; ^B
  1506                              <1>         cmp     al,6
  1507                              <1>         je      right                   ; ^F
  1508                              <1>         cmp     al,1Bh
  1509                              <1>         je      esc
  1510                              <1>         push    edi                     ; a command key? Look it up
  1511                              <1>         mov     edi,ckeys
  1512                              <1>         push    NCMD
  1513                              <1>         pop     ecx
  1514                              <1>         repne   scasb
  1515                              <1>         pop     edi
  1516                              <1>         jne     ed1                     ; no: the key is ignored
  1517                              <1>         movzx   eax,word [ctabr+ecx*2]  ; the command's address: fin returns
  1518                              <1>         add     eax,IB                  ;   to it
  1519                              <1>         push    eax
  1520                              <1> ; fin: end the input line: CR LF and a NUL after it, and a new line on the
  1521                              <1> ; terminal. Leaves ESI -> the line.
  1522                              <1> fin:    mov     word [edx],0A0Dh
  1523                              <1>         mov     esi,edx
  1524                              <1>         call    prl                     ; (prints the CR LF)
  1525                              <1>         mov     byte [esi],0
  1526                              <1>         mov     esi,ARENA+LINEBUF
  1527                              <1>         ret
  1528                              <1> 
  1529                              <1> ; Backspace, DEL: the character before the cursor goes. The cursor moves
  1530                              <1> ; left, the rest of the line moves down over it, and the last place (now a
  1531                              <1> ; space) is printed over along with the rest.
  1532                              <1> bsp:    cmp     bl,80h
  1533                              <1>         je      ed1                     ; at the start
  1534                              <1>         dec     ebx
  1535                              <1>         mov     al,8
  1536                              <1>         call    putc
  1537                              <1>         mov     ecx,ebx
  1538                              <1> .bs1:   mov     al,[ecx+1]
  1539                              <1>         mov     [ecx],al
  1540                              <1>         inc     ecx
  1541                              <1>         cmp     ecx,edx
  1542                              <1>         jne     .bs1
  1543                              <1>         mov     byte [ecx-1],' '
  1544                              <1>         dec     edx
  1545                              <1>         jmp     short ic2
  1546                              <1> ; A character goes in at the cursor: it ripples up through the rest of the
  1547                              <1> ; line, the cursor moves on, and the rest is printed again.
  1548                              <1> insc:   cmp     dl,0FDh
  1549                              <1>         je      ed1                     ; the line is full: 125 characters
  1550                              <1>         call    putc
  1551                              <1>         mov     ecx,ebx
  1552                              <1> .ic1:   xchg    al,[ecx]
  1553                              <1>         inc     ecx
  1554                              <1>         cmp     ecx,edx
  1555                              <1>         jbe     .ic1
  1556                              <1>         inc     ebx
  1557                              <1>         inc     edx
  1558                              <1>         mov     ecx,edx
  1559                              <1> ic2:    call    tail
  1560                              <1>         jmp     ed1
  1561                              <1> ; tail: print the line from the cursor to ECX, and bring the cursor back
  1562                              <1> ; with backspaces. Nothing at all if the cursor is at ECX.
  1563                              <1> tail:   mov     esi,ebx
  1564                              <1> .ta1:   cmp     esi,ecx
  1565                              <1>         je      .ta2
  1566                              <1>         lodsb
  1567                              <1>         call    putc
  1568                              <1>         jmp     .ta1
  1569                              <1> .ta2:   cmp     esi,ebx
  1570                              <1>         je      .ta3
  1571                              <1>         mov     al,8
  1572                              <1>         call    putc
  1573                              <1>         dec     esi
  1574                              <1>         jmp     .ta2
  1575                              <1> .ta3:   ret
  1576                              <1> 
  1577                              <1> ; ekey: wait for a key
  1578                              <1> ekey:   or      eax,-1
  1579                              <1>         jmp     waitk
  1580                              <1> 
  1581                              <1> ; The command keys, and where each goes (after fin). REPNE SCASB leaves ECX
  1582                              <1> ; = the number of keys after the one found, so the table is backwards. (The
  1583                              <1> ; addresses are kept as RVAs, which fit in a word.)
  1584                              <1> ckeys:  db      13, 7, 12, 5, 18, 23, 14, 22, 24
  1585                              <1> NCMD    equ     $-ckeys
  1586                              <1> ctabr:  dw      exit-IB                 ; ^X
  1587                              <1>         dw      cview-IB                   ; ^V
  1588                              <1>         dw      cnew-IB                 ; ^N
  1589                              <1>         dw      cwrite-IB                  ; ^W
  1590                              <1>         dw      cread-IB                   ; ^R
  1591                              <1>         dw      cedln-IB                   ; ^E
  1592                              <1>         dw      clist-IB                   ; ^L
  1593                              <1>         dw      crun-IB                 ; ^G
  1594                              <1>         dw      cret-IB                 ; Return
  1595                              <1> 
  1596                              <1> ; ^N ^N: no program, if the next key is ^N too
  1597                              <1> cnew:   call    ekey
  1598                              <1>         cmp     al,14
  1599                              <1>         jne     gedit
  1600                              <1>         mov     byte [ARENA+PROG],0
  1601                              <1> gedit:  jmp     edit
  1602                              <1> 
  1603                              <1> ; ^E: line n goes into the input line, to be changed. V_EDLN remembers
  1604                              <1> ; which line it was: Return puts the text back in its place.
  1605                              <1> cedln:  call    rdnum
  1606                              <1>         movzx   eax,dx
  1607                              <1>         push    eax
  1608                              <1>         call    find                    ; EDI -> the line, or the NUL
  1609                              <1>         pop     eax
  1610                              <1>         cmp     byte [edi],0
  1611                              <1>         je      gedit
  1612                              <1>         mov     [V(v_edln)],eax
  1613                              <1>         mov     ebx,ARENA+LINEBUF
  1614                              <1> .ce1:   mov     al,[edi]                ; copy it, and show it, up to its CR
  1615                              <1>         cmp     al,13                   ;   (or LF)
  1616                              <1>         je      .ce2
  1617                              <1>         cmp     al,10
  1618                              <1>         je      .ce2
  1619                              <1>         mov     [ebx],al
  1620                              <1>         call    putc
  1621                              <1>         inc     edi
  1622                              <1>         inc     ebx
  1623                              <1>         cmp     bl,0FDh                 ; (a longer line is cut at 125)
  1624                              <1>         jne     .ce1
  1625                              <1> .ce2:   mov     edx,ebx                 ; the cursor is at the line's end
  1626                              <1>         jmp     ed1
  1627                              <1> 
  1628                              <1> ; Return. If ^E put a line here, the text goes back in its place. If not:
  1629                              <1> ; a number and text is a line to put in, a number alone a line to take out,
  1630                              <1> ; and anything else is run where it is.
  1631                              <1> cret:   push    edx                     ; the end of what was typed
  1632                              <1>         mov     eax,[V(v_edln)]
  1633                              <1>         test    eax,eax
  1634                              <1>         jz      .cr1
  1635                              <1>         push    eax
  1636                              <1>         call    delln
  1637                              <1>         pop     eax
  1638                              <1>         jmp     short ins
  1639                              <1> .cr1:   call    rdnum                   ; DX = the number it starts with
  1640                              <1>         mov     eax,esi                 ; ESI's low byte is still 80h if there
  1641                              <1>         cmp     al,80h                  ;   was no number:
  1642                              <1>         je      runln                   ;   then run the line
  1643                              <1>         movzx   eax,dx
  1644                              <1>         cmp     byte [esi],13
  1645                              <1>         jne     .cr2
  1646                              <1>         pop     edx                     ; the number alone: take that line out
  1647                              <1>         call    delln
  1648                              <1>         jmp     gedit
  1649                              <1> .cr2:   inc     esi                     ; step over the one character after it
  1650                              <1> 
  1651                              <1> ; Put the text at ESI in as line EAX: open a gap of its length there, CR
  1652                              <1> ; and LF included, and copy it in.
  1653                              <1> ins:    call    find                    ; EDI -> where it goes
  1654                              <1>         pop     ecx                     ; the end of what was typed
  1655                              <1>         inc     ecx
  1656                              <1>         inc     ecx
  1657                              <1>         sub     ecx,esi                 ; the length, with its CR LF
  1658                              <1>         push    esi                     ; the text
  1659                              <1>         push    ecx                     ; its length
  1660                              <1>         push    edi                     ; where it goes
  1661                              <1>         mov     esi,edi
  1662                              <1> .in1:   lodsb                           ; find the program's NUL
  1663                              <1>         test    al,al
  1664                              <1>         jnz     .in1
  1665                              <1>         dec     esi
  1666                              <1>         mov     ecx,esi
  1667                              <1>         sub     ecx,edi
  1668                              <1>         inc     ecx                     ; the bytes to move up, NUL included
  1669                              <1>         mov     edi,esi
  1670                              <1>         add     edi,[esp+4]             ; the NUL's new place
  1671                              <1>         std
  1672                              <1>         rep     movsb                   ; move the rest of the program up
  1673                              <1>         cld
  1674                              <1>         pop     edi
  1675                              <1>         pop     ecx
  1676                              <1>         pop     esi
  1677                              <1>         rep     movsb
  1678                              <1>         jmp     gedit
  1679                              <1> 
  1680                              <1> ; ^G: run the program. runln: run the typed line (ESI -> it).
  1681                              <1> crun:   mov     esi,ARENA+PROG
  1682                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1683                              <1> runln:   pop     eax                     ; (the end of what was typed)
  1684                              <1> %endif
  1685                              <1> ; run0: start running at ESI. The heap starts after the stored program's
  1686                              <1> ; NUL. TOS is popped: the data stack is as the last line left it.
  1687 00000771 BA00024100          <1> run0:    mov     edx,ARENA+PROG
  1688 00000776 42                  <1> .st1:   inc     edx
  1689 00000777 807AFF00            <1>         cmp     byte [edx-1],0
  1690 0000077B 75F9                <1>         jne     .st1
  1691 0000077D 6689157C014100      <1>         mov     [ARENA+HEAP],dx
  1692                              <1> %if CHECKED
  1693 00000784 0FB7C2              <1>         movzx   eax,dx                  ; '_' may not release below this
  1694 00000787 894570              <1>         mov     [V(v_npend)],eax
  1695                              <1> %endif
  1696 0000078A 5B                  <1>         pop     ebx
  1697 0000078B FFE5                <1>         jmp     ebp
  1698                              <1> 
  1699                              <1> %if EDITOR
  1700                              <1> ; ^L: list from line n. EDX = the number of the line at ESI.
  1701                              <1> clist:  call    rdnum                   ; DX = n, or 0 if there was none:
  1702                              <1>         movzx   eax,dx
  1703                              <1>         test    eax,eax
  1704                              <1>         jnz     .li0
  1705                              <1>         inc     eax                     ;   then from line 1
  1706                              <1> .li0:   push    eax
  1707                              <1>         call    find
  1708                              <1>         pop     edx
  1709                              <1>         mov     esi,edi
  1710                              <1> .li1:   cmp     byte [esi],0
  1711                              <1>         je      gedit                   ; the end of the text
  1712                              <1>         xor     eax,eax
  1713                              <1>         call    waitk
  1714                              <1>         jz      .li3                    ; no key: carry on
  1715                              <1>         cmp     al,3
  1716                              <1>         je      gedit                   ; Ctrl-C ends the list,
  1717                              <1>         call    ekey                    ;   any other key holds it until the
  1718                              <1>         cmp     al,3                    ;   next (and a Ctrl-C then ends it)
  1719                              <1>         je      gedit
  1720                              <1> .li3:   push    edx
  1721                              <1>         xchg    eax,edx
  1722                              <1>         call    pdec                    ; the line's number,
  1723                              <1>         mov     al,' '
  1724                              <1>         call    putc                    ;   a space,
  1725                              <1>         pop     edx
  1726                              <1>         inc     edx
  1727                              <1>         call    prl                     ;   and the line
  1728                              <1>         jmp     .li1
  1729                              <1> 
  1730                              <1> ; ^V: view.
  1731                              <1> cview:  call    pmsg
  1732                              <1>  %if CHECKED
  1733                              <1>         db      'B8SWINEC 2026-11-21',22h
  1734                              <1>  %else
  1735                              <1>         db      'B8SWINE 2026-11-21',22h
  1736                              <1>  %endif
  1737                              <1>         call    pstk                    ; both stacks
  1738                              <1>         mov     edi,ARENA+PROG
  1739                              <1>         or      ecx,-1
  1740                              <1> .cv1:   inc     ecx                     ; count the lines, and find the end
  1741                              <1>         call    nxl
  1742                              <1>         jnz     .cv1
  1743                              <1>         push    ecx
  1744                              <1>         call    pmsg
  1745                              <1>         db      '/M/JProg ',22h
  1746                              <1>         lea     eax,[edi-(ARENA+PROG)]
  1747                              <1>         call    pdec                    ; the program's size
  1748                              <1>         call    pmsg
  1749                              <1>         db      '/M/JLines ',22h
  1750                              <1>         pop     eax
  1751                              <1>         call    pdec
  1752                              <1>         call    pmsg
  1753                              <1>         db      '/M/JFree ',22h
  1754                              <1>         mov     eax,ARENA+LIMIT-1
  1755                              <1>         sub     eax,edi
  1756                              <1>         call    pdec                    ; the room left for text and heap
  1757                              <1>         call    pmsg
  1758                              <1>         db      '/M/J',22h
  1759                              <1>         jmp     gedit
  1760                              <1> 
  1761                              <1> ; delln: take line EAX out: copy everything after it down over it. Keeps ESI.
  1762                              <1> delln:  push    esi
  1763                              <1>         call    find
  1764                              <1>         push    edi
  1765                              <1>         call    nxl                     ; EDI -> the next line
  1766                              <1>         mov     esi,edi
  1767                              <1>         pop     edi
  1768                              <1> .de1:   lodsb
  1769                              <1>         stosb
  1770                              <1>         test    al,al
  1771                              <1>         jnz     .de1
  1772                              <1>         pop     esi
  1773                              <1>         ret
  1774                              <1> 
  1775                              <1> ; find: EAX = a line number. Returns EDI -> that line, or -> the NUL at the
  1776                              <1> ; end of the text if there are fewer lines (or the number is 0). Keeps ESI.
  1777                              <1> find:   xchg    eax,ecx
  1778                              <1>         mov     edi,ARENA+PROG
  1779                              <1> .fi1:   dec     cx
  1780                              <1>         jz      .fi2
  1781                              <1>         call    nxl
  1782                              <1>         jnz     .fi1
  1783                              <1> .fi2:   ret
  1784                              <1> 
  1785                              <1> ; nxl: step EDI over one line, to just past its LF (and return not-zero),
  1786                              <1> ; or stop at the NUL that ends the text (and return zero).
  1787                              <1> nxl:    mov     al,[edi]
  1788                              <1>         test    al,al
  1789                              <1>         jz      .nx1
  1790                              <1>         inc     edi
  1791                              <1>         cmp     al,10
  1792                              <1>         jne     nxl
  1793                              <1>         test    al,al
  1794                              <1> .nx1:   ret
  1795                              <1> 
  1796                              <1> ; prl: print the line at ESI, to its LF; ESI -> just past it.
  1797                              <1> prl:    lodsb
  1798                              <1>         call    putc
  1799                              <1>         cmp     al,10
  1800                              <1>         jne     prl
  1801                              <1>         ret
  1802                              <1> 
  1803                              <1> ; ^R: read the file. ^W: write the file (made anew, or emptied first). A
  1804                              <1> ; name typed before the key is the file's name from now on. (A file that
  1805                              <1> ; can't be made or written is not noticed: nothing is written.)
  1806                              <1> cread:  call    setname
  1807                              <1>         call    load
  1808                              <1>         jmp     gedit
  1809                              <1> cwrite: call    setname
  1810                              <1>         mov     edi,ARENA+PROG
  1811                              <1>         xor     eax,eax
  1812                              <1>         or      ecx,-1
  1813                              <1>         repne   scasb
  1814                              <1>         not     ecx
  1815                              <1>         dec     ecx                     ; the length of the text
  1816                              <1>         push    ecx
  1817                              <1>         push    eax                     ; hTemplateFile
  1818                              <1>         push    eax                     ; dwFlagsAndAttributes
  1819                              <1>         push    2                       ; CREATE_ALWAYS
  1820                              <1>         push    eax                     ; lpSecurityAttributes
  1821                              <1>         push    eax                     ; no sharing
  1822                              <1>         push    40000000h               ; GENERIC_WRITE
  1823                              <1>         push    NAMEBUF
  1824                              <1>         call    [V(iat_CreateFileA)]
  1825                              <1>         pop     ecx
  1826                              <1>         push    eax                     ; (for CloseHandle)
  1827                              <1>         push    0
  1828                              <1>         lea     edx,[V(v_cnt)]
  1829                              <1>         push    edx
  1830                              <1>         push    ecx
  1831                              <1>         push    ARENA+PROG
  1832                              <1>         push    eax
  1833                              <1>         call    [V(iat_WriteFile)]
  1834                              <1>         call    [V(iat_CloseHandle)]
  1835                              <1>         jmp     gedit
  1836                              <1> 
  1837                              <1> ; setname: if a name was typed (the line does not start with its CR), it is
  1838                              <1> ; the file's name from now on, as typed (a Windows path).
  1839                              <1> setname:mov     esi,ARENA+LINEBUF
  1840                              <1>         cmp     byte [esi],13
  1841                              <1>         je      .sn2
  1842                              <1>         mov     edi,NAMEBUF
  1843                              <1> .sn1:   lodsb
  1844                              <1>         cmp     al,13
  1845                              <1>         jne     .sn3
  1846                              <1>         mov     al,0
  1847                              <1> .sn3:   stosb
  1848                              <1>         test    al,al
  1849                              <1>         jnz     .sn1
  1850                              <1> .sn2:   ret
  1851                              <1> %endif
