022F   4D                     MOV   C,L   ; ... jump to it ...
0230   EB                     XCHG      
0231   C3 3B 05               JMP   rpushd   ; ... and push it back (which drops the flag)
0234                          ENDIF      
0234                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0234                             ; "-" has two jobs: directly before a digit it starts a negative number.
0234   0A           H_SUB:    LDAX   B   
0235   D6 30                  SUI   "0"   
0237   FE 0A                  CPI   10   
0239   DA 7E 03               JC   negnum   
