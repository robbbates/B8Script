  2404                              <1> ; =============================================================================
  2405                              <1> ;  The inner loop: read one character and sort it by range.
  2406                              <1> ;
  2407                              <1> ;    00h          end of program
  2408                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  2409                              <1> ;                 build stops on 80h-FFh: X)
  2410                              <1> ;    30h-39h      digit: read a whole number
  2411                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  2412                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  2413                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  2414                              <1> ;
  2415                              <1> ;  (The fast build has none of this: `next` is its table's dispatcher. See
  2416                              <1> ;  "The fast build".)
  2417                              <1> ; =============================================================================
  2418                              <1> %if FAST == 0
  2419                              <1> ; Digits: step back onto the first digit and read the whole number.
  2420 00000640 53                  <1> digit:  push    ebx
  2421 00000641 4E                  <1>         dec     esi
  2422                              <1>         CALLP   rdnum
   223                              <2>  %if P_%1
   224                              <2>  call [V(p_%1)]
   225                              <2>  %else
   226 00000642 E844FEFFFF          <2>  call %1
   227                              <2>  %endif
  2423 00000647 FFE5                <1>         jmp     ebp
  2424                              <1> 
  2425                              <1>  %if SBASEU == 0
  2426                              <1> ; a-z: push the cell's address (the cell is the variable). (The unchecked
  2427                              <1> ; base build does x@ and x! in one step: its `lower` is after the window.)
  2428 00000649 53                  <1> lower:  push    ebx
  2429 0000064A 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  2430 00000651 FFE5                <1>         jmp     ebp
  2431                              <1>  %endif
  2432                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  2433                              <1> ; next in reach)
  2434 00000653 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  2435 00000655 7505                <1>         jnz     next                    ; the rest are ignored
  2436 00000657 E94EFDFFFF          <1>         jmp     endprog
  2437                              <1> %endif
  2438                              <1> %if CHECKED
  2439                              <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  2440                              <1>         jmp     error
  2441                              <1> %endif
  2442                              <1> %if FAST
  2443                              <1> next:   NEXTF                           ; (the fast build: through the table)
  2444                              <1> %else
  2445                              <1> next:
  2446                              <1> %if CHECKED
  2447                              <1>         call    chkstk                  ; both stacks, once per character
  2448                              <1> %endif
  2449 0000065C 31C0                <1>         xor     eax,eax
  2450 0000065E AC                  <1>         lodsb
  2451 0000065F 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  2452 00000661 72F0                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  2453 00000663 3C0F                <1>         cmp     al,0Fh
  2454 00000665 7226                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  2455 00000667 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  2456 00000669 3C0A                <1>         cmp     al,0Ah
  2457 0000066B 72D3                <1>         jb      digit                   ; 30h-39h
  2458 0000066D 3C11                <1>         cmp     al,11h
  2459 0000066F 721A                <1>         jb      p3a                     ; 3Ah-40h
  2460 00000671 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  2461 00000673 3C1A                <1>         cmp     al,1Ah
  2462 00000675 0F825AFAFFFF        <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  2463 0000067B 3C20                <1>         cmp     al,20h
  2464 0000067D 720A                <1>         jb      p5b                     ; 5Bh-60h
  2465 0000067F 3C3A                <1>         cmp     al,3Ah
  2466 00000681 72C6                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  2467 00000683 3C3E                <1>         cmp     al,3Eh
  2468                              <1> %if CHECKED
  2469                              <1>         je      next                    ; 7Fh, DEL: ignored
  2470                              <1>         jae     e_hi                    ; 80h-FFh: reserved
  2471                              <1> %else
  2472 00000685 73D5                <1>         jae     next                    ; 7Fh-FFh: ignored
  2473                              <1> %endif
  2474 00000687 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  2475 00000689 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  2476 0000068B 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  2477 0000068D 8A80[A2040000]      <1> punct:  mov     al,[ptab+eax]
  2478 00000693 8D80[FB000000]      <1>         lea     eax,[hbase+eax]
  2479 00000699 FFE0                <1>         jmp     eax
  2480                              <1> %endif
