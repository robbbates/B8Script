E2EC                             ; ---- "_" is the last handler: its body may leave the page
E2EC                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E2EC                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E2EC                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   0,X   
                              STA   HEAP   
                              STY   0,X   
                              LDA   HEAP+1   
                              TAY      
                              ADC   1,X   
                              STA   HEAP+1   
                              STY   1,X   
                              RTS      
E2EC                          ENDIF      
E2EC                             ; The checked build works the new top out first, in T0 and Y, and stops with
E2EC                             ; H, the count still on the stack, if it is at or past the limit, below the
E2EC                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E2EC                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E2EC                             ; a signed number from -8000h, so the add overflows exactly when the true
E2EC                             ; sum leaves 0000h-FFFFh.
E2EC                          IF   CHECKED   
E2EC   AD 7C 04     H_ALLOC:   LDA   HEAP   
E2EF   75 00                  ADC   0,X   
E2F1   85 04                  STA   T0   
E2F3   AD 7D 04               LDA   HEAP+1   
E2F6   49 80                  EOR   #80h   
E2F8   75 01                  ADC   1,X   
E2FA   70 25                  BVS   e_heap   ; wrapped
E2FC   49 80                  EOR   #80h   ; the new top's high byte
E2FE   C9 E0                  CMP   #HEAPLIM   
E300   B0 1F                  BCS   e_heap   ; at or past the limit
E302   A8                     TAY      
E303   A5 04                  LDA   T0   
E305   CD 38 04               CMP   PEND   
E308   98                     TYA      
E309   ED 39 04               SBC   PEND+1   
E30C   90 13                  BCC   e_heap   ; below the program's end
E30E   AD 7C 04               LDA   HEAP   
E311   95 00                  STA   0,X   
E313   A5 04                  LDA   T0   
E315   8D 7C 04               STA   HEAP   
E318   AD 7D 04               LDA   HEAP+1   
E31B   95 01                  STA   1,X   
E31D   8C 7D 04               STY   HEAP+1   
E320   60                     RTS      
