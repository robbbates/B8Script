055A   62 05                  DW   cnew   
055C   16                     DB   22   ; ^V
055D   2D 06                  DW   cview   
055F   18                     DB   24   ; ^X
0560   00 00                  DW   LEAVE   
0562                NCMD:     EQU   9   
0562                             ; ^N ^N: no program, if the next key is ^N too
0562   CD 41 05     CNEW:     CALL   ekey   
0565   FE 0E                  CP   14   
0567   20 04                  JR   NZ,ged0   
0569   AF                     XOR   A   
056A   32 00 0B               LD   (PROG),A   
056D   C3 A1 04     GED0:     JP   edit   
0570                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0570                             ; line it was: Return puts the text back in its place.
0570   CD 03 03     CEDLN:    CALL   rdnum   
0573   E5                     PUSH   HL   
0574   CD A6 06               CALL   find   ; HL -> the line, or the NUL if there is none
0577   D1                     POP   DE   
0578   7E                     LD   A,(HL)   
0579   B7                     OR   A   
057A   28 F1                  JR   Z,ged0   
057C   ED 53 3A 0A            LD   (EDLN),DE   
0580   11 80 0A               LD   DE,LINEBUF   
0583   7E           CE1:      LD   A,(HL)   
0584   FE 0D                  CP   13   
0586   28 0C                  JR   Z,ce2   
0588   FE 0A                  CP   10   
058A   28 08                  JR   Z,ce2   
058C   12                     LD   (DE),A   
058D   23                     INC   HL   
058E   1C                     INC   E   
058F   7B                     LD   A,E   
0590   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0592   20 EF                  JR   NZ,ce1   
0594   21 80 0A     CE2:      LD   HL,LINEBUF   ; show it; the cursor ends up at its end
0597   7D           CE3:      LD   A,L   
0598   BB                     CP   E   
0599   CA B3 04               JP   Z,ed1   
059C   7E                     LD   A,(HL)   
059D   EF                     RST   28h   
059E   2C                     INC   L   
059F   18 F6                  JR   ce3   
05A1                             ; Return. If ^E put a line here, the text goes back in its place. If not:
05A1                             ; a number and text is a line to put in, a number alone a line to take out,
05A1                             ; and anything else is run where it is.
05A1   E5           CRET:     PUSH   HL   ; the end of what was typed
05A2   2A 3A 0A               LD   HL,(EDLN)   
05A5   7C                     LD   A,H   
05A6   B5                     OR   L   
05A7   28 07                  JR   Z,cr1   
05A9   E5                     PUSH   HL   
05AA   CD 96 06               CALL   delln   
05AD   E1                     POP   HL   
05AE   18 13                  JR   ins   
05B0   CD 03 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
05B3   79                     LD   A,C   ; C is still 80h if there was no number:
05B4   87                     ADD   A,A   ;   only then is twice it 0
05B5   28 36                  JR   Z,st0p   ; no number: run the line
05B7   0A                     LD   A,(BC)   
05B8   FE 0D                  CP   13   
05BA   20 06                  JR   NZ,cr2   
05BC   D1                     POP   DE   ; the number alone: take that line out
05BD   CD 96 06               CALL   delln   
05C0   18 24                  JR   gedit   
05C2   03           CR2:      INC   BC   ; step over the one character after the number
05C3                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
05C3                             ; CR and LF included, and copy it in.
05C3   CD A6 06     INS:      CALL   find   ; HL -> where it goes
05C6   D1                     POP   DE   ; the end of what was typed
05C7   7B                     LD   A,E   
05C8   91                     SUB   C   ; A = the length of the text, with its CR LF
05C9   C5                     PUSH   BC   ; the text
05CA   4F                     LD   C,A   
05CB   06 00                  LD   B,0   
05CD   C5                     PUSH   BC   ; its length
05CE   54                     LD   D,H   
05CF   5D                     LD   E,L   ; DE = where it goes
05D0   AF                     XOR   A   
05D1   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
05D2   ED B1                  CPIR      ; HL -> one past the program's NUL
05D4   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
05D6   44                     LD   B,H   
05D7   4D                     LD   C,L   
05D8   19                     ADD   HL,DE   
05D9   2B                     DEC   HL   ; HL -> the NUL
05DA   EB                     EX   DE,HL   
05DB   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
05DC   E5                     PUSH   HL   
05DD   19                     ADD   HL,DE   ; the NUL's new place
05DE   EB                     EX   DE,HL   
05DF   ED B8                  LDDR      ; move the rest of the program up
05E1   C1                     POP   BC   ; the length
05E2   D1                     POP   DE   ; where it goes
05E3   E1                     POP   HL   ; the text
05E4   ED B0                  LDIR      
05E6   C3 A1 04     GEDIT:    JP   edit   
05E9                             ; ^G: run the program. st0p: run the typed line (BC -> it).
05E9   01 00 0B     CRUN:     LD   BC,PROG   
