0494   C6 30                  ADI   "0"   
0496   EF                     RST   5   
0497   C9                     RET      
0498                             ; skip: read past text to the closer at this level, and return A = 0 if it
0498                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0498                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0498                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0498                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0498                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
0498                             ; 
0498                             ; The checked build also looks at the character the skip was started by,
0498                             ; which is always the one just before where it starts: "(" must end at ")",
0498                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0498                             ; quote counts as running into it. "\" takes either closer. The place where
0498                             ; the skip started is kept on the stack, for the report.
0498                SKIP:        
0498                          IF   CHECKED   
0498   C5                     PUSH   B   
0499   0B                     DCX   B   
049A   0A                     LDAX   B   
049B   03                     INX   B   
049C   5F                     MOV   E,A   ; E = the opener: ( [ or \
049D                          ENDIF      
049D   16 00                  MVI   D,0   
049F   14           SK3:      INR   D   ; an opener: one deeper
04A0   0A           SK1:      LDAX   B   
04A1                          IF   1-CHECKED   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
04A1                          ENDIF      
04A1                          IF   CHECKED   
04A1   B7                     ORA   A   
04A2   CA D0 04               JZ   sk6   ; (the IP stays on the NUL)
04A5   03                     INX   B   
04A6                          ENDIF      
04A6   FE 22                  CPI   22h   
04A8   CC DC 04               CZ   skipstr   ; leaves A = 22h, which matches nothing below
04AB   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
04AD   CA 9F 04               JZ   sk3   
04B0   3D                     DCR   A   ; ")"
04B1   CA BE 04               JZ   sk4   
04B4   D6 32                  SUI   "["-")"   
04B6   CA 9F 04               JZ   sk3   
04B9   FE 02                  CPI   "]"-"["   
04BB   C2 A0 04               JNZ   sk1   
04BE   15           SK4:      DCR   D   
04BF                          IF   1-CHECKED   
                              RZ      ; the closer at this level
                              JMP   sk1   
04BF                          ENDIF      
04BF                          IF   CHECKED   
