  1684                              <1>         IMP     CreateFileA
  1685                              <1>         IMP     ReadFile
  1686                              <1>         IMP     WriteFile
  1687                              <1> %if EDITOR
  1688                              <1>         IMP     CloseHandle             ; (a runner leaves its file open)
  1689                              <1> %endif
  1690                              <1>         IMP     WaitForSingleObject
  1691                              <1>         IMP     ReadConsoleInputA
  1692                              <1>         IMP     ExitProcess
  1693                              <1> %endmacro
