04C3   F1                     POP   PSW   
04C4   C6 30                  ADI   "0"   
04C6                          ;*Macro unroll:  PUTA
04C6                          DS   1-CPM,0EFh   
04C6   CD                     DS   CPM,0CDh   
04C7   D4                     DS   CPM,APUT&0FFh   
04C8   06                     DS   CPM,APUT/256   
