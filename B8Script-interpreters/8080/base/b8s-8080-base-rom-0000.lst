018A   EB                     XCHG      ; DE = q
018B   60                     MOV   H,B   
018C   69                     MOV   L,C   ; HL = r
018D   F1                     POP   PSW   
018E   FC 20 00               CM   neg16   ; r's sign
0191   C1                     POP   B   
0192   D5                     PUSH   D   ; q under r
0193                          ;*Macro unroll:  NEXT
0193   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0194                          DS   CPM+FAST-CPM*FAST,0C3h   
0194                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0194                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0194                             ; ---- stack and storage -----------------------------------------------------
0194   E5           H_DUP:    PUSH   H   ; ":"
0195                          ;*Macro unroll:  NEXT
0195   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0196                          DS   CPM+FAST-CPM*FAST,0C3h   
0196                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0196                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0196   E3           H_SWAP:   XTHL      ; "%"
0197                          ;*Macro unroll:  NEXT
0197   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0198                          DS   CPM+FAST-CPM*FAST,0C3h   
0198                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0198                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0198                             ; (The checked build tests the address before it takes the value off the
0198                             ; stack, so that an error report shows both.)
0198                H_STORE:      ; "!" ( n addr -- )
0198                          IF   CHECKED   
0198   CD 77 04               CALL   chkst   
019B                          ENDIF      
019B   D1                     POP   D   
019C   73                     MOV   M,E   
019D   23                     INX   H   
019E   72                     MOV   M,D   
019F                          ;*Macro unroll:  DROP
019F   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01A0                          DS   CPM*(1-FAST),0C3h   
01A0                          DS   CPM*(1-FAST),ADRP&0FFh   
01A0                          DS   CPM*(1-FAST),ADRP/256   
01A0                          DS   FAST,0E1h   
01A0                          DS   FAST,0C3h   
01A0                          DS   FAST,ANXT&0FFh   
01A0                          DS   FAST,ANXT/256   
01A0                H_CSTORE:      ; "." ( c addr -- )
01A0                          IF   CHECKED   
01A0   CD 77 04               CALL   chkst   
01A3                          ENDIF      
01A3   D1                     POP   D   
01A4   73                     MOV   M,E   
01A5                          ;*Macro unroll:  DROP
01A5   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01A6                          DS   CPM*(1-FAST),0C3h   
01A6                          DS   CPM*(1-FAST),ADRP&0FFh   
01A6                          DS   CPM*(1-FAST),ADRP/256   
01A6                          DS   FAST,0E1h   
01A6                          DS   FAST,0C3h   
01A6                          DS   FAST,ANXT&0FFh   
01A6                          DS   FAST,ANXT/256   
01A6                             ; ---- console ---------------------------------------------------------------
01A6                             ; 22h pushes the address of the text after it and skips the string.
01A6   E5           H_STR:    PUSH   H   
01A7   60                     MOV   H,B   
01A8   69                     MOV   L,C   
01A9   CD AE 03               CALL   skipstr   
01AC                          IF   CHECKED   
01AC   B7                     ORA   A   ; 0: the text ran out before the closing quote
01AD   CA 06 05               JZ   e_quote   
01B0                          ENDIF      
01B0                          ;*Macro unroll:  NEXT
01B0   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01B1                          DS   CPM+FAST-CPM*FAST,0C3h   
01B1                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01B1                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01B1                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01B1                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01B1                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01B1                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01B1                          IF   1-CHECKED   
                    H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
                    PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
                    PRAGAIN:   EQU   prlp   ;   the image's first two pages)
01B1                          ENDIF      
01B1                          IF   CHECKED   
01B1                             ; (The checked build has the loop as a routine, prstr, which the error
01B1                             ; report uses too. The address is kept meanwhile, for a report: it shows
01B1                             ; the stack as it was before the "$". /~ comes back to hp1.)
01B1   22 3A 82     H_PRINT:   SHLD   PSAVE   
01B4   CD 8A 04     HP1:      CALL   prstr   
01B7                          ;*Macro unroll:  DROP
01B7   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01B8                          DS   CPM*(1-FAST),0C3h   
01B8                          DS   CPM*(1-FAST),ADRP&0FFh   
01B8                          DS   CPM*(1-FAST),ADRP/256   
01B8                          DS   FAST,0E1h   
01B8                          DS   FAST,0C3h   
01B8                          DS   FAST,ANXT&0FFh   
01B8                          DS   FAST,ANXT/256   
01B8                          ENDIF      
01B8   7D           H_EMIT:   MOV   A,L   ; "'"
01B9                          ;*Macro unroll:  PUTA
01B9   EF                     DS   1-CPM,0EFh   
01BA                          DS   CPM,0CDh   
01BA                          DS   CPM,APUT&0FFh   
01BA                          DS   CPM,APUT/256   
01BA                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
01BA   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
01BB                          DS   CPM*(1-FAST),0C3h   
01BB                          DS   CPM*(1-FAST),ADRP&0FFh   
01BB                          DS   CPM*(1-FAST),ADRP/256   
01BB                          DS   FAST,0E1h   
01BB                          DS   FAST,0C3h   
01BB                          DS   FAST,ANXT&0FFh   
01BB                          DS   FAST,ANXT/256   
01BB                             ; "#" prints TOS as a signed decimal number, with no space after it.
01BB   C5           H_NUM:    PUSH   B   
01BC   CD B4 02               CALL   psgn   
01BF   C1                     POP   B   
01C0                          ;*Macro unroll:  DROP
01C0   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01C1                          DS   CPM*(1-FAST),0C3h   
01C1                          DS   CPM*(1-FAST),ADRP&0FFh   
01C1                          DS   CPM*(1-FAST),ADRP/256   
01C1                          DS   FAST,0E1h   
01C1                          DS   FAST,0C3h   
01C1                          DS   FAST,ANXT&0FFh   
01C1                          DS   FAST,ANXT/256   
01C1                          IF   CHECKED   ; (the checked build has no room to start ","
01C1   6E           H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
01C2   26 00                  MVI   H,0   ;   the end of "?")
01C4                          ;*Macro unroll:  NEXT
01C4   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01C5                          DS   CPM+FAST-CPM*FAST,0C3h   
01C5                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01C5                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01C5                          ENDIF      
01C5                             ; "?" ( n -- c ) or ( -n -- addr )
01C5                             ;   n > 0: wait about n ms for a key; 0 if none came
01C5                             ;   n = 0: wait for a key
01C5                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C5                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C5   7C           H_KEY:    MOV   A,H   
01C6   B7                     ORA   A   
01C7   FA E5 01               JM   line   
01CA   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
01CC   CD 50 04     KT2:      CALL   getk   
01CF   C2 E1 01               JNZ   kt3   
01D2   1D                     DCR   E   
01D3   C2 CC 01               JNZ   kt2   
01D6   7C                     MOV   A,H   ; 0? never counts down: it waits
01D7   B5                     ORA   L   
01D8   CA CA 01               JZ   kt1   
01DB   2B                     DCX   H   
01DC   7C                     MOV   A,H   
01DD   B5                     ORA   L   
01DE   C2 CA 01               JNZ   kt1   ; A = 0 if the time ran out
01E1                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01E1                          ENDIF      
01E1   6F           KT3:      MOV   L,A   
01E2   26 00                  MVI   H,0   
01E4                          ;*Macro unroll:  NEXT
01E4   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01E5                          DS   CPM+FAST-CPM*FAST,0C3h   
01E5                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01E5                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01E5                             ; Backspace takes the last character back (and is echoed as
01E5                             ; it is), CR ends (stored, not echoed), every other key is stored and
01E5                             ; echoed until the line is full. The line buffer starts at offset 80h
01E5                             ; of its page, so L alone is the place in the line: D holds the L of
01E5                             ; a full line.
01E5   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
01E8   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
01E9   9F                     SBB   A   
01EA   A5                     ANA   L   ; (0 for a count that is too big)
01EB   2F                     CMA      
01EC   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
01ED                             ;   at most
01ED   21 80 82               LXI   H,LINEBUF   
01F0   CD 50 04     LN2:      CALL   getk   
01F3   CA F0 01               JZ   ln2   
01F6   FE 0D                  CPI   13   
01F8   CA 15 02               JZ   ln5   
01FB   FE 08                  CPI   8   
01FD   CA 0D 02               JZ   ln4   
0200   5F                     MOV   E,A   
0201   7D                     MOV   A,L   
0202   BA                     CMP   D   
0203   CA F0 01               JZ   ln2   ; full
0206   73                     MOV   M,E   
0207   2C                     INR   L   
0208   7B                     MOV   A,E   
0209                          ;*Macro unroll: ln3:    PUTA
0209   EF           LN3:      DS   1-CPM,0EFh   
020A                          DS   CPM,0CDh   
020A                          DS   CPM,APUT&0FFh   
020A                          DS   CPM,APUT/256   
020A   C3 F0 01               JMP   ln2   
020D   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
020E   FA 09 02               JM   ln3   ;   unless the line was empty (L left the
0211   2C                     INR   L   ;   upper half of the page)
0212   C3 F0 01               JMP   ln2   
0215   77           LN5:      MOV   M,A   ; the CR
0216   2E 80                  MVI   L,LINEBUF & 0FFh   
0218                          ;*Macro unroll:  NEXT
0218   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0219                          DS   CPM+FAST-CPM*FAST,0C3h   
0219                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0219                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0219                             ; =============================================================================
0219                             ;  Dispatch table: the low byte of each handler's address, in code order.
0219                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0219                             ; =============================================================================
0219                             ; The handlers of the first NPG1 characters start in the image's second page.
0219                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0219                             ; differs between the builds, so the count is worked out here.
0219                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0219                          IF   1-FAST   
0219                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0219                PGBRK:    EQU   (h_break-BASE)/256   
0219                PGDEF:    EQU   (h_def-BASE)/256   
0219                PGFET:    EQU   (h_fetch-BASE)/256   
0219                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0219                          ENDIF      
0219                          IF   (1-FAST)*(1-PTLATE)   
0219                PTAB:        
0219                          ;*Macro unroll:  PTABLE
0219   98                     DB   h_store & 0FFh   
021A   A6                     DB   h_str & 0FFh   
021B   BB                     DB   h_num & 0FFh   
021C   B1                     DB   h_print & 0FFh   
021D   96                     DB   h_swap & 0FFh   
021E   43                     DB   h_and & 0FFh   
021F   B8                     DB   h_emit & 0FFh   
0220   23                     DB   h_open & 0FFh   
0221   2F                     DB   h_close & 0FFh   
0222   68                     DB   h_mul & 0FFh   
0223   40                     DB   h_add & 0FFh   
0224   C1                     DB   h_cfetch & 0FFh   
0225   37                     DB   h_sub & 0FFh   
0226   A0                     DB   h_cstore & 0FFh   
0227   6C                     DB   h_div & 0FFh   
0228   94                     DB   h_dup & 0FFh   
0229   BA                     DB   h_drop & 0FFh   
022A   4C                     DB   h_lt & 0FFh   
022B   5B                     DB   h_eq & 0FFh   
022C   4B                     DB   h_gt & 0FFh   
022D   C5                     DB   h_key & 0FFh   
022E   1E                     DB   h_fetch & 0FFh   
022F   F7                     DB   h_def & 0FFh   
0230   E8                     DB   h_break & 0FFh   
0231   E3                     DB   h_ret & 0FFh   
0232   82                     DB   h_xor & 0FFh   
0233   95                     DB   h_alloc & 0FFh   
0234   C6                     DB   h_grave & 0FFh   
0235   14                     DB   h_tor & 0FFh   
0236   8A                     DB   h_or & 0FFh   
0237   1D                     DB   h_fromr & 0FFh   
0238   92                     DB   h_not & 0FFh   
0239                PTABEND:      
0239                          ENDIF      
0239                             ; =============================================================================
0239                             ;  Routines (no handler starts past this point)
0239                             ; =============================================================================
0239                             ; Digits: step back onto the first digit and read the whole number.
0239   E5           DIGIT:    PUSH   H   
023A   0B                     DCX   B   
023B   CD 45 02               CALL   rdnum   
023E                          ;*Macro unroll:  NEXT
023E   F7                     DS   (1-CPM)*(1-FAST),0F7h   
023F                          DS   CPM+FAST-CPM*FAST,0C3h   
023F                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
023F                          DS   CPM+FAST-CPM*FAST,ANXT/256   
023F                             ; negnum: "-" directly before a digit: read the number, negate it.
023F   E5           NEGNUM:   PUSH   H   
0240   CD 45 02               CALL   rdnum   
0243                          ;*Macro unroll:  NEGH
0243   E7                     DS   1-CPM,0E7h   
0244                          DS   CPM,0CDh   
0244                          DS   CPM,ANEG&0FFh   
0244                          DS   CPM,ANEG/256   
0244                          ;*Macro unroll:  NEXT
0244   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0245                          DS   CPM+FAST-CPM*FAST,0C3h   
0245                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0245                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0245                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0245                             ; non-digit. Values wrap at 16 bits, as the spec says.
0245   21 00 00     RDNUM:    LXI   H,0   
0248   0A           RDN1:     LDAX   B   
0249   D6 30                  SUI   "0"   
024B   FE 0A                  CPI   10   
024D   D0                     RNC      
024E   03                     INX   B   
024F   54                     MOV   D,H   
0250   5D                     MOV   E,L   
0251   29                     DAD   H   
0252   29                     DAD   H   
0253   19                     DAD   D   
0254   29                     DAD   H   ; HL * 10
0255   5F                     MOV   E,A   
0256   16 00                  MVI   D,0   
0258   19                     DAD   D   
0259   C3 48 02               JMP   rdn1   
025C                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
025C                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
025C                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
025C                             ; lives on the stack, since A is busy with the shifts.
025C                             ; Dividing by 2 is one shift (the spec wants that fast).
025C   01 00 00     UDIV:     LXI   B,0   
025F                          IF   1-QK   
                              MOV   A,E   
                              XRI   2   
                              ORA   D   
                              JNZ   udv0   
                              ORA   H   ; A was 0, and the carry is clear
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   ; the quotient
                              MOV   A,B   
                              RAL      
                              MOV   C,A   ; the remainder: the bit that fell out
                              RET      
025F                          ENDIF      
025F                          IF   QK   
025F                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
025F                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
025F   7A                     MOV   A,D   
0260   B7                     ORA   A   
0261   C2 7F 02               JNZ   uq1   ; 256 and up
0264   B3                     ORA   E   
0265   CA 96 02               JZ   udv0   ; by 0: the long way (it means nothing anyway)
0268   3D                     DCR   A   
0269   A3                     ANA   E   
026A   C2 96 02               JNZ   udv0   ; not a power of two
026D   7B                     MOV   A,E   ; by 2^k below 256: q = HL >> k, and
026E   3D                     DCR   A   ;   r = L & (2^k - 1)
026F   A5                     ANA   L   
0270   4F                     MOV   C,A   
0271                          ENDIF      
0271                          IF   QK*(1-FAST)   
0271   7B           UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
0272   B7                     ORA   A   
0273   1F                     RAR      
0274   D8                     RC      
0275   5F                     MOV   E,A   
0276   7C                     MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
0277   1F                     RAR      
0278   67                     MOV   H,A   
0279   7D                     MOV   A,L   
027A   1F                     RAR      
027B   6F                     MOV   L,A   
027C   C3 71 02               JMP   uq2   
027F                          ENDIF      
027F                          IF   FAST   
                                 ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
                                 ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
                    UQ2:      MOV   A,E   
                              CPI   16   
                              JNC   uqh   
                              CPI   2   
                              RC      ; by 1
                              JZ   ur1   
                              CPI   4   
                              JZ   ur2   
                    UR3:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR2:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR1:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              RET      
                    UQH:      CPI   64   
                              MVI   A,0   
                              JZ   ul2   
                              JNC   ul1   
                              MOV   A,E   
                              CPI   32   
                              MVI   A,0   
                              JZ   ul3   
                              DAD   H   ; by 16
                              ADC   A   
                    UL3:      DAD   H   
                              ADC   A   
                    UL2:      DAD   H   
                              ADC   A   
                    UL1:      DAD   H   
                              ADC   A   
                              MOV   L,H   
                              MOV   H,A   
                              RET      
027F                          ENDIF      
027F                          IF   QK   
027F   7B           UQ1:      MOV   A,E   
0280   B7                     ORA   A   
0281   C2 96 02               JNZ   udv0   
0284   7A                     MOV   A,D   
0285   3D                     DCR   A   
0286   A2                     ANA   D   
0287   C2 96 02               JNZ   udv0   ; not a power of two
028A   7A                     MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
028B   3D                     DCR   A   ;   q = H >> (k - 8)
028C   A4                     ANA   H   
028D   47                     MOV   B,A   
028E   4D                     MOV   C,L   
028F   6C                     MOV   L,H   
0290   26 00                  MVI   H,0   
0292   5A                     MOV   E,D   
0293   C3 71 02               JMP   uq2   
0296                          ENDIF      
0296                          IF   1-FAST   
0296   3E 10        UDV0:     MVI   A,16   
0298   F5                     PUSH   PSW   
0299   29           UDV1:     DAD   H   ; next dividend bit into the carry
029A   79                     MOV   A,C   
029B   17                     RAL      
029C   4F                     MOV   C,A   
029D   78                     MOV   A,B   
029E   17                     RAL      
029F   47                     MOV   B,A   ; BC = BC*2 + bit
02A0   79                     MOV   A,C   
02A1   93                     SUB   E   
02A2   78                     MOV   A,B   
02A3   9A                     SBB   D   ; carry if BC < DE
02A4   DA AC 02               JC   udv2   
02A7   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
02A8   79                     MOV   A,C   
02A9   93                     SUB   E   
02AA   4F                     MOV   C,A   
02AB   2C                     INR   L   ; quotient bit
02AC   F1           UDV2:     POP   PSW   
02AD   3D                     DCR   A   
02AE   F5                     PUSH   PSW   
02AF   C2 99 02               JNZ   udv1   
02B2   F1                     POP   PSW   
02B3   C9                     RET      
02B4                          ENDIF      
02B4                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
                                 ; starts 8 bits up and takes only the last 8, since its first 8 would only
                                 ; shift zeros)
                    UDV0:     MOV   A,H   
                              ORA   A   
                              JZ   uvs   
                    UV0:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw0   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW0:         
                    UV1:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
