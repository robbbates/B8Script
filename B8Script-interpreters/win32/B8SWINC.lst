  1360 00000687 6BD20A              <1>         imul    edx,edx,10
  1361 0000068A 01C2                <1>         add     edx,eax
  1362 0000068C EBEF                <1>         jmp     .rn1
  1363 0000068E 6689D3              <1> .rn2:   mov     bx,dx
  1364 00000691 C3                  <1>         ret
  1365                              <1> 
  1366                              <1> 
  1367                              <1> %if CHECKED
  1368                              <1> ; pmsg: print the text that follows the CALL, to its closing quote (through
  1369                              <1> ; prstr), and carry on after it. Uses EBX.
  1370 00000692 5B                  <1> pmsg:   pop     ebx
  1371 00000693 E841FDFFFF          <1>         call    prstr
