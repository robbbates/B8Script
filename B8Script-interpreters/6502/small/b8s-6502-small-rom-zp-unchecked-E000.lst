E1C9                             ; "?" ( n -- c ) or ( -n -- addr )
E1C9                             ;   n > 0: wait about n ms for a key; 0 if none came
E1C9                             ;   n = 0: wait for a key
E1C9                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E1C9                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
