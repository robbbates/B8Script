01BD   D1                     POP   DE   
01BE   2B                     DEC   HL   
01BF   72                     LD   (HL),D   
01C0   2B                     DEC   HL   
01C1   73                     LD   (HL),E   
01C2   05                     DEC   B   
01C3   D9                     EXX      
01C4   CC 82 04               CALL   Z,pollk   
01C7   F7                     RST   30h   
01C8                             ; ---- machine code: the grave -----------------------------------------------
01C8                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01C8                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01C8                             ; written and its address is left. An odd last digit is consumed and dropped.
01C8                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01C8                             ; code is entered by CALL with the data stack above the return address; it
01C8                             ; must keep BC, and on return the top cell becomes the new TOS.
01C8   CD 36 04     H_GRAVE:   CALL   hexc   
01CB   30 CA                  JR   NC,exec   
01CD   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01CE   CD 36 04               CALL   hexc   
01D1   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01D3   ED 6F                  RLD      ;   overwrites it
01D5   23                     INC   HL   ; ... and RLD shifts it up under the low one
01D6   CD 36 04               CALL   hexc   
01D9   38 F2                  JR   C,hx1   
01DB   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01DD   F7                     RST   30h   
01DE                             ; ---- where the two pages meet ----------------------------------------------
01DE                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01DE                             ; are in falling code order for this), and where exactly differs between the
01DE                             ; builds: NPG1 follows. Every handler below these four must start in the
01DE                             ; second page, and every one above in the first; chktab.py checks both.
01DE                             ; "]" returns: pop an address and jump to it.
01DE   CF           H_RET:    RST   08h   
01DF   42                     LD   B,D   
01E0   4B                     LD   C,E   
01E1   F7           BRK1:     RST   30h   
01E2                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E2                             ; drops the block start, "]" returns. No closer at all ends the program.
01E2   7C           H_BREAK:   LD   A,H   
01E3   B5                     OR   L   
01E4   E1                     POP   HL   
01E5   28 FA                  JR   Z,brk1   
01E7   CD F9 03               CALL   skip   
01EA   B7                     OR   A   ; skip returns 0 for ")"
01EB   20 F1                  JR   NZ,h_ret   
01ED   CF           RDROP:    RST   08h   
01EE   F7                     RST   30h   
01EF                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EF                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EF                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EF                             ; (The unchecked build takes anything that is not a letter as the space; the
01EF                             ; checked build stops on it.)
01EF   0A           H_DEF:    LD   A,(BC)   
01F0   03                     INC   BC   
01F1   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01F3   5F                     LD   E,A   ;   lands 64 bytes up
01F4   E6 DF                  AND   0DFh   ; fold case
01F6   FE 1A                  CP   26   
01F8   30 0B                  JR   NC,def2   ; not a letter
01FA   CB 23                  SLA   E   
01FC   16 0B                  LD   D,LETPAGE   ; DE -> cell
01FE   79                     LD   A,C   
01FF   12                     LD   (DE),A   
0200   1C                     INC   E   
0201   78                     LD   A,B   
0202   12                     LD   (DE),A   
0203   18 09                  JR   skipnx   
0205                DEF2:        
0205                          IF   CHECKED   
0205   7B                     LD   A,E   
0206   FE DF                  CP   " "-"A"+256   
0208   C2 4F 05               JP   NZ,e_brack   ; anything but a letter or a space
020B                          ENDIF      
020B   E5                     PUSH   HL   ; an anonymous block: push its address
020C   60                     LD   H,B   
020D   69                     LD   L,C   
020E                SKIPNX:      
020E                          IF   CHECKED   
020E   0B                     DEC   BC   ; back onto the letter, so that skip finds its
020F                          ENDIF      ;   opener, the "[", just before where it starts
020F   CD F9 03     SKIPO:    CALL   skip   
0212   F7                     RST   30h   
0213   5E           H_FETCH:   LD   E,(HL)   ; "@"
0214   23                     INC   HL   
0215   56                     LD   D,(HL)   
0216   EB                     EX   DE,HL   
0217   F7                     RST   30h   
0218                             ; =============================================================================
0218                             ;  Handlers that must start in the image's second page.
0218                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0218                             ;  page.
0218                             ; =============================================================================
0218                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0218                             ; the matching ")".
0218   7C           H_OPEN:   LD   A,H   
0219   B5                     OR   L   
021A   E1                     POP   HL   
021B   28 F2                  JR   Z,skipo   
021D   C5                     PUSH   BC   ; the block starts at the IP
021E   18 9C                  JR   rpushn   
0220                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0220                             ; drops it and carries on.
0220   7C           H_CLOSE:   LD   A,H   
0221   B5                     OR   L   
0222   E1                     POP   HL   
0223   28 C8                  JR   Z,rdrop   
0225   CF                     RST   08h   ; pop the block start ...
0226   42                     LD   B,D   
0227   4B                     LD   C,E   
0228   C5                     PUSH   BC   
0229   18 91                  JR   rpushn   ; ... and push it back
022B                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022B                             ; "-" has two jobs: directly before a digit it starts a negative number.
022B   0A           H_SUB:    LD   A,(BC)   
022C   D6 30                  SUB   "0"   
022E   FE 0A                  CP   10   
0230   38 04                  JR   C,negnum   
0232   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0233   D1           H_ADD:    POP   DE   
0234   19                     ADD   HL,DE   
0235   F7                     RST   30h   
0236   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0237   CD D2 03               CALL   rdnum   
023A   E7                     RST   20h   
023B   F7                     RST   30h   
023C   D1           H_AND:    POP   DE   
023D   7C                     LD   A,H   
023E   A2                     AND   D   
023F   67                     LD   H,A   
0240   7D                     LD   A,L   
0241   A3                     AND   E   
0242   6F                     LD   L,A   
0243   F7                     RST   30h   
0244                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0244                             ; cells first. Flipping both sign bits turns a signed compare into an
0244                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0244                             ; carry into -1 or 0 with no branch.
0244   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0245   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0246   7C                     LD   A,H   
0247   EE 80                  XOR   80h   
0249   67                     LD   H,A   
024A   7A                     LD   A,D   
024B   EE 80                  XOR   80h   
024D   57                     LD   D,A   
024E   ED 52                  SBC   HL,DE   ; carry if HL < DE
0250   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0252   F7                     RST   30h   
0253   D1           H_EQ:     POP   DE   
0254   B7                     OR   A   
0255   ED 52                  SBC   HL,DE   
0257   7C                     LD   A,H   
0258   B5                     OR   L   
0259   FE 01                  CP   1   ; carry only if a - b = 0
025B   18 F3                  JR   tf   
025D                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
025D                             ; multiplier shifts up through A:C.
025D   D1           H_MUL:    POP   DE   ; DE = multiplicand
025E   C5                     PUSH   BC   
025F   7C                     LD   A,H   
0260   4D                     LD   C,L   ; A:C = multiplier
0261   21 00 00               LD   HL,0   
0264   06 10                  LD   B,16   
0266   29           MUL1:     ADD   HL,HL   
0267   CB 21                  SLA   C   
0269   17                     RLA      
026A   30 01                  JR   NC,mul2   
026C   19                     ADD   HL,DE   
026D   10 F7        MUL2:     DJNZ   mul1   
026F   C1                     POP   BC   
0270   F7                     RST   30h   
0271                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0271                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0271                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0271                             ; stops on it.
0271                H_DIV:       
0271                          IF   CHECKED   
0271   7C                     LD   A,H   
0272   B5                     OR   L   
0273   CA 4C 05               JP   Z,e_zero   
0276                          ENDIF      
0276   D1                     POP   DE   ; DE = a, HL = b
0277   D5                     PUSH   DE   ; a, for r's sign
0278   7A                     LD   A,D   
0279   AC                     XOR   H   
027A   F5                     PUSH   AF   ; S flag = sign of q
027B   CB 7C                  BIT   7,H   
027D   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0280   EB                     EX   DE,HL   
0281   CB 7C                  BIT   7,H   
0283   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0286   CD AA 03               CALL   udiv   ; HL = q, DE = r
0289   F1                     POP   AF   
028A   FC 20 01               CALL   M,neg16   ; q's sign
028D   EB                     EX   DE,HL   ; HL = r, DE = q
028E   F1                     POP   AF   ; A = a's high byte
028F   B7                     OR   A   
0290   FC 20 01               CALL   M,neg16   ; r's sign
0293   D5                     PUSH   DE   ; q under r
0294   F7                     RST   30h   
