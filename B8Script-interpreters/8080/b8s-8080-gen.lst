0134   D1           H_ADD:    POP   D   
0135   19                     DAD   D   
0136   F7                     RST   6   
0137   D1           H_AND:    POP   D   
0138   7C                     MOV   A,H   
0139   A2                     ANA   D   
013A   67                     MOV   H,A   
013B   7D                     MOV   A,L   
013C   A3                     ANA   E   
013D   6F                     MOV   L,A   
013E   F7                     RST   6   
013F                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
013F                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
013F                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
013F                             ; SBB A turns a carry into -1 or 0 with no branch.
013F   E3           H_GT:     XTHL      ; a > b  is  b < a
0140   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0141   7B                     MOV   A,E   
0142   95                     SUB   L   
0143   7A                     MOV   A,D   
0144   9C                     SBB   H   
0145   9F                     SBB   A   ; A = -1 if DE < HL unsigned
0146   6F                     MOV   L,A   
0147   7C                     MOV   A,H   
0148   AA                     XRA   D   
0149   17                     RAL      ; carry = the signs differ
014A   9F                     SBB   A   
014B   AD                     XRA   L   ; flip when they do
014C   67                     MOV   H,A   
014D   6F                     MOV   L,A   
014E   F7                     RST   6   
014F   D1           H_EQ:     POP   D   
0150   7D                     MOV   A,L   
0151   AB                     XRA   E   
0152   6F                     MOV   L,A   
0153   7C                     MOV   A,H   
0154   AA                     XRA   D   
0155   B5                     ORA   L   ; zero if equal
0156   D6 01                  SUI   1   ; carry only for zero
0158   9F                     SBB   A   
0159   67                     MOV   H,A   
015A   6F                     MOV   L,A   
015B   F7                     RST   6   
015C                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
015C                             ; multiplier is used up; only the low 16 bits are kept.
015C   D1           H_MUL:    POP   D   ; DE = multiplicand
015D   C5                     PUSH   B   
015E   44                     MOV   B,H   
015F   4D                     MOV   C,L   ; BC = multiplier
0160   21 00 00               LXI   H,0   
0163   78           MUL1:     MOV   A,B   
0164   B7                     ORA   A   ; clear carry
0165   1F                     RAR      
0166   47                     MOV   B,A   
0167   79                     MOV   A,C   
0168   1F                     RAR      
0169   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
016A   D2 6E 01               JNC   mul2   
016D   19                     DAD   D   
016E   EB           MUL2:     XCHG      
016F   29                     DAD   H   ; multiplicand << 1
0170   EB                     XCHG      
0171   78                     MOV   A,B   
0172   B1                     ORA   C   
0173   C2 63 01               JNZ   mul1   
0176   C1                     POP   B   
0177   F7                     RST   6   
0178                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0178                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0178                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0178                             ; stops on it.
0178                H_DIV:       
0178                          IF   CHECKED   
                              MOV   A,H   
                              ORA   L   
                              JZ   e_zero   
0178                          ENDIF      
0178   D1                     POP   D   ; DE = a, HL = b
0179   C5                     PUSH   B   
017A   7A                     MOV   A,D   
017B   B7                     ORA   A   
017C   F5                     PUSH   PSW   ; S flag = sign of a (for r)
017D   AC                     XRA   H   
017E   F5                     PUSH   PSW   ; S flag = sign of q
017F   7C                     MOV   A,H   
0180   B7                     ORA   A   
0181   FC 20 00               CM   neg16   ; HL = |b|
0184   EB                     XCHG      
0185   7C                     MOV   A,H   
0186   B7                     ORA   A   
0187   FC 20 00               CM   neg16   ; HL = |a|, DE = |b|
018A   CD 6E 02               CALL   udiv   ; HL = q, BC = r
018D   F1                     POP   PSW   
018E   FC 20 00               CM   neg16   ; q's sign
0191   EB                     XCHG      ; DE = q
0192   60                     MOV   H,B   
0193   69                     MOV   L,C   ; HL = r
0194   F1                     POP   PSW   
0195   FC 20 00               CM   neg16   ; r's sign
0198   C1                     POP   B   
0199   D5                     PUSH   D   ; q under r
019A   F7                     RST   6   
019B                             ; ---- stack and storage -----------------------------------------------------
019B   E5           H_DUP:    PUSH   H   ; ":"
019C   F7                     RST   6   
019D   E3           H_SWAP:   XTHL      ; "%"
019E   F7                     RST   6   
019F                             ; (The checked build tests the address before it takes the value off the
019F                             ; stack, so that an error report shows both.)
019F                H_STORE:      ; "!" ( n addr -- )
019F                          IF   CHECKED   
                              CALL   chkst   
019F                          ENDIF      
019F   D1                     POP   D   
01A0   73                     MOV   M,E   
01A1   23                     INX   H   
01A2   72                     MOV   M,D   
01A3   DF                     RST   3   
01A4                H_CSTORE:      ; "." ( c addr -- )
01A4                          IF   CHECKED   
                              CALL   chkst   
01A4                          ENDIF      
01A4   D1                     POP   D   
01A5   73                     MOV   M,E   
01A6   DF                     RST   3   
01A7                             ; ---- console ---------------------------------------------------------------
01A7                             ; 22h pushes the address of the text after it and skips the string.
01A7   E5           H_STR:    PUSH   H   
01A8   60                     MOV   H,B   
01A9   69                     MOV   L,C   
01AA   CD 1D 03               CALL   skipstr   
01AD                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
01AD                          ENDIF      
01AD   F7                     RST   6   
01AE                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01AE                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01AE                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01AE                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01AE                          IF   1-CHECKED   
01AE   7E           H_PRINT:   MOV   A,M   
01AF   23                     INX   H   
01B0   FE 22                  CPI   22h   
01B2   CA CE 01               JZ   h_drop   
01B5   FE 2F                  CPI   "/"   
01B7   C2 C8 01               JNZ   pr1   
01BA   7E                     MOV   A,M   
01BB   23                     INX   H   
01BC   FE 60                  CPI   60h   
01BE   DA C6 01               JC   pr0   
01C1   FE 7F                  CPI   7Fh   
01C3   DA BB 02               JC   pesc   
01C6   E6 BF        PR0:      ANI   0BFh   
01C8   EF           PR1:      RST   5   
01C9   C3 AE 01               JMP   h_print   
01CC                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
01CC                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01CC                          ENDIF      
01CC                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
