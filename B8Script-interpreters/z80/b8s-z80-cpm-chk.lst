0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        Dividing by zero is not checked. -n? does no more editing than
0000                             ;        Backspace.
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = generic build with a small line editor built in (see the
0000                             ;                 end of this file). It needs CPM = 0 and CHECKED = 0.
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor (generic only)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                EXIT:     EQU   0000h   ; warm boot
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   1-EDITOR   
0100   31 FE 06               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   EDITOR   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
                              JP   edit   ; 04
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 4D 04               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 00 00     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 D1 03               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 C5 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD EA 03               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LD   A,(BC)   
0138   03                     INC   BC   
0139   D6 21                  SUB   21h   ; A = c - 21h
013B   38 D4                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CP   0Fh   
013F   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0141   D6 0F                  SUB   0Fh   ; A = c - 30h
0143   FE 0A                  CP   0Ah   
0145   38 68                  JR   C,digit   ; 30h-39h
0147   FE 11                  CP   11h   
0149   38 16                  JR   C,p3a   ; 3Ah-40h
014B   D6 11                  SUB   11h   ; A = c - 41h
014D   FE 1A                  CP   1Ah   
014F   38 6A                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0151   FE 20                  CP   20h   
0153   38 0A                  JR   C,p5b   ; 5Bh-60h
0155   FE 3A                  CP   3Ah   
0157   38 5C                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0159   FE 3E                  CP   3Eh   
015B   30 D7                  JR   NC,next0   ; 7Fh-FFh: ignored
015D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
015F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0161   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0163                .macro PTABLE,
0163                             ; 
0163                 DB      h_store & 0FFh  ; !
0163                 DB      h_str & 0FFh    ; "
0163                 DB      h_num & 0FFh    ; #
0163                 DB      h_print & 0FFh  ; $
0163                 DB      h_swap & 0FFh   ; %
0163                 DB      h_and & 0FFh    ; &
0163                 DB      h_emit & 0FFh   ; '
0163                 DB      h_open & 0FFh   ; (
0163                 DB      h_close & 0FFh  ; )
0163                 DB      h_mul & 0FFh    ; *
0163                 DB      h_add & 0FFh    ; +
0163                 DB      h_cfetch & 0FFh ; ,
0163                 DB      h_sub & 0FFh    ; -
0163                 DB      h_cstore & 0FFh ; .
0163                 DB      h_div & 0FFh    ; /
0163                 DB      h_dup & 0FFh    ; :
0163                 DB      h_drop & 0FFh   ; ;
0163                 DB      h_lt & 0FFh     ; <
0163                 DB      h_eq & 0FFh     ; =
0163                 DB      h_gt & 0FFh     ; >
0163                 DB      h_key & 0FFh    ; ?
0163                 DB      h_fetch & 0FFh  ; @
0163                 DB      h_def & 0FFh    ; [
0163                 DB      h_break & 0FFh  ; \
0163                 DB      h_ret & 0FFh    ; ]
0163                 DB      h_xor & 0FFh    ; ^
0163                 DB      h_alloc & 0FFh  ; _
0163                 DB      h_grave & 0FFh  ; `
0163                 DB      h_tor & 0FFh    ; {
0163                 DB      h_or & 0FFh     ; |
0163                 DB      h_fromr & 0FFh  ; }
0163                 DB      h_not & 0FFh    ; ~
0163                .endm
0163                 
0163                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0163                             ; untouched, and A, DE free.
0163   C6 A5        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0165   5F                     LD   E,A   
0166   16 03                  LD   D,PTAB / 256   ; (0 in the editor build)
0168   FE BB                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016A   1A                     LD   A,(DE)   
016B   5F                     LD   E,A   ; the handler's low byte
016C                          IF   (1-CPM)*(1-EDITOR)   
                              LD   D,0   
016C                          ENDIF      
016C                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
016C                          ENDIF      
016C                          IF   CPM   
016C   16 01                  LD   D,1   
016E   30 01                  JR   NC,pu1   
0170   14                     INC   D   ; its page: 1 + carry
0171                PU1:         
0171                          ENDIF      
0171   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0172   C9                     RET      ;   when the handler starts
0173                             ; The rest of the startup: here so that the generic reset code can reach it
0173                             ; with JR. st0: find the program's NUL; the heap starts after it.
0173                             ; (The editor build has its own copy of this, next to the editor.)
0173                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0173                          ENDIF      
0173                          IF   1-EDITOR   
0173   22 7C 07     ST2:      LD   (HEAP),HL   
0176   D9                     EXX      
0177   21 E0 05               LD   HL,RSTOP   ; the return stack is empty
017A   D9                     EXX      
017B                          ENDIF      
017B                          IF   CHECKED*(1-EDITOR)   
017B   AF                     XOR   A   
017C   32 36 07               LD   (KEYBUF),A   ; no key held back
017F                          ENDIF      
017F                          IF   1-EDITOR   
017F   F7                     RST   30h   ; (its return address is thrown away)
0180                          ENDIF      
0180                             ; In the editor build the table is here, in the first page, which saves
0180                             ; loading D twice. (The other builds have no room for it here: theirs is
0180                             ; further down.)
0180                          IF   EDITOR   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0180                          ENDIF      
0180                             ; =============================================================================
0180                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0180                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0180                             ;  is here too: it belongs to "`" and makes the page come out right.
0180                             ; =============================================================================
0180   D1           H_XOR:    POP   DE   
0181   7C                     LD   A,H   
0182   AA                     XOR   D   
0183   67                     LD   H,A   
0184   7D                     LD   A,L   
0185   AB                     XOR   E   
0186   6F                     LD   L,A   
0187   F7                     RST   30h   
0188   D1           H_OR:     POP   DE   
0189   7C                     LD   A,H   
018A   B2                     OR   D   
018B   67                     LD   H,A   
018C   7D                     LD   A,L   
018D   B3                     OR   E   
018E   6F                     LD   L,A   
018F   F7                     RST   30h   
0190   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0191   2B                     DEC   HL   
0192   F7                     RST   30h   
0193                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
0193   ED 5B 7C 07  H_ALLOC:   LD   DE,(HEAP)   
0197   19                     ADD   HL,DE   ; the new top
0198                          IF   CHECKED   
0198   CD 1D 04               CALL   chkhp   
019B                          ENDIF      
019B   22 7C 07               LD   (HEAP),HL   
019E   EB                     EX   DE,HL   
019F   F7                     RST   30h   
01A0   D9           EXEC:     EXX      
01A1   22 34 07               LD   (RSAVE),HL   ; machine code may change the alternates
01A4   D9                     EXX      
01A5   CD 2B 01               CALL   jphl   
01A8   D9                     EXX      
01A9   2A 34 07               LD   HL,(RSAVE)   
01AC   D9                     EXX      
01AD   E1                     POP   HL   
01AE   F7                     RST   30h   
01AF                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01AF                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01AF                             ; Digits: step back onto the first digit and read the whole number.
01AF   E5           DIGIT:    PUSH   HL   
01B0   0B                     DEC   BC   
01B1   CD 3E 03               CALL   rdnum   
01B4   F7                     RST   30h   
01B5                             ; a-z: push the cell's address (the cell is the variable)
01B5   E5           LOWER:    PUSH   HL   
01B6   87                     ADD   A,A   
01B7   6F                     LD   L,A   
01B8   26 07                  LD   H,LETPAGE   
01BA   F7                     RST   30h   
01BB                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01BB                             ; the return stack, and the IP becomes the address in the letter's cell.
01BB   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01BC   EB                     EX   DE,HL   ; park TOS
01BD   87                     ADD   A,A   
01BE   6F                     LD   L,A   
01BF   26 07                  LD   H,LETPAGE   ; HL -> cell
01C1   4E                     LD   C,(HL)   
01C2   2C                     INC   L   
01C3   46                     LD   B,(HL)   ; IP = the word's body
01C4   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01C5                             ; rpushn: move the top cell of the data stack (in memory) to the return
01C5                             ; stack, then next. Everything that pushes the return stack ends here.
01C5                RPUSHN:      
01C5                          IF   CHECKED   
01C5   CD 02 04               CALL   chkbrk   ; Ctrl-C is checked at every word call, block
01C8                          ENDIF      ;   entry, loop-back and "{"
01C8   D9                     EXX      
01C9   D1                     POP   DE   
01CA   2B                     DEC   HL   
01CB   72                     LD   (HL),D   
01CC   2B                     DEC   HL   
01CD   73                     LD   (HL),E   
01CE   D9                     EXX      
01CF   F7                     RST   30h   
01D0                             ; ---- machine code: the grave -----------------------------------------------
01D0                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01D0                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01D0                             ; written and its address is left. An odd last digit is consumed and dropped.
01D0                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01D0                             ; code is entered by CALL with the data stack above the return address; it
01D0                             ; must keep BC, and on return the top cell becomes the new TOS.
01D0   CD 93 03     H_GRAVE:   CALL   hexc   
01D3   30 CB                  JR   NC,exec   
01D5                HX1:         
01D5                          IF   CHECKED   
01D5   CD 0E 04               CALL   chkst   
01D8                          ENDIF      
01D8   77                     LD   (HL),A   ; the high digit goes in first ...
01D9   CD 93 03               CALL   hexc   
01DC   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01DE   ED 6F                  RLD      ;   overwrites it
01E0   23                     INC   HL   ; ... and RLD shifts it up under the low one
01E1   CD 93 03               CALL   hexc   
01E4   38 EF                  JR   C,hx1   
01E6                HX2:         
01E6                          IF   CHECKED   
01E6   CD 0E 04               CALL   chkst   
01E9                          ENDIF      
01E9   36 C9                  LD   (HL),0C9h   
01EB   F7                     RST   30h   
01EC                             ; ---- where the two pages meet ----------------------------------------------
01EC                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01EC                             ; are in falling code order for this), and where exactly differs between the
01EC                             ; builds: NPG1 follows. Every handler below these four must start in the
01EC                             ; second page, and every one above in the first; chktab.py checks both.
01EC                             ; "]" returns: pop an address and jump to it.
01EC   CF           H_RET:    RST   08h   
01ED   42                     LD   B,D   
01EE   4B                     LD   C,E   
01EF   F7           BRK1:     RST   30h   
01F0                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01F0                             ; drops the block start, "]" returns. No closer at all ends the program.
01F0   7C           H_BREAK:   LD   A,H   
01F1   B5                     OR   L   
01F2   E1                     POP   HL   
01F3   28 FA                  JR   Z,brk1   
01F5   CD 60 03               CALL   skip   
01F8   B7                     OR   A   ; skip returns 0 for ")"
01F9   20 F1                  JR   NZ,h_ret   
01FB   CF           RDROP:    RST   08h   
01FC   F7                     RST   30h   
01FD                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01FD                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01FD                             ; the body"s address instead. Either way it then skips to the matching "]'.
01FD                             ; (The unchecked build takes anything that is not a letter as the space; the
01FD                             ; checked build stops on it.)
01FD   0A           H_DEF:    LD   A,(BC)   
01FE   03                     INC   BC   
01FF   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
0201   5F                     LD   E,A   ;   lands 64 bytes up
0202   E6 DF                  AND   0DFh   ; fold case
0204   FE 1A                  CP   26   
0206   30 0B                  JR   NC,def2   ; not a letter
0208   CB 23                  SLA   E   
020A   16 07                  LD   D,LETPAGE   ; DE -> cell
020C   79                     LD   A,C   
020D   12                     LD   (DE),A   
020E   1C                     INC   E   
020F   78                     LD   A,B   
0210   12                     LD   (DE),A   
0211   18 09                  JR   skipnx   
0213                DEF2:        
0213                          IF   CHECKED   
0213   7B                     LD   A,E   
0214   FE DF                  CP   " "-"A"+256   
0216   C2 34 04               JP   NZ,e_brack   ; anything but a letter or a space
0219                          ENDIF      
0219   E5                     PUSH   HL   ; an anonymous block: push its address
021A   60                     LD   H,B   
021B   69                     LD   L,C   
021C   CD 60 03     SKIPNX:   CALL   skip   
021F   F7                     RST   30h   
0220   5E           H_FETCH:   LD   E,(HL)   ; "@"
0221   23                     INC   HL   
0222   56                     LD   D,(HL)   
0223   EB                     EX   DE,HL   
0224   F7                     RST   30h   
0225                             ; =============================================================================
0225                             ;  Handlers that must start in the image's second page.
0225                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0225                             ;  page.
0225                             ; =============================================================================
0225                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0225                             ; the matching ")".
0225   7C           H_OPEN:   LD   A,H   
0226   B5                     OR   L   
0227   E1                     POP   HL   
0228   28 F2                  JR   Z,skipnx   
022A   C5                     PUSH   BC   ; the block starts at the IP
022B   18 98                  JR   rpushn   
022D                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
022D                             ; drops it and carries on.
022D   7C           H_CLOSE:   LD   A,H   
022E   B5                     OR   L   
022F   E1                     POP   HL   
0230   28 C9                  JR   Z,rdrop   
0232   CF                     RST   08h   ; pop the block start ...
0233   42                     LD   B,D   
0234   4B                     LD   C,E   
0235   C5                     PUSH   BC   
0236   18 8D                  JR   rpushn   ; ... and push it back
0238                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0238                             ; "-" has two jobs: directly before a digit it starts a negative number.
0238   0A           H_SUB:    LD   A,(BC)   
0239   D6 30                  SUB   "0"   
023B   FE 0A                  CP   10   
023D   38 04                  JR   C,negnum   
023F   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0240   D1           H_ADD:    POP   DE   
0241   19                     ADD   HL,DE   
0242   F7                     RST   30h   
0243   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0244   CD 3E 03               CALL   rdnum   
0247   E7                     RST   20h   
0248   F7                     RST   30h   
0249   D1           H_AND:    POP   DE   
024A   7C                     LD   A,H   
024B   A2                     AND   D   
024C   67                     LD   H,A   
024D   7D                     LD   A,L   
024E   A3                     AND   E   
024F   6F                     LD   L,A   
0250   F7                     RST   30h   
0251                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0251                             ; cells first. Flipping both sign bits turns a signed compare into an
0251                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0251                             ; carry into -1 or 0 with no branch.
0251   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0252   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0253   7C                     LD   A,H   
0254   EE 80                  XOR   80h   
0256   67                     LD   H,A   
0257   7A                     LD   A,D   
0258   EE 80                  XOR   80h   
025A   57                     LD   D,A   
025B   ED 52                  SBC   HL,DE   ; carry if HL < DE
025D   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
025F   F7                     RST   30h   
0260   D1           H_EQ:     POP   DE   
0261   B7                     OR   A   
0262   ED 52                  SBC   HL,DE   
0264   7C                     LD   A,H   
0265   B5                     OR   L   
0266   FE 01                  CP   1   ; carry only if a - b = 0
0268   18 F3                  JR   tf   
026A                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
026A                             ; multiplier shifts up through A:C.
026A   D1           H_MUL:    POP   DE   ; DE = multiplicand
026B   C5                     PUSH   BC   
026C   7C                     LD   A,H   
026D   4D                     LD   C,L   ; A:C = multiplier
026E   21 00 00               LD   HL,0   
0271   06 10                  LD   B,16   
0273   29           MUL1:     ADD   HL,HL   
0274   CB 21                  SLA   C   
0276   17                     RLA      
0277   30 01                  JR   NC,mul2   
0279   19                     ADD   HL,DE   
027A   10 F7        MUL2:     DJNZ   mul1   
027C   C1                     POP   BC   
027D   F7                     RST   30h   
027E                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
027E                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
027E                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
027E   D1           H_DIV:    POP   DE   ; DE = a, HL = b
027F   C5                     PUSH   BC   ; free BC for udiv
0280   D5                     PUSH   DE   ; a, for r's sign
0281   7A                     LD   A,D   
0282   AC                     XOR   H   
0283   F5                     PUSH   AF   ; S flag = sign of q
0284   CB 7C                  BIT   7,H   
0286   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0289   EB                     EX   DE,HL   
028A   CB 7C                  BIT   7,H   
028C   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
028F   CD 18 03               CALL   udiv   ; HL = q, DE = r
0292   F1                     POP   AF   
0293   FC 20 01               CALL   M,neg16   ; q's sign
0296   EB                     EX   DE,HL   ; HL = r, DE = q
0297   F1                     POP   AF   ; A = a's high byte
0298   B7                     OR   A   
0299   FC 20 01               CALL   M,neg16   ; r's sign
029C   C1                     POP   BC   
029D   D5                     PUSH   DE   ; q under r
029E   F7                     RST   30h   
029F                             ; ---- stack and storage -----------------------------------------------------
029F   E5           H_DUP:    PUSH   HL   ; ":"
02A0   F7                     RST   30h   
02A1   E3           H_SWAP:   EX   (SP),HL   ; "%"
02A2   F7                     RST   30h   
02A3   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
02A4                          IF   CHECKED   
02A4   CD 0E 04               CALL   chkst   
02A7                          ENDIF      
02A7   73                     LD   (HL),E   
02A8   DF           H_DROP:   RST   18h   ; ";" is this one byte
02A9   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
02AA                          IF   CHECKED   
02AA   23                     INC   HL   ; both bytes must be in the program's space
02AB   CD 0E 04               CALL   chkst   
02AE   2B                     DEC   HL   
02AF                          ENDIF      
02AF   73                     LD   (HL),E   
02B0   23                     INC   HL   
02B1   72                     LD   (HL),D   
02B2   DF                     RST   18h   
02B3                             ; ---- console ---------------------------------------------------------------
02B3                             ; 22h pushes the address of the text after it and skips the string.
02B3   E5           H_STR:    PUSH   HL   
02B4   60                     LD   H,B   
02B5   69                     LD   L,C   
02B6   CD 55 03               CALL   skipstr   
02B9   F7                     RST   30h   
02BA                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02BA                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02BA                             ; bit 6, so // and /" give themselves).
02BA   7E           H_PRINT:   LD   A,(HL)   
02BB   23                     INC   HL   
02BC   FE 22                  CP   22h   
02BE   28 0D                  JR   Z,pr9   
02C0   FE 2F                  CP   "/"   
02C2   20 04                  JR   NZ,pr1   
02C4   7E                     LD   A,(HL)   
02C5   23                     INC   HL   
02C6   E6 BF                  AND   0BFh   
02C8   EF           PR1:      RST   28h   
02C9   18 EF                  JR   h_print   
02CB   7D           H_EMIT:   LD   A,L   ; "'"
02CC   EF                     RST   28h   
02CD   DF           PR9:      RST   18h   
02CE                             ; "#" prints TOS as a signed decimal number, with no space after it.
02CE   CB 7C        H_NUM:    BIT   7,H   
02D0   28 04                  JR   Z,num1   
02D2   3E 2D                  LD   A,"-"   
02D4   EF                     RST   28h   
02D5   E7                     RST   20h   
02D6   C5           NUM1:     PUSH   BC   
02D7   CD 81 03               CALL   pdec   
02DA   C1                     POP   BC   
02DB   DF                     RST   18h   
02DC                             ; "?" ( n -- c ) or ( -n -- addr )
02DC                             ;   n > 0: wait about n ms for a key; 0 if none came
02DC                             ;   n = 0: wait for a key
02DC                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02DC                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02DC   CB 7C        H_KEY:    BIT   7,H   
02DE   20 19                  JR   NZ,line   
02E0   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02E2   CD C5 03     KT2:      CALL   getk   
02E5   20 0E                  JR   NZ,kt3   
02E7   1D                     DEC   E   
02E8   20 F8                  JR   NZ,kt2   
02EA   7C                     LD   A,H   ; 0? never counts down: it waits
02EB   B5                     OR   L   
02EC   28 F2                  JR   Z,kt1   
02EE   2B                     DEC   HL   
02EF   7C                     LD   A,H   
02F0   B5                     OR   L   
02F1   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02F3   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02F4   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02F5   6F           KT3:      LD   L,A   
02F6   26 00                  LD   H,0   
02F8   F7                     RST   30h   
02F9                          IF   CPM   
02F9                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02F9                             ; own line editor). It doesn't store the CR, so it is added here.
02F9   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02FC   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02FD   9F                     SBC   A,A   
02FE   A5                     AND   L   ; (0 for a count that is too big)
02FF   EE 7F                  XOR   127   ; A = the count, 127 at most
0301   32 7E 07               LD   (LBHDR),A   
0304   11 7E 07               LD   DE,LBHDR   
0307   3E 0A                  LD   A,10   
0309   CD DD 03               CALL   bdosx   
030C   21 7F 07               LD   HL,LBHDR+1   
030F   7E                     LD   A,(HL)   ; the count typed (0-127)
0310   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
0311   85                     ADD   A,L   ;   adding the count to L can't carry
0312   6F                     LD   L,A   
0313   36 0D                  LD   (HL),13   
0315   2E 80                  LD   L,LINEBUF & 0FFh   
0317   F7                     RST   30h   
0318                          ENDIF      
0318                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
0318                          ENDIF      
0318                          IFN   CPM   
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
0318                          ENDIF      ;   at most
0318                          IF   EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
0318                          ENDIF      
0318                          IFN   CPM   
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
0318                          ENDIF      
0318                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
0318                          ENDIF      
0318                          IF   EDITOR   
                              RET      
0318                          ENDIF      
0318                             ; =============================================================================
0318                             ;  More routines (no handler starts past this point)
0318                             ; =============================================================================
0318                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0318                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0318                             ; while the quotient bits arrive at the bottom of C.
0318                             ; Dividing by 2 is one shift (the spec wants that fast).
0318   7B           UDIV:     LD   A,E   
0319   EE 02                  XOR   2   
031B   B2                     OR   D   
031C   20 07                  JR   NZ,udv0   
031E   CB 3C                  SRL   H   
0320   CB 1D                  RR   L   ; the quotient
0322   8F                     ADC   A,A   
0323   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0324   C9                     RET      
0325   7C           UDV0:     LD   A,H   
0326   4D                     LD   C,L   
0327   21 00 00               LD   HL,0   
032A   06 10                  LD   B,16   
032C   CB 21        UDV1:     SLA   C   
032E   17                     RLA      
032F   ED 6A                  ADC   HL,HL   
0331   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0333   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0335   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0336   0D                     DEC   C   ;   INC below
0337   0C           UDV2:     INC   C   ; a quotient bit
0338   10 F2                  DJNZ   udv1   
033A   EB                     EX   DE,HL   ; DE = remainder
033B   67                     LD   H,A   
033C   69                     LD   L,C   ; HL = quotient
033D   C9                     RET      
033E                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
033E                             ; non-digit. Values wrap at 16 bits, as the spec says.
033E   21 00 00     RDNUM:    LD   HL,0   
0341   0A           RDN1:     LD   A,(BC)   
0342   D6 30                  SUB   "0"   
0344   FE 0A                  CP   10   
0346   D0                     RET   NC   
0347   03                     INC   BC   
0348   54                     LD   D,H   
0349   5D                     LD   E,L   
034A   29                     ADD   HL,HL   
034B   29                     ADD   HL,HL   
034C   19                     ADD   HL,DE   
034D   29                     ADD   HL,HL   ; HL * 10
034E   5F                     LD   E,A   
034F   16 00                  LD   D,0   
0351   19                     ADD   HL,DE   
0352   18 ED                  JR   rdn1   
0354                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0354                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0354   03           SS0:      INC   BC   
0355   0A           SKIPSTR:   LD   A,(BC)   
0356   03                     INC   BC   
0357   FE 2F                  CP   "/"   
0359   28 F9                  JR   Z,ss0   
035B   FE 22                  CP   22h   
035D   20 F6                  JR   NZ,skipstr   
035F   C9                     RET      
0360                             ; skip: read past text to the closer at this level, and return A = 0 if it
0360                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0360                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0360                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0360                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0360                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0360   16 00        SKIP:     LD   D,0   
0362   14           SK3:      INC   D   ; an opener: one deeper
0363   0A           SK1:      LD   A,(BC)   
0364   03                     INC   BC   
0365   B7                     OR   A   
0366   CA 15 01               JP   Z,endprog   
0369   FE 22                  CP   22h   
036B   CC 55 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
036E   D6 28                  SUB   "("   
0370   28 F0                  JR   Z,sk3   
0372   3D                     DEC   A   ; ")"
0373   28 08                  JR   Z,sk4   
0375   D6 32                  SUB   "["-")"   
0377   28 E9                  JR   Z,sk3   
0379   FE 02                  CP   "]"-"["   
037B   20 E6                  JR   NZ,sk1   
037D   15           SK4:      DEC   D   
037E   C8                     RET   Z   ; the closer at this level
037F   18 E2                  JR   sk1   
0381                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0381                             ; Uses BC.
0381   11 0A 00     PDEC:     LD   DE,10   
0384   CD 18 03               CALL   udiv   ; HL = HL / 10, E = the last digit
0387   7B                     LD   A,E   
0388   F5                     PUSH   AF   
0389   7C                     LD   A,H   
038A   B5                     OR   L   
038B   C4 81 03               CALL   NZ,pdec   
038E   F1                     POP   AF   
038F   C6 30                  ADD   A,"0"   
0391   EF                     RST   28h   
0392   C9                     RET      
0393                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0393                             ; and return its value in A with the carry set; otherwise leave the IP and
0393                             ; return with the carry clear.
0393   0A           HEXC:     LD   A,(BC)   
0394   D6 30                  SUB   "0"   
0396   FE 0A                  CP   10   
0398   38 09                  JR   C,hc1   
039A   E6 DF                  AND   0DFh   
039C   D6 11                  SUB   11h   
039E   FE 06                  CP   6   
03A0   D0                     RET   NC   
03A1   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03A3   03           HC1:      INC   BC   
03A4   C9                     RET      
03A5                             ; =============================================================================
03A5                             ;  Dispatch table: the low byte of each handler's address, in code order
03A5                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03A5                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03A5                             ; =============================================================================
03A5                             ; The handlers of the first NPG1 characters start in the image's second page.
03A5                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03A5                             ; differs between the builds, so the count is worked out here.
03A5                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03A5                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03A5                PGBRK:    EQU   (h_break-BASE)/256   
03A5                PGDEF:    EQU   (h_def-BASE)/256   
03A5                PGFET:    EQU   (h_fetch-BASE)/256   
03A5                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03A5                          IF   1-EDITOR   
03A5                PTAB:        
03A5                          ;*Macro unroll:  PTABLE
03A5   A9                     DB   h_store & 0FFh   
03A6   B3                     DB   h_str & 0FFh   
03A7   CE                     DB   h_num & 0FFh   
03A8   BA                     DB   h_print & 0FFh   
03A9   A1                     DB   h_swap & 0FFh   
03AA   49                     DB   h_and & 0FFh   
03AB   CB                     DB   h_emit & 0FFh   
03AC   25                     DB   h_open & 0FFh   
03AD   2D                     DB   h_close & 0FFh   
03AE   6A                     DB   h_mul & 0FFh   
03AF   40                     DB   h_add & 0FFh   
03B0   F4                     DB   h_cfetch & 0FFh   
03B1   38                     DB   h_sub & 0FFh   
03B2   A3                     DB   h_cstore & 0FFh   
03B3   7E                     DB   h_div & 0FFh   
03B4   9F                     DB   h_dup & 0FFh   
03B5   A8                     DB   h_drop & 0FFh   
03B6   51                     DB   h_lt & 0FFh   
03B7   60                     DB   h_eq & 0FFh   
03B8   52                     DB   h_gt & 0FFh   
03B9   DC                     DB   h_key & 0FFh   
03BA   20                     DB   h_fetch & 0FFh   
03BB   FD                     DB   h_def & 0FFh   
03BC   F0                     DB   h_break & 0FFh   
03BD   EC                     DB   h_ret & 0FFh   
03BE   80                     DB   h_xor & 0FFh   
03BF   93                     DB   h_alloc & 0FFh   
03C0   D0                     DB   h_grave & 0FFh   
03C1   2C                     DB   h_tor & 0FFh   
03C2   88                     DB   h_or & 0FFh   
03C3   1C                     DB   h_fromr & 0FFh   
03C4   90                     DB   h_not & 0FFh   
03C5                PTABEND:      
03C5                          ENDIF      
03C5                             ; =============================================================================
03C5                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
03C5                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
03C5                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
03C5                             ;  KEY and CONOUT routines themselves.
03C5                             ; =============================================================================
03C5                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
03C5                          ENDIF      
03C5                          IF   CHECKED   
03C5   E5           GETK:     PUSH   HL   ; a key held back by the break check goes
03C6   21 36 07               LD   HL,KEYBUF   ;   first, and is taken out of the buffer
03C9   7E                     LD   A,(HL)   
03CA   36 00                  LD   (HL),0   
03CC   E1                     POP   HL   
03CD   B7                     OR   A   
03CE   C0                     RET   NZ   
03CF                          ENDIF      
03CF                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
03CF                          ENDIF      
03CF                          IF   CPM*(1-CHECKED)   
                    GETK:        
03CF                          ENDIF      
03CF                          IF   CPM   
03CF   3E FF                  LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03D1                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
03D1                             ; printing and could swallow a key that BDOS 6 then never sees.
03D1   D5           PUTC:     PUSH   DE   
03D2   E5                     PUSH   HL   
03D3   5F                     LD   E,A   
03D4   3E 06                  LD   A,6   
03D6   CD DD 03               CALL   bdosx   
03D9   E1                     POP   HL   
03DA   D1                     POP   DE   
03DB   B7                     OR   A   ; (for getk)
03DC   C9                     RET      
03DD                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
03DD   C5           BDOSX:    PUSH   BC   
03DE   D9                     EXX      
03DF   E5                     PUSH   HL   
03E0   D9                     EXX      
03E1   4F                     LD   C,A   
03E2   CD 05 00               CALL   BDOS   
03E5   D9                     EXX      
03E6   E1                     POP   HL   
03E7   D9                     EXX      
03E8   C1                     POP   BC   
03E9   C9                     RET      
03EA                          ENDIF      
03EA                             ; =============================================================================
03EA                             ;  Checked build: the checks and the error report
03EA                             ; =============================================================================
03EA                          IF   CHECKED   
03EA                             ; chkstk: both stacks are checked once per character, not in every handler.
03EA                             ; Each stack lives in one page, so it has overrun exactly when the pointer's
03EA                             ; high byte has left that page. Errors are caught one cell late at most; the
03EA                             ; page below each stack is a guard band. (The call itself is on the data
03EA                             ; stack, but in the same page whenever the stack is in range.)
03EA   ED 73 38 07  CHKSTK:   LD   (SPTMP),SP   
03EE   3A 39 07               LD   A,(SPTMP+1)   
03F1   FE 06                  CP   DSPAGE   
03F3   20 36                  JR   NZ,e_stack   
03F5   D9                     EXX      ; the return stack: in its page, and not
03F6   7D                     LD   A,L   ;   above its empty position (an underflow
03F7   FE E1                  CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
03F9   7C                     LD   A,H   ;   guard band)
03FA   D9                     EXX      
03FB   30 31                  JR   NC,e_rstack   
03FD   FE 05                  CP   RSPAGE   
03FF   C8                     RET   Z   
0400   18 2C                  JR   e_rstack   
0402                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
0402                             ; else is held for the next "?".
0402   CD C5 03     CHKBRK:   CALL   getk   
0405   C8                     RET   Z   
0406   FE 03                  CP   3   
0408   28 27                  JR   Z,e_break   
040A   32 36 07               LD   (KEYBUF),A   
040D   C9                     RET      
040E                             ; chkst: stop unless HL is in the program's own space: from the letter page
040E                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
040E                             ; whatever lies above the limit are safe. Memory above the heap top but
040E                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
040E                             ; Keeps every register.
040E   F5           CHKST:    PUSH   AF   
040F   7C                     LD   A,H   
0410   FE 07                  CP   LETPAGE   
0412   38 14                  JR   C,e_store   
0414                          ENDIF      
0414                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              JR   NC,e_store   
0414                          ENDIF      
0414                          IF   CHECKED*CPM   
0414   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0417   3D                     DEC   A   
0418   BC                     CP   H   
0419   38 0D                  JR   C,e_store   
041B                          ENDIF      
041B                          IF   CHECKED   
041B   F1                     POP   AF   
041C   C9                     RET      
041D                             ; chkhp: stop if working out the new heap top carried (a negative count
041D                             ; wraps: too big), or if the new top in HL is not below the limit page.
041D   38 06        CHKHP:    JR   C,e_heap   
041F                          ENDIF      
041F                          IF   CHECKED*(1-CPM)   
                              LD   A,H   
                              CP   HEAPLIM   
                              RET   C   
041F                          ENDIF      
041F                          IF   CHECKED*CPM   
041F   3A 07 00               LD   A,(0007h)   
0422   3D                     DEC   A   
0423   BC                     CP   H   
0424   D0                     RET   NC   
0425                          ENDIF      
0425                          IF   CHECKED   
0425                             ; Error entries. Each loads its letter and then hides the next entry inside
0425                             ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
0425   3E 48        E_HEAP:   LD   A,"H"   ; heap past the limit
0427   21                     DB   21h   
0428   3E 57        E_STORE:   LD   A,"W"   ; write outside the program's space
042A   21                     DB   21h   
042B   3E 53        E_STACK:   LD   A,"S"   ; data stack over or under
042D   21                     DB   21h   
042E   3E 52        E_RSTACK:   LD   A,"R"   ; return stack over or under
0430   21                     DB   21h   
0431   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C
0433   21                     DB   21h   
0434   3E 44        E_BRACK:   LD   A,"D"   ; bad character after [
0436                             ; error: print the letter in A, " @ " and the offset in the program of the
0436                             ; character just read, then end. For example: S @ 245
0436   31 FE 06     ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
0439   EF                     RST   28h   
043A   3E 20                  LD   A," "   
043C   EF                     RST   28h   
043D   3E 40                  LD   A,"@"   
043F   EF                     RST   28h   
0440   3E 20                  LD   A," "   
0442   EF                     RST   28h   
0443   21 FF F7               LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
0446   09                     ADD   HL,BC   ;   just read: HL = its offset
0447   CD 81 03               CALL   pdec   
044A   C3 15 01               JP   endprog   
044D                          ENDIF      
044D                             ; =============================================================================
044D                             ;  The line editor (EDITOR = 1)
044D                             ; 
044D                             ;  The interpreter starts here, and a program that ends comes back here. Type
044D                             ;  a line and press Return:
044D                             ; 
044D                             ;    n text    put the text in as line n; the lines from n on move down.
044D                             ;              A number past the end, or 0, adds the line at the end.
044D                             ;    n         take line n out
044D                             ;    0         run the program
044D                             ;    -n        list the program from line n on (-1 lists all of it). Any key
044D                             ;              stops the list until another key is pressed; Ctrl-C ends it.
044D                             ;    anything else is run at once, as B8Script. (Start such a line with a
044D                             ;    space if it would begin with a digit or a minus sign.)
044D                             ; 
044D                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
044D                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
044D                             ;  125 characters, the line number and the one character after it included;
044D                             ;  that character is not stored. The text is kept as it is typed, each line
044D                             ;  ending in CR LF, at PROG. Nothing is checked.
044D                             ; 
044D                             ;  Things to know:
044D                             ;    - Reset empties the program.
044D                             ;    - Words and variables last from one line to the next. A word's address
044D                             ;      points into the program, so run the program again after editing it.
044D                             ;    - Nothing is printed between a program's output and what is typed next.
044D                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
044D                             ;      a line that calls -n? and carries on afterwards runs what was typed.
044D                             ;      (The stored program never comes back to the line, so it may.)
044D                             ; =============================================================================
044D                          IF   EDITOR   
                                 ; -n: list from line n. DE = the number of the line at HL.
                    LIST:     INC   BC   
                              CALL   rdnum   ; HL = n
                              PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,edit   ; the end of the text
                              CALL   getk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,edit   ; Ctrl-C
                    LI2:      CALL   getk   ; any other key: wait for one more
                              JR   Z,li2   
                              CP   3   
                              JR   Z,edit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; Take line n (in HL) out: copy everything after it down over it.
                    DEL:      CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
                              LD   D,0FDh   ; 125 characters at most
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   
                              CALL   prl   ; (print the CR LF: a new line)
                              LD   (HL),0   ;   and a NUL after that
                              PUSH   HL   ; the end of what was typed
                              LD   BC,LINEBUF   
                              LD   A,(BC)   
                              CP   "-"   
                              JR   Z,list   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0   ; no number: run the line where it is
                              LD   A,(BC)   
                              SUB   13   
                              JR   NZ,ins   ; text follows the number
                              OR   H   ; the number alone:
                              OR   L   
                              JR   NZ,del   ;   not 0: take that line out
                              LD   BC,PROG   ;   0: run the program
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; Put the typed text in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              INC   BC   ; step over the one character after the number
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                              JR   edit   
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
044D                          ENDIF      
044D                             ; =============================================================================
044D                             ;  CP/M startup (the generic build starts at address 0: see st0)
044D                             ; =============================================================================
044D                          IF   CPM   
044D                             ; The RAM pages follow the image; the heap may grow to the BDOS.
044D   21 08 01     START:    LD   HL,vecs   ; the RST routines go down into page zero
0450   11 08 00               LD   DE,0008h   
0453   01 2C 00               LD   BC,vecend-vecs   
0456   ED B0                  LDIR      
0458   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
045B   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
045D   CD 05 00               CALL   BDOS   ;   and the program is empty)
0460   11 00 08               LD   DE,PROG   
0463   D5           LD1:      PUSH   DE   
0464   0E 1A                  LD   C,26   ; set the DMA address
0466   CD 05 00               CALL   BDOS   
0469   11 5C 00               LD   DE,005Ch   
046C   0E 14                  LD   C,20   ; read the next 128 bytes
046E   CD 05 00               CALL   BDOS   
0471   E1                     POP   HL   ; HL = the address this record went to
0472   B7                     OR   A   
0473   20 07                  JR   NZ,ld2   
0475   11 80 00               LD   DE,128   
0478   19                     ADD   HL,DE   
0479   EB                     EX   DE,HL   
047A   18 E7                  JR   ld1   
047C   36 00        LD2:      LD   (HL),0   ; the end of the file counts as NUL
047E   23                     INC   HL   ; the heap starts after it
047F   01 00 08               LD   BC,PROG   ; the IP
0482   C3 73 01               JP   st2   
0485                          ENDIF      
0485                          IF   CPM   
0485                             ; RAM pages, after the image
0485                RSPAGE:   EQU   (imgend + 255) / 256   
0485                DSPAGE:   EQU   RSPAGE + 1   
0485                LETPAGE:   EQU   RSPAGE + 2   
0485                PROG:     EQU   LETPAGE*256 + 256   
0485                          ENDIF      
0485                IMGEND:      


