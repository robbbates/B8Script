0560   EB                     XCHG      
0561   E5                     PUSH   H   ; the count
0562   2A 38 0A               LHLD   NPEND   
0565   19                     DAD   D   ; carry: at or above the program's end
0566   E1                     POP   H   
0567   EB                     XCHG      
0568   D8                     RC      
0569   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
056A   D1                     POP   D   ;   and drop the return address (errp drops
056B   3E 48                  MVI   A,"H"   ;   the old top)
056D   C3 04 06               JMP   errp   
0570                             ; chkst: stop unless HL is in the program's own space: from the letter page
0570                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0570                             ; whatever lies above the limit are safe. Memory above the heap top but
0570                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0570                             ; It is the page of HL + 1 that is tested, so that one test serves both
0570                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0570                             ; Keeps HL and BC. It runs on into its own error entry.
0570   23           CHKST:    INX   H   
0571   7C                     MOV   A,H   
0572   2B                     DCX   H   
0573   FE 0A                  CPI   LETPAGE   
0575   DA 7F 05               JC   e_store   
0578                          ENDIF      
0578                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
0578                          ENDIF      
0578                          IF   CHECKED*CPM   
0578   5F                     MOV   E,A   
0579   3A 07 00               LDA   0007h   ; the BDOS page is the heap limit
057C   3D                     DCR   A   
057D   BB                     CMP   E   
057E   D0                     RNC      
057F                          ENDIF      
057F                          IF   CHECKED   
057F                             ; Two error entries for errors found inside a routine: the first hides the
057F                             ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
057F                             ; return address.
057F   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
0581   11                     DB   11h   
0582   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
0584   C3 04 06               JMP   errp   
0587                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
