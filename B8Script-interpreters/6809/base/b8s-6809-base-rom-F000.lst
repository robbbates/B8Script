F29A   34 20                  PSHS   Y   
F29C   6E 84                  JMP   ,X   
F29E                             ; 22h pushes the address of the text after it and skips the string.
F29E                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
F29E                             ; the next character, so "/"" does not end it. Leaves A = 22h. (The checked
F29E                             ; build's is after skip.)
F29E                          IF   1-CHECKED   
                    H_STR:    PSHU   Y   
                              FCB   8Ch   ; (CMPX #: steps over the LEAY)
                    SS0:      LEAY   1,Y   
                    SKIPSTR:   LDA   ,Y+   
                              CMPA   #"/"   
                              BEQ   ss0   
                              CMPA   #22h   
                              BNE   skipstr   
                              RTS      
F29E                          ENDIF      
