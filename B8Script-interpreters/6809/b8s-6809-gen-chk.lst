F1B5   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
F1B7   1F 89                  TFR   A,B   ;   lands 64 bytes up
F1B9   C4 DF                  ANDB   #0DFh   ; fold case
F1BB   C1 1A                  CMPB   #26   
F1BD                          IF   1-CHECKED   
                              BHS   def2   ; not a letter
F1BD                          ENDIF      
F1BD                          IF   CHECKED   
F1BD   24 E8                  BHS   def1   
F1BF                          ENDIF      
F1BF   BD F0 AD               JSR   cellx   
F1C2   1F 20                  TFR   Y,D   
F1C4   E7 84                  STB   ,X   ; little-endian
F1C6   A7 01                  STA   1,X   
F1C8   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F1C9   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F1CB                          IF   1-CHECKED   
                                 ; fall into skip
F1CB                          ENDIF      
F1CB                          IF   CHECKED   
F1CB                             ; Checked: the skip must end at a "]" (A = 2), or for a false "(",
F1CB                             ; which comes to opf, at a ")" (A = 0). Anything else stops with N.
F1CB   8D 0B                  BSR   skip   
F1CD   80 02                  SUBA   #2   
F1CF   8C                     FCB   8Ch   ; (CMPX #: steps over the BSR)
F1D0   8D 06        OPF:      BSR   skip   
F1D2   4D                     TSTA      
F1D3   10 26 01 5B            LBNE   e_nest   
F1D7   39                     RTS      
F1D8                          ENDIF      
F1D8                             ; skip: read past text to the closer at this level, and return A = 0 if it
F1D8                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F1D8                             ; strings are stepped over whole. B counts the open levels.
F1D8                             ; Unchecked: a NUL first ends the program (for "\" with no closer; anything
F1D8                             ; else that runs into the NUL had unbalanced brackets anyway).
F1D8                             ; Checked: a NUL, or a string that runs into it, returns A = FFh, and the
F1D8                             ; caller decides: "\" ends the program, "(" and "[" stop with N, as they do
F1D8                             ; for a closer of the other kind. The place is the opener, still in AT.
F1D8   5F           SKIP:     CLRB      
F1D9   A6 A0        SK1:      LDA   ,Y+   
F1DB                          IF   1-CHECKED   
                              LBEQ   fin   
F1DB                          ENDIF      
F1DB                          IF   CHECKED   
