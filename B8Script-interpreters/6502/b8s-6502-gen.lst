E49A   4C 50 E1     RH1:      JMP   incip   
E49D   60           RH9:      RTS      
E49E                             ; =============================================================================
E49E                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E49E                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E49E                             ;  Both keep X and Y. In the unchecked build getk is the host's KEY itself.
E49E                             ; =============================================================================
E49E                          IF   1-CHECKED   
E49E                GETK:     EQU   KEY   ; the host's routine does the whole job
E49E                          ENDIF      
E49E                          IF   CHECKED   
                    GETK:     LDA   KEYBUF   ; a key held back by the break check
                              BEQ   gk1   
                              PHA      
                              LDA   #0   
                              STA   KEYBUF   
                              PLA      
                              RTS      
                    GK1:      JMP   KEY   
E49E                          ENDIF      
E49E                             ; =============================================================================
E49E                             ;  Checked build: break key and error reports
E49E                             ; =============================================================================
E49E                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   LDA   KEYBUF   
                              BNE   cb9   ; one key is already held
                              JSR   getk   
                              BEQ   cb9   
                              CMP   #3   
                              BEQ   e_break   
                              STA   KEYBUF   
                    CB9:      RTS      
                    E_BREAK:   LDA   #"B"   ; Ctrl-C
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                                 ; The stacks are left as they are: the hardware stack wraps inside its page,
                                 ; so the calls below work whatever state it is in.
                    ERROR:    JSR   CONOUT   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   #"@"   
                              JSR   CONOUT   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   IP   
                              SEC      
                              SBC   #<PROG1   ; the character just read
                              STA   TL   
                              LDA   IP+1   
                              SBC   #>PROG1   
                              STA   TH   
                              JSR   h_num   
                              JMP   endprog   
E49E                          ENDIF      


