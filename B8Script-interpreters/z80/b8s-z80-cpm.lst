0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
0000                EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 05               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0103                          ENDIF      
0103                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0103                          ENDIF      
0103                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0103                          ENDIF      
0103                          IF   EDGEN   
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 BF 03               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 00 00     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 A6 03               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 BB 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0134                          ENDIF      
0134   0A                     LD   A,(BC)   
0135   03                     INC   BC   
0136   D6 21                  SUB   21h   ; A = c - 21h
0138   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013A   FE 0F                  CP   0Fh   
013C   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
013E   D6 0F                  SUB   0Fh   ; A = c - 30h
0140   FE 0A                  CP   0Ah   
0142   38 61                  JR   C,digit   ; 30h-39h
0144   FE 11                  CP   11h   
0146   38 16                  JR   C,p3a   ; 3Ah-40h
0148   D6 11                  SUB   11h   ; A = c - 41h
014A   FE 1A                  CP   1Ah   
014C   38 63                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
014E   FE 20                  CP   20h   
0150   38 0A                  JR   C,p5b   ; 5Bh-60h
0152   FE 3A                  CP   3Ah   
0154   38 55                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0156   FE 3E                  CP   3Eh   
0158                          IF   1-CHECKED   
0158   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
015A                          ENDIF      
015A                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
015A                          ENDIF      
015A   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
015C   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
015E   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0160                .macro PTABLE,
0160                             ; 
0160                 DB      h_store & 0FFh  ; !
0160                 DB      h_str & 0FFh    ; "
0160                 DB      h_num & 0FFh    ; #
0160                 DB      h_print & 0FFh  ; $
0160                 DB      h_swap & 0FFh   ; %
0160                 DB      h_and & 0FFh    ; &
0160                 DB      h_emit & 0FFh   ; '
0160                 DB      h_open & 0FFh   ; (
0160                 DB      h_close & 0FFh  ; )
0160                 DB      h_mul & 0FFh    ; *
0160                 DB      h_add & 0FFh    ; +
0160                 DB      h_cfetch & 0FFh ; ,
0160                 DB      h_sub & 0FFh    ; -
0160                 DB      h_cstore & 0FFh ; .
0160                 DB      h_div & 0FFh    ; /
0160                 DB      h_dup & 0FFh    ; :
0160                 DB      h_drop & 0FFh   ; ;
0160                 DB      h_lt & 0FFh     ; <
0160                 DB      h_eq & 0FFh     ; =
0160                 DB      h_gt & 0FFh     ; >
0160                 DB      h_key & 0FFh    ; ?
0160                 DB      h_fetch & 0FFh  ; @
0160                 DB      h_def & 0FFh    ; [
0160                 DB      h_break & 0FFh  ; \
0160                 DB      h_ret & 0FFh    ; ]
0160                 DB      h_xor & 0FFh    ; ^
0160                 DB      h_alloc & 0FFh  ; _
0160                 DB      h_grave & 0FFh  ; `
0160                 DB      h_tor & 0FFh    ; {
0160                 DB      h_or & 0FFh     ; |
0160                 DB      h_fromr & 0FFh  ; }
0160                 DB      h_not & 0FFh    ; ~
0160                .endm
0160                 
0160                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0160                             ; untouched, and A, DE free.
0160   C6 84        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0162   5F                     LD   E,A   
0163   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0165   FE 9A                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0167   1A                     LD   A,(DE)   
0168   5F                     LD   E,A   ; the handler's low byte
0169                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0169                          ENDIF      
0169                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
0169                          ENDIF      
0169                          IF   CPM   
0169   16 01                  LD   D,1   
016B   30 01                  JR   NC,pu1   
016D   14                     INC   D   ; its page: 1 + carry
016E                PU1:         
016E                          ENDIF      
016E   D5                     PUSH   DE   ; jump to it; the stack is balanced again
016F   C9                     RET      ;   when the handler starts
0170                             ; The rest of the startup: here so that the generic reset code can reach it
0170                             ; with JR. st0: find the program's NUL; the heap starts after it.
0170                             ; (The editor build has its own copy of this, next to the editor.)
0170                             ; A checked build first clears the lower half of the letter page (A = 0):
0170                             ; every variable starts at 0, every word cell holds 0000h, the address an
0170                             ; undefined word is caught at (see e_hi), and no key is held back.
0170                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0170                          ENDIF      
0170                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0170                          ENDIF      
0170                          IF   1-EDITOR   
0170   22 7C 06     ST2:      LD   (HEAP),HL   
0173                          ENDIF      
0173                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0173                          ENDIF      
0173                          IF   1-EDITOR   
0173   D9                     EXX      
0174   21 E0 04               LD   HL,RSTOP   ; the return stack is empty
0177   D9                     EXX      
0178   F7                     RST   30h   ; (its return address is thrown away)
0179                          ENDIF      
0179                             ; In the unchecked generic editor build the table is here, in the first
0179                             ; page, which saves loading D twice. (The other builds have no room for it
0179                             ; here: theirs is further down.)
0179                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0179                          ENDIF      
0179                             ; =============================================================================
0179                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0179                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0179                             ;  is here too: it belongs to "`" and makes the page come out right.
0179                             ; =============================================================================
0179   D1           H_XOR:    POP   DE   
017A   7C                     LD   A,H   
017B   AA                     XOR   D   
017C   67                     LD   H,A   
017D   7D                     LD   A,L   
017E   AB                     XOR   E   
017F   6F                     LD   L,A   
0180   F7                     RST   30h   
0181   D1           H_OR:     POP   DE   
0182   7C                     LD   A,H   
0183   B2                     OR   D   
0184   67                     LD   H,A   
0185   7D                     LD   A,L   
0186   B3                     OR   E   
0187   6F                     LD   L,A   
0188   F7                     RST   30h   
0189   E7           H_NOT:    RST   20h   ; ~x = -x - 1
018A   2B                     DEC   HL   
018B   F7                     RST   30h   
018C                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
018C                             ; the same either way); TOS is the old pointer.
018C   ED 5B 7C 06  H_ALLOC:   LD   DE,(HEAP)   
0190                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0190                          ENDIF      
0190   19                     ADD   HL,DE   ; the new top
0191                          IF   CHECKED   
                              CALL   chkhp   
0191                          ENDIF      
0191   22 7C 06               LD   (HEAP),HL   
0194   EB                     EX   DE,HL   
0195   F7                     RST   30h   
0196   D9           EXEC:     EXX      
0197   22 34 06               LD   (RSAVE),HL   ; machine code may change the alternates
019A   D9                     EXX      
019B   CD 2B 01               CALL   jphl   
019E   D9                     EXX      
019F   2A 34 06               LD   HL,(RSAVE)   
01A2   D9                     EXX      
01A3   E1                     POP   HL   
01A4   F7                     RST   30h   
01A5                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01A5                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01A5                             ; Digits: step back onto the first digit and read the whole number.
01A5   E5           DIGIT:    PUSH   HL   
01A6   0B                     DEC   BC   
01A7   CD 15 03               CALL   rdnum   
01AA   F7                     RST   30h   
01AB                             ; a-z: push the cell's address (the cell is the variable)
01AB   E5           LOWER:    PUSH   HL   
01AC   87                     ADD   A,A   
01AD   6F                     LD   L,A   
01AE   26 06                  LD   H,LETPAGE   
01B0   F7                     RST   30h   
01B1                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01B1                             ; the return stack, and the IP becomes the address in the letter's cell.
01B1   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01B2   EB                     EX   DE,HL   ; park TOS
01B3   87                     ADD   A,A   
01B4   6F                     LD   L,A   
01B5   26 06                  LD   H,LETPAGE   ; HL -> cell
01B7   4E                     LD   C,(HL)   
01B8   2C                     INC   L   
01B9   46                     LD   B,(HL)   ; IP = the word's body
01BA   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01BB                             ; rpushn: move the top cell of the data stack (in memory) to the return
01BB                             ; stack, then next. Everything that pushes the return stack ends here.
01BB                RPUSHN:      
01BB                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every word call, block
01BB                          ENDIF      ;   entry, loop-back and "{"
01BB   D9                     EXX      
01BC   D1                     POP   DE   
01BD   2B                     DEC   HL   
01BE   72                     LD   (HL),D   
01BF   2B                     DEC   HL   
01C0   73                     LD   (HL),E   
01C1   D9                     EXX      
01C2   F7                     RST   30h   
01C3                             ; ---- machine code: the grave -----------------------------------------------
01C3                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01C3                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01C3                             ; written and its address is left. An odd last digit is consumed and dropped.
01C3                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01C3                             ; code is entered by CALL with the data stack above the return address; it
01C3                             ; must keep BC, and on return the top cell becomes the new TOS.
01C3   CD 72 03     H_GRAVE:   CALL   hexc   
01C6   30 CE                  JR   NC,exec   
01C8   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01C9   CD 72 03               CALL   hexc   
01CC   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01CE   ED 6F                  RLD      ;   overwrites it
01D0   23                     INC   HL   ; ... and RLD shifts it up under the low one
01D1   CD 72 03               CALL   hexc   
01D4   38 F2                  JR   C,hx1   
01D6   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01D8   F7                     RST   30h   
01D9                             ; ---- where the two pages meet ----------------------------------------------
01D9                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D9                             ; are in falling code order for this), and where exactly differs between the
01D9                             ; builds: NPG1 follows. Every handler below these four must start in the
01D9                             ; second page, and every one above in the first; chktab.py checks both.
01D9                             ; "]" returns: pop an address and jump to it.
01D9   CF           H_RET:    RST   08h   
01DA   42                     LD   B,D   
01DB   4B                     LD   C,E   
01DC   F7           BRK1:     RST   30h   
01DD                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01DD                             ; drops the block start, "]" returns. No closer at all ends the program.
01DD   7C           H_BREAK:   LD   A,H   
01DE   B5                     OR   L   
01DF   E1                     POP   HL   
01E0   28 FA                  JR   Z,brk1   
01E2   CD 37 03               CALL   skip   
01E5   B7                     OR   A   ; skip returns 0 for ")"
01E6   20 F1                  JR   NZ,h_ret   
01E8   CF           RDROP:    RST   08h   
01E9   F7                     RST   30h   
01EA                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EA                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EA                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EA                             ; (The unchecked build takes anything that is not a letter as the space; the
01EA                             ; checked build stops on it.)
01EA   0A           H_DEF:    LD   A,(BC)   
01EB   03                     INC   BC   
01EC   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01EE   5F                     LD   E,A   ;   lands 64 bytes up
01EF   E6 DF                  AND   0DFh   ; fold case
01F1   FE 1A                  CP   26   
01F3   30 0B                  JR   NC,def2   ; not a letter
01F5   CB 23                  SLA   E   
01F7   16 06                  LD   D,LETPAGE   ; DE -> cell
01F9   79                     LD   A,C   
01FA   12                     LD   (DE),A   
01FB   1C                     INC   E   
01FC   78                     LD   A,B   
01FD   12                     LD   (DE),A   
01FE   18 03                  JR   skipnx   
0200                DEF2:        
0200                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0200                          ENDIF      
0200   E5                     PUSH   HL   ; an anonymous block: push its address
0201   60                     LD   H,B   
0202   69                     LD   L,C   
0203                SKIPNX:      
0203                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0203                          ENDIF      ;   opener, the "[", just before where it starts
0203   CD 37 03     SKIPO:    CALL   skip   
0206   F7                     RST   30h   
0207   5E           H_FETCH:   LD   E,(HL)   ; "@"
0208   23                     INC   HL   
0209   56                     LD   D,(HL)   
020A   EB                     EX   DE,HL   
020B   F7                     RST   30h   
020C                             ; =============================================================================
020C                             ;  Handlers that must start in the image's second page.
020C                             ;  "?" is the last (with "," inside it), so its long tail may run past that
020C                             ;  page.
020C                             ; =============================================================================
020C                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
020C                             ; the matching ")".
020C   7C           H_OPEN:   LD   A,H   
020D   B5                     OR   L   
020E   E1                     POP   HL   
020F   28 F2                  JR   Z,skipo   
0211   C5                     PUSH   BC   ; the block starts at the IP
0212   18 A7                  JR   rpushn   
0214                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0214                             ; drops it and carries on.
0214   7C           H_CLOSE:   LD   A,H   
0215   B5                     OR   L   
0216   E1                     POP   HL   
0217   28 CF                  JR   Z,rdrop   
0219   CF                     RST   08h   ; pop the block start ...
021A   42                     LD   B,D   
021B   4B                     LD   C,E   
021C   C5                     PUSH   BC   
021D   18 9C                  JR   rpushn   ; ... and push it back
021F                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
021F                             ; "-" has two jobs: directly before a digit it starts a negative number.
021F   0A           H_SUB:    LD   A,(BC)   
0220   D6 30                  SUB   "0"   
0222   FE 0A                  CP   10   
0224   38 04                  JR   C,negnum   
0226   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0227   D1           H_ADD:    POP   DE   
0228   19                     ADD   HL,DE   
0229   F7                     RST   30h   
022A   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
022B   CD 15 03               CALL   rdnum   
022E   E7                     RST   20h   
022F   F7                     RST   30h   
0230   D1           H_AND:    POP   DE   
0231   7C                     LD   A,H   
0232   A2                     AND   D   
0233   67                     LD   H,A   
0234   7D                     LD   A,L   
0235   A3                     AND   E   
0236   6F                     LD   L,A   
0237   F7                     RST   30h   
0238                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0238                             ; cells first. Flipping both sign bits turns a signed compare into an
0238                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0238                             ; carry into -1 or 0 with no branch.
0238   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0239   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
023A   7C                     LD   A,H   
023B   EE 80                  XOR   80h   
023D   67                     LD   H,A   
023E   7A                     LD   A,D   
023F   EE 80                  XOR   80h   
0241   57                     LD   D,A   
0242   ED 52                  SBC   HL,DE   ; carry if HL < DE
0244   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0246   F7                     RST   30h   
0247   D1           H_EQ:     POP   DE   
0248   B7                     OR   A   
0249   ED 52                  SBC   HL,DE   
024B   7C                     LD   A,H   
024C   B5                     OR   L   
024D   FE 01                  CP   1   ; carry only if a - b = 0
024F   18 F3                  JR   tf   
0251                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0251                             ; multiplier shifts up through A:C.
0251   D1           H_MUL:    POP   DE   ; DE = multiplicand
0252   C5                     PUSH   BC   
0253   7C                     LD   A,H   
0254   4D                     LD   C,L   ; A:C = multiplier
0255   21 00 00               LD   HL,0   
0258   06 10                  LD   B,16   
025A   29           MUL1:     ADD   HL,HL   
025B   CB 21                  SLA   C   
025D   17                     RLA      
025E   30 01                  JR   NC,mul2   
0260   19                     ADD   HL,DE   
0261   10 F7        MUL2:     DJNZ   mul1   
0263   C1                     POP   BC   
0264   F7                     RST   30h   
0265                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0265                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0265                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0265                             ; stops on it.
0265                H_DIV:       
0265                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0265                          ENDIF      
0265   D1                     POP   DE   ; DE = a, HL = b
0266   C5                     PUSH   BC   ; free BC for udiv
0267   D5                     PUSH   DE   ; a, for r's sign
0268   7A                     LD   A,D   
0269   AC                     XOR   H   
026A   F5                     PUSH   AF   ; S flag = sign of q
026B   CB 7C                  BIT   7,H   
026D   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0270   EB                     EX   DE,HL   
0271   CB 7C                  BIT   7,H   
0273   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0276   CD EF 02               CALL   udiv   ; HL = q, DE = r
0279   F1                     POP   AF   
027A   FC 20 01               CALL   M,neg16   ; q's sign
027D   EB                     EX   DE,HL   ; HL = r, DE = q
027E   F1                     POP   AF   ; A = a's high byte
027F   B7                     OR   A   
0280   FC 20 01               CALL   M,neg16   ; r's sign
0283   C1                     POP   BC   
0284   D5                     PUSH   DE   ; q under r
0285   F7                     RST   30h   
0286                             ; ---- stack and storage -----------------------------------------------------
0286   E5           H_DUP:    PUSH   HL   ; ":"
0287   F7                     RST   30h   
0288   E3           H_SWAP:   EX   (SP),HL   ; "%"
0289   F7                     RST   30h   
028A                             ; (The checked build tests the address before it takes the value off the
028A                             ; stack, so that an error report shows both.)
028A                H_CSTORE:      ; "." ( c addr -- )
028A                          IF   CHECKED   
                              CALL   chkst   
028A                          ENDIF      
028A   D1                     POP   DE   
028B   73                     LD   (HL),E   
028C   DF           H_DROP:   RST   18h   ; ";" is this one byte
028D                H_STORE:      ; "!" ( n addr -- )
028D                          IF   CHECKED   
                              CALL   chkst   
028D                          ENDIF      
028D   D1                     POP   DE   
028E   73                     LD   (HL),E   
028F   23                     INC   HL   
0290   72                     LD   (HL),D   
0291   DF                     RST   18h   
0292                             ; ---- console ---------------------------------------------------------------
0292                             ; 22h pushes the address of the text after it and skips the string.
0292   E5           H_STR:    PUSH   HL   
0293   60                     LD   H,B   
0294   69                     LD   L,C   
0295   CD 2C 03               CALL   skipstr   
0298                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
0298                          ENDIF      
0298   F7                     RST   30h   
0299                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
0299                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
0299                             ; bit 6, so // and /" give themselves).
0299                          IF   1-CHECKED   
0299   7E           H_PRINT:   LD   A,(HL)   
029A   23                     INC   HL   
029B   FE 22                  CP   22h   
029D   28 0D                  JR   Z,pr9   
029F   FE 2F                  CP   "/"   
02A1   20 04                  JR   NZ,pr1   
02A3   7E                     LD   A,(HL)   
02A4   23                     INC   HL   
02A5   E6 BF                  AND   0BFh   
02A7   EF           PR1:      RST   28h   
02A8   18 EF                  JR   h_print   
02AA                          ENDIF      
02AA                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
02AA                          ENDIF      
02AA   7D           H_EMIT:   LD   A,L   ; "'"
02AB   EF                     RST   28h   
02AC   DF           PR9:      RST   18h   
02AD                             ; "#" prints TOS as a signed decimal number, with no space after it.
02AD   C5           H_NUM:    PUSH   BC   
02AE   CD 58 03               CALL   psgn   
02B1   C1                     POP   BC   
02B2   DF                     RST   18h   
02B3                             ; "?" ( n -- c ) or ( -n -- addr )
02B3                             ;   n > 0: wait about n ms for a key; 0 if none came
02B3                             ;   n = 0: wait for a key
02B3                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02B3                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02B3   CB 7C        H_KEY:    BIT   7,H   
02B5   20 19                  JR   NZ,line   
02B7   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02B9   CD A4 03     KT2:      CALL   getk   
02BC   20 0E                  JR   NZ,kt3   
02BE   1D                     DEC   E   
02BF   20 F8                  JR   NZ,kt2   
02C1   7C                     LD   A,H   ; 0? never counts down: it waits
02C2   B5                     OR   L   
02C3   28 F2                  JR   Z,kt1   
02C5   2B                     DEC   HL   
02C6   7C                     LD   A,H   
02C7   B5                     OR   L   
02C8   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02CA   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02CB   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02CC   6F           KT3:      LD   L,A   
02CD   26 00                  LD   H,0   
02CF   F7                     RST   30h   
02D0                          IF   CPM   
02D0                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02D0                             ; own line editor). It doesn't store the CR, so it is added here.
02D0   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02D3   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02D4   9F                     SBC   A,A   
02D5   A5                     AND   L   ; (0 for a count that is too big)
02D6   EE 7F                  XOR   127   ; A = the count, 127 at most
02D8                          ENDIF      
02D8                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
02D8                          ENDIF      
02D8                          IF   CPM   
02D8   32 7E 06               LD   (LBHDR),A   
02DB   11 7E 06               LD   DE,LBHDR   
02DE   3E 0A                  LD   A,10   
02E0   CD B2 03               CALL   bdosx   
02E3   21 7F 06               LD   HL,LBHDR+1   
02E6   7E                     LD   A,(HL)   ; the count typed (0-127)
02E7   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
02E8   85                     ADD   A,L   ;   adding the count to L can't carry
02E9   6F                     LD   L,A   
02EA   36 0D                  LD   (HL),13   
02EC                          ENDIF      
02EC                          IF   CPM*(1-EDITOR)   
02EC   2E 80                  LD   L,LINEBUF & 0FFh   
02EE   F7                     RST   30h   
02EF                          ENDIF      
02EF                          IF   CPM*EDITOR   
                              RET      
02EF                          ENDIF      
02EF                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
02EF                          ENDIF      
02EF                          IFN   CPM   
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
02EF                          ENDIF      ;   at most
02EF                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
02EF                          ENDIF      
02EF                          IFN   CPM   
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
02EF                          ENDIF      
02EF                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
02EF                          ENDIF      
02EF                          IF   EDGEN   
                              RET      
02EF                          ENDIF      
02EF                             ; =============================================================================
02EF                             ;  More routines (no handler starts past this point)
02EF                             ; =============================================================================
02EF                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
02EF                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
02EF                             ; while the quotient bits arrive at the bottom of C.
02EF                             ; Dividing by 2 is one shift (the spec wants that fast).
02EF   7B           UDIV:     LD   A,E   
02F0   EE 02                  XOR   2   
02F2   B2                     OR   D   
02F3   20 07                  JR   NZ,udv0   
02F5   CB 3C                  SRL   H   
02F7   CB 1D                  RR   L   ; the quotient
02F9   8F                     ADC   A,A   
02FA   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
02FB   C9                     RET      
02FC   7C           UDV0:     LD   A,H   
02FD   4D                     LD   C,L   
02FE   21 00 00               LD   HL,0   
0301   06 10                  LD   B,16   
0303   CB 21        UDV1:     SLA   C   
0305   17                     RLA      
0306   ED 6A                  ADC   HL,HL   
0308   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
030A   30 02                  JR   NC,udv2   ;   always fits in 16 bits
030C   19                     ADD   HL,DE   ; too much: put it back, and cancel the
030D   0D                     DEC   C   ;   INC below
030E   0C           UDV2:     INC   C   ; a quotient bit
030F   10 F2                  DJNZ   udv1   
0311   EB                     EX   DE,HL   ; DE = remainder
0312   67                     LD   H,A   
0313   69                     LD   L,C   ; HL = quotient
0314   C9                     RET      
0315                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0315                             ; non-digit. Values wrap at 16 bits, as the spec says.
0315   21 00 00     RDNUM:    LD   HL,0   
0318   0A           RDN1:     LD   A,(BC)   
0319   D6 30                  SUB   "0"   
031B   FE 0A                  CP   10   
031D   D0                     RET   NC   
031E   03                     INC   BC   
031F   54                     LD   D,H   
0320   5D                     LD   E,L   
0321   29                     ADD   HL,HL   
0322   29                     ADD   HL,HL   
0323   19                     ADD   HL,DE   
0324   29                     ADD   HL,HL   ; HL * 10
0325   5F                     LD   E,A   
0326   16 00                  LD   D,0   
0328   19                     ADD   HL,DE   
0329   18 ED                  JR   rdn1   
032B                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
032B                             ; the next character, so "/"" does not end it. Leaves A = 22h.
032B                          IF   1-CHECKED   
032B   03           SS0:      INC   BC   
032C   0A           SKIPSTR:   LD   A,(BC)   
032D   03                     INC   BC   
032E   FE 2F                  CP   "/"   
0330   28 F9                  JR   Z,ss0   
0332   FE 22                  CP   22h   
0334   20 F6                  JR   NZ,skipstr   
0336   C9                     RET      
0337                          ENDIF      
0337                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0337                          ENDIF      
0337                             ; skip: read past text to the closer at this level, and return A = 0 if it
0337                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0337                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0337                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0337                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0337                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0337                             ; 
0337                             ; The checked build also looks at the character the skip was started by,
0337                             ; which is always the one just before where it starts: "(" must end at ")",
0337                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0337                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0337                             ; place where the skip started, for the report.
0337                SKIP:        
0337                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0337                          ENDIF      
0337   16 00                  LD   D,0   
0339   14           SK3:      INC   D   ; an opener: one deeper
033A   0A           SK1:      LD   A,(BC)   
033B                          IF   1-CHECKED   
033B   03                     INC   BC   
033C   B7                     OR   A   
033D   CA 15 01               JP   Z,endprog   
0340                          ENDIF      
0340                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0340                          ENDIF      
0340   FE 22                  CP   22h   
0342   CC 2C 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0345   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0347   28 F0                  JR   Z,sk3   
0349   3D                     DEC   A   ; ")"
034A   28 08                  JR   Z,sk4   
034C   D6 32                  SUB   "["-")"   
034E   28 E9                  JR   Z,sk3   
0350   FE 02                  CP   "]"-"["   
0352   20 E6                  JR   NZ,sk1   
0354   15           SK4:      DEC   D   
0355                          IF   1-CHECKED   
0355   C8                     RET   Z   ; the closer at this level
0356   18 E2                  JR   sk1   
0358                          ENDIF      
0358                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,endprog   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0358                          ENDIF      
0358                             ; psgn: print HL as a signed number. Uses BC.
0358   CB 7C        PSGN:     BIT   7,H   
035A   28 04                  JR   Z,pdec   
035C   3E 2D                  LD   A,"-"   
035E   EF                     RST   28h   
035F   E7                     RST   20h   
0360                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0360                             ; Uses BC.
0360   11 0A 00     PDEC:     LD   DE,10   
0363   CD EF 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0366   7B                     LD   A,E   
0367   F5                     PUSH   AF   
0368   7C                     LD   A,H   
0369   B5                     OR   L   
036A   C4 60 03               CALL   NZ,pdec   
036D   F1                     POP   AF   
036E   C6 30                  ADD   A,"0"   
0370   EF                     RST   28h   
0371   C9                     RET      
0372                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0372                             ; and return its value in A with the carry set; otherwise leave the IP and
0372                             ; return with the carry clear.
0372   0A           HEXC:     LD   A,(BC)   
0373   D6 30                  SUB   "0"   
0375   FE 0A                  CP   10   
0377   38 09                  JR   C,hc1   
0379   E6 DF                  AND   0DFh   
037B   D6 11                  SUB   11h   
037D   FE 06                  CP   6   
037F   D0                     RET   NC   
0380   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0382   03           HC1:      INC   BC   
0383   C9                     RET      
0384                             ; =============================================================================
0384                             ;  Dispatch table: the low byte of each handler's address, in code order
0384                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0384                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0384                             ; =============================================================================
0384                             ; The handlers of the first NPG1 characters start in the image's second page.
0384                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0384                             ; differs between the builds, so the count is worked out here.
0384                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0384                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0384                PGBRK:    EQU   (h_break-BASE)/256   
0384                PGDEF:    EQU   (h_def-BASE)/256   
0384                PGFET:    EQU   (h_fetch-BASE)/256   
0384                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0384                          IF   1-TABP0   
0384                PTAB:        
0384                          ;*Macro unroll:  PTABLE
0384   8D                     DB   h_store & 0FFh   
0385   92                     DB   h_str & 0FFh   
0386   AD                     DB   h_num & 0FFh   
0387   99                     DB   h_print & 0FFh   
0388   88                     DB   h_swap & 0FFh   
0389   30                     DB   h_and & 0FFh   
038A   AA                     DB   h_emit & 0FFh   
038B   0C                     DB   h_open & 0FFh   
038C   14                     DB   h_close & 0FFh   
038D   51                     DB   h_mul & 0FFh   
038E   27                     DB   h_add & 0FFh   
038F   CB                     DB   h_cfetch & 0FFh   
0390   1F                     DB   h_sub & 0FFh   
0391   8A                     DB   h_cstore & 0FFh   
0392   65                     DB   h_div & 0FFh   
0393   86                     DB   h_dup & 0FFh   
0394   8C                     DB   h_drop & 0FFh   
0395   38                     DB   h_lt & 0FFh   
0396   47                     DB   h_eq & 0FFh   
0397   39                     DB   h_gt & 0FFh   
0398   B3                     DB   h_key & 0FFh   
0399   07                     DB   h_fetch & 0FFh   
039A   EA                     DB   h_def & 0FFh   
039B   DD                     DB   h_break & 0FFh   
039C   D9                     DB   h_ret & 0FFh   
039D   79                     DB   h_xor & 0FFh   
039E   8C                     DB   h_alloc & 0FFh   
039F   C3                     DB   h_grave & 0FFh   
03A0   2C                     DB   h_tor & 0FFh   
03A1   81                     DB   h_or & 0FFh   
03A2   1C                     DB   h_fromr & 0FFh   
03A3   89                     DB   h_not & 0FFh   
03A4                PTABEND:      
03A4                          ENDIF      
03A4                             ; =============================================================================
03A4                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
03A4                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
03A4                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
03A4                             ;  KEY and CONOUT routines themselves.
03A4                             ; =============================================================================
03A4                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
03A4                          ENDIF      
03A4                          IF   CHECKED   
                    GETK:     PUSH   HL   ; a key held back by the break check goes
                              LD   HL,KEYBUF   ;   first, and is taken out of the buffer
                              LD   A,(HL)   
                              LD   (HL),0   
                              POP   HL   
                              OR   A   
                              RET   NZ   
03A4                          ENDIF      
03A4                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
03A4                          ENDIF      
03A4                          IF   CPM*(1-CHECKED)   
03A4                GETK:        
03A4                          ENDIF      
03A4                          IF   CPM   
03A4   3E FF                  LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03A6                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
03A6                             ; printing and could swallow a key that BDOS 6 then never sees.
03A6   D5           PUTC:     PUSH   DE   
03A7   E5                     PUSH   HL   
03A8   5F                     LD   E,A   
03A9   3E 06                  LD   A,6   
03AB   CD B2 03               CALL   bdosx   
03AE   E1                     POP   HL   
03AF   D1                     POP   DE   
03B0   B7                     OR   A   ; (for getk)
03B1   C9                     RET      
03B2                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
03B2   C5           BDOSX:    PUSH   BC   
03B3   D9                     EXX      
03B4   E5                     PUSH   HL   
03B5   D9                     EXX      
03B6   4F                     LD   C,A   
03B7   CD 05 00               CALL   BDOS   
03BA   D9                     EXX      
03BB   E1                     POP   HL   
03BC   D9                     EXX      
03BD   C1                     POP   BC   
03BE   C9                     RET      
03BF                          ENDIF      
03BF                             ; =============================================================================
03BF                             ;  Checked build: the checks and the error report
03BF                             ; =============================================================================
03BF                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,chs1   
03BF                          ENDIF      
03BF                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
03BF                          ENDIF      
03BF                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03BF                          ENDIF      
03BF                          IF   CHECKED   
                    CHS1:     JP   e_store   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
03BF                          ENDIF      
03BF                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03BF                          ENDIF      
03BF                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
03BF                          ENDIF      
03BF                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              JP   e_heap1   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JR   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              POP   HL   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   HL,RSTOP   
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   CALL   getk   
                              RET   Z   
                              CP   3   
                              JR   Z,e_break   
                              LD   (KEYBUF),A   
                              RET      
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside chkbrk)
                              DB   11h   
                    E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
                              DB   11h   
                    E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
03BF                          ENDIF      
03BF                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
03BF                          ENDIF      ;   screen on it)
03BF                          IF   CHECKED   
                              RST   28h   
                              DJNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
                              OR   A   ;   first value and holds nothing)
                              SBC   HL,SP   
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              PUSH   BC   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   BC   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
                                 ; phalf: print half of HL, and leave it in C
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
03BF                          ENDIF      
03BF                             ; =============================================================================
03BF                             ;  The line editor (EDITOR = 1)
03BF                             ; 
03BF                             ;  The interpreter starts here, and a program that ends comes back here. Type
03BF                             ;  a line and press Return:
03BF                             ; 
03BF                             ;    n text    put the text in as line n; the lines from n on move down.
03BF                             ;              A number past the end, or 0, adds the line at the end.
03BF                             ;    n         take line n out
03BF                             ;    0         run the program
03BF                             ;    -n        list the program from line n on (-1 lists all of it). Any key
03BF                             ;              stops the list until another key is pressed; Ctrl-C ends it.
03BF                             ;    anything else is run at once, as B8Script. (Start such a line with a
03BF                             ;    space if it would begin with a digit or a minus sign.)
03BF                             ; 
03BF                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
03BF                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
03BF                             ;  125 characters, the line number and the one character after it included;
03BF                             ;  that character is not stored. The text is kept as it is typed, each line
03BF                             ;  ending in CR LF, at PROG. Nothing is checked.
03BF                             ; 
03BF                             ;  With CPM = 1 the file named on the command line is the program to start
03BF                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
03BF                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
03BF                             ;  CP/M. Nothing is written back: there is no command to save.
03BF                             ; 
03BF                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
03BF                             ;  its report and comes back here, with both stacks empty. The place is a
03BF                             ;  line and column of the program; in a line typed here it is line 0.
03BF                             ; 
03BF                             ;  Things to know:
03BF                             ;    - Reset empties the program (generic builds).
03BF                             ;    - Words and variables last from one line to the next. A word's address
03BF                             ;      points into the program, so run the program again after editing it.
03BF                             ;    - Nothing is printed between a program's output and what is typed next.
03BF                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
03BF                             ;      a line that calls -n? and carries on afterwards runs what was typed.
03BF                             ;      (The stored program never comes back to the line, so it may.)
03BF                             ; =============================================================================
03BF                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
03BF                          ENDIF      
03BF                          IF   EDITOR   
                                 ; -n: list from line n. DE = the number of the line at HL.
                    LIST:     INC   BC   
                              CALL   rdnum   ; HL = n
                              PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,edit   ; the end of the text
                              CALL   getk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,edit   ; Ctrl-C
                    LI2:      CALL   getk   ; any other key: wait for one more
                              JR   Z,li2   
                              CP   3   
                              JR   Z,edit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; Take line n (in HL) out: copy everything after it down over it.
                    DEL:      CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
03BF                          ENDIF      
03BF                          IF   EDITOR*CPM*CHECKED   
                                 ; A key that the break check held back while a program ran is let
                                 ; go: BDOS 10 would not see it, and it would turn up in the next
                                 ; program that asked for a key. (This also serves at the start.)
                              XOR   A   
                              LD   (KEYBUF),A   
03BF                          ENDIF      
03BF                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
03BF                          ENDIF      
03BF                          IF   EDITOR*CPM   
                              LD   A,125   
03BF                          ENDIF      
03BF                          IF   EDITOR   
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   
                              CALL   prl   ; (print the CR LF: a new line)
                              LD   (HL),0   ;   and a NUL after that
                              PUSH   HL   ; the end of what was typed
                              LD   BC,LINEBUF   
                              LD   A,(BC)   
                              CP   "-"   
                              JR   Z,list   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0   ; no number: run the line where it is
                              LD   A,(BC)   
                              SUB   13   
                              JR   NZ,ins   ; text follows the number
                              OR   H   ; the number alone:
                              OR   L   
                              JR   NZ,del   ;   not 0: take that line out
                              LD   BC,PROG   ;   0: run the program
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
                              LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
03BF                          ENDIF      
03BF                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
03BF                          ENDIF      
03BF                          IF   EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; Put the typed text in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              INC   BC   ; step over the one character after the number
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                              JR   edit   
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
03BF                          ENDIF      
03BF                             ; =============================================================================
03BF                             ;  CP/M startup (the generic build starts at address 0: see st0)
03BF                             ; =============================================================================
03BF                          IF   CPM   
03BF                             ; The RAM pages follow the image; the heap may grow to the BDOS.
03BF                START:       
03BF                          ENDIF      
03BF                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
03BF                          ENDIF      
03BF                          IF   CPM   
03BF   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
03C2   11 08 00               LD   DE,0008h   
03C5   01 2C 00               LD   BC,vecend-vecs   
03C8   ED B0                  LDIR      
03CA   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
03CD   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
03CF   CD 05 00               CALL   BDOS   ;   and the program is empty)
03D2   11 00 07               LD   DE,PROG   
03D5   D5           LD1:      PUSH   DE   
03D6   0E 1A                  LD   C,26   ; set the DMA address
03D8   CD 05 00               CALL   BDOS   
03DB   11 5C 00               LD   DE,005Ch   
03DE   0E 14                  LD   C,20   ; read the next 128 bytes
03E0   CD 05 00               CALL   BDOS   
03E3   E1                     POP   HL   ; HL = the address this record went to
03E4   B7                     OR   A   
03E5   20 07                  JR   NZ,ld2   
03E7   11 80 00               LD   DE,128   
03EA   19                     ADD   HL,DE   
03EB   EB                     EX   DE,HL   
03EC   18 E7                  JR   ld1   
03EE                LD2:         
03EE                          ENDIF      
03EE                          IF   CPM*(1-EDITOR)   
03EE   36 00                  LD   (HL),0   ; the end of the file counts as NUL
03F0   23                     INC   HL   ; the heap starts after it
03F1   01 00 07               LD   BC,PROG   ; the IP
03F4   C3 70 01               JP   st2   
03F7                          ENDIF      
03F7                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
03F7                          ENDIF      
03F7                          IF   CPM   
03F7                             ; RAM pages, after the image
03F7                RSPAGE:   EQU   (imgend + 255) / 256   
03F7                DSPAGE:   EQU   RSPAGE + 1   
03F7                LETPAGE:   EQU   RSPAGE + 2   
03F7                PROG:     EQU   LETPAGE*256 + 256   
03F7                          ENDIF      
03F7                IMGEND:      


