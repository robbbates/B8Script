0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three. (asm80 wants the vector number: RST 1 = RST 08h.)
0000                             ; 
0000                             ;    RST 1  08h  rpop    pop the return stack into HL
0000                             ;    RST 3  18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 4  20h  neg16   HL = -HL
0000                             ;    RST 5  28h  putc    print A
0000                             ;    RST 6  30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block has no jumps inside itself, so it works at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                EXIT:     EQU   0000h   ; warm boot
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with ORA A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE and HL.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255;
0000                             ; the wait for a second Ctrl-C uses it too):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                BRKCNT:   EQU   LET+36h   ;   the break check's countdown;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   1-(1-CPM)*CHECKED   
0100   31 FC 08               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103   C3 01 06               JMP   start   ; In the checked generic build this is at 0000h
0106                             ;   (and `start` sets SP): its first byte, C3h,
0106                             ;   is what an undefined word runs into, as
0106                             ;   CP/M's own JMP at 0000h is in a .COM: e_hi.
0106                          IF   (1-CPM)*CHECKED   
                              DB   0,0,0   ; 03  spare
0106                          ENDIF      
0106   CF           RDROP:    RST   1   ; 06  drop the top of the return stack, then
0107   DF                     RST   3   ;     drop TOS (a spent flag) and go on
0108                VECS:        
0108                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
0108   2A 34 09     RPOP:     LHLD   RSP   ; 08
010B   5E                     MOV   E,M   
010C   23                     INX   H   
010D   56                     MOV   D,M   
010E   23                     INX   H   
010F   22 34 09               SHLD   RSP   
0112   EB                     XCHG      
0113   C9                     RET      ; 13  (so RST 2 is not used)
0114   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0115   C3 B7 01               JMP   rpushd   ;     brings up the new TOS
0118                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
0118   D1           RST18:    POP   D   ; 18  discard the RST's return address
0119   E1                     POP   H   ;     new TOS = NOS
011A   C3 34 01               JMP   next0   
011D   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
011E   CF                     RST   1   
011F   F7                     RST   6   
0120                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0120   AF           NEG16:    XRA   A   ; 20
0121   95                     SUB   L   
0122   6F                     MOV   L,A   
0123   9F                     SBB   A   
0124   94                     SUB   H   
0125   67                     MOV   H,A   
0126   C9                     RET      
0127   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
0128                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JMP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 64 04               JMP   putc   ; 28
012B                          ENDIF      
012B                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
012B                             ; returns here, with its top cell on the stack: that becomes the new TOS.
012B   CD 27 01     EXEC:     CALL   jphl   ; 2B
012E   E1                     POP   H   
012F   F7                     RST   6   
0130                             ; ---- RST 6: next character --------------------------------------------------
0130   D1           RST30:    POP   D   ; 30  discard the RST's return address
0131                          IF   CPM   
0131   C3 34 01               JMP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD D2 04               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LDAX   B   
0138   03                     INX   B   
0139   D6 21                  SUI   21h   ; A = c - 21h
013B   DA 7E 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
013E   FE 0F                  CPI   0Fh   
0140   DA 6E 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
0143   D6 0F                  SUI   0Fh   ; A = c - 30h
0145   FE 0A                  CPI   0Ah   
0147   DA 45 03               JC   digit   ; 30h-39h
014A   FE 11                  CPI   11h   
014C   DA 6C 01               JC   p3a   ; 3Ah-40h
014F   D6 11                  SUI   11h   ; A = c - 41h
0151   FE 1A                  CPI   1Ah   
0153   DA AD 01               JC   upper   ; 41h-5Ah: A = letter index 0-25
0156   FE 20                  CPI   20h   
0158   DA 6A 01               JC   p5b   ; 5Bh-60h
015B   FE 3A                  CPI   3Ah   
015D   DA A7 01               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0160   FE 3E                  CPI   3Eh   
0162                          IF   CHECKED   
0162   CA 34 01               JZ   next0   ; 7Fh, DEL: ignored
0165   D2 09 05               JNC   e_hi   ; 80h-FFh: reserved
0168                          ENDIF      
0168                          IF   1-CHECKED   
                              JNC   next0   ; 7Fh-FFh: ignored
0168                          ENDIF      
0168   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
016A   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
016C   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
016E                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
016E                             ; untouched, and A, DE free.
016E   C6 25        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
0170   5F                     MOV   E,A   
0171   16 03                  MVI   D,PTAB / 256   
0173   FE 3B                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0175   1A                     LDAX   D   
0176   5F                     MOV   E,A   ; the handler's low byte
0177                          IFN   CPM   
                              MVI   A,0   
                              RAL      ; its page: 0 + carry
0177                          ENDIF      
0177                          IF   CPM   
0177   3E 01                  MVI   A,1   
0179   CE 00                  ACI   0   ; its page: 1 + carry
017B                          ENDIF      
017B   57                     MOV   D,A   
017C   D5                     PUSH   D   ; jump to it; the stack is balanced again
017D   C9                     RET      ;   when the handler starts
017E                             ; ctl: characters below 21h. A = c - 21h.
017E   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
0180   C2 34 01               JNZ   next0   ; the rest are ignored
0183   C3 00 00     ENDPROG:   JMP   EXIT   ; the program has ended
0186                             ; =============================================================================
0186                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0186                             ;  (00bbIGFuZCA= are up among the RST routines.)
0186                             ; =============================================================================
0186   D1           H_XOR:    POP   D   
0187   7C                     MOV   A,H   
0188   AA                     XRA   D   
0189   67                     MOV   H,A   
018A   7D                     MOV   A,L   
018B   AB                     XRA   E   
018C   6F                     MOV   L,A   
018D   F7                     RST   6   
018E   D1           H_OR:     POP   D   
018F   7C                     MOV   A,H   
0190   B2                     ORA   D   
0191   67                     MOV   H,A   
0192   7D                     MOV   A,L   
0193   B3                     ORA   E   
0194   6F                     MOV   L,A   
0195   F7                     RST   6   
0196   E7           H_NOT:    RST   4   ; ~x = -x - 1
0197   2B                     DCX   H   
0198   F7                     RST   6   
0199                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0199                             ; the same either way); TOS is the old pointer.
0199   EB           H_ALLOC:   XCHG      
019A   2A 7C 09               LHLD   HEAP   
019D   E5                     PUSH   H   
019E   19                     DAD   D   ; the new top
019F                          IF   CHECKED   
019F   CD 72 04               CALL   chkhp   
01A2                          ENDIF      
01A2   22 7C 09               SHLD   HEAP   
01A5   E1                     POP   H   
01A6   F7                     RST   6   
01A7                             ; ---- the letters and digits --------------------------------------------------
01A7                             ; a-z: push the cell's address (the cell is the variable)
01A7   E5           LOWER:    PUSH   H   
01A8   87                     ADD   A   
01A9   6F                     MOV   L,A   
01AA   26 09                  MVI   H,LETPAGE   
01AC   F7                     RST   6   
01AD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01AD                             ; the return stack, and the IP becomes the address in the letter's cell.
01AD   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
01AE   87                     ADD   A   
01AF   6F                     MOV   L,A   
01B0   26 09                  MVI   H,LETPAGE   ; HL -> cell
01B2   50                     MOV   D,B   
01B3   59                     MOV   E,C   ; DE = the return address
01B4   4E                     MOV   C,M   
01B5   23                     INX   H   
01B6   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
01B7                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
01B7                             ; go on. Every push of the return stack ends here: for a word call the cell
01B7                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
01B7                             ; the one that was used up.
01B7                             ; 
01B7                             ; The break key is looked at here, so at every word call and loop-back (and
01B7                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
01B7                             ; the keyboard can be slow (it is a BDOS call under CP/M).
01B7   2A 34 09     RPUSHD:   LHLD   RSP   
01BA   2B                     DCX   H   
01BB   72                     MOV   M,D   
01BC   2B                     DCX   H   
01BD   73                     MOV   M,E   
01BE   22 34 09               SHLD   RSP   
01C1   21 36 09               LXI   H,BRKCNT   
01C4   35                     DCR   M   
01C5   E1                     POP   H   ; (keeps the flags)
01C6   CC 1F 04               CZ   pollk   
01C9   F7                     RST   6   
01CA                             ; ---- machine code: the grave -----------------------------------------------
01CA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01CA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01CA                             ; written and its address is left. An odd last digit is consumed and dropped.
01CA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01CA                             ; code is entered by CALL with the data stack above the return address; it
01CA                             ; must keep BC, and on return the top cell becomes the new TOS.
01CA   CD 0C 04     H_GRAVE:   CALL   hexc   
01CD   D2 2B 01               JNC   exec   
01D0   87           HX1:      ADD   A   
01D1   87                     ADD   A   
01D2   87                     ADD   A   
01D3   87                     ADD   A   
01D4   57                     MOV   D,A   ; the high digit
01D5   CD 0C 04               CALL   hexc   
01D8   D2 E4 01               JNC   hx2   ; odd digit: consumed and dropped
01DB   B2                     ORA   D   
01DC   77                     MOV   M,A   
01DD   23                     INX   H   
01DE   CD 0C 04               CALL   hexc   
01E1   DA D0 01               JC   hx1   
01E4   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
01E6   F7                     RST   6   
01E7                             ; ---- where the two pages meet ----------------------------------------------
01E7                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01E7                             ; are in falling code order for this), and where exactly differs between the
01E7                             ; builds: NPG1 follows. Every handler below these four must start in the
01E7                             ; second page, and every one above in the first; chktab.py checks both.
01E7                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
01E7                             ; while rpop uses HL, and the drop at the end brings it back.
01E7   E5           H_RET:    PUSH   H   
01E8   CF           RET2:     RST   1   
01E9   44                     MOV   B,H   
01EA   4D                     MOV   C,L   
01EB   DF                     RST   3   
01EC                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01EC                             ; drops the block start, "]" returns. No closer at all ends the program.
01EC                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
01EC   7C           H_BREAK:   MOV   A,H   
01ED   B5                     ORA   L   
01EE   CA D9 02               JZ   h_drop   ; false: just drop the flag
01F1   CD B5 03               CALL   skip   
01F4   B7                     ORA   A   ; skip returns 0 for ")"
01F5   C2 E8 01               JNZ   ret2   
01F8   C3 06 01               JMP   rdrop   
01FB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01FB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01FB                             ; the body"s address instead. Either way it then skips to the matching "]'.
01FB                             ; (The unchecked build takes anything that is not a letter as the space; the
01FB                             ; checked build stops on it.)
01FB   0A           H_DEF:    LDAX   B   
01FC   03                     INX   B   
01FD   D6 41                  SUI   "A"   ; a letter gives 0-25 or 32-57: lowercase
01FF   5F                     MOV   E,A   ;   lands 64 bytes up
0200   E6 DF                  ANI   0DFh   ; fold case
0202   FE 1A                  CPI   26   
0204   D2 14 02               JNC   def2   ; not a letter
0207   7B                     MOV   A,E   
0208   87                     ADD   A   
0209   5F                     MOV   E,A   
020A   16 09                  MVI   D,LETPAGE   ; DE -> cell
020C   79                     MOV   A,C   
020D   12                     STAX   D   
020E   1C                     INR   E   
020F   78                     MOV   A,B   
0210   12                     STAX   D   
0211   C3 1D 02               JMP   skipnx   
0214                DEF2:        
0214                          IF   CHECKED   
0214   7B                     MOV   A,E   
0215   FE DF                  CPI   " "-"A"+256   
0217   C2 23 05               JNZ   e_brack   ; anything but a letter or a space
021A                          ENDIF      
021A   E5                     PUSH   H   ; an anonymous block: push its address
021B   60                     MOV   H,B   
021C   69                     MOV   L,C   
021D                SKIPNX:      
021D                          IF   CHECKED   
021D   0B                     DCX   B   ; back onto the letter, so that skip finds its
021E                          ENDIF      ;   opener, the "[", just before where it starts
021E   CD B5 03     SKIPO:    CALL   skip   
0221   F7                     RST   6   
0222   5E           H_FETCH:   MOV   E,M   ; "@"
0223   23                     INX   H   
0224   56                     MOV   D,M   
0225   EB                     XCHG      
0226   F7                     RST   6   
0227                             ; =============================================================================
0227                             ;  Handlers that must start in the image's second page.
0227                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
0227                             ;  tail may run past that page.
0227                             ; =============================================================================
0227                             ; ---- flow control ----------------------------------------------------------
0227                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0227                             ; the matching ")".
0227   7C           H_OPEN:   MOV   A,H   
0228   B5                     ORA   L   
0229   E1                     POP   H   
022A   CA 1E 02               JZ   skipo   
022D   E5                     PUSH   H   ; (rpushd pops it again)
022E   50                     MOV   D,B   
022F   59                     MOV   E,C   ; the block starts at the IP
0230   C3 B7 01               JMP   rpushd   
0233                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0233                             ; drops it and carries on.
0233   7C           H_CLOSE:   MOV   A,H   
0234   B5                     ORA   L   
0235   CA 06 01               JZ   rdrop   
0238   CF                     RST   1   ; pop the block start ...
0239   44                     MOV   B,H   
023A   4D                     MOV   C,L   ; ... jump to it ...
023B   EB                     XCHG      
023C   C3 B7 01               JMP   rpushd   ; ... and push it back (which drops the flag)
023F                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
023F                             ; "-" has two jobs: directly before a digit it starts a negative number.
023F   0A           H_SUB:    LDAX   B   
0240   D6 30                  SUI   "0"   
0242   FE 0A                  CPI   10   
0244   DA 4B 03               JC   negnum   
0247   E7                     RST   4   ; a - b = a + (-b): fall into "+"
0248   D1           H_ADD:    POP   D   
0249   19                     DAD   D   
024A   F7                     RST   6   
024B   D1           H_AND:    POP   D   
024C   7C                     MOV   A,H   
024D   A2                     ANA   D   
024E   67                     MOV   H,A   
024F   7D                     MOV   A,L   
0250   A3                     ANA   E   
0251   6F                     MOV   L,A   
0252   F7                     RST   6   
0253                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0253                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0253                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0253                             ; SBB A turns a carry into -1 or 0 with no branch.
0253   E3           H_GT:     XTHL      ; a > b  is  b < a
0254   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0255   7B                     MOV   A,E   
0256   95                     SUB   L   
0257   7A                     MOV   A,D   
0258   9C                     SBB   H   
0259   9F                     SBB   A   ; A = -1 if DE < HL unsigned
025A   6F                     MOV   L,A   
025B   7C                     MOV   A,H   
025C   AA                     XRA   D   
025D   17                     RAL      ; carry = the signs differ
025E   9F                     SBB   A   
025F   AD                     XRA   L   ; flip when they do
0260   67                     MOV   H,A   
0261   6F                     MOV   L,A   
0262   F7                     RST   6   
0263   D1           H_EQ:     POP   D   
0264   7D                     MOV   A,L   
0265   AB                     XRA   E   
0266   6F                     MOV   L,A   
0267   7C                     MOV   A,H   
0268   AA                     XRA   D   
0269   B5                     ORA   L   ; zero if equal
026A   D6 01                  SUI   1   ; carry only for zero
026C   9F                     SBB   A   
026D   67                     MOV   H,A   
026E   6F                     MOV   L,A   
026F   F7                     RST   6   
0270                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0270                             ; multiplier is used up; only the low 16 bits are kept.
0270   D1           H_MUL:    POP   D   ; DE = multiplicand
0271   C5                     PUSH   B   
0272   44                     MOV   B,H   
0273   4D                     MOV   C,L   ; BC = multiplier
0274   21 00 00               LXI   H,0   
0277   78           MUL1:     MOV   A,B   
0278   B7                     ORA   A   ; clear carry
0279   1F                     RAR      
027A   47                     MOV   B,A   
027B   79                     MOV   A,C   
027C   1F                     RAR      
027D   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
027E   D2 82 02               JNC   mul2   
0281   19                     DAD   D   
0282   EB           MUL2:     XCHG      
0283   29                     DAD   H   ; multiplicand << 1
0284   EB                     XCHG      
0285   78                     MOV   A,B   
0286   B1                     ORA   C   
0287   C2 77 02               JNZ   mul1   
028A   C1                     POP   B   
028B   F7                     RST   6   
028C                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
028C                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
028C                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
028C                             ; stops on it.
028C                H_DIV:       
028C                          IF   CHECKED   
028C   7C                     MOV   A,H   
028D   B5                     ORA   L   
028E   CA 20 05               JZ   e_zero   
0291                          ENDIF      
0291   D1                     POP   D   ; DE = a, HL = b
0292   C5                     PUSH   B   
0293   7A                     MOV   A,D   
0294   B7                     ORA   A   
0295   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0296   AC                     XRA   H   
0297   F5                     PUSH   PSW   ; S flag = sign of q
0298   7C                     MOV   A,H   
0299   B7                     ORA   A   
029A   FC 20 01               CM   neg16   ; HL = |b|
029D   EB                     XCHG      
029E   7C                     MOV   A,H   
029F   B7                     ORA   A   
02A0   FC 20 01               CM   neg16   ; HL = |a|, DE = |b|
02A3   CD 68 03               CALL   udiv   ; HL = q, BC = r
02A6   F1                     POP   PSW   
02A7   FC 20 01               CM   neg16   ; q's sign
02AA   EB                     XCHG      ; DE = q
02AB   60                     MOV   H,B   
02AC   69                     MOV   L,C   ; HL = r
02AD   F1                     POP   PSW   
02AE   FC 20 01               CM   neg16   ; r's sign
02B1   C1                     POP   B   
02B2   D5                     PUSH   D   ; q under r
02B3   F7                     RST   6   
02B4                             ; ---- stack and storage -----------------------------------------------------
02B4   E5           H_DUP:    PUSH   H   ; ":"
02B5   F7                     RST   6   
02B6   E3           H_SWAP:   XTHL      ; "%"
02B7   F7                     RST   6   
02B8                             ; (The checked build tests the address before it takes the value off the
02B8                             ; stack, so that an error report shows both.)
02B8                H_STORE:      ; "!" ( n addr -- )
02B8                          IF   CHECKED   
02B8   CD 92 04               CALL   chkst   
02BB                          ENDIF      
02BB   D1                     POP   D   
02BC   73                     MOV   M,E   
02BD   23                     INX   H   
02BE   72                     MOV   M,D   
02BF   DF                     RST   3   
02C0                H_CSTORE:      ; "." ( c addr -- )
02C0                          IF   CHECKED   
02C0   CD 92 04               CALL   chkst   
02C3                          ENDIF      
02C3   D1                     POP   D   
02C4   73                     MOV   M,E   
02C5   DF                     RST   3   
02C6                             ; ---- console ---------------------------------------------------------------
02C6                             ; 22h pushes the address of the text after it and skips the string.
02C6   E5           H_STR:    PUSH   H   
02C7   60                     MOV   H,B   
02C8   69                     MOV   L,C   
02C9   CD F9 03               CALL   skipstr   
02CC                          IF   CHECKED   
02CC   B7                     ORA   A   ; 0: the text ran out before the closing quote
02CD   CA 18 05               JZ   e_quote   
02D0                          ENDIF      
02D0   F7                     RST   6   
02D1                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02D1                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02D1                             ; bit 6, so // and /" give themselves).
02D1                          IF   1-CHECKED   
                    H_PRINT:   MOV   A,M   
                              INX   H   
                              CPI   22h   
                              JZ   h_drop   
                              CPI   "/"   
                              JNZ   pr1   
                              MOV   A,M   
                              INX   H   
                              ANI   0BFh   
                    PR1:      RST   5   
                              JMP   h_print   
02D1                          ENDIF      
02D1                          IF   CHECKED   
02D1                             ; (The checked build has the loop as a routine, prstr, which the error
02D1                             ; report uses too. The address is kept on the stack meanwhile: a report
02D1                             ; shows the stack as it was before the "$".)
02D1   E5           H_PRINT:   PUSH   H   
02D2   CD A9 04               CALL   prstr   
02D5   D1                     POP   D   
02D6   DF                     RST   3   
02D7                          ENDIF      
02D7   7D           H_EMIT:   MOV   A,L   ; "'"
02D8   EF                     RST   5   
02D9   DF           H_DROP:   RST   3   ; ";" is this one byte
02DA                             ; "#" prints TOS as a signed decimal number, with no space after it.
02DA   C5           H_NUM:    PUSH   B   
02DB   CD 9A 03               CALL   psgn   
02DE   C1                     POP   B   
02DF   DF                     RST   3   
02E0                          IF   CHECKED   ; (the checked build has no room to start ","
02E0   6E           H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
02E1   26 00                  MVI   H,0   ;   the end of "?")
02E3   F7                     RST   6   
02E4                          ENDIF      
02E4                             ; "?" ( n -- c ) or ( -n -- addr )
02E4                             ;   n > 0: wait about n ms for a key; 0 if none came
02E4                             ;   n = 0: wait for a key
02E4                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02E4                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02E4   7C           H_KEY:    MOV   A,H   
02E5   B7                     ORA   A   
02E6   FA 04 03               JM   line   
02E9   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
02EB   CD 51 04     KT2:      CALL   getk   
02EE   C2 00 03               JNZ   kt3   
02F1   1D                     DCR   E   
02F2   C2 EB 02               JNZ   kt2   
02F5   7C                     MOV   A,H   ; 0? never counts down: it waits
02F6   B5                     ORA   L   
02F7   CA E9 02               JZ   kt1   
02FA   2B                     DCX   H   
02FB   7C                     MOV   A,H   
02FC   B5                     ORA   L   
02FD   C2 E9 02               JNZ   kt1   ; A = 0 if the time ran out
0300                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
0300                          ENDIF      
0300   6F           KT3:      MOV   L,A   
0301   26 00                  MVI   H,0   
0303   F7                     RST   6   
0304                          IF   CPM   
0304                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
0304                             ; own line editor). It doesn't store the CR, so it is added here.
0304   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
0307   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
0308   9F                     SBB   A   
0309   A5                     ANA   L   ; (0 for a count that is too big)
030A   EE 7F                  XRI   127   ; A = the count, 127 at most
030C   32 7E 09               STA   LBHDR   
030F   C5                     PUSH   B   
0310   11 7E 09               LXI   D,LBHDR   
0313   0E 0A                  MVI   C,10   
0315   CD 05 00               CALL   BDOS   
0318   C1                     POP   B   
0319   21 7F 09               LXI   H,LBHDR+1   
031C   7E                     MOV   A,M   ; the count typed (0-127)
031D   2C                     INR   L   ; HL = LINEBUF, whose low byte is 80h:
031E   85                     ADD   L   ;   adding the count to L can't carry
031F   6F                     MOV   L,A   
0320   36 0D                  MVI   M,13   
0322   2E 80                  MVI   L,LINEBUF & 0FFh   
0324   F7                     RST   6   
0325                          ENDIF      
0325                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
                              DAD   D   ;   only for 1 to 127, and leaves 127 - count
                              SBB   A   
                              ANA   L   ; (0 for a count that is too big)
                              CMA      
                              MOV   D,A   ; D = the L of a full line: 80h + count, FFh
                                 ;   at most
                              LXI   H,LINEBUF   
                    LN2:      CALL   getk   
                              JZ   ln2   
                              CPI   13   
                              JZ   ln5   
                              CPI   8   
                              JZ   ln4   
                              MOV   E,A   
                              MOV   A,L   
                              CMP   D   
                              JZ   ln2   ; full
                              MOV   M,E   
                              INR   L   
                              MOV   A,E   
                    LN3:      RST   5   
                              JMP   ln2   
                    LN4:      DCR   L   ; Backspace: one back, and echo it,
                              JM   ln3   ;   unless the line was empty (L left the
                              INR   L   ;   upper half of the page)
                              JMP   ln2   
                    LN5:      MOV   M,A   ; the CR
                              MVI   L,LINEBUF & 0FFh   
                              RST   6   
0325                          ENDIF      
0325                             ; =============================================================================
0325                             ;  Dispatch table: the low byte of each handler's address, in code order.
0325                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0325                             ; =============================================================================
0325                             ; The handlers of the first NPG1 characters start in the image's second page.
0325                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0325                             ; differs between the builds, so the count is worked out here.
0325                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0325                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0325                PGBRK:    EQU   (h_break-BASE)/256   
0325                PGDEF:    EQU   (h_def-BASE)/256   
0325                PGFET:    EQU   (h_fetch-BASE)/256   
0325                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0325   B8           PTAB:     DB   h_store & 0FFh   ; !
0326   C6                     DB   h_str & 0FFh   ; "
0327   DA                     DB   h_num & 0FFh   ; #
0328   D1                     DB   h_print & 0FFh   ; $
0329   B6                     DB   h_swap & 0FFh   ; %
032A   4B                     DB   h_and & 0FFh   ; &
032B   D7                     DB   h_emit & 0FFh   ; '
032C   27                     DB   h_open & 0FFh   ; (
032D   33                     DB   h_close & 0FFh   ; )
032E   70                     DB   h_mul & 0FFh   ; *
032F   48                     DB   h_add & 0FFh   ; +
0330   E0                     DB   h_cfetch & 0FFh   ; ,
0331   3F                     DB   h_sub & 0FFh   ; -
0332   C0                     DB   h_cstore & 0FFh   ; .
0333   8C                     DB   h_div & 0FFh   ; /
0334   B4                     DB   h_dup & 0FFh   ; :
0335   D9                     DB   h_drop & 0FFh   ; ;
0336   54                     DB   h_lt & 0FFh   ; <
0337   63                     DB   h_eq & 0FFh   ; =
0338   53                     DB   h_gt & 0FFh   ; >
0339   E4                     DB   h_key & 0FFh   ; ?
033A   22                     DB   h_fetch & 0FFh   ; @
033B   FB                     DB   h_def & 0FFh   ; [
033C   EC                     DB   h_break & 0FFh   ; \
033D   E7                     DB   h_ret & 0FFh   ; ]
033E   86                     DB   h_xor & 0FFh   ; ^
033F   99                     DB   h_alloc & 0FFh   ; _
0340   CA                     DB   h_grave & 0FFh   ; `
0341   14                     DB   h_tor & 0FFh   ; {
0342   8E                     DB   h_or & 0FFh   ; |
0343   1D                     DB   h_fromr & 0FFh   ; }
0344   96                     DB   h_not & 0FFh   ; ~
0345                PTABEND:      
0345                             ; =============================================================================
0345                             ;  Routines (no handler starts past this point)
0345                             ; =============================================================================
0345                             ; Digits: step back onto the first digit and read the whole number.
0345   E5           DIGIT:    PUSH   H   
0346   0B                     DCX   B   
0347   CD 51 03               CALL   rdnum   
034A   F7                     RST   6   
034B                             ; negnum: "-" directly before a digit: read the number, negate it.
034B   E5           NEGNUM:   PUSH   H   
034C   CD 51 03               CALL   rdnum   
034F   E7                     RST   4   
0350   F7                     RST   6   
0351                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0351                             ; non-digit. Values wrap at 16 bits, as the spec says.
0351   21 00 00     RDNUM:    LXI   H,0   
0354   0A           RDN1:     LDAX   B   
0355   D6 30                  SUI   "0"   
0357   FE 0A                  CPI   10   
0359   D0                     RNC      
035A   03                     INX   B   
035B   54                     MOV   D,H   
035C   5D                     MOV   E,L   
035D   29                     DAD   H   
035E   29                     DAD   H   
035F   19                     DAD   D   
0360   29                     DAD   H   ; HL * 10
0361   5F                     MOV   E,A   
0362   16 00                  MVI   D,0   
0364   19                     DAD   D   
0365   C3 54 03               JMP   rdn1   
0368                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0368                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0368                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0368                             ; lives on the stack, since A is busy with the shifts.
0368                             ; Dividing by 2 is one shift (the spec wants that fast).
0368   01 00 00     UDIV:     LXI   B,0   
036B   7B                     MOV   A,E   
036C   EE 02                  XRI   2   
036E   B2                     ORA   D   
036F   C2 7C 03               JNZ   udv0   
0372   B4                     ORA   H   ; A was 0, and the carry is clear
0373   1F                     RAR      
0374   67                     MOV   H,A   
0375   7D                     MOV   A,L   
0376   1F                     RAR      
0377   6F                     MOV   L,A   ; the quotient
0378   78                     MOV   A,B   
0379   17                     RAL      
037A   4F                     MOV   C,A   ; the remainder: the bit that fell out
037B   C9                     RET      
037C   3E 10        UDV0:     MVI   A,16   
037E   F5                     PUSH   PSW   
037F   29           UDV1:     DAD   H   ; next dividend bit into the carry
0380   79                     MOV   A,C   
0381   17                     RAL      
0382   4F                     MOV   C,A   
0383   78                     MOV   A,B   
0384   17                     RAL      
0385   47                     MOV   B,A   ; BC = BC*2 + bit
0386   79                     MOV   A,C   
0387   93                     SUB   E   
0388   78                     MOV   A,B   
0389   9A                     SBB   D   ; carry if BC < DE
038A   DA 92 03               JC   udv2   
038D   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
038E   79                     MOV   A,C   
038F   93                     SUB   E   
0390   4F                     MOV   C,A   
0391   2C                     INR   L   ; quotient bit
0392   F1           UDV2:     POP   PSW   
0393   3D                     DCR   A   
0394   F5                     PUSH   PSW   
0395   C2 7F 03               JNZ   udv1   
0398   F1                     POP   PSW   
0399   C9                     RET      
039A                             ; psgn: print HL as a signed number. Uses BC.
039A   7C           PSGN:     MOV   A,H   
039B   B7                     ORA   A   
039C   F2 A3 03               JP   pdec   
039F   3E 2D                  MVI   A,"-"   
03A1   EF                     RST   5   
03A2   E7                     RST   4   
03A3                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03A3                             ; Uses BC.
03A3   11 0A 00     PDEC:     LXI   D,10   
03A6   CD 68 03               CALL   udiv   ; HL = HL / 10, C = the last digit
03A9   79                     MOV   A,C   
03AA   F5                     PUSH   PSW   
03AB   7C                     MOV   A,H   
03AC   B5                     ORA   L   
03AD   C4 A3 03               CNZ   pdec   
03B0   F1                     POP   PSW   
03B1   C6 30                  ADI   "0"   
03B3   EF                     RST   5   
03B4   C9                     RET      
03B5                             ; skip: read past text to the closer at this level, and return A = 0 if it
03B5                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03B5                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03B5                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03B5                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03B5                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
03B5                             ; 
03B5                             ; The checked build also looks at the character the skip was started by,
03B5                             ; which is always the one just before where it starts: "(" must end at ")",
03B5                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03B5                             ; quote counts as running into it. "\" takes either closer. The place where
03B5                             ; the skip started is kept on the stack, for the report.
03B5                SKIP:        
03B5                          IF   CHECKED   
03B5   C5                     PUSH   B   
03B6   0B                     DCX   B   
03B7   0A                     LDAX   B   
03B8   03                     INX   B   
03B9   5F                     MOV   E,A   ; E = the opener: ( [ or \
03BA                          ENDIF      
03BA   16 00                  MVI   D,0   
03BC   14           SK3:      INR   D   ; an opener: one deeper
03BD   0A           SK1:      LDAX   B   
03BE                          IF   1-CHECKED   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
03BE                          ENDIF      
03BE                          IF   CHECKED   
03BE   B7                     ORA   A   
03BF   CA ED 03               JZ   sk6   ; (the IP stays on the NUL)
03C2   03                     INX   B   
03C3                          ENDIF      
03C3   FE 22                  CPI   22h   
03C5   CC F9 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
03C8   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
03CA   CA BC 03               JZ   sk3   
03CD   3D                     DCR   A   ; ")"
03CE   CA DB 03               JZ   sk4   
03D1   D6 32                  SUI   "["-")"   
03D3   CA BC 03               JZ   sk3   
03D6   FE 02                  CPI   "]"-"["   
03D8   C2 BD 03               JNZ   sk1   
03DB   15           SK4:      DCR   D   
03DC                          IF   1-CHECKED   
                              RZ      ; the closer at this level
                              JMP   sk1   
03DC                          ENDIF      
03DC                          IF   CHECKED   
03DC   C2 BD 03               JNZ   sk1   
03DF   57                     MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
03E0   AB                     XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
03E1   E6 06                  ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
03E3   FE 02                  CPI   2   ;   closer, and only then
03E5   7A                     MOV   A,D   
03E6   D1                     POP   D   ; (where the skip started)
03E7   C0                     RNZ      
03E8   42                     MOV   B,D   ; N. The place is the opener
03E9   4B                     MOV   C,E   
03EA   C3 F4 03               JMP   sk7   
03ED   7B           SK6:      MOV   A,E   ; the text ran out:
03EE   E6 04                  ANI   4   
03F0   C2 83 01               JNZ   endprog   ;   "\" with no closer ends the program
03F3   C1                     POP   B   
03F4   3E 4E        SK7:      MVI   A,"N"   
03F6   C3 26 05               JMP   errp   ; (errp drops skip's return address)
03F9                          ENDIF      
03F9                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03F9                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03F9                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
03F9                          ENDIF      
03F9                          IF   CHECKED   
03F9                             ; The checked build never steps over a NUL: if the text runs out first it
03F9                             ; returns A = 0 with the IP on the NUL.
03F9   0A           SKIPSTR:   LDAX   B   
03FA   B7                     ORA   A   
03FB   C8                     RZ      
03FC   03                     INX   B   
03FD   FE 22                  CPI   22h   
03FF   C8                     RZ      
0400   FE 2F                  CPI   "/"   
0402   C2 F9 03               JNZ   skipstr   
0405   0A                     LDAX   B   ; the escaped character
0406   B7                     ORA   A   
0407   C8                     RZ      
0408   03                     INX   B   
0409   C3 F9 03               JMP   skipstr   
040C                          ENDIF      
040C                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
040C                             ; and return its value in A with the carry set; otherwise leave the IP and
040C                             ; return with the carry clear.
040C   0A           HEXC:     LDAX   B   
040D   D6 30                  SUI   "0"   
040F   FE 0A                  CPI   10   
0411   DA 1D 04               JC   hc1   
0414   E6 DF                  ANI   0DFh   
0416   D6 11                  SUI   11h   
0418   FE 06                  CPI   6   
041A   D0                     RNC      
041B   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
041D   03           HC1:      INX   B   
041E   C9                     RET      
041F                             ; =============================================================================
041F                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
041F                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
041F                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
041F                             ;  the host's KEY and CONOUT routines themselves.
041F                             ; 
041F                             ;  A running program reads the keyboard only through getk and pollk, which
041F                             ;  between them give the break key its rules:
041F                             ;    - Ctrl-C stops the program;
041F                             ;    - any other key that the break check reads is held in KEYBUF for the
041F                             ;      next "?", and a newer one takes its place;
041F                             ;    - "?" (getk) takes the held key first;
041F                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
041F                             ;      key like any other, but two of them within about 250 ms still stop it.
041F                             ;  Both are called straight from a handler, never from a routine under one:
041F                             ;  the checked build's report counts on finding one return address above the
041F                             ;  data stack, and TOS in HL.
041F                             ; =============================================================================
041F                          IFN   CPM   
                    RAWK:     EQU   KEY   
041F                          ENDIF      
041F                             ; pollk: the break check (see rpushd).
041F   CD 62 04     POLLK:    CALL   rawk   
0422   C8                     RZ      ; no key
0423   32 7A 09               STA   KEYBUF   ; held for the next "?"
0426   FE 03        PK1:      CPI   3   ; (getk joins here)
0428   C0                     RNZ      
0429                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0429                             ; the program has turned it off, wait about 250 ms for one more key: a
0429                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0429                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0429   3A 7B 09     CTLC:     LDA   BRKOFF   
042C   B7                     ORA   A   
042D   CA A4 04               JZ   brk   
0430   D5                     PUSH   D   
0431   11 10 27               LXI   D,250*MSLOOP   
0434   CD 62 04     CT1:      CALL   rawk   
0437   C2 40 04               JNZ   ct2   
043A   1B                     DCX   D   
043B   7A                     MOV   A,D   
043C   B3                     ORA   E   
043D   C2 34 04               JNZ   ct1   
0440   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
0441   FE 03                  CPI   3   
0443   CA A4 04               JZ   brk   
0446   B7                     ORA   A   
0447   CA 4D 04               JZ   ct3   
044A   32 7A 09               STA   KEYBUF   
044D   3E 03        CT3:      MVI   A,3   
044F   B7                     ORA   A   
0450   C9                     RET      
0451                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0451   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
0452   21 7A 09               LXI   H,KEYBUF   ;   the buffer
0455   7E                     MOV   A,M   
0456   36 00                  MVI   M,0   
0458   E1                     POP   H   
0459   B7                     ORA   A   
045A   C0                     RNZ      
045B   CD 62 04               CALL   rawk   
045E   C8                     RZ      
045F   C3 26 04               JMP   pk1   ; Ctrl-C? If not, that is the key
0462                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
0462                          ENDIF      
0462                          IF   CHECKED   
0462                BRK:      EQU   e_break   ;   the checked build reports B
0462                          ENDIF      
0462                          IF   CPM   
0462   3E FF        RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0464                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0464                             ; printing and could swallow a key that BDOS 6 then never sees.
0464   C5           PUTC:     PUSH   B   
0465   D5                     PUSH   D   
0466   E5                     PUSH   H   
0467   5F                     MOV   E,A   
0468   0E 06                  MVI   C,6   
046A   CD 05 00               CALL   BDOS   
046D   E1                     POP   H   
046E   D1                     POP   D   
046F   C1                     POP   B   
0470   B7                     ORA   A   ; (for getk)
0471   C9                     RET      
0472                          ENDIF      
0472                             ; =============================================================================
0472                             ;  Checked build: the checks and the error report
0472                             ; =============================================================================
0472                          IF   CHECKED   
0472                             ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
0472                             ; it, and the old top is on the stack under the return address. Stop if the
0472                             ; new top is not below the limit page, or is below the program's end.
0472                CHKHP:       
0472                          ENDIF      
0472                          IF   CHECKED*CPM   
0472                             ; With this much room a top that wrapped round can land back in
0472                             ; range, so the add is tested too: growing must not carry, and
0472                             ; releasing must.
0472   7A                     MOV   A,D   
0473   1F                     RAR      ; the carry comes in above the count's sign:
0474   C6 40                  ADI   40h   ;   bit 7 = carry XOR sign
0476   87                     ADD   A   
0477   DA 8B 04               JC   e_heap   
047A   3A 07 00               LDA   0007h   
047D   3D                     DCR   A   
047E   BC                     CMP   H   
047F   DA 8B 04               JC   e_heap   
0482                          ENDIF      
0482                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
0482                          ENDIF      
0482                          IF   CHECKED   
0482   EB                     XCHG      
0483   E5                     PUSH   H   ; the count
0484   2A 38 09               LHLD   NPEND   
0487   19                     DAD   D   ; carry: at or above the program's end
0488   E1                     POP   H   
0489   EB                     XCHG      
048A   D8                     RC      
048B   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
048C   D1                     POP   D   ;   and drop the return address (errp drops
048D   3E 48                  MVI   A,"H"   ;   the old top)
048F   C3 26 05               JMP   errp   
0492                             ; chkst: stop unless HL is in the program's own space: from the letter page
0492                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0492                             ; whatever lies above the limit are safe. Memory above the heap top but
0492                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0492                             ; It is the page of HL + 1 that is tested, so that one test serves both
0492                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0492                             ; Keeps HL and BC. It runs on into its own error entry.
0492   23           CHKST:    INX   H   
0493   7C                     MOV   A,H   
0494   2B                     DCX   H   
0495   FE 09                  CPI   LETPAGE   
0497   DA A1 04               JC   e_store   
049A                          ENDIF      
049A                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
049A                          ENDIF      
049A                          IF   CHECKED*CPM   
049A   5F                     MOV   E,A   
049B   3A 07 00               LDA   0007h   ; the BDOS page is the heap limit
049E   3D                     DCR   A   
049F   BB                     CMP   E   
04A0   D0                     RNC      
04A1                          ENDIF      
04A1                          IF   CHECKED   
04A1                             ; Two error entries for errors found inside a routine: the first hides the
04A1                             ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
04A1                             ; return address.
04A1   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
04A3   11                     DB   11h   
04A4   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
04A6   C3 26 05               JMP   errp   
04A9                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
04A9                             ; "$", and the error report's texts). A NUL first is an error: Q.
04A9   7E           PRSTR:    MOV   A,M   
04AA   23                     INX   H   
04AB   FE 22                  CPI   22h   
04AD   C8                     RZ      
04AE   B7                     ORA   A   
04AF   CA BF 04               JZ   e_dollar   
04B2   FE 2F                  CPI   "/"   
04B4   C2 BB 04               JNZ   prs1   
04B7   7E                     MOV   A,M   
04B8   23                     INX   H   
04B9   E6 BF                  ANI   0BFh   
04BB   EF           PRS1:     RST   5   
04BC   C3 A9 04               JMP   prstr   
04BF   D1           E_DOLLAR:   POP   D   ; "$" ran into a NUL: drop the return address,
04C0   E1                     POP   H   ;   and put the string's address back in TOS
04C1   3E 51                  MVI   A,"Q"   
04C3   C3 27 05               JMP   error   
04C6                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
04C6                             ; pnl: the same, on a new line.
04C6   3E 0D        PNL:      MVI   A,13   
04C8   EF                     RST   5   
04C9   3E 0A                  MVI   A,10   
04CB   EF                     RST   5   
04CC   E3           PMSG:     XTHL      
04CD   CD A9 04               CALL   prstr   
04D0   E3                     XTHL      
04D1   C9                     RET      
04D2                             ; chkstk: both stacks are checked once per character, not in every handler.
04D2                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
04D2                             ; the constant carries if it is above (cells were popped that were never
04D2                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
04D2                             ; a character late at most: the bytes above DSTOP and the guard band below
04D2                             ; the page take what happens meanwhile.
04D2   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
04D3   21 05 F7               LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
04D6   39                     DAD   SP   
04D7   DA 01 05               JC   e_under   
04DA   24                     INR   H   
04DB   C2 FB 04               JNZ   e_over   
04DE   2A 34 09               LHLD   RSP   ; the return stack: in its page (or it has
04E1   7C                     MOV   A,H   ;   overflowed), and not above its empty
04E2   FE 07                  CPI   RSPAGE   ;   position (an underflow stays inside the
04E4   C2 F8 04               JNZ   e_rover   ;   page, in the guard band)
04E7   7D                     MOV   A,L   
04E8   FE E1                  CPI   RSTOP&0FFh+1   
04EA   D2 EF 04               JNC   e_runder   
04ED   EB                     XCHG      ; TOS back
04EE   C9                     RET      
04EF   21 E0 07     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
04F2   22 34 09               SHLD   RSP   
04F5   3E 72                  MVI   A,"r"   
04F7   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
04F8   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
04FA   21                     DB   21h   
04FB   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
04FD   EB                     XCHG      ; TOS back
04FE   C3 26 05               JMP   errp   
0501   31 FC 08     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
0504   3E 73                  MVI   A,"s"   
0506   C3 27 05               JMP   error   
0509                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0509                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
0509                             ; every build: if the IP is in page zero, this was a call of an undefined
0509                             ; word. The call is undone, so the place is the call itself.
0509   04           E_HI:     INR   B   
050A   05                     DCR   B   
050B   C2 1D 05               JNZ   e_resv   
050E   E5                     PUSH   H   
050F   CF                     RST   1   
0510   44                     MOV   B,H   
0511   4D                     MOV   C,L   
0512   E1                     POP   H   
0513   3E 55                  MVI   A,"U"   
0515   C3 27 05               JMP   error   
0518                             ; Error entries. Each loads its letter and then hides the next entry inside
0518                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
0518   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
0519   4D                     MOV   C,L   ;   past the opening quote, which is the place
051A   3E 51                  MVI   A,"Q"   
051C   11                     DB   11h   
051D   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
051F   11                     DB   11h   
0520   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
0522   11                     DB   11h   
0523   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
0525   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
0526                             ; errp: an error found inside a routine: drop its return address first.
0526   D1           ERRP:     POP   D   
0527                             ; error: the report, then the end. A = the letter, BC = one past the place,
0527                             ; HL = TOS, and both stacks as the report is to show them:
0527                             ; 
0527                             ;   Err X @ line,col
0527                             ;   up to 16 characters of the text from the place
0527                             ;   Stk n: the top 8 cells at most, bottom to top
0527                             ;   Rtn n
0527   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
0528   5F                     MOV   E,A   
0529   CD C6 04               CALL   pnl   
052C   45 72 72 20 22         DB   "Err ",22h   
0531   7B                     MOV   A,E   
0532   EF                     RST   5   
0533   CD CC 04               CALL   pmsg   
0536   20 40 20 22            DB   " @ ",22h   
053A   0B                     DCX   B   ; BC = the place
053B                             ; The line and column. A place below the program is in the line
053B                             ; buffer: line 0. Otherwise count the LFs from the program's start;
053B                             ; DE = the line's number, HL = where it starts.
053B   21 80 09               LXI   H,LINEBUF   
053E   11 00 00               LXI   D,0   
0541   78                     MOV   A,B   
0542   FE 0A                  CPI   PROG/256   
0544   DA 5E 05               JC   er3   
0547   24                     INR   H   
0548   6B                     MOV   L,E   ; HL = PROG
0549   13           ER1:      INX   D   ; a new line starts at HL
054A   E5                     PUSH   H   
054B   7D           ER2:      MOV   A,L   
054C   91                     SUB   C   
054D   7C                     MOV   A,H   
054E   98                     SBB   B   
054F   D2 5D 05               JNC   er2x   ; reached the place
0552   7E                     MOV   A,M   
0553   23                     INX   H   
0554   FE 0A                  CPI   10   
0556   C2 4B 05               JNZ   er2   
0559   F1                     POP   PSW   
055A   C3 49 05               JMP   er1   
055D   E1           ER2X:     POP   H   
055E   C5           ER3:      PUSH   B   
055F   E5                     PUSH   H   
0560   EB                     XCHG      
0561   CD A3 03               CALL   pdec   ; the line
0564   3E 2C                  MVI   A,","   
0566   EF                     RST   5   
0567   D1                     POP   D   
0568   E1                     POP   H   
0569   E5                     PUSH   H   
056A   CD FA 05               CALL   sub16   
056D   23                     INX   H   
056E   CD A3 03               CALL   pdec   ; the column
0571   CD C6 04               CALL   pnl   
0574   22                     DB   22h   
0575   E1                     POP   H   ; the text, as it is: 16 characters, or fewer
0576   06 10                  MVI   B,16   ;   if the line or the program ends first
0578   7E           ER4:      MOV   A,M   
0579   23                     INX   H   
057A   B7                     ORA   A   
057B   CA 92 05               JZ   er5   
057E   FE 0D                  CPI   13   
0580   CA 92 05               JZ   er5   
0583   FE 0A                  CPI   10   
0585   CA 92 05               JZ   er5   
0588                          ENDIF      
0588                          IF   CHECKED*CPM   
0588   FE 1A                  CPI   1Ah   ; (the ^Z that pads a file's last record ends
058A   CA 92 05               JZ   er5   ;   the text too: some terminals clear the
058D                          ENDIF      ;   screen on it)
058D                          IF   CHECKED   
058D   EF                     RST   5   
058E   05                     DCR   B   
058F   C2 78 05               JNZ   er4   
0592   CD C6 04     ER5:      CALL   pnl   
0595   53 74 6B 20 22         DB   "Stk ",22h   
059A   21 06 F7               LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
059D   39                     DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
059E   E7                     RST   4   ;   first value and holds nothing)
059F   7C                     MOV   A,H   
05A0   CD EE 05               CALL   phal2   ; the depth
05A3   3E 3A                  MVI   A,":"   
05A5   EF                     RST   5   
05A6   79                     MOV   A,C   
05A7   FE 09                  CPI   9   
05A9   DA B6 05               JC   er6   
05AC   CD CC 04               CALL   pmsg   
05AF   20 2E 2E 2E 22         DB   " ...",22h   
05B4   0E 08                  MVI   C,8   
05B6   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
05B8   69                     MOV   L,C   
05B9   29                     DAD   H   
05BA   39                     DAD   SP   ; HL -> just above the deepest of them
05BB   0C                     INR   C   
05BC   0D           ER7:      DCR   C   
05BD   CA D2 05               JZ   er8   
05C0   2B                     DCX   H   
05C1   56                     MOV   D,M   
05C2   2B                     DCX   H   
05C3   5E                     MOV   E,M   
05C4   E5                     PUSH   H   
05C5   C5                     PUSH   B   
05C6   3E 20                  MVI   A," "   
05C8   EF                     RST   5   
05C9   EB                     XCHG      
05CA   CD 9A 03               CALL   psgn   
05CD   C1                     POP   B   
05CE   E1                     POP   H   
05CF   C3 BC 05               JMP   er7   
05D2   CD C6 04     ER8:      CALL   pnl   
05D5   52 74 6E 20 22         DB   "Rtn ",22h   
05DA   2A 34 09               LHLD   RSP   
05DD   EB                     XCHG      
05DE   21 E0 07               LXI   H,RSTOP   
05E1   CD EB 05               CALL   phalf   
05E4   CD C6 04               CALL   pnl   
05E7   22                     DB   22h   
05E8   C3 83 01               JMP   endprog   
05EB                             ; phalf: print half of HL - DE, and leave it in BC
05EB   CD FA 05     PHALF:    CALL   sub16   
05EE   B7           PHAL2:    ORA   A   ; (A = H; this clears the carry)
05EF   1F                     RAR      
05F0   67                     MOV   H,A   
05F1   7D                     MOV   A,L   
05F2   1F                     RAR      
05F3   6F                     MOV   L,A   
05F4   E5                     PUSH   H   
05F5   CD A3 03               CALL   pdec   
05F8   C1                     POP   B   
05F9   C9                     RET      
05FA                             ; sub16: HL = HL - DE. Leaves A = H.
05FA   7D           SUB16:    MOV   A,L   
05FB   93                     SUB   E   
05FC   6F                     MOV   L,A   
05FD   7C                     MOV   A,H   
05FE   9A                     SBB   D   
05FF   67                     MOV   H,A   
0600   C9                     RET      
0601                          ENDIF      
0601                             ; =============================================================================
0601                             ;  Startup
0601                             ; =============================================================================
0601                START:       
0601                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
0601                          ENDIF      
0601                          IF   CHECKED   
0601                             ; Clear the lower half of the letter page: every variable starts at
0601                             ; 0, every word cell holds 0000h, the address an undefined word is
0601                             ; caught at (see e_hi), and no key is held back.
0601   21 00 09               LXI   H,LET   
0604   AF                     XRA   A   
0605   77           INI1:     MOV   M,A   
0606   2C                     INR   L   
0607   F2 05 06               JP   ini1   ; +00h to +7Fh
060A                          ENDIF      
060A                          IF   CPM   
060A                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
060A   21 08 01               LXI   H,vecs   ; the RST routines go down into page zero
060D   11 08 00               LXI   D,0008h   
0610   06 2C                  MVI   B,vecend-vecs   
0612   7E           CPY:      MOV   A,M   
0613   12                     STAX   D   
0614   23                     INX   H   
0615   13                     INX   D   
0616   05                     DCR   B   
0617   C2 12 06               JNZ   cpy   
061A   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
061D   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
061F   CD 05 00               CALL   BDOS   ;   and the program is empty)
0622   11 00 0A               LXI   D,PROG   
0625   D5           LD1:      PUSH   D   
0626   0E 1A                  MVI   C,26   ; set the DMA address
0628   CD 05 00               CALL   BDOS   
062B   11 5C 00               LXI   D,005Ch   
062E   0E 14                  MVI   C,20   ; read the next 128 bytes
0630   CD 05 00               CALL   BDOS   
0633   E1                     POP   H   ; HL = the address this record went to
0634   B7                     ORA   A   
0635   C2 40 06               JNZ   ld2   
0638   11 80 00               LXI   D,128   
063B   19                     DAD   D   
063C   EB                     XCHG      
063D   C3 25 06               JMP   ld1   
0640   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0642   23                     INX   H   ; the heap starts after it
0643                          ENDIF      
0643                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
0643                          ENDIF      
0643   22 7C 09               SHLD   HEAP   
0646                          IF   CHECKED   
0646   E7                     RST   4   ; minus the heap"s first address: "_' may not
0647   22 38 09               SHLD   NPEND   ;   release below it
064A                          ENDIF      
064A   21 E0 07               LXI   H,RSTOP   ; the return stack is empty
064D   22 34 09               SHLD   RSP   
0650                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
0650                          ENDIF      ;   checked build has cleared these)
0650                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0650                          ENDIF      
0650                          IF   1-CHECKED   
                              SHLD   KEYBUF   
0650                          ENDIF      
0650   01 00 0A               LXI   B,PROG   ; the IP
0653   F7                     RST   6   ; (its return address is thrown away)
0654                          IF   CPM   
0654                             ; RAM pages, after the image
0654                RSPAGE:   EQU   (imgend + 255) / 256   
0654                DSPAGE:   EQU   RSPAGE + 1   
0654                LETPAGE:   EQU   RSPAGE + 2   
0654                PROG:     EQU   LETPAGE*256 + 256   
0654                          ENDIF      
0654                IMGEND:      


