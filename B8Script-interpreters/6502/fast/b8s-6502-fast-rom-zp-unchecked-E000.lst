E6C2                          IF   SBASEU   
                                 ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
                                 ; fetched or stored in the same step (x@ is the commonest pair in most
                                 ; programs). A checked build checks the stacks between the two, so it keeps
                                 ; them apart. (pvar calls lowp, which only pushes.)
                    LOWQ:     ASL      
                              STA   T0   ; the cell's offset in the letter page
                              LDY   #0   
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   lwf   
                              CMP   #"!"   
                              BEQ   lws   
                              LDA   T0   
                              LDY   #>LET   
                              JMP   pushay   ; the address
                    LWF:      JSR   incip   ; x@: TOS = the cell's value
                              LDY   T0   
                              DEX      
                              DEX      
                              LDA   LET,Y   
                              STA   0,X   
                              LDA   LET+1,Y   
                              STA   1,X   
                              RTS      
                    LWS:      JSR   incip   ; x!: the cell = TOS, and it is dropped
                              LDY   T0   
                              LDA   0,X   
                              STA   LET,Y   
                              LDA   1,X   
                              STA   LET+1,Y   
                              INX      
                              INX      
                              RTS      
E6C2                          ENDIF      
E6C2                          IF   QK   
E6C2                             ; The skip cache. Nearly every skip is one that has happened before (a loop
E6C2                             ; skips the same false block on every pass), so the first scan from each
E6C2                             ; place is remembered: 64 entries of 00bbc3RhcnQsIHRoZSBjbG9zZXIncyBhZGRyZXNz, in CPAGE,
E6C2                             ; found by the start's low byte times 4. Only skips that start in the
E6C2                             ; program text are kept (the line buffer changes); the cache is emptied when
E6C2                             ; the program starts. A program that changes its own text while it runs is
E6C2                             ; not looked after. A miss writes the start into its entry at once, and
E6C2                             ; keeps the entry's place in the scratch under the top cell, $FE,X (1, which
E6C2                             ; no entry has, for a skip that is not kept), so that the end can go in when
E6C2                             ; the scan finds it. A scan that fails ends the program, and the next run
E6C2                             ; empties the cache, so a half-written entry is never found. (The checked
E6C2                             ; build: A holds the wrong closer on the way in, as at the checked skip above.)
E6C2                SKIP:        
E6C2                          ENDIF      
E6C2                          IF   CHECKED*QK   
                              STA   T0   
E6C2                          ENDIF      
E6C2                          IF   QK   
E6C2   A0 01                  LDY   #1   ; (no entry)
E6C4   A5 01                  LDA   IP+1   
E6C6   C9 05                  CMP   #>PROG   
E6C8   90 2E                  BCC   sks   ; below the program text: no cache
E6CA   A5 00                  LDA   IP   
E6CC   0A                     ASL      
E6CD   0A                     ASL      
E6CE   A8                     TAY      ; Y -> the entry
E6CF   A5 00                  LDA   IP   
E6D1   D9 00 02               CMP   CPAGE*256,Y   
E6D4   D0 18                  BNE   skm   
E6D6   A5 01                  LDA   IP+1   
E6D8   D9 01 02               CMP   CPAGE*256+1,Y   
E6DB   D0 11                  BNE   skm   
E6DD   B9 02 02               LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
E6E0   85 00                  STA   IP   ;   read
E6E2   B9 03 02               LDA   CPAGE*256+3,Y   
E6E5   85 01                  STA   IP+1   
E6E7   A0 00                  LDY   #0   
E6E9   B1 00                  LDA   (IP),Y   
E6EB   4C 88 EA               JMP   incip   
E6EE   A5 00        SKM:      LDA   IP   ; a miss: the entry's start now, its end when
E6F0   99 00 02               STA   CPAGE*256,Y   ;   the scan has found it
E6F3   A5 01                  LDA   IP+1   
E6F5   99 01 02               STA   CPAGE*256+1,Y   
E6F8   94 FE        SKS:      STY   0FEh,X   ; the entry, or 1 for none
E6FA   A0 00                  LDY   #0   
E6FC   84 06                  STY   T2   ; depth
E6FE                             ; The scan reads at IP+Y. Most characters are nothing to it, and two range
E6FE                             ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
E6FE   B1 00        SQ1:      LDA   (IP),Y   
E700   C8                     INY      
E701   F0 1D                  BEQ   sqw   
E703   C9 5E        SQ2:      CMP   #5Eh   
E705   B0 F7                  BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E707   C9 5B                  CMP   #5Bh   
E709   B0 28                  BCS   sqb   ; [ \ ]
E70B   C9 2A                  CMP   #2Ah   
E70D   B0 EF                  BCS   sq1   ; * to Z: nothing
E70F   C9 28                  CMP   #28h   
E711   F0 1B                  BEQ   sqo   ; (
E713   B0 24                  BCS   sqc   ; )
E715   C9 22                  CMP   #22h   
E717   F0 0B                  BEQ   sqq   ; a string
E719   C9 01                  CMP   #1   
E71B   B0 E1                  BCS   sq1   ; the rest below "(": nothing
E71D                          ENDIF      
E71D                          IF   QK*(1-CHECKED)   
E71D   4C 09 FF               JMP   EXIT   ; NUL: the end of the program
E720                          ENDIF      
E720                          IF   QK*CHECKED   
                              JMP   sknul   
E720                          ENDIF      
E720                          IF   QK   
E720   E6 01        SQW:      INC   IP+1   ; Y went round: on into the next page
E722   D0 DF                  BNE   sq2   ; always
E724   20 58 E7     SQQ:      JSR   sqip   ; a string: step over it
E727   20 60 E2               JSR   skipstr   
E72A                          ENDIF      
E72A                          IF   QK*CHECKED   
                              BNE   sqq1   
                              JMP   sknul   ; the string ran into the end
                    SQQ1:        
E72A                          ENDIF      
E72A                          IF   QK   
E72A   A0 00                  LDY   #0   
E72C   F0 D0                  BEQ   sq1   ; always
E72E   E6 06        SQO:      INC   T2   ; an opener
E730   4C FE E6               JMP   sq1   
E733   C9 5C        SQB:      CMP   #5Ch   
E735   F0 C7                  BEQ   sq1   ; "\" is nothing here
E737   90 F5                  BCC   sqo   ; [
E739   C6 06        SQC:      DEC   T2   ; ) ]
E73B   10 C1                  BPL   sq1   
E73D   20 58 E7               JSR   sqip   ; the closer at this level: the IP past it
E740                          ENDIF      
E740                          IF   QK*CHECKED   
                              CMP   T0   
                              BNE   sqc1   
                              JMP   e_nest   ; the wrong kind
                    SQC1:        
E740                          ENDIF      
