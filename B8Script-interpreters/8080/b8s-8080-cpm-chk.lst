0700   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
0702   CD 05 00               CALL   BDOS   ;   and the program is empty)
0705   11 00 0B               LXI   D,PROG   
0708   D5           LD1:      PUSH   D   
0709   0E 1A                  MVI   C,26   ; set the DMA address
070B   CD 05 00               CALL   BDOS   
070E   11 5C 00               LXI   D,005Ch   
0711   0E 14                  MVI   C,20   ; read the next 128 bytes
0713   CD 05 00               CALL   BDOS   
