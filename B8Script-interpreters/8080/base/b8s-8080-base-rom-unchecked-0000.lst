02A4                          IF   1-CHECKED   
02A4                             ; "$" prints the string at TOS (see h_print).
02A4   7E           PRLP:     MOV   A,M   
02A5   23                     INX   H   
02A6   FE 22                  CPI   22h   
02A8   CA 91 01               JZ   h_drop   
02AB   FE 2F                  CPI   "/"   
02AD   C2 BE 02               JNZ   pr1   
02B0   7E                     MOV   A,M   
02B1   23                     INX   H   
02B2   FE 60                  CPI   60h   
02B4   DA BC 02               JC   pr0   
02B7   FE 7F                  CPI   7Fh   
02B9   DA C2 02               JC   pesc   
02BC   E6 BF        PR0:      ANI   0BFh   
02BE                          ;*Macro unroll: pr1:    PUTA
02BE   EF           PR1:      DS   1-CPM,0EFh   
02BF                          DS   CPM,0CDh   
02BF                          DS   CPM,APUT&0FFh   
02BF                          DS   CPM,APUT/256   
02BF   C3 A4 02               JMP   prlp   
02C2                          ENDIF      
02C2                             ;-----------------------------------------------------------------------------
02C2                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
02C2                             ; HL points past it. Each goes back into the loop that prints the string
02C2                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
02C2                             ;    /a-/z   print the variable, as "#" does
02C2                             ;    /{      clear the screen, the cursor to the top left
02C2                             ;    /}      clear from the cursor to the end of the line
02C2                             ;    /|  /`  show the cursor, hide it
02C2                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
02C2   FE 7E        PESC:     CPI   7Eh   
02C4   CA E7 02               JZ   pat   
02C7   11 A4 02               LXI   D,PRLOOP   ; the others return into the loop
02CA   D5                     PUSH   D   
02CB   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
02CD   D2 F0 02               JNC   pcon   
02D0   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
02D2   D2 F9 02               JNC   phide   
02D5   87                     ADD   A   ; the variable's cell
02D6   C6 40                  ADI   40h   
02D8   E5                     PUSH   H   
02D9   C5                     PUSH   B   
02DA   6F                     MOV   L,A   
02DB   26 82                  MVI   H,LETPAGE   
02DD   7E                     MOV   A,M   
02DE   2C                     INR   L   
02DF   66                     MOV   H,M   
02E0   6F                     MOV   L,A   
02E1   CD 69 02               CALL   psgn   
02E4   C1                     POP   B   
02E5   E1                     POP   H   
02E6   C9                     RET      
02E7                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
02E7                             ; the checked build "$" is the routine prstr: its own return address goes
02E7                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
02E7                             ; its two cells are there, and is s if not, before it prints anything.
02E7                PAT:         
02E7                          IF   CHECKED   
                              XTHL      ; the text pointer over prstr's return address
                              LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              DAD   SP   
                              JC   e_under   
                              POP   H   
02E7                          ENDIF      
02E7   D1                     POP   D   ; DE = the column
02E8   E3                     XTHL      ; HL = the row; the text pointer is kept
02E9                          IF   1-ANS   
02E9   CD 15 FF               CALL   CONAT   
02EC   E1                     POP   H   
02ED   C3 A4 02               JMP   PRAGAIN   
02F0                             ; With ANSI = 0 the machine's routines do the rest.
02F0   CA 0C FF     PCON:     JZ   CONCLS   ; /{
02F3   FE 02                  CPI   2   
02F5   CA 0F FF               JZ   CONEOL   ; /}
02F8   FE                     DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
02F9   AF           PHIDE:    XRA   A   ; /`  (A = 0: hide)
02FA   C3 12 FF               JMP   CONCUR   
02FD                          ENDIF      
02FD                          IF   ANS   
                              PUSH   B   ; (pdec uses BC)
                              PUSH   D   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INX   H   
                              CALL   pdec   
                              MVI   A,";"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   H   
                              INX   H   
                              CALL   pdec   
                              MVI   A,"H"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   B   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
                    PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
                              MVI   A,"?"   
                              CALL   csia   
                              MVI   A,"2"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"5"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DCR   A   
                              JZ   pshow   ; /|
                              MVI   A,"K"   
                              JP   csia   ; /}  ESC [ K
                              MVI   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              MVI   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
                    CSIA:     PUSH   PSW   
                              CALL   csi   
                              POP   PSW   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                    CSI:      MVI   A,27   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"["   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
02FD                          ENDIF      
02FD                             ; skip: read past text to the closer at this level, and return A = 0 if it
02FD                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02FD                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02FD                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02FD                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02FD                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
02FD                             ; 
02FD                             ; The checked build also looks at the character the skip was started by,
02FD                             ; which is always the one just before where it starts: "(" must end at ")",
02FD                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02FD                             ; quote counts as running into it. "\" takes either closer. The place where
02FD                             ; the skip started is kept on the stack, for the report.
02FD                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
02FD                          ENDIF      
02FD                          IF   CHECKED*(1-QK)   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
02FD                          ENDIF      
02FD                          IF   1-QK   
                              MVI   D,0   
                    SK3:      INR   D   ; an opener: one deeper
                    SK1:      LDAX   B   
02FD                          ENDIF      
02FD                          IF   (1-CHECKED)*(1-QK)   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
02FD                          ENDIF      
02FD                          IF   CHECKED*(1-QK)   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
02FD                          ENDIF      
02FD                          IF   1-QK   
                              CPI   22h   
                              CZ   skipstr   ; leaves A = 22h, which matches nothing below
                              SUI   "("   ;   (or 0, and then the NUL is read next)
                              JZ   sk3   
                              DCR   A   ; ")"
                              JZ   sk4   
                              SUI   "["-")"   
                              JZ   sk3   
                              CPI   "]"-"["   
                              JNZ   sk1   
                    SK4:      DCR   D   
02FD                          ENDIF      
02FD                          IF   (1-CHECKED)*(1-QK)   
                              RZ      ; the closer at this level
                              JMP   sk1   
02FD                          ENDIF      
02FD                          IF   CHECKED*(1-QK)   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
02FD                          ENDIF      
02FD                          IF   QK   
02FD                             ; The skip cache. Nearly every skip is one that has happened before (a loop
02FD                             ; skips the same false block on every pass), so the first scan from each
02FD                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
02FD                             ; by the start's low byte (times 4). Only skips that start in the program
02FD                             ; text are kept (the line buffer changes); the cache is emptied whenever a
02FD                             ; run starts (see start). A program that changes its own text while it
02FD                             ; runs is not looked after.
02FD   78           SKIP:     MOV   A,B   
02FE   FE 83                  CPI   PROG/256   
0300   DA 20 03               JC   sks   ; below the program text: no cache
0303   79                     MOV   A,C   
0304   87                     ADD   A   
0305   87                     ADD   A   
0306   5F                     MOV   E,A   
0307   16 F0                  MVI   D,CPAGE   ; DE -> the entry
0309   1A                     LDAX   D   
030A   B9                     CMP   C   
030B   C2 20 03               JNZ   sks   
030E   1C                     INR   E   
030F   1A                     LDAX   D   
0310   B8                     CMP   B   
0311   C2 20 03               JNZ   sks   
0314   1C                     INR   E   
0315   1A                     LDAX   D   
0316   4F                     MOV   C,A   
0317   1C                     INR   E   
0318   1A                     LDAX   D   
0319   47                     MOV   B,A   ; a hit: the IP is past the closer
031A   0B                     DCX   B   
031B   0A                     LDAX   B   
031C   03                     INX   B   
031D   D6 29                  SUI   ")"   ; 0 for ")", not 0 for "]"
031F   C9                     RET      
0320   C5           SKS:      PUSH   B   ; where it starts: the cache's key (and the
0321                          ENDIF      ;   checked report's place)
0321                          IF   QK*CHECKED   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
0321                          ENDIF      
0321                          IF   QK   
0321                             ; The scan. Most characters are nothing to it, and two range tests rule
0321                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
0321   16 00                  MVI   D,0   
0323   14           SQ3:      INR   D   ; an opener: one deeper
0324   0A           SQ1:      LDAX   B   
0325   03                     INX   B   
0326   FE 5E                  CPI   5Eh   
0328   D2 24 03               JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
032B   FE 5B                  CPI   5Bh   
032D   D2 4F 03               JNC   sqb   ; [ \ ]
0330   FE 2A                  CPI   2Ah   
0332   D2 24 03               JNC   sq1   ; * to Z: nothing
0335   FE 28                  CPI   28h   
0337   CA 23 03               JZ   sq3   ; (
033A   D2 5A 03               JNC   sqc   ; )
033D   FE 22                  CPI   22h   
033F   CA 49 03               JZ   sqq   ; a string
0342   B7                     ORA   A   
0343   C2 24 03               JNZ   sq1   ; the rest below "(": nothing
0346                          ENDIF      
0346                          IF   QK*(1-CHECKED)   
0346   C3 79 00               JMP   endprog   ; NUL: the end of the program
0349                          ENDIF      
0349                          IF   QK*CHECKED   
                              DCX   B   ; NUL: the IP stays on it
                              MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SQ7:      MVI   A,"N"   ; N. The place is the opener
                              JMP   errp   ; (errp drops skip's return address)
0349                          ENDIF      
0349                          IF   QK   
0349   CD 7C 03     SQQ:      CALL   skipstr   ; step over the string
034C   C3 24 03               JMP   sq1   
034F   D6 5C        SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
0351   CA 24 03               JZ   sq1   ; "\" is nothing here
0354   DA 23 03               JC   sq3   ; [
0357   3E 02                  MVI   A,2   ; ]
0359   FE                     DB   0FEh   ; (CPI: steps over the XRA)
035A   AF           SQC:      XRA   A   ; )
035B   15           SQ4:      DCR   D   
035C   C2 24 03               JNZ   sq1   
035F                          ENDIF      
035F                          IF   QK*CHECKED   
                              MOV   D,A   ; the closer at this level (as above): 2 here
                              XRA   E   ;   means the wrong closer
                              ANI   6   
                              CPI   2   
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              JNZ   sq8   
                              MOV   B,D   
                              MOV   C,E   
                              JMP   sq7   
                    SQ8:         
035F                          ENDIF      
035F                          IF   QK*(1-CHECKED)   
035F   D1                     POP   D   ; where the skip started
0360                          ENDIF      
0360                          IF   QK   
0360                             ; The closer at this level: remember the skip (if it started in the program
0360                             ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
0360   E5                     PUSH   H   
0361   67                     MOV   H,A   
0362   7A                     MOV   A,D   
0363   FE 83                  CPI   PROG/256   
0365   DA 78 03               JC   sq9   
0368   7B                     MOV   A,E   
0369   87                     ADD   A   
036A   87                     ADD   A   
036B   6F                     MOV   L,A   
036C   7C                     MOV   A,H   
036D   26 F0                  MVI   H,CPAGE   
036F   73                     MOV   M,E   
0370   2C                     INR   L   
0371   72                     MOV   M,D   
0372   2C                     INR   L   
0373   71                     MOV   M,C   
0374   2C                     INR   L   
0375   70                     MOV   M,B   
0376   E1                     POP   H   
0377   C9                     RET      
0378   7C           SQ9:      MOV   A,H   
0379   E1                     POP   H   
037A   C9                     RET      
037B                          ENDIF      
037B                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
037B                             ; the next character, so "/"" does not end it. Leaves A = 22h.
037B                          IF   1-CHECKED   
037B   03           SS0:      INX   B   
037C   0A           SKIPSTR:   LDAX   B   
037D   03                     INX   B   
037E   FE 2F                  CPI   "/"   
0380   CA 7B 03               JZ   ss0   
0383   FE 22                  CPI   22h   
0385   C2 7C 03               JNZ   skipstr   
0388   C9                     RET      
0389                          ENDIF      
0389                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
0389                          ENDIF      
0389                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0389                             ; and return its value in A with the carry set; otherwise leave the IP and
0389                             ; return with the carry clear.
0389   0A           HEXC:     LDAX   B   
038A   D6 30                  SUI   "0"   
038C   FE 0A                  CPI   10   
038E   DA 9A 03               JC   hc1   
0391   E6 DF                  ANI   0DFh   
0393   D6 11                  SUI   11h   
0395   FE 06                  CPI   6   
0397   D0                     RNC      
0398   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
039A   03           HC1:      INX   B   
039B   C9                     RET      
039C                             ;  ---- Speed-ups (base builds) -------------------------------------------
039C                             ;  The skip cache and "/" by a power of two are above. These are the
039C                             ;  handlers' tails that the builds with room take, kept here, out of the
039C                             ;  handlers' first two pages.
039C                          IF   QK   
039C                             ; "*" with an operand below 256: that one becomes the multiplier, a byte in
039C                             ; A, and the loop stops as soon as its bits are used up (most
039C                             ; multiplications have one, a count or a small constant). With both at 256
039C                             ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
039C                             ; shifted in above it says when), and its high byte goes on as a small one.
039C                             ; DE = NOS, HL = TOS.
039C   7C           MULQ:     MOV   A,H   
039D   B7                     ORA   A   
039E   CA A7 03               JZ   mq8   ; the multiplier is below 256
03A1   7A                     MOV   A,D   
03A2   B7                     ORA   A   
03A3   C2 BC 03               JNZ   mq16   
03A6   EB                     XCHG      ; the multiplicand is: it becomes the multiplier
03A7   7D           MQ8:      MOV   A,L   
03A8   21 00 00               LXI   H,0   
03AB   B7                     ORA   A   ; (clears the carry)
03AC   CA BB 03               JZ   mq9   
03AF   1F           MQ1:      RAR      ; the next bit
03B0   D2 B4 03               JNC   mq2   
03B3   19                     DAD   D   
03B4   EB           MQ2:      XCHG      
03B5   29                     DAD   H   ; multiplicand << 1
03B6   EB                     XCHG      
03B7   B7                     ORA   A   ; bits left? (and clears the carry)
03B8   C2 AF 03               JNZ   mq1   
03BB                          ;*Macro unroll: mq9:    NEXTQ
03BB   F7           MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
03BC                          DS   CPM*(1-FAST),0C3h   
03BC                          DS   CPM*(1-FAST),ANXT&0FFh   
03BC                          DS   CPM*(1-FAST),ANXT/256   
03BC                          DS   FAST*CHECKED,0CDh   
03BC                          DS   FAST*CHECKED,ACHK&0FFh   
03BC                          DS   FAST*CHECKED,ACHK/256   
03BC                          DS   FAST,0Ah   
03BC                          DS   FAST,03h   
03BC                          DS   FAST,0EBh   
03BC                          DS   FAST,6Fh   
03BC                          DS   FAST,26h   
03BC                          DS   FAST,DTPG   
03BC                          DS   FAST,7Eh   
03BC                          DS   FAST,24h   
03BC                          DS   FAST,66h   
03BC                          DS   FAST,6Fh   
03BC                          DS   FAST,0E9h   
03BC   C5           MQ16:     PUSH   B   
03BD   44                     MOV   B,H   ; the high byte, for later
03BE   7D                     MOV   A,L   
03BF   21 00 00               LXI   H,0   
03C2   37                     STC      ; the marker
03C3   1F                     RAR      
03C4   D2 C8 03     MQ3:      JNC   mq4   
03C7   19                     DAD   D   
03C8   EB           MQ4:      XCHG      
03C9   29                     DAD   H   
03CA   EB                     XCHG      
03CB   FE 01                  CPI   1   ; only the marker left: 8 rounds done (and
03CD   1F                     RAR      ;   the carry was clear for the shift)
03CE   C2 C4 03               JNZ   mq3   
03D1   78                     MOV   A,B   
03D2   C1                     POP   B   
03D3   B7                     ORA   A   
03D4   C3 AF 03               JMP   mq1   ; the high byte, as a small multiplier
03D7                             ; A true ")" reads the block start where it is, on top of the return stack,
03D7                             ; instead of popping it and pushing it back; the break key is looked at as
03D7                             ; rpushd would.
03D7   2A 34 82     CLOSEQ:   LHLD   RSP   
03DA   4E                     MOV   C,M   
03DB   23                     INX   H   
03DC   46                     MOV   B,M   
03DD   21 36 82               LXI   H,BRKCNT   
03E0   35                     DCR   M   
03E1   E1                     POP   H   ; (keeps the flags)
03E2   CC 07 04               CZ   pollk   
03E5                          ;*Macro unroll:  NEXTQ
03E5   F7                     DS   (1-CPM)*(1-FAST),0F7h   
03E6                          DS   CPM*(1-FAST),0C3h   
03E6                          DS   CPM*(1-FAST),ANXT&0FFh   
03E6                          DS   CPM*(1-FAST),ANXT/256   
03E6                          DS   FAST*CHECKED,0CDh   
03E6                          DS   FAST*CHECKED,ACHK&0FFh   
03E6                          DS   FAST*CHECKED,ACHK/256   
03E6                          DS   FAST,0Ah   
03E6                          DS   FAST,03h   
03E6                          DS   FAST,0EBh   
03E6                          DS   FAST,6Fh   
03E6                          DS   FAST,26h   
03E6                          DS   FAST,DTPG   
03E6                          DS   FAST,7Eh   
03E6                          DS   FAST,24h   
03E6                          DS   FAST,66h   
03E6                          DS   FAST,6Fh   
03E6                          DS   FAST,0E9h   
03E6                          ENDIF      
03E6                          IF   SBASEU   
03E6                             ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
03E6                             ; or stored in the same step (x@ is the commonest pair in most programs).
03E6                             ; (A checked build checks the stacks between the two, so it keeps them apart.)
03E6                LOWER:    EQU   lowq   
03E6   87           LOWQ:     ADD   A   
03E7   5F                     MOV   E,A   
03E8   16 82                  MVI   D,LETPAGE   ; DE -> the cell
03EA   0A                     LDAX   B   
03EB   FE 40                  CPI   "@"   
03ED   CA F8 03               JZ   lwf   
03F0   FE 21                  CPI   "!"   
03F2   CA 00 04               JZ   lws   
03F5   E5                     PUSH   H   
03F6   EB                     XCHG      ; TOS = the cell's address
03F7                          ;*Macro unroll:  NEXT
03F7   F7                     DS   (1-CPM)*(1-FAST),0F7h   
03F8                          DS   CPM+FAST-CPM*FAST,0C3h   
03F8                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
03F8                          DS   CPM+FAST-CPM*FAST,ANXT/256   
03F8   03           LWF:      INX   B   ; x@: TOS = the cell's value
03F9   E5                     PUSH   H   
03FA   EB                     XCHG      
03FB   5E                     MOV   E,M   
03FC   23                     INX   H   
03FD   56                     MOV   D,M   
03FE   EB                     XCHG      
03FF                          ;*Macro unroll:  NEXT
03FF   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0400                          DS   CPM+FAST-CPM*FAST,0C3h   
0400                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0400                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0400   03           LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
0401   EB                     XCHG      
0402   73                     MOV   M,E   
0403   23                     INX   H   
0404   72                     MOV   M,D   
0405   E1                     POP   H   
0406                          ;*Macro unroll:  NEXT
0406   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0407                          DS   CPM+FAST-CPM*FAST,0C3h   
0407                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0407                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0407                          ENDIF      
0407                             ; =============================================================================
0407                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0407                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0407                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
0407                             ;  the host's KEY and CONOUT routines themselves.
0407                             ; 
0407                             ;  A running program reads the keyboard only through getk and pollk, which
0407                             ;  between them give the break key its rules:
0407                             ;    - Ctrl-C stops the program;
0407                             ;    - any other key that the break check reads is held in KEYBUF for the
0407                             ;      next "?", and a newer one takes its place;
0407                             ;    - "?" (getk) takes the held key first;
0407                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0407                             ;      key like any other, but two of them within about 250 ms still stop it.
0407                             ;  Both are called straight from a handler, never from a routine under one:
0407                             ;  the checked build's report counts on finding one return address above the
0407                             ;  data stack, and TOS in HL.
0407                             ; =============================================================================
0407                          IFN   CPM   
0407                RAWK:     EQU   KEY   
0407                          ENDIF      
0407                             ; pollk: the break check (see rpushd).
0407   CD 06 FF     POLLK:    CALL   rawk   
040A   C8                     RZ      ; no key
040B   32 7A 82               STA   KEYBUF   ; held for the next "?"
040E   FE 03        PK1:      CPI   3   ; (getk joins here)
0410   C0                     RNZ      
0411                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0411                             ; the program has turned it off, wait about 250 ms for one more key: a
0411                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0411                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0411   3A 7B 82     CTLC:     LDA   BRKOFF   
0414   B7                     ORA   A   
0415   CA 79 00               JZ   brk   
0418   D5                     PUSH   D   
0419   11 10 27               LXI   D,250*MSLOOP   
041C   CD 06 FF     CT1:      CALL   rawk   
041F   C2 28 04               JNZ   ct2   
0422   1B                     DCX   D   
0423   7A                     MOV   A,D   
0424   B3                     ORA   E   
0425   C2 1C 04               JNZ   ct1   
0428   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
0429   FE 03                  CPI   3   
042B   CA 79 00               JZ   brk   
042E   B7                     ORA   A   
042F   CA 35 04               JZ   ct3   
0432   32 7A 82               STA   KEYBUF   
0435   3E 03        CT3:      MVI   A,3   
0437   B7                     ORA   A   
0438   C9                     RET      
0439                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0439   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
043A   21 7A 82               LXI   H,KEYBUF   ;   the buffer
043D   7E                     MOV   A,M   
043E   36 00                  MVI   M,0   
0440   E1                     POP   H   
0441   B7                     ORA   A   
0442   C0                     RNZ      
0443   CD 06 FF               CALL   rawk   
0446   C8                     RZ      
0447   C3 0E 04               JMP   pk1   ; Ctrl-C? If not, that is the key
044A                          IF   1-CHECKED   
044A                BRK:      EQU   endprog   ; the unchecked build stops without a word;
044A                          ENDIF      
044A                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
044A                          ENDIF      
044A                          IF   CPM   
                                 ; (In a CP/M build the letters and digits are here, out of the way of the
                                 ; handlers, which must fit in the image's first two pages. The same code as
                                 ; in the generic build.)
                                 ; ---- the letters and digits --------------------------------------------------
                                 ; a-z: push the cell's address (the cell is the variable)
044A                          ENDIF      
044A                          IF   CPM*(1-SBASEU)   
                    LOWER:    PUSH   H   
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
044A                          ENDIF      
044A                          IF   CPM   
                                 ; A-Z: call the word. The return address (the IP after the letter) goes on
                                 ; the return stack, and the IP becomes the address in the letter's cell.
                    UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   ; HL -> cell
                              MOV   D,B   
                              MOV   E,C   ; DE = the return address
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   ; IP = the word's body, and fall into rpushd
                                 ; rpushd: push DE on the return stack, then pop TOS off the data stack and
                                 ; go on. Every push of the return stack ends here: for a word call the cell
                                 ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
                                 ; the one that was used up.
                                 ; 
                                 ; The break key is looked at here, so at every word call and loop-back (and
                                 ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
                                 ; the keyboard can be slow (it is a BDOS call under CP/M).
                    RPUSHD:   LHLD   RSP   
                              DCX   H   
                              MOV   M,D   
                              DCX   H   
                              MOV   M,E   
                              SHLD   RSP   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
044A                          ENDIF      
044A                             ; =============================================================================
044A                             ;  Checked build: the checks and the error report
044A                             ; =============================================================================
044A                          IF   CHECKED   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
044A                          ENDIF      
044A                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
044A                          ENDIF      
044A                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
044A                          ENDIF      
044A                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address (errp drops
                              MVI   A,"H"   ;   the old top)
                              JMP   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
044A                          ENDIF      
044A                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
044A                          ENDIF      
044A                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
044A                          ENDIF      
044A                          IF   CHECKED   
                                 ; Two error entries for errors found inside a routine: the first hides the
                                 ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
                                 ; return address.
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   prs0   
                              CPI   7Fh   
                              JC   pesc   
                    PRS0:     ANI   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,10   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   D   
                              POP   H   
                              CALL   chkstk   
                              PUSH   H   
                              LHLD   PSAVE   
                              DB   11h   ; (LXI D hides e_quote's first two bytes)
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   D   
                              POP   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   "D:",22h   
                              LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
                              DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
                              ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
                              DS   1-CPM,0E7h   ;   first value and holds nothing)
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              MOV   A,H   
                              CALL   phal2   ; the depth
                              MVI   A,":"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                    PHAL2:    ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
044A                          ENDIF      
044A                             ; =============================================================================
044A                             ;  Startup
044A                             ; =============================================================================
044A                START:       
044A                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
044A                          ENDIF      
044A                          IF   QK   
044A   21 00 F0               LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
044D   AF                     XRA   A   ;   start of 0000h matches no skip)
044E   77           SKC1:     MOV   M,A   
044F   2C                     INR   L   
0450   C2 4E 04               JNZ   skc1   
0453                          ENDIF      
0453                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
0453                          ENDIF      
0453                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
0453                          ENDIF      
0453                          IFN   CPM   
0453   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
0456   7E           FNUL:     MOV   A,M   
0457   23                     INX   H   
0458   B7                     ORA   A   
0459   C2 56 04               JNZ   fnul   
045C                          ENDIF      
045C   22 7C 82               SHLD   HEAP   
045F                          IF   CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              SHLD   NPEND   ;   release below it
045F                          ENDIF      
045F   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
0462   22 34 82               SHLD   RSP   
0465                          IF   (1-CHECKED)*(1-CPM)   
0465   67                     MOV   H,A   ; (A = 0, from the search for the NUL) no key
0466   6F                     MOV   L,A   ;   is held, and the break key is on (the
0467                          ENDIF      ;   checked build has cleared these)
0467                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0467                          ENDIF      
0467                          IF   1-CHECKED   
0467   22 7A 82               SHLD   KEYBUF   
046A                          ENDIF      
046A   01 00 83               LXI   B,PROG   ; the IP
046D                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
046D   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
046E                          DS   CPM+FAST-CPM*FAST,0C3h   
046E                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
046E                          DS   CPM+FAST-CPM*FAST,ANXT/256   
046E                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
                                 ; 
                                 ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
                                 ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
                                 ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
                                 ;  the letters and digits have one entry each, which knows its cell or its
                                 ;  value already.
                                 ; =============================================================================
                    FTSTORE:   XCHG      ; !
                              JMP   h_store   
                    FTSTR:    XCHG      ; "
                              JMP   h_str   
                    FTNUM:    XCHG      ; #
                              JMP   h_num   
                    FTPRINT:   XCHG      ; $
                              JMP   h_print   
                    FTEMIT:   XCHG      ; '
                              JMP   h_emit   
                    FTCSTORE:   XCHG      ; .
                              JMP   h_cstore   
                    FTDIV:    XCHG      ; /
                              JMP   h_div   
                    FTKEY:    XCHG      ; ?
                              JMP   h_key   
                    FTDEF:    XCHG      ; [
                              JMP   h_def   
                    FTBREAK:   XCHG      ; \
                              JMP   h_break   
                    FTALLOC:   XCHG      ; _
                              JMP   h_alloc   
                    FTGRAVE:   XCHG      ; `
                              JMP   h_grave   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:   POP   H   ; +
                              DAD   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:   LDAX   B   ; -
                              SUI   "0"   
                              CPI   10   
                              JC   fs_neg   
                              POP   H   
                              MOV   A,L   
                              SUB   E   
                              MOV   E,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   D,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   XCHG      ; a digit next: a negative number
                              JMP   negnum   
                    FS_DUP:   PUSH   D   ; :
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:   POP   H   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:   POP   H   ; %
                              PUSH   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:   XCHG      ; @
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:   LDAX   D   ; ,
                              MOV   E,A   
                              MVI   D,0   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:    POP   H   ; < (HL = a, DE = b: the borrow of a - b, flipped if the signs differ)
                              MOV   A,L   
                              SUB   E   
                              MOV   A,H   
                              SBB   D   
                              SBB   A   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              RAL      
                              SBB   A   
                              XRA   L   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:    POP   H   ; > (b < a: the borrow of b - a)
                              MOV   A,E   
                              SUB   L   
                              MOV   A,D   
                              SBB   H   
                              SBB   A   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              RAL      
                              SBB   A   
                              XRA   L   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_EQ:    POP   H   ; =
                              MOV   A,L   
                              XRA   E   
                              MOV   L,A   
                              MOV   A,H   
                              XRA   D   
                              ORA   L   
                              SUI   1   
                              SBB   A   
                              MOV   D,A   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:   POP   H   ; &
                              MOV   A,H   
                              ANA   D   
                              MOV   D,A   
                              MOV   A,L   
                              ANA   E   
                              MOV   E,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
