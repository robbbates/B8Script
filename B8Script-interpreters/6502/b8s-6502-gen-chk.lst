0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-11-21). -n? does no more editing than
0000                             ;        Backspace. The break key is checked in the checked build only (at
0000                             ;        every ")" loop-back and every return).
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page. b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  One switch, set in the EQU line below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's four-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   0/ "no"$
0000                             ;                   Stk 2: 5 0
0000                             ;                   Rtn 0
0000                             ;                 and then goes to EXIT.
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                RSV:      EQU   07h   ; checked: S as it was before this character
0000                             ; The error report (checked) runs after the program, so it may use the zero
0000                             ; page that machine code has ($0A-$0F):
0000                P:        EQU   0Ah   ; 0A-0B the place being reported
0000                Q:        EQU   0Ch   ; 0C-0D a pointer for counting lines
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: KEYBUF at +34, PLACE at +36, PEND at +38.
0000                             ;               (+7A and +7B are kept free.)
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                PLACE:    EQU   LET+36h   ; checked: the address of this character
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                LBM1:     EQU   LINEBUF-1   ; (for the error report)
0000                PROGM1:   EQU   PROG-1   
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
E003                             ; The first half of the letter page is zeroed: every variable, every
E003                             ; cell of the interpreter's own (no key held back), and every word
E003                             ; cell, which then points at 0000h: calling an undefined word stops
E003                             ; with U (see e_undef).
E003   E8                     INX      
E004   8A                     TXA      ; A = 0
E005   A0 7F                  LDY   #7Fh   
E007   99 00 04     STZ:      STA   LET,Y   
E00A   88                     DEY      
E00B   10 FA                  BPL   stz   
E00D                          ENDIF      
E00D   20 24 E2               JSR   rstip   
E010   20 18 E2     ST1:      JSR   getc   
E013   D0 FB                  BNE   st1   ; IP ends just past the NUL
E015   A5 00                  LDA   IP   
E017   8D 7C 04               STA   HEAP   
E01A                          IF   CHECKED   
E01A   8D 38 04               STA   PEND   
E01D                          ENDIF      
E01D   A5 01                  LDA   IP+1   
E01F   8D 7D 04               STA   HEAP+1   
E022                          IF   CHECKED   
E022   8D 39 04               STA   PEND+1   
E025                          ENDIF      
E025   20 24 E2               JSR   rstip   
E028   A2 FC                  LDX   #DSE   
E02A                             ; =============================================================================
E02A                             ;  The inner loop
E02A                             ; =============================================================================
E02A                NEXT:        
E02A                          IF   CHECKED   
E02A                             ; Both stacks are checked once per character, after it has run. The
E02A                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E02A                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E02A                             ; more than one entry). The data stack has when X is above DSE: an
E02A                             ; underflow moves X up to FDh or FEh (no handler moves X by more
E02A                             ; than 2), and an overflow wraps it from 00h to FFh.
E02A                             ; S is kept in RSV, for the report's Rtn line (an error found inside
E02A                             ; a handler has its own calls on the hardware stack), and the place
E02A                             ; of the character about to run in PLACE.
E02A   8A                     TXA      ; TSX trashes X: keep it in A
E02B   BA                     TSX      
E02C   86 07                  STX   RSV   
E02E   E0 20                  CPX   #RSLIM   
E030   AA                     TAX      ; TAX leaves the carry alone
E031   90 6F                  BCC   e_rstack   
E033   E0 FD                  CPX   #DSE+1   
E035   B0 7B                  BCS   e_stack   
E037   A5 00                  LDA   IP   
E039   8D 36 04               STA   PLACE   
E03C   A5 01                  LDA   IP+1   
E03E   8D 37 04               STA   PLACE+1   
E041                          ENDIF      
E041   20 47 E0               JSR   step   
E044   4C 2A E0               JMP   next   
E047                             ; step: read one character and sort it by range.
E047                             ;    00h          end of program
E047                             ;    01h-20h, 7Fh-FFh   ignored
E047                             ;    30h-39h      digit: read a whole number
E047                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E047                             ;    61h-7Ah      a-z: push the address of that letter's cell
E047                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E047                             ; Every way out of the sort has the carry clear, except "ignored". A checked
E047                             ; build stops on 80h-FFh (X) and still ignores DEL.
E047   20 18 E2     STEP:     JSR   getc   ; flags follow A
E04A   F0 38                  BEQ   endprog   
E04C   38                     SEC      
E04D   E9 21                  SBC   #21h   ; A = c - 21h
E04F   90 32                  BCC   ign   ; 01h-20h
E051   C9 0F                  CMP   #0Fh   
E053   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E055   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E057   C9 0A                  CMP   #10   
E059   90 6C                  BCC   digit   
E05B   C9 11                  CMP   #11h   
E05D   90 18                  BCC   p3a   ; 3Ah-40h
E05F   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E061   C9 1A                  CMP   #1Ah   
E063   90 5D                  BCC   upper   ; 41h-5Ah
E065   C9 20                  CMP   #20h   
E067   90 0C                  BCC   p5b   ; 5Bh-60h
E069   C9 3A                  CMP   #3Ah   
E06B   90 62                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E06D   C9 3E                  CMP   #3Eh   
E06F                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E06F                          ENDIF      
E06F                          IF   CHECKED   
E06F   F0 12                  BEQ   ign   ; 7Fh
E071   B0 4A                  BCS   e_resv   ; 80h-FFh: reserved
E073                          ENDIF      
E073                             ; The three adjustments below chain. Each ADC adds the carry the one
E073                             ; before it left, which the constants allow for.
E073   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E075   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E077   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E079   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E07A   A8                     TAY      
E07B   B9 9E E1               LDA   PTAB+1,Y   
E07E   48                     PHA      
E07F   B9 9D E1               LDA   PTAB,Y   
E082   48                     PHA      
E083   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E084                             ; directly, it just ends an ignored character.
E084                ENDPROG:      
E084                          IF   CHECKED   
E084   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E086   F0 03                  BEQ   e_undef   
E088                          ENDIF      
E088   4C 09 FF               JMP   EXIT   
E08B                          IF   CHECKED   
E08B                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E08B                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E08B                             ; the call reads a NUL with IP in page zero, where no program can be. The
E08B                             ; call is undone first: the step frame and the return address come off the
E08B                             ; hardware stack, and the place is the call letter (the return address - 1).
E08B   68           E_UNDEF:   PLA      
E08C   68                     PLA      ; the step frame
E08D   68                     PLA      
E08E   38                     SEC      
E08F   E9 01                  SBC   #1   
E091   8D 36 04               STA   PLACE   
E094   68                     PLA      
E095   E9 00                  SBC   #0   
E097   8D 37 04               STA   PLACE+1   
E09A   E6 07                  INC   RSV   
E09C   E6 07                  INC   RSV   ; Rtn does not count the call
E09E   A9 55                  LDA   #"U"   
E0A0   D0 1D                  BNE   ejmp   ; always
E0A2                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E0A2                             ; empty.
E0A2   A5 07        E_RSTACK:   LDA   RSV   
E0A4   C9 10                  CMP   #10h   
E0A6   A9 52                  LDA   #"R"   
E0A8   B0 15                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E0AA   A9 FF                  LDA   #0FFh   
E0AC   85 07                  STA   RSV   ; S wrapped to 01h: Rtn 0
E0AE   A9 72                  LDA   #"r"   
E0B0   D0 0D                  BNE   ejmp   ; always
E0B2   E0 FF        E_STACK:   CPX   #0FFh   
E0B4   A9 53                  LDA   #"S"   
E0B6   B0 07                  BCS   ejmp   ; X wrapped from 00h to FFh: an overflow
E0B8   A2 FC                  LDX   #DSE   ; an underflow: Stk 0
E0BA   A9 73                  LDA   #"s"   
E0BC   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E0BD   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E0BF   4C 70 E5     EJMP:     JMP   error   
E0C2                          ENDIF      
E0C2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E0C2                             ; the return stack, and the IP becomes the address in the letter's cell.
E0C2   0A           UPPER:    ASL      
E0C3   A8                     TAY      
E0C4   38                     SEC      
E0C5   B0 2C                  BCS   pushn   ; always
E0C7                             ; Digits: the first one is in A; read the rest of the number.
E0C7   A0 00        DIGIT:    LDY   #0   
E0C9   20 D8 E0               JSR   pushay   
E0CC   4C 04 E2               JMP   rdnum   
E0CF                             ; a-z: push the cell's address (the cell is the variable)
E0CF   0A           LOWER:    ASL      
E0D0   A0 04                  LDY   #>LET   
E0D2   D0 04                  BNE   pushay   ; always
E0D4   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E0D6   A4 01                  LDY   IP+1   
E0D8                             ; pushay: push a cell: A = its low byte, Y = its high byte
E0D8   48           PUSHAY:   PHA      
E0D9   20 E2 E0               JSR   push   
E0DC   68                     PLA      
E0DD   85 02                  STA   TL   
E0DF   84 03                  STY   TH   
E0E1   60                     RTS      
E0E2   CA           PUSH:     DEX      ; ":" and every push (keeps Y)
E0E3   A5 02                  LDA   TL   
E0E5   9D 00 02               STA   DSL,X   
E0E8   A5 03                  LDA   TH   
E0EA   9D 00 03               STA   DSH,X   
E0ED   60                     RTS      
E0EE                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E0EE                             ; the matching ")".
E0EE   20 2D E2     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E0F1                          IF   1-CHECKED   
                              BEQ   skip   
E0F1                          ENDIF      
E0F1                          IF   CHECKED   
E0F1   F0 27                  BEQ   skpar   
E0F3                          ENDIF      
E0F3                             ; pushn: take the step frame off, push the reading position on the return
E0F3                             ; stack, and go on. With the carry set (a word call) the reading position
E0F3                             ; then becomes the address in the letter cell at LET,Y.
E0F3   68           PUSHN:    PLA      
E0F4   68                     PLA      ; drop the step frame
E0F5   A5 01                  LDA   IP+1   
E0F7   48                     PHA      
E0F8   A5 00                  LDA   IP   
E0FA   48                     PHA      
E0FB   90 0A                  BCC   nxt   
E0FD   B9 00 04               LDA   LET,Y   
E100   85 00                  STA   IP   
E102   B9 01 04               LDA   LET+1,Y   
E105   85 01                  STA   IP+1   
E107   4C 2A E0     NXT:      JMP   next   
E10A                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E10A                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E10A                             ; the body"s address instead. Either way it then skips to the matching "]'.
E10A                             ; (The unchecked build takes anything that is not a letter as the space; the
E10A                             ; checked build stops on it.)
E10A                          IF   CHECKED   
E10A   C0 DF        DEF1:     CPY   #" "-"A"+256   
E10C   F0 2C                  BEQ   def2   
E10E                             ; W: anything but a letter or a space after [. The place is that character,
E10E                             ; one past the [.
E10E   EE 36 04               INC   PLACE   
E111   D0 03                  BNE   eb1   
E113   EE 37 04               INC   PLACE+1   
E116   A9 57        EB1:      LDA   #"W"   
E118   D0 A5                  BNE   ejmp   ; always
E11A                             ; A false ( skips: the wrong closer for it is ].
E11A   A9 5D        SKPAR:    LDA   #"]"   
E11C   D0 21                  BNE   skip   ; always
E11E                          ENDIF      
E11E   20 18 E2     H_DEF:    JSR   getc   
E121   38                     SEC      
E122   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E124   A8                     TAY      ;   lands 64 bytes up
E125   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E127   C9 1A                  CMP   #26   
E129                          IF   1-CHECKED   
                              BCS   def2   ; not a letter
E129                          ENDIF      
E129                          IF   CHECKED   
E129   B0 DF                  BCS   def1   
E12B                          ENDIF      
E12B   98                     TYA      
E12C   0A                     ASL      
E12D   A8                     TAY      ; Y -> the cell
E12E   A5 00                  LDA   IP   
E130   99 00 04               STA   LET,Y   
E133   A5 01                  LDA   IP+1   
E135   99 01 04               STA   LET+1,Y   
E138   D0 03                  BNE   skdef   ; always: no program is in page zero
E13A   20 D4 E0     DEF2:     JSR   puship   ; an anonymous block: push its address
E13D                SKDEF:       
E13D                          IF   CHECKED   
E13D   A9 29                  LDA   #")"   ; the wrong closer for [
E13F                          ENDIF      
E13F                             ; skip: read past text to the closer at this level, and return it in A.
E13F                             ; Brackets of both kinds count together; strings are stepped over whole. A
E13F                             ; NUL first ends the program.
E13F                             ; In the checked build A holds, on the way in, the wrong closer for the
E13F                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E13F                             ; which takes either. Meeting the wrong closer at this level, or the end
E13F                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E13F                             ; which then ends the program as before.
E13F                SKIP:        
E13F                          IF   CHECKED   
E13F   85 04                  STA   T0   
E141                          ENDIF      
E141   A9 00                  LDA   #0   
E143   85 06                  STA   T2   ; depth
E145   20 18 E2     SK1:      JSR   getc   
E148                          IF   1-CHECKED   
                              BEQ   endprog   
E148                          ENDIF      
E148                          IF   CHECKED   
E148   F0 26                  BEQ   sknul   
E14A                          ENDIF      
E14A   C9 22                  CMP   #22h   
E14C   D0 05                  BNE   sk2   
E14E   20 88 E1               JSR   skipstr   ; leaves A = 22h (11h when checked), which
E151                             ;   matches nothing below
E151                          IF   CHECKED   
E151   F0 1D                  BEQ   sknul   ; the string ran into the end
E153                          ENDIF      
E153   C9 28        SK2:      CMP   #"("   
E155   F0 15                  BEQ   sk3   
E157   C9 5B                  CMP   #"["   
E159   F0 11                  BEQ   sk3   
E15B   C9 29                  CMP   #")"   
E15D   F0 04                  BEQ   sk4   
E15F   C9 5D                  CMP   #"]"   
E161   D0 E2                  BNE   sk1   
E163   C6 06        SK4:      DEC   T2   
E165   10 DE                  BPL   sk1   
E167                          IF   CHECKED   
E167   C5 04                  CMP   T0   
E169   F0 0C                  BEQ   e_nest   ; the wrong kind
E16B                          ENDIF      
E16B   60                     RTS      ; the closer at this level
E16C   E6 06        SK3:      INC   T2   
E16E   D0 D5                  BNE   sk1   
E170                          IF   CHECKED   
E170   A5 04        SKNUL:    LDA   T0   
E172   D0 03                  BNE   e_nest   ; ( and [ stop with N
E174   4C 09 FF               JMP   EXIT   ; \ ends the program
E177   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E179   2C                     DB   2Ch   ;   or the end: the place is the opener
E17A   A9 51        E_QUOTE:   LDA   #"Q"   ; a string from 22h runs into the end
E17C   4C 70 E5               JMP   error   
E17F                          ENDIF      
E17F                             ; 22h pushes the address of the text after it and skips the string.
E17F   20 D4 E0     H_STR:    JSR   puship   
E182                          IF   CHECKED   
E182   20 88 E1               JSR   skipstr   
E185   F0 F3                  BEQ   e_quote   ; it ran into the end: the place is the 22h
E187   60                     RTS      
E188                          ENDIF      
E188                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E188                             ; the next character, so "/"" does not end it.
E188                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E188                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E188                             ; text ended first (a NUL, also one just after "/").
E188                          IF   1-CHECKED   
                    SKIPSTR:   JSR   getc   
                              CMP   #"/"   
                              BEQ   ss0   
                              CMP   #22h   
                              BNE   skipstr   
                              RTS      
                    SS0:      JSR   incip   
                              BNE   skipstr   ; A is "/" here
E188                          ENDIF      
E188                          IF   CHECKED   
E188   20 18 E2     SKIPSTR:   JSR   getc   
E18B   F0 09                  BEQ   ss9   ; the end
E18D   C9 2F                  CMP   #"/"   
E18F   D0 06                  BNE   ss1   
E191   20 18 E2               JSR   getc   ; the escaped character
E194   D0 F2                  BNE   skipstr   
E196   60           SS9:      RTS      ; the end, just after "/"
E197   C9 22        SS1:      CMP   #22h   
E199   D0 ED                  BNE   skipstr   
E19B   4A                     LSR      ; A = 11h, Z clear
E19C   60                     RTS      
E19D                          ENDIF      
E19D                             ; =============================================================================
E19D                             ;  Dispatch table: one handler per punctuation character, in code order.
E19D                             ;  Entries are handler-1 for the RTS trick.
E19D                             ; =============================================================================
E19D   35 E2        PTAB:     DW   h_store-1   ; !
E19F   7E E1                  DW   h_str-1   ; "
E1A1   67 E4                  DW   h_num-1   ; #
E1A3   34 E4                  DW   h_print-1   ; $
E1A5   55 E3                  DW   h_swap-1   ; %
E1A7   AA E2                  DW   h_and-1   ; &
E1A9   5F E4                  DW   h_emit-1   ; '
E1AB   ED E0                  DW   h_open-1   ; (
E1AD   7B E2                  DW   h_close-1   ; )
E1AF   2D E3                  DW   h_mul-1   ; *
E1B1   DC E2                  DW   h_add-1   ; +
E1B3   A2 E4                  DW   h_cfetch-1   ; ,
E1B5   D4 E2                  DW   h_sub-1   ; -
E1B7   47 E2                  DW   h_cstore-1   ; .
E1B9   6F E3                  DW   h_div-1   ; /
E1BB   E1 E0                  DW   push-1   ; :
E1BD   54 E2                  DW   drop-1   ; ;
E1BF   0B E3                  DW   h_lt-1   ; <
E1C1   1D E3                  DW   h_eq-1   ; =
E1C3   08 E3                  DW   h_gt-1   ; >
E1C5   AB E4                  DW   h_key-1   ; ?
E1C7   96 E4                  DW   h_fetch-1   ; @
E1C9   1D E1                  DW   h_def-1   ; [
E1CB   95 E2                  DW   h_break-1   ; \
E1CD   81 E2                  DW   h_ret-1   ; ]
E1CF   C6 E2                  DW   h_xor-1   ; ^
E1D1   E3 E3                  DW   h_alloc-1   ; _
E1D3   0C E5                  DW   h_grave-1   ; `
E1D5   60 E2                  DW   h_tor-1   ; {
E1D7   B8 E2                  DW   h_or-1   ; |
E1D9   6D E2                  DW   h_fromr-1   ; }
E1DB   F4 E2                  DW   h_not-1   ; ~
E1DD                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E1DD                             ; test is at the bottom so the loop closes with a branch. Returns with the
E1DD                             ; carry set.
E1DD   20 1B E2     RD1:      JSR   incip   ; (keeps A = the digit)
E1E0   06 02                  ASL   TL   
E1E2   26 03                  ROL   TH   ; x2
E1E4   18                     CLC      
E1E5   65 02                  ADC   TL   
E1E7   85 04                  STA   T0   
E1E9   A5 03                  LDA   TH   
E1EB   69 00                  ADC   #0   
E1ED   85 05                  STA   T1   ; T = x2 + digit
E1EF   06 02                  ASL   TL   
E1F1   26 03                  ROL   TH   
E1F3   06 02                  ASL   TL   
E1F5   26 03                  ROL   TH   ; x8
E1F7   18                     CLC      
E1F8   A5 02                  LDA   TL   
E1FA   65 04                  ADC   T0   
E1FC   85 02                  STA   TL   
E1FE   A5 03                  LDA   TH   
E200   65 05                  ADC   T1   
E202   85 03                  STA   TH   ; x8 + x2 + digit
E204   20 0A E2     RDNUM:    JSR   isdig   
E207   90 D4                  BCC   rd1   
E209   60                     RTS      
E20A                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E20A                             ; digit. Y = 0.
E20A   20 13 E2     ISDIG:    JSR   peek   
E20D   38                     SEC      
E20E   E9 30                  SBC   #"0"   
E210   C9 0A                  CMP   #10   
E212   60                     RTS      
E213                             ; =============================================================================
E213                             ;  Reading the program
E213                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E213                             ;    getc: the same, then IP moves on; flags follow A
E213                             ;    incip: IP moves on; keeps A, the carry and Y
E213                             ; =============================================================================
E213   A0 00        PEEK:     LDY   #0   
E215   B1 00                  LDA   (IP),Y   
E217   60                     RTS      
E218   20 13 E2     GETC:     JSR   peek   
E21B   E6 00        INCIP:    INC   IP   
E21D   D0 02                  BNE   ic1   
E21F   E6 01                  INC   IP+1   
E221   09 00        IC1:      ORA   #0   
E223   60                     RTS      
E224                             ; rstip: point IP at the start of the program
E224   A9 00        RSTIP:    LDA   #<PROG   
E226   85 00                  STA   IP   
E228   A9 05                  LDA   #>PROG   
E22A   85 01                  STA   IP+1   
E22C   60                     RTS      
E22D                             ; =============================================================================
E22D                             ;  Stack
E22D                             ; =============================================================================
E22D                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E22D   A5 02        FLAG:     LDA   TL   
E22F   05 03                  ORA   TH   
E231   20 55 E2               JSR   drop   
E234   A8                     TAY      ; (drop's INX changed the flags)
E235   60                     RTS      
E236                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E236                H_STORE:      
E236                          IF   CHECKED   
E236   A5 02                  LDA   TL   ; both bytes must be in the program's space:
E238   69 01                  ADC   #1   ; check the page of addr+1 (the carry is
E23A   A5 03                  LDA   TH   ; clear on the way in)
E23C   69 00                  ADC   #0   
E23E   20 21 E4               JSR   chkst   
E241                          ENDIF      
E241   BD 00 03               LDA   DSH,X   
E244   A0 01                  LDY   #1   
E246   91 02                  STA   (TL),Y   
E248                H_CSTORE:      ; "." ( c addr -- )
E248                          IF   CHECKED   
E248   A5 03                  LDA   TH   
E24A   20 21 E4               JSR   chkst   
E24D                          ENDIF      
E24D   BD 00 02               LDA   DSL,X   
E250   A0 00                  LDY   #0   
E252   91 02                  STA   (TL),Y   
E254   E8                     INX      ; falls into drop
E255                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E255                             ; it returns with Z clear.
E255   BC 00 02     DROP:     LDY   DSL,X   
E258   84 02                  STY   TL   
E25A   BC 00 03               LDY   DSH,X   
E25D   84 03                  STY   TH   
E25F   E8                     INX      
E260   60                     RTS      
E261                             ; "{" TOS to the return stack, "}" return stack to TOS
E261   68           H_TOR:    PLA      
E262   68                     PLA      
E263   A5 03                  LDA   TH   
E265   48                     PHA      
E266   A5 02                  LDA   TL   
E268   48                     PHA      
E269   20 55 E2               JSR   drop   
E26C   D0 0B                  BNE   nxt2   ; always
E26E   68           H_FROMR:   PLA      
E26F   68                     PLA      
E270   20 E2 E0               JSR   push   
E273   68                     PLA      
E274   85 02                  STA   TL   
E276   68                     PLA      
E277   85 03                  STA   TH   
E279   4C 2A E0     NXT2:     JMP   next   
E27C                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E27C                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E27C                             ; it is here, the address popped is pushed back.
E27C   20 2D E2     H_CLOSE:   JSR   flag   
E27F   F0 23                  BEQ   rdrop   
E281   24                     DB   24h   ; (BIT zp: steps over the SEC)
E282                             ; "]" returns: pull an address and jump to it.
E282   38           H_RET:    SEC      
E283                          IF   CHECKED   
E283   20 5F E5               JSR   chkbrk   ; Ctrl-C is checked at every loop-back and
E286                          ENDIF      ;   every word return (it keeps the carry)
E286   68                     PLA      
E287   68                     PLA      ; drop the step frame
E288   68                     PLA      
E289   85 00                  STA   IP   
E28B   68                     PLA      
E28C   85 01                  STA   IP+1   
E28E   B0 E9                  BCS   nxt2   
E290   48                     PHA      ; ")": keep the block start
E291   A5 00                  LDA   IP   
E293   48                     PHA      
E294   90 E3                  BCC   nxt2   ; always
E296                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E296                             ; drops the block start, "]" returns.
E296   20 2D E2     H_BREAK:   JSR   flag   
E299   F0 6D                  BEQ   ab9   
E29B                          IF   CHECKED   
E29B   A9 00                  LDA   #0   ; \ takes either closer
E29D                          ENDIF      
E29D   20 3F E1               JSR   skip   
E2A0   C9 29                  CMP   #")"   
E2A2   D0 DE                  BNE   h_ret   
E2A4   68           RDROP:    PLA      
E2A5   68                     PLA      
E2A6   68                     PLA      
E2A7   68                     PLA      
E2A8   4C 2A E0               JMP   next   
E2AB                             ; =============================================================================
E2AB                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E2AB                             ; =============================================================================
E2AB                             ; The logic operators leave the carry as they found it, clear, so they can
E2AB                             ; branch to fin.
E2AB   BD 00 02     H_AND:    LDA   DSL,X   
E2AE   25 02                  AND   TL   
E2B0   85 02                  STA   TL   
E2B2   BD 00 03               LDA   DSH,X   
E2B5   25 03                  AND   TH   
E2B7   90 31                  BCC   fin   ; always
E2B9   BD 00 02     H_OR:     LDA   DSL,X   
E2BC   05 02                  ORA   TL   
E2BE   85 02                  STA   TL   
E2C0   BD 00 03               LDA   DSH,X   
E2C3   05 03                  ORA   TH   
E2C5   90 23                  BCC   fin   ; always
E2C7   BD 00 02     H_XOR:    LDA   DSL,X   
E2CA   45 02                  EOR   TL   
E2CC   85 02                  STA   TL   
E2CE   BD 00 03               LDA   DSH,X   
E2D1   45 03                  EOR   TH   
E2D3   90 15                  BCC   fin   ; always
E2D5                             ; "-" has two jobs: directly before a digit it starts a negative number.
E2D5   20 0A E2     H_SUB:    JSR   isdig   
E2D8   90 14                  BCC   negnum   
E2DA   20 FB E2     SUB1:     JSR   neg   ; a - b = a + (-b)
E2DD   18           H_ADD:    CLC      
E2DE   BD 00 02               LDA   DSL,X   
E2E1   65 02                  ADC   TL   
E2E3   85 02                  STA   TL   
E2E5   BD 00 03               LDA   DSH,X   
E2E8   65 03                  ADC   TH   ; falls into fin
E2EA                             ; fin: finish a two-operand op: A = the high byte of the result
E2EA   85 03        FIN:      STA   TH   
E2EC   E8                     INX      
E2ED   60                     RTS      
E2EE   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E2F0   20 C7 E0               JSR   digit   ; (comes back with the carry set)
E2F3   B0 06                  BCS   neg   ; always: the number, negated
E2F5                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E2F5   90 05        H_NOT:    BCC   neg1   ; always
E2F7                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E2F7   A5 03        ABSV:     LDA   TH   
E2F9   10 0D        NEGM:     BPL   ab9   
E2FB                             ; neg: TOS = -TOS
E2FB   38           NEG:      SEC      
E2FC   A9 00        NEG1:     LDA   #0   
E2FE   E5 02                  SBC   TL   
E300   85 02                  STA   TL   
E302   A9 00                  LDA   #0   
E304   E5 03                  SBC   TH   
E306   85 03                  STA   TH   
E308   60           AB9:      RTS      
E309                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E309                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E309   20 56 E3     H_GT:     JSR   h_swap   ; a > b is b < a
E30C   BD 00 02     H_LT:     LDA   DSL,X   
E30F   C5 02                  CMP   TL   
E311   BD 00 03               LDA   DSH,X   
E314   E5 03                  SBC   TH   
E316   70 02                  BVS   lt1   
E318   49 80                  EOR   #80h   
E31A   0A           LT1:      ASL      
E31B   E8                     INX      ; (keeps the carry; never leaves X at 0)
E31C   D0 07                  BNE   bool   ; always
E31E   20 DA E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E321   05 02                  ORA   TL   
E323   C9 01                  CMP   #1   ; carry clear if A = 0
E325   A9 00        BOOL:     LDA   #0   
E327   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E329   85 02                  STA   TL   
E32B   85 03                  STA   TH   
E32D   60                     RTS      
E32E                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E32E                             ; bottom while the product comes in at the top, through A:T0 above it; after
E32E                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E32E   A0 10        H_MUL:    LDY   #16   
E330   84 05                  STY   T1   ; the round count
E332   A9 00                  LDA   #0   
E334   85 04                  STA   T0   ; A:T0 = the upper half
E336   46 03                  LSR   TH   
E338   66 02                  ROR   TL   ; the first multiplier bit
E33A   90 0D        ML1:      BCC   ml2   
E33C   A8                     TAY      
E33D   18                     CLC      
E33E   A5 04                  LDA   T0   
E340   7D 00 02               ADC   DSL,X   
E343   85 04                  STA   T0   
E345   98                     TYA      
E346   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E349   6A           ML2:      ROR      
E34A   66 04                  ROR   T0   
E34C   66 03                  ROR   TH   
E34E   66 02                  ROR   TL   ; everything one place right; next bit out
E350   C6 05                  DEC   T1   
E352   D0 E6                  BNE   ml1   
E354   E8                     INX      ; drop the multiplicand
E355   60                     RTS      
E356   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E359   A5 02                  LDA   TL   
E35B   9D 00 02               STA   DSL,X   
E35E   84 02                  STY   TL   
E360   BC 00 03               LDY   DSH,X   
E363   A5 03                  LDA   TH   
E365   9D 00 03               STA   DSH,X   
E368   84 03                  STY   TH   
E36A   60                     RTS      
E36B                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E36B                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E36B                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E36B                             ; it stops with Z.
E36B                          IF   CHECKED   
E36B   A9 5A        E_ZERO:   LDA   #"Z"   ; divide by zero, the stack as it was
E36D   4C 70 E5               JMP   error   
E370                          ENDIF      
E370                H_DIV:       
E370                          IF   CHECKED   
E370   A5 02                  LDA   TL   
E372   05 03                  ORA   TH   
E374   F0 F5                  BEQ   e_zero   
E376                          ENDIF      
E376   BD 00 03               LDA   DSH,X   
E379   48                     PHA      ; a's sign: for r
E37A   45 03                  EOR   TH   
E37C   48                     PHA      ; a xor b: for q
E37D   20 F7 E2               JSR   absv   
E380   A5 02                  LDA   TL   
E382   85 08                  STA   D0   
E384   A5 03                  LDA   TH   
E386   85 09                  STA   D1   ; D = |b|
E388   BD 00 02               LDA   DSL,X   
E38B   85 02                  STA   TL   
E38D   BD 00 03               LDA   DSH,X   
E390   85 03                  STA   TH   
E392   20 F7 E2               JSR   absv   ; TOS = |a|
E395   20 A3 E3               JSR   udiv   ; TOS = q, NOS = r
E398   68                     PLA      
E399   20 F9 E2               JSR   negm   ; q's sign
E39C   20 56 E3               JSR   h_swap   ; r on top
E39F   68                     PLA      
E3A0   4C F9 E2               JMP   negm   ; r's sign
E3A3                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E3A3                             ; cell the remainder (whatever was there is lost).
E3A3                             ; Dividing by 2 is one shift (the spec wants that fast).
E3A3   A9 00        UDIV:     LDA   #0   
E3A5   9D 00 02               STA   DSL,X   
E3A8   9D 00 03               STA   DSH,X   
E3AB   A5 08                  LDA   D0   
E3AD   49 02                  EOR   #2   
E3AF   05 09                  ORA   D1   
E3B1   D0 08                  BNE   ud0   
E3B3   46 03                  LSR   TH   
E3B5   66 02                  ROR   TL   ; the quotient
E3B7   3E 00 02               ROL   DSL,X   ; the remainder: the bit that fell out
E3BA   60                     RTS      
E3BB   A0 10        UD0:      LDY   #16   
E3BD   06 02        UD1:      ASL   TL   
E3BF   26 03                  ROL   TH   
E3C1   3E 00 02               ROL   DSL,X   
E3C4   3E 00 03               ROL   DSH,X   
E3C7   38                     SEC      
E3C8   BD 00 02               LDA   DSL,X   
E3CB   E5 08                  SBC   D0   
E3CD   85 04                  STA   T0   
E3CF   BD 00 03               LDA   DSH,X   
E3D2   E5 09                  SBC   D1   
E3D4   90 0A                  BCC   ud2   
E3D6   9D 00 03               STA   DSH,X   
E3D9   A5 04                  LDA   T0   
E3DB   9D 00 02               STA   DSL,X   
E3DE   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E3E0   88           UD2:      DEY      
E3E1   D0 DA                  BNE   ud1   
E3E3   60           UD9:      RTS      
E3E4                             ; =============================================================================
E3E4                             ;  Storage
E3E4                             ; =============================================================================
E3E4                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E3E4                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E3E4                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   TL   
                              STA   HEAP   
                              STY   TL   
                              LDA   HEAP+1   
                              TAY      
                              ADC   TH   
                              STA   HEAP+1   
                              STY   TH   
                              RTS      
E3E4                          ENDIF      
E3E4                             ; The checked build works the new top out first, in T0 and Y, and stops with
E3E4                             ; H, the count still on the stack, if it is at or past the limit, below the
E3E4                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E3E4                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E3E4                             ; a signed number from -8000h, so the add overflows exactly when the true
E3E4                             ; sum leaves 0000h-FFFFh.
E3E4                          IF   CHECKED   
E3E4   AD 7C 04     H_ALLOC:   LDA   HEAP   
E3E7   65 02                  ADC   TL   
E3E9   85 04                  STA   T0   
E3EB   AD 7D 04               LDA   HEAP+1   
E3EE   49 80                  EOR   #80h   
E3F0   65 03                  ADC   TH   
E3F2   70 25                  BVS   e_heap   ; wrapped
E3F4   49 80                  EOR   #80h   ; the new top's high byte
E3F6   C9 E0                  CMP   #HEAPLIM   
E3F8   B0 1F                  BCS   e_heap   ; at or past the limit
E3FA   A8                     TAY      
E3FB   A5 04                  LDA   T0   
E3FD   CD 38 04               CMP   PEND   
E400   98                     TYA      
E401   ED 39 04               SBC   PEND+1   
E404   90 13                  BCC   e_heap   ; below the program's end
E406   AD 7C 04               LDA   HEAP   
E409   85 02                  STA   TL   
E40B   A5 04                  LDA   T0   
E40D   8D 7C 04               STA   HEAP   
E410   AD 7D 04               LDA   HEAP+1   
E413   85 03                  STA   TH   
E415   8C 7D 04               STY   HEAP+1   
E418   60                     RTS      
E419                             ; Errors found by handlers. The stacks are as they were before the handler.
E419   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E41B   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E41C   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E41E   4C 70 E5               JMP   error   
E421                             ; chkst: stop unless the page in A is in the program's own space, from the
E421                             ; letter page up to the heap limit. Keeps Y.
E421   C9 04        CHKST:    CMP   #LETPAGE   
E423   90 F7                  BCC   e_store   
E425   C9 E0                  CMP   #HEAPLIM   
E427   B0 F3                  BCS   e_store   
E429   60                     RTS      
E42A                          ENDIF      
E42A                             ; =============================================================================
E42A                             ;  Console
E42A                             ; =============================================================================
E42A                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E42A   A0 00        TOSGET:   LDY   #0   
E42C   B1 02                  LDA   (TL),Y   
E42E   E6 02        INCTOS:   INC   TL   
E430   D0 02                  BNE   tg1   
E432   E6 03                  INC   TH   
E434   60           TG1:      RTS      
E435                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E435                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E435                             ; bit 6, so // and /" give themselves).
E435                             ; The checked build walks a copy of TOS along the string, so that the address
E435                             ; is still there if it stops with Q on a NUL.
E435                H_PRINT:      
E435                          IF   CHECKED   
E435   20 E2 E0               JSR   push   ; the copy
E438   20 3E E4               JSR   pr0   
E43B   4C 55 E2               JMP   drop   
E43E                PR0:         
E43E                          ENDIF      
E43E   20 2A E4               JSR   tosget   
E441   C9 22                  CMP   #22h   
E443   F0 20                  BEQ   pdrop   
E445                          IF   CHECKED   
E445   C9 00                  CMP   #0   
E447   F0 0F                  BEQ   e_qpr   
E449                          ENDIF      
E449   C9 2F                  CMP   #"/"   
E44B   D0 05                  BNE   pr1   
E44D   20 2A E4               JSR   tosget   
E450   29 BF                  AND   #0BFh   
E452   20 03 FF     PR1:      JSR   CONOUT   
E455                          IF   1-CHECKED   
                              JMP   h_print   
E455                          ENDIF      
E455                          IF   CHECKED   
E455   4C 3E E4               JMP   pr0   
E458   20 55 E2     E_QPR:    JSR   drop   ; the copy goes: the address is TOS again
E45B   A9 51                  LDA   #"Q"   ; $ ran into the end
E45D   4C 70 E5               JMP   error   
E460                          ENDIF      
E460   A5 02        H_EMIT:   LDA   TL   ; "'"
E462   20 03 FF               JSR   CONOUT   
E465   4C 55 E2     PDROP:    JMP   drop   
E468                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E468                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E468                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E468   A5 03        H_NUM:    LDA   TH   
E46A   10 08                  BPL   pn1   
E46C   A9 2D                  LDA   #"-"   
E46E   20 03 FF               JSR   CONOUT   
E471   20 FB E2               JSR   neg   
E474   CA           PN1:      DEX      ; the spare cell
E475   A9 0A                  LDA   #10   
E477   85 08                  STA   D0   
E479   A9 00                  LDA   #0   
E47B   85 09                  STA   D1   
E47D   48                     PHA      ; the end marker
E47E   20 A3 E3     PN2:      JSR   udiv   
E481   BD 00 02               LDA   DSL,X   
E484   09 30                  ORA   #"0"   
E486   48                     PHA      
E487   A5 02                  LDA   TL   
E489   05 03                  ORA   TH   
E48B   D0 F1                  BNE   pn2   
E48D   E8                     INX      
E48E   68           PN3:      PLA      
E48F   F0 D4                  BEQ   pdrop   
E491   20 03 FF               JSR   CONOUT   
E494   4C 8E E4               JMP   pn3   
E497   A0 01        H_FETCH:   LDY   #1   ; "@"
E499   B1 02                  LDA   (TL),Y   
E49B   48                     PHA      ; the high byte, while "," gets the low one
E49C   20 A3 E4               JSR   h_cfetch   
E49F   68                     PLA      
E4A0   85 03                  STA   TH   
E4A2   60                     RTS      
E4A3                H_CFETCH:      ; ","
E4A3   A0 00                  LDY   #0   
E4A5   B1 02                  LDA   (TL),Y   
E4A7   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E4A9   84 03                  STY   TH   
E4AB   60                     RTS      
E4AC                             ; "?" ( n -- c ) or ( -n -- addr )
E4AC                             ;   n > 0: wait about n ms for a key; 0 if none came
E4AC                             ;   n = 0: wait for a key
E4AC                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E4AC                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E4AC   A5 03        H_KEY:    LDA   TH   
E4AE   30 20                  BMI   line   
E4B0   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E4B2   20 4F E5     KT2:      JSR   getk   
E4B5   D0 15                  BNE   kt3   
E4B7   88                     DEY      
E4B8   D0 F8                  BNE   kt2   
E4BA   A5 02                  LDA   TL   ; count the millisecond off:
E4BC   D0 06                  BNE   kt4   
E4BE   A5 03                  LDA   TH   
E4C0   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E4C2   C6 03                  DEC   TH   
E4C4   C6 02        KT4:      DEC   TL   
E4C6   D0 E8                  BNE   kt1   
E4C8   A5 03                  LDA   TH   
E4CA   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E4CC   A0 00        KT3:      LDY   #0   
E4CE   F0 D7                  BEQ   cf2   ; always: TOS = A
E4D0                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E4D0                             ; (stored, not echoed), every other key is stored and echoed until the line
E4D0                             ; is full. Y = the length so far; TL = the most allowed.
E4D0   20 FB E2     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E4D3   D0 04                  BNE   ln0   
E4D5   A5 02                  LDA   TL   
E4D7   10 04                  BPL   ln1   
E4D9   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E4DB   85 02                  STA   TL   
E4DD   A0 00        LN1:      LDY   #0   
E4DF   F0 03                  BEQ   ln2   ; always
E4E1   20 03 FF     LN3:      JSR   CONOUT   
E4E4   20 4F E5     LN2:      JSR   getk   
E4E7   F0 FB                  BEQ   ln2   
E4E9   C9 0D                  CMP   #13   
E4EB   F0 14                  BEQ   ln5   
E4ED   C9 08                  CMP   #8   
E4EF   F0 0A                  BEQ   ln4   
E4F1   C4 02                  CPY   TL   
E4F3   B0 EF                  BCS   ln2   ; full
E4F5   99 80 04               STA   LINEBUF,Y   
E4F8   C8                     INY      
E4F9   D0 E6                  BNE   ln3   ; always: echo it
E4FB   88           LN4:      DEY      ; Backspace: one back, and echo it,
E4FC   10 E3                  BPL   ln3   
E4FE   C8                     INY      ;   unless the line was empty
E4FF   F0 E3                  BEQ   ln2   ; always
E501   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E504   A9 80                  LDA   #<LINEBUF   
E506   85 02                  STA   TL   
E508   A9 04                  LDA   #>LINEBUF   
E50A   85 03                  STA   TH   
E50C   60                     RTS      
E50D                             ; =============================================================================
E50D                             ;  Machine code: the grave
E50D                             ; =============================================================================
E50D                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E50D                             ; are stored from addr until a non-hex character; then a RET (60h) is
E50D                             ; written and its address is left. An odd last digit is consumed and dropped.
E50D                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E50D                             ; contract in the header.
E50D   20 3C E5     H_GRAVE:   JSR   rdhex   
E510   B0 1C                  BCS   exec   
E512   0A           HX1:      ASL      
E513   0A                     ASL      
E514   0A                     ASL      
E515   0A                     ASL      
E516   85 04                  STA   T0   
E518   20 3C E5               JSR   rdhex   
E51B   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E51D   05 04                  ORA   T0   
E51F   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
E521   20 2E E4               JSR   inctos   
E524   20 3C E5               JSR   rdhex   
E527   90 E9                  BCC   hx1   
E529   A9 60        HX2:      LDA   #60h   
E52B   91 02                  STA   (TL),Y   
E52D   60                     RTS      
E52E   A5 02        EXEC:     LDA   TL   
E530   85 04                  STA   T0   
E532   A5 03                  LDA   TH   
E534   85 05                  STA   T1   
E536   20 55 E2               JSR   drop   ; the address is consumed
E539   6C 04 00               JMP   (T0)   
E53C                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E53C                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E53C                             ; Y = 0.
E53C   20 0A E2     RDHEX:    JSR   isdig   
E53F   90 0A                  BCC   rh1   
E541   29 DF                  AND   #0DFh   
E543   E9 11                  SBC   #11h   ; (the carry is set)
E545   C9 06                  CMP   #6   
E547   B0 05                  BCS   rh9   
E549   69 0A                  ADC   #10   
E54B   4C 1B E2     RH1:      JMP   incip   
E54E   60           RH9:      RTS      
E54F                             ; =============================================================================
E54F                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E54F                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E54F                             ;  Both keep X and Y. In the unchecked build getk is the host's KEY itself.
E54F                             ; =============================================================================
E54F                          IF   1-CHECKED   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
E54F                          ENDIF      
E54F                          IF   CHECKED   
E54F   AD 34 04     GETK:     LDA   KEYBUF   ; a key held back by the break check
E552   F0 08                  BEQ   gk1   
E554   48                     PHA      
E555   A9 00                  LDA   #0   
E557   8D 34 04               STA   KEYBUF   
E55A   68                     PLA      
E55B   60                     RTS      
E55C   4C 06 FF     GK1:      JMP   KEY   
E55F                          ENDIF      
E55F                             ; =============================================================================
E55F                             ;  Checked build: break key and error reports
E55F                             ; =============================================================================
E55F                          IF   CHECKED   
E55F                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
E55F                             ; else is held for the next "?". Keeps the flags.
E55F   08           CHKBRK:   PHP      
E560   20 4F E5               JSR   getk   
E563   F0 07                  BEQ   cb9   
E565   C9 03                  CMP   #3   
E567   F0 05                  BEQ   e_break   
E569   8D 34 04               STA   KEYBUF   
E56C   28           CB9:      PLP      
E56D   60                     RTS      
E56E   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C
E570                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E570                             ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
E570                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E570                             ; its depth is shown.
E570                             ;   CR LF
E570                             ;   Err X @ line,col CR LF
E570                             ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
E570                             ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
E570                             ;   Rtn n CR LF
E570                             ; The numbers go through "#" (prnum), which pushes them over the data stack
E570                             ; and pops them again, so the stack is shown as it was.
E570   48           ERROR:    PHA      ; the letter
E571   AD 36 04               LDA   PLACE   
E574   85 0A                  STA   P   
E576   AD 37 04               LDA   PLACE+1   
E579   85 0B                  STA   P+1   
E57B   A0 00                  LDY   #M_ERR-MSG   
E57D   20 18 E6               JSR   prs   ; CR LF "Err "
E580   68                     PLA      
E581   20 03 FF               JSR   CONOUT   
E584   20 18 E6               JSR   prs   ; " @ " (it follows M_ERR)
E587   20 43 E6               JSR   lcol   
E58A   A5 08                  LDA   D0   
E58C   A4 09                  LDY   D1   
E58E   20 12 E6               JSR   prnum   ; the line
E591   A9 2C                  LDA   #","   
E593   20 03 FF               JSR   CONOUT   
E596   A5 05                  LDA   T1   
E598   A4 06                  LDY   T2   
E59A   20 12 E6               JSR   prnum   ; the column
E59D   A0 09                  LDY   #M_NL-MSG   
E59F   20 18 E6               JSR   prs   
E5A2   A0 00                  LDY   #0   ; the text at the place
E5A4   B1 0A        ER1:      LDA   (P),Y   
E5A6   F0 10                  BEQ   er2   
E5A8   C9 0D                  CMP   #13   
E5AA   F0 0C                  BEQ   er2   
E5AC   C9 0A                  CMP   #10   
E5AE   F0 08                  BEQ   er2   
E5B0   20 03 FF               JSR   CONOUT   
E5B3   C8                     INY      
E5B4   C0 10                  CPY   #16   
E5B6   D0 EC                  BNE   er1   
E5B8   A0 0B        ER2:      LDY   #M_STK-MSG   
E5BA   20 18 E6               JSR   prs   ; CR LF "Stk "
E5BD   8A                     TXA      
E5BE   49 FF                  EOR   #0FFh   
E5C0   38                     SEC      
E5C1   E9 03                  SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
E5C3   48                     PHA      
E5C4   A0 00                  LDY   #0   
E5C6   20 12 E6               JSR   prnum   
E5C9   68                     PLA      
E5CA   A0 16                  LDY   #M_C-MSG   ; ":"
E5CC   C9 09                  CMP   #9   
E5CE   90 04                  BCC   er3   
E5D0   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E5D2   A0 11                  LDY   #M_CD-MSG   
E5D4   85 05        ER3:      STA   T1   ; T1 = how many cells to show
E5D6   20 18 E6               JSR   prs   
E5D9   20 E2 E0               JSR   push   ; TOS into memory with the rest: cell i from
E5DC                             ;   the top is at DSL+X+i now
E5DC   A5 05        ER4:      LDA   T1   ; cells T1-1 down to 0, the top last
E5DE   F0 1B                  BEQ   er5   
E5E0   C6 05                  DEC   T1   
E5E2   A9 20                  LDA   #" "   
E5E4   20 03 FF               JSR   CONOUT   
E5E7   8A                     TXA      
E5E8   18                     CLC      
E5E9   65 05                  ADC   T1   
E5EB   A8                     TAY      
E5EC   B9 00 02               LDA   DSL,Y   
E5EF   48                     PHA      
E5F0   B9 00 03               LDA   DSH,Y   
E5F3   A8                     TAY      
E5F4   68                     PLA      
E5F5   20 12 E6               JSR   prnum   
E5F8   4C DC E5               JMP   er4   
E5FB   A0 17        ER5:      LDY   #M_RTN-MSG   
E5FD   20 18 E6               JSR   prs   ; CR LF "Rtn "
E600   A5 07                  LDA   RSV   
E602   49 FF                  EOR   #0FFh   
E604   4A                     LSR      ; (FFh - S) / 2 entries
E605   A0 00                  LDY   #0   
E607   20 12 E6               JSR   prnum   
E60A   A0 09                  LDY   #M_NL-MSG   
E60C   20 18 E6               JSR   prs   
E60F   4C 09 FF               JMP   EXIT   
E612                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack
E612   20 D8 E0     PRNUM:    JSR   pushay   
E615   4C 68 E4               JMP   h_num   
E618                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E618                             ; past it, at the next message.
E618   B9 26 E6     PRS:      LDA   MSG,Y   
E61B   48                     PHA      
E61C   29 7F                  AND   #7Fh   
E61E   20 03 FF               JSR   CONOUT   
E621   C8                     INY      
E622   68                     PLA      
E623   10 F3                  BPL   prs   
E625   60                     RTS      
E626                MSG:         
E626   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E62C   20 40 A0               DB   " @"," "+80h   
E62F   0D 8A        M_NL:     DB   13,10+80h   
E631   0D 0A 53 74 6B A0 M_STK:   DB   13,10,"Stk"," "+80h   
E637   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E63C   BA           M_C:      DB   ":"+80h   
E63D   0D 0A 52 74 6E A0 M_RTN:   DB   13,10,"Rtn"," "+80h   
E643                             ; lcol: the line (D0/D1) and the column (T1/T2) of the place at P, both from
E643                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
E643                             ; column is the place in the buffer. Otherwise the LFs before the place are
E643                             ; counted from PROG; T1/T2 holds the address before the line's first
E643                             ; character (the last LF, or PROG - 1), and the column is P minus that.
E643   A0 00        LCOL:     LDY   #0   
E645   84 09                  STY   D1   
E647   84 08                  STY   D0   
E649   A9 7F                  LDA   #<LBM1   
E64B   85 05                  STA   T1   
E64D   A9 04                  LDA   #>LBM1   
E64F   85 06                  STA   T2   
E651   A5 0A                  LDA   P   
E653   C9 00                  CMP   #<PROG   
E655   A5 0B                  LDA   P+1   
E657   E9 05                  SBC   #>PROG   
E659   90 34                  BCC   lc9   ; below the program: line 0
E65B   E6 08                  INC   D0   
E65D   A9 FF                  LDA   #<PROGM1   
E65F   85 0C                  STA   Q   
E661   85 05                  STA   T1   
E663   A9 04                  LDA   #>PROGM1   
E665   85 0D                  STA   Q+1   
E667   85 06                  STA   T2   
E669   E6 0C        LC1:      INC   Q   ; the next character
E66B   D0 02                  BNE   lc2   
E66D   E6 0D                  INC   Q+1   
E66F   A5 0C        LC2:      LDA   Q   
E671   C5 0A                  CMP   P   
E673   A5 0D                  LDA   Q+1   
E675   E5 0B                  SBC   P+1   
E677   B0 16                  BCS   lc9   ; at the place
E679   B1 0C                  LDA   (Q),Y   
E67B   C9 0A                  CMP   #10   
E67D   D0 EA                  BNE   lc1   
E67F   E6 08                  INC   D0   ; an LF: a new line starts after it
E681   D0 02                  BNE   lc3   
E683   E6 09                  INC   D1   
E685   A5 0C        LC3:      LDA   Q   
E687   85 05                  STA   T1   
E689   A5 0D                  LDA   Q+1   
E68B   85 06                  STA   T2   
E68D   D0 DA                  BNE   lc1   ; always: no program is in page zero
E68F   A5 0A        LC9:      LDA   P   
E691   38                     SEC      
E692   E5 05                  SBC   T1   
E694   85 05                  STA   T1   
E696   A5 0B                  LDA   P+1   
E698   E5 06                  SBC   T2   
E69A   85 06                  STA   T2   
E69C   60                     RTS      
E69D                          ENDIF      


