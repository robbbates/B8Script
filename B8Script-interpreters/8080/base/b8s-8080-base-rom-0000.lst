02B4                             ; psgn: print HL as a signed number. Uses BC.
02B4   7C           PSGN:     MOV   A,H   
02B5   B7                     ORA   A   
02B6   F2 BD 02               JP   pdec   
02B9   3E 2D                  MVI   A,"-"   
02BB                          ;*Macro unroll:  PUTA
02BB   EF                     DS   1-CPM,0EFh   
02BC                          DS   CPM,0CDh   
02BC                          DS   CPM,APUT&0FFh   
02BC                          DS   CPM,APUT/256   
02BC                          ;*Macro unroll:  NEGH
02BC   E7                     DS   1-CPM,0E7h   
02BD                          DS   CPM,0CDh   
02BD                          DS   CPM,ANEG&0FFh   
02BD                          DS   CPM,ANEG/256   
02BD                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02BD                             ; Uses BC.
02BD   11 0A 00     PDEC:     LXI   D,10   
02C0   CD 5C 02               CALL   udiv   ; HL = HL / 10, C = the last digit
02C3   79                     MOV   A,C   
02C4   F5                     PUSH   PSW   
02C5   7C                     MOV   A,H   
02C6   B5                     ORA   L   
02C7   C4 BD 02               CNZ   pdec   
02CA   F1                     POP   PSW   
02CB   C6 30                  ADI   "0"   
02CD                          ;*Macro unroll:  PUTA
02CD   EF                     DS   1-CPM,0EFh   
02CE                          DS   CPM,0CDh   
02CE                          DS   CPM,APUT&0FFh   
02CE                          DS   CPM,APUT/256   
02CE   C9                     RET      
02CF                             ; (The table goes here instead in the builds where, before the routines, it
02CF                             ; would cross a page: PTLATE. If it would cross one here too, it starts on
02CF                             ; the next page: PTPAD is 0 unless it must.)
02CF                          IF   (1-FAST)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02CF                          ENDIF      
02CF                          IF   1-CHECKED   
                                 ; "$" prints the string at TOS (see h_print).
                    PRLP:     MOV   A,M   
                              INX   H   
                              CPI   22h   
                              JZ   h_drop   
                              CPI   "/"   
                              JNZ   pr1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   pr0   
                              CPI   7Fh   
                              JC   pesc   
                    PR0:      ANI   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prlp   
02CF                          ENDIF      
02CF                             ;-----------------------------------------------------------------------------
02CF                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
02CF                             ; HL points past it. Each goes back into the loop that prints the string
02CF                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
02CF                             ;    /a-/z   print the variable, as "#" does
02CF                             ;    /{      clear the screen, the cursor to the top left
02CF                             ;    /}      clear from the cursor to the end of the line
02CF                             ;    /|  /`  show the cursor, hide it
02CF                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
02CF   FE 7E        PESC:     CPI   7Eh   
02D1   CA F4 02               JZ   pat   
02D4   11 8A 04               LXI   D,PRLOOP   ; the others return into the loop
02D7   D5                     PUSH   D   
02D8   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
02DA   D2 06 03               JNC   pcon   
02DD   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
02DF   D2 0F 03               JNC   phide   
02E2   87                     ADD   A   ; the variable's cell
02E3   C6 40                  ADI   40h   
02E5   E5                     PUSH   H   
02E6   C5                     PUSH   B   
02E7   6F                     MOV   L,A   
02E8   26 82                  MVI   H,LETPAGE   
02EA   7E                     MOV   A,M   
02EB   2C                     INR   L   
02EC   66                     MOV   H,M   
02ED   6F                     MOV   L,A   
02EE   CD B4 02               CALL   psgn   
02F1   C1                     POP   B   
02F2   E1                     POP   H   
02F3   C9                     RET      
02F4                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
02F4                             ; the checked build "$" is the routine prstr: its own return address goes
02F4                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
02F4                             ; its two cells are there, and is s if not, before it prints anything.
02F4                PAT:         
02F4                          IF   CHECKED   
02F4   E3                     XTHL      ; the text pointer over prstr's return address
02F5   21 0A 7E               LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
02F8   39                     DAD   SP   
02F9   DA E5 04               JC   e_under   
02FC   E1                     POP   H   
02FD                          ENDIF      
02FD   D1                     POP   D   ; DE = the column
02FE   E3                     XTHL      ; HL = the row; the text pointer is kept
02FF                          IF   1-ANS   
02FF   CD 15 FF               CALL   CONAT   
0302   E1                     POP   H   
0303   C3 B4 01               JMP   PRAGAIN   
0306                             ; With ANSI = 0 the machine's routines do the rest.
0306   CA 0C FF     PCON:     JZ   CONCLS   ; /{
0309   FE 02                  CPI   2   
030B   CA 0F FF               JZ   CONEOL   ; /}
030E   FE                     DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
030F   AF           PHIDE:    XRA   A   ; /`  (A = 0: hide)
0310   C3 12 FF               JMP   CONCUR   
0313                          ENDIF      
0313                          IF   ANS   
                              PUSH   B   ; (pdec uses BC)
                              PUSH   D   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INX   H   
                              CALL   pdec   
                              MVI   A,";"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   H   
                              INX   H   
                              CALL   pdec   
                              MVI   A,"H"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   B   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
                    PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
                              MVI   A,"?"   
                              CALL   csia   
                              MVI   A,"2"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"5"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DCR   A   
                              JZ   pshow   ; /|
                              MVI   A,"K"   
                              JP   csia   ; /}  ESC [ K
                              MVI   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              MVI   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
                    CSIA:     PUSH   PSW   
                              CALL   csi   
                              POP   PSW   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                    CSI:      MVI   A,27   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"["   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
0313                          ENDIF      
0313                             ; skip: read past text to the closer at this level, and return A = 0 if it
0313                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0313                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0313                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0313                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0313                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
0313                             ; 
0313                             ; The checked build also looks at the character the skip was started by,
0313                             ; which is always the one just before where it starts: "(" must end at ")",
0313                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0313                             ; quote counts as running into it. "\" takes either closer. The place where
0313                             ; the skip started is kept on the stack, for the report.
0313                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
0313                          ENDIF      
0313                          IF   CHECKED*(1-QK)   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
0313                          ENDIF      
0313                          IF   1-QK   
                              MVI   D,0   
                    SK3:      INR   D   ; an opener: one deeper
                    SK1:      LDAX   B   
0313                          ENDIF      
0313                          IF   (1-CHECKED)*(1-QK)   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
0313                          ENDIF      
0313                          IF   CHECKED*(1-QK)   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
0313                          ENDIF      
0313                          IF   1-QK   
                              CPI   22h   
                              CZ   skipstr   ; leaves A = 22h, which matches nothing below
                              SUI   "("   ;   (or 0, and then the NUL is read next)
                              JZ   sk3   
                              DCR   A   ; ")"
                              JZ   sk4   
                              SUI   "["-")"   
                              JZ   sk3   
                              CPI   "]"-"["   
                              JNZ   sk1   
                    SK4:      DCR   D   
0313                          ENDIF      
0313                          IF   (1-CHECKED)*(1-QK)   
                              RZ      ; the closer at this level
                              JMP   sk1   
0313                          ENDIF      
0313                          IF   CHECKED*(1-QK)   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
0313                          ENDIF      
0313                          IF   QK   
0313                             ; The skip cache. Nearly every skip is one that has happened before (a loop
0313                             ; skips the same false block on every pass), so the first scan from each
0313                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
0313                             ; by the start's low byte (times 4). Only skips that start in the program
0313                             ; text are kept (the line buffer changes); the cache is emptied whenever a
0313                             ; run starts (see start). A program that changes its own text while it
0313                             ; runs is not looked after.
0313   78           SKIP:     MOV   A,B   
0314   FE 83                  CPI   PROG/256   
0316   DA 36 03               JC   sks   ; below the program text: no cache
0319   79                     MOV   A,C   
031A   87                     ADD   A   
031B   87                     ADD   A   
031C   5F                     MOV   E,A   
031D   16 F0                  MVI   D,CPAGE   ; DE -> the entry
031F   1A                     LDAX   D   
0320   B9                     CMP   C   
0321   C2 36 03               JNZ   sks   
0324   1C                     INR   E   
0325   1A                     LDAX   D   
0326   B8                     CMP   B   
0327   C2 36 03               JNZ   sks   
032A   1C                     INR   E   
032B   1A                     LDAX   D   
032C   4F                     MOV   C,A   
032D   1C                     INR   E   
032E   1A                     LDAX   D   
032F   47                     MOV   B,A   ; a hit: the IP is past the closer
0330   0B                     DCX   B   
0331   0A                     LDAX   B   
0332   03                     INX   B   
0333   D6 29                  SUI   ")"   ; 0 for ")", not 0 for "]"
0335   C9                     RET      
0336   C5           SKS:      PUSH   B   ; where it starts: the cache's key (and the
0337                          ENDIF      ;   checked report's place)
0337                          IF   QK*CHECKED   
0337   0B                     DCX   B   
0338   0A                     LDAX   B   
0339   03                     INX   B   
033A   5F                     MOV   E,A   ; E = the opener: ( [ or \
033B                          ENDIF      
033B                          IF   QK   
033B                             ; The scan. Most characters are nothing to it, and two range tests rule
033B                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
033B   16 00                  MVI   D,0   
033D   14           SQ3:      INR   D   ; an opener: one deeper
033E   0A           SQ1:      LDAX   B   
033F   03                     INX   B   
0340   FE 5E                  CPI   5Eh   
0342   D2 3E 03               JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
0345   FE 5B                  CPI   5Bh   
0347   D2 73 03               JNC   sqb   ; [ \ ]
034A   FE 2A                  CPI   2Ah   
034C   D2 3E 03               JNC   sq1   ; * to Z: nothing
034F   FE 28                  CPI   28h   
0351   CA 3D 03               JZ   sq3   ; (
0354   D2 7E 03               JNC   sqc   ; )
0357   FE 22                  CPI   22h   
0359   CA 6D 03               JZ   sqq   ; a string
035C   B7                     ORA   A   
035D   C2 3E 03               JNZ   sq1   ; the rest below "(": nothing
0360                          ENDIF      
0360                          IF   QK*(1-CHECKED)   
                              JMP   endprog   ; NUL: the end of the program
0360                          ENDIF      
0360                          IF   QK*CHECKED   
0360   0B                     DCX   B   ; NUL: the IP stays on it
0361   7B                     MOV   A,E   ; the text ran out:
0362   E6 04                  ANI   4   
0364   C2 7F 00               JNZ   endprog   ;   "\" with no closer ends the program
0367   C1                     POP   B   
0368   3E 4E        SQ7:      MVI   A,"N"   ; N. The place is the opener
036A   C3 14 05               JMP   errp   ; (errp drops skip's return address)
036D                          ENDIF      
036D                          IF   QK   
036D   CD AE 03     SQQ:      CALL   skipstr   ; step over the string
0370   C3 3E 03               JMP   sq1   
0373   D6 5C        SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
0375   CA 3E 03               JZ   sq1   ; "\" is nothing here
0378   DA 3D 03               JC   sq3   ; [
037B   3E 02                  MVI   A,2   ; ]
037D   FE                     DB   0FEh   ; (CPI: steps over the XRA)
037E   AF           SQC:      XRA   A   ; )
037F   15           SQ4:      DCR   D   
0380   C2 3E 03               JNZ   sq1   
0383                          ENDIF      
0383                          IF   QK*CHECKED   
0383   57                     MOV   D,A   ; the closer at this level (as above): 2 here
0384   AB                     XRA   E   ;   means the wrong closer
0385   E6 06                  ANI   6   
0387   FE 02                  CPI   2   
0389   7A                     MOV   A,D   
038A   D1                     POP   D   ; (where the skip started)
038B   C2 93 03               JNZ   sq8   
038E   42                     MOV   B,D   
038F   4B                     MOV   C,E   
0390   C3 68 03               JMP   sq7   
0393                SQ8:         
0393                          ENDIF      
0393                          IF   QK*(1-CHECKED)   
                              POP   D   ; where the skip started
0393                          ENDIF      
0393                          IF   QK   
0393                             ; The closer at this level: remember the skip (if it started in the program
0393                             ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
0393   E5                     PUSH   H   
0394   67                     MOV   H,A   
0395   7A                     MOV   A,D   
0396   FE 83                  CPI   PROG/256   
0398   DA AB 03               JC   sq9   
039B   7B                     MOV   A,E   
039C   87                     ADD   A   
039D   87                     ADD   A   
039E   6F                     MOV   L,A   
039F   7C                     MOV   A,H   
03A0   26 F0                  MVI   H,CPAGE   
03A2   73                     MOV   M,E   
03A3   2C                     INR   L   
03A4   72                     MOV   M,D   
03A5   2C                     INR   L   
03A6   71                     MOV   M,C   
03A7   2C                     INR   L   
03A8   70                     MOV   M,B   
03A9   E1                     POP   H   
03AA   C9                     RET      
03AB   7C           SQ9:      MOV   A,H   
03AC   E1                     POP   H   
03AD   C9                     RET      
03AE                          ENDIF      
03AE                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03AE                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03AE                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
03AE                          ENDIF      
03AE                          IF   CHECKED   
03AE                             ; The checked build never steps over a NUL: if the text runs out first it
03AE                             ; returns A = 0 with the IP on the NUL.
03AE   0A           SKIPSTR:   LDAX   B   
03AF   B7                     ORA   A   
03B0   C8                     RZ      
03B1   03                     INX   B   
03B2   FE 22                  CPI   22h   
03B4   C8                     RZ      
03B5   FE 2F                  CPI   "/"   
03B7   C2 AE 03               JNZ   skipstr   
03BA   0A                     LDAX   B   ; the escaped character
03BB   B7                     ORA   A   
03BC   C8                     RZ      
03BD   03                     INX   B   
03BE   C3 AE 03               JMP   skipstr   
03C1                          ENDIF      
03C1                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03C1                             ; and return its value in A with the carry set; otherwise leave the IP and
03C1                             ; return with the carry clear.
03C1   0A           HEXC:     LDAX   B   
03C2   D6 30                  SUI   "0"   
03C4   FE 0A                  CPI   10   
03C6   DA D2 03               JC   hc1   
03C9   E6 DF                  ANI   0DFh   
03CB   D6 11                  SUI   11h   
03CD   FE 06                  CPI   6   
03CF   D0                     RNC      
03D0   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
03D2   03           HC1:      INX   B   
03D3   C9                     RET      
03D4                             ;  ---- Speed-ups (base builds) -------------------------------------------
03D4                             ;  The skip cache and "/" by a power of two are above. These are the
03D4                             ;  handlers' tails that the builds with room take, kept here, out of the
03D4                             ;  handlers' first two pages.
03D4                          IF   QK   
03D4                             ; "*" with an operand below 256: that one becomes the multiplier, a byte in
03D4                             ; A, and the loop stops as soon as its bits are used up (most
03D4                             ; multiplications have one, a count or a small constant). With both at 256
03D4                             ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
03D4                             ; shifted in above it says when), and its high byte goes on as a small one.
03D4                             ; DE = NOS, HL = TOS.
03D4   7C           MULQ:     MOV   A,H   
03D5   B7                     ORA   A   
03D6   CA DF 03               JZ   mq8   ; the multiplier is below 256
03D9   7A                     MOV   A,D   
03DA   B7                     ORA   A   
03DB   C2 F4 03               JNZ   mq16   
03DE   EB                     XCHG      ; the multiplicand is: it becomes the multiplier
03DF   7D           MQ8:      MOV   A,L   
03E0   21 00 00               LXI   H,0   
03E3   B7                     ORA   A   ; (clears the carry)
03E4   CA F3 03               JZ   mq9   
03E7   1F           MQ1:      RAR      ; the next bit
03E8   D2 EC 03               JNC   mq2   
03EB   19                     DAD   D   
03EC   EB           MQ2:      XCHG      
03ED   29                     DAD   H   ; multiplicand << 1
03EE   EB                     XCHG      
03EF   B7                     ORA   A   ; bits left? (and clears the carry)
03F0   C2 E7 03               JNZ   mq1   
03F3                          ;*Macro unroll: mq9:    NEXTQ
03F3   F7           MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
03F4                          DS   CPM*(1-FAST),0C3h   
03F4                          DS   CPM*(1-FAST),ANXT&0FFh   
03F4                          DS   CPM*(1-FAST),ANXT/256   
03F4                          DS   FAST*CHECKED,0CDh   
03F4                          DS   FAST*CHECKED,ACHK&0FFh   
03F4                          DS   FAST*CHECKED,ACHK/256   
03F4                          DS   FAST,0Ah   
03F4                          DS   FAST,03h   
03F4                          DS   FAST,0EBh   
03F4                          DS   FAST,6Fh   
03F4                          DS   FAST,26h   
03F4                          DS   FAST,DTPG   
03F4                          DS   FAST,7Eh   
03F4                          DS   FAST,24h   
03F4                          DS   FAST,66h   
03F4                          DS   FAST,6Fh   
03F4                          DS   FAST,0E9h   
03F4   C5           MQ16:     PUSH   B   
03F5   44                     MOV   B,H   ; the high byte, for later
03F6   7D                     MOV   A,L   
03F7   21 00 00               LXI   H,0   
03FA   37                     STC      ; the marker
03FB   1F                     RAR      
03FC   D2 00 04     MQ3:      JNC   mq4   
03FF   19                     DAD   D   
0400   EB           MQ4:      XCHG      
0401   29                     DAD   H   
0402   EB                     XCHG      
0403   FE 01                  CPI   1   ; only the marker left: 8 rounds done (and
0405   1F                     RAR      ;   the carry was clear for the shift)
0406   C2 FC 03               JNZ   mq3   
0409   78                     MOV   A,B   
040A   C1                     POP   B   
040B   B7                     ORA   A   
040C   C3 E7 03               JMP   mq1   ; the high byte, as a small multiplier
040F                             ; A true ")" reads the block start where it is, on top of the return stack,
040F                             ; instead of popping it and pushing it back; the break key is looked at as
040F                             ; rpushd would.
040F   2A 34 82     CLOSEQ:   LHLD   RSP   
0412   4E                     MOV   C,M   
0413   23                     INX   H   
0414   46                     MOV   B,M   
0415   21 36 82               LXI   H,BRKCNT   
0418   35                     DCR   M   
0419   E1                     POP   H   ; (keeps the flags)
041A   CC 1E 04               CZ   pollk   
041D                          ;*Macro unroll:  NEXTQ
041D   F7                     DS   (1-CPM)*(1-FAST),0F7h   
041E                          DS   CPM*(1-FAST),0C3h   
041E                          DS   CPM*(1-FAST),ANXT&0FFh   
041E                          DS   CPM*(1-FAST),ANXT/256   
041E                          DS   FAST*CHECKED,0CDh   
041E                          DS   FAST*CHECKED,ACHK&0FFh   
041E                          DS   FAST*CHECKED,ACHK/256   
041E                          DS   FAST,0Ah   
041E                          DS   FAST,03h   
041E                          DS   FAST,0EBh   
041E                          DS   FAST,6Fh   
041E                          DS   FAST,26h   
041E                          DS   FAST,DTPG   
041E                          DS   FAST,7Eh   
041E                          DS   FAST,24h   
041E                          DS   FAST,66h   
041E                          DS   FAST,6Fh   
041E                          DS   FAST,0E9h   
041E                          ENDIF      
041E                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWER:    EQU   lowq   
                    LOWQ:     ADD   A   
                              MOV   E,A   
                              MVI   D,LETPAGE   ; DE -> the cell
                              LDAX   B   
                              CPI   "@"   
                              JZ   lwf   
                              CPI   "!"   
                              JZ   lws   
                              PUSH   H   
                              XCHG      ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWF:      INX   B   ; x@: TOS = the cell's value
                              PUSH   H   
                              XCHG      
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              XCHG      
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
                              XCHG      
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
041E                          ENDIF      
041E                             ; =============================================================================
041E                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
041E                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
041E                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
041E                             ;  the host's KEY and CONOUT routines themselves.
041E                             ; 
041E                             ;  A running program reads the keyboard only through getk and pollk, which
041E                             ;  between them give the break key its rules:
041E                             ;    - Ctrl-C stops the program;
041E                             ;    - any other key that the break check reads is held in KEYBUF for the
041E                             ;      next "?", and a newer one takes its place;
041E                             ;    - "?" (getk) takes the held key first;
041E                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
041E                             ;      key like any other, but two of them within about 250 ms still stop it.
041E                             ;  Both are called straight from a handler, never from a routine under one:
041E                             ;  the checked build's report counts on finding one return address above the
041E                             ;  data stack, and TOS in HL.
041E                             ; =============================================================================
041E                          IFN   CPM   
041E                RAWK:     EQU   KEY   
041E                          ENDIF      
041E                             ; pollk: the break check (see rpushd).
041E   CD 06 FF     POLLK:    CALL   rawk   
0421   C8                     RZ      ; no key
0422   32 7A 82               STA   KEYBUF   ; held for the next "?"
0425   FE 03        PK1:      CPI   3   ; (getk joins here)
0427   C0                     RNZ      
0428                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0428                             ; the program has turned it off, wait about 250 ms for one more key: a
0428                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0428                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0428   3A 7B 82     CTLC:     LDA   BRKOFF   
042B   B7                     ORA   A   
042C   CA 85 04               JZ   brk   
042F   D5                     PUSH   D   
0430   11 10 27               LXI   D,250*MSLOOP   
0433   CD 06 FF     CT1:      CALL   rawk   
0436   C2 3F 04               JNZ   ct2   
0439   1B                     DCX   D   
043A   7A                     MOV   A,D   
043B   B3                     ORA   E   
043C   C2 33 04               JNZ   ct1   
043F   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
0440   FE 03                  CPI   3   
0442   CA 85 04               JZ   brk   
0445   B7                     ORA   A   
0446   CA 4C 04               JZ   ct3   
0449   32 7A 82               STA   KEYBUF   
044C   3E 03        CT3:      MVI   A,3   
044E   B7                     ORA   A   
044F   C9                     RET      
0450                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0450   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
0451   21 7A 82               LXI   H,KEYBUF   ;   the buffer
0454   7E                     MOV   A,M   
0455   36 00                  MVI   M,0   
0457   E1                     POP   H   
0458   B7                     ORA   A   
0459   C0                     RNZ      
045A   CD 06 FF               CALL   rawk   
045D   C8                     RZ      
045E   C3 25 04               JMP   pk1   ; Ctrl-C? If not, that is the key
0461                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
0461                          ENDIF      
0461                          IF   CHECKED   
0461                BRK:      EQU   e_break   ;   the checked build reports B
0461                          ENDIF      
0461                          IF   CPM   
                                 ; (In a CP/M build the letters and digits are here, out of the way of the
                                 ; handlers, which must fit in the image's first two pages. The same code as
                                 ; in the generic build.)
                                 ; ---- the letters and digits --------------------------------------------------
                                 ; a-z: push the cell's address (the cell is the variable)
0461                          ENDIF      
0461                          IF   CPM*(1-SBASEU)   
                    LOWER:    PUSH   H   
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0461                          ENDIF      
0461                          IF   CPM   
                                 ; A-Z: call the word. The return address (the IP after the letter) goes on
                                 ; the return stack, and the IP becomes the address in the letter's cell.
                    UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   ; HL -> cell
                              MOV   D,B   
                              MOV   E,C   ; DE = the return address
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   ; IP = the word's body, and fall into rpushd
                                 ; rpushd: push DE on the return stack, then pop TOS off the data stack and
                                 ; go on. Every push of the return stack ends here: for a word call the cell
                                 ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
                                 ; the one that was used up.
                                 ; 
                                 ; The break key is looked at here, so at every word call and loop-back (and
                                 ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
                                 ; the keyboard can be slow (it is a BDOS call under CP/M).
                    RPUSHD:   LHLD   RSP   
                              DCX   H   
                              MOV   M,D   
                              DCX   H   
                              MOV   M,E   
                              SHLD   RSP   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
0461                          ENDIF      
0461                             ; =============================================================================
0461                             ;  Checked build: the checks and the error report
0461                             ; =============================================================================
0461                          IF   CHECKED   
0461                             ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
0461                             ; it, and the old top is on the stack under the return address. Stop if the
0461                             ; new top is not below the limit page, or is below the program's end.
0461                CHKHP:       
0461                          ENDIF      
0461                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
0461                          ENDIF      
0461                          IF   CHECKED*(1-CPM)   
0461                             ; (Here the program's space is under 32K, so a top that wrapped
0461                             ; round always falls outside it.)
0461   7C                     MOV   A,H   
0462   FE F0                  CPI   HEAPLIM   
0464   D2 70 04               JNC   e_heap   
0467                          ENDIF      
0467                          IF   CHECKED   
0467   EB                     XCHG      
0468   E5                     PUSH   H   ; the count
0469   2A 38 82               LHLD   NPEND   
046C   19                     DAD   D   ; carry: at or above the program's end
046D   E1                     POP   H   
046E   EB                     XCHG      
046F   D8                     RC      
0470   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
0471   D1                     POP   D   ;   and drop the return address (errp drops
0472   3E 48                  MVI   A,"H"   ;   the old top)
0474   C3 14 05               JMP   errp   
0477                             ; chkst: stop unless HL is in the program's own space: from the letter page
0477                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0477                             ; whatever lies above the limit are safe. Memory above the heap top but
0477                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0477                             ; It is the page of HL + 1 that is tested, so that one test serves both
0477                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0477                             ; Keeps HL and BC. It runs on into its own error entry.
0477   23           CHKST:    INX   H   
0478   7C                     MOV   A,H   
0479   2B                     DCX   H   
047A   FE 82                  CPI   LETPAGE   
047C   DA 82 04               JC   e_store   
047F                          ENDIF      
047F                          IF   CHECKED*(1-CPM)   
047F   FE F0                  CPI   HEAPLIM   
0481   D8                     RC      
0482                          ENDIF      
0482                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
0482                          ENDIF      
0482                          IF   CHECKED   
0482                             ; Two error entries for errors found inside a routine: the first hides the
0482                             ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
0482                             ; return address.
0482   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
0484   11                     DB   11h   
0485   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
0487   C3 14 05               JMP   errp   
048A                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
048A                             ; "$", and the error report's texts). A NUL first is an error: Q.
048A   7E           PRSTR:    MOV   A,M   
048B   23                     INX   H   
048C   FE 22                  CPI   22h   
048E   C8                     RZ      
048F   B7                     ORA   A   
0490   CA FC 04               JZ   e_dollar   
0493   FE 2F                  CPI   "/"   
0495   C2 A6 04               JNZ   prs1   
0498   7E                     MOV   A,M   
0499   23                     INX   H   
049A   FE 60                  CPI   60h   
049C   DA A4 04               JC   prs0   
049F   FE 7F                  CPI   7Fh   
04A1   DA CF 02               JC   pesc   
04A4   E6 BF        PRS0:     ANI   0BFh   
04A6                          ;*Macro unroll: prs1:   PUTA
04A6   EF           PRS1:     DS   1-CPM,0EFh   
04A7                          DS   CPM,0CDh   
04A7                          DS   CPM,APUT&0FFh   
04A7                          DS   CPM,APUT/256   
04A7   C3 8A 04               JMP   prstr   
04AA                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
04AA                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
04AA                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
04AA                             ; pnl: the same, on a new line.
04AA   3E 0D        PNL:      MVI   A,13   
04AC                          ;*Macro unroll:  PUTA
04AC   EF                     DS   1-CPM,0EFh   
04AD                          DS   CPM,0CDh   
04AD                          DS   CPM,APUT&0FFh   
04AD                          DS   CPM,APUT/256   
04AD   3E 0A                  MVI   A,10   
04AF                          ;*Macro unroll:  PUTA
04AF   EF                     DS   1-CPM,0EFh   
04B0                          DS   CPM,0CDh   
04B0                          DS   CPM,APUT&0FFh   
04B0                          DS   CPM,APUT/256   
04B0   E3           PMSG:     XTHL      
04B1   CD 8A 04               CALL   prstr   
04B4   E3                     XTHL      
04B5   C9                     RET      
04B6                             ; chkstk: both stacks are checked once per character, not in every handler.
04B6                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
04B6                             ; the constant carries if it is above (cells were popped that were never
04B6                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
04B6                             ; a character late at most: the bytes above DSTOP and the guard band below
04B6                             ; the page take what happens meanwhile.
04B6   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
04B7   21 05 7E               LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
04BA   39                     DAD   SP   
04BB   DA E5 04               JC   e_under   
04BE   24                     INR   H   
04BF   C2 DF 04               JNZ   e_over   
04C2   2A 34 82               LHLD   RSP   ; the return stack: in its page (or it has
04C5   7C                     MOV   A,H   ;   overflowed), and not above its empty
04C6   FE 80                  CPI   RSPAGE   ;   position (an underflow stays inside the
04C8   C2 DC 04               JNZ   e_rover   ;   page, in the guard band)
04CB   7D                     MOV   A,L   
04CC   FE E1                  CPI   RSTOP&0FFh+1   
04CE   D2 D3 04               JNC   e_runder   
04D1   EB                     XCHG      ; TOS back
04D2   C9                     RET      
04D3   21 E0 80     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
04D6   22 34 82               SHLD   RSP   
04D9   3E 72                  MVI   A,"r"   
04DB   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
04DC   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
04DE   21                     DB   21h   
04DF   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
04E1   EB                     XCHG      ; TOS back
04E2   C3 14 05               JMP   errp   
04E5   31 FC 81     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
04E8   3E 73                  MVI   A,"s"   
04EA   C3 15 05               JMP   error   
04ED                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
04ED                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
04ED                             ; every build: if the IP is in page zero, this was a call of an undefined
04ED                             ; word. The call is undone, so the place is the call itself.
04ED   04           E_HI:     INR   B   
04EE   05                     DCR   B   
04EF   C2 0B 05               JNZ   e_resv   
04F2   E5                     PUSH   H   
04F3                          ;*Macro unroll:  POPR
04F3   CF                     DS   1-CPM,0CFh   
04F4                          DS   CPM,0CDh   
04F4                          DS   CPM,AROP&0FFh   
04F4                          DS   CPM,AROP/256   
04F4   44                     MOV   B,H   
04F5   4D                     MOV   C,L   
04F6   E1                     POP   H   
04F7   3E 55                  MVI   A,"U"   
04F9   C3 15 05               JMP   error   
04FC                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
04FC                             ; back in TOS. prstr"s return address goes first. But if "$' had no
04FC                             ; address at all (the stack was empty), it is s, found now: chkstk, called
04FC                             ; one cell up, sees the stack past its empty place then.
04FC   D1           E_DOLLAR:   POP   D   
04FD   E1                     POP   H   
04FE   CD B6 04               CALL   chkstk   
0501   E5                     PUSH   H   
0502   2A 3A 82               LHLD   PSAVE   
0505   11                     DB   11h   ; (LXI D hides e_quote's first two bytes)
0506                             ; Error entries. Each loads its letter and then hides the next entry inside
0506                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
0506   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
0507   4D                     MOV   C,L   ;   past the opening quote, which is the place
0508   3E 51                  MVI   A,"Q"   
050A   11                     DB   11h   
050B   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
050D   11                     DB   11h   
050E   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
0510   11                     DB   11h   
0511   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
0513   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
0514                             ; errp: an error found inside a routine: drop its return address first.
0514   D1           ERRP:     POP   D   
0515                             ; error: the report, then the end. A = the letter, BC = one past the place,
0515                             ; HL = TOS, and both stacks as the report is to show them:
0515                             ; 
0515                             ;   Err X @ line,col
0515                             ;   D:n: the top 8 cells at most, bottom to top
0515                             ;   R:n
0515   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
0516   5F                     MOV   E,A   
0517   CD AA 04               CALL   pnl   
051A   45 72 72 20 22         DB   "Err ",22h   
051F   7B                     MOV   A,E   
0520                          ;*Macro unroll:  PUTA
0520   EF                     DS   1-CPM,0EFh   
0521                          DS   CPM,0CDh   
0521                          DS   CPM,APUT&0FFh   
0521                          DS   CPM,APUT/256   
0521   CD B0 04               CALL   pmsg   
0524   20 40 20 22            DB   " @ ",22h   
0528   0B                     DCX   B   ; BC = the place
0529                             ; The line and column. A place below the program is in the line
0529                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0529                             ; DE = the line's number, HL = where it starts.
0529   21 80 82               LXI   H,LINEBUF   
052C   11 00 00               LXI   D,0   
052F   78                     MOV   A,B   
0530   FE 83                  CPI   PROG/256   
0532   DA 4C 05               JC   er3   
0535   24                     INR   H   
0536   6B                     MOV   L,E   ; HL = PROG
0537   13           ER1:      INX   D   ; a new line starts at HL
0538   E5                     PUSH   H   
0539   7D           ER2:      MOV   A,L   
053A   91                     SUB   C   
053B   7C                     MOV   A,H   
053C   98                     SBB   B   
053D   D2 4B 05               JNC   er2x   ; reached the place
0540   7E                     MOV   A,M   
0541   23                     INX   H   
0542   FE 0A                  CPI   10   
0544   C2 39 05               JNZ   er2   
0547   F1                     POP   PSW   
0548   C3 37 05               JMP   er1   
054B   E1           ER2X:     POP   H   
054C   C5           ER3:      PUSH   B   
054D   E5                     PUSH   H   
054E   EB                     XCHG      
054F   CD BD 02               CALL   pdec   ; the line
0552   3E 2C                  MVI   A,","   
0554                          ;*Macro unroll:  PUTA
0554   EF                     DS   1-CPM,0EFh   
0555                          DS   CPM,0CDh   
0555                          DS   CPM,APUT&0FFh   
0555                          DS   CPM,APUT/256   
0555   D1                     POP   D   
0556   E1                     POP   H   
0557   CD C2 05               CALL   sub16   
055A   23                     INX   H   
055B   CD BD 02               CALL   pdec   ; the column
055E   CD AA 04               CALL   pnl   
0561   44 3A 22               DB   "D:",22h   
0564   21 06 7E               LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
0567   39                     DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
0568                          ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
0568   E7                     DS   1-CPM,0E7h   ;   first value and holds nothing)
0569                          DS   CPM,0CDh   
0569                          DS   CPM,ANEG&0FFh   
0569                          DS   CPM,ANEG/256   
0569   7C                     MOV   A,H   
056A   CD B6 05               CALL   phal2   ; the depth
056D   3E 3A                  MVI   A,":"   
056F                          ;*Macro unroll:  PUTA
056F   EF                     DS   1-CPM,0EFh   
0570                          DS   CPM,0CDh   
0570                          DS   CPM,APUT&0FFh   
0570                          DS   CPM,APUT/256   
0570   79                     MOV   A,C   
0571   FE 09                  CPI   9   
0573   DA 80 05               JC   er6   
0576   CD B0 04               CALL   pmsg   
0579   20 2E 2E 2E 22         DB   " ...",22h   
057E   0E 08                  MVI   C,8   
0580   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
0582   69                     MOV   L,C   
0583   29                     DAD   H   
0584   39                     DAD   SP   ; HL -> just above the deepest of them
0585   0C                     INR   C   
0586   0D           ER7:      DCR   C   
0587   CA 9C 05               JZ   er8   
058A   2B                     DCX   H   
058B   56                     MOV   D,M   
058C   2B                     DCX   H   
058D   5E                     MOV   E,M   
058E   E5                     PUSH   H   
058F   C5                     PUSH   B   
0590   3E 20                  MVI   A," "   
0592                          ;*Macro unroll:  PUTA
0592   EF                     DS   1-CPM,0EFh   
0593                          DS   CPM,0CDh   
0593                          DS   CPM,APUT&0FFh   
0593                          DS   CPM,APUT/256   
0593   EB                     XCHG      
0594   CD B4 02               CALL   psgn   
0597   C1                     POP   B   
0598   E1                     POP   H   
0599   C3 86 05               JMP   er7   
059C   CD AA 04     ER8:      CALL   pnl   
059F   52 3A 22               DB   "R:",22h   
05A2   2A 34 82               LHLD   RSP   
05A5   EB                     XCHG      
05A6   21 E0 80               LXI   H,RSTOP   
05A9   CD B3 05               CALL   phalf   
05AC   CD AA 04               CALL   pnl   
05AF   22                     DB   22h   
05B0   C3 7F 00               JMP   endprog   
05B3                             ; phalf: print half of HL - DE, and leave it in BC
05B3   CD C2 05     PHALF:    CALL   sub16   
05B6   B7           PHAL2:    ORA   A   ; (A = H; this clears the carry)
05B7   1F                     RAR      
05B8   67                     MOV   H,A   
05B9   7D                     MOV   A,L   
05BA   1F                     RAR      
05BB   6F                     MOV   L,A   
05BC   E5                     PUSH   H   
05BD   CD BD 02               CALL   pdec   
05C0   C1                     POP   B   
05C1   C9                     RET      
05C2                             ; sub16: HL = HL - DE. Leaves A = H.
05C2   7D           SUB16:    MOV   A,L   
05C3   93                     SUB   E   
05C4   6F                     MOV   L,A   
05C5   7C                     MOV   A,H   
05C6   9A                     SBB   D   
05C7   67                     MOV   H,A   
05C8   C9                     RET      
05C9                          ENDIF      
05C9                             ; =============================================================================
05C9                             ;  Startup
05C9                             ; =============================================================================
05C9                START:       
05C9                          IF   (1-CPM)*CHECKED   
05C9   31 FC 81               LXI   SP,DSTOP   
05CC                          ENDIF      
05CC                          IF   QK   
05CC   21 00 F0               LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
05CF   AF                     XRA   A   ;   start of 0000h matches no skip)
05D0   77           SKC1:     MOV   M,A   
05D1   2C                     INR   L   
05D2   C2 D0 05               JNZ   skc1   
05D5                          ENDIF      
05D5                          IF   CHECKED   
05D5                             ; Clear the lower half of the letter page: every variable starts at
05D5                             ; 0, every word cell holds 0000h, the address an undefined word is
05D5                             ; caught at (see e_hi), and no key is held back.
05D5   21 00 82               LXI   H,LET   
05D8   AF                     XRA   A   
05D9   77           INI1:     MOV   M,A   
05DA   2C                     INR   L   
05DB   F2 D9 05               JP   ini1   ; +00h to +7Fh
05DE                          ENDIF      
05DE                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
05DE                          ENDIF      
05DE                          IFN   CPM   
05DE   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
05E1   7E           FNUL:     MOV   A,M   
05E2   23                     INX   H   
05E3   B7                     ORA   A   
05E4   C2 E1 05               JNZ   fnul   
05E7                          ENDIF      
05E7   22 7C 82               SHLD   HEAP   
05EA                          IF   CHECKED   
05EA                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
05EA   E7                     DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
05EB                          DS   CPM,0CDh   
05EB                          DS   CPM,ANEG&0FFh   
05EB                          DS   CPM,ANEG/256   
05EB   22 38 82               SHLD   NPEND   ;   release below it
05EE                          ENDIF      
05EE   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
05F1   22 34 82               SHLD   RSP   
05F4                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
05F4                          ENDIF      ;   checked build has cleared these)
05F4                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
05F4                          ENDIF      
05F4                          IF   1-CHECKED   
                              SHLD   KEYBUF   
05F4                          ENDIF      
05F4   01 00 83               LXI   B,PROG   ; the IP
05F7                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
05F7   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
05F8                          DS   CPM+FAST-CPM*FAST,0C3h   
05F8                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
05F8                          DS   CPM+FAST-CPM*FAST,ANXT/256   
05F8                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
                                 ; 
                                 ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
                                 ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
                                 ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
                                 ;  the letters and digits have one entry each, which knows its cell or its
                                 ;  value already.
                                 ; =============================================================================
                    FTSTORE:   XCHG      ; !
                              JMP   h_store   
                    FTSTR:    XCHG      ; "
                              JMP   h_str   
                    FTNUM:    XCHG      ; #
                              JMP   h_num   
                    FTPRINT:   XCHG      ; $
                              JMP   h_print   
                    FTEMIT:   XCHG      ; '
                              JMP   h_emit   
                    FTCSTORE:   XCHG      ; .
                              JMP   h_cstore   
                    FTDIV:    XCHG      ; /
                              JMP   h_div   
                    FTKEY:    XCHG      ; ?
                              JMP   h_key   
                    FTDEF:    XCHG      ; [
                              JMP   h_def   
                    FTBREAK:   XCHG      ; \
                              JMP   h_break   
                    FTALLOC:   XCHG      ; _
                              JMP   h_alloc   
                    FTGRAVE:   XCHG      ; `
                              JMP   h_grave   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:   POP   H   ; +
                              DAD   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:   LDAX   B   ; -
                              SUI   "0"   
                              CPI   10   
                              JC   fs_neg   
                              POP   H   
                              MOV   A,L   
                              SUB   E   
                              MOV   E,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   D,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   XCHG      ; a digit next: a negative number
                              JMP   negnum   
                    FS_DUP:   PUSH   D   ; :
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:   POP   H   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:   POP   H   ; %
                              PUSH   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:   XCHG      ; @
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:   LDAX   D   ; ,
                              MOV   E,A   
                              MVI   D,0   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:    POP   H   ; < (HL = a, DE = b: the borrow of a - b, flipped if the signs differ)
