04A3   CC D7 04               CZ   skipstr   ; leaves A = 22h, which matches nothing below
04A6   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
04A8   CA 9A 04               JZ   sk3   
04AB   3D                     DCR   A   ; ")"
04AC   CA B9 04               JZ   sk4   
