0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        "/" leaves ( r q ), the quotient on top; dividing by zero is not
0000                             ;        checked. -n? does no more editing than Backspace.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  Two switches, set in the EQU lines below:
0000                             ;    ZPSTACK  0 = the data stack is in pages 2 and 3: 252 cells
0000                             ;             1 = the data stack is in zero page: 112 cells, and a smaller
0000                             ;                 interpreter, because every stack access is a byte shorter.
0000                             ;                 The memory map and the machine-code contract differ: see
0000                             ;                 below.
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                ZPSTACK:   EQU   1   ; 1 = data stack in zero page
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X, or $10,X and $80,X when the stack is in zero page.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above; with ZPSTACK = 1 also the data
0000                             ;               stack: low bytes at 10-7F, high bytes at 80-EF (X = 70 when
0000                             ;               empty: 112 cells)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       with ZPSTACK = 0: DSL, data stack, low bytes (X = FC when
0000                             ;    0300       empty: 252 cells) and DSH, high bytes. With ZPSTACK = 1 these
0000                             ;               two pages are not used.
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C
0000                             ;               (= z10+), KEYBUF at +34, the -n? line buffer at +80..+FF
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   ZPSTACK   
0000                DSL:      EQU   10h   ; data stack, low bytes
0000                DSH:      EQU   80h   ; data stack, high bytes
0000                DSE:      EQU   70h   ; X when the data stack is empty
0000                          ENDIF      
0000                          IFN   ZPSTACK   
                    DSL:      EQU   0200h   
                    DSH:      EQU   0300h   
                    DSE:      EQU   0FCh   
0000                          ENDIF      
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003   20 75 E1               JSR   rstip   
E006   20 69 E1     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B                          IF   CHECKED   
                              STA   KEYBUF   ; (A = 0) no key held back
E00B                          ENDIF      
E00B   A5 00                  LDA   IP   
E00D   8D 7C 04               STA   HEAP   
E010   A5 01                  LDA   IP+1   
E012   8D 7D 04               STA   HEAP+1   
E015   20 75 E1               JSR   rstip   
E018   A2 70                  LDX   #DSE   
E01A                             ; =============================================================================
E01A                             ;  The inner loop
E01A                             ; =============================================================================
E01A                NEXT:        
E01A                          IF   CHECKED   
                                 ; Both stacks are checked once per character. The data stack has
                                 ; overrun when X is above DSE (an overflow wraps X to FF, an underflow
                                 ; moves it up; no handler moves X by more than 2). The return stack
                                 ; has when S is below RSLIM (an underflow wraps S to 00-03).
                              CPX   #DSE+1   
                              BCS   e_stack   
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
E01A                          ENDIF      
E01A   20 20 E0               JSR   step   
E01D   4C 1A E0               JMP   next   
E020                             ; step: read one character and sort it by range.
E020                             ;    00h          end of program
E020                             ;    01h-20h, 7Fh-FFh   ignored
E020                             ;    30h-39h      digit: read a whole number
E020                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E020                             ;    61h-7Ah      a-z: push the address of that letter's cell
E020                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E020                             ; Every way out of the sort has the carry clear, except "ignored".
E020   20 69 E1     STEP:     JSR   getc   ; flags follow A
E023   F0 36                  BEQ   endprog   
E025   38                     SEC      
E026   E9 21                  SBC   #21h   ; A = c - 21h
E028   90 30                  BCC   ign   ; 01h-20h
E02A   C9 0F                  CMP   #0Fh   
E02C   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E02E   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E030   C9 0A                  CMP   #10   
E032   90 2A                  BCC   digit   
E034   C9 11                  CMP   #11h   
E036   90 16                  BCC   p3a   ; 3Ah-40h
E038   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E03A   C9 1A                  CMP   #1Ah   
E03C   90 55                  BCC   upper   ; 41h-5Ah
E03E   C9 20                  CMP   #20h   
E040   90 0A                  BCC   p5b   ; 5Bh-60h
E042   C9 3A                  CMP   #3Ah   
E044   90 25                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E046   C9 3E                  CMP   #3Eh   
E048   B0 10                  BCS   ign   ; 7Fh-FFh
E04A                             ; The three adjustments below chain. Each ADC adds the carry the one
E04A                             ; before it left, which the constants allow for.
E04A   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E04C   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E04E   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E050   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E051   A8                     TAY      
E052   B9 EF E0               LDA   PTAB+1,Y   
E055   48                     PHA      
E056   B9 EE E0               LDA   PTAB,Y   
E059   48                     PHA      
E05A   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E05B                             ; directly, it just ends an ignored character.
E05B   4C 09 FF     ENDPROG:   JMP   EXIT   
E05E                          IF   CHECKED   
                    E_STACK:   LDA   #"S"   ; data stack over or under
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RSTACK:   LDA   #"R"   ; return stack over or under
                              JMP   error   
E05E                          ENDIF      
E05E                             ; Digits: the first one is in A; read the rest of the number.
E05E   A8           DIGIT:    TAY      
E05F   20 8A E1               JSR   push   
E062   84 02                  STY   TL   
E064   A9 00                  LDA   #0   
E066   85 03                  STA   TH   
E068   4C 55 E1               JMP   rdnum   
E06B                             ; a-z: push the cell's address (the cell is the variable)
E06B   0A           LOWER:    ASL      
E06C   A8                     TAY      
E06D   20 8A E1               JSR   push   
E070   84 02                  STY   TL   
E072   A9 04                  LDA   #>LET   
E074   85 03                  STA   TH   
E076   60                     RTS      
E077                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E077                             ; the matching ")".
E077   20 94 E1     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E07A   F0 35                  BEQ   skip   
E07C                             ; pushn: take the step frame off, push the reading position on the return
E07C                             ; stack, and go on. With the carry set (a word call) the reading position
E07C                             ; then becomes the address in the letter cell at LET,Y.
E07C   68           PUSHN:    PLA      
E07D   68                     PLA      ; drop the step frame
E07E   A5 01                  LDA   IP+1   
E080   48                     PHA      
E081   A5 00                  LDA   IP   
E083   48                     PHA      
E084   90 0A                  BCC   nxt   
E086   B9 00 04               LDA   LET,Y   
E089   85 00                  STA   IP   
E08B   B9 01 04               LDA   LET+1,Y   
E08E   85 01                  STA   IP+1   
E090   4C 1A E0     NXT:      JMP   next   
E093                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E093                             ; the return stack, and the IP becomes the address in the letter's cell.
E093   0A           UPPER:    ASL      
E094   A8                     TAY      
E095   38                     SEC      
E096   B0 E4                  BCS   pushn   ; always
E098                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E098                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E098                             ; the body"s address instead. Either way it then skips to the matching "]'.
E098                             ; (The unchecked build takes anything below "A" as the space, and anything
E098                             ; from "A" up as a letter.)
E098   20 69 E1     H_DEF:    JSR   getc   
E09B                          IF   CHECKED   
                              CMP   #" "   
                              BEQ   def2   
E09B                          ENDIF      
E09B   38                     SEC      
E09C   E9 41                  SBC   #"A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
E09E                          IF   1-CHECKED   
E09E   90 0E                  BCC   def2   
E0A0                          ENDIF      
E0A0                          IF   CHECKED   
                              TAY      
                              AND   #0DFh   ; fold case: 0-25 only for a letter
                              CMP   #26   
                              BCS   e_brack   ; anything but a letter or a space
                              TYA      
E0A0                          ENDIF      
E0A0   0A                     ASL      
E0A1   A8                     TAY      ; Y -> the cell
E0A2   A5 00                  LDA   IP   
E0A4   99 00 04               STA   LET,Y   
E0A7   A5 01                  LDA   IP+1   
E0A9   99 01 04               STA   LET+1,Y   
E0AC   D0 03                  BNE   skip   ; always: no program is in page zero
E0AE   20 7E E1     DEF2:     JSR   puship   ; an anonymous block: push its address
E0B1                             ; skip: read past text to the closer at this level, and return it in A.
E0B1                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0B1                             ; NUL first ends the program.
E0B1   A9 00        SKIP:     LDA   #0   
E0B3   85 06                  STA   T2   ; depth
E0B5   20 69 E1     SK1:      JSR   getc   
E0B8   F0 A1                  BEQ   endprog   
E0BA   C9 22                  CMP   #22h   
E0BC   D0 03                  BNE   sk2   
E0BE   20 DD E0               JSR   skipstr   ; leaves A = 22h, which matches nothing below
E0C1   C9 28        SK2:      CMP   #"("   
E0C3   F0 11                  BEQ   sk3   
E0C5   C9 5B                  CMP   #"["   
E0C7   F0 0D                  BEQ   sk3   
E0C9   C9 29                  CMP   #")"   
E0CB   F0 04                  BEQ   sk4   
E0CD   C9 5D                  CMP   #"]"   
E0CF   D0 E4                  BNE   sk1   
E0D1   C6 06        SK4:      DEC   T2   
E0D3   10 E0                  BPL   sk1   
E0D5   60                     RTS      ; the closer at this level
E0D6   E6 06        SK3:      INC   T2   
E0D8   D0 DB                  BNE   sk1   
E0DA                          IF   CHECKED   
                    E_BRACK:   LDA   #"D"   ; bad character after [
                              JMP   error   
E0DA                          ENDIF      
E0DA                             ; 22h pushes the address of the text after it and skips the string.
E0DA   20 7E E1     H_STR:    JSR   puship   
E0DD                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E0DD                             ; the next character, so "/"" does not end it. Returns with Z set, A = 22h.
E0DD   20 69 E1     SKIPSTR:   JSR   getc   
E0E0   C9 2F                  CMP   #"/"   
E0E2   F0 05                  BEQ   ss0   
E0E4   C9 22                  CMP   #22h   
E0E6   D0 F5                  BNE   skipstr   
E0E8   60                     RTS      
E0E9   20 6C E1     SS0:      JSR   incip   
E0EC   D0 EF                  BNE   skipstr   ; A is "/" here
E0EE                             ; =============================================================================
E0EE                             ;  Dispatch table: one handler per punctuation character, in code order.
E0EE                             ;  Entries are handler-1 for the RTS trick.
E0EE                             ; =============================================================================
E0EE   9C E1        PTAB:     DW   h_store-1   ; !
E0F0   D9 E0                  DW   h_str-1   ; "
E0F2   40 E3                  DW   h_num-1   ; #
E0F4   22 E3                  DW   h_print-1   ; $
E0F6   97 E2                  DW   h_swap-1   ; %
E0F8   F8 E1                  DW   h_and-1   ; &
E0FA   38 E3                  DW   h_emit-1   ; '
E0FC   76 E0                  DW   h_open-1   ; (
E0FE   CE E1                  DW   h_close-1   ; )
E100   71 E2                  DW   h_mul-1   ; *
E102   24 E2                  DW   h_add-1   ; +
E104   7A E3                  DW   h_cfetch-1   ; ,
E106   1C E2                  DW   h_sub-1   ; -
E108   A2 E1                  DW   h_cstore-1   ; .
E10A   A8 E2                  DW   h_div-1   ; /
E10C   89 E1                  DW   push-1   ; :
E10E   A9 E1                  DW   drop-1   ; ;
E110   51 E2                  DW   h_lt-1   ; <
E112   61 E2                  DW   h_eq-1   ; =
E114   4E E2                  DW   h_gt-1   ; >
E116   83 E3                  DW   h_key-1   ; ?
E118   6E E3                  DW   h_fetch-1   ; @
E11A   97 E0                  DW   h_def-1   ; [
E11C   E5 E1                  DW   h_break-1   ; \
E11E   D4 E1                  DW   h_ret-1   ; ]
E120   10 E2                  DW   h_xor-1   ; ^
E122   00 E3                  DW   h_alloc-1   ; _
E124   DA E3                  DW   h_grave-1   ; `
E126   B3 E1                  DW   h_tor-1   ; {
E128   04 E2                  DW   h_or-1   ; |
E12A   C0 E1                  DW   h_fromr-1   ; }
E12C   3A E2                  DW   h_not-1   ; ~
E12E                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E12E                             ; test is at the bottom so the loop closes with a branch. Returns with the
E12E                             ; carry set.
E12E   20 6C E1     RD1:      JSR   incip   ; (keeps A = the digit)
E131   06 02                  ASL   TL   
E133   26 03                  ROL   TH   ; x2
E135   18                     CLC      
E136   65 02                  ADC   TL   
E138   85 04                  STA   T0   
E13A   A5 03                  LDA   TH   
E13C   69 00                  ADC   #0   
E13E   85 05                  STA   T1   ; T = x2 + digit
E140   06 02                  ASL   TL   
E142   26 03                  ROL   TH   
E144   06 02                  ASL   TL   
E146   26 03                  ROL   TH   ; x8
E148   18                     CLC      
E149   A5 02                  LDA   TL   
E14B   65 04                  ADC   T0   
E14D   85 02                  STA   TL   
E14F   A5 03                  LDA   TH   
E151   65 05                  ADC   T1   
E153   85 03                  STA   TH   ; x8 + x2 + digit
E155   20 5B E1     RDNUM:    JSR   isdig   
E158   90 D4                  BCC   rd1   
E15A   60                     RTS      
E15B                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E15B                             ; digit. Y = 0.
E15B   20 64 E1     ISDIG:    JSR   peek   
E15E   38                     SEC      
E15F   E9 30                  SBC   #"0"   
E161   C9 0A                  CMP   #10   
E163   60                     RTS      
E164                             ; =============================================================================
E164                             ;  Reading the program
E164                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E164                             ;    getc: the same, then IP moves on; flags follow A
E164                             ;    incip: IP moves on; keeps A, the carry and Y
E164                             ; =============================================================================
E164   A0 00        PEEK:     LDY   #0   
E166   B1 00                  LDA   (IP),Y   
E168   60                     RTS      
E169   20 64 E1     GETC:     JSR   peek   
E16C   E6 00        INCIP:    INC   IP   
E16E   D0 02                  BNE   ic1   
E170   E6 01                  INC   IP+1   
E172   09 00        IC1:      ORA   #0   
E174   60                     RTS      
E175                             ; rstip: point IP at the start of the program
E175   A9 00        RSTIP:    LDA   #<PROG   
E177   85 00                  STA   IP   
E179   A9 05                  LDA   #>PROG   
E17B   85 01                  STA   IP+1   
E17D   60                     RTS      
E17E                             ; =============================================================================
E17E                             ;  Stack
E17E                             ; =============================================================================
E17E   20 8A E1     PUSHIP:   JSR   push   ; push the reading position
E181   A5 00                  LDA   IP   
E183   85 02                  STA   TL   
E185   A5 01                  LDA   IP+1   
E187   85 03                  STA   TH   
E189   60                     RTS      
E18A   CA           PUSH:     DEX      ; ":" and every push
E18B   A5 02                  LDA   TL   
E18D   95 10                  STA   DSL,X   
E18F   A5 03                  LDA   TH   
E191   95 80                  STA   DSH,X   
E193   60                     RTS      
E194                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E194   A5 02        FLAG:     LDA   TL   
E196   05 03                  ORA   TH   
E198   20 AA E1               JSR   drop   
E19B   A8                     TAY      ; (drop's INX changed the flags)
E19C   60                     RTS      
E19D                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E19D                H_STORE:      
E19D                          IF   CHECKED   
                              LDA   TL   ; both bytes must be in the program's space:
                              ADC   #1   ; check the page of addr+1 (the carry is
                              LDA   TH   ; clear on the way in)
                              ADC   #0   
                              JSR   chkst   
E19D                          ENDIF      
E19D   B5 80                  LDA   DSH,X   
E19F   A0 01                  LDY   #1   
E1A1   91 02                  STA   (TL),Y   
E1A3                H_CSTORE:      ; "." ( c addr -- )
E1A3                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E1A3                          ENDIF      
E1A3   B5 10                  LDA   DSL,X   
E1A5   A0 00                  LDY   #0   
E1A7   91 02                  STA   (TL),Y   
E1A9   E8                     INX      ; falls into drop
E1AA                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E1AA                             ; it returns with Z clear.
E1AA   B4 10        DROP:     LDY   DSL,X   
E1AC   84 02                  STY   TL   
E1AE   B4 80                  LDY   DSH,X   
E1B0   84 03                  STY   TH   
E1B2   E8                     INX      
E1B3   60                     RTS      
E1B4                             ; "{" TOS to the return stack, "}" return stack to TOS
E1B4   68           H_TOR:    PLA      
E1B5   68                     PLA      
E1B6   A5 03                  LDA   TH   
E1B8   48                     PHA      
E1B9   A5 02                  LDA   TL   
E1BB   48                     PHA      
E1BC   20 AA E1               JSR   drop   
E1BF   D0 0B                  BNE   nxt2   ; always
E1C1   68           H_FROMR:   PLA      
E1C2   68                     PLA      
E1C3   20 8A E1               JSR   push   
E1C6   68                     PLA      
E1C7   85 02                  STA   TL   
E1C9   68                     PLA      
E1CA   85 03                  STA   TH   
E1CC   4C 1A E0     NXT2:     JMP   next   
E1CF                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E1CF                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E1CF                             ; it is here, the address popped is pushed back.
E1CF   20 94 E1     H_CLOSE:   JSR   flag   
E1D2   F0 1E                  BEQ   rdrop   
E1D4   24                     DB   24h   ; (BIT zp: steps over the SEC)
E1D5                             ; "]" returns: pull an address and jump to it.
E1D5   38           H_RET:    SEC      
E1D6                          IF   CHECKED   
                              JSR   chkbrk   ; Ctrl-C is checked at every loop-back and
E1D6                          ENDIF      ;   every word return (it keeps the carry)
E1D6   68                     PLA      
E1D7   68                     PLA      ; drop the step frame
E1D8   68                     PLA      
E1D9   85 00                  STA   IP   
E1DB   68                     PLA      
E1DC   85 01                  STA   IP+1   
E1DE   B0 EC                  BCS   nxt2   
E1E0   48                     PHA      ; ")": keep the block start
E1E1   A5 00                  LDA   IP   
E1E3   48                     PHA      
E1E4   90 E6                  BCC   nxt2   ; always
E1E6                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E1E6                             ; drops the block start, "]" returns.
E1E6   20 94 E1     H_BREAK:   JSR   flag   
E1E9   F0 63                  BEQ   ab9   
E1EB   20 B1 E0               JSR   skip   
E1EE   C9 29                  CMP   #")"   
E1F0   D0 E3                  BNE   h_ret   
E1F2   68           RDROP:    PLA      
E1F3   68                     PLA      
E1F4   68                     PLA      
E1F5   68                     PLA      
E1F6   4C 1A E0               JMP   next   
E1F9                             ; =============================================================================
E1F9                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E1F9                             ; =============================================================================
E1F9                             ; The logic operators leave the carry as they found it, clear, so they can
E1F9                             ; branch to fin.
E1F9   B5 10        H_AND:    LDA   DSL,X   
E1FB   25 02                  AND   TL   
E1FD   85 02                  STA   TL   
E1FF   B5 80                  LDA   DSH,X   
E201   25 03                  AND   TH   
E203   90 2B                  BCC   fin   ; always
E205   B5 10        H_OR:     LDA   DSL,X   
E207   05 02                  ORA   TL   
E209   85 02                  STA   TL   
E20B   B5 80                  LDA   DSH,X   
E20D   05 03                  ORA   TH   
E20F   90 1F                  BCC   fin   ; always
E211   B5 10        H_XOR:    LDA   DSL,X   
E213   45 02                  EOR   TL   
E215   85 02                  STA   TL   
E217   B5 80                  LDA   DSH,X   
E219   45 03                  EOR   TH   
E21B   90 13                  BCC   fin   ; always
E21D                             ; "-" has two jobs: directly before a digit it starts a negative number.
E21D   20 5B E1     H_SUB:    JSR   isdig   
E220   90 12                  BCC   negnum   
E222   20 41 E2     SUB1:     JSR   neg   ; a - b = a + (-b)
E225   18           H_ADD:    CLC      
E226   B5 10                  LDA   DSL,X   
E228   65 02                  ADC   TL   
E22A   85 02                  STA   TL   
E22C   B5 80                  LDA   DSH,X   
E22E   65 03                  ADC   TH   ; falls into fin
E230                             ; fin: finish a two-operand op: A = the high byte of the result
E230   85 03        FIN:      STA   TH   
E232   E8                     INX      
E233   60                     RTS      
E234   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E236   20 5E E0               JSR   digit   ; (comes back with the carry set)
E239   B0 06                  BCS   neg   ; always: the number, negated
E23B                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E23B   90 05        H_NOT:    BCC   neg1   ; always
E23D                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E23D   A5 03        ABSV:     LDA   TH   
E23F   10 0D        NEGM:     BPL   ab9   
E241                             ; neg: TOS = -TOS
E241   38           NEG:      SEC      
E242   A9 00        NEG1:     LDA   #0   
E244   E5 02                  SBC   TL   
E246   85 02                  STA   TL   
E248   A9 00                  LDA   #0   
E24A   E5 03                  SBC   TH   
E24C   85 03                  STA   TH   
E24E   60           AB9:      RTS      
E24F                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E24F                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E24F   20 98 E2     H_GT:     JSR   h_swap   ; a > b is b < a
E252   B5 10        H_LT:     LDA   DSL,X   
E254   C5 02                  CMP   TL   
E256   B5 80                  LDA   DSH,X   
E258   E5 03                  SBC   TH   
E25A   70 02                  BVS   lt1   
E25C   49 80                  EOR   #80h   
E25E   0A           LT1:      ASL      
E25F   E8                     INX      ; (keeps the carry; never leaves X at 0)
E260   D0 07                  BNE   bool   ; always
E262   20 22 E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E265   05 02                  ORA   TL   
E267   C9 01                  CMP   #1   ; carry clear if A = 0
E269   A9 00        BOOL:     LDA   #0   
E26B   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E26D   85 02                  STA   TL   
E26F   85 03                  STA   TH   
E271   60                     RTS      
E272                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E272                             ; bottom while the product comes in at the top, through A:T0 above it; after
E272                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E272   A0 10        H_MUL:    LDY   #16   
E274   84 05                  STY   T1   ; the round count
E276   A9 00                  LDA   #0   
E278   85 04                  STA   T0   ; A:T0 = the upper half
E27A   46 03                  LSR   TH   
E27C   66 02                  ROR   TL   ; the first multiplier bit
E27E   90 0B        ML1:      BCC   ml2   
E280   A8                     TAY      
E281   18                     CLC      
E282   A5 04                  LDA   T0   
E284   75 10                  ADC   DSL,X   
E286   85 04                  STA   T0   
E288   98                     TYA      
E289   75 80                  ADC   DSH,X   ; upper half += the multiplicand
E28B   6A           ML2:      ROR      
E28C   66 04                  ROR   T0   
E28E   66 03                  ROR   TH   
E290   66 02                  ROR   TL   ; everything one place right; next bit out
E292   C6 05                  DEC   T1   
E294   D0 E8                  BNE   ml1   
E296   E8                     INX      ; drop the multiplicand
E297   60                     RTS      
E298   B4 10        H_SWAP:   LDY   DSL,X   ; "%"
E29A   A5 02                  LDA   TL   
E29C   95 10                  STA   DSL,X   
E29E   84 02                  STY   TL   
E2A0   B4 80                  LDY   DSH,X   
E2A2   A5 03                  LDA   TH   
E2A4   95 80                  STA   DSH,X   
E2A6   84 03                  STY   TH   
E2A8   60                     RTS      
E2A9                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
E2A9                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E2A9                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
E2A9   B5 80        H_DIV:    LDA   DSH,X   
E2AB   48                     PHA      ; a's sign: for r
E2AC   45 03                  EOR   TH   
E2AE   48                     PHA      ; a xor b: for q
E2AF   20 3D E2               JSR   absv   
E2B2   A5 02                  LDA   TL   
E2B4   85 08                  STA   D0   
E2B6   A5 03                  LDA   TH   
E2B8   85 09                  STA   D1   ; D = |b|
E2BA   B5 10                  LDA   DSL,X   
E2BC   85 02                  STA   TL   
E2BE   B5 80                  LDA   DSH,X   
E2C0   85 03                  STA   TH   
E2C2   20 3D E2               JSR   absv   ; TOS = |a|
E2C5   20 D8 E2               JSR   udiv   ; TOS = q, NOS = r
E2C8   68                     PLA      
E2C9   20 3F E2               JSR   negm   ; q's sign
E2CC   68                     PLA      
E2CD   10 31                  BPL   ud9   ; r's sign:
E2CF   20 98 E2               JSR   h_swap   ;   bring r up,
E2D2   20 41 E2               JSR   neg   ;   negate it,
E2D5   4C 98 E2               JMP   h_swap   ;   and put it back
E2D8                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E2D8                             ; cell the remainder (whatever was there is lost).
E2D8   A9 00        UDIV:     LDA   #0   
E2DA   95 10                  STA   DSL,X   
E2DC   95 80                  STA   DSH,X   
E2DE   A0 10                  LDY   #16   
E2E0   06 02        UD1:      ASL   TL   
E2E2   26 03                  ROL   TH   
E2E4   36 10                  ROL   DSL,X   
E2E6   36 80                  ROL   DSH,X   
E2E8   38                     SEC      
E2E9   B5 10                  LDA   DSL,X   
E2EB   E5 08                  SBC   D0   
E2ED   85 04                  STA   T0   
E2EF   B5 80                  LDA   DSH,X   
E2F1   E5 09                  SBC   D1   
E2F3   90 08                  BCC   ud2   
E2F5   95 80                  STA   DSH,X   
E2F7   A5 04                  LDA   T0   
E2F9   95 10                  STA   DSL,X   
E2FB   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E2FD   88           UD2:      DEY      
E2FE   D0 E0                  BNE   ud1   
E300   60           UD9:      RTS      
E301                             ; =============================================================================
E301                             ;  Storage
E301                             ; =============================================================================
E301                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
E301                             ; (The carry is clear on the way in.)
E301   AD 7C 04     H_ALLOC:   LDA   HEAP   
E304   A8                     TAY      
E305   65 02                  ADC   TL   
E307   8D 7C 04               STA   HEAP   
E30A   84 02                  STY   TL   
E30C   AD 7D 04               LDA   HEAP+1   
E30F   A8                     TAY      
E310   65 03                  ADC   TH   
E312                          IF   CHECKED   
                              BCS   e_heap   ; a negative count wraps: too big
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; the new top must stay below the limit page
E312                          ENDIF      
E312   8D 7D 04               STA   HEAP+1   
E315   84 03                  STY   TH   
E317   60                     RTS      
E318                          IF   CHECKED   
                    E_HEAP:   LDA   #"H"   ; heap past the limit
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_STORE:   LDA   #"W"   ; write outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the page in A is in the program's own space, from the
                                 ; letter page up to the heap limit. Keeps Y.
                    CHKST:    CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              RTS      
E318                          ENDIF      
E318                             ; =============================================================================
E318                             ;  Console
E318                             ; =============================================================================
E318                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E318   A0 00        TOSGET:   LDY   #0   
E31A   B1 02                  LDA   (TL),Y   
E31C   E6 02        INCTOS:   INC   TL   
E31E   D0 02                  BNE   tg1   
E320   E6 03                  INC   TH   
E322   60           TG1:      RTS      
E323                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E323                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E323                             ; bit 6, so // and /" give themselves).
E323   20 18 E3     H_PRINT:   JSR   tosget   
E326   C9 22                  CMP   #22h   
E328   F0 14                  BEQ   pdrop   
E32A   C9 2F                  CMP   #"/"   
E32C   D0 05                  BNE   pr1   
E32E   20 18 E3               JSR   tosget   
E331   29 BF                  AND   #0BFh   
E333   20 03 FF     PR1:      JSR   CONOUT   
E336   4C 23 E3               JMP   h_print   
E339   A5 02        H_EMIT:   LDA   TL   ; "'"
E33B   20 03 FF               JSR   CONOUT   
E33E   4C AA E1     PDROP:    JMP   drop   
E341                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E341                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E341                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E341   A5 03        H_NUM:    LDA   TH   
E343   10 08                  BPL   pn1   
E345   A9 2D                  LDA   #"-"   
E347   20 03 FF               JSR   CONOUT   
E34A   20 41 E2               JSR   neg   
E34D   CA           PN1:      DEX      ; the spare cell
E34E   A9 0A                  LDA   #10   
E350   85 08                  STA   D0   
E352   A9 00                  LDA   #0   
E354   85 09                  STA   D1   
E356   48                     PHA      ; the end marker
E357   20 D8 E2     PN2:      JSR   udiv   
E35A   B5 10                  LDA   DSL,X   
E35C   09 30                  ORA   #"0"   
E35E   48                     PHA      
E35F   A5 02                  LDA   TL   
E361   05 03                  ORA   TH   
E363   D0 F2                  BNE   pn2   
E365   E8                     INX      
E366   68           PN3:      PLA      
E367   F0 D5                  BEQ   pdrop   
E369   20 03 FF               JSR   CONOUT   
E36C   4C 66 E3               JMP   pn3   
E36F   A0 01        H_FETCH:   LDY   #1   ; "@"
E371   B1 02                  LDA   (TL),Y   
E373   48                     PHA      ; the high byte, while "," gets the low one
E374   20 7B E3               JSR   h_cfetch   
E377   68                     PLA      
E378   85 03                  STA   TH   
E37A   60                     RTS      
E37B                H_CFETCH:      ; ","
E37B   A0 00                  LDY   #0   
E37D   B1 02                  LDA   (TL),Y   
E37F   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E381   84 03                  STY   TH   
E383   60                     RTS      
E384                             ; "?" ( n -- c ) or ( -n -- addr )
E384                             ;   n > 0: wait about n ms for a key; 0 if none came
E384                             ;   n = 0: wait for a key
E384                             ;   n < 0: read a line of at most -n characters, with echo. n is not
E384                             ;          checked: the buffer holds 127 characters and the CR, so a
E384                             ;          program must ask for 127 or fewer.
E384   A5 03        H_KEY:    LDA   TH   
E386   30 20                  BMI   line   
E388   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E38A   20 06 FF     KT2:      JSR   getk   
E38D   D0 15                  BNE   kt3   
E38F   88                     DEY      
E390   D0 F8                  BNE   kt2   
E392   A5 02                  LDA   TL   ; count the millisecond off:
E394   D0 06                  BNE   kt4   
E396   A5 03                  LDA   TH   
E398   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E39A   C6 03                  DEC   TH   
E39C   C6 02        KT4:      DEC   TL   
E39E   D0 E8                  BNE   kt1   
E3A0   A5 03                  LDA   TH   
E3A2   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E3A4   A0 00        KT3:      LDY   #0   
E3A6   F0 D7                  BEQ   cf2   ; always: TOS = A
E3A8                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E3A8                             ; (stored, not echoed), every other key is stored and echoed until the line
E3A8                             ; is full. Y = the length so far; TL = the most allowed.
E3A8   20 41 E2     LINE:     JSR   neg   ; TL = the count
E3AB   A0 00                  LDY   #0   
E3AD   F0 03                  BEQ   ln2   ; always
E3AF   20 03 FF     LN3:      JSR   CONOUT   
E3B2   20 06 FF     LN2:      JSR   getk   
E3B5   F0 FB                  BEQ   ln2   
E3B7   C9 0D                  CMP   #13   
E3B9   F0 14                  BEQ   ln5   
E3BB   C9 08                  CMP   #8   
E3BD   F0 0A                  BEQ   ln4   
E3BF   C4 02                  CPY   TL   
E3C1   B0 EF                  BCS   ln2   ; full
E3C3   99 80 04               STA   LINEBUF,Y   
E3C6   C8                     INY      
E3C7   D0 E6                  BNE   ln3   ; always: echo it
E3C9   88           LN4:      DEY      ; Backspace: one back, and echo it,
E3CA   10 E3                  BPL   ln3   
E3CC   C8                     INY      ;   unless the line was empty
E3CD   F0 E3                  BEQ   ln2   ; always
E3CF   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E3D2   A9 80                  LDA   #<LINEBUF   
E3D4   85 02                  STA   TL   
E3D6   A9 04                  LDA   #>LINEBUF   
E3D8   85 03                  STA   TH   
E3DA   60                     RTS      
E3DB                             ; =============================================================================
E3DB                             ;  Machine code: the grave
E3DB                             ; =============================================================================
E3DB                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E3DB                             ; are stored from addr until a non-hex character; then a RET (60h) is
E3DB                             ; written and its address is left. An odd last digit is consumed and dropped.
E3DB                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E3DB                             ; contract in the header.
E3DB   20 0A E4     H_GRAVE:   JSR   rdhex   
E3DE   B0 1C                  BCS   exec   
E3E0   0A           HX1:      ASL      
E3E1   0A                     ASL      
E3E2   0A                     ASL      
E3E3   0A                     ASL      
E3E4   85 04                  STA   T0   
E3E6   20 0A E4               JSR   rdhex   
E3E9   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E3EB   05 04                  ORA   T0   
E3ED                          IF   CHECKED   
                              STA   T0   
                              LDA   TH   
                              JSR   chkst   
                              LDA   T0   
E3ED                          ENDIF      
E3ED   91 02                  STA   (TL),Y   ; Y is 0 after rdhex
E3EF   20 1C E3               JSR   inctos   
E3F2   20 0A E4               JSR   rdhex   
E3F5   90 E9                  BCC   hx1   
E3F7                HX2:         
E3F7                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E3F7                          ENDIF      
E3F7   A9 60                  LDA   #60h   
E3F9   91 02                  STA   (TL),Y   
E3FB   60                     RTS      
E3FC   A5 02        EXEC:     LDA   TL   
E3FE   85 04                  STA   T0   
E400   A5 03                  LDA   TH   
E402   85 05                  STA   T1   
E404   20 AA E1               JSR   drop   ; the address is consumed
E407   6C 04 00               JMP   (T0)   
E40A                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E40A                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E40A                             ; Y = 0.
E40A   20 5B E1     RDHEX:    JSR   isdig   
E40D   90 0A                  BCC   rh1   
E40F   29 DF                  AND   #0DFh   
E411   E9 11                  SBC   #11h   ; (the carry is set)
E413   C9 06                  CMP   #6   
E415   B0 05                  BCS   rh9   
E417   69 0A                  ADC   #10   
E419   4C 6C E1     RH1:      JMP   incip   
E41C   60           RH9:      RTS      
E41D                             ; =============================================================================
E41D                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E41D                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E41D                             ;  Both keep X and Y. In the unchecked build getk is the host's KEY itself.
E41D                             ; =============================================================================
E41D                          IF   1-CHECKED   
E41D                GETK:     EQU   KEY   ; the host's routine does the whole job
E41D                          ENDIF      
E41D                          IF   CHECKED   
                    GETK:     LDA   KEYBUF   ; a key held back by the break check
                              BEQ   gk1   
                              PHA      
                              LDA   #0   
                              STA   KEYBUF   
                              PLA      
                              RTS      
                    GK1:      JMP   KEY   
E41D                          ENDIF      
E41D                             ; =============================================================================
E41D                             ;  Checked build: break key and error reports
E41D                             ; =============================================================================
E41D                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?". Keeps the flags.
                    CHKBRK:   PHP      
                              JSR   getk   
                              BEQ   cb9   
                              CMP   #3   
                              BEQ   e_break   
                              STA   KEYBUF   
                    CB9:      PLP      
                              RTS      
                    E_BREAK:   LDA   #"B"   ; Ctrl-C
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                                 ; The hardware stack is left as it is: it wraps inside its page, so the
                                 ; calls below work whatever state it is in.
                    ERROR:    LDX   #DSE   ; (the number printer uses a data cell)
                              JSR   CONOUT   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   #"@"   
                              JSR   CONOUT   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   IP   
                              SEC      
                              SBC   #<PROG1   ; the character just read
                              STA   TL   
                              LDA   IP+1   
                              SBC   #>PROG1   
                              STA   TH   
                              JSR   h_num   
                              JMP   endprog   
E41D                          ENDIF      


