  1957                              <1> iat_end:
  1958                              <1> 
  1959                              <1> ; =============================================================================
  1960                              <1> ;  The letters and digits, the return stack's push, and the inner loop
  1961                              <1> ; =============================================================================
  1962                              <1> 
  1963                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
  1964                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
  1965 00000760 89F2                <1> upper:  mov     edx,esi
  1966 00000762 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
  1967                              <1> 
  1968                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
  1969                              <1> ; return stack ends here, and the true ')' comes to rpoll.
  1970                              <1> ;
  1971                              <1> ; The break key is looked at here, so at every word call and loop-back (and
  1972                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
  1973 0000076A 83EF04              <1> rpush:  sub     edi,4
  1974 0000076D 8917                <1>         mov     [edi],edx
  1975 0000076F FE4D64              <1> rpoll:  dec     byte [V(v_pcnt)]
  1976 00000772 7505                <1>         jnz     .rp1
  1977 00000774 E8C3FDFFFF          <1>         call    pollk
  1978 00000779 FFE5                <1> .rp1:   jmp     ebp
  1979                              <1> 
  1980                              <1> ; =============================================================================
  1981                              <1> ;  The inner loop: read one character and sort it by range.
  1982                              <1> ;
  1983                              <1> ;    00h          end of program
  1984                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1985                              <1> ;                 build stops on 80h-FFh: X)
  1986                              <1> ;    30h-39h      digit: read a whole number
  1987                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1988                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1989                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1990                              <1> ; =============================================================================
  1991                              <1> ; Digits: step back onto the first digit and read the whole number.
  1992 0000077B 53                  <1> digit:  push    ebx
  1993 0000077C 4E                  <1>         dec     esi
  1994 0000077D E80CFBFFFF          <1>         call    rdnum
  1995 00000782 FFE5                <1>         jmp     ebp
  1996                              <1> 
  1997                              <1> ; a-z: push the cell's address (the cell is the variable).
  1998 00000784 53                  <1> lower:  push    ebx
  1999 00000785 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  2000 0000078C FFE5                <1>         jmp     ebp
  2001                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  2002                              <1> ; next in reach)
  2003 0000078E 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  2004 00000790 7505                <1>         jnz     next                    ; the rest are ignored
  2005 00000792 E9E0FDFFFF          <1>         jmp     endprog
  2006                              <1> %if CHECKED
  2007                              <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  2008                              <1>         jmp     error
  2009                              <1> %endif
  2010                              <1> next:
  2011                              <1> %if CHECKED
  2012                              <1>         call    chkstk                  ; both stacks, once per character
  2013                              <1> %endif
  2014 00000797 31C0                <1>         xor     eax,eax
  2015 00000799 AC                  <1>         lodsb
  2016 0000079A 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  2017 0000079C 72F0                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  2018 0000079E 3C0F                <1>         cmp     al,0Fh
  2019 000007A0 7222                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  2020 000007A2 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  2021 000007A4 3C0A                <1>         cmp     al,0Ah
  2022 000007A6 72D3                <1>         jb      digit                   ; 30h-39h
  2023 000007A8 3C11                <1>         cmp     al,11h
  2024 000007AA 7216                <1>         jb      p3a                     ; 3Ah-40h
  2025 000007AC 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  2026 000007AE 3C1A                <1>         cmp     al,1Ah
  2027 000007B0 72AE                <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  2028 000007B2 3C20                <1>         cmp     al,20h
  2029 000007B4 720A                <1>         jb      p5b                     ; 5Bh-60h
  2030 000007B6 3C3A                <1>         cmp     al,3Ah
  2031 000007B8 72CA                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
