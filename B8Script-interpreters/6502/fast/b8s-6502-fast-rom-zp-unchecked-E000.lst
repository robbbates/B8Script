E93D   E5 05                  SBC   D0   
E93F   A8                     TAY      
E940   B5 FF                  LDA   0FFh,X   
E942   E5 06                  SBC   D1   
E944   90 06                  BCC   uv15   
E946   95 FF                  STA   0FFh,X   
E948   94 FE                  STY   0FEh,X   
