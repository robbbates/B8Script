                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FVST:     INC   BC   ; x!: the cell = TOS, and NOS comes up
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
