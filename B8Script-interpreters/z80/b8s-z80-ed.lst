0161   21 00 00               LD   HL,0   
0164   06 10                  LD   B,16   
0166   29           MUL1:     ADD   HL,HL   
0167   CB 21                  SLA   C   
0169   17                     RLA      
016A   30 01                  JR   NC,mul2   
016C   19                     ADD   HL,DE   
016D   10 F7        MUL2:     DJNZ   mul1   
016F   C1                     POP   BC   
0170   F7                     RST   30h   
0171                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
0171                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0171                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0171   D1           H_DIV:    POP   DE   ; DE = a, HL = b
