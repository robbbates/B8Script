F342   8C                     FCB   8Ch   
F343   86 51        E_QUOTE:   LDA   #"Q"   ; " or $ ran into the NUL
F345                             ; and fall into error. (H, W and N have their own entries, near
F345                             ; their handlers, at ejmp.)
F345                             ; =============================================================================
F345                             ;  Checked build: the error report. A = the letter, AT = the place; U is
F345                             ;  as the program left it, and SSAV holds S as the failing character began
F345                             ;  (see "the error entries" after `upper`).
F345                             ;  It sits here, ahead of h_num, pdec and putc, so that it reaches them with
F345                             ;  short calls. Prints
F345                             ; 
F345                             ;     CR LF
F345                             ;     Err X @ line,col CR LF
F345                             ;     <up to 16 raw characters from the place, ending early at CR, LF, NUL>
F345                             ;     CR LF
F345                             ;     Stk n:[ ...][ v]*  CR LF     (the top 8 cells, bottom to top, signed)
F345                             ;     Rtn n CR LF
F345                             ; 
F345                             ;  and goes to EXIT. Line and column count from 1: the line is one more
F345                             ;  than the LFs between PROG and the place, the column the distance from the
F345                             ;  last LF (or from PROG-1). A place below PROG is in the -n? line buffer:
F345                             ;  line 0, column = its offset there + 1. Numbers other than the cells are
F345                             ;  printed unsigned (pdec), the cells signed (h_num).
F345                             ; 
F345                             ;  The data stack may be one cell past its limit (S, U = 80FEh): the
F345                             ;  report's own cells then reach 8 bytes further down, to 80F6h, into the
F345                             ;  return stack page, so the report runs on a fresh return stack at RSREP
F345                             ;  (80F0h), below those bytes.
F345                             ; =============================================================================
F345   10 CE 80 F0  ERROR:    LDS   #RSREP   
F349   1F 89                  TFR   A,B   ; the letter (pmsg and CONOUT keep B)
F34B   8D 34                  BSR   pmsg   
F34D   0D 0A 45 72 72 A0      FCB   13,10,"Err"," "+80h   
F353   1F 98                  TFR   B,A   
F355   BD FF 03               JSR   CONOUT   
F358   8D 27                  BSR   pmsg   
F35A   20 40 A0               FCB   " @"," "+80h   
F35D                             ; the place: Y counts the lines, X walks, the cell at ,U holds the
F35D                             ; address of the last LF (PROG-1 to begin with)
F35D   10 8E 00 00            LDY   #0   
F361   8E 82 7F               LDX   #LINEBUF-1   
F364   36 10                  PSHU   X   
F366   8E 82 FF               LDX   #PROG-1   
F369   9C 36                  CMPX   <AT   
F36B   24 23                  BHS   lc3   ; the place is below PROG: line 0
F36D   AF C4                  STX   ,U   
F36F   31 21        LC1:      LEAY   1,Y   ; a line
F371   30 01        LC2:      LEAX   1,X   
F373   9C 36                  CMPX   <AT   
F375   24 19                  BHS   lc3   
F377   A6 84                  LDA   ,X   
F379   81 0A                  CMPA   #10   
F37B   26 F4                  BNE   lc2   
F37D   AF C4                  STX   ,U   
F37F   20 EE                  BRA   lc1   
F381                             ; pmsg: print the text after the call, up to and including the character
F381                             ; that has bit 7 set (it is printed without it), then return after it.
F381                             ; (It sits here, in the middle of the report, where all its calls reach.)
F381   35 10        PMSG:     PULS   X   
F383   A6 84        PM1:      LDA   ,X   
F385   84 7F                  ANDA   #7Fh   
F387   BD F4 31               JSR   putc   
F38A   6D 80                  TST   ,X+   
F38C   2A F5                  BPL   pm1   
F38E   6E 84                  JMP   ,X   
F390   DC 36        LC3:      LDD   <AT   
F392   A3 C4                  SUBD   ,U   
F394   ED C4                  STD   ,U   ; the column
F396   36 20                  PSHU   Y   
F398   BD F4 19               JSR   pdec   ; the line
F39B   8D E4                  BSR   pmsg   
F39D   AC                     FCB   ","+80h   
F39E   8D 79                  BSR   pdec   ; the column
F3A0   8D DF                  BSR   pmsg   
F3A2   0D 8A                  FCB   13,10+80h   
F3A4                             ; the text at the place
F3A4   9E 36                  LDX   <AT   
F3A6   C6 10                  LDB   #16   
F3A8   A6 80        TX1:      LDA   ,X+   
F3AA   27 0D                  BEQ   tx9   
F3AC   81 0A                  CMPA   #10   
F3AE   27 09                  BEQ   tx9   
F3B0   81 0D                  CMPA   #13   
F3B2   27 05                  BEQ   tx9   
F3B4   8D 7B                  BSR   putc   
F3B6   5A                     DECB      
F3B7   26 EF                  BNE   tx1   
F3B9   8D C6        TX9:      BSR   pmsg   
F3BB   0D 0A 53 74 6B A0      FCB   13,10,"Stk"," "+80h   
F3C1                             ; the data stack: its depth, then its top 8 cells, from Y down to
F3C1                             ; the program's top cell, at ,U.
F3C1   34 40                  PSHS   U   ; where the walk ends
F3C3   CC 81 FC               LDD   #DSTOP   
F3C6   A3 E4                  SUBD   ,S   
F3C8   8D 3F                  BSR   pdh   ; the depth (pdec leaves U as it was)
F3CA   8D B5                  BSR   pmsg   
F3CC   BA                     FCB   ":"+80h   
F3CD   31 C8 10               LEAY   16,U   ; past the 8th cell from the top ...
F3D0   10 8C 81 FC            CMPY   #DSTOP   
F3D4   24 08                  BHS   sl1   
F3D6   8D A9                  BSR   pmsg   ; (there are more than 8)
F3D8   20 2E 2E AE            FCB   " ..","."+80h   
F3DC   20 04                  BRA   sl2   
F3DE   10 8E 81 FC  SL1:      LDY   #DSTOP   ; ... or the whole stack, if no more than 8
F3E2   10 AC E4     SL2:      CMPY   ,S   
F3E5   23 0B                  BLS   sl9   
F3E7   EC A3                  LDD   ,--Y   
F3E9   36 06                  PSHU   D   
F3EB   8D 94                  BSR   pmsg   
F3ED   A0                     FCB   " "+80h   
F3EE   8D 1F                  BSR   h_num   
F3F0   20 F0                  BRA   sl2   
F3F2   8D 8D        SL9:      BSR   pmsg   
F3F4   0D 0A 52 74 6E A0      FCB   13,10,"Rtn"," "+80h   
F3FA   CC 81 00               LDD   #RSTOP   ; the return stack's depth, (RSTOP - S) / 2,
F3FD   93 3A                  SUBD   <SSAV   ;   S as it was when this character began
F3FF   8D 08                  BSR   pdh   
F401   BD F3 81               JSR   pmsg   
F404   0D 8A                  FCB   13,10+80h   
F406   7E FF 09               JMP   EXIT   
F409                             ; pdh: print D/2 (a depth: D is twice it), unsigned.
F409   44           PDH:      LSRA      
F40A   56                     RORB      
F40B   36 06                  PSHU   D   
F40D   20 0A                  BRA   pdec   
F40F                          ENDIF      
F40F                             ; "#" prints TOS as a signed decimal number, with no space after it.
F40F   6D C4        H_NUM:    TST   ,U   
F411   2A 06                  BPL   pdec   
F413   86 2D                  LDA   #"-"   
F415   8D 1A                  BSR   putc   
F417   8D 5E                  BSR   negt   
F419                             ; pdec: print the top cell as unsigned and drop it, by recursion on /10
F419   CC 00 0A     PDEC:     LDD   #10   
F41C   36 06                  PSHU   D   
F41E   8D 68                  BSR   udiv   ; NOS = quotient, TOS = digit
F420   37 06                  PULU   D   ; the digit
F422   34 04                  PSHS   B   
F424   EC C4                  LDD   ,U   
F426   27 03                  BEQ   pd1   
F428   8D EF                  BSR   pdec   ; (it drops the quotient)
F42A   8C                     FCB   8Ch   ; (CMPX #: steps over the LEAU)
F42B   33 42        PD1:      LEAU   2,U   ; drop the zero quotient
F42D   35 02                  PULS   A   
F42F   8B 30                  ADDA   #"0"   ; and fall into putc
F431   7E FF 03     PUTC:     JMP   CONOUT   
F434                             ; ---- more arithmetic ---------------------------------------------------------
F434   EC C1        H_AND:    LDD   ,U++   
F436   A4 C4                  ANDA   ,U   
F438   E4 41                  ANDB   1,U   
F43A   20 04                  BRA   st   
F43C   EC C1        H_ADD:    LDD   ,U++   
F43E   E3 C4                  ADDD   ,U   
F440   ED C4        ST:       STD   ,U   
F442   39                     RTS      
F443                             ; "-" has two jobs: directly before a digit it starts a negative number.
F443   BD F0 BB     H_SUB:    JSR   isdig   
F446   25 2C                  BLO   negnum   
F448   EC 42                  LDD   2,U   
F44A   A3 C1                  SUBD   ,U++   
F44C   20 F2                  BRA   st   
F44E                             ; ---- the tail ---------------------------------------------------------------
F44E                             ; "/" is the last handler, so what follows its first byte may lie past the
F44E                             ; second range: the divide itself and the routines after it.
F44E                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
F44E                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F44E                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
F44E                             ; it stops with Z, both operands still on the stack.
F44E                H_DIV:       
F44E                          IF   CHECKED   
F44E   EC C4                  LDD   ,U   
F450   10 27 FE EC            LBEQ   e_zero   
F454                          ENDIF      
F454   A6 42                  LDA   2,U   
F456   34 02                  PSHS   A   ; a's sign: for r
F458   A8 C4                  EORA   ,U   
F45A   34 02                  PSHS   A   ; a xor b: for q
F45C   30 42                  LEAX   2,U   
F45E   8D 22                  BSR   absx   ; |a|
F460   1F 31                  TFR   U,X   
F462   8D 1E                  BSR   absx   ; |b|
F464   8D 22                  BSR   udiv   ; NOS = q, TOS = r
F466   30 42                  LEAX   2,U   
F468   6D E0                  TST   ,S+   
F46A   2A 02                  BPL   dv1   
F46C   8D 0B                  BSR   negx   ; q's sign
F46E   6D E0        DV1:      TST   ,S+   
F470   2A 0F                  BPL   ng9   
F472   20 03                  BRA   negt   ; r's sign
F474   BD F0 C2     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F477   1F 31        NEGT:     TFR   U,X   
F479   EC 84        NEGX:     LDD   ,X   ; negx: negate the cell at X
F47B   40                     NEGA      
F47C   50                     NEGB      
F47D   82 00                  SBCA   #0   
F47F   ED 84                  STD   ,X   
F481   39           NG9:      RTS      
F482   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F484   2A FB                  BPL   ng9   
F486   20 F1                  BRA   negx   
F488                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F488                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F488                             ; the TOS cell the remainder. The remainder is built in D (always < the
F488                             ; divisor, so 2R+1 fits in 16 bits).
F488                             ; Dividing by 2 is one shift (the spec wants that fast).
F488   EC C4        UDIV:     LDD   ,U   
F48A   83 00 02               SUBD   #2   
F48D   26 07                  BNE   ud0   
F48F   64 42                  LSR   2,U   
F491   66 43                  ROR   3,U   ; the quotient
F493   59                     ROLB      ; the remainder: the bit that fell out (D was 0)
F494   20 18                  BRA   ud3   
F496   8E 00 10     UD0:      LDX   #16   
F499   4F                     CLRA      
F49A   5F                     CLRB      
F49B   68 43        UD1:      ASL   3,U   
F49D   69 42                  ROL   2,U   ; the dividend's top bit ...
F49F   59                     ROLB      
F4A0   49                     ROLA      ; ... into the remainder
F4A1   10 A3 C4               CMPD   ,U   
F4A4   25 04                  BLO   ud2   
F4A6   A3 C4                  SUBD   ,U   
F4A8   6C 43                  INC   3,U   ; a quotient bit
F4AA   30 1F        UD2:      LEAX   -1,X   
F4AC   26 ED                  BNE   ud1   
F4AE   ED C4        UD3:      STD   ,U   
F4B0   39                     RTS      
F4B1                             ; =============================================================================
F4B1                             ;  The grave's codes (h_grave is the dispatcher). Each is entered with
F4B1                             ;  A = the character, and ends in RTS.
F4B1                             ; 
F4B1                             ;    `!  ( addr -- )        call the machine code at addr. The code is
F4B1                             ;                           entered with the address already popped: U
F4B1                             ;                           points at the top data cell (big-endian) and the
F4B1                             ;                           dispatcher's return address is on top of S. It
F4B1                             ;                           may pop and push data cells by changing U; on
F4B1                             ;                           return the cell at ,U is the new TOS. It must
F4B1                             ;                           keep Y, DP and S (balanced) and return with RTS;
F4B1                             ;                           A, B, X and CC may change.
F4B1                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
F4B1                             ;                           from addr until a non-hex character; then a RTS
F4B1                             ;                           (39h) is written and its address is left. An odd
F4B1                             ;                           last digit is consumed and dropped.
F4B1                             ;    `'  ( -- )             new line: CR LF
F4B1                             ;    `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
F4B1                             ;    `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
F4B1                             ;    `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
F4B1                             ;    `.  ( -- addr )        the address of the random seed
F4B1                             ;    `<  ( a b -- n )       the smaller of the two (signed)
F4B1                             ;    `>  ( a b -- n )       the larger
F4B1                             ;    `?  ( flag -- )        the cursor off (0) or on
F4B1                             ;    `@  ( row col -- )     the cursor to that row and column, both from 0
F4B1                             ;    `^  ( -- )             clear the screen and home the cursor
F4B1                             ;    `_  ( -- )             clear from the cursor to the end of the line
F4B1                             ; 
F4B1                             ;  Neither the loader's stores nor the machine code are checked.
F4B1                             ; =============================================================================
F4B1                GBASE:       
F4B1                             ; `, The seed goes one step on: seed * 261 + 1, which takes every 16-bit
F4B1                             ; value in turn. The high bits of such a seed are the good ones and the low
F4B1                             ; ones repeat soon, so the high byte is folded into the low (EOR) before the
F4B1                             ; remainder of dividing by n is taken.
F4B1                             ; n must be 1 to 32767: the checked build stops with Z on anything less
F4B1                             ; than 1.
F4B1                G_RND:       
F4B1                          IF   CHECKED   
F4B1   EC C4                  LDD   ,U   
F4B3   83 00 01               SUBD   #1   ; n - 1 negative: n is 0 or less
F4B6   10 2B FE 86            LBMI   e_zero   
F4BA                          ENDIF      
F4BA   D6 76                  LDB   <SEED   ; (the cell is little-endian)
F4BC   96 77                  LDA   <SEED+1   
F4BE   58                     ASLB      
F4BF   49                     ROLA      
F4C0   58                     ASLB      
F4C1   49                     ROLA      
F4C2   DB 76                  ADDB   <SEED   
F4C4   99 77                  ADCA   <SEED+1   ; * 5
F4C6   9B 76                  ADDA   <SEED   ; + * 256: * 261
F4C8   C3 00 01               ADDD   #1   
F4CB   D7 76                  STB   <SEED   
F4CD   97 77                  STA   <SEED+1   
F4CF   D8 77                  EORB   <SEED+1   
F4D1   AE C4                  LDX   ,U   ; n
F4D3   ED C4                  STD   ,U   ; the dividend under it
F4D5   36 10                  PSHU   X   
F4D7   8D AF                  BSR   udiv   ; NOS = the quotient, TOS = the remainder
F4D9   37 06                  PULU   D   
F4DB   ED C4                  STD   ,U   
F4DD   39                     RTS      
F4DE                             ; `+ and `-: one routine. "," minus the character is 1 or -1.
F4DE   AE C4        G_INC:    LDX   ,U   
F4E0                          IF   CHECKED   
F4E0   BD F3 32               JSR   chkst   ; both bytes are tested first, as "!" does
F4E3   30 01                  LEAX   1,X   
F4E5   BD F3 32               JSR   chkst   
F4E8   30 1F                  LEAX   -1,X   
F4EA                          ENDIF      
F4EA   40                     NEGA      
F4EB   8B 2C                  ADDA   #","   
F4ED   1F 89                  TFR   A,B   
F4EF   1D                     SEX      
F4F0   EB 84                  ADDB   ,X   ; (the cell is little-endian)
F4F2   A9 01                  ADCA   1,X   
F4F4   E7 84                  STB   ,X   
F4F6   A7 01                  STA   1,X   
F4F8   ED C4                  STD   ,U   ; the new value is TOS
F4FA   39                     RTS      
F4FB                             ; `. pushes the address of the random seed.
F4FB   8E 82 76     G_SEED:   LDX   #LET+SEED   
F4FE   36 10                  PSHU   X   
F500   39                     RTS      
F501                             ; `< and `>: b is taken off and compared with a; it goes in a's place if it
F501                             ; is the one wanted.
F501   8D 0B        G_MAX:    BSR   gcmp   
F503   2F 08                  BLE   gm9   
F505   20 04                  BRA   gm8   
F507   8D 05        G_MIN:    BSR   gcmp   
F509   2C 02                  BGE   gm9   
F50B   ED C4        GM8:      STD   ,U   
F50D   39           GM9:      RTS      
F50E   EC C1        GCMP:     LDD   ,U++   
F510   10 A3 C4               CMPD   ,U   ; b - a
F513   39                     RTS      
F514   86 0D        G_NL:     LDA   #13   
F516   8D 54                  BSR   gputc   
F518   86 0A                  LDA   #10   
F51A   20 50                  BRA   gputc   
F51C   AE C4        G_HEX:    LDX   ,U   
F51E   BD F1 B9     HX1:      JSR   hexc   
F521   24 10                  BCC   hx2   
F523   C6 10                  LDB   #16   
F525   3D                     MUL      ; B = the digit, moved up to the high half
F526   E7 84                  STB   ,X   ; (an odd digit is overwritten by the RTS)
F528   BD F1 B9               JSR   hexc   
F52B   24 06                  BCC   hx2   ; odd digit: already consumed, dropped
F52D   AA 84                  ORA   ,X   
F52F   A7 80                  STA   ,X+   
F531   20 EB                  BRA   hx1   
F533   86 39        HX2:      LDA   #39h   ; RTS
F535   A7 84                  STA   ,X   
F537   AF C4                  STX   ,U   
F539   39                     RTS      
F53A   37 80        G_EXEC:   PULU   PC   ; jump to it: the code's RTS returns to the
F53C                             ;   dispatcher
F53C                          IF   ANSI   
F53C                             ; `^: ESC [ H homes the cursor, and ESC [ J clears from there to the end of
F53C                             ; the screen. `_: ESC [ K clears to the end of the line. (CONOUT keeps B.)
F53C   8D 28        G_CLS:    BSR   csi   
F53E   86 48                  LDA   #"H"   
F540   8D 2A                  BSR   gputc   
F542   C6 4A                  LDB   #"J"   
F544   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F545   C6 4B        G_EOL:    LDB   #"K"   
F547   8D 1D                  BSR   csi   
F549   1F 98                  TFR   B,A   
F54B   20 1F                  BRA   gputc   
