02D8   E3           H_SWAP:   XTHL      
02D9   D7                     RST   2   
02DA                          ENDIF      
02DA   EB           H_TOR:    XCHG      ; "{" TOS to the return stack
02DB   CD DF 01               CALL   rpush   
02DE   CF                     RST   1   
02DF   E5           H_FROMR:   PUSH   H   ; "}" return stack to TOS
02E0   CD EA 01               CALL   rpop   
