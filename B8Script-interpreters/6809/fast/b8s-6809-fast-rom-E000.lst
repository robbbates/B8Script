E5B3   37 06        FS_ADD:   PULU   D   ; +
E5B5   E3 C4                  ADDD   ,U   
E5B7   ED C4                  STD   ,U   
E5B9                          ;*Macro unroll:  NEXTF
E5B9   BD                     DS   CHECKED,0BDh   
E5BA   E4                     DS   CHECKED,ACHK/256   
E5BB   A5                     DS   CHECKED,ACHK&0FFh   
E5BC   E6 A0                  LDB   ,Y+   
E5BE   8E EE A1               LDX   #FTAB   
E5C1   3A                     ABX      
E5C2   3A                     ABX      
E5C3   6E 94                  JMP   [,X]   
E5C5   A6 A4        FS_SUB:   LDA   ,Y   ; -  (a digit next: a negative number)
E5C7   80 30                  SUBA   #"0"   
E5C9   81 0A                  CMPA   #10   
