  2339                              <1> ;  The imports: kernel32.dll only. An import directory entry, the import
  2340                              <1> ;  lookup table, the hint/name entries and the DLL's name; then the import
  2341                              <1> ;  address table, which the loader fills in, right below `next` (with the
  2342                              <1> ;  routine pointers after it), so that CALL [EBP+d8] reaches it.
  2343                              <1> ; =============================================================================
  2344                              <1> %macro  IMPORTS 1
  2345                              <1>         IMP     GetStdHandle
  2346                              <1>         IMP     GetConsoleMode
  2347                              <1>         IMP     SetConsoleMode
  2348                              <1>         IMP     GetCommandLineA
  2349                              <1>         IMP     CreateFileA
