02B6   4D                     LD   C,L   
02B7   21 00 00               LD   HL,0   
02BA   CB 21                  SLA   C   
02BC   17                     RLA      
02BD   ED 6A                  ADC   HL,HL   
02BF   ED 52                  SBC   HL,DE   
02C1   30 02                  JR   NC,uvr0   
02C3   19                     ADD   HL,DE   
02C4   0D                     DEC   C   
02C5   0C           UVR0:     INC   C   
02C6   CB 21                  SLA   C   
02C8   17                     RLA      
02C9   ED 6A                  ADC   HL,HL   
02CB   ED 52                  SBC   HL,DE   
02CD   30 02                  JR   NC,uvr1   
02CF   19                     ADD   HL,DE   
02D0   0D                     DEC   C   
02D1   0C           UVR1:     INC   C   
02D2   CB 21                  SLA   C   
02D4   17                     RLA      
02D5   ED 6A                  ADC   HL,HL   
02D7   ED 52                  SBC   HL,DE   
02D9   30 02                  JR   NC,uvr2   
02DB   19                     ADD   HL,DE   
02DC   0D                     DEC   C   
02DD   0C           UVR2:     INC   C   
02DE   CB 21                  SLA   C   
02E0   17                     RLA      
02E1   ED 6A                  ADC   HL,HL   
02E3   ED 52                  SBC   HL,DE   
02E5   30 02                  JR   NC,uvr3   
02E7   19                     ADD   HL,DE   
02E8   0D                     DEC   C   
02E9   0C           UVR3:     INC   C   
02EA   CB 21                  SLA   C   
02EC   17                     RLA      
02ED   ED 6A                  ADC   HL,HL   
02EF   ED 52                  SBC   HL,DE   
02F1   30 02                  JR   NC,uvr4   
02F3   19                     ADD   HL,DE   
02F4   0D                     DEC   C   
02F5   0C           UVR4:     INC   C   
02F6   CB 21                  SLA   C   
02F8   17                     RLA      
02F9   ED 6A                  ADC   HL,HL   
02FB   ED 52                  SBC   HL,DE   
02FD   30 02                  JR   NC,uvr5   
02FF   19                     ADD   HL,DE   
0300   0D                     DEC   C   
0301   0C           UVR5:     INC   C   
0302   CB 21                  SLA   C   
0304   17                     RLA      
0305   ED 6A                  ADC   HL,HL   
0307   ED 52                  SBC   HL,DE   
0309   30 02                  JR   NC,uvr6   
030B   19                     ADD   HL,DE   
030C   0D                     DEC   C   
030D   0C           UVR6:     INC   C   
030E   CB 21                  SLA   C   
0310   17                     RLA      
0311   ED 6A                  ADC   HL,HL   
0313   ED 52                  SBC   HL,DE   
0315   30 02                  JR   NC,uvr7   
0317   19                     ADD   HL,DE   
0318   0D                     DEC   C   
0319   0C           UVR7:     INC   C   
031A   CB 21                  SLA   C   
031C   17                     RLA      
031D   ED 6A                  ADC   HL,HL   
031F   ED 52                  SBC   HL,DE   
0321   30 02                  JR   NC,uvr8   
0323   19                     ADD   HL,DE   
0324   0D                     DEC   C   
0325   0C           UVR8:     INC   C   
0326   CB 21                  SLA   C   
0328   17                     RLA      
0329   ED 6A                  ADC   HL,HL   
032B   ED 52                  SBC   HL,DE   
032D   30 02                  JR   NC,uvr9   
032F   19                     ADD   HL,DE   
0330   0D                     DEC   C   
0331   0C           UVR9:     INC   C   
0332   CB 21                  SLA   C   
0334   17                     RLA      
0335   ED 6A                  ADC   HL,HL   
0337   ED 52                  SBC   HL,DE   
0339   30 02                  JR   NC,uvr10   
033B   19                     ADD   HL,DE   
033C   0D                     DEC   C   
033D   0C           UVR10:    INC   C   
033E   CB 21                  SLA   C   
0340   17                     RLA      
0341   ED 6A                  ADC   HL,HL   
0343   ED 52                  SBC   HL,DE   
0345   30 02                  JR   NC,uvr11   
0347   19                     ADD   HL,DE   
0348   0D                     DEC   C   
0349   0C           UVR11:    INC   C   
034A   CB 21                  SLA   C   
034C   17                     RLA      
