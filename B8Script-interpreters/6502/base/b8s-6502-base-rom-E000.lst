E500                          IF   QK*(1-FAST)   
E500                             ; (QK: with an operand below 256, 8 rounds, not 16: that one becomes the
E500                             ; multiplier, so the product's low byte comes out of TL and its high byte is
E500                             ; left in T0. Most multiplications have one: a count or a small constant.)
E500   A5 03        H_MUL:    LDA   TH   
E502   F0 08                  BEQ   mq8   ; the multiplier is below 256
E504   BD 00 03               LDA   DSH,X   
E507   D0 2A                  BNE   mq16   
E509   20 5A E5               JSR   h_swap   ; the multiplicand is: it becomes the multiplier
E50C   A0 08        MQ8:      LDY   #8   
E50E   A9 00                  LDA   #0   
E510   85 04                  STA   T0   
E512   46 02                  LSR   TL   
E514   90 0F        MQ1:      BCC   mq2   
E516   85 05                  STA   T1   
E518   18                     CLC      
E519   A5 04                  LDA   T0   
E51B   7D 00 02               ADC   DSL,X   
E51E   85 04                  STA   T0   
E520   A5 05                  LDA   T1   
E522   7D 00 03               ADC   DSH,X   
E525   6A           MQ2:      ROR      
E526   66 04                  ROR   T0   
E528   66 02                  ROR   TL   
E52A   88                     DEY      
E52B   D0 E7                  BNE   mq1   
E52D   A5 04                  LDA   T0   
E52F   85 03                  STA   TH   
E531   E8                     INX      
E532   60                     RTS      
E533                MQ16:        
E533                          ENDIF      
E533                          IF   1-QK   
                    H_MUL:       
E533                          ENDIF      
E533                          IF   1-FAST   
E533   A0 10                  LDY   #16   ; the round count
E535   A9 00                  LDA   #0   
E537   85 04                  STA   T0   ; A:T0 = the upper half
E539   46 03                  LSR   TH   
E53B   66 02                  ROR   TL   ; the first multiplier bit
E53D   90 0F        ML1:      BCC   ml2   
E53F   85 05                  STA   T1   
E541   18                     CLC      
E542   A5 04                  LDA   T0   
E544   7D 00 02               ADC   DSL,X   
E547   85 04                  STA   T0   
E549   A5 05                  LDA   T1   
E54B   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E54E   6A           ML2:      ROR      
E54F   66 04                  ROR   T0   
E551   66 03                  ROR   TH   
E553   66 02                  ROR   TL   ; everything one place right; next bit out
E555   88                     DEY      
E556   D0 E5                  BNE   ml1   
E558   E8                     INX      ; drop the multiplicand
E559   60                     RTS      
E55A                          ENDIF      
E55A   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E55D   A5 02                  LDA   TL   
E55F   9D 00 02               STA   DSL,X   
E562   84 02                  STY   TL   
E564   BC 00 03               LDY   DSH,X   
E567   A5 03                  LDA   TH   
E569   9D 00 03               STA   DSH,X   
E56C   84 03                  STY   TH   
E56E   60                     RTS      
E56F                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E56F                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b, r is pushed
E56F                             ; and gets the sign of a. Unchecked, dividing by zero returns two cells of no
E56F                             ; meaning; checked, it stops with Z.
E56F                H_DIV:       
E56F                          IF   CHECKED   
E56F   A5 02                  LDA   TL   
E571   05 03                  ORA   TH   
E573   F0 5F                  BEQ   e_zero   
E575                          ENDIF      
E575   BD 00 03               LDA   DSH,X   
E578   48                     PHA      ; a's sign: for r
E579   45 03                  EOR   TH   
E57B   48                     PHA      ; a xor b: for q
E57C   20 C9 E4               JSR   absv   
E57F   A5 02                  LDA   TL   
E581   85 08                  STA   D0   
E583   A5 03                  LDA   TH   
E585   85 09                  STA   D1   ; D = |b|
E587   20 71 E4               JSR   drop   ; TOS = a
E58A   20 C9 E4               JSR   absv   ; TOS = |a|
E58D   20 E8 E5               JSR   udiv   ; TOS = q, T0/T1 = r
E590   68                     PLA      
E591   20 CB E4               JSR   negm   ; q's sign
E594   A5 04                  LDA   T0   
E596   A4 05                  LDY   T1   
E598   20 78 E1               JSR   pushay   ; r on top
E59B   68                     PLA      
E59C   4C CB E4               JMP   negm   ; r's sign
E59F                             ; =============================================================================
E59F                             ;  Storage
E59F                             ; =============================================================================
E59F                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E59F                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E59F                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   TL   
                              STA   HEAP   
                              STY   TL   
                              LDA   HEAP+1   
                              TAY      
                              ADC   TH   
                              STA   HEAP+1   
                              STY   TH   
                              RTS      
E59F                          ENDIF      
E59F                             ; The checked build works the new top out first, in T0 and Y, and stops with
E59F                             ; H, the count still on the stack, if it is at or past the limit, below the
E59F                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E59F                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E59F                             ; a signed number from -8000h, so the add overflows exactly when the true
E59F                             ; sum leaves 0000h-FFFFh.
E59F                          IF   CHECKED   
E59F   AD 7C 04     H_ALLOC:   LDA   HEAP   
E5A2   65 02                  ADC   TL   
E5A4   85 04                  STA   T0   
E5A6   AD 7D 04               LDA   HEAP+1   
E5A9   49 80                  EOR   #80h   
E5AB   65 03                  ADC   TH   
E5AD   70 28                  BVS   e_heap   ; wrapped
E5AF   49 80                  EOR   #80h   ; the new top's high byte
E5B1   C9 DF                  CMP   #HEAPLIM   
E5B3   B0 22                  BCS   e_heap   ; at or past the limit
E5B5   A8                     TAY      
E5B6   A5 04                  LDA   T0   
E5B8   CD 38 04               CMP   PEND   
E5BB   98                     TYA      
E5BC   ED 39 04               SBC   PEND+1   
E5BF   90 16                  BCC   e_heap   ; below the program's end
E5C1   AD 7C 04               LDA   HEAP   
E5C4   85 02                  STA   TL   
E5C6   A5 04                  LDA   T0   
E5C8   8D 7C 04               STA   HEAP   
E5CB   AD 7D 04               LDA   HEAP+1   
E5CE   85 03                  STA   TH   
E5D0   8C 7D 04               STY   HEAP+1   
E5D3   60                     RTS      
E5D4                             ; Errors found by handlers. The stacks are as they were before the handler.
E5D4   A9 5A        E_ZERO:   LDA   #"Z"   ; divide by zero
E5D6   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E5D7   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E5D9   2C                     DB   2Ch   
E5DA   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E5DC   4C F4 E6               JMP   error   
E5DF                             ; chkst: stop unless the page in A is in the program's own space, from the
E5DF                             ; letter page up to the heap limit. Keeps Y.
E5DF   C9 04        CHKST:    CMP   #LETPAGE   
E5E1   90 F7                  BCC   e_store   
E5E3   C9 DF                  CMP   #HEAPLIM   
E5E5   B0 F3                  BCS   e_store   
E5E7   60                     RTS      
E5E8                          ENDIF      
E5E8                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and T0/T1
E5E8                             ; the remainder. The low byte of each trial subtraction waits on the
E5E8                             ; hardware stack.
E5E8                             ; Dividing by 2 is one shift (the spec wants that fast).
E5E8   A9 00        UDIV:     LDA   #0   
E5EA   85 04                  STA   T0   
E5EC   85 05                  STA   T1   
E5EE                          IF   1-QK   
                              LDA   D0   
                              EOR   #2   
                              ORA   D1   
                              BNE   ud0   
                              LSR   TH   
                              ROR   TL   ; the quotient
                              ROL   T0   ; the remainder: the bit that fell out
                              RTS      
E5EE                          ENDIF      
E5EE                          IF   QK   
E5EE                             ; (QK: any power of two is shifts: 2, and 32, 64, 256 and the like, which
E5EE                             ; fixed point and byte work use all the time.)
E5EE   A4 08                  LDY   D0   
E5F0   A5 09                  LDA   D1   
E5F2   D0 12                  BNE   uq1   ; 256 and up
E5F4   98                     TYA      
E5F5   F0 38                  BEQ   ud0   ; by 0: the long way (it means nothing anyway)
E5F7   88                     DEY      
E5F8   98                     TYA      
E5F9   25 08                  AND   D0   
E5FB   D0 32                  BNE   ud0   ; not a power of two
E5FD   98                     TYA      ; by 2^k below 256: r = a & (2^k - 1),
E5FE   25 02                  AND   TL   
E600   85 04                  STA   T0   
E602   A5 08                  LDA   D0   ;   and q = a >> k
E604   D0 1E                  BNE   uq2   ; always
E606   98           UQ1:      TYA      
E607   D0 26                  BNE   ud0   ; not a power of two
E609   A4 09                  LDY   D1   
E60B   88                     DEY      
E60C   98                     TYA      
E60D   25 09                  AND   D1   
E60F   D0 1E                  BNE   ud0   ; not a power of two
E611   98                     TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
E612   25 03                  AND   TH   
E614   85 05                  STA   T1   
E616   A5 02                  LDA   TL   
E618   85 04                  STA   T0   
E61A   A5 03                  LDA   TH   ;   and q = (a >> 8) >> (k - 8)
E61C   85 02                  STA   TL   
E61E   A9 00                  LDA   #0   
E620   85 03                  STA   TH   
E622   A5 09                  LDA   D1   
E624   4A           UQ2:      LSR      ; a bit of 2^k: one shift for each 0 below
E625   B0 07                  BCS   uq9   ;   the 1
E627   46 03        UQ3:      LSR   TH   
E629   66 02                  ROR   TL   
E62B   4A                     LSR      
E62C   90 F9                  BCC   uq3   
E62E   60           UQ9:      RTS      
E62F                          ENDIF      
