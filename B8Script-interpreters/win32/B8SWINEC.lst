   980                              <1> ; =============================================================================
   981                              <1> ;  Console layer
   982                              <1> ;
   983                              <1> ;  putc prints AL. waitk is the host's key routine: it waits up to EAX ms
   984                              <1> ;  (0: just a look; -1: for ever) for a key, and returns it in AL with the
   985                              <1> ;  zero flag clear, or AL = 0 with the zero flag set if none came. Both keep
   986                              <1> ;  every register but EAX (putc keeps EAX too).
   987                              <1> ;
   988                              <1> ;  A running program reads the keyboard only through getk and pollk, which
   989                              <1> ;  between them give the break key its rules:
   990                              <1> ;    - Ctrl-C stops the program;
   991                              <1> ;    - any other key that the break check reads is held at HELD for the
   992                              <1> ;      next '?', and a newer one takes its place;
   993                              <1> ;    - '?' (getk) takes the held key first;
   994                              <1> ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
   995                              <1> ;      key like any other, but two of them within about 250 ms still stop it.
   996                              <1> ;  Both are called straight from a handler (or from rpoll), never from a
   997                              <1> ;  routine under one: the checked build's report counts on finding one
   998                              <1> ;  return address above the data stack.
   999                              <1> ; =============================================================================
  1000                              <1> 
  1001                              <1> ; putc: WriteFile to the output handle (standard output; the checked
  1002                              <1> ; report switches it to standard error), one byte. PUSHAD saves everything;
  1003                              <1> ; the byte is AL in the saved EAX, and the count goes in the slot of the
  1004                              <1> ; saved ESP, which POPAD ignores.
  1005 000004D6 60                  <1> putc:   pushad
  1006 000004D7 8D4C240C            <1>         lea     ecx,[esp+12]
  1007 000004DB 8D54241C            <1>         lea     edx,[esp+28]
  1008 000004DF 6A00                <1>         push    0                       ; lpOverlapped
  1009 000004E1 51                  <1>         push    ecx                     ; lpNumberOfBytesWritten
  1010 000004E2 6A01                <1>         push    1
  1011 000004E4 52                  <1>         push    edx
  1012 000004E5 FF7562              <1>         push    dword [V(v_outh)]
  1013 000004E8 FF559E              <1>         call    [V(iat_WriteFile)]
  1014 000004EB 61                  <1>         popad
  1015 000004EC C3                  <1>         ret
  1016                              <1> 
  1017                              <1> ; waitk. At a console: a wait on the input handle for the time (EAX: 0
  1018                              <1> ; just looks, -1 is INFINITE), then ReadConsoleInputA for one event. A
  1019                              <1> ; timed wait (1 ms or more) sets the high-resolution timer once for the
  1020                              <1> ; whole time and waits for the input or the timer (WaitForMultipleObjects
  1021                              <1> ; on v_hin and v_htm, which follow each other); without the timer it is a
  1022                              <1> ; plain WaitForSingleObject, which starts again with its whole time after
  1023                              <1> ; each event passed over. Only key-down events count: their character,
  1024                              <1> ; or for the left and right arrow keys (virtual keys 25h and 27h, which
  1025                              <1> ; have none) ^B and ^F. Anything else is passed over.
  1026                              <1> ; Input that is not a console (a pipe or a file) is read a byte at a time
  1027                              <1> ; with ReadFile, and only by a wait that is not just a look (a look would
  1028                              <1> ; eat the input); at its end the interpreter exits.
  1029 000004ED 60                  <1> waitk:  pushad
  1030 000004EE 93                  <1>         xchg    eax,ebx                 ; EBX = the time
  1031 000004EF 8B7D5E              <1>         mov     edi,[V(v_htm)]          ; EDI: the timer, if this wait uses it
  1032 000004F2 8D43FF              <1>         lea     eax,[ebx-1]
  1033 000004F5 3DFEFFFF7F          <1>         cmp     eax,7FFFFFFEh
  1034 000004FA 7202                <1>         jb      .wk0                    ; 1 ms or more, and not INFINITE
  1035 000004FC 31FF                <1>         xor     edi,edi
  1036 000004FE 85FF                <1> .wk0:   test    edi,edi
  1037 00000500 741A                <1>         jz      .wk1
  1038 00000502 69C3F0D8FFFF        <1>         imul    eax,ebx,-10000          ; relative, in 100 ns units
  1039 00000508 99                  <1>         cdq
  1040 00000509 52                  <1>         push    edx
  1041 0000050A 50                  <1>         push    eax                     ; the due time, 64 bits
  1042 0000050B 89E1                <1>         mov     ecx,esp
  1043 0000050D 6A00                <1>         push    0                       ; fResume
  1044 0000050F 6A00                <1>         push    0                       ; lpArgToCompletionRoutine
  1045 00000511 6A00                <1>         push    0                       ; pfnCompletionRoutine
  1046 00000513 6A00                <1>         push    0                       ; lPeriod
  1047 00000515 51                  <1>         push    ecx                     ; lpDueTime
  1048 00000516 57                  <1>         push    edi
  1049 00000517 FF55B2              <1>         call    [V(iat_SetWaitableTimer)]
  1050 0000051A 58                  <1>         pop     eax
  1051 0000051B 58                  <1>         pop     eax
