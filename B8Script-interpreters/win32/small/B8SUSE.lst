  2509 0000098B ????????            <1> v_edln: resd    1               ; the editor: the line ^E put in the input
  2510                              <1> %endif
  2511 0000098F <res 14h>           <1> v_rec:  resb    20              ; an INPUT_RECORD; ReadFile's byte. (Last:
  2512                              <1>                                 ;   only its first 15 bytes need be in reach)
  2513                              <1>         times   -((v_rec+15-next) > 127) db 0   ; (an error if out of reach)
  2514                              <1>         times   -((next-iat) > 128) db 0
  2515                              <1> %if QK
  2516                              <1> v_tlen: resd    1               ; the program text's length, NUL included
  2517                              <1>         alignb  8
  2518                              <1> skc:    resd    2*NSKC          ; the skip cache: {start, end}, 64 of them
  2519                              <1>         times   -((skc+8*NSKC-tstart) > NAMEBUF-(IB+SECTVA)) db 0
  2520                              <1> %endif
