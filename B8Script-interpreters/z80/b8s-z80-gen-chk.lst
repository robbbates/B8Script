027A   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
027B                          IF   1-ANS   
027B   CD 15 FF               CALL   CONAT   
027E   E1                     POP   HL   
027F   C3 CF 01               JP   PRAGAIN   
0282                             ; With ANSI = 0 the machine's routines do the rest.
0282   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0283   C3 12 FF               JP   CONCUR   
0286   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
0289   FE 02                  CP   2   
028B   CA 0F FF               JP   Z,CONEOL   ; /}
028E   C3 12 FF               JP   CONCUR   ; /|  (A = 1: show)
0291                          ENDIF      
0291                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              LD   A,";"   
                              RST   28h   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              LD   A,"H"   
                              RST   28h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   
                              JR   csia   
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
                              LD   A,"?"   
                              CALL   csia   
                              LD   A,"2"   
                              RST   28h   
                              LD   A,"5"   
                              RST   28h   
                              LD   A,E   
                              RST   28h   
                              RET      
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              RST   28h   
                              RET      
                    CSI:      PUSH   AF   
                              LD   A,27   
                              RST   28h   
                              LD   A,"["   
                              RST   28h   
                              POP   AF   
                              RET      
0291                          ENDIF      
0291                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0291                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0291                             ; the quotient bits arrive at the bottom of C.
0291                             ; Dividing by 2 is one shift (the spec wants that fast).
0291   7B           UDIV:     LD   A,E   
0292   EE 02                  XOR   2   
0294   B2                     OR   D   
0295   20 07                  JR   NZ,udv0   
0297   CB 3C                  SRL   H   
0299   CB 1D                  RR   L   ; the quotient
029B   8F                     ADC   A,A   
029C   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
029D   C9                     RET      
029E   C5           UDV0:     PUSH   BC   
029F   7C                     LD   A,H   
02A0   4D                     LD   C,L   
02A1   21 00 00               LD   HL,0   
02A4   06 10                  LD   B,16   
02A6   CB 21        UDV1:     SLA   C   
02A8   17                     RLA      
02A9   ED 6A                  ADC   HL,HL   
02AB   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
02AD   30 02                  JR   NC,udv2   ;   always fits in 16 bits
02AF   19                     ADD   HL,DE   ; too much: put it back, and cancel the
02B0   0D                     DEC   C   ;   INC below
02B1   0C           UDV2:     INC   C   ; a quotient bit
02B2   10 F2                  DJNZ   udv1   
02B4   EB                     EX   DE,HL   ; DE = remainder
02B5   67                     LD   H,A   
02B6   69                     LD   L,C   ; HL = quotient
02B7   C1                     POP   BC   
02B8   C9                     RET      
02B9                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
02B9                             ; non-digit. Values wrap at 16 bits, as the spec says.
02B9   21 00 00     RDNUM:    LD   HL,0   
02BC   0A           RDN1:     LD   A,(BC)   
02BD   D6 30                  SUB   "0"   
02BF   FE 0A                  CP   10   
02C1   D0                     RET   NC   
02C2   03                     INC   BC   
02C3   54                     LD   D,H   
02C4   5D                     LD   E,L   
02C5   29                     ADD   HL,HL   
02C6   29                     ADD   HL,HL   
02C7   19                     ADD   HL,DE   
02C8   29                     ADD   HL,HL   ; HL * 10
02C9   5F                     LD   E,A   
02CA   16 00                  LD   D,0   
02CC   19                     ADD   HL,DE   
02CD   18 ED                  JR   rdn1   
02CF                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02CF                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02CF                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
02CF                          ENDIF      
02CF                          IF   CHECKED   
02CF                             ; The checked build never steps over a NUL: if the text runs out first it
02CF                             ; returns A = 0 with the IP on the NUL.
02CF   0A           SKIPSTR:   LD   A,(BC)   
02D0   B7                     OR   A   
02D1   C8                     RET   Z   
02D2   03                     INC   BC   
02D3   FE 22                  CP   22h   
02D5   C8                     RET   Z   
02D6   FE 2F                  CP   "/"   
02D8   20 F5                  JR   NZ,skipstr   
02DA   0A                     LD   A,(BC)   ; the escaped character
02DB   B7                     OR   A   
02DC   C8                     RET   Z   
02DD   03                     INC   BC   
02DE   18 EF                  JR   skipstr   
02E0                          ENDIF      
02E0                             ; skip: read past text to the closer at this level, and return A = 0 if it
02E0                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02E0                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02E0                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02E0                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02E0                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02E0                             ; 
02E0                             ; The checked build also looks at the character the skip was started by,
02E0                             ; which is always the one just before where it starts: "(" must end at ")",
02E0                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02E0                             ; quote counts as running into it. "\" takes either closer. IX keeps the
02E0                             ; place where the skip started, for the report.
02E0                SKIP:        
02E0                          IF   CHECKED   
02E0   C5                     PUSH   BC   
02E1   DD E1                  POP   IX   
02E3   0B                     DEC   BC   
02E4   0A                     LD   A,(BC)   
02E5   03                     INC   BC   
02E6   5F                     LD   E,A   ; E = the opener: ( [ or \
02E7                          ENDIF      
02E7   16 00                  LD   D,0   
02E9   14           SK3:      INC   D   ; an opener: one deeper
02EA   0A           SK1:      LD   A,(BC)   
02EB                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
02EB                          ENDIF      
02EB                          IF   CHECKED   
02EB   B7                     OR   A   
02EC   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
02EE   03                     INC   BC   
02EF                          ENDIF      
02EF   FE 22                  CP   22h   
02F1   CC CF 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02F4   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02F6   28 F1                  JR   Z,sk3   
02F8   3D                     DEC   A   ; ")"
02F9   28 08                  JR   Z,sk4   
02FB   D6 32                  SUB   "["-")"   
02FD   28 EA                  JR   Z,sk3   
02FF   FE 02                  CP   "]"-"["   
0301   20 E7                  JR   NZ,sk1   
0303   15           SK4:      DEC   D   
0304                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0304                          ENDIF      
0304                          IF   CHECKED   
0304   20 E4                  JR   NZ,sk1   
0306   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0307   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0308   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
030A   FE 02                  CP   2   ;   closer, and only then
030C   7A                     LD   A,D   
030D   C0                     RET   NZ   
030E   18 05                  JR   sk7   
0310   CB 53        SK6:      BIT   2,E   ; the text ran out:
0312   C2 09 FF               JP   NZ,SKEND   ;   "\" with no closer ends the program
0315   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0317   C1                     POP   BC   
0318   3E 4E                  LD   A,"N"   
031A   C3 01 04               JP   errp   ; (errp drops skip's return address)
031D                          ENDIF      
031D                             ; =============================================================================
031D                             ;  Dispatch table: the low byte of each handler's address, in code order
031D                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
031D                             ;  It must not cross a page (the dispatcher only adds to its low byte).
031D                             ; =============================================================================
031D                             ; The handlers of the first NPG1 characters start in the image's second page.
031D                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
031D                             ; differs between the builds, so the count is worked out here.
031D                             ; (One division to a line: asm80 only rounds down when it stores a value.)
031D                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
031D                PGBRK:    EQU   (h_break-BASE)/256   
031D                PGDEF:    EQU   (h_def-BASE)/256   
031D                PGFET:    EQU   (h_fetch-BASE)/256   
031D                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
031D                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
031D                          ENDIF      
031D                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
031D                             ; and return its value in A with the carry set; otherwise leave the IP and
031D                             ; return with the carry clear.
031D   0A           HEXC:     LD   A,(BC)   
031E   D6 30                  SUB   "0"   
0320   FE 0A                  CP   10   
0322   38 09                  JR   C,hc1   
0324   E6 DF                  AND   0DFh   
0326   D6 11                  SUB   11h   
0328   FE 06                  CP   6   
032A   D0                     RET   NC   
032B   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
032D   03           HC1:      INC   BC   
032E   C9                     RET      
032F                             ; psgn: print HL as a signed number. Keeps BC.
032F   CB 7C        PSGN:     BIT   7,H   
0331   28 04                  JR   Z,pdec   
0333   3E 2D                  LD   A,"-"   
0335   EF                     RST   28h   
0336   E7                     RST   20h   
0337                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0337                             ; Keeps BC.
0337   11 0A 00     PDEC:     LD   DE,10   
033A   CD 91 02               CALL   udiv   ; HL = HL / 10, E = the last digit
033D   7B                     LD   A,E   
033E   F5                     PUSH   AF   
033F   7C                     LD   A,H   
0340   B5                     OR   L   
0341   C4 37 03               CALL   NZ,pdec   
0344   F1                     POP   AF   
0345   C6 30                  ADD   A,"0"   
0347   EF                     RST   28h   
0348   C9                     RET      
0349                             ; (The table goes here instead in the builds where, before psgn, it would
0349                             ; cross a page: PTLATE.)
0349                          IF   (1-TABP0)*PTLATE   
0349                PTAB:        
0349                          ;*Macro unroll:  PTABLE
0349   B9                     DB   h_store & 0FFh   
034A   C1                     DB   h_str & 0FFh   
034B   D6                     DB   h_num & 0FFh   
034C   CC                     DB   h_print & 0FFh   
034D   B1                     DB   h_swap & 0FFh   
034E   56                     DB   h_and & 0FFh   
034F   D3                     DB   h_emit & 0FFh   
0350   32                     DB   h_open & 0FFh   
0351   3A                     DB   h_close & 0FFh   
0352   77                     DB   h_mul & 0FFh   
0353   4D                     DB   h_add & 0FFh   
0354   F2                     DB   h_cfetch & 0FFh   
0355   45                     DB   h_sub & 0FFh   
0356   B3                     DB   h_cstore & 0FFh   
0357   8B                     DB   h_div & 0FFh   
0358   AF                     DB   h_dup & 0FFh   
0359   B8                     DB   h_drop & 0FFh   
035A   5E                     DB   h_lt & 0FFh   
035B   6D                     DB   h_eq & 0FFh   
035C   5F                     DB   h_gt & 0FFh   
035D   DA                     DB   h_key & 0FFh   
035E   2D                     DB   h_fetch & 0FFh   
035F   09                     DB   h_def & 0FFh   
0360   FC                     DB   h_break & 0FFh   
0361   F8                     DB   h_ret & 0FFh   
0362   91                     DB   h_xor & 0FFh   
0363   A4                     DB   h_alloc & 0FFh   
0364   E2                     DB   h_grave & 0FFh   
0365   2C                     DB   h_tor & 0FFh   
0366   99                     DB   h_or & 0FFh   
0367   1C                     DB   h_fromr & 0FFh   
0368   A1                     DB   h_not & 0FFh   
0369                PTABEND:      
0369                          ENDIF      
0369                             ; =============================================================================
0369                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0369                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0369                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
0369                             ;  they are the host's KEY and CONOUT routines themselves.
0369                             ; 
0369                             ;  A running program reads the keyboard only through getk and pollk, which
0369                             ;  between them give the break key its rules:
0369                             ;    - Ctrl-C stops the program;
0369                             ;    - any other key that the break check reads is held in KEYBUF for the
0369                             ;      next "?", and a newer one takes its place;
0369                             ;    - "?" (getk) takes the held key first;
0369                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0369                             ;      key like any other, but two of them within about 250 ms still stop it.
0369                             ;  Both are called straight from a handler, never from a routine under one:
0369                             ;  the checked build's report counts on finding one return address above the
0369                             ;  data stack.
0369                             ; =============================================================================
0369                          IFN   CPM   
0369                RAWK:     EQU   KEY   
0369                          ENDIF      
0369                             ; pollk: the break check (see rpushn).
0369   CD 06 FF     POLLK:    CALL   rawk   
036C   C8                     RET   Z   ; no key
036D   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0370   FE 03        PK1:      CP   3   ; (getk joins here)
0372   C0                     RET   NZ   
0373                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0373                             ; the program has turned it off, wait about 250 ms for one more key: a
0373                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0373                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0373   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0376   B7                     OR   A   
0377   CA FF 03     CT0:      JP   Z,brk   
037A   D5                     PUSH   DE   
037B   11 10 27               LD   DE,250*MSLOOP   
037E   CD 06 FF     CT1:      CALL   rawk   
0381   20 05                  JR   NZ,ct2   
0383   1B                     DEC   DE   
0384   7A                     LD   A,D   
0385   B3                     OR   E   
0386   20 F6                  JR   NZ,ct1   
0388   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0389   FE 03                  CP   3   
038B   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
038D   B7                     OR   A   
038E   28 03                  JR   Z,ct3   
0390   32 7A 82               LD   (KEYBUF),A   
0393   3E 03        CT3:      LD   A,3   
0395   B7                     OR   A   
0396   C9                     RET      
0397                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0397   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0398   21 7A 82               LD   HL,KEYBUF   ;   the buffer
039B   7E                     LD   A,(HL)   
039C   36 00                  LD   (HL),0   
039E   E1                     POP   HL   
039F   B7                     OR   A   
03A0   C0                     RET   NZ   
03A1   CD 06 FF               CALL   rawk   
03A4   C8                     RET   Z   
03A5   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
03A7                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
03A7                          ENDIF      ;   (with the editor, both stacks are cleared);
03A7                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
03A7                          ENDIF      
03A7                          IF   CHECKED   
03A7                BRK:      EQU   e_break   ;   the checked build reports B
03A7                          ENDIF      
03A7                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
03A7                          ENDIF      
03A7                             ; =============================================================================
03A7                             ;  Checked build: the checks and the error report
03A7                             ; =============================================================================
03A7                          IF   CHECKED   
03A7                             ; chkstk: both stacks are checked once per character, not in every handler.
03A7                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
03A7                             ; the constant carries if it is above (cells were popped that were never
03A7                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
03A7                             ; a character late at most: the bytes above DSTOP and the guard band below
03A7                             ; the page take what happens meanwhile. DE is free between characters.
03A7   EB           CHKSTK:   EX   DE,HL   
03A8   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
03AB   39                     ADD   HL,SP   
03AC   EB                     EX   DE,HL   
03AD   38 1D                  JR   C,e_under   
03AF   14                     INC   D   
03B0   20 16                  JR   NZ,e_over   
03B2   D9                     EXX      ; the return stack: in its page (or it has
03B3   7C                     LD   A,H   ;   overflowed), and not above its empty
03B4   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
03B6   7D                     LD   A,L   ;   page, in the guard band)
03B7   D9                     EXX      
03B8   20 0B                  JR   NZ,e_rover   
03BA   FE E1                  CP   RSTOP&0FFh+1   
03BC   D8                     RET   C   
03BD   D9                     EXX      ; return stack underflow: it counts as empty
03BE   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
03C0   D9                     EXX      
03C1   3E 72                  LD   A,"r"   
03C3   18 3C                  JR   errp   
03C5   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
03C7   11                     DB   11h   ; (LD DE,nn hides the next entry)
03C8   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
03CA   18 35                  JR   errp   
03CC   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
03CF   3E 73                  LD   A,"s"   
03D1   18 3E                  JR   error   
03D3                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
03D3                             ; was never defined still holds 0000h, and the byte there is a reserved one
03D3                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
03D3                             ; an undefined word. The call is undone, so the place is the call itself.
03D3   04           E_HI:     INC   B   
03D4   10 33                  DJNZ   e_resv   ; (B is as it was, and is not 0)
03D6   CF                     RST   08h   
03D7   42                     LD   B,D   
03D8   4B                     LD   C,E   
03D9   3E 55                  LD   A,"U"   
03DB   18 34                  JR   error   
03DD                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
03DD                             ; the count. Stop if the top is not below the limit page, or is below the
03DD                             ; program's end.
03DD                CHKHP:       
03DD                          ENDIF      
03DD                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03DD                          ENDIF      
03DD                          IF   CHECKED*(1-CPM)   
03DD                             ; (Here the program's space is under 32K, so a top that wrapped
03DD                             ; round always falls outside it.)
03DD   7C                     LD   A,H   
03DE   FE F0                  CP   HEAPLIM   
03E0   30 09                  JR   NC,e_heap   
03E2                          ENDIF      
03E2                          IF   CHECKED   
03E2   D5                     PUSH   DE   
03E3   EB                     EX   DE,HL   
03E4   2A 38 82               LD   HL,(NPEND)   
03E7   19                     ADD   HL,DE   ; carry: at or above the program's end
03E8   EB                     EX   DE,HL   
03E9   D1                     POP   DE   
03EA   D8                     RET   C   
03EB   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
03EC   ED 52                  SBC   HL,DE   
03EE   3E 48                  LD   A,"H"   
03F0   18 0F                  JR   errp   
03F2                             ; chkst: stop unless HL is in the program's own space: from the letter page
03F2                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
03F2                             ; whatever lies above the limit are safe. Memory above the heap top but
03F2                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
03F2                             ; It is the page of HL + 1 that is tested, so that one test serves both
03F2                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
03F2                             ; Keeps HL and BC. It runs on into its own error entry.
03F2   23           CHKST:    INC   HL   
03F3   7C                     LD   A,H   
03F4   2B                     DEC   HL   
03F5   FE 82                  CP   LETPAGE   
03F7   38 03                  JR   C,e_store   
03F9                          ENDIF      
03F9                          IF   CHECKED*(1-CPM)   
03F9   FE F0                  CP   HEAPLIM   
03FB   D8                     RET   C   
03FC                          ENDIF      
03FC                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03FC                          ENDIF      
03FC                          IF   CHECKED   
03FC                             ; Error entries. Each loads its letter and then hides the next entry inside
03FC                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
03FC   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
03FE   11                     DB   11h   
03FF   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0401                             ; errp: an error found inside a routine: drop its return address first.
0401   D1           ERRP:     POP   DE   
0402   18 0D                  JR   error   
0404   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0405   4D                     LD   C,L   ;   past the opening quote, which is the place
0406   3E 51                  LD   A,"Q"   
0408   11                     DB   11h   
0409   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
040B   11                     DB   11h   
040C   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
040E   11                     DB   11h   
040F   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0411                             ; error: the report, then the end. A = the letter, BC = one past the place,
0411                             ; HL = TOS, and both stacks as the report is to show them:
0411                             ; 
0411                             ;   Err X @ line,col
0411                             ;   up to 16 characters of the text from the place
0411                             ;   Stk n: the top 8 cells at most, bottom to top
0411                             ;   Rtn n
0411   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0412   5F                     LD   E,A   
0413   CD 40 02               CALL   pnl   
0416   45 72 72 20 22         DB   "Err ",22h   
041B   7B                     LD   A,E   
041C   EF                     RST   28h   
041D   CD 46 02               CALL   pmsg   
0420   20 40 20 22            DB   " @ ",22h   
0424   0B                     DEC   BC   ; BC = the place
0425                             ; The line and column. A place below the program is in the line
0425                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0425                             ; DE = the line's number, HL = where it starts.
0425   21 80 82               LD   HL,LINEBUF   
0428   11 00 00               LD   DE,0   
042B   78                     LD   A,B   
042C   FE 83                  CP   PROG/256   
042E   38 14                  JR   C,er3   
0430   24                     INC   H   
0431   6B                     LD   L,E   ; HL = PROG
0432   13           ER1:      INC   DE   ; a new line starts at HL
0433   E5                     PUSH   HL   
0434   7D           ER2:      LD   A,L   
0435   91                     SUB   C   
0436   7C                     LD   A,H   
0437   98                     SBC   A,B   
0438   30 09                  JR   NC,er2x   ; reached the place
043A   7E                     LD   A,(HL)   
043B   23                     INC   HL   
043C   FE 0A                  CP   10   
043E   20 F4                  JR   NZ,er2   
0440   F1                     POP   AF   
0441   18 EF                  JR   er1   
0443   E1           ER2X:     POP   HL   
0444   C5           ER3:      PUSH   BC   
0445   E5                     PUSH   HL   
0446   EB                     EX   DE,HL   
0447   CD 37 03               CALL   pdec   ; the line
044A   3E 2C                  LD   A,","   
044C   EF                     RST   28h   
044D   D1                     POP   DE   
044E   E1                     POP   HL   
044F   E5                     PUSH   HL   
0450   B7                     OR   A   
0451   ED 52                  SBC   HL,DE   
0453   23                     INC   HL   
0454   CD 37 03               CALL   pdec   ; the column
0457   CD 40 02               CALL   pnl   
045A   22                     DB   22h   
045B   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
045C   06 10                  LD   B,16   ;   if the line or the program ends first
045E   7E           ER4:      LD   A,(HL)   
045F   23                     INC   HL   
0460   B7                     OR   A   
0461   28 0B                  JR   Z,er5   
0463   FE 0D                  CP   13   
0465   28 07                  JR   Z,er5   
0467   FE 0A                  CP   10   
0469   28 03                  JR   Z,er5   
046B                          ENDIF      
046B                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
046B                          ENDIF      ;   screen on it. The editor's loader ends
046B                          IF   CHECKED   ;   the text at the first ^Z.)
046B   EF                     RST   28h   
046C   10 F0                  DJNZ   er4   
046E                ER5:         ; (on into the two stack lines)
046E                             ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
046E                             ;                       Rtn n
046E                             ; TOS is in memory with the rest (pushed) by now.
046E   CD 40 02               CALL   pnl   
0471   53 74 6B 20 22         DB   "Stk ",22h   
0476   21 06 7E               LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
0479   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
047A   E7                     RST   20h   ;   with the first value and holds nothing)
047B   CD C4 04               CALL   phalf   ; the depth
047E   3E 3A                  LD   A,":"   
0480   EF                     RST   28h   
0481   79                     LD   A,C   
0482   FE 09                  CP   9   
0484   38 0A                  JR   C,er6   
0486   CD 46 02               CALL   pmsg   
0489   20 2E 2E 2E 22         DB   " ...",22h   
048E   0E 08                  LD   C,8   
0490   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0492   69                     LD   L,C   
0493   29                     ADD   HL,HL   
0494   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0495   0C                     INC   C   
0496   0D           ER7:      DEC   C   
0497   28 0F                  JR   Z,er8   
0499   2B                     DEC   HL   
049A   56                     LD   D,(HL)   
049B   2B                     DEC   HL   
049C   5E                     LD   E,(HL)   
049D   E5                     PUSH   HL   
049E   3E 20                  LD   A," "   
04A0   EF                     RST   28h   
04A1   EB                     EX   DE,HL   
04A2   CD 2F 03               CALL   psgn   
04A5   E1                     POP   HL   
04A6   18 EE                  JR   er7   
04A8   CD 40 02     ER8:      CALL   pnl   
04AB   52 74 6E 20 22         DB   "Rtn ",22h   
04B0   D9                     EXX      
04B1   E5                     PUSH   HL   
04B2   D9                     EXX      
04B3   D1                     POP   DE   
04B4   21 E0 80               LD   HL,RSTOP   
04B7   B7                     OR   A   
04B8   ED 52                  SBC   HL,DE   
04BA   CD C4 04               CALL   phalf   
04BD   CD 40 02               CALL   pnl   
04C0   22                     DB   22h   
04C1                          ENDIF      
04C1                          IF   CHECKED*(1-EDITOR)   
04C1   C3 15 00               JP   endprog   
04C4                          ENDIF      
04C4                          IF   CHECKED*EDITOR   
                              JP   edit0   ; back to the editor, with both stacks cleared
04C4                          ENDIF      
04C4                          IF   CHECKED   
04C4                             ; phalf: print half of HL, and leave it in C.
04C4   CB 3C        PHALF:    SRL   H   
04C6   CB 1D                  RR   L   
04C8   E5                     PUSH   HL   
04C9   CD 37 03               CALL   pdec   
04CC   C1                     POP   BC   
04CD   C9                     RET      
04CE                          ENDIF      
04CE                             ; =============================================================================
04CE                             ;  The line editor (EDITOR = 1)
04CE                             ; 
04CE                             ;  The interpreter starts here, and a program that ends comes back here.
04CE                             ;  There is no prompt. It follows the spec's suggested standard for a line
04CE                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
04CE                             ; 
04CE                             ;    n text    put the text in as line n; the lines from n on move down. A
04CE                             ;              number past the end (or 0) adds the line at the end.
04CE                             ;    n         take line n out
04CE                             ;    anything else is run at once, as B8Script. (Start such a line with a
04CE                             ;    space if it would begin with a digit.)
04CE                             ; 
04CE                             ;  A command key ends the line too, and takes what was typed as its argument:
04CE                             ; 
04CE                             ;    ^G        run the program
04CE                             ;    n ^L      list from line n (no number: all of it). Any key holds the
04CE                             ;              list until another key is pressed; Ctrl-C ends it.
04CE                             ;    n ^E      put line n in the input line; Return puts it back, changed
04CE                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
04CE                             ;              last time). Generic: what is typed, or pasted, from now until
04CE                             ;              ^Z replaces the program; it is not echoed.
04CE                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
04CE                             ;              time). Generic: the text is printed, as it is.
04CE                             ;    ^N ^N     new: no program (the key twice in a row)
04CE                             ;    ^X        leave (to LEAVE)
04CE                             ; 
04CE                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
04CE                             ;  a character goes in at the cursor; Backspace and DEL take out the one
04CE                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
04CE                             ;  sent to the terminal, so any terminal will do.
04CE                             ; 
04CE                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
04CE                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
04CE                             ;  125 characters; the one character after a line number separates it from
04CE                             ;  the text and is not stored. The text is kept as it is typed, each line
04CE                             ;  ending in CR LF, at PROG.
04CE                             ; 
04CE                             ;  What lasts from one line to the next: the program, the words, the
04CE                             ;  variables and the data stack. An error or a break clears both stacks. The
04CE                             ;  return stack starts empty for every line.
04CE                             ; 
04CE                             ;  Things to know:
04CE                             ;    - Reset empties the program (generic builds).
04CE                             ;    - A word's address points into the program, so run the program again
04CE                             ;      after editing it.
04CE                             ;    - Nothing is printed between a program's output and what is typed next.
04CE                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
04CE                             ;      a line that calls -n? and carries on afterwards runs what was typed.
04CE                             ;      (The stored program never comes back to the line, so it may.)
04CE                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
04CE                             ;      read of the other builds.
04CE                             ; 
04CE                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
04CE                             ;  the last line left there, with TOS pushed like the rest.
04CE                             ; =============================================================================
04CE                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
04CE                          ENDIF      
04CE                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
04CE                          ENDIF      
04CE                          IF   EDGEN   
                              JR   edit0   
04CE                          ENDIF      
04CE                          IF   EDITOR   
                                 ; ^F, right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; ^B, left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                    LF1:      RST   28h   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   2   
                              JR   Z,left   ; ^B
                              CP   6   
                              JR   Z,right   ; ^F
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              LD   A,8   
                              RST   28h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              RST   28h   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              RST   28h   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              LD   A,8   
                              RST   28h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N ^N: no program, if the next key is ^N too
                    CNEW:     CALL   ekey   
                              CP   14   
                              JR   NZ,ged0   
                              XOR   A   
                              LD   (PROG),A   
                    GED0:     JP   edit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              RST   28h   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
04CE                          ENDIF      
04CE                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
04CE                          ENDIF      
04CE                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              RST   30h   ; (its return address is thrown away)
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                    GED1:     JP   edit   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
04CE                          ENDIF      
04CE                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
04CE                          ENDIF      
04CE                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
04CE                          ENDIF      
04CE                             ; =============================================================================
04CE                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
04CE                          ENDIF      
04CE                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
04CE                          ENDIF      
04CE                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
04CE                          ENDIF      
04CE                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
04CE                          ENDIF      
04CE                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
04CE                          ENDIF      
04CE                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
04CE                          ENDIF      
04CE                IMGEND:      


