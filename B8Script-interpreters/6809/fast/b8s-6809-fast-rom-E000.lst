E218   E6 41                  LDB   1,U   
E21A   3D                     MUL      ; ah*bl
E21B   EB C4                  ADDB   ,U   
E21D   E7 C4                  STB   ,U   ; the cross terms, low byte
E21F                MU2:         
E21F                          ENDIF      
