  2365 000004D0 [F605C0FF]          <1>         dd      dllname-IB              ; Name
  2366 000004D4 [0406C0FF]          <1>         dd      iat-IB                  ; FirstThunk: the IAT
  2367 000004D8 00<rep 14h>         <1>         times   20 db 0                 ; the null entry that ends the list
