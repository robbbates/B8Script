                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CSTORE:      ; .
                              POP   HL   
                              EX   DE,HL   
                              LD   (HL),E   
                              POP   HL   
                              ;*Macro unroll:  NEXTF
