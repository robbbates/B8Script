  1748 0000069C 00000000            <1>         dd      0                       ; TimeDateStamp
  1749 000006A0 00000000            <1>         dd      0                       ; ForwarderChain
  1750 000006A4 [E407C0FF]          <1>         dd      dllname-IB              ; Name
  1751 000006A8 [F407C0FF]          <1>         dd      iat-IB                  ; FirstThunk: the IAT
  1752 000006AC 00<rep 14h>         <1>         times   20 db 0                 ; the null entry that ends the list
  1753                              <1> idesc_end:
  1754                              <1> %macro  IMP 1
  1755                              <1>         dd      hn_%1-IB
  1756                              <1> %endmacro
