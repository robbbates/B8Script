E604   0D 0A 52 74 6E A0 M_RTN:   DB   13,10,"Rtn"," "+80h   
E60A                             ; lcol: the line (LN) and the column (T1/T2) of the place at P, both from
E60A                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
E60A                             ; column is the place in the buffer. Otherwise IP (free now: the program has
E60A                             ; stopped) runs from PROG to the place, counting LFs; T1/T2 keeps where the
E60A                             ; last line started, and the column is the place minus that, plus 1.
E60A   A9 00        LCOL:     LDA   #0   
E60C   85 0B                  STA   LN+1   
E60E   85 0A                  STA   LN   
E610   A9 80                  LDA   #<LINEBUF   
E612   85 05                  STA   T1   
E614   A9 04                  LDA   #>LINEBUF   
E616   85 06                  STA   T2   
E618   A5 02                  LDA   P   
E61A   C9 00                  CMP   #<PROG   
E61C   A5 03                  LDA   P+1   
E61E   E9 05                  SBC   #>PROG   
E620   90 26                  BCC   lc9   ; below the program: line 0
E622   E6 0A                  INC   LN   
E624   20 2F E5               JSR   rstip   
E627   A5 00        LC3:      LDA   IP   ; a line starts here
E629   85 05                  STA   T1   
E62B   A5 01                  LDA   IP+1   
E62D   85 06                  STA   T2   
E62F   A5 00        LC1:      LDA   IP   
E631   C5 02                  CMP   P   
E633   A5 01                  LDA   IP+1   
E635   E5 03                  SBC   P+1   
E637   B0 0F                  BCS   lc9   ; at the place
E639   20 1E E5               JSR   getc   
E63C   C9 0A                  CMP   #10   
E63E   D0 EF                  BNE   lc1   
E640   E6 0A                  INC   LN   ; an LF: a new line starts after it
E642   D0 E3                  BNE   lc3   
E644   E6 0B                  INC   LN+1   
E646   D0 DF                  BNE   lc3   ; always
E648   A5 02        LC9:      LDA   P   
E64A   38                     SEC      
E64B   E5 05                  SBC   T1   
E64D   85 05                  STA   T1   
E64F   A5 03                  LDA   P+1   
E651   E5 06                  SBC   T2   
E653   85 06                  STA   T2   
E655   E6 05                  INC   T1   ; + 1
E657   D0 02                  BNE   lc8   
E659   E6 06                  INC   T2   
E65B   60           LC8:      RTS      
E65C                          ENDIF      


