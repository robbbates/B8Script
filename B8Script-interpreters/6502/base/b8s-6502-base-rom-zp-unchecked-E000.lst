                              LDA   3,X   
                              CMP   1,X   
                              BNE   feq1   
                              DEY      
                    FEQ1:     INX      
                              INX      
                              STY   0,X   
                              STY   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
