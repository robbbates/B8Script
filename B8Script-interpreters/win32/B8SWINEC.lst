  1990                              <1> %if CHECKED
  1991 00000BBD ????????            <1> v_npend:resd    1               ; the heap's first address (checked '_')
  1992 00000BC1 ????????            <1> v_skat: resd    1               ; where the skip started (checked N)
  1993 00000BC5 ????????            <1> v_str:  resd    1               ; the address '$' prints from (checked Q)
  1994                              <1> %endif
