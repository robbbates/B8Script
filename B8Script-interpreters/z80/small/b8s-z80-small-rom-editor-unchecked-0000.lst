0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Required Notice: Copyright 2026 Robb Bates (https://github.com/robbbates)
0000                             ;  Licence: PolyForm Noncommercial License 1.0.0 (LICENSE.md at the top of
0000                             ;  the repository, or https://polyformproject.org/licenses/noncommercial/1.0.0)
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as line
0000                             ;                 and column, and both stacks. See `error`.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   0   ; 0 = small, 1 = base, 2 = fast (not with EDITOR) (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; IY, and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
0000                             ;   at the heap limit, which the heap never reaches
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
0000                PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
                    ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (fast build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (fast build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 2D 03               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0008                          ENDIF      
0008                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0008                          ENDIF      
0008                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0008                          ENDIF      
0008                          IF   1-CPM   
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   FD 5E 00     RPOP:     LD   E,(IY+0)   ; 08
000B   FD 56 01               LD   D,(IY+1)   
000E   18 1B                  JR   rp2   ; (the rest is at 2Bh)
0010                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0010   C6 21        CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
0012   20 1D                  JR   NZ,next0   ;     the rest are ignored
0014   C3 6F 03     ENDPROG:   JP   EXIT   ;     the program has ended
0017   00                     NOP      ; 17  spare
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1           DRP:      POP   HL   ;     new TOS = NOS
001A   18 15                  JR   next0   
001C                          ENDIF      
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D                          ;*Macro unroll:  POPR
001D   CF                     DS   1-CPM,0CFh   
001E                          DS   CPM,0CDh   
001E                          DS   CPM,AROP&0FFh   
001E                          DS   CPM,AROP/256   
001E   EB                     EX   DE,HL   
001F                          ;*Macro unroll:  NEXTZ
001F   F7                     DS   1-CPM,0F7h   
0020                          DS   CPM,0DDh   
0020                          DS   CPM,0E9h   
0020                          IF   1-CPM   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
0028                RST28:       
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B   FD 23        RP2:      INC   IY   ; 2B  the rest of rpop
002D   FD 23                  INC   IY   
002F   C9                     RET      
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                          ENDIF      
0031                          IF   CPM   
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; back to c; zero only for NUL
                              JR   NZ,next0   ; the rest are ignored
                    ENDPROG:   JP   EXIT   ; the program has ended
0031                          ENDIF      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0031                          ENDIF      
0031                          IF   1-FAST   
0031                NEXT0:       
0031                          ENDIF      
0031                          IF   CHECKED*(1-FAST)   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031                          IF   1-FAST   
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 D9                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 73                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 75                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 67                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          ENDIF      
0055                          IF   (1-CHECKED)*(1-FAST)   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED*(1-FAST)   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057                          IF   1-FAST   
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                          ENDIF      
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D                          IF   1-FAST   
005D   C6 6A        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 00                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE 81                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          ENDIF      
0066                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
                              LD   D,0   
0066                          ENDIF      
0066                          IF   (1-CPM)*(1-FAST)   
0066   CB 12                  RL   D   ; its page: 0 + carry
0068                          ENDIF      
0068                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0068                          ENDIF      
0068                          IF   1-FAST   
0068   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0069   C9                     RET      ;   when the handler starts
006A                          ENDIF      
006A                             ; The rest of the startup: here so that the generic reset code can reach it
006A                             ; with JR. st0: find the program's NUL; the heap starts after it.
006A                             ; (The editor build has its own copy of this, next to the editor.)
006A                             ; A checked build first clears the lower half of the letter page (A = 0):
006A                             ; every variable starts at 0, every word cell holds 0000h, the address an
006A                             ; undefined word is caught at (see e_hi), and no key is held back.
006A                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006A                          ENDIF      
006A                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
006A                          ENDIF      
006A                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
006A                          ENDIF      ;   these)
006A                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
006A                          ENDIF      
006A                             ; In the unchecked generic editor build the table is here, in the first
006A                             ; page, which saves loading D twice. (The other builds have no room for it
006A                             ; here: theirs is further down.)
006A                          IF   TABP0   
006A                PTAB:        
006A                          ;*Macro unroll:  PTABLE
006A   AB                     DB   h_store & 0FFh   
006B   B0                     DB   h_str & 0FFh   
006C   D3                     DB   h_num & 0FFh   
006D   B7                     DB   h_print & 0FFh   
006E   A6                     DB   h_swap & 0FFh   
006F   50                     DB   h_and & 0FFh   
0070   D0                     DB   h_emit & 0FFh   
0071   2C                     DB   h_open & 0FFh   
0072   34                     DB   h_close & 0FFh   
0073   71                     DB   h_mul & 0FFh   
0074   47                     DB   h_add & 0FFh   
0075   EF                     DB   h_cfetch & 0FFh   
0076   3F                     DB   h_sub & 0FFh   
0077   A8                     DB   h_cstore & 0FFh   
0078   85                     DB   h_div & 0FFh   
0079   A4                     DB   h_dup & 0FFh   
007A   AA                     DB   h_drop & 0FFh   
007B   58                     DB   h_lt & 0FFh   
007C   67                     DB   h_eq & 0FFh   
007D   59                     DB   h_gt & 0FFh   
007E   D7                     DB   h_key & 0FFh   
007F   27                     DB   h_fetch & 0FFh   
0080   0A                     DB   h_def & 0FFh   
0081   FD                     DB   h_break & 0FFh   
0082   F9                     DB   h_ret & 0FFh   
0083   8A                     DB   h_xor & 0FFh   
0084   9D                     DB   h_alloc & 0FFh   
0085   E3                     DB   h_grave & 0FFh   
0086   DF                     DB   h_tor & 0FFh   
0087   92                     DB   h_or & 0FFh   
0088   1C                     DB   h_fromr & 0FFh   
0089   9A                     DB   h_not & 0FFh   
008A                PTABEND:      
008A                          ENDIF      
008A                             ; =============================================================================
008A                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
008A                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
008A                             ;  is here too: it belongs to "`" and makes the page come out right.
008A                             ; =============================================================================
008A   D1           H_XOR:    POP   DE   
008B   7C                     LD   A,H   
008C   AA                     XOR   D   
008D   67                     LD   H,A   
008E   7D                     LD   A,L   
008F   AB                     XOR   E   
0090   6F                     LD   L,A   
0091                          ;*Macro unroll:  NEXT
0091   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0092                          DS   CPM+FAST-CPM*FAST,0DDh   
0092                          DS   CPM+FAST-CPM*FAST,0E9h   
0092   D1           H_OR:     POP   DE   
0093   7C                     LD   A,H   
0094   B2                     OR   D   
0095   67                     LD   H,A   
0096   7D                     LD   A,L   
0097   B3                     OR   E   
0098   6F                     LD   L,A   
0099                          ;*Macro unroll:  NEXT
0099   F7                     DS   (1-CPM)*(1-FAST),0F7h   
009A                          DS   CPM+FAST-CPM*FAST,0DDh   
009A                          DS   CPM+FAST-CPM*FAST,0E9h   
009A                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
009A   E7           H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
009B                          DS   CPM,0CDh   
009B                          DS   CPM,ANEG&0FFh   
009B                          DS   CPM,ANEG/256   
009B   2B                     DEC   HL   
009C                          ;*Macro unroll:  NEXT
009C   F7                     DS   (1-CPM)*(1-FAST),0F7h   
009D                          DS   CPM+FAST-CPM*FAST,0DDh   
009D                          DS   CPM+FAST-CPM*FAST,0E9h   
009D                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
009D                             ; the same either way); TOS is the old pointer.
009D   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A1                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A1                          ENDIF      
00A1   19                     ADD   HL,DE   ; the new top
00A2                          IF   CHECKED   
                              CALL   chkhp   
00A2                          ENDIF      
00A2   22 7C 82               LD   (HEAP),HL   
00A5   EB                     EX   DE,HL   
00A6                          ;*Macro unroll:  NEXT
00A6   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00A7                          DS   CPM+FAST-CPM*FAST,0DDh   
00A7                          DS   CPM+FAST-CPM*FAST,0E9h   
00A7                          IF   1-CPM*CHECKED   
00A7   FD 22 34 82  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
00AB   CD E2 00               CALL   jphl   
00AE   FD 2A 34 82            LD   IY,(RSAVE)   
00B2                          ;*Macro unroll:  SETIX
00B2                          DS   CPM+FAST-CPM*FAST,0DDh   
00B2                          DS   CPM+FAST-CPM*FAST,21h   
00B2                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
00B2                          DS   CPM+FAST-CPM*FAST,ANXT/256   
00B2   E1                     POP   HL   
00B3                          ;*Macro unroll:  NEXT
00B3   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00B4                          DS   CPM+FAST-CPM*FAST,0DDh   
00B4                          DS   CPM+FAST-CPM*FAST,0E9h   
00B4                          ENDIF      
00B4                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00B4                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00B4                             ; Digits: step back onto the first digit and read the whole number.
00B4   E5           DIGIT:    PUSH   HL   
00B5   0B                     DEC   BC   
00B6   CD 80 02               CALL   rdnum   
00B9                          ;*Macro unroll:  NEXT
00B9   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00BA                          DS   CPM+FAST-CPM*FAST,0DDh   
00BA                          DS   CPM+FAST-CPM*FAST,0E9h   
00BA                             ; a-z: push the cell's address (the cell is the variable)
00BA                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
00BA                          IF   1-SBASEU   
00BA   E5           LOWER:    PUSH   HL   
00BB   87                     ADD   A,A   
00BC   6F                     LD   L,A   
00BD   26 82                  LD   H,LETPAGE   
00BF                          ;*Macro unroll:  NEXT
00BF   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00C0                          DS   CPM+FAST-CPM*FAST,0DDh   
00C0                          DS   CPM+FAST-CPM*FAST,0E9h   
00C0                          ENDIF      
00C0                          IF   SBASEU   
                    LOWER:    JP   lowq   
00C0                          ENDIF      
00C0                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00C0                             ; the return stack, and the IP becomes the address in the letter's cell.
00C0   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00C1   EB                     EX   DE,HL   ; park TOS
00C2   87                     ADD   A,A   
00C3   6F                     LD   L,A   
00C4   26 82                  LD   H,LETPAGE   ; HL -> cell
00C6   4E                     LD   C,(HL)   
00C7   2C                     INC   L   
00C8   46                     LD   B,(HL)   ; IP = the word's body
00C9   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00CA                             ; rpushn: move the top cell of the data stack (in memory) to the return
00CA                             ; stack, then next. Everything that pushes the return stack ends here.
00CA                             ; 
00CA                             ; The break key is looked at here, so at every word call and loop-back (and
00CA                             ; block entry and "{"), but only one time in 256: PCNT counts them.
00CA                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
00CA   D1           RPUSHN:   POP   DE   
00CB   FD 72 FF               LD   (IY-1),D   
00CE   FD 73 FE               LD   (IY-2),E   
00D1   FD 2B                  DEC   IY   
00D3   FD 2B                  DEC   IY   
00D5   E5                     PUSH   HL   
00D6   21 36 82               LD   HL,PCNT   
00D9   35                     DEC   (HL)   
00DA   E1                     POP   HL   ; (the zero flag lasts)
00DB   CC EF 02               CALL   Z,pollk   
00DE                          ;*Macro unroll:  NEXT
00DE   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00DF                          DS   CPM+FAST-CPM*FAST,0DDh   
00DF                          DS   CPM+FAST-CPM*FAST,0E9h   
00DF                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
00DF   E3           H_TOR:    EX   (SP),HL   
00E0   18 E8                  JR   rpushn   
00E2   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
00E3                             ; ---- machine code: the grave -----------------------------------------------
00E3                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00E3                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00E3                             ; written and its address is left. An odd last digit is consumed and dropped.
00E3                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00E3                             ; code is entered by CALL with the data stack above the return address; it
00E3                             ; must keep BC, and on return the top cell becomes the new TOS.
00E3   CD C3 02     H_GRAVE:   CALL   hexc   
00E6                          IF   1-CPM*CHECKED   
00E6   30 BF                  JR   NC,exec   
00E8                          ENDIF      
00E8                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
00E8                          ENDIF      
00E8   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00E9   CD C3 02               CALL   hexc   
00EC   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00EE   ED 6F                  RLD      ;   overwrites it
00F0   23                     INC   HL   ; ... and RLD shifts it up under the low one
00F1   CD C3 02               CALL   hexc   
00F4   38 F2                  JR   C,hx1   
00F6   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00F8                          ;*Macro unroll:  NEXT
00F8   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00F9                          DS   CPM+FAST-CPM*FAST,0DDh   
00F9                          DS   CPM+FAST-CPM*FAST,0E9h   
00F9                             ; ---- where the two pages meet ----------------------------------------------
00F9                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00F9                             ; are in falling code order for this), and where exactly differs between the
00F9                             ; builds: NPG1 follows. Every handler below these four must start in the
00F9                             ; second page, and every one above in the first; chktab.py checks both.
00F9                             ; "]" returns: pop an address and jump to it.
00F9                          ;*Macro unroll: h_ret:  POPR
00F9   CF           H_RET:    DS   1-CPM,0CFh   
00FA                          DS   CPM,0CDh   
00FA                          DS   CPM,AROP&0FFh   
00FA                          DS   CPM,AROP/256   
00FA   42                     LD   B,D   
00FB   4B                     LD   C,E   
00FC                          ;*Macro unroll: brk1:   NEXT
00FC   F7           BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
00FD                          DS   CPM+FAST-CPM*FAST,0DDh   
00FD                          DS   CPM+FAST-CPM*FAST,0E9h   
00FD                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00FD                             ; drops the block start, "]" returns. No closer at all ends the program.
00FD   7C           H_BREAK:   LD   A,H   
00FE   B5                     OR   L   
00FF   E1                     POP   HL   
0100   28 FA                  JR   Z,brk1   
0102   CD A2 02               CALL   skip   
0105   B7                     OR   A   ; skip returns 0 for ")"
0106   20 F1                  JR   NZ,h_ret   
0108                          ;*Macro unroll: rdrop:  POPR
0108   CF           RDROP:    DS   1-CPM,0CFh   
0109                          DS   CPM,0CDh   
0109                          DS   CPM,AROP&0FFh   
0109                          DS   CPM,AROP/256   
0109                          ;*Macro unroll:  NEXT
0109   F7                     DS   (1-CPM)*(1-FAST),0F7h   
010A                          DS   CPM+FAST-CPM*FAST,0DDh   
010A                          DS   CPM+FAST-CPM*FAST,0E9h   
010A                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
010A                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
010A                             ; the body"s address instead. Either way it then skips to the matching "]'.
010A                             ; (The unchecked build takes anything that is not a letter as the space; the
010A                             ; checked build stops on it.)
010A   0A           H_DEF:    LD   A,(BC)   
010B   03                     INC   BC   
010C   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
010E   5F                     LD   E,A   ;   lands 64 bytes up
010F   E6 DF                  AND   0DFh   ; fold case
0111   FE 1A                  CP   26   
0113   30 0B                  JR   NC,def2   ; not a letter
0115   CB 23                  SLA   E   
0117   16 82                  LD   D,LETPAGE   ; DE -> cell
0119   79                     LD   A,C   
011A   12                     LD   (DE),A   
011B   1C                     INC   E   
011C   78                     LD   A,B   
011D   12                     LD   (DE),A   
011E   18 03                  JR   skipnx   
0120                DEF2:        
0120                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0120                          ENDIF      
0120   E5                     PUSH   HL   ; an anonymous block: push its address
0121   60                     LD   H,B   
0122   69                     LD   L,C   
0123                SKIPNX:      
0123                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0123                          ENDIF      ;   opener, the "[", just before where it starts
0123   CD A2 02     SKIPO:    CALL   skip   
0126                          ;*Macro unroll:  NEXT
0126   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0127                          DS   CPM+FAST-CPM*FAST,0DDh   
0127                          DS   CPM+FAST-CPM*FAST,0E9h   
0127   5E           H_FETCH:   LD   E,(HL)   ; "@"
0128   23                     INC   HL   
0129   56                     LD   D,(HL)   
012A   EB                     EX   DE,HL   
012B                          ;*Macro unroll:  NEXT
012B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
012C                          DS   CPM+FAST-CPM*FAST,0DDh   
012C                          DS   CPM+FAST-CPM*FAST,0E9h   
012C                             ; =============================================================================
012C                             ;  Handlers that must start in the image's second page.
012C                             ;  "?" is the last (with "," inside it), so its long tail may run past that
012C                             ;  page.
012C                             ; =============================================================================
012C                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
012C                             ; the matching ")".
012C   7C           H_OPEN:   LD   A,H   
012D   B5                     OR   L   
012E   E1                     POP   HL   
012F   28 F2                  JR   Z,skipo   
0131   C5                     PUSH   BC   ; the block starts at the IP
0132   18 96                  JR   rpushn   
0134                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0134                             ; drops it and carries on.
0134   7C           H_CLOSE:   LD   A,H   
0135   B5                     OR   L   
0136   E1                     POP   HL   
0137   28 CF                  JR   Z,rdrop   
0139                          IF   QK   
                              JP   closeq   ; (out of the handlers' pages: see Speed-ups)
0139                          ENDIF      
0139                          IF   1-QK   
0139                          ;*Macro unroll:  POPR                    ; pop the block start ...
0139   CF                     DS   1-CPM,0CFh   ; pop the block start ...
013A                          DS   CPM,0CDh   
013A                          DS   CPM,AROP&0FFh   
013A                          DS   CPM,AROP/256   
013A   42                     LD   B,D   
013B   4B                     LD   C,E   
013C   C5                     PUSH   BC   
013D                          ENDIF      
013D                          IF   (1-QK)*(1-CPM)   
013D   18 8B                  JR   rpushn   ; ... and push it back
013F                          ENDIF      
013F                          IF   (1-QK)*CPM   
                              JP   rpushn   
013F                          ENDIF      
013F                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
013F                             ; "-" has two jobs: directly before a digit it starts a negative number.
013F   0A           H_SUB:    LD   A,(BC)   
0140   D6 30                  SUB   "0"   
0142   FE 0A                  CP   10   
0144   38 04                  JR   C,negnum   
0146                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0146   E7                     DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0147                          DS   CPM,0CDh   
0147                          DS   CPM,ANEG&0FFh   
0147                          DS   CPM,ANEG/256   
0147   D1           H_ADD:    POP   DE   
0148   19                     ADD   HL,DE   
0149                          ;*Macro unroll:  NEXT
0149   F7                     DS   (1-CPM)*(1-FAST),0F7h   
014A                          DS   CPM+FAST-CPM*FAST,0DDh   
014A                          DS   CPM+FAST-CPM*FAST,0E9h   
014A   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
014B   CD 80 02               CALL   rdnum   
014E                          ;*Macro unroll:  NEGH
014E   E7                     DS   1-CPM,0E7h   
014F                          DS   CPM,0CDh   
014F                          DS   CPM,ANEG&0FFh   
014F                          DS   CPM,ANEG/256   
014F                          ;*Macro unroll:  NEXT
014F   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0150                          DS   CPM+FAST-CPM*FAST,0DDh   
0150                          DS   CPM+FAST-CPM*FAST,0E9h   
0150   D1           H_AND:    POP   DE   
0151   7C                     LD   A,H   
0152   A2                     AND   D   
0153   67                     LD   H,A   
0154   7D                     LD   A,L   
0155   A3                     AND   E   
0156   6F                     LD   L,A   
0157                          ;*Macro unroll:  NEXT
0157   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0158                          DS   CPM+FAST-CPM*FAST,0DDh   
0158                          DS   CPM+FAST-CPM*FAST,0E9h   
0158                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0158                             ; cells first. Flipping both sign bits turns a signed compare into an
0158                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0158                             ; carry into -1 or 0 with no branch.
0158   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0159   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
015A   7C                     LD   A,H   
015B   EE 80                  XOR   80h   
015D   67                     LD   H,A   
015E   7A                     LD   A,D   
015F   EE 80                  XOR   80h   
0161   57                     LD   D,A   
0162   ED 52                  SBC   HL,DE   ; carry if HL < DE
0164   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0166                          ;*Macro unroll:  NEXT
0166   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0167                          DS   CPM+FAST-CPM*FAST,0DDh   
0167                          DS   CPM+FAST-CPM*FAST,0E9h   
0167   D1           H_EQ:     POP   DE   
0168   B7                     OR   A   
0169   ED 52                  SBC   HL,DE   
016B   7C                     LD   A,H   
016C   B5                     OR   L   
016D   FE 01                  CP   1   ; carry only if a - b = 0
016F   18 F3                  JR   tf   
0171                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0171                             ; multiplier shifts up through A:C.
0171                          IF   1-QK   
0171   D1           H_MUL:    POP   DE   ; DE = multiplicand
0172   C5                     PUSH   BC   
0173   7C                     LD   A,H   
0174   4D                     LD   C,L   ; A:C = multiplier
0175   21 00 00               LD   HL,0   
0178   06 10                  LD   B,16   
017A   29           MUL1:     ADD   HL,HL   
017B   CB 21                  SLA   C   
017D   17                     RLA      
017E   30 01                  JR   NC,mul2   
0180   19                     ADD   HL,DE   
0181   10 F7        MUL2:     DJNZ   mul1   
0183   C1                     POP   BC   
0184                          ;*Macro unroll:  NEXT
0184   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0185                          DS   CPM+FAST-CPM*FAST,0DDh   
0185                          DS   CPM+FAST-CPM*FAST,0E9h   
0185                          ENDIF      
0185                          IF   QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0185                          ENDIF      
0185                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0185                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0185                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0185                             ; stops on it.
0185                H_DIV:       
0185                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0185                          ENDIF      
0185   D1                     POP   DE   ; DE = a, HL = b
0186   D5                     PUSH   DE   ; a, for r's sign
0187   7A                     LD   A,D   
0188   AC                     XOR   H   
0189   F5                     PUSH   AF   ; S flag = sign of q
018A   CB 7C                  BIT   7,H   
018C   C4 20 00               CALL   NZ,neg16   ; HL = |b|
018F   EB                     EX   DE,HL   
0190   CB 7C                  BIT   7,H   
0192   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0195   CD 58 02               CALL   udiv   ; HL = q, DE = r
0198   F1                     POP   AF   
0199   FC 20 00               CALL   M,neg16   ; q's sign
019C   EB                     EX   DE,HL   ; HL = r, DE = q
019D   F1                     POP   AF   ; A = a's high byte
019E   B7                     OR   A   
019F   FC 20 00               CALL   M,neg16   ; r's sign
01A2   D5                     PUSH   DE   ; q under r
01A3                          ;*Macro unroll:  NEXT
01A3   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01A4                          DS   CPM+FAST-CPM*FAST,0DDh   
01A4                          DS   CPM+FAST-CPM*FAST,0E9h   
01A4                             ; ---- stack and storage -----------------------------------------------------
01A4   E5           H_DUP:    PUSH   HL   ; ":"
01A5                          ;*Macro unroll:  NEXT
01A5   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01A6                          DS   CPM+FAST-CPM*FAST,0DDh   
01A6                          DS   CPM+FAST-CPM*FAST,0E9h   
01A6   E3           H_SWAP:   EX   (SP),HL   ; "%"
01A7                          ;*Macro unroll:  NEXT
01A7   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01A8                          DS   CPM+FAST-CPM*FAST,0DDh   
01A8                          DS   CPM+FAST-CPM*FAST,0E9h   
01A8                             ; (The checked build tests the address before it takes the value off the
01A8                             ; stack, so that an error report shows both.)
01A8                H_CSTORE:      ; "." ( c addr -- )
01A8                          IF   CHECKED   
                              CALL   chkst   
01A8                          ENDIF      
01A8   D1                     POP   DE   
01A9   73                     LD   (HL),E   
01AA                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
01AA   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
01AB                          DS   CPM+FAST-CPM*FAST,0E1h   
01AB                          DS   CPM+FAST-CPM*FAST,0DDh   
01AB                          DS   CPM+FAST-CPM*FAST,0E9h   
01AB                H_STORE:      ; "!" ( n addr -- )
01AB                          IF   CHECKED   
                              CALL   chkst   
01AB                          ENDIF      
01AB   D1                     POP   DE   
01AC   73                     LD   (HL),E   
01AD   23                     INC   HL   
01AE   72                     LD   (HL),D   
01AF                          ;*Macro unroll:  DROP
01AF   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01B0                          DS   CPM+FAST-CPM*FAST,0E1h   
01B0                          DS   CPM+FAST-CPM*FAST,0DDh   
01B0                          DS   CPM+FAST-CPM*FAST,0E9h   
01B0                             ; ---- console ---------------------------------------------------------------
01B0                             ; 22h pushes the address of the text after it and skips the string.
01B0   E5           H_STR:    PUSH   HL   
01B1   60                     LD   H,B   
01B2   69                     LD   L,C   
01B3   CD 97 02               CALL   skipstr   
01B6                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01B6                          ENDIF      
01B6                          ;*Macro unroll:  NEXT
01B6   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01B7                          DS   CPM+FAST-CPM*FAST,0DDh   
01B7                          DS   CPM+FAST-CPM*FAST,0E9h   
01B7                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01B7                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01B7                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01B7                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01B7                          IF   1-CHECKED   
01B7   7E           H_PRINT:   LD   A,(HL)   
01B8   23                     INC   HL   
01B9   FE 22                  CP   22h   
01BB   28 15                  JR   Z,pr9   
01BD   FE 2F                  CP   "/"   
01BF   20 0C                  JR   NZ,pr1   
01C1   7E                     LD   A,(HL)   
01C2   23                     INC   HL   
01C3   FE 60                  CP   60h   
01C5   38 04                  JR   C,pr0   
01C7   FE 7F                  CP   7Fh   
01C9   38 57                  JR   C,pesc   
01CB   E6 BF        PR0:      AND   0BFh   
01CD                          ;*Macro unroll: pr1:    PUTA
01CD   EF           PR1:      DS   1-CPM,0EFh   
01CE                          DS   CPM,0CDh   
01CE                          DS   CPM,APUT&0FFh   
01CE                          DS   CPM,APUT/256   
01CE   18 E7                  JR   h_print   
01D0                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
01D0                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01D0                          ENDIF      
01D0                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM+FAST-CPM*FAST,0E1h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
01D0                          ENDIF      
01D0   7D           H_EMIT:   LD   A,L   ; "'"
01D1                          ;*Macro unroll:  PUTA
01D1   EF                     DS   1-CPM,0EFh   
01D2                          DS   CPM,0CDh   
01D2                          DS   CPM,APUT&0FFh   
01D2                          DS   CPM,APUT/256   
01D2                          ;*Macro unroll: pr9:    DROP
01D2   DF           PR9:      DS   (1-CPM)*(1-FAST),0DFh   
01D3                          DS   CPM+FAST-CPM*FAST,0E1h   
01D3                          DS   CPM+FAST-CPM*FAST,0DDh   
01D3                          DS   CPM+FAST-CPM*FAST,0E9h   
01D3                             ; "#" prints TOS as a signed decimal number, with no space after it.
01D3   CD D5 02     H_NUM:    CALL   psgn   
01D6                          ;*Macro unroll:  DROP
01D6   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01D7                          DS   CPM+FAST-CPM*FAST,0E1h   
01D7                          DS   CPM+FAST-CPM*FAST,0DDh   
01D7                          DS   CPM+FAST-CPM*FAST,0E9h   
01D7                             ; "?" ( n -- c ) or ( -n -- addr )
01D7                             ;   n > 0: wait about n ms for a key; 0 if none came
01D7                             ;   n = 0: wait for a key
01D7                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01D7                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01D7   CB 7C        H_KEY:    BIT   7,H   
01D9   20 19                  JR   NZ,line   
01DB   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01DD   CD 1D 03     KT2:      CALL   getk   
01E0   20 0E                  JR   NZ,kt3   
01E2   1D                     DEC   E   
01E3   20 F8                  JR   NZ,kt2   
01E5   7C                     LD   A,H   ; 0? never counts down: it waits
01E6   B5                     OR   L   
01E7   28 F2                  JR   Z,kt1   
01E9   2B                     DEC   HL   
01EA   7C                     LD   A,H   
01EB   B5                     OR   L   
01EC   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01EE   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01EF   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01F0   6F           KT3:      LD   L,A   
01F1   26 00                  LD   H,0   
01F3                          ;*Macro unroll:  NEXT
01F3   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01F4                          DS   CPM+FAST-CPM*FAST,0DDh   
01F4                          DS   CPM+FAST-CPM*FAST,0E9h   
01F4                             ; Backspace takes the last character back (and is echoed as it
01F4                             ; is), CR ends (stored, not echoed), every other key is stored and
01F4                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01F4                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01F4                             ; is the place in the line: D holds the L of a full line.
01F4   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01F7   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01F8   9F                     SBC   A,A   
01F9   A5                     AND   L   ; (0 for a count that is too big)
01FA   2F                     CPL      
01FB   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01FC                             ;   at most
01FC   21 80 82               LD   HL,LINEBUF   
01FF   CD 1D 03     LN2:      CALL   getk   
0202   28 FB                  JR   Z,ln2   
0204   FE 0D                  CP   13   
0206   28 16                  JR   Z,ln5   
0208   FE 08                  CP   8   
020A   28 0B                  JR   Z,ln4   
020C   5F                     LD   E,A   
020D   7D                     LD   A,L   
020E   BA                     CP   D   
020F   28 EE                  JR   Z,ln2   ; full
0211   73                     LD   (HL),E   
0212   2C                     INC   L   
0213   7B                     LD   A,E   
0214                          ;*Macro unroll: ln3:    PUTA
0214   EF           LN3:      DS   1-CPM,0EFh   
0215                          DS   CPM,0CDh   
0215                          DS   CPM,APUT&0FFh   
0215                          DS   CPM,APUT/256   
0215   18 E8                  JR   ln2   
0217   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0218   FA 14 02               JP   M,ln3   ;   unless the line was empty (L left the
021B   2C                     INC   L   ;   upper half of the page)
021C   18 E1                  JR   ln2   
021E   77           LN5:      LD   (HL),A   ; the CR
021F   2E 80                  LD   L,LINEBUF & 0FFh   
0221                          ;*Macro unroll:  NEXT
0221   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0222                          DS   CPM+FAST-CPM*FAST,0DDh   
0222                          DS   CPM+FAST-CPM*FAST,0E9h   
0222                             ; =============================================================================
0222                             ;  More routines (no handler starts past this point)
0222                             ; =============================================================================
0222                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
                              DB   13,10,22h   ;   the caller's text)
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
0222                          ENDIF      
0222                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0222                             ; HL points past it. Each goes back into the loop that prints the string
0222                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0222                             ;    /a-/z   print the variable, as "#" does
0222                             ;    /{      clear the screen, the cursor to the top left
0222                             ;    /}      clear from the cursor to the end of the line
0222                             ;    /|  /`  show the cursor, hide it
0222                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0222   FE 7E        PESC:     CP   7Eh   
0224   28 1C                  JR   Z,pat   
0226   11 B7 01               LD   DE,PRLOOP   ; the others return into the loop
0229   D5                     PUSH   DE   
022A   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
022C   30 1D                  JR   NC,pcon   
022E   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0230   30 22                  JR   NC,phide   
0232   87                     ADD   A,A   ; the variable's cell
0233   C6 40                  ADD   A,40h   
0235   E5                     PUSH   HL   
0236   6F                     LD   L,A   
0237   26 82                  LD   H,LETPAGE   
0239   7E                     LD   A,(HL)   
023A   2C                     INC   L   
023B   66                     LD   H,(HL)   
023C   6F                     LD   L,A   
023D   CD D5 02               CALL   psgn   
0240   E1                     POP   HL   
0241   C9                     RET      
0242                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0242                             ; the checked build "$" is the routine prstr: its own return address goes
0242                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0242                             ; its two cells are there, and is s if not, before it prints anything.
0242                PAT:         
0242                          IF   CHECKED   
                              EX   (SP),HL   ; the text pointer over prstr's return address
                              LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              ADD   HL,SP   
                              JP   C,e_under   
                              POP   HL   
0242                          ENDIF      
0242   D1                     POP   DE   ; DE = the column
0243   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0244                          IF   1-ANS   
0244   CD 15 FF               CALL   CONAT   
0247   E1                     POP   HL   
0248   C3 B7 01               JP   PRAGAIN   
024B                             ; With ANSI = 0 the machine's routines do the rest.
024B   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
024E   FE 02                  CP   2   
0250   CA 0F FF               JP   Z,CONEOL   ; /}
0253   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
0254   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0255   C3 12 FF               JP   CONCUR   
0258                          ENDIF      
0258                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    3Bh             ; ';'
                              DS   1-CPM,3Eh   ; ";"
                              DS   1-CPM,3Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Bh   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    48h             ; 'H'
                              DS   1-CPM,3Eh   ; "H"
                              DS   1-CPM,48h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,48h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0258                          ENDIF      
0258                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0258                          ENDIF      
0258                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
0258                          ENDIF      
0258                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0258                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0258                             ; the quotient bits arrive at the bottom of C.
0258                             ; Dividing by 2 is one shift (the spec wants that fast).
0258                          IF   1-QK   
0258   7B           UDIV:     LD   A,E   
0259   EE 02                  XOR   2   
025B   B2                     OR   D   
025C   20 07                  JR   NZ,udv0   
025E   CB 3C                  SRL   H   
0260   CB 1D                  RR   L   ; the quotient
0262   8F                     ADC   A,A   
0263   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0264   C9                     RET      
0265                          ENDIF      
0265                          IF   QK   
                                 ; (The builds with room divide by any power of two with shifts: 2, and 32,
                                 ; 64, 256 and the like, which fixed point and byte work use all the time.)
                    UDIV:     LD   A,D   
                              OR   A   
                              JR   NZ,uq1   ; 256 and up
                              OR   E   
                              JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
                              DEC   A   
                              AND   E   
                              JR   NZ,udv0   ; not a power of two
                              LD   A,E   ; by 2^k below 256: q = HL >> k, and
                              DEC   A   ;   r = L & (2^k - 1)
                              AND   L   
                              PUSH   AF   
                    UQ2:      SRL   E   
                              JR   C,uq3   
                              SRL   H   
                              RR   L   
                              JR   uq2   
                    UQ3:      POP   AF   
                              LD   E,A   
                              LD   D,0   
                              RET      
                    UQ1:      LD   A,E   
                              OR   A   
                              JR   NZ,udv0   
                              LD   A,D   
                              DEC   A   
                              AND   D   
                              JR   NZ,udv0   ; not a power of two
                              LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
                              DEC   A   ;   r = HL & (2^k - 1)
                              AND   H   
                              LD   E,A   ; (the remainder's high byte,
                              LD   A,L   ;   and its low byte)
                              LD   L,H   
                              LD   H,0   
                    UQ4:      SRL   D   
                              JR   C,uq5   
                              SRL   L   
                              JR   uq4   
                    UQ5:      LD   D,E   
                              LD   E,A   
                              RET      
0265                          ENDIF      
0265                          IF   1-FAST   
0265   C5           UDV0:     PUSH   BC   
0266   7C                     LD   A,H   
0267   4D                     LD   C,L   
0268   21 00 00               LD   HL,0   
026B   06 10                  LD   B,16   
026D   CB 21        UDV1:     SLA   C   
026F   17                     RLA      
0270   ED 6A                  ADC   HL,HL   
0272   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0274   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0276   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0277   0D                     DEC   C   ;   INC below
0278   0C           UDV2:     INC   C   ; a quotient bit
0279   10 F2                  DJNZ   udv1   
027B   EB                     EX   DE,HL   ; DE = remainder
027C   67                     LD   H,A   
027D   69                     LD   L,C   ; HL = quotient
027E   C1                     POP   BC   
027F   C9                     RET      
0280                          ENDIF      
0280                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
0280                          ENDIF      
0280                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0280                             ; non-digit. Values wrap at 16 bits, as the spec says.
0280   21 00 00     RDNUM:    LD   HL,0   
0283   0A           RDN1:     LD   A,(BC)   
0284   D6 30                  SUB   "0"   
0286   FE 0A                  CP   10   
0288   D0                     RET   NC   
0289   03                     INC   BC   
028A   54                     LD   D,H   
028B   5D                     LD   E,L   
028C   29                     ADD   HL,HL   
028D   29                     ADD   HL,HL   
028E   19                     ADD   HL,DE   
028F   29                     ADD   HL,HL   ; HL * 10
0290   5F                     LD   E,A   
0291   16 00                  LD   D,0   
0293   19                     ADD   HL,DE   
0294   18 ED                  JR   rdn1   
0296                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0296                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0296                          IF   1-CHECKED   
0296   03           SS0:      INC   BC   
0297   0A           SKIPSTR:   LD   A,(BC)   
0298   03                     INC   BC   
0299   FE 2F                  CP   "/"   
029B   28 F9                  JR   Z,ss0   
029D   FE 22                  CP   22h   
029F   20 F6                  JR   NZ,skipstr   
02A1   C9                     RET      
02A2                          ENDIF      
02A2                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
02A2                          ENDIF      
02A2                             ; skip: read past text to the closer at this level, and return A = 0 if it
02A2                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02A2                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02A2                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02A2                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02A2                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02A2                             ; 
02A2                             ; The checked build also looks at the character the skip was started by,
02A2                             ; which is always the one just before where it starts: "(" must end at ")",
02A2                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02A2                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
02A2                             ; place where the skip started, for the report.
02A2                          IF   1-QK   
02A2                             ; (Without base: no skip cache.)
02A2                SKIP:        
02A2                          ENDIF      
02A2                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
02A2                          ENDIF      
02A2                          IF   1-QK   
02A2   16 00                  LD   D,0   
02A4   14           SK3:      INC   D   ; an opener: one deeper
02A5   0A           SK1:      LD   A,(BC)   
02A6                          ENDIF      
02A6                          IF   (1-CHECKED)*(1-QK)   
02A6   03                     INC   BC   
02A7   B7                     OR   A   
02A8   CA 6E 03               JP   Z,SKEND   ; (the end of the program)
02AB                          ENDIF      
02AB                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
02AB                          ENDIF      
02AB                          IF   1-QK   
02AB   FE 22                  CP   22h   
02AD   CC 97 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02B0   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02B2   28 F0                  JR   Z,sk3   
02B4   3D                     DEC   A   ; ")"
02B5   28 08                  JR   Z,sk4   
02B7   D6 32                  SUB   "["-")"   
02B9   28 E9                  JR   Z,sk3   
02BB   FE 02                  CP   "]"-"["   
02BD   20 E6                  JR   NZ,sk1   
02BF   15           SK4:      DEC   D   
02C0                          ENDIF      
02C0                          IF   (1-CHECKED)*(1-QK)   
02C0   C8                     RET   Z   ; the closer at this level
02C1   18 E2                  JR   sk1   
02C3                          ENDIF      
02C3                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02C3                          ENDIF      
02C3                          IF   QK   
                                 ; The skip cache. Nearly every skip is one that has happened before (a loop
                                 ; skips the same false block on every pass), so the first scan from each
                                 ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
                                 ; start's low byte. Only skips that start in the program text are kept (the
                                 ; line buffer changes); the cache is emptied whenever a run starts (skclr).
                                 ; A program that changes its own text while it runs is not looked after.
                    SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
                              LD   A,B   ;   checked report's place)
                              CP   PROG/256   
                              JR   C,sks   ; below the program text: no cache
                              LD   A,C   
                              ADD   A,A   
                              ADD   A,A   
                              LD   E,A   
                              LD   D,CPAGE   ; DE -> the entry
                              LD   A,(DE)   
                              CP   C   
                              JR   NZ,sks   
                              INC   E   
                              LD   A,(DE)   
                              CP   B   
                              JR   NZ,sks   
                              INC   E   
                              LD   A,(DE)   
                              LD   C,A   
                              INC   E   
                              LD   A,(DE)   
                              LD   B,A   ; a hit: the IP is past the closer
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              SUB   ")"   ; 0 for ")", not 0 for "]"
                              RET      
                    SKS:         
02C3                          ENDIF      
02C3                          IF   QK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
02C3                          ENDIF      
02C3                          IF   QK   
                                 ; The scan. Most characters are nothing to it, and two range tests rule
                                 ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                              LD   D,0   
                    SQ3:      INC   D   ; an opener: one deeper
                    SQ1:      LD   A,(BC)   
                              INC   BC   
                              CP   5Eh   
                              JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CP   5Bh   
                              JR   NC,sqb   ; [ \ ]
                              CP   2Ah   
                              JR   NC,sq1   ; * to Z: nothing
                              CP   28h   
                              JR   Z,sq3   ; (
                              JR   NC,sqc   ; )
                              CP   22h   
                              JR   Z,sqq   ; a string
                              OR   A   
                              JR   NZ,sq1   ; the rest below "(": nothing
02C3                          ENDIF      
02C3                          IF   QK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
02C3                          ENDIF      
02C3                          IF   QK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02C3                          ENDIF      
02C3                          IF   QK   
                    SQQ:      CALL   skipstr   ; step over the string
                              JR   sq1   
                    SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
                              JR   Z,sq1   ; "\" is nothing here
                              JR   C,sq3   ; [
                              LD   A,2   ; ]
                              JR   sq4   
                    SQC:      XOR   A   ; )
                    SQ4:      DEC   D   
                              JR   NZ,sq1   
02C3                          ENDIF      
02C3                          IF   QK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
02C3                          ENDIF      
02C3                          IF   QK   
                                 ; The closer at this level: remember the skip (if it started in the program
                                 ; text), and return A = 0 for ")" or 2 for "]".
                              PUSH   AF   
                              PUSH   HL   
                              LD   HL,(SKPL)   
                              LD   A,H   
                              CP   PROG/256   
                              JR   C,sq9   
                              LD   A,L   
                              ADD   A,A   
                              ADD   A,A   
                              LD   E,A   
                              LD   D,CPAGE   
                              LD   A,L   
                              LD   (DE),A   
                              INC   E   
                              LD   A,H   
                              LD   (DE),A   
                              INC   E   
                              LD   A,C   
                              LD   (DE),A   
                              INC   E   
                              LD   A,B   
                              LD   (DE),A   
                    SQ9:      POP   HL   
                              POP   AF   
                              RET      
                                 ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
                    SKCLR:    PUSH   HL   
                              LD   HL,CPAGE*256   
                    SKC1:     LD   (HL),0   
                              INC   L   
                              JR   NZ,skc1   
                              POP   HL   
                              RET      
02C3                          ENDIF      
02C3                             ;  ---- Speed-ups (base builds) -------------------------------------------
02C3                             ;  The skip cache is above. These are the handlers' tails that the builds with
02C3                             ;  room take, kept here, out of the handlers' first two pages.
02C3                          IF   QK   
                                 ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
                                 ; multiplier (most multiplications have one, a count or a small constant).
                    MULQ:     LD   A,H   
                              OR   A   
                              JR   Z,mq8   ; the multiplier is below 256
                              LD   A,D   
                              OR   A   
                              JR   NZ,mq16   
                              EX   DE,HL   ; the multiplicand is: it becomes the multiplier
02C3                          ENDIF      
02C3                          IF   QK*(1-FAST)   
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              PUSH   BC   
                              LD   B,8   
                    MQ1:      ADD   HL,HL   
                              RLA      
                              JR   NC,mq2   
                              ADD   HL,DE   
                    MQ2:      DJNZ   mq1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    MQ3:      ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mq4   
                              ADD   HL,DE   
                    MQ4:      DJNZ   mq3   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
02C3                          ENDIF      
02C3                          IF   FAST   
                                 ; (the fast build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
02C3                          ENDIF      
02C3                          IF   QK   
                                 ; A true ")" reads the block start where it is, on top of the return stack,
                                 ; instead of popping it and pushing it back; the break key is looked at as
                                 ; rpushn would.
                    CLOSEQ:   LD   C,(IY+0)   
                              LD   B,(IY+1)   
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
02C3                          ENDIF      
02C3                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
02C3                          ENDIF      
02C3                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
02C3                          ENDIF      
02C3                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
02C3                          ENDIF      
02C3                             ; =============================================================================
02C3                             ;  Dispatch table: the low byte of each handler's address, in code order
02C3                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02C3                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02C3                             ; =============================================================================
02C3                             ; The handlers of the first NPG1 characters start in the image's second page.
02C3                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02C3                             ; differs between the builds, so the count is worked out here.
02C3                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02C3                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02C3                PGBRK:    EQU   (h_break-BASE)/256   
02C3                PGDEF:    EQU   (h_def-BASE)/256   
02C3                PGFET:    EQU   (h_fetch-BASE)/256   
02C3                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02C3                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02C3                          ENDIF      
02C3                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02C3                             ; and return its value in A with the carry set; otherwise leave the IP and
02C3                             ; return with the carry clear.
02C3   0A           HEXC:     LD   A,(BC)   
02C4   D6 30                  SUB   "0"   
02C6   FE 0A                  CP   10   
02C8   38 09                  JR   C,hc1   
02CA   E6 DF                  AND   0DFh   
02CC   D6 11                  SUB   11h   
02CE   FE 06                  CP   6   
02D0   D0                     RET   NC   
02D1   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02D3   03           HC1:      INC   BC   
02D4   C9                     RET      
02D5                             ; psgn: print HL as a signed number. Keeps BC.
02D5   CB 7C        PSGN:     BIT   7,H   
02D7   28 04                  JR   Z,pdec   
02D9                          ;*Macro unroll:  PUTK    2Dh             ; '-'
02D9   3E                     DS   1-CPM,3Eh   ; "-"
02DA   2D                     DS   1-CPM,2Dh   
02DB   EF                     DS   1-CPM,0EFh   
02DC                          DS   CPM,0CDh   
02DC                          DS   CPM,APTK&0FFh   
02DC                          DS   CPM,APTK/256   
02DC                          DS   CPM,2Dh   
02DC                          ;*Macro unroll:  NEGH
02DC   E7                     DS   1-CPM,0E7h   
02DD                          DS   CPM,0CDh   
02DD                          DS   CPM,ANEG&0FFh   
02DD                          DS   CPM,ANEG/256   
02DD                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02DD                             ; Keeps BC.
02DD   11 0A 00     PDEC:     LD   DE,10   
02E0   CD 58 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02E3   7B                     LD   A,E   
02E4   F5                     PUSH   AF   
02E5   7C                     LD   A,H   
02E6   B5                     OR   L   
02E7   C4 DD 02               CALL   NZ,pdec   
02EA   F1                     POP   AF   
02EB   C6 30                  ADD   A,"0"   
02ED                          ;*Macro unroll:  PUTAR
02ED   EF                     DS   1-CPM,0EFh   
02EE   C9                     DS   1-CPM,0C9h   
02EF                          DS   CPM,0C3h   
02EF                          DS   CPM,APUT&0FFh   
02EF                          DS   CPM,APUT/256   
02EF                             ; (The table goes here instead in the builds where, before psgn, it would
02EF                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
02EF                             ; page: PTPAD is 0 unless it must.)
02EF                          IF   (1-TABP0)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02EF                          ENDIF      
02EF                             ; =============================================================================
02EF                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
02EF                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
02EF                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
02EF                             ;  they are the host's KEY and CONOUT routines themselves.
02EF                             ; 
02EF                             ;  A running program reads the keyboard only through getk and pollk, which
02EF                             ;  between them give the break key its rules:
02EF                             ;    - Ctrl-C stops the program;
02EF                             ;    - any other key that the break check reads is held in KEYBUF for the
02EF                             ;      next "?", and a newer one takes its place;
02EF                             ;    - "?" (getk) takes the held key first;
02EF                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
02EF                             ;      key like any other, but two of them within about 250 ms still stop it.
02EF                             ;  Both are called straight from a handler, never from a routine under one:
02EF                             ;  the checked build's report counts on finding one return address above the
02EF                             ;  data stack.
02EF                             ; =============================================================================
02EF                          IFN   CPM   
02EF                RAWK:     EQU   KEY   
02EF                          ENDIF      
02EF                             ; pollk: the break check (see rpushn).
02EF   CD 06 FF     POLLK:    CALL   rawk   
02F2   C8                     RET   Z   ; no key
02F3   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
02F6   FE 03        PK1:      CP   3   ; (getk joins here)
02F8   C0                     RET   NZ   
02F9                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
02F9                             ; the program has turned it off, wait about 250 ms for one more key: a
02F9                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
02F9                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
02F9   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
02FC   B7                     OR   A   
02FD   CA 65 03     CT0:      JP   Z,brk   
0300   D5                     PUSH   DE   
0301   11 10 27               LD   DE,250*MSLOOP   
0304   CD 06 FF     CT1:      CALL   rawk   
0307   20 05                  JR   NZ,ct2   
0309   1B                     DEC   DE   
030A   7A                     LD   A,D   
030B   B3                     OR   E   
030C   20 F6                  JR   NZ,ct1   
030E   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
030F   FE 03                  CP   3   
0311   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0313   B7                     OR   A   
0314   28 03                  JR   Z,ct3   
0316   32 7A 82               LD   (KEYBUF),A   
0319   3E 03        CT3:      LD   A,3   
031B   B7                     OR   A   
031C   C9                     RET      
031D                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
031D   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
031E   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0321   7E                     LD   A,(HL)   
0322   36 00                  LD   (HL),0   
0324   E1                     POP   HL   
0325   B7                     OR   A   
0326   C0                     RET   NZ   
0327   CD 06 FF               CALL   rawk   
032A   C8                     RET   Z   
032B   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
032D                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
032D                          ENDIF      ;   (with the editor, both stacks are cleared);
032D                          IF   (1-CHECKED)*EDITOR   
032D                BRK:      EQU   edit0   
032D                          ENDIF      
032D                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
032D                          ENDIF      
032D                          IF   CPM   
                                 ; The routines a generic build keeps in page zero (see there). Here they are
                                 ; out of the way of the handlers, which must fit in the image's first two
                                 ; pages.
                    RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
                              LD   D,(IY+1)   
                              INC   IY   
                              INC   IY   
                              RET      
                    NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
032D                          ENDIF      
032D                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
032D                          ENDIF      
032D                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JR   putc   
                    PUTK:     EX   (SP),HL   ; print the byte after the CALL
                              LD   A,(HL)   
                              INC   HL   
                              EX   (SP),HL   
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                                 ; It keeps every register but A and the flags: BDOS may change any of them
                                 ; (IX and IY too, in a Z80 BDOS or BIOS).
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              PUSH   IX   
                              PUSH   IY   
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              POP   IY   
                              POP   IX   
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              OR   A   ; (for getk)
                              RET      
032D                          ENDIF      
032D                             ; =============================================================================
032D                             ;  Checked build: the checks and the error report
032D                             ; =============================================================================
032D                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              PUSH   IY   ; the return stack: in its page (or it has
                              POP   DE   ;   overflowed), and not above its empty
                              LD   A,D   ;   position (an underflow stays inside the
                              CP   RSPAGE   ;   page, in the guard band)
                              LD   A,E   
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              LD   IY,RSTOP   ; return stack underflow: it counts as empty
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
032D                          ENDIF      
032D                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
032D                          ENDIF      
032D                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
032D                          ENDIF      
032D                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
032D                          ENDIF      
032D                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
032D                          ENDIF      
032D                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
032D                          ENDIF      
032D                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              ;*Macro unroll:  PUTK    2Ch             ; ','
                              DS   1-CPM,3Eh   ; ","
                              DS   1-CPM,2Ch   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,2Ch   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
                                 ;                       R:n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "D:",22h   
                              LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
                              SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
                                 ;   and holds nothing; pnl left the carry clear)
                              CALL   phalf   ; the depth
                              ;*Macro unroll:  PUTK    3Ah             ; ':'
                              DS   1-CPM,3Eh   ; ":"
                              DS   1-CPM,3Ah   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Ah   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              ;*Macro unroll:  PUTK    20h             ; ' '
                              DS   1-CPM,3Eh   ; " "
                              DS   1-CPM,20h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,20h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
                              POP   HL   ;   at most one entry below its page), so
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough
                              SUB   L   
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
032D                          ENDIF      
032D                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
032D                          ENDIF      
032D                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
032D                          ENDIF      
032D                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
032D                          ENDIF      
032D                             ; =============================================================================
032D                             ;  The line editor (EDITOR = 1)
032D                             ; 
032D                             ;  The interpreter starts here, and a program that ends comes back here.
032D                             ;  There is no prompt. It follows the spec's suggested standard for a line
032D                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
032D                             ; 
032D                             ;    n text    put the text in as line n; the lines from n on move down. A
032D                             ;              number past the end (or 0) adds the line at the end.
032D                             ;    n         take line n out
032D                             ;    anything else is run at once, as B8Script. (Start such a line with a
032D                             ;    space if it would begin with a digit.)
032D                             ; 
032D                             ;  A command key ends the line too, and takes what was typed as its argument:
032D                             ; 
032D                             ;    ^G        run the program
032D                             ;    n ^L      list from line n (no number: all of it). Any key holds the
032D                             ;              list until another key is pressed; Ctrl-C ends it.
032D                             ;    n ^E      put line n in the input line; Return puts it back, changed
032D                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
032D                             ;              last time). Generic: what is typed, or pasted, from now until
032D                             ;              ^Z replaces the program; it is not echoed.
032D                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
032D                             ;              time). Generic: the text is printed, as it is.
032D                             ;    ^N        new: no program
032D                             ;    ^X        leave (to LEAVE)
032D                             ; 
032D                             ;  In the line: the left and right arrow keys move the cursor;
032D                             ;  a character goes in at the cursor; Backspace and DEL take out the one
032D                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
032D                             ;  sent to the terminal, so any terminal will do.
032D                             ; 
032D                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
032D                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
032D                             ;  125 characters; the one character after a line number separates it from
032D                             ;  the text and is not stored. The text is kept as it is typed, each line
032D                             ;  ending in CR LF, at PROG.
032D                             ; 
032D                             ;  What lasts from one line to the next: the program, the words, the
032D                             ;  variables and the data stack. An error or a break clears both stacks. The
032D                             ;  return stack starts empty for every line.
032D                             ; 
032D                             ;  Things to know:
032D                             ;    - Reset empties the program (generic builds).
032D                             ;    - A word's address points into the program, so run the program again
032D                             ;      after editing it.
032D                             ;    - Nothing is printed between a program's output and what is typed next.
032D                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
032D                             ;      a line that calls -n? and carries on afterwards runs what was typed.
032D                             ;      (The stored program never comes back to the line, so it may.)
032D                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
032D                             ;      read of the other builds.
032D                             ; 
032D                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
032D                             ;  the last line left there, with TOS pushed like the rest.
032D                             ; =============================================================================
032D                          IF   EDGEN   
032D                INIT:        ; reset (A = 0)
032D                          ENDIF      
032D                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
032D                          ENDIF      
032D                          IF   EDGEN   
032D   18 36                  JR   edit0   
032F                          ENDIF      
032F                          IF   EDITOR   
032F                             ; Right arrow: one to the right, by printing the character there
032F   7D           RIGHT:    LD   A,L   
0330   BB                     CP   E   
0331   28 4E                  JR   Z,ed1   ; at the end
0333   7E                     LD   A,(HL)   
0334   2C                     INC   L   
0335   18 2B                  JR   lf1   
0337                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0337                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0337                             ; ends the sequence, and act on C (right) and D (left).
0337   01 C8 00     ESC:      LD   BC,5*MSLOOP   
033A   CD 06 FF     ES1:      CALL   rawk   
033D   20 0A                  JR   NZ,es2   
033F   0B                     DEC   BC   
0340   78                     LD   A,B   
0341   B1                     OR   C   
0342   20 F6                  JR   NZ,es1   
0344   CD AE 03               CALL   fin   ; no second key: the line is dropped
0347   18 27                  JR   edit   
0349   FE 5B        ES2:      CP   "["   
034B   20 34                  JR   NZ,ed1   ; not a sequence known here
034D   CD 07 04     ES3:      CALL   ekey   
0350   FE 40                  CP   40h   
0352   38 F9                  JR   C,es3   ; (its parameters)
0354   D6 43                  SUB   "C"   
0356   28 D7                  JR   Z,right   
0358   3D                     DEC   A   ; "D"?
0359   20 26                  JR   NZ,ed1   ; no: on into left
035B                             ; Left arrow: the cursor goes one to the left
035B   7D           LEFT:     LD   A,L   
035C   87                     ADD   A,A   
035D   28 22                  JR   Z,ed1   ; (L = 80h: at the start)
035F   2D                     DEC   L   
0360   3E 08                  LD   A,8   
0362                          ;*Macro unroll: lf1:    PUTA
0362   EF           LF1:      DS   1-CPM,0EFh   
0363                          DS   CPM,0CDh   
0363                          DS   CPM,APUT&0FFh   
0363                          DS   CPM,APUT/256   
0363   18 1C                  JR   ed1   
0365                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
0365                             ;   is shown, in case the program had hidden it and could not show it again.
0365                             ; skend: a program that ended inside skip: its return address goes.
0365                             ; edend: a program that ended: TOS joins the rest of the data stack.
0365   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0368                          ENDIF      
0368                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
0368                          ENDIF      
0368                          IF   EDITOR*(1-ANS)   
0368   3E 01                  LD   A,1   
036A   CD 12 FF               CALL   CONCUR   ; show the cursor
036D                          ENDIF      
036D                          IF   EDITOR   
036D   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
036E   D1           SKEND:    POP   DE   
036F   E5           EDEND:    PUSH   HL   
0370                             ; edit: start a new input line.
0370   FD 21 E0 80  EDIT:     LD   IY,RSTOP   ; the return stack is empty
0374                          ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
0374                          DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
0374                          DS   CPM+FAST-CPM*FAST,21h   
0374                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0374                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0374   21 00 00               LD   HL,0   
0377   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
037A   22 3A 82               LD   (EDLN),HL   ; no line is being edited
037D   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
0380   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0381   CD 07 04     ED1:      CALL   ekey   
0384   FE 7F                  CP   7Fh   
0386   28 38                  JR   Z,bsp   ; DEL
0388   FE 20                  CP   " "   
038A   30 4E                  JR   NC,insc   
038C   FE 09                  CP   9   
038E   28 4A                  JR   Z,insc   ; Tab is text
0390   FE 08                  CP   8   
0392   28 2C                  JR   Z,bsp   
0394   FE 1B                  CP   1Bh   
0396   28 9F                  JR   Z,esc   
0398   E5                     PUSH   HL   ; a command key? Look it up
0399   21 0D 04               LD   HL,cmds   
039C   06 08                  LD   B,NCMD   
039E   BE           ED2:      CP   (HL)   
039F   23                     INC   HL   
03A0   28 07                  JR   Z,ed3   
03A2   23                     INC   HL   
03A3   23                     INC   HL   
03A4   10 F8                  DJNZ   ed2   
03A6   E1                     POP   HL   
03A7   18 D8                  JR   ed1   ; no: the key is ignored
03A9   7E           ED3:      LD   A,(HL)   
03AA   23                     INC   HL   
03AB   66                     LD   H,(HL)   
03AC   6F                     LD   L,A   
03AD   E3                     EX   (SP),HL   ; the command's address: fin returns to it
03AE                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
03AE                             ; terminal. Leaves BC -> the line and HL -> the NUL.
03AE   26 82        FIN:      LD   H,LETPAGE   
03B0   6B                     LD   L,E   
03B1   36 0D                  LD   (HL),13   
03B3   2C                     INC   L   
03B4   36 0A                  LD   (HL),10   
03B6   2D                     DEC   L   
03B7   CD 07 05               CALL   prl   ; (prints the CR LF)
03BA   36 00                  LD   (HL),0   
03BC   01 80 82               LD   BC,LINEBUF   
03BF   C9                     RET      
03C0                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
03C0                             ; left, the rest of the line moves down over it, and the last place (now a
03C0                             ; space) is printed over along with the rest.
03C0   7D           BSP:      LD   A,L   
03C1   87                     ADD   A,A   
03C2   28 BD                  JR   Z,ed1   ; at the start
03C4   2D                     DEC   L   
03C5                          ;*Macro unroll:  PUTK    08h             ; backspace
03C5   3E                     DS   1-CPM,3Eh   ; backspace
03C6   08                     DS   1-CPM,08h   
03C7   EF                     DS   1-CPM,0EFh   
03C8                          DS   CPM,0CDh   
03C8                          DS   CPM,APTK&0FFh   
03C8                          DS   CPM,APTK/256   
03C8                          DS   CPM,08h   
03C8   E5                     PUSH   HL   
03C9   2C           BS1:      INC   L   
03CA   7E                     LD   A,(HL)   
03CB   2D                     DEC   L   
03CC   77                     LD   (HL),A   
03CD   2C                     INC   L   
03CE   7D                     LD   A,L   
03CF   BB                     CP   E   
03D0   20 F7                  JR   NZ,bs1   
03D2   2D                     DEC   L   
03D3   36 20                  LD   (HL)," "   
03D5   E1                     POP   HL   
03D6   53                     LD   D,E   
03D7   1D                     DEC   E   
03D8   18 15                  JR   ic2   
03DA                             ; A character goes in at the cursor: it ripples up through the rest of the
03DA                             ; line, the cursor moves on, and the rest is printed again.
03DA   47           INSC:     LD   B,A   
03DB   7B                     LD   A,E   
03DC   FE FD                  CP   0FDh   
03DE   28 A1                  JR   Z,ed1   ; the line is full: 125 characters
03E0   78                     LD   A,B   
03E1                          ;*Macro unroll:  PUTA
03E1   EF                     DS   1-CPM,0EFh   
03E2                          DS   CPM,0CDh   
03E2                          DS   CPM,APUT&0FFh   
03E2                          DS   CPM,APUT/256   
03E2   E5                     PUSH   HL   
03E3   7E           IC1:      LD   A,(HL)   
03E4   70                     LD   (HL),B   
03E5   47                     LD   B,A   
03E6   7D                     LD   A,L   
03E7   2C                     INC   L   
03E8   BB                     CP   E   
03E9   20 F8                  JR   NZ,ic1   
03EB   E1                     POP   HL   
03EC   2C                     INC   L   
03ED   1C                     INC   E   
03EE   53                     LD   D,E   
03EF   CD F4 03     IC2:      CALL   tail   
03F2   18 8D                  JR   ed1   
03F4                             ; tail: print the line from the cursor to D (a low byte), and bring the
03F4                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
03F4   4D           TAIL:     LD   C,L   
03F5   7D           TA1:      LD   A,L   
03F6   BA                     CP   D   
03F7   28 05                  JR   Z,ta2   
03F9   7E                     LD   A,(HL)   
03FA                          ;*Macro unroll:  PUTA
03FA   EF                     DS   1-CPM,0EFh   
03FB                          DS   CPM,0CDh   
03FB                          DS   CPM,APUT&0FFh   
03FB                          DS   CPM,APUT/256   
03FB   2C                     INC   L   
03FC   18 F7                  JR   ta1   
03FE   7D           TA2:      LD   A,L   
03FF   B9                     CP   C   
0400   C8                     RET   Z   
0401                          ;*Macro unroll:  PUTK    08h             ; backspace
0401   3E                     DS   1-CPM,3Eh   ; backspace
0402   08                     DS   1-CPM,08h   
0403   EF                     DS   1-CPM,0EFh   
0404                          DS   CPM,0CDh   
0404                          DS   CPM,APTK&0FFh   
0404                          DS   CPM,APTK/256   
0404                          DS   CPM,08h   
0404   2D                     DEC   L   
0405   18 F7                  JR   ta2   
0407                             ; ekey: wait for a key
0407   CD 06 FF     EKEY:     CALL   rawk   
040A   28 FB                  JR   Z,ekey   
040C   C9                     RET      
040D                             ; The command keys, and where each goes (after fin).
040D   0D           CMDS:     DB   13   
040E   55 04                  DW   cret   
0410   07                     DB   7   ; ^G
0411   9D 04                  DW   crun   
0413   0C                     DB   12   ; ^L
0414   AF 04                  DW   clist   
0416   05                     DB   5   ; ^E
0417   2B 04                  DW   cedln   
0419   12                     DB   18   ; ^R
041A   13 05                  DW   cread   
041C   17                     DB   23   ; ^W
041D   40 05                  DW   cwrite   
041F   0E                     DB   14   ; ^N
0420   25 04                  DW   cnew   
0422   18                     DB   24   ; ^X
0423   09 FF                  DW   LEAVE   
0425                NCMD:     EQU   8   
0425                             ; ^N: no program
0425   AF           CNEW:     XOR   A   
0426   32 00 83               LD   (PROG),A   
0429   18 6F        GED0:     JR   gedit   
042B                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
042B                             ; line it was: Return puts the text back in its place.
042B   CD 80 02     CEDLN:    CALL   rdnum   
042E   E5                     PUSH   HL   
042F   CD EF 04               CALL   find   ; HL -> the line, or the NUL if there is none
0432   D1                     POP   DE   
0433   7E                     LD   A,(HL)   
0434   B7                     OR   A   
0435   28 F2                  JR   Z,ged0   
0437   ED 53 3A 82            LD   (EDLN),DE   
043B   11 80 82               LD   DE,LINEBUF   
043E   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
043F   FE 0D                  CP   13   
0441   28 0D                  JR   Z,ce2   
0443   FE 0A                  CP   10   
0445   28 09                  JR   Z,ce2   
0447   12                     LD   (DE),A   
0448                          ;*Macro unroll:  PUTA
0448   EF                     DS   1-CPM,0EFh   
0449                          DS   CPM,0CDh   
0449                          DS   CPM,APUT&0FFh   
0449                          DS   CPM,APUT/256   
0449   23                     INC   HL   
044A   1C                     INC   E   
044B   7B                     LD   A,E   
044C   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
044E   20 EE                  JR   NZ,ce1   
0450   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
0451   5D                     LD   E,L   
0452   C3 81 03               JP   ed1   
0455                             ; Return. If ^E put a line here, the text goes back in its place. If not:
0455                             ; a number and text is a line to put in, a number alone a line to take out,
0455                             ; and anything else is run where it is.
0455   E5           CRET:     PUSH   HL   ; the end of what was typed
0456   2A 3A 82               LD   HL,(EDLN)   
0459   7C                     LD   A,H   
045A   B5                     OR   L   
045B   28 07                  JR   Z,cr1   
045D   E5                     PUSH   HL   
045E   CD DF 04               CALL   delln   
0461   E1                     POP   HL   
0462   18 13                  JR   ins   
0464   CD 80 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0467   79                     LD   A,C   ; C is still 80h if there was no number:
0468   87                     ADD   A,A   ;   only then is twice it 0
0469   28 36                  JR   Z,st0p   ; no number: run the line
046B   0A                     LD   A,(BC)   
046C   FE 0D                  CP   13   
046E   20 06                  JR   NZ,cr2   
0470   D1                     POP   DE   ; the number alone: take that line out
0471   CD DF 04               CALL   delln   
0474   18 24                  JR   gedit   
0476   03           CR2:      INC   BC   ; step over the one character after the number
0477                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0477                             ; CR and LF included, and copy it in.
0477   CD EF 04     INS:      CALL   find   ; HL -> where it goes
047A   D1                     POP   DE   ; the end of what was typed
047B   7B                     LD   A,E   
047C   91                     SUB   C   ; A = the length of the text, with its CR LF
047D   C5                     PUSH   BC   ; the text
047E   4F                     LD   C,A   
047F   06 00                  LD   B,0   
0481   C5                     PUSH   BC   ; its length
0482   54                     LD   D,H   
0483   5D                     LD   E,L   ; DE = where it goes
0484   AF                     XOR   A   
0485   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0486   ED B1                  CPIR      ; HL -> one past the program's NUL
0488   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
048A   44                     LD   B,H   
048B   4D                     LD   C,L   
048C   19                     ADD   HL,DE   
048D   2B                     DEC   HL   ; HL -> the NUL
048E   EB                     EX   DE,HL   
048F   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0490   E5                     PUSH   HL   
0491   19                     ADD   HL,DE   ; the NUL's new place
0492   EB                     EX   DE,HL   
0493   ED B8                  LDDR      ; move the rest of the program up
0495   C1                     POP   BC   ; the length
0496   D1                     POP   DE   ; where it goes
0497   E1                     POP   HL   ; the text
0498   ED B0                  LDIR      
049A   C3 70 03     GEDIT:    JP   edit   
049D                             ; ^G: run the program. st0p: run the typed line (BC -> it).
049D   01 00 83     CRUN:     LD   BC,PROG   
04A0   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
04A1   E1           ST0P:     POP   HL   ; (the end of what was typed)
04A2                             ; st0: start running at BC. The heap starts after the stored program's NUL.
04A2   21 00 83     ST0:      LD   HL,PROG   
04A5   AF                     XOR   A   
04A6   BE           ST1:      CP   (HL)   
04A7   23                     INC   HL   
04A8   20 FC                  JR   NZ,st1   
04AA   22 7C 82               LD   (HEAP),HL   
04AD                          ENDIF      
04AD                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
04AD                          ENDIF      
04AD                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
04AD                          ENDIF      
04AD                          IF   EDITOR   
04AD   E1                     POP   HL   ; TOS: the data stack is as the last line left it
04AE                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
04AE   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
04AF                          DS   CPM+FAST-CPM*FAST,0DDh   
04AF                          DS   CPM+FAST-CPM*FAST,0E9h   
04AF                             ; ^L: list from line n. DE = the number of the line at HL.
04AF   CD 80 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
04B2   7C                     LD   A,H   
04B3   B5                     OR   L   
04B4   20 01                  JR   NZ,li0   
04B6   2C                     INC   L   ;   then from line 1
04B7   E5           LI0:      PUSH   HL   
04B8   CD EF 04               CALL   find   
04BB   D1                     POP   DE   
04BC   7E           LI1:      LD   A,(HL)   
04BD   B7                     OR   A   
04BE   28 DA                  JR   Z,gedit   ; the end of the text
04C0   CD 06 FF               CALL   rawk   
04C3   28 09                  JR   Z,li3   ; no key: carry on
04C5   FE 03                  CP   3   
04C7   C4 07 04               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
04CA   FE 03                  CP   3   
04CC   28 CC                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
04CE   E5           LI3:      PUSH   HL   
04CF   D5                     PUSH   DE   
04D0   EB                     EX   DE,HL   
04D1   CD DD 02               CALL   pdec   ; the line's number,
04D4   3E 20                  LD   A," "   
04D6                          ;*Macro unroll:  PUTA                    ;   a space,
04D6   EF                     DS   1-CPM,0EFh   ;   a space,
04D7                          DS   CPM,0CDh   
04D7                          DS   CPM,APUT&0FFh   
04D7                          DS   CPM,APUT/256   
04D7   D1                     POP   DE   
04D8   E1                     POP   HL   
04D9   13                     INC   DE   
04DA   CD 07 05               CALL   prl   ;   and the line
04DD   18 DD                  JR   li1   
04DF                             ; delln: take line n (in HL) out: copy everything after it down over it.
04DF   CD EF 04     DELLN:    CALL   find   
04E2   54                     LD   D,H   
04E3   5D                     LD   E,L   
04E4   CD FD 04               CALL   nxl   ; HL -> the next line
04E7   7E           DE1:      LD   A,(HL)   
04E8   12                     LD   (DE),A   
04E9   23                     INC   HL   
04EA   13                     INC   DE   
04EB   B7                     OR   A   
04EC   20 F9                  JR   NZ,de1   
04EE   C9                     RET      
04EF                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
04EF                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
04EF   EB           FIND:     EX   DE,HL   
04F0   21 00 83               LD   HL,PROG   
04F3   1B           FI1:      DEC   DE   
04F4   7A                     LD   A,D   
04F5   B3                     OR   E   
04F6   C8                     RET   Z   
04F7   CD FD 04               CALL   nxl   
04FA   20 F7                  JR   NZ,fi1   
04FC   C9                     RET      
04FD                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
04FD                             ; stop at the NUL that ends the text (and return zero).
04FD   7E           NXL:      LD   A,(HL)   
04FE   B7                     OR   A   
04FF   C8                     RET   Z   
0500   23                     INC   HL   
0501   FE 0A                  CP   10   
0503   20 F8                  JR   NZ,nxl   
0505   B7                     OR   A   
0506   C9                     RET      
0507                             ; prl: print the line at HL, to its LF; HL -> just past it.
0507   7E           PRL:      LD   A,(HL)   
0508                          ;*Macro unroll:  PUTA
0508   EF                     DS   1-CPM,0EFh   
0509                          DS   CPM,0CDh   
0509                          DS   CPM,APUT&0FFh   
0509                          DS   CPM,APUT/256   
0509   7E                     LD   A,(HL)   
050A   23                     INC   HL   
050B   FE 0A                  CP   10   
050D   20 F8                  JR   NZ,prl   
050F   C9                     RET      
0510                          ENDIF      
0510                          IF   EDGEN   
0510   C3 70 03     GED1:     JP   edit   
0513                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
0513                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
0513                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
0513                             ; line with no end is given one. Nothing is echoed, and there is no check
0513                             ; for running out of memory.
0513   21 FF 82     CREAD:    LD   HL,PROG-1   
0516   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
0518   23                     INC   HL   ;   the line buffer's last, and spare)
0519   CD 07 04     RD1:      CALL   ekey   
051C   4F                     LD   C,A   
051D   FE 1A                  CP   1Ah   
051F   20 02                  JR   NZ,rd2   
0521   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
0523   FE 0A        RD2:      CP   10   
0525   20 07                  JR   NZ,rd3   
0527   2B                     DEC   HL   
0528   BE                     CP   (HL)   
0529   23                     INC   HL   
052A   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
052C   3E 0D                  LD   A,13   ; anywhere else it ends the line
052E   77           RD3:      LD   (HL),A   
052F   23                     INC   HL   
0530   FE 0D                  CP   13   
0532   20 03                  JR   NZ,rd4   
0534   36 0A                  LD   (HL),10   ; after a CR goes a LF
0536   23                     INC   HL   
0537   79           RD4:      LD   A,C   
0538   FE 1A                  CP   1Ah   
053A   20 DD                  JR   NZ,rd1   
053C   36 00                  LD   (HL),0   
053E   18 D0                  JR   ged1   
0540                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
0540   21 00 83     CWRITE:   LD   HL,PROG   
0543   7E           CW1:      LD   A,(HL)   
0544   B7                     OR   A   
0545   28 C9                  JR   Z,ged1   
0547                          ;*Macro unroll:  PUTA
0547   EF                     DS   1-CPM,0EFh   
0548                          DS   CPM,0CDh   
0548                          DS   CPM,APUT&0FFh   
0548                          DS   CPM,APUT/256   
0548   23                     INC   HL   
0549   18 F8                  JR   cw1   
054B                          ENDIF      
054B                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
054B                          ENDIF      
054B                             ; =============================================================================
054B                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
054B                          ENDIF      
054B                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
054B                          ENDIF      
054B                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
054B                          ENDIF      
054B                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
054B                          ENDIF      
054B                          IF   CPM*(1-EDITOR)   
                              JP   st2   
054B                          ENDIF      
054B                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
