0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        "/" leaves ( r q ), the quotient on top; dividing by zero is not
0000                             ;        checked. -n? does no more editing than Backspace.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  Two switches, set in the EQU lines below:
0000                             ;    ZPSTACK  0 = the data stack is in pages 2 and 3: 252 cells
0000                             ;             1 = the data stack is in zero page: 112 cells, and a smaller
0000                             ;                 interpreter, because every stack access is a byte shorter.
0000                             ;                 The memory map and the machine-code contract differ: see
0000                             ;                 below.
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                ZPSTACK:   EQU   0   ; 1 = data stack in zero page
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X, or $10,X and $80,X when the stack is in zero page.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above; with ZPSTACK = 1 also the data
0000                             ;               stack: low bytes at 10-7F, high bytes at 80-EF (X = 70 when
0000                             ;               empty: 112 cells)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       with ZPSTACK = 0: DSL, data stack, low bytes (X = FC when
0000                             ;    0300       empty: 252 cells) and DSH, high bytes. With ZPSTACK = 1 these
0000                             ;               two pages are not used.
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C
0000                             ;               (= z10+), KEYBUF at +34, the -n? line buffer at +80..+FF
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   ZPSTACK   
                    DSL:      EQU   10h   ; data stack, low bytes
                    DSH:      EQU   80h   ; data stack, high bytes
                    DSE:      EQU   70h   ; X when the data stack is empty
0000                          ENDIF      
0000                          IFN   ZPSTACK   
0000                DSL:      EQU   0200h   
0000                DSH:      EQU   0300h   
0000                DSE:      EQU   0FCh   
0000                          ENDIF      
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003   20 9A E1               JSR   rstip   
E006   20 8E E1     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B                          IF   CHECKED   
E00B   8D 34 04               STA   KEYBUF   ; (A = 0) no key held back
E00E                          ENDIF      
E00E   A5 00                  LDA   IP   
E010   8D 7C 04               STA   HEAP   
E013   A5 01                  LDA   IP+1   
E015   8D 7D 04               STA   HEAP+1   
E018   20 9A E1               JSR   rstip   
E01B   A2 FC                  LDX   #DSE   
E01D                             ; =============================================================================
E01D                             ;  The inner loop
E01D                             ; =============================================================================
E01D                NEXT:        
E01D                          IF   CHECKED   
E01D                             ; Both stacks are checked once per character. The data stack has
E01D                             ; overrun when X is above DSE (an overflow wraps X to FF, an underflow
E01D                             ; moves it up; no handler moves X by more than 2). The return stack
E01D                             ; has when S is below RSLIM (an underflow wraps S to 00-03).
E01D   E0 FD                  CPX   #DSE+1   
E01F   B0 4B                  BCS   e_stack   
E021   8A                     TXA      ; TSX trashes X: keep it in A
E022   BA                     TSX      
E023   E0 20                  CPX   #RSLIM   
E025   AA                     TAX      ; TAX leaves the carry alone
E026   90 47                  BCC   e_rstack   
E028                          ENDIF      
E028   20 2E E0               JSR   step   
E02B   4C 1D E0               JMP   next   
E02E                             ; step: read one character and sort it by range.
E02E                             ;    00h          end of program
E02E                             ;    01h-20h, 7Fh-FFh   ignored
E02E                             ;    30h-39h      digit: read a whole number
E02E                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E02E                             ;    61h-7Ah      a-z: push the address of that letter's cell
E02E                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E02E                             ; Every way out of the sort has the carry clear, except "ignored".
E02E   20 8E E1     STEP:     JSR   getc   ; flags follow A
E031   F0 36                  BEQ   endprog   
E033   38                     SEC      
E034   E9 21                  SBC   #21h   ; A = c - 21h
E036   90 30                  BCC   ign   ; 01h-20h
E038   C9 0F                  CMP   #0Fh   
E03A   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E03C   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E03E   C9 0A                  CMP   #10   
E040   90 32                  BCC   digit   
E042   C9 11                  CMP   #11h   
E044   90 16                  BCC   p3a   ; 3Ah-40h
E046   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E048   C9 1A                  CMP   #1Ah   
E04A   90 5D                  BCC   upper   ; 41h-5Ah
E04C   C9 20                  CMP   #20h   
E04E   90 0A                  BCC   p5b   ; 5Bh-60h
E050   C9 3A                  CMP   #3Ah   
E052   90 2D                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E054   C9 3E                  CMP   #3Eh   
E056   B0 10                  BCS   ign   ; 7Fh-FFh
E058                             ; The three adjustments below chain. Each ADC adds the carry the one
E058                             ; before it left, which the constants allow for.
E058   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E05A   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E05C   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E05E   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E05F   A8                     TAY      
E060   B9 14 E1               LDA   PTAB+1,Y   
E063   48                     PHA      
E064   B9 13 E1               LDA   PTAB,Y   
E067   48                     PHA      
E068   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E069                             ; directly, it just ends an ignored character.
E069   4C 09 FF     ENDPROG:   JMP   EXIT   
E06C                          IF   CHECKED   
E06C   A9 53        E_STACK:   LDA   #"S"   ; data stack over or under
E06E   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E06F   A9 52        E_RSTACK:   LDA   #"R"   ; return stack over or under
E071   4C BD E4               JMP   error   
E074                          ENDIF      
E074                             ; Digits: the first one is in A; read the rest of the number.
E074   A8           DIGIT:    TAY      
E075   20 AF E1               JSR   push   
E078   84 02                  STY   TL   
E07A   A9 00                  LDA   #0   
E07C   85 03                  STA   TH   
E07E   4C 7A E1               JMP   rdnum   
E081                             ; a-z: push the cell's address (the cell is the variable)
E081   0A           LOWER:    ASL      
E082   A8                     TAY      
E083   20 AF E1               JSR   push   
E086   84 02                  STY   TL   
E088   A9 04                  LDA   #>LET   
E08A   85 03                  STA   TH   
E08C   60                     RTS      
E08D                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E08D                             ; the matching ")".
E08D   20 BB E1     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E090   F0 3F                  BEQ   skip   
E092                             ; pushn: take the step frame off, push the reading position on the return
E092                             ; stack, and go on. With the carry set (a word call) the reading position
E092                             ; then becomes the address in the letter cell at LET,Y.
E092   68           PUSHN:    PLA      
E093   68                     PLA      ; drop the step frame
E094   A5 01                  LDA   IP+1   
E096   48                     PHA      
E097   A5 00                  LDA   IP   
E099   48                     PHA      
E09A   90 0A                  BCC   nxt   
E09C   B9 00 04               LDA   LET,Y   
E09F   85 00                  STA   IP   
E0A1   B9 01 04               LDA   LET+1,Y   
E0A4   85 01                  STA   IP+1   
E0A6   4C 1D E0     NXT:      JMP   next   
E0A9                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E0A9                             ; the return stack, and the IP becomes the address in the letter's cell.
E0A9   0A           UPPER:    ASL      
E0AA   A8                     TAY      
E0AB   38                     SEC      
E0AC   B0 E4                  BCS   pushn   ; always
E0AE                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E0AE                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E0AE                             ; the body"s address instead. Either way it then skips to the matching "]'.
E0AE                             ; (The unchecked build takes anything below "A" as the space, and anything
E0AE                             ; from "A" up as a letter.)
E0AE   20 8E E1     H_DEF:    JSR   getc   
E0B1                          IF   CHECKED   
E0B1   C9 20                  CMP   #" "   
E0B3   F0 19                  BEQ   def2   
E0B5                          ENDIF      
E0B5   38                     SEC      
E0B6   E9 41                  SBC   #"A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
E0B8                          IF   1-CHECKED   
                              BCC   def2   
E0B8                          ENDIF      
E0B8                          IF   CHECKED   
E0B8   A8                     TAY      
E0B9   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E0BB   C9 1A                  CMP   #26   
E0BD   B0 3B                  BCS   e_brack   ; anything but a letter or a space
E0BF   98                     TYA      
E0C0                          ENDIF      
E0C0   0A                     ASL      
E0C1   A8                     TAY      ; Y -> the cell
E0C2   A5 00                  LDA   IP   
E0C4   99 00 04               STA   LET,Y   
E0C7   A5 01                  LDA   IP+1   
E0C9   99 01 04               STA   LET+1,Y   
E0CC   D0 03                  BNE   skip   ; always: no program is in page zero
E0CE   20 A3 E1     DEF2:     JSR   puship   ; an anonymous block: push its address
E0D1                             ; skip: read past text to the closer at this level, and return it in A.
E0D1                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0D1                             ; NUL first ends the program.
E0D1   A9 00        SKIP:     LDA   #0   
E0D3   85 06                  STA   T2   ; depth
E0D5   20 8E E1     SK1:      JSR   getc   
E0D8   F0 8F                  BEQ   endprog   
E0DA   C9 22                  CMP   #22h   
E0DC   D0 03                  BNE   sk2   
E0DE   20 02 E1               JSR   skipstr   ; leaves A = 22h, which matches nothing below
E0E1   C9 28        SK2:      CMP   #"("   
E0E3   F0 11                  BEQ   sk3   
E0E5   C9 5B                  CMP   #"["   
E0E7   F0 0D                  BEQ   sk3   
E0E9   C9 29                  CMP   #")"   
E0EB   F0 04                  BEQ   sk4   
E0ED   C9 5D                  CMP   #"]"   
E0EF   D0 E4                  BNE   sk1   
E0F1   C6 06        SK4:      DEC   T2   
E0F3   10 E0                  BPL   sk1   
E0F5   60                     RTS      ; the closer at this level
E0F6   E6 06        SK3:      INC   T2   
E0F8   D0 DB                  BNE   sk1   
E0FA                          IF   CHECKED   
E0FA   A9 44        E_BRACK:   LDA   #"D"   ; bad character after [
E0FC   4C BD E4               JMP   error   
E0FF                          ENDIF      
E0FF                             ; 22h pushes the address of the text after it and skips the string.
E0FF   20 A3 E1     H_STR:    JSR   puship   
E102                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E102                             ; the next character, so "/"" does not end it. Returns with Z set, A = 22h.
E102   20 8E E1     SKIPSTR:   JSR   getc   
E105   C9 2F                  CMP   #"/"   
E107   F0 05                  BEQ   ss0   
E109   C9 22                  CMP   #22h   
E10B   D0 F5                  BNE   skipstr   
E10D   60                     RTS      
E10E   20 91 E1     SS0:      JSR   incip   
E111   D0 EF                  BNE   skipstr   ; A is "/" here
E113                             ; =============================================================================
E113                             ;  Dispatch table: one handler per punctuation character, in code order.
E113                             ;  Entries are handler-1 for the RTS trick.
E113                             ; =============================================================================
E113   C3 E1        PTAB:     DW   h_store-1   ; !
E115   FE E0                  DW   h_str-1   ; "
E117   B0 E3                  DW   h_num-1   ; #
E119   92 E3                  DW   h_print-1   ; $
E11B   E1 E2                  DW   h_swap-1   ; %
E11D   36 E2                  DW   h_and-1   ; &
E11F   A8 E3                  DW   h_emit-1   ; '
E121   8C E0                  DW   h_open-1   ; (
E123   09 E2                  DW   h_close-1   ; )
E125   B9 E2                  DW   h_mul-1   ; *
E127   68 E2                  DW   h_add-1   ; +
E129   EB E3                  DW   h_cfetch-1   ; ,
E12B   60 E2                  DW   h_sub-1   ; -
E12D   D5 E1                  DW   h_cstore-1   ; .
E12F   F6 E2                  DW   h_div-1   ; /
E131   AE E1                  DW   push-1   ; :
E133   E2 E1                  DW   drop-1   ; ;
E135   97 E2                  DW   h_lt-1   ; <
E137   A9 E2                  DW   h_eq-1   ; =
E139   94 E2                  DW   h_gt-1   ; >
E13B   F4 E3                  DW   h_key-1   ; ?
E13D   DF E3                  DW   h_fetch-1   ; @
E13F   AD E0                  DW   h_def-1   ; [
E141   23 E2                  DW   h_break-1   ; \
E143   0F E2                  DW   h_ret-1   ; ]
E145   52 E2                  DW   h_xor-1   ; ^
E147   59 E3                  DW   h_alloc-1   ; _
E149   4B E4                  DW   h_grave-1   ; `
E14B   EE E1                  DW   h_tor-1   ; {
E14D   44 E2                  DW   h_or-1   ; |
E14F   FB E1                  DW   h_fromr-1   ; }
E151   80 E2                  DW   h_not-1   ; ~
E153                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E153                             ; test is at the bottom so the loop closes with a branch. Returns with the
E153                             ; carry set.
E153   20 91 E1     RD1:      JSR   incip   ; (keeps A = the digit)
E156   06 02                  ASL   TL   
E158   26 03                  ROL   TH   ; x2
E15A   18                     CLC      
E15B   65 02                  ADC   TL   
E15D   85 04                  STA   T0   
E15F   A5 03                  LDA   TH   
E161   69 00                  ADC   #0   
E163   85 05                  STA   T1   ; T = x2 + digit
E165   06 02                  ASL   TL   
E167   26 03                  ROL   TH   
E169   06 02                  ASL   TL   
E16B   26 03                  ROL   TH   ; x8
E16D   18                     CLC      
E16E   A5 02                  LDA   TL   
E170   65 04                  ADC   T0   
E172   85 02                  STA   TL   
E174   A5 03                  LDA   TH   
E176   65 05                  ADC   T1   
E178   85 03                  STA   TH   ; x8 + x2 + digit
E17A   20 80 E1     RDNUM:    JSR   isdig   
E17D   90 D4                  BCC   rd1   
E17F   60                     RTS      
E180                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E180                             ; digit. Y = 0.
E180   20 89 E1     ISDIG:    JSR   peek   
E183   38                     SEC      
E184   E9 30                  SBC   #"0"   
E186   C9 0A                  CMP   #10   
E188   60                     RTS      
E189                             ; =============================================================================
E189                             ;  Reading the program
E189                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E189                             ;    getc: the same, then IP moves on; flags follow A
E189                             ;    incip: IP moves on; keeps A, the carry and Y
E189                             ; =============================================================================
E189   A0 00        PEEK:     LDY   #0   
E18B   B1 00                  LDA   (IP),Y   
E18D   60                     RTS      
E18E   20 89 E1     GETC:     JSR   peek   
E191   E6 00        INCIP:    INC   IP   
E193   D0 02                  BNE   ic1   
E195   E6 01                  INC   IP+1   
E197   09 00        IC1:      ORA   #0   
E199   60                     RTS      
E19A                             ; rstip: point IP at the start of the program
E19A   A9 00        RSTIP:    LDA   #<PROG   
E19C   85 00                  STA   IP   
E19E   A9 05                  LDA   #>PROG   
E1A0   85 01                  STA   IP+1   
E1A2   60                     RTS      
E1A3                             ; =============================================================================
E1A3                             ;  Stack
E1A3                             ; =============================================================================
E1A3   20 AF E1     PUSHIP:   JSR   push   ; push the reading position
E1A6   A5 00                  LDA   IP   
E1A8   85 02                  STA   TL   
E1AA   A5 01                  LDA   IP+1   
E1AC   85 03                  STA   TH   
E1AE   60                     RTS      
E1AF   CA           PUSH:     DEX      ; ":" and every push
E1B0   A5 02                  LDA   TL   
E1B2   9D 00 02               STA   DSL,X   
E1B5   A5 03                  LDA   TH   
E1B7   9D 00 03               STA   DSH,X   
E1BA   60                     RTS      
E1BB                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E1BB   A5 02        FLAG:     LDA   TL   
E1BD   05 03                  ORA   TH   
E1BF   20 E3 E1               JSR   drop   
E1C2   A8                     TAY      ; (drop's INX changed the flags)
E1C3   60                     RTS      
E1C4                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E1C4                H_STORE:      
E1C4                          IF   CHECKED   
E1C4   A5 02                  LDA   TL   ; both bytes must be in the program's space:
E1C6   69 01                  ADC   #1   ; check the page of addr+1 (the carry is
E1C8   A5 03                  LDA   TH   ; clear on the way in)
E1CA   69 00                  ADC   #0   
E1CC   20 7F E3               JSR   chkst   
E1CF                          ENDIF      
E1CF   BD 00 03               LDA   DSH,X   
E1D2   A0 01                  LDY   #1   
E1D4   91 02                  STA   (TL),Y   
E1D6                H_CSTORE:      ; "." ( c addr -- )
E1D6                          IF   CHECKED   
E1D6   A5 03                  LDA   TH   
E1D8   20 7F E3               JSR   chkst   
E1DB                          ENDIF      
E1DB   BD 00 02               LDA   DSL,X   
E1DE   A0 00                  LDY   #0   
E1E0   91 02                  STA   (TL),Y   
E1E2   E8                     INX      ; falls into drop
E1E3                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E1E3                             ; it returns with Z clear.
E1E3   BC 00 02     DROP:     LDY   DSL,X   
E1E6   84 02                  STY   TL   
E1E8   BC 00 03               LDY   DSH,X   
E1EB   84 03                  STY   TH   
E1ED   E8                     INX      
E1EE   60                     RTS      
E1EF                             ; "{" TOS to the return stack, "}" return stack to TOS
E1EF   68           H_TOR:    PLA      
E1F0   68                     PLA      
E1F1   A5 03                  LDA   TH   
E1F3   48                     PHA      
E1F4   A5 02                  LDA   TL   
E1F6   48                     PHA      
E1F7   20 E3 E1               JSR   drop   
E1FA   D0 0B                  BNE   nxt2   ; always
E1FC   68           H_FROMR:   PLA      
E1FD   68                     PLA      
E1FE   20 AF E1               JSR   push   
E201   68                     PLA      
E202   85 02                  STA   TL   
E204   68                     PLA      
E205   85 03                  STA   TH   
E207   4C 1D E0     NXT2:     JMP   next   
E20A                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E20A                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E20A                             ; it is here, the address popped is pushed back.
E20A   20 BB E1     H_CLOSE:   JSR   flag   
E20D   F0 21                  BEQ   rdrop   
E20F   24                     DB   24h   ; (BIT zp: steps over the SEC)
E210                             ; "]" returns: pull an address and jump to it.
E210   38           H_RET:    SEC      
E211                          IF   CHECKED   
E211   20 AC E4               JSR   chkbrk   ; Ctrl-C is checked at every loop-back and
E214                          ENDIF      ;   every word return (it keeps the carry)
E214   68                     PLA      
E215   68                     PLA      ; drop the step frame
E216   68                     PLA      
E217   85 00                  STA   IP   
E219   68                     PLA      
E21A   85 01                  STA   IP+1   
E21C   B0 E9                  BCS   nxt2   
E21E   48                     PHA      ; ")": keep the block start
E21F   A5 00                  LDA   IP   
E221   48                     PHA      
E222   90 E3                  BCC   nxt2   ; always
E224                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E224                             ; drops the block start, "]" returns.
E224   20 BB E1     H_BREAK:   JSR   flag   
E227   F0 6B                  BEQ   ab9   
E229   20 D1 E0               JSR   skip   
E22C   C9 29                  CMP   #")"   
E22E   D0 E0                  BNE   h_ret   
E230   68           RDROP:    PLA      
E231   68                     PLA      
E232   68                     PLA      
E233   68                     PLA      
E234   4C 1D E0               JMP   next   
E237                             ; =============================================================================
E237                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E237                             ; =============================================================================
E237                             ; The logic operators leave the carry as they found it, clear, so they can
E237                             ; branch to fin.
E237   BD 00 02     H_AND:    LDA   DSL,X   
E23A   25 02                  AND   TL   
E23C   85 02                  STA   TL   
E23E   BD 00 03               LDA   DSH,X   
E241   25 03                  AND   TH   
E243   90 31                  BCC   fin   ; always
E245   BD 00 02     H_OR:     LDA   DSL,X   
E248   05 02                  ORA   TL   
E24A   85 02                  STA   TL   
E24C   BD 00 03               LDA   DSH,X   
E24F   05 03                  ORA   TH   
E251   90 23                  BCC   fin   ; always
E253   BD 00 02     H_XOR:    LDA   DSL,X   
E256   45 02                  EOR   TL   
E258   85 02                  STA   TL   
E25A   BD 00 03               LDA   DSH,X   
E25D   45 03                  EOR   TH   
E25F   90 15                  BCC   fin   ; always
E261                             ; "-" has two jobs: directly before a digit it starts a negative number.
E261   20 80 E1     H_SUB:    JSR   isdig   
E264   90 14                  BCC   negnum   
E266   20 87 E2     SUB1:     JSR   neg   ; a - b = a + (-b)
E269   18           H_ADD:    CLC      
E26A   BD 00 02               LDA   DSL,X   
E26D   65 02                  ADC   TL   
E26F   85 02                  STA   TL   
E271   BD 00 03               LDA   DSH,X   
E274   65 03                  ADC   TH   ; falls into fin
E276                             ; fin: finish a two-operand op: A = the high byte of the result
E276   85 03        FIN:      STA   TH   
E278   E8                     INX      
E279   60                     RTS      
E27A   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E27C   20 74 E0               JSR   digit   ; (comes back with the carry set)
E27F   B0 06                  BCS   neg   ; always: the number, negated
E281                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E281   90 05        H_NOT:    BCC   neg1   ; always
E283                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E283   A5 03        ABSV:     LDA   TH   
E285   10 0D        NEGM:     BPL   ab9   
E287                             ; neg: TOS = -TOS
E287   38           NEG:      SEC      
E288   A9 00        NEG1:     LDA   #0   
E28A   E5 02                  SBC   TL   
E28C   85 02                  STA   TL   
E28E   A9 00                  LDA   #0   
E290   E5 03                  SBC   TH   
E292   85 03                  STA   TH   
E294   60           AB9:      RTS      
E295                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E295                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E295   20 E2 E2     H_GT:     JSR   h_swap   ; a > b is b < a
E298   BD 00 02     H_LT:     LDA   DSL,X   
E29B   C5 02                  CMP   TL   
E29D   BD 00 03               LDA   DSH,X   
E2A0   E5 03                  SBC   TH   
E2A2   70 02                  BVS   lt1   
E2A4   49 80                  EOR   #80h   
E2A6   0A           LT1:      ASL      
E2A7   E8                     INX      ; (keeps the carry; never leaves X at 0)
E2A8   D0 07                  BNE   bool   ; always
E2AA   20 66 E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E2AD   05 02                  ORA   TL   
E2AF   C9 01                  CMP   #1   ; carry clear if A = 0
E2B1   A9 00        BOOL:     LDA   #0   
E2B3   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E2B5   85 02                  STA   TL   
E2B7   85 03                  STA   TH   
E2B9   60                     RTS      
E2BA                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E2BA                             ; bottom while the product comes in at the top, through A:T0 above it; after
E2BA                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E2BA   A0 10        H_MUL:    LDY   #16   
E2BC   84 05                  STY   T1   ; the round count
E2BE   A9 00                  LDA   #0   
E2C0   85 04                  STA   T0   ; A:T0 = the upper half
E2C2   46 03                  LSR   TH   
E2C4   66 02                  ROR   TL   ; the first multiplier bit
E2C6   90 0D        ML1:      BCC   ml2   
E2C8   A8                     TAY      
E2C9   18                     CLC      
E2CA   A5 04                  LDA   T0   
E2CC   7D 00 02               ADC   DSL,X   
E2CF   85 04                  STA   T0   
E2D1   98                     TYA      
E2D2   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E2D5   6A           ML2:      ROR      
E2D6   66 04                  ROR   T0   
E2D8   66 03                  ROR   TH   
E2DA   66 02                  ROR   TL   ; everything one place right; next bit out
E2DC   C6 05                  DEC   T1   
E2DE   D0 E6                  BNE   ml1   
E2E0   E8                     INX      ; drop the multiplicand
E2E1   60                     RTS      
E2E2   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E2E5   A5 02                  LDA   TL   
E2E7   9D 00 02               STA   DSL,X   
E2EA   84 02                  STY   TL   
E2EC   BC 00 03               LDY   DSH,X   
E2EF   A5 03                  LDA   TH   
E2F1   9D 00 03               STA   DSH,X   
E2F4   84 03                  STY   TH   
E2F6   60                     RTS      
E2F7                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
E2F7                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E2F7                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
E2F7   BD 00 03     H_DIV:    LDA   DSH,X   
E2FA   48                     PHA      ; a's sign: for r
E2FB   45 03                  EOR   TH   
E2FD   48                     PHA      ; a xor b: for q
E2FE   20 83 E2               JSR   absv   
E301   A5 02                  LDA   TL   
E303   85 08                  STA   D0   
E305   A5 03                  LDA   TH   
E307   85 09                  STA   D1   ; D = |b|
E309   BD 00 02               LDA   DSL,X   
E30C   85 02                  STA   TL   
E30E   BD 00 03               LDA   DSH,X   
E311   85 03                  STA   TH   
E313   20 83 E2               JSR   absv   ; TOS = |a|
E316   20 29 E3               JSR   udiv   ; TOS = q, NOS = r
E319   68                     PLA      
E31A   20 85 E2               JSR   negm   ; q's sign
E31D   68                     PLA      
E31E   10 39                  BPL   ud9   ; r's sign:
E320   20 E2 E2               JSR   h_swap   ;   bring r up,
E323   20 87 E2               JSR   neg   ;   negate it,
E326   4C E2 E2               JMP   h_swap   ;   and put it back
E329                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E329                             ; cell the remainder (whatever was there is lost).
E329   A9 00        UDIV:     LDA   #0   
E32B   9D 00 02               STA   DSL,X   
E32E   9D 00 03               STA   DSH,X   
E331   A0 10                  LDY   #16   
E333   06 02        UD1:      ASL   TL   
E335   26 03                  ROL   TH   
E337   3E 00 02               ROL   DSL,X   
E33A   3E 00 03               ROL   DSH,X   
E33D   38                     SEC      
E33E   BD 00 02               LDA   DSL,X   
E341   E5 08                  SBC   D0   
E343   85 04                  STA   T0   
E345   BD 00 03               LDA   DSH,X   
E348   E5 09                  SBC   D1   
E34A   90 0A                  BCC   ud2   
E34C   9D 00 03               STA   DSH,X   
E34F   A5 04                  LDA   T0   
E351   9D 00 02               STA   DSL,X   
E354   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E356   88           UD2:      DEY      
E357   D0 DA                  BNE   ud1   
E359   60           UD9:      RTS      
E35A                             ; =============================================================================
E35A                             ;  Storage
E35A                             ; =============================================================================
E35A                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
E35A                             ; (The carry is clear on the way in.)
E35A   AD 7C 04     H_ALLOC:   LDA   HEAP   
E35D   A8                     TAY      
E35E   65 02                  ADC   TL   
E360   8D 7C 04               STA   HEAP   
E363   84 02                  STY   TL   
E365   AD 7D 04               LDA   HEAP+1   
E368   A8                     TAY      
E369   65 03                  ADC   TH   
E36B                          IF   CHECKED   
E36B   B0 0A                  BCS   e_heap   ; a negative count wraps: too big
E36D   C9 E0                  CMP   #HEAPLIM   
E36F   B0 06                  BCS   e_heap   ; the new top must stay below the limit page
E371                          ENDIF      
E371   8D 7D 04               STA   HEAP+1   
E374   84 03                  STY   TH   
E376   60                     RTS      
E377                          IF   CHECKED   
E377   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit
E379   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E37A   A9 57        E_STORE:   LDA   #"W"   ; write outside the program's space
E37C   4C BD E4               JMP   error   
E37F                             ; chkst: stop unless the page in A is in the program's own space, from the
E37F                             ; letter page up to the heap limit. Keeps Y.
E37F   C9 04        CHKST:    CMP   #LETPAGE   
E381   90 F7                  BCC   e_store   
E383   C9 E0                  CMP   #HEAPLIM   
E385   B0 F3                  BCS   e_store   
E387   60                     RTS      
E388                          ENDIF      
E388                             ; =============================================================================
E388                             ;  Console
E388                             ; =============================================================================
E388                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E388   A0 00        TOSGET:   LDY   #0   
E38A   B1 02                  LDA   (TL),Y   
E38C   E6 02        INCTOS:   INC   TL   
E38E   D0 02                  BNE   tg1   
E390   E6 03                  INC   TH   
E392   60           TG1:      RTS      
E393                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E393                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E393                             ; bit 6, so // and /" give themselves).
E393   20 88 E3     H_PRINT:   JSR   tosget   
E396   C9 22                  CMP   #22h   
E398   F0 14                  BEQ   pdrop   
E39A   C9 2F                  CMP   #"/"   
E39C   D0 05                  BNE   pr1   
E39E   20 88 E3               JSR   tosget   
E3A1   29 BF                  AND   #0BFh   
E3A3   20 03 FF     PR1:      JSR   CONOUT   
E3A6   4C 93 E3               JMP   h_print   
E3A9   A5 02        H_EMIT:   LDA   TL   ; "'"
E3AB   20 03 FF               JSR   CONOUT   
E3AE   4C E3 E1     PDROP:    JMP   drop   
E3B1                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E3B1                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E3B1                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E3B1   A5 03        H_NUM:    LDA   TH   
E3B3   10 08                  BPL   pn1   
E3B5   A9 2D                  LDA   #"-"   
E3B7   20 03 FF               JSR   CONOUT   
E3BA   20 87 E2               JSR   neg   
E3BD   CA           PN1:      DEX      ; the spare cell
E3BE   A9 0A                  LDA   #10   
E3C0   85 08                  STA   D0   
E3C2   A9 00                  LDA   #0   
E3C4   85 09                  STA   D1   
E3C6   48                     PHA      ; the end marker
E3C7   20 29 E3     PN2:      JSR   udiv   
E3CA   BD 00 02               LDA   DSL,X   
E3CD   09 30                  ORA   #"0"   
E3CF   48                     PHA      
E3D0   A5 02                  LDA   TL   
E3D2   05 03                  ORA   TH   
E3D4   D0 F1                  BNE   pn2   
E3D6   E8                     INX      
E3D7   68           PN3:      PLA      
E3D8   F0 D4                  BEQ   pdrop   
E3DA   20 03 FF               JSR   CONOUT   
E3DD   4C D7 E3               JMP   pn3   
E3E0   A0 01        H_FETCH:   LDY   #1   ; "@"
E3E2   B1 02                  LDA   (TL),Y   
E3E4   48                     PHA      ; the high byte, while "," gets the low one
E3E5   20 EC E3               JSR   h_cfetch   
E3E8   68                     PLA      
E3E9   85 03                  STA   TH   
E3EB   60                     RTS      
E3EC                H_CFETCH:      ; ","
E3EC   A0 00                  LDY   #0   
E3EE   B1 02                  LDA   (TL),Y   
E3F0   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E3F2   84 03                  STY   TH   
E3F4   60                     RTS      
E3F5                             ; "?" ( n -- c ) or ( -n -- addr )
E3F5                             ;   n > 0: wait about n ms for a key; 0 if none came
E3F5                             ;   n = 0: wait for a key
E3F5                             ;   n < 0: read a line of at most -n characters, with echo. n is not
E3F5                             ;          checked: the buffer holds 127 characters and the CR, so a
E3F5                             ;          program must ask for 127 or fewer.
E3F5   A5 03        H_KEY:    LDA   TH   
E3F7   30 20                  BMI   line   
E3F9   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E3FB   20 9C E4     KT2:      JSR   getk   
E3FE   D0 15                  BNE   kt3   
E400   88                     DEY      
E401   D0 F8                  BNE   kt2   
E403   A5 02                  LDA   TL   ; count the millisecond off:
E405   D0 06                  BNE   kt4   
E407   A5 03                  LDA   TH   
E409   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E40B   C6 03                  DEC   TH   
E40D   C6 02        KT4:      DEC   TL   
E40F   D0 E8                  BNE   kt1   
E411   A5 03                  LDA   TH   
E413   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E415   A0 00        KT3:      LDY   #0   
E417   F0 D7                  BEQ   cf2   ; always: TOS = A
E419                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E419                             ; (stored, not echoed), every other key is stored and echoed until the line
E419                             ; is full. Y = the length so far; TL = the most allowed.
E419   20 87 E2     LINE:     JSR   neg   ; TL = the count
E41C   A0 00                  LDY   #0   
E41E   F0 03                  BEQ   ln2   ; always
E420   20 03 FF     LN3:      JSR   CONOUT   
E423   20 9C E4     LN2:      JSR   getk   
E426   F0 FB                  BEQ   ln2   
E428   C9 0D                  CMP   #13   
E42A   F0 14                  BEQ   ln5   
E42C   C9 08                  CMP   #8   
E42E   F0 0A                  BEQ   ln4   
E430   C4 02                  CPY   TL   
E432   B0 EF                  BCS   ln2   ; full
E434   99 80 04               STA   LINEBUF,Y   
E437   C8                     INY      
E438   D0 E6                  BNE   ln3   ; always: echo it
E43A   88           LN4:      DEY      ; Backspace: one back, and echo it,
E43B   10 E3                  BPL   ln3   
E43D   C8                     INY      ;   unless the line was empty
E43E   F0 E3                  BEQ   ln2   ; always
E440   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E443   A9 80                  LDA   #<LINEBUF   
E445   85 02                  STA   TL   
E447   A9 04                  LDA   #>LINEBUF   
E449   85 03                  STA   TH   
E44B   60                     RTS      
E44C                             ; =============================================================================
E44C                             ;  Machine code: the grave
E44C                             ; =============================================================================
E44C                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E44C                             ; are stored from addr until a non-hex character; then a RET (60h) is
E44C                             ; written and its address is left. An odd last digit is consumed and dropped.
E44C                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E44C                             ; contract in the header.
E44C   20 89 E4     H_GRAVE:   JSR   rdhex   
E44F   B0 2A                  BCS   exec   
E451   0A           HX1:      ASL      
E452   0A                     ASL      
E453   0A                     ASL      
E454   0A                     ASL      
E455   85 04                  STA   T0   
E457   20 89 E4               JSR   rdhex   
E45A   B0 15                  BCS   hx2   ; odd digit: already consumed, dropped
E45C   05 04                  ORA   T0   
E45E                          IF   CHECKED   
E45E   85 04                  STA   T0   
E460   A5 03                  LDA   TH   
E462   20 7F E3               JSR   chkst   
E465   A5 04                  LDA   T0   
E467                          ENDIF      
E467   91 02                  STA   (TL),Y   ; Y is 0 after rdhex
E469   20 8C E3               JSR   inctos   
E46C   20 89 E4               JSR   rdhex   
E46F   90 E0                  BCC   hx1   
E471                HX2:         
E471                          IF   CHECKED   
E471   A5 03                  LDA   TH   
E473   20 7F E3               JSR   chkst   
E476                          ENDIF      
E476   A9 60                  LDA   #60h   
E478   91 02                  STA   (TL),Y   
E47A   60                     RTS      
E47B   A5 02        EXEC:     LDA   TL   
E47D   85 04                  STA   T0   
E47F   A5 03                  LDA   TH   
E481   85 05                  STA   T1   
E483   20 E3 E1               JSR   drop   ; the address is consumed
E486   6C 04 00               JMP   (T0)   
E489                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E489                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E489                             ; Y = 0.
E489   20 80 E1     RDHEX:    JSR   isdig   
E48C   90 0A                  BCC   rh1   
E48E   29 DF                  AND   #0DFh   
E490   E9 11                  SBC   #11h   ; (the carry is set)
E492   C9 06                  CMP   #6   
E494   B0 05                  BCS   rh9   
E496   69 0A                  ADC   #10   
E498   4C 91 E1     RH1:      JMP   incip   
E49B   60           RH9:      RTS      
E49C                             ; =============================================================================
E49C                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E49C                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E49C                             ;  Both keep X and Y. In the unchecked build getk is the host's KEY itself.
E49C                             ; =============================================================================
E49C                          IF   1-CHECKED   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
E49C                          ENDIF      
E49C                          IF   CHECKED   
E49C   AD 34 04     GETK:     LDA   KEYBUF   ; a key held back by the break check
E49F   F0 08                  BEQ   gk1   
E4A1   48                     PHA      
E4A2   A9 00                  LDA   #0   
E4A4   8D 34 04               STA   KEYBUF   
E4A7   68                     PLA      
E4A8   60                     RTS      
E4A9   4C 06 FF     GK1:      JMP   KEY   
E4AC                          ENDIF      
E4AC                             ; =============================================================================
E4AC                             ;  Checked build: break key and error reports
E4AC                             ; =============================================================================
E4AC                          IF   CHECKED   
E4AC                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
E4AC                             ; else is held for the next "?". Keeps the flags.
E4AC   08           CHKBRK:   PHP      
E4AD   20 9C E4               JSR   getk   
E4B0   F0 07                  BEQ   cb9   
E4B2   C9 03                  CMP   #3   
E4B4   F0 05                  BEQ   e_break   
E4B6   8D 34 04               STA   KEYBUF   
E4B9   28           CB9:      PLP      
E4BA   60                     RTS      
E4BB   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C
E4BD                             ; error: print the letter in A, " @ " and the offset in the program of the
E4BD                             ; character just read, then end. For example: S @ 245
E4BD                             ; The hardware stack is left as it is: it wraps inside its page, so the
E4BD                             ; calls below work whatever state it is in.
