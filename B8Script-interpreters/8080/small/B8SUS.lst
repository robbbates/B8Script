023D   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
023E                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
023E                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
023E                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
023E                             ; SBB A turns a carry into -1 or 0 with no branch.
023E   E3           H_GT:     XTHL      ; a > b  is  b < a
023F   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0240   7B                     MOV   A,E   
0241   95                     SUB   L   
0242   7A                     MOV   A,D   
0243   9C                     SBB   H   
