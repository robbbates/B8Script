02A1                             ; "?" ( n -- c ) or ( -n -- addr )
02A1                             ;   n > 0: wait about n ms for a key; 0 if none came
02A1                             ;   n = 0: wait for a key
02A1                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02A1                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02A1   7C           H_KEY:    MOV   A,H   
02A2   B7                     ORA   A   
02A3   FA C3 02               JM   line   
02A6   1E 04        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
02A8   CD D2 06     KT2:      CALL   getk   
02AB   C2 BD 02               JNZ   kt3   
02AE   1D                     DCR   E   
02AF   C2 A8 02               JNZ   kt2   
02B2   7C                     MOV   A,H   ; 0? never counts down: it waits
02B3   B5                     ORA   L   
02B4   CA A6 02               JZ   kt1   
02B7   2B                     DCX   H   
02B8   7C                     MOV   A,H   
02B9   B5                     ORA   L   
02BA   C2 A6 02               JNZ   kt1   ; A = 0 if the time ran out
02BD                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
02BD                          ENDIF      
02BD   6F           KT3:      MOV   L,A   
02BE   26 00                  MVI   H,0   
02C0                          ;*Macro unroll:  NEXT
02C0                          DS   (1-CPM)*(1-FAST),0F7h   
02C0   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02C1   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02C2   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02C3                             ; Backspace takes the last character back (and is echoed as
02C3                             ; it is), CR ends (stored, not echoed), every other key is stored and
02C3                             ; echoed until the line is full. The line buffer starts at offset 80h
02C3                             ; of its page, so L alone is the place in the line: D holds the L of
02C3                             ; a full line.
02C3   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
02C6   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
02C7   9F                     SBB   A   
02C8   A5                     ANA   L   ; (0 for a count that is too big)
02C9   2F                     CMA      
02CA   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
02CB                             ;   at most
02CB   21 80 17               LXI   H,LINEBUF   
02CE   CD D2 06     LN2:      CALL   getk   
02D1   CA CE 02               JZ   ln2   
02D4   FE 0D                  CPI   13   
02D6   CA F5 02               JZ   ln5   
02D9   FE 08                  CPI   8   
02DB   CA ED 02               JZ   ln4   
02DE   5F                     MOV   E,A   
02DF   7D                     MOV   A,L   
02E0   BA                     CMP   D   
02E1   CA CE 02               JZ   ln2   ; full
02E4   73                     MOV   M,E   
02E5   2C                     INR   L   
02E6   7B                     MOV   A,E   
02E7                          ;*Macro unroll: ln3:    PUTA
02E7                LN3:      DS   1-CPM,0EFh   
02E7   CD                     DS   CPM,0CDh   
02E8   0C                     DS   CPM,APUT&0FFh   
02E9   07                     DS   CPM,APUT/256   
02EA   C3 CE 02               JMP   ln2   
02ED   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
02EE   FA E7 02               JM   ln3   ;   unless the line was empty (L left the
02F1   2C                     INR   L   ;   upper half of the page)
02F2   C3 CE 02               JMP   ln2   
02F5   77           LN5:      MOV   M,A   ; the CR
02F6   2E 80                  MVI   L,LINEBUF & 0FFh   
02F8                          ;*Macro unroll:  NEXT
02F8                          DS   (1-CPM)*(1-FAST),0F7h   
02F8   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02F9   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02FA   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02FB                             ; =============================================================================
02FB                             ;  Dispatch table: the low byte of each handler's address, in code order.
02FB                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02FB                             ; =============================================================================
02FB                             ; The handlers of the first NPG1 characters start in the image's second page.
02FB                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02FB                             ; differs between the builds, so the count is worked out here.
02FB                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02FB                          IF   1-FAST   
                    PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
                    PGBRK:    EQU   (h_break-BASE)/256   
                    PGDEF:    EQU   (h_def-BASE)/256   
                    PGFET:    EQU   (h_fetch-BASE)/256   
                    NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02FB                          ENDIF      
02FB                          IF   (1-FAST)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02FB                          ENDIF      
02FB                             ; =============================================================================
02FB                             ;  Routines (no handler starts past this point)
02FB                             ; =============================================================================
02FB                             ; Digits: step back onto the first digit and read the whole number.
02FB   E5           DIGIT:    PUSH   H   
02FC   0B                     DCX   B   
02FD   CD 0D 03               CALL   rdnum   
0300                          ;*Macro unroll:  NEXT
0300                          DS   (1-CPM)*(1-FAST),0F7h   
0300   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0301   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0302   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0303                             ; negnum: "-" directly before a digit: read the number, negate it.
0303   E5           NEGNUM:   PUSH   H   
0304   CD 0D 03               CALL   rdnum   
0307                          ;*Macro unroll:  NEGH
0307                          DS   1-CPM,0E7h   
0307   CD                     DS   CPM,0CDh   
0308   27                     DS   CPM,ANEG&0FFh   
0309   01                     DS   CPM,ANEG/256   
030A                          ;*Macro unroll:  NEXT
030A                          DS   (1-CPM)*(1-FAST),0F7h   
030A   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
030B   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
030C   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
030D                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
030D                             ; non-digit. Values wrap at 16 bits, as the spec says.
030D   21 00 00     RDNUM:    LXI   H,0   
0310   0A           RDN1:     LDAX   B   
0311   D6 30                  SUI   "0"   
0313   FE 0A                  CPI   10   
0315   D0                     RNC      
0316   03                     INX   B   
0317   54                     MOV   D,H   
0318   5D                     MOV   E,L   
0319   29                     DAD   H   
031A   29                     DAD   H   
031B   19                     DAD   D   
031C   29                     DAD   H   ; HL * 10
031D   5F                     MOV   E,A   
031E   16 00                  MVI   D,0   
0320   19                     DAD   D   
0321   C3 10 03               JMP   rdn1   
0324                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0324                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0324                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0324                             ; lives on the stack, since A is busy with the shifts.
0324                             ; Dividing by 2 is one shift (the spec wants that fast).
0324   01 00 00     UDIV:     LXI   B,0   
0327                          IF   1-QK   
                              MOV   A,E   
                              XRI   2   
                              ORA   D   
                              JNZ   udv0   
                              ORA   H   ; A was 0, and the carry is clear
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   ; the quotient
                              MOV   A,B   
                              RAL      
                              MOV   C,A   ; the remainder: the bit that fell out
                              RET      
0327                          ENDIF      
0327                          IF   QK   
0327                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0327                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0327   7A                     MOV   A,D   
0328   B7                     ORA   A   
0329   C2 7D 03               JNZ   uq1   ; 256 and up
032C   B3                     ORA   E   
032D   CA 94 03               JZ   udv0   ; by 0: the long way (it means nothing anyway)
0330   3D                     DCR   A   
0331   A3                     ANA   E   
0332   C2 94 03               JNZ   udv0   ; not a power of two
0335   7B                     MOV   A,E   ; by 2^k below 256: q = HL >> k, and
0336   3D                     DCR   A   ;   r = L & (2^k - 1)
0337   A5                     ANA   L   
0338   4F                     MOV   C,A   
0339                          ENDIF      
0339                          IF   QK*(1-FAST)   
                    UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
                              ORA   A   
                              RAR      
                              RC      
                              MOV   E,A   
                              MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              JMP   uq2   
0339                          ENDIF      
0339                          IF   FAST   
0339                             ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
0339                             ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
0339   7B           UQ2:      MOV   A,E   
033A   FE 10                  CPI   16   
033C   D2 60 03               JNC   uqh   
033F   FE 02                  CPI   2   
0341   D8                     RC      ; by 1
0342   CA 58 03               JZ   ur1   
0345   FE 04                  CPI   4   
0347   CA 51 03               JZ   ur2   
034A                UR3:         
034A   7C                     MOV   A,H   
034B   B7                     ORA   A   
034C   1F                     RAR      
034D   67                     MOV   H,A   
034E   7D                     MOV   A,L   
034F   1F                     RAR      
0350   6F                     MOV   L,A   
0351                UR2:         
0351   7C                     MOV   A,H   
0352   B7                     ORA   A   
0353   1F                     RAR      
0354   67                     MOV   H,A   
0355   7D                     MOV   A,L   
0356   1F                     RAR      
0357   6F                     MOV   L,A   
0358                UR1:         
0358   7C                     MOV   A,H   
0359   B7                     ORA   A   
035A   1F                     RAR      
035B   67                     MOV   H,A   
035C   7D                     MOV   A,L   
035D   1F                     RAR      
035E   6F                     MOV   L,A   
035F   C9                     RET      
0360   FE 40        UQH:      CPI   64   
0362   3E 00                  MVI   A,0   
0364   CA 76 03               JZ   ul2   
0367   D2 78 03               JNC   ul1   
036A   7B                     MOV   A,E   
036B   FE 20                  CPI   32   
036D   3E 00                  MVI   A,0   
036F   CA 74 03               JZ   ul3   
0372   29                     DAD   H   ; by 16
0373   8F                     ADC   A   
0374   29           UL3:      DAD   H   
0375   8F                     ADC   A   
0376   29           UL2:      DAD   H   
0377   8F                     ADC   A   
0378   29           UL1:      DAD   H   
0379   8F                     ADC   A   
037A   6C                     MOV   L,H   
037B   67                     MOV   H,A   
037C   C9                     RET      
037D                          ENDIF      
037D                          IF   QK   
037D   7B           UQ1:      MOV   A,E   
037E   B7                     ORA   A   
037F   C2 94 03               JNZ   udv0   
0382   7A                     MOV   A,D   
0383   3D                     DCR   A   
0384   A2                     ANA   D   
0385   C2 94 03               JNZ   udv0   ; not a power of two
0388   7A                     MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
0389   3D                     DCR   A   ;   q = H >> (k - 8)
038A   A4                     ANA   H   
038B   47                     MOV   B,A   
038C   4D                     MOV   C,L   
038D   6C                     MOV   L,H   
038E   26 00                  MVI   H,0   
0390   5A                     MOV   E,D   
0391   C3 39 03               JMP   uq2   
0394                          ENDIF      
0394                          IF   1-FAST   
                    UDV0:     MVI   A,16   
                              PUSH   PSW   
                    UDV1:     DAD   H   ; next dividend bit into the carry
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   udv2   
                              MOV   B,A   ; BC - DE (high byte; A holds it)
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UDV2:     POP   PSW   
                              DCR   A   
                              PUSH   PSW   
                              JNZ   udv1   
                              POP   PSW   
                              RET      
0394                          ENDIF      
0394                          IF   FAST   
0394                             ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
0394                             ; starts 8 bits up and takes only the last 8, since its first 8 would only
0394                             ; shift zeros)
0394   7C           UDV0:     MOV   A,H   
0395   B7                     ORA   A   
0396   CA CA 04               JZ   uvs   
0399   29           UV0:      DAD   H   
039A   79                     MOV   A,C   
039B   17                     RAL      
039C   4F                     MOV   C,A   
039D   78                     MOV   A,B   
039E   17                     RAL      
039F   47                     MOV   B,A   ; BC = BC*2 + bit
03A0   79                     MOV   A,C   
03A1   93                     SUB   E   
03A2   78                     MOV   A,B   
03A3   9A                     SBB   D   ; carry if BC < DE
03A4   DA AC 03               JC   uw0   
03A7   47                     MOV   B,A   
03A8   79                     MOV   A,C   
03A9   93                     SUB   E   
03AA   4F                     MOV   C,A   
03AB   2C                     INR   L   ; quotient bit
03AC                UW0:         
03AC   29           UV1:      DAD   H   
03AD   79                     MOV   A,C   
03AE   17                     RAL      
03AF   4F                     MOV   C,A   
03B0   78                     MOV   A,B   
03B1   17                     RAL      
03B2   47                     MOV   B,A   ; BC = BC*2 + bit
03B3   79                     MOV   A,C   
03B4   93                     SUB   E   
03B5   78                     MOV   A,B   
03B6   9A                     SBB   D   ; carry if BC < DE
03B7   DA BF 03               JC   uw1   
03BA   47                     MOV   B,A   
03BB   79                     MOV   A,C   
03BC   93                     SUB   E   
