02F2   CD 03 FF               CALL   putc   
02F5   CF                     RST   1   
02F6                             ; "#" prints TOS as a signed decimal number, with no space after it.
02F6   7C           H_NUM:    MOV   A,H   
02F7   B7                     ORA   A   
02F8   F2 03 03               JP   num1   
02FB   3E 2D                  MVI   A,"-"   
02FD   CD 03 FF               CALL   putc   
0300   CD 1D 01               CALL   neg16   
0303   C5           NUM1:     PUSH   B   
0304   CD 09 03               CALL   pdec   
0307   C1                     POP   B   
0308   CF                     RST   1   
