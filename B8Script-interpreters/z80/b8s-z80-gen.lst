0200   F7                     RST   30h   
0201                          ENDIF      
0201                          IF   EDGEN   
                              RET      
0201                          ENDIF      
0201                             ; =============================================================================
0201                             ;  More routines (no handler starts past this point)
0201                             ; =============================================================================
0201                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0201                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0201                             ; while the quotient bits arrive at the bottom of C.
0201                             ; Dividing by 2 is one shift (the spec wants that fast).
0201   7B           UDIV:     LD   A,E   
0202   EE 02                  XOR   2   
0204   B2                     OR   D   
0205   20 07                  JR   NZ,udv0   
0207   CB 3C                  SRL   H   
0209   CB 1D                  RR   L   ; the quotient
020B   8F                     ADC   A,A   
020C   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
020D   C9                     RET      
020E   7C           UDV0:     LD   A,H   
020F   4D                     LD   C,L   
0210   21 00 00               LD   HL,0   
0213   06 10                  LD   B,16   
0215   CB 21        UDV1:     SLA   C   
0217   17                     RLA      
0218   ED 6A                  ADC   HL,HL   
021A   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
021C   30 02                  JR   NC,udv2   ;   always fits in 16 bits
021E   19                     ADD   HL,DE   ; too much: put it back, and cancel the
021F   0D                     DEC   C   ;   INC below
0220   0C           UDV2:     INC   C   ; a quotient bit
0221   10 F2                  DJNZ   udv1   
0223   EB                     EX   DE,HL   ; DE = remainder
0224   67                     LD   H,A   
0225   69                     LD   L,C   ; HL = quotient
0226   C9                     RET      
0227                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0227                             ; non-digit. Values wrap at 16 bits, as the spec says.
0227   21 00 00     RDNUM:    LD   HL,0   
022A   0A           RDN1:     LD   A,(BC)   
022B   D6 30                  SUB   "0"   
022D   FE 0A                  CP   10   
022F   D0                     RET   NC   
0230   03                     INC   BC   
0231   54                     LD   D,H   
0232   5D                     LD   E,L   
0233   29                     ADD   HL,HL   
0234   29                     ADD   HL,HL   
0235   19                     ADD   HL,DE   
0236   29                     ADD   HL,HL   ; HL * 10
0237   5F                     LD   E,A   
0238   16 00                  LD   D,0   
023A   19                     ADD   HL,DE   
023B   18 ED                  JR   rdn1   
023D                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
023D                             ; the next character, so "/"" does not end it. Leaves A = 22h.
023D                          IF   1-CHECKED   
023D   03           SS0:      INC   BC   
023E   0A           SKIPSTR:   LD   A,(BC)   
023F   03                     INC   BC   
0240   FE 2F                  CP   "/"   
0242   28 F9                  JR   Z,ss0   
0244   FE 22                  CP   22h   
0246   20 F6                  JR   NZ,skipstr   
0248   C9                     RET      
0249                          ENDIF      
0249                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0249                          ENDIF      
0249                             ; skip: read past text to the closer at this level, and return A = 0 if it
0249                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0249                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0249                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0249                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0249                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0249                             ; 
0249                             ; The checked build also looks at the character the skip was started by,
0249                             ; which is always the one just before where it starts: "(" must end at ")",
0249                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0249                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0249                             ; place where the skip started, for the report.
0249                SKIP:        
0249                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0249                          ENDIF      
0249   16 00                  LD   D,0   
024B   14           SK3:      INC   D   ; an opener: one deeper
024C   0A           SK1:      LD   A,(BC)   
024D                          IF   1-CHECKED   
024D   03                     INC   BC   
024E   B7                     OR   A   
024F   CA 15 00               JP   Z,endprog   
0252                          ENDIF      
0252                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0252                          ENDIF      
0252   FE 22                  CP   22h   
0254   CC 3E 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0257   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0259   28 F0                  JR   Z,sk3   
025B   3D                     DEC   A   ; ")"
025C   28 08                  JR   Z,sk4   
025E   D6 32                  SUB   "["-")"   
0260   28 E9                  JR   Z,sk3   
0262   FE 02                  CP   "]"-"["   
0264   20 E6                  JR   NZ,sk1   
0266   15           SK4:      DEC   D   
0267                          IF   1-CHECKED   
0267   C8                     RET   Z   ; the closer at this level
0268   18 E2                  JR   sk1   
026A                          ENDIF      
026A                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,endprog   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
026A                          ENDIF      
026A                             ; psgn: print HL as a signed number. Uses BC.
026A   CB 7C        PSGN:     BIT   7,H   
026C   28 04                  JR   Z,pdec   
026E   3E 2D                  LD   A,"-"   
0270   EF                     RST   28h   
0271   E7                     RST   20h   
0272                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0272                             ; Uses BC.
0272   11 0A 00     PDEC:     LD   DE,10   
0275   CD 01 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0278   7B                     LD   A,E   
0279   F5                     PUSH   AF   
027A   7C                     LD   A,H   
027B   B5                     OR   L   
027C   C4 72 02               CALL   NZ,pdec   
027F   F1                     POP   AF   
0280   C6 30                  ADD   A,"0"   
0282   EF                     RST   28h   
0283   C9                     RET      
0284                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0284                             ; and return its value in A with the carry set; otherwise leave the IP and
0284                             ; return with the carry clear.
0284   0A           HEXC:     LD   A,(BC)   
0285   D6 30                  SUB   "0"   
0287   FE 0A                  CP   10   
0289   38 09                  JR   C,hc1   
028B   E6 DF                  AND   0DFh   
028D   D6 11                  SUB   11h   
028F   FE 06                  CP   6   
0291   D0                     RET   NC   
0292   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0294   03           HC1:      INC   BC   
0295   C9                     RET      
0296                             ; =============================================================================
0296                             ;  Dispatch table: the low byte of each handler's address, in code order
0296                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0296                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0296                             ; =============================================================================
0296                             ; The handlers of the first NPG1 characters start in the image's second page.
0296                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0296                             ; differs between the builds, so the count is worked out here.
0296                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0296                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0296                PGBRK:    EQU   (h_break-BASE)/256   
0296                PGDEF:    EQU   (h_def-BASE)/256   
0296                PGFET:    EQU   (h_fetch-BASE)/256   
0296                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0296                          IF   1-TABP0   
0296                PTAB:        
0296                          ;*Macro unroll:  PTABLE
0296   90                     DB   h_store & 0FFh   
0297   95                     DB   h_str & 0FFh   
0298   B0                     DB   h_num & 0FFh   
0299   9C                     DB   h_print & 0FFh   
029A   8B                     DB   h_swap & 0FFh   
029B   33                     DB   h_and & 0FFh   
029C   AD                     DB   h_emit & 0FFh   
029D   0F                     DB   h_open & 0FFh   
029E   17                     DB   h_close & 0FFh   
029F   54                     DB   h_mul & 0FFh   
02A0   2A                     DB   h_add & 0FFh   
02A1   CE                     DB   h_cfetch & 0FFh   
02A2   22                     DB   h_sub & 0FFh   
02A3   8D                     DB   h_cstore & 0FFh   
02A4   68                     DB   h_div & 0FFh   
02A5   89                     DB   h_dup & 0FFh   
02A6   8F                     DB   h_drop & 0FFh   
02A7   3B                     DB   h_lt & 0FFh   
02A8   4A                     DB   h_eq & 0FFh   
02A9   3C                     DB   h_gt & 0FFh   
02AA   B6                     DB   h_key & 0FFh   
02AB   0A                     DB   h_fetch & 0FFh   
02AC   ED                     DB   h_def & 0FFh   
02AD   E0                     DB   h_break & 0FFh   
02AE   DC                     DB   h_ret & 0FFh   
02AF   7C                     DB   h_xor & 0FFh   
02B0   8F                     DB   h_alloc & 0FFh   
02B1   C6                     DB   h_grave & 0FFh   
02B2   2C                     DB   h_tor & 0FFh   
02B3   84                     DB   h_or & 0FFh   
02B4   1C                     DB   h_fromr & 0FFh   
02B5   8C                     DB   h_not & 0FFh   
02B6                PTABEND:      
02B6                          ENDIF      
02B6                             ; =============================================================================
02B6                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02B6                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
02B6                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
02B6                             ;  KEY and CONOUT routines themselves.
02B6                             ; =============================================================================
02B6                          IF   (1-CPM)*(1-CHECKED)   
02B6                GETK:     EQU   KEY   ; the host's routine does the whole job
02B6                          ENDIF      
02B6                          IF   CHECKED   
                    GETK:     PUSH   HL   ; a key held back by the break check goes
                              LD   HL,KEYBUF   ;   first, and is taken out of the buffer
                              LD   A,(HL)   
                              LD   (HL),0   
                              POP   HL   
                              OR   A   
                              RET   NZ   
02B6                          ENDIF      
02B6                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
02B6                          ENDIF      
02B6                          IF   CPM*(1-CHECKED)   
                    GETK:        
02B6                          ENDIF      
02B6                          IF   CPM   
                              LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
02B6                          ENDIF      
02B6                             ; =============================================================================
02B6                             ;  Checked build: the checks and the error report
02B6                             ; =============================================================================
02B6                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,chs1   
02B6                          ENDIF      
02B6                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
02B6                          ENDIF      
02B6                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
02B6                          ENDIF      
02B6                          IF   CHECKED   
                    CHS1:     JP   e_store   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
02B6                          ENDIF      
02B6                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
02B6                          ENDIF      
02B6                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
02B6                          ENDIF      
02B6                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              JP   e_heap1   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JR   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              POP   HL   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   HL,RSTOP   
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   CALL   getk   
                              RET   Z   
                              CP   3   
                              JR   Z,e_break   
                              LD   (KEYBUF),A   
                              RET      
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside chkbrk)
                              DB   11h   
                    E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
                              DB   11h   
                    E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
02B6                          ENDIF      
02B6                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
02B6                          ENDIF      ;   screen on it)
02B6                          IF   CHECKED   
                              RST   28h   
                              DJNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
                              OR   A   ;   first value and holds nothing)
                              SBC   HL,SP   
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              PUSH   BC   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   BC   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
                                 ; phalf: print half of HL, and leave it in C
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
02B6                          ENDIF      
02B6                             ; =============================================================================
02B6                             ;  The line editor (EDITOR = 1)
02B6                             ; 
02B6                             ;  The interpreter starts here, and a program that ends comes back here. Type
02B6                             ;  a line and press Return:
02B6                             ; 
02B6                             ;    n text    put the text in as line n; the lines from n on move down.
02B6                             ;              A number past the end, or 0, adds the line at the end.
02B6                             ;    n         take line n out
02B6                             ;    0         run the program
02B6                             ;    -n        list the program from line n on (-1 lists all of it). Any key
02B6                             ;              stops the list until another key is pressed; Ctrl-C ends it.
02B6                             ;    anything else is run at once, as B8Script. (Start such a line with a
02B6                             ;    space if it would begin with a digit or a minus sign.)
02B6                             ; 
02B6                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
02B6                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
02B6                             ;  125 characters, the line number and the one character after it included;
02B6                             ;  that character is not stored. The text is kept as it is typed, each line
02B6                             ;  ending in CR LF, at PROG. Nothing is checked.
02B6                             ; 
02B6                             ;  With CPM = 1 the file named on the command line is the program to start
02B6                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
02B6                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
02B6                             ;  CP/M. Nothing is written back: there is no command to save.
02B6                             ; 
02B6                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
02B6                             ;  its report and comes back here, with both stacks empty. The place is a
02B6                             ;  line and column of the program; in a line typed here it is line 0.
02B6                             ; 
02B6                             ;  Things to know:
02B6                             ;    - Reset empties the program (generic builds).
02B6                             ;    - Words and variables last from one line to the next. A word's address
02B6                             ;      points into the program, so run the program again after editing it.
02B6                             ;    - Nothing is printed between a program's output and what is typed next.
02B6                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
02B6                             ;      a line that calls -n? and carries on afterwards runs what was typed.
02B6                             ;      (The stored program never comes back to the line, so it may.)
02B6                             ; =============================================================================
02B6                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
02B6                          ENDIF      
02B6                          IF   EDITOR   
                                 ; -n: list from line n. DE = the number of the line at HL.
                    LIST:     INC   BC   
                              CALL   rdnum   ; HL = n
                              PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,edit   ; the end of the text
                              CALL   getk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,edit   ; Ctrl-C
                    LI2:      CALL   getk   ; any other key: wait for one more
                              JR   Z,li2   
                              CP   3   
                              JR   Z,edit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; Take line n (in HL) out: copy everything after it down over it.
                    DEL:      CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
02B6                          ENDIF      
02B6                          IF   EDITOR*CPM*CHECKED   
                                 ; A key that the break check held back while a program ran is let
                                 ; go: BDOS 10 would not see it, and it would turn up in the next
                                 ; program that asked for a key. (This also serves at the start.)
                              XOR   A   
                              LD   (KEYBUF),A   
02B6                          ENDIF      
02B6                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
02B6                          ENDIF      
02B6                          IF   EDITOR*CPM   
                              LD   A,125   
02B6                          ENDIF      
02B6                          IF   EDITOR   
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   
                              CALL   prl   ; (print the CR LF: a new line)
                              LD   (HL),0   ;   and a NUL after that
                              PUSH   HL   ; the end of what was typed
                              LD   BC,LINEBUF   
                              LD   A,(BC)   
                              CP   "-"   
                              JR   Z,list   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0   ; no number: run the line where it is
                              LD   A,(BC)   
                              SUB   13   
                              JR   NZ,ins   ; text follows the number
                              OR   H   ; the number alone:
                              OR   L   
                              JR   NZ,del   ;   not 0: take that line out
                              LD   BC,PROG   ;   0: run the program
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
                              LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
02B6                          ENDIF      
02B6                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
02B6                          ENDIF      
02B6                          IF   EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; Put the typed text in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              INC   BC   ; step over the one character after the number
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                              JR   edit   
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
02B6                          ENDIF      
02B6                             ; =============================================================================
02B6                             ;  CP/M startup (the generic build starts at address 0: see st0)
02B6                             ; =============================================================================
02B6                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
02B6                          ENDIF      
02B6                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
02B6                          ENDIF      
02B6                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:         
02B6                          ENDIF      
02B6                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
02B6                          ENDIF      
02B6                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
02B6                          ENDIF      
02B6                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
02B6                          ENDIF      
02B6                IMGEND:      


