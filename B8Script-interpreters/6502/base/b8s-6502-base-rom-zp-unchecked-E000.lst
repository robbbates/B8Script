0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only), with the data stack
0000                             ;  in zero page
0000                             ;  Required Notice: Copyright 2026 Robb Bates (https://github.com/robbbates)
0000                             ;  Licence: PolyForm Noncommercial License 1.0.0 (LICENSE.md at the top of
0000                             ;  the repository, or https://polyformproject.org/licenses/noncommercial/1.0.0)
0000                             ;  Spec: docs/b8script.md (2026-11-24). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ; 
0000                             ;  This is the smaller of the two 6502 interpreters. b8s-6502.asm keeps the
0000                             ;  data stack in pages 2 and 3 (252 cells) and leaves zero page almost free;
0000                             ;  this one keeps it in zero page (112 cells), where the 6502's short
0000                             ;  addressing modes make nearly every handler smaller. The language is the
0000                             ;  same; the memory map and the machine-code contract differ.
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's three-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   D:2: 5 0
0000                             ;                   R:0
0000                             ;                 and then goes to EXIT.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build").
0000                             ;  The base and fast builds keep the skip cache in the page at $0200, which no
0000                             ;  other build uses (this interpreter's data stack is in zero page).
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   1   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    X       the data-stack pointer. Every cell is two bytes in zero page, low
0000                             ;            byte first: the top cell (TOS) is 0,X and 1,X, the one under it
0000                             ;            (NOS) 2,X and 3,X. The stack grows down: a push is DEX DEX, a
0000                             ;            drop INX INX. A cell that holds an address is used where it is,
0000                             ;            with (0,X): nothing is copied to a pointer first.
0000                             ;    $FE,X   the two bytes under the top cell (zero-page indexing wraps, so
0000                             ;    $FF,X   this is -2,X and -1,X): free memory, used as scratch.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  PTAB holds one byte per punctuation character: the low byte of its
0000                             ;  handler's address, less 1 (the dispatcher pushes an address and "returns"
0000                             ;  to it). The high byte comes from the character: the handlers of the first
0000                             ;  N1 characters start in the image's first page, those of the characters from
0000                             ;  N1 up to N2 in its second, and the rest in its third. The layout below
0000                             ;  keeps to that, and testing/chktab6502.py checks it in every build but the
0000                             ;  fast build (SPEED = 2), which dispatches through a full table instead:
0000                             ;  see "The fast build" at the end.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the dispatcher
0000                             ;  leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry the
0000                             ;  address has been dropped and X is the data-stack pointer: TOS is 0,X (low)
0000                             ;  and 1,X (high), NOS is 2,X and 3,X. To push: DEX, DEX, then store at 0,X
0000                             ;  and 1,X. To drop: INX, INX. The code may change A and Y, and X as the
0000                             ;  stack pointer; it must keep IP ($00/$01) and leave the hardware stack
0000                             ;  balanced. Zero page $02, $03, $07 and $0A-$0D are free for its own use;
0000                             ;  but $0C-$0D only while the code runs: a "$" that prints a variable escape
0000                             ;  with the data stack full writes there.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   T1   ; 05-06 the divisor (division, number printing)
0000                D1:       EQU   T2   
0000                V:        EQU   T0   ; (FAST) 04-05 the dispatcher's jump vector
0000                          IF   CHECKED   
                    PLACE:    EQU   08h   ; 08-09 the address of the character being
                                 ;   run, for the error report. No handler
                                 ;   uses it.
                                 ; The error report runs after the program, so it may use the zero page that
                                 ; machine code has ($02, $03, $0A-$0D; but not $0A-$0D once it prints
                                 ; numbers, since a full stack and "#" reach down to them):
                    P:        EQU   02h   ; 02-03 the place, copied (PLACE is the
                    CO:       EQU   08h   ;   report's own scratch then, CO)
                    LN:       EQU   0Ah   ; 0A-0B the line being reported
0000                          ENDIF      
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-000F  the variables above, and scratch
0000                             ;    0010-00EF  the data stack: 112 cells. X = F0 when it is empty. (0E and
0000                             ;               0F are the scratch under the top cell when it is full.)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       CPAGE (QK builds only): the skip cache
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PEND at +38;
0000                             ;               and every build's: the countdown CDOWN at +79, KEYBUF (the
0000                             ;               held key) at +7A, BRKOFF (the break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM). In the fast build its first two
0000                             ;               pages are the dispatch table, and start is at E200
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these. All four must keep X;
0000                             ; they may change A, Y and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if the carry is set,
0000                             ;     hide it if the carry is clear
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row A, column Y, both
0000                             ;     counted from 0
0000                          ENDIF      
0000                DSE:      EQU   0F0h   ; X when the data stack is empty
0000                DSFULL:   EQU   10h   ; X when it is full
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                CDOWN:    EQU   LET+79h   ; the break check's countdown (see pnext)
0000                RSV:      EQU   LET+35h   ; checked: S as it was before this character
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                CPAGE:    EQU   02h   ; (QK) the skip cache's page
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
0000                BASE:     EQU   0E000h   ; where the image starts: a multiple of 512
0000                HALFPG:   EQU   BASE/512   ; (the dispatcher doubles this to get a page)
0000                N1:       EQU   8   ; ! " # $ % & ' (  start in the first page,
0000                N2:       EQU   21   ; ) * + , - . / : ; < = > ?  in the second,
0000                             ; @ [ \ ] ^ _ ` 00bbIHwg ~  in the third
0000                             ; The fast build's dispatcher (SPEED = 2; see "The fast build"), inline at
0000                             ; the end of its own entries. NEXTF reads the next character and jumps
0000                             ; through the table:
0000                             ;     LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
0000                             ;     LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
0000                             ; NEXTA is the same from INC IP on: the character is already in A, and IP is
0000                             ; still at it (it skips the LDY and the LDA); NEXTY is the same with the
0000                             ; character in Y (it skips the TAY too). In the checked build all three are
0000                             ; JMP fnext, which checks the stacks first. (The bytes are written out with
0000                             ; DS, because asm80 does not nest an IF in a macro inside another IF; and
0000                             ; DS takes the addresses as these equates.)
0000                          IF   FAST   
                    ADTL:     EQU   DTL   
                    ADTH:     EQU   DTH   
                    AFNX:     EQU   fnext   
0000                          ENDIF      
0000                          IF   1-FAST   
0000                ADTL:     EQU   0   
0000                ADTH:     EQU   0   
0000                AFNX:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      1-CHECKED,0A0h  ; LDY #0
0000                 DS      1-CHECKED,0
0000                 DS      1-CHECKED,0B1h  ; LDA (IP),Y
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTA,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTY,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient; the
0000                             ; remainder is left in the scratch under it, at $FE,X and $FF,X.
0000                             ; Dividing by 2 is one shift (the spec wants that fast).
0000                             ; (A macro, from when the two builds needed it in different places.)
0000                .macro UDIV,
0000                             ; 
0000                udiv:   LDA     #0
0000                 STA     0FEh,X
0000                 STA     0FFh,X
0000                 LDA     D0
0000                 EOR     #2
0000                 ORA     D1
0000                 BNE     ud0
0000                 LSR     1,X
0000                 ROR     0,X             ; the quotient
0000                 ROL     0FEh,X          ; the remainder: the bit that fell out
0000                 RTS
0000                ud0:    LDY     #16
0000                ud1:    ASL     0,X
0000                 ROL     1,X
0000                 ROL     0FEh,X
0000                 ROL     0FFh,X
0000                 SEC
0000                 LDA     0FEh,X
0000                 SBC     D0
0000                 STA     T0
0000                 LDA     0FFh,X
0000                 SBC     D1
0000                 BCC     ud2
0000                 STA     0FFh,X
0000                 LDA     T0
0000                 STA     0FEh,X
0000                 INC     0,X             ; the quotient bit (bit 0 is free)
0000                ud2:    DEY
0000                 BNE     ud1
0000                 RTS
0000                .endm
0000                 
0000                             ; (QK) "*" with an operand below 256 takes 8 rounds, not 16: that one
0000                             ; becomes the multiplier, so the product's low byte comes out of the NOS
0000                             ; cell's low byte and its high byte is left in T0. Most multiplications have
0000                             ; one: a count or a small constant. (A macro, as it sits in a different
0000                             ; place in the checked and the unchecked builds, to keep the handlers'
0000                             ; pages.)
0000                .macro MULQ,
0000                             ; 
0000                mulq:   LDA     3,X
0000                 BEQ     mq8             ; the multiplier is below 256
0000                 LDA     1,X
0000                 BNE     mq16
0000                 JSR     h_swap          ; the multiplicand is: it becomes the multiplier
0000                mq8:    LDY     #8
0000                 LDA     #0
0000                 STA     T0
0000                 LSR     2,X
0000                mq1:    BCC     mq2
0000                 STA     T1
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 LDA     T1
0000                 ADC     1,X
0000                mq2:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 DEY
0000                 BNE     mq1
0000                 LDA     T0
0000                 STA     3,X
0000                 INX
0000                 INX
0000                 RTS
0000                mq16:   LDY     #16             ; 16 rounds, as h_mul does without QK
0000                 LDA     #0
0000                 STA     T0
0000                 LSR     3,X
0000                 ROR     2,X
0000                mq3:    BCC     mq4
0000                 STA     T1
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 LDA     T1
0000                 ADC     1,X
0000                mq4:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 DEY
0000                 BNE     mq3
0000                 INX
0000                 INX
0000                 RTS
0000                .endm
0000                 
0000                             ; (MULF: the same for the fast build, the rounds unrolled, with Y for the
0000                             ; upper half's high byte while the low one is added)
0000                .macro MULF,
0000                             ; 
0000                mulq:   LDA     3,X
0000                 BEQ     mq8             ; the multiplier is below 256
0000                 LDA     1,X
0000                 BEQ     mqs
0000                 JMP     mq16            ; (out of a branch's reach)
0000                mqs:    JSR     h_swap          ; the multiplicand is: it becomes the multiplier
0000                mq8:    LDA     #0
0000                 STA     T0
0000                 LSR     2,X
0000                 BCC     mu0
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu0:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu1
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu1:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu2
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu2:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu3
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu3:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu4
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu4:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu5
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu5:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu6
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu6:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu7
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu7:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 LDA     T0
0000                 STA     3,X
0000                 INX
0000                 INX
0000                 RTS
0000                mq16:   LDA     #0
0000                 STA     T0
0000                 LSR     3,X
0000                 ROR     2,X
0000                 BCC     mw0
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw0:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw1
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw1:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw2
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw2:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw3
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw3:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw4
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw4:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw5
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw5:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw6
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw6:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw7
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw7:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw8
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw8:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw9
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw9:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw10
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw10:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw11
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw11:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw12
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw12:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw13
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw13:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw14
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw14:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw15
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw15:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 INX
0000                 INX
0000                 RTS
0000                .endm
0000                 
0000                             ; (QK) A true ")" reads the block start where it is, under the step frame,
0000                             ; instead of popping it and pushing it back. The break key is looked at as
0000                             ; pnext would. (A macro, for the same reason.)
0000                .macro CLOSEQ,
0000                             ; 
0000                closeq: TXA                     ; (TSX trashes X)
0000                 TSX
0000                 LDY     103h,X
0000                 STY     IP
0000                 LDY     104h,X
0000                 STY     IP+1
0000                 TAX
0000                 DEC     CDOWN
0000                 BEQ     cq1
0000                 RTS                     ; into the loop
0000                cq1:    PLA
0000                 PLA                     ; the step frame
0000                 JMP     pkey
0000                .endm
0000                 
0000                FTAB:     EQU   BASE   ; (FAST: the fast build's table, two pages,
E000                          .ORG   BASE+FAST*512   ;   comes first, and the code after it)
E000                             ; =============================================================================
E000                             ;  Page 1 of 3. Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
                                 ; The first half of the letter page is zeroed: every variable, every
                                 ; cell of the interpreter's own (no key held back), and every word
                                 ; cell, which then points at 0000h: calling an undefined word stops
                                 ; with U (see e_undef).
                              INX      
                              TXA      ; A = 0
                              LDY   #7Fh   
                    STZ:      STA   LET,Y   
                              DEY      
                              BPL   stz   
E003                          ENDIF      
E003                          IF   QK   
E003   A9 00                  LDA   #0   ; an empty skip cache (a start of 0000h
E005   A8                     TAY      ;   matches no skip)
E006   99 00 02     SKC:      STA   CPAGE*256,Y   
E009   C8                     INY      
E00A   D0 FA                  BNE   skc   
E00C                          ENDIF      
E00C   20 B9 E5               JSR   rstip   
E00F   20 A8 E5     ST1:      JSR   getc   
E012   D0 FB                  BNE   st1   ; IP ends just past the NUL
E014                          IF   1-CHECKED   
E014   8D 7A 04               STA   KEYBUF   ; (A = 0) no key held, the break key on
E017   8D 7B 04               STA   BRKOFF   
E01A                          ENDIF      
E01A   A5 00                  LDA   IP   
E01C   8D 7C 04               STA   HEAP   
E01F                          IF   CHECKED   
                              STA   PEND   
E01F                          ENDIF      
E01F   A5 01                  LDA   IP+1   
E021   8D 7D 04               STA   HEAP+1   
E024                          IF   CHECKED   
                              STA   PEND+1   
E024                          ENDIF      
E024   20 B9 E5               JSR   rstip   
E027   A2 F0                  LDX   #DSE   
E029                             ; ---- the inner loop (the checked build's is further down, out of this page)
E029                          IF   1-CHECKED   
E029                             ; -----------------------------------------------------------------------------
E029                             ;  The break key. A running program reads the keyboard only through getk
E029                             ;  (for "?") and pnext (the break check), which between them give the break
E029                             ;  key its rules:
E029                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E029                             ;      build, with the report (B) in the checked one;
E029                             ;    - any other key that the break check reads is held in KEYBUF for the
E029                             ;      next "?", and a newer one takes its place;
E029                             ;    - "?" (getk) takes the held key first;
E029                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E029                             ;      key like any other, but two of them within about 250 ms still stop it.
E029                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E029                             ; -----------------------------------------------------------------------------
E029                             ; pnext: the break check, then (falling through) next. A word call, a true
E029                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E029                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E029                             ; falls in here too, which does no harm.)
E029   CE 79 04     PNEXT:    DEC   CDOWN   
E02C   D0 0B                  BNE   next   
E02E   20 06 FF     PKEY:     JSR   KEY   
E031   F0 06                  BEQ   next   ; no key
E033   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E036   20 B2 E4               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E039                NEXT:        
E039                          ENDIF      
E039                          IF   (1-CHECKED)*(1-FAST)   
E039   20 D9 E4               JSR   step   
E03C   4C 39 E0               JMP   next   
E03F                          ENDIF      
E03F                          IF   (1-CHECKED)*FAST   
                              JMP   fnext   ; (the fast build: see "The fast build")
E03F                          ENDIF      
E03F                          IF   CHECKED   
                              JMP   next   
E03F                          ENDIF      
E03F                             ; ---- handlers of ! " # $ % & ' ( : they must start in this page -------------
E03F                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E03F                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E03F                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
E03F                             ; no bit 6, so // and /" give themselves). TOS walks along the string; the
E03F                             ; checked build keeps the address on the hardware stack meanwhile, for a Q
E03F                             ; report, and puts it back in TOS at the end (pq).
E03F                          IF   CHECKED   
                    PQ:       PLA      
                              STA   0,X   
                              PLA      
                              STA   1,X   
                              BCS   pdrop   ; the closing quote: drop it
                              CPX   #DSE   ; a NUL: Q, unless "$" had nothing on the
                              LDA   #"s"   ;   stack at all (X at the empty mark): s
                              BCS   eq1   
                    E_QUOTE:   LDA   #"Q"   ; a NUL: "$" or a string ran into the end
                    EQ1:      JMP   error   
                    H_PRINT:   LDA   1,X   
                              PHA      
                              LDA   0,X   
                              PHA      
                              BCC   pr0   ; always: the carry is clear on the way in
E03F                          ENDIF      
E03F                          IF   1-CHECKED   
E03F                H_PRINT:   EQU   pr0   
E03F                          ENDIF      
E03F   20 6D E4     PESC0:    JSR   pesc   ; (an escape, and back into the loop)
E042   20 9E E2     PR0:      JSR   tosget   
E045   C9 22                  CMP   #22h   
E047                          IF   1-CHECKED   
E047   F0 30                  BEQ   pdrop   
E049                          ENDIF      
E049                          IF   CHECKED   
                              BEQ   pq   ; the closing quote, with the carry set
                              TAY      ; (Y is free here)
                              BEQ   pq   ; a NUL, with the carry clear
E049                          ENDIF      
E049   C9 2F                  CMP   #"/"   
E04B   D0 0D                  BNE   pr1   
E04D   20 9E E2               JSR   tosget   
E050   C9 60                  CMP   #60h   
E052   90 04                  BCC   pr2   
E054   C9 7F                  CMP   #7Fh   
E056   90 E7                  BCC   pesc0   ; 60h-7Eh, and the carry is clear
E058   29 BF        PR2:      AND   #0BFh   
E05A   20 03 FF     PR1:      JSR   CONOUT   
E05D   4C 42 E0               JMP   pr0   
E060                             ; 22h pushes the address of the text after it and skips the string.
E060   20 22 E5     H_STR:    JSR   puship   
E063                          IF   CHECKED   
                              JSR   skipstr   
                              BEQ   e_quote   ; it ran into the end: the place is the 22h
                              RTS      
E063                          ENDIF      
E063                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E063                             ; the next character, so "/"" does not end it.
E063                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E063                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E063                             ; text ended first (a NUL, also one just after "/").
E063                          IF   1-CHECKED   
E063   20 A8 E5     SKIPSTR:   JSR   getc   
E066   C9 2F                  CMP   #"/"   
E068   F0 05                  BEQ   ss0   
E06A   C9 22                  CMP   #22h   
E06C   D0 F5                  BNE   skipstr   
E06E   60                     RTS      
E06F   20 AB E5     SS0:      JSR   incip   
E072   D0 EF                  BNE   skipstr   ; A is "/" here
E074                          ENDIF      
E074                          IF   CHECKED   
                    SKIPSTR:   JSR   getc   
                              BEQ   ss9   ; the end
                              CMP   #"/"   
                              BNE   ss1   
                              JSR   getc   ; the escaped character
                              BNE   skipstr   
                    SS9:      RTS      ; the end, just after "/"
                    SS1:      CMP   #22h   
                              BNE   skipstr   
                              LSR      ; A = 11h, Z clear
                              RTS      
E074                          ENDIF      
E074   B5 00        H_EMIT:   LDA   0,X   ; "'"
E076   20 03 FF               JSR   CONOUT   
E079   E8           PDROP:    INX      ; a drop for this page's handlers
E07A   E8                     INX      
E07B   60                     RTS      
E07C                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E07C                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E07C                             ; leaves each remainder in the scratch under the top cell.
E07C   B5 01        H_NUM:    LDA   1,X   
E07E   10 08                  BPL   pn1   
E080   A9 2D                  LDA   #"-"   
E082   20 03 FF               JSR   CONOUT   
E085   20 4A E1               JSR   neg   
E088   A9 0A        PN1:      LDA   #10   
E08A   85 05                  STA   D0   
E08C   A9 00                  LDA   #0   
E08E   85 06                  STA   D1   
E090   48                     PHA      ; the end marker
E091   20 03 E4     PN2:      JSR   udiv   
E094   B5 FE                  LDA   0FEh,X   
E096   09 30                  ORA   #"0"   
E098   48                     PHA      
E099   B5 00                  LDA   0,X   
E09B   15 01                  ORA   1,X   
E09D   D0 F2                  BNE   pn2   
E09F   68           PN3:      PLA      
E0A0   F0 D7                  BEQ   pdrop   
E0A2   20 03 FF               JSR   CONOUT   
E0A5   4C 9F E0               JMP   pn3   
E0A8                             ; "!" ( n addr -- ): the low byte, then "."s ending for the high byte.
E0A8   B5 02        H_STORE:   LDA   2,X   
E0AA                          IF   CHECKED   
                              JSR   chkst   
E0AA                          ENDIF      
E0AA   81 00                  STA   (0,X)   
E0AC   20 A0 E2               JSR   inctos   
E0AF   B5 03                  LDA   3,X   
E0B1   4C 61 E1               JMP   st9   
E0B4   B5 00        H_SWAP:   LDA   0,X   ; "%"
E0B6   B4 02                  LDY   2,X   
E0B8   94 00                  STY   0,X   
E0BA   95 02                  STA   2,X   
E0BC   B5 01                  LDA   1,X   
E0BE   B4 03                  LDY   3,X   
E0C0   94 01                  STY   1,X   
E0C2   95 03                  STA   3,X   
E0C4   60                     RTS      
E0C5                             ; "&", and "|" and "^" further down: one byte of the result goes into NOS,
E0C5                             ; and X moves up one. Done twice, that is both bytes, and NOS has become TOS.
E0C5   20 C8 E0     H_AND:    JSR   an1   
E0C8   B5 00        AN1:      LDA   0,X   
E0CA   35 02                  AND   2,X   
E0CC   95 02                  STA   2,X   
E0CE   E8                     INX      
E0CF   60                     RTS      
E0D0                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E0D0                             ; the matching ")".
E0D0   20 35 E5     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E0D3                          IF   (1-CHECKED)*(1-QK)   
                              BEQ   skip   
E0D3                          ENDIF      
E0D3                          IF   CHECKED+QK   
E0D3   F0 17                  BEQ   skpar   
E0D5                          ENDIF      
E0D5                             ; pushn: take the step frame off, push the reading position on the return
E0D5                             ; stack, and go on. With the carry set (a word call) the reading position
E0D5                             ; then becomes the address in the letter cell at LET,Y.
E0D5   68           PUSHN:    PLA      
E0D6   68                     PLA      ; drop the step frame
E0D7   A5 01                  LDA   IP+1   
E0D9   48                     PHA      
E0DA   A5 00                  LDA   IP   
E0DC   48                     PHA      
E0DD   90 0A                  BCC   nxt   
E0DF   B9 00 04               LDA   LET,Y   
E0E2   85 00                  STA   IP   
E0E4   B9 01 04               LDA   LET+1,Y   
E0E7   85 01                  STA   IP+1   
E0E9   4C 29 E0     NXT:      JMP   pnext   
E0EC                             ; ---- no handler starts between here and the next heading: these routines
E0EC                             ; ---- fill the space up to the page boundary and past it ---------------------
E0EC                             ; skip: read past text to the closer at this level, and return it in A.
E0EC                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0EC                             ; NUL first ends the program. (The checked build's skip is further down.)
E0EC                          IF   (1-CHECKED)*(1-QK)   
                    SKIP:     LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   endprog   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 22h, which matches nothing below
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
                    ENDPROG:   JMP   EXIT   
E0EC                          ENDIF      
E0EC                          IF   CHECKED   
                                 ; A false ( skips: the wrong closer for it is ].
                    SKPAR:    LDA   #"]"   
                              JMP   skip   
E0EC                          ENDIF      
E0EC                          IF   (1-CHECKED)*QK   
E0EC   4C 60 E3     SKPAR:    JMP   skip   ; (QK: the skip is further down)
E0EF                          ENDIF      
E0EF                          IF   (1-CHECKED)*QK*(1-FAST)   
E0EF                          ;*Macro unroll:  MULQ                    ; (QK: here, where the skip was)
E0EF   B5 03        MULQ:     LDA   3,X   ; (QK: here, where the skip was)
E0F1   F0 07                  BEQ   mq8   
E0F3   B5 01                  LDA   1,X   
E0F5   D0 29                  BNE   mq16   
E0F7   20 B4 E0               JSR   h_swap   
E0FA   A0 08        MQ8:      LDY   #8   
E0FC   A9 00                  LDA   #0   
E0FE   85 04                  STA   T0   
E100   56 02                  LSR   2,X   
E102   90 0D        MQ1:      BCC   mq2   
E104   85 05                  STA   T1   
E106   18                     CLC      
E107   A5 04                  LDA   T0   
E109   75 00                  ADC   0,X   
E10B   85 04                  STA   T0   
E10D   A5 05                  LDA   T1   
E10F   75 01                  ADC   1,X   
E111   6A           MQ2:      ROR      
E112   66 04                  ROR   T0   
E114   76 02                  ROR   2,X   
E116   88                     DEY      
E117   D0 E9                  BNE   mq1   
E119   A5 04                  LDA   T0   
E11B   95 03                  STA   3,X   
E11D   E8                     INX      
E11E   E8                     INX      
E11F   60                     RTS      
E120   A0 10        MQ16:     LDY   #16   
E122   A9 00                  LDA   #0   
E124   85 04                  STA   T0   
E126   56 03                  LSR   3,X   
E128   76 02                  ROR   2,X   
E12A   90 0D        MQ3:      BCC   mq4   
E12C   85 05                  STA   T1   
E12E   18                     CLC      
E12F   A5 04                  LDA   T0   
E131   75 00                  ADC   0,X   
E133   85 04                  STA   T0   
E135   A5 05                  LDA   T1   
E137   75 01                  ADC   1,X   
E139   6A           MQ4:      ROR      
E13A   66 04                  ROR   T0   
E13C   76 03                  ROR   3,X   
E13E   76 02                  ROR   2,X   
E140   88                     DEY      
E141   D0 E7                  BNE   mq3   
E143   E8                     INX      
E144   E8                     INX      
E145   60                     RTS      
E146                          ENDIF      
E146                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E146   B5 01        ABSV:     LDA   1,X   
E148   10 0D        NEGM:     BPL   ab9   
E14A                             ; neg: TOS = -TOS
E14A   38           NEG:      SEC      
E14B   A9 00        NEG1:     LDA   #0   
E14D   F5 00                  SBC   0,X   
E14F   95 00                  STA   0,X   
E151   A9 00                  LDA   #0   
E153   F5 01                  SBC   1,X   
E155   95 01                  STA   1,X   
E157   60           AB9:      RTS      
E158                             ; =============================================================================
E158                             ;  Page 2 of 3: handlers of ) * + , - . / : ; < = > ?
E158                             ; =============================================================================
E158   B5 00        H_DUP:    LDA   0,X   ; ":"
E15A   B4 01                  LDY   1,X   
E15C   4C 2E E5               JMP   pushay   
E15F                             ; "." ( c addr -- ), and the end of "!": store A at TOS, drop both cells.
E15F   B5 02        H_CSTORE:   LDA   2,X   
E161                ST9:         
E161                          IF   CHECKED   
                              JSR   chkst   
E161                          ENDIF      
E161   81 00                  STA   (0,X)   
E163   E8                     INX      
E164   E8                     INX      
E165   E8           DROP:     INX      ; ";"
E166   E8                     INX      
E167   60                     RTS      
E168                             ; "-" has two jobs: directly before a digit it starts a negative number.
E168   20 8E E5     H_SUB:    JSR   isdig   
E16B   90 0F                  BCC   negnum   
E16D   20 4A E1     SUB1:     JSR   neg   ; a - b = a + (-b)
E170   18                     CLC      
E171                             ; "+": one byte at a time, as the logic operators do; the carry goes across.
E171                             ; It ends with A = the high byte of the sum.
E171   20 74 E1     H_ADD:    JSR   ad1   
E174   B5 00        AD1:      LDA   0,X   
E176   75 02                  ADC   2,X   
E178   95 02                  STA   2,X   
E17A   E8                     INX      
E17B   60                     RTS      
E17C   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E17E   20 5C E5               JSR   digit   ; (comes back with the carry set)
E181   B0 C7                  BCS   neg   ; always: the number, negated
E183                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E183                             ; clear for true, and bool turns it into -1 (true) or 0.
E183   20 B4 E0     H_GT:     JSR   h_swap   ; a > b is b < a
E186   B5 02        H_LT:     LDA   2,X   
E188   D5 00                  CMP   0,X   
E18A   B5 03                  LDA   3,X   
E18C   F5 01                  SBC   1,X   
E18E   70 02                  BVS   lt1   
E190   49 80                  EOR   #80h   
E192   0A           LT1:      ASL      
E193   E8                     INX      
E194   E8                     INX      ; (keeps the carry; X is never 0)
E195   D0 07                  BNE   bool   ; always
E197   20 6D E1     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E19A   15 00                  ORA   0,X   
E19C   C9 01                  CMP   #1   ; carry clear if A = 0
E19E   A9 00        BOOL:     LDA   #0   
E1A0   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E1A2   95 00                  STA   0,X   
E1A4   95 01                  STA   1,X   
E1A6   60                     RTS      
E1A7                             ; "*": the classic shift-right multiply. The multiplier is the NOS cell: it
E1A7                             ; leaves from the bottom while the product comes in at the top, through
E1A7                             ; A:T0 above it; after 16 rounds the cell holds the low 16 bits, which are
E1A7                             ; all that is kept. Dropping TOS (the multiplicand) leaves it on top.
E1A7                          IF   1-QK   
                    H_MUL:    LDY   #16   ; the round count
                              LDA   #0   
                              STA   T0   ; A:T0 = the upper half
                              LSR   3,X   
                              ROR   2,X   ; the first multiplier bit
                    ML1:      BCC   ml2   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              LDA   T1   
                              ADC   1,X   ; upper half += the multiplicand
                    ML2:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   ; everything one place right; next bit out
                              DEY      
                              BNE   ml1   
                              INX      
                              INX      
                              RTS      
E1A7                          ENDIF      
E1A7                          IF   QK   
E1A7   4C EF E0     H_MUL:    JMP   mulq   ; (QK: see Speed-ups)
E1AA                          ENDIF      
E1AA                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E1AA                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E1AA                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E1AA                             ; it stops with Z.
E1AA                             ; b's cell is dropped once D holds |b|; udiv then leaves the remainder just
E1AA                             ; where that cell was, so stepping X back down makes it the top cell.
E1AA                          IF   CHECKED   
                    E_ZERO:   LDA   #"Z"   ; divide by zero, the stack as it was
                              JMP   error   
E1AA                          ENDIF      
E1AA                H_DIV:       
E1AA                          IF   CHECKED   
                              LDA   0,X   
                              ORA   1,X   
                              BEQ   e_zero   
E1AA                          ENDIF      
E1AA   B5 03                  LDA   3,X   
E1AC   48                     PHA      ; a's sign: for r
E1AD   55 01                  EOR   1,X   
E1AF   48                     PHA      ; a xor b: for q
E1B0   20 46 E1               JSR   absv   
E1B3   B5 00                  LDA   0,X   
E1B5   85 05                  STA   D0   
E1B7   B5 01                  LDA   1,X   
E1B9   85 06                  STA   D1   ; D = |b|
E1BB   E8                     INX      
E1BC   E8                     INX      
E1BD   20 46 E1               JSR   absv   ; TOS = |a|
E1C0   20 03 E4               JSR   udiv   ; TOS = q
E1C3   68                     PLA      
E1C4   20 48 E1               JSR   negm   ; q's sign
E1C7   CA                     DEX      
E1C8   CA                     DEX      ; r on top
E1C9   68                     PLA      
E1CA   4C 48 E1               JMP   negm   ; r's sign
E1CD   A1 00        H_CFETCH:   LDA   (0,X)   ; ","
E1CF   95 00        SETA:     STA   0,X   ; TOS = A
E1D1   A9 00                  LDA   #0   
E1D3   95 01                  STA   1,X   
E1D5   60                     RTS      
E1D6                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E1D6                             ; drops it and carries on. It uses "]"s code, entered past its SEC: with the
E1D6                             ; carry clear, as it is here, the address popped is pushed back.
E1D6   20 35 E5     H_CLOSE:   JSR   flag   
E1D9   F0 6C                  BEQ   rdrop   
E1DB                          IF   1-QK   
                              BNE   ret1   ; always
E1DB                          ENDIF      
E1DB                          IF   QK   
E1DB   4C 0E E3               JMP   closeq   ; (QK: see Speed-ups)
E1DE                          ENDIF      
E1DE                             ; "?" ( n -- c ) or ( -n -- addr )
E1DE                             ;   n > 0: wait about n ms for a key; 0 if none came
E1DE                             ;   n = 0: wait for a key
E1DE                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E1DE                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E1DE   B5 01        H_KEY:    LDA   1,X   
E1E0   30 1E                  BMI   line   
E1E2   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E1E4   20 A0 E4     KT2:      JSR   getk   
E1E7   D0 E6                  BNE   seta   
E1E9   88                     DEY      
E1EA   D0 F8                  BNE   kt2   
E1EC   B5 00                  LDA   0,X   ; count the millisecond off:
E1EE   D0 06                  BNE   kt4   
E1F0   B5 01                  LDA   1,X   
E1F2   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E1F4   D6 01                  DEC   1,X   
E1F6   D6 00        KT4:      DEC   0,X   
E1F8   D0 E8                  BNE   kt1   
E1FA   B5 01                  LDA   1,X   
E1FC   D0 E4                  BNE   kt1   
E1FE   F0 CF                  BEQ   seta   ; always: the time ran out, A = 0
E200                             ; ---- no handler starts between here and the next heading --------------------
E200                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E200                             ; (stored, not echoed), every other key is stored and echoed until the line
E200                             ; is full. Y = the length so far; T0 = the most allowed.
E200   20 4A E1     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E203   D0 04                  BNE   ln0   
E205   B5 00                  LDA   0,X   
E207   10 02                  BPL   ln1   
E209   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E20B   85 04        LN1:      STA   T0   
E20D   A0 00                  LDY   #0   
E20F   F0 03                  BEQ   ln2   ; always
E211   20 03 FF     LN3:      JSR   CONOUT   
E214   20 A0 E4     LN2:      JSR   getk   
E217   F0 FB                  BEQ   ln2   
E219   C9 0D                  CMP   #13   
E21B   F0 14                  BEQ   ln5   
E21D   C9 08                  CMP   #8   
E21F   F0 0A                  BEQ   ln4   
E221   C4 04                  CPY   T0   
E223   B0 EF                  BCS   ln2   ; full
E225   99 80 04               STA   LINEBUF,Y   
E228   C8                     INY      
E229   D0 E6                  BNE   ln3   ; always: echo it
E22B   88           LN4:      DEY      ; Backspace: one back, and echo it,
E22C   10 E3                  BPL   ln3   
E22E   C8                     INY      ;   unless the line was empty
E22F   F0 E3                  BEQ   ln2   ; always
E231   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E234   A9 80                  LDA   #<LINEBUF   
E236   A0 04                  LDY   #>LINEBUF   
E238   4C 30 E5               JMP   setay   ; TOS = the line's address
E23B                             ; =============================================================================
E23B                             ;  Page 3 of 3: handlers of @ [ \ ] ^ _ ` 00bbIHwg ~
E23B                             ; =============================================================================
E23B                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E23B                             ; drops the block start, "]" returns.
E23B   20 35 E5     H_BREAK:   JSR   flag   
E23E   F0 66                  BEQ   tg1   ; (an RTS)
E240                          IF   CHECKED   
                              LDA   #0   ; \ takes either closer
E240                          ENDIF      
E240   20 60 E3               JSR   skip   
E243   C9 29                  CMP   #")"   
E245   D0 06                  BNE   h_ret   
E247   68           RDROP:    PLA      
E248   68                     PLA      
E249   68                     PLA      
E24A   68                     PLA      ; (the block start's high byte: never 0)
E24B   D0 28                  BNE   nxt2   ; always
E24D                             ; "]" returns: pull an address and jump to it. ")" comes in at ret1 with the
E24D                             ; carry clear, and then the address is pushed back.
E24D   38           H_RET:    SEC      
E24E                RET1:        
E24E   68                     PLA      
E24F   68                     PLA      ; drop the step frame
E250   68                     PLA      
E251   85 00                  STA   IP   
E253   68                     PLA      
E254   85 01                  STA   IP+1   
E256   B0 1D                  BCS   nxt2   
E258   48                     PHA      ; ")": keep the block start
E259   A5 00                  LDA   IP   
E25B   48                     PHA      
E25C   4C 29 E0               JMP   pnext   ; a loop-back: the break check
E25F                             ; "{" TOS to the return stack, "}" return stack to TOS
E25F   68           H_TOR:    PLA      
E260   68                     PLA      
E261   B5 01                  LDA   1,X   
E263   48                     PHA      
E264   B5 00                  LDA   0,X   
E266   48                     PHA      
E267   E8                     INX      
E268   E8                     INX      
E269   D0 0A                  BNE   nxt2   ; always: X is never 0
E26B   68           H_FROMR:   PLA      
E26C   68                     PLA      
E26D   CA                     DEX      
E26E   CA                     DEX      
E26F   68                     PLA      
E270   95 00                  STA   0,X   
E272   68                     PLA      
E273   95 01                  STA   1,X   
E275   4C 39 E0     NXT2:     JMP   next   
E278                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E278   4C 4B E1     H_NOT:    JMP   neg1   
E27B   20 7E E2     H_XOR:    JSR   xr1   
E27E   B5 00        XR1:      LDA   0,X   
E280   55 02                  EOR   2,X   
E282   95 02                  STA   2,X   
E284   E8                     INX      
E285   60                     RTS      
E286   20 89 E2     H_OR:     JSR   or1   
E289   B5 00        OR1:      LDA   0,X   
E28B   15 02                  ORA   2,X   
E28D   95 02                  STA   2,X   
E28F   E8                     INX      
E290   60                     RTS      
E291   A1 00        H_FETCH:   LDA   (0,X)   ; "@"
E293   A8                     TAY      
E294   20 A0 E2               JSR   inctos   
E297   A1 00                  LDA   (0,X)   
E299   95 01                  STA   1,X   
E29B   94 00                  STY   0,X   
E29D   60                     RTS      
E29E                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E29E   A1 00        TOSGET:   LDA   (0,X)   
E2A0   F6 00        INCTOS:   INC   0,X   
E2A2   D0 02                  BNE   tg1   
E2A4   F6 01                  INC   1,X   
E2A6   60           TG1:      RTS      
E2A7                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E2A7                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E2A7                             ; the body"s address instead. Either way it then skips to the matching "]'.
E2A7                             ; (The unchecked build takes anything that is not a letter as the space; the
E2A7                             ; checked build stops on it.)
E2A7                          IF   CHECKED   
                    DEF1:     CPY   #" "-"A"+256   
                              BEQ   def2   
                                 ; W: anything but a letter or a space after [. The place is that character,
                                 ; one past the [.
                              INC   PLACE   
                              BNE   eb1   
                              INC   PLACE+1   
                    EB1:      LDA   #"W"   
                              JMP   error   
E2A7                          ENDIF      
E2A7   20 A8 E5     H_DEF:    JSR   getc   
E2AA   38                     SEC      
E2AB   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E2AD   A8                     TAY      ;   lands 64 bytes up
E2AE   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E2B0   C9 1A                  CMP   #26   
E2B2                          IF   1-CHECKED   
E2B2   B0 0F                  BCS   def2   ; not a letter
E2B4                          ENDIF      
E2B4                          IF   CHECKED   
                              BCS   def1   
E2B4                          ENDIF      
E2B4   98                     TYA      
E2B5   0A                     ASL      
E2B6   A8                     TAY      ; Y -> the cell
E2B7   A5 00                  LDA   IP   
E2B9   99 00 04               STA   LET,Y   
E2BC   A5 01                  LDA   IP+1   
E2BE   99 01 04               STA   LET+1,Y   
E2C1   D0 03                  BNE   dsk   ; always: no program is in page zero
E2C3   20 22 E5     DEF2:     JSR   puship   ; an anonymous block: push its address
E2C6                DSK:         
E2C6                          IF   CHECKED   
                              LDA   #")"   ; the wrong closer for [
E2C6                          ENDIF      
E2C6   4C 60 E3               JMP   skip   
E2C9                             ; ---- machine code: the grave
E2C9                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E2C9                             ; are stored from addr until a non-hex character; then a RET (60h) is
E2C9                             ; written and its address is left. An odd last digit is consumed and dropped.
E2C9                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E2C9                             ; contract in the header.
E2C9   20 97 E5     H_GRAVE:   JSR   rdhex   
E2CC   B0 1C                  BCS   exec   
E2CE   0A           HX1:      ASL      
E2CF   0A                     ASL      
E2D0   0A                     ASL      
E2D1   0A                     ASL      
E2D2   85 04                  STA   T0   
E2D4   20 97 E5               JSR   rdhex   
E2D7   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E2D9   05 04                  ORA   T0   
E2DB   81 00                  STA   (0,X)   ; (never checked)
E2DD   20 A0 E2               JSR   inctos   
E2E0   20 97 E5               JSR   rdhex   
E2E3   90 E9                  BCC   hx1   
E2E5   A9 60        HX2:      LDA   #60h   
E2E7   81 00                  STA   (0,X)   
E2E9   60                     RTS      
E2EA   B5 00        EXEC:     LDA   0,X   
E2EC   85 04                  STA   T0   
E2EE   B5 01                  LDA   1,X   
E2F0   85 05                  STA   T1   
E2F2   E8                     INX      ; the address is consumed
E2F3   E8                     INX      
E2F4   6C 04 00               JMP   (T0)   
E2F7                             ; ---- "_" is the last handler: its body may leave the page
E2F7                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E2F7                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E2F7                          IF   1-CHECKED   
E2F7   AD 7C 04     H_ALLOC:   LDA   HEAP   
E2FA   A8                     TAY      
E2FB   75 00                  ADC   0,X   
E2FD   8D 7C 04               STA   HEAP   
E300   94 00                  STY   0,X   
E302   AD 7D 04               LDA   HEAP+1   
E305   A8                     TAY      
E306   75 01                  ADC   1,X   
E308   8D 7D 04               STA   HEAP+1   
E30B   94 01                  STY   1,X   
E30D   60                     RTS      
E30E                          ENDIF      
E30E                             ; The checked build works the new top out first, in T0 and Y, and stops with
E30E                             ; H, the count still on the stack, if it is at or past the limit, below the
E30E                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E30E                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E30E                             ; a signed number from -8000h, so the add overflows exactly when the true
E30E                             ; sum leaves 0000h-FFFFh.
E30E                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   0,X   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   1,X   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   0,X   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   1,X   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the address in the top cell is in the program's own
                                 ; space, from the letter page up to the heap limit. Keeps A and Y.
                    CHKST:    PHA      
                              LDA   1,X   
                              CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              PLA      
                              RTS      
E30E                          ENDIF      
E30E                             ; =============================================================================
E30E                             ;  The rest: no handler starts past this point
E30E                             ; =============================================================================
E30E                          IF   1-QK   
                              ;*Macro unroll:  UDIV
                    UDIV:     LDA   #0   
                              STA   0FEh,X   
                              STA   0FFh,X   
                              LDA   D0   
                              EOR   #2   
                              ORA   D1   
                              BNE   ud0   
                              LSR   1,X   
                              ROR   0,X   
                              ROL   0FEh,X   
                              RTS      
                    UD0:      LDY   #16   
                    UD1:      ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              STA   T0   
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   ud2   
                              STA   0FFh,X   
                              LDA   T0   
                              STA   0FEh,X   
                              INC   0,X   
                    UD2:      DEY      
                              BNE   ud1   
                              RTS      
E30E                          ENDIF      
E30E                          IF   QK   
E30E                             ;  ---- Speed-ups (QK builds) ---------------------------------------------
E30E                             ;  "*" is at mulq (in page 1 unchecked, to keep the handlers' pages; here
E30E                             ;  checked and in the fast build), x@ and x! (unchecked) at lowq.
E30E                          ENDIF      
E30E                          IF   CHECKED*QK*(1-FAST)   
