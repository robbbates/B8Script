                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
E483                          ENDIF      
E483                          IF   FAST   
                                 ; 0-9: push the digit; more digits go on through rdnum. A character that
                                 ; is not a digit is dispatched from A, as it has been read already.
                    FD0:      DEX      ; 0
                              DEX      
                              LDA   #0   
                              STA   0,X   
                              LDA   #0   
                              STA   1,X   
                              TAY      
                              LDA   (IP),Y   
                              CMP   #3Ah   
                              BCS   fd0a   
                              CMP   #30h   
                              BCC   fd0a   
                              JMP   fdm   ; more digits
                              ;*Macro unroll: fd0a:   NEXTA
                    FD0A:     DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FD1:      DEX      ; 1
                              DEX      
                              LDA   #1   
                              STA   0,X   
                              LDA   #0   
                              STA   1,X   
                              TAY      
                              LDA   (IP),Y   
                              CMP   #3Ah   
                              BCS   fd1a   
                              CMP   #30h   
                              BCC   fd1a   
                              JMP   fdm   ; more digits
                              ;*Macro unroll: fd1a:   NEXTA
                    FD1A:     DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FD2:      DEX      ; 2
                              DEX      
