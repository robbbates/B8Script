F223   63 C4        H_NOT:    COM   ,U   
F225   63 41                  COM   1,U   
F227   39                     RTS      
F228                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F228   EC 42        CMP:      LDD   2,U   
F22A   10 A3 C1               CMPD   ,U++   
F22D   39                     RTS      
F22E   8D F8        H_LT:     BSR   cmp   
F230   2D 0E                  BLT   true   
F232   4F           FALSE:    CLRA      
F233   5F                     CLRB      
F234   20 0D                  BRA   st   
F236   8D F0        H_GT:     BSR   cmp   
F238   2E 06                  BGT   true   
F23A   20 F6                  BRA   false   
F23C   8D EA        H_EQ:     BSR   cmp   
F23E   26 F2                  BNE   false   
F240   CC FF FF     TRUE:     LDD   #-1   
F243   ED C4        ST:       STD   ,U   
F245   39                     RTS      
F246                             ; =============================================================================
F246                             ;  Stack
F246                             ; =============================================================================
F246   EC C4        H_DUP:    LDD   ,U   
F248   36 06                  PSHU   D   
F24A   39                     RTS      
F24B   37 16        H_SWAP:   PULU   D,X   
F24D   36 06                  PSHU   D   
F24F   36 10                  PSHU   X   
F251   39                     RTS      
F252                             ; =============================================================================
F252                             ;  Storage. The cells in RAM are little-endian: the byte order is swapped
F252                             ;  between the stack (big-endian) and memory.
F252                             ; =============================================================================
F252   AE C4        H_FETCH:   LDX   ,U   ; "@"
F254   E6 84                  LDB   ,X   
F256   A6 01                  LDA   1,X   
F258   20 E9                  BRA   st   
F25A   AE C4        H_CFETCH:   LDX   ,U   ; ","
F25C   E6 84                  LDB   ,X   
F25E   4F                     CLRA      
F25F   20 E2                  BRA   st   
F261   AE C1        H_STORE:   LDX   ,U++   ; "!" ( n addr -- )
F263                          IF   CHECKED   
                              BSR   chkst   ; both bytes must be in the program's space
                              LEAX   1,X   
                              BSR   chkst   
                              LEAX   -1,X   
F263                          ENDIF      
F263   37 06                  PULU   D   
F265   E7 84                  STB   ,X   ; little-endian
F267   A7 01                  STA   1,X   
F269   39                     RTS      
F26A   AE C1        H_CSTORE:   LDX   ,U++   ; "." ( c addr -- )
F26C                          IF   CHECKED   
                              BSR   chkst   
F26C                          ENDIF      
F26C   37 06                  PULU   D   
F26E   E7 84                  STB   ,X   
F270   39                     RTS      
F271                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
F271   D6 7C        H_ALLOC:   LDB   <HEAP   
F273   96 7D                  LDA   <HEAP+1   
F275   1F 01                  TFR   D,X   ; the old pointer
F277   E3 C4                  ADDD   ,U   
F279                          IF   CHECKED   
                              LBCS   e_heap   ; a negative count wraps: too big
                              CMPD   #HEAPLIM*256   
                              LBHS   e_heap   
F279                          ENDIF      
F279   D7 7C                  STB   <HEAP   
F27B   97 7D                  STA   <HEAP+1   
F27D   AF C4                  STX   ,U   
F27F   39                     RTS      
F280                          IF   CHECKED   
                                 ; chkst: stop unless X is in the program's own space: from the letter page
                                 ; up to HEAPLIM, so the interpreter's stacks and whatever lies above the
                                 ; limit are safe. Memory above the heap top but below the limit is the
                                 ; program's own: Tiny BASIC keeps its lines there. Keeps every register.
                    CHKST:    CMPX   #LET   
                              LBLO   e_store   
                              CMPX   #HEAPLIM*256   
                              LBHS   e_store   
                              RTS      
F280                          ENDIF      
F280                             ; =============================================================================
F280                             ;  Flow control helpers
F280                             ; =============================================================================
F280                             ; =============================================================================
F280                             ;  Console
F280                             ; =============================================================================
F280                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
F280                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
F280                             ; that character itself.
F280   AE C4        H_PRINT:   LDX   ,U   
F282   A6 80        PR0:      LDA   ,X+   
F284   81 22                  CMPA   #22h   
F286   27 14                  BEQ   drop   
F288   81 2F                  CMPA   #"/"   
F28A   26 08                  BNE   pr1   
F28C   A6 80                  LDA   ,X+   
F28E   81 40                  CMPA   #40h   
F290   25 02                  BLO   pr1   
F292   84 BF                  ANDA   #0BFh   
F294   8D 09        PR1:      BSR   putc   
F296   20 EA                  BRA   pr0   
F298   A6 41        H_EMIT:   LDA   1,U   ; "'"
F29A   8D 03                  BSR   putc   
F29C   33 42        DROP:     LEAU   2,U   ; ";"
F29E   39                     RTS      
F29F                             ; =============================================================================
F29F                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
F29F                             ;  A = 0 with the zero flag set when none is waiting. It keeps B, X, Y, U.
F29F                             ;  In the unchecked build getk is the host's KEY routine itself.
F29F                             ; =============================================================================
F29F                          IF   1-CHECKED   
F29F                GETK:     EQU   KEY   ; the host's routine does the whole job; it
F29F                          ENDIF      ;   is too far for BSR, so it is called by JSR
F29F                          IF   CHECKED   
                    GETK:     LDA   <KEYBUF   ; a key held back by the break check
                              BEQ   gk1   
                              CLR   <KEYBUF   
                              TSTA      
                              RTS      
                    GK1:      JMP   KEY   
F29F                          ENDIF      
F29F                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   LDA   <KEYBUF   
                              BNE   cb9   ; one key is already held
                              BSR   getk   
                              BEQ   cb9   
                              CMPA   #3   
                              LBEQ   e_break   
                              STA   <KEYBUF   
                    CB9:      RTS      
F29F                          ENDIF      
F29F   7E FF 03     PUTC:     JMP   CONOUT   
F2A2                             ; "?" ( n -- c ) or ( -n -- addr )
F2A2                             ;   n > 0: wait about n ms for a key; 0 if none came
F2A2                             ;   n = 0: wait for a key
F2A2                             ;   n < 0: read a line of at most -n characters, with echo. n is not
F2A2                             ;          checked: the buffer holds 127 characters and the CR, so a
F2A2                             ;          program must ask for 127 or fewer.
F2A2   AE C4        H_KEY:    LDX   ,U   
F2A4   2B 17                  BMI   line   
F2A6   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F2A8                KT2:         
F2A8                          IF   1-CHECKED   
F2A8   BD FF 06               JSR   getk   
F2AB                          ENDIF      
F2AB                          IF   CHECKED   
                              BSR   getk   
F2AB                          ENDIF      
F2AB   26 0B                  BNE   kt3   
F2AD   5A                     DECB      
F2AE   26 F8                  BNE   kt2   
F2B0   30 1F                  LEAX   -1,X   
F2B2   26 F2                  BNE   kt1   ; A = 0 if the time ran out
F2B4   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F2B6   27 EE                  BEQ   kt1   ;   run it again, until a key comes
F2B8   6F C4        KT3:      CLR   ,U   
F2BA   A7 41                  STA   1,U   
F2BC   39                     RTS      
F2BD                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F2BD                             ; (stored, not echoed), every other key is stored and echoed until the line
F2BD                             ; is full. B = the length so far; the low byte of the top cell becomes the
F2BD                             ; most allowed (it holds minus the count on entry).
F2BD   60 41        LINE:     NEG   1,U   
F2BF   8E 82 80               LDX   #LINEBUF   
F2C2   5F                     CLRB      
F2C3                LN2:         
F2C3                          IF   1-CHECKED   
F2C3   BD FF 06               JSR   getk   
F2C6                          ENDIF      
F2C6                          IF   CHECKED   
                              BSR   getk   
F2C6                          ENDIF      
F2C6   27 FB                  BEQ   ln2   
F2C8   81 0D                  CMPA   #13   
F2CA   27 17                  BEQ   ln5   
F2CC   81 08                  CMPA   #8   
F2CE   27 0B                  BEQ   ln4   
F2D0   E1 41                  CMPB   1,U   
F2D2   24 EF                  BHS   ln2   ; full
F2D4   A7 80                  STA   ,X+   
F2D6   5C                     INCB      
F2D7   8D C6        LN3:      BSR   putc   
F2D9   20 E8                  BRA   ln2   
F2DB   5D           LN4:      TSTB      ; Backspace: nothing to take back?
F2DC   27 E5                  BEQ   ln2   
F2DE   5A                     DECB      
F2DF   30 1F                  LEAX   -1,X   
F2E1   20 F4                  BRA   ln3   ; echo it
F2E3   A7 84        LN5:      STA   ,X   ; A = 13
F2E5   CC 82 80               LDD   #LINEBUF   
F2E8   ED C4                  STD   ,U   
F2EA   39                     RTS      
F2EB                             ; =============================================================================
F2EB                             ;  Machine code: the grave
F2EB                             ; =============================================================================
F2EB                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
F2EB                             ; are stored from addr until a non-hex character; then a RTS (39h) is
F2EB                             ; written and its address is left. An odd last digit is consumed and dropped.
F2EB                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
F2EB                             ; code is entered by JSR (the dispatcher's own), with the address already
F2EB                             ; popped: U points at the top data cell (big-endian, 2 bytes, stack grows
F2EB                             ; down) and the return address is on top of S. The code may pop and push
F2EB                             ; data cells by changing U; on return the cell at ,U is the new TOS. It must
F2EB                             ; keep Y (the interpreter's reading position), DP and S (balanced), and
F2EB                             ; return with RTS. A, B, X, CC may change.
F2EB   8D 21        H_GRAVE:   BSR   hexc   ; the digit after the grave, if any
F2ED   24 1B                  BCC   exec   
F2EF   AE C4                  LDX   ,U   
F2F1   48           HX1:      ASLA      
F2F2   48                     ASLA      
F2F3   48                     ASLA      
F2F4   48                     ASLA      
F2F5                          IF   CHECKED   
                              JSR   chkst   
F2F5                          ENDIF      
F2F5   A7 84                  STA   ,X   ; the high nibble; an odd digit is overwritten
F2F7   8D 15                  BSR   hexc   
F2F9   24 08                  BCC   hx2   ; odd digit: already consumed, dropped
F2FB   AA 84                  ORA   ,X   
F2FD   A7 80                  STA   ,X+   
F2FF   8D 0D                  BSR   hexc   
F301   25 EE                  BCS   hx1   
F303                HX2:         
F303                          IF   CHECKED   
                              JSR   chkst   
F303                          ENDIF      
F303   86 39                  LDA   #39h   ; RTS
F305   A7 84                  STA   ,X   
F307   AF C4                  STX   ,U   
F309   39                     RTS      
F30A   AE C1        EXEC:     LDX   ,U++   
F30C   6E 84                  JMP   ,X   ; the code's RTS returns to the dispatcher
F30E                             ; hexc: read the character at IP. If it is a hex digit (0-9, A-F, a-f), return
F30E                             ; its value 0-15 in A with carry set and step over it; otherwise return with
F30E                             ; carry clear and the IP unchanged.
F30E   A6 A4        HEXC:     LDA   ,Y   
F310   80 30                  SUBA   #"0"   
F312   81 0A                  CMPA   #10   
F314   25 0C                  BLO   hv1   ; C = 1
F316   84 DF                  ANDA   #0DFh   
F318   80 11                  SUBA   #11h   
F31A   81 06                  CMPA   #6   
F31C   24 06                  BHS   hv9   ; C = 0
F31E   8B 0A                  ADDA   #10   
F320   81 10                  CMPA   #16   ; C = 1
F322   31 21        HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
F324   39           HV9:      RTS      
F325                             ; =============================================================================
F325                             ;  Checked build: break key and error reports
F325                             ; =============================================================================
F325                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte CMPX # (the 8Ch), so they all fall through to `error`.
                    E_STACK:   LDA   #"S"   ; data stack over or under
                              FCB   8Ch   
                    E_RSTACK:   LDA   #"R"   ; return stack over or under
                              FCB   8Ch   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C
                              FCB   8Ch   
                    E_HEAP:   LDA   #"H"   ; heap past the limit
                              FCB   8Ch   
                    E_STORE:   LDA   #"W"   ; write outside the program's space
                              FCB   8Ch   
                    E_BRACK:   LDA   #"D"   ; bad character after [
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                    ERROR:    LDS   #RSTOP   ; the stacks may be wrecked: start clean
                              LDU   #DSTOP   
                              JSR   CONOUT   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   #"@"   
                              JSR   CONOUT   
                              LDA   #" "   
                              JSR   CONOUT   
                              TFR   Y,D   
                              SUBD   #PROG+1   ; the character just read
                              PSHU   D   
                              JSR   pdec   
                              JMP   EXIT   
F325                          ENDIF      
F325                IMGEND:      


