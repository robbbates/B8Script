E402   60                     RTS      
E403                             ; udiv (QK): as the macro UDIV, and any power of two is shifts: 2, and 32,
E403                             ; 64, 256 and the like, which fixed point and byte work use all the time.
E403   A9 00        UDIV:     LDA   #0   
E405   95 FE                  STA   0FEh,X   
E407   95 FF                  STA   0FFh,X   
E409   A4 05                  LDY   D0   
E40B   A5 06                  LDA   D1   
E40D   D0 12                  BNE   uq1   ; 256 and up
E40F   98                     TYA      
E410   F0 38                  BEQ   ud0   ; by 0: the long way (it means nothing anyway)
E412   88                     DEY      
E413   98                     TYA      
E414   25 05                  AND   D0   
E416   D0 32                  BNE   ud0   ; not a power of two
E418   98                     TYA      ; by 2^k below 256: r = a & (2^k - 1),
E419   35 00                  AND   0,X   
E41B   95 FE                  STA   0FEh,X   
E41D   A5 05                  LDA   D0   ;   and q = a >> k
E41F   D0 1E                  BNE   uq2   ; always
E421   98           UQ1:      TYA      
E422   D0 26                  BNE   ud0   ; not a power of two
E424   A4 06                  LDY   D1   
E426   88                     DEY      
E427   98                     TYA      
E428   25 06                  AND   D1   
E42A   D0 1E                  BNE   ud0   ; not a power of two
E42C   98                     TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
E42D   35 01                  AND   1,X   
E42F   95 FF                  STA   0FFh,X   
E431   B5 00                  LDA   0,X   
E433   95 FE                  STA   0FEh,X   
E435   B5 01                  LDA   1,X   ;   and q = (a >> 8) >> (k - 8)
E437   95 00                  STA   0,X   
E439   A9 00                  LDA   #0   
E43B   95 01                  STA   1,X   
E43D   A5 06                  LDA   D1   
