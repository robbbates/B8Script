02AC   23                     INC   HL   
02AD   FE 60                  CP   60h   
02AF   38 04                  JR   C,pr0   
02B1   FE 7F                  CP   7Fh   
02B3   38 57                  JR   C,pesc   
02B5   E6 BF        PR0:      AND   0BFh   
02B7   EF           PR1:      RST   28h   
02B8   18 E7                  JR   h_print   
02BA                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
02BA                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02BA                          ENDIF      
02BA                          IF   CHECKED   
