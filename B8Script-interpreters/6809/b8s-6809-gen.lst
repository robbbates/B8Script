F29A   30 42                  LEAX   2,U   
F29C   8D 26                  BSR   absx   ; |a|
F29E   1F 31                  TFR   U,X   
F2A0   8D 22                  BSR   absx   ; |b|
F2A2   8D 26                  BSR   udiv   ; NOS = q, TOS = r
F2A4   8D C6                  BSR   h_swap   ; NOS = r, TOS = q
F2A6   1F 31                  TFR   U,X   
F2A8   6D E0                  TST   ,S+   
F2AA   2A 02                  BPL   dv1   
F2AC   8D 0D                  BSR   negx   ; q's sign
F2AE   30 42        DV1:      LEAX   2,U   
F2B0   6D E0                  TST   ,S+   
F2B2   2A 0F                  BPL   ng9   
