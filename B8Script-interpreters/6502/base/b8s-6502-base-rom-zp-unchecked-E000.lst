E3D3   F0 C7                  BEQ   sq1   ; "\" is nothing here
E3D5   90 F5                  BCC   sqo   ; [
E3D7   C6 06        SQC:      DEC   T2   ; ) ]
E3D9   10 C1                  BPL   sq1   
E3DB   20 F6 E3               JSR   sqip   ; the closer at this level: the IP past it
