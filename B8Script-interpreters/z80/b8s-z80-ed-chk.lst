                    FDM:      INC   BC   ; more digits: HL = HL * 10 + the digit
                              LD   D,H   
                              LD   E,L   
                              ADD   HL,HL   
                              ADD   HL,HL   
                              ADD   HL,DE   
                              ADD   HL,HL   
                              LD   E,A   
                              LD   D,0   
                              ADD   HL,DE   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JR   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FUA:      LD   (IY-1),B   ; A: call the word. The return address goes
                              LD   (IY-2),C   ;   on the return stack,
                              DEC   IY   
                              DEC   IY   
                              LD   BC,(LET+0)   ;   the IP becomes the word's body, and the break
                              EX   DE,HL   ;   key is looked at as rpushn would
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FUB:      LD   (IY-1),B   ; B: call the word. The return address goes
                              LD   (IY-2),C   ;   on the return stack,
                              DEC   IY   
                              DEC   IY   
                              LD   BC,(LET+2)   ;   the IP becomes the word's body, and the break
                              EX   DE,HL   ;   key is looked at as rpushn would
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FUC:      LD   (IY-1),B   ; C: call the word. The return address goes
                              LD   (IY-2),C   ;   on the return stack,
                              DEC   IY   
                              DEC   IY   
                              LD   BC,(LET+4)   ;   the IP becomes the word's body, and the break
                              EX   DE,HL   ;   key is looked at as rpushn would
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
