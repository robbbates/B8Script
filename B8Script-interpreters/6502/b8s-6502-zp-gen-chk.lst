E2C2                          ENDIF      
E2C2   4C EB E4               JMP   skip   
E2C5                             ; ---- the grave
E2C5                             ; The grave is a prefix: with the character after it, it is one command.
E2C5                             ; GTAB (after the three pages, with the handlers) holds each character with
E2C5                             ; its handler's address, less 1 for the RTS trick. A handler starts with the
E2C5                             ; carry SET and Y = three times its place in the table, and ends in RTS. A
E2C5                             ; character that is not in the table is unsafe: the unchecked build does
E2C5                             ; nothing, the checked build stops with W.
E2C5                H_GRAVE:      
E2C5                          IF   CHECKED   
E2C5   E6 08                  INC   PLACE   ; the place of anything that goes wrong in
E2C7   D0 02                  BNE   gr0   ;   one of these is the character after the
E2C9   E6 09                  INC   PLACE+1   ;   grave
E2CB                GR0:         
E2CB                          ENDIF      
E2CB   20 54 E6               JSR   getc   
E2CE   A0 24                  LDY   #GTABE-GTAB-3   
E2D0   D9 75 E3     GR1:      CMP   GTAB,Y   
E2D3   F0 08                  BEQ   gr2   
E2D5   88                     DEY      
E2D6   88                     DEY      
E2D7   88                     DEY      
E2D8   10 F6                  BPL   gr1   
E2DA                          IF   1-CHECKED   
                              RTS      ; no such code
E2DA                          ENDIF      
E2DA                          IF   CHECKED   
E2DA   4C 9C E2               JMP   eb1   ; no such code: W
E2DD                          ENDIF      
E2DD   B9 77 E3     GR2:      LDA   GTAB+2,Y   
E2E0   48                     PHA      
E2E1   B9 76 E3               LDA   GTAB+1,Y   
E2E4   48                     PHA      
E2E5   60                     RTS      ; to the handler
E2E6                             ; `! ( addr -- ): call the machine code at addr; see the contract in the
E2E6                             ; header.
E2E6   B5 00        EXEC:     LDA   0,X   
E2E8   85 04                  STA   T0   
E2EA   B5 01                  LDA   1,X   
E2EC   85 05                  STA   T1   
E2EE   E8                     INX      ; the address is consumed
E2EF   E8                     INX      
E2F0   6C 04 00               JMP   (T0)   
E2F3                             ; ---- "_" is the last handler: its body may leave the page
E2F3                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E2F3                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E2F3                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   0,X   
                              STA   HEAP   
                              STY   0,X   
                              LDA   HEAP+1   
                              TAY      
                              ADC   1,X   
                              STA   HEAP+1   
                              STY   1,X   
                              RTS      
E2F3                          ENDIF      
E2F3                             ; The checked build works the new top out first, in T0 and Y, and stops with
E2F3                             ; H, the count still on the stack, if it is at or past the limit, below the
E2F3                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E2F3                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E2F3                             ; a signed number from -8000h, so the add overflows exactly when the true
E2F3                             ; sum leaves 0000h-FFFFh.
E2F3                          IF   CHECKED   
E2F3   AD 7C 04     H_ALLOC:   LDA   HEAP   
E2F6   75 00                  ADC   0,X   
E2F8   85 04                  STA   T0   
E2FA   AD 7D 04               LDA   HEAP+1   
E2FD   49 80                  EOR   #80h   
E2FF   75 01                  ADC   1,X   
E301   70 25                  BVS   e_heap   ; wrapped
E303   49 80                  EOR   #80h   ; the new top's high byte
E305   C9 E0                  CMP   #HEAPLIM   
E307   B0 1F                  BCS   e_heap   ; at or past the limit
E309   A8                     TAY      
E30A   A5 04                  LDA   T0   
E30C   CD 38 04               CMP   PEND   
E30F   98                     TYA      
E310   ED 39 04               SBC   PEND+1   
E313   90 13                  BCC   e_heap   ; below the program's end
E315   AD 7C 04               LDA   HEAP   
E318   95 00                  STA   0,X   
E31A   A5 04                  LDA   T0   
E31C   8D 7C 04               STA   HEAP   
E31F   AD 7D 04               LDA   HEAP+1   
E322   95 01                  STA   1,X   
E324   8C 7D 04               STY   HEAP+1   
E327   60                     RTS      
E328                             ; Errors found by handlers. The stacks are as they were before the handler.
E328   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E32A   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E32B   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E32D   4C 6E E6               JMP   error   
E330                             ; chkst: stop unless the address in the top cell is in the program's own
E330                             ; space, from the letter page up to the heap limit. Keeps A and Y.
E330   48           CHKST:    PHA      
E331   B5 01                  LDA   1,X   
E333   C9 04                  CMP   #LETPAGE   
E335   90 F4                  BCC   e_store   
E337   C9 E0                  CMP   #HEAPLIM   
E339   B0 F0                  BCS   e_store   
E33B   68                     PLA      
E33C   60                     RTS      
E33D                          ENDIF      
