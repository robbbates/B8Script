  2404                              <1> ; =============================================================================
  2405                              <1> ;  The inner loop: read one character and sort it by range.
  2406                              <1> ;
  2407                              <1> ;    00h          end of program
  2408                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  2409                              <1> ;                 build stops on 80h-FFh: X)
  2410                              <1> ;    30h-39h      digit: read a whole number
  2411                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  2412                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  2413                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  2414                              <1> ;
  2415                              <1> ;  (The fast build has none of this: `next` is its table's dispatcher. See
  2416                              <1> ;  "The fast build".)
  2417                              <1> ; =============================================================================
  2418                              <1> %if FAST == 0
  2419                              <1> ; Digits: step back onto the first digit and read the whole number.
  2420 000009D8 53                  <1> digit:  push    ebx
  2421 000009D9 4E                  <1>         dec     esi
  2422                              <1>         CALLP   rdnum
   223                              <2>  %if P_%1
   224 000009DA FF55E4              <2>  call [V(p_%1)]
   225                              <2>  %else
   226                              <2>  call %1
   227                              <2>  %endif
  2423 000009DD FFE5                <1>         jmp     ebp
  2424                              <1> 
  2425                              <1>  %if SBASEU == 0
  2426                              <1> ; a-z: push the cell's address (the cell is the variable). (The unchecked
  2427                              <1> ; base build does x@ and x! in one step: its `lower` is after the window.)
  2428                              <1> lower:  push    ebx
  2429                              <1>         lea     ebx,[ARENA+LET+eax*2]
  2430                              <1>         jmp     ebp
  2431                              <1>  %endif
  2432                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  2433                              <1> ; next in reach)
  2434 000009DF 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  2435 000009E1 7505                <1>         jnz     next                    ; the rest are ignored
  2436 000009E3 E9F0FBFFFF          <1>         jmp     endprog
  2437                              <1> %endif
  2438                              <1> %if CHECKED
  2439                              <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  2440                              <1>         jmp     error
  2441                              <1> %endif
  2442                              <1> %if FAST
  2443                              <1> next:   NEXTF                           ; (the fast build: through the table)
  2444                              <1> %else
  2445                              <1> next:
  2446                              <1> %if CHECKED
  2447                              <1>         call    chkstk                  ; both stacks, once per character
  2448                              <1> %endif
