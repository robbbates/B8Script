0673   E1                     POP   HL   
0674   CD 5B 04               CALL   pnl   
0677   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
067E   CD 9B 02               CALL   pdec   
0681   D1                     POP   DE   
0682                          ENDIF      
0682                          IF   EDGEN   
0682   21 FF EF               LD   HL,HEAPLIM*256-1   
0685                          ENDIF      
0685                          IF   EDITOR*CPM   
                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
0685                          ENDIF      
0685                          IF   EDITOR   
0685   B7                     OR   A   
0686   ED 52                  SBC   HL,DE   
0688   CD 5B 04               CALL   pnl   
068B   46 72 65 65 20 22      DB   "Free ",22h   
0691   CD 9B 02               CALL   pdec   ; the room left for text and heap
0694   CD 5B 04               CALL   pnl   
0697   22                     DB   22h   
0698   C3 B4 04     GED1:     JP   edit   
069B                             ; delln: take line n (in HL) out: copy everything after it down over it.
069B   CD AB 06     DELLN:    CALL   find   
069E   54                     LD   D,H   
069F   5D                     LD   E,L   
06A0   CD B9 06               CALL   nxl   ; HL -> the next line
06A3   7E           DE1:      LD   A,(HL)   
06A4   12                     LD   (DE),A   
06A5   23                     INC   HL   
06A6   13                     INC   DE   
06A7   B7                     OR   A   
06A8   20 F9                  JR   NZ,de1   
06AA   C9                     RET      
06AB                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
06AB                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
06AB   EB           FIND:     EX   DE,HL   
06AC   21 00 83               LD   HL,PROG   
06AF   1B           FI1:      DEC   DE   
06B0   7A                     LD   A,D   
06B1   B3                     OR   E   
06B2   C8                     RET   Z   
06B3   CD B9 06               CALL   nxl   
06B6   20 F7                  JR   NZ,fi1   
06B8   C9                     RET      
06B9                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
06B9                             ; stop at the NUL that ends the text (and return zero).
06B9   7E           NXL:      LD   A,(HL)   
06BA   B7                     OR   A   
06BB   C8                     RET   Z   
06BC   23                     INC   HL   
06BD   FE 0A                  CP   10   
06BF   20 F8                  JR   NZ,nxl   
06C1   B7                     OR   A   
06C2   C9                     RET      
06C3                             ; prl: print the line at HL, to its LF; HL -> just past it.
06C3   7E           PRL:      LD   A,(HL)   
06C4   EF                     RST   28h   
06C5   7E                     LD   A,(HL)   
06C6   23                     INC   HL   
06C7   FE 0A                  CP   10   
06C9   20 F8                  JR   NZ,prl   
06CB   C9                     RET      
06CC                          ENDIF      
06CC                          IF   EDGEN   
06CC                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
06CC                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
06CC                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
06CC                             ; line with no end is given one. Nothing is echoed, and there is no check
06CC                             ; for running out of memory.
06CC   21 FF 82     CREAD:    LD   HL,PROG-1   
06CF   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
06D1   23                     INC   HL   ;   the line buffer's last, and spare)
06D2   CD 54 05     RD1:      CALL   ekey   
06D5   4F                     LD   C,A   
06D6   FE 1A                  CP   1Ah   
06D8   20 02                  JR   NZ,rd2   
06DA   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
06DC   FE 0A        RD2:      CP   10   
06DE   20 07                  JR   NZ,rd3   
06E0   2B                     DEC   HL   
06E1   BE                     CP   (HL)   
06E2   23                     INC   HL   
06E3   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
06E5   3E 0D                  LD   A,13   ; anywhere else it ends the line
06E7   77           RD3:      LD   (HL),A   
06E8   23                     INC   HL   
06E9   FE 0D                  CP   13   
06EB   20 03                  JR   NZ,rd4   
06ED   36 0A                  LD   (HL),10   ; after a CR goes a LF
06EF   23                     INC   HL   
06F0   79           RD4:      LD   A,C   
06F1   FE 1A                  CP   1Ah   
06F3   20 DD                  JR   NZ,rd1   
06F5   36 00                  LD   (HL),0   
06F7   18 9F                  JR   ged1   
06F9                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
06F9   21 00 83     CWRITE:   LD   HL,PROG   
06FC   7E           CW1:      LD   A,(HL)   
06FD   B7                     OR   A   
06FE   28 98                  JR   Z,ged1   
0700   EF                     RST   28h   
0701   23                     INC   HL   
0702   18 F8                  JR   cw1   
0704                          ENDIF      
0704                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0704                          ENDIF      
0704                             ; =============================================================================
0704                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0704                          ENDIF      
0704                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0704                          ENDIF      
0704                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
0704                          ENDIF      
0704                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0704                          ENDIF      
0704                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0704                          ENDIF      
0704                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0704                          ENDIF      
