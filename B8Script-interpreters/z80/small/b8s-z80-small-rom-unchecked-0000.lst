                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FSTORE:   EQU   fs_store   
                    FCSTORE:   EQU   fs_cstore   
