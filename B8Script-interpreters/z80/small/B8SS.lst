0686                          IF   CPM   
0686                             ; RAM pages, after the image
0686                CPAGE:    EQU   (imgend + 255) / 256   ; the skip cache (QK builds), first, so
0686                RSPAGE:   EQU   CPAGE + QK   ;   that the letter page is still the one
0686                DSPAGE:   EQU   RSPAGE + 1   ;   just below the program text
0686                LETPAGE:   EQU   RSPAGE + 2   
0686                PROG:     EQU   LETPAGE*256 + 256   
0686                          ENDIF      
0686                IMGEND:      


