0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-CPM*EDITOR*(1-CHECKED)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC and
                                 ; HL'; CONCLS, CONEOL and CONCUR also DE and HL.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 0A               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 C3 08               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 4B 06     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 B8 04               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 BC 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD D1 04               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LD   A,(BC)   
0138   03                     INC   BC   
0139   D6 21                  SUB   21h   ; A = c - 21h
013B   38 D4                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CP   0Fh   
013F   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0141   D6 0F                  SUB   0Fh   ; A = c - 30h
0143   FE 0A                  CP   0Ah   
0145   38 5F                  JR   C,digit   ; 30h-39h
0147   FE 11                  CP   11h   
0149   38 19                  JR   C,p3a   ; 3Ah-40h
014B   D6 11                  SUB   11h   ; A = c - 41h
014D   FE 1A                  CP   1Ah   
014F   38 61                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0151   FE 20                  CP   20h   
0153   38 0D                  JR   C,p5b   ; 5Bh-60h
0155   FE 3A                  CP   3Ah   
0157   38 53                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0159   FE 3E                  CP   3Eh   
015B                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
015B                          ENDIF      
015B                          IF   CHECKED   
015B   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
015D   D2 FD 04               JP   NC,e_hi   ; 80h-FFh: reserved
0160                          ENDIF      
0160   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0162   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0164   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0166                .macro PTABLE,
0166                             ; 
0166                 DB      h_store & 0FFh  ; !
0166                 DB      h_str & 0FFh    ; "
0166                 DB      h_num & 0FFh    ; #
0166                 DB      h_print & 0FFh  ; $
0166                 DB      h_swap & 0FFh   ; %
0166                 DB      h_and & 0FFh    ; &
0166                 DB      h_emit & 0FFh   ; '
0166                 DB      h_open & 0FFh   ; (
0166                 DB      h_close & 0FFh  ; )
0166                 DB      h_mul & 0FFh    ; *
0166                 DB      h_add & 0FFh    ; +
0166                 DB      h_cfetch & 0FFh ; ,
0166                 DB      h_sub & 0FFh    ; -
0166                 DB      h_cstore & 0FFh ; .
0166                 DB      h_div & 0FFh    ; /
0166                 DB      h_dup & 0FFh    ; :
0166                 DB      h_drop & 0FFh   ; ;
0166                 DB      h_lt & 0FFh     ; <
0166                 DB      h_eq & 0FFh     ; =
0166                 DB      h_gt & 0FFh     ; >
0166                 DB      h_key & 0FFh    ; ?
0166                 DB      h_fetch & 0FFh  ; @
0166                 DB      h_def & 0FFh    ; [
0166                 DB      h_break & 0FFh  ; \
0166                 DB      h_ret & 0FFh    ; ]
0166                 DB      h_xor & 0FFh    ; ^
0166                 DB      h_alloc & 0FFh  ; _
0166                 DB      h_grave & 0FFh  ; `
0166                 DB      h_tor & 0FFh    ; {
0166                 DB      h_or & 0FFh     ; |
0166                 DB      h_fromr & 0FFh  ; }
0166                 DB      h_not & 0FFh    ; ~
0166                .endm
0166                 
0166                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0166                             ; untouched, and A, DE free.
0166   C6 58        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0168   5F                     LD   E,A   
0169   16 04                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
016B   FE 6E                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016D   1A                     LD   A,(DE)   
016E   5F                     LD   E,A   ; the handler's low byte
016F                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
016F                          ENDIF      
016F                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
016F                          ENDIF      
016F                          IF   CPM   
016F   16 01                  LD   D,1   
0171   30 01                  JR   NC,pu1   
0173   14                     INC   D   ; its page: 1 + carry
0174                PU1:         
0174                          ENDIF      
0174   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0175   C9                     RET      ;   when the handler starts
0176                             ; The rest of the startup: here so that the generic reset code can reach it
0176                             ; with JR. st0: find the program's NUL; the heap starts after it.
0176                             ; (The editor build has its own copy of this, next to the editor.)
0176                             ; A checked build first clears the lower half of the letter page (A = 0):
0176                             ; every variable starts at 0, every word cell holds 0000h, the address an
0176                             ; undefined word is caught at (see e_hi), and no key is held back.
0176                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0176                          ENDIF      
0176                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0176                          ENDIF      
0176                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0176                          ENDIF      
0176                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0176                          ENDIF      ;   these)
0176                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0176                          ENDIF      
0176                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0176                          ENDIF      
0176                             ; In the unchecked generic editor build the table is here, in the first
0176                             ; page, which saves loading D twice. (The other builds have no room for it
0176                             ; here: theirs is further down.)
0176                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0176                          ENDIF      
0176                             ; =============================================================================
0176                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0176                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0176                             ;  is here too: it belongs to "`" and makes the page come out right.
0176                             ; =============================================================================
0176   D1           H_XOR:    POP   DE   
0177   7C                     LD   A,H   
0178   AA                     XOR   D   
0179   67                     LD   H,A   
017A   7D                     LD   A,L   
017B   AB                     XOR   E   
017C   6F                     LD   L,A   
017D   F7                     RST   30h   
017E   D1           H_OR:     POP   DE   
017F   7C                     LD   A,H   
0180   B2                     OR   D   
0181   67                     LD   H,A   
0182   7D                     LD   A,L   
0183   B3                     OR   E   
0184   6F                     LD   L,A   
0185   F7                     RST   30h   
0186   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0187   2B                     DEC   HL   
0188   F7                     RST   30h   
0189                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0189                             ; the same either way); TOS is the old pointer.
0189   ED 5B 7C 0B  H_ALLOC:   LD   DE,(HEAP)   
018D                          IF   CHECKED*CPM   
018D   7C                     LD   A,H   ; the count's sign, for chkhp
018E                          ENDIF      
018E   19                     ADD   HL,DE   ; the new top
018F                          IF   CHECKED   
018F   CD 07 05               CALL   chkhp   
0192                          ENDIF      
0192   22 7C 0B               LD   (HEAP),HL   
0195   EB                     EX   DE,HL   
0196   F7                     RST   30h   
0197   D9           EXEC:     EXX      
0198   22 34 0B               LD   (RSAVE),HL   ; machine code may change the alternates
019B   D9                     EXX      
019C   CD 2B 01               CALL   jphl   
019F   D9                     EXX      
01A0   2A 34 0B               LD   HL,(RSAVE)   
01A3   D9                     EXX      
01A4   E1                     POP   HL   
01A5   F7                     RST   30h   
01A6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01A6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01A6                             ; Digits: step back onto the first digit and read the whole number.
01A6   E5           DIGIT:    PUSH   HL   
01A7   0B                     DEC   BC   
01A8   CD C8 03               CALL   rdnum   
01AB   F7                     RST   30h   
01AC                             ; a-z: push the cell's address (the cell is the variable)
01AC   E5           LOWER:    PUSH   HL   
01AD   87                     ADD   A,A   
01AE   6F                     LD   L,A   
01AF   26 0B                  LD   H,LETPAGE   
01B1   F7                     RST   30h   
01B2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01B2                             ; the return stack, and the IP becomes the address in the letter's cell.
01B2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01B3   EB                     EX   DE,HL   ; park TOS
01B4   87                     ADD   A,A   
01B5   6F                     LD   L,A   
01B6   26 0B                  LD   H,LETPAGE   ; HL -> cell
01B8   4E                     LD   C,(HL)   
01B9   2C                     INC   L   
01BA   46                     LD   B,(HL)   ; IP = the word's body
01BB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01BC                             ; rpushn: move the top cell of the data stack (in memory) to the return
01BC                             ; stack, then next. Everything that pushes the return stack ends here.
01BC                             ; 
01BC                             ; The break key is looked at here, so at every word call and loop-back (and
01BC                             ; block entry and "{"), but only one time in 256: B', which nothing else
01BC                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
01BC                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
01BC                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
01BC                             ; both ways out.)
01BC   D9           RPUSHN:   EXX      
01BD   D1                     POP   DE   
01BE   2B                     DEC   HL   
01BF   72                     LD   (HL),D   
01C0   2B                     DEC   HL   
01C1   73                     LD   (HL),E   
01C2   05                     DEC   B   
01C3   D9                     EXX      
01C4   CC 78 04               CALL   Z,pollk   
01C7   F7                     RST   30h   
01C8                             ; ---- machine code: the grave -----------------------------------------------
01C8                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01C8                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01C8                             ; written and its address is left. An odd last digit is consumed and dropped.
01C8                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01C8                             ; code is entered by CALL with the data stack above the return address; it
01C8                             ; must keep BC, and on return the top cell becomes the new TOS.
01C8   CD 2C 04     H_GRAVE:   CALL   hexc   
01CB   30 CA                  JR   NC,exec   
01CD   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01CE   CD 2C 04               CALL   hexc   
01D1   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01D3   ED 6F                  RLD      ;   overwrites it
01D5   23                     INC   HL   ; ... and RLD shifts it up under the low one
01D6   CD 2C 04               CALL   hexc   
01D9   38 F2                  JR   C,hx1   
01DB   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01DD   F7                     RST   30h   
01DE                             ; ---- where the two pages meet ----------------------------------------------
01DE                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01DE                             ; are in falling code order for this), and where exactly differs between the
01DE                             ; builds: NPG1 follows. Every handler below these four must start in the
01DE                             ; second page, and every one above in the first; chktab.py checks both.
01DE                             ; "]" returns: pop an address and jump to it.
01DE   CF           H_RET:    RST   08h   
01DF   42                     LD   B,D   
01E0   4B                     LD   C,E   
01E1   F7           BRK1:     RST   30h   
01E2                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E2                             ; drops the block start, "]" returns. No closer at all ends the program.
01E2   7C           H_BREAK:   LD   A,H   
01E3   B5                     OR   L   
01E4   E1                     POP   HL   
01E5   28 FA                  JR   Z,brk1   
01E7   CD EF 03               CALL   skip   
01EA   B7                     OR   A   ; skip returns 0 for ")"
01EB   20 F1                  JR   NZ,h_ret   
01ED   CF           RDROP:    RST   08h   
01EE   F7                     RST   30h   
01EF                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EF                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EF                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EF                             ; (The unchecked build takes anything that is not a letter as the space; the
01EF                             ; checked build stops on it.)
01EF   0A           H_DEF:    LD   A,(BC)   
01F0   03                     INC   BC   
01F1   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01F3   5F                     LD   E,A   ;   lands 64 bytes up
01F4   E6 DF                  AND   0DFh   ; fold case
01F6   FE 1A                  CP   26   
01F8   30 0B                  JR   NC,def2   ; not a letter
01FA   CB 23                  SLA   E   
01FC   16 0B                  LD   D,LETPAGE   ; DE -> cell
01FE   79                     LD   A,C   
01FF   12                     LD   (DE),A   
0200   1C                     INC   E   
0201   78                     LD   A,B   
0202   12                     LD   (DE),A   
0203   18 09                  JR   skipnx   
0205                DEF2:        
0205                          IF   CHECKED   
0205   7B                     LD   A,E   
0206   FE DF                  CP   " "-"A"+256   
0208   C2 4F 05               JP   NZ,e_brack   ; anything but a letter or a space
020B                          ENDIF      
020B   E5                     PUSH   HL   ; an anonymous block: push its address
020C   60                     LD   H,B   
020D   69                     LD   L,C   
020E                SKIPNX:      
020E                          IF   CHECKED   
020E   0B                     DEC   BC   ; back onto the letter, so that skip finds its
020F                          ENDIF      ;   opener, the "[", just before where it starts
020F   CD EF 03     SKIPO:    CALL   skip   
0212   F7                     RST   30h   
0213   5E           H_FETCH:   LD   E,(HL)   ; "@"
0214   23                     INC   HL   
0215   56                     LD   D,(HL)   
0216   EB                     EX   DE,HL   
0217   F7                     RST   30h   
0218                             ; =============================================================================
0218                             ;  Handlers that must start in the image's second page.
0218                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0218                             ;  page.
0218                             ; =============================================================================
0218                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0218                             ; the matching ")".
0218   7C           H_OPEN:   LD   A,H   
0219   B5                     OR   L   
021A   E1                     POP   HL   
021B   28 F2                  JR   Z,skipo   
021D   C5                     PUSH   BC   ; the block starts at the IP
021E   18 9C                  JR   rpushn   
0220                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0220                             ; drops it and carries on.
0220   7C           H_CLOSE:   LD   A,H   
0221   B5                     OR   L   
0222   E1                     POP   HL   
0223   28 C8                  JR   Z,rdrop   
0225   CF                     RST   08h   ; pop the block start ...
0226   42                     LD   B,D   
0227   4B                     LD   C,E   
0228   C5                     PUSH   BC   
0229   18 91                  JR   rpushn   ; ... and push it back
022B                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022B                             ; "-" has two jobs: directly before a digit it starts a negative number.
022B   0A           H_SUB:    LD   A,(BC)   
022C   D6 30                  SUB   "0"   
022E   FE 0A                  CP   10   
0230   38 04                  JR   C,negnum   
0232   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0233   D1           H_ADD:    POP   DE   
0234   19                     ADD   HL,DE   
0235   F7                     RST   30h   
0236   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0237   CD C8 03               CALL   rdnum   
023A   E7                     RST   20h   
023B   F7                     RST   30h   
023C   D1           H_AND:    POP   DE   
023D   7C                     LD   A,H   
023E   A2                     AND   D   
023F   67                     LD   H,A   
0240   7D                     LD   A,L   
0241   A3                     AND   E   
0242   6F                     LD   L,A   
0243   F7                     RST   30h   
0244                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0244                             ; cells first. Flipping both sign bits turns a signed compare into an
0244                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0244                             ; carry into -1 or 0 with no branch.
0244   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0245   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0246   7C                     LD   A,H   
0247   EE 80                  XOR   80h   
0249   67                     LD   H,A   
024A   7A                     LD   A,D   
024B   EE 80                  XOR   80h   
024D   57                     LD   D,A   
024E   ED 52                  SBC   HL,DE   ; carry if HL < DE
0250   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0252   F7                     RST   30h   
0253   D1           H_EQ:     POP   DE   
0254   B7                     OR   A   
0255   ED 52                  SBC   HL,DE   
0257   7C                     LD   A,H   
0258   B5                     OR   L   
0259   FE 01                  CP   1   ; carry only if a - b = 0
025B   18 F3                  JR   tf   
025D                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
025D                             ; multiplier shifts up through A:C.
025D   D1           H_MUL:    POP   DE   ; DE = multiplicand
025E   C5                     PUSH   BC   
025F   7C                     LD   A,H   
0260   4D                     LD   C,L   ; A:C = multiplier
0261   21 00 00               LD   HL,0   
0264   06 10                  LD   B,16   
0266   29           MUL1:     ADD   HL,HL   
0267   CB 21                  SLA   C   
0269   17                     RLA      
026A   30 01                  JR   NC,mul2   
026C   19                     ADD   HL,DE   
026D   10 F7        MUL2:     DJNZ   mul1   
026F   C1                     POP   BC   
0270   F7                     RST   30h   
0271                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0271                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0271                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0271                             ; stops on it.
0271                H_DIV:       
0271                          IF   CHECKED   
0271   7C                     LD   A,H   
0272   B5                     OR   L   
0273   CA 4C 05               JP   Z,e_zero   
0276                          ENDIF      
0276   D1                     POP   DE   ; DE = a, HL = b
0277   D5                     PUSH   DE   ; a, for r's sign
0278   7A                     LD   A,D   
0279   AC                     XOR   H   
027A   F5                     PUSH   AF   ; S flag = sign of q
027B   CB 7C                  BIT   7,H   
027D   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0280   EB                     EX   DE,HL   
0281   CB 7C                  BIT   7,H   
0283   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0286   CD A0 03               CALL   udiv   ; HL = q, DE = r
0289   F1                     POP   AF   
028A   FC 20 01               CALL   M,neg16   ; q's sign
028D   EB                     EX   DE,HL   ; HL = r, DE = q
028E   F1                     POP   AF   ; A = a's high byte
028F   B7                     OR   A   
0290   FC 20 01               CALL   M,neg16   ; r's sign
0293   D5                     PUSH   DE   ; q under r
0294   F7                     RST   30h   
0295                             ; ---- stack and storage -----------------------------------------------------
0295   E5           H_DUP:    PUSH   HL   ; ":"
0296   F7                     RST   30h   
0297   E3           H_SWAP:   EX   (SP),HL   ; "%"
0298   F7                     RST   30h   
0299                             ; (The checked build tests the address before it takes the value off the
0299                             ; stack, so that an error report shows both.)
0299                H_CSTORE:      ; "." ( c addr -- )
0299                          IF   CHECKED   
0299   CD 24 05               CALL   chkst   
029C                          ENDIF      
029C   D1                     POP   DE   
029D   73                     LD   (HL),E   
029E   DF           H_DROP:   RST   18h   ; ";" is this one byte
029F                H_STORE:      ; "!" ( n addr -- )
029F                          IF   CHECKED   
029F   CD 24 05               CALL   chkst   
02A2                          ENDIF      
02A2   D1                     POP   DE   
02A3   73                     LD   (HL),E   
02A4   23                     INC   HL   
02A5   72                     LD   (HL),D   
02A6   DF                     RST   18h   
02A7                             ; ---- console ---------------------------------------------------------------
02A7                             ; 22h pushes the address of the text after it and skips the string.
02A7   E5           H_STR:    PUSH   HL   
02A8   60                     LD   H,B   
02A9   69                     LD   L,C   
02AA   CD DE 03               CALL   skipstr   
02AD                          IF   CHECKED   
02AD   B7                     OR   A   ; 0: the text ran out before the closing quote
02AE   CA 44 05               JP   Z,e_quote   
02B1                          ENDIF      
02B1   F7                     RST   30h   
02B2                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02B2                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02B2                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02B2                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02B2                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02B2                          ENDIF      
02B2                          IF   CHECKED   
02B2                             ; (The checked build has the loop as a routine, prstr, which the error
02B2                             ; report uses too. The address is kept meanwhile, for a report: it shows
02B2                             ; the stack as it was before the "$". /~ comes back to hp1.)
02B2   22 34 0B     H_PRINT:   LD   (RSAVE),HL   
02B5   CD 0B 03     HP1:      CALL   prstr   
02B8   DF                     RST   18h   
02B9                          ENDIF      
02B9   7D           H_EMIT:   LD   A,L   ; "'"
02BA   EF                     RST   28h   
02BB   DF           PR9:      RST   18h   
02BC                             ; "#" prints TOS as a signed decimal number, with no space after it.
02BC   CD 3E 04     H_NUM:    CALL   psgn   
02BF   DF                     RST   18h   
02C0                             ; "?" ( n -- c ) or ( -n -- addr )
02C0                             ;   n > 0: wait about n ms for a key; 0 if none came
02C0                             ;   n = 0: wait for a key
02C0                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C0                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C0   CB 7C        H_KEY:    BIT   7,H   
02C2   20 19                  JR   NZ,line   
02C4   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02C6   CD A6 04     KT2:      CALL   getk   
02C9   20 0E                  JR   NZ,kt3   
02CB   1D                     DEC   E   
02CC   20 F8                  JR   NZ,kt2   
02CE   7C                     LD   A,H   ; 0? never counts down: it waits
02CF   B5                     OR   L   
02D0   28 F2                  JR   Z,kt1   
02D2   2B                     DEC   HL   
02D3   7C                     LD   A,H   
02D4   B5                     OR   L   
02D5   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02D7   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02D8   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02D9   6F           KT3:      LD   L,A   
02DA   26 00                  LD   H,0   
02DC   F7                     RST   30h   
02DD                             ; Backspace takes the last character back (and is echoed as it
02DD                             ; is), CR ends (stored, not echoed), every other key is stored and
02DD                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02DD                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02DD                             ; is the place in the line: D holds the L of a full line.
02DD   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E0   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02E1   9F                     SBC   A,A   
02E2   A5                     AND   L   ; (0 for a count that is too big)
02E3   2F                     CPL      
02E4   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
02E5                             ;   at most
02E5   21 80 0B               LD   HL,LINEBUF   
02E8   CD A6 04     LN2:      CALL   getk   
02EB   28 FB                  JR   Z,ln2   
02ED   FE 0D                  CP   13   
02EF   28 16                  JR   Z,ln5   
02F1   FE 08                  CP   8   
02F3   28 0B                  JR   Z,ln4   
02F5   5F                     LD   E,A   
02F6   7D                     LD   A,L   
02F7   BA                     CP   D   
02F8   28 EE                  JR   Z,ln2   ; full
02FA   73                     LD   (HL),E   
02FB   2C                     INC   L   
02FC   7B                     LD   A,E   
02FD   EF           LN3:      RST   28h   
02FE   18 E8                  JR   ln2   
0300   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0301   FA FD 02               JP   M,ln3   ;   unless the line was empty (L left the
0304   2C                     INC   L   ;   upper half of the page)
0305   18 E1                  JR   ln2   
0307   77           LN5:      LD   (HL),A   ; the CR
0308   2E 80                  LD   L,LINEBUF & 0FFh   
030A   F7                     RST   30h   
030B                             ; =============================================================================
030B                             ;  More routines (no handler starts past this point)
030B                             ; =============================================================================
030B                          IF   CHECKED   
030B                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
030B                             ; "$", and the texts of the report). A NUL first is an error: Q.
030B   7E           PRSTR:    LD   A,(HL)   
030C   23                     INC   HL   
030D   FE 22                  CP   22h   
030F   C8                     RET   Z   
0310   B7                     OR   A   
0311   CA 3A 05               JP   Z,e_dollar   
0314   FE 2F                  CP   "/"   
0316   20 0C                  JR   NZ,prs1   
0318   7E                     LD   A,(HL)   
0319   23                     INC   HL   
031A   FE 60                  CP   60h   
031C   38 04                  JR   C,prs0   
031E   FE 7F                  CP   7Fh   
0320   38 11                  JR   C,pesc   
0322   E6 BF        PRS0:     AND   0BFh   
0324   EF           PRS1:     RST   28h   
0325   18 E4                  JR   prstr   
0327                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0327                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0327                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0327                             ; pnl: the same, on a new line.
0327   3E 0D        PNL:      LD   A,13   
0329   EF                     RST   28h   
032A   3E 0A                  LD   A,10   
032C   EF                     RST   28h   
032D   E3           PMSG:     EX   (SP),HL   
032E   CD 0B 03               CALL   prstr   
0331   E3                     EX   (SP),HL   
0332   C9                     RET      
0333                          ENDIF      
0333                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0333                             ; HL points past it. Each goes back into the loop that prints the string
0333                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0333                             ;    /a-/z   print the variable, as "#" does
0333                             ;    /{      clear the screen, the cursor to the top left
0333                             ;    /}      clear from the cursor to the end of the line
0333                             ;    /|  /`  show the cursor, hide it
0333                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0333   FE 7E        PESC:     CP   7Eh   
0335   28 1C                  JR   Z,pat   
0337   11 0B 03               LD   DE,PRLOOP   ; the others return into the loop
033A   D5                     PUSH   DE   
033B   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
033D   30 44                  JR   NC,pcon   
033F   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0341   30 30                  JR   NC,phide   
0343   87                     ADD   A,A   ; the variable's cell
0344   C6 40                  ADD   A,40h   
0346   E5                     PUSH   HL   
0347   6F                     LD   L,A   
0348   26 0B                  LD   H,LETPAGE   
034A   7E                     LD   A,(HL)   
034B   2C                     INC   L   
034C   66                     LD   H,(HL)   
034D   6F                     LD   L,A   
034E   CD 3E 04               CALL   psgn   
0351   E1                     POP   HL   
0352   C9                     RET      
0353                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0353                             ; the checked build "$" is the routine prstr: its own return address goes
0353                             ; first, and hp1 calls it again afterwards. There a /~ that takes cells
0353                             ; that aren"t there is s after the "$' (or at its NUL: see e_dollar), as for
0353                             ; any other character. chkstk stops a /~ only when the stack is already
0353                             ; past its empty place, so that, however many there are, what they write
0353                             ; stays in the spare bytes above the stack.
0353                PAT:         
0353                          IF   CHECKED   
0353   D1                     POP   DE   
0354   CD D1 04               CALL   chkstk   
0357                          ENDIF      
0357   D1                     POP   DE   ; DE = the column
0358   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0359                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
0359                          ENDIF      
0359                          IF   ANS   
0359   D5                     PUSH   DE   
035A   CD 97 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
035D   23                     INC   HL   
035E   CD 46 04               CALL   pdec   
0361   3E 3B                  LD   A,";"   
0363   EF                     RST   28h   
0364   E1                     POP   HL   
0365   23                     INC   HL   
0366   CD 46 04               CALL   pdec   
0369   3E 48                  LD   A,"H"   
036B   EF                     RST   28h   
036C   E1                     POP   HL   
036D   C3 B5 02               JP   PRAGAIN   
0370                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0370   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0372   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0373   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0375   3E 3F                  LD   A,"?"   
0377   CD 92 03               CALL   csia   
037A   3E 32                  LD   A,"2"   
037C   EF                     RST   28h   
037D   3E 35                  LD   A,"5"   
037F   EF                     RST   28h   
0380   7B                     LD   A,E   
0381   EF                     RST   28h   
0382   C9                     RET      
0383                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0383   3D           PCON:     DEC   A   
0384   28 EA                  JR   Z,pshow   ; /|
0386   3E 4B                  LD   A,"K"   
0388   F2 92 03               JP   P,csia   ; /}  ESC [ K
038B   3E 48                  LD   A,"H"   ; /{  ESC [ H ESC [ J
038D   CD 92 03               CALL   csia   
0390   3E 4A                  LD   A,"J"   ; (on into csia)
0392                             ; csia: ESC [ and then A. csi: ESC [, keeping A.
0392   CD 97 03     CSIA:     CALL   csi   
0395   EF                     RST   28h   
0396   C9                     RET      
0397   F5           CSI:      PUSH   AF   
0398   3E 1B                  LD   A,27   
039A   EF                     RST   28h   
039B   3E 5B                  LD   A,"["   
039D   EF                     RST   28h   
039E   F1                     POP   AF   
039F   C9                     RET      
03A0                          ENDIF      
03A0                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
03A0                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
03A0                             ; the quotient bits arrive at the bottom of C.
03A0                             ; Dividing by 2 is one shift (the spec wants that fast).
03A0   7B           UDIV:     LD   A,E   
03A1   EE 02                  XOR   2   
03A3   B2                     OR   D   
03A4   20 07                  JR   NZ,udv0   
03A6   CB 3C                  SRL   H   
03A8   CB 1D                  RR   L   ; the quotient
03AA   8F                     ADC   A,A   
03AB   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
03AC   C9                     RET      
03AD   C5           UDV0:     PUSH   BC   
03AE   7C                     LD   A,H   
03AF   4D                     LD   C,L   
03B0   21 00 00               LD   HL,0   
03B3   06 10                  LD   B,16   
03B5   CB 21        UDV1:     SLA   C   
03B7   17                     RLA      
03B8   ED 6A                  ADC   HL,HL   
03BA   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03BC   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03BE   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03BF   0D                     DEC   C   ;   INC below
03C0   0C           UDV2:     INC   C   ; a quotient bit
03C1   10 F2                  DJNZ   udv1   
03C3   EB                     EX   DE,HL   ; DE = remainder
03C4   67                     LD   H,A   
03C5   69                     LD   L,C   ; HL = quotient
03C6   C1                     POP   BC   
03C7   C9                     RET      
03C8                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
03C8                             ; non-digit. Values wrap at 16 bits, as the spec says.
03C8   21 00 00     RDNUM:    LD   HL,0   
03CB   0A           RDN1:     LD   A,(BC)   
03CC   D6 30                  SUB   "0"   
03CE   FE 0A                  CP   10   
03D0   D0                     RET   NC   
03D1   03                     INC   BC   
03D2   54                     LD   D,H   
03D3   5D                     LD   E,L   
03D4   29                     ADD   HL,HL   
03D5   29                     ADD   HL,HL   
03D6   19                     ADD   HL,DE   
03D7   29                     ADD   HL,HL   ; HL * 10
03D8   5F                     LD   E,A   
03D9   16 00                  LD   D,0   
03DB   19                     ADD   HL,DE   
03DC   18 ED                  JR   rdn1   
03DE                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03DE                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03DE                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
03DE                          ENDIF      
03DE                          IF   CHECKED   
03DE                             ; The checked build never steps over a NUL: if the text runs out first it
03DE                             ; returns A = 0 with the IP on the NUL.
03DE   0A           SKIPSTR:   LD   A,(BC)   
03DF   B7                     OR   A   
03E0   C8                     RET   Z   
03E1   03                     INC   BC   
03E2   FE 22                  CP   22h   
03E4   C8                     RET   Z   
03E5   FE 2F                  CP   "/"   
03E7   20 F5                  JR   NZ,skipstr   
03E9   0A                     LD   A,(BC)   ; the escaped character
03EA   B7                     OR   A   
03EB   C8                     RET   Z   
03EC   03                     INC   BC   
03ED   18 EF                  JR   skipstr   
03EF                          ENDIF      
03EF                             ; skip: read past text to the closer at this level, and return A = 0 if it
03EF                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03EF                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03EF                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03EF                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03EF                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
03EF                             ; 
03EF                             ; The checked build also looks at the character the skip was started by,
03EF                             ; which is always the one just before where it starts: "(" must end at ")",
03EF                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03EF                             ; quote counts as running into it. "\" takes either closer. IX keeps the
03EF                             ; place where the skip started, for the report.
03EF                SKIP:        
03EF                          IF   CHECKED   
03EF   C5                     PUSH   BC   
03F0   DD E1                  POP   IX   
03F2   0B                     DEC   BC   
03F3   0A                     LD   A,(BC)   
03F4   03                     INC   BC   
03F5   5F                     LD   E,A   ; E = the opener: ( [ or \
03F6                          ENDIF      
03F6   16 00                  LD   D,0   
03F8   14           SK3:      INC   D   ; an opener: one deeper
03F9   0A           SK1:      LD   A,(BC)   
03FA                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
03FA                          ENDIF      
03FA                          IF   CHECKED   
03FA   B7                     OR   A   
03FB   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
03FD   03                     INC   BC   
03FE                          ENDIF      
03FE   FE 22                  CP   22h   
0400   CC DE 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0403   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0405   28 F1                  JR   Z,sk3   
0407   3D                     DEC   A   ; ")"
0408   28 08                  JR   Z,sk4   
040A   D6 32                  SUB   "["-")"   
040C   28 EA                  JR   Z,sk3   
040E   FE 02                  CP   "]"-"["   
0410   20 E7                  JR   NZ,sk1   
0412   15           SK4:      DEC   D   
0413                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0413                          ENDIF      
0413                          IF   CHECKED   
0413   20 E4                  JR   NZ,sk1   
0415   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0416   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0417   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0419   FE 02                  CP   2   ;   closer, and only then
041B   7A                     LD   A,D   
041C   C0                     RET   NZ   
041D   18 05                  JR   sk7   
041F   CB 53        SK6:      BIT   2,E   ; the text ran out:
0421   C2 4A 06               JP   NZ,SKEND   ;   "\" with no closer ends the program
0424   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0426   C1                     POP   BC   
0427   3E 4E                  LD   A,"N"   
0429   C3 37 05               JP   errp   ; (errp drops skip's return address)
042C                          ENDIF      
042C                             ; =============================================================================
042C                             ;  Dispatch table: the low byte of each handler's address, in code order
042C                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
042C                             ;  It must not cross a page (the dispatcher only adds to its low byte).
042C                             ; =============================================================================
042C                             ; The handlers of the first NPG1 characters start in the image's second page.
042C                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
042C                             ; differs between the builds, so the count is worked out here.
042C                             ; (One division to a line: asm80 only rounds down when it stores a value.)
042C                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
042C                PGBRK:    EQU   (h_break-BASE)/256   
042C                PGDEF:    EQU   (h_def-BASE)/256   
042C                PGFET:    EQU   (h_fetch-BASE)/256   
042C                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
042C                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
042C                          ENDIF      
042C                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
042C                             ; and return its value in A with the carry set; otherwise leave the IP and
042C                             ; return with the carry clear.
042C   0A           HEXC:     LD   A,(BC)   
042D   D6 30                  SUB   "0"   
042F   FE 0A                  CP   10   
0431   38 09                  JR   C,hc1   
0433   E6 DF                  AND   0DFh   
0435   D6 11                  SUB   11h   
0437   FE 06                  CP   6   
0439   D0                     RET   NC   
043A   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
043C   03           HC1:      INC   BC   
043D   C9                     RET      
043E                             ; psgn: print HL as a signed number. Keeps BC.
043E   CB 7C        PSGN:     BIT   7,H   
0440   28 04                  JR   Z,pdec   
0442   3E 2D                  LD   A,"-"   
0444   EF                     RST   28h   
0445   E7                     RST   20h   
0446                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0446                             ; Keeps BC.
0446   11 0A 00     PDEC:     LD   DE,10   
0449   CD A0 03               CALL   udiv   ; HL = HL / 10, E = the last digit
044C   7B                     LD   A,E   
044D   F5                     PUSH   AF   
044E   7C                     LD   A,H   
044F   B5                     OR   L   
0450   C4 46 04               CALL   NZ,pdec   
0453   F1                     POP   AF   
0454   C6 30                  ADD   A,"0"   
0456   EF                     RST   28h   
0457   C9                     RET      
0458                             ; (The table goes here instead in the builds where, before psgn, it would
0458                             ; cross a page: PTLATE.)
0458                          IF   (1-TABP0)*PTLATE   
0458                PTAB:        
0458                          ;*Macro unroll:  PTABLE
0458   9F                     DB   h_store & 0FFh   
0459   A7                     DB   h_str & 0FFh   
045A   BC                     DB   h_num & 0FFh   
045B   B2                     DB   h_print & 0FFh   
045C   97                     DB   h_swap & 0FFh   
045D   3C                     DB   h_and & 0FFh   
045E   B9                     DB   h_emit & 0FFh   
045F   18                     DB   h_open & 0FFh   
0460   20                     DB   h_close & 0FFh   
0461   5D                     DB   h_mul & 0FFh   
0462   33                     DB   h_add & 0FFh   
0463   D8                     DB   h_cfetch & 0FFh   
0464   2B                     DB   h_sub & 0FFh   
0465   99                     DB   h_cstore & 0FFh   
0466   71                     DB   h_div & 0FFh   
0467   95                     DB   h_dup & 0FFh   
0468   9E                     DB   h_drop & 0FFh   
0469   44                     DB   h_lt & 0FFh   
046A   53                     DB   h_eq & 0FFh   
046B   45                     DB   h_gt & 0FFh   
046C   C0                     DB   h_key & 0FFh   
046D   13                     DB   h_fetch & 0FFh   
046E   EF                     DB   h_def & 0FFh   
046F   E2                     DB   h_break & 0FFh   
0470   DE                     DB   h_ret & 0FFh   
0471   76                     DB   h_xor & 0FFh   
0472   89                     DB   h_alloc & 0FFh   
0473   C8                     DB   h_grave & 0FFh   
0474   2C                     DB   h_tor & 0FFh   
0475   7E                     DB   h_or & 0FFh   
0476   1C                     DB   h_fromr & 0FFh   
0477   86                     DB   h_not & 0FFh   
0478                PTABEND:      
0478                          ENDIF      
0478                             ; =============================================================================
0478                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0478                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0478                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
0478                             ;  they are the host's KEY and CONOUT routines themselves.
0478                             ; 
0478                             ;  A running program reads the keyboard only through getk and pollk, which
0478                             ;  between them give the break key its rules:
0478                             ;    - Ctrl-C stops the program;
0478                             ;    - any other key that the break check reads is held in KEYBUF for the
0478                             ;      next "?", and a newer one takes its place;
0478                             ;    - "?" (getk) takes the held key first;
0478                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0478                             ;      key like any other, but two of them within about 250 ms still stop it.
0478                             ;  Both are called straight from a handler, never from a routine under one:
0478                             ;  the checked build's report counts on finding one return address above the
0478                             ;  data stack.
0478                             ; =============================================================================
0478                          IFN   CPM   
                    RAWK:     EQU   KEY   
0478                          ENDIF      
0478                             ; pollk: the break check (see rpushn).
0478   CD B6 04     POLLK:    CALL   rawk   
047B   C8                     RET   Z   ; no key
047C   32 7A 0B               LD   (KEYBUF),A   ; held for the next "?"
047F   FE 03        PK1:      CP   3   ; (getk joins here)
0481   C0                     RET   NZ   
0482                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0482                             ; the program has turned it off, wait about 250 ms for one more key: a
0482                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0482                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0482   3A 7B 0B     CTLC:     LD   A,(BRKOFF)   
0485   B7                     OR   A   
0486   CA 35 05     CT0:      JP   Z,brk   
0489   D5                     PUSH   DE   
048A   11 10 27               LD   DE,250*MSLOOP   
048D   CD B6 04     CT1:      CALL   rawk   
0490   20 05                  JR   NZ,ct2   
0492   1B                     DEC   DE   
0493   7A                     LD   A,D   
0494   B3                     OR   E   
0495   20 F6                  JR   NZ,ct1   
0497   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0498   FE 03                  CP   3   
049A   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
049C   B7                     OR   A   
049D   28 03                  JR   Z,ct3   
049F   32 7A 0B               LD   (KEYBUF),A   
04A2   3E 03        CT3:      LD   A,3   
04A4   B7                     OR   A   
04A5   C9                     RET      
04A6                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04A6   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
04A7   21 7A 0B               LD   HL,KEYBUF   ;   the buffer
04AA   7E                     LD   A,(HL)   
04AB   36 00                  LD   (HL),0   
04AD   E1                     POP   HL   
04AE   B7                     OR   A   
04AF   C0                     RET   NZ   
04B0   CD B6 04               CALL   rawk   
04B3   C8                     RET   Z   
04B4   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
04B6                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
04B6                          ENDIF      ;   (with the editor, both stacks are cleared);
04B6                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
04B6                          ENDIF      
04B6                          IF   CHECKED   
04B6                BRK:      EQU   e_break   ;   the checked build reports B
04B6                          ENDIF      
04B6                          IF   CPM   
04B6   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
04B8                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
04B8                             ; printing and could swallow a key that BDOS 6 then never sees.
04B8   D5           PUTC:     PUSH   DE   
04B9   E5                     PUSH   HL   
04BA   5F                     LD   E,A   
04BB   3E 06                  LD   A,6   
04BD   CD C4 04               CALL   bdosx   
04C0   E1                     POP   HL   
04C1   D1                     POP   DE   
04C2   B7                     OR   A   ; (for getk)
04C3   C9                     RET      
04C4                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
04C4   C5           BDOSX:    PUSH   BC   
04C5   D9                     EXX      
04C6   E5                     PUSH   HL   
04C7   D9                     EXX      
04C8   4F                     LD   C,A   
04C9   CD 05 00               CALL   BDOS   
04CC   D9                     EXX      
04CD   E1                     POP   HL   
04CE   D9                     EXX      
04CF   C1                     POP   BC   
04D0   C9                     RET      
04D1                          ENDIF      
04D1                             ; =============================================================================
04D1                             ;  Checked build: the checks and the error report
04D1                             ; =============================================================================
04D1                          IF   CHECKED   
04D1                             ; chkstk: both stacks are checked once per character, not in every handler.
04D1                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
04D1                             ; the constant carries if it is above (cells were popped that were never
04D1                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
04D1                             ; a character late at most: the bytes above DSTOP and the guard band below
04D1                             ; the page take what happens meanwhile. DE is free between characters.
04D1   EB           CHKSTK:   EX   DE,HL   
04D2   21 05 F5               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
04D5   39                     ADD   HL,SP   
04D6   EB                     EX   DE,HL   
04D7   38 1D                  JR   C,e_under   
04D9   14                     INC   D   
04DA   20 16                  JR   NZ,e_over   
04DC   D9                     EXX      ; the return stack: in its page (or it has
04DD   7C                     LD   A,H   ;   overflowed), and not above its empty
04DE   FE 09                  CP   RSPAGE   ;   position (an underflow stays inside the
04E0   7D                     LD   A,L   ;   page, in the guard band)
04E1   D9                     EXX      
04E2   20 0B                  JR   NZ,e_rover   
04E4   FE E1                  CP   RSTOP&0FFh+1   
04E6   D8                     RET   C   
04E7   D9                     EXX      ; return stack underflow: it counts as empty
04E8   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
04EA   D9                     EXX      
04EB   3E 72                  LD   A,"r"   
04ED   18 48                  JR   errp   
04EF   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
04F1   11                     DB   11h   ; (LD DE,nn hides the next entry)
04F2   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
04F4   18 41                  JR   errp   
04F6   31 FC 0A     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
04F9   3E 73                  LD   A,"s"   
04FB   18 54                  JR   error   
04FD                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
04FD                             ; was never defined still holds 0000h, and the byte there is a reserved one
04FD                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
04FD                             ; an undefined word. The call is undone, so the place is the call itself.
04FD   04           E_HI:     INC   B   
04FE   10 49                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0500   CF                     RST   08h   
0501   42                     LD   B,D   
0502   4B                     LD   C,E   
0503   3E 55                  LD   A,"U"   
0505   18 4A                  JR   error   
0507                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0507                             ; the count. Stop if the top is not below the limit page, or is below the
0507                             ; program's end.
0507                CHKHP:       
0507                          ENDIF      
0507                          IF   CHECKED*CPM   
0507                             ; With this much room a top that wrapped round can land back in
0507                             ; range, so the add is tested too: growing (A, the count's high
0507                             ; byte, is positive) must not carry, and releasing must.
0507   1F                     RRA      ; the carry comes in above the sign:
0508   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
050A   87                     ADD   A,A   
050B   38 10                  JR   C,e_heap   
050D   3A 07 00               LD   A,(0007h)   
0510   3D                     DEC   A   
0511   BC                     CP   H   
0512   38 09                  JR   C,e_heap   
0514                          ENDIF      
0514                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0514                          ENDIF      
0514                          IF   CHECKED   
0514   D5                     PUSH   DE   
0515   EB                     EX   DE,HL   
0516   2A 38 0B               LD   HL,(NPEND)   
0519   19                     ADD   HL,DE   ; carry: at or above the program's end
051A   EB                     EX   DE,HL   
051B   D1                     POP   DE   
051C   D8                     RET   C   
051D   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
051E   ED 52                  SBC   HL,DE   
0520   3E 48                  LD   A,"H"   
0522   18 13                  JR   errp   
0524                             ; chkst: stop unless HL is in the program's own space: from the letter page
0524                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0524                             ; whatever lies above the limit are safe. Memory above the heap top but
0524                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0524                             ; It is the page of HL + 1 that is tested, so that one test serves both
0524                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0524                             ; Keeps HL and BC. It runs on into its own error entry.
0524   23           CHKST:    INC   HL   
0525   7C                     LD   A,H   
0526   2B                     DEC   HL   
0527   FE 0B                  CP   LETPAGE   
0529   38 07                  JR   C,e_store   
052B                          ENDIF      
052B                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
052B                          ENDIF      
052B                          IF   CHECKED*CPM   
052B   5F                     LD   E,A   
052C   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
052F   3D                     DEC   A   
0530   BB                     CP   E   
0531   D0                     RET   NC   
0532                          ENDIF      
0532                          IF   CHECKED   
0532                             ; Error entries. Each loads its letter and then hides the next entry inside
0532                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0532   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
0534   11                     DB   11h   
0535   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0537                             ; errp: an error found inside a routine: drop its return address first.
0537   D1           ERRP:     POP   DE   
0538   18 17                  JR   error   
053A                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
053A                             ; back in TOS. prstr's return address goes first. But if a /~ took cells
053A                             ; that weren't there, it is s, found now: chkstk, called one cell up, sees
053A                             ; the stack past its empty place then.
053A   D1           E_DOLLAR:   POP   DE   
053B   E1                     POP   HL   
053C   CD D1 04               CALL   chkstk   
053F   E5                     PUSH   HL   
0540   2A 34 0B               LD   HL,(RSAVE)   
0543   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
0544   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0545   4D                     LD   C,L   ;   past the opening quote, which is the place
0546   3E 51                  LD   A,"Q"   
0548   11                     DB   11h   
0549   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
054B   11                     DB   11h   
054C   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
054E   11                     DB   11h   
054F   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0551                             ; error: the report, then the end. A = the letter, BC = one past the place,
0551                             ; HL = TOS, and both stacks as the report is to show them:
0551                             ; 
0551                             ;   Err X @ line,col
0551                             ;   up to 16 characters of the text from the place
0551                             ;   Stk n: the top 8 cells at most, bottom to top
0551                             ;   Rtn n
0551   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0552   5F                     LD   E,A   
0553   CD 27 03               CALL   pnl   
0556   45 72 72 20 22         DB   "Err ",22h   
055B   7B                     LD   A,E   
055C   EF                     RST   28h   
055D   CD 2D 03               CALL   pmsg   
0560   20 40 20 22            DB   " @ ",22h   
0564   0B                     DEC   BC   ; BC = the place
0565                             ; The line and column. A place below the program is in the line
0565                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0565                             ; DE = the line's number, HL = where it starts.
0565   21 80 0B               LD   HL,LINEBUF   
0568   11 00 00               LD   DE,0   
056B   78                     LD   A,B   
056C   FE 0C                  CP   PROG/256   
056E   38 14                  JR   C,er3   
0570   24                     INC   H   
0571   6B                     LD   L,E   ; HL = PROG
0572   13           ER1:      INC   DE   ; a new line starts at HL
0573   E5                     PUSH   HL   
0574   7D           ER2:      LD   A,L   
0575   91                     SUB   C   
0576   7C                     LD   A,H   
0577   98                     SBC   A,B   
0578   30 09                  JR   NC,er2x   ; reached the place
057A   7E                     LD   A,(HL)   
057B   23                     INC   HL   
057C   FE 0A                  CP   10   
057E   20 F4                  JR   NZ,er2   
0580   F1                     POP   AF   
0581   18 EF                  JR   er1   
0583   E1           ER2X:     POP   HL   
0584   C5           ER3:      PUSH   BC   
0585   E5                     PUSH   HL   
0586   EB                     EX   DE,HL   
0587   CD 46 04               CALL   pdec   ; the line
058A   3E 2C                  LD   A,","   
058C   EF                     RST   28h   
058D   D1                     POP   DE   
058E   E1                     POP   HL   
058F   E5                     PUSH   HL   
0590   B7                     OR   A   
0591   ED 52                  SBC   HL,DE   
0593   23                     INC   HL   
0594   CD 46 04               CALL   pdec   ; the column
0597   CD 27 03               CALL   pnl   
059A   22                     DB   22h   
059B   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
059C   06 10                  LD   B,16   ;   if the line or the program ends first
059E   7E           ER4:      LD   A,(HL)   
059F   23                     INC   HL   
05A0   B7                     OR   A   
05A1   28 0B                  JR   Z,er5   
05A3   FE 0D                  CP   13   
05A5   28 07                  JR   Z,er5   
05A7   FE 0A                  CP   10   
05A9   28 03                  JR   Z,er5   
05AB                          ENDIF      
05AB                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
05AB                          ENDIF      ;   screen on it. The editor's loader ends
05AB                          IF   CHECKED   ;   the text at the first ^Z.)
05AB   EF                     RST   28h   
05AC   10 F0                  DJNZ   er4   
05AE                ER5:         ; (on into the two stack lines)
05AE                             ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
05AE                             ;                       Rtn n
05AE                             ; TOS is in memory with the rest (pushed) by now.
05AE   CD 27 03               CALL   pnl   
05B1   53 74 6B 20 22         DB   "Stk ",22h   
05B6   21 06 F5               LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
05B9   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
05BA   E7                     RST   20h   ;   with the first value and holds nothing)
05BB   CD 02 06               CALL   phalf   ; the depth
05BE   3E 3A                  LD   A,":"   
05C0   EF                     RST   28h   
05C1   79                     LD   A,C   
05C2   FE 09                  CP   9   
05C4   38 0A                  JR   C,er6   
05C6   CD 2D 03               CALL   pmsg   
05C9   20 2E 2E 2E 22         DB   " ...",22h   
05CE   0E 08                  LD   C,8   
05D0   26 00        ER6:      LD   H,0   ; C = the number of cells to show
05D2   69                     LD   L,C   
05D3   29                     ADD   HL,HL   
05D4   39                     ADD   HL,SP   ; HL -> just above the deepest of them
05D5   0C                     INC   C   
05D6   0D           ER7:      DEC   C   
05D7   28 0F                  JR   Z,er8   
05D9   2B                     DEC   HL   
05DA   56                     LD   D,(HL)   
05DB   2B                     DEC   HL   
05DC   5E                     LD   E,(HL)   
05DD   E5                     PUSH   HL   
05DE   3E 20                  LD   A," "   
05E0   EF                     RST   28h   
05E1   EB                     EX   DE,HL   
05E2   CD 3E 04               CALL   psgn   
05E5   E1                     POP   HL   
05E6   18 EE                  JR   er7   
05E8   CD 27 03     ER8:      CALL   pnl   
05EB   52 74 6E 20 22         DB   "Rtn ",22h   
05F0   D9                     EXX      ; RSTOP - HL' is under 256 (the pointer is
05F1   3E E0                  LD   A,RSTOP&0FFh   ;   at most one entry below its page), so
05F3   95                     SUB   L   ;   the low bytes are enough
05F4   D9                     EXX      
05F5   6F                     LD   L,A   
05F6   26 00                  LD   H,0   
05F8   CD 02 06               CALL   phalf   
05FB   CD 27 03               CALL   pnl   
05FE   22                     DB   22h   
05FF                          ENDIF      
05FF                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
05FF                          ENDIF      
05FF                          IF   CHECKED*EDITOR   
05FF   C3 42 06               JP   edit0   ; back to the editor, with both stacks cleared
0602                          ENDIF      
0602                          IF   CHECKED   
0602                             ; phalf: print half of HL, and leave it in C.
0602   CB 3C        PHALF:    SRL   H   
0604   CB 1D                  RR   L   
0606   E5                     PUSH   HL   
0607   CD 46 04               CALL   pdec   
060A   C1                     POP   BC   
060B   C9                     RET      
060C                          ENDIF      
060C                             ; =============================================================================
060C                             ;  The line editor (EDITOR = 1)
060C                             ; 
060C                             ;  The interpreter starts here, and a program that ends comes back here.
060C                             ;  There is no prompt. It follows the spec's suggested standard for a line
060C                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
060C                             ; 
060C                             ;    n text    put the text in as line n; the lines from n on move down. A
060C                             ;              number past the end (or 0) adds the line at the end.
060C                             ;    n         take line n out
060C                             ;    anything else is run at once, as B8Script. (Start such a line with a
060C                             ;    space if it would begin with a digit.)
060C                             ; 
060C                             ;  A command key ends the line too, and takes what was typed as its argument:
060C                             ; 
060C                             ;    ^G        run the program
060C                             ;    n ^L      list from line n (no number: all of it). Any key holds the
060C                             ;              list until another key is pressed; Ctrl-C ends it.
060C                             ;    n ^E      put line n in the input line; Return puts it back, changed
060C                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
060C                             ;              last time). Generic: what is typed, or pasted, from now until
060C                             ;              ^Z replaces the program; it is not echoed.
060C                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
060C                             ;              time). Generic: the text is printed, as it is.
060C                             ;    ^N ^N     new: no program (the key twice in a row)
060C                             ;    ^X        leave (to LEAVE)
060C                             ; 
060C                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
060C                             ;  a character goes in at the cursor; Backspace and DEL take out the one
060C                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
060C                             ;  sent to the terminal, so any terminal will do.
060C                             ; 
060C                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
060C                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
060C                             ;  125 characters; the one character after a line number separates it from
060C                             ;  the text and is not stored. The text is kept as it is typed, each line
060C                             ;  ending in CR LF, at PROG.
060C                             ; 
060C                             ;  What lasts from one line to the next: the program, the words, the
060C                             ;  variables and the data stack. An error or a break clears both stacks. The
060C                             ;  return stack starts empty for every line.
060C                             ; 
060C                             ;  Things to know:
060C                             ;    - Reset empties the program (generic builds).
060C                             ;    - A word's address points into the program, so run the program again
060C                             ;      after editing it.
060C                             ;    - Nothing is printed between a program's output and what is typed next.
060C                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
060C                             ;      a line that calls -n? and carries on afterwards runs what was typed.
060C                             ;      (The stored program never comes back to the line, so it may.)
060C                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
060C                             ;      read of the other builds.
060C                             ; 
060C                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
060C                             ;  the last line left there, with TOS pushed like the rest.
060C                             ; =============================================================================
060C                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
060C                          ENDIF      
060C                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
060C                          ENDIF      
060C                          IF   EDGEN   
                              JR   edit0   
060C                          ENDIF      
060C                          IF   EDITOR   
060C                             ; ^F, right arrow: one to the right, by printing the character there
060C   7D           RIGHT:    LD   A,L   
060D   BB                     CP   E   
060E   28 4E                  JR   Z,ed1   ; at the end
0610   7E                     LD   A,(HL)   
0611   2C                     INC   L   
0612   18 2B                  JR   lf1   
0614                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0614                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0614                             ; ends the sequence, and act on C (right) and D (left).
0614   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0617   CD B6 04     ES1:      CALL   rawk   
061A   20 0A                  JR   NZ,es2   
061C   0B                     DEC   BC   
061D   78                     LD   A,B   
061E   B1                     OR   C   
061F   20 F6                  JR   NZ,es1   
0621   CD 93 06               CALL   fin   ; no second key: the line is dropped
0624   18 26                  JR   edit   
0626   FE 5B        ES2:      CP   "["   
0628   20 34                  JR   NZ,ed1   ; not a sequence known here
062A   CD EC 06     ES3:      CALL   ekey   
062D   FE 40                  CP   40h   
062F   38 F9                  JR   C,es3   ; (its parameters)
0631   D6 43                  SUB   "C"   
0633   28 D7                  JR   Z,right   
0635   3D                     DEC   A   ; "D"?
0636   20 26                  JR   NZ,ed1   ; no: on into left
0638                             ; ^B, left arrow: the cursor goes one to the left
0638   7D           LEFT:     LD   A,L   
0639   87                     ADD   A,A   
063A   28 22                  JR   Z,ed1   ; (L = 80h: at the start)
063C   2D                     DEC   L   
063D   3E 08                  LD   A,8   
063F   EF           LF1:      RST   28h   
0640   18 1C                  JR   ed1   
0642                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
0642                             ;   is shown, in case the program had hidden it and could not show it again.
0642                             ; skend: a program that ended inside skip: its return address goes.
0642                             ; edend: a program that ended: TOS joins the rest of the data stack.
0642   31 FA 0A     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0645                          ENDIF      
0645                          IF   EDITOR*ANS   
0645   AF                     XOR   A   ; (pshow wants the carry clear)
0646   CD 70 03               CALL   pshow   ; ESC [ ? 2 5 h
0649                          ENDIF      
0649                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
0649                          ENDIF      
0649                          IF   EDITOR   
0649   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
064A   D1           SKEND:    POP   DE   
064B   E5           EDEND:    PUSH   HL   
064C                             ; edit: start a new input line.
064C   D9           EDIT:     EXX      
064D   21 E0 09               LD   HL,RSTOP   ; the return stack is empty
0650   D9                     EXX      
0651   21 00 00               LD   HL,0   
0654   22 7A 0B               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0657   22 3A 0B               LD   (EDLN),HL   ; no line is being edited
065A   21 80 0B               LD   HL,LINEBUF   ; HL = the cursor,
065D   5D                     LD   E,L   ;   E = the end of the line (its low byte)
065E   CD EC 06     ED1:      CALL   ekey   
0661   FE 7F                  CP   7Fh   
0663   28 40                  JR   Z,bsp   ; DEL
0665   FE 20                  CP   " "   
0667   30 56                  JR   NC,insc   
0669   FE 09                  CP   9   
066B   28 52                  JR   Z,insc   ; Tab is text
066D   FE 08                  CP   8   
066F   28 34                  JR   Z,bsp   
0671   FE 02                  CP   2   
0673   28 C3                  JR   Z,left   ; ^B
0675   FE 06                  CP   6   
0677   28 93                  JR   Z,right   ; ^F
0679   FE 1B                  CP   1Bh   
067B   28 97                  JR   Z,esc   
067D   E5                     PUSH   HL   ; a command key? Look it up
067E   21 F2 06               LD   HL,cmds   
0681   06 08                  LD   B,NCMD   
0683   BE           ED2:      CP   (HL)   
0684   23                     INC   HL   
0685   28 07                  JR   Z,ed3   
0687   23                     INC   HL   
0688   23                     INC   HL   
0689   10 F8                  DJNZ   ed2   
068B   E1                     POP   HL   
068C   18 D0                  JR   ed1   ; no: the key is ignored
068E   7E           ED3:      LD   A,(HL)   
068F   23                     INC   HL   
0690   66                     LD   H,(HL)   
0691   6F                     LD   L,A   
0692   E3                     EX   (SP),HL   ; the command's address: fin returns to it
0693                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
0693                             ; terminal. Leaves BC -> the line and HL -> the NUL.
0693   26 0B        FIN:      LD   H,LETPAGE   
0695   6B                     LD   L,E   
0696   36 0D                  LD   (HL),13   
0698   2C                     INC   L   
0699   36 0A                  LD   (HL),10   
069B   2D                     DEC   L   
069C   CD F8 07               CALL   prl   ; (prints the CR LF)
069F   36 00                  LD   (HL),0   
06A1   01 80 0B               LD   BC,LINEBUF   
06A4   C9                     RET      
06A5                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
06A5                             ; left, the rest of the line moves down over it, and the last place (now a
06A5                             ; space) is printed over along with the rest.
06A5   7D           BSP:      LD   A,L   
06A6   87                     ADD   A,A   
06A7   28 B5                  JR   Z,ed1   ; at the start
06A9   2D                     DEC   L   
06AA   3E 08                  LD   A,8   
06AC   EF                     RST   28h   
06AD   E5                     PUSH   HL   
06AE   2C           BS1:      INC   L   
06AF   7E                     LD   A,(HL)   
06B0   2D                     DEC   L   
06B1   77                     LD   (HL),A   
06B2   2C                     INC   L   
06B3   7D                     LD   A,L   
06B4   BB                     CP   E   
06B5   20 F7                  JR   NZ,bs1   
06B7   2D                     DEC   L   
06B8   36 20                  LD   (HL)," "   
06BA   E1                     POP   HL   
06BB   53                     LD   D,E   
06BC   1D                     DEC   E   
06BD   18 15                  JR   ic2   
06BF                             ; A character goes in at the cursor: it ripples up through the rest of the
06BF                             ; line, the cursor moves on, and the rest is printed again.
06BF   47           INSC:     LD   B,A   
06C0   7B                     LD   A,E   
06C1   FE FD                  CP   0FDh   
06C3   28 99                  JR   Z,ed1   ; the line is full: 125 characters
06C5   78                     LD   A,B   
06C6   EF                     RST   28h   
06C7   E5                     PUSH   HL   
06C8   7E           IC1:      LD   A,(HL)   
06C9   70                     LD   (HL),B   
06CA   47                     LD   B,A   
06CB   7D                     LD   A,L   
06CC   2C                     INC   L   
06CD   BB                     CP   E   
06CE   20 F8                  JR   NZ,ic1   
06D0   E1                     POP   HL   
06D1   2C                     INC   L   
06D2   1C                     INC   E   
06D3   53                     LD   D,E   
06D4   CD D9 06     IC2:      CALL   tail   
06D7   18 85                  JR   ed1   
06D9                             ; tail: print the line from the cursor to D (a low byte), and bring the
06D9                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
06D9   4D           TAIL:     LD   C,L   
06DA   7D           TA1:      LD   A,L   
06DB   BA                     CP   D   
06DC   28 05                  JR   Z,ta2   
06DE   7E                     LD   A,(HL)   
06DF   EF                     RST   28h   
06E0   2C                     INC   L   
06E1   18 F7                  JR   ta1   
06E3   7D           TA2:      LD   A,L   
06E4   B9                     CP   C   
06E5   C8                     RET   Z   
06E6   3E 08                  LD   A,8   
06E8   EF                     RST   28h   
06E9   2D                     DEC   L   
06EA   18 F7                  JR   ta2   
06EC                             ; ekey: wait for a key
06EC   CD B6 04     EKEY:     CALL   rawk   
06EF   28 FB                  JR   Z,ekey   
06F1   C9                     RET      
06F2                             ; The command keys, and where each goes (after fin).
06F2   0D           CMDS:     DB   13   
06F3   42 07                  DW   cret   
06F5   07                     DB   7   ; ^G
06F6   8A 07                  DW   crun   
06F8   0C                     DB   12   ; ^L
06F9   A0 07                  DW   clist   
06FB   05                     DB   5   ; ^E
06FC   18 07                  DW   cedln   
06FE   12                     DB   18   ; ^R
06FF   01 08                  DW   cread   
0701   17                     DB   23   ; ^W
0702   0A 08                  DW   cwrite   
0704   0E                     DB   14   ; ^N
0705   0A 07                  DW   cnew   
0707   18                     DB   24   ; ^X
0708   00 00                  DW   LEAVE   
070A                NCMD:     EQU   8   
070A                             ; ^N ^N: no program, if the next key is ^N too
070A   CD EC 06     CNEW:     CALL   ekey   
070D   FE 0E                  CP   14   
070F   20 04                  JR   NZ,ged0   
0711   AF                     XOR   A   
0712   32 00 0C               LD   (PROG),A   
0715   C3 4C 06     GED0:     JP   edit   
0718                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0718                             ; line it was: Return puts the text back in its place.
0718   CD C8 03     CEDLN:    CALL   rdnum   
071B   E5                     PUSH   HL   
071C   CD E0 07               CALL   find   ; HL -> the line, or the NUL if there is none
071F   D1                     POP   DE   
0720   7E                     LD   A,(HL)   
0721   B7                     OR   A   
0722   28 F1                  JR   Z,ged0   
0724   ED 53 3A 0B            LD   (EDLN),DE   
0728   11 80 0B               LD   DE,LINEBUF   
072B   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
072C   FE 0D                  CP   13   
072E   28 0D                  JR   Z,ce2   
0730   FE 0A                  CP   10   
0732   28 09                  JR   Z,ce2   
0734   12                     LD   (DE),A   
0735   EF                     RST   28h   
0736   23                     INC   HL   
0737   1C                     INC   E   
0738   7B                     LD   A,E   
0739   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
073B   20 EE                  JR   NZ,ce1   
073D   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
073E   5D                     LD   E,L   
073F   C3 5E 06               JP   ed1   
0742                             ; Return. If ^E put a line here, the text goes back in its place. If not:
0742                             ; a number and text is a line to put in, a number alone a line to take out,
0742                             ; and anything else is run where it is.
0742   E5           CRET:     PUSH   HL   ; the end of what was typed
0743   2A 3A 0B               LD   HL,(EDLN)   
0746   7C                     LD   A,H   
0747   B5                     OR   L   
0748   28 07                  JR   Z,cr1   
074A   E5                     PUSH   HL   
074B   CD D0 07               CALL   delln   
074E   E1                     POP   HL   
074F   18 13                  JR   ins   
0751   CD C8 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0754   79                     LD   A,C   ; C is still 80h if there was no number:
0755   87                     ADD   A,A   ;   only then is twice it 0
0756   28 36                  JR   Z,st0p   ; no number: run the line
0758   0A                     LD   A,(BC)   
0759   FE 0D                  CP   13   
075B   20 06                  JR   NZ,cr2   
075D   D1                     POP   DE   ; the number alone: take that line out
075E   CD D0 07               CALL   delln   
0761   18 24                  JR   gedit   
0763   03           CR2:      INC   BC   ; step over the one character after the number
0764                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0764                             ; CR and LF included, and copy it in.
0764   CD E0 07     INS:      CALL   find   ; HL -> where it goes
0767   D1                     POP   DE   ; the end of what was typed
0768   7B                     LD   A,E   
0769   91                     SUB   C   ; A = the length of the text, with its CR LF
076A   C5                     PUSH   BC   ; the text
076B   4F                     LD   C,A   
076C   06 00                  LD   B,0   
076E   C5                     PUSH   BC   ; its length
076F   54                     LD   D,H   
0770   5D                     LD   E,L   ; DE = where it goes
0771   AF                     XOR   A   
0772   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0773   ED B1                  CPIR      ; HL -> one past the program's NUL
0775   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0777   44                     LD   B,H   
0778   4D                     LD   C,L   
0779   19                     ADD   HL,DE   
077A   2B                     DEC   HL   ; HL -> the NUL
077B   EB                     EX   DE,HL   
077C   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
077D   E5                     PUSH   HL   
077E   19                     ADD   HL,DE   ; the NUL's new place
077F   EB                     EX   DE,HL   
0780   ED B8                  LDDR      ; move the rest of the program up
0782   C1                     POP   BC   ; the length
0783   D1                     POP   DE   ; where it goes
0784   E1                     POP   HL   ; the text
0785   ED B0                  LDIR      
0787   C3 4C 06     GEDIT:    JP   edit   
078A                             ; ^G: run the program. st0p: run the typed line (BC -> it).
078A   01 00 0C     CRUN:     LD   BC,PROG   
078D   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
078E   E1           ST0P:     POP   HL   ; (the end of what was typed)
078F                             ; st0: start running at BC. The heap starts after the stored program's NUL.
078F   21 00 0C     ST0:      LD   HL,PROG   
0792   AF                     XOR   A   
0793   BE           ST1:      CP   (HL)   
0794   23                     INC   HL   
0795   20 FC                  JR   NZ,st1   
0797   22 7C 0B               LD   (HEAP),HL   
079A                          ENDIF      
079A                          IF   EDITOR*CHECKED   
079A   E7                     RST   20h   ; minus the heap"s first address: "_' may not
079B   22 38 0B               LD   (NPEND),HL   ;   release below it
079E                          ENDIF      
079E                          IF   EDITOR   
079E   E1                     POP   HL   ; TOS: the data stack is as the last line left it
079F   F7                     RST   30h   ; (its return address is thrown away)
07A0                             ; ^L: list from line n. DE = the number of the line at HL.
07A0   CD C8 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
07A3   7C                     LD   A,H   
07A4   B5                     OR   L   
07A5   20 01                  JR   NZ,li0   
07A7   2C                     INC   L   ;   then from line 1
07A8   E5           LI0:      PUSH   HL   
07A9   CD E0 07               CALL   find   
07AC   D1                     POP   DE   
07AD   7E           LI1:      LD   A,(HL)   
07AE   B7                     OR   A   
07AF   28 D6                  JR   Z,gedit   ; the end of the text
07B1   CD B6 04               CALL   rawk   
07B4   28 09                  JR   Z,li3   ; no key: carry on
07B6   FE 03                  CP   3   
07B8   C4 EC 06               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
07BB   FE 03                  CP   3   
07BD   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
07BF   E5           LI3:      PUSH   HL   
07C0   D5                     PUSH   DE   
07C1   EB                     EX   DE,HL   
07C2   CD 46 04               CALL   pdec   ; the line's number,
07C5   3E 20                  LD   A," "   
07C7   EF                     RST   28h   ;   a space,
07C8   D1                     POP   DE   
07C9   E1                     POP   HL   
07CA   13                     INC   DE   
07CB   CD F8 07               CALL   prl   ;   and the line
07CE   18 DD                  JR   li1   
07D0                             ; delln: take line n (in HL) out: copy everything after it down over it.
07D0   CD E0 07     DELLN:    CALL   find   
07D3   54                     LD   D,H   
07D4   5D                     LD   E,L   
07D5   CD EE 07               CALL   nxl   ; HL -> the next line
07D8   7E           DE1:      LD   A,(HL)   
07D9   12                     LD   (DE),A   
07DA   23                     INC   HL   
07DB   13                     INC   DE   
07DC   B7                     OR   A   
07DD   20 F9                  JR   NZ,de1   
07DF   C9                     RET      
07E0                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
07E0                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
07E0   EB           FIND:     EX   DE,HL   
07E1   21 00 0C               LD   HL,PROG   
07E4   1B           FI1:      DEC   DE   
07E5   7A                     LD   A,D   
07E6   B3                     OR   E   
07E7   C8                     RET   Z   
07E8   CD EE 07               CALL   nxl   
07EB   20 F7                  JR   NZ,fi1   
07ED   C9                     RET      
07EE                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
07EE                             ; stop at the NUL that ends the text (and return zero).
07EE   7E           NXL:      LD   A,(HL)   
07EF   B7                     OR   A   
07F0   C8                     RET   Z   
07F1   23                     INC   HL   
07F2   FE 0A                  CP   10   
07F4   20 F8                  JR   NZ,nxl   
07F6   B7                     OR   A   
07F7   C9                     RET      
07F8                             ; prl: print the line at HL, to its LF; HL -> just past it.
07F8   7E           PRL:      LD   A,(HL)   
07F9   EF                     RST   28h   
07FA   7E                     LD   A,(HL)   
07FB   23                     INC   HL   
07FC   FE 0A                  CP   10   
07FE   20 F8                  JR   NZ,prl   
0800   C9                     RET      
0801                          ENDIF      
0801                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
0801                          ENDIF      
0801                          IF   EDITOR*CPM   
0801                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
0801                             ;   put the one from the command line
0801                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
0801                             ; from now on.
0801   CD 58 08     CREAD:    CALL   setname   
0804   CD 97 08               CALL   load   
0807   C3 4C 06               JP   edit   
080A                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
080A                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
080A                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
080A                             ; full disk or directory is not noticed: the calls fail and that is all.)
080A   CD 58 08     CWRITE:   CALL   setname   
080D   0E 13                  LD   C,19   ; delete
080F   CD 91 08               CALL   fbdos   
0812   0E 16                  LD   C,22   ; make
0814   CD 91 08               CALL   fbdos   
0817   21 00 0C               LD   HL,PROG   
081A   AF                     XOR   A   
081B   BE           CW1:      CP   (HL)   
081C   23                     INC   HL   
081D   20 FC                  JR   NZ,cw1   
081F   2B                     DEC   HL   ; HL -> the NUL
0820   E5                     PUSH   HL   
0821   06 80                  LD   B,128   
0823   36 1A        CW2:      LD   (HL),1Ah   
0825   23                     INC   HL   
0826   10 FB                  DJNZ   cw2   
0828   E1                     POP   HL   
0829   11 00 0C               LD   DE,PROG   
082C   7B           CW3:      LD   A,E   ; a record that starts before the end is written
082D   95                     SUB   L   
082E   7A                     LD   A,D   
082F   9C                     SBC   A,H   
0830   30 09                  JR   NC,cw4   
0832   E5                     PUSH   HL   
0833   0E 15                  LD   C,21   ; write, from where the record lies
0835   CD 45 08               CALL   frec   
0838   E1                     POP   HL   
0839   18 F1                  JR   cw3   
083B   36 00        CW4:      LD   (HL),0   ; the NUL again
083D   0E 10                  LD   C,16   ; close
083F   CD 91 08               CALL   fbdos   
0842   C3 4C 06               JP   edit   
0845                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
0845                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
0845   D5           FREC:     PUSH   DE   
0846   C5                     PUSH   BC   
0847   0E 1A                  LD   C,26   ; set the DMA address
0849   CD 05 00               CALL   BDOS   
084C   C1                     POP   BC   
084D   CD 91 08               CALL   fbdos   
0850   E1                     POP   HL   
0851   11 80 00               LD   DE,128   
0854   EB                     EX   DE,HL   
0855   19                     ADD   HL,DE   
0856   EB                     EX   DE,HL   
0857   C9                     RET      
0858                             ; setname: if a name was typed (the line does not start with its CR), put it
0858                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
0858                             ; is the current one. Then, name or no name, clear the FCB after the name,
0858                             ; as it must be before a file is opened or made.
0858   11 80 0B     SETNAME:   LD   DE,LINEBUF   
085B   1A                     LD   A,(DE)   
085C   FE 0D                  CP   13   
085E   28 26                  JR   Z,fcbclr   
0860   21 5C 00               LD   HL,CFCB   
0863   36 00                  LD   (HL),0   ; the current drive
0865   06 0B                  LD   B,11   
0867   2C           SN1:      INC   L   
0868   36 20                  LD   (HL)," "   
086A   10 FB                  DJNZ   sn1   
086C   2E 5D                  LD   L,CFCB+1   
086E   1A           SN2:      LD   A,(DE)   
086F   13                     INC   DE   
0870   FE 0D                  CP   13   
0872   28 12                  JR   Z,fcbclr   
0874   FE 2E                  CP   "."   
0876   20 04                  JR   NZ,sn3   
0878   2E 65                  LD   L,CFCB+9   ; the type
087A   18 F2                  JR   sn2   
087C   FE 61        SN3:      CP   "a"   
087E   38 02                  JR   C,sn4   
0880   E6 5F                  AND   5Fh   ; a capital
0882   77           SN4:      LD   (HL),A   
0883   2C                     INC   L   
0884   18 E8                  JR   sn2   
0886   21 68 00     FCBCLR:   LD   HL,CFCB+12   
0889   06 18                  LD   B,24   
088B   36 00        FC1:      LD   (HL),0   
088D   23                     INC   HL   
088E   10 FB                  DJNZ   fc1   
0890   C9                     RET      
0891                             ; fbdos: BDOS function C on the file
0891   11 5C 00     FBDOS:    LD   DE,CFCB   
0894   C3 05 00               JP   BDOS   
0897                             ; load: read the file into PROG. No such file: no program. The text ends at
0897                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0897                             ; goes after the last record, so the search always stops. And every line
0897                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
0897                             ; clear after its name: the CCP left it so, or setname did.)
0897   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
0899   CD 91 08               CALL   fbdos   ;   too)
089C   11 00 0C               LD   DE,PROG   
089F   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
08A1   CD 45 08               CALL   frec   
08A4   B7                     OR   A   
08A5   28 F8                  JR   Z,ld1   
08A7   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
08A9   21 FF 0B               LD   HL,PROG-1   
08AC   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
08AE   23           TR1:      INC   HL   
08AF   5F                     LD   E,A   ; E = the character before this one
08B0   7E                     LD   A,(HL)   
08B1   FE 1A                  CP   1Ah   
08B3   20 F9                  JR   NZ,tr1   
08B5   7B                     LD   A,E   
08B6   FE 0A                  CP   10   
08B8   28 06                  JR   Z,tr2   
08BA   36 0D                  LD   (HL),13   
08BC   23                     INC   HL   
08BD   36 0A                  LD   (HL),10   
08BF   23                     INC   HL   
08C0   36 00        TR2:      LD   (HL),0   
08C2   C9                     RET      
08C3                          ENDIF      
08C3                             ; =============================================================================
08C3                          IF   CPM   
08C3                             ; The RAM pages follow the image; the heap may grow to the BDOS.
08C3                START:       
08C3                          ENDIF      
08C3                          IF   CPM*CHECKED   
08C3                             ; Clear the lower half of the letter page: every variable starts at
08C3                             ; 0, every word cell holds 0000h, the address an undefined word is
08C3                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
08C3                             ; is held back.
08C3   21 00 0B               LD   HL,LET   
08C6   AF                     XOR   A   
08C7   77           INI1:     LD   (HL),A   
08C8   2C                     INC   L   
08C9   F2 C7 08               JP   P,ini1   ; +00h to +7Fh
08CC                          ENDIF      
08CC                          IF   CPM   
08CC   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
08CF   11 08 00               LD   DE,0008h   
08D2   01 2C 00               LD   BC,vecend-vecs   
08D5   ED B0                  LDIR      
08D7                          ENDIF      
08D7                          IF   CPM*EDITOR   
08D7   CD 97 08               CALL   load   ; the file named on the command line
08DA   C3 42 06               JP   edit0   
08DD                          ENDIF      
08DD                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
08DD                          ENDIF      
08DD                          IF   CPM   
08DD                             ; RAM pages, after the image
08DD                RSPAGE:   EQU   (imgend + 255) / 256   
08DD                DSPAGE:   EQU   RSPAGE + 1   
08DD                LETPAGE:   EQU   RSPAGE + 2   
08DD                PROG:     EQU   LETPAGE*256 + 256   
08DD                          ENDIF      
08DD                IMGEND:      


