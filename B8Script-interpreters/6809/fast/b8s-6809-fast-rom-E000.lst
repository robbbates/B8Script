E3E0                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
E3E0                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
E3E0                             ; the TOS cell the remainder. The remainder is built in D (always < the
E3E0                             ; divisor, so 2R+1 fits in 16 bits).
E3E0                             ; Dividing by 2 is one shift (the spec wants that fast). (base divides
E3E0                             ; by any power of two with shifts: its udiv is with the speed-ups, and
E3E0                             ; comes to ud0 for the rest; pdec, whose divisor is 10, goes straight there.)
E3E0                          IF   1-QK   
                    UDIV:     LDD   ,U   
                              SUBD   #2   
                              BNE   ud0   
                              LSR   2,U   
                              ROR   3,U   ; the quotient
                              ROLB      ; the remainder: the bit that fell out (D was 0)
                              BRA   ud3   
E3E0                          ENDIF      
E3E0                          IF   1-FAST   
                    UD0:      LDX   #16   
                              CLRA      
                              CLRB      
                    UD1:      ASL   3,U   
                              ROL   2,U   ; the dividend's top bit ...
                              ROLB      
                              ROLA      ; ... into the remainder
                              CMPD   ,U   
                              BLO   ud2   
                              SUBD   ,U   
                              INC   3,U   ; a quotient bit
                    UD2:      LEAX   -1,X   
                              BNE   ud1   
E3E0                          ENDIF      ; (the fast build's is unrolled: see the end)
E3E0   ED C4        UD3:      STD   ,U   
E3E2   39                     RTS      
E3E3                             ; pesc: the escapes of "$". A = the character after the "/", minus 60h
E3E3                             ; (0 to 30); Y points past it. Each returns to the loop with an RTS, its
E3E3                             ; own or that of the routine it ends by jumping to. A, B and X are free.
E3E3                             ;    /a-/z   print the variable, as "#" does
E3E3                             ;    /{      clear the screen, the cursor to the top left
E3E3                             ;    /}      clear from the cursor to the end of the line
E3E3                             ;    /|  /`  show the cursor, hide it
E3E3                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
E3E3   81 1B        PESC:     CMPA   #27   
E3E5   24 0F                  BHS   pcon   
E3E7   48                     ASLA      ; (` leaves A = 0: hide)
E3E8   27 18                  BEQ   phide   
E3EA   8E 82 3E               LDX   #LET+40h-2   ; the variable's cell (little-endian)
E3ED   EC 86                  LDD   A,X   
E3EF   1E 89                  EXG   A,B   
E3F1   36 06                  PSHU   D   
E3F3   7E E3 3E               JMP   h_num   
E3F6                          IF   1-ANSI   
E3F6   10 27 1B 12  PCON:     LBEQ   CONCLS   ; /{
E3FA   81 1D                  CMPA   #29   
E3FC   10 27 1B 0F            LBEQ   CONEOL   ; /}
E400   22 03                  BHI   pat   
E402   7E FF 12     PHIDE:    JMP   CONCUR   ; /|  (A = 28: show), /`  (A = 0: hide)
E405                          ENDIF      
E405                PAT:         
E405                          IF   CHECKED   
E405                             ; /~ checks first that there are a row and a column (with less it
E405                             ; is s, and the stack counts as empty): U is never let past the
E405                             ; top of the stack, however many /~ there are.
E405   11 83 81 F8            CMPU   #DSTOP-4   
E409   10 22 FC 20            LBHI   e_ds   ; (N is clear: an underflow)
E40D                          ENDIF      
E40D                          IF   1-ANSI   
E40D   37 16                  PULU   D,X   ; /~  D = the column, X = the row
E40F   7E FF 15               JMP   CONAT   
E412                          ENDIF      
E412                          IF   ANSI   
                                 ; /~  ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              PULU   D,X   ; D = the column, X = the row
                              ADDD   #1   
                              LEAX   1,X   
                              PSHU   D   
                              PSHU   X   
                              BSR   csi   
                              JSR   pdec   
                              BSR   pm   
                              FCB   ";"+80h   
                              JSR   pdec   
                              BSR   pm   
                              FCB   "H"+80h   
                              RTS      
                    PCON:     BEQ   pcls   ; /{
                              CMPA   #29   
                              BEQ   peol   ; /}
                              BHI   pat   
                              BSR   pcsi   ; /|  ESC [ ? 2 5 h
                              FCB   "?25","h"+80h   
                              RTS      
                    PHIDE:    BSR   pcsi   ; /`  ESC [ ? 2 5 l
                              FCB   "?25","l"+80h   
                              RTS      
                    PCLS:     BSR   pcsi   ; /{  ESC [ H ESC [ J
                              FCB   "H"+80h   
                              BSR   pcsi   
                              FCB   "J"+80h   
                              RTS      
                    PEOL:     BSR   pcsi   ; /}  ESC [ K
                              FCB   "K"+80h   
                              RTS      
                                 ; pcsi: ESC [ and then the text after the call, as pmsg. csi: ESC [.
                    CSI:      BSR   pm   
                              FCB   27,"["+80h   
                              RTS      
                    PCSI:     BSR   csi   
E412                          ENDIF      
E412                          IF   ANSI*(1-CHECKED)   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                                 ; (The checked build has its own, with the report: pm leads to it.)
                    PM:          
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              JSR   CONOUT   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
E412                          ENDIF      
E412                          IF   ANSI*CHECKED   
                    PM:       JMP   pmsg   
E412                          ENDIF      
E412                          IF   QK   
E412                             ; =============================================================================
E412                             ;  Speed-ups (base, and the fast build)
E412                             ; 
E412                             ;  The rest of them are with their handlers: "*" (h_mul), the unchecked
E412                             ;  a-z (lower), pdec (straight to the long divide) and the startup, which
E412                             ;  empties the skip cache. (A true ")" already reads the block start where
E412                             ;  it is, in every build, so there is nothing to gain there.)
E412                             ; =============================================================================
E412                             ; skip, with the skip cache. Nearly every skip is one that has happened
E412                             ; before (a loop skips the same false block on every pass), so the end of
E412                             ; each scan is remembered: 64 entries of 00bbc3RhcnQsIGVuZA== (big-endian), in the
E412                             ; page CPAGE, found by the start's low byte times 4. Only skips that start
E412                             ; in the program text hit (the line buffer changes); the cache is emptied
E412                             ; whenever a run starts. A program that changes its own text while it runs
E412                             ; is not looked after. A hit returns as the scan would: Y past the closer,
E412                             ; and A = 0 for ")" or 2 for "]".
E412   1F 20        SKIP:     TFR   Y,D   ; the start: the cache's key
E414   58                     ASLB      
E415   58                     ASLB      
E416   8E DF 00               LDX   #CPAGE*256   
E419   3A                     ABX      ; X -> the entry
E41A   10 AC 84               CMPY   ,X   
E41D   26 0F                  BNE   sks   
E41F   10 8C 83 00            CMPY   #PROG   
E423   25 09                  BLO   sks   ; below the program text: never a hit
E425   10 AE 02               LDY   2,X   ; a hit: the IP is past the closer,
E428   A6 3F                  LDA   -1,Y   ;   ")" (29h) or "]" (5Dh): 0 or 2
E42A   44                     LSRA      
E42B   84 02                  ANDA   #2   
E42D   39                     RTS      
E42E                             ; The scan, which fills the entry (X is kept throughout). A scan that fails
E42E                             ; ends the program, so an entry is never left half written for a later run
E42E                             ; to find. Two range tests rule most characters out: ^ and up, and * to Z.
E42E                             ; Only NUL " ( ) [ ] count. B counts the open levels.
E42E   10 AF 84     SKS:      STY   ,X   ; the key
E431   C6 FF                  LDB   #0FFh   
E433   5C           SQ3:      INCB      ; an opener: one deeper
E434   A6 A0        SQ1:      LDA   ,Y+   
E436   81 5E                  CMPA   #5Eh   
E438   24 FA                  BHS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E43A   81 5B                  CMPA   #5Bh   
E43C   24 19                  BHS   sqb   ; [ \ ]
E43E   81 2A                  CMPA   #2Ah   
E440   24 F2                  BHS   sq1   ; * to Z: nothing
E442   81 28                  CMPA   #28h   
E444   27 ED                  BEQ   sq3   ; (
E446   22 18                  BHI   sqc   ; )
E448   81 22                  CMPA   #22h   
E44A   27 05                  BEQ   sqq   ; a string
E44C   4D                     TSTA      
E44D   26 E5                  BNE   sq1   ; the rest below "(": nothing
E44F                          ENDIF      
E44F                          IF   QK*(1-CHECKED)   
                              JMP   fin   ; NUL: the end of the program
                    SQQ:      JSR   skipstr   ; step over the string
                              BRA   sq1   
E44F                          ENDIF      
E44F                          IF   QK*CHECKED   
E44F   4A                     DECA      ; NUL: A = FFh, and the caller decides
E450   39                     RTS      
E451   BD E1 87     SQQ:      JSR   skipstr   ; step over the string; A = FFh with the
E454   24 DE                  BCC   sq1   ;   carry set if it ran into the NUL
E456   39                     RTS      
E457                          ENDIF      
E457                          IF   QK   
E457   80 5C        SQB:      SUBA   #5Ch   ; [ -1, \ 0, ] 1
E459   27 D9                  BEQ   sq1   ; "\" is nothing here
E45B   25 D6                  BLO   sq3   ; [
E45D   86 02                  LDA   #2   ; ]
E45F   21                     FCB   21h   ; (BRN: steps over the CLRA)
E460   4F           SQC:      CLRA      ; )
E461   5A                     DECB      
E462   2A D0                  BPL   sq1   
E464   10 AF 02               STY   2,X   ; the closer at this level: the entry's end
E467   39                     RTS      
E468                             ; base: a power of two, 2^k, is a shift: q = a >> k and r = a AND (2^k - 1).
E468                             ; That is 2, and 256 for a high byte, and the 32 or 64 of fixed point.
E468   EC C4        UDIV:     LDD   ,U   
E46A   27 33                  BEQ   uqx   ; by 0: the long way (it means nothing anyway)
E46C   83 00 01               SUBD   #1   
E46F   1F 01                  TFR   D,X   ; X = d - 1
E471   A4 C4                  ANDA   ,U   
E473   26 2A                  BNE   uqx   
E475   E4 41                  ANDB   1,U   
E477   26 26                  BNE   uqx   ; not a power of two
E479   1F 10                  TFR   X,D   
E47B   A4 42                  ANDA   2,U   
E47D   E4 43                  ANDB   3,U   
E47F   34 06                  PSHS   D   ; r
E481   6D 41                  TST   1,U   
E483   26 09                  BNE   uq0   ; d < 256
E485   A6 C4                  LDA   ,U   ; 256 and up: d and a move a byte down
E487   A7 41                  STA   1,U   ;   (the low byte of d is all the loop
E489   E6 42                  LDB   2,U   ;   looks at)
E48B   4F                     CLRA      
E48C   20 02                  BRA   uq1   
E48E   EC 42        UQ0:      LDD   2,U   
E490   64 41        UQ1:      LSR   1,U   ; a moves down until d's one bit falls out
E492   25 04                  BCS   uq2   
E494   44                     LSRA      
E495   56                     RORB      
E496   20 F8                  BRA   uq1   
E498   ED 42        UQ2:      STD   2,U   ; q
E49A   35 06                  PULS   D   
E49C   ED C4                  STD   ,U   
E49E   39                     RTS      
E49F   7E ED A9     UQX:      JMP   ud0   ; (three short branches to one jump are
E4A2                             ;  3 bytes less than three long ones)
E4A2                          ENDIF      
E4A2                          IF   FAST   
E4A2                             ; =============================================================================
E4A2                             ;  The fast build (SPEED = 2)
E4A2                             ; 
E4A2                             ;  The inner loop is a table of 256 handler addresses, FTAB, one for every
E4A2                             ;  byte, and the dispatcher (NEXTF, at the top) is inline at the end of each
E4A2                             ;  of the fast build's own entries, so there is no return to a loop:
E4A2                             ; 
E4A2                             ;      LDB ,Y+ / LDX #FTAB / ABX / ABX / JMP [,X]
E4A2                             ; 
E4A2                             ;  (21 cycles; the checked build calls fchk first, which checks the stacks
E4A2                             ;  and keeps the place, as the ordinary inner loop does.) The entries are
E4A2                             ;  jumped to, not called, so nothing of the dispatcher's is on the return
E4A2                             ;  stack while they run. The letters and digits have one entry each, which
E4A2                             ;  knows its cell or its value already; the commonest punctuation has its
E4A2                             ;  own; the rest are thunks, JSR to the ordinary handler, which returns
E4A2                             ;  with its RTS as it would to the ordinary dispatcher.
E4A2                             ; =============================================================================
E4A2                          ENDIF      
E4A2                          IF   FAST*CHECKED   
E4A2                             ; fchk: the checks of the inner loop, for the checked fast build (S is 2
E4A2                             ; lower in here than when the character starts).
E4A2   30 C9 7E FE  FCHK:     LEAX   (0-DSLIM)&0FFFFh,U   
E4A6   8C 00 FA               CMPX   #DSTOP-DSLIM   
E4A9   10 22 FB 80            LBHI   e_ds   
E4AD   30 E9 7F C2            LEAX   (2-RSLIM)&0FFFFh,S   
E4B1   8C 00 C0               CMPX   #RSTOP-RSLIM   
E4B4   10 22 FB 7E            LBHI   e_rs   
E4B8   10 9F 36               STY   <AT   ; the place, should this character fail
E4BB   30 62                  LEAX   2,S   
E4BD   9F 3A                  STX   <SSAV   ; and the return stack, as it is then
E4BF   39                     RTS      
E4C0                FOPF:     EQU   opf   ; (a false "(": the checked skip)
E4C0                FSTORE:   EQU   ft_store   ; ("!" and "." are checked: the thunks)
E4C0                FCSTORE:   EQU   ft_cstore   
E4C0                FHIGH:    EQU   fhi   ; (80h-FFh: X)
E4C0   7E E0 46     FHI:      JMP   e_resv   ; 80h-FFh: reserved
E4C3                          ENDIF      
E4C3                          IF   FAST*(1-CHECKED)   
                    FOPF:     EQU   skip   
                    FSTORE:   EQU   fs_store   
                    FCSTORE:   EQU   fs_cstore   
                    FHIGH:    EQU   fign   ; (80h-FFh are ignored)
E4C3                          ENDIF      
E4C3                          IF   FAST   
E4C3                          ;*Macro unroll: fnext:  NEXTF                   ; the startup comes here
E4C3   BD           FNEXT:    DS   CHECKED,0BDh   ; the startup comes here
E4C4   E4                     DS   CHECKED,ACHK/256   
E4C5   A2                     DS   CHECKED,ACHK&0FFh   
E4C6   E6 A0                  LDB   ,Y+   
E4C8   8E EE 9E               LDX   #FTAB   
E4CB   3A                     ABX      
E4CC   3A                     ABX      
E4CD   6E 94                  JMP   [,X]   
E4CF   7E FF 09     FNUL:     JMP   EXIT   ; NUL: the end of the program
E4D2                          ;*Macro unroll: fign:   NEXTF                   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
E4D2   BD           FIGN:     DS   CHECKED,0BDh   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
E4D3   E4                     DS   CHECKED,ACHK/256   
E4D4   A2                     DS   CHECKED,ACHK&0FFh   
E4D5   E6 A0                  LDB   ,Y+   
E4D7   8E EE 9E               LDX   #FTAB   
E4DA   3A                     ABX      
E4DB   3A                     ABX      
E4DC   6E 94                  JMP   [,X]   
E4DE                             ; The thunks: the ordinary handler, then the dispatcher.
E4DE   BD E2 68     FT_STORE:   JSR   h_store   ; !
E4E1                          ;*Macro unroll:  NEXTF
E4E1   BD                     DS   CHECKED,0BDh   
E4E2   E4                     DS   CHECKED,ACHK/256   
E4E3   A2                     DS   CHECKED,ACHK&0FFh   
E4E4   E6 A0                  LDB   ,Y+   
E4E6   8E EE 9E               LDX   #FTAB   
E4E9   3A                     ABX      
E4EA   3A                     ABX      
E4EB   6E 94                  JMP   [,X]   
E4ED   BD E1 7A     FT_STR:   JSR   h_str   ; "
E4F0                          ;*Macro unroll:  NEXTF
E4F0   BD                     DS   CHECKED,0BDh   
E4F1   E4                     DS   CHECKED,ACHK/256   
E4F2   A2                     DS   CHECKED,ACHK&0FFh   
E4F3   E6 A0                  LDB   ,Y+   
E4F5   8E EE 9E               LDX   #FTAB   
E4F8   3A                     ABX      
E4F9   3A                     ABX      
E4FA   6E 94                  JMP   [,X]   
E4FC   BD E3 3E     FT_NUM:   JSR   h_num   ; #
E4FF                          ;*Macro unroll:  NEXTF
E4FF   BD                     DS   CHECKED,0BDh   
E500   E4                     DS   CHECKED,ACHK/256   
E501   A2                     DS   CHECKED,ACHK&0FFh   
E502   E6 A0                  LDB   ,Y+   
E504   8E EE 9E               LDX   #FTAB   
E507   3A                     ABX      
E508   3A                     ABX      
E509   6E 94                  JMP   [,X]   
E50B   BD E3 8B     FT_PRINT:   JSR   h_print   ; $
E50E                          ;*Macro unroll:  NEXTF
E50E   BD                     DS   CHECKED,0BDh   
E50F   E4                     DS   CHECKED,ACHK/256   
E510   A2                     DS   CHECKED,ACHK&0FFh   
E511   E6 A0                  LDB   ,Y+   
E513   8E EE 9E               LDX   #FTAB   
E516   3A                     ABX      
