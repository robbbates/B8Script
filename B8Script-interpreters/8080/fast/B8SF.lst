04F1                             ; (The table goes here instead in the builds where, before the routines, it
04F1                             ; would cross a page: PTLATE. If it would cross one here too, it starts on
04F1                             ; the next page: PTPAD is 0 unless it must.)
04F1                          IF   (1-FAST)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
04F1                          ENDIF      
04F1                          IF   1-CHECKED   
                                 ; "$" prints the string at TOS (see h_print).
                    PRLP:     MOV   A,M   
                              INX   H   
                              CPI   22h   
                              JZ   h_drop   
                              CPI   "/"   
                              JNZ   pr1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   pr0   
                              CPI   7Fh   
                              JC   pesc   
                    PR0:      ANI   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prlp   
04F1                          ENDIF      
04F1                             ;-----------------------------------------------------------------------------
04F1                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
04F1                             ; HL points past it. Each goes back into the loop that prints the string
04F1                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
04F1                             ;    /a-/z   print the variable, as "#" does
04F1                             ;    /{      clear the screen, the cursor to the top left
04F1                             ;    /}      clear from the cursor to the end of the line
04F1                             ;    /|  /`  show the cursor, hide it
04F1                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
04F1   FE 7E        PESC:     CPI   7Eh   
04F3   CA 16 05               JZ   pat   
04F6   11 51 07               LXI   D,PRLOOP   ; the others return into the loop
04F9   D5                     PUSH   D   
04FA   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
04FC   D2 57 05               JNC   pcon   
04FF   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0501   D2 41 05               JNC   phide   
0504   87                     ADD   A   ; the variable's cell
0505   C6 40                  ADI   40h   
0507   E5                     PUSH   H   
0508   C5                     PUSH   B   
0509   6F                     MOV   L,A   
050A   26 17                  MVI   H,LETPAGE   
050C   7E                     MOV   A,M   
050D   2C                     INR   L   
050E   66                     MOV   H,M   
050F   6F                     MOV   L,A   
0510   CD D0 04               CALL   psgn   
0513   C1                     POP   B   
0514   E1                     POP   H   
0515   C9                     RET      
0516                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0516                             ; the checked build "$" is the routine prstr: its own return address goes
0516                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0516                             ; its two cells are there, and is s if not, before it prints anything.
0516                PAT:         
0516                          IF   CHECKED   
0516   E3                     XTHL      ; the text pointer over prstr's return address
0517   21 0A E9               LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
051A   39                     DAD   SP   
051B   DA B2 07               JC   e_under   
051E   E1                     POP   H   
051F                          ENDIF      
051F   D1                     POP   D   ; DE = the column
0520   E3                     XTHL      ; HL = the row; the text pointer is kept
0521                          IF   1-ANS   
                              CALL   CONAT   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JZ   CONCLS   ; /{
                              CPI   2   
                              JZ   CONEOL   ; /}
                              DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
                    PHIDE:    XRA   A   ; /`  (A = 0: hide)
                              JMP   CONCUR   
0521                          ENDIF      
0521                          IF   ANS   
0521   C5                     PUSH   B   ; (pdec uses BC)
0522   D5                     PUSH   D   
0523   CD 70 05               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0526   23                     INX   H   
0527   CD DD 04               CALL   pdec   
052A   3E 3B                  MVI   A,";"   
052C                          ;*Macro unroll:  PUTA
052C                          DS   1-CPM,0EFh   
052C   CD                     DS   CPM,0CDh   
052D   0C                     DS   CPM,APUT&0FFh   
052E   07                     DS   CPM,APUT/256   
052F   E1                     POP   H   
0530   23                     INX   H   
0531   CD DD 04               CALL   pdec   
0534   3E 48                  MVI   A,"H"   
0536                          ;*Macro unroll:  PUTA
0536                          DS   1-CPM,0EFh   
0536   CD                     DS   CPM,0CDh   
0537   0C                     DS   CPM,APUT&0FFh   
0538   07                     DS   CPM,APUT/256   
0539   C1                     POP   B   
053A   E1                     POP   H   
053B   C3 83 02               JMP   PRAGAIN   
053E                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
053E   1E 68        PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
0540   DA                     DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
0541   1E 6C        PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
0543   3E 3F                  MVI   A,"?"   
0545   CD 67 05               CALL   csia   
0548   3E 32                  MVI   A,"2"   
054A                          ;*Macro unroll:  PUTA
054A                          DS   1-CPM,0EFh   
054A   CD                     DS   CPM,0CDh   
054B   0C                     DS   CPM,APUT&0FFh   
054C   07                     DS   CPM,APUT/256   
054D   3E 35                  MVI   A,"5"   
054F                          ;*Macro unroll:  PUTA
054F                          DS   1-CPM,0EFh   
054F   CD                     DS   CPM,0CDh   
0550   0C                     DS   CPM,APUT&0FFh   
0551   07                     DS   CPM,APUT/256   
0552   7B                     MOV   A,E   
0553                          ;*Macro unroll:  PUTA
0553                          DS   1-CPM,0EFh   
0553   CD                     DS   CPM,0CDh   
0554   0C                     DS   CPM,APUT&0FFh   
0555   07                     DS   CPM,APUT/256   
0556   C9                     RET      
0557                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0557   3D           PCON:     DCR   A   
0558   CA 3E 05               JZ   pshow   ; /|
055B   3E 4B                  MVI   A,"K"   
055D   F2 67 05               JP   csia   ; /}  ESC [ K
0560   3E 48                  MVI   A,"H"   ; /{  ESC [ H ESC [ J
0562   CD 67 05               CALL   csia   
0565   3E 4A                  MVI   A,"J"   ; (on into csia)
0567                             ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
0567   F5           CSIA:     PUSH   PSW   
0568   CD 70 05               CALL   csi   
056B   F1                     POP   PSW   
056C                          ;*Macro unroll:  PUTA
056C                          DS   1-CPM,0EFh   
056C   CD                     DS   CPM,0CDh   
056D   0C                     DS   CPM,APUT&0FFh   
056E   07                     DS   CPM,APUT/256   
056F   C9                     RET      
0570   3E 1B        CSI:      MVI   A,27   
0572                          ;*Macro unroll:  PUTA
0572                          DS   1-CPM,0EFh   
0572   CD                     DS   CPM,0CDh   
0573   0C                     DS   CPM,APUT&0FFh   
0574   07                     DS   CPM,APUT/256   
0575   3E 5B                  MVI   A,"["   
0577                          ;*Macro unroll:  PUTA
0577                          DS   1-CPM,0EFh   
0577   CD                     DS   CPM,0CDh   
0578   0C                     DS   CPM,APUT&0FFh   
0579   07                     DS   CPM,APUT/256   
057A   C9                     RET      
057B                          ENDIF      
057B                             ; skip: read past text to the closer at this level, and return A = 0 if it
057B                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
057B                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
057B                             ; no closer; anything else that runs into the NUL had unbalanced brackets
057B                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
057B                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
057B                             ; 
057B                             ; The checked build also looks at the character the skip was started by,
057B                             ; which is always the one just before where it starts: "(" must end at ")",
057B                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
057B                             ; quote counts as running into it. "\" takes either closer. The place where
057B                             ; the skip started is kept on the stack, for the report.
057B                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
057B                          ENDIF      
057B                          IF   CHECKED*(1-QK)   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
057B                          ENDIF      
057B                          IF   1-QK   
                              MVI   D,0   
                    SK3:      INR   D   ; an opener: one deeper
                    SK1:      LDAX   B   
057B                          ENDIF      
057B                          IF   (1-CHECKED)*(1-QK)   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
057B                          ENDIF      
057B                          IF   CHECKED*(1-QK)   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
057B                          ENDIF      
057B                          IF   1-QK   
                              CPI   22h   
                              CZ   skipstr   ; leaves A = 22h, which matches nothing below
                              SUI   "("   ;   (or 0, and then the NUL is read next)
                              JZ   sk3   
                              DCR   A   ; ")"
                              JZ   sk4   
                              SUI   "["-")"   
                              JZ   sk3   
                              CPI   "]"-"["   
                              JNZ   sk1   
                    SK4:      DCR   D   
057B                          ENDIF      
057B                          IF   (1-CHECKED)*(1-QK)   
                              RZ      ; the closer at this level
                              JMP   sk1   
057B                          ENDIF      
057B                          IF   CHECKED*(1-QK)   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
057B                          ENDIF      
057B                          IF   QK   
057B                             ; The skip cache. Nearly every skip is one that has happened before (a loop
057B                             ; skips the same false block on every pass), so the first scan from each
057B                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
057B                             ; by the start's low byte (times 4). Only skips that start in the program
057B                             ; text are kept (the line buffer changes); the cache is emptied whenever a
057B                             ; run starts (see start). A program that changes its own text while it
057B                             ; runs is not looked after.
057B   78           SKIP:     MOV   A,B   
057C   FE 18                  CPI   PROG/256   
057E   DA 9E 05               JC   sks   ; below the program text: no cache
0581   79                     MOV   A,C   
0582   87                     ADD   A   
0583   87                     ADD   A   
0584   5F                     MOV   E,A   
0585   16 14                  MVI   D,CPAGE   ; DE -> the entry
0587   1A                     LDAX   D   
0588   B9                     CMP   C   
0589   C2 9E 05               JNZ   sks   
058C   1C                     INR   E   
058D   1A                     LDAX   D   
058E   B8                     CMP   B   
058F   C2 9E 05               JNZ   sks   
0592   1C                     INR   E   
0593   1A                     LDAX   D   
0594   4F                     MOV   C,A   
0595   1C                     INR   E   
0596   1A                     LDAX   D   
0597   47                     MOV   B,A   ; a hit: the IP is past the closer
0598   0B                     DCX   B   
0599   0A                     LDAX   B   
059A   03                     INX   B   
059B   D6 29                  SUI   ")"   ; 0 for ")", not 0 for "]"
059D   C9                     RET      
059E   C5           SKS:      PUSH   B   ; where it starts: the cache's key (and the
059F                          ENDIF      ;   checked report's place)
059F                          IF   QK*CHECKED   
059F   0B                     DCX   B   
05A0   0A                     LDAX   B   
05A1   03                     INX   B   
05A2   5F                     MOV   E,A   ; E = the opener: ( [ or \
05A3                          ENDIF      
05A3                          IF   QK   
05A3                             ; The scan. Most characters are nothing to it, and two range tests rule
05A3                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
05A3   16 00                  MVI   D,0   
05A5   14           SQ3:      INR   D   ; an opener: one deeper
05A6   0A           SQ1:      LDAX   B   
05A7   03                     INX   B   
05A8   FE 5E                  CPI   5Eh   
05AA   D2 A6 05               JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
05AD   FE 5B                  CPI   5Bh   
05AF   D2 DB 05               JNC   sqb   ; [ \ ]
05B2   FE 2A                  CPI   2Ah   
05B4   D2 A6 05               JNC   sq1   ; * to Z: nothing
05B7   FE 28                  CPI   28h   
05B9   CA A5 05               JZ   sq3   ; (
05BC   D2 E6 05               JNC   sqc   ; )
05BF   FE 22                  CPI   22h   
05C1   CA D5 05               JZ   sqq   ; a string
05C4   B7                     ORA   A   
05C5   C2 A6 05               JNZ   sq1   ; the rest below "(": nothing
05C8                          ENDIF      
05C8                          IF   QK*(1-CHECKED)   
                              JMP   endprog   ; NUL: the end of the program
05C8                          ENDIF      
05C8                          IF   QK*CHECKED   
05C8   0B                     DCX   B   ; NUL: the IP stays on it
05C9   7B                     MOV   A,E   ; the text ran out:
05CA   E6 04                  ANI   4   
05CC   C2 44 01               JNZ   endprog   ;   "\" with no closer ends the program
05CF   C1                     POP   B   
05D0   3E 4E        SQ7:      MVI   A,"N"   ; N. The place is the opener
05D2   C3 E3 07               JMP   errp   ; (errp drops skip's return address)
05D5                          ENDIF      
05D5                          IF   QK   
05D5   CD 16 06     SQQ:      CALL   skipstr   ; step over the string
05D8   C3 A6 05               JMP   sq1   
05DB   D6 5C        SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
05DD   CA A6 05               JZ   sq1   ; "\" is nothing here
05E0   DA A5 05               JC   sq3   ; [
05E3   3E 02                  MVI   A,2   ; ]
05E5   FE                     DB   0FEh   ; (CPI: steps over the XRA)
05E6   AF           SQC:      XRA   A   ; )
05E7   15           SQ4:      DCR   D   
05E8   C2 A6 05               JNZ   sq1   
05EB                          ENDIF      
05EB                          IF   QK*CHECKED   
05EB   57                     MOV   D,A   ; the closer at this level (as above): 2 here
05EC   AB                     XRA   E   ;   means the wrong closer
05ED   E6 06                  ANI   6   
05EF   FE 02                  CPI   2   
05F1   7A                     MOV   A,D   
05F2   D1                     POP   D   ; (where the skip started)
05F3   C2 FB 05               JNZ   sq8   
05F6   42                     MOV   B,D   
05F7   4B                     MOV   C,E   
05F8   C3 D0 05               JMP   sq7   
05FB                SQ8:         
05FB                          ENDIF      
05FB                          IF   QK*(1-CHECKED)   
                              POP   D   ; where the skip started
05FB                          ENDIF      
05FB                          IF   QK   
05FB                             ; The closer at this level: remember the skip (if it started in the program
05FB                             ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
05FB   E5                     PUSH   H   
05FC   67                     MOV   H,A   
05FD   7A                     MOV   A,D   
05FE   FE 18                  CPI   PROG/256   
0600   DA 13 06               JC   sq9   
0603   7B                     MOV   A,E   
0604   87                     ADD   A   
0605   87                     ADD   A   
0606   6F                     MOV   L,A   
0607   7C                     MOV   A,H   
0608   26 14                  MVI   H,CPAGE   
060A   73                     MOV   M,E   
060B   2C                     INR   L   
060C   72                     MOV   M,D   
060D   2C                     INR   L   
060E   71                     MOV   M,C   
060F   2C                     INR   L   
0610   70                     MOV   M,B   
0611   E1                     POP   H   
0612   C9                     RET      
0613   7C           SQ9:      MOV   A,H   
0614   E1                     POP   H   
0615   C9                     RET      
0616                          ENDIF      
0616                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0616                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0616                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
0616                          ENDIF      
0616                          IF   CHECKED   
0616                             ; The checked build never steps over a NUL: if the text runs out first it
0616                             ; returns A = 0 with the IP on the NUL.
0616   0A           SKIPSTR:   LDAX   B   
0617   B7                     ORA   A   
0618   C8                     RZ      
0619   03                     INX   B   
061A   FE 22                  CPI   22h   
061C   C8                     RZ      
061D   FE 2F                  CPI   "/"   
061F   C2 16 06               JNZ   skipstr   
0622   0A                     LDAX   B   ; the escaped character
0623   B7                     ORA   A   
0624   C8                     RZ      
0625   03                     INX   B   
0626   C3 16 06               JMP   skipstr   
0629                          ENDIF      
0629                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0629                             ; and return its value in A with the carry set; otherwise leave the IP and
0629                             ; return with the carry clear.
0629   0A           HEXC:     LDAX   B   
062A   D6 30                  SUI   "0"   
062C   FE 0A                  CPI   10   
062E   DA 3A 06               JC   hc1   
0631   E6 DF                  ANI   0DFh   
0633   D6 11                  SUI   11h   
0635   FE 06                  CPI   6   
0637   D0                     RNC      
0638   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
063A   03           HC1:      INX   B   
063B   C9                     RET      
063C                             ;  ---- Speed-ups (base builds) -------------------------------------------
063C                             ;  The skip cache and "/" by a power of two are above. These are the
063C                             ;  handlers' tails that the builds with room take, kept here, out of the
063C                             ;  handlers' first two pages.
063C                          IF   QK   
063C                             ; "*" with an operand below 256: that one becomes the multiplier, a byte in
063C                             ; A, and the loop stops as soon as its bits are used up (most
063C                             ; multiplications have one, a count or a small constant). With both at 256
063C                             ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
063C                             ; shifted in above it says when), and its high byte goes on as a small one.
063C                             ; DE = NOS, HL = TOS.
063C   7C           MULQ:     MOV   A,H   
063D   B7                     ORA   A   
063E   CA 47 06               JZ   mq8   ; the multiplier is below 256
0641   7A                     MOV   A,D   
0642   B7                     ORA   A   
0643   C2 69 06               JNZ   mq16   
0646   EB                     XCHG      ; the multiplicand is: it becomes the multiplier
0647   7D           MQ8:      MOV   A,L   
0648   21 00 00               LXI   H,0   
064B   B7                     ORA   A   ; (clears the carry)
064C   CA 5B 06               JZ   mq9   
064F   1F           MQ1:      RAR      ; the next bit
0650   D2 54 06               JNC   mq2   
0653   19                     DAD   D   
0654   EB           MQ2:      XCHG      
0655   29                     DAD   H   ; multiplicand << 1
0656   EB                     XCHG      
0657   B7                     ORA   A   ; bits left? (and clears the carry)
0658   C2 4F 06               JNZ   mq1   
065B                          ;*Macro unroll: mq9:    NEXTQ
065B                MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
065B                          DS   CPM*(1-FAST),0C3h   
065B                          DS   CPM*(1-FAST),ANXT&0FFh   
065B                          DS   CPM*(1-FAST),ANXT/256   
065B   CD                     DS   FAST*CHECKED,0CDh   
065C   83                     DS   FAST*CHECKED,ACHK&0FFh   
065D   07                     DS   FAST*CHECKED,ACHK/256   
065E   0A                     DS   FAST,0Ah   
065F   03                     DS   FAST,03h   
0660   EB                     DS   FAST,0EBh   
0661   6F                     DS   FAST,6Fh   
0662   26                     DS   FAST,26h   
0663   12                     DS   FAST,DTPG   
0664   7E                     DS   FAST,7Eh   
0665   24                     DS   FAST,24h   
0666   66                     DS   FAST,66h   
0667   6F                     DS   FAST,6Fh   
0668   E9                     DS   FAST,0E9h   
0669   C5           MQ16:     PUSH   B   
066A   44                     MOV   B,H   ; the high byte, for later
066B   7D                     MOV   A,L   
066C   21 00 00               LXI   H,0   
066F   37                     STC      ; the marker
0670   1F                     RAR      
0671   D2 75 06     MQ3:      JNC   mq4   
0674   19                     DAD   D   
0675   EB           MQ4:      XCHG      
0676   29                     DAD   H   
0677   EB                     XCHG      
0678   FE 01                  CPI   1   ; only the marker left: 8 rounds done (and
067A   1F                     RAR      ;   the carry was clear for the shift)
067B   C2 71 06               JNZ   mq3   
067E   78                     MOV   A,B   
067F   C1                     POP   B   
0680   B7                     ORA   A   
0681   C3 4F 06               JMP   mq1   ; the high byte, as a small multiplier
0684                             ; A true ")" reads the block start where it is, on top of the return stack,
0684                             ; instead of popping it and pushing it back; the break key is looked at as
0684                             ; rpushd would.
0684   2A 34 17     CLOSEQ:   LHLD   RSP   
0687   4E                     MOV   C,M   
0688   23                     INX   H   
0689   46                     MOV   B,M   
068A   21 36 17               LXI   H,BRKCNT   
068D   35                     DCR   M   
068E   E1                     POP   H   ; (keeps the flags)
068F   CC A0 06               CZ   pollk   
0692                          ;*Macro unroll:  NEXTQ
0692                          DS   (1-CPM)*(1-FAST),0F7h   
0692                          DS   CPM*(1-FAST),0C3h   
0692                          DS   CPM*(1-FAST),ANXT&0FFh   
0692                          DS   CPM*(1-FAST),ANXT/256   
0692   CD                     DS   FAST*CHECKED,0CDh   
0693   83                     DS   FAST*CHECKED,ACHK&0FFh   
0694   07                     DS   FAST*CHECKED,ACHK/256   
0695   0A                     DS   FAST,0Ah   
0696   03                     DS   FAST,03h   
0697   EB                     DS   FAST,0EBh   
0698   6F                     DS   FAST,6Fh   
0699   26                     DS   FAST,26h   
069A   12                     DS   FAST,DTPG   
069B   7E                     DS   FAST,7Eh   
069C   24                     DS   FAST,24h   
069D   66                     DS   FAST,66h   
069E   6F                     DS   FAST,6Fh   
069F   E9                     DS   FAST,0E9h   
06A0                          ENDIF      
06A0                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWER:    EQU   lowq   
                    LOWQ:     ADD   A   
                              MOV   E,A   
                              MVI   D,LETPAGE   ; DE -> the cell
                              LDAX   B   
                              CPI   "@"   
                              JZ   lwf   
                              CPI   "!"   
                              JZ   lws   
                              PUSH   H   
                              XCHG      ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWF:      INX   B   ; x@: TOS = the cell's value
                              PUSH   H   
                              XCHG      
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              XCHG      
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
                              XCHG      
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
06A0                          ENDIF      
06A0                             ; =============================================================================
06A0                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
06A0                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
06A0                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
06A0                             ;  the host's KEY and CONOUT routines themselves.
06A0                             ; 
06A0                             ;  A running program reads the keyboard only through getk and pollk, which
06A0                             ;  between them give the break key its rules:
06A0                             ;    - Ctrl-C stops the program;
06A0                             ;    - any other key that the break check reads is held in KEYBUF for the
06A0                             ;      next "?", and a newer one takes its place;
06A0                             ;    - "?" (getk) takes the held key first;
06A0                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
06A0                             ;      key like any other, but two of them within about 250 ms still stop it.
06A0                             ;  Both are called straight from a handler, never from a routine under one:
06A0                             ;  the checked build's report counts on finding one return address above the
06A0                             ;  data stack, and TOS in HL.
06A0                             ; =============================================================================
06A0                          IFN   CPM   
                    RAWK:     EQU   KEY   
06A0                          ENDIF      
06A0                             ; pollk: the break check (see rpushd).
06A0   CD 0A 07     POLLK:    CALL   rawk   
06A3   C8                     RZ      ; no key
06A4   32 7A 17               STA   KEYBUF   ; held for the next "?"
06A7   FE 03        PK1:      CPI   3   ; (getk joins here)
06A9   C0                     RNZ      
06AA                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
06AA                             ; the program has turned it off, wait about 250 ms for one more key: a
06AA                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
06AA                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
06AA   3A 7B 17     CTLC:     LDA   BRKOFF   
06AD   B7                     ORA   A   
06AE   CA 4C 07               JZ   brk   
06B1   D5                     PUSH   D   
06B2   11 E8 03               LXI   D,250*MSLOOP   
06B5   CD 0A 07     CT1:      CALL   rawk   
06B8   C2 C1 06               JNZ   ct2   
06BB   1B                     DCX   D   
06BC   7A                     MOV   A,D   
06BD   B3                     ORA   E   
06BE   C2 B5 06               JNZ   ct1   
06C1   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
06C2   FE 03                  CPI   3   
06C4   CA 4C 07               JZ   brk   
06C7   B7                     ORA   A   
06C8   CA CE 06               JZ   ct3   
06CB   32 7A 17               STA   KEYBUF   
06CE   3E 03        CT3:      MVI   A,3   
06D0   B7                     ORA   A   
06D1   C9                     RET      
06D2                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
06D2   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
06D3   21 7A 17               LXI   H,KEYBUF   ;   the buffer
06D6   7E                     MOV   A,M   
06D7   36 00                  MVI   M,0   
06D9   E1                     POP   H   
06DA   B7                     ORA   A   
06DB   C0                     RNZ      
06DC   CD 0A 07               CALL   rawk   
06DF   C8                     RZ      
06E0   C3 A7 06               JMP   pk1   ; Ctrl-C? If not, that is the key
06E3                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
06E3                          ENDIF      
06E3                          IF   CHECKED   
06E3                BRK:      EQU   e_break   ;   the checked build reports B
06E3                          ENDIF      
06E3                          IF   CPM   
06E3                             ; (In a CP/M build the letters and digits are here, out of the way of the
06E3                             ; handlers, which must fit in the image's first two pages. The same code as
06E3                             ; in the generic build.)
06E3                             ; ---- the letters and digits --------------------------------------------------
06E3                             ; a-z: push the cell's address (the cell is the variable)
06E3                          ENDIF      
06E3                          IF   CPM*(1-SBASEU)   
06E3   E5           LOWER:    PUSH   H   
06E4   87                     ADD   A   
06E5   6F                     MOV   L,A   
06E6   26 17                  MVI   H,LETPAGE   
06E8                          ;*Macro unroll:  NEXT
06E8                          DS   (1-CPM)*(1-FAST),0F7h   
06E8   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
06E9   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
06EA   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
06EB                          ENDIF      
06EB                          IF   CPM   
06EB                             ; A-Z: call the word. The return address (the IP after the letter) goes on
06EB                             ; the return stack, and the IP becomes the address in the letter's cell.
06EB   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
06EC   87                     ADD   A   
06ED   6F                     MOV   L,A   
06EE   26 17                  MVI   H,LETPAGE   ; HL -> cell
06F0   50                     MOV   D,B   
06F1   59                     MOV   E,C   ; DE = the return address
06F2   4E                     MOV   C,M   
06F3   23                     INX   H   
06F4   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
06F5                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
06F5                             ; go on. Every push of the return stack ends here: for a word call the cell
06F5                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
06F5                             ; the one that was used up.
06F5                             ; 
06F5                             ; The break key is looked at here, so at every word call and loop-back (and
06F5                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
06F5                             ; the keyboard can be slow (it is a BDOS call under CP/M).
06F5   2A 34 17     RPUSHD:   LHLD   RSP   
06F8   2B                     DCX   H   
06F9   72                     MOV   M,D   
06FA   2B                     DCX   H   
06FB   73                     MOV   M,E   
06FC   22 34 17               SHLD   RSP   
06FF   21 36 17               LXI   H,BRKCNT   
0702   35                     DCR   M   
0703   E1                     POP   H   ; (keeps the flags)
0704   CC A0 06               CZ   pollk   
0707                          ;*Macro unroll:  NEXT
0707                          DS   (1-CPM)*(1-FAST),0F7h   
0707   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0708   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0709   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
070A   3E FF        RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
070C                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
070C                             ; printing and could swallow a key that BDOS 6 then never sees.
070C   C5           PUTC:     PUSH   B   
070D   D5                     PUSH   D   
070E   E5                     PUSH   H   
070F   5F                     MOV   E,A   
0710   0E 06                  MVI   C,6   
0712   CD 05 00               CALL   BDOS   
0715   E1                     POP   H   
0716   D1                     POP   D   
0717   C1                     POP   B   
0718   B7                     ORA   A   ; (for getk)
0719   C9                     RET      
071A                          ENDIF      
071A                             ; =============================================================================
071A                             ;  Checked build: the checks and the error report
071A                             ; =============================================================================
071A                          IF   CHECKED   
071A                             ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
071A                             ; it, and the old top is on the stack under the return address. Stop if the
071A                             ; new top is not below the limit page, or is below the program's end.
071A                CHKHP:       
071A                          ENDIF      
071A                          IF   CHECKED*CPM   
071A                             ; With this much room a top that wrapped round can land back in
071A                             ; range, so the add is tested too: growing must not carry, and
071A                             ; releasing must.
071A   7A                     MOV   A,D   
071B   1F                     RAR      ; the carry comes in above the count's sign:
071C   C6 40                  ADI   40h   ;   bit 7 = carry XOR sign
071E   87                     ADD   A   
071F   DA 33 07               JC   e_heap   
0722   3A 07 00               LDA   0007h   
0725   3D                     DCR   A   
0726   BC                     CMP   H   
0727   DA 33 07               JC   e_heap   
072A                          ENDIF      
072A                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
072A                          ENDIF      
072A                          IF   CHECKED   
072A   EB                     XCHG      
072B   E5                     PUSH   H   ; the count
072C   2A 38 17               LHLD   NPEND   
072F   19                     DAD   D   ; carry: at or above the program's end
0730   E1                     POP   H   
0731   EB                     XCHG      
0732   D8                     RC      
0733   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
0734   D1                     POP   D   ;   and drop the return address (errp drops
0735   3E 48                  MVI   A,"H"   ;   the old top)
0737   C3 E3 07               JMP   errp   
073A                             ; chkst: stop unless HL is in the program's own space: from the letter page
073A                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
073A                             ; whatever lies above the limit are safe. Memory above the heap top but
073A                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
073A                             ; It is the page of HL + 1 that is tested, so that one test serves both
073A                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
073A                             ; Keeps HL and BC. It runs on into its own error entry.
073A   23           CHKST:    INX   H   
073B   7C                     MOV   A,H   
073C   2B                     DCX   H   
073D   FE 17                  CPI   LETPAGE   
073F   DA 49 07               JC   e_store   
0742                          ENDIF      
0742                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
0742                          ENDIF      
0742                          IF   CHECKED*CPM   
0742   5F                     MOV   E,A   
0743   3A 07 00               LDA   0007h   ; the BDOS page is the heap limit
0746   3D                     DCR   A   
0747   BB                     CMP   E   
0748   D0                     RNC      
0749                          ENDIF      
0749                          IF   CHECKED   
0749                             ; Two error entries for errors found inside a routine: the first hides the
0749                             ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
0749                             ; return address.
0749   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
074B   11                     DB   11h   
074C   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
074E   C3 E3 07               JMP   errp   
0751                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0751                             ; "$", and the error report's texts). A NUL first is an error: Q.
0751   7E           PRSTR:    MOV   A,M   
0752   23                     INX   H   
0753   FE 22                  CPI   22h   
0755   C8                     RZ      
0756   B7                     ORA   A   
0757   CA CB 07               JZ   e_dollar   
075A   FE 2F                  CPI   "/"   
075C   C2 6D 07               JNZ   prs1   
075F   7E                     MOV   A,M   
0760   23                     INX   H   
0761   FE 60                  CPI   60h   
0763   DA 6B 07               JC   prs0   
0766   FE 7F                  CPI   7Fh   
0768   DA F1 04               JC   pesc   
076B   E6 BF        PRS0:     ANI   0BFh   
076D                          ;*Macro unroll: prs1:   PUTA
076D                PRS1:     DS   1-CPM,0EFh   
076D   CD                     DS   CPM,0CDh   
076E   0C                     DS   CPM,APUT&0FFh   
076F   07                     DS   CPM,APUT/256   
0770   C3 51 07               JMP   prstr   
0773                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0773                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0773                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0773                             ; pnl: the same, on a new line.
0773   3E 0D        PNL:      MVI   A,13   
0775                          ;*Macro unroll:  PUTA
0775                          DS   1-CPM,0EFh   
0775   CD                     DS   CPM,0CDh   
0776   0C                     DS   CPM,APUT&0FFh   
0777   07                     DS   CPM,APUT/256   
0778   3E 0A                  MVI   A,10   
077A                          ;*Macro unroll:  PUTA
077A                          DS   1-CPM,0EFh   
077A   CD                     DS   CPM,0CDh   
077B   0C                     DS   CPM,APUT&0FFh   
077C   07                     DS   CPM,APUT/256   
077D   E3           PMSG:     XTHL      
077E   CD 51 07               CALL   prstr   
0781   E3                     XTHL      
0782   C9                     RET      
0783                             ; chkstk: both stacks are checked once per character, not in every handler.
0783                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0783                             ; the constant carries if it is above (cells were popped that were never
0783                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0783                             ; a character late at most: the bytes above DSTOP and the guard band below
0783                             ; the page take what happens meanwhile.
0783   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
0784   21 05 E9               LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0787   39                     DAD   SP   
0788   DA B2 07               JC   e_under   
078B   24                     INR   H   
078C   C2 AC 07               JNZ   e_over   
078F   2A 34 17               LHLD   RSP   ; the return stack: in its page (or it has
0792   7C                     MOV   A,H   ;   overflowed), and not above its empty
0793   FE 15                  CPI   RSPAGE   ;   position (an underflow stays inside the
0795   C2 A9 07               JNZ   e_rover   ;   page, in the guard band)
0798   7D                     MOV   A,L   
0799   FE E1                  CPI   RSTOP&0FFh+1   
079B   D2 A0 07               JNC   e_runder   
079E   EB                     XCHG      ; TOS back
079F   C9                     RET      
07A0   21 E0 15     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
07A3   22 34 17               SHLD   RSP   
07A6   3E 72                  MVI   A,"r"   
07A8   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
07A9   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
07AB   21                     DB   21h   
07AC   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
07AE   EB                     XCHG      ; TOS back
07AF   C3 E3 07               JMP   errp   
07B2   31 FC 16     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
07B5   3E 73                  MVI   A,"s"   
07B7   C3 E4 07               JMP   error   
07BA                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
07BA                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
07BA                             ; every build: if the IP is in page zero, this was a call of an undefined
07BA                             ; word. The call is undone, so the place is the call itself.
07BA   04           E_HI:     INR   B   
07BB   05                     DCR   B   
07BC   C2 DA 07               JNZ   e_resv   
07BF   E5                     PUSH   H   
07C0                          ;*Macro unroll:  POPR
07C0                          DS   1-CPM,0CFh   
07C0   CD                     DS   CPM,0CDh   
07C1   0C                     DS   CPM,AROP&0FFh   
07C2   01                     DS   CPM,AROP/256   
07C3   44                     MOV   B,H   
07C4   4D                     MOV   C,L   
07C5   E1                     POP   H   
07C6   3E 55                  MVI   A,"U"   
07C8   C3 E4 07               JMP   error   
07CB                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
07CB                             ; back in TOS. prstr"s return address goes first. But if "$' had no
07CB                             ; address at all (the stack was empty), it is s, found now: chkstk, called
07CB                             ; one cell up, sees the stack past its empty place then.
07CB   D1           E_DOLLAR:   POP   D   
07CC   E1                     POP   H   
07CD   CD 83 07               CALL   chkstk   
07D0   E5                     PUSH   H   
07D1   2A 3A 17               LHLD   PSAVE   
07D4   11                     DB   11h   ; (LXI D hides e_quote's first two bytes)
07D5                             ; Error entries. Each loads its letter and then hides the next entry inside
07D5                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
07D5   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
07D6   4D                     MOV   C,L   ;   past the opening quote, which is the place
07D7   3E 51                  MVI   A,"Q"   
07D9   11                     DB   11h   
07DA   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
07DC   11                     DB   11h   
07DD   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
07DF   11                     DB   11h   
07E0   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
07E2   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
07E3                             ; errp: an error found inside a routine: drop its return address first.
07E3   D1           ERRP:     POP   D   
07E4                             ; error: the report, then the end. A = the letter, BC = one past the place,
07E4                             ; HL = TOS, and both stacks as the report is to show them:
07E4                             ; 
07E4                             ;   Err X @ line,col
07E4                             ;   D:n: the top 8 cells at most, bottom to top
07E4                             ;   R:n
07E4   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
07E5   5F                     MOV   E,A   
07E6   CD 73 07               CALL   pnl   
07E9   45 72 72 20 22         DB   "Err ",22h   
07EE   7B                     MOV   A,E   
07EF                          ;*Macro unroll:  PUTA
07EF                          DS   1-CPM,0EFh   
07EF   CD                     DS   CPM,0CDh   
07F0   0C                     DS   CPM,APUT&0FFh   
07F1   07                     DS   CPM,APUT/256   
07F2   CD 7D 07               CALL   pmsg   
07F5   20 40 20 22            DB   " @ ",22h   
07F9   0B                     DCX   B   ; BC = the place
07FA                             ; The line and column. A place below the program is in the line
07FA                             ; buffer: line 0. Otherwise count the LFs from the program's start;
07FA                             ; DE = the line's number, HL = where it starts.
07FA   21 80 17               LXI   H,LINEBUF   
07FD   11 00 00               LXI   D,0   
0800   78                     MOV   A,B   
0801   FE 18                  CPI   PROG/256   
0803   DA 1D 08               JC   er3   
0806   24                     INR   H   
0807   6B                     MOV   L,E   ; HL = PROG
0808   13           ER1:      INX   D   ; a new line starts at HL
0809   E5                     PUSH   H   
080A   7D           ER2:      MOV   A,L   
080B   91                     SUB   C   
080C   7C                     MOV   A,H   
080D   98                     SBB   B   
080E   D2 1C 08               JNC   er2x   ; reached the place
0811   7E                     MOV   A,M   
0812   23                     INX   H   
0813   FE 0A                  CPI   10   
0815   C2 0A 08               JNZ   er2   
0818   F1                     POP   PSW   
0819   C3 08 08               JMP   er1   
081C   E1           ER2X:     POP   H   
081D   C5           ER3:      PUSH   B   
081E   E5                     PUSH   H   
081F   EB                     XCHG      
0820   CD DD 04               CALL   pdec   ; the line
0823   3E 2C                  MVI   A,","   
0825                          ;*Macro unroll:  PUTA
0825                          DS   1-CPM,0EFh   
0825   CD                     DS   CPM,0CDh   
0826   0C                     DS   CPM,APUT&0FFh   
0827   07                     DS   CPM,APUT/256   
0828   D1                     POP   D   
0829   E1                     POP   H   
082A   CD 9B 08               CALL   sub16   
082D   23                     INX   H   
082E   CD DD 04               CALL   pdec   ; the column
0831   CD 73 07               CALL   pnl   
0834   44 3A 22               DB   "D:",22h   
0837   21 06 E9               LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
083A   39                     DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
083B                          ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
083B                          DS   1-CPM,0E7h   ;   first value and holds nothing)
083B   CD                     DS   CPM,0CDh   
083C   27                     DS   CPM,ANEG&0FFh   
083D   01                     DS   CPM,ANEG/256   
083E   7C                     MOV   A,H   
083F   CD 8F 08               CALL   phal2   ; the depth
0842   3E 3A                  MVI   A,":"   
0844                          ;*Macro unroll:  PUTA
0844                          DS   1-CPM,0EFh   
0844   CD                     DS   CPM,0CDh   
0845   0C                     DS   CPM,APUT&0FFh   
0846   07                     DS   CPM,APUT/256   
0847   79                     MOV   A,C   
0848   FE 09                  CPI   9   
084A   DA 57 08               JC   er6   
084D   CD 7D 07               CALL   pmsg   
0850   20 2E 2E 2E 22         DB   " ...",22h   
0855   0E 08                  MVI   C,8   
0857   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
0859   69                     MOV   L,C   
085A   29                     DAD   H   
085B   39                     DAD   SP   ; HL -> just above the deepest of them
085C   0C                     INR   C   
085D   0D           ER7:      DCR   C   
085E   CA 75 08               JZ   er8   
0861   2B                     DCX   H   
0862   56                     MOV   D,M   
0863   2B                     DCX   H   
0864   5E                     MOV   E,M   
0865   E5                     PUSH   H   
0866   C5                     PUSH   B   
0867   3E 20                  MVI   A," "   
0869                          ;*Macro unroll:  PUTA
0869                          DS   1-CPM,0EFh   
0869   CD                     DS   CPM,0CDh   
086A   0C                     DS   CPM,APUT&0FFh   
086B   07                     DS   CPM,APUT/256   
086C   EB                     XCHG      
086D   CD D0 04               CALL   psgn   
0870   C1                     POP   B   
0871   E1                     POP   H   
0872   C3 5D 08               JMP   er7   
0875   CD 73 07     ER8:      CALL   pnl   
0878   52 3A 22               DB   "R:",22h   
087B   2A 34 17               LHLD   RSP   
087E   EB                     XCHG      
087F   21 E0 15               LXI   H,RSTOP   
0882   CD 8C 08               CALL   phalf   
0885   CD 73 07               CALL   pnl   
0888   22                     DB   22h   
0889   C3 44 01               JMP   endprog   
088C                             ; phalf: print half of HL - DE, and leave it in BC
088C   CD 9B 08     PHALF:    CALL   sub16   
088F   B7           PHAL2:    ORA   A   ; (A = H; this clears the carry)
0890   1F                     RAR      
0891   67                     MOV   H,A   
0892   7D                     MOV   A,L   
0893   1F                     RAR      
0894   6F                     MOV   L,A   
0895   E5                     PUSH   H   
0896   CD DD 04               CALL   pdec   
0899   C1                     POP   B   
089A   C9                     RET      
089B                             ; sub16: HL = HL - DE. Leaves A = H.
089B   7D           SUB16:    MOV   A,L   
089C   93                     SUB   E   
089D   6F                     MOV   L,A   
089E   7C                     MOV   A,H   
089F   9A                     SBB   D   
08A0   67                     MOV   H,A   
08A1   C9                     RET      
08A2                          ENDIF      
08A2                             ; =============================================================================
08A2                             ;  Startup
08A2                             ; =============================================================================
08A2                START:       
08A2                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
08A2                          ENDIF      
08A2                          IF   QK   
08A2   21 00 14               LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
08A5   AF                     XRA   A   ;   start of 0000h matches no skip)
08A6   77           SKC1:     MOV   M,A   
08A7   2C                     INR   L   
08A8   C2 A6 08               JNZ   skc1   
08AB                          ENDIF      
08AB                          IF   CHECKED   
08AB                             ; Clear the lower half of the letter page: every variable starts at
08AB                             ; 0, every word cell holds 0000h, the address an undefined word is
08AB                             ; caught at (see e_hi), and no key is held back.
08AB   21 00 17               LXI   H,LET   
08AE   AF                     XRA   A   
08AF   77           INI1:     MOV   M,A   
08B0   2C                     INR   L   
08B1   F2 AF 08               JP   ini1   ; +00h to +7Fh
08B4                          ENDIF      
08B4                          IF   CPM   
08B4                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
08B4   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
08B7   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
08B9   CD 05 00               CALL   BDOS   ;   and the program is empty)
08BC   11 00 18               LXI   D,PROG   
08BF   D5           LD1:      PUSH   D   
08C0   0E 1A                  MVI   C,26   ; set the DMA address
08C2   CD 05 00               CALL   BDOS   
08C5   11 5C 00               LXI   D,005Ch   
08C8   0E 14                  MVI   C,20   ; read the next 128 bytes
08CA   CD 05 00               CALL   BDOS   
08CD   E1                     POP   H   ; HL = the address this record went to
08CE   B7                     ORA   A   
08CF   C2 DA 08               JNZ   ld2   
08D2   11 80 00               LXI   D,128   
08D5   19                     DAD   D   
08D6   EB                     XCHG      
08D7   C3 BF 08               JMP   ld1   
08DA   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
08DC   23                     INX   H   ; the heap starts after it
08DD                          ENDIF      
08DD                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
08DD                          ENDIF      
08DD   22 7C 17               SHLD   HEAP   
08E0                          IF   CHECKED   
08E0                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
08E0                          DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
08E0   CD                     DS   CPM,0CDh   
08E1   27                     DS   CPM,ANEG&0FFh   
08E2   01                     DS   CPM,ANEG/256   
08E3   22 38 17               SHLD   NPEND   ;   release below it
08E6                          ENDIF      
08E6   21 E0 15               LXI   H,RSTOP   ; the return stack is empty
08E9   22 34 17               SHLD   RSP   
08EC                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
08EC                          ENDIF      ;   checked build has cleared these)
08EC                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
08EC                          ENDIF      
08EC                          IF   1-CHECKED   
                              SHLD   KEYBUF   
08EC                          ENDIF      
08EC   01 00 18               LXI   B,PROG   ; the IP
08EF                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
08EF                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
08EF   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
08F0   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
08F1   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
08F2                          IF   FAST   
08F2                             ; =============================================================================
08F2                             ;  The fast build (SPEED = 2)
08F2                             ; 
08F2                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
08F2                             ;  addresses in one page and the high bytes in the next. The dispatcher (at
08F2                             ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
08F2                             ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
08F2                             ; 
08F2                             ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
08F2                             ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
08F2                             ; 
08F2                             ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
08F2                             ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
08F2                             ;  the letters and digits have one entry each, which knows its cell or its
08F2                             ;  value already.
08F2                             ; =============================================================================
08F2   EB           FTSTORE:   XCHG      ; !
08F3   C3 5F 02               JMP   h_store   
08F6   EB           FTSTR:    XCHG      ; "
08F7   C3 73 02               JMP   h_str   
08FA   EB           FTNUM:    XCHG      ; #
08FB   C3 92 02               JMP   h_num   
08FE   EB           FTPRINT:   XCHG      ; $
08FF   C3 80 02               JMP   h_print   
0902   EB           FTEMIT:   XCHG      ; '
0903   C3 8A 02               JMP   h_emit   
0906   EB           FTCSTORE:   XCHG      ; .
0907   C3 6A 02               JMP   h_cstore   
090A   EB           FTDIV:    XCHG      ; /
090B   C3 2D 02               JMP   h_div   
090E   EB           FTKEY:    XCHG      ; ?
090F   C3 A1 02               JMP   h_key   
0912   EB           FTDEF:    XCHG      ; [
0913   C3 AA 01               JMP   h_def   
0916   EB           FTBREAK:   XCHG      ; \
0917   C3 9B 01               JMP   h_break   
091A   EB           FTALLOC:   XCHG      ; _
091B   C3 62 01               JMP   h_alloc   
091E   EB           FTGRAVE:   XCHG      ; `
091F   C3 72 01               JMP   h_grave   
0922                             ; The commonest punctuation, written for the fast build: TOS in DE on the
0922                             ; way in, and the dispatcher inline on the way out.
0922   E1           FS_ADD:   POP   H   ; +
0923   19                     DAD   D   
0924                          ;*Macro unroll:  NEXTF
0924   CD                     DS   FAST*CHECKED,0CDh   
0925   83                     DS   FAST*CHECKED,ACHK&0FFh   
0926   07                     DS   FAST*CHECKED,ACHK/256   
