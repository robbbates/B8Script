01BA   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01BC   CD 06 FF     KT2:      CALL   getk   
01BF   20 0E                  JR   NZ,kt3   
01C1   1D                     DEC   E   
01C2   20 F8                  JR   NZ,kt2   
01C4   7C                     LD   A,H   ; 0? never counts down: it waits
01C5   B5                     OR   L   
01C6   28 F2                  JR   Z,kt1   
01C8   2B                     DEC   HL   
01C9   7C                     LD   A,H   
01CA   B5                     OR   L   
01CB   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01CD   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01CE   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01CF   6F           KT3:      LD   L,A   
01D0   26 00                  LD   H,0   
01D2   F7                     RST   30h   
01D3                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
01D3                          ENDIF      
01D3                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
