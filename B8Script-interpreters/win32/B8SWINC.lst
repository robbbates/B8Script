   762                              <1> ; ---- machine code: the grave -----------------------------------------------
   763                              <1> ; '`' plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
   764                              <1> ; are stored from addr until a non-hex character; then a RET (C3h) is
   765                              <1> ; written and its address is left. An odd last digit is consumed and its
   766                              <1> ; byte is overwritten by the RET. (Never range-checked: the spec says so.)
   767                              <1> ; '`' plus anything else calls the machine code at TOS: ( addr -- ).
   768                              <1> ;
   769                              <1> ; The machine-code contract: the code is entered by CALL, with the return
   770                              <1> ; address at [ESP] and the data stack above it: [ESP+4] is the top cell
   771                              <1> ; (the one under the address, which was consumed), [ESP+8] the next, one
   772                              <1> ; dword per cell, the cell in the low word. EBX holds the code's own
   773                              <1> ; address (ARENA + addr), and its high word is the arena's (0041h): a
   774                              <1> ; B8Script address a is the byte at ARENA + a. The code may push and pop
   775                              <1> ; dwords, and may change EAX, EBX, ECX, EDX and the flags; it must keep
   776                              <1> ; ESI, EDI and EBP, leave the direction flag clear, and return with RET
   777                              <1> ; (C3h, which the loader writes). On return the dword on top of the stack
   778                              <1> ; becomes TOS. Only the low word of each cell counts: the interpreter puts
   779                              <1> ; the arena's high word back into every cell on the stack.
   780                              <1> grave1: CALLP   hexc
   780                              <2> grave1: 
   192                              <2>  %if P_%1
   193 00000247 FF55D9              <2>  call [V(p_%1)]
   194                              <2>  %else
   195                              <2>  call %1
   196                              <2>  %endif
   781 0000024A 7317                <1>         jnc     .ex
   782 0000024C 8803                <1> .hx1:   mov     [ebx],al                ; the high digit goes in first ...
   783                              <1>         CALLP   hexc
