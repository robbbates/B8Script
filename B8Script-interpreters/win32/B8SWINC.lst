  1223                              <1> 
  1224                              <1> ; =============================================================================
  1225                              <1> ;  The line editor (EDITOR = 1)
  1226                              <1> ;
  1227                              <1> ;  The interpreter starts here, and a program that ends comes back here.
  1228                              <1> ;  There is no prompt. It follows the spec's suggested standard for a line
  1229                              <1> ;  editor (docs/b8script.md, Environments), and is the Z80's editor, key for
  1230                              <1> ;  key. Type a line and press Return:
  1231                              <1> ;
  1232                              <1> ;    n text    put the text in as line n; the lines from n on move down. A
  1233                              <1> ;              number past the end (or 0) adds the line at the end.
  1234                              <1> ;    n         take line n out
  1235                              <1> ;    anything else is run at once, as B8Script. (Start such a line with a
  1236                              <1> ;    space if it would begin with a digit.)
  1237                              <1> ;
  1238                              <1> ;  A command key ends the line too, and takes what was typed as its argument:
  1239                              <1> ;
  1240                              <1> ;    ^G        run the program
  1241                              <1> ;    n ^L      list from line n (no number: all of it). Any key holds the
  1242                              <1> ;              list until another key is pressed; Ctrl-C ends it.
  1243                              <1> ;    n ^E      put line n in the input line; Return puts it back, changed
  1244                              <1> ;    name ^R   read the file of that name (no name: the current one: the
  1245                              <1> ;              one from the command line, or the last one typed)
  1246                              <1> ;    name ^W   write the program to that file (no name: the current one)
  1247                              <1> ;    ^N ^N     new: no program (the key twice in a row)
  1248                              <1> ;    ^V        view: the build, both stacks, and the program's size, lines
  1249                              <1> ;              and free memory
  1250                              <1> ;    ^X        leave
  1251                              <1> ;
  1252                              <1> ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
  1253                              <1> ;  a character goes in at the cursor; Backspace and DEL take out the one
  1254                              <1> ;  before it; Esc drops the line (after Esc it waits 5 ms for a '[': Esc [ C
  1255                              <1> ;  and Esc [ D are right and left too). Only CR, LF, BS and printing
  1256                              <1> ;  characters are sent to the terminal.
  1257                              <1> ;
  1258                              <1> ;  Lines are counted, not numbered. A typed line holds 125 characters; the
  1259                              <1> ;  one character after a line number separates it from the text and is not
  1260                              <1> ;  stored. The text is kept as typed, each line ending in CR LF, at PROG. A
  1261                              <1> ;  file is read up to its first ^Z, and a last line with no line end is
  1262                              <1> ;  given one; it is written as it is, with no padding.
  1263                              <1> ;
  1264                              <1> ;  What lasts from one line to the next: the program, the words, the
  1265                              <1> ;  variables and the data stack (TOS is kept pushed while the editor runs).
  1266                              <1> ;  An error or a break clears both stacks. The return stack starts empty for
  1267                              <1> ;  every line.
  1268                              <1> ;
  1269                              <1> ;  Registers in the editor: EBX = the cursor, EDX = the end of the line
  1270                              <1> ;  (pointers into the line buffer); EDI is free (edit resets it).
  1271                              <1> ; =============================================================================
  1272                              <1> %if EDITOR
  1273                              <1> ; ^F, right arrow: one to the right, by printing the character there
  1274                              <1> right:  cmp     ebx,edx
  1275                              <1>         je      ed1                     ; at the end
  1276                              <1>         mov     al,[ebx]
  1277                              <1>         inc     ebx
  1278                              <1>         jmp     short lf1
  1279                              <1> 
  1280                              <1> ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
  1281                              <1> ; wait about 5 ms for a second key: after a '[' read on to the letter that
  1282                              <1> ; ends the sequence, and act on C (right) and D (left).
  1283                              <1> esc:    push    5
  1284                              <1>         pop     eax
  1285                              <1>         call    waitk
  1286                              <1>         jnz     .es2
  1287                              <1>         call    fin                     ; no second key: the line is dropped
  1288                              <1>         jmp     edit
  1289                              <1> .es2:   cmp     al,'['
  1290                              <1>         jne     ed1                     ; not a sequence known here
  1291                              <1> .es3:   call    ekey
  1292                              <1>         cmp     al,40h
  1293                              <1>         jb      .es3                    ; (its parameters)
  1294                              <1>         sub     al,'C'
  1295                              <1>         je      right
  1296                              <1>         dec     al                      ; 'D'?
  1297                              <1>         jne     ed1                     ; no: on into left
  1298                              <1> ; ^B, left arrow: the cursor goes one to the left
  1299                              <1> left:   cmp     bl,80h
  1300                              <1>         je      ed1                     ; at the start
  1301                              <1>         dec     ebx
  1302                              <1>         mov     al,8
  1303                              <1> lf1:    call    putc
  1304                              <1>         jmp     ed1
  1305                              <1> 
  1306                              <1> ; edit0: an error or a break: both stacks are cleared.
  1307                              <1> ; skend: a program that ended inside skip: its return address goes.
  1308                              <1> ; edend: a program that ended: TOS joins the rest of the data stack.
  1309                              <1> edit0:  mov     esp,[V(v_dstop)]
  1310                              <1>  %if CHECKED
  1311                              <1>         push    -11                     ; the report went to stderr: back to
  1312                              <1>         call    [V(iat_GetStdHandle)]   ;   stdout
  1313                              <1>         mov     [V(v_outh)],eax
  1314                              <1>  %endif
  1315                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1316                              <1> skend:  pop     eax
  1317                              <1> edend:  push    ebx
  1318                              <1> ; edit: start a new input line.
  1319                              <1> edit:   mov     edi,RSTOP               ; the return stack is empty
  1320                              <1>         xor     eax,eax
  1321                              <1>         mov     [ARENA+HELD],ax         ; no key is held, and the break key is on
  1322                              <1>         mov     [V(v_edln)],eax         ; no line is being edited
  1323                              <1>         mov     ebx,ARENA+LINEBUF       ; EBX = the cursor,
  1324                              <1>         mov     edx,ebx                 ;   EDX = the end of the line
  1325                              <1> ed1:    call    ekey
  1326                              <1>         cmp     al,7Fh
  1327                              <1>         je      bsp                     ; DEL
  1328                              <1>         cmp     al,' '
  1329                              <1>         jae     insc
  1330                              <1>         cmp     al,9
  1331                              <1>         je      insc                    ; Tab is text
  1332                              <1>         cmp     al,8
  1333                              <1>         je      bsp
  1334                              <1>         cmp     al,2
  1335                              <1>         je      left                    ; ^B
  1336                              <1>         cmp     al,6
  1337                              <1>         je      right                   ; ^F
  1338                              <1>         cmp     al,1Bh
  1339                              <1>         je      esc
  1340                              <1>         push    edi                     ; a command key? Look it up
  1341                              <1>         mov     edi,ckeys
  1342                              <1>         push    NCMD
  1343                              <1>         pop     ecx
  1344                              <1>         repne   scasb
  1345                              <1>         pop     edi
  1346                              <1>         jne     ed1                     ; no: the key is ignored
  1347                              <1>         movzx   eax,word [ctabr+ecx*2]  ; the command's address: fin returns
  1348                              <1>         add     eax,IB                  ;   to it
  1349                              <1>         push    eax
  1350                              <1> ; fin: end the input line: CR LF and a NUL after it, and a new line on the
  1351                              <1> ; terminal. Leaves ESI -> the line.
  1352                              <1> fin:    mov     word [edx],0A0Dh
  1353                              <1>         mov     esi,edx
  1354                              <1>         call    prl                     ; (prints the CR LF)
  1355                              <1>         mov     byte [esi],0
  1356                              <1>         mov     esi,ARENA+LINEBUF
  1357                              <1>         ret
  1358                              <1> 
  1359                              <1> ; Backspace, DEL: the character before the cursor goes. The cursor moves
  1360                              <1> ; left, the rest of the line moves down over it, and the last place (now a
  1361                              <1> ; space) is printed over along with the rest.
  1362                              <1> bsp:    cmp     bl,80h
  1363                              <1>         je      ed1                     ; at the start
  1364                              <1>         dec     ebx
  1365                              <1>         mov     al,8
  1366                              <1>         call    putc
  1367                              <1>         mov     ecx,ebx
  1368                              <1> .bs1:   mov     al,[ecx+1]
  1369                              <1>         mov     [ecx],al
  1370                              <1>         inc     ecx
  1371                              <1>         cmp     ecx,edx
  1372                              <1>         jne     .bs1
  1373                              <1>         mov     byte [ecx-1],' '
  1374                              <1>         dec     edx
  1375                              <1>         jmp     short ic2
  1376                              <1> ; A character goes in at the cursor: it ripples up through the rest of the
  1377                              <1> ; line, the cursor moves on, and the rest is printed again.
  1378                              <1> insc:   cmp     dl,0FDh
  1379                              <1>         je      ed1                     ; the line is full: 125 characters
  1380                              <1>         call    putc
  1381                              <1>         mov     ecx,ebx
  1382                              <1> .ic1:   xchg    al,[ecx]
  1383                              <1>         inc     ecx
  1384                              <1>         cmp     ecx,edx
  1385                              <1>         jbe     .ic1
  1386                              <1>         inc     ebx
  1387                              <1>         inc     edx
  1388                              <1>         mov     ecx,edx
  1389                              <1> ic2:    call    tail
  1390                              <1>         jmp     ed1
  1391                              <1> ; tail: print the line from the cursor to ECX, and bring the cursor back
  1392                              <1> ; with backspaces. Nothing at all if the cursor is at ECX.
  1393                              <1> tail:   mov     esi,ebx
  1394                              <1> .ta1:   cmp     esi,ecx
  1395                              <1>         je      .ta2
  1396                              <1>         lodsb
  1397                              <1>         call    putc
  1398                              <1>         jmp     .ta1
  1399                              <1> .ta2:   cmp     esi,ebx
  1400                              <1>         je      .ta3
  1401                              <1>         mov     al,8
  1402                              <1>         call    putc
  1403                              <1>         dec     esi
  1404                              <1>         jmp     .ta2
  1405                              <1> .ta3:   ret
  1406                              <1> 
  1407                              <1> ; ekey: wait for a key
  1408                              <1> ekey:   or      eax,-1
  1409                              <1>         jmp     waitk
  1410                              <1> 
  1411                              <1> ; The command keys, and where each goes (after fin). REPNE SCASB leaves ECX
  1412                              <1> ; = the number of keys after the one found, so the table is backwards. (The
  1413                              <1> ; addresses are kept as RVAs, which fit in a word.)
  1414                              <1> ckeys:  db      13, 7, 12, 5, 18, 23, 14, 22, 24
  1415                              <1> NCMD    equ     $-ckeys
  1416                              <1> ctabr:  dw      exit-IB                 ; ^X
  1417                              <1>         dw      cview-IB                   ; ^V
  1418                              <1>         dw      cnew-IB                 ; ^N
  1419                              <1>         dw      cwrite-IB                  ; ^W
  1420                              <1>         dw      cread-IB                   ; ^R
  1421                              <1>         dw      cedln-IB                   ; ^E
  1422                              <1>         dw      clist-IB                   ; ^L
  1423                              <1>         dw      crun-IB                 ; ^G
  1424                              <1>         dw      cret-IB                 ; Return
  1425                              <1> 
  1426                              <1> ; ^N ^N: no program, if the next key is ^N too
  1427                              <1> cnew:   call    ekey
  1428                              <1>         cmp     al,14
  1429                              <1>         jne     gedit
  1430                              <1>         mov     byte [ARENA+PROG],0
  1431                              <1> gedit:  jmp     edit
  1432                              <1> 
  1433                              <1> ; ^E: line n goes into the input line, to be changed. V_EDLN remembers
  1434                              <1> ; which line it was: Return puts the text back in its place.
  1435                              <1> cedln:  call    rdnum
  1436                              <1>         movzx   eax,dx
  1437                              <1>         push    eax
  1438                              <1>         call    find                    ; EDI -> the line, or the NUL
  1439                              <1>         pop     eax
  1440                              <1>         cmp     byte [edi],0
  1441                              <1>         je      gedit
  1442                              <1>         mov     [V(v_edln)],eax
  1443                              <1>         mov     ebx,ARENA+LINEBUF
  1444                              <1> .ce1:   mov     al,[edi]                ; copy it, and show it, up to its CR
  1445                              <1>         cmp     al,13                   ;   (or LF)
  1446                              <1>         je      .ce2
  1447                              <1>         cmp     al,10
  1448                              <1>         je      .ce2
  1449                              <1>         mov     [ebx],al
  1450                              <1>         call    putc
  1451                              <1>         inc     edi
  1452                              <1>         inc     ebx
  1453                              <1>         cmp     bl,0FDh                 ; (a longer line is cut at 125)
  1454                              <1>         jne     .ce1
  1455                              <1> .ce2:   mov     edx,ebx                 ; the cursor is at the line's end
  1456                              <1>         jmp     ed1
  1457                              <1> 
  1458                              <1> ; Return. If ^E put a line here, the text goes back in its place. If not:
  1459                              <1> ; a number and text is a line to put in, a number alone a line to take out,
  1460                              <1> ; and anything else is run where it is.
  1461                              <1> cret:   push    edx                     ; the end of what was typed
  1462                              <1>         mov     eax,[V(v_edln)]
  1463                              <1>         test    eax,eax
  1464                              <1>         jz      .cr1
  1465                              <1>         push    eax
  1466                              <1>         call    delln
  1467                              <1>         pop     eax
  1468                              <1>         jmp     short ins
  1469                              <1> .cr1:   call    rdnum                   ; DX = the number it starts with
  1470                              <1>         mov     eax,esi                 ; ESI's low byte is still 80h if there
  1471                              <1>         cmp     al,80h                  ;   was no number:
  1472                              <1>         je      runln                   ;   then run the line
  1473                              <1>         movzx   eax,dx
  1474                              <1>         cmp     byte [esi],13
  1475                              <1>         jne     .cr2
  1476                              <1>         pop     edx                     ; the number alone: take that line out
  1477                              <1>         call    delln
  1478                              <1>         jmp     gedit
  1479                              <1> .cr2:   inc     esi                     ; step over the one character after it
  1480                              <1> 
  1481                              <1> ; Put the text at ESI in as line EAX: open a gap of its length there, CR
  1482                              <1> ; and LF included, and copy it in.
  1483                              <1> ins:    call    find                    ; EDI -> where it goes
  1484                              <1>         pop     ecx                     ; the end of what was typed
  1485                              <1>         inc     ecx
  1486                              <1>         inc     ecx
  1487                              <1>         sub     ecx,esi                 ; the length, with its CR LF
  1488                              <1>         push    esi                     ; the text
  1489                              <1>         push    ecx                     ; its length
  1490                              <1>         push    edi                     ; where it goes
  1491                              <1>         mov     esi,edi
  1492                              <1> .in1:   lodsb                           ; find the program's NUL
  1493                              <1>         test    al,al
  1494                              <1>         jnz     .in1
  1495                              <1>         dec     esi
  1496                              <1>         mov     ecx,esi
  1497                              <1>         sub     ecx,edi
  1498                              <1>         inc     ecx                     ; the bytes to move up, NUL included
  1499                              <1>         mov     edi,esi
  1500                              <1>         add     edi,[esp+4]             ; the NUL's new place
  1501                              <1>         std
  1502                              <1>         rep     movsb                   ; move the rest of the program up
  1503                              <1>         cld
  1504                              <1>         pop     edi
  1505                              <1>         pop     ecx
  1506                              <1>         pop     esi
  1507                              <1>         rep     movsb
  1508                              <1>         jmp     gedit
  1509                              <1> 
  1510                              <1> ; ^G: run the program. runln: run the typed line (ESI -> it).
  1511                              <1> crun:   mov     esi,ARENA+PROG
  1512                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1513                              <1> runln:   pop     eax                     ; (the end of what was typed)
  1514                              <1> %endif
  1515                              <1> ; run0: start running at ESI. The heap starts after the stored program's
  1516                              <1> ; NUL. TOS is popped: the data stack is as the last line left it.
  1517 00000659 BA00024100          <1> run0:    mov     edx,ARENA+PROG
  1518 0000065E 42                  <1> .st1:   inc     edx
  1519 0000065F 807AFF00            <1>         cmp     byte [edx-1],0
  1520 00000663 75F9                <1>         jne     .st1
