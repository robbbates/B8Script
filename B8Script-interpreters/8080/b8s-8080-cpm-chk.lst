0550                             ; range, so the add is tested too: growing must not carry, and
0550                             ; releasing must.
0550   7A                     MOV   A,D   
0551   1F                     RAR      ; the carry comes in above the count's sign:
0552   C6 40                  ADI   40h   ;   bit 7 = carry XOR sign
0554   87                     ADD   A   
0555   DA 69 05               JC   e_heap   
0558   3A 07 00               LDA   0007h   
055B   3D                     DCR   A   
055C   BC                     CMP   H   
055D   DA 69 05               JC   e_heap   
0560                          ENDIF      
0560                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
