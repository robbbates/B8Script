0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        Dividing by zero is not checked. -n? does no more editing than
0000                             ;        Backspace.
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   1-EDGEN   
0000   31 FE 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003                          ENDIF      
0003                          IF   (1-CPM)*(1-EDITOR)   
0003   01 00 83               LD   BC,PROG   ; 03  the IP
0006   18 67                  JR   st0   ; 06  (the rest of the startup is close by)
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0008                          ENDIF      
0008                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0008                          ENDIF      
0008                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0008                          ENDIF      
0008                          IF   EDGEN   
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 C8 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD E4 02               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 6E                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 16                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 70                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0A                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 62                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058   30 D7                  JR   NC,next0   ; 7Fh-FFh: ignored
005A   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005C   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005E   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0060                .macro PTABLE,
0060                             ; 
0060                 DB      h_store & 0FFh  ; !
0060                 DB      h_str & 0FFh    ; "
0060                 DB      h_num & 0FFh    ; #
0060                 DB      h_print & 0FFh  ; $
0060                 DB      h_swap & 0FFh   ; %
0060                 DB      h_and & 0FFh    ; &
0060                 DB      h_emit & 0FFh   ; '
0060                 DB      h_open & 0FFh   ; (
0060                 DB      h_close & 0FFh  ; )
0060                 DB      h_mul & 0FFh    ; *
0060                 DB      h_add & 0FFh    ; +
0060                 DB      h_cfetch & 0FFh ; ,
0060                 DB      h_sub & 0FFh    ; -
0060                 DB      h_cstore & 0FFh ; .
0060                 DB      h_div & 0FFh    ; /
0060                 DB      h_dup & 0FFh    ; :
0060                 DB      h_drop & 0FFh   ; ;
0060                 DB      h_lt & 0FFh     ; <
0060                 DB      h_eq & 0FFh     ; =
0060                 DB      h_gt & 0FFh     ; >
0060                 DB      h_key & 0FFh    ; ?
0060                 DB      h_fetch & 0FFh  ; @
0060                 DB      h_def & 0FFh    ; [
0060                 DB      h_break & 0FFh  ; \
0060                 DB      h_ret & 0FFh    ; ]
0060                 DB      h_xor & 0FFh    ; ^
0060                 DB      h_alloc & 0FFh  ; _
0060                 DB      h_grave & 0FFh  ; `
0060                 DB      h_tor & 0FFh    ; {
0060                 DB      h_or & 0FFh     ; |
0060                 DB      h_fromr & 0FFh  ; }
0060                 DB      h_not & 0FFh    ; ~
0060                .endm
0060                 
0060                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0060                             ; untouched, and A, DE free.
0060   C6 B7        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0062   5F                     LD   E,A   
0063   16 02                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0065   FE CE                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0067   1A                     LD   A,(DE)   
0068   5F                     LD   E,A   ; the handler's low byte
0069                          IF   (1-CPM)*(1-TABP0)   
0069   16 00                  LD   D,0   
006B                          ENDIF      
006B                          IFN   CPM   
006B   CB 12                  RL   D   ; its page: 0 + carry
006D                          ENDIF      
006D                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
006D                          ENDIF      
006D   D5                     PUSH   DE   ; jump to it; the stack is balanced again
006E   C9                     RET      ;   when the handler starts
006F                             ; The rest of the startup: here so that the generic reset code can reach it
006F                             ; with JR. st0: find the program's NUL; the heap starts after it.
006F                             ; (The editor build has its own copy of this, next to the editor.)
006F                          IF   (1-CPM)*(1-EDITOR)   
006F   60           ST0:      LD   H,B   
0070   69                     LD   L,C   
0071   AF                     XOR   A   
0072   BE           ST1:      CP   (HL)   
0073   23                     INC   HL   
0074   20 FC                  JR   NZ,st1   
0076                          ENDIF      
0076                          IF   1-EDITOR   
0076   22 7C 82     ST2:      LD   (HEAP),HL   
0079   D9                     EXX      
007A   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
007D   D9                     EXX      
007E                          ENDIF      
007E                          IF   CHECKED*(1-EDITOR)   
007E   AF                     XOR   A   
007F   32 36 82               LD   (KEYBUF),A   ; no key held back
0082                          ENDIF      
0082                          IF   1-EDITOR   
0082   F7                     RST   30h   ; (its return address is thrown away)
0083                          ENDIF      
0083                             ; In the unchecked generic editor build the table is here, in the first
0083                             ; page, which saves loading D twice. (The other builds have no room for it
0083                             ; here: theirs is further down.)
0083                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0083                          ENDIF      
0083                             ; =============================================================================
0083                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0083                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0083                             ;  is here too: it belongs to "`" and makes the page come out right.
0083                             ; =============================================================================
0083   D1           H_XOR:    POP   DE   
0084   7C                     LD   A,H   
0085   AA                     XOR   D   
0086   67                     LD   H,A   
0087   7D                     LD   A,L   
0088   AB                     XOR   E   
0089   6F                     LD   L,A   
008A   F7                     RST   30h   
008B   D1           H_OR:     POP   DE   
008C   7C                     LD   A,H   
008D   B2                     OR   D   
008E   67                     LD   H,A   
008F   7D                     LD   A,L   
0090   B3                     OR   E   
0091   6F                     LD   L,A   
0092   F7                     RST   30h   
0093   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0094   2B                     DEC   HL   
0095   F7                     RST   30h   
0096                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
0096   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
009A   19                     ADD   HL,DE   ; the new top
009B                          IF   CHECKED   
009B   CD 14 03               CALL   chkhp   
009E                          ENDIF      
009E   22 7C 82               LD   (HEAP),HL   
00A1   EB                     EX   DE,HL   
00A2   F7                     RST   30h   
00A3   D9           EXEC:     EXX      
00A4   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00A7   D9                     EXX      
00A8   CD 2B 00               CALL   jphl   
00AB   D9                     EXX      
00AC   2A 34 82               LD   HL,(RSAVE)   
00AF   D9                     EXX      
00B0   E1                     POP   HL   
00B1   F7                     RST   30h   
00B2                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00B2                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00B2                             ; Digits: step back onto the first digit and read the whole number.
00B2   E5           DIGIT:    PUSH   HL   
00B3   0B                     DEC   BC   
00B4   CD 50 02               CALL   rdnum   
00B7   F7                     RST   30h   
00B8                             ; a-z: push the cell's address (the cell is the variable)
00B8   E5           LOWER:    PUSH   HL   
00B9   87                     ADD   A,A   
00BA   6F                     LD   L,A   
00BB   26 82                  LD   H,LETPAGE   
00BD   F7                     RST   30h   
00BE                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00BE                             ; the return stack, and the IP becomes the address in the letter's cell.
00BE   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00BF   EB                     EX   DE,HL   ; park TOS
00C0   87                     ADD   A,A   
00C1   6F                     LD   L,A   
00C2   26 82                  LD   H,LETPAGE   ; HL -> cell
00C4   4E                     LD   C,(HL)   
00C5   2C                     INC   L   
00C6   46                     LD   B,(HL)   ; IP = the word's body
00C7   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00C8                             ; rpushn: move the top cell of the data stack (in memory) to the return
00C8                             ; stack, then next. Everything that pushes the return stack ends here.
00C8                RPUSHN:      
00C8                          IF   CHECKED   
00C8   CD FC 02               CALL   chkbrk   ; Ctrl-C is checked at every word call, block
00CB                          ENDIF      ;   entry, loop-back and "{"
00CB   D9                     EXX      
00CC   D1                     POP   DE   
00CD   2B                     DEC   HL   
00CE   72                     LD   (HL),D   
00CF   2B                     DEC   HL   
00D0   73                     LD   (HL),E   
00D1   D9                     EXX      
00D2   F7                     RST   30h   
00D3                             ; ---- machine code: the grave -----------------------------------------------
00D3                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00D3                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00D3                             ; written and its address is left. An odd last digit is consumed and dropped.
00D3                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00D3                             ; code is entered by CALL with the data stack above the return address; it
00D3                             ; must keep BC, and on return the top cell becomes the new TOS.
00D3   CD A5 02     H_GRAVE:   CALL   hexc   
00D6   30 CB                  JR   NC,exec   
00D8                HX1:         
00D8                          IF   CHECKED   
00D8   CD 08 03               CALL   chkst   
00DB                          ENDIF      
00DB   77                     LD   (HL),A   ; the high digit goes in first ...
00DC   CD A5 02               CALL   hexc   
00DF   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00E1   ED 6F                  RLD      ;   overwrites it
00E3   23                     INC   HL   ; ... and RLD shifts it up under the low one
00E4   CD A5 02               CALL   hexc   
00E7   38 EF                  JR   C,hx1   
00E9                HX2:         
00E9                          IF   CHECKED   
00E9   CD 08 03               CALL   chkst   
00EC                          ENDIF      
00EC   36 C9                  LD   (HL),0C9h   
00EE   F7                     RST   30h   
00EF                             ; ---- where the two pages meet ----------------------------------------------
00EF                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00EF                             ; are in falling code order for this), and where exactly differs between the
00EF                             ; builds: NPG1 follows. Every handler below these four must start in the
00EF                             ; second page, and every one above in the first; chktab.py checks both.
00EF                             ; "]" returns: pop an address and jump to it.
00EF   CF           H_RET:    RST   08h   
00F0   42                     LD   B,D   
00F1   4B                     LD   C,E   
00F2   F7           BRK1:     RST   30h   
00F3                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00F3                             ; drops the block start, "]" returns. No closer at all ends the program.
00F3   7C           H_BREAK:   LD   A,H   
00F4   B5                     OR   L   
00F5   E1                     POP   HL   
00F6   28 FA                  JR   Z,brk1   
00F8   CD 72 02               CALL   skip   
00FB   B7                     OR   A   ; skip returns 0 for ")"
00FC   20 F1                  JR   NZ,h_ret   
00FE   CF           RDROP:    RST   08h   
00FF   F7                     RST   30h   
0100                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0100                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0100                             ; the body"s address instead. Either way it then skips to the matching "]'.
0100                             ; (The unchecked build takes anything that is not a letter as the space; the
0100                             ; checked build stops on it.)
0100   0A           H_DEF:    LD   A,(BC)   
0101   03                     INC   BC   
0102   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
0104   5F                     LD   E,A   ;   lands 64 bytes up
0105   E6 DF                  AND   0DFh   ; fold case
0107   FE 1A                  CP   26   
0109   30 0B                  JR   NC,def2   ; not a letter
010B   CB 23                  SLA   E   
010D   16 82                  LD   D,LETPAGE   ; DE -> cell
010F   79                     LD   A,C   
0110   12                     LD   (DE),A   
0111   1C                     INC   E   
0112   78                     LD   A,B   
0113   12                     LD   (DE),A   
0114   18 09                  JR   skipnx   
0116                DEF2:        
0116                          IF   CHECKED   
0116   7B                     LD   A,E   
0117   FE DF                  CP   " "-"A"+256   
0119   C2 29 03               JP   NZ,e_brack   ; anything but a letter or a space
011C                          ENDIF      
011C   E5                     PUSH   HL   ; an anonymous block: push its address
011D   60                     LD   H,B   
011E   69                     LD   L,C   
011F   CD 72 02     SKIPNX:   CALL   skip   
0122   F7                     RST   30h   
0123   5E           H_FETCH:   LD   E,(HL)   ; "@"
0124   23                     INC   HL   
0125   56                     LD   D,(HL)   
0126   EB                     EX   DE,HL   
0127   F7                     RST   30h   
0128                             ; =============================================================================
0128                             ;  Handlers that must start in the image's second page.
0128                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0128                             ;  page.
0128                             ; =============================================================================
0128                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0128                             ; the matching ")".
0128   7C           H_OPEN:   LD   A,H   
0129   B5                     OR   L   
012A   E1                     POP   HL   
012B   28 F2                  JR   Z,skipnx   
012D   C5                     PUSH   BC   ; the block starts at the IP
012E   18 98                  JR   rpushn   
0130                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0130                             ; drops it and carries on.
0130   7C           H_CLOSE:   LD   A,H   
0131   B5                     OR   L   
0132   E1                     POP   HL   
0133   28 C9                  JR   Z,rdrop   
0135   CF                     RST   08h   ; pop the block start ...
0136   42                     LD   B,D   
0137   4B                     LD   C,E   
0138   C5                     PUSH   BC   
0139   18 8D                  JR   rpushn   ; ... and push it back
013B                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
013B                             ; "-" has two jobs: directly before a digit it starts a negative number.
013B   0A           H_SUB:    LD   A,(BC)   
013C   D6 30                  SUB   "0"   
013E   FE 0A                  CP   10   
0140   38 04                  JR   C,negnum   
0142   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0143   D1           H_ADD:    POP   DE   
0144   19                     ADD   HL,DE   
0145   F7                     RST   30h   
0146   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0147   CD 50 02               CALL   rdnum   
014A   E7                     RST   20h   
014B   F7                     RST   30h   
014C   D1           H_AND:    POP   DE   
014D   7C                     LD   A,H   
014E   A2                     AND   D   
014F   67                     LD   H,A   
0150   7D                     LD   A,L   
0151   A3                     AND   E   
0152   6F                     LD   L,A   
0153   F7                     RST   30h   
0154                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0154                             ; cells first. Flipping both sign bits turns a signed compare into an
0154                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0154                             ; carry into -1 or 0 with no branch.
0154   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0155   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0156   7C                     LD   A,H   
0157   EE 80                  XOR   80h   
0159   67                     LD   H,A   
015A   7A                     LD   A,D   
015B   EE 80                  XOR   80h   
015D   57                     LD   D,A   
015E   ED 52                  SBC   HL,DE   ; carry if HL < DE
0160   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0162   F7                     RST   30h   
0163   D1           H_EQ:     POP   DE   
0164   B7                     OR   A   
0165   ED 52                  SBC   HL,DE   
0167   7C                     LD   A,H   
0168   B5                     OR   L   
0169   FE 01                  CP   1   ; carry only if a - b = 0
016B   18 F3                  JR   tf   
016D                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
016D                             ; multiplier shifts up through A:C.
016D   D1           H_MUL:    POP   DE   ; DE = multiplicand
016E   C5                     PUSH   BC   
016F   7C                     LD   A,H   
0170   4D                     LD   C,L   ; A:C = multiplier
0171   21 00 00               LD   HL,0   
0174   06 10                  LD   B,16   
0176   29           MUL1:     ADD   HL,HL   
0177   CB 21                  SLA   C   
0179   17                     RLA      
017A   30 01                  JR   NC,mul2   
017C   19                     ADD   HL,DE   
017D   10 F7        MUL2:     DJNZ   mul1   
017F   C1                     POP   BC   
0180   F7                     RST   30h   
0181                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0181                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0181                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0181   D1           H_DIV:    POP   DE   ; DE = a, HL = b
0182   C5                     PUSH   BC   ; free BC for udiv
0183   D5                     PUSH   DE   ; a, for r's sign
0184   7A                     LD   A,D   
0185   AC                     XOR   H   
0186   F5                     PUSH   AF   ; S flag = sign of q
0187   CB 7C                  BIT   7,H   
0189   C4 20 00               CALL   NZ,neg16   ; HL = |b|
018C   EB                     EX   DE,HL   
018D   CB 7C                  BIT   7,H   
018F   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0192   CD 2A 02               CALL   udiv   ; HL = q, DE = r
0195   F1                     POP   AF   
0196   FC 20 00               CALL   M,neg16   ; q's sign
0199   EB                     EX   DE,HL   ; HL = r, DE = q
019A   F1                     POP   AF   ; A = a's high byte
019B   B7                     OR   A   
019C   FC 20 00               CALL   M,neg16   ; r's sign
019F   C1                     POP   BC   
01A0   D5                     PUSH   DE   ; q under r
01A1   F7                     RST   30h   
01A2                             ; ---- stack and storage -----------------------------------------------------
01A2   E5           H_DUP:    PUSH   HL   ; ":"
01A3   F7                     RST   30h   
01A4   E3           H_SWAP:   EX   (SP),HL   ; "%"
01A5   F7                     RST   30h   
01A6   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
01A7                          IF   CHECKED   
01A7   CD 08 03               CALL   chkst   
01AA                          ENDIF      
01AA   73                     LD   (HL),E   
01AB   DF           H_DROP:   RST   18h   ; ";" is this one byte
01AC   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
01AD                          IF   CHECKED   
01AD   23                     INC   HL   ; both bytes must be in the program's space
01AE   CD 08 03               CALL   chkst   
01B1   2B                     DEC   HL   
01B2                          ENDIF      
01B2   73                     LD   (HL),E   
01B3   23                     INC   HL   
01B4   72                     LD   (HL),D   
01B5   DF                     RST   18h   
01B6                             ; ---- console ---------------------------------------------------------------
01B6                             ; 22h pushes the address of the text after it and skips the string.
01B6   E5           H_STR:    PUSH   HL   
01B7   60                     LD   H,B   
01B8   69                     LD   L,C   
01B9   CD 67 02               CALL   skipstr   
01BC   F7                     RST   30h   
01BD                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01BD                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01BD                             ; bit 6, so // and /" give themselves).
01BD   7E           H_PRINT:   LD   A,(HL)   
01BE   23                     INC   HL   
01BF   FE 22                  CP   22h   
01C1   28 0D                  JR   Z,pr9   
01C3   FE 2F                  CP   "/"   
01C5   20 04                  JR   NZ,pr1   
01C7   7E                     LD   A,(HL)   
01C8   23                     INC   HL   
01C9   E6 BF                  AND   0BFh   
01CB   EF           PR1:      RST   28h   
01CC   18 EF                  JR   h_print   
01CE   7D           H_EMIT:   LD   A,L   ; "'"
01CF   EF                     RST   28h   
01D0   DF           PR9:      RST   18h   
01D1                             ; "#" prints TOS as a signed decimal number, with no space after it.
01D1   CB 7C        H_NUM:    BIT   7,H   
01D3   28 04                  JR   Z,num1   
01D5   3E 2D                  LD   A,"-"   
01D7   EF                     RST   28h   
01D8   E7                     RST   20h   
01D9   C5           NUM1:     PUSH   BC   
01DA   CD 93 02               CALL   pdec   
01DD   C1                     POP   BC   
01DE   DF                     RST   18h   
01DF                             ; "?" ( n -- c ) or ( -n -- addr )
01DF                             ;   n > 0: wait about n ms for a key; 0 if none came
01DF                             ;   n = 0: wait for a key
01DF                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01DF                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01DF   CB 7C        H_KEY:    BIT   7,H   
01E1   20 19                  JR   NZ,line   
01E3   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01E5   CD D7 02     KT2:      CALL   getk   
01E8   20 0E                  JR   NZ,kt3   
01EA   1D                     DEC   E   
01EB   20 F8                  JR   NZ,kt2   
01ED   7C                     LD   A,H   ; 0? never counts down: it waits
01EE   B5                     OR   L   
01EF   28 F2                  JR   Z,kt1   
01F1   2B                     DEC   HL   
01F2   7C                     LD   A,H   
01F3   B5                     OR   L   
01F4   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01F6   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01F7   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01F8   6F           KT3:      LD   L,A   
01F9   26 00                  LD   H,0   
01FB   F7                     RST   30h   
01FC                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
01FC                          ENDIF      
01FC                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
01FC                          ENDIF      
01FC                          IF   CPM   
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01FC                          ENDIF      
01FC                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
01FC                          ENDIF      
01FC                          IF   CPM*EDITOR   
                              RET      
01FC                          ENDIF      
01FC                          IFN   CPM   
01FC                             ; Generic: Backspace takes the last character back (and is echoed as
01FC                             ; it is), CR ends (stored, not echoed), every other key is stored and
01FC                             ; echoed until the line is full. The line buffer starts at offset 80h
01FC                             ; of its page, so L alone is the place in the line: D holds the L of
01FC                             ; a full line.
01FC                          ENDIF      
01FC                          IFN   CPM   
01FC   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01FF   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
0200   9F                     SBC   A,A   
0201   A5                     AND   L   ; (0 for a count that is too big)
0202   2F                     CPL      
0203   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
0204                          ENDIF      ;   at most
0204                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
0204                          ENDIF      
0204                          IFN   CPM   
0204   21 80 82               LD   HL,LINEBUF   
0207   CD D7 02     LN2:      CALL   getk   
020A   28 FB                  JR   Z,ln2   
020C   FE 0D                  CP   13   
020E   28 16                  JR   Z,ln5   
0210   FE 08                  CP   8   
0212   28 0B                  JR   Z,ln4   
0214   5F                     LD   E,A   
0215   7D                     LD   A,L   
0216   BA                     CP   D   
0217   28 EE                  JR   Z,ln2   ; full
0219   73                     LD   (HL),E   
021A   2C                     INC   L   
021B   7B                     LD   A,E   
021C   EF           LN3:      RST   28h   
021D   18 E8                  JR   ln2   
021F   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0220   FA 1C 02               JP   M,ln3   ;   unless the line was empty (L left the
0223   2C                     INC   L   ;   upper half of the page)
0224   18 E1                  JR   ln2   
0226   77           LN5:      LD   (HL),A   ; the CR
0227                          ENDIF      
0227                          IF   (1-CPM)*(1-EDITOR)   
0227   2E 80                  LD   L,LINEBUF & 0FFh   
0229   F7                     RST   30h   
022A                          ENDIF      
022A                          IF   EDGEN   
                              RET      
022A                          ENDIF      
022A                             ; =============================================================================
022A                             ;  More routines (no handler starts past this point)
022A                             ; =============================================================================
022A                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
022A                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
022A                             ; while the quotient bits arrive at the bottom of C.
022A                             ; Dividing by 2 is one shift (the spec wants that fast).
022A   7B           UDIV:     LD   A,E   
022B   EE 02                  XOR   2   
022D   B2                     OR   D   
022E   20 07                  JR   NZ,udv0   
0230   CB 3C                  SRL   H   
0232   CB 1D                  RR   L   ; the quotient
0234   8F                     ADC   A,A   
0235   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0236   C9                     RET      
0237   7C           UDV0:     LD   A,H   
0238   4D                     LD   C,L   
0239   21 00 00               LD   HL,0   
023C   06 10                  LD   B,16   
023E   CB 21        UDV1:     SLA   C   
0240   17                     RLA      
0241   ED 6A                  ADC   HL,HL   
0243   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0245   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0247   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0248   0D                     DEC   C   ;   INC below
0249   0C           UDV2:     INC   C   ; a quotient bit
024A   10 F2                  DJNZ   udv1   
024C   EB                     EX   DE,HL   ; DE = remainder
024D   67                     LD   H,A   
024E   69                     LD   L,C   ; HL = quotient
024F   C9                     RET      
0250                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0250                             ; non-digit. Values wrap at 16 bits, as the spec says.
0250   21 00 00     RDNUM:    LD   HL,0   
0253   0A           RDN1:     LD   A,(BC)   
0254   D6 30                  SUB   "0"   
0256   FE 0A                  CP   10   
0258   D0                     RET   NC   
0259   03                     INC   BC   
025A   54                     LD   D,H   
025B   5D                     LD   E,L   
025C   29                     ADD   HL,HL   
025D   29                     ADD   HL,HL   
025E   19                     ADD   HL,DE   
025F   29                     ADD   HL,HL   ; HL * 10
0260   5F                     LD   E,A   
0261   16 00                  LD   D,0   
0263   19                     ADD   HL,DE   
0264   18 ED                  JR   rdn1   
0266                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0266                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0266   03           SS0:      INC   BC   
0267   0A           SKIPSTR:   LD   A,(BC)   
0268   03                     INC   BC   
0269   FE 2F                  CP   "/"   
026B   28 F9                  JR   Z,ss0   
026D   FE 22                  CP   22h   
026F   20 F6                  JR   NZ,skipstr   
0271   C9                     RET      
0272                             ; skip: read past text to the closer at this level, and return A = 0 if it
0272                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0272                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0272                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0272                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0272                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0272   16 00        SKIP:     LD   D,0   
0274   14           SK3:      INC   D   ; an opener: one deeper
0275   0A           SK1:      LD   A,(BC)   
0276   03                     INC   BC   
0277   B7                     OR   A   
0278   CA 15 00               JP   Z,endprog   
027B   FE 22                  CP   22h   
027D   CC 67 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0280   D6 28                  SUB   "("   
0282   28 F0                  JR   Z,sk3   
0284   3D                     DEC   A   ; ")"
0285   28 08                  JR   Z,sk4   
0287   D6 32                  SUB   "["-")"   
0289   28 E9                  JR   Z,sk3   
028B   FE 02                  CP   "]"-"["   
028D   20 E6                  JR   NZ,sk1   
028F   15           SK4:      DEC   D   
0290   C8                     RET   Z   ; the closer at this level
0291   18 E2                  JR   sk1   
0293                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0293                             ; Uses BC.
0293   11 0A 00     PDEC:     LD   DE,10   
0296   CD 2A 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0299   7B                     LD   A,E   
029A   F5                     PUSH   AF   
029B   7C                     LD   A,H   
029C   B5                     OR   L   
029D   C4 93 02               CALL   NZ,pdec   
02A0   F1                     POP   AF   
02A1   C6 30                  ADD   A,"0"   
02A3   EF                     RST   28h   
02A4   C9                     RET      
02A5                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02A5                             ; and return its value in A with the carry set; otherwise leave the IP and
02A5                             ; return with the carry clear.
02A5   0A           HEXC:     LD   A,(BC)   
02A6   D6 30                  SUB   "0"   
02A8   FE 0A                  CP   10   
02AA   38 09                  JR   C,hc1   
02AC   E6 DF                  AND   0DFh   
02AE   D6 11                  SUB   11h   
02B0   FE 06                  CP   6   
02B2   D0                     RET   NC   
02B3   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02B5   03           HC1:      INC   BC   
02B6   C9                     RET      
02B7                             ; =============================================================================
02B7                             ;  Dispatch table: the low byte of each handler's address, in code order
02B7                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02B7                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02B7                             ; =============================================================================
02B7                             ; The handlers of the first NPG1 characters start in the image's second page.
02B7                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02B7                             ; differs between the builds, so the count is worked out here.
02B7                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02B7                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02B7                PGBRK:    EQU   (h_break-BASE)/256   
02B7                PGDEF:    EQU   (h_def-BASE)/256   
02B7                PGFET:    EQU   (h_fetch-BASE)/256   
02B7                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02B7                          IF   1-TABP0   
02B7                PTAB:        
02B7                          ;*Macro unroll:  PTABLE
02B7   AC                     DB   h_store & 0FFh   
02B8   B6                     DB   h_str & 0FFh   
02B9   D1                     DB   h_num & 0FFh   
02BA   BD                     DB   h_print & 0FFh   
02BB   A4                     DB   h_swap & 0FFh   
02BC   4C                     DB   h_and & 0FFh   
02BD   CE                     DB   h_emit & 0FFh   
02BE   28                     DB   h_open & 0FFh   
02BF   30                     DB   h_close & 0FFh   
02C0   6D                     DB   h_mul & 0FFh   
02C1   43                     DB   h_add & 0FFh   
02C2   F7                     DB   h_cfetch & 0FFh   
02C3   3B                     DB   h_sub & 0FFh   
02C4   A6                     DB   h_cstore & 0FFh   
02C5   81                     DB   h_div & 0FFh   
02C6   A2                     DB   h_dup & 0FFh   
02C7   AB                     DB   h_drop & 0FFh   
02C8   54                     DB   h_lt & 0FFh   
02C9   63                     DB   h_eq & 0FFh   
02CA   55                     DB   h_gt & 0FFh   
02CB   DF                     DB   h_key & 0FFh   
02CC   23                     DB   h_fetch & 0FFh   
02CD   00                     DB   h_def & 0FFh   
02CE   F3                     DB   h_break & 0FFh   
02CF   EF                     DB   h_ret & 0FFh   
02D0   83                     DB   h_xor & 0FFh   
02D1   96                     DB   h_alloc & 0FFh   
02D2   D3                     DB   h_grave & 0FFh   
02D3   2C                     DB   h_tor & 0FFh   
02D4   8B                     DB   h_or & 0FFh   
02D5   1C                     DB   h_fromr & 0FFh   
02D6   93                     DB   h_not & 0FFh   
02D7                PTABEND:      
02D7                          ENDIF      
02D7                             ; =============================================================================
02D7                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02D7                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
02D7                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
02D7                             ;  KEY and CONOUT routines themselves.
02D7                             ; =============================================================================
02D7                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
02D7                          ENDIF      
02D7                          IF   CHECKED   
02D7   E5           GETK:     PUSH   HL   ; a key held back by the break check goes
02D8   21 36 82               LD   HL,KEYBUF   ;   first, and is taken out of the buffer
02DB   7E                     LD   A,(HL)   
02DC   36 00                  LD   (HL),0   
02DE   E1                     POP   HL   
02DF   B7                     OR   A   
02E0   C0                     RET   NZ   
02E1                          ENDIF      
02E1                          IF   (1-CPM)*CHECKED   
02E1   C3 06 FF               JP   KEY   
02E4                          ENDIF      
02E4                          IF   CPM*(1-CHECKED)   
                    GETK:        
02E4                          ENDIF      
02E4                          IF   CPM   
                              LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
02E4                          ENDIF      
02E4                             ; =============================================================================
02E4                             ;  Checked build: the checks and the error report
02E4                             ; =============================================================================
02E4                          IF   CHECKED   
02E4                             ; chkstk: both stacks are checked once per character, not in every handler.
02E4                             ; Each stack lives in one page, so it has overrun exactly when the pointer's
02E4                             ; high byte has left that page. Errors are caught one cell late at most; the
02E4                             ; page below each stack is a guard band. (The call itself is on the data
02E4                             ; stack, but in the same page whenever the stack is in range.)
02E4   ED 73 38 82  CHKSTK:   LD   (SPTMP),SP   
02E8   3A 39 82               LD   A,(SPTMP+1)   
02EB   FE 81                  CP   DSPAGE   
02ED   20 31                  JR   NZ,e_stack   
02EF   D9                     EXX      ; the return stack: in its page, and not
02F0   7D                     LD   A,L   ;   above its empty position (an underflow
02F1   FE E1                  CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
02F3   7C                     LD   A,H   ;   guard band)
02F4   D9                     EXX      
02F5   30 2C                  JR   NC,e_rstack   
02F7   FE 80                  CP   RSPAGE   
02F9   C8                     RET   Z   
02FA   18 27                  JR   e_rstack   
02FC                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
02FC                             ; else is held for the next "?".
02FC   CD D7 02     CHKBRK:   CALL   getk   
02FF   C8                     RET   Z   
0300   FE 03                  CP   3   
0302   28 22                  JR   Z,e_break   
0304   32 36 82               LD   (KEYBUF),A   
0307   C9                     RET      
0308                             ; chkst: stop unless HL is in the program's own space: from the letter page
0308                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0308                             ; whatever lies above the limit are safe. Memory above the heap top but
0308                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0308                             ; Keeps every register.
0308   F5           CHKST:    PUSH   AF   
0309   7C                     LD   A,H   
030A   FE 82                  CP   LETPAGE   
030C   38 0F                  JR   C,e_store   
030E                          ENDIF      
030E                          IF   CHECKED*(1-CPM)   
030E   FE F0                  CP   HEAPLIM   
0310   30 0B                  JR   NC,e_store   
0312                          ENDIF      
0312                          IF   CHECKED*CPM   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   H   
                              JR   C,e_store   
0312                          ENDIF      
0312                          IF   CHECKED   
0312   F1                     POP   AF   
0313   C9                     RET      
0314                             ; chkhp: stop if working out the new heap top carried (a negative count
0314                             ; wraps: too big), or if the new top in HL is not below the limit page.
0314   38 04        CHKHP:    JR   C,e_heap   
0316                          ENDIF      
0316                          IF   CHECKED*(1-CPM)   
0316   7C                     LD   A,H   
0317   FE F0                  CP   HEAPLIM   
0319   D8                     RET   C   
031A                          ENDIF      
031A                          IF   CHECKED*CPM   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              RET   NC   
031A                          ENDIF      
031A                          IF   CHECKED   
031A                             ; Error entries. Each loads its letter and then hides the next entry inside
031A                             ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
031A   3E 48        E_HEAP:   LD   A,"H"   ; heap past the limit
031C   21                     DB   21h   
031D   3E 57        E_STORE:   LD   A,"W"   ; write outside the program's space
031F   21                     DB   21h   
0320   3E 53        E_STACK:   LD   A,"S"   ; data stack over or under
0322   21                     DB   21h   
0323   3E 52        E_RSTACK:   LD   A,"R"   ; return stack over or under
0325   21                     DB   21h   
0326   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C
0328   21                     DB   21h   
0329   3E 44        E_BRACK:   LD   A,"D"   ; bad character after [
032B                             ; error: print the letter in A, " @ " and the offset in the program of the
032B                             ; character just read, then end. For example: S @ 245
032B   31 FE 81     ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
032E   EF                     RST   28h   
032F   3E 20                  LD   A," "   
0331   EF                     RST   28h   
0332   3E 40                  LD   A,"@"   
0334   EF                     RST   28h   
0335   3E 20                  LD   A," "   
0337   EF                     RST   28h   
0338   21 FF 7C               LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
033B   09                     ADD   HL,BC   ;   just read: HL = its offset
033C   CD 93 02               CALL   pdec   
033F   C3 15 00               JP   endprog   
0342                          ENDIF      
0342                             ; =============================================================================
0342                             ;  The line editor (EDITOR = 1)
0342                             ; 
0342                             ;  The interpreter starts here, and a program that ends comes back here. Type
0342                             ;  a line and press Return:
0342                             ; 
0342                             ;    n text    put the text in as line n; the lines from n on move down.
0342                             ;              A number past the end, or 0, adds the line at the end.
0342                             ;    n         take line n out
0342                             ;    0         run the program
0342                             ;    -n        list the program from line n on (-1 lists all of it). Any key
0342                             ;              stops the list until another key is pressed; Ctrl-C ends it.
0342                             ;    anything else is run at once, as B8Script. (Start such a line with a
0342                             ;    space if it would begin with a digit or a minus sign.)
0342                             ; 
0342                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0342                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0342                             ;  125 characters, the line number and the one character after it included;
0342                             ;  that character is not stored. The text is kept as it is typed, each line
0342                             ;  ending in CR LF, at PROG. Nothing is checked.
0342                             ; 
0342                             ;  With CPM = 1 the file named on the command line is the program to start
0342                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
0342                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
0342                             ;  CP/M. Nothing is written back: there is no command to save.
0342                             ; 
0342                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
0342                             ;  its letter and place and comes back here. The place is counted from the
0342                             ;  start of the program, so in a line typed here it is 65408 plus the
0342                             ;  character's place in the line (the line buffer is 128 bytes below the
0342                             ;  program).
0342                             ; 
0342                             ;  Things to know:
0342                             ;    - Reset empties the program (generic builds).
0342                             ;    - Words and variables last from one line to the next. A word's address
0342                             ;      points into the program, so run the program again after editing it.
0342                             ;    - Nothing is printed between a program's output and what is typed next.
0342                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0342                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0342                             ;      (The stored program never comes back to the line, so it may.)
0342                             ; =============================================================================
0342                          IF   EDGEN*CHECKED   
                    INIT:     LD   (KEYBUF),A   ; (A = 0) reset: no key held back
                              JR   edit   
0342                          ENDIF      
0342                          IF   EDITOR   
                                 ; -n: list from line n. DE = the number of the line at HL.
                    LIST:     INC   BC   
                              CALL   rdnum   ; HL = n
                              PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,edit   ; the end of the text
                              CALL   getk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,edit   ; Ctrl-C
                    LI2:      CALL   getk   ; any other key: wait for one more
                              JR   Z,li2   
                              CP   3   
                              JR   Z,edit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; Take line n (in HL) out: copy everything after it down over it.
                    DEL:      CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
0342                          ENDIF      
0342                          IF   EDITOR*CPM*CHECKED   
                                 ; A key that the break check held back while a program ran is let
                                 ; go: BDOS 10 would not see it, and it would turn up in the next
                                 ; program that asked for a key. (This also serves at the start.)
                              XOR   A   
                              LD   (KEYBUF),A   
0342                          ENDIF      
0342                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
0342                          ENDIF      
0342                          IF   EDITOR*CPM   
                              LD   A,125   
0342                          ENDIF      
0342                          IF   EDITOR   
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   
                              CALL   prl   ; (print the CR LF: a new line)
                              LD   (HL),0   ;   and a NUL after that
                              PUSH   HL   ; the end of what was typed
                              LD   BC,LINEBUF   
                              LD   A,(BC)   
                              CP   "-"   
                              JR   Z,list   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0   ; no number: run the line where it is
                              LD   A,(BC)   
                              SUB   13   
                              JR   NZ,ins   ; text follows the number
                              OR   H   ; the number alone:
                              OR   L   
                              JR   NZ,del   ;   not 0: take that line out
                              LD   BC,PROG   ;   0: run the program
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
                              LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; Put the typed text in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              INC   BC   ; step over the one character after the number
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                              JR   edit   
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
0342                          ENDIF      
0342                             ; =============================================================================
0342                             ;  CP/M startup (the generic build starts at address 0: see st0)
0342                             ; =============================================================================
0342                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:    LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:         
0342                          ENDIF      
0342                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0342                          ENDIF      
0342                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
0342                          ENDIF      
0342                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0342                          ENDIF      
0342                IMGEND:      


