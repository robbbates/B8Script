  1493                              <1>         xor     eax,eax
  1494                              <1>         call    waitk
  1495                              <1>         jz      .li3                    ; no key: carry on
  1496                              <1>         cmp     al,3
  1497                              <1>         je      gedit                   ; Ctrl-C ends the list,
  1498                              <1>         call    ekey                    ;   any other key holds it until the
  1499                              <1>         cmp     al,3                    ;   next (and a Ctrl-C then ends it)
  1500                              <1>         je      gedit
  1501                              <1> .li3:   push    edx
  1502                              <1>         xchg    eax,edx
  1503                              <1>         call    pdec                    ; the line's number,
  1504                              <1>         mov     al,' '
  1505                              <1>         call    putc                    ;   a space,
  1506                              <1>         pop     edx
  1507                              <1>         inc     edx
  1508                              <1>         call    prl                     ;   and the line
  1509                              <1>         jmp     .li1
  1510                              <1> 
