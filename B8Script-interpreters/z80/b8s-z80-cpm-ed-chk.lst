0332   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
0333   2A 34 0B               LD   HL,(RSAVE)   ;   and put the string's address back in TOS
0336   3E 51                  LD   A,"Q"   
0338   C3 51 05               JP   error   
033B                          ENDIF      
033B                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
033B                             ; HL points past it. Each goes back into the loop that prints the string
033B                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
033B                             ;    /a-/z   print the variable, as "#" does
033B                             ;    /{      clear the screen, the cursor to the top left
033B                             ;    /}      clear from the cursor to the end of the line
033B                             ;    /|  /`  show the cursor, hide it
033B                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
033B   FE 7E        PESC:     CP   7Eh   
033D   28 1C                  JR   Z,pat   
033F   11 0B 03               LD   DE,PRLOOP   ; the others return into the loop
0342   D5                     PUSH   DE   
0343   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0345   30 31                  JR   NC,pcon   
0347   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0349   30 41                  JR   NC,phide   
034B   87                     ADD   A,A   ; the variable's cell
034C   C6 40                  ADD   A,40h   
034E   E5                     PUSH   HL   
034F   6F                     LD   L,A   
0350   26 0B                  LD   H,LETPAGE   
0352   7E                     LD   A,(HL)   
0353   2C                     INC   L   
0354   66                     LD   H,(HL)   
0355   6F                     LD   L,A   
0356   CD 48 04               CALL   psgn   
0359   E1                     POP   HL   
035A   C9                     RET      
035B                             ; /~ ( row col addr -- ): the two cells under the string's address go. Where
035B                             ; "$" is the routine prstr, its own return address goes first, and hp1
035B                             ; calls it again afterwards. (The checked build looks first, through
035B                             ; chkstk, that there is a column at least: with less, it is s. With a
035B                             ; column but no row it is s after the "$", as for any other character; the
035B                             ; spare bytes above the stack take what is written meanwhile.)
