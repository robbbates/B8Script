0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-CPM*EDITOR*(1-CHECKED)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; HL', and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
0000   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003                          ENDIF      
0003                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
0003   01 00 83               LD   BC,PROG   ; 03  the IP
0006   18 64                  JR   st0   ; 06  (the rest of the startup is close by)
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 C3 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 DA                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 6C                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 6E                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 60                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          IF   1-CHECKED   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D   C6 DB        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 02                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE F1                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          IF   (1-CPM)*(1-TABP0)   
0066   16 00                  LD   D,0   
0068                          ENDIF      
0068                          IFN   CPM   
0068   CB 12                  RL   D   ; its page: 0 + carry
006A                          ENDIF      
006A                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
006A                          ENDIF      
006A   D5                     PUSH   DE   ; jump to it; the stack is balanced again
006B   C9                     RET      ;   when the handler starts
006C                             ; The rest of the startup: here so that the generic reset code can reach it
006C                             ; with JR. st0: find the program's NUL; the heap starts after it.
006C                             ; (The editor build has its own copy of this, next to the editor.)
006C                             ; A checked build first clears the lower half of the letter page (A = 0):
006C                             ; every variable starts at 0, every word cell holds 0000h, the address an
006C                             ; undefined word is caught at (see e_hi), and no key is held back.
006C                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006C                          ENDIF      
006C                          IF   (1-CPM)*(1-EDITOR)   
006C   60           ST0:      LD   H,B   
006D   69                     LD   L,C   
006E   AF                     XOR   A   
006F   BE           ST1:      CP   (HL)   
0070   23                     INC   HL   
0071   20 FC                  JR   NZ,st1   
0073                          ENDIF      
0073                          IF   1-EDITOR   
0073   22 7C 82     ST2:      LD   (HEAP),HL   
0076                          ENDIF      
0076                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0076                          ENDIF      
0076                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
0076   67                     LD   H,A   ; (A = 0) no key is held, and the break key
0077   6F                     LD   L,A   ;   is on (the checked build has cleared
0078                          ENDIF      ;   these)
0078                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0078                          ENDIF      
0078                          IF   (1-CHECKED)*(1-EDITOR)   
0078   22 7A 82               LD   (KEYBUF),HL   
007B                          ENDIF      
007B                          IF   1-EDITOR   
007B   D9                     EXX      
007C   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
007F   D9                     EXX      
0080   F7                     RST   30h   ; (its return address is thrown away)
0081                          ENDIF      
0081                             ; In the unchecked generic editor build the table is here, in the first
0081                             ; page, which saves loading D twice. (The other builds have no room for it
0081                             ; here: theirs is further down.)
0081                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0081                          ENDIF      
0081                             ; =============================================================================
0081                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0081                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0081                             ;  is here too: it belongs to "`" and makes the page come out right.
0081                             ; =============================================================================
0081   D1           H_XOR:    POP   DE   
0082   7C                     LD   A,H   
0083   AA                     XOR   D   
0084   67                     LD   H,A   
0085   7D                     LD   A,L   
0086   AB                     XOR   E   
0087   6F                     LD   L,A   
0088   F7                     RST   30h   
0089   D1           H_OR:     POP   DE   
008A   7C                     LD   A,H   
008B   B2                     OR   D   
008C   67                     LD   H,A   
008D   7D                     LD   A,L   
008E   B3                     OR   E   
008F   6F                     LD   L,A   
0090   F7                     RST   30h   
0091   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0092   2B                     DEC   HL   
0093   F7                     RST   30h   
0094                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0094                             ; the same either way); TOS is the old pointer.
0094   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0098                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0098                          ENDIF      
0098   19                     ADD   HL,DE   ; the new top
0099                          IF   CHECKED   
                              CALL   chkhp   
0099                          ENDIF      
0099   22 7C 82               LD   (HEAP),HL   
009C   EB                     EX   DE,HL   
009D   F7                     RST   30h   
009E   D9           EXEC:     EXX      
009F   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00A2   D9                     EXX      
00A3   CD 2B 00               CALL   jphl   
00A6   D9                     EXX      
00A7   2A 34 82               LD   HL,(RSAVE)   
00AA   D9                     EXX      
00AB   E1                     POP   HL   
00AC   F7                     RST   30h   
00AD                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00AD                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00AD                             ; Digits: step back onto the first digit and read the whole number.
00AD   E5           DIGIT:    PUSH   HL   
00AE   0B                     DEC   BC   
00AF   CD 6C 02               CALL   rdnum   
00B2   F7                     RST   30h   
00B3                             ; a-z: push the cell's address (the cell is the variable)
00B3   E5           LOWER:    PUSH   HL   
00B4   87                     ADD   A,A   
00B5   6F                     LD   L,A   
00B6   26 82                  LD   H,LETPAGE   
00B8   F7                     RST   30h   
00B9                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00B9                             ; the return stack, and the IP becomes the address in the letter's cell.
00B9   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00BA   EB                     EX   DE,HL   ; park TOS
00BB   87                     ADD   A,A   
00BC   6F                     LD   L,A   
00BD   26 82                  LD   H,LETPAGE   ; HL -> cell
00BF   4E                     LD   C,(HL)   
00C0   2C                     INC   L   
00C1   46                     LD   B,(HL)   ; IP = the word's body
00C2   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00C3                             ; rpushn: move the top cell of the data stack (in memory) to the return
00C3                             ; stack, then next. Everything that pushes the return stack ends here.
00C3                             ; 
00C3                             ; The break key is looked at here, so at every word call and loop-back (and
00C3                             ; block entry and "{"), but only one time in 256: B', which nothing else
00C3                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00C3                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00C3                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00C3                             ; both ways out.)
00C3   D9           RPUSHN:   EXX      
00C4   D1                     POP   DE   
00C5   2B                     DEC   HL   
00C6   72                     LD   (HL),D   
00C7   2B                     DEC   HL   
00C8   73                     LD   (HL),E   
00C9   05                     DEC   B   
00CA   D9                     EXX      
00CB   CC FB 02               CALL   Z,pollk   
00CE   F7                     RST   30h   
00CF                             ; ---- machine code: the grave -----------------------------------------------
00CF                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00CF                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00CF                             ; written and its address is left. An odd last digit is consumed and dropped.
00CF                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00CF                             ; code is entered by CALL with the data stack above the return address; it
00CF                             ; must keep BC, and on return the top cell becomes the new TOS.
00CF   CD AF 02     H_GRAVE:   CALL   hexc   
00D2   30 CA                  JR   NC,exec   
00D4   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00D5   CD AF 02               CALL   hexc   
00D8   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00DA   ED 6F                  RLD      ;   overwrites it
00DC   23                     INC   HL   ; ... and RLD shifts it up under the low one
00DD   CD AF 02               CALL   hexc   
00E0   38 F2                  JR   C,hx1   
00E2   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00E4   F7                     RST   30h   
00E5                             ; ---- where the two pages meet ----------------------------------------------
00E5                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00E5                             ; are in falling code order for this), and where exactly differs between the
00E5                             ; builds: NPG1 follows. Every handler below these four must start in the
00E5                             ; second page, and every one above in the first; chktab.py checks both.
00E5                             ; "]" returns: pop an address and jump to it.
00E5   CF           H_RET:    RST   08h   
00E6   42                     LD   B,D   
00E7   4B                     LD   C,E   
00E8   F7           BRK1:     RST   30h   
00E9                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00E9                             ; drops the block start, "]" returns. No closer at all ends the program.
00E9   7C           H_BREAK:   LD   A,H   
00EA   B5                     OR   L   
00EB   E1                     POP   HL   
00EC   28 FA                  JR   Z,brk1   
00EE   CD 8E 02               CALL   skip   
00F1   B7                     OR   A   ; skip returns 0 for ")"
00F2   20 F1                  JR   NZ,h_ret   
00F4   CF           RDROP:    RST   08h   
00F5   F7                     RST   30h   
00F6                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00F6                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00F6                             ; the body"s address instead. Either way it then skips to the matching "]'.
00F6                             ; (The unchecked build takes anything that is not a letter as the space; the
00F6                             ; checked build stops on it.)
00F6   0A           H_DEF:    LD   A,(BC)   
00F7   03                     INC   BC   
00F8   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00FA   5F                     LD   E,A   ;   lands 64 bytes up
00FB   E6 DF                  AND   0DFh   ; fold case
00FD   FE 1A                  CP   26   
00FF   30 0B                  JR   NC,def2   ; not a letter
0101   CB 23                  SLA   E   
0103   16 82                  LD   D,LETPAGE   ; DE -> cell
0105   79                     LD   A,C   
0106   12                     LD   (DE),A   
0107   1C                     INC   E   
0108   78                     LD   A,B   
0109   12                     LD   (DE),A   
010A   18 03                  JR   skipnx   
010C                DEF2:        
010C                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
010C                          ENDIF      
010C   E5                     PUSH   HL   ; an anonymous block: push its address
010D   60                     LD   H,B   
010E   69                     LD   L,C   
010F                SKIPNX:      
010F                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
010F                          ENDIF      ;   opener, the "[", just before where it starts
010F   CD 8E 02     SKIPO:    CALL   skip   
0112   F7                     RST   30h   
0113   5E           H_FETCH:   LD   E,(HL)   ; "@"
0114   23                     INC   HL   
0115   56                     LD   D,(HL)   
0116   EB                     EX   DE,HL   
0117   F7                     RST   30h   
0118                             ; =============================================================================
0118                             ;  Handlers that must start in the image's second page.
0118                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0118                             ;  page.
0118                             ; =============================================================================
0118                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0118                             ; the matching ")".
0118   7C           H_OPEN:   LD   A,H   
0119   B5                     OR   L   
011A   E1                     POP   HL   
011B   28 F2                  JR   Z,skipo   
011D   C5                     PUSH   BC   ; the block starts at the IP
011E   18 A3                  JR   rpushn   
0120                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0120                             ; drops it and carries on.
0120   7C           H_CLOSE:   LD   A,H   
0121   B5                     OR   L   
0122   E1                     POP   HL   
0123   28 CF                  JR   Z,rdrop   
0125   CF                     RST   08h   ; pop the block start ...
0126   42                     LD   B,D   
0127   4B                     LD   C,E   
0128   C5                     PUSH   BC   
0129   18 98                  JR   rpushn   ; ... and push it back
012B                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
012B                             ; "-" has two jobs: directly before a digit it starts a negative number.
012B   0A           H_SUB:    LD   A,(BC)   
012C   D6 30                  SUB   "0"   
012E   FE 0A                  CP   10   
0130   38 04                  JR   C,negnum   
0132   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0133   D1           H_ADD:    POP   DE   
0134   19                     ADD   HL,DE   
0135   F7                     RST   30h   
0136   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0137   CD 6C 02               CALL   rdnum   
013A   E7                     RST   20h   
013B   F7                     RST   30h   
013C   D1           H_AND:    POP   DE   
013D   7C                     LD   A,H   
013E   A2                     AND   D   
013F   67                     LD   H,A   
0140   7D                     LD   A,L   
0141   A3                     AND   E   
0142   6F                     LD   L,A   
0143   F7                     RST   30h   
0144                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0144                             ; cells first. Flipping both sign bits turns a signed compare into an
0144                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0144                             ; carry into -1 or 0 with no branch.
0144   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0145   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0146   7C                     LD   A,H   
0147   EE 80                  XOR   80h   
0149   67                     LD   H,A   
014A   7A                     LD   A,D   
014B   EE 80                  XOR   80h   
014D   57                     LD   D,A   
014E   ED 52                  SBC   HL,DE   ; carry if HL < DE
0150   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0152   F7                     RST   30h   
0153   D1           H_EQ:     POP   DE   
0154   B7                     OR   A   
0155   ED 52                  SBC   HL,DE   
0157   7C                     LD   A,H   
0158   B5                     OR   L   
0159   FE 01                  CP   1   ; carry only if a - b = 0
015B   18 F3                  JR   tf   
015D                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
015D                             ; multiplier shifts up through A:C.
015D   D1           H_MUL:    POP   DE   ; DE = multiplicand
015E   C5                     PUSH   BC   
015F   7C                     LD   A,H   
0160   4D                     LD   C,L   ; A:C = multiplier
0161   21 00 00               LD   HL,0   
0164   06 10                  LD   B,16   
0166   29           MUL1:     ADD   HL,HL   
0167   CB 21                  SLA   C   
0169   17                     RLA      
016A   30 01                  JR   NC,mul2   
016C   19                     ADD   HL,DE   
016D   10 F7        MUL2:     DJNZ   mul1   
016F   C1                     POP   BC   
0170   F7                     RST   30h   
0171                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0171                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0171                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0171                             ; stops on it.
0171                H_DIV:       
0171                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0171                          ENDIF      
0171   D1                     POP   DE   ; DE = a, HL = b
0172   D5                     PUSH   DE   ; a, for r's sign
0173   7A                     LD   A,D   
0174   AC                     XOR   H   
0175   F5                     PUSH   AF   ; S flag = sign of q
0176   CB 7C                  BIT   7,H   
0178   C4 20 00               CALL   NZ,neg16   ; HL = |b|
017B   EB                     EX   DE,HL   
017C   CB 7C                  BIT   7,H   
017E   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0181   CD 44 02               CALL   udiv   ; HL = q, DE = r
0184   F1                     POP   AF   
0185   FC 20 00               CALL   M,neg16   ; q's sign
0188   EB                     EX   DE,HL   ; HL = r, DE = q
0189   F1                     POP   AF   ; A = a's high byte
018A   B7                     OR   A   
018B   FC 20 00               CALL   M,neg16   ; r's sign
018E   D5                     PUSH   DE   ; q under r
018F   F7                     RST   30h   
0190                             ; ---- stack and storage -----------------------------------------------------
0190   E5           H_DUP:    PUSH   HL   ; ":"
0191   F7                     RST   30h   
0192   E3           H_SWAP:   EX   (SP),HL   ; "%"
0193   F7                     RST   30h   
0194                             ; (The checked build tests the address before it takes the value off the
0194                             ; stack, so that an error report shows both.)
0194                H_CSTORE:      ; "." ( c addr -- )
0194                          IF   CHECKED   
                              CALL   chkst   
0194                          ENDIF      
0194   D1                     POP   DE   
0195   73                     LD   (HL),E   
0196   DF           H_DROP:   RST   18h   ; ";" is this one byte
0197                H_STORE:      ; "!" ( n addr -- )
0197                          IF   CHECKED   
                              CALL   chkst   
0197                          ENDIF      
0197   D1                     POP   DE   
0198   73                     LD   (HL),E   
0199   23                     INC   HL   
019A   72                     LD   (HL),D   
019B   DF                     RST   18h   
019C                             ; ---- console ---------------------------------------------------------------
019C                             ; 22h pushes the address of the text after it and skips the string.
019C   E5           H_STR:    PUSH   HL   
019D   60                     LD   H,B   
019E   69                     LD   L,C   
019F   CD 83 02               CALL   skipstr   
01A2                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01A2                          ENDIF      
01A2   F7                     RST   30h   
01A3                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01A3                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01A3                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01A3                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01A3                          IF   1-CHECKED   
01A3   7E           H_PRINT:   LD   A,(HL)   
01A4   23                     INC   HL   
01A5   FE 22                  CP   22h   
01A7   28 15                  JR   Z,pr9   
01A9   FE 2F                  CP   "/"   
01AB   20 0C                  JR   NZ,pr1   
01AD   7E                     LD   A,(HL)   
01AE   23                     INC   HL   
01AF   FE 60                  CP   60h   
01B1   38 04                  JR   C,pr0   
01B3   FE 7F                  CP   7Fh   
01B5   38 57                  JR   C,pesc   
01B7   E6 BF        PR0:      AND   0BFh   
01B9   EF           PR1:      RST   28h   
01BA   18 E7                  JR   h_print   
01BC                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
01BC                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01BC                          ENDIF      
01BC                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              RST   18h   
01BC                          ENDIF      
01BC   7D           H_EMIT:   LD   A,L   ; "'"
01BD   EF                     RST   28h   
01BE   DF           PR9:      RST   18h   
01BF                             ; "#" prints TOS as a signed decimal number, with no space after it.
01BF   CD C1 02     H_NUM:    CALL   psgn   
01C2   DF                     RST   18h   
01C3                             ; "?" ( n -- c ) or ( -n -- addr )
01C3                             ;   n > 0: wait about n ms for a key; 0 if none came
01C3                             ;   n = 0: wait for a key
01C3                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C3                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C3   CB 7C        H_KEY:    BIT   7,H   
01C5   20 19                  JR   NZ,line   
01C7   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C9   CD 29 03     KT2:      CALL   getk   
01CC   20 0E                  JR   NZ,kt3   
01CE   1D                     DEC   E   
01CF   20 F8                  JR   NZ,kt2   
01D1   7C                     LD   A,H   ; 0? never counts down: it waits
01D2   B5                     OR   L   
01D3   28 F2                  JR   Z,kt1   
01D5   2B                     DEC   HL   
01D6   7C                     LD   A,H   
01D7   B5                     OR   L   
01D8   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01DA   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01DB   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DC   6F           KT3:      LD   L,A   
01DD   26 00                  LD   H,0   
01DF   F7                     RST   30h   
01E0                             ; Backspace takes the last character back (and is echoed as it
01E0                             ; is), CR ends (stored, not echoed), every other key is stored and
01E0                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01E0                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01E0                             ; is the place in the line: D holds the L of a full line.
01E0   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E3   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E4   9F                     SBC   A,A   
01E5   A5                     AND   L   ; (0 for a count that is too big)
01E6   2F                     CPL      
01E7   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E8                             ;   at most
01E8   21 80 82               LD   HL,LINEBUF   
01EB   CD 29 03     LN2:      CALL   getk   
01EE   28 FB                  JR   Z,ln2   
01F0   FE 0D                  CP   13   
01F2   28 16                  JR   Z,ln5   
01F4   FE 08                  CP   8   
01F6   28 0B                  JR   Z,ln4   
01F8   5F                     LD   E,A   
01F9   7D                     LD   A,L   
01FA   BA                     CP   D   
01FB   28 EE                  JR   Z,ln2   ; full
01FD   73                     LD   (HL),E   
01FE   2C                     INC   L   
01FF   7B                     LD   A,E   
0200   EF           LN3:      RST   28h   
0201   18 E8                  JR   ln2   
0203   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0204   FA 00 02               JP   M,ln3   ;   unless the line was empty (L left the
0207   2C                     INC   L   ;   upper half of the page)
0208   18 E1                  JR   ln2   
020A   77           LN5:      LD   (HL),A   ; the CR
020B   2E 80                  LD   L,LINEBUF & 0FFh   
020D   F7                     RST   30h   
020E                             ; =============================================================================
020E                             ;  More routines (no handler starts past this point)
020E                             ; =============================================================================
020E                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
020E                          ENDIF      
020E                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
020E                             ; HL points past it. Each goes back into the loop that prints the string
020E                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
020E                             ;    /a-/z   print the variable, as "#" does
020E                             ;    /{      clear the screen, the cursor to the top left
020E                             ;    /}      clear from the cursor to the end of the line
020E                             ;    /|  /`  show the cursor, hide it
020E                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
020E   FE 7E        PESC:     CP   7Eh   
0210   28 1C                  JR   Z,pat   
0212   11 A3 01               LD   DE,PRLOOP   ; the others return into the loop
0215   D5                     PUSH   DE   
0216   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0218   30 1D                  JR   NC,pcon   
021A   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
021C   30 22                  JR   NC,phide   
021E   87                     ADD   A,A   ; the variable's cell
021F   C6 40                  ADD   A,40h   
0221   E5                     PUSH   HL   
0222   6F                     LD   L,A   
0223   26 82                  LD   H,LETPAGE   
0225   7E                     LD   A,(HL)   
0226   2C                     INC   L   
0227   66                     LD   H,(HL)   
0228   6F                     LD   L,A   
0229   CD C1 02               CALL   psgn   
022C   E1                     POP   HL   
022D   C9                     RET      
022E                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
022E                             ; the checked build "$" is the routine prstr: its own return address goes
022E                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
022E                             ; its two cells are there, and is s if not, before it prints anything.
022E                PAT:         
022E                          IF   CHECKED   
                              EX   (SP),HL   ; the text pointer over prstr's return address
                              LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              ADD   HL,SP   
                              JP   C,e_under   
                              POP   HL   
022E                          ENDIF      
022E   D1                     POP   DE   ; DE = the column
022F   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0230                          IF   1-ANS   
0230   CD 15 FF               CALL   CONAT   
0233   E1                     POP   HL   
0234   C3 A3 01               JP   PRAGAIN   
0237                             ; With ANSI = 0 the machine's routines do the rest.
0237   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
023A   FE 02                  CP   2   
023C   CA 0F FF               JP   Z,CONEOL   ; /}
023F   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
0240   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0241   C3 12 FF               JP   CONCUR   
0244                          ENDIF      
0244                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              LD   A,";"   
                              RST   28h   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              LD   A,"H"   
                              RST   28h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0244                          ENDIF      
0244                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              RST   28h   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0244                          ENDIF      
0244                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              LD   A,"2"   
                              RST   28h   
                              LD   A,"5"   
                              RST   28h   
                              LD   A,E   
                              RST   28h   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              RST   28h   
                              RET      
                    CSI:      PUSH   AF   
                              LD   A,27   
                              RST   28h   
                              LD   A,"["   
                              RST   28h   
                              POP   AF   
                              RET      
0244                          ENDIF      
0244                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0244                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0244                             ; the quotient bits arrive at the bottom of C.
0244                             ; Dividing by 2 is one shift (the spec wants that fast).
0244   7B           UDIV:     LD   A,E   
0245   EE 02                  XOR   2   
0247   B2                     OR   D   
0248   20 07                  JR   NZ,udv0   
024A   CB 3C                  SRL   H   
024C   CB 1D                  RR   L   ; the quotient
024E   8F                     ADC   A,A   
024F   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0250   C9                     RET      
0251   C5           UDV0:     PUSH   BC   
0252   7C                     LD   A,H   
0253   4D                     LD   C,L   
0254   21 00 00               LD   HL,0   
0257   06 10                  LD   B,16   
0259   CB 21        UDV1:     SLA   C   
025B   17                     RLA      
025C   ED 6A                  ADC   HL,HL   
025E   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0260   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0262   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0263   0D                     DEC   C   ;   INC below
0264   0C           UDV2:     INC   C   ; a quotient bit
0265   10 F2                  DJNZ   udv1   
0267   EB                     EX   DE,HL   ; DE = remainder
0268   67                     LD   H,A   
0269   69                     LD   L,C   ; HL = quotient
026A   C1                     POP   BC   
026B   C9                     RET      
026C                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
026C                             ; non-digit. Values wrap at 16 bits, as the spec says.
026C   21 00 00     RDNUM:    LD   HL,0   
026F   0A           RDN1:     LD   A,(BC)   
0270   D6 30                  SUB   "0"   
0272   FE 0A                  CP   10   
0274   D0                     RET   NC   
0275   03                     INC   BC   
0276   54                     LD   D,H   
0277   5D                     LD   E,L   
0278   29                     ADD   HL,HL   
0279   29                     ADD   HL,HL   
027A   19                     ADD   HL,DE   
027B   29                     ADD   HL,HL   ; HL * 10
027C   5F                     LD   E,A   
027D   16 00                  LD   D,0   
027F   19                     ADD   HL,DE   
0280   18 ED                  JR   rdn1   
0282                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0282                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0282                          IF   1-CHECKED   
0282   03           SS0:      INC   BC   
0283   0A           SKIPSTR:   LD   A,(BC)   
0284   03                     INC   BC   
0285   FE 2F                  CP   "/"   
0287   28 F9                  JR   Z,ss0   
0289   FE 22                  CP   22h   
028B   20 F6                  JR   NZ,skipstr   
028D   C9                     RET      
028E                          ENDIF      
028E                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
028E                          ENDIF      
028E                             ; skip: read past text to the closer at this level, and return A = 0 if it
028E                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
028E                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
028E                             ; no closer; anything else that runs into the NUL had unbalanced brackets
028E                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
028E                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
028E                             ; 
028E                             ; The checked build also looks at the character the skip was started by,
028E                             ; which is always the one just before where it starts: "(" must end at ")",
028E                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
028E                             ; quote counts as running into it. "\" takes either closer. IX keeps the
028E                             ; place where the skip started, for the report.
028E                SKIP:        
028E                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
028E                          ENDIF      
028E   16 00                  LD   D,0   
0290   14           SK3:      INC   D   ; an opener: one deeper
0291   0A           SK1:      LD   A,(BC)   
0292                          IF   1-CHECKED   
0292   03                     INC   BC   
0293   B7                     OR   A   
0294   CA 09 FF               JP   Z,SKEND   ; (the end of the program)
0297                          ENDIF      
0297                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0297                          ENDIF      
0297   FE 22                  CP   22h   
0299   CC 83 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
029C   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
029E   28 F0                  JR   Z,sk3   
02A0   3D                     DEC   A   ; ")"
02A1   28 08                  JR   Z,sk4   
02A3   D6 32                  SUB   "["-")"   
02A5   28 E9                  JR   Z,sk3   
02A7   FE 02                  CP   "]"-"["   
02A9   20 E6                  JR   NZ,sk1   
02AB   15           SK4:      DEC   D   
02AC                          IF   1-CHECKED   
02AC   C8                     RET   Z   ; the closer at this level
02AD   18 E2                  JR   sk1   
02AF                          ENDIF      
02AF                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02AF                          ENDIF      
02AF                             ; =============================================================================
02AF                             ;  Dispatch table: the low byte of each handler's address, in code order
02AF                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02AF                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02AF                             ; =============================================================================
02AF                             ; The handlers of the first NPG1 characters start in the image's second page.
02AF                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02AF                             ; differs between the builds, so the count is worked out here.
02AF                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02AF                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02AF                PGBRK:    EQU   (h_break-BASE)/256   
02AF                PGDEF:    EQU   (h_def-BASE)/256   
02AF                PGFET:    EQU   (h_fetch-BASE)/256   
02AF                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02AF                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02AF                          ENDIF      
02AF                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02AF                             ; and return its value in A with the carry set; otherwise leave the IP and
02AF                             ; return with the carry clear.
02AF   0A           HEXC:     LD   A,(BC)   
02B0   D6 30                  SUB   "0"   
02B2   FE 0A                  CP   10   
02B4   38 09                  JR   C,hc1   
02B6   E6 DF                  AND   0DFh   
02B8   D6 11                  SUB   11h   
02BA   FE 06                  CP   6   
02BC   D0                     RET   NC   
02BD   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02BF   03           HC1:      INC   BC   
02C0   C9                     RET      
02C1                             ; psgn: print HL as a signed number. Keeps BC.
02C1   CB 7C        PSGN:     BIT   7,H   
02C3   28 04                  JR   Z,pdec   
02C5   3E 2D                  LD   A,"-"   
02C7   EF                     RST   28h   
02C8   E7                     RST   20h   
02C9                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02C9                             ; Keeps BC.
02C9   11 0A 00     PDEC:     LD   DE,10   
02CC   CD 44 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02CF   7B                     LD   A,E   
02D0   F5                     PUSH   AF   
02D1   7C                     LD   A,H   
02D2   B5                     OR   L   
02D3   C4 C9 02               CALL   NZ,pdec   
02D6   F1                     POP   AF   
02D7   C6 30                  ADD   A,"0"   
02D9   EF                     RST   28h   
02DA   C9                     RET      
02DB                             ; (The table goes here instead in the builds where, before psgn, it would
02DB                             ; cross a page: PTLATE.)
02DB                          IF   (1-TABP0)*PTLATE   
02DB                PTAB:        
02DB                          ;*Macro unroll:  PTABLE
02DB   97                     DB   h_store & 0FFh   
02DC   9C                     DB   h_str & 0FFh   
02DD   BF                     DB   h_num & 0FFh   
02DE   A3                     DB   h_print & 0FFh   
02DF   92                     DB   h_swap & 0FFh   
02E0   3C                     DB   h_and & 0FFh   
02E1   BC                     DB   h_emit & 0FFh   
02E2   18                     DB   h_open & 0FFh   
02E3   20                     DB   h_close & 0FFh   
02E4   5D                     DB   h_mul & 0FFh   
02E5   33                     DB   h_add & 0FFh   
02E6   DB                     DB   h_cfetch & 0FFh   
02E7   2B                     DB   h_sub & 0FFh   
02E8   94                     DB   h_cstore & 0FFh   
02E9   71                     DB   h_div & 0FFh   
02EA   90                     DB   h_dup & 0FFh   
02EB   96                     DB   h_drop & 0FFh   
02EC   44                     DB   h_lt & 0FFh   
02ED   53                     DB   h_eq & 0FFh   
02EE   45                     DB   h_gt & 0FFh   
02EF   C3                     DB   h_key & 0FFh   
02F0   13                     DB   h_fetch & 0FFh   
02F1   F6                     DB   h_def & 0FFh   
02F2   E9                     DB   h_break & 0FFh   
02F3   E5                     DB   h_ret & 0FFh   
02F4   81                     DB   h_xor & 0FFh   
02F5   94                     DB   h_alloc & 0FFh   
02F6   CF                     DB   h_grave & 0FFh   
02F7   2C                     DB   h_tor & 0FFh   
02F8   89                     DB   h_or & 0FFh   
02F9   1C                     DB   h_fromr & 0FFh   
02FA   91                     DB   h_not & 0FFh   
02FB                PTABEND:      
02FB                          ENDIF      
02FB                             ; =============================================================================
02FB                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
02FB                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
02FB                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
02FB                             ;  they are the host's KEY and CONOUT routines themselves.
02FB                             ; 
02FB                             ;  A running program reads the keyboard only through getk and pollk, which
02FB                             ;  between them give the break key its rules:
02FB                             ;    - Ctrl-C stops the program;
02FB                             ;    - any other key that the break check reads is held in KEYBUF for the
02FB                             ;      next "?", and a newer one takes its place;
02FB                             ;    - "?" (getk) takes the held key first;
02FB                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
02FB                             ;      key like any other, but two of them within about 250 ms still stop it.
02FB                             ;  Both are called straight from a handler, never from a routine under one:
02FB                             ;  the checked build's report counts on finding one return address above the
02FB                             ;  data stack.
02FB                             ; =============================================================================
02FB                          IFN   CPM   
02FB                RAWK:     EQU   KEY   
02FB                          ENDIF      
02FB                             ; pollk: the break check (see rpushn).
02FB   CD 06 FF     POLLK:    CALL   rawk   
02FE   C8                     RET   Z   ; no key
02FF   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0302   FE 03        PK1:      CP   3   ; (getk joins here)
0304   C0                     RET   NZ   
0305                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0305                             ; the program has turned it off, wait about 250 ms for one more key: a
0305                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0305                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0305   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0308   B7                     OR   A   
0309   CA 15 00     CT0:      JP   Z,brk   
030C   D5                     PUSH   DE   
030D   11 10 27               LD   DE,250*MSLOOP   
0310   CD 06 FF     CT1:      CALL   rawk   
0313   20 05                  JR   NZ,ct2   
0315   1B                     DEC   DE   
0316   7A                     LD   A,D   
0317   B3                     OR   E   
0318   20 F6                  JR   NZ,ct1   
031A   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
031B   FE 03                  CP   3   
031D   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
031F   B7                     OR   A   
0320   28 03                  JR   Z,ct3   
0322   32 7A 82               LD   (KEYBUF),A   
0325   3E 03        CT3:      LD   A,3   
0327   B7                     OR   A   
0328   C9                     RET      
0329                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0329   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
032A   21 7A 82               LD   HL,KEYBUF   ;   the buffer
032D   7E                     LD   A,(HL)   
032E   36 00                  LD   (HL),0   
0330   E1                     POP   HL   
0331   B7                     OR   A   
0332   C0                     RET   NZ   
0333   CD 06 FF               CALL   rawk   
0336   C8                     RET   Z   
0337   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0339                          IF   (1-CHECKED)*(1-EDITOR)   
0339                BRK:      EQU   endprog   ; the unchecked build stops without a word
0339                          ENDIF      ;   (with the editor, both stacks are cleared);
0339                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0339                          ENDIF      
0339                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
0339                          ENDIF      
0339                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0339                          ENDIF      
0339                             ; =============================================================================
0339                             ;  Checked build: the checks and the error report
0339                             ; =============================================================================
0339                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
0339                          ENDIF      
0339                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0339                          ENDIF      
0339                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0339                          ENDIF      
0339                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
0339                          ENDIF      
0339                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0339                          ENDIF      
0339                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0339                          ENDIF      
0339                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
0339                          ENDIF      
0339                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0339                          ENDIF      ;   screen on it. The editor's loader ends
0339                          IF   CHECKED   ;   the text at the first ^Z.)
                              RST   28h   
                              DJNZ   er4   
                    ER5:         ; (on into the two stack lines)
                                 ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
                                 ;                       Rtn n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
                              ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
                              RST   20h   ;   with the first value and holds nothing)
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      ; RSTOP - HL' is under 256 (the pointer is
                              LD   A,RSTOP&0FFh   ;   at most one entry below its page), so
                              SUB   L   ;   the low bytes are enough
                              EXX      
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
0339                          ENDIF      
0339                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
0339                          ENDIF      
0339                          IF   CHECKED*EDITOR   
                              JP   edit0   ; back to the editor, with both stacks cleared
0339                          ENDIF      
0339                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
0339                          ENDIF      
0339                             ; =============================================================================
0339                             ;  The line editor (EDITOR = 1)
0339                             ; 
0339                             ;  The interpreter starts here, and a program that ends comes back here.
0339                             ;  There is no prompt. It follows the spec's suggested standard for a line
0339                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0339                             ; 
0339                             ;    n text    put the text in as line n; the lines from n on move down. A
0339                             ;              number past the end (or 0) adds the line at the end.
0339                             ;    n         take line n out
0339                             ;    anything else is run at once, as B8Script. (Start such a line with a
0339                             ;    space if it would begin with a digit.)
0339                             ; 
0339                             ;  A command key ends the line too, and takes what was typed as its argument:
0339                             ; 
0339                             ;    ^G        run the program
0339                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0339                             ;              list until another key is pressed; Ctrl-C ends it.
0339                             ;    n ^E      put line n in the input line; Return puts it back, changed
0339                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0339                             ;              last time). Generic: what is typed, or pasted, from now until
0339                             ;              ^Z replaces the program; it is not echoed.
0339                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0339                             ;              time). Generic: the text is printed, as it is.
0339                             ;    ^N ^N     new: no program (the key twice in a row)
0339                             ;    ^X        leave (to LEAVE)
0339                             ; 
0339                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
0339                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0339                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0339                             ;  sent to the terminal, so any terminal will do.
0339                             ; 
0339                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0339                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0339                             ;  125 characters; the one character after a line number separates it from
0339                             ;  the text and is not stored. The text is kept as it is typed, each line
0339                             ;  ending in CR LF, at PROG.
0339                             ; 
0339                             ;  What lasts from one line to the next: the program, the words, the
0339                             ;  variables and the data stack. An error or a break clears both stacks. The
0339                             ;  return stack starts empty for every line.
0339                             ; 
0339                             ;  Things to know:
0339                             ;    - Reset empties the program (generic builds).
0339                             ;    - A word's address points into the program, so run the program again
0339                             ;      after editing it.
0339                             ;    - Nothing is printed between a program's output and what is typed next.
0339                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0339                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0339                             ;      (The stored program never comes back to the line, so it may.)
0339                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0339                             ;      read of the other builds.
0339                             ; 
0339                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0339                             ;  the last line left there, with TOS pushed like the rest.
0339                             ; =============================================================================
0339                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
0339                          ENDIF      
0339                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0339                          ENDIF      
0339                          IF   EDGEN   
                              JR   edit0   
0339                          ENDIF      
0339                          IF   EDITOR   
                                 ; ^F, right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; ^B, left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                    LF1:      RST   28h   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0339                          ENDIF      
0339                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
0339                          ENDIF      
0339                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
0339                          ENDIF      
0339                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   2   
                              JR   Z,left   ; ^B
                              CP   6   
                              JR   Z,right   ; ^F
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              LD   A,8   
                              RST   28h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              RST   28h   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              RST   28h   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              LD   A,8   
                              RST   28h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N ^N: no program, if the next key is ^N too
                    CNEW:     CALL   ekey   
                              CP   14   
                              JR   NZ,ged0   
                              XOR   A   
                              LD   (PROG),A   
                    GED0:     JP   edit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              RST   28h   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
0339                          ENDIF      
0339                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0339                          ENDIF      
0339                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              RST   30h   ; (its return address is thrown away)
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
0339                          ENDIF      
0339                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
0339                          ENDIF      
0339                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0339                          ENDIF      
0339                             ; =============================================================================
0339                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0339                          ENDIF      
0339                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0339                          ENDIF      
0339                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
0339                          ENDIF      
0339                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0339                          ENDIF      
0339                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0339                          ENDIF      
0339                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0339                          ENDIF      
0339                IMGEND:      


