0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three. (asm80 wants the vector number: RST 1 = RST 08h.)
0000                             ; 
0000                             ;    RST 1  08h  rpop    pop the return stack into HL
0000                             ;    RST 3  18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 4  20h  neg16   HL = -HL
0000                             ;    RST 5  28h  putc    print A
0000                             ;    RST 6  30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block has no jumps inside itself, so it works at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    EXIT:     EQU   0000h   ; warm boot
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with ORA A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve BC, DE and HL.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255;
0000                             ; the wait for a second Ctrl-C uses it too):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                BRKCNT:   EQU   LET+36h   ;   the break check's countdown;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   1-(1-CPM)*CHECKED   
                              LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000   C3 CB 05               JMP   start   ; In the checked generic build this is at 0000h
0003                             ;   (and `start` sets SP): its first byte, C3h,
0003                             ;   is what an undefined word runs into, as
0003                             ;   CP/M's own JMP at 0000h is in a .COM: e_hi.
0003                          IF   (1-CPM)*CHECKED   
0003   00 00 00               DB   0,0,0   ; 03  spare
0006                          ENDIF      
0006   CF           RDROP:    RST   1   ; 06  drop the top of the return stack, then
0007   DF                     RST   3   ;     drop TOS (a spent flag) and go on
0008                VECS:        
0008                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
0008   2A 34 82     RPOP:     LHLD   RSP   ; 08
000B   5E                     MOV   E,M   
000C   23                     INX   H   
000D   56                     MOV   D,M   
000E   23                     INX   H   
000F   22 34 82               SHLD   RSP   
0012   EB                     XCHG      
0013   C9                     RET      ; 13  (so RST 2 is not used)
0014   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0015   C3 B3 00               JMP   rpushd   ;     brings up the new TOS
0018                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
0018   D1           RST18:    POP   D   ; 18  discard the RST's return address
0019   E1                     POP   H   ;     new TOS = NOS
001A   C3 31 00               JMP   next0   
001D   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
001E   CF                     RST   1   
001F   F7                     RST   6   
0020                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0020   AF           NEG16:    XRA   A   ; 20
0021   95                     SUB   L   
0022   6F                     MOV   L,A   
0023   9F                     SBB   A   
0024   94                     SUB   H   
0025   67                     MOV   H,A   
0026   C9                     RET      
0027   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
0028                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JMP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JMP   putc   ; 28
002B                          ENDIF      
002B                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
002B                             ; returns here, with its top cell on the stack: that becomes the new TOS.
002B   CD 27 00     EXEC:     CALL   jphl   ; 2B
002E   E1                     POP   H   
002F   F7                     RST   6   
0030                             ; ---- RST 6: next character --------------------------------------------------
0030   D1           RST30:    POP   D   ; 30  discard the RST's return address
0031                          IF   CPM   
                              JMP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD A1 04               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LDAX   B   
0035   03                     INX   B   
0036   D6 21                  SUI   21h   ; A = c - 21h
0038   DA 7A 00               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
003B   FE 0F                  CPI   0Fh   
003D   DA 6B 00               JC   punct   ; 21h-2Fh: PTAB index 0-14
0040   D6 0F                  SUI   0Fh   ; A = c - 30h
0042   FE 0A                  CPI   0Ah   
0044   DA 57 02               JC   digit   ; 30h-39h
0047   FE 11                  CPI   11h   
0049   DA 69 00               JC   p3a   ; 3Ah-40h
004C   D6 11                  SUI   11h   ; A = c - 41h
004E   FE 1A                  CPI   1Ah   
0050   DA A9 00               JC   upper   ; 41h-5Ah: A = letter index 0-25
0053   FE 20                  CPI   20h   
0055   DA 67 00               JC   p5b   ; 5Bh-60h
0058   FE 3A                  CPI   3Ah   
005A   DA A3 00               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
005D   FE 3E                  CPI   3Eh   
005F                          IF   CHECKED   
005F   CA 31 00               JZ   next0   ; 7Fh, DEL: ignored
0062   D2 D8 04               JNC   e_hi   ; 80h-FFh: reserved
0065                          ENDIF      
0065                          IF   1-CHECKED   
                              JNC   next0   ; 7Fh-FFh: ignored
0065                          ENDIF      
0065   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0067   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
0069   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
006B                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
006B                             ; untouched, and A, DE free.
006B   C6 37        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
006D   5F                     MOV   E,A   
006E   16 02                  MVI   D,PTAB / 256   
0070   FE 4D                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0072   1A                     LDAX   D   
0073   5F                     MOV   E,A   ; the handler's low byte
0074                          IFN   CPM   
0074   3E 00                  MVI   A,0   
0076   17                     RAL      ; its page: 0 + carry
0077                          ENDIF      
0077                          IF   CPM   
                              MVI   A,1   
                              ACI   0   ; its page: 1 + carry
0077                          ENDIF      
0077   57                     MOV   D,A   
0078   D5                     PUSH   D   ; jump to it; the stack is balanced again
0079   C9                     RET      ;   when the handler starts
007A                             ; ctl: characters below 21h. A = c - 21h.
007A   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
007C   C2 31 00               JNZ   next0   ; the rest are ignored
007F   C3 09 FF     ENDPROG:   JMP   EXIT   ; the program has ended
0082                             ; =============================================================================
0082                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0082                             ;  (00bbIGFuZCA= are up among the RST routines.)
0082                             ; =============================================================================
0082   D1           H_XOR:    POP   D   
0083   7C                     MOV   A,H   
0084   AA                     XRA   D   
0085   67                     MOV   H,A   
0086   7D                     MOV   A,L   
0087   AB                     XRA   E   
0088   6F                     MOV   L,A   
0089   F7                     RST   6   
008A   D1           H_OR:     POP   D   
008B   7C                     MOV   A,H   
008C   B2                     ORA   D   
008D   67                     MOV   H,A   
008E   7D                     MOV   A,L   
008F   B3                     ORA   E   
0090   6F                     MOV   L,A   
0091   F7                     RST   6   
0092   E7           H_NOT:    RST   4   ; ~x = -x - 1
0093   2B                     DCX   H   
0094   F7                     RST   6   
0095                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0095                             ; the same either way); TOS is the old pointer.
0095   EB           H_ALLOC:   XCHG      
0096   2A 7C 82               LHLD   HEAP   
0099   E5                     PUSH   H   
009A   19                     DAD   D   ; the new top
009B                          IF   CHECKED   
009B   CD 4F 04               CALL   chkhp   
009E                          ENDIF      
009E   22 7C 82               SHLD   HEAP   
00A1   E1                     POP   H   
00A2   F7                     RST   6   
00A3                             ; ---- the letters and digits --------------------------------------------------
00A3                             ; a-z: push the cell's address (the cell is the variable)
00A3   E5           LOWER:    PUSH   H   
00A4   87                     ADD   A   
00A5   6F                     MOV   L,A   
00A6   26 82                  MVI   H,LETPAGE   
00A8   F7                     RST   6   
00A9                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00A9                             ; the return stack, and the IP becomes the address in the letter's cell.
00A9   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
00AA   87                     ADD   A   
00AB   6F                     MOV   L,A   
00AC   26 82                  MVI   H,LETPAGE   ; HL -> cell
00AE   50                     MOV   D,B   
00AF   59                     MOV   E,C   ; DE = the return address
00B0   4E                     MOV   C,M   
00B1   23                     INX   H   
00B2   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
00B3                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
00B3                             ; go on. Every push of the return stack ends here: for a word call the cell
00B3                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
00B3                             ; the one that was used up.
00B3                             ; 
00B3                             ; The break key is looked at here, so at every word call and loop-back (and
00B3                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
00B3                             ; the keyboard can be slow (it is a BDOS call under CP/M).
00B3   2A 34 82     RPUSHD:   LHLD   RSP   
00B6   2B                     DCX   H   
00B7   72                     MOV   M,D   
00B8   2B                     DCX   H   
00B9   73                     MOV   M,E   
00BA   22 34 82               SHLD   RSP   
00BD   21 36 82               LXI   H,BRKCNT   
00C0   35                     DCR   M   
00C1   E1                     POP   H   ; (keeps the flags)
00C2   CC 0C 04               CZ   pollk   
00C5   F7                     RST   6   
00C6                             ; ---- the grave -------------------------------------------------------------
00C6                             ; The grave is a prefix: with the character after it, it is one command.
00C6                             ; GTAB holds each character with the place of its handler, as a byte to add
00C6                             ; to that byte's own address (so the table sits just ahead of the handlers).
00C6                             ; The handler starts with HL = TOS, A = the character and the carry clear. A character that is not in the table is unsafe: the unchecked
00C6                             ; build searches on through memory, the checked build stops with W.
00C6   0A           H_GRAVE:   LDAX   B   
00C7   03                     INX   B   
00C8   E5                     PUSH   H   ; TOS
00C9   21 AB 02               LXI   H,GTAB-1   
00CC   23           GR1:      INX   H   
00CD                          IF   CHECKED   
00CD   5E                     MOV   E,M   
00CE   1C                     INR   E   
00CF   CA 83 03               JZ   gbad   ; FFh ends the table
00D2                          ENDIF      
00D2   BE                     CMP   M   
00D3   23                     INX   H   
00D4   C2 CC 00               JNZ   gr1   
00D7   5E                     MOV   E,M   
00D8   16 00                  MVI   D,0   
00DA   19                     DAD   D   ; the handler: this byte's address plus it
00DB   E3                     XTHL      ; TOS back, and jump there
00DC   C9                     RET      
00DD                             ; ---- where the two pages meet ----------------------------------------------
00DD                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00DD                             ; are in falling code order for this), and where exactly differs between the
00DD                             ; builds: NPG1 follows. Every handler below these four must start in the
00DD                             ; second page, and every one above in the first; chktab.py checks both.
00DD                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
00DD                             ; while rpop uses HL, and the drop at the end brings it back.
00DD   E5           H_RET:    PUSH   H   
00DE   CF           RET2:     RST   1   
00DF   44                     MOV   B,H   
00E0   4D                     MOV   C,L   
00E1   DF                     RST   3   
00E2                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00E2                             ; drops the block start, "]" returns. No closer at all ends the program.
00E2                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
00E2   7C           H_BREAK:   MOV   A,H   
00E3   B5                     ORA   L   
00E4   CA CF 01               JZ   h_drop   ; false: just drop the flag
00E7   CD A2 03               CALL   skip   
00EA   B7                     ORA   A   ; skip returns 0 for ")"
00EB   C2 DE 00               JNZ   ret2   
00EE   C3 06 00               JMP   rdrop   
00F1                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00F1                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00F1                             ; the body"s address instead. Either way it then skips to the matching "]'.
00F1                             ; (The unchecked build takes anything that is not a letter as the space; the
00F1                             ; checked build stops on it.)
00F1   0A           H_DEF:    LDAX   B   
00F2   03                     INX   B   
00F3   D6 41                  SUI   "A"   ; a letter gives 0-25 or 32-57: lowercase
00F5   5F                     MOV   E,A   ;   lands 64 bytes up
00F6   E6 DF                  ANI   0DFh   ; fold case
00F8   FE 1A                  CPI   26   
00FA   D2 0A 01               JNC   def2   ; not a letter
00FD   7B                     MOV   A,E   
00FE   87                     ADD   A   
00FF   5F                     MOV   E,A   
0100   16 82                  MVI   D,LETPAGE   ; DE -> cell
0102   79                     MOV   A,C   
0103   12                     STAX   D   
0104   1C                     INR   E   
0105   78                     MOV   A,B   
0106   12                     STAX   D   
0107   C3 13 01               JMP   skipnx   
010A                DEF2:        
010A                          IF   CHECKED   
010A   7B                     MOV   A,E   
010B   FE DF                  CPI   " "-"A"+256   
010D   C2 F2 04               JNZ   e_brack   ; anything but a letter or a space
0110                          ENDIF      
0110   E5                     PUSH   H   ; an anonymous block: push its address
0111   60                     MOV   H,B   
0112   69                     MOV   L,C   
0113                SKIPNX:      
0113                          IF   CHECKED   
0113   0B                     DCX   B   ; back onto the letter, so that skip finds its
0114                          ENDIF      ;   opener, the "[", just before where it starts
0114   CD A2 03     SKIPO:    CALL   skip   
0117   F7                     RST   6   
0118   5E           H_FETCH:   MOV   E,M   ; "@"
0119   23                     INX   H   
011A   56                     MOV   D,M   
011B   EB                     XCHG      
011C   F7                     RST   6   
011D                             ; =============================================================================
011D                             ;  Handlers that must start in the image's second page.
011D                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
011D                             ;  tail may run past that page.
011D                             ; =============================================================================
011D                             ; ---- flow control ----------------------------------------------------------
011D                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
011D                             ; the matching ")".
011D   7C           H_OPEN:   MOV   A,H   
011E   B5                     ORA   L   
011F   E1                     POP   H   
0120   CA 14 01               JZ   skipo   
0123   E5                     PUSH   H   ; (rpushd pops it again)
0124   50                     MOV   D,B   
0125   59                     MOV   E,C   ; the block starts at the IP
0126   C3 B3 00               JMP   rpushd   
0129                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0129                             ; drops it and carries on.
0129   7C           H_CLOSE:   MOV   A,H   
012A   B5                     ORA   L   
012B   CA 06 00               JZ   rdrop   
012E   CF                     RST   1   ; pop the block start ...
012F   44                     MOV   B,H   
0130   4D                     MOV   C,L   ; ... jump to it ...
0131   EB                     XCHG      
0132   C3 B3 00               JMP   rpushd   ; ... and push it back (which drops the flag)
0135                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0135                             ; "-" has two jobs: directly before a digit it starts a negative number.
0135   0A           H_SUB:    LDAX   B   
0136   D6 30                  SUI   "0"   
0138   FE 0A                  CPI   10   
013A   DA 5D 02               JC   negnum   
013D   E7                     RST   4   ; a - b = a + (-b): fall into "+"
013E   D1           H_ADD:    POP   D   
013F   19                     DAD   D   
0140   F7                     RST   6   
0141   D1           H_AND:    POP   D   
0142   7C                     MOV   A,H   
0143   A2                     ANA   D   
0144   67                     MOV   H,A   
0145   7D                     MOV   A,L   
0146   A3                     ANA   E   
0147   6F                     MOV   L,A   
0148   F7                     RST   6   
0149                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0149                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0149                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0149                             ; SBB A turns a carry into -1 or 0 with no branch.
0149   E3           H_GT:     XTHL      ; a > b  is  b < a
014A   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
014B   7B                     MOV   A,E   
014C   95                     SUB   L   
014D   7A                     MOV   A,D   
014E   9C                     SBB   H   
014F   9F                     SBB   A   ; A = -1 if DE < HL unsigned
0150   6F                     MOV   L,A   
0151   7C                     MOV   A,H   
0152   AA                     XRA   D   
0153   17                     RAL      ; carry = the signs differ
0154   9F                     SBB   A   
0155   AD                     XRA   L   ; flip when they do
0156   67                     MOV   H,A   
0157   6F                     MOV   L,A   
0158   F7                     RST   6   
0159   D1           H_EQ:     POP   D   
015A   7D                     MOV   A,L   
015B   AB                     XRA   E   
015C   6F                     MOV   L,A   
015D   7C                     MOV   A,H   
015E   AA                     XRA   D   
015F   B5                     ORA   L   ; zero if equal
0160   D6 01                  SUI   1   ; carry only for zero
0162   9F                     SBB   A   
0163   67                     MOV   H,A   
0164   6F                     MOV   L,A   
0165   F7                     RST   6   
0166                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0166                             ; multiplier is used up; only the low 16 bits are kept.
0166   D1           H_MUL:    POP   D   ; DE = multiplicand
0167   C5                     PUSH   B   
0168   44                     MOV   B,H   
0169   4D                     MOV   C,L   ; BC = multiplier
016A   21 00 00               LXI   H,0   
016D   78           MUL1:     MOV   A,B   
016E   B7                     ORA   A   ; clear carry
016F   1F                     RAR      
0170   47                     MOV   B,A   
0171   79                     MOV   A,C   
0172   1F                     RAR      
0173   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0174   D2 78 01               JNC   mul2   
0177   19                     DAD   D   
0178   EB           MUL2:     XCHG      
0179   29                     DAD   H   ; multiplicand << 1
017A   EB                     XCHG      
017B   78                     MOV   A,B   
017C   B1                     ORA   C   
017D   C2 6D 01               JNZ   mul1   
0180   C1                     POP   B   
0181   F7                     RST   6   
0182                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0182                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0182                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0182                             ; stops on it.
0182                H_DIV:       
0182                          IF   CHECKED   
0182   7C                     MOV   A,H   
0183   B5                     ORA   L   
0184   CA EF 04               JZ   e_zero   
0187                          ENDIF      
0187   D1                     POP   D   ; DE = a, HL = b
0188   C5                     PUSH   B   
0189   7A                     MOV   A,D   
018A   B7                     ORA   A   
018B   F5                     PUSH   PSW   ; S flag = sign of a (for r)
018C   AC                     XRA   H   
018D   F5                     PUSH   PSW   ; S flag = sign of q
018E   7C                     MOV   A,H   
018F   B7                     ORA   A   
0190   FC 20 00               CM   neg16   ; HL = |b|
0193   EB                     XCHG      
0194   7C                     MOV   A,H   
0195   B7                     ORA   A   
0196   FC 20 00               CM   neg16   ; HL = |a|, DE = |b|
0199   CD 7A 02               CALL   udiv   ; HL = q, BC = r
019C   F1                     POP   PSW   
019D   FC 20 00               CM   neg16   ; q's sign
01A0   EB                     XCHG      ; DE = q
01A1   60                     MOV   H,B   
01A2   69                     MOV   L,C   ; HL = r
01A3   F1                     POP   PSW   
01A4   FC 20 00               CM   neg16   ; r's sign
01A7   C1                     POP   B   
01A8   D5                     PUSH   D   ; q under r
01A9   F7                     RST   6   
01AA                             ; ---- stack and storage -----------------------------------------------------
01AA   E5           H_DUP:    PUSH   H   ; ":"
01AB   F7                     RST   6   
01AC   E3           H_SWAP:   XTHL      ; "%"
01AD   F7                     RST   6   
01AE                             ; (The checked build tests the address before it takes the value off the
01AE                             ; stack, so that an error report shows both.)
01AE                H_STORE:      ; "!" ( n addr -- )
01AE                          IF   CHECKED   
01AE   CD 65 04               CALL   chkst   
01B1                          ENDIF      
01B1   D1                     POP   D   
01B2   73                     MOV   M,E   
01B3   23                     INX   H   
01B4   72                     MOV   M,D   
01B5   DF                     RST   3   
01B6                H_CSTORE:      ; "." ( c addr -- )
01B6                          IF   CHECKED   
01B6   CD 65 04               CALL   chkst   
01B9                          ENDIF      
01B9   D1                     POP   D   
01BA   73                     MOV   M,E   
01BB   DF                     RST   3   
01BC                             ; ---- console ---------------------------------------------------------------
01BC                             ; 22h pushes the address of the text after it and skips the string.
01BC   E5           H_STR:    PUSH   H   
01BD   60                     MOV   H,B   
01BE   69                     MOV   L,C   
01BF   CD E6 03               CALL   skipstr   
01C2                          IF   CHECKED   
01C2   B7                     ORA   A   ; 0: the text ran out before the closing quote
01C3   CA E7 04               JZ   e_quote   
01C6                          ENDIF      
01C6   F7                     RST   6   
01C7                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01C7                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01C7                             ; bit 6, so // and /" give themselves).
01C7                          IF   1-CHECKED   
                    H_PRINT:   MOV   A,M   
                              INX   H   
                              CPI   22h   
                              JZ   h_drop   
                              CPI   "/"   
                              JNZ   pr1   
                              MOV   A,M   
                              INX   H   
                              ANI   0BFh   
                    PR1:      RST   5   
                              JMP   h_print   
01C7                          ENDIF      
01C7                          IF   CHECKED   
01C7                             ; (The checked build has the loop as a routine, prstr, which the error
01C7                             ; report uses too. The address is kept on the stack meanwhile: a report
01C7                             ; shows the stack as it was before the "$".)
01C7   E5           H_PRINT:   PUSH   H   
01C8   CD 78 04               CALL   prstr   
01CB   D1                     POP   D   
01CC   DF                     RST   3   
01CD                          ENDIF      
01CD   7D           H_EMIT:   MOV   A,L   ; "'"
01CE   EF                     RST   5   
01CF   DF           H_DROP:   RST   3   ; ";" is this one byte
01D0                             ; "#" prints TOS as a signed decimal number, with no space after it.
01D0   C5           H_NUM:    PUSH   B   
01D1   CD 87 03               CALL   psgn   
01D4   C1                     POP   B   
01D5   DF                     RST   3   
01D6                          IF   CHECKED   ; (the checked build has no room to start ","
01D6   6E           H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
01D7   26 00                  MVI   H,0   ;   the end of "?")
01D9   F7                     RST   6   
01DA                          ENDIF      
01DA                             ; "?" ( n -- c ) or ( -n -- addr )
01DA                             ;   n > 0: wait about n ms for a key; 0 if none came
01DA                             ;   n = 0: wait for a key
01DA                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01DA                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01DA   7C           H_KEY:    MOV   A,H   
01DB   B7                     ORA   A   
01DC   FA 03 02               JM   line   
01DF   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
01E1   CD 3E 04     KT2:      CALL   getk   
01E4   C2 FF 01               JNZ   kt3   
01E7   1D                     DCR   E   
01E8   C2 E1 01               JNZ   kt2   
01EB   EB                     XCHG      ; a millisecond with no key stirs the random
01EC   2A 76 82               LHLD   SEED   ;   seed by one: how long a key takes to come
01EF   23                     INX   H   ;   is the one thing here that is not the
01F0   22 76 82               SHLD   SEED   ;   same every time
01F3   EB                     XCHG      
01F4   7C                     MOV   A,H   ; 0? never counts down: it waits
01F5   B5                     ORA   L   
01F6   CA DF 01               JZ   kt1   
01F9   2B                     DCX   H   
01FA   7C                     MOV   A,H   
01FB   B5                     ORA   L   
01FC   C2 DF 01               JNZ   kt1   ; A = 0 if the time ran out
01FF                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01FF                          ENDIF      
01FF   6F           KT3:      MOV   L,A   
0200   26 00                  MVI   H,0   
0202   F7                     RST   6   
0203                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
                              DAD   D   ;   only for 1 to 127, and leaves 127 - count
                              SBB   A   
                              ANA   L   ; (0 for a count that is too big)
                              XRI   127   ; A = the count, 127 at most
                              STA   LBHDR   
                              PUSH   B   
                              LXI   D,LBHDR   
                              MVI   C,10   
                              CALL   BDOS   
                              POP   B   
                              LXI   H,LBHDR+1   
                              MOV   A,M   ; the count typed (0-127)
                              INR   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   L   ;   adding the count to L can't carry
                              MOV   L,A   
                              MVI   M,13   
                              MVI   L,LINEBUF & 0FFh   
                              RST   6   
0203                          ENDIF      
0203                          IFN   CPM   
0203                             ; Generic: Backspace takes the last character back (and is echoed as
0203                             ; it is), CR ends (stored, not echoed), every other key is stored and
0203                             ; echoed until the line is full. The line buffer starts at offset 80h
0203                             ; of its page, so L alone is the place in the line: D holds the L of
0203                             ; a full line.
0203   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
0206   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
0207   9F                     SBB   A   
0208   A5                     ANA   L   ; (0 for a count that is too big)
0209   2F                     CMA      
020A   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
020B                             ;   at most
020B   21 80 82               LXI   H,LINEBUF   
020E   CD 3E 04     LN2:      CALL   getk   
0211   CA 0E 02               JZ   ln2   
0214   FE 0D                  CPI   13   
0216   CA 33 02               JZ   ln5   
0219   FE 08                  CPI   8   
021B   CA 2B 02               JZ   ln4   
021E   5F                     MOV   E,A   
021F   7D                     MOV   A,L   
0220   BA                     CMP   D   
0221   CA 0E 02               JZ   ln2   ; full
0224   73                     MOV   M,E   
0225   2C                     INR   L   
0226   7B                     MOV   A,E   
0227   EF           LN3:      RST   5   
0228   C3 0E 02               JMP   ln2   
022B   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
022C   FA 27 02               JM   ln3   ;   unless the line was empty (L left the
022F   2C                     INR   L   ;   upper half of the page)
0230   C3 0E 02               JMP   ln2   
0233   77           LN5:      MOV   M,A   ; the CR
0234   2E 80                  MVI   L,LINEBUF & 0FFh   
0236   F7                     RST   6   
0237                          ENDIF      
0237                             ; =============================================================================
0237                             ;  Dispatch table: the low byte of each handler's address, in code order.
0237                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0237                             ; =============================================================================
0237                             ; The handlers of the first NPG1 characters start in the image's second page.
0237                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0237                             ; differs between the builds, so the count is worked out here.
0237                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0237                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0237                PGBRK:    EQU   (h_break-BASE)/256   
0237                PGDEF:    EQU   (h_def-BASE)/256   
0237                PGFET:    EQU   (h_fetch-BASE)/256   
0237                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0237   AE           PTAB:     DB   h_store & 0FFh   ; !
0238   BC                     DB   h_str & 0FFh   ; "
0239   D0                     DB   h_num & 0FFh   ; #
023A   C7                     DB   h_print & 0FFh   ; $
023B   AC                     DB   h_swap & 0FFh   ; %
023C   41                     DB   h_and & 0FFh   ; &
023D   CD                     DB   h_emit & 0FFh   ; '
023E   1D                     DB   h_open & 0FFh   ; (
023F   29                     DB   h_close & 0FFh   ; )
0240   66                     DB   h_mul & 0FFh   ; *
0241   3E                     DB   h_add & 0FFh   ; +
0242   D6                     DB   h_cfetch & 0FFh   ; ,
0243   35                     DB   h_sub & 0FFh   ; -
0244   B6                     DB   h_cstore & 0FFh   ; .
0245   82                     DB   h_div & 0FFh   ; /
0246   AA                     DB   h_dup & 0FFh   ; :
0247   CF                     DB   h_drop & 0FFh   ; ;
0248   4A                     DB   h_lt & 0FFh   ; <
0249   59                     DB   h_eq & 0FFh   ; =
024A   49                     DB   h_gt & 0FFh   ; >
024B   DA                     DB   h_key & 0FFh   ; ?
024C   18                     DB   h_fetch & 0FFh   ; @
024D   F1                     DB   h_def & 0FFh   ; [
024E   E2                     DB   h_break & 0FFh   ; \
024F   DD                     DB   h_ret & 0FFh   ; ]
0250   82                     DB   h_xor & 0FFh   ; ^
0251   95                     DB   h_alloc & 0FFh   ; _
0252   C6                     DB   h_grave & 0FFh   ; `
0253   14                     DB   h_tor & 0FFh   ; {
0254   8A                     DB   h_or & 0FFh   ; |
0255   1D                     DB   h_fromr & 0FFh   ; }
0256   92                     DB   h_not & 0FFh   ; ~
0257                PTABEND:      
0257                             ; =============================================================================
0257                             ;  Routines (no handler starts past this point)
0257                             ; =============================================================================
0257                             ; Digits: step back onto the first digit and read the whole number.
0257   E5           DIGIT:    PUSH   H   
0258   0B                     DCX   B   
0259   CD 63 02               CALL   rdnum   
025C   F7                     RST   6   
025D                             ; negnum: "-" directly before a digit: read the number, negate it.
025D   E5           NEGNUM:   PUSH   H   
025E   CD 63 02               CALL   rdnum   
0261   E7                     RST   4   
0262   F7                     RST   6   
0263                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0263                             ; non-digit. Values wrap at 16 bits, as the spec says.
0263   21 00 00     RDNUM:    LXI   H,0   
0266   0A           RDN1:     LDAX   B   
0267   D6 30                  SUI   "0"   
0269   FE 0A                  CPI   10   
026B   D0                     RNC      
026C   03                     INX   B   
026D   54                     MOV   D,H   
026E   5D                     MOV   E,L   
026F   29                     DAD   H   
0270   29                     DAD   H   
0271   19                     DAD   D   
0272   29                     DAD   H   ; HL * 10
0273   5F                     MOV   E,A   
0274   16 00                  MVI   D,0   
0276   19                     DAD   D   
0277   C3 66 02               JMP   rdn1   
027A                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
027A                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
027A                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
027A                             ; lives on the stack, since A is busy with the shifts.
027A                             ; Dividing by 2 is one shift (the spec wants that fast).
027A   01 00 00     UDIV:     LXI   B,0   
027D   7B                     MOV   A,E   
027E   EE 02                  XRI   2   
0280   B2                     ORA   D   
0281   C2 8E 02               JNZ   udv0   
0284   B4                     ORA   H   ; A was 0, and the carry is clear
0285   1F                     RAR      
0286   67                     MOV   H,A   
0287   7D                     MOV   A,L   
0288   1F                     RAR      
0289   6F                     MOV   L,A   ; the quotient
028A   78                     MOV   A,B   
028B   17                     RAL      
028C   4F                     MOV   C,A   ; the remainder: the bit that fell out
028D   C9                     RET      
028E   3E 10        UDV0:     MVI   A,16   
0290   F5                     PUSH   PSW   
0291   29           UDV1:     DAD   H   ; next dividend bit into the carry
0292   79                     MOV   A,C   
0293   17                     RAL      
0294   4F                     MOV   C,A   
0295   78                     MOV   A,B   
0296   17                     RAL      
0297   47                     MOV   B,A   ; BC = BC*2 + bit
0298   79                     MOV   A,C   
0299   93                     SUB   E   
029A   78                     MOV   A,B   
029B   9A                     SBB   D   ; carry if BC < DE
029C   DA A4 02               JC   udv2   
029F   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
02A0   79                     MOV   A,C   
02A1   93                     SUB   E   
02A2   4F                     MOV   C,A   
02A3   2C                     INR   L   ; quotient bit
02A4   F1           UDV2:     POP   PSW   
02A5   3D                     DCR   A   
02A6   F5                     PUSH   PSW   
02A7   C2 91 02               JNZ   udv1   
02AA   F1                     POP   PSW   
02AB   C9                     RET      
02AC                             ; =============================================================================
02AC                             ;  The grave's codes (h_grave is the dispatcher). Each starts with HL = TOS,
02AC                             ;  A = the character and the carry clear.
02AC                             ; 
02AC                             ;    `!  ( addr -- )        call the machine code at addr (exec)
02AC                             ;    `$  ( addr -- addr' )  the hex loader
02AC                             ;    `'  ( -- )             new line: CR LF
02AC                             ;    `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
02AC                             ;    `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
02AC                             ;    `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
02AC                             ;    `.  ( -- addr )        the address of the random seed
02AC                             ;    `<  ( a b -- n )       the smaller of the two (signed)
02AC                             ;    `>  ( a b -- n )       the larger
02AC                             ;    `?  ( flag -- )        the cursor off (0) or on
02AC                             ;    `@  ( row col -- )     the cursor to that row and column, both from 0
02AC                             ;    `^  ( -- )             clear the screen and home the cursor
02AC                             ;    `_  ( -- )             clear from the cursor to the end of the line
02AC                             ; =============================================================================
02AC                             ; The table: a character, then its handler's distance from that second byte.
02AC   21           GTAB:     DB   "!"   
02AD   1A                     DB   g_exec-$   
02AE   24                     DB   "$"   
02AF   1B                     DB   g_hex-$   
02B0   27                     DB   27h   
02B1   33                     DB   g_nl-$   
02B2   2B                     DB   "+"   
02B3   38                     DB   g_inc-$   
02B4   2C                     DB   ","   
02B5   50                     DB   g_rnd-$   
02B6   2D                     DB   "-"   
02B7   34                     DB   g_inc-$   
02B8   2E                     DB   "."   
02B9   47                     DB   g_seed-$   
02BA   3C                     DB   "<"   
02BB   6B                     DB   g_min-$   
02BC   3E                     DB   ">"   
02BD   69                     DB   g_min-$   
02BE   3F                     DB   "?"   
02BF   8E                     DB   g_cur-$   
02C0   40                     DB   "@"   
02C1   A3                     DB   g_at-$   
02C2   5E                     DB   "^"   
02C3   78                     DB   g_cls-$   
02C4   5F                     DB   "_"   
02C5   7F                     DB   g_eol-$   
02C6                          IF   CHECKED   
02C6   FF                     DB   0FFh   ; the end
02C7                          ENDIF      
02C7   C3 2B 00     G_EXEC:   JMP   exec   ; (exec is up among the RST routines)
02CA                             ; `$: pairs of hex digits are stored from addr until a non-hex character;
02CA                             ; then a RET (C9h) is written and its address is left. An odd last digit is
02CA                             ; consumed and dropped.
02CA   CD F9 03     G_HEX:    CALL   hexc   
02CD   D2 E1 02               JNC   hx2   
02D0   87                     ADD   A   
02D1   87                     ADD   A   
02D2   87                     ADD   A   
02D3   87                     ADD   A   
02D4   57                     MOV   D,A   ; the high digit
02D5   CD F9 03               CALL   hexc   
02D8   D2 E1 02               JNC   hx2   ; odd digit: consumed and dropped
02DB   B2                     ORA   D   
02DC   77                     MOV   M,A   
02DD   23                     INX   H   
02DE   C3 CA 02               JMP   g_hex   
02E1   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
02E3   F7                     RST   6   
02E4   3E 0D        G_NL:     MVI   A,13   
02E6   EF                     RST   5   
02E7   3E 0A                  MVI   A,10   
02E9   EF                     RST   5   
02EA   F7                     RST   6   
02EB                             ; `+ and `-: one routine. The character says which.
02EB                G_INC:       
02EB                          IF   CHECKED   
02EB   57                     MOV   D,A   ; the address is tested first, as "!" does
02EC   CD 65 04               CALL   chkst   ;   (the test uses A, and under CP/M E)
02EF   7A                     MOV   A,D   
02F0                          ENDIF      
