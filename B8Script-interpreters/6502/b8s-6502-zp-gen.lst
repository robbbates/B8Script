E305   16 00        UD1:      ASL   0,X   
E307   36 01                  ROL   1,X   
E309   36 FE                  ROL   0FEh,X   
E30B   36 FF                  ROL   0FFh,X   
E30D   38                     SEC      
E30E   B5 FE                  LDA   0FEh,X   
E310   E5 08                  SBC   D0   
E312   85 04                  STA   T0   
E314   B5 FF                  LDA   0FFh,X   
E316   E5 09                  SBC   D1   
E318   90 08                  BCC   ud2   
E31A   95 FF                  STA   0FFh,X   
E31C   A5 04                  LDA   T0   
E31E   95 FE                  STA   0FEh,X   
E320   F6 00                  INC   0,X   
E322   88           UD2:      DEY      
E323   D0 E0                  BNE   ud1   
E325   60                     RTS      
E326                          IF   CHECKED   
                                 ; The checked build's inner loop, out of page 1, where it would not fit,
                                 ; and its break check (described with the unchecked one in page 1).
                                 ; pnext: the break check, then (falling through) next. A word call, a true
                                 ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
                                 ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
                                 ; falls in here too, which does no harm.)
                    PNEXT:    DEC   CDOWN   
                              BNE   next   
                              JSR   KEY   
                              BEQ   next   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JSR   chk3   ; (Ctrl-C: back only if the break key is off)
                    NEXT:        
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE (an
                                 ; underflow) or below DSFULL (an overflow). No handler moves X by
                                 ; more than 4, so X is caught before it wraps; an overrun by a cell
                                 ; or two writes on the scratch bytes below or above the stack.
                                 ; S is kept in RSV, for the report's Rtn line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_sund   
                              CPX   #DSFULL   
                              BCC   e_sovr   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
                              JSR   step   
                              JMP   next   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: Rtn 0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_SUND:   LDX   #DSE   ; Stk 0
                              LDA   #"s"   
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_SOVR:   LDA   #"S"   
                    EJMP:     JMP   error   
                                 ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
                                 ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
                                 ; which takes either. Meeting the wrong closer at this level, or the end
                                 ; (a NUL, or a string that runs into it), stops with N, except for \,
                                 ; which then ends the program as before.
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                              JMP   error   ;   or the end: the place is the opener
E326                          ENDIF      
E326                          IF   1-CHECKED   
E326                CBREAK:   EQU   endp   ; the unchecked build stops without a word
E326                          ENDIF      
E326                          IF   CHECKED   
                    CBREAK:   EQU   e_break   ; the checked build reports B
E326                          ENDIF      
E326                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E326                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E326                             ; taken out of KEYBUF.
E326   AD 7A 04     GETK:     LDA   KEYBUF   
E329   F0 08                  BEQ   gk1   
E32B   48                     PHA      
E32C   A9 00                  LDA   #0   
E32E   8D 7A 04               STA   KEYBUF   
E331   68                     PLA      
E332   60                     RTS      
E333   20 06 FF     GK1:      JSR   KEY   
E336   F0 04                  BEQ   gk9   
E338                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E338                             ; back if it comes back at all.
E338   C9 03        CHK3:     CMP   #3   
E33A   F0 01                  BEQ   ctlc   
E33C   60           GK9:      RTS      
E33D                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E33D                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E33D                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E33D                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E33D                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y. (Not D0/D1:
E33D                             ; they hold the place in the checked build.)
E33D   AD 7B 04     CTLC:     LDA   BRKOFF   
E340   F0 5D                  BEQ   cbreak   
E342   A9 28                  LDA   #CWAIT+1   
E344   85 05                  STA   T1   
E346   20 06 FF     CT2:      JSR   KEY   
E349   D0 0A                  BNE   ct3   
E34B   C6 06                  DEC   T2   
E34D   D0 F7                  BNE   ct2   
E34F   C6 05                  DEC   T1   
E351   D0 F3                  BNE   ct2   
E353   F0 07                  BEQ   ct9   ; always: none came
E355   C9 03        CT3:      CMP   #3   
E357   F0 46                  BEQ   cbreak   
E359   8D 7A 04               STA   KEYBUF   
E35C   A9 03        CT9:      LDA   #3   
E35E   60                     RTS      
E35F                          IF   CHECKED   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP2:    JMP   error   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; Rtn does not count the call
                              LDA   #"U"   
                              BNE   ejmp2   ; always
E35F                          ENDIF      
E35F                             ; step: read one character and sort it by range.
E35F                             ;    00h          end of program
E35F                             ;    01h-20h, 7Fh-FFh   ignored
E35F                             ;    30h-39h      digit: read a whole number
E35F                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E35F                             ;    61h-7Ah      a-z: push the address of that letter's cell
E35F                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E35F   20 2D E4     STEP:     JSR   getc   ; flags follow A
E362   F0 3B                  BEQ   endp   
E364   38                     SEC      
E365   E9 21                  SBC   #21h   ; A = c - 21h
E367   90 35                  BCC   ign   ; 01h-20h
E369   C9 0F                  CMP   #0Fh   
E36B   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E36D   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E36F   C9 0A                  CMP   #10   
E371   90 6C                  BCC   digit   
E373   C9 11                  CMP   #11h   
E375   90 16                  BCC   p3a   ; 3Ah-40h
E377   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E379   C9 1A                  CMP   #1Ah   
E37B   90 25                  BCC   upper   ; 41h-5Ah
E37D   C9 20                  CMP   #20h   
E37F   90 0A                  BCC   p5b   ; 5Bh-60h
E381   C9 3A                  CMP   #3Ah   
E383   90 29                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E385   C9 3E                  CMP   #3Eh   
E387                          IF   1-CHECKED   
E387   B0 15                  BCS   ign   ; 7Fh-FFh
E389                          ENDIF      
E389                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E389                          ENDIF      
E389                             ; The three adjustments below chain. Each ADC adds the carry the one
E389                             ; before it left, which the constants allow for.
E389   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E38B   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E38D   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E38F                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E38F                             ; the index is N1 or more, plus one more if it is N2 or more.
E38F   C9 08        PUNCT:    CMP   #N1   
E391   A8                     TAY      
E392   A9 70                  LDA   #HALFPG   
E394   2A                     ROL      ; the first page, or the second (carry clear)
E395   C0 15                  CPY   #N2   
E397   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E399   48                     PHA      
E39A   B9 BF E3               LDA   PTAB,Y   
E39D   48                     PHA      
E39E   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E39F                             ; directly, it just ends an ignored character.
E39F                ENDP:        ; the program has ended
E39F                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E39F                          ENDIF      
E39F   4C 09 FF               JMP   EXIT   
E3A2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E3A2                             ; the return stack, and the IP becomes the address in the letter's cell.
E3A2   0A           UPPER:    ASL      
E3A3   A8                     TAY      
E3A4   38                     SEC      
E3A5   4C C1 E0               JMP   pushn   
E3A8   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E3AA   A4 01                  LDY   IP+1   
E3AC   D0 03                  BNE   pushay   ; always: no program is in page zero
E3AE                             ; a-z: push the cell's address (the cell is the variable)
E3AE   0A           LOWER:    ASL      
E3AF   A0 04                  LDY   #>LET   
E3B1                             ; pushay: push a cell: A = its low byte, Y = its high byte
E3B1   CA           PUSHAY:   DEX      
E3B2   CA                     DEX      
E3B3   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E3B5   94 01                  STY   1,X   
E3B7   60                     RTS      
E3B8                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E3B8   E8           FLAG:     INX      
E3B9   E8                     INX      
E3BA   B5 FE                  LDA   0FEh,X   
E3BC   15 FF                  ORA   0FFh,X   
E3BE   60                     RTS      
E3BF                             ; =============================================================================
E3BF                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E3BF                             ;  character, in code order.
E3BF                             ; =============================================================================
E3BF   93           PTAB:     DB   (h_store-1) & 0FFh   ; !
E3C0   4B                     DB   (h_str-1) & 0FFh   ; "
E3C1   67                     DB   (h_num-1) & 0FFh   ; #
E3C2   35                     DB   (h_print-1) & 0FFh   ; $
E3C3   9F                     DB   (h_swap-1) & 0FFh   ; %
E3C4   B0                     DB   (h_and-1) & 0FFh   ; &
E3C5   5F                     DB   (h_emit-1) & 0FFh   ; '
E3C6   BB                     DB   (h_open-1) & 0FFh   ; (
E3C7   B6                     DB   (h_close-1) & 0FFh   ; )
E3C8   64                     DB   (h_mul-1) & 0FFh   ; *
E3C9   2E                     DB   (h_add-1) & 0FFh   ; +
E3CA   AD                     DB   (h_cfetch-1) & 0FFh   ; ,
E3CB   25                     DB   (h_sub-1) & 0FFh   ; -
E3CC   1C                     DB   (h_cstore-1) & 0FFh   ; .
E3CD   8A                     DB   (h_div-1) & 0FFh   ; /
E3CE   15                     DB   (h_dup-1) & 0FFh   ; :
E3CF   22                     DB   (drop-1) & 0FFh   ; ;
E3D0   43                     DB   (h_lt-1) & 0FFh   ; <
E3D1   54                     DB   (h_eq-1) & 0FFh   ; =
E3D2   40                     DB   (h_gt-1) & 0FFh   ; >
E3D3   BD                     DB   (h_key-1) & 0FFh   ; ?
E3D4   70                     DB   (h_fetch-1) & 0FFh   ; @
E3D5   86                     DB   (h_def-1) & 0FFh   ; [
E3D6   1A                     DB   (h_break-1) & 0FFh   ; \
E3D7   2C                     DB   (h_ret-1) & 0FFh   ; ]
E3D8   5A                     DB   (h_xor-1) & 0FFh   ; ^
E3D9   D6                     DB   (h_alloc-1) & 0FFh   ; _
E3DA   A8                     DB   (h_grave-1) & 0FFh   ; `
E3DB   3E                     DB   (h_tor-1) & 0FFh   ; {
E3DC   65                     DB   (h_or-1) & 0FFh   ; |
E3DD   4A                     DB   (h_fromr-1) & 0FFh   ; }
E3DE   57                     DB   (h_not-1) & 0FFh   ; ~
E3DF                             ; Digits: the first one is in A; read the rest of the number.
E3DF   A0 00        DIGIT:    LDY   #0   
E3E1   20 B1 E3               JSR   pushay   
E3E4                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E3E4                             ; Returns with the carry set.
E3E4   20 13 E4     RDNUM:    JSR   isdig   
E3E7   B0 4F                  BCS   ic9   ; (an RTS)
E3E9   20 30 E4               JSR   incip   ; (keeps A = the digit)
E3EC   16 00                  ASL   0,X   
E3EE   36 01                  ROL   1,X   ; x2
E3F0   18                     CLC      
E3F1   75 00                  ADC   0,X   
E3F3   85 04                  STA   T0   
E3F5   B5 01                  LDA   1,X   
E3F7   69 00                  ADC   #0   
E3F9   85 05                  STA   T1   ; T = x2 + digit
E3FB   16 00                  ASL   0,X   
E3FD   36 01                  ROL   1,X   
E3FF   16 00                  ASL   0,X   
E401   36 01                  ROL   1,X   ; x8
E403   18                     CLC      
E404   B5 00                  LDA   0,X   
E406   65 04                  ADC   T0   
E408   95 00                  STA   0,X   
E40A   B5 01                  LDA   1,X   
E40C   65 05                  ADC   T1   
E40E   95 01                  STA   1,X   ; x8 + x2 + digit
E410   4C E4 E3               JMP   rdnum   
E413                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E413                             ; digit. Y = 0.
E413   20 39 E4     ISDIG:    JSR   peek   
E416   38                     SEC      
E417   E9 30                  SBC   #"0"   
E419   C9 0A                  CMP   #10   
E41B   60                     RTS      
E41C                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E41C                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E41C   20 13 E4     RDHEX:    JSR   isdig   
E41F   90 0F                  BCC   incip   
E421   29 DF                  AND   #0DFh   
E423   E9 11                  SBC   #11h   ; (the carry is set)
E425   C9 06                  CMP   #6   
E427   B0 0F                  BCS   ic9   
E429   69 0A                  ADC   #10   
E42B   D0 03                  BNE   incip   ; always
E42D                             ; Reading the program
E42D                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E42D                             ;    getc: the same, then IP moves on; flags follow A
E42D                             ;    incip: IP moves on; keeps A, the carry and Y
E42D   20 39 E4     GETC:     JSR   peek   
E430   E6 00        INCIP:    INC   IP   
E432   D0 02                  BNE   ic1   
E434   E6 01                  INC   IP+1   
E436   09 00        IC1:      ORA   #0   
E438   60           IC9:      RTS      
E439   A0 00        PEEK:     LDY   #0   
E43B   B1 00                  LDA   (IP),Y   
E43D   60                     RTS      
E43E                             ; rstip: point IP at the start of the program
E43E   A9 00        RSTIP:    LDA   #<PROG   
E440   85 00                  STA   IP   
E442   A9 05                  LDA   #>PROG   
E444   85 01                  STA   IP+1   
E446   60                     RTS      
E447                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
                                 ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   Rtn n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was. With the stack full
                                 ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
                    ERROR:    PHA      ; the letter
                              LDA   PLACE   
                              STA   P   
                              LDA   PLACE+1   
                              STA   P+1   ; (the numbers need D0/D1)
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   LN   
                              LDY   LN+1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   T1   
                              LDY   T2   
                              JSR   prnum   ; the column
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              LDY   #0   ; the text at the place
                    ER1:      LDA   (P),Y   
                              BEQ   er2   
                              CMP   #13   
                              BEQ   er2   
                              CMP   #10   
                              BEQ   er2   
                              JSR   CONOUT   
                              INY      
                              CPY   #16   
                              BNE   er1   
                    ER2:      LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "Stk "
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   
                              LSR      ; the depth, (DSE - X) / 2
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T1   ; T1 = how many cells to show
                              JSR   prs   
                    ER4:      LDA   T1   ; cells T1-1 down to 0, the top last: cell i
                              BEQ   er5   ;   from the top is at X+2i
                              DEC   T1   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   T1   
                              ASL      
                              STA   T2   
                              TXA      
                              ADC   T2   ; (the carry is clear)
                              TAY      
                              LDA   0,Y   
                              PHA      
                              LDA   1,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "Rtn "
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"Stk"," "+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"Rtn"," "+80h   
                                 ; lcol: the line (LN) and the column (T1/T2) of the place at P, both from
                                 ; 1. A place below the program is in the -n? line buffer: line 0, and the
                                 ; column is the place in the buffer. Otherwise IP (free now: the program has
                                 ; stopped) runs from PROG to the place, counting LFs; T1/T2 keeps where the
                                 ; last line started, and the column is the place minus that, plus 1.
                    LCOL:     LDA   #0   
                              STA   LN+1   
                              STA   LN   
                              LDA   #<LINEBUF   
                              STA   T1   
                              LDA   #>LINEBUF   
                              STA   T2   
                              LDA   P   
                              CMP   #<PROG   
                              LDA   P+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   LN   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   T1   
                              LDA   IP+1   
                              STA   T2   
                    LC1:      LDA   IP   
                              CMP   P   
                              LDA   IP+1   
                              SBC   P+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              INC   LN   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   LN+1   
                              BNE   lc3   ; always
                    LC9:      LDA   P   
                              SEC      
                              SBC   T1   
                              STA   T1   
                              LDA   P+1   
                              SBC   T2   
                              STA   T2   
                              INC   T1   ; + 1
                              BNE   lc8   
                              INC   T2   
                    LC8:      RTS      
E447                          ENDIF      


