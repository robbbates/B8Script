E37E   F0 08                  BEQ   pcls   ; {
E380   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E381   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E383   B0 26                  BCS   pat   ; ~
E385   4C 0F FF               JMP   CONEOL   ; }
E388   4C 0C FF     PCLS:     JMP   CONCLS   
E38B   C9 E6        PE1:      CMP   #0E6h   
E38D   B0 03                  BCS   pvar   
E38F   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E392                          ENDIF      
E392                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG (see prs).
                    PESC:     LDY   #M_CLS-MSG   
                              SBC   #7Ah   ; (the carry is clear: - 7Bh)
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l
                              BNE   prs   ; always
E392                          ENDIF      
E392                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E392                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' prints
E392                             ; it and drops it: TOS is the string's address again.
E392   69 39        PVAR:     ADC   #39h   
E394   20 F5 E4               JSR   lower   
E397   20 81 E2               JSR   h_fetch   
E39A   4C 8C E0               JMP   h_num   
E39D                          IF   CHECKED+ANSI   
E39D                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E39D                             ; past it, at the next message.
E39D   B9 33 E6     PRS:      LDA   MSG,Y   
E3A0   48                     PHA      
E3A1   29 7F                  AND   #7Fh   
E3A3   20 03 FF               JSR   CONOUT   
E3A6   C8                     INY      
E3A7   68                     PLA      
E3A8   10 F3                  BPL   prs   
E3AA   60                     RTS      
E3AB                          ENDIF      
E3AB                             ; /~: the row is at 4,X, the column at 2,X, the string's address at 0,X.
E3AB                PAT:         
E3AB                          IF   CHECKED   
E3AB   E0 EB                  CPX   #DSE-5   ; fewer than two cells under TOS: s
E3AD   B0 52                  BCS   e_sund   
E3AF                          ENDIF      
E3AF                          IF   1-ANSI   
E3AF   B5 04                  LDA   4,X   ; the row
E3B1   B4 02                  LDY   2,X   ; the column
E3B3   20 15 FF               JSR   CONAT   
E3B6   20 B9 E3               JSR   nip   ; two nips leave the address, 4 bytes up
E3B9   20 C7 E0     NIP:      JSR   h_swap   ; nip: ( a b -- b )
E3BC   4C 26 E1               JMP   drop   
E3BF                          ENDIF      
E3BF                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). Three swaps put the row on top
                                 ; and the address under the column: "#" prints the row and drops it, prints
                                 ; the column and drops it, and TOS is the string's address again.
                              JSR   h_swap   
                              INX      
                              INX      
                              JSR   h_swap   
                              DEX      
                              DEX      
                              JSR   h_swap   
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E3BF                          ENDIF      
E3BF                          IF   CHECKED   
E3BF                             ; The checked build's inner loop, out of page 1, where it would not fit,
E3BF                             ; and its break check (described with the unchecked one in page 1).
E3BF                             ; pnext: the break check, then (falling through) next. A word call, a true
E3BF                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E3BF                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E3BF                             ; falls in here too, which does no harm.)
E3BF   CE 79 04     PNEXT:    DEC   CDOWN   
E3C2   D0 0B                  BNE   next   
E3C4   20 06 FF               JSR   KEY   
E3C7   F0 06                  BEQ   next   ; no key
E3C9   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E3CC   20 5A E4               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E3CF                NEXT:        
E3CF                             ; Both stacks are checked once per character, after it has run. The
E3CF                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E3CF                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E3CF                             ; more than one entry). The data stack has when X is above DSE (an
E3CF                             ; underflow) or below DSFULL (an overflow). No handler moves X by
E3CF                             ; more than 4 (but "$", whose /~ escapes each look first), so X is
E3CF                             ; caught before it wraps; an overrun by a cell or two writes on the
E3CF                             ; scratch bytes below or above the stack.
E3CF                             ; S is kept in RSV, for the report's Rtn line (an error found inside
E3CF                             ; a handler has its own calls on the hardware stack), and the place
E3CF                             ; of the character about to run in PLACE.
E3CF   8A                     TXA      ; TSX trashes X: keep it in A
E3D0   BA                     TSX      
E3D1   8E 35 04               STX   RSV   
E3D4   E0 20                  CPX   #RSLIM   
E3D6   AA                     TAX      ; TAX leaves the carry alone
E3D7   90 16                  BCC   e_rstack   
E3D9   E0 F1                  CPX   #DSE+1   
E3DB   B0 24                  BCS   e_sund   
E3DD   E0 10                  CPX   #DSFULL   
E3DF   90 25                  BCC   e_sovr   
E3E1   A5 00                  LDA   IP   
E3E3   85 08                  STA   PLACE   
E3E5   A5 01                  LDA   IP+1   
E3E7   85 09                  STA   PLACE+1   
E3E9   20 A0 E4               JSR   step   
E3EC   4C CF E3               JMP   next   
E3EF                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E3EF                             ; empty.
E3EF   AD 35 04     E_RSTACK:   LDA   RSV   
E3F2   C9 10                  CMP   #10h   
E3F4   A9 52                  LDA   #"R"   
E3F6   B0 10                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E3F8   A9 FF                  LDA   #0FFh   
E3FA   8D 35 04               STA   RSV   ; S wrapped to 01h: Rtn 0
E3FD   A9 72                  LDA   #"r"   
E3FF   D0 07                  BNE   ejmp   ; always
E401   A2 F0        E_SUND:   LDX   #DSE   ; Stk 0
E403   A9 73                  LDA   #"s"   
E405   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E406   A9 53        E_SOVR:   LDA   #"S"   
E408   4C 8C E5     EJMP:     JMP   error   
E40B                             ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
E40B                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E40B                             ; which takes either. Meeting the wrong closer at this level, or the end
E40B                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E40B                             ; which then ends the program as before.
E40B   85 04        SKIP:     STA   T0   
E40D   A9 00                  LDA   #0   
E40F   85 06                  STA   T2   ; depth
E411   20 72 E5     SK1:      JSR   getc   
E414   F0 26                  BEQ   sknul   
E416   C9 22                  CMP   #22h   
E418   D0 05                  BNE   sk2   
E41A   20 6F E0               JSR   skipstr   ; leaves A = 11h, which matches nothing below
E41D   F0 1D                  BEQ   sknul   ; the string ran into the end
E41F   C9 28        SK2:      CMP   #"("   
E421   F0 15                  BEQ   sk3   
E423   C9 5B                  CMP   #"["   
E425   F0 11                  BEQ   sk3   
E427   C9 29                  CMP   #")"   
E429   F0 04                  BEQ   sk4   
E42B   C9 5D                  CMP   #"]"   
E42D   D0 E2                  BNE   sk1   
E42F   C6 06        SK4:      DEC   T2   
E431   10 DE                  BPL   sk1   
E433   C5 04                  CMP   T0   
E435   F0 0C                  BEQ   e_nest   ; the wrong kind
E437   60                     RTS      ; the closer at this level
E438   E6 06        SK3:      INC   T2   
E43A   D0 D5                  BNE   sk1   
E43C   A5 04        SKNUL:    LDA   T0   
E43E   D0 03                  BNE   e_nest   ; ( and [ stop with N
E440   4C 09 FF               JMP   EXIT   ; \ ends the program
E443   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E445   4C 8C E5               JMP   error   ;   or the end: the place is the opener
E448                          ENDIF      
E448                          IF   1-CHECKED   
                    CBREAK:   EQU   endp   ; the unchecked build stops without a word
E448                          ENDIF      
E448                          IF   CHECKED   
E448                CBREAK:   EQU   e_break   ; the checked build reports B
E448                          ENDIF      
E448                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E448                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E448                             ; taken out of KEYBUF.
E448   AD 7A 04     GETK:     LDA   KEYBUF   
E44B   F0 08                  BEQ   gk1   
E44D   48                     PHA      
E44E   A9 00                  LDA   #0   
E450   8D 7A 04               STA   KEYBUF   
E453   68                     PLA      
E454   60                     RTS      
E455   20 06 FF     GK1:      JSR   KEY   
E458   F0 04                  BEQ   gk9   
E45A                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E45A                             ; back if it comes back at all.
E45A   C9 03        CHK3:     CMP   #3   
E45C   F0 01                  BEQ   ctlc   
E45E   60           GK9:      RTS      
E45F                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E45F                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E45F                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E45F                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E45F                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E45F   AD 7B 04     CTLC:     LDA   BRKOFF   
E462   F0 1D                  BEQ   cbreak   
E464   A9 28                  LDA   #CWAIT+1   
E466   85 05                  STA   T1   
E468   20 06 FF     CT2:      JSR   KEY   
E46B   D0 0A                  BNE   ct3   
E46D   C6 06                  DEC   T2   
E46F   D0 F7                  BNE   ct2   
E471   C6 05                  DEC   T1   
E473   D0 F3                  BNE   ct2   
E475   F0 07                  BEQ   ct9   ; always: none came
E477   C9 03        CT3:      CMP   #3   
E479   F0 06                  BEQ   cbreak   
E47B   8D 7A 04               STA   KEYBUF   
E47E   A9 03        CT9:      LDA   #3   
E480   60                     RTS      
E481                          IF   CHECKED   
E481   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E483   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E484   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E486   4C 8C E5     EJMP2:    JMP   error   
E489                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E489                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E489                             ; the call reads a NUL with IP in page zero, where no program can be. The
E489                             ; call is undone first: the step frame and the return address come off the
E489                             ; hardware stack, and the place is the call letter (the return address - 1).
E489   68           E_UNDEF:   PLA      
E48A   68                     PLA      ; the step frame
E48B   68                     PLA      
E48C   38                     SEC      
E48D   E9 01                  SBC   #1   
E48F   85 08                  STA   PLACE   
E491   68                     PLA      
E492   E9 00                  SBC   #0   
E494   85 09                  STA   PLACE+1   
E496   EE 35 04               INC   RSV   
E499   EE 35 04               INC   RSV   ; Rtn does not count the call
E49C   A9 55                  LDA   #"U"   
E49E   D0 E6                  BNE   ejmp2   ; always
E4A0                          ENDIF      
E4A0                             ; step: read one character and sort it by range.
E4A0                             ;    00h          end of program
E4A0                             ;    01h-20h, 7Fh-FFh   ignored
E4A0                             ;    30h-39h      digit: read a whole number
E4A0                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E4A0                             ;    61h-7Ah      a-z: push the address of that letter's cell
E4A0                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E4A0   20 72 E5     STEP:     JSR   getc   ; flags follow A
E4A3   F0 3D                  BEQ   endp   
E4A5   38                     SEC      
E4A6   E9 21                  SBC   #21h   ; A = c - 21h
E4A8   90 37                  BCC   ign   ; 01h-20h
E4AA   C9 0F                  CMP   #0Fh   
E4AC   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E4AE   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E4B0   C9 0A                  CMP   #10   
E4B2   90 72                  BCC   digit   
E4B4   C9 11                  CMP   #11h   
E4B6   90 18                  BCC   p3a   ; 3Ah-40h
E4B8   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E4BA   C9 1A                  CMP   #1Ah   
E4BC   90 2B                  BCC   upper   ; 41h-5Ah
E4BE   C9 20                  CMP   #20h   
E4C0   90 0C                  BCC   p5b   ; 5Bh-60h
E4C2   C9 3A                  CMP   #3Ah   
E4C4   90 2F                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E4C6   C9 3E                  CMP   #3Eh   
E4C8                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E4C8                          ENDIF      
E4C8                          IF   CHECKED   
E4C8   F0 17                  BEQ   ign   ; 7Fh
E4CA   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
E4CC                          ENDIF      
E4CC                             ; The three adjustments below chain. Each ADC adds the carry the one
E4CC                             ; before it left, which the constants allow for.
E4CC   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E4CE   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E4D0   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E4D2                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E4D2                             ; the index is N1 or more, plus one more if it is N2 or more.
E4D2   C9 08        PUNCT:    CMP   #N1   
E4D4   A8                     TAY      
E4D5   A9 70                  LDA   #HALFPG   
E4D7   2A                     ROL      ; the first page, or the second (carry clear)
E4D8   C0 15                  CPY   #N2   
E4DA   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E4DC   48                     PHA      
E4DD   B9 06 E5               LDA   PTAB,Y   
E4E0   48                     PHA      
E4E1   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E4E2                             ; directly, it just ends an ignored character.
E4E2                ENDP:        ; the program has ended
E4E2                          IF   CHECKED   
E4E2   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E4E4   F0 A3                  BEQ   e_undef   
E4E6                          ENDIF      
E4E6   4C 09 FF               JMP   EXIT   
E4E9                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E4E9                             ; the return stack, and the IP becomes the address in the letter's cell.
E4E9   0A           UPPER:    ASL      
E4EA   A8                     TAY      
E4EB   38                     SEC      
E4EC   4C E8 E0               JMP   pushn   
E4EF   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E4F1   A4 01                  LDY   IP+1   
E4F3   D0 03                  BNE   pushay   ; always: no program is in page zero
E4F5                             ; a-z: push the cell's address (the cell is the variable)
E4F5   0A           LOWER:    ASL      
E4F6   A0 04                  LDY   #>LET   
E4F8                             ; pushay: push a cell: A = its low byte, Y = its high byte
E4F8   CA           PUSHAY:   DEX      
E4F9   CA                     DEX      
E4FA   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E4FC   94 01                  STY   1,X   
E4FE   60                     RTS      
E4FF                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E4FF   E8           FLAG:     INX      
E500   E8                     INX      
E501   B5 FE                  LDA   0FEh,X   
E503   15 FF                  ORA   0FFh,X   
E505   60                     RTS      
E506                             ; =============================================================================
E506                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E506                             ;  character, in code order.
E506                             ; =============================================================================
E506   B7           PTAB:     DB   (h_store-1) & 0FFh   ; !
E507   65                     DB   (h_str-1) & 0FFh   ; "
E508   8B                     DB   (h_num-1) & 0FFh   ; #
E509   39                     DB   (h_print-1) & 0FFh   ; $
E50A   C6                     DB   (h_swap-1) & 0FFh   ; %
E50B   D7                     DB   (h_and-1) & 0FFh   ; &
E50C   83                     DB   (h_emit-1) & 0FFh   ; '
E50D   E2                     DB   (h_open-1) & 0FFh   ; (
E50E   C4                     DB   (h_close-1) & 0FFh   ; )
E50F   67                     DB   (h_mul-1) & 0FFh   ; *
E510   31                     DB   (h_add-1) & 0FFh   ; +
E511   BB                     DB   (h_cfetch-1) & 0FFh   ; ,
E512   28                     DB   (h_sub-1) & 0FFh   ; -
E513   1C                     DB   (h_cstore-1) & 0FFh   ; .
E514   92                     DB   (h_div-1) & 0FFh   ; /
E515   15                     DB   (h_dup-1) & 0FFh   ; :
E516   25                     DB   (drop-1) & 0FFh   ; ;
E517   46                     DB   (h_lt-1) & 0FFh   ; <
E518   57                     DB   (h_eq-1) & 0FFh   ; =
E519   43                     DB   (h_gt-1) & 0FFh   ; >
E51A   CB                     DB   (h_key-1) & 0FFh   ; ?
E51B   80                     DB   (h_fetch-1) & 0FFh   ; @
E51C   A5                     DB   (h_def-1) & 0FFh   ; [
E51D   28                     DB   (h_break-1) & 0FFh   ; \
E51E   3C                     DB   (h_ret-1) & 0FFh   ; ]
E51F   6A                     DB   (h_xor-1) & 0FFh   ; ^
E520   F7                     DB   (h_alloc-1) & 0FFh   ; _
E521   C9                     DB   (h_grave-1) & 0FFh   ; `
E522   4E                     DB   (h_tor-1) & 0FFh   ; {
E523   75                     DB   (h_or-1) & 0FFh   ; |
E524   5A                     DB   (h_fromr-1) & 0FFh   ; }
E525   67                     DB   (h_not-1) & 0FFh   ; ~
E526                             ; Digits: the first one is in A; read the rest of the number.
E526   A0 00        DIGIT:    LDY   #0   
E528   20 F8 E4               JSR   pushay   
E52B                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E52B                             ; Returns with the carry set.
E52B   20 58 E5     RDNUM:    JSR   isdig   
E52E   B0 4D                  BCS   ic9   ; (an RTS)
E530   20 75 E5               JSR   incip   ; (keeps A = the digit)
E533   16 00                  ASL   0,X   
E535   36 01                  ROL   1,X   ; x2
E537   18                     CLC      
E538   75 00                  ADC   0,X   
E53A   85 04                  STA   T0   
E53C   B5 01                  LDA   1,X   
E53E   69 00                  ADC   #0   
E540   A8                     TAY      ; Y:T0 = x2 + digit
E541   16 00                  ASL   0,X   
E543   36 01                  ROL   1,X   
E545   16 00                  ASL   0,X   
E547   36 01                  ROL   1,X   ; x8
E549   18                     CLC      
E54A   B5 00                  LDA   0,X   
E54C   65 04                  ADC   T0   
E54E   95 00                  STA   0,X   
E550   98                     TYA      
E551   75 01                  ADC   1,X   
E553   95 01                  STA   1,X   ; x8 + x2 + digit
E555   4C 2B E5               JMP   rdnum   
E558                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E558                             ; digit. Y = 0.
E558   20 7E E5     ISDIG:    JSR   peek   
E55B   38                     SEC      
E55C   E9 30                  SBC   #"0"   
E55E   C9 0A                  CMP   #10   
E560   60                     RTS      
E561                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E561                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E561   20 58 E5     RDHEX:    JSR   isdig   
E564   90 0F                  BCC   incip   
E566   29 DF                  AND   #0DFh   
E568   E9 11                  SBC   #11h   ; (the carry is set)
E56A   C9 06                  CMP   #6   
E56C   B0 0F                  BCS   ic9   
E56E   69 0A                  ADC   #10   
E570   D0 03                  BNE   incip   ; always
E572                             ; Reading the program
E572                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E572                             ;    getc: the same, then IP moves on; flags follow A
E572                             ;    incip: IP moves on; keeps A, the carry and Y
E572   20 7E E5     GETC:     JSR   peek   
E575   E6 00        INCIP:    INC   IP   
E577   D0 02                  BNE   ic1   
E579   E6 01                  INC   IP+1   
E57B   09 00        IC1:      ORA   #0   
E57D   60           IC9:      RTS      
E57E   A0 00        PEEK:     LDY   #0   
E580   B1 00                  LDA   (IP),Y   
E582   60                     RTS      
E583                             ; rstip: point IP at the start of the program
E583   A9 00        RSTIP:    LDA   #<PROG   
E585   85 00                  STA   IP   
E587   A9 05                  LDA   #>PROG   
E589   85 01                  STA   IP+1   
E58B   60                     RTS      
E58C                          IF   CHECKED   
E58C                             ; =============================================================================
E58C                             ;  Checked build: the error report
E58C                             ; =============================================================================
E58C                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E58C                             ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
E58C                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E58C                             ; its depth is shown.
E58C                             ;   CR LF
E58C                             ;   Err X @ line,col CR LF
E58C                             ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
E58C                             ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
E58C                             ;   Rtn n CR LF
E58C                             ; The numbers go through "#" (prnum), which pushes them over the data stack
E58C                             ; and pops them again, so the stack is shown as it was. With the stack full
E58C                             ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
E58C   48           ERROR:    PHA      ; the letter
E58D   A5 08                  LDA   PLACE   
E58F   85 02                  STA   P   
E591   A5 09                  LDA   PLACE+1   
E593   85 03                  STA   P+1   ; (CO is the report's scratch from here on)
E595   A0 00                  LDY   #M_ERR-MSG   
E597   20 9D E3               JSR   prs   ; CR LF "Err "
E59A   68                     PLA      
E59B   20 03 FF               JSR   CONOUT   
E59E   20 9D E3               JSR   prs   ; " @ " (it follows M_ERR)
E5A1   20 50 E6               JSR   lcol   
E5A4   A5 0A                  LDA   LN   
E5A6   A4 0B                  LDY   LN+1   
E5A8   20 2D E6               JSR   prnum   ; the line
E5AB   A9 2C                  LDA   #","   
E5AD   20 03 FF               JSR   CONOUT   
E5B0   A5 08                  LDA   CO   
E5B2   A4 09                  LDY   CO+1   
E5B4   20 2D E6               JSR   prnum   ; the column
E5B7   A0 09                  LDY   #M_NL-MSG   
E5B9   20 9D E3               JSR   prs   
E5BC   A0 00                  LDY   #0   ; the text at the place
E5BE   B1 02        ER1:      LDA   (P),Y   
E5C0   F0 10                  BEQ   er2   
E5C2   C9 0D                  CMP   #13   
E5C4   F0 0C                  BEQ   er2   
E5C6   C9 0A                  CMP   #10   
E5C8   F0 08                  BEQ   er2   
E5CA   20 03 FF               JSR   CONOUT   
E5CD   C8                     INY      
E5CE   C0 10                  CPY   #16   
E5D0   D0 EC                  BNE   er1   
E5D2   A0 0B        ER2:      LDY   #M_STK-MSG   
E5D4   20 9D E3               JSR   prs   ; CR LF "Stk "
E5D7   8A                     TXA      
E5D8   49 FF                  EOR   #0FFh   
E5DA   38                     SEC      
E5DB   E9 0F                  SBC   #0FFh-DSE   
E5DD   4A                     LSR      ; the depth, (DSE - X) / 2
E5DE   48                     PHA      
E5DF   20 2B E6               JSR   prnum8   
E5E2   68                     PLA      
E5E3   A0 16                  LDY   #M_C-MSG   ; ":"
E5E5   C9 09                  CMP   #9   
E5E7   90 04                  BCC   er3   
E5E9   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E5EB   A0 11                  LDY   #M_CD-MSG   
E5ED   85 08        ER3:      STA   CO   ; CO = how many cells to show
E5EF   20 9D E3               JSR   prs   
E5F2   A5 08        ER4:      LDA   CO   ; cells CO-1 down to 0, the top last: cell i
E5F4   F0 1F                  BEQ   er5   ;   from the top is at X+2i
E5F6   C6 08                  DEC   CO   
E5F8   A9 20                  LDA   #" "   
E5FA   20 03 FF               JSR   CONOUT   
E5FD   A5 08                  LDA   CO   
E5FF   0A                     ASL      
E600   85 09                  STA   CO+1   
E602   8A                     TXA      
E603   65 09                  ADC   CO+1   ; (the carry is clear)
E605   A8                     TAY      
E606   B9 00 00               LDA   0,Y   
E609   48                     PHA      
E60A   B9 01 00               LDA   1,Y   
E60D   A8                     TAY      
E60E   68                     PLA      
E60F   20 2D E6               JSR   prnum   
E612   4C F2 E5               JMP   er4   
E615   A0 17        ER5:      LDY   #M_RTN-MSG   
E617   20 9D E3               JSR   prs   ; CR LF "Rtn "
E61A   AD 35 04               LDA   RSV   
E61D   49 FF                  EOR   #0FFh   
E61F   4A                     LSR      ; (FFh - S) / 2 entries
E620   20 2B E6               JSR   prnum8   
E623   A0 09                  LDY   #M_NL-MSG   
E625   20 9D E3               JSR   prs   
E628   4C 09 FF               JMP   EXIT   
E62B                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
E62B                             ; prnum8: the same for A alone, 0-255.
E62B   A0 00        PRNUM8:   LDY   #0   
E62D   20 F8 E4     PRNUM:    JSR   pushay   
E630   4C 8C E0               JMP   h_num   
E633                          ENDIF      
E633                          IF   CHECKED+ANSI   
E633                MSG:         
E633                          ENDIF      
E633                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
E633                          ENDIF      
E633                          IF   CHECKED   
E633   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E639   20 40 A0               DB   " @"," "+80h   
E63C   0D 8A        M_NL:     DB   13,10+80h   
E63E   0D 0A 53 74 6B A0 M_STK:   DB   13,10,"Stk"," "+80h   
E644   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E649   BA           M_C:      DB   ":"+80h   
E64A   0D 0A 52 74 6E A0 M_RTN:   DB   13,10,"Rtn"," "+80h   
E650                          ENDIF      
E650                          IF   CHECKED   
E650                             ; lcol: the line (LN) and the column (CO) of the place at P, both from
E650                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
E650                             ; column is the place in the buffer. Otherwise IP (free now: the program has
E650                             ; stopped) runs from PROG to the place, counting LFs; CO keeps where the
E650                             ; last line started, and the column is the place minus that, plus 1.
E650   A9 00        LCOL:     LDA   #0   
E652   85 0B                  STA   LN+1   
E654   85 0A                  STA   LN   
E656   A9 80                  LDA   #<LINEBUF   
E658   85 08                  STA   CO   
E65A   A9 04                  LDA   #>LINEBUF   
E65C   85 09                  STA   CO+1   
E65E   A5 02                  LDA   P   
E660   C9 00                  CMP   #<PROG   
E662   A5 03                  LDA   P+1   
E664   E9 05                  SBC   #>PROG   
E666   90 26                  BCC   lc9   ; below the program: line 0
E668   E6 0A                  INC   LN   
E66A   20 83 E5               JSR   rstip   
E66D   A5 00        LC3:      LDA   IP   ; a line starts here
E66F   85 08                  STA   CO   
E671   A5 01                  LDA   IP+1   
E673   85 09                  STA   CO+1   
E675   A5 00        LC1:      LDA   IP   
E677   C5 02                  CMP   P   
E679   A5 01                  LDA   IP+1   
E67B   E5 03                  SBC   P+1   
E67D   B0 0F                  BCS   lc9   ; at the place
E67F   20 72 E5               JSR   getc   
E682   C9 0A                  CMP   #10   
E684   D0 EF                  BNE   lc1   
E686   E6 0A                  INC   LN   ; an LF: a new line starts after it
E688   D0 E3                  BNE   lc3   
E68A   E6 0B                  INC   LN+1   
E68C   D0 DF                  BNE   lc3   ; always
E68E   A5 02        LC9:      LDA   P   
E690   38                     SEC      
E691   E5 08                  SBC   CO   
E693   85 08                  STA   CO   
E695   A5 03                  LDA   P+1   
E697   E5 09                  SBC   CO+1   
E699   85 09                  STA   CO+1   
E69B   E6 08                  INC   CO   ; + 1
E69D   D0 02                  BNE   lc8   
E69F   E6 09                  INC   CO+1   
E6A1   60           LC8:      RTS      
E6A2                          ENDIF      


