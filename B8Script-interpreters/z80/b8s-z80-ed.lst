019B                          IF   CHECKED   
                              INC   HL   ; both bytes must be in the program's space
                              CALL   chkst   
                              DEC   HL   
019B                          ENDIF      
019B   73                     LD   (HL),E   
019C   23                     INC   HL   
019D   72                     LD   (HL),D   
019E   DF                     RST   18h   
