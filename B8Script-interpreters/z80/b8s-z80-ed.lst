                              INC   HL   
                              CALL   pdec   
                              LD   A,";"   
                              RST   28h   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              LD   A,"H"   
                              RST   28h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
                              LD   A,"?"   
                              CALL   csia   
                              LD   A,"2"   
                              RST   28h   
                              LD   A,"5"   
                              RST   28h   
                              LD   A,E   
                              RST   28h   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              RST   28h   
                              RET      
                    CSI:      PUSH   AF   
                              LD   A,27   
                              RST   28h   
                              LD   A,"["   
                              RST   28h   
                              POP   AF   
                              RET      
024D                          ENDIF      
024D                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
024D                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
024D                             ; the quotient bits arrive at the bottom of C.
024D                             ; Dividing by 2 is one shift (the spec wants that fast).
024D   7B           UDIV:     LD   A,E   
024E   EE 02                  XOR   2   
0250   B2                     OR   D   
0251   20 07                  JR   NZ,udv0   
0253   CB 3C                  SRL   H   
0255   CB 1D                  RR   L   ; the quotient
0257   8F                     ADC   A,A   
0258   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0259   C9                     RET      
025A   C5           UDV0:     PUSH   BC   
025B   7C                     LD   A,H   
025C   4D                     LD   C,L   
025D   21 00 00               LD   HL,0   
0260   06 10                  LD   B,16   
0262   CB 21        UDV1:     SLA   C   
0264   17                     RLA      
0265   ED 6A                  ADC   HL,HL   
0267   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0269   30 02                  JR   NC,udv2   ;   always fits in 16 bits
026B   19                     ADD   HL,DE   ; too much: put it back, and cancel the
026C   0D                     DEC   C   ;   INC below
026D   0C           UDV2:     INC   C   ; a quotient bit
026E   10 F2                  DJNZ   udv1   
0270   EB                     EX   DE,HL   ; DE = remainder
0271   67                     LD   H,A   
0272   69                     LD   L,C   ; HL = quotient
0273   C1                     POP   BC   
0274   C9                     RET      
0275                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0275                             ; non-digit. Values wrap at 16 bits, as the spec says.
0275   21 00 00     RDNUM:    LD   HL,0   
0278   0A           RDN1:     LD   A,(BC)   
0279   D6 30                  SUB   "0"   
027B   FE 0A                  CP   10   
027D   D0                     RET   NC   
027E   03                     INC   BC   
027F   54                     LD   D,H   
0280   5D                     LD   E,L   
0281   29                     ADD   HL,HL   
0282   29                     ADD   HL,HL   
0283   19                     ADD   HL,DE   
0284   29                     ADD   HL,HL   ; HL * 10
0285   5F                     LD   E,A   
0286   16 00                  LD   D,0   
0288   19                     ADD   HL,DE   
0289   18 ED                  JR   rdn1   
028B                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
028B                             ; the next character, so "/"" does not end it. Leaves A = 22h.
028B                          IF   1-CHECKED   
028B   03           SS0:      INC   BC   
028C   0A           SKIPSTR:   LD   A,(BC)   
028D   03                     INC   BC   
028E   FE 2F                  CP   "/"   
0290   28 F9                  JR   Z,ss0   
0292   FE 22                  CP   22h   
0294   20 F6                  JR   NZ,skipstr   
0296   C9                     RET      
0297                          ENDIF      
0297                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0297                          ENDIF      
0297                             ; skip: read past text to the closer at this level, and return A = 0 if it
0297                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0297                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0297                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0297                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0297                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0297                             ; 
0297                             ; The checked build also looks at the character the skip was started by,
0297                             ; which is always the one just before where it starts: "(" must end at ")",
0297                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0297                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0297                             ; place where the skip started, for the report.
0297                SKIP:        
0297                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0297                          ENDIF      
0297   16 00                  LD   D,0   
0299   14           SK3:      INC   D   ; an opener: one deeper
029A   0A           SK1:      LD   A,(BC)   
029B                          IF   1-CHECKED   
029B   03                     INC   BC   
029C   B7                     OR   A   
029D   CA 63 03               JP   Z,SKEND   ; (the end of the program)
02A0                          ENDIF      
02A0                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
02A0                          ENDIF      
02A0   FE 22                  CP   22h   
02A2   CC 8C 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02A5   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02A7   28 F0                  JR   Z,sk3   
02A9   3D                     DEC   A   ; ")"
02AA   28 08                  JR   Z,sk4   
02AC   D6 32                  SUB   "["-")"   
02AE   28 E9                  JR   Z,sk3   
02B0   FE 02                  CP   "]"-"["   
02B2   20 E6                  JR   NZ,sk1   
02B4   15           SK4:      DEC   D   
02B5                          IF   1-CHECKED   
02B5   C8                     RET   Z   ; the closer at this level
02B6   18 E2                  JR   sk1   
02B8                          ENDIF      
02B8                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02B8                          ENDIF      
02B8                             ; =============================================================================
02B8                             ;  Dispatch table: the low byte of each handler's address, in code order
02B8                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02B8                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02B8                             ; =============================================================================
02B8                             ; The handlers of the first NPG1 characters start in the image's second page.
02B8                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02B8                             ; differs between the builds, so the count is worked out here.
02B8                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02B8                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02B8                PGBRK:    EQU   (h_break-BASE)/256   
02B8                PGDEF:    EQU   (h_def-BASE)/256   
02B8                PGFET:    EQU   (h_fetch-BASE)/256   
02B8                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02B8                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02B8                          ENDIF      
02B8                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02B8                             ; and return its value in A with the carry set; otherwise leave the IP and
02B8                             ; return with the carry clear.
02B8   0A           HEXC:     LD   A,(BC)   
02B9   D6 30                  SUB   "0"   
02BB   FE 0A                  CP   10   
02BD   38 09                  JR   C,hc1   
02BF   E6 DF                  AND   0DFh   
02C1   D6 11                  SUB   11h   
02C3   FE 06                  CP   6   
02C5   D0                     RET   NC   
02C6   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02C8   03           HC1:      INC   BC   
02C9   C9                     RET      
02CA                             ; psgn: print HL as a signed number. Keeps BC.
02CA   CB 7C        PSGN:     BIT   7,H   
02CC   28 04                  JR   Z,pdec   
02CE   3E 2D                  LD   A,"-"   
02D0   EF                     RST   28h   
02D1   E7                     RST   20h   
02D2                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02D2                             ; Keeps BC.
02D2   11 0A 00     PDEC:     LD   DE,10   
02D5   CD 4D 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02D8   7B                     LD   A,E   
02D9   F5                     PUSH   AF   
02DA   7C                     LD   A,H   
02DB   B5                     OR   L   
02DC   C4 D2 02               CALL   NZ,pdec   
02DF   F1                     POP   AF   
02E0   C6 30                  ADD   A,"0"   
02E2   EF                     RST   28h   
02E3   C9                     RET      
02E4                             ; (The table goes here instead in the builds where, before psgn, it would
02E4                             ; cross a page: PTLATE.)
02E4                          IF   (1-TABP0)*PTLATE   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02E4                          ENDIF      
02E4                             ; =============================================================================
02E4                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
02E4                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
02E4                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
02E4                             ;  they are the host's KEY and CONOUT routines themselves.
02E4                             ; 
02E4                             ;  A running program reads the keyboard only through getk and pollk, which
02E4                             ;  between them give the break key its rules:
02E4                             ;    - Ctrl-C stops the program;
02E4                             ;    - any other key that the break check reads is held in KEYBUF for the
02E4                             ;      next "?", and a newer one takes its place;
02E4                             ;    - "?" (getk) takes the held key first;
02E4                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
02E4                             ;      key like any other, but two of them within about 250 ms still stop it.
02E4                             ;  Both are called straight from a handler, never from a routine under one:
02E4                             ;  the checked build's report counts on finding one return address above the
02E4                             ;  data stack.
02E4                             ; =============================================================================
02E4                          IFN   CPM   
02E4                RAWK:     EQU   KEY   
02E4                          ENDIF      
02E4                             ; pollk: the break check (see rpushn).
02E4   CD 06 FF     POLLK:    CALL   rawk   
02E7   C8                     RET   Z   ; no key
02E8   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
02EB   FE 03        PK1:      CP   3   ; (getk joins here)
02ED   C0                     RET   NZ   
02EE                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
02EE                             ; the program has turned it off, wait about 250 ms for one more key: a
02EE                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
02EE                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
02EE   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
02F1   B7                     OR   A   
02F2   CA 5A 03     CT0:      JP   Z,brk   
02F5   D5                     PUSH   DE   
02F6   11 10 27               LD   DE,250*MSLOOP   
02F9   CD 06 FF     CT1:      CALL   rawk   
02FC   20 05                  JR   NZ,ct2   
02FE   1B                     DEC   DE   
02FF   7A                     LD   A,D   
0300   B3                     OR   E   
0301   20 F6                  JR   NZ,ct1   
0303   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0304   FE 03                  CP   3   
0306   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0308   B7                     OR   A   
0309   28 03                  JR   Z,ct3   
030B   32 7A 82               LD   (KEYBUF),A   
030E   3E 03        CT3:      LD   A,3   
0310   B7                     OR   A   
0311   C9                     RET      
0312                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0312   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0313   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0316   7E                     LD   A,(HL)   
0317   36 00                  LD   (HL),0   
0319   E1                     POP   HL   
031A   B7                     OR   A   
031B   C0                     RET   NZ   
031C   CD 06 FF               CALL   rawk   
031F   C8                     RET   Z   
0320   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0322                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0322                          ENDIF      ;   (with the editor, both stacks are cleared);
0322                          IF   (1-CHECKED)*EDITOR   
0322                BRK:      EQU   edit0   
0322                          ENDIF      
0322                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
0322                          ENDIF      
0322                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0322                          ENDIF      
0322                             ; =============================================================================
0322                             ;  Checked build: the checks and the error report
0322                             ; =============================================================================
0322                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
0322                          ENDIF      
0322                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0322                          ENDIF      
0322                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0322                          ENDIF      
0322                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
0322                          ENDIF      
0322                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0322                          ENDIF      
0322                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0322                          ENDIF      
0322                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr's return address goes first. But if a /~ took cells
                                 ; that weren't there, it is s, found now: chkstk, called one cell up, sees
                                 ; the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
0322                          ENDIF      
0322                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0322                          ENDIF      ;   screen on it. The editor's loader ends
0322                          IF   CHECKED   ;   the text at the first ^Z.)
                              RST   28h   
                              DJNZ   er4   
                    ER5:         ; (on into the two stack lines)
                                 ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
                                 ;                       Rtn n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
                              ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
                              RST   20h   ;   with the first value and holds nothing)
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      ; RSTOP - HL' is under 256 (the pointer is
                              LD   A,RSTOP&0FFh   ;   at most one entry below its page), so
                              SUB   L   ;   the low bytes are enough
                              EXX      
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
0322                          ENDIF      
0322                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
0322                          ENDIF      
0322                          IF   CHECKED*EDITOR   
                              JP   edit0   ; back to the editor, with both stacks cleared
0322                          ENDIF      
0322                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
0322                          ENDIF      
0322                             ; =============================================================================
0322                             ;  The line editor (EDITOR = 1)
0322                             ; 
0322                             ;  The interpreter starts here, and a program that ends comes back here.
0322                             ;  There is no prompt. It follows the spec's suggested standard for a line
0322                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0322                             ; 
0322                             ;    n text    put the text in as line n; the lines from n on move down. A
0322                             ;              number past the end (or 0) adds the line at the end.
0322                             ;    n         take line n out
0322                             ;    anything else is run at once, as B8Script. (Start such a line with a
0322                             ;    space if it would begin with a digit.)
0322                             ; 
0322                             ;  A command key ends the line too, and takes what was typed as its argument:
0322                             ; 
0322                             ;    ^G        run the program
0322                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0322                             ;              list until another key is pressed; Ctrl-C ends it.
0322                             ;    n ^E      put line n in the input line; Return puts it back, changed
0322                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0322                             ;              last time). Generic: what is typed, or pasted, from now until
0322                             ;              ^Z replaces the program; it is not echoed.
0322                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0322                             ;              time). Generic: the text is printed, as it is.
0322                             ;    ^N ^N     new: no program (the key twice in a row)
0322                             ;    ^X        leave (to LEAVE)
0322                             ; 
0322                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
0322                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0322                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0322                             ;  sent to the terminal, so any terminal will do.
0322                             ; 
0322                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0322                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0322                             ;  125 characters; the one character after a line number separates it from
0322                             ;  the text and is not stored. The text is kept as it is typed, each line
0322                             ;  ending in CR LF, at PROG.
0322                             ; 
0322                             ;  What lasts from one line to the next: the program, the words, the
0322                             ;  variables and the data stack. An error or a break clears both stacks. The
0322                             ;  return stack starts empty for every line.
0322                             ; 
0322                             ;  Things to know:
0322                             ;    - Reset empties the program (generic builds).
0322                             ;    - A word's address points into the program, so run the program again
0322                             ;      after editing it.
0322                             ;    - Nothing is printed between a program's output and what is typed next.
0322                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0322                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0322                             ;      (The stored program never comes back to the line, so it may.)
0322                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0322                             ;      read of the other builds.
0322                             ; 
0322                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0322                             ;  the last line left there, with TOS pushed like the rest.
0322                             ; =============================================================================
0322                          IF   EDGEN   
0322                INIT:        ; reset (A = 0)
0322                          ENDIF      
0322                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0322                          ENDIF      
0322                          IF   EDGEN   
0322   18 36                  JR   edit0   
0324                          ENDIF      
0324                          IF   EDITOR   
0324                             ; ^F, right arrow: one to the right, by printing the character there
0324   7D           RIGHT:    LD   A,L   
0325   BB                     CP   E   
0326   28 4F                  JR   Z,ed1   ; at the end
0328   7E                     LD   A,(HL)   
0329   2C                     INC   L   
032A   18 2B                  JR   lf1   
032C                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
032C                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
032C                             ; ends the sequence, and act on C (right) and D (left).
032C   01 C8 00     ESC:      LD   BC,5*MSLOOP   
032F   CD 06 FF     ES1:      CALL   rawk   
0332   20 0A                  JR   NZ,es2   
0334   0B                     DEC   BC   
0335   78                     LD   A,B   
0336   B1                     OR   C   
0337   20 F6                  JR   NZ,es1   
0339   CD AC 03               CALL   fin   ; no second key: the line is dropped
033C   18 27                  JR   edit   
033E   FE 5B        ES2:      CP   "["   
0340   20 35                  JR   NZ,ed1   ; not a sequence known here
0342   CD 05 04     ES3:      CALL   ekey   
0345   FE 40                  CP   40h   
0347   38 F9                  JR   C,es3   ; (its parameters)
0349   D6 43                  SUB   "C"   
034B   28 D7                  JR   Z,right   
034D   3D                     DEC   A   ; "D"?
034E   20 27                  JR   NZ,ed1   ; no: on into left
0350                             ; ^B, left arrow: the cursor goes one to the left
0350   7D           LEFT:     LD   A,L   
0351   87                     ADD   A,A   
0352   28 23                  JR   Z,ed1   ; (L = 80h: at the start)
0354   2D                     DEC   L   
0355   3E 08                  LD   A,8   
0357   EF           LF1:      RST   28h   
0358   18 1D                  JR   ed1   
035A                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
035A                             ;   is shown, in case the program had hidden it and could not show it again.
035A                             ; skend: a program that ended inside skip: its return address goes.
035A                             ; edend: a program that ended: TOS joins the rest of the data stack.
035A   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
035D                          ENDIF      
035D                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
035D                          ENDIF      
035D                          IF   EDITOR*(1-ANS)   
035D   3E 01                  LD   A,1   
035F   CD 12 FF               CALL   CONCUR   ; show the cursor
0362                          ENDIF      
0362                          IF   EDITOR   
0362   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0363   D1           SKEND:    POP   DE   
0364   E5           EDEND:    PUSH   HL   
0365                             ; edit: start a new input line.
0365   D9           EDIT:     EXX      
0366   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
0369   D9                     EXX      
036A   21 00 00               LD   HL,0   
036D   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0370   22 3A 82               LD   (EDLN),HL   ; no line is being edited
0373   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
0376   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0377   CD 05 04     ED1:      CALL   ekey   
037A   FE 7F                  CP   7Fh   
037C   28 40                  JR   Z,bsp   ; DEL
037E   FE 20                  CP   " "   
0380   30 56                  JR   NC,insc   
0382   FE 09                  CP   9   
0384   28 52                  JR   Z,insc   ; Tab is text
0386   FE 08                  CP   8   
0388   28 34                  JR   Z,bsp   
038A   FE 02                  CP   2   
038C   28 C2                  JR   Z,left   ; ^B
038E   FE 06                  CP   6   
0390   28 92                  JR   Z,right   ; ^F
0392   FE 1B                  CP   1Bh   
0394   28 96                  JR   Z,esc   
0396   E5                     PUSH   HL   ; a command key? Look it up
0397   21 0B 04               LD   HL,cmds   
039A   06 08                  LD   B,NCMD   
039C   BE           ED2:      CP   (HL)   
039D   23                     INC   HL   
039E   28 07                  JR   Z,ed3   
03A0   23                     INC   HL   
03A1   23                     INC   HL   
03A2   10 F8                  DJNZ   ed2   
03A4   E1                     POP   HL   
03A5   18 D0                  JR   ed1   ; no: the key is ignored
03A7   7E           ED3:      LD   A,(HL)   
03A8   23                     INC   HL   
03A9   66                     LD   H,(HL)   
03AA   6F                     LD   L,A   
03AB   E3                     EX   (SP),HL   ; the command's address: fin returns to it
03AC                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
03AC                             ; terminal. Leaves BC -> the line and HL -> the NUL.
03AC   26 82        FIN:      LD   H,LETPAGE   
03AE   6B                     LD   L,E   
03AF   36 0D                  LD   (HL),13   
03B1   2C                     INC   L   
03B2   36 0A                  LD   (HL),10   
03B4   2D                     DEC   L   
03B5   CD 0D 05               CALL   prl   ; (prints the CR LF)
03B8   36 00                  LD   (HL),0   
03BA   01 80 82               LD   BC,LINEBUF   
03BD   C9                     RET      
03BE                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
03BE                             ; left, the rest of the line moves down over it, and the last place (now a
03BE                             ; space) is printed over along with the rest.
03BE   7D           BSP:      LD   A,L   
03BF   87                     ADD   A,A   
03C0   28 B5                  JR   Z,ed1   ; at the start
03C2   2D                     DEC   L   
03C3   3E 08                  LD   A,8   
03C5   EF                     RST   28h   
03C6   E5                     PUSH   HL   
03C7   2C           BS1:      INC   L   
03C8   7E                     LD   A,(HL)   
03C9   2D                     DEC   L   
03CA   77                     LD   (HL),A   
03CB   2C                     INC   L   
03CC   7D                     LD   A,L   
03CD   BB                     CP   E   
03CE   20 F7                  JR   NZ,bs1   
03D0   2D                     DEC   L   
03D1   36 20                  LD   (HL)," "   
03D3   E1                     POP   HL   
03D4   53                     LD   D,E   
03D5   1D                     DEC   E   
03D6   18 15                  JR   ic2   
03D8                             ; A character goes in at the cursor: it ripples up through the rest of the
03D8                             ; line, the cursor moves on, and the rest is printed again.
03D8   47           INSC:     LD   B,A   
03D9   7B                     LD   A,E   
03DA   FE FD                  CP   0FDh   
03DC   28 99                  JR   Z,ed1   ; the line is full: 125 characters
03DE   78                     LD   A,B   
03DF   EF                     RST   28h   
03E0   E5                     PUSH   HL   
03E1   7E           IC1:      LD   A,(HL)   
03E2   70                     LD   (HL),B   
03E3   47                     LD   B,A   
03E4   7D                     LD   A,L   
03E5   2C                     INC   L   
03E6   BB                     CP   E   
03E7   20 F8                  JR   NZ,ic1   
03E9   E1                     POP   HL   
03EA   2C                     INC   L   
03EB   1C                     INC   E   
03EC   53                     LD   D,E   
03ED   CD F2 03     IC2:      CALL   tail   
03F0   18 85                  JR   ed1   
03F2                             ; tail: print the line from the cursor to D (a low byte), and bring the
03F2                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
03F2   4D           TAIL:     LD   C,L   
03F3   7D           TA1:      LD   A,L   
03F4   BA                     CP   D   
03F5   28 05                  JR   Z,ta2   
03F7   7E                     LD   A,(HL)   
03F8   EF                     RST   28h   
03F9   2C                     INC   L   
03FA   18 F7                  JR   ta1   
03FC   7D           TA2:      LD   A,L   
03FD   B9                     CP   C   
03FE   C8                     RET   Z   
03FF   3E 08                  LD   A,8   
0401   EF                     RST   28h   
0402   2D                     DEC   L   
0403   18 F7                  JR   ta2   
0405                             ; ekey: wait for a key
0405   CD 06 FF     EKEY:     CALL   rawk   
0408   28 FB                  JR   Z,ekey   
040A   C9                     RET      
040B                             ; The command keys, and where each goes (after fin).
040B   0D           CMDS:     DB   13   
040C   5B 04                  DW   cret   
040E   07                     DB   7   ; ^G
040F   A3 04                  DW   crun   
0411   0C                     DB   12   ; ^L
0412   B5 04                  DW   clist   
0414   05                     DB   5   ; ^E
0415   31 04                  DW   cedln   
0417   12                     DB   18   ; ^R
0418   19 05                  DW   cread   
041A   17                     DB   23   ; ^W
041B   46 05                  DW   cwrite   
041D   0E                     DB   14   ; ^N
041E   23 04                  DW   cnew   
0420   18                     DB   24   ; ^X
0421   09 FF                  DW   LEAVE   
0423                NCMD:     EQU   8   
0423                             ; ^N ^N: no program, if the next key is ^N too
0423   CD 05 04     CNEW:     CALL   ekey   
0426   FE 0E                  CP   14   
0428   20 04                  JR   NZ,ged0   
042A   AF                     XOR   A   
042B   32 00 83               LD   (PROG),A   
042E   C3 65 03     GED0:     JP   edit   
0431                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0431                             ; line it was: Return puts the text back in its place.
0431   CD 75 02     CEDLN:    CALL   rdnum   
0434   E5                     PUSH   HL   
0435   CD F5 04               CALL   find   ; HL -> the line, or the NUL if there is none
0438   D1                     POP   DE   
0439   7E                     LD   A,(HL)   
043A   B7                     OR   A   
043B   28 F1                  JR   Z,ged0   
043D   ED 53 3A 82            LD   (EDLN),DE   
0441   11 80 82               LD   DE,LINEBUF   
0444   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0445   FE 0D                  CP   13   
0447   28 0D                  JR   Z,ce2   
0449   FE 0A                  CP   10   
044B   28 09                  JR   Z,ce2   
044D   12                     LD   (DE),A   
044E   EF                     RST   28h   
044F   23                     INC   HL   
0450   1C                     INC   E   
0451   7B                     LD   A,E   
0452   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0454   20 EE                  JR   NZ,ce1   
0456   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
0457   5D                     LD   E,L   
0458   C3 77 03               JP   ed1   
045B                             ; Return. If ^E put a line here, the text goes back in its place. If not:
045B                             ; a number and text is a line to put in, a number alone a line to take out,
045B                             ; and anything else is run where it is.
045B   E5           CRET:     PUSH   HL   ; the end of what was typed
045C   2A 3A 82               LD   HL,(EDLN)   
045F   7C                     LD   A,H   
0460   B5                     OR   L   
0461   28 07                  JR   Z,cr1   
0463   E5                     PUSH   HL   
0464   CD E5 04               CALL   delln   
0467   E1                     POP   HL   
0468   18 13                  JR   ins   
046A   CD 75 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
046D   79                     LD   A,C   ; C is still 80h if there was no number:
046E   87                     ADD   A,A   ;   only then is twice it 0
046F   28 36                  JR   Z,st0p   ; no number: run the line
0471   0A                     LD   A,(BC)   
0472   FE 0D                  CP   13   
0474   20 06                  JR   NZ,cr2   
0476   D1                     POP   DE   ; the number alone: take that line out
0477   CD E5 04               CALL   delln   
047A   18 24                  JR   gedit   
047C   03           CR2:      INC   BC   ; step over the one character after the number
047D                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
047D                             ; CR and LF included, and copy it in.
047D   CD F5 04     INS:      CALL   find   ; HL -> where it goes
0480   D1                     POP   DE   ; the end of what was typed
0481   7B                     LD   A,E   
0482   91                     SUB   C   ; A = the length of the text, with its CR LF
0483   C5                     PUSH   BC   ; the text
0484   4F                     LD   C,A   
0485   06 00                  LD   B,0   
0487   C5                     PUSH   BC   ; its length
0488   54                     LD   D,H   
0489   5D                     LD   E,L   ; DE = where it goes
048A   AF                     XOR   A   
048B   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
048C   ED B1                  CPIR      ; HL -> one past the program's NUL
048E   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0490   44                     LD   B,H   
0491   4D                     LD   C,L   
0492   19                     ADD   HL,DE   
0493   2B                     DEC   HL   ; HL -> the NUL
0494   EB                     EX   DE,HL   
0495   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0496   E5                     PUSH   HL   
0497   19                     ADD   HL,DE   ; the NUL's new place
0498   EB                     EX   DE,HL   
0499   ED B8                  LDDR      ; move the rest of the program up
049B   C1                     POP   BC   ; the length
049C   D1                     POP   DE   ; where it goes
049D   E1                     POP   HL   ; the text
049E   ED B0                  LDIR      
04A0   C3 65 03     GEDIT:    JP   edit   
04A3                             ; ^G: run the program. st0p: run the typed line (BC -> it).
04A3   01 00 83     CRUN:     LD   BC,PROG   
04A6   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
04A7   E1           ST0P:     POP   HL   ; (the end of what was typed)
04A8                             ; st0: start running at BC. The heap starts after the stored program's NUL.
04A8   21 00 83     ST0:      LD   HL,PROG   
04AB   AF                     XOR   A   
04AC   BE           ST1:      CP   (HL)   
04AD   23                     INC   HL   
04AE   20 FC                  JR   NZ,st1   
04B0   22 7C 82               LD   (HEAP),HL   
04B3                          ENDIF      
04B3                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
04B3                          ENDIF      
04B3                          IF   EDITOR   
04B3   E1                     POP   HL   ; TOS: the data stack is as the last line left it
04B4   F7                     RST   30h   ; (its return address is thrown away)
04B5                             ; ^L: list from line n. DE = the number of the line at HL.
04B5   CD 75 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
04B8   7C                     LD   A,H   
04B9   B5                     OR   L   
04BA   20 01                  JR   NZ,li0   
04BC   2C                     INC   L   ;   then from line 1
04BD   E5           LI0:      PUSH   HL   
04BE   CD F5 04               CALL   find   
04C1   D1                     POP   DE   
04C2   7E           LI1:      LD   A,(HL)   
04C3   B7                     OR   A   
04C4   28 DA                  JR   Z,gedit   ; the end of the text
04C6   CD 06 FF               CALL   rawk   
04C9   28 09                  JR   Z,li3   ; no key: carry on
04CB   FE 03                  CP   3   
04CD   C4 05 04               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
04D0   FE 03                  CP   3   
04D2   28 CC                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
04D4   E5           LI3:      PUSH   HL   
04D5   D5                     PUSH   DE   
04D6   EB                     EX   DE,HL   
04D7   CD D2 02               CALL   pdec   ; the line's number,
04DA   3E 20                  LD   A," "   
04DC   EF                     RST   28h   ;   a space,
04DD   D1                     POP   DE   
04DE   E1                     POP   HL   
04DF   13                     INC   DE   
04E0   CD 0D 05               CALL   prl   ;   and the line
04E3   18 DD                  JR   li1   
04E5                             ; delln: take line n (in HL) out: copy everything after it down over it.
04E5   CD F5 04     DELLN:    CALL   find   
04E8   54                     LD   D,H   
04E9   5D                     LD   E,L   
04EA   CD 03 05               CALL   nxl   ; HL -> the next line
04ED   7E           DE1:      LD   A,(HL)   
04EE   12                     LD   (DE),A   
04EF   23                     INC   HL   
04F0   13                     INC   DE   
04F1   B7                     OR   A   
04F2   20 F9                  JR   NZ,de1   
04F4   C9                     RET      
04F5                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
04F5                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
04F5   EB           FIND:     EX   DE,HL   
04F6   21 00 83               LD   HL,PROG   
04F9   1B           FI1:      DEC   DE   
04FA   7A                     LD   A,D   
04FB   B3                     OR   E   
04FC   C8                     RET   Z   
04FD   CD 03 05               CALL   nxl   
0500   20 F7                  JR   NZ,fi1   
0502   C9                     RET      
0503                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0503                             ; stop at the NUL that ends the text (and return zero).
0503   7E           NXL:      LD   A,(HL)   
0504   B7                     OR   A   
0505   C8                     RET   Z   
0506   23                     INC   HL   
0507   FE 0A                  CP   10   
0509   20 F8                  JR   NZ,nxl   
050B   B7                     OR   A   
050C   C9                     RET      
050D                             ; prl: print the line at HL, to its LF; HL -> just past it.
050D   7E           PRL:      LD   A,(HL)   
050E   EF                     RST   28h   
050F   7E                     LD   A,(HL)   
0510   23                     INC   HL   
0511   FE 0A                  CP   10   
0513   20 F8                  JR   NZ,prl   
0515   C9                     RET      
0516                          ENDIF      
0516                          IF   EDGEN   
0516   C3 65 03     GED1:     JP   edit   
0519                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
0519                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
0519                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
0519                             ; line with no end is given one. Nothing is echoed, and there is no check
0519                             ; for running out of memory.
0519   21 FF 82     CREAD:    LD   HL,PROG-1   
051C   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
051E   23                     INC   HL   ;   the line buffer's last, and spare)
051F   CD 05 04     RD1:      CALL   ekey   
0522   4F                     LD   C,A   
0523   FE 1A                  CP   1Ah   
0525   20 02                  JR   NZ,rd2   
0527   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
0529   FE 0A        RD2:      CP   10   
052B   20 07                  JR   NZ,rd3   
052D   2B                     DEC   HL   
052E   BE                     CP   (HL)   
052F   23                     INC   HL   
0530   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
0532   3E 0D                  LD   A,13   ; anywhere else it ends the line
0534   77           RD3:      LD   (HL),A   
0535   23                     INC   HL   
0536   FE 0D                  CP   13   
0538   20 03                  JR   NZ,rd4   
053A   36 0A                  LD   (HL),10   ; after a CR goes a LF
053C   23                     INC   HL   
053D   79           RD4:      LD   A,C   
053E   FE 1A                  CP   1Ah   
0540   20 DD                  JR   NZ,rd1   
0542   36 00                  LD   (HL),0   
0544   18 D0                  JR   ged1   
0546                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
0546   21 00 83     CWRITE:   LD   HL,PROG   
0549   7E           CW1:      LD   A,(HL)   
054A   B7                     OR   A   
054B   28 C9                  JR   Z,ged1   
054D   EF                     RST   28h   
054E   23                     INC   HL   
054F   18 F8                  JR   cw1   
0551                          ENDIF      
0551                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0551                          ENDIF      
0551                             ; =============================================================================
0551                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0551                          ENDIF      
0551                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0551                          ENDIF      
0551                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
0551                          ENDIF      
0551                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0551                          ENDIF      
0551                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0551                          ENDIF      
0551                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0551                          ENDIF      
0551                IMGEND:      


