030C                             ; =============================================================================
030C                             ;  More routines (no handler starts past this point)
030C                             ; =============================================================================
030C                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JR   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              LD   HL,(RSAVE)   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
030C                          ENDIF      
030C                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
030C                             ; HL points past it. Each goes back into the loop that prints the string
030C                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
030C                             ;    /a-/z   print the variable, as "#" does
030C                             ;    /{      clear the screen, the cursor to the top left
030C                             ;    /}      clear from the cursor to the end of the line
030C                             ;    /|  /`  show the cursor, hide it
030C                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
030C   FE 7E        PESC:     CP   7Eh   
030E   28 1C                  JR   Z,pat   
0310   11 A1 02               LD   DE,PRLOOP   ; the others return into the loop
0313   D5                     PUSH   DE   
0314   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0316   30 2D                  JR   NC,pcon   
0318   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
031A   30 3D                  JR   NC,phide   
031C   87                     ADD   A,A   ; the variable's cell
031D   C6 40                  ADD   A,40h   
031F   E5                     PUSH   HL   
0320   6F                     LD   L,A   
0321   26 07                  LD   H,LETPAGE   
0323   7E                     LD   A,(HL)   
0324   2C                     INC   L   
0325   66                     LD   H,(HL)   
0326   6F                     LD   L,A   
0327   CD F4 03               CALL   psgn   
032A   E1                     POP   HL   
032B   C9                     RET      
032C                             ; /~ ( row col addr -- ): the two cells under the string's address go. Where
032C                             ; "$" is the routine prstr, its own return address goes first, and hp1
032C                             ; calls it again afterwards. (The checked build looks first, through
032C                             ; chkstk, that there is a column at least: with less, it is s. With a
032C                             ; column but no row it is s after the "$", as for any other character; the
032C                             ; spare bytes above the stack take what is written meanwhile.)
032C                PAT:         
032C                          IF   PRSUB   
                              POP   DE   
032C                          ENDIF      
032C                          IF   CHECKED   
                              CALL   chkstk   
032C                          ENDIF      
032C   D1                     POP   DE   ; DE = the column
032D   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
032E                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              JP   CONCUR   ; /|  (A = 1: show)
032E                          ENDIF      
032E                          IF   ANS   
032E   D5                     PUSH   DE   
032F   CD 6E 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0332   23                     INC   HL   
0333   CD FC 03               CALL   pdec   
0336   3E 3B                  LD   A,";"   
0338   EF                     RST   28h   
0339   E1                     POP   HL   
033A   23                     INC   HL   
033B   CD FC 03               CALL   pdec   
033E   3E 48                  LD   A,"H"   
0340   EF                     RST   28h   
0341   E1                     POP   HL   
0342   C3 A1 02               JP   PRAGAIN   
0345                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0345   3D           PCON:     DEC   A   
0346   28 0E                  JR   Z,pshow   ; /|
0348   3E 4B                  LD   A,"K"   
034A   F2 69 03               JP   P,csia   ; /}  ESC [ K
034D   3E 48                  LD   A,"H"   ; /{  ESC [ H ESC [ J
034F   CD 69 03               CALL   csia   
0352   3E 4A                  LD   A,"J"   
0354   18 13                  JR   csia   
0356   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0358   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0359   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
035B   3E 3F                  LD   A,"?"   
035D   CD 69 03               CALL   csia   
0360   3E 32                  LD   A,"2"   
0362   EF                     RST   28h   
0363   3E 35                  LD   A,"5"   
0365   EF                     RST   28h   
0366   7B                     LD   A,E   
0367   EF                     RST   28h   
0368   C9                     RET      
0369                             ; csia: ESC [ and then A. csi: ESC [, keeping A.
0369   CD 6E 03     CSIA:     CALL   csi   
036C   EF                     RST   28h   
036D   C9                     RET      
036E   F5           CSI:      PUSH   AF   
036F   3E 1B                  LD   A,27   
0371   EF                     RST   28h   
0372   3E 5B                  LD   A,"["   
0374   EF                     RST   28h   
0375   F1                     POP   AF   
0376   C9                     RET      
0377                          ENDIF      
0377                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0377                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0377                             ; the quotient bits arrive at the bottom of C.
0377                             ; Dividing by 2 is one shift (the spec wants that fast).
0377   7B           UDIV:     LD   A,E   
0378   EE 02                  XOR   2   
037A   B2                     OR   D   
037B   20 07                  JR   NZ,udv0   
037D   CB 3C                  SRL   H   
037F   CB 1D                  RR   L   ; the quotient
0381   8F                     ADC   A,A   
0382   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0383   C9                     RET      
0384   C5           UDV0:     PUSH   BC   
0385   7C                     LD   A,H   
0386   4D                     LD   C,L   
0387   21 00 00               LD   HL,0   
038A   06 10                  LD   B,16   
038C   CB 21        UDV1:     SLA   C   
038E   17                     RLA      
038F   ED 6A                  ADC   HL,HL   
0391   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0393   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0395   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0396   0D                     DEC   C   ;   INC below
0397   0C           UDV2:     INC   C   ; a quotient bit
0398   10 F2                  DJNZ   udv1   
039A   EB                     EX   DE,HL   ; DE = remainder
039B   67                     LD   H,A   
039C   69                     LD   L,C   ; HL = quotient
039D   C1                     POP   BC   
039E   C9                     RET      
039F                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
039F                             ; non-digit. Values wrap at 16 bits, as the spec says.
039F   21 00 00     RDNUM:    LD   HL,0   
03A2   0A           RDN1:     LD   A,(BC)   
03A3   D6 30                  SUB   "0"   
03A5   FE 0A                  CP   10   
03A7   D0                     RET   NC   
03A8   03                     INC   BC   
03A9   54                     LD   D,H   
03AA   5D                     LD   E,L   
03AB   29                     ADD   HL,HL   
03AC   29                     ADD   HL,HL   
03AD   19                     ADD   HL,DE   
03AE   29                     ADD   HL,HL   ; HL * 10
03AF   5F                     LD   E,A   
03B0   16 00                  LD   D,0   
03B2   19                     ADD   HL,DE   
03B3   18 ED                  JR   rdn1   
03B5                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03B5                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03B5                          IF   1-CHECKED   
03B5   03           SS0:      INC   BC   
03B6   0A           SKIPSTR:   LD   A,(BC)   
03B7   03                     INC   BC   
03B8   FE 2F                  CP   "/"   
03BA   28 F9                  JR   Z,ss0   
03BC   FE 22                  CP   22h   
03BE   20 F6                  JR   NZ,skipstr   
03C0   C9                     RET      
03C1                          ENDIF      
03C1                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
03C1                          ENDIF      
03C1                             ; skip: read past text to the closer at this level, and return A = 0 if it
03C1                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03C1                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03C1                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03C1                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03C1                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
03C1                             ; 
03C1                             ; The checked build also looks at the character the skip was started by,
03C1                             ; which is always the one just before where it starts: "(" must end at ")",
03C1                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03C1                             ; quote counts as running into it. "\" takes either closer. IX keeps the
03C1                             ; place where the skip started, for the report.
03C1                SKIP:        
03C1                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
03C1                          ENDIF      
03C1   16 00                  LD   D,0   
03C3   14           SK3:      INC   D   ; an opener: one deeper
03C4   0A           SK1:      LD   A,(BC)   
03C5                          IF   1-CHECKED   
03C5   03                     INC   BC   
03C6   B7                     OR   A   
03C7   CA 00 00               JP   Z,SKEND   ; (the end of the program)
03CA                          ENDIF      
03CA                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
03CA                          ENDIF      
03CA   FE 22                  CP   22h   
03CC   CC B6 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
03CF   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
03D1   28 F0                  JR   Z,sk3   
03D3   3D                     DEC   A   ; ")"
03D4   28 08                  JR   Z,sk4   
03D6   D6 32                  SUB   "["-")"   
03D8   28 E9                  JR   Z,sk3   
03DA   FE 02                  CP   "]"-"["   
03DC   20 E6                  JR   NZ,sk1   
03DE   15           SK4:      DEC   D   
03DF                          IF   1-CHECKED   
03DF   C8                     RET   Z   ; the closer at this level
03E0   18 E2                  JR   sk1   
03E2                          ENDIF      
03E2                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
03E2                          ENDIF      
03E2                             ; =============================================================================
03E2                             ;  Dispatch table: the low byte of each handler's address, in code order
03E2                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03E2                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03E2                             ; =============================================================================
03E2                             ; The handlers of the first NPG1 characters start in the image's second page.
03E2                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03E2                             ; differs between the builds, so the count is worked out here.
03E2                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03E2                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03E2                PGBRK:    EQU   (h_break-BASE)/256   
03E2                PGDEF:    EQU   (h_def-BASE)/256   
03E2                PGFET:    EQU   (h_fetch-BASE)/256   
03E2                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03E2                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
03E2                          ENDIF      
03E2                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03E2                             ; and return its value in A with the carry set; otherwise leave the IP and
03E2                             ; return with the carry clear.
03E2   0A           HEXC:     LD   A,(BC)   
03E3   D6 30                  SUB   "0"   
03E5   FE 0A                  CP   10   
03E7   38 09                  JR   C,hc1   
03E9   E6 DF                  AND   0DFh   
03EB   D6 11                  SUB   11h   
03ED   FE 06                  CP   6   
03EF   D0                     RET   NC   
03F0   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03F2   03           HC1:      INC   BC   
03F3   C9                     RET      
03F4                             ; psgn: print HL as a signed number. Keeps BC.
03F4   CB 7C        PSGN:     BIT   7,H   
03F6   28 04                  JR   Z,pdec   
03F8   3E 2D                  LD   A,"-"   
03FA   EF                     RST   28h   
03FB   E7                     RST   20h   
03FC                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03FC                             ; Keeps BC.
03FC   11 0A 00     PDEC:     LD   DE,10   
03FF   CD 77 03               CALL   udiv   ; HL = HL / 10, E = the last digit
0402   7B                     LD   A,E   
0403   F5                     PUSH   AF   
0404   7C                     LD   A,H   
0405   B5                     OR   L   
0406   C4 FC 03               CALL   NZ,pdec   
0409   F1                     POP   AF   
040A   C6 30                  ADD   A,"0"   
040C   EF                     RST   28h   
040D   C9                     RET      
040E                             ; (The table goes here instead in the builds where, before psgn, it would
040E                             ; cross a page: PTLATE.)
040E                          IF   (1-TABP0)*PTLATE   
040E                PTAB:        
040E                          ;*Macro unroll:  PTABLE
040E   95                     DB   h_store & 0FFh   
040F   9A                     DB   h_str & 0FFh   
0410   BD                     DB   h_num & 0FFh   
0411   A1                     DB   h_print & 0FFh   
0412   90                     DB   h_swap & 0FFh   
0413   3A                     DB   h_and & 0FFh   
0414   BA                     DB   h_emit & 0FFh   
0415   16                     DB   h_open & 0FFh   
0416   1E                     DB   h_close & 0FFh   
0417   5B                     DB   h_mul & 0FFh   
0418   31                     DB   h_add & 0FFh   
0419   D9                     DB   h_cfetch & 0FFh   
041A   29                     DB   h_sub & 0FFh   
041B   92                     DB   h_cstore & 0FFh   
041C   6F                     DB   h_div & 0FFh   
041D   8E                     DB   h_dup & 0FFh   
041E   94                     DB   h_drop & 0FFh   
041F   42                     DB   h_lt & 0FFh   
0420   51                     DB   h_eq & 0FFh   
0421   43                     DB   h_gt & 0FFh   
0422   C1                     DB   h_key & 0FFh   
0423   11                     DB   h_fetch & 0FFh   
0424   F4                     DB   h_def & 0FFh   
0425   E7                     DB   h_break & 0FFh   
0426   E3                     DB   h_ret & 0FFh   
0427   7F                     DB   h_xor & 0FFh   
0428   92                     DB   h_alloc & 0FFh   
0429   CD                     DB   h_grave & 0FFh   
042A   2C                     DB   h_tor & 0FFh   
042B   87                     DB   h_or & 0FFh   
042C   1C                     DB   h_fromr & 0FFh   
042D   8F                     DB   h_not & 0FFh   
042E                PTABEND:      
042E                          ENDIF      
042E                             ; =============================================================================
042E                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
042E                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
042E                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
042E                             ;  they are the host's KEY and CONOUT routines themselves.
042E                             ; 
042E                             ;  A running program reads the keyboard only through getk and pollk, which
042E                             ;  between them give the break key its rules:
042E                             ;    - Ctrl-C stops the program;
042E                             ;    - any other key that the break check reads is held in KEYBUF for the
042E                             ;      next "?", and a newer one takes its place;
042E                             ;    - "?" (getk) takes the held key first;
042E                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
042E                             ;      key like any other, but two of them within about 250 ms still stop it.
042E                             ;  Both are called straight from a handler, never from a routine under one:
042E                             ;  the checked build's report counts on finding one return address above the
042E                             ;  data stack.
042E                             ; =============================================================================
042E                          IFN   CPM   
                    RAWK:     EQU   KEY   
042E                          ENDIF      
042E                             ; pollk: the break check (see rpushn).
042E   CD 6C 04     POLLK:    CALL   rawk   
0431   C8                     RET   Z   ; no key
0432   32 7A 07               LD   (KEYBUF),A   ; held for the next "?"
0435   FE 03        PK1:      CP   3   ; (getk joins here)
0437   C0                     RET   NZ   
0438                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0438                             ; the program has turned it off, wait about 250 ms for one more key: a
0438                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0438                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0438   3A 7B 07     CTLC:     LD   A,(BRKOFF)   
043B   B7                     OR   A   
043C   CA 15 01     CT0:      JP   Z,brk   
043F   D5                     PUSH   DE   
0440   11 10 27               LD   DE,250*MSLOOP   
0443   CD 6C 04     CT1:      CALL   rawk   
0446   20 05                  JR   NZ,ct2   
0448   1B                     DEC   DE   
0449   7A                     LD   A,D   
044A   B3                     OR   E   
044B   20 F6                  JR   NZ,ct1   
044D   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
044E   FE 03                  CP   3   
0450   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0452   B7                     OR   A   
0453   28 03                  JR   Z,ct3   
0455   32 7A 07               LD   (KEYBUF),A   
0458   3E 03        CT3:      LD   A,3   
045A   B7                     OR   A   
045B   C9                     RET      
045C                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
045C   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
045D   21 7A 07               LD   HL,KEYBUF   ;   the buffer
0460   7E                     LD   A,(HL)   
0461   36 00                  LD   (HL),0   
0463   E1                     POP   HL   
0464   B7                     OR   A   
0465   C0                     RET   NZ   
0466   CD 6C 04               CALL   rawk   
0469   C8                     RET   Z   
046A   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
046C                          IF   (1-CHECKED)*(1-EDITOR)   
046C                BRK:      EQU   endprog   ; the unchecked build stops without a word
046C                          ENDIF      ;   (with the editor, both stacks are cleared);
046C                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
046C                          ENDIF      
046C                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
046C                          ENDIF      
046C                          IF   CPM   
046C   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
046E                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
046E                             ; printing and could swallow a key that BDOS 6 then never sees.
046E   D5           PUTC:     PUSH   DE   
046F   E5                     PUSH   HL   
0470   5F                     LD   E,A   
0471   3E 06                  LD   A,6   
0473   CD 7A 04               CALL   bdosx   
0476   E1                     POP   HL   
0477   D1                     POP   DE   
0478   B7                     OR   A   ; (for getk)
0479   C9                     RET      
047A                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
047A   C5           BDOSX:    PUSH   BC   
047B   D9                     EXX      
047C   E5                     PUSH   HL   
047D   D9                     EXX      
047E   4F                     LD   C,A   
047F   CD 05 00               CALL   BDOS   
0482   D9                     EXX      
0483   E1                     POP   HL   
0484   D9                     EXX      
0485   C1                     POP   BC   
0486   C9                     RET      
0487                          ENDIF      
0487                             ; =============================================================================
0487                             ;  Checked build: the checks and the error report
0487                             ; =============================================================================
0487                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
0487                          ENDIF      
0487                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0487                          ENDIF      
0487                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0487                          ENDIF      
0487                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
0487                          ENDIF      
0487                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0487                          ENDIF      
0487                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0487                          ENDIF      
0487                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
0487                          ENDIF      
0487                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0487                          ENDIF      ;   screen on it. The editor's loader ends
0487                          IF   CHECKED   ;   the text at the first ^Z.)
                              RST   28h   
                              DJNZ   er4   
                    ER5:         ; (on into the two stack lines)
                                 ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
                                 ;                       Rtn n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
                              ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
                              RST   20h   ;   with the first value and holds nothing)
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
0487                          ENDIF      
0487                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
0487                          ENDIF      
0487                          IF   CHECKED*EDITOR   
                              JP   edit0   ; back to the editor, with both stacks cleared
0487                          ENDIF      
0487                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
0487                          ENDIF      
0487                             ; =============================================================================
0487                             ;  The line editor (EDITOR = 1)
0487                             ; 
0487                             ;  The interpreter starts here, and a program that ends comes back here.
0487                             ;  There is no prompt. It follows the spec's suggested standard for a line
0487                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0487                             ; 
0487                             ;    n text    put the text in as line n; the lines from n on move down. A
0487                             ;              number past the end (or 0) adds the line at the end.
0487                             ;    n         take line n out
0487                             ;    anything else is run at once, as B8Script. (Start such a line with a
0487                             ;    space if it would begin with a digit.)
0487                             ; 
0487                             ;  A command key ends the line too, and takes what was typed as its argument:
0487                             ; 
0487                             ;    ^G        run the program
0487                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0487                             ;              list until another key is pressed; Ctrl-C ends it.
0487                             ;    n ^E      put line n in the input line; Return puts it back, changed
0487                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0487                             ;              last time). Generic: what is typed, or pasted, from now until
0487                             ;              ^Z replaces the program; it is not echoed.
0487                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0487                             ;              time). Generic: the text is printed, as it is.
0487                             ;    ^N ^N     new: no program (the key twice in a row)
0487                             ;    ^X        leave (to LEAVE)
0487                             ; 
0487                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
0487                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0487                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0487                             ;  sent to the terminal, so any terminal will do.
0487                             ; 
0487                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0487                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0487                             ;  125 characters; the one character after a line number separates it from
0487                             ;  the text and is not stored. The text is kept as it is typed, each line
0487                             ;  ending in CR LF, at PROG.
0487                             ; 
0487                             ;  What lasts from one line to the next: the program, the words, the
0487                             ;  variables and the data stack. An error or a break clears both stacks. The
0487                             ;  return stack starts empty for every line.
0487                             ; 
0487                             ;  Things to know:
0487                             ;    - Reset empties the program (generic builds).
0487                             ;    - A word's address points into the program, so run the program again
0487                             ;      after editing it.
0487                             ;    - Nothing is printed between a program's output and what is typed next.
0487                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0487                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0487                             ;      (The stored program never comes back to the line, so it may.)
0487                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0487                             ;      read of the other builds.
0487                             ; 
0487                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0487                             ;  the last line left there, with TOS pushed like the rest.
0487                             ; =============================================================================
0487                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
0487                          ENDIF      
0487                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0487                          ENDIF      
0487                          IF   EDGEN   
                              JR   edit0   
0487                          ENDIF      
0487                          IF   EDITOR   
                                 ; ^F, right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; ^B, left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                    LF1:      RST   28h   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   2   
                              JR   Z,left   ; ^B
                              CP   6   
                              JR   Z,right   ; ^F
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              LD   A,8   
                              RST   28h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              RST   28h   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              RST   28h   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              LD   A,8   
                              RST   28h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N ^N: no program, if the next key is ^N too
                    CNEW:     CALL   ekey   
                              CP   14   
                              JR   NZ,ged0   
                              XOR   A   
                              LD   (PROG),A   
                    GED0:     JP   edit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              RST   28h   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
0487                          ENDIF      
0487                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0487                          ENDIF      
0487                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              RST   30h   ; (its return address is thrown away)
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                    GED1:     JP   edit   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
0487                          ENDIF      
0487                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
0487                          ENDIF      
0487                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0487                          ENDIF      
0487                             ; =============================================================================
0487                          IF   CPM   
0487                             ; The RAM pages follow the image; the heap may grow to the BDOS.
0487                START:       
0487                          ENDIF      
0487                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0487                          ENDIF      
0487                          IF   CPM   
0487   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
048A   11 08 00               LD   DE,0008h   
048D   01 2C 00               LD   BC,vecend-vecs   
0490   ED B0                  LDIR      
0492                          ENDIF      
0492                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0492                          ENDIF      
0492                          IF   CPM*(1-EDITOR)   
0492   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
0495   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
0497   CD 05 00               CALL   BDOS   ;   and the program is empty)
049A   11 00 08               LD   DE,PROG   
049D   D5           LD1:      PUSH   DE   
049E   0E 1A                  LD   C,26   ; set the DMA address
04A0   CD 05 00               CALL   BDOS   
04A3   11 5C 00               LD   DE,005Ch   
04A6   0E 14                  LD   C,20   ; read the next 128 bytes
04A8   CD 05 00               CALL   BDOS   
04AB   E1                     POP   HL   ; HL = the address this record went to
04AC   B7                     OR   A   
04AD   20 07                  JR   NZ,ld2   
04AF   11 80 00               LD   DE,128   
04B2   19                     ADD   HL,DE   
04B3   EB                     EX   DE,HL   
04B4   18 E7                  JR   ld1   
04B6   36 00        LD2:      LD   (HL),0   ; the end of the file counts as NUL
04B8   23                     INC   HL   ; the heap starts after it
04B9   01 00 08               LD   BC,PROG   ; the IP
04BC   C3 70 01               JP   st2   
04BF                          ENDIF      
04BF                          IF   CPM   
04BF                             ; RAM pages, after the image
04BF                RSPAGE:   EQU   (imgend + 255) / 256   
04BF                DSPAGE:   EQU   RSPAGE + 1   
04BF                LETPAGE:   EQU   RSPAGE + 2   
04BF                PROG:     EQU   LETPAGE*256 + 256   
04BF                          ENDIF      
04BF                IMGEND:      


