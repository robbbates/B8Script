E956                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E956                             ; the carry is clear. Each returns into the loop.
E956                             ;    /a-/z   print the variable, as "#" does
E956                             ;    /{      clear the screen, the cursor to the top left
E956                             ;    /}      clear from the cursor to the end of the line
E956                             ;    /|  /`  show the cursor, hide it
E956                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E956                             ;            from 0. The two cells under the string's address go.
E956                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E956                             ; E6h-FFh with it clear.
E956                          IF   1-ANSI   
E956                             ; With ANSI = 0 the machine's routines do the work.
E956   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E958   90 0D                  BCC   pe1   
E95A   F0 08                  BEQ   pcls   ; {
E95C   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E95D   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E95F   B0 18                  BCS   pat   ; ~
E961   4C 0F FF               JMP   CONEOL   ; }
E964   4C 0C FF     PCLS:     JMP   CONCLS   
E967   C9 E6        PE1:      CMP   #0E6h   
E969   B0 03                  BCS   pvar   
E96B   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E96E                          ENDIF      
E96E                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E96E                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' prints
E96E                             ; it and drops it: TOS is the string's address again.
E96E   69 39        PVAR:     ADC   #39h   
E970   20 11 EA               JSR   lowp   
E973   20 37 E4               JSR   h_fetch   
E976   4C 79 E2               JMP   h_num   
E979                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into.
                    PESC:     LDY   #M_CLS-MSG   
                              SBC   #7Ah   ; (the carry is clear: - 7Bh)
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E979                          ENDIF      
E979                          IF   CHECKED+ANSI   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
E979                          ENDIF      
E979                             ; /~: the row is at 4,X, the column at 2,X, the string's address at 0,X.
E979                PAT:         
E979                          IF   CHECKED   
                              CPX   #DSE-5   ; fewer than two cells under TOS: s
                              BCS   e_sund   
E979                          ENDIF      
E979                          IF   1-ANSI   
E979   B5 04                  LDA   4,X   ; the row
E97B   B4 02                  LDY   2,X   ; the column
E97D   20 15 FF               JSR   CONAT   
E980   20 83 E9               JSR   nip   ; two nips leave the address, 4 bytes up
E983   20 B1 E2     NIP:      JSR   h_swap   ; nip: ( a b -- b )
E986   4C 0B E3               JMP   drop   
E989                          ENDIF      
E989                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). Three swaps put the row on top
                                 ; and the address under the column: "#" prints the row and drops it, prints
                                 ; the column and drops it, and TOS is the string's address again.
                              JSR   h_swap   
                              INX      
                              INX      
                              JSR   h_swap   
                              DEX      
                              DEX      
                              JSR   h_swap   
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E989                          ENDIF      
E989                          IF   CHECKED   
                                 ; The checked build's inner loop, out of page 1, where it would not fit,
                                 ; and its break check (described with the unchecked one in page 1).
                                 ; pnext: the break check, then (falling through) next. A word call, a true
                                 ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
                                 ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
                                 ; falls in here too, which does no harm.)
                    PNEXT:    DEC   CDOWN   
                              BNE   next   
                    PKEY:     JSR   KEY   
                              BEQ   next   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JSR   chk3   ; (Ctrl-C: back only if the break key is off)
                    NEXT:        
E989                          ENDIF      
E989                          IF   CHECKED*FAST   
                              JMP   fnext   ; (the fast build: see "The fast build")
E989                          ENDIF      
E989                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE (an
                                 ; underflow) or below DSFULL (an overflow). No handler moves X by
                                 ; more than 4 (but "$", whose /~ escapes each look first), so X is
                                 ; caught before it wraps; an overrun by a cell or two writes on the
                                 ; scratch bytes below or above the stack.
                                 ; S is kept in RSV, for the report's R: line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_sund   
                              CPX   #DSFULL   
                              BCC   e_sovr   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
                              JSR   step   
                              JMP   next   
E989                          ENDIF      
E989                          IF   CHECKED   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: R:0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_SUND:   LDX   #DSE   ; D:0
                              LDA   #"s"   
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_SOVR:   LDA   #"S"   
                    EJMP:     JMP   error   
                                 ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
                                 ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
                                 ; which takes either. Meeting the wrong closer at this level, or the end
                                 ; (a NUL, or a string that runs into it), stops with N, except for \,
                                 ; which then ends the program as before.
E989                          ENDIF      
E989                          IF   CHECKED*(1-QK)   
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
E989                          ENDIF      
E989                          IF   CHECKED   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                              JMP   error   ;   or the end: the place is the opener
E989                          ENDIF      
E989                          IF   1-CHECKED   
E989                CBREAK:   EQU   endp   ; the unchecked build stops without a word
E989                          ENDIF      
E989                          IF   CHECKED   
                    CBREAK:   EQU   e_break   ; the checked build reports B
E989                          ENDIF      
E989                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E989                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E989                             ; taken out of KEYBUF.
E989   AD 7A 04     GETK:     LDA   KEYBUF   
E98C   F0 08                  BEQ   gk1   
E98E   48                     PHA      
E98F   A9 00                  LDA   #0   
E991   8D 7A 04               STA   KEYBUF   
E994   68                     PLA      
E995   60                     RTS      
E996   20 06 FF     GK1:      JSR   KEY   
E999   F0 04                  BEQ   gk9   
E99B                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E99B                             ; back if it comes back at all.
E99B   C9 03        CHK3:     CMP   #3   
E99D   F0 01                  BEQ   ctlc   
E99F   60           GK9:      RTS      
E9A0                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E9A0                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E9A0                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E9A0                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E9A0                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E9A0   AD 7B 04     CTLC:     LDA   BRKOFF   
E9A3   F0 5D                  BEQ   cbreak   
E9A5   A9 28                  LDA   #CWAIT+1   
E9A7   85 05                  STA   T1   
E9A9   20 06 FF     CT2:      JSR   KEY   
E9AC   D0 0A                  BNE   ct3   
E9AE   C6 06                  DEC   T2   
E9B0   D0 F7                  BNE   ct2   
E9B2   C6 05                  DEC   T1   
E9B4   D0 F3                  BNE   ct2   
E9B6   F0 07                  BEQ   ct9   ; always: none came
E9B8   C9 03        CT3:      CMP   #3   
E9BA   F0 46                  BEQ   cbreak   
E9BC   8D 7A 04               STA   KEYBUF   
E9BF   A9 03        CT9:      LDA   #3   
E9C1   60                     RTS      
E9C2                          IF   CHECKED   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP2:    JMP   error   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; R: does not count the call
                              LDA   #"U"   
                              BNE   ejmp2   ; always
E9C2                          ENDIF      
E9C2                             ; step: read one character and sort it by range.
E9C2                             ;    00h          end of program
E9C2                             ;    01h-20h, 7Fh-FFh   ignored
E9C2                             ;    30h-39h      digit: read a whole number
E9C2                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E9C2                             ;    61h-7Ah      a-z: push the address of that letter's cell
E9C2                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E9C2   20 8E EA     STEP:     JSR   getc   ; flags follow A
E9C5   F0 3B                  BEQ   endp   
E9C7   38                     SEC      
E9C8   E9 21                  SBC   #21h   ; A = c - 21h
E9CA   90 35                  BCC   ign   ; 01h-20h
E9CC   C9 0F                  CMP   #0Fh   
E9CE   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E9D0   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E9D2   C9 0A                  CMP   #10   
E9D4   90 6C                  BCC   digit   
E9D6   C9 11                  CMP   #11h   
E9D8   90 16                  BCC   p3a   ; 3Ah-40h
E9DA   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E9DC   C9 1A                  CMP   #1Ah   
E9DE   90 25                  BCC   upper   ; 41h-5Ah
E9E0   C9 20                  CMP   #20h   
E9E2   90 0A                  BCC   p5b   ; 5Bh-60h
E9E4   C9 3A                  CMP   #3Ah   
E9E6   90 29                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E9E8   C9 3E                  CMP   #3Eh   
E9EA                          IF   1-CHECKED   
E9EA   B0 15                  BCS   ign   ; 7Fh-FFh
E9EC                          ENDIF      
E9EC                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E9EC                          ENDIF      
E9EC                             ; The three adjustments below chain. Each ADC adds the carry the one
E9EC                             ; before it left, which the constants allow for.
E9EC   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E9EE   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E9F0   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E9F2                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E9F2                             ; the index is N1 or more, plus one more if it is N2 or more.
E9F2   C9 08        PUNCT:    CMP   #N1   
E9F4   A8                     TAY      
E9F5   A9 70                  LDA   #HALFPG   
E9F7   2A                     ROL      ; the first page, or the second (carry clear)
E9F8   C0 15                  CPY   #N2   
E9FA   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E9FC   48                     PHA      
E9FD   B9 22 EA               LDA   PTAB,Y   
EA00   48                     PHA      
EA01   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
EA02                             ; directly, it just ends an ignored character.
EA02                ENDP:        ; the program has ended
EA02                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
EA02                          ENDIF      
EA02   4C 09 FF               JMP   EXIT   
EA05                             ; A-Z: call the word. The return address (the IP after the letter) goes on
EA05                             ; the return stack, and the IP becomes the address in the letter's cell.
EA05   0A           UPPER:    ASL      
EA06   A8                     TAY      
EA07   38                     SEC      
EA08   4C D2 E2               JMP   pushn   
EA0B   A5 00        PUSHIP:   LDA   IP   ; push the reading position
EA0D   A4 01                  LDY   IP+1   
EA0F   D0 03                  BNE   pushay   ; always: no program is in page zero
EA11                             ; a-z: push the cell's address (the cell is the variable)
EA11                             ;  (the unchecked QK builds do x@ and x! in one step: lowq)
EA11                          IF   SBASEU   
                    LOWER:    JMP   lowq   
                    LOWP:        
EA11                          ENDIF      
EA11                          IF   1-SBASEU   
EA11                LOWER:       
EA11                LOWP:        
EA11                          ENDIF      
EA11   0A                     ASL      
EA12   A0 04                  LDY   #>LET   
EA14                             ; pushay: push a cell: A = its low byte, Y = its high byte
EA14   CA           PUSHAY:   DEX      
EA15   CA                     DEX      
EA16   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
EA18   94 01                  STY   1,X   
EA1A   60                     RTS      
EA1B                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
EA1B   E8           FLAG:     INX      
EA1C   E8                     INX      
EA1D   B5 FE                  LDA   0FEh,X   
EA1F   15 FF                  ORA   0FFh,X   
EA21   60                     RTS      
EA22                             ; =============================================================================
EA22                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
EA22                             ;  character, in code order.
EA22                             ; =============================================================================
EA22   A4           PTAB:     DB   (h_store-1) & 0FFh   ; !
EA23   5C                     DB   (h_str-1) & 0FFh   ; "
EA24   78                     DB   (h_num-1) & 0FFh   ; #
EA25   3E                     DB   (h_print-1) & 0FFh   ; $
EA26   B0                     DB   (h_swap-1) & 0FFh   ; %
EA27   C1                     DB   (h_and-1) & 0FFh   ; &
EA28   70                     DB   (h_emit-1) & 0FFh   ; '
EA29   CC                     DB   (h_open-1) & 0FFh   ; (
EA2A   7B                     DB   (h_close-1) & 0FFh   ; )
EA2B   4C                     DB   (h_mul-1) & 0FFh   ; *
EA2C   16                     DB   (h_add-1) & 0FFh   ; +
EA2D   72                     DB   (h_cfetch-1) & 0FFh   ; ,
EA2E   0D                     DB   (h_sub-1) & 0FFh   ; -
EA2F   04                     DB   (h_cstore-1) & 0FFh   ; .
EA30   4F                     DB   (h_div-1) & 0FFh   ; /
EA31   FD                     DB   (h_dup-1) & 0FFh   ; :
EA32   0A                     DB   (drop-1) & 0FFh   ; ;
EA33   2B                     DB   (h_lt-1) & 0FFh   ; <
EA34   3C                     DB   (h_eq-1) & 0FFh   ; =
EA35   28                     DB   (h_gt-1) & 0FFh   ; >
EA36   83                     DB   (h_key-1) & 0FFh   ; ?
EA37   36                     DB   (h_fetch-1) & 0FFh   ; @
EA38   4C                     DB   (h_def-1) & 0FFh   ; [
EA39   E0                     DB   (h_break-1) & 0FFh   ; \
EA3A   F2                     DB   (h_ret-1) & 0FFh   ; ]
EA3B   20                     DB   (h_xor-1) & 0FFh   ; ^
EA3C   9C                     DB   (h_alloc-1) & 0FFh   ; _
EA3D   6E                     DB   (h_grave-1) & 0FFh   ; `
EA3E   04                     DB   (h_tor-1) & 0FFh   ; {
EA3F   2B                     DB   (h_or-1) & 0FFh   ; |
EA40   10                     DB   (h_fromr-1) & 0FFh   ; }
EA41   1D                     DB   (h_not-1) & 0FFh   ; ~
EA42                             ; Digits: the first one is in A; read the rest of the number.
EA42   A0 00        DIGIT:    LDY   #0   
EA44   20 14 EA               JSR   pushay   
EA47                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
EA47                             ; Returns with the carry set.
EA47   20 74 EA     RDNUM:    JSR   isdig   
EA4A   B0 4D                  BCS   ic9   ; (an RTS)
EA4C   20 91 EA               JSR   incip   ; (keeps A = the digit)
EA4F   16 00                  ASL   0,X   
EA51   36 01                  ROL   1,X   ; x2
EA53   18                     CLC      
EA54   75 00                  ADC   0,X   
EA56   85 04                  STA   T0   
EA58   B5 01                  LDA   1,X   
EA5A   69 00                  ADC   #0   
EA5C   A8                     TAY      ; Y:T0 = x2 + digit
EA5D   16 00                  ASL   0,X   
EA5F   36 01                  ROL   1,X   
EA61   16 00                  ASL   0,X   
EA63   36 01                  ROL   1,X   ; x8
EA65   18                     CLC      
EA66   B5 00                  LDA   0,X   
EA68   65 04                  ADC   T0   
EA6A   95 00                  STA   0,X   
EA6C   98                     TYA      
EA6D   75 01                  ADC   1,X   
EA6F   95 01                  STA   1,X   ; x8 + x2 + digit
EA71   4C 47 EA               JMP   rdnum   
EA74                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
EA74                             ; digit. Y = 0.
EA74   20 9A EA     ISDIG:    JSR   peek   
EA77   38                     SEC      
EA78   E9 30                  SBC   #"0"   
EA7A   C9 0A                  CMP   #10   
EA7C   60                     RTS      
EA7D                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
EA7D                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
EA7D   20 74 EA     RDHEX:    JSR   isdig   
EA80   90 0F                  BCC   incip   
EA82   29 DF                  AND   #0DFh   
EA84   E9 11                  SBC   #11h   ; (the carry is set)
EA86   C9 06                  CMP   #6   
EA88   B0 0F                  BCS   ic9   
EA8A   69 0A                  ADC   #10   
EA8C   D0 03                  BNE   incip   ; always
EA8E                             ; Reading the program
EA8E                             ;    peek: A = the character at IP, IP unchanged, Y = 0
EA8E                             ;    getc: the same, then IP moves on; flags follow A
EA8E                             ;    incip: IP moves on; keeps A, the carry and Y
EA8E   20 9A EA     GETC:     JSR   peek   
EA91   E6 00        INCIP:    INC   IP   
EA93   D0 02                  BNE   ic1   
EA95   E6 01                  INC   IP+1   
EA97   09 00        IC1:      ORA   #0   
EA99   60           IC9:      RTS      
EA9A   A0 00        PEEK:     LDY   #0   
EA9C   B1 00                  LDA   (IP),Y   
EA9E   60                     RTS      
EA9F                             ; rstip: point IP at the start of the program
EA9F   A9 00        RSTIP:    LDA   #<PROG   
EAA1   85 00                  STA   IP   
EAA3   A9 05                  LDA   #>PROG   
EAA5   85 01                  STA   IP+1   
EAA7   60                     RTS      
EAA8                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   R:n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was. With the stack full
                                 ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
                    ERROR:    PHA      ; the letter
                              LDA   PLACE   
                              STA   P   
                              LDA   PLACE+1   
                              STA   P+1   ; (CO is the report's scratch from here on)
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   LN   
                              LDY   LN+1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   CO   
                              LDY   CO+1   
                              JSR   prnum   ; the column
                              LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "D:"
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   
                              LSR      ; the depth, (DSE - X) / 2
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   CO   ; CO = how many cells to show
                              JSR   prs   
                    ER4:      LDA   CO   ; cells CO-1 down to 0, the top last: cell i
                              BEQ   er5   ;   from the top is at X+2i
                              DEC   CO   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   CO   
                              ASL      
                              STA   CO+1   
                              TXA      
                              ADC   CO+1   ; (the carry is clear)
                              TAY      
                              LDA   0,Y   
                              PHA      
                              LDA   1,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "R:"
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
EAA8                          ENDIF      
EAA8                          IF   CHECKED+ANSI   
                    MSG:         
EAA8                          ENDIF      
EAA8                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
EAA8                          ENDIF      
EAA8                          IF   CHECKED   
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"D",":"+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"R",":"+80h   
EAA8                          ENDIF      
EAA8                          IF   CHECKED   
                                 ; lcol: the line (LN) and the column (CO) of the place at P, both from
                                 ; 1. A place below the program is in the -n? line buffer: line 0, and the
                                 ; column is the place in the buffer. Otherwise IP (free now: the program has
                                 ; stopped) runs from PROG to the place, counting LFs; CO keeps where the
                                 ; last line started, and the column is the place minus that, plus 1.
                    LCOL:     LDA   #0   
                              STA   LN+1   
                              STA   LN   
                              LDA   #<LINEBUF   
                              STA   CO   
                              LDA   #>LINEBUF   
                              STA   CO+1   
                              LDA   P   
                              CMP   #<PROG   
                              LDA   P+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   LN   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   CO   
                              LDA   IP+1   
                              STA   CO+1   
                    LC1:      LDA   IP   
                              CMP   P   
                              LDA   IP+1   
                              SBC   P+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              INC   LN   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   LN+1   
                              BNE   lc3   ; always
                    LC9:      LDA   P   
                              SEC      
                              SBC   CO   
                              STA   CO   
                              LDA   P+1   
                              SBC   CO+1   
                              STA   CO+1   
                              INC   CO   ; + 1
                              BNE   lc8   
                              INC   CO+1   
                    LC8:      RTS      
EAA8                          ENDIF      
EAA8                             ; =============================================================================
EAA8                             ;  The fast build (SPEED = 2)
EAA8                             ; 
EAA8                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
EAA8                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
EAA8                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
EAA8                             ;  so there is no JSR and no RTS per character:
EAA8                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
EAA8                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
EAA8                             ;  The letters and digits have one entry each, which knows its cell or its
EAA8                             ;  value already; the commonest punctuation is written for the table; the
EAA8                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
EAA8                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
EAA8                             ;  and the clear carry they expect.
EAA8                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
EAA8                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
EAA8                             ;  stacks first, as next does in the other builds.
EAA8                             ;  Everything here is read-only: the image can be ROM, as the others are.
EAA8                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
EAA8                             ;  starts after it.
EAA8                             ; =============================================================================
EAA8                          IF   FAST   
EAA8                             ; fnext: the dispatcher, after the checks of the checked build
EAA8                FNEXT:       
EAA8                          ENDIF      
EAA8                          IF   FAST*CHECKED   
                                 ; (the same checks as next in the other checked builds)
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      
                              BCS   fn1   
                              JMP   e_rstack   
                    FN1:      CPX   #DSE+1   
                              BCS   fn2   
                              CPX   #DSFULL   
                              BCS   fn3   
                              JMP   e_sovr   
                    FN2:      JMP   e_sund   
                    FN3:      LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
EAA8                          ENDIF      
EAA8                          IF   FAST   
EAA8   A0 00                  LDY   #0   
EAAA   B1 00                  LDA   (IP),Y   
EAAC   E6 00                  INC   IP   
EAAE   D0 02                  BNE   fn4   
EAB0   E6 01                  INC   IP+1   
EAB2   A8           FN4:      TAY      
EAB3   B9 00 E0               LDA   DTL,Y   
EAB6   85 04                  STA   V   
EAB8   B9 00 E1               LDA   DTH,Y   
EABB   85 05                  STA   V+1   
EABD   6C 04 00               JMP   (V)   
EAC0                             ; fpoll: the break check of pnext, as a subroutine, for the entries that
EAC0                             ; look at the keyboard (a word call, a true ( and a true ))
EAC0   20 06 FF     FPOLL:    JSR   KEY   
EAC3   F0 06                  BEQ   fp9   ; no key
EAC5   8D 7A 04               STA   KEYBUF   ; held for the next "?"
EAC8   4C 9B E9               JMP   chk3   ; (Ctrl-C: back only if the break key is off)
EACB   60           FP9:      RTS      
EACC                             ; The thunks: the rest of the punctuation, through the ordinary handlers
EACC   18           FT_STR:   CLC      ; "
EACD   20 5D E2               JSR   h_str   
EAD0   4C A8 EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EAD3   18           FT_NUM:   CLC      ; #
EAD4   20 79 E2               JSR   h_num   
EAD7   4C A8 EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EADA   18           FT_PRT:   CLC      ; $
EADB   20 3F E2               JSR   h_print   
EADE   4C A8 EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EAE1   18           FT_EMIT:   CLC      ; '
EAE2   20 71 E2               JSR   h_emit   
EAE5   4C A8 EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EAE8   18           FT_DIV:   CLC      ; /
EAE9   20 50 E3               JSR   h_div   
EAEC                          ;*Macro unroll:  NEXTF
EAEC   A0                     DS   1-CHECKED,0A0h   
EAED   00                     DS   1-CHECKED,0   
EAEE   B1                     DS   1-CHECKED,0B1h   
EAEF   00                     DS   1-CHECKED,IP   
EAF0   E6                     DS   1-CHECKED,0E6h   
EAF1   00                     DS   1-CHECKED,IP   
EAF2   D0                     DS   1-CHECKED,0D0h   
EAF3   02                     DS   1-CHECKED,2   
EAF4   E6                     DS   1-CHECKED,0E6h   
EAF5   01                     DS   1-CHECKED,IP+1   
EAF6   A8                     DS   1-CHECKED,0A8h   
EAF7   B9                     DS   1-CHECKED,0B9h   
EAF8   00                     DS   1-CHECKED,ADTL&0FFh   
EAF9   E0                     DS   1-CHECKED,ADTL/256   
EAFA   85                     DS   1-CHECKED,85h   
EAFB   04                     DS   1-CHECKED,V   
EAFC   B9                     DS   1-CHECKED,0B9h   
EAFD   00                     DS   1-CHECKED,ADTH&0FFh   
EAFE   E1                     DS   1-CHECKED,ADTH/256   
EAFF   85                     DS   1-CHECKED,85h   
EB00   05                     DS   1-CHECKED,V+1   
EB01   6C                     DS   1-CHECKED,6Ch   
EB02   04                     DS   1-CHECKED,V   
EB03   00                     DS   1-CHECKED,0   
EB04                          DS   CHECKED,4Ch   
EB04                          DS   CHECKED,AFNX&0FFh   
EB04                          DS   CHECKED,AFNX/256   
EB04   18           FT_KEY:   CLC      ; ?
EB05   20 84 E3               JSR   h_key   
EB08   4C A8 EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EB0B   18           FT_DEF:   CLC      ; [
EB0C   20 4D E4               JSR   h_def   
EB0F                          ;*Macro unroll:  NEXTF
EB0F   A0                     DS   1-CHECKED,0A0h   
EB10   00                     DS   1-CHECKED,0   
EB11   B1                     DS   1-CHECKED,0B1h   
EB12   00                     DS   1-CHECKED,IP   
EB13   E6                     DS   1-CHECKED,0E6h   
EB14   00                     DS   1-CHECKED,IP   
EB15   D0                     DS   1-CHECKED,0D0h   
EB16   02                     DS   1-CHECKED,2   
EB17   E6                     DS   1-CHECKED,0E6h   
EB18   01                     DS   1-CHECKED,IP+1   
EB19   A8                     DS   1-CHECKED,0A8h   
EB1A   B9                     DS   1-CHECKED,0B9h   
EB1B   00                     DS   1-CHECKED,ADTL&0FFh   
EB1C   E0                     DS   1-CHECKED,ADTL/256   
EB1D   85                     DS   1-CHECKED,85h   
EB1E   04                     DS   1-CHECKED,V   
EB1F   B9                     DS   1-CHECKED,0B9h   
EB20   00                     DS   1-CHECKED,ADTH&0FFh   
EB21   E1                     DS   1-CHECKED,ADTH/256   
EB22   85                     DS   1-CHECKED,85h   
EB23   05                     DS   1-CHECKED,V+1   
EB24   6C                     DS   1-CHECKED,6Ch   
EB25   04                     DS   1-CHECKED,V   
EB26   00                     DS   1-CHECKED,0   
EB27                          DS   CHECKED,4Ch   
EB27                          DS   CHECKED,AFNX&0FFh   
EB27                          DS   CHECKED,AFNX/256   
EB27   18           FT_BRK:   CLC      ; \
EB28   20 E1 E3               JSR   h_break   
EB2B                          ;*Macro unroll:  NEXTF
EB2B   A0                     DS   1-CHECKED,0A0h   
EB2C   00                     DS   1-CHECKED,0   
EB2D   B1                     DS   1-CHECKED,0B1h   
EB2E   00                     DS   1-CHECKED,IP   
EB2F   E6                     DS   1-CHECKED,0E6h   
EB30   00                     DS   1-CHECKED,IP   
EB31   D0                     DS   1-CHECKED,0D0h   
EB32   02                     DS   1-CHECKED,2   
EB33   E6                     DS   1-CHECKED,0E6h   
EB34   01                     DS   1-CHECKED,IP+1   
EB35   A8                     DS   1-CHECKED,0A8h   
EB36   B9                     DS   1-CHECKED,0B9h   
EB37   00                     DS   1-CHECKED,ADTL&0FFh   
EB38   E0                     DS   1-CHECKED,ADTL/256   
EB39   85                     DS   1-CHECKED,85h   
EB3A   04                     DS   1-CHECKED,V   
EB3B   B9                     DS   1-CHECKED,0B9h   
EB3C   00                     DS   1-CHECKED,ADTH&0FFh   
EB3D   E1                     DS   1-CHECKED,ADTH/256   
EB3E   85                     DS   1-CHECKED,85h   
EB3F   05                     DS   1-CHECKED,V+1   
EB40   6C                     DS   1-CHECKED,6Ch   
EB41   04                     DS   1-CHECKED,V   
EB42   00                     DS   1-CHECKED,0   
EB43                          DS   CHECKED,4Ch   
EB43                          DS   CHECKED,AFNX&0FFh   
EB43                          DS   CHECKED,AFNX/256   
EB43   18           FT_ALC:   CLC      ; _
EB44   20 9D E4               JSR   h_alloc   
EB47   4C A8 EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EB4A   18           FT_GRV:   CLC      ; `
EB4B   20 6F E4               JSR   h_grave   
EB4E   4C A8 EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EB51   18           FT_TOR:   CLC      ; {
EB52   20 05 E4               JSR   h_tor   
EB55   4C A8 EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EB58   18           FT_FRR:   CLC      ; }
EB59   20 11 E4               JSR   h_fromr   
EB5C   4C A8 EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EB5F                          ENDIF      
EB5F                          IF   FAST*CHECKED   
                    FT_STO:   CLC      ; ! (checked: it checks the address)
                              JSR   h_store   
                              JMP   fnext   
                    FT_CST:   CLC      ; . (the same)
                              JSR   h_cstore   
                              JMP   fnext   
EB5F                          ENDIF      
EB5F                          IF   FAST   
EB5F                             ; The commonest punctuation, written for the table
EB5F   18           FS_ADD:   CLC      ; +
EB60   B5 00                  LDA   0,X   
EB62   75 02                  ADC   2,X   
EB64   95 02                  STA   2,X   
EB66   B5 01                  LDA   1,X   
EB68   75 03                  ADC   3,X   
EB6A   95 03                  STA   3,X   
EB6C   E8                     INX      
EB6D   E8                     INX      
EB6E                          ;*Macro unroll:  NEXTF
EB6E   A0                     DS   1-CHECKED,0A0h   
EB6F   00                     DS   1-CHECKED,0   
EB70   B1                     DS   1-CHECKED,0B1h   
EB71   00                     DS   1-CHECKED,IP   
EB72   E6                     DS   1-CHECKED,0E6h   
EB73   00                     DS   1-CHECKED,IP   
EB74   D0                     DS   1-CHECKED,0D0h   
EB75   02                     DS   1-CHECKED,2   
EB76   E6                     DS   1-CHECKED,0E6h   
EB77   01                     DS   1-CHECKED,IP+1   
EB78   A8                     DS   1-CHECKED,0A8h   
EB79   B9                     DS   1-CHECKED,0B9h   
EB7A   00                     DS   1-CHECKED,ADTL&0FFh   
