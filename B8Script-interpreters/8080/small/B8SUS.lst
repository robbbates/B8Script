0245   6F                     MOV   L,A   
0246   7C                     MOV   A,H   
0247   AA                     XRA   D   
0248   17                     RAL      ; carry = the signs differ
0249   9F                     SBB   A   
024A   AD                     XRA   L   ; flip when they do
024B   67                     MOV   H,A   
024C   6F                     MOV   L,A   
024D                          ;*Macro unroll:  NEXT
024D                          DS   (1-CPM)*(1-FAST),0F7h   
024D   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
024E   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
024F   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0250   D1           H_EQ:     POP   D   
0251   7D                     MOV   A,L   
0252   AB                     XRA   E   
0253   6F                     MOV   L,A   
0254   7C                     MOV   A,H   
0255   AA                     XRA   D   
0256   B5                     ORA   L   ; zero if equal
0257   D6 01                  SUI   1   ; carry only for zero
0259   9F                     SBB   A   
025A   67                     MOV   H,A   
025B   6F                     MOV   L,A   
025C                          ;*Macro unroll:  NEXT
025C                          DS   (1-CPM)*(1-FAST),0F7h   
025C   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
025D   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
025E   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
025F                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
025F                             ; multiplier is used up; only the low 16 bits are kept.
025F                          IF   QK   
                    H_MUL:    POP   D   ; DE = multiplicand
                              JMP   mulq   ; (out of the handlers' pages: see Speed-ups)
025F                          ENDIF      
025F                          IF   1-QK   
025F   D1           H_MUL:    POP   D   ; DE = multiplicand
0260   C5                     PUSH   B   
0261   44                     MOV   B,H   
0262   4D                     MOV   C,L   ; BC = multiplier
0263   21 00 00               LXI   H,0   
0266   78           MUL1:     MOV   A,B   
0267   B7                     ORA   A   ; clear carry
0268   1F                     RAR      
0269   47                     MOV   B,A   
026A   79                     MOV   A,C   
026B   1F                     RAR      
026C   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
026D   D2 71 02               JNC   mul2   
0270   19                     DAD   D   
0271   EB           MUL2:     XCHG      
0272   29                     DAD   H   ; multiplicand << 1
0273   EB                     XCHG      
0274   78                     MOV   A,B   
0275   B1                     ORA   C   
0276   C2 66 02               JNZ   mul1   
0279   C1                     POP   B   
027A                          ;*Macro unroll:  NEXT
027A                          DS   (1-CPM)*(1-FAST),0F7h   
027A   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
027B   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
