0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as
0000                             ;                 line and column, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC and HL'; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 A4 03               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 E1 03     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 CC 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 DA                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 75                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 77                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 69                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          IF   1-CHECKED   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D   C6 6A        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 00                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE 80                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0066                          ENDIF      
0066                          IFN   CPM   
0066   CB 12                  RL   D   ; its page: 0 + carry
0068                          ENDIF      
0068                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0068                          ENDIF      
0068   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0069   C9                     RET      ;   when the handler starts
006A                             ; The rest of the startup: here so that the generic reset code can reach it
006A                             ; with JR. st0: find the program's NUL; the heap starts after it.
006A                             ; (The editor build has its own copy of this, next to the editor.)
006A                             ; A checked build first clears the lower half of the letter page (A = 0):
006A                             ; every variable starts at 0, every word cell holds 0000h, the address an
006A                             ; undefined word is caught at (see e_hi), and no key is held back.
006A                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006A                          ENDIF      
006A                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
006A                          ENDIF      
006A                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
006A                          ENDIF      ;   these)
006A                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
006A                          ENDIF      
006A                             ; In the unchecked generic editor build the table is here, in the first
006A                             ; page, which saves loading D twice. (The other builds have no room for it
006A                             ; here: theirs is further down.)
006A                          IF   TABP0   
006A                PTAB:        
006A                          ;*Macro unroll:  PTABLE
006A   9E                     DB   h_store & 0FFh   
006B   A3                     DB   h_str & 0FFh   
006C   BE                     DB   h_num & 0FFh   
006D   AA                     DB   h_print & 0FFh   
006E   99                     DB   h_swap & 0FFh   
006F   41                     DB   h_and & 0FFh   
0070   BB                     DB   h_emit & 0FFh   
0071   1D                     DB   h_open & 0FFh   
0072   25                     DB   h_close & 0FFh   
0073   62                     DB   h_mul & 0FFh   
0074   38                     DB   h_add & 0FFh   
0075   E5                     DB   h_cfetch & 0FFh   
0076   30                     DB   h_sub & 0FFh   
0077   9B                     DB   h_cstore & 0FFh   
0078   76                     DB   h_div & 0FFh   
0079   97                     DB   h_dup & 0FFh   
007A   9D                     DB   h_drop & 0FFh   
007B   49                     DB   h_lt & 0FFh   
007C   58                     DB   h_eq & 0FFh   
007D   4A                     DB   h_gt & 0FFh   
007E   C4                     DB   h_key & 0FFh   
007F   18                     DB   h_fetch & 0FFh   
0080   FB                     DB   h_def & 0FFh   
0081   EE                     DB   h_break & 0FFh   
0082   EA                     DB   h_ret & 0FFh   
0083   8A                     DB   h_xor & 0FFh   
0084   9D                     DB   h_alloc & 0FFh   
0085   D8                     DB   h_grave & 0FFh   
0086   2C                     DB   h_tor & 0FFh   
0087   92                     DB   h_or & 0FFh   
0088   1C                     DB   h_fromr & 0FFh   
0089   9A                     DB   h_not & 0FFh   
008A                PTABEND:      
008A                          ENDIF      
008A                             ; =============================================================================
008A                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
008A                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
008A                             ;  is here too: it belongs to "`" and makes the page come out right.
008A                             ; =============================================================================
008A   D1           H_XOR:    POP   DE   
008B   7C                     LD   A,H   
008C   AA                     XOR   D   
008D   67                     LD   H,A   
008E   7D                     LD   A,L   
008F   AB                     XOR   E   
0090   6F                     LD   L,A   
0091   F7                     RST   30h   
0092   D1           H_OR:     POP   DE   
0093   7C                     LD   A,H   
0094   B2                     OR   D   
0095   67                     LD   H,A   
0096   7D                     LD   A,L   
0097   B3                     OR   E   
0098   6F                     LD   L,A   
0099   F7                     RST   30h   
009A   E7           H_NOT:    RST   20h   ; ~x = -x - 1
009B   2B                     DEC   HL   
009C   F7                     RST   30h   
009D                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
009D                             ; the same either way); TOS is the old pointer.
009D   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A1                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A1                          ENDIF      
00A1   19                     ADD   HL,DE   ; the new top
00A2                          IF   CHECKED   
                              CALL   chkhp   
00A2                          ENDIF      
00A2   22 7C 82               LD   (HEAP),HL   
00A5   EB                     EX   DE,HL   
00A6   F7                     RST   30h   
00A7   D9           EXEC:     EXX      
00A8   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00AB   D9                     EXX      
00AC   CD 2B 00               CALL   jphl   
00AF   D9                     EXX      
00B0   2A 34 82               LD   HL,(RSAVE)   
00B3   D9                     EXX      
00B4   E1                     POP   HL   
00B5   F7                     RST   30h   
00B6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00B6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00B6                             ; Digits: step back onto the first digit and read the whole number.
00B6   E5           DIGIT:    PUSH   HL   
00B7   0B                     DEC   BC   
00B8   CD 3E 02               CALL   rdnum   
00BB   F7                     RST   30h   
00BC                             ; a-z: push the cell's address (the cell is the variable)
00BC   E5           LOWER:    PUSH   HL   
00BD   87                     ADD   A,A   
00BE   6F                     LD   L,A   
00BF   26 82                  LD   H,LETPAGE   
00C1   F7                     RST   30h   
00C2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00C2                             ; the return stack, and the IP becomes the address in the letter's cell.
00C2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00C3   EB                     EX   DE,HL   ; park TOS
00C4   87                     ADD   A,A   
00C5   6F                     LD   L,A   
00C6   26 82                  LD   H,LETPAGE   ; HL -> cell
00C8   4E                     LD   C,(HL)   
00C9   2C                     INC   L   
00CA   46                     LD   B,(HL)   ; IP = the word's body
00CB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00CC                             ; rpushn: move the top cell of the data stack (in memory) to the return
00CC                             ; stack, then next. Everything that pushes the return stack ends here.
00CC                             ; 
00CC                             ; The break key is looked at here, so at every word call and loop-back (and
00CC                             ; block entry and "{"), but only one time in 256: B', which nothing else
00CC                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00CC                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00CC                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00CC                             ; both ways out.)
00CC   D9           RPUSHN:   EXX      
00CD   D1                     POP   DE   
00CE   2B                     DEC   HL   
00CF   72                     LD   (HL),D   
00D0   2B                     DEC   HL   
00D1   73                     LD   (HL),E   
00D2   05                     DEC   B   
00D3   D9                     EXX      
00D4   CC 66 03               CALL   Z,pollk   
00D7   F7                     RST   30h   
00D8                             ; ---- the grave -------------------------------------------------------------
00D8                             ; The grave is a prefix: with the character after it, it is one command.
00D8                             ; The characters are tested one after another, each SUB taking off the step
00D8                             ; from the one before, so A is 0 (and the carry clear) when a handler is
00D8                             ; reached. Two are here, where they keep the first page as full as the
00D8                             ; layout needs; grave2 has the rest.
00D8                             ; 
00D8                             ;   `!  ( addr -- )  calls the machine code at TOS. The code is entered by
00D8                             ;       CALL with the data stack above the return address; it must keep BC,
00D8                             ;       and on return the top cell becomes the new TOS.
00D8                             ;   `'  ( -- )  new line: CR LF
00D8   0A           H_GRAVE:   LD   A,(BC)   
00D9   03                     INC   BC   
00DA   D6 21                  SUB   "!"   
00DC   28 C9                  JR   Z,exec   
00DE   D6 06                  SUB   27h-"!"   ; "'"
00E0   C2 9B 02               JP   NZ,grave2   
00E3   3E 0D                  LD   A,13   
00E5   EF                     RST   28h   
00E6   3E 0A                  LD   A,10   
00E8   EF                     RST   28h   
00E9   F7                     RST   30h   
00EA                             ; ---- where the two pages meet ----------------------------------------------
00EA                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00EA                             ; are in falling code order for this), and where exactly differs between the
00EA                             ; builds: NPG1 follows. Every handler below these four must start in the
00EA                             ; second page, and every one above in the first; chktab.py checks both.
00EA                             ; "]" returns: pop an address and jump to it.
00EA   CF           H_RET:    RST   08h   
00EB   42                     LD   B,D   
00EC   4B                     LD   C,E   
00ED   F7           BRK1:     RST   30h   
00EE                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00EE                             ; drops the block start, "]" returns. No closer at all ends the program.
00EE   7C           H_BREAK:   LD   A,H   
00EF   B5                     OR   L   
00F0   E1                     POP   HL   
00F1   28 FA                  JR   Z,brk1   
00F3   CD 60 02               CALL   skip   
00F6   B7                     OR   A   ; skip returns 0 for ")"
00F7   20 F1                  JR   NZ,h_ret   
00F9   CF           RDROP:    RST   08h   
00FA   F7                     RST   30h   
00FB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00FB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00FB                             ; the body"s address instead. Either way it then skips to the matching "]'.
00FB                             ; (The unchecked build takes anything that is not a letter as the space; the
00FB                             ; checked build stops on it.)
00FB   0A           H_DEF:    LD   A,(BC)   
00FC   03                     INC   BC   
00FD   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00FF   5F                     LD   E,A   ;   lands 64 bytes up
0100   E6 DF                  AND   0DFh   ; fold case
0102   FE 1A                  CP   26   
0104   30 0B                  JR   NC,def2   ; not a letter
0106   CB 23                  SLA   E   
0108   16 82                  LD   D,LETPAGE   ; DE -> cell
010A   79                     LD   A,C   
010B   12                     LD   (DE),A   
010C   1C                     INC   E   
010D   78                     LD   A,B   
010E   12                     LD   (DE),A   
010F   18 03                  JR   skipnx   
0111                DEF2:        
0111                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0111                          ENDIF      
0111   E5                     PUSH   HL   ; an anonymous block: push its address
0112   60                     LD   H,B   
0113   69                     LD   L,C   
0114                SKIPNX:      
0114                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0114                          ENDIF      ;   opener, the "[", just before where it starts
0114   CD 60 02     SKIPO:    CALL   skip   
0117   F7                     RST   30h   
0118   5E           H_FETCH:   LD   E,(HL)   ; "@"
0119   23                     INC   HL   
011A   56                     LD   D,(HL)   
011B   EB                     EX   DE,HL   
011C   F7                     RST   30h   
011D                             ; =============================================================================
011D                             ;  Handlers that must start in the image's second page.
011D                             ;  "?" is the last (with "," inside it), so its long tail may run past that
011D                             ;  page.
011D                             ; =============================================================================
011D                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
011D                             ; the matching ")".
011D   7C           H_OPEN:   LD   A,H   
011E   B5                     OR   L   
011F   E1                     POP   HL   
0120   28 F2                  JR   Z,skipo   
0122   C5                     PUSH   BC   ; the block starts at the IP
0123   18 A7                  JR   rpushn   
0125                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0125                             ; drops it and carries on.
0125   7C           H_CLOSE:   LD   A,H   
0126   B5                     OR   L   
0127   E1                     POP   HL   
0128   28 CF                  JR   Z,rdrop   
012A   CF                     RST   08h   ; pop the block start ...
012B   42                     LD   B,D   
012C   4B                     LD   C,E   
012D   C5                     PUSH   BC   
012E   18 9C                  JR   rpushn   ; ... and push it back
0130                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0130                             ; "-" has two jobs: directly before a digit it starts a negative number.
0130   0A           H_SUB:    LD   A,(BC)   
0131   D6 30                  SUB   "0"   
0133   FE 0A                  CP   10   
0135   38 04                  JR   C,negnum   
0137   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0138   D1           H_ADD:    POP   DE   
0139   19                     ADD   HL,DE   
013A   F7                     RST   30h   
013B   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
013C   CD 3E 02               CALL   rdnum   
013F   E7                     RST   20h   
0140   F7                     RST   30h   
0141   D1           H_AND:    POP   DE   
0142   7C                     LD   A,H   
0143   A2                     AND   D   
0144   67                     LD   H,A   
0145   7D                     LD   A,L   
0146   A3                     AND   E   
0147   6F                     LD   L,A   
0148   F7                     RST   30h   
0149                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0149                             ; cells first. Flipping both sign bits turns a signed compare into an
0149                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0149                             ; carry into -1 or 0 with no branch.
0149   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
014A   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
014B   7C                     LD   A,H   
014C   EE 80                  XOR   80h   
014E   67                     LD   H,A   
014F   7A                     LD   A,D   
0150   EE 80                  XOR   80h   
0152   57                     LD   D,A   
0153   ED 52                  SBC   HL,DE   ; carry if HL < DE
0155   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0157   F7                     RST   30h   
0158   D1           H_EQ:     POP   DE   
0159   B7                     OR   A   
015A   ED 52                  SBC   HL,DE   
015C   7C                     LD   A,H   
015D   B5                     OR   L   
015E   FE 01                  CP   1   ; carry only if a - b = 0
0160   18 F3                  JR   tf   
0162                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0162                             ; multiplier shifts up through A:C.
0162   D1           H_MUL:    POP   DE   ; DE = multiplicand
0163   C5                     PUSH   BC   
0164   7C                     LD   A,H   
0165   4D                     LD   C,L   ; A:C = multiplier
0166   21 00 00               LD   HL,0   
0169   06 10                  LD   B,16   
016B   29           MUL1:     ADD   HL,HL   
016C   CB 21                  SLA   C   
016E   17                     RLA      
016F   30 01                  JR   NC,mul2   
0171   19                     ADD   HL,DE   
0172   10 F7        MUL2:     DJNZ   mul1   
0174   C1                     POP   BC   
0175   F7                     RST   30h   
0176                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0176                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0176                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0176                             ; stops on it.
0176                H_DIV:       
0176                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0176                          ENDIF      
0176   D1                     POP   DE   ; DE = a, HL = b
0177   C5                     PUSH   BC   ; free BC for udiv
0178   D5                     PUSH   DE   ; a, for r's sign
0179   7A                     LD   A,D   
017A   AC                     XOR   H   
017B   F5                     PUSH   AF   ; S flag = sign of q
017C   CB 7C                  BIT   7,H   
017E   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0181   EB                     EX   DE,HL   
0182   CB 7C                  BIT   7,H   
0184   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0187   CD 18 02               CALL   udiv   ; HL = q, DE = r
018A   F1                     POP   AF   
018B   FC 20 00               CALL   M,neg16   ; q's sign
018E   EB                     EX   DE,HL   ; HL = r, DE = q
018F   F1                     POP   AF   ; A = a's high byte
0190   B7                     OR   A   
0191   FC 20 00               CALL   M,neg16   ; r's sign
0194   C1                     POP   BC   
0195   D5                     PUSH   DE   ; q under r
0196   F7                     RST   30h   
0197                             ; ---- stack and storage -----------------------------------------------------
0197   E5           H_DUP:    PUSH   HL   ; ":"
0198   F7                     RST   30h   
0199   E3           H_SWAP:   EX   (SP),HL   ; "%"
019A   F7                     RST   30h   
019B                             ; (The checked build tests the address before it takes the value off the
019B                             ; stack, so that an error report shows both.)
019B                H_CSTORE:      ; "." ( c addr -- )
019B                          IF   CHECKED   
                              CALL   chkst   
019B                          ENDIF      
019B   D1                     POP   DE   
019C   73                     LD   (HL),E   
019D   DF           H_DROP:   RST   18h   ; ";" is this one byte
019E                H_STORE:      ; "!" ( n addr -- )
019E                          IF   CHECKED   
                              CALL   chkst   
019E                          ENDIF      
019E   D1                     POP   DE   
019F   73                     LD   (HL),E   
01A0   23                     INC   HL   
01A1   72                     LD   (HL),D   
01A2   DF                     RST   18h   
01A3                             ; ---- console ---------------------------------------------------------------
01A3                             ; 22h pushes the address of the text after it and skips the string.
01A3   E5           H_STR:    PUSH   HL   
01A4   60                     LD   H,B   
01A5   69                     LD   L,C   
01A6   CD 55 02               CALL   skipstr   
01A9                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01A9                          ENDIF      
01A9   F7                     RST   30h   
01AA                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01AA                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01AA                             ; bit 6, so // and /" give themselves).
01AA                          IF   1-CHECKED   
01AA   7E           H_PRINT:   LD   A,(HL)   
01AB   23                     INC   HL   
01AC   FE 22                  CP   22h   
01AE   28 0D                  JR   Z,pr9   
01B0   FE 2F                  CP   "/"   
01B2   20 04                  JR   NZ,pr1   
01B4   7E                     LD   A,(HL)   
01B5   23                     INC   HL   
01B6   E6 BF                  AND   0BFh   
01B8   EF           PR1:      RST   28h   
01B9   18 EF                  JR   h_print   
01BB                          ENDIF      
01BB                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
01BB                          ENDIF      
01BB   7D           H_EMIT:   LD   A,L   ; "'"
01BC   EF                     RST   28h   
01BD   DF           PR9:      RST   18h   
01BE                             ; "#" prints TOS as a signed decimal number, with no space after it.
01BE   C5           H_NUM:    PUSH   BC   
01BF   CD 81 02               CALL   psgn   
01C2   C1                     POP   BC   
01C3   DF                     RST   18h   
01C4                             ; "?" ( n -- c ) or ( -n -- addr )
01C4                             ;   n > 0: wait about n ms for a key; 0 if none came
01C4                             ;   n = 0: wait for a key
01C4                             ;          (both stir the random seed while they wait: see kt2)
01C4                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C4                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C4   CB 7C        H_KEY:    BIT   7,H   
01C6   20 22                  JR   NZ,line   
01C8   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01CA   CD 94 03     KT2:      CALL   getk   
01CD   20 17                  JR   NZ,kt3   
01CF   1D                     DEC   E   
01D0   20 F8                  JR   NZ,kt2   
01D2   EB                     EX   DE,HL   ; a millisecond with no key stirs the random
01D3   2A 76 82               LD   HL,(SEED)   ;   seed by one: how long a key takes to come
01D6   23                     INC   HL   ;   is the one thing here that is not the
01D7   22 76 82               LD   (SEED),HL   ;   same every time
01DA   EB                     EX   DE,HL   
01DB   7C                     LD   A,H   ; 0? never counts down: it waits
01DC   B5                     OR   L   
01DD   28 E9                  JR   Z,kt1   
01DF   2B                     DEC   HL   
01E0   7C                     LD   A,H   
01E1   B5                     OR   L   
01E2   20 E4                  JR   NZ,kt1   ; A = 0 if the time ran out
01E4   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01E5   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01E6   6F           KT3:      LD   L,A   
01E7   26 00                  LD   H,0   
01E9   F7                     RST   30h   
01EA                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01EA                          ENDIF      
01EA                          IFN   CPM   
01EA                             ; Generic: Backspace takes the last character back (and is echoed as
01EA                             ; it is), CR ends (stored, not echoed), every other key is stored and
01EA                             ; echoed until the line is full. The line buffer starts at offset 80h
01EA                             ; of its page, so L alone is the place in the line: D holds the L of
01EA                             ; a full line.
01EA   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01ED   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01EE   9F                     SBC   A,A   
01EF   A5                     AND   L   ; (0 for a count that is too big)
01F0   2F                     CPL      
01F1   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01F2                             ;   at most
01F2   21 80 82               LD   HL,LINEBUF   
01F5   CD 94 03     LN2:      CALL   getk   
01F8   28 FB                  JR   Z,ln2   
01FA   FE 0D                  CP   13   
01FC   28 16                  JR   Z,ln5   
01FE   FE 08                  CP   8   
0200   28 0B                  JR   Z,ln4   
0202   5F                     LD   E,A   
0203   7D                     LD   A,L   
0204   BA                     CP   D   
0205   28 EE                  JR   Z,ln2   ; full
0207   73                     LD   (HL),E   
0208   2C                     INC   L   
0209   7B                     LD   A,E   
020A   EF           LN3:      RST   28h   
020B   18 E8                  JR   ln2   
020D   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
020E   FA 0A 02               JP   M,ln3   ;   unless the line was empty (L left the
0211   2C                     INC   L   ;   upper half of the page)
0212   18 E1                  JR   ln2   
0214   77           LN5:      LD   (HL),A   ; the CR
0215                          ENDIF      
0215   2E 80                  LD   L,LINEBUF & 0FFh   
0217   F7                     RST   30h   
0218                             ; =============================================================================
0218                             ;  More routines (no handler starts past this point)
0218                             ; =============================================================================
0218                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0218                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0218                             ; while the quotient bits arrive at the bottom of C.
0218                             ; Dividing by 2 is one shift (the spec wants that fast).
0218   7B           UDIV:     LD   A,E   
0219   EE 02                  XOR   2   
021B   B2                     OR   D   
021C   20 07                  JR   NZ,udv0   
021E   CB 3C                  SRL   H   
0220   CB 1D                  RR   L   ; the quotient
0222   8F                     ADC   A,A   
0223   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0224   C9                     RET      
0225   7C           UDV0:     LD   A,H   
0226   4D                     LD   C,L   
0227   21 00 00               LD   HL,0   
022A   06 10                  LD   B,16   
022C   CB 21        UDV1:     SLA   C   
022E   17                     RLA      
022F   ED 6A                  ADC   HL,HL   
0231   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0233   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0235   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0236   0D                     DEC   C   ;   INC below
0237   0C           UDV2:     INC   C   ; a quotient bit
0238   10 F2                  DJNZ   udv1   
023A   EB                     EX   DE,HL   ; DE = remainder
023B   67                     LD   H,A   
023C   69                     LD   L,C   ; HL = quotient
023D   C9                     RET      
023E                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
023E                             ; non-digit. Values wrap at 16 bits, as the spec says.
023E   21 00 00     RDNUM:    LD   HL,0   
0241   0A           RDN1:     LD   A,(BC)   
0242   D6 30                  SUB   "0"   
0244   FE 0A                  CP   10   
0246   D0                     RET   NC   
0247   03                     INC   BC   
0248   54                     LD   D,H   
0249   5D                     LD   E,L   
024A   29                     ADD   HL,HL   
024B   29                     ADD   HL,HL   
024C   19                     ADD   HL,DE   
024D   29                     ADD   HL,HL   ; HL * 10
024E   5F                     LD   E,A   
024F   16 00                  LD   D,0   
0251   19                     ADD   HL,DE   
0252   18 ED                  JR   rdn1   
0254                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0254                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0254                          IF   1-CHECKED   
0254   03           SS0:      INC   BC   
0255   0A           SKIPSTR:   LD   A,(BC)   
0256   03                     INC   BC   
0257   FE 2F                  CP   "/"   
0259   28 F9                  JR   Z,ss0   
025B   FE 22                  CP   22h   
025D   20 F6                  JR   NZ,skipstr   
025F   C9                     RET      
0260                          ENDIF      
0260                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0260                          ENDIF      
0260                             ; skip: read past text to the closer at this level, and return A = 0 if it
0260                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0260                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0260                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0260                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0260                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0260                             ; 
0260                             ; The checked build also looks at the character the skip was started by,
0260                             ; which is always the one just before where it starts: "(" must end at ")",
0260                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0260                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0260                             ; place where the skip started, for the report.
0260                SKIP:        
0260                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0260                          ENDIF      
0260   16 00                  LD   D,0   
0262   14           SK3:      INC   D   ; an opener: one deeper
0263   0A           SK1:      LD   A,(BC)   
0264                          IF   1-CHECKED   
0264   03                     INC   BC   
0265   B7                     OR   A   
0266   CA E0 03               JP   Z,SKEND   ; (the end of the program)
0269                          ENDIF      
0269                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0269                          ENDIF      
0269   FE 22                  CP   22h   
026B   CC 55 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
026E   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0270   28 F0                  JR   Z,sk3   
0272   3D                     DEC   A   ; ")"
0273   28 08                  JR   Z,sk4   
0275   D6 32                  SUB   "["-")"   
0277   28 E9                  JR   Z,sk3   
0279   FE 02                  CP   "]"-"["   
027B   20 E6                  JR   NZ,sk1   
027D   15           SK4:      DEC   D   
027E                          IF   1-CHECKED   
027E   C8                     RET   Z   ; the closer at this level
027F   18 E2                  JR   sk1   
0281                          ENDIF      
0281                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0281                          ENDIF      
0281                             ; psgn: print HL as a signed number. Uses BC.
0281   CB 7C        PSGN:     BIT   7,H   
0283   28 04                  JR   Z,pdec   
0285   3E 2D                  LD   A,"-"   
0287   EF                     RST   28h   
0288   E7                     RST   20h   
0289                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0289                             ; Uses BC.
0289   11 0A 00     PDEC:     LD   DE,10   
028C   CD 18 02               CALL   udiv   ; HL = HL / 10, E = the last digit
028F   7B                     LD   A,E   
0290   F5                     PUSH   AF   
0291   7C                     LD   A,H   
0292   B5                     OR   L   
0293   C4 89 02               CALL   NZ,pdec   
0296   F1                     POP   AF   
0297   C6 30                  ADD   A,"0"   
0299   EF                     RST   28h   
029A   C9                     RET      
029B                             ; =============================================================================
029B                             ;  The grave's other codes. h_grave comes here with A = the character minus
029B                             ;  27h, not zero; the tests carry on from there. The four characters from
029B                             ;  "+" to "." follow one another, so one range test finds them and two
029B                             ;  rotates tell them apart.
029B                             ; 
029B                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
029B                             ;        from addr until a non-hex character; then a RET (C9h) is written
029B                             ;        and its address is left. An odd last digit is consumed and dropped.
029B                             ;    `+  ( addr -- n )   add 1 to the cell at addr and leave its new value
029B                             ;    `,  ( n -- r )      a random number from 0 to n-1 (n is 1 to 32767)
029B                             ;    `-  ( addr -- n )   subtract 1 from the cell at addr, the same way
029B                             ;    `.  ( -- addr )     the address of the random seed
029B                             ;    `<  ( a b -- n )    the smaller of the two (signed)
029B                             ;    `>  ( a b -- n )    the larger
029B                             ;    `?  ( flag -- )     the cursor off (0) or on
029B                             ;    `@  ( row col -- )  the cursor to that row and column, both from 0
029B                             ;    `^  ( -- )          clear the screen and home the cursor
029B                             ;    `_  ( -- )          clear from the cursor to the end of the line
029B                             ; 
029B                             ;  Any other character is unsafe: the unchecked build takes it as "_", the
029B                             ;  checked build stops with W.
029B                             ; =============================================================================
029B   D6 04        GRAVE2:   SUB   "+"-27h   ; "+" "," "-" "." leave 0 to 3
029D   FE 04                  CP   4   
029F   30 32                  JR   NC,gv2   
02A1   1F                     RRA      ; carry: "," or "."; bit 0 of A: "-" or "."
02A2   38 0E                  JR   C,gv3   
02A4                             ; `+ and `-: one routine.
02A4                          IF   CHECKED   
                              LD   D,A   ; (the checked build tests the address first,
                              CALL   chkst   ;   as "!" does: the test uses A, and under
                              LD   A,D   ;   CP/M E too)
02A4                          ENDIF      
02A4   5E                     LD   E,(HL)   
02A5   23                     INC   HL   
02A6   56                     LD   D,(HL)   
02A7   1F                     RRA      ; carry: "-"
02A8   38 02                  JR   C,gi1   
02AA   13                     INC   DE   
02AB   13                     INC   DE   
02AC   1B           GI1:      DEC   DE   
02AD   72                     LD   (HL),D   
02AE   2B                     DEC   HL   
02AF   73                     LD   (HL),E   
02B0   EB                     EX   DE,HL   ; the new value is TOS
02B1   F7                     RST   30h   
02B2   1F           GV3:      RRA      ; carry: "."
02B3   38 19                  JR   C,g_seed   
02B5                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
02B5                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
02B5                             ; and the low ones repeat soon, so the high byte is folded into the low
02B5                             ; (XOR) before the remainder of dividing by n is taken.
02B5                             ; n must be 1 to 32767: the checked build stops with Z on anything less
02B5                             ; than 1.
02B5                G_RND:       
02B5                          IF   CHECKED   
                              DEC   HL   
                              BIT   7,H   ; n - 1 negative: n is 0 or less
                              INC   HL   
                              JP   NZ,e_zero   
02B5                          ENDIF      
02B5   EB                     EX   DE,HL   ; DE = n
02B6   C5                     PUSH   BC   
02B7   2A 76 82               LD   HL,(SEED)   
02BA   44                     LD   B,H   
02BB   4D                     LD   C,L   
02BC   29                     ADD   HL,HL   
02BD   29                     ADD   HL,HL   
02BE   09                     ADD   HL,BC   ; * 5
02BF   23                     INC   HL   ; + 1
02C0   7C                     LD   A,H   
02C1   81                     ADD   A,C   
02C2   67                     LD   H,A   ; + * 256: * 261 + 1
02C3   22 76 82               LD   (SEED),HL   
02C6   AD                     XOR   L   ; (A is still the high byte)
02C7   6F                     LD   L,A   
02C8   CD 18 02               CALL   udiv   ; DE = the remainder
02CB   EB                     EX   DE,HL   
02CC   C1                     POP   BC   
02CD   F7                     RST   30h   
02CE                             ; `. pushes the address of the random seed.
02CE   E5           G_SEED:   PUSH   HL   
02CF   21 76 82               LD   HL,SEED   
02D2   F7                     RST   30h   
02D3   C6 07        GV2:      ADD   A,"+"-"$"   ; "$"
02D5   20 13                  JR   NZ,gv4   
02D7   CD 54 03     HX1:      CALL   hexc   
02DA   30 0B                  JR   NC,hx2   
02DC   77                     LD   (HL),A   ; the high digit goes in first ...
02DD   CD 54 03               CALL   hexc   
02E0   30 05                  JR   NC,hx2   ; odd digit: consumed, and the RET below
02E2   ED 6F                  RLD      ;   overwrites it
02E4   23                     INC   HL   ; ... and RLD shifts it up under the low one
02E5   18 F0                  JR   hx1   
02E7   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
02E9   F7                     RST   30h   
02EA   D6 18        GV4:      SUB   "<"-"$"   
02EC   28 1F                  JR   Z,g_min   
02EE   D6 02                  SUB   ">"-"<"   
02F0   28 1A                  JR   Z,g_max   
02F2   3D                     DEC   A   ; "?"
02F3   28 2A                  JR   Z,g_cur   
02F5   3D                     DEC   A   ; "@"
02F6   28 3D                  JR   Z,g_at   
02F8   D6 1E                  SUB   "^"-"@"   ; "^" leaves 0 and "_" leaves 1
02FA                          IF   CHECKED   
                              CP   2   
                              JP   NC,e_brack   ; anything else: W. The place is the character
                              OR   A   
02FA                          ENDIF      
02FA                          IF   ANSI   
02FA   20 07                  JR   NZ,ge1   
02FC   CD 4D 03               CALL   csi   ; "^": ESC [ H homes the cursor, and then
02FF   3E 48                  LD   A,"H"   ;   ESC [ J clears from there to the end of
0301   EF                     RST   28h   ;   the screen
0302   AF                     XOR   A   
0303   C6 4A        GE1:      ADD   A,"J"   ; "_": ESC [ K clears to the end of the line
0305   5F                     LD   E,A   
0306   CD 4D 03               CALL   csi   
0309   7B                     LD   A,E   
030A   EF                     RST   28h   
030B   F7                     RST   30h   
030C                          ENDIF      
030C                          IF   1-ANSI   
                              JR   NZ,ge1   
                              CALL   CONCLS   
                              RST   30h   
                    GE1:      CALL   CONEOL   
                              RST   30h   
030C                          ENDIF      
030C                             ; `< and `>. The carry says which: set for the larger. The two are put in
030C                             ; order, HL the smaller and DE the larger, and then swapped for ">".
030C                             ; b < a (signed) is the borrow of b - a, turned round if the two signs
030C                             ; differ: RRA puts the borrow in bit 7, where the two XORs meet it.
030C   37           G_MAX:    SCF      ; ("<" comes in with the carry clear)
030D   D1           G_MIN:    POP   DE   ; DE = a, HL = b
030E   F5                     PUSH   AF   
030F   7D                     LD   A,L   
0310   93                     SUB   E   
0311   7C                     LD   A,H   
0312   9A                     SBC   A,D   
0313   1F                     RRA      
0314   AC                     XOR   H   
0315   AA                     XOR   D   
0316   17                     RLA      ; carry: b < a
0317   38 01                  JR   C,gm2   
0319   EB                     EX   DE,HL   
031A   F1           GM2:      POP   AF   
031B   30 01                  JR   NC,gm3   
031D   EB                     EX   DE,HL   
031E   F7           GM3:      RST   30h   
031F                          IF   ANSI   
031F                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
031F   CD 4D 03     G_CUR:    CALL   csi   
0322   3E 3F                  LD   A,"?"   
0324   EF                     RST   28h   
0325   3E 32                  LD   A,"2"   
0327   EF                     RST   28h   
0328   3E 35                  LD   A,"5"   
032A   EF                     RST   28h   
032B   7C                     LD   A,H   
032C   B5                     OR   L   
032D   3E 6C                  LD   A,"l"   
032F   28 02                  JR   Z,gc1   
0331   3E 68                  LD   A,"h"   
0333   EF           GC1:      RST   28h   
0334   DF                     RST   18h   
0335                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
0335   D1           G_AT:     POP   DE   ; DE = the row
0336   C5                     PUSH   BC   ; (pdec uses BC)
0337   E5                     PUSH   HL   ; the column
0338   EB                     EX   DE,HL   
0339   CD 4D 03               CALL   csi   
033C   23                     INC   HL   
033D   CD 89 02               CALL   pdec   
0340   3E 3B                  LD   A,";"   
0342   EF                     RST   28h   
0343   E1                     POP   HL   
0344   23                     INC   HL   
0345   CD 89 02               CALL   pdec   
0348   3E 48                  LD   A,"H"   
034A   EF                     RST   28h   
034B   C1                     POP   BC   
034C   DF                     RST   18h   
034D                             ; csi: print ESC [, which starts every ANSI sequence. Keeps all but A.
034D   3E 1B        CSI:      LD   A,27   
034F   EF                     RST   28h   
0350   3E 5B                  LD   A,"["   
0352   EF                     RST   28h   
0353   C9                     RET      
0354                          ENDIF      
0354                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    LD   A,H   
                              OR   L   
                              CALL   CONCUR   
                              RST   18h   
                    G_AT:     POP   DE   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   18h   
0354                          ENDIF      
0354                             ; =============================================================================
0354                             ;  Dispatch table: the low byte of each handler's address, in code order
0354                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0354                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0354                             ; =============================================================================
0354                             ; The handlers of the first NPG1 characters start in the image's second page.
0354                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0354                             ; differs between the builds, so the count is worked out here.
0354                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0354                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0354                PGBRK:    EQU   (h_break-BASE)/256   
0354                PGDEF:    EQU   (h_def-BASE)/256   
0354                PGFET:    EQU   (h_fetch-BASE)/256   
0354                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0354                          IF   1-TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0354                          ENDIF      
0354                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0354                             ; and return its value in A with the carry set; otherwise leave the IP and
0354                             ; return with the carry clear.
0354   0A           HEXC:     LD   A,(BC)   
0355   D6 30                  SUB   "0"   
0357   FE 0A                  CP   10   
0359   38 09                  JR   C,hc1   
035B   E6 DF                  AND   0DFh   
035D   D6 11                  SUB   11h   
035F   FE 06                  CP   6   
0361   D0                     RET   NC   
0362   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0364   03           HC1:      INC   BC   
0365   C9                     RET      
0366                             ; =============================================================================
0366                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0366                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0366                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
0366                             ;  they are the host's KEY and CONOUT routines themselves.
0366                             ; 
0366                             ;  A running program reads the keyboard only through getk and pollk, which
0366                             ;  between them give the break key its rules:
0366                             ;    - Ctrl-C stops the program;
0366                             ;    - any other key that the break check reads is held in KEYBUF for the
0366                             ;      next "?", and a newer one takes its place;
0366                             ;    - "?" (getk) takes the held key first;
0366                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0366                             ;      key like any other, but two of them within about 250 ms still stop it.
0366                             ;  Both are called straight from a handler, never from a routine under one:
0366                             ;  the checked build's report counts on finding one return address above the
0366                             ;  data stack.
0366                             ; =============================================================================
0366                          IFN   CPM   
0366                RAWK:     EQU   KEY   
0366                          ENDIF      
0366                             ; pollk: the break check (see rpushn).
0366   CD 06 FF     POLLK:    CALL   rawk   
0369   C8                     RET   Z   ; no key
036A   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
036D   FE 03        PK1:      CP   3   ; (getk joins here)
036F   C0                     RET   NZ   
0370                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0370                             ; the program has turned it off, wait about 250 ms for one more key: a
0370                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0370                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0370   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0373   B7                     OR   A   
0374   CA DC 03     CT0:      JP   Z,brk   
0377   D5                     PUSH   DE   
0378   11 10 27               LD   DE,250*MSLOOP   
037B   CD 06 FF     CT1:      CALL   rawk   
037E   20 05                  JR   NZ,ct2   
0380   1B                     DEC   DE   
0381   7A                     LD   A,D   
0382   B3                     OR   E   
0383   20 F6                  JR   NZ,ct1   
0385   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0386   FE 03                  CP   3   
0388   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
038A   B7                     OR   A   
038B   28 03                  JR   Z,ct3   
038D   32 7A 82               LD   (KEYBUF),A   
0390   3E 03        CT3:      LD   A,3   
0392   B7                     OR   A   
0393   C9                     RET      
0394                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0394   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0395   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0398   7E                     LD   A,(HL)   
0399   36 00                  LD   (HL),0   
039B   E1                     POP   HL   
039C   B7                     OR   A   
039D   C0                     RET   NZ   
039E   CD 06 FF               CALL   rawk   
03A1   C8                     RET   Z   
03A2   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
03A4                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
03A4                          ENDIF      ;   (with the editor, both stacks are cleared);
03A4                          IF   (1-CHECKED)*EDITOR   
03A4                BRK:      EQU   edit0   
03A4                          ENDIF      
03A4                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
03A4                          ENDIF      
03A4                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
03A4                          ENDIF      
03A4                             ; =============================================================================
03A4                             ;  Checked build: the checks and the error report
03A4                             ; =============================================================================
03A4                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
03A4                          ENDIF      
03A4                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03A4                          ENDIF      
03A4                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
03A4                          ENDIF      
03A4                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
03A4                          ENDIF      
03A4                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
03A4                          ENDIF      
03A4                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03A4                          ENDIF      
03A4                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop prstr's return
                              POP   HL   ;   address, put the string's address back in
                              DB   11h   ;   TOS, and step over the next two bytes: Q
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
                                 ;                       Rtn n
                                 ; TOS is in memory with the rest (pushed).
                              CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
                              ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
                              RST   20h   ;   with the first value and holds nothing)
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,B   ; C = the number of cells to show (B is 0:
                                 ;   phalf left the depth in BC)
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              PUSH   BC   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   BC   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      ; twice the depth is RSTOP less the pointer:
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough, since even an
                              SUB   L   ;   overflowing stack holds under 128 entries
                              EXX      
                              LD   L,A   
                              LD   H,B   ; (B is still 0)
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
03A4                          ENDIF      
03A4                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
03A4                          ENDIF      
03A4                          IF   CHECKED*EDITOR   
                              JP   edit0   ; back to the editor, with both stacks cleared
03A4                          ENDIF      
03A4                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A
                                 ; NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
03A4                          ENDIF      
03A4                             ; =============================================================================
03A4                             ;  The line editor (EDITOR = 1)
03A4                             ; 
03A4                             ;  The interpreter starts here, and a program that ends comes back here.
03A4                             ;  There is no prompt. It follows the spec's suggested standard for a line
03A4                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
03A4                             ; 
03A4                             ;    n text    put the text in as line n; the lines from n on move down. A
03A4                             ;              number past the end (or 0) adds the line at the end.
03A4                             ;    n         take line n out
03A4                             ;    anything else is run at once, as B8Script. (Start such a line with a
03A4                             ;    space if it would begin with a digit.)
03A4                             ; 
03A4                             ;  A command key ends the line too, and takes what was typed as its argument:
03A4                             ; 
03A4                             ;    ^G        run the program
03A4                             ;    n ^L      list from line n (no number: all of it). Any key holds the
03A4                             ;              list until another key is pressed; Ctrl-C ends it.
03A4                             ;    n ^E      put line n in the input line; Return puts it back, changed
03A4                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
03A4                             ;              last time). Generic: what is typed, or pasted, from now until
03A4                             ;              ^Z replaces the program; it is not echoed.
03A4                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
03A4                             ;              time). Generic: the text is printed, as it is.
03A4                             ;    ^N ^N     new: no program (the key twice in a row)
03A4                             ;    ^X        leave (to LEAVE)
03A4                             ; 
03A4                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
03A4                             ;  a character goes in at the cursor; Backspace and DEL take out the one
03A4                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
03A4                             ;  sent to the terminal, so any terminal will do.
03A4                             ; 
03A4                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
03A4                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
03A4                             ;  125 characters; the one character after a line number separates it from
03A4                             ;  the text and is not stored. The text is kept as it is typed, each line
03A4                             ;  ending in CR LF, at PROG.
03A4                             ; 
03A4                             ;  What lasts from one line to the next: the program, the words, the
03A4                             ;  variables and the data stack. An error or a break clears both stacks. The
03A4                             ;  return stack starts empty for every line.
03A4                             ; 
03A4                             ;  Things to know:
03A4                             ;    - Reset empties the program (generic builds).
03A4                             ;    - A word's address points into the program, so run the program again
03A4                             ;      after editing it.
03A4                             ;    - Nothing is printed between a program's output and what is typed next.
03A4                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
03A4                             ;      a line that calls -n? and carries on afterwards runs what was typed.
03A4                             ;      (The stored program never comes back to the line, so it may.)
03A4                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
03A4                             ;      read of the other builds (BDOS 10 under CP/M).
03A4                             ; 
03A4                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
03A4                             ;  the last line left there, with TOS pushed like the rest.
03A4                             ; =============================================================================
03A4                          IF   EDGEN   
03A4                INIT:        ; reset (A = 0)
03A4                          ENDIF      
03A4                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
03A4                          ENDIF      
03A4                          IF   EDGEN   
03A4   18 36                  JR   edit0   
03A6                          ENDIF      
03A6                          IF   EDITOR   
03A6                             ; ^F, right arrow: one to the right, by printing the character there
03A6   7D           RIGHT:    LD   A,L   
03A7   BB                     CP   E   
03A8   28 4A                  JR   Z,ed1   ; at the end
03AA   7E                     LD   A,(HL)   
03AB   2C                     INC   L   
03AC   18 2B                  JR   lf1   
03AE                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
03AE                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
03AE                             ; ends the sequence, and act on C (right) and D (left).
03AE   01 C8 00     ESC:      LD   BC,5*MSLOOP   
03B1   CD 06 FF     ES1:      CALL   rawk   
03B4   20 0A                  JR   NZ,es2   
03B6   0B                     DEC   BC   
03B7   78                     LD   A,B   
03B8   B1                     OR   C   
03B9   20 F6                  JR   NZ,es1   
03BB   CD 29 04               CALL   fin   ; no second key: the line is dropped
03BE   18 22                  JR   edit   
03C0   FE 5B        ES2:      CP   "["   
03C2   20 30                  JR   NZ,ed1   ; not a sequence known here
03C4   CD 82 04     ES3:      CALL   ekey   
03C7   FE 40                  CP   40h   
03C9   38 F9                  JR   C,es3   ; (its parameters)
03CB   D6 43                  SUB   "C"   
03CD   28 D7                  JR   Z,right   
03CF   3D                     DEC   A   ; "D"?
03D0   20 22                  JR   NZ,ed1   ; no: on into left
03D2                             ; ^B, left arrow: the cursor goes one to the left
03D2   7D           LEFT:     LD   A,L   
03D3   87                     ADD   A,A   
03D4   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
03D6   2D                     DEC   L   
03D7   3E 08                  LD   A,8   
03D9   EF           LF1:      RST   28h   
03DA   18 18                  JR   ed1   
03DC                             ; edit0: reset, an error or a break: both stacks are cleared.
03DC                             ; skend: a program that ended inside skip: its return address goes.
03DC                             ; edend: a program that ended: TOS joins the rest of the data stack.
03DC   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
03DF   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
03E0   D1           SKEND:    POP   DE   
03E1   E5           EDEND:    PUSH   HL   
03E2                             ; edit: start a new input line.
03E2   D9           EDIT:     EXX      
03E3   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
03E6   D9                     EXX      
03E7   21 00 00               LD   HL,0   
03EA   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
03ED   22 3A 82               LD   (EDLN),HL   ; no line is being edited
03F0   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
03F3   5D                     LD   E,L   ;   E = the end of the line (its low byte)
03F4   CD 82 04     ED1:      CALL   ekey   
03F7   FE 7F                  CP   7Fh   
03F9   28 40                  JR   Z,bsp   ; DEL
03FB   FE 20                  CP   " "   
03FD   30 56                  JR   NC,insc   
03FF   FE 09                  CP   9   
0401   28 52                  JR   Z,insc   ; Tab is text
0403   FE 08                  CP   8   
0405   28 34                  JR   Z,bsp   
0407   FE 02                  CP   2   
0409   28 C7                  JR   Z,left   ; ^B
040B   FE 06                  CP   6   
040D   28 97                  JR   Z,right   ; ^F
040F   FE 1B                  CP   1Bh   
0411   28 9B                  JR   Z,esc   
0413   E5                     PUSH   HL   ; a command key? Look it up
0414   21 88 04               LD   HL,cmds   
0417   06 08                  LD   B,NCMD   
0419   BE           ED2:      CP   (HL)   
041A   23                     INC   HL   
041B   28 07                  JR   Z,ed3   
041D   23                     INC   HL   
041E   23                     INC   HL   
041F   10 F8                  DJNZ   ed2   
0421   E1                     POP   HL   
0422   18 D0                  JR   ed1   ; no: the key is ignored
0424   7E           ED3:      LD   A,(HL)   
0425   23                     INC   HL   
0426   66                     LD   H,(HL)   
0427   6F                     LD   L,A   
0428   E3                     EX   (SP),HL   ; the command's address: fin returns to it
0429                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
0429                             ; terminal. Leaves BC -> the line and HL -> the NUL.
0429   26 82        FIN:      LD   H,LETPAGE   
042B   6B                     LD   L,E   
042C   36 0D                  LD   (HL),13   
042E   2C                     INC   L   
042F   36 0A                  LD   (HL),10   
0431   2D                     DEC   L   
0432   CD 86 05               CALL   prl   ; (prints the CR LF)
0435   36 00                  LD   (HL),0   
0437   01 80 82               LD   BC,LINEBUF   
043A   C9                     RET      
043B                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
043B                             ; left, the rest of the line moves down over it, and the last place (now a
043B                             ; space) is printed over along with the rest.
043B   7D           BSP:      LD   A,L   
043C   87                     ADD   A,A   
043D   28 B5                  JR   Z,ed1   ; at the start
043F   2D                     DEC   L   
0440   3E 08                  LD   A,8   
0442   EF                     RST   28h   
0443   E5                     PUSH   HL   
0444   2C           BS1:      INC   L   
0445   7E                     LD   A,(HL)   
0446   2D                     DEC   L   
0447   77                     LD   (HL),A   
0448   2C                     INC   L   
0449   7D                     LD   A,L   
044A   BB                     CP   E   
044B   20 F7                  JR   NZ,bs1   
044D   2D                     DEC   L   
044E   36 20                  LD   (HL)," "   
0450   E1                     POP   HL   
0451   53                     LD   D,E   
0452   1D                     DEC   E   
0453   18 15                  JR   ic2   
0455                             ; A character goes in at the cursor: it ripples up through the rest of the
0455                             ; line, the cursor moves on, and the rest is printed again.
0455   47           INSC:     LD   B,A   
0456   7B                     LD   A,E   
0457   FE FD                  CP   0FDh   
0459   28 99                  JR   Z,ed1   ; the line is full: 125 characters
045B   78                     LD   A,B   
045C   EF                     RST   28h   
045D   E5                     PUSH   HL   
045E   7E           IC1:      LD   A,(HL)   
045F   70                     LD   (HL),B   
0460   47                     LD   B,A   
0461   7D                     LD   A,L   
0462   2C                     INC   L   
0463   BB                     CP   E   
0464   20 F8                  JR   NZ,ic1   
0466   E1                     POP   HL   
0467   2C                     INC   L   
0468   1C                     INC   E   
0469   53                     LD   D,E   
046A   CD 6F 04     IC2:      CALL   tail   
046D   18 85                  JR   ed1   
046F                             ; tail: print the line from the cursor to D (a low byte), and bring the
046F                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
046F   4D           TAIL:     LD   C,L   
0470   7D           TA1:      LD   A,L   
0471   BA                     CP   D   
0472   28 05                  JR   Z,ta2   
0474   7E                     LD   A,(HL)   
0475   EF                     RST   28h   
0476   2C                     INC   L   
0477   18 F7                  JR   ta1   
0479   7D           TA2:      LD   A,L   
047A   B9                     CP   C   
047B   C8                     RET   Z   
047C   3E 08                  LD   A,8   
047E   EF                     RST   28h   
047F   2D                     DEC   L   
0480   18 F7                  JR   ta2   
0482                             ; ekey: wait for a key
0482   CD 06 FF     EKEY:     CALL   rawk   
0485   28 FB                  JR   Z,ekey   
0487   C9                     RET      
0488                             ; The command keys, and where each goes (after fin).
0488   0D           CMDS:     DB   13   
0489   D4 04                  DW   cret   
048B   07                     DB   7   ; ^G
048C   1C 05                  DW   crun   
048E   0C                     DB   12   ; ^L
048F   2E 05                  DW   clist   
0491   05                     DB   5   ; ^E
0492   AD 04                  DW   cedln   
0494   12                     DB   18   ; ^R
0495   8F 05                  DW   cread   
0497   17                     DB   23   ; ^W
0498   BD 05                  DW   cwrite   
049A   0E                     DB   14   ; ^N
049B   A0 04                  DW   cnew   
049D   18                     DB   24   ; ^X
049E   09 FF                  DW   LEAVE   
04A0                NCMD:     EQU   8   
04A0                             ; ^N ^N: no program, if the next key is ^N too
04A0   CD 82 04     CNEW:     CALL   ekey   
04A3   FE 0E                  CP   14   
04A5   20 04                  JR   NZ,ged0   
04A7   AF                     XOR   A   
04A8   32 00 83               LD   (PROG),A   
04AB   18 6C        GED0:     JR   gedit   
04AD                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
04AD                             ; line it was: Return puts the text back in its place.
04AD   CD 3E 02     CEDLN:    CALL   rdnum   
04B0   22 3A 82               LD   (EDLN),HL   ; (no such line: `edit` clears it again)
04B3   CD 6E 05               CALL   find   ; HL -> the line, or the NUL if there is none
04B6   7E                     LD   A,(HL)   
04B7   B7                     OR   A   
04B8   28 F1                  JR   Z,ged0   
04BA   11 80 82               LD   DE,LINEBUF   
04BD   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
04BE   FE 0D                  CP   13   
04C0   28 0D                  JR   Z,ce2   
04C2   FE 0A                  CP   10   
04C4   28 09                  JR   Z,ce2   
04C6   12                     LD   (DE),A   
04C7   EF                     RST   28h   
04C8   23                     INC   HL   
04C9   1C                     INC   E   
04CA   7B                     LD   A,E   
04CB   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
04CD   20 EE                  JR   NZ,ce1   
04CF   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
04D0   5D                     LD   E,L   
04D1   C3 F4 03               JP   ed1   
04D4                             ; Return. If ^E put a line here, the text goes back in its place. If not:
04D4                             ; a number and text is a line to put in, a number alone a line to take out,
04D4                             ; and anything else is run where it is.
04D4   E5           CRET:     PUSH   HL   ; the end of what was typed
04D5   2A 3A 82               LD   HL,(EDLN)   
04D8   7C                     LD   A,H   
04D9   B5                     OR   L   
04DA   28 07                  JR   Z,cr1   
04DC   E5                     PUSH   HL   
04DD   CD 5E 05               CALL   delln   
04E0   E1                     POP   HL   
04E1   18 13                  JR   ins   
04E3   CD 3E 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
04E6   79                     LD   A,C   ; C is still 80h if there was no number:
04E7   87                     ADD   A,A   ;   only then is twice it 0
04E8   28 36                  JR   Z,st0p   ; no number: run the line
04EA   0A                     LD   A,(BC)   
04EB   FE 0D                  CP   13   
04ED   20 06                  JR   NZ,cr2   
04EF   D1                     POP   DE   ; the number alone: take that line out
04F0   CD 5E 05               CALL   delln   
04F3   18 24                  JR   gedit   
04F5   03           CR2:      INC   BC   ; step over the one character after the number
04F6                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
04F6                             ; CR and LF included, and copy it in.
04F6   CD 6E 05     INS:      CALL   find   ; HL -> where it goes
04F9   D1                     POP   DE   ; the end of what was typed
04FA   7B                     LD   A,E   
04FB   91                     SUB   C   ; A = the length of the text, with its CR LF
04FC   C5                     PUSH   BC   ; the text
04FD   4F                     LD   C,A   
04FE   06 00                  LD   B,0   
0500   C5                     PUSH   BC   ; its length
0501   54                     LD   D,H   
0502   5D                     LD   E,L   ; DE = where it goes
0503   AF                     XOR   A   
0504   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0505   ED B1                  CPIR      ; HL -> one past the program's NUL
0507   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0509   44                     LD   B,H   
050A   4D                     LD   C,L   
050B   19                     ADD   HL,DE   
050C   2B                     DEC   HL   ; HL -> the NUL
050D   EB                     EX   DE,HL   
050E   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
050F   E5                     PUSH   HL   
0510   19                     ADD   HL,DE   ; the NUL's new place
0511   EB                     EX   DE,HL   
0512   ED B8                  LDDR      ; move the rest of the program up
0514   C1                     POP   BC   ; the length
0515   D1                     POP   DE   ; where it goes
0516   E1                     POP   HL   ; the text
0517   ED B0                  LDIR      
0519   C3 E2 03     GEDIT:    JP   edit   
051C                             ; ^G: run the program. st0p: run the typed line (BC -> it).
051C   01 00 83     CRUN:     LD   BC,PROG   
051F   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
0520   E1           ST0P:     POP   HL   ; (the end of what was typed)
0521                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0521   21 00 83     ST0:      LD   HL,PROG   
0524   AF                     XOR   A   
0525   BE           ST1:      CP   (HL)   
0526   23                     INC   HL   
0527   20 FC                  JR   NZ,st1   
0529   22 7C 82               LD   (HEAP),HL   
052C                          ENDIF      
052C                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
052C                          ENDIF      
052C                          IF   EDITOR   
052C   E1                     POP   HL   ; TOS: the data stack is as the last line left it
052D   F7                     RST   30h   ; (its return address is thrown away)
052E                             ; ^L: list from line n. DE = the number of the line at HL.
052E   CD 3E 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
0531   7C                     LD   A,H   
0532   B5                     OR   L   
0533   20 01                  JR   NZ,li0   
0535   2C                     INC   L   ;   then from line 1
0536   E5           LI0:      PUSH   HL   
0537   CD 6E 05               CALL   find   
053A   D1                     POP   DE   
053B   7E           LI1:      LD   A,(HL)   
053C   B7                     OR   A   
053D   28 DA                  JR   Z,gedit   ; the end of the text
053F   CD 06 FF               CALL   rawk   
0542   28 09                  JR   Z,li3   ; no key: carry on
0544   FE 03                  CP   3   
0546   C4 82 04               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
0549   FE 03                  CP   3   
054B   28 CC                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
054D   E5           LI3:      PUSH   HL   
054E   D5                     PUSH   DE   
054F   EB                     EX   DE,HL   
0550   CD 89 02               CALL   pdec   ; the line's number,
0553   3E 20                  LD   A," "   
0555   EF                     RST   28h   ;   a space,
0556   D1                     POP   DE   
0557   E1                     POP   HL   
0558   13                     INC   DE   
0559   CD 86 05               CALL   prl   ;   and the line
055C   18 DD                  JR   li1   
055E                             ; delln: take line n (in HL) out: copy everything after it down over it.
055E   CD 6E 05     DELLN:    CALL   find   
0561   54                     LD   D,H   
0562   5D                     LD   E,L   
0563   CD 7C 05               CALL   nxl   ; HL -> the next line
0566   7E           DE1:      LD   A,(HL)   
0567   12                     LD   (DE),A   
0568   23                     INC   HL   
0569   13                     INC   DE   
056A   B7                     OR   A   
056B   20 F9                  JR   NZ,de1   
056D   C9                     RET      
056E                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
056E                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
056E   EB           FIND:     EX   DE,HL   
056F   21 00 83               LD   HL,PROG   
0572   1B           FI1:      DEC   DE   
0573   7A                     LD   A,D   
0574   B3                     OR   E   
0575   C8                     RET   Z   
0576   CD 7C 05               CALL   nxl   
0579   20 F7                  JR   NZ,fi1   
057B   C9                     RET      
057C                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
057C                             ; stop at the NUL that ends the text (and return zero).
057C   7E           NXL:      LD   A,(HL)   
057D   B7                     OR   A   
057E   C8                     RET   Z   
057F   23                     INC   HL   
0580   FE 0A                  CP   10   
0582   20 F8                  JR   NZ,nxl   
0584   B7                     OR   A   
0585   C9                     RET      
0586                             ; prl: print the line at HL, to its LF; HL -> just past it.
0586   7E           PRL:      LD   A,(HL)   
0587   EF                     RST   28h   
0588   7E                     LD   A,(HL)   
0589   23                     INC   HL   
058A   FE 0A                  CP   10   
058C   20 F8                  JR   NZ,prl   
058E   C9                     RET      
058F                          ENDIF      
058F                          IF   EDGEN   
058F                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
058F                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
058F                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
058F                             ; line with no end is given one. Nothing is echoed, and there is no check
058F                             ; for running out of memory.
058F   21 FF 82     CREAD:    LD   HL,PROG-1   
0592   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
0594   23                     INC   HL   ;   the line buffer's last, and spare)
0595   CD 82 04     RD1:      CALL   ekey   
0598   4F                     LD   C,A   
0599   FE 1A                  CP   1Ah   
059B   20 02                  JR   NZ,rd2   
059D   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
059F   FE 0A        RD2:      CP   10   
05A1   20 07                  JR   NZ,rd3   
05A3   2B                     DEC   HL   
05A4   BE                     CP   (HL)   
05A5   23                     INC   HL   
05A6   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
05A8   3E 0D                  LD   A,13   ; anywhere else it ends the line
05AA   77           RD3:      LD   (HL),A   
05AB   23                     INC   HL   
05AC   FE 0D                  CP   13   
05AE   20 03                  JR   NZ,rd4   
05B0   36 0A                  LD   (HL),10   ; after a CR goes a LF
05B2   23                     INC   HL   
05B3   79           RD4:      LD   A,C   
05B4   FE 1A                  CP   1Ah   
05B6   20 DD                  JR   NZ,rd1   
05B8   36 00                  LD   (HL),0   
05BA   C3 E2 03     GED1:     JP   edit   
05BD                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
05BD   21 00 83     CWRITE:   LD   HL,PROG   
05C0   7E           CW1:      LD   A,(HL)   
05C1   B7                     OR   A   
05C2   28 F6                  JR   Z,ged1   
05C4   EF                     RST   28h   
05C5   23                     INC   HL   
05C6   18 F8                  JR   cw1   
05C8                          ENDIF      
05C8                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close,
                              LD   HL,edit   ;   and from there back to the editor
                              PUSH   HL   
                                 ; fbdos: BDOS function C on the file. (^W ends by running on into it.)
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. It runs on into load, which returns to the editor.
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
05C8                          ENDIF      
05C8                             ; =============================================================================
05C8                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
05C8                          ENDIF      
05C8                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
05C8                          ENDIF      
05C8                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
05C8                          ENDIF      
05C8                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
05C8                          ENDIF      
05C8                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
05C8                          ENDIF      
05C8                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
05C8                          ENDIF      
05C8                IMGEND:      


