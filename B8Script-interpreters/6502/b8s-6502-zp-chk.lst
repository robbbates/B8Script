0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        "/" leaves ( r q ), the quotient on top; dividing by zero is not
0000                             ;        checked. -n? does no more editing than Backspace.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  Two switches, set in the EQU lines below:
0000                             ;    ZPSTACK  0 = the data stack is in pages 2 and 3: 252 cells
0000                             ;             1 = the data stack is in zero page: 112 cells, and a smaller
0000                             ;                 interpreter, because every stack access is a byte shorter.
0000                             ;                 The memory map and the machine-code contract differ: see
0000                             ;                 below.
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                ZPSTACK:   EQU   1   ; 1 = data stack in zero page
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X, or $10,X and $80,X when the stack is in zero page.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above; with ZPSTACK = 1 also the data
0000                             ;               stack: low bytes at 10-7F, high bytes at 80-EF (X = 70 when
0000                             ;               empty: 112 cells)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       with ZPSTACK = 0: DSL, data stack, low bytes (X = FC when
0000                             ;    0300       empty: 252 cells) and DSH, high bytes. With ZPSTACK = 1 these
0000                             ;               two pages are not used.
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C
0000                             ;               (= z10+), KEYBUF at +34, the -n? line buffer at +80..+FF
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   ZPSTACK   
0000                DSL:      EQU   10h   ; data stack, low bytes
0000                DSH:      EQU   80h   ; data stack, high bytes
0000                DSE:      EQU   70h   ; X when the data stack is empty
0000                          ENDIF      
0000                          IFN   ZPSTACK   
                    DSL:      EQU   0200h   
                    DSH:      EQU   0300h   
                    DSE:      EQU   0FCh   
0000                          ENDIF      
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003   20 9A E1               JSR   rstip   
E006   20 8E E1     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B                          IF   CHECKED   
E00B   8D 34 04               STA   KEYBUF   ; (A = 0) no key held back
E00E                          ENDIF      
E00E   A5 00                  LDA   IP   
E010   8D 7C 04               STA   HEAP   
E013   A5 01                  LDA   IP+1   
E015   8D 7D 04               STA   HEAP+1   
E018   20 9A E1               JSR   rstip   
E01B   A2 70                  LDX   #DSE   
E01D                             ; =============================================================================
E01D                             ;  The inner loop
E01D                             ; =============================================================================
E01D                NEXT:        
E01D                          IF   CHECKED   
E01D                             ; Both stacks are checked once per character. The data stack has
E01D                             ; overrun when X is above DSE (an overflow wraps X to FF, an underflow
E01D                             ; moves it up; no handler moves X by more than 2). The return stack
E01D                             ; has when S is below RSLIM (an underflow wraps S to 00-03).
E01D   E0 71                  CPX   #DSE+1   
E01F   B0 4B                  BCS   e_stack   
E021   8A                     TXA      ; TSX trashes X: keep it in A
E022   BA                     TSX      
E023   E0 20                  CPX   #RSLIM   
E025   AA                     TAX      ; TAX leaves the carry alone
E026   90 47                  BCC   e_rstack   
E028                          ENDIF      
E028   20 2E E0               JSR   step   
E02B   4C 1D E0               JMP   next   
E02E                             ; step: read one character and sort it by range.
E02E                             ;    00h          end of program
E02E                             ;    01h-20h, 7Fh-FFh   ignored
E02E                             ;    30h-39h      digit: read a whole number
E02E                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E02E                             ;    61h-7Ah      a-z: push the address of that letter's cell
E02E                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E02E                             ; Every way out of the sort has the carry clear, except "ignored".
E02E   20 8E E1     STEP:     JSR   getc   ; flags follow A
E031   F0 36                  BEQ   endprog   
E033   38                     SEC      
E034   E9 21                  SBC   #21h   ; A = c - 21h
E036   90 30                  BCC   ign   ; 01h-20h
E038   C9 0F                  CMP   #0Fh   
E03A   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E03C   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E03E   C9 0A                  CMP   #10   
E040   90 32                  BCC   digit   
E042   C9 11                  CMP   #11h   
E044   90 16                  BCC   p3a   ; 3Ah-40h
E046   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E048   C9 1A                  CMP   #1Ah   
E04A   90 5D                  BCC   upper   ; 41h-5Ah
E04C   C9 20                  CMP   #20h   
E04E   90 0A                  BCC   p5b   ; 5Bh-60h
E050   C9 3A                  CMP   #3Ah   
E052   90 2D                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E054   C9 3E                  CMP   #3Eh   
E056   B0 10                  BCS   ign   ; 7Fh-FFh
E058                             ; The three adjustments below chain. Each ADC adds the carry the one
E058                             ; before it left, which the constants allow for.
E058   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E05A   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E05C   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E05E   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E05F   A8                     TAY      
E060   B9 14 E1               LDA   PTAB+1,Y   
E063   48                     PHA      
E064   B9 13 E1               LDA   PTAB,Y   
E067   48                     PHA      
E068   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E069                             ; directly, it just ends an ignored character.
E069   4C 09 FF     ENDPROG:   JMP   EXIT   
E06C                          IF   CHECKED   
E06C   A9 53        E_STACK:   LDA   #"S"   ; data stack over or under
E06E   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E06F   A9 52        E_RSTACK:   LDA   #"R"   ; return stack over or under
E071   4C 9B E4               JMP   error   
E074                          ENDIF      
E074                             ; Digits: the first one is in A; read the rest of the number.
E074   A8           DIGIT:    TAY      
E075   20 AF E1               JSR   push   
E078   84 02                  STY   TL   
E07A   A9 00                  LDA   #0   
E07C   85 03                  STA   TH   
E07E   4C 7A E1               JMP   rdnum   
E081                             ; a-z: push the cell's address (the cell is the variable)
E081   0A           LOWER:    ASL      
E082   A8                     TAY      
E083   20 AF E1               JSR   push   
E086   84 02                  STY   TL   
E088   A9 04                  LDA   #>LET   
E08A   85 03                  STA   TH   
E08C   60                     RTS      
E08D                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E08D                             ; the matching ")".
E08D   20 B9 E1     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E090   F0 3F                  BEQ   skip   
E092                             ; pushn: take the step frame off, push the reading position on the return
E092                             ; stack, and go on. With the carry set (a word call) the reading position
E092                             ; then becomes the address in the letter cell at LET,Y.
E092   68           PUSHN:    PLA      
E093   68                     PLA      ; drop the step frame
E094   A5 01                  LDA   IP+1   
E096   48                     PHA      
E097   A5 00                  LDA   IP   
E099   48                     PHA      
E09A   90 0A                  BCC   nxt   
E09C   B9 00 04               LDA   LET,Y   
E09F   85 00                  STA   IP   
E0A1   B9 01 04               LDA   LET+1,Y   
E0A4   85 01                  STA   IP+1   
E0A6   4C 1D E0     NXT:      JMP   next   
E0A9                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E0A9                             ; the return stack, and the IP becomes the address in the letter's cell.
E0A9   0A           UPPER:    ASL      
E0AA   A8                     TAY      
E0AB   38                     SEC      
E0AC   B0 E4                  BCS   pushn   ; always
E0AE                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E0AE                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E0AE                             ; the body"s address instead. Either way it then skips to the matching "]'.
E0AE                             ; (The unchecked build takes anything below "A" as the space, and anything
E0AE                             ; from "A" up as a letter.)
E0AE   20 8E E1     H_DEF:    JSR   getc   
E0B1                          IF   CHECKED   
E0B1   C9 20                  CMP   #" "   
E0B3   F0 19                  BEQ   def2   
E0B5                          ENDIF      
E0B5   38                     SEC      
E0B6   E9 41                  SBC   #"A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
E0B8                          IF   1-CHECKED   
                              BCC   def2   
E0B8                          ENDIF      
E0B8                          IF   CHECKED   
E0B8   A8                     TAY      
E0B9   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E0BB   C9 1A                  CMP   #26   
E0BD   B0 3B                  BCS   e_brack   ; anything but a letter or a space
E0BF   98                     TYA      
E0C0                          ENDIF      
E0C0   0A                     ASL      
E0C1   A8                     TAY      ; Y -> the cell
E0C2   A5 00                  LDA   IP   
E0C4   99 00 04               STA   LET,Y   
E0C7   A5 01                  LDA   IP+1   
E0C9   99 01 04               STA   LET+1,Y   
E0CC   D0 03                  BNE   skip   ; always: no program is in page zero
E0CE   20 A3 E1     DEF2:     JSR   puship   ; an anonymous block: push its address
E0D1                             ; skip: read past text to the closer at this level, and return it in A.
E0D1                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0D1                             ; NUL first ends the program.
E0D1   A9 00        SKIP:     LDA   #0   
E0D3   85 06                  STA   T2   ; depth
E0D5   20 8E E1     SK1:      JSR   getc   
E0D8   F0 8F                  BEQ   endprog   
E0DA   C9 22                  CMP   #22h   
E0DC   D0 03                  BNE   sk2   
E0DE   20 02 E1               JSR   skipstr   ; leaves A = 22h, which matches nothing below
E0E1   C9 28        SK2:      CMP   #"("   
E0E3   F0 11                  BEQ   sk3   
E0E5   C9 5B                  CMP   #"["   
E0E7   F0 0D                  BEQ   sk3   
E0E9   C9 29                  CMP   #")"   
E0EB   F0 04                  BEQ   sk4   
E0ED   C9 5D                  CMP   #"]"   
E0EF   D0 E4                  BNE   sk1   
E0F1   C6 06        SK4:      DEC   T2   
E0F3   10 E0                  BPL   sk1   
E0F5   60                     RTS      ; the closer at this level
E0F6   E6 06        SK3:      INC   T2   
E0F8   D0 DB                  BNE   sk1   
E0FA                          IF   CHECKED   
E0FA   A9 44        E_BRACK:   LDA   #"D"   ; bad character after [
E0FC   4C 9B E4               JMP   error   
E0FF                          ENDIF      
E0FF                             ; 22h pushes the address of the text after it and skips the string.
E0FF   20 A3 E1     H_STR:    JSR   puship   
E102                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E102                             ; the next character, so "/"" does not end it. Returns with Z set, A = 22h.
E102   20 8E E1     SKIPSTR:   JSR   getc   
E105   C9 2F                  CMP   #"/"   
E107   F0 05                  BEQ   ss0   
E109   C9 22                  CMP   #22h   
E10B   D0 F5                  BNE   skipstr   
E10D   60                     RTS      
E10E   20 91 E1     SS0:      JSR   incip   
E111   D0 EF                  BNE   skipstr   ; A is "/" here
E113                             ; =============================================================================
E113                             ;  Dispatch table: one handler per punctuation character, in code order.
E113                             ;  Entries are handler-1 for the RTS trick.
E113                             ; =============================================================================
E113   C1 E1        PTAB:     DW   h_store-1   ; !
E115   FE E0                  DW   h_str-1   ; "
E117   8F E3                  DW   h_num-1   ; #
E119   71 E3                  DW   h_print-1   ; $
E11B   CF E2                  DW   h_swap-1   ; %
E11D   30 E2                  DW   h_and-1   ; &
E11F   87 E3                  DW   h_emit-1   ; '
E121   8C E0                  DW   h_open-1   ; (
E123   03 E2                  DW   h_close-1   ; )
E125   A9 E2                  DW   h_mul-1   ; *
E127   5C E2                  DW   h_add-1   ; +
E129   C9 E3                  DW   h_cfetch-1   ; ,
E12B   54 E2                  DW   h_sub-1   ; -
E12D   D2 E1                  DW   h_cstore-1   ; .
E12F   E0 E2                  DW   h_div-1   ; /
E131   AE E1                  DW   push-1   ; :
E133   DE E1                  DW   drop-1   ; ;
E135   89 E2                  DW   h_lt-1   ; <
E137   99 E2                  DW   h_eq-1   ; =
E139   86 E2                  DW   h_gt-1   ; >
E13B   D2 E3                  DW   h_key-1   ; ?
E13D   BD E3                  DW   h_fetch-1   ; @
E13F   AD E0                  DW   h_def-1   ; [
E141   1D E2                  DW   h_break-1   ; \
E143   09 E2                  DW   h_ret-1   ; ]
E145   48 E2                  DW   h_xor-1   ; ^
E147   38 E3                  DW   h_alloc-1   ; _
E149   29 E4                  DW   h_grave-1   ; `
E14B   E8 E1                  DW   h_tor-1   ; {
E14D   3C E2                  DW   h_or-1   ; |
E14F   F5 E1                  DW   h_fromr-1   ; }
E151   72 E2                  DW   h_not-1   ; ~
E153                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E153                             ; test is at the bottom so the loop closes with a branch. Returns with the
E153                             ; carry set.
E153   20 91 E1     RD1:      JSR   incip   ; (keeps A = the digit)
E156   06 02                  ASL   TL   
E158   26 03                  ROL   TH   ; x2
E15A   18                     CLC      
E15B   65 02                  ADC   TL   
E15D   85 04                  STA   T0   
E15F   A5 03                  LDA   TH   
E161   69 00                  ADC   #0   
E163   85 05                  STA   T1   ; T = x2 + digit
E165   06 02                  ASL   TL   
E167   26 03                  ROL   TH   
E169   06 02                  ASL   TL   
E16B   26 03                  ROL   TH   ; x8
E16D   18                     CLC      
E16E   A5 02                  LDA   TL   
E170   65 04                  ADC   T0   
E172   85 02                  STA   TL   
E174   A5 03                  LDA   TH   
E176   65 05                  ADC   T1   
E178   85 03                  STA   TH   ; x8 + x2 + digit
E17A   20 80 E1     RDNUM:    JSR   isdig   
E17D   90 D4                  BCC   rd1   
E17F   60                     RTS      
E180                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E180                             ; digit. Y = 0.
E180   20 89 E1     ISDIG:    JSR   peek   
E183   38                     SEC      
E184   E9 30                  SBC   #"0"   
E186   C9 0A                  CMP   #10   
E188   60                     RTS      
E189                             ; =============================================================================
E189                             ;  Reading the program
E189                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E189                             ;    getc: the same, then IP moves on; flags follow A
E189                             ;    incip: IP moves on; keeps A, the carry and Y
E189                             ; =============================================================================
E189   A0 00        PEEK:     LDY   #0   
E18B   B1 00                  LDA   (IP),Y   
E18D   60                     RTS      
E18E   20 89 E1     GETC:     JSR   peek   
E191   E6 00        INCIP:    INC   IP   
E193   D0 02                  BNE   ic1   
E195   E6 01                  INC   IP+1   
E197   09 00        IC1:      ORA   #0   
E199   60                     RTS      
E19A                             ; rstip: point IP at the start of the program
E19A   A9 00        RSTIP:    LDA   #<PROG   
E19C   85 00                  STA   IP   
E19E   A9 05                  LDA   #>PROG   
E1A0   85 01                  STA   IP+1   
E1A2   60                     RTS      
E1A3                             ; =============================================================================
E1A3                             ;  Stack
E1A3                             ; =============================================================================
E1A3   20 AF E1     PUSHIP:   JSR   push   ; push the reading position
E1A6   A5 00                  LDA   IP   
E1A8   85 02                  STA   TL   
E1AA   A5 01                  LDA   IP+1   
E1AC   85 03                  STA   TH   
E1AE   60                     RTS      
E1AF   CA           PUSH:     DEX      ; ":" and every push
E1B0   A5 02                  LDA   TL   
E1B2   95 10                  STA   DSL,X   
E1B4   A5 03                  LDA   TH   
E1B6   95 80                  STA   DSH,X   
E1B8   60                     RTS      
E1B9                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E1B9   A5 02        FLAG:     LDA   TL   
E1BB   05 03                  ORA   TH   
E1BD   20 DF E1               JSR   drop   
E1C0   A8                     TAY      ; (drop's INX changed the flags)
E1C1   60                     RTS      
E1C2                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E1C2                H_STORE:      
E1C2                          IF   CHECKED   
E1C2   A5 02                  LDA   TL   ; both bytes must be in the program's space:
E1C4   69 01                  ADC   #1   ; check the page of addr+1 (the carry is
E1C6   A5 03                  LDA   TH   ; clear on the way in)
E1C8   69 00                  ADC   #0   
E1CA   20 5E E3               JSR   chkst   
E1CD                          ENDIF      
E1CD   B5 80                  LDA   DSH,X   
E1CF   A0 01                  LDY   #1   
E1D1   91 02                  STA   (TL),Y   
E1D3                H_CSTORE:      ; "." ( c addr -- )
E1D3                          IF   CHECKED   
E1D3   A5 03                  LDA   TH   
E1D5   20 5E E3               JSR   chkst   
E1D8                          ENDIF      
E1D8   B5 10                  LDA   DSL,X   
E1DA   A0 00                  LDY   #0   
E1DC   91 02                  STA   (TL),Y   
E1DE   E8                     INX      ; falls into drop
E1DF                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E1DF                             ; it returns with Z clear.
E1DF   B4 10        DROP:     LDY   DSL,X   
E1E1   84 02                  STY   TL   
E1E3   B4 80                  LDY   DSH,X   
E1E5   84 03                  STY   TH   
E1E7   E8                     INX      
E1E8   60                     RTS      
E1E9                             ; "{" TOS to the return stack, "}" return stack to TOS
E1E9   68           H_TOR:    PLA      
E1EA   68                     PLA      
E1EB   A5 03                  LDA   TH   
E1ED   48                     PHA      
E1EE   A5 02                  LDA   TL   
E1F0   48                     PHA      
E1F1   20 DF E1               JSR   drop   
E1F4   D0 0B                  BNE   nxt2   ; always
E1F6   68           H_FROMR:   PLA      
E1F7   68                     PLA      
E1F8   20 AF E1               JSR   push   
E1FB   68                     PLA      
E1FC   85 02                  STA   TL   
E1FE   68                     PLA      
E1FF   85 03                  STA   TH   
E201   4C 1D E0     NXT2:     JMP   next   
E204                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E204                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E204                             ; it is here, the address popped is pushed back.
E204   20 B9 E1     H_CLOSE:   JSR   flag   
E207   F0 21                  BEQ   rdrop   
E209   24                     DB   24h   ; (BIT zp: steps over the SEC)
E20A                             ; "]" returns: pull an address and jump to it.
E20A   38           H_RET:    SEC      
E20B                          IF   CHECKED   
E20B   20 8A E4               JSR   chkbrk   ; Ctrl-C is checked at every loop-back and
E20E                          ENDIF      ;   every word return (it keeps the carry)
E20E   68                     PLA      
E20F   68                     PLA      ; drop the step frame
E210   68                     PLA      
E211   85 00                  STA   IP   
E213   68                     PLA      
E214   85 01                  STA   IP+1   
E216   B0 E9                  BCS   nxt2   
E218   48                     PHA      ; ")": keep the block start
E219   A5 00                  LDA   IP   
E21B   48                     PHA      
E21C   90 E3                  BCC   nxt2   ; always
E21E                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E21E                             ; drops the block start, "]" returns.
E21E   20 B9 E1     H_BREAK:   JSR   flag   
E221   F0 63                  BEQ   ab9   
E223   20 D1 E0               JSR   skip   
E226   C9 29                  CMP   #")"   
E228   D0 E0                  BNE   h_ret   
E22A   68           RDROP:    PLA      
E22B   68                     PLA      
E22C   68                     PLA      
E22D   68                     PLA      
E22E   4C 1D E0               JMP   next   
E231                             ; =============================================================================
E231                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E231                             ; =============================================================================
E231                             ; The logic operators leave the carry as they found it, clear, so they can
E231                             ; branch to fin.
E231   B5 10        H_AND:    LDA   DSL,X   
E233   25 02                  AND   TL   
E235   85 02                  STA   TL   
E237   B5 80                  LDA   DSH,X   
E239   25 03                  AND   TH   
E23B   90 2B                  BCC   fin   ; always
E23D   B5 10        H_OR:     LDA   DSL,X   
E23F   05 02                  ORA   TL   
E241   85 02                  STA   TL   
E243   B5 80                  LDA   DSH,X   
E245   05 03                  ORA   TH   
E247   90 1F                  BCC   fin   ; always
E249   B5 10        H_XOR:    LDA   DSL,X   
E24B   45 02                  EOR   TL   
E24D   85 02                  STA   TL   
E24F   B5 80                  LDA   DSH,X   
E251   45 03                  EOR   TH   
E253   90 13                  BCC   fin   ; always
E255                             ; "-" has two jobs: directly before a digit it starts a negative number.
E255   20 80 E1     H_SUB:    JSR   isdig   
E258   90 12                  BCC   negnum   
E25A   20 79 E2     SUB1:     JSR   neg   ; a - b = a + (-b)
E25D   18           H_ADD:    CLC      
E25E   B5 10                  LDA   DSL,X   
E260   65 02                  ADC   TL   
E262   85 02                  STA   TL   
E264   B5 80                  LDA   DSH,X   
E266   65 03                  ADC   TH   ; falls into fin
E268                             ; fin: finish a two-operand op: A = the high byte of the result
E268   85 03        FIN:      STA   TH   
E26A   E8                     INX      
E26B   60                     RTS      
E26C   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E26E   20 74 E0               JSR   digit   ; (comes back with the carry set)
E271   B0 06                  BCS   neg   ; always: the number, negated
E273                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E273   90 05        H_NOT:    BCC   neg1   ; always
E275                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E275   A5 03        ABSV:     LDA   TH   
E277   10 0D        NEGM:     BPL   ab9   
E279                             ; neg: TOS = -TOS
E279   38           NEG:      SEC      
E27A   A9 00        NEG1:     LDA   #0   
E27C   E5 02                  SBC   TL   
E27E   85 02                  STA   TL   
E280   A9 00                  LDA   #0   
E282   E5 03                  SBC   TH   
E284   85 03                  STA   TH   
E286   60           AB9:      RTS      
E287                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E287                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E287   20 D0 E2     H_GT:     JSR   h_swap   ; a > b is b < a
E28A   B5 10        H_LT:     LDA   DSL,X   
E28C   C5 02                  CMP   TL   
E28E   B5 80                  LDA   DSH,X   
E290   E5 03                  SBC   TH   
E292   70 02                  BVS   lt1   
E294   49 80                  EOR   #80h   
E296   0A           LT1:      ASL      
E297   E8                     INX      ; (keeps the carry; never leaves X at 0)
E298   D0 07                  BNE   bool   ; always
E29A   20 5A E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E29D   05 02                  ORA   TL   
E29F   C9 01                  CMP   #1   ; carry clear if A = 0
E2A1   A9 00        BOOL:     LDA   #0   
E2A3   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E2A5   85 02                  STA   TL   
E2A7   85 03                  STA   TH   
E2A9   60                     RTS      
E2AA                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E2AA                             ; bottom while the product comes in at the top, through A:T0 above it; after
E2AA                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E2AA   A0 10        H_MUL:    LDY   #16   
E2AC   84 05                  STY   T1   ; the round count
E2AE   A9 00                  LDA   #0   
E2B0   85 04                  STA   T0   ; A:T0 = the upper half
E2B2   46 03                  LSR   TH   
E2B4   66 02                  ROR   TL   ; the first multiplier bit
E2B6   90 0B        ML1:      BCC   ml2   
E2B8   A8                     TAY      
E2B9   18                     CLC      
E2BA   A5 04                  LDA   T0   
E2BC   75 10                  ADC   DSL,X   
E2BE   85 04                  STA   T0   
E2C0   98                     TYA      
E2C1   75 80                  ADC   DSH,X   ; upper half += the multiplicand
E2C3   6A           ML2:      ROR      
E2C4   66 04                  ROR   T0   
E2C6   66 03                  ROR   TH   
E2C8   66 02                  ROR   TL   ; everything one place right; next bit out
E2CA   C6 05                  DEC   T1   
E2CC   D0 E8                  BNE   ml1   
E2CE   E8                     INX      ; drop the multiplicand
E2CF   60                     RTS      
E2D0   B4 10        H_SWAP:   LDY   DSL,X   ; "%"
E2D2   A5 02                  LDA   TL   
E2D4   95 10                  STA   DSL,X   
E2D6   84 02                  STY   TL   
E2D8   B4 80                  LDY   DSH,X   
E2DA   A5 03                  LDA   TH   
E2DC   95 80                  STA   DSH,X   
E2DE   84 03                  STY   TH   
E2E0   60                     RTS      
E2E1                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
E2E1                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E2E1                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
E2E1   B5 80        H_DIV:    LDA   DSH,X   
E2E3   48                     PHA      ; a's sign: for r
E2E4   45 03                  EOR   TH   
E2E6   48                     PHA      ; a xor b: for q
E2E7   20 75 E2               JSR   absv   
E2EA   A5 02                  LDA   TL   
E2EC   85 08                  STA   D0   
E2EE   A5 03                  LDA   TH   
E2F0   85 09                  STA   D1   ; D = |b|
E2F2   B5 10                  LDA   DSL,X   
E2F4   85 02                  STA   TL   
E2F6   B5 80                  LDA   DSH,X   
E2F8   85 03                  STA   TH   
E2FA   20 75 E2               JSR   absv   ; TOS = |a|
E2FD   20 10 E3               JSR   udiv   ; TOS = q, NOS = r
E300   68                     PLA      
E301   20 77 E2               JSR   negm   ; q's sign
E304   68                     PLA      
E305   10 31                  BPL   ud9   ; r's sign:
E307   20 D0 E2               JSR   h_swap   ;   bring r up,
E30A   20 79 E2               JSR   neg   ;   negate it,
E30D   4C D0 E2               JMP   h_swap   ;   and put it back
E310                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E310                             ; cell the remainder (whatever was there is lost).
E310   A9 00        UDIV:     LDA   #0   
E312   95 10                  STA   DSL,X   
E314   95 80                  STA   DSH,X   
E316   A0 10                  LDY   #16   
E318   06 02        UD1:      ASL   TL   
E31A   26 03                  ROL   TH   
E31C   36 10                  ROL   DSL,X   
E31E   36 80                  ROL   DSH,X   
E320   38                     SEC      
E321   B5 10                  LDA   DSL,X   
E323   E5 08                  SBC   D0   
E325   85 04                  STA   T0   
E327   B5 80                  LDA   DSH,X   
E329   E5 09                  SBC   D1   
E32B   90 08                  BCC   ud2   
E32D   95 80                  STA   DSH,X   
E32F   A5 04                  LDA   T0   
E331   95 10                  STA   DSL,X   
E333   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E335   88           UD2:      DEY      
E336   D0 E0                  BNE   ud1   
E338   60           UD9:      RTS      
E339                             ; =============================================================================
E339                             ;  Storage
E339                             ; =============================================================================
E339                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
E339                             ; (The carry is clear on the way in.)
E339   AD 7C 04     H_ALLOC:   LDA   HEAP   
E33C   A8                     TAY      
E33D   65 02                  ADC   TL   
E33F   8D 7C 04               STA   HEAP   
E342   84 02                  STY   TL   
E344   AD 7D 04               LDA   HEAP+1   
E347   A8                     TAY      
E348   65 03                  ADC   TH   
E34A                          IF   CHECKED   
E34A   B0 0A                  BCS   e_heap   ; a negative count wraps: too big
E34C   C9 E0                  CMP   #HEAPLIM   
E34E   B0 06                  BCS   e_heap   ; the new top must stay below the limit page
E350                          ENDIF      
E350   8D 7D 04               STA   HEAP+1   
E353   84 03                  STY   TH   
E355   60                     RTS      
E356                          IF   CHECKED   
E356   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit
E358   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E359   A9 57        E_STORE:   LDA   #"W"   ; write outside the program's space
E35B   4C 9B E4               JMP   error   
E35E                             ; chkst: stop unless the page in A is in the program's own space, from the
E35E                             ; letter page up to the heap limit. Keeps Y.
E35E   C9 04        CHKST:    CMP   #LETPAGE   
E360   90 F7                  BCC   e_store   
E362   C9 E0                  CMP   #HEAPLIM   
E364   B0 F3                  BCS   e_store   
E366   60                     RTS      
E367                          ENDIF      
E367                             ; =============================================================================
E367                             ;  Console
E367                             ; =============================================================================
E367                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E367   A0 00        TOSGET:   LDY   #0   
E369   B1 02                  LDA   (TL),Y   
E36B   E6 02        INCTOS:   INC   TL   
E36D   D0 02                  BNE   tg1   
E36F   E6 03                  INC   TH   
E371   60           TG1:      RTS      
E372                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E372                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E372                             ; bit 6, so // and /" give themselves).
E372   20 67 E3     H_PRINT:   JSR   tosget   
E375   C9 22                  CMP   #22h   
E377   F0 14                  BEQ   pdrop   
E379   C9 2F                  CMP   #"/"   
E37B   D0 05                  BNE   pr1   
E37D   20 67 E3               JSR   tosget   
E380   29 BF                  AND   #0BFh   
E382   20 03 FF     PR1:      JSR   CONOUT   
E385   4C 72 E3               JMP   h_print   
E388   A5 02        H_EMIT:   LDA   TL   ; "'"
E38A   20 03 FF               JSR   CONOUT   
E38D   4C DF E1     PDROP:    JMP   drop   
E390                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E390                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E390                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E390   A5 03        H_NUM:    LDA   TH   
E392   10 08                  BPL   pn1   
E394   A9 2D                  LDA   #"-"   
E396   20 03 FF               JSR   CONOUT   
E399   20 79 E2               JSR   neg   
E39C   CA           PN1:      DEX      ; the spare cell
E39D   A9 0A                  LDA   #10   
E39F   85 08                  STA   D0   
E3A1   A9 00                  LDA   #0   
E3A3   85 09                  STA   D1   
E3A5   48                     PHA      ; the end marker
E3A6   20 10 E3     PN2:      JSR   udiv   
E3A9   B5 10                  LDA   DSL,X   
E3AB   09 30                  ORA   #"0"   
E3AD   48                     PHA      
E3AE   A5 02                  LDA   TL   
E3B0   05 03                  ORA   TH   
E3B2   D0 F2                  BNE   pn2   
E3B4   E8                     INX      
E3B5   68           PN3:      PLA      
E3B6   F0 D5                  BEQ   pdrop   
E3B8   20 03 FF               JSR   CONOUT   
E3BB   4C B5 E3               JMP   pn3   
E3BE   A0 01        H_FETCH:   LDY   #1   ; "@"
E3C0   B1 02                  LDA   (TL),Y   
E3C2   48                     PHA      ; the high byte, while "," gets the low one
E3C3   20 CA E3               JSR   h_cfetch   
E3C6   68                     PLA      
E3C7   85 03                  STA   TH   
E3C9   60                     RTS      
E3CA                H_CFETCH:      ; ","
E3CA   A0 00                  LDY   #0   
E3CC   B1 02                  LDA   (TL),Y   
E3CE   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E3D0   84 03                  STY   TH   
E3D2   60                     RTS      
E3D3                             ; "?" ( n -- c ) or ( -n -- addr )
E3D3                             ;   n > 0: wait about n ms for a key; 0 if none came
E3D3                             ;   n = 0: wait for a key
E3D3                             ;   n < 0: read a line of at most -n characters, with echo. n is not
E3D3                             ;          checked: the buffer holds 127 characters and the CR, so a
E3D3                             ;          program must ask for 127 or fewer.
E3D3   A5 03        H_KEY:    LDA   TH   
E3D5   30 20                  BMI   line   
E3D7   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E3D9   20 7A E4     KT2:      JSR   getk   
E3DC   D0 15                  BNE   kt3   
E3DE   88                     DEY      
E3DF   D0 F8                  BNE   kt2   
E3E1   A5 02                  LDA   TL   ; count the millisecond off:
E3E3   D0 06                  BNE   kt4   
E3E5   A5 03                  LDA   TH   
E3E7   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E3E9   C6 03                  DEC   TH   
E3EB   C6 02        KT4:      DEC   TL   
E3ED   D0 E8                  BNE   kt1   
E3EF   A5 03                  LDA   TH   
E3F1   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E3F3   A0 00        KT3:      LDY   #0   
E3F5   F0 D7                  BEQ   cf2   ; always: TOS = A
E3F7                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E3F7                             ; (stored, not echoed), every other key is stored and echoed until the line
E3F7                             ; is full. Y = the length so far; TL = the most allowed.
E3F7   20 79 E2     LINE:     JSR   neg   ; TL = the count
E3FA   A0 00                  LDY   #0   
E3FC   F0 03                  BEQ   ln2   ; always
E3FE   20 03 FF     LN3:      JSR   CONOUT   
E401   20 7A E4     LN2:      JSR   getk   
E404   F0 FB                  BEQ   ln2   
E406   C9 0D                  CMP   #13   
E408   F0 14                  BEQ   ln5   
E40A   C9 08                  CMP   #8   
E40C   F0 0A                  BEQ   ln4   
E40E   C4 02                  CPY   TL   
E410   B0 EF                  BCS   ln2   ; full
E412   99 80 04               STA   LINEBUF,Y   
E415   C8                     INY      
E416   D0 E6                  BNE   ln3   ; always: echo it
E418   88           LN4:      DEY      ; Backspace: one back, and echo it,
E419   10 E3                  BPL   ln3   
E41B   C8                     INY      ;   unless the line was empty
E41C   F0 E3                  BEQ   ln2   ; always
E41E   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E421   A9 80                  LDA   #<LINEBUF   
E423   85 02                  STA   TL   
E425   A9 04                  LDA   #>LINEBUF   
E427   85 03                  STA   TH   
E429   60                     RTS      
E42A                             ; =============================================================================
E42A                             ;  Machine code: the grave
E42A                             ; =============================================================================
E42A                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E42A                             ; are stored from addr until a non-hex character; then a RET (60h) is
E42A                             ; written and its address is left. An odd last digit is consumed and dropped.
E42A                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E42A                             ; contract in the header.
E42A   20 67 E4     H_GRAVE:   JSR   rdhex   
E42D   B0 2A                  BCS   exec   
E42F   0A           HX1:      ASL      
E430   0A                     ASL      
E431   0A                     ASL      
E432   0A                     ASL      
E433   85 04                  STA   T0   
E435   20 67 E4               JSR   rdhex   
E438   B0 15                  BCS   hx2   ; odd digit: already consumed, dropped
E43A   05 04                  ORA   T0   
E43C                          IF   CHECKED   
E43C   85 04                  STA   T0   
E43E   A5 03                  LDA   TH   
E440   20 5E E3               JSR   chkst   
E443   A5 04                  LDA   T0   
E445                          ENDIF      
E445   91 02                  STA   (TL),Y   ; Y is 0 after rdhex
E447   20 6B E3               JSR   inctos   
E44A   20 67 E4               JSR   rdhex   
E44D   90 E0                  BCC   hx1   
E44F                HX2:         
E44F                          IF   CHECKED   
E44F   A5 03                  LDA   TH   
E451   20 5E E3               JSR   chkst   
E454                          ENDIF      
E454   A9 60                  LDA   #60h   
E456   91 02                  STA   (TL),Y   
E458   60                     RTS      
E459   A5 02        EXEC:     LDA   TL   
E45B   85 04                  STA   T0   
E45D   A5 03                  LDA   TH   
E45F   85 05                  STA   T1   
E461   20 DF E1               JSR   drop   ; the address is consumed
E464   6C 04 00               JMP   (T0)   
E467                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E467                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E467                             ; Y = 0.
E467   20 80 E1     RDHEX:    JSR   isdig   
E46A   90 0A                  BCC   rh1   
E46C   29 DF                  AND   #0DFh   
E46E   E9 11                  SBC   #11h   ; (the carry is set)
E470   C9 06                  CMP   #6   
E472   B0 05                  BCS   rh9   
E474   69 0A                  ADC   #10   
E476   4C 91 E1     RH1:      JMP   incip   
E479   60           RH9:      RTS      
E47A                             ; =============================================================================
E47A                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E47A                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E47A                             ;  Both keep X and Y. In the unchecked build getk is the host's KEY itself.
E47A                             ; =============================================================================
E47A                          IF   1-CHECKED   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
E47A                          ENDIF      
E47A                          IF   CHECKED   
E47A   AD 34 04     GETK:     LDA   KEYBUF   ; a key held back by the break check
E47D   F0 08                  BEQ   gk1   
E47F   48                     PHA      
E480   A9 00                  LDA   #0   
E482   8D 34 04               STA   KEYBUF   
E485   68                     PLA      
E486   60                     RTS      
E487   4C 06 FF     GK1:      JMP   KEY   
E48A                          ENDIF      
E48A                             ; =============================================================================
E48A                             ;  Checked build: break key and error reports
E48A                             ; =============================================================================
E48A                          IF   CHECKED   
E48A                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
E48A                             ; else is held for the next "?". Keeps the flags.
E48A   08           CHKBRK:   PHP      
E48B   20 7A E4               JSR   getk   
E48E   F0 07                  BEQ   cb9   
E490   C9 03                  CMP   #3   
E492   F0 05                  BEQ   e_break   
E494   8D 34 04               STA   KEYBUF   
E497   28           CB9:      PLP      
E498   60                     RTS      
E499   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C
E49B                             ; error: print the letter in A, " @ " and the offset in the program of the
E49B                             ; character just read, then end. For example: S @ 245
E49B                             ; The hardware stack is left as it is: it wraps inside its page, so the
E49B                             ; calls below work whatever state it is in.
E49B   A2 70        ERROR:    LDX   #DSE   ; (the number printer uses a data cell)
E49D   20 03 FF               JSR   CONOUT   
