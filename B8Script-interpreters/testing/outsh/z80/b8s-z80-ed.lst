                    HP1:      CALL   prstr   
                              RST   18h   
01C5                          ENDIF      
01C5   7D           H_EMIT:   LD   A,L   ; "'"
01C6   EF                     RST   28h   
01C7   DF           PR9:      RST   18h   
01C8                             ; "#" prints TOS as a signed decimal number, with no space after it.
01C8   CD FD 02     H_NUM:    CALL   psgn   
01CB   DF                     RST   18h   
01CC                             ; "?" ( n -- c ) or ( -n -- addr )
01CC                             ;   n > 0: wait about n ms for a key; 0 if none came
01CC                             ;   n = 0: wait for a key
01CC                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01CC                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01CC   CB 7C        H_KEY:    BIT   7,H   
01CE   20 19                  JR   NZ,line   
01D0   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01D2   CD 45 03     KT2:      CALL   getk   
01D5   20 0E                  JR   NZ,kt3   
01D7   1D                     DEC   E   
01D8   20 F8                  JR   NZ,kt2   
01DA   7C                     LD   A,H   ; 0? never counts down: it waits
01DB   B5                     OR   L   
01DC   28 F2                  JR   Z,kt1   
01DE   2B                     DEC   HL   
01DF   7C                     LD   A,H   
01E0   B5                     OR   L   
01E1   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01E3   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01E4   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01E5   6F           KT3:      LD   L,A   
01E6   26 00                  LD   H,0   
01E8   F7                     RST   30h   
01E9                             ; Backspace takes the last character back (and is echoed as
01E9                             ; it is), CR ends (stored, not echoed), every other key is stored and
01E9                             ; echoed until the line is full. The line buffer starts at offset 80h
01E9                             ; of its page, so L alone is the place in the line: D holds the L of
01E9                             ; a full line.
01E9   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01EC   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01ED   9F                     SBC   A,A   
01EE   A5                     AND   L   ; (0 for a count that is too big)
01EF   2F                     CPL      
01F0   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01F1                             ;   at most
01F1   21 80 82               LD   HL,LINEBUF   
01F4   CD 45 03     LN2:      CALL   getk   
01F7   28 FB                  JR   Z,ln2   
01F9   FE 0D                  CP   13   
01FB   28 16                  JR   Z,ln5   
01FD   FE 08                  CP   8   
01FF   28 0B                  JR   Z,ln4   
0201   5F                     LD   E,A   
0202   7D                     LD   A,L   
0203   BA                     CP   D   
0204   28 EE                  JR   Z,ln2   ; full
0206   73                     LD   (HL),E   
0207   2C                     INC   L   
0208   7B                     LD   A,E   
0209   EF           LN3:      RST   28h   
020A   18 E8                  JR   ln2   
020C   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
020D   FA 09 02               JP   M,ln3   ;   unless the line was empty (L left the
0210   2C                     INC   L   ;   upper half of the page)
0211   18 E1                  JR   ln2   
0213   77           LN5:      LD   (HL),A   ; the CR
0214   2E 80                  LD   L,LINEBUF & 0FFh   
0216   F7                     RST   30h   
0217                             ; =============================================================================
0217                             ;  More routines (no handler starts past this point)
0217                             ; =============================================================================
0217                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JR   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              LD   HL,(RSAVE)   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
0217                          ENDIF      
0217                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0217                             ; HL points past it. Each goes back into the loop that prints the string
0217                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0217                             ;    /a-/z   print the variable, as "#" does
0217                             ;    /{      clear the screen, the cursor to the top left
0217                             ;    /}      clear from the cursor to the end of the line
0217                             ;    /|  /`  show the cursor, hide it
0217                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0217   FE 7E        PESC:     CP   7Eh   
0219   28 1C                  JR   Z,pat   
021B   11 AC 01               LD   DE,PRLOOP   ; the others return into the loop
021E   D5                     PUSH   DE   
021F   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0221   30 40                  JR   NC,pcon   
0223   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0225   30 2C                  JR   NC,phide   
0227   87                     ADD   A,A   ; the variable's cell
0228   C6 40                  ADD   A,40h   
022A   E5                     PUSH   HL   
022B   6F                     LD   L,A   
022C   26 82                  LD   H,LETPAGE   
022E   7E                     LD   A,(HL)   
022F   2C                     INC   L   
0230   66                     LD   H,(HL)   
0231   6F                     LD   L,A   
0232   CD FD 02               CALL   psgn   
0235   E1                     POP   HL   
0236   C9                     RET      
0237                             ; /~ ( row col addr -- ): the two cells under the string's address go. Where
0237                             ; "$" is the routine prstr, its own return address goes first, and hp1
0237                             ; calls it again afterwards. (The checked build looks first, through
0237                             ; chkstk, that there is a column at least: with less, it is s. With a
0237                             ; column but no row it is s after the "$", as for any other character; the
0237                             ; spare bytes above the stack take what is written meanwhile.)
0237                PAT:         
0237                          IF   PRSUB   
                              POP   DE   
0237                          ENDIF      
0237                          IF   CHECKED   
                              CALL   chkstk   
0237                          ENDIF      
0237   D1                     POP   DE   ; DE = the column
0238   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0239                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              JP   CONCUR   ; /|  (A = 1: show)
0239                          ENDIF      
0239                          IF   ANS   
0239   D5                     PUSH   DE   
023A   CD 77 02               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
023D   23                     INC   HL   
023E   CD 05 03               CALL   pdec   
0241   3E 3B                  LD   A,";"   
0243   EF                     RST   28h   
0244   E1                     POP   HL   
0245   23                     INC   HL   
0246   CD 05 03               CALL   pdec   
0249   3E 48                  LD   A,"H"   
024B   EF                     RST   28h   
024C   E1                     POP   HL   
024D   C3 AC 01               JP   PRAGAIN   
0250                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0250   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0252   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0253   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0255   3E 3F                  LD   A,"?"   
0257   CD 72 02               CALL   csia   
025A   3E 32                  LD   A,"2"   
025C   EF                     RST   28h   
025D   3E 35                  LD   A,"5"   
025F   EF                     RST   28h   
0260   7B                     LD   A,E   
0261   EF                     RST   28h   
0262   C9                     RET      
0263                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0263   3D           PCON:     DEC   A   
0264   28 EA                  JR   Z,pshow   ; /|
0266   3E 4B                  LD   A,"K"   
0268   F2 72 02               JP   P,csia   ; /}  ESC [ K
026B   3E 48                  LD   A,"H"   ; /{  ESC [ H ESC [ J
026D   CD 72 02               CALL   csia   
0270   3E 4A                  LD   A,"J"   ; (on into csia)
0272                             ; csia: ESC [ and then A. csi: ESC [, keeping A.
0272   CD 77 02     CSIA:     CALL   csi   
0275   EF                     RST   28h   
0276   C9                     RET      
0277   F5           CSI:      PUSH   AF   
0278   3E 1B                  LD   A,27   
027A   EF                     RST   28h   
027B   3E 5B                  LD   A,"["   
027D   EF                     RST   28h   
027E   F1                     POP   AF   
027F   C9                     RET      
0280                          ENDIF      
0280                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0280                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0280                             ; the quotient bits arrive at the bottom of C.
0280                             ; Dividing by 2 is one shift (the spec wants that fast).
0280   7B           UDIV:     LD   A,E   
0281   EE 02                  XOR   2   
0283   B2                     OR   D   
0284   20 07                  JR   NZ,udv0   
0286   CB 3C                  SRL   H   
0288   CB 1D                  RR   L   ; the quotient
028A   8F                     ADC   A,A   
028B   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
028C   C9                     RET      
028D   C5           UDV0:     PUSH   BC   
028E   7C                     LD   A,H   
028F   4D                     LD   C,L   
0290   21 00 00               LD   HL,0   
0293   06 10                  LD   B,16   
0295   CB 21        UDV1:     SLA   C   
0297   17                     RLA      
0298   ED 6A                  ADC   HL,HL   
029A   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
029C   30 02                  JR   NC,udv2   ;   always fits in 16 bits
029E   19                     ADD   HL,DE   ; too much: put it back, and cancel the
029F   0D                     DEC   C   ;   INC below
02A0   0C           UDV2:     INC   C   ; a quotient bit
02A1   10 F2                  DJNZ   udv1   
02A3   EB                     EX   DE,HL   ; DE = remainder
02A4   67                     LD   H,A   
02A5   69                     LD   L,C   ; HL = quotient
02A6   C1                     POP   BC   
02A7   C9                     RET      
02A8                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
02A8                             ; non-digit. Values wrap at 16 bits, as the spec says.
02A8   21 00 00     RDNUM:    LD   HL,0   
02AB   0A           RDN1:     LD   A,(BC)   
02AC   D6 30                  SUB   "0"   
02AE   FE 0A                  CP   10   
02B0   D0                     RET   NC   
02B1   03                     INC   BC   
02B2   54                     LD   D,H   
02B3   5D                     LD   E,L   
02B4   29                     ADD   HL,HL   
02B5   29                     ADD   HL,HL   
02B6   19                     ADD   HL,DE   
02B7   29                     ADD   HL,HL   ; HL * 10
02B8   5F                     LD   E,A   
02B9   16 00                  LD   D,0   
02BB   19                     ADD   HL,DE   
02BC   18 ED                  JR   rdn1   
02BE                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02BE                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02BE                          IF   1-CHECKED   
02BE   03           SS0:      INC   BC   
02BF   0A           SKIPSTR:   LD   A,(BC)   
02C0   03                     INC   BC   
02C1   FE 2F                  CP   "/"   
02C3   28 F9                  JR   Z,ss0   
02C5   FE 22                  CP   22h   
02C7   20 F6                  JR   NZ,skipstr   
02C9   C9                     RET      
02CA                          ENDIF      
02CA                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
02CA                          ENDIF      
02CA                             ; skip: read past text to the closer at this level, and return A = 0 if it
02CA                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02CA                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02CA                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02CA                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02CA                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02CA                             ; 
02CA                             ; The checked build also looks at the character the skip was started by,
02CA                             ; which is always the one just before where it starts: "(" must end at ")",
02CA                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02CA                             ; quote counts as running into it. "\" takes either closer. IX keeps the
02CA                             ; place where the skip started, for the report.
02CA                SKIP:        
02CA                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
02CA                          ENDIF      
02CA   16 00                  LD   D,0   
02CC   14           SK3:      INC   D   ; an opener: one deeper
02CD   0A           SK1:      LD   A,(BC)   
02CE                          IF   1-CHECKED   
02CE   03                     INC   BC   
02CF   B7                     OR   A   
02D0   CA 91 03               JP   Z,SKEND   ; (the end of the program)
02D3                          ENDIF      
02D3                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
02D3                          ENDIF      
02D3   FE 22                  CP   22h   
02D5   CC BF 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02D8   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02DA   28 F0                  JR   Z,sk3   
02DC   3D                     DEC   A   ; ")"
02DD   28 08                  JR   Z,sk4   
02DF   D6 32                  SUB   "["-")"   
02E1   28 E9                  JR   Z,sk3   
02E3   FE 02                  CP   "]"-"["   
02E5   20 E6                  JR   NZ,sk1   
02E7   15           SK4:      DEC   D   
02E8                          IF   1-CHECKED   
02E8   C8                     RET   Z   ; the closer at this level
02E9   18 E2                  JR   sk1   
02EB                          ENDIF      
02EB                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02EB                          ENDIF      
02EB                             ; =============================================================================
02EB                             ;  Dispatch table: the low byte of each handler's address, in code order
02EB                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02EB                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02EB                             ; =============================================================================
02EB                             ; The handlers of the first NPG1 characters start in the image's second page.
02EB                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02EB                             ; differs between the builds, so the count is worked out here.
02EB                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02EB                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02EB                PGBRK:    EQU   (h_break-BASE)/256   
02EB                PGDEF:    EQU   (h_def-BASE)/256   
02EB                PGFET:    EQU   (h_fetch-BASE)/256   
02EB                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02EB                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02EB                          ENDIF      
02EB                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02EB                             ; and return its value in A with the carry set; otherwise leave the IP and
02EB                             ; return with the carry clear.
02EB   0A           HEXC:     LD   A,(BC)   
02EC   D6 30                  SUB   "0"   
02EE   FE 0A                  CP   10   
02F0   38 09                  JR   C,hc1   
02F2   E6 DF                  AND   0DFh   
02F4   D6 11                  SUB   11h   
02F6   FE 06                  CP   6   
02F8   D0                     RET   NC   
02F9   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02FB   03           HC1:      INC   BC   
02FC   C9                     RET      
02FD                             ; psgn: print HL as a signed number. Keeps BC.
02FD   CB 7C        PSGN:     BIT   7,H   
02FF   28 04                  JR   Z,pdec   
0301   3E 2D                  LD   A,"-"   
0303   EF                     RST   28h   
0304   E7                     RST   20h   
0305                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0305                             ; Keeps BC.
0305   11 0A 00     PDEC:     LD   DE,10   
0308   CD 80 02               CALL   udiv   ; HL = HL / 10, E = the last digit
030B   7B                     LD   A,E   
030C   F5                     PUSH   AF   
030D   7C                     LD   A,H   
030E   B5                     OR   L   
030F   C4 05 03               CALL   NZ,pdec   
0312   F1                     POP   AF   
0313   C6 30                  ADD   A,"0"   
0315   EF                     RST   28h   
0316   C9                     RET      
0317                             ; (The table goes here instead in the builds where, before psgn, it would
0317                             ; cross a page: PTLATE.)
0317                          IF   (1-TABP0)*PTLATE   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0317                          ENDIF      
0317                             ; =============================================================================
0317                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0317                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0317                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
0317                             ;  they are the host's KEY and CONOUT routines themselves.
0317                             ; 
0317                             ;  A running program reads the keyboard only through getk and pollk, which
0317                             ;  between them give the break key its rules:
0317                             ;    - Ctrl-C stops the program;
0317                             ;    - any other key that the break check reads is held in KEYBUF for the
0317                             ;      next "?", and a newer one takes its place;
0317                             ;    - "?" (getk) takes the held key first;
0317                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0317                             ;      key like any other, but two of them within about 250 ms still stop it.
0317                             ;  Both are called straight from a handler, never from a routine under one:
0317                             ;  the checked build's report counts on finding one return address above the
0317                             ;  data stack.
0317                             ; =============================================================================
0317                          IFN   CPM   
0317                RAWK:     EQU   KEY   
0317                          ENDIF      
0317                             ; pollk: the break check (see rpushn).
0317   CD 06 FF     POLLK:    CALL   rawk   
031A   C8                     RET   Z   ; no key
031B   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
031E   FE 03        PK1:      CP   3   ; (getk joins here)
0320   C0                     RET   NZ   
0321                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0321                             ; the program has turned it off, wait about 250 ms for one more key: a
0321                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0321                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0321   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0324   B7                     OR   A   
0325   CA 8D 03     CT0:      JP   Z,brk   
0328   D5                     PUSH   DE   
0329   11 10 27               LD   DE,250*MSLOOP   
032C   CD 06 FF     CT1:      CALL   rawk   
032F   20 05                  JR   NZ,ct2   
0331   1B                     DEC   DE   
0332   7A                     LD   A,D   
0333   B3                     OR   E   
0334   20 F6                  JR   NZ,ct1   
0336   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0337   FE 03                  CP   3   
0339   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
033B   B7                     OR   A   
033C   28 03                  JR   Z,ct3   
033E   32 7A 82               LD   (KEYBUF),A   
0341   3E 03        CT3:      LD   A,3   
0343   B7                     OR   A   
0344   C9                     RET      
0345                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0345   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0346   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0349   7E                     LD   A,(HL)   
034A   36 00                  LD   (HL),0   
034C   E1                     POP   HL   
034D   B7                     OR   A   
034E   C0                     RET   NZ   
034F   CD 06 FF               CALL   rawk   
0352   C8                     RET   Z   
0353   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0355                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0355                          ENDIF      ;   (with the editor, both stacks are cleared);
0355                          IF   (1-CHECKED)*EDITOR   
0355                BRK:      EQU   edit0   
0355                          ENDIF      
0355                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
0355                          ENDIF      
0355                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0355                          ENDIF      
0355                             ; =============================================================================
0355                             ;  Checked build: the checks and the error report
0355                             ; =============================================================================
0355                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
0355                          ENDIF      
0355                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0355                          ENDIF      
0355                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0355                          ENDIF      
0355                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
0355                          ENDIF      
0355                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0355                          ENDIF      
0355                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0355                          ENDIF      
0355                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
0355                          ENDIF      
0355                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0355                          ENDIF      ;   screen on it. The editor's loader ends
0355                          IF   CHECKED   ;   the text at the first ^Z.)
                              RST   28h   
                              DJNZ   er4   
                    ER5:         ; (on into the two stack lines)
                                 ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
                                 ;                       Rtn n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
                              ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
                              RST   20h   ;   with the first value and holds nothing)
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
0355                          ENDIF      
0355                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
0355                          ENDIF      
0355                          IF   CHECKED*EDITOR   
                              JP   edit0   ; back to the editor, with both stacks cleared
0355                          ENDIF      
0355                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
0355                          ENDIF      
0355                             ; =============================================================================
0355                             ;  The line editor (EDITOR = 1)
0355                             ; 
0355                             ;  The interpreter starts here, and a program that ends comes back here.
0355                             ;  There is no prompt. It follows the spec's suggested standard for a line
0355                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0355                             ; 
0355                             ;    n text    put the text in as line n; the lines from n on move down. A
0355                             ;              number past the end (or 0) adds the line at the end.
0355                             ;    n         take line n out
0355                             ;    anything else is run at once, as B8Script. (Start such a line with a
0355                             ;    space if it would begin with a digit.)
0355                             ; 
0355                             ;  A command key ends the line too, and takes what was typed as its argument:
0355                             ; 
0355                             ;    ^G        run the program
0355                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0355                             ;              list until another key is pressed; Ctrl-C ends it.
0355                             ;    n ^E      put line n in the input line; Return puts it back, changed
0355                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0355                             ;              last time). Generic: what is typed, or pasted, from now until
0355                             ;              ^Z replaces the program; it is not echoed.
0355                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0355                             ;              time). Generic: the text is printed, as it is.
0355                             ;    ^N ^N     new: no program (the key twice in a row)
0355                             ;    ^X        leave (to LEAVE)
0355                             ; 
0355                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
0355                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0355                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0355                             ;  sent to the terminal, so any terminal will do.
0355                             ; 
0355                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0355                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0355                             ;  125 characters; the one character after a line number separates it from
0355                             ;  the text and is not stored. The text is kept as it is typed, each line
0355                             ;  ending in CR LF, at PROG.
0355                             ; 
0355                             ;  What lasts from one line to the next: the program, the words, the
0355                             ;  variables and the data stack. An error or a break clears both stacks. The
0355                             ;  return stack starts empty for every line.
0355                             ; 
0355                             ;  Things to know:
0355                             ;    - Reset empties the program (generic builds).
0355                             ;    - A word's address points into the program, so run the program again
0355                             ;      after editing it.
0355                             ;    - Nothing is printed between a program's output and what is typed next.
0355                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0355                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0355                             ;      (The stored program never comes back to the line, so it may.)
0355                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0355                             ;      read of the other builds.
0355                             ; 
0355                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0355                             ;  the last line left there, with TOS pushed like the rest.
0355                             ; =============================================================================
0355                          IF   EDGEN   
0355                INIT:        ; reset (A = 0)
0355                          ENDIF      
0355                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0355                          ENDIF      
0355                          IF   EDGEN   
0355   18 36                  JR   edit0   
0357                          ENDIF      
0357                          IF   EDITOR   
0357                             ; ^F, right arrow: one to the right, by printing the character there
0357   7D           RIGHT:    LD   A,L   
0358   BB                     CP   E   
0359   28 4A                  JR   Z,ed1   ; at the end
035B   7E                     LD   A,(HL)   
035C   2C                     INC   L   
035D   18 2B                  JR   lf1   
035F                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
035F                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
035F                             ; ends the sequence, and act on C (right) and D (left).
035F   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0362   CD 06 FF     ES1:      CALL   rawk   
0365   20 0A                  JR   NZ,es2   
0367   0B                     DEC   BC   
0368   78                     LD   A,B   
0369   B1                     OR   C   
036A   20 F6                  JR   NZ,es1   
036C   CD DA 03               CALL   fin   ; no second key: the line is dropped
036F   18 22                  JR   edit   
0371   FE 5B        ES2:      CP   "["   
0373   20 30                  JR   NZ,ed1   ; not a sequence known here
0375   CD 33 04     ES3:      CALL   ekey   
0378   FE 40                  CP   40h   
037A   38 F9                  JR   C,es3   ; (its parameters)
037C   D6 43                  SUB   "C"   
037E   28 D7                  JR   Z,right   
0380   3D                     DEC   A   ; "D"?
0381   20 22                  JR   NZ,ed1   ; no: on into left
0383                             ; ^B, left arrow: the cursor goes one to the left
0383   7D           LEFT:     LD   A,L   
0384   87                     ADD   A,A   
0385   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
0387   2D                     DEC   L   
0388   3E 08                  LD   A,8   
038A   EF           LF1:      RST   28h   
038B   18 18                  JR   ed1   
038D                             ; edit0: reset, an error or a break: both stacks are cleared.
038D                             ; skend: a program that ended inside skip: its return address goes.
038D                             ; edend: a program that ended: TOS joins the rest of the data stack.
038D   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0390   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0391   D1           SKEND:    POP   DE   
0392   E5           EDEND:    PUSH   HL   
0393                             ; edit: start a new input line.
0393   D9           EDIT:     EXX      
0394   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
0397   D9                     EXX      
0398   21 00 00               LD   HL,0   
039B   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
039E   22 3A 82               LD   (EDLN),HL   ; no line is being edited
03A1   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
03A4   5D                     LD   E,L   ;   E = the end of the line (its low byte)
03A5   CD 33 04     ED1:      CALL   ekey   
03A8   FE 7F                  CP   7Fh   
03AA   28 40                  JR   Z,bsp   ; DEL
03AC   FE 20                  CP   " "   
03AE   30 56                  JR   NC,insc   
03B0   FE 09                  CP   9   
03B2   28 52                  JR   Z,insc   ; Tab is text
03B4   FE 08                  CP   8   
03B6   28 34                  JR   Z,bsp   
03B8   FE 02                  CP   2   
03BA   28 C7                  JR   Z,left   ; ^B
03BC   FE 06                  CP   6   
03BE   28 97                  JR   Z,right   ; ^F
03C0   FE 1B                  CP   1Bh   
03C2   28 9B                  JR   Z,esc   
03C4   E5                     PUSH   HL   ; a command key? Look it up
03C5   21 39 04               LD   HL,cmds   
03C8   06 08                  LD   B,NCMD   
03CA   BE           ED2:      CP   (HL)   
03CB   23                     INC   HL   
03CC   28 07                  JR   Z,ed3   
03CE   23                     INC   HL   
03CF   23                     INC   HL   
03D0   10 F8                  DJNZ   ed2   
03D2   E1                     POP   HL   
03D3   18 D0                  JR   ed1   ; no: the key is ignored
03D5   7E           ED3:      LD   A,(HL)   
03D6   23                     INC   HL   
03D7   66                     LD   H,(HL)   
03D8   6F                     LD   L,A   
03D9   E3                     EX   (SP),HL   ; the command's address: fin returns to it
03DA                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
03DA                             ; terminal. Leaves BC -> the line and HL -> the NUL.
03DA   26 82        FIN:      LD   H,LETPAGE   
03DC   6B                     LD   L,E   
03DD   36 0D                  LD   (HL),13   
03DF   2C                     INC   L   
03E0   36 0A                  LD   (HL),10   
03E2   2D                     DEC   L   
03E3   CD 3E 05               CALL   prl   ; (prints the CR LF)
03E6   36 00                  LD   (HL),0   
03E8   01 80 82               LD   BC,LINEBUF   
03EB   C9                     RET      
03EC                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
03EC                             ; left, the rest of the line moves down over it, and the last place (now a
03EC                             ; space) is printed over along with the rest.
03EC   7D           BSP:      LD   A,L   
03ED   87                     ADD   A,A   
03EE   28 B5                  JR   Z,ed1   ; at the start
03F0   2D                     DEC   L   
03F1   3E 08                  LD   A,8   
03F3   EF                     RST   28h   
03F4   E5                     PUSH   HL   
03F5   2C           BS1:      INC   L   
03F6   7E                     LD   A,(HL)   
03F7   2D                     DEC   L   
03F8   77                     LD   (HL),A   
03F9   2C                     INC   L   
03FA   7D                     LD   A,L   
03FB   BB                     CP   E   
03FC   20 F7                  JR   NZ,bs1   
03FE   2D                     DEC   L   
03FF   36 20                  LD   (HL)," "   
0401   E1                     POP   HL   
0402   53                     LD   D,E   
0403   1D                     DEC   E   
0404   18 15                  JR   ic2   
0406                             ; A character goes in at the cursor: it ripples up through the rest of the
0406                             ; line, the cursor moves on, and the rest is printed again.
0406   47           INSC:     LD   B,A   
0407   7B                     LD   A,E   
0408   FE FD                  CP   0FDh   
040A   28 99                  JR   Z,ed1   ; the line is full: 125 characters
040C   78                     LD   A,B   
040D   EF                     RST   28h   
040E   E5                     PUSH   HL   
040F   7E           IC1:      LD   A,(HL)   
0410   70                     LD   (HL),B   
0411   47                     LD   B,A   
0412   7D                     LD   A,L   
0413   2C                     INC   L   
0414   BB                     CP   E   
0415   20 F8                  JR   NZ,ic1   
0417   E1                     POP   HL   
0418   2C                     INC   L   
0419   1C                     INC   E   
041A   53                     LD   D,E   
041B   CD 20 04     IC2:      CALL   tail   
041E   18 85                  JR   ed1   
0420                             ; tail: print the line from the cursor to D (a low byte), and bring the
0420                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0420   4D           TAIL:     LD   C,L   
0421   7D           TA1:      LD   A,L   
0422   BA                     CP   D   
0423   28 05                  JR   Z,ta2   
0425   7E                     LD   A,(HL)   
0426   EF                     RST   28h   
0427   2C                     INC   L   
0428   18 F7                  JR   ta1   
042A   7D           TA2:      LD   A,L   
042B   B9                     CP   C   
042C   C8                     RET   Z   
042D   3E 08                  LD   A,8   
042F   EF                     RST   28h   
0430   2D                     DEC   L   
0431   18 F7                  JR   ta2   
0433                             ; ekey: wait for a key
0433   CD 06 FF     EKEY:     CALL   rawk   
0436   28 FB                  JR   Z,ekey   
0438   C9                     RET      
0439                             ; The command keys, and where each goes (after fin).
0439   0D           CMDS:     DB   13   
043A   89 04                  DW   cret   
043C   07                     DB   7   ; ^G
043D   D1 04                  DW   crun   
043F   0C                     DB   12   ; ^L
0440   E3 04                  DW   clist   
0442   05                     DB   5   ; ^E
0443   5F 04                  DW   cedln   
0445   12                     DB   18   ; ^R
0446   47 05                  DW   cread   
0448   17                     DB   23   ; ^W
0449   74 05                  DW   cwrite   
044B   0E                     DB   14   ; ^N
044C   51 04                  DW   cnew   
044E   18                     DB   24   ; ^X
044F   09 FF                  DW   LEAVE   
0451                NCMD:     EQU   8   
0451                             ; ^N ^N: no program, if the next key is ^N too
0451   CD 33 04     CNEW:     CALL   ekey   
0454   FE 0E                  CP   14   
0456   20 04                  JR   NZ,ged0   
0458   AF                     XOR   A   
0459   32 00 83               LD   (PROG),A   
045C   C3 93 03     GED0:     JP   edit   
045F                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
045F                             ; line it was: Return puts the text back in its place.
045F   CD A8 02     CEDLN:    CALL   rdnum   
0462   E5                     PUSH   HL   
0463   CD 26 05               CALL   find   ; HL -> the line, or the NUL if there is none
0466   D1                     POP   DE   
0467   7E                     LD   A,(HL)   
0468   B7                     OR   A   
0469   28 F1                  JR   Z,ged0   
046B   ED 53 3A 82            LD   (EDLN),DE   
046F   11 80 82               LD   DE,LINEBUF   
0472   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0473   FE 0D                  CP   13   
0475   28 0D                  JR   Z,ce2   
0477   FE 0A                  CP   10   
0479   28 09                  JR   Z,ce2   
047B   12                     LD   (DE),A   
047C   EF                     RST   28h   
047D   23                     INC   HL   
047E   1C                     INC   E   
047F   7B                     LD   A,E   
0480   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0482   20 EE                  JR   NZ,ce1   
0484   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
0485   5D                     LD   E,L   
0486   C3 A5 03               JP   ed1   
0489                             ; Return. If ^E put a line here, the text goes back in its place. If not:
0489                             ; a number and text is a line to put in, a number alone a line to take out,
0489                             ; and anything else is run where it is.
0489   E5           CRET:     PUSH   HL   ; the end of what was typed
048A   2A 3A 82               LD   HL,(EDLN)   
048D   7C                     LD   A,H   
048E   B5                     OR   L   
048F   28 07                  JR   Z,cr1   
0491   E5                     PUSH   HL   
0492   CD 16 05               CALL   delln   
0495   E1                     POP   HL   
0496   18 13                  JR   ins   
0498   CD A8 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
049B   79                     LD   A,C   ; C is still 80h if there was no number:
049C   87                     ADD   A,A   ;   only then is twice it 0
049D   28 36                  JR   Z,st0p   ; no number: run the line
049F   0A                     LD   A,(BC)   
04A0   FE 0D                  CP   13   
04A2   20 06                  JR   NZ,cr2   
04A4   D1                     POP   DE   ; the number alone: take that line out
04A5   CD 16 05               CALL   delln   
04A8   18 24                  JR   gedit   
04AA   03           CR2:      INC   BC   ; step over the one character after the number
04AB                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
04AB                             ; CR and LF included, and copy it in.
04AB   CD 26 05     INS:      CALL   find   ; HL -> where it goes
04AE   D1                     POP   DE   ; the end of what was typed
04AF   7B                     LD   A,E   
04B0   91                     SUB   C   ; A = the length of the text, with its CR LF
04B1   C5                     PUSH   BC   ; the text
04B2   4F                     LD   C,A   
04B3   06 00                  LD   B,0   
04B5   C5                     PUSH   BC   ; its length
04B6   54                     LD   D,H   
04B7   5D                     LD   E,L   ; DE = where it goes
04B8   AF                     XOR   A   
04B9   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
04BA   ED B1                  CPIR      ; HL -> one past the program's NUL
04BC   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
04BE   44                     LD   B,H   
04BF   4D                     LD   C,L   
04C0   19                     ADD   HL,DE   
04C1   2B                     DEC   HL   ; HL -> the NUL
04C2   EB                     EX   DE,HL   
04C3   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
04C4   E5                     PUSH   HL   
04C5   19                     ADD   HL,DE   ; the NUL's new place
04C6   EB                     EX   DE,HL   
04C7   ED B8                  LDDR      ; move the rest of the program up
04C9   C1                     POP   BC   ; the length
04CA   D1                     POP   DE   ; where it goes
04CB   E1                     POP   HL   ; the text
04CC   ED B0                  LDIR      
04CE   C3 93 03     GEDIT:    JP   edit   
04D1                             ; ^G: run the program. st0p: run the typed line (BC -> it).
04D1   01 00 83     CRUN:     LD   BC,PROG   
04D4   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
04D5   E1           ST0P:     POP   HL   ; (the end of what was typed)
04D6                             ; st0: start running at BC. The heap starts after the stored program's NUL.
04D6   21 00 83     ST0:      LD   HL,PROG   
04D9   AF                     XOR   A   
04DA   BE           ST1:      CP   (HL)   
04DB   23                     INC   HL   
04DC   20 FC                  JR   NZ,st1   
04DE   22 7C 82               LD   (HEAP),HL   
04E1                          ENDIF      
04E1                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
04E1                          ENDIF      
04E1                          IF   EDITOR   
04E1   E1                     POP   HL   ; TOS: the data stack is as the last line left it
04E2   F7                     RST   30h   ; (its return address is thrown away)
04E3                             ; ^L: list from line n. DE = the number of the line at HL.
04E3   CD A8 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
04E6   7C                     LD   A,H   
04E7   B5                     OR   L   
04E8   20 01                  JR   NZ,li0   
04EA   2C                     INC   L   ;   then from line 1
04EB   E5           LI0:      PUSH   HL   
04EC   CD 26 05               CALL   find   
04EF   D1                     POP   DE   
04F0   7E           LI1:      LD   A,(HL)   
04F1   B7                     OR   A   
04F2   28 DA                  JR   Z,gedit   ; the end of the text
04F4   CD 06 FF               CALL   rawk   
04F7   28 09                  JR   Z,li3   ; no key: carry on
04F9   FE 03                  CP   3   
04FB   C4 33 04               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
04FE   FE 03                  CP   3   
0500   28 CC                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
0502   E5           LI3:      PUSH   HL   
0503   D5                     PUSH   DE   
0504   EB                     EX   DE,HL   
0505   CD 05 03               CALL   pdec   ; the line's number,
0508   3E 20                  LD   A," "   
050A   EF                     RST   28h   ;   a space,
050B   D1                     POP   DE   
050C   E1                     POP   HL   
050D   13                     INC   DE   
050E   CD 3E 05               CALL   prl   ;   and the line
0511   18 DD                  JR   li1   
0513   C3 93 03     GED1:     JP   edit   
0516                             ; delln: take line n (in HL) out: copy everything after it down over it.
0516   CD 26 05     DELLN:    CALL   find   
0519   54                     LD   D,H   
051A   5D                     LD   E,L   
051B   CD 34 05               CALL   nxl   ; HL -> the next line
051E   7E           DE1:      LD   A,(HL)   
051F   12                     LD   (DE),A   
0520   23                     INC   HL   
0521   13                     INC   DE   
0522   B7                     OR   A   
0523   20 F9                  JR   NZ,de1   
0525   C9                     RET      
0526                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0526                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0526   EB           FIND:     EX   DE,HL   
0527   21 00 83               LD   HL,PROG   
052A   1B           FI1:      DEC   DE   
052B   7A                     LD   A,D   
052C   B3                     OR   E   
052D   C8                     RET   Z   
052E   CD 34 05               CALL   nxl   
0531   20 F7                  JR   NZ,fi1   
0533   C9                     RET      
0534                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0534                             ; stop at the NUL that ends the text (and return zero).
0534   7E           NXL:      LD   A,(HL)   
0535   B7                     OR   A   
0536   C8                     RET   Z   
0537   23                     INC   HL   
0538   FE 0A                  CP   10   
053A   20 F8                  JR   NZ,nxl   
053C   B7                     OR   A   
053D   C9                     RET      
053E                             ; prl: print the line at HL, to its LF; HL -> just past it.
053E   7E           PRL:      LD   A,(HL)   
053F   EF                     RST   28h   
0540   7E                     LD   A,(HL)   
0541   23                     INC   HL   
0542   FE 0A                  CP   10   
0544   20 F8                  JR   NZ,prl   
0546   C9                     RET      
0547                          ENDIF      
0547                          IF   EDGEN   
0547                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
0547                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
0547                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
0547                             ; line with no end is given one. Nothing is echoed, and there is no check
0547                             ; for running out of memory.
0547   21 FF 82     CREAD:    LD   HL,PROG-1   
054A   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
054C   23                     INC   HL   ;   the line buffer's last, and spare)
054D   CD 33 04     RD1:      CALL   ekey   
0550   4F                     LD   C,A   
0551   FE 1A                  CP   1Ah   
0553   20 02                  JR   NZ,rd2   
0555   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
0557   FE 0A        RD2:      CP   10   
0559   20 07                  JR   NZ,rd3   
055B   2B                     DEC   HL   
055C   BE                     CP   (HL)   
055D   23                     INC   HL   
055E   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
0560   3E 0D                  LD   A,13   ; anywhere else it ends the line
0562   77           RD3:      LD   (HL),A   
0563   23                     INC   HL   
0564   FE 0D                  CP   13   
0566   20 03                  JR   NZ,rd4   
0568   36 0A                  LD   (HL),10   ; after a CR goes a LF
056A   23                     INC   HL   
056B   79           RD4:      LD   A,C   
056C   FE 1A                  CP   1Ah   
056E   20 DD                  JR   NZ,rd1   
0570   36 00                  LD   (HL),0   
0572   18 9F                  JR   ged1   
0574                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
0574   21 00 83     CWRITE:   LD   HL,PROG   
0577   7E           CW1:      LD   A,(HL)   
0578   B7                     OR   A   
0579   28 98                  JR   Z,ged1   
057B   EF                     RST   28h   
057C   23                     INC   HL   
057D   18 F8                  JR   cw1   
057F                          ENDIF      
057F                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
057F                          ENDIF      
057F                             ; =============================================================================
057F                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
057F                          ENDIF      
057F                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
057F                          ENDIF      
057F                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
057F                          ENDIF      
057F                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
057F                          ENDIF      
057F                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
057F                          ENDIF      
057F                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
057F                          ENDIF      
057F                IMGEND:      


