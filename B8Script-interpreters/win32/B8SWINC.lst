   622                              <1> ; Signed compares. '<' swaps the two cells and is then '>': a > b is b < a.
   623                              <1> ; Flipping both sign bits turns the signed compare into an unsigned one, and
   624                              <1> ; SBB turns the carry into -1 or 0 with no branch.
   625 0000016D 871C24              <1> h_lt:   xchg    ebx,[esp]
