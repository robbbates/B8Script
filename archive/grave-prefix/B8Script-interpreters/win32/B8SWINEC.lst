   963                              <1> ; `! The machine-code contract: the code is entered by CALL, with the return
   964                              <1> ; address at [ESP] and the data stack above it: [ESP+4] is the top cell
   965                              <1> ; (the one under the address, which was consumed), [ESP+8] the next, one
   966                              <1> ; dword per cell, the cell in the low word. EBX holds the code's own
   967                              <1> ; address (ARENA + addr), and its high word is the arena's (0041h): a
   968                              <1> ; B8Script address a is the byte at ARENA + a. The code may push and pop
   969                              <1> ; dwords, and may change EAX, EBX, ECX, EDX and the flags; it must keep
   970                              <1> ; ESI, EDI and EBP, leave the direction flag clear, and return with RET
   971                              <1> ; (C3h, which the loader writes). On return the dword on top of the stack
   972                              <1> ; becomes TOS. Only the low word of each cell counts: the interpreter puts
   973                              <1> ; the arena's high word back into every cell on the stack.
   974 0000048E FFD3                <1> g_exec: call    ebx
   975 00000490 89E0                <1>         mov     eax,esp                 ; (the stack holds one cell at least,
   976 00000492 66C740024100        <1> .ex1:   mov     word [eax+2],ARENA>>16  ;   the one that stands for TOS)
