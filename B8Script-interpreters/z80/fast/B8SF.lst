03DC   ED 52                  SBC   HL,DE   
03DE   30 02                  JR   NC,uvr2   
03E0   19                     ADD   HL,DE   
03E1   0D                     DEC   C   
03E2   0C           UVR2:     INC   C   
03E3   CB 21                  SLA   C   
03E5   17                     RLA      
03E6   ED 6A                  ADC   HL,HL   
03E8   ED 52                  SBC   HL,DE   
03EA   30 02                  JR   NC,uvr3   
03EC   19                     ADD   HL,DE   
03ED   0D                     DEC   C   
03EE   0C           UVR3:     INC   C   
03EF   CB 21                  SLA   C   
03F1   17                     RLA      
03F2   ED 6A                  ADC   HL,HL   
03F4   ED 52                  SBC   HL,DE   
03F6   30 02                  JR   NC,uvr4   
03F8   19                     ADD   HL,DE   
03F9   0D                     DEC   C   
03FA   0C           UVR4:     INC   C   
03FB   CB 21                  SLA   C   
03FD   17                     RLA      
03FE   ED 6A                  ADC   HL,HL   
0400   ED 52                  SBC   HL,DE   
0402   30 02                  JR   NC,uvr5   
0404   19                     ADD   HL,DE   
0405   0D                     DEC   C   
0406   0C           UVR5:     INC   C   
0407   CB 21                  SLA   C   
0409   17                     RLA      
040A   ED 6A                  ADC   HL,HL   
040C   ED 52                  SBC   HL,DE   
040E   30 02                  JR   NC,uvr6   
0410   19                     ADD   HL,DE   
0411   0D                     DEC   C   
0412   0C           UVR6:     INC   C   
0413   CB 21                  SLA   C   
0415   17                     RLA      
0416   ED 6A                  ADC   HL,HL   
0418   ED 52                  SBC   HL,DE   
041A   30 02                  JR   NC,uvr7   
041C   19                     ADD   HL,DE   
041D   0D                     DEC   C   
041E   0C           UVR7:     INC   C   
041F   CB 21                  SLA   C   
0421   17                     RLA      
0422   ED 6A                  ADC   HL,HL   
0424   ED 52                  SBC   HL,DE   
0426   30 02                  JR   NC,uvr8   
0428   19                     ADD   HL,DE   
0429   0D                     DEC   C   
042A   0C           UVR8:     INC   C   
042B   CB 21                  SLA   C   
042D   17                     RLA      
