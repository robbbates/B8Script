0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only), with the data stack
0000                             ;  in zero page
0000                             ;  Spec: docs/b8script.md (2026-11-24). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ; 
0000                             ;  This is the smaller of the two 6502 interpreters. b8s-6502.asm keeps the
0000                             ;  data stack in pages 2 and 3 (252 cells) and leaves zero page almost free;
0000                             ;  this one keeps it in zero page (112 cells), where the 6502's short
0000                             ;  addressing modes make nearly every handler smaller. The language is the
0000                             ;  same; the memory map and the machine-code contract differ.
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's three-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   D:2: 5 0
0000                             ;                   R:0
0000                             ;                 and then goes to EXIT.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build").
0000                             ;  The base and fast builds keep the skip cache in the page at $0200, which no
0000                             ;  other build uses (this interpreter's data stack is in zero page).
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   2   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    X       the data-stack pointer. Every cell is two bytes in zero page, low
0000                             ;            byte first: the top cell (TOS) is 0,X and 1,X, the one under it
0000                             ;            (NOS) 2,X and 3,X. The stack grows down: a push is DEX DEX, a
0000                             ;            drop INX INX. A cell that holds an address is used where it is,
0000                             ;            with (0,X): nothing is copied to a pointer first.
0000                             ;    $FE,X   the two bytes under the top cell (zero-page indexing wraps, so
0000                             ;    $FF,X   this is -2,X and -1,X): free memory, used as scratch.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  PTAB holds one byte per punctuation character: the low byte of its
0000                             ;  handler's address, less 1 (the dispatcher pushes an address and "returns"
0000                             ;  to it). The high byte comes from the character: the handlers of the first
0000                             ;  N1 characters start in the image's first page, those of the characters from
0000                             ;  N1 up to N2 in its second, and the rest in its third. The layout below
0000                             ;  keeps to that, and testing/chktab6502.py checks it in every build but the
0000                             ;  fast build (SPEED = 2), which dispatches through a full table instead:
0000                             ;  see "The fast build" at the end.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the dispatcher
0000                             ;  leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry the
0000                             ;  address has been dropped and X is the data-stack pointer: TOS is 0,X (low)
0000                             ;  and 1,X (high), NOS is 2,X and 3,X. To push: DEX, DEX, then store at 0,X
0000                             ;  and 1,X. To drop: INX, INX. The code may change A and Y, and X as the
0000                             ;  stack pointer; it must keep IP ($00/$01) and leave the hardware stack
0000                             ;  balanced. Zero page $02, $03, $07 and $0A-$0D are free for its own use;
0000                             ;  but $0C-$0D only while the code runs: a "$" that prints a variable escape
0000                             ;  with the data stack full writes there.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   T1   ; 05-06 the divisor (division, number printing)
0000                D1:       EQU   T2   
0000                V:        EQU   T0   ; (FAST) 04-05 the dispatcher's jump vector
0000                          IF   CHECKED   
0000                PLACE:    EQU   08h   ; 08-09 the address of the character being
0000                             ;   run, for the error report. No handler
0000                             ;   uses it.
0000                             ; The error report runs after the program, so it may use the zero page that
0000                             ; machine code has ($02, $03, $0A-$0D; but not $0A-$0D once it prints
0000                             ; numbers, since a full stack and "#" reach down to them):
0000                P:        EQU   02h   ; 02-03 the place, copied (PLACE is the
0000                CO:       EQU   08h   ;   report's own scratch then, CO)
0000                LN:       EQU   0Ah   ; 0A-0B the line being reported
0000                          ENDIF      
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-000F  the variables above, and scratch
0000                             ;    0010-00EF  the data stack: 112 cells. X = F0 when it is empty. (0E and
0000                             ;               0F are the scratch under the top cell when it is full.)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       CPAGE (QK builds only): the skip cache
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PEND at +38;
0000                             ;               and every build's: the countdown CDOWN at +79, KEYBUF (the
0000                             ;               held key) at +7A, BRKOFF (the break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM). In the fast build its first two
0000                             ;               pages are the dispatch table, and start is at E200
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these. All four must keep X;
0000                             ; they may change A, Y and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if the carry is set,
0000                             ;     hide it if the carry is clear
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row A, column Y, both
0000                             ;     counted from 0
0000                          ENDIF      
0000                DSE:      EQU   0F0h   ; X when the data stack is empty
0000                DSFULL:   EQU   10h   ; X when it is full
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                CDOWN:    EQU   LET+79h   ; the break check's countdown (see pnext)
0000                RSV:      EQU   LET+35h   ; checked: S as it was before this character
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                CPAGE:    EQU   02h   ; (QK) the skip cache's page
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
0000                BASE:     EQU   0E000h   ; where the image starts: a multiple of 512
0000                HALFPG:   EQU   BASE/512   ; (the dispatcher doubles this to get a page)
0000                N1:       EQU   8   ; ! " # $ % & ' (  start in the first page,
0000                N2:       EQU   21   ; ) * + , - . / : ; < = > ?  in the second,
0000                             ; @ [ \ ] ^ _ ` 00bbIHwg ~  in the third
0000                             ; The fast build's dispatcher (SPEED = 2; see "The fast build"), inline at
0000                             ; the end of its own entries. NEXTF reads the next character and jumps
0000                             ; through the table:
0000                             ;     LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
0000                             ;     LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
0000                             ; NEXTA is the same from INC IP on: the character is already in A, and IP is
0000                             ; still at it (it skips the LDY and the LDA); NEXTY is the same with the
0000                             ; character in Y (it skips the TAY too). In the checked build all three are
0000                             ; JMP fnext, which checks the stacks first. (The bytes are written out with
0000                             ; DS, because asm80 does not nest an IF in a macro inside another IF; and
0000                             ; DS takes the addresses as these equates.)
0000                          IF   FAST   
0000                ADTL:     EQU   DTL   
0000                ADTH:     EQU   DTH   
0000                AFNX:     EQU   fnext   
0000                          ENDIF      
0000                          IF   1-FAST   
                    ADTL:     EQU   0   
                    ADTH:     EQU   0   
                    AFNX:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      1-CHECKED,0A0h  ; LDY #0
0000                 DS      1-CHECKED,0
0000                 DS      1-CHECKED,0B1h  ; LDA (IP),Y
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTA,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTY,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient; the
0000                             ; remainder is left in the scratch under it, at $FE,X and $FF,X.
0000                             ; Dividing by 2 is one shift (the spec wants that fast).
0000                             ; (A macro, from when the two builds needed it in different places.)
0000                .macro UDIV,
0000                             ; 
0000                udiv:   LDA     #0
0000                 STA     0FEh,X
0000                 STA     0FFh,X
0000                 LDA     D0
0000                 EOR     #2
0000                 ORA     D1
0000                 BNE     ud0
0000                 LSR     1,X
0000                 ROR     0,X             ; the quotient
0000                 ROL     0FEh,X          ; the remainder: the bit that fell out
0000                 RTS
0000                ud0:    LDY     #16
0000                ud1:    ASL     0,X
0000                 ROL     1,X
0000                 ROL     0FEh,X
0000                 ROL     0FFh,X
0000                 SEC
0000                 LDA     0FEh,X
0000                 SBC     D0
0000                 STA     T0
0000                 LDA     0FFh,X
0000                 SBC     D1
0000                 BCC     ud2
0000                 STA     0FFh,X
0000                 LDA     T0
0000                 STA     0FEh,X
0000                 INC     0,X             ; the quotient bit (bit 0 is free)
0000                ud2:    DEY
0000                 BNE     ud1
0000                 RTS
0000                .endm
0000                 
0000                             ; (QK) "*" with an operand below 256 takes 8 rounds, not 16: that one
0000                             ; becomes the multiplier, so the product's low byte comes out of the NOS
0000                             ; cell's low byte and its high byte is left in T0. Most multiplications have
0000                             ; one: a count or a small constant. (A macro, as it sits in a different
0000                             ; place in the checked and the unchecked builds, to keep the handlers'
0000                             ; pages.)
0000                .macro MULQ,
0000                             ; 
0000                mulq:   LDA     3,X
0000                 BEQ     mq8             ; the multiplier is below 256
0000                 LDA     1,X
0000                 BNE     mq16
0000                 JSR     h_swap          ; the multiplicand is: it becomes the multiplier
0000                mq8:    LDY     #8
0000                 LDA     #0
0000                 STA     T0
0000                 LSR     2,X
0000                mq1:    BCC     mq2
0000                 STA     T1
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 LDA     T1
0000                 ADC     1,X
0000                mq2:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 DEY
0000                 BNE     mq1
0000                 LDA     T0
0000                 STA     3,X
0000                 INX
0000                 INX
0000                 RTS
0000                mq16:   LDY     #16             ; 16 rounds, as h_mul does without QK
0000                 LDA     #0
0000                 STA     T0
0000                 LSR     3,X
0000                 ROR     2,X
0000                mq3:    BCC     mq4
0000                 STA     T1
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 LDA     T1
0000                 ADC     1,X
0000                mq4:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 DEY
0000                 BNE     mq3
0000                 INX
0000                 INX
0000                 RTS
0000                .endm
0000                 
0000                             ; (MULF: the same for the fast build, the rounds unrolled, with Y for the
0000                             ; upper half's high byte while the low one is added)
0000                .macro MULF,
0000                             ; 
0000                mulq:   LDA     3,X
0000                 BEQ     mq8             ; the multiplier is below 256
0000                 LDA     1,X
0000                 BEQ     mqs
0000                 JMP     mq16            ; (out of a branch's reach)
0000                mqs:    JSR     h_swap          ; the multiplicand is: it becomes the multiplier
0000                mq8:    LDA     #0
0000                 STA     T0
0000                 LSR     2,X
0000                 BCC     mu0
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu0:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu1
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu1:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu2
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu2:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu3
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu3:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu4
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu4:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu5
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu5:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu6
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu6:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 BCC     mu7
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mu7:    ROR
0000                 ROR     T0
0000                 ROR     2,X
0000                 LDA     T0
0000                 STA     3,X
0000                 INX
0000                 INX
0000                 RTS
0000                mq16:   LDA     #0
0000                 STA     T0
0000                 LSR     3,X
0000                 ROR     2,X
0000                 BCC     mw0
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw0:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw1
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw1:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw2
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw2:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw3
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw3:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw4
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw4:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw5
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw5:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw6
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw6:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw7
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw7:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw8
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw8:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw9
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw9:    ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw10
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw10:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw11
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw11:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw12
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw12:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw13
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw13:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw14
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw14:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 BCC     mw15
0000                 TAY
0000                 CLC
0000                 LDA     T0
0000                 ADC     0,X
0000                 STA     T0
0000                 TYA
0000                 ADC     1,X
0000                mw15:   ROR
0000                 ROR     T0
0000                 ROR     3,X
0000                 ROR     2,X
0000                 INX
0000                 INX
0000                 RTS
0000                .endm
0000                 
0000                             ; (QK) A true ")" reads the block start where it is, under the step frame,
0000                             ; instead of popping it and pushing it back. The break key is looked at as
0000                             ; pnext would. (A macro, for the same reason.)
0000                .macro CLOSEQ,
0000                             ; 
0000                closeq: TXA                     ; (TSX trashes X)
0000                 TSX
0000                 LDY     103h,X
0000                 STY     IP
0000                 LDY     104h,X
0000                 STY     IP+1
0000                 TAX
0000                 DEC     CDOWN
0000                 BEQ     cq1
0000                 RTS                     ; into the loop
0000                cq1:    PLA
0000                 PLA                     ; the step frame
0000                 JMP     pkey
0000                .endm
0000                 
0000                FTAB:     EQU   BASE   ; (FAST: the fast build's table, two pages,
E200                          .ORG   BASE+FAST*512   ;   comes first, and the code after it)
E200                             ; =============================================================================
E200                             ;  Page 1 of 3. Startup: find the NUL, the heap starts after it
E200                             ; =============================================================================
E200   A2 FF        START:    LDX   #0FFh   
E202   9A                     TXS      ; return stack empty
E203                          IF   CHECKED   
E203                             ; The first half of the letter page is zeroed: every variable, every
E203                             ; cell of the interpreter's own (no key held back), and every word
E203                             ; cell, which then points at 0000h: calling an undefined word stops
E203                             ; with U (see e_undef).
E203   E8                     INX      
E204   8A                     TXA      ; A = 0
E205   A0 7F                  LDY   #7Fh   
E207   99 00 04     STZ:      STA   LET,Y   
E20A   88                     DEY      
E20B   10 FA                  BPL   stz   
E20D                          ENDIF      
E20D                          IF   QK   
E20D   A9 00                  LDA   #0   ; an empty skip cache (a start of 0000h
E20F   A8                     TAY      ;   matches no skip)
E210   99 00 02     SKC:      STA   CPAGE*256,Y   
E213   C8                     INY      
E214   D0 FA                  BNE   skc   
E216                          ENDIF      
E216   20 9A EB               JSR   rstip   
E219   20 89 EB     ST1:      JSR   getc   
E21C   D0 FB                  BNE   st1   ; IP ends just past the NUL
E21E                          IF   1-CHECKED   
                              STA   KEYBUF   ; (A = 0) no key held, the break key on
                              STA   BRKOFF   
E21E                          ENDIF      
E21E   A5 00                  LDA   IP   
E220   8D 7C 04               STA   HEAP   
E223                          IF   CHECKED   
E223   8D 38 04               STA   PEND   
E226                          ENDIF      
E226   A5 01                  LDA   IP+1   
E228   8D 7D 04               STA   HEAP+1   
E22B                          IF   CHECKED   
E22B   8D 39 04               STA   PEND+1   
E22E                          ENDIF      
E22E   20 9A EB               JSR   rstip   
E231   A2 F0                  LDX   #DSE   
E233                             ; ---- the inner loop (the checked build's is further down, out of this page)
E233                          IF   1-CHECKED   
                                 ; -----------------------------------------------------------------------------
                                 ;  The break key. A running program reads the keyboard only through getk
                                 ;  (for "?") and pnext (the break check), which between them give the break
                                 ;  key its rules:
                                 ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
                                 ;      build, with the report (B) in the checked one;
                                 ;    - any other key that the break check reads is held in KEYBUF for the
                                 ;      next "?", and a newer one takes its place;
                                 ;    - "?" (getk) takes the held key first;
                                 ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
                                 ;      key like any other, but two of them within about 250 ms still stop it.
                                 ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
                                 ; -----------------------------------------------------------------------------
                                 ; pnext: the break check, then (falling through) next. A word call, a true
                                 ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
                                 ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
                                 ; falls in here too, which does no harm.)
                    PNEXT:    DEC   CDOWN   
                              BNE   next   
                    PKEY:     JSR   KEY   
                              BEQ   next   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JSR   chk3   ; (Ctrl-C: back only if the break key is off)
                    NEXT:        
E233                          ENDIF      
E233                          IF   (1-CHECKED)*(1-FAST)   
                              JSR   step   
                              JMP   next   
E233                          ENDIF      
E233                          IF   (1-CHECKED)*FAST   
                              JMP   fnext   ; (the fast build: see "The fast build")
E233                          ENDIF      
E233                          IF   CHECKED   
E233   4C 34 EA               JMP   next   
E236                          ENDIF      
E236                             ; ---- handlers of ! " # $ % & ' ( : they must start in this page -------------
E236                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E236                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E236                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
E236                             ; no bit 6, so // and /" give themselves). TOS walks along the string; the
E236                             ; checked build keeps the address on the hardware stack meanwhile, for a Q
E236                             ; report, and puts it back in TOS at the end (pq).
E236                          IF   CHECKED   
E236   68           PQ:       PLA      
E237   95 00                  STA   0,X   
E239   68                     PLA      
E23A   95 01                  STA   1,X   
E23C   B0 5A                  BCS   pdrop   ; the closing quote: drop it
E23E   E0 F0                  CPX   #DSE   ; a NUL: Q, unless "$" had nothing on the
E240   A9 73                  LDA   #"s"   ;   stack at all (X at the empty mark): s
E242   B0 02                  BCS   eq1   
E244   A9 51        E_QUOTE:   LDA   #"Q"   ; a NUL: "$" or a string ran into the end
E246   4C A3 EB     EQ1:      JMP   error   
E249   B5 01        H_PRINT:   LDA   1,X   
E24B   48                     PHA      
E24C   B5 00                  LDA   0,X   
E24E   48                     PHA      
E24F   90 03                  BCC   pr0   ; always: the carry is clear on the way in
E251                          ENDIF      
E251                          IF   1-CHECKED   
                    H_PRINT:   EQU   pr0   
E251                          ENDIF      
E251   20 DF E9     PESC0:    JSR   pesc   ; (an escape, and back into the loop)
E254   20 7B E4     PR0:      JSR   tosget   
E257   C9 22                  CMP   #22h   
E259                          IF   1-CHECKED   
                              BEQ   pdrop   
E259                          ENDIF      
E259                          IF   CHECKED   
E259   F0 DB                  BEQ   pq   ; the closing quote, with the carry set
E25B   A8                     TAY      ; (Y is free here)
E25C   F0 D8                  BEQ   pq   ; a NUL, with the carry clear
E25E                          ENDIF      
E25E   C9 2F                  CMP   #"/"   
E260   D0 0D                  BNE   pr1   
E262   20 7B E4               JSR   tosget   
E265   C9 60                  CMP   #60h   
E267   90 04                  BCC   pr2   
E269   C9 7F                  CMP   #7Fh   
E26B   90 E4                  BCC   pesc0   ; 60h-7Eh, and the carry is clear
E26D   29 BF        PR2:      AND   #0BFh   
E26F   20 03 FF     PR1:      JSR   CONOUT   
E272   4C 54 E2               JMP   pr0   
E275                             ; 22h pushes the address of the text after it and skips the string.
E275   20 06 EB     H_STR:    JSR   puship   
E278                          IF   CHECKED   
E278   20 7E E2               JSR   skipstr   
E27B   F0 C7                  BEQ   e_quote   ; it ran into the end: the place is the 22h
E27D   60                     RTS      
E27E                          ENDIF      
E27E                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E27E                             ; the next character, so "/"" does not end it.
E27E                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E27E                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E27E                             ; text ended first (a NUL, also one just after "/").
E27E                          IF   1-CHECKED   
                    SKIPSTR:   JSR   getc   
                              CMP   #"/"   
                              BEQ   ss0   
                              CMP   #22h   
                              BNE   skipstr   
                              RTS      
                    SS0:      JSR   incip   
                              BNE   skipstr   ; A is "/" here
E27E                          ENDIF      
E27E                          IF   CHECKED   
E27E   20 89 EB     SKIPSTR:   JSR   getc   
E281   F0 09                  BEQ   ss9   ; the end
E283   C9 2F                  CMP   #"/"   
E285   D0 06                  BNE   ss1   
E287   20 89 EB               JSR   getc   ; the escaped character
E28A   D0 F2                  BNE   skipstr   
E28C   60           SS9:      RTS      ; the end, just after "/"
E28D   C9 22        SS1:      CMP   #22h   
E28F   D0 ED                  BNE   skipstr   
E291   4A                     LSR      ; A = 11h, Z clear
E292   60                     RTS      
E293                          ENDIF      
E293   B5 00        H_EMIT:   LDA   0,X   ; "'"
E295   20 03 FF               JSR   CONOUT   
E298   E8           PDROP:    INX      ; a drop for this page's handlers
E299   E8                     INX      
E29A   60                     RTS      
E29B                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E29B                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E29B                             ; leaves each remainder in the scratch under the top cell.
E29B   B5 01        H_NUM:    LDA   1,X   
E29D   10 08                  BPL   pn1   
E29F   A9 2D                  LDA   #"-"   
E2A1   20 03 FF               JSR   CONOUT   
E2A4   20 17 E3               JSR   neg   
E2A7   A9 0A        PN1:      LDA   #10   
E2A9   85 05                  STA   D0   
E2AB   A9 00                  LDA   #0   
E2AD   85 06                  STA   D1   
E2AF   48                     PHA      ; the end marker
E2B0   20 F7 E7     PN2:      JSR   udiv   
E2B3   B5 FE                  LDA   0FEh,X   
E2B5   09 30                  ORA   #"0"   
E2B7   48                     PHA      
E2B8   B5 00                  LDA   0,X   
E2BA   15 01                  ORA   1,X   
E2BC   D0 F2                  BNE   pn2   
E2BE   68           PN3:      PLA      
E2BF   F0 D7                  BEQ   pdrop   
E2C1   20 03 FF               JSR   CONOUT   
E2C4   4C BE E2               JMP   pn3   
E2C7                             ; "!" ( n addr -- ): the low byte, then "."s ending for the high byte.
E2C7   B5 02        H_STORE:   LDA   2,X   
E2C9                          IF   CHECKED   
E2C9   20 22 E5               JSR   chkst   
E2CC                          ENDIF      
E2CC   81 00                  STA   (0,X)   
E2CE   20 7D E4               JSR   inctos   
E2D1   B5 03                  LDA   3,X   
E2D3   4C 2E E3               JMP   st9   
E2D6   B5 00        H_SWAP:   LDA   0,X   ; "%"
E2D8   B4 02                  LDY   2,X   
E2DA   94 00                  STY   0,X   
E2DC   95 02                  STA   2,X   
E2DE   B5 01                  LDA   1,X   
E2E0   B4 03                  LDY   3,X   
E2E2   94 01                  STY   1,X   
E2E4   95 03                  STA   3,X   
E2E6   60                     RTS      
E2E7                             ; "&", and "|" and "^" further down: one byte of the result goes into NOS,
E2E7                             ; and X moves up one. Done twice, that is both bytes, and NOS has become TOS.
E2E7   20 EA E2     H_AND:    JSR   an1   
E2EA   B5 00        AN1:      LDA   0,X   
E2EC   35 02                  AND   2,X   
E2EE   95 02                  STA   2,X   
E2F0   E8                     INX      
E2F1   60                     RTS      
E2F2                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E2F2                             ; the matching ")".
E2F2   20 16 EB     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E2F5                          IF   (1-CHECKED)*(1-QK)   
                              BEQ   skip   
E2F5                          ENDIF      
E2F5                          IF   CHECKED+QK   
E2F5   F0 17                  BEQ   skpar   
E2F7                          ENDIF      
E2F7                             ; pushn: take the step frame off, push the reading position on the return
E2F7                             ; stack, and go on. With the carry set (a word call) the reading position
E2F7                             ; then becomes the address in the letter cell at LET,Y.
E2F7   68           PUSHN:    PLA      
E2F8   68                     PLA      ; drop the step frame
E2F9   A5 01                  LDA   IP+1   
E2FB   48                     PHA      
E2FC   A5 00                  LDA   IP   
E2FE   48                     PHA      
E2FF   90 0A                  BCC   nxt   
E301   B9 00 04               LDA   LET,Y   
E304   85 00                  STA   IP   
E306   B9 01 04               LDA   LET+1,Y   
E309   85 01                  STA   IP+1   
E30B   4C 24 EA     NXT:      JMP   pnext   
E30E                             ; ---- no handler starts between here and the next heading: these routines
E30E                             ; ---- fill the space up to the page boundary and past it ---------------------
E30E                             ; skip: read past text to the closer at this level, and return it in A.
E30E                             ; Brackets of both kinds count together; strings are stepped over whole. A
E30E                             ; NUL first ends the program. (The checked build's skip is further down.)
E30E                          IF   (1-CHECKED)*(1-QK)   
                    SKIP:     LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   endprog   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 22h, which matches nothing below
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
                    ENDPROG:   JMP   EXIT   
E30E                          ENDIF      
E30E                          IF   CHECKED   
E30E                             ; A false ( skips: the wrong closer for it is ].
E30E   A9 5D        SKPAR:    LDA   #"]"   
E310   4C 3D E7               JMP   skip   
E313                          ENDIF      
E313                          IF   (1-CHECKED)*QK   
                    SKPAR:    JMP   skip   ; (QK: the skip is further down)
E313                          ENDIF      
E313                          IF   (1-CHECKED)*QK*(1-FAST)   
                              ;*Macro unroll:  MULQ                    ; (QK: here, where the skip was)
                    MULQ:     LDA   3,X   ; (QK: here, where the skip was)
                              BEQ   mq8   
                              LDA   1,X   
                              BNE   mq16   
                              JSR   h_swap   
                    MQ8:      LDY   #8   
                              LDA   #0   
                              STA   T0   
                              LSR   2,X   
                    MQ1:      BCC   mq2   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              LDA   T1   
                              ADC   1,X   
                    MQ2:      ROR      
                              ROR   T0   
                              ROR   2,X   
                              DEY      
                              BNE   mq1   
                              LDA   T0   
                              STA   3,X   
                              INX      
                              INX      
                              RTS      
                    MQ16:     LDY   #16   
                              LDA   #0   
                              STA   T0   
                              LSR   3,X   
                              ROR   2,X   
                    MQ3:      BCC   mq4   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              LDA   T1   
                              ADC   1,X   
                    MQ4:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              DEY      
                              BNE   mq3   
                              INX      
                              INX      
                              RTS      
E313                          ENDIF      
E313                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E313   B5 01        ABSV:     LDA   1,X   
E315   10 0D        NEGM:     BPL   ab9   
E317                             ; neg: TOS = -TOS
E317   38           NEG:      SEC      
E318   A9 00        NEG1:     LDA   #0   
E31A   F5 00                  SBC   0,X   
E31C   95 00                  STA   0,X   
E31E   A9 00                  LDA   #0   
E320   F5 01                  SBC   1,X   
E322   95 01                  STA   1,X   
E324   60           AB9:      RTS      
E325                             ; =============================================================================
E325                             ;  Page 2 of 3: handlers of ) * + , - . / : ; < = > ?
E325                             ; =============================================================================
E325   B5 00        H_DUP:    LDA   0,X   ; ":"
E327   B4 01                  LDY   1,X   
E329   4C 0F EB               JMP   pushay   
E32C                             ; "." ( c addr -- ), and the end of "!": store A at TOS, drop both cells.
E32C   B5 02        H_CSTORE:   LDA   2,X   
E32E                ST9:         
E32E                          IF   CHECKED   
E32E   20 22 E5               JSR   chkst   
E331                          ENDIF      
E331   81 00                  STA   (0,X)   
E333   E8                     INX      
E334   E8                     INX      
E335   E8           DROP:     INX      ; ";"
E336   E8                     INX      
E337   60                     RTS      
E338                             ; "-" has two jobs: directly before a digit it starts a negative number.
E338   20 6F EB     H_SUB:    JSR   isdig   
E33B   90 0F                  BCC   negnum   
E33D   20 17 E3     SUB1:     JSR   neg   ; a - b = a + (-b)
E340   18                     CLC      
E341                             ; "+": one byte at a time, as the logic operators do; the carry goes across.
E341                             ; It ends with A = the high byte of the sum.
E341   20 44 E3     H_ADD:    JSR   ad1   
E344   B5 00        AD1:      LDA   0,X   
E346   75 02                  ADC   2,X   
E348   95 02                  STA   2,X   
E34A   E8                     INX      
E34B   60                     RTS      
E34C   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E34E   20 3D EB               JSR   digit   ; (comes back with the carry set)
E351   B0 C4                  BCS   neg   ; always: the number, negated
E353                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E353                             ; clear for true, and bool turns it into -1 (true) or 0.
E353   20 D6 E2     H_GT:     JSR   h_swap   ; a > b is b < a
E356   B5 02        H_LT:     LDA   2,X   
E358   D5 00                  CMP   0,X   
E35A   B5 03                  LDA   3,X   
E35C   F5 01                  SBC   1,X   
E35E   70 02                  BVS   lt1   
E360   49 80                  EOR   #80h   
E362   0A           LT1:      ASL      
E363   E8                     INX      
E364   E8                     INX      ; (keeps the carry; X is never 0)
E365   D0 07                  BNE   bool   ; always
E367   20 3D E3     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E36A   15 00                  ORA   0,X   
E36C   C9 01                  CMP   #1   ; carry clear if A = 0
E36E   A9 00        BOOL:     LDA   #0   
E370   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E372   95 00                  STA   0,X   
E374   95 01                  STA   1,X   
E376   60                     RTS      
E377                             ; "*": the classic shift-right multiply. The multiplier is the NOS cell: it
E377                             ; leaves from the bottom while the product comes in at the top, through
E377                             ; A:T0 above it; after 16 rounds the cell holds the low 16 bits, which are
E377                             ; all that is kept. Dropping TOS (the multiplicand) leaves it on top.
E377                          IF   1-QK   
                    H_MUL:    LDY   #16   ; the round count
                              LDA   #0   
                              STA   T0   ; A:T0 = the upper half
                              LSR   3,X   
                              ROR   2,X   ; the first multiplier bit
                    ML1:      BCC   ml2   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              LDA   T1   
                              ADC   1,X   ; upper half += the multiplicand
                    ML2:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   ; everything one place right; next bit out
                              DEY      
                              BNE   ml1   
                              INX      
                              INX      
                              RTS      
E377                          ENDIF      
E377                          IF   QK   
E377   4C 2F E5     H_MUL:    JMP   mulq   ; (QK: see Speed-ups)
E37A                          ENDIF      
E37A                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E37A                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E37A                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E37A                             ; it stops with Z.
E37A                             ; b's cell is dropped once D holds |b|; udiv then leaves the remainder just
E37A                             ; where that cell was, so stepping X back down makes it the top cell.
E37A                          IF   CHECKED   
E37A   A9 5A        E_ZERO:   LDA   #"Z"   ; divide by zero, the stack as it was
E37C   4C A3 EB               JMP   error   
E37F                          ENDIF      
E37F                H_DIV:       
E37F                          IF   CHECKED   
E37F   B5 00                  LDA   0,X   
E381   15 01                  ORA   1,X   
E383   F0 F5                  BEQ   e_zero   
E385                          ENDIF      
E385   B5 03                  LDA   3,X   
E387   48                     PHA      ; a's sign: for r
E388   55 01                  EOR   1,X   
E38A   48                     PHA      ; a xor b: for q
E38B   20 13 E3               JSR   absv   
E38E   B5 00                  LDA   0,X   
E390   85 05                  STA   D0   
E392   B5 01                  LDA   1,X   
E394   85 06                  STA   D1   ; D = |b|
E396   E8                     INX      
E397   E8                     INX      
E398   20 13 E3               JSR   absv   ; TOS = |a|
E39B   20 F7 E7               JSR   udiv   ; TOS = q
E39E   68                     PLA      
E39F   20 15 E3               JSR   negm   ; q's sign
E3A2   CA                     DEX      
E3A3   CA                     DEX      ; r on top
E3A4   68                     PLA      
E3A5   4C 15 E3               JMP   negm   ; r's sign
E3A8   A1 00        H_CFETCH:   LDA   (0,X)   ; ","
E3AA   95 00        SETA:     STA   0,X   ; TOS = A
E3AC   A9 00                  LDA   #0   
E3AE   95 01                  STA   1,X   
E3B0   60                     RTS      
E3B1                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E3B1                             ; drops it and carries on. It uses "]"s code, entered past its SEC: with the
E3B1                             ; carry clear, as it is here, the address popped is pushed back.
E3B1   20 16 EB     H_CLOSE:   JSR   flag   
E3B4   F0 6E                  BEQ   rdrop   
E3B6                          IF   1-QK   
                              BNE   ret1   ; always
E3B6                          ENDIF      
E3B6                          IF   QK   
E3B6   4C 25 E7               JMP   closeq   ; (QK: see Speed-ups)
E3B9                          ENDIF      
E3B9                             ; "?" ( n -- c ) or ( -n -- addr )
E3B9                             ;   n > 0: wait about n ms for a key; 0 if none came
E3B9                             ;   n = 0: wait for a key
E3B9                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E3B9                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E3B9   B5 01        H_KEY:    LDA   1,X   
E3BB   30 1E                  BMI   line   
E3BD   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E3BF   20 5F EA     KT2:      JSR   getk   
E3C2   D0 E6                  BNE   seta   
E3C4   88                     DEY      
E3C5   D0 F8                  BNE   kt2   
E3C7   B5 00                  LDA   0,X   ; count the millisecond off:
E3C9   D0 06                  BNE   kt4   
E3CB   B5 01                  LDA   1,X   
E3CD   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E3CF   D6 01                  DEC   1,X   
E3D1   D6 00        KT4:      DEC   0,X   
E3D3   D0 E8                  BNE   kt1   
E3D5   B5 01                  LDA   1,X   
E3D7   D0 E4                  BNE   kt1   
E3D9   F0 CF                  BEQ   seta   ; always: the time ran out, A = 0
E3DB                             ; ---- no handler starts between here and the next heading --------------------
E3DB                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E3DB                             ; (stored, not echoed), every other key is stored and echoed until the line
E3DB                             ; is full. Y = the length so far; T0 = the most allowed.
E3DB   20 17 E3     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E3DE   D0 04                  BNE   ln0   
E3E0   B5 00                  LDA   0,X   
E3E2   10 02                  BPL   ln1   
E3E4   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E3E6   85 04        LN1:      STA   T0   
E3E8   A0 00                  LDY   #0   
E3EA   F0 03                  BEQ   ln2   ; always
E3EC   20 03 FF     LN3:      JSR   CONOUT   
E3EF   20 5F EA     LN2:      JSR   getk   
E3F2   F0 FB                  BEQ   ln2   
E3F4   C9 0D                  CMP   #13   
E3F6   F0 14                  BEQ   ln5   
E3F8   C9 08                  CMP   #8   
E3FA   F0 0A                  BEQ   ln4   
E3FC   C4 04                  CPY   T0   
E3FE   B0 EF                  BCS   ln2   ; full
E400   99 80 04               STA   LINEBUF,Y   
E403   C8                     INY      
E404   D0 E6                  BNE   ln3   ; always: echo it
E406   88           LN4:      DEY      ; Backspace: one back, and echo it,
E407   10 E3                  BPL   ln3   
E409   C8                     INY      ;   unless the line was empty
E40A   F0 E3                  BEQ   ln2   ; always
E40C   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E40F   A9 80                  LDA   #<LINEBUF   
E411   A0 04                  LDY   #>LINEBUF   
E413   4C 11 EB               JMP   setay   ; TOS = the line's address
E416                             ; =============================================================================
E416                             ;  Page 3 of 3: handlers of @ [ \ ] ^ _ ` 00bbIHwg ~
E416                             ; =============================================================================
E416                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E416                             ; drops the block start, "]" returns.
E416   20 16 EB     H_BREAK:   JSR   flag   
E419   F0 68                  BEQ   tg1   ; (an RTS)
E41B                          IF   CHECKED   
E41B   A9 00                  LDA   #0   ; \ takes either closer
E41D                          ENDIF      
E41D   20 3D E7               JSR   skip   
E420   C9 29                  CMP   #")"   
E422   D0 06                  BNE   h_ret   
E424   68           RDROP:    PLA      
E425   68                     PLA      
E426   68                     PLA      
E427   68                     PLA      ; (the block start's high byte: never 0)
E428   D0 28                  BNE   nxt2   ; always
E42A                             ; "]" returns: pull an address and jump to it. ")" comes in at ret1 with the
E42A                             ; carry clear, and then the address is pushed back.
E42A   38           H_RET:    SEC      
E42B                RET1:        
E42B   68                     PLA      
E42C   68                     PLA      ; drop the step frame
E42D   68                     PLA      
E42E   85 00                  STA   IP   
E430   68                     PLA      
E431   85 01                  STA   IP+1   
E433   B0 1D                  BCS   nxt2   
E435   48                     PHA      ; ")": keep the block start
E436   A5 00                  LDA   IP   
E438   48                     PHA      
E439   4C 24 EA               JMP   pnext   ; a loop-back: the break check
E43C                             ; "{" TOS to the return stack, "}" return stack to TOS
E43C   68           H_TOR:    PLA      
E43D   68                     PLA      
E43E   B5 01                  LDA   1,X   
E440   48                     PHA      
E441   B5 00                  LDA   0,X   
E443   48                     PHA      
E444   E8                     INX      
E445   E8                     INX      
E446   D0 0A                  BNE   nxt2   ; always: X is never 0
E448   68           H_FROMR:   PLA      
E449   68                     PLA      
E44A   CA                     DEX      
E44B   CA                     DEX      
E44C   68                     PLA      
E44D   95 00                  STA   0,X   
E44F   68                     PLA      
E450   95 01                  STA   1,X   
E452   4C 34 EA     NXT2:     JMP   next   
E455                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E455   4C 18 E3     H_NOT:    JMP   neg1   
E458   20 5B E4     H_XOR:    JSR   xr1   
E45B   B5 00        XR1:      LDA   0,X   
E45D   55 02                  EOR   2,X   
E45F   95 02                  STA   2,X   
E461   E8                     INX      
E462   60                     RTS      
E463   20 66 E4     H_OR:     JSR   or1   
E466   B5 00        OR1:      LDA   0,X   
E468   15 02                  ORA   2,X   
E46A   95 02                  STA   2,X   
E46C   E8                     INX      
E46D   60                     RTS      
E46E   A1 00        H_FETCH:   LDA   (0,X)   ; "@"
E470   A8                     TAY      
E471   20 7D E4               JSR   inctos   
E474   A1 00                  LDA   (0,X)   
E476   95 01                  STA   1,X   
E478   94 00                  STY   0,X   
E47A   60                     RTS      
E47B                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E47B   A1 00        TOSGET:   LDA   (0,X)   
E47D   F6 00        INCTOS:   INC   0,X   
E47F   D0 02                  BNE   tg1   
E481   F6 01                  INC   1,X   
E483   60           TG1:      RTS      
E484                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E484                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E484                             ; the body"s address instead. Either way it then skips to the matching "]'.
E484                             ; (The unchecked build takes anything that is not a letter as the space; the
E484                             ; checked build stops on it.)
E484                          IF   CHECKED   
E484   C0 DF        DEF1:     CPY   #" "-"A"+256   
E486   F0 27                  BEQ   def2   
E488                             ; W: anything but a letter or a space after [. The place is that character,
E488                             ; one past the [.
E488   E6 08                  INC   PLACE   
E48A   D0 02                  BNE   eb1   
E48C   E6 09                  INC   PLACE+1   
E48E   A9 57        EB1:      LDA   #"W"   
E490   4C A3 EB               JMP   error   
E493                          ENDIF      
E493   20 89 EB     H_DEF:    JSR   getc   
E496   38                     SEC      
E497   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E499   A8                     TAY      ;   lands 64 bytes up
E49A   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E49C   C9 1A                  CMP   #26   
E49E                          IF   1-CHECKED   
                              BCS   def2   ; not a letter
E49E                          ENDIF      
E49E                          IF   CHECKED   
E49E   B0 E4                  BCS   def1   
E4A0                          ENDIF      
E4A0   98                     TYA      
E4A1   0A                     ASL      
E4A2   A8                     TAY      ; Y -> the cell
E4A3   A5 00                  LDA   IP   
E4A5   99 00 04               STA   LET,Y   
E4A8   A5 01                  LDA   IP+1   
E4AA   99 01 04               STA   LET+1,Y   
E4AD   D0 03                  BNE   dsk   ; always: no program is in page zero
E4AF   20 06 EB     DEF2:     JSR   puship   ; an anonymous block: push its address
E4B2                DSK:         
E4B2                          IF   CHECKED   
E4B2   A9 29                  LDA   #")"   ; the wrong closer for [
E4B4                          ENDIF      
E4B4   4C 3D E7               JMP   skip   
E4B7                             ; ---- machine code: the grave
E4B7                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E4B7                             ; are stored from addr until a non-hex character; then a RET (60h) is
E4B7                             ; written and its address is left. An odd last digit is consumed and dropped.
E4B7                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E4B7                             ; contract in the header.
E4B7   20 78 EB     H_GRAVE:   JSR   rdhex   
E4BA   B0 1C                  BCS   exec   
E4BC   0A           HX1:      ASL      
E4BD   0A                     ASL      
E4BE   0A                     ASL      
E4BF   0A                     ASL      
E4C0   85 04                  STA   T0   
E4C2   20 78 EB               JSR   rdhex   
E4C5   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E4C7   05 04                  ORA   T0   
E4C9   81 00                  STA   (0,X)   ; (never checked)
E4CB   20 7D E4               JSR   inctos   
E4CE   20 78 EB               JSR   rdhex   
E4D1   90 E9                  BCC   hx1   
E4D3   A9 60        HX2:      LDA   #60h   
E4D5   81 00                  STA   (0,X)   
E4D7   60                     RTS      
E4D8   B5 00        EXEC:     LDA   0,X   
E4DA   85 04                  STA   T0   
E4DC   B5 01                  LDA   1,X   
E4DE   85 05                  STA   T1   
E4E0   E8                     INX      ; the address is consumed
E4E1   E8                     INX      
E4E2   6C 04 00               JMP   (T0)   
E4E5                             ; ---- "_" is the last handler: its body may leave the page
E4E5                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E4E5                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E4E5                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   0,X   
                              STA   HEAP   
                              STY   0,X   
                              LDA   HEAP+1   
                              TAY      
                              ADC   1,X   
                              STA   HEAP+1   
                              STY   1,X   
                              RTS      
E4E5                          ENDIF      
E4E5                             ; The checked build works the new top out first, in T0 and Y, and stops with
E4E5                             ; H, the count still on the stack, if it is at or past the limit, below the
E4E5                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E4E5                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E4E5                             ; a signed number from -8000h, so the add overflows exactly when the true
E4E5                             ; sum leaves 0000h-FFFFh.
E4E5                          IF   CHECKED   
E4E5   AD 7C 04     H_ALLOC:   LDA   HEAP   
E4E8   75 00                  ADC   0,X   
E4EA   85 04                  STA   T0   
E4EC   AD 7D 04               LDA   HEAP+1   
E4EF   49 80                  EOR   #80h   
E4F1   75 01                  ADC   1,X   
E4F3   70 25                  BVS   e_heap   ; wrapped
E4F5   49 80                  EOR   #80h   ; the new top's high byte
E4F7   C9 E0                  CMP   #HEAPLIM   
E4F9   B0 1F                  BCS   e_heap   ; at or past the limit
E4FB   A8                     TAY      
E4FC   A5 04                  LDA   T0   
E4FE   CD 38 04               CMP   PEND   
E501   98                     TYA      
E502   ED 39 04               SBC   PEND+1   
E505   90 13                  BCC   e_heap   ; below the program's end
E507   AD 7C 04               LDA   HEAP   
E50A   95 00                  STA   0,X   
E50C   A5 04                  LDA   T0   
E50E   8D 7C 04               STA   HEAP   
E511   AD 7D 04               LDA   HEAP+1   
E514   95 01                  STA   1,X   
E516   8C 7D 04               STY   HEAP+1   
E519   60                     RTS      
E51A                             ; Errors found by handlers. The stacks are as they were before the handler.
E51A   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E51C   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E51D   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E51F   4C A3 EB               JMP   error   
E522                             ; chkst: stop unless the address in the top cell is in the program's own
E522                             ; space, from the letter page up to the heap limit. Keeps A and Y.
E522   48           CHKST:    PHA      
E523   B5 01                  LDA   1,X   
E525   C9 04                  CMP   #LETPAGE   
E527   90 F4                  BCC   e_store   
E529   C9 E0                  CMP   #HEAPLIM   
E52B   B0 F0                  BCS   e_store   
E52D   68                     PLA      
E52E   60                     RTS      
E52F                          ENDIF      
E52F                             ; =============================================================================
E52F                             ;  The rest: no handler starts past this point
E52F                             ; =============================================================================
E52F                          IF   1-QK   
                              ;*Macro unroll:  UDIV
                    UDIV:     LDA   #0   
                              STA   0FEh,X   
                              STA   0FFh,X   
                              LDA   D0   
                              EOR   #2   
                              ORA   D1   
                              BNE   ud0   
                              LSR   1,X   
                              ROR   0,X   
                              ROL   0FEh,X   
                              RTS      
                    UD0:      LDY   #16   
                    UD1:      ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              STA   T0   
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   ud2   
                              STA   0FFh,X   
                              LDA   T0   
                              STA   0FEh,X   
                              INC   0,X   
                    UD2:      DEY      
                              BNE   ud1   
                              RTS      
E52F                          ENDIF      
E52F                          IF   QK   
E52F                             ;  ---- Speed-ups (QK builds) ---------------------------------------------
E52F                             ;  "*" is at mulq (in page 1 unchecked, to keep the handlers' pages; here
E52F                             ;  checked and in the fast build), x@ and x! (unchecked) at lowq.
E52F                          ENDIF      
E52F                          IF   CHECKED*QK*(1-FAST)   
                              ;*Macro unroll:  MULQ
                    MULQ:     LDA   3,X   
                              BEQ   mq8   
                              LDA   1,X   
                              BNE   mq16   
                              JSR   h_swap   
                    MQ8:      LDY   #8   
                              LDA   #0   
                              STA   T0   
                              LSR   2,X   
                    MQ1:      BCC   mq2   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              LDA   T1   
                              ADC   1,X   
                    MQ2:      ROR      
                              ROR   T0   
                              ROR   2,X   
                              DEY      
                              BNE   mq1   
                              LDA   T0   
                              STA   3,X   
                              INX      
                              INX      
                              RTS      
                    MQ16:     LDY   #16   
                              LDA   #0   
                              STA   T0   
                              LSR   3,X   
                              ROR   2,X   
                    MQ3:      BCC   mq4   
                              STA   T1   
                              CLC      
                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              LDA   T1   
                              ADC   1,X   
                    MQ4:      ROR      
                              ROR   T0   
                              ROR   3,X   
                              ROR   2,X   
                              DEY      
                              BNE   mq3   
                              INX      
                              INX      
                              RTS      
E52F                          ENDIF      
