0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   1   ; 0 = small, 1 = base, 2 = fast (not with EDITOR) (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; IY, and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
0000                             ;   at the heap limit, which the heap never reaches
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
0000                PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
0000                ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
                    ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (fast build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (fast build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0000   AF                     XOR   A   ; 00  reset. (This byte, AFh, is also what an
0001                          ENDIF      ;     undefined word runs into: see e_hi.)
0001                          IF   1-EDGEN   
0001   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
0004   C3 D5 03               JP   qinit   ; 04  (the skip cache is emptied first)
0007   00                     DB   0   ; 07  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0008                          ENDIF      
0008                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0008                          ENDIF      
0008                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0008                          ENDIF      
0008                          IF   1-CPM   
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   FD 5E 00     RPOP:     LD   E,(IY+0)   ; 08
000B   FD 56 01               LD   D,(IY+1)   
000E   18 1B                  JR   rp2   ; (the rest is at 2Bh)
0010                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0010   C6 21        CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
0012   20 1D                  JR   NZ,next0   ;     the rest are ignored
0014   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0017   00                     NOP      ; 17  spare
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1           DRP:      POP   HL   ;     new TOS = NOS
001A   18 15                  JR   next0   
001C                          ENDIF      
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D                          ;*Macro unroll:  POPR
001D   CF                     DS   1-CPM,0CFh   
001E                          DS   CPM,0CDh   
001E                          DS   CPM,AROP&0FFh   
001E                          DS   CPM,AROP/256   
001E   EB                     EX   DE,HL   
001F                          ;*Macro unroll:  NEXTZ
001F   F7                     DS   1-CPM,0F7h   
0020                          DS   CPM,0DDh   
0020                          DS   CPM,0E9h   
0020                          IF   1-CPM   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
0028                RST28:       
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B   FD 23        RP2:      INC   IY   ; 2B  the rest of rpop
002D   FD 23                  INC   IY   
002F   C9                     RET      
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                          ENDIF      
0031                          IF   CPM   
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; back to c; zero only for NUL
                              JR   NZ,next0   ; the rest are ignored
                    ENDPROG:   JP   EXIT   ; the program has ended
0031                          ENDIF      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0031                          ENDIF      
0031                          IF   1-FAST   
0031                NEXT0:       
0031                          ENDIF      
0031                          IF   CHECKED*(1-FAST)   
0031   CD 65 04               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034                          IF   1-FAST   
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D6                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 79                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 7B                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 6D                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          ENDIF      
0058                          IF   (1-CHECKED)*(1-FAST)   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED*(1-FAST)   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 92 04               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D                          IF   1-FAST   
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                          ENDIF      
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063                          IF   1-FAST   
0063   C6 07        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 04                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE 20                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          ENDIF      
006C                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IF   (1-CPM)*(1-FAST)   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070                          IF   1-FAST   
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                          ENDIF      
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0072   21 00 82     INIT:     LD   HL,LET   
0075   77           INI1:     LD   (HL),A   
0076   2C                     INC   L   
0077   F2 75 00               JP   P,ini1   ; +00h to +7Fh
007A   01 00 83               LD   BC,PROG   ; the IP
007D                          ENDIF      
007D                          IF   (1-CPM)*(1-EDITOR)   
007D   60           ST0:      LD   H,B   
007E   69                     LD   L,C   
007F   AF                     XOR   A   
0080   BE           ST1:      CP   (HL)   
0081   23                     INC   HL   
0082   20 FC                  JR   NZ,st1   
0084                          ENDIF      
0084                          IF   1-EDITOR   
0084   22 7C 82     ST2:      LD   (HEAP),HL   
0087                          ENDIF      
0087                          IF   CHECKED*(1-EDITOR)   
0087                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
0087   E7                     DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
0088                          DS   CPM,0CDh   
0088                          DS   CPM,ANEG&0FFh   
0088                          DS   CPM,ANEG/256   
0088   22 38 82               LD   (NPEND),HL   ;   release below it
008B                          ENDIF      
008B                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
008B                          ENDIF      ;   these)
008B                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
008B                          ENDIF      
008B                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
008B                          ENDIF      
008B                          IF   1-EDITOR   
008B                          ;*Macro unroll:  SETIX
008B                          DS   CPM+FAST-CPM*FAST,0DDh   
008B                          DS   CPM+FAST-CPM*FAST,21h   
008B                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
008B                          DS   CPM+FAST-CPM*FAST,ANXT/256   
008B   FD 21 E0 80            LD   IY,RSTOP   ; the return stack is empty
008F                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
008F   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0090                          DS   CPM+FAST-CPM*FAST,0DDh   
0090                          DS   CPM+FAST-CPM*FAST,0E9h   
0090                          ENDIF      
0090                             ; In the unchecked generic editor build the table is here, in the first
0090                             ; page, which saves loading D twice. (The other builds have no room for it
0090                             ; here: theirs is further down.)
0090                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0090                          ENDIF      
0090                             ; =============================================================================
0090                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0090                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0090                             ;  is here too: it belongs to "`" and makes the page come out right.
0090                             ; =============================================================================
0090   D1           H_XOR:    POP   DE   
0091   7C                     LD   A,H   
0092   AA                     XOR   D   
0093   67                     LD   H,A   
0094   7D                     LD   A,L   
0095   AB                     XOR   E   
0096   6F                     LD   L,A   
0097                          ;*Macro unroll:  NEXT
0097   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0098                          DS   CPM+FAST-CPM*FAST,0DDh   
0098                          DS   CPM+FAST-CPM*FAST,0E9h   
0098   D1           H_OR:     POP   DE   
0099   7C                     LD   A,H   
009A   B2                     OR   D   
009B   67                     LD   H,A   
009C   7D                     LD   A,L   
009D   B3                     OR   E   
009E   6F                     LD   L,A   
009F                          ;*Macro unroll:  NEXT
009F   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00A0                          DS   CPM+FAST-CPM*FAST,0DDh   
00A0                          DS   CPM+FAST-CPM*FAST,0E9h   
00A0                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
00A0   E7           H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
00A1                          DS   CPM,0CDh   
00A1                          DS   CPM,ANEG&0FFh   
00A1                          DS   CPM,ANEG/256   
00A1   2B                     DEC   HL   
00A2                          ;*Macro unroll:  NEXT
00A2   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00A3                          DS   CPM+FAST-CPM*FAST,0DDh   
00A3                          DS   CPM+FAST-CPM*FAST,0E9h   
00A3                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
00A3                             ; the same either way); TOS is the old pointer.
00A3   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A7                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A7                          ENDIF      
00A7   19                     ADD   HL,DE   ; the new top
00A8                          IF   CHECKED   
00A8   CD 9C 04               CALL   chkhp   
00AB                          ENDIF      
00AB   22 7C 82               LD   (HEAP),HL   
00AE   EB                     EX   DE,HL   
00AF                          ;*Macro unroll:  NEXT
00AF   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00B0                          DS   CPM+FAST-CPM*FAST,0DDh   
00B0                          DS   CPM+FAST-CPM*FAST,0E9h   
00B0                          IF   1-CPM*CHECKED   
00B0   FD 22 34 82  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
00B4   CD EB 00               CALL   jphl   
00B7   FD 2A 34 82            LD   IY,(RSAVE)   
00BB                          ;*Macro unroll:  SETIX
00BB                          DS   CPM+FAST-CPM*FAST,0DDh   
00BB                          DS   CPM+FAST-CPM*FAST,21h   
00BB                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
00BB                          DS   CPM+FAST-CPM*FAST,ANXT/256   
00BB   E1                     POP   HL   
00BC                          ;*Macro unroll:  NEXT
00BC   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00BD                          DS   CPM+FAST-CPM*FAST,0DDh   
00BD                          DS   CPM+FAST-CPM*FAST,0E9h   
00BD                          ENDIF      
00BD                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00BD                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00BD                             ; Digits: step back onto the first digit and read the whole number.
00BD   E5           DIGIT:    PUSH   HL   
00BE   0B                     DEC   BC   
00BF   CD D8 02               CALL   rdnum   
00C2                          ;*Macro unroll:  NEXT
00C2   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00C3                          DS   CPM+FAST-CPM*FAST,0DDh   
00C3                          DS   CPM+FAST-CPM*FAST,0E9h   
00C3                             ; a-z: push the cell's address (the cell is the variable)
00C3                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
00C3                          IF   1-SBASEU   
00C3   E5           LOWER:    PUSH   HL   
00C4   87                     ADD   A,A   
00C5   6F                     LD   L,A   
00C6   26 82                  LD   H,LETPAGE   
00C8                          ;*Macro unroll:  NEXT
00C8   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00C9                          DS   CPM+FAST-CPM*FAST,0DDh   
00C9                          DS   CPM+FAST-CPM*FAST,0E9h   
00C9                          ENDIF      
00C9                          IF   SBASEU   
                    LOWER:    JP   lowq   
00C9                          ENDIF      
00C9                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00C9                             ; the return stack, and the IP becomes the address in the letter's cell.
00C9   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00CA   EB                     EX   DE,HL   ; park TOS
00CB   87                     ADD   A,A   
00CC   6F                     LD   L,A   
00CD   26 82                  LD   H,LETPAGE   ; HL -> cell
00CF   4E                     LD   C,(HL)   
00D0   2C                     INC   L   
00D1   46                     LD   B,(HL)   ; IP = the word's body
00D2   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00D3                             ; rpushn: move the top cell of the data stack (in memory) to the return
00D3                             ; stack, then next. Everything that pushes the return stack ends here.
00D3                             ; 
00D3                             ; The break key is looked at here, so at every word call and loop-back (and
00D3                             ; block entry and "{"), but only one time in 256: PCNT counts them.
00D3                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
00D3   D1           RPUSHN:   POP   DE   
00D4   FD 72 FF               LD   (IY-1),D   
00D7   FD 73 FE               LD   (IY-2),E   
00DA   FD 2B                  DEC   IY   
00DC   FD 2B                  DEC   IY   
00DE   E5                     PUSH   HL   
00DF   21 36 82               LD   HL,PCNT   
00E2   35                     DEC   (HL)   
00E3   E1                     POP   HL   ; (the zero flag lasts)
00E4   CC 27 04               CALL   Z,pollk   
00E7                          ;*Macro unroll:  NEXT
00E7   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00E8                          DS   CPM+FAST-CPM*FAST,0DDh   
00E8                          DS   CPM+FAST-CPM*FAST,0E9h   
00E8                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
00E8   E3           H_TOR:    EX   (SP),HL   
00E9   18 E8                  JR   rpushn   
00EB   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
00EC                             ; ---- machine code: the grave -----------------------------------------------
00EC                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00EC                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00EC                             ; written and its address is left. An odd last digit is consumed and dropped.
00EC                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00EC                             ; code is entered by CALL with the data stack above the return address; it
00EC                             ; must keep BC, and on return the top cell becomes the new TOS.
00EC   CD DB 03     H_GRAVE:   CALL   hexc   
00EF                          IF   1-CPM*CHECKED   
00EF   30 BF                  JR   NC,exec   
00F1                          ENDIF      
00F1                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
00F1                          ENDIF      
00F1   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00F2   CD DB 03               CALL   hexc   
00F5   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00F7   ED 6F                  RLD      ;   overwrites it
00F9   23                     INC   HL   ; ... and RLD shifts it up under the low one
00FA   CD DB 03               CALL   hexc   
00FD   38 F2                  JR   C,hx1   
00FF   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
0101                          ;*Macro unroll:  NEXT
0101   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0102                          DS   CPM+FAST-CPM*FAST,0DDh   
0102                          DS   CPM+FAST-CPM*FAST,0E9h   
0102                             ; ---- where the two pages meet ----------------------------------------------
0102                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
0102                             ; are in falling code order for this), and where exactly differs between the
0102                             ; builds: NPG1 follows. Every handler below these four must start in the
0102                             ; second page, and every one above in the first; chktab.py checks both.
0102                             ; "]" returns: pop an address and jump to it.
0102                          ;*Macro unroll: h_ret:  POPR
0102   CF           H_RET:    DS   1-CPM,0CFh   
0103                          DS   CPM,0CDh   
0103                          DS   CPM,AROP&0FFh   
0103                          DS   CPM,AROP/256   
0103   42                     LD   B,D   
0104   4B                     LD   C,E   
0105                          ;*Macro unroll: brk1:   NEXT
0105   F7           BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
0106                          DS   CPM+FAST-CPM*FAST,0DDh   
0106                          DS   CPM+FAST-CPM*FAST,0E9h   
0106                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
0106                             ; drops the block start, "]" returns. No closer at all ends the program.
0106   7C           H_BREAK:   LD   A,H   
0107   B5                     OR   L   
0108   E1                     POP   HL   
0109   28 FA                  JR   Z,brk1   
010B   CD FF 02               CALL   skip   
010E   B7                     OR   A   ; skip returns 0 for ")"
010F   20 F1                  JR   NZ,h_ret   
0111                          ;*Macro unroll: rdrop:  POPR
0111   CF           RDROP:    DS   1-CPM,0CFh   
0112                          DS   CPM,0CDh   
0112                          DS   CPM,AROP&0FFh   
0112                          DS   CPM,AROP/256   
0112                          ;*Macro unroll:  NEXT
0112   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0113                          DS   CPM+FAST-CPM*FAST,0DDh   
0113                          DS   CPM+FAST-CPM*FAST,0E9h   
0113                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0113                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0113                             ; the body"s address instead. Either way it then skips to the matching "]'.
0113                             ; (The unchecked build takes anything that is not a letter as the space; the
0113                             ; checked build stops on it.)
0113   0A           H_DEF:    LD   A,(BC)   
0114   03                     INC   BC   
0115   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
0117   5F                     LD   E,A   ;   lands 64 bytes up
0118   E6 DF                  AND   0DFh   ; fold case
011A   FE 1A                  CP   26   
011C   30 0B                  JR   NC,def2   ; not a letter
011E   CB 23                  SLA   E   
0120   16 82                  LD   D,LETPAGE   ; DE -> cell
0122   79                     LD   A,C   
0123   12                     LD   (DE),A   
0124   1C                     INC   E   
0125   78                     LD   A,B   
0126   12                     LD   (DE),A   
0127   18 09                  JR   skipnx   
0129                DEF2:        
0129                          IF   CHECKED   
0129   7B                     LD   A,E   
012A   FE DF                  CP   " "-"A"+256   
012C   C2 D8 04               JP   NZ,e_brack   ; anything but a letter or a space
012F                          ENDIF      
012F   E5                     PUSH   HL   ; an anonymous block: push its address
0130   60                     LD   H,B   
0131   69                     LD   L,C   
0132                SKIPNX:      
0132                          IF   CHECKED   
0132   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0133                          ENDIF      ;   opener, the "[", just before where it starts
0133   CD FF 02     SKIPO:    CALL   skip   
0136                          ;*Macro unroll:  NEXT
0136   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0137                          DS   CPM+FAST-CPM*FAST,0DDh   
0137                          DS   CPM+FAST-CPM*FAST,0E9h   
0137   5E           H_FETCH:   LD   E,(HL)   ; "@"
0138   23                     INC   HL   
0139   56                     LD   D,(HL)   
013A   EB                     EX   DE,HL   
013B                          ;*Macro unroll:  NEXT
013B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
013C                          DS   CPM+FAST-CPM*FAST,0DDh   
013C                          DS   CPM+FAST-CPM*FAST,0E9h   
013C                             ; =============================================================================
013C                             ;  Handlers that must start in the image's second page.
013C                             ;  "?" is the last (with "," inside it), so its long tail may run past that
013C                             ;  page.
013C                             ; =============================================================================
013C                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
013C                             ; the matching ")".
013C   7C           H_OPEN:   LD   A,H   
013D   B5                     OR   L   
013E   E1                     POP   HL   
013F   28 F2                  JR   Z,skipo   
0141   C5                     PUSH   BC   ; the block starts at the IP
0142   18 8F                  JR   rpushn   
0144                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0144                             ; drops it and carries on.
0144   7C           H_CLOSE:   LD   A,H   
0145   B5                     OR   L   
0146   E1                     POP   HL   
0147   28 C8                  JR   Z,rdrop   
0149                          IF   QK   
0149   C3 C5 03               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
014C                          ENDIF      
014C                          IF   1-QK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
014C                          ENDIF      
014C                          IF   (1-QK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
014C                          ENDIF      
014C                          IF   (1-QK)*CPM   
                              JP   rpushn   
014C                          ENDIF      
014C                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
014C                             ; "-" has two jobs: directly before a digit it starts a negative number.
014C   0A           H_SUB:    LD   A,(BC)   
014D   D6 30                  SUB   "0"   
014F   FE 0A                  CP   10   
0151   38 04                  JR   C,negnum   
0153                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0153   E7                     DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0154                          DS   CPM,0CDh   
0154                          DS   CPM,ANEG&0FFh   
0154                          DS   CPM,ANEG/256   
0154   D1           H_ADD:    POP   DE   
0155   19                     ADD   HL,DE   
0156                          ;*Macro unroll:  NEXT
0156   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0157                          DS   CPM+FAST-CPM*FAST,0DDh   
0157                          DS   CPM+FAST-CPM*FAST,0E9h   
0157   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0158   CD D8 02               CALL   rdnum   
015B                          ;*Macro unroll:  NEGH
015B   E7                     DS   1-CPM,0E7h   
015C                          DS   CPM,0CDh   
015C                          DS   CPM,ANEG&0FFh   
015C                          DS   CPM,ANEG/256   
015C                          ;*Macro unroll:  NEXT
015C   F7                     DS   (1-CPM)*(1-FAST),0F7h   
015D                          DS   CPM+FAST-CPM*FAST,0DDh   
015D                          DS   CPM+FAST-CPM*FAST,0E9h   
015D   D1           H_AND:    POP   DE   
015E   7C                     LD   A,H   
015F   A2                     AND   D   
0160   67                     LD   H,A   
0161   7D                     LD   A,L   
0162   A3                     AND   E   
0163   6F                     LD   L,A   
0164                          ;*Macro unroll:  NEXT
0164   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0165                          DS   CPM+FAST-CPM*FAST,0DDh   
0165                          DS   CPM+FAST-CPM*FAST,0E9h   
0165                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0165                             ; cells first. Flipping both sign bits turns a signed compare into an
0165                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0165                             ; carry into -1 or 0 with no branch.
0165   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0166   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0167   7C                     LD   A,H   
0168   EE 80                  XOR   80h   
016A   67                     LD   H,A   
016B   7A                     LD   A,D   
016C   EE 80                  XOR   80h   
016E   57                     LD   D,A   
016F   ED 52                  SBC   HL,DE   ; carry if HL < DE
0171   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0173                          ;*Macro unroll:  NEXT
0173   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0174                          DS   CPM+FAST-CPM*FAST,0DDh   
0174                          DS   CPM+FAST-CPM*FAST,0E9h   
0174   D1           H_EQ:     POP   DE   
0175   B7                     OR   A   
0176   ED 52                  SBC   HL,DE   
0178   7C                     LD   A,H   
0179   B5                     OR   L   
017A   FE 01                  CP   1   ; carry only if a - b = 0
017C   18 F3                  JR   tf   
017E                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
017E                             ; multiplier shifts up through A:C.
017E                          IF   1-QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
017E                          ENDIF      
017E                          IF   QK   
017E   D1           H_MUL:    POP   DE   ; DE = multiplicand
017F   C3 99 03               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0182                          ENDIF      
0182                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0182                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0182                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0182                             ; stops on it.
0182                H_DIV:       
0182                          IF   CHECKED   
0182   7C                     LD   A,H   
0183   B5                     OR   L   
0184   CA D5 04               JP   Z,e_zero   
0187                          ENDIF      
0187   D1                     POP   DE   ; DE = a, HL = b
0188   D5                     PUSH   DE   ; a, for r's sign
0189   7A                     LD   A,D   
018A   AC                     XOR   H   
018B   F5                     PUSH   AF   ; S flag = sign of q
018C   CB 7C                  BIT   7,H   
018E   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0191   EB                     EX   DE,HL   
0192   CB 7C                  BIT   7,H   
0194   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0197   CD 83 02               CALL   udiv   ; HL = q, DE = r
019A   F1                     POP   AF   
019B   FC 20 00               CALL   M,neg16   ; q's sign
019E   EB                     EX   DE,HL   ; HL = r, DE = q
019F   F1                     POP   AF   ; A = a's high byte
01A0   B7                     OR   A   
01A1   FC 20 00               CALL   M,neg16   ; r's sign
01A4   D5                     PUSH   DE   ; q under r
01A5                          ;*Macro unroll:  NEXT
01A5   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01A6                          DS   CPM+FAST-CPM*FAST,0DDh   
01A6                          DS   CPM+FAST-CPM*FAST,0E9h   
01A6                             ; ---- stack and storage -----------------------------------------------------
01A6   E5           H_DUP:    PUSH   HL   ; ":"
01A7                          ;*Macro unroll:  NEXT
01A7   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01A8                          DS   CPM+FAST-CPM*FAST,0DDh   
01A8                          DS   CPM+FAST-CPM*FAST,0E9h   
01A8   E3           H_SWAP:   EX   (SP),HL   ; "%"
01A9                          ;*Macro unroll:  NEXT
01A9   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01AA                          DS   CPM+FAST-CPM*FAST,0DDh   
01AA                          DS   CPM+FAST-CPM*FAST,0E9h   
01AA                             ; (The checked build tests the address before it takes the value off the
01AA                             ; stack, so that an error report shows both.)
01AA                H_CSTORE:      ; "." ( c addr -- )
01AA                          IF   CHECKED   
01AA   CD B1 04               CALL   chkst   
01AD                          ENDIF      
01AD   D1                     POP   DE   
01AE   73                     LD   (HL),E   
01AF                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
01AF   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
01B0                          DS   CPM+FAST-CPM*FAST,0E1h   
01B0                          DS   CPM+FAST-CPM*FAST,0DDh   
01B0                          DS   CPM+FAST-CPM*FAST,0E9h   
01B0                H_STORE:      ; "!" ( n addr -- )
01B0                          IF   CHECKED   
01B0   CD B1 04               CALL   chkst   
01B3                          ENDIF      
01B3   D1                     POP   DE   
01B4   73                     LD   (HL),E   
01B5   23                     INC   HL   
01B6   72                     LD   (HL),D   
01B7                          ;*Macro unroll:  DROP
01B7   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01B8                          DS   CPM+FAST-CPM*FAST,0E1h   
01B8                          DS   CPM+FAST-CPM*FAST,0DDh   
01B8                          DS   CPM+FAST-CPM*FAST,0E9h   
01B8                             ; ---- console ---------------------------------------------------------------
01B8                             ; 22h pushes the address of the text after it and skips the string.
01B8   E5           H_STR:    PUSH   HL   
01B9   60                     LD   H,B   
01BA   69                     LD   L,C   
01BB   CD EE 02               CALL   skipstr   
01BE                          IF   CHECKED   
01BE   B7                     OR   A   ; 0: the text ran out before the closing quote
01BF   CA CD 04               JP   Z,e_quote   
01C2                          ENDIF      
01C2                          ;*Macro unroll:  NEXT
01C2   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01C3                          DS   CPM+FAST-CPM*FAST,0DDh   
01C3                          DS   CPM+FAST-CPM*FAST,0E9h   
01C3                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01C3                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01C3                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01C3                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01C3                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01C3                          ENDIF      
01C3                          IF   CHECKED   
01C3                             ; (The checked build has the loop as a routine, prstr, which the error
01C3                             ; report uses too. The address is kept meanwhile, for a report: it shows
01C3                             ; the stack as it was before the "$". /~ comes back to hp1.)
01C3   22 34 82     H_PRINT:   LD   (RSAVE),HL   
01C6   CD 1C 02     HP1:      CALL   prstr   
01C9                          ;*Macro unroll:  DROP
01C9   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01CA                          DS   CPM+FAST-CPM*FAST,0E1h   
01CA                          DS   CPM+FAST-CPM*FAST,0DDh   
01CA                          DS   CPM+FAST-CPM*FAST,0E9h   
01CA                          ENDIF      
01CA   7D           H_EMIT:   LD   A,L   ; "'"
01CB                          ;*Macro unroll:  PUTA
01CB   EF                     DS   1-CPM,0EFh   
01CC                          DS   CPM,0CDh   
01CC                          DS   CPM,APUT&0FFh   
01CC                          DS   CPM,APUT/256   
01CC                          ;*Macro unroll: pr9:    DROP
01CC   DF           PR9:      DS   (1-CPM)*(1-FAST),0DFh   
01CD                          DS   CPM+FAST-CPM*FAST,0E1h   
01CD                          DS   CPM+FAST-CPM*FAST,0DDh   
01CD                          DS   CPM+FAST-CPM*FAST,0E9h   
01CD                             ; "#" prints TOS as a signed decimal number, with no space after it.
01CD   CD ED 03     H_NUM:    CALL   psgn   
01D0                          ;*Macro unroll:  DROP
01D0   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01D1                          DS   CPM+FAST-CPM*FAST,0E1h   
01D1                          DS   CPM+FAST-CPM*FAST,0DDh   
01D1                          DS   CPM+FAST-CPM*FAST,0E9h   
01D1                             ; "?" ( n -- c ) or ( -n -- addr )
01D1                             ;   n > 0: wait about n ms for a key; 0 if none came
01D1                             ;   n = 0: wait for a key
01D1                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01D1                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01D1   CB 7C        H_KEY:    BIT   7,H   
01D3   20 19                  JR   NZ,line   
01D5   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01D7   CD 55 04     KT2:      CALL   getk   
01DA   20 0E                  JR   NZ,kt3   
01DC   1D                     DEC   E   
01DD   20 F8                  JR   NZ,kt2   
01DF   7C                     LD   A,H   ; 0? never counts down: it waits
01E0   B5                     OR   L   
01E1   28 F2                  JR   Z,kt1   
01E3   2B                     DEC   HL   
01E4   7C                     LD   A,H   
01E5   B5                     OR   L   
01E6   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01E8   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01E9   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01EA   6F           KT3:      LD   L,A   
01EB   26 00                  LD   H,0   
01ED                          ;*Macro unroll:  NEXT
01ED   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01EE                          DS   CPM+FAST-CPM*FAST,0DDh   
01EE                          DS   CPM+FAST-CPM*FAST,0E9h   
01EE                             ; Backspace takes the last character back (and is echoed as it
01EE                             ; is), CR ends (stored, not echoed), every other key is stored and
01EE                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01EE                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01EE                             ; is the place in the line: D holds the L of a full line.
01EE   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01F1   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01F2   9F                     SBC   A,A   
01F3   A5                     AND   L   ; (0 for a count that is too big)
01F4   2F                     CPL      
01F5   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01F6                             ;   at most
01F6   21 80 82               LD   HL,LINEBUF   
01F9   CD 55 04     LN2:      CALL   getk   
01FC   28 FB                  JR   Z,ln2   
01FE   FE 0D                  CP   13   
0200   28 16                  JR   Z,ln5   
0202   FE 08                  CP   8   
0204   28 0B                  JR   Z,ln4   
0206   5F                     LD   E,A   
0207   7D                     LD   A,L   
0208   BA                     CP   D   
0209   28 EE                  JR   Z,ln2   ; full
020B   73                     LD   (HL),E   
020C   2C                     INC   L   
020D   7B                     LD   A,E   
020E                          ;*Macro unroll: ln3:    PUTA
020E   EF           LN3:      DS   1-CPM,0EFh   
020F                          DS   CPM,0CDh   
020F                          DS   CPM,APUT&0FFh   
020F                          DS   CPM,APUT/256   
020F   18 E8                  JR   ln2   
0211   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0212   FA 0E 02               JP   M,ln3   ;   unless the line was empty (L left the
0215   2C                     INC   L   ;   upper half of the page)
0216   18 E1                  JR   ln2   
0218   77           LN5:      LD   (HL),A   ; the CR
0219   2E 80                  LD   L,LINEBUF & 0FFh   
021B                          ;*Macro unroll:  NEXT
021B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
021C                          DS   CPM+FAST-CPM*FAST,0DDh   
021C                          DS   CPM+FAST-CPM*FAST,0E9h   
021C                             ; =============================================================================
021C                             ;  More routines (no handler starts past this point)
021C                             ; =============================================================================
021C                          IF   CHECKED   
021C                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
021C                             ; "$", and the texts of the report). A NUL first is an error: Q.
021C   7E           PRSTR:    LD   A,(HL)   
021D   23                     INC   HL   
021E   FE 22                  CP   22h   
0220   C8                     RET   Z   
0221   B7                     OR   A   
0222   CA C3 04               JP   Z,e_dollar   
0225   FE 2F                  CP   "/"   
0227   20 0C                  JR   NZ,prs1   
0229   7E                     LD   A,(HL)   
022A   23                     INC   HL   
022B   FE 60                  CP   60h   
022D   38 04                  JR   C,prs0   
022F   FE 7F                  CP   7Fh   
0231   38 11                  JR   C,pesc   
0233   E6 BF        PRS0:     AND   0BFh   
0235                          ;*Macro unroll: prs1:   PUTA
0235   EF           PRS1:     DS   1-CPM,0EFh   
0236                          DS   CPM,0CDh   
0236                          DS   CPM,APUT&0FFh   
0236                          DS   CPM,APUT/256   
0236   18 E4                  JR   prstr   
0238                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0238                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0238                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0238                             ; pnl: the same, on a new line.
0238   CD 3E 02     PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
023B   0D 0A 22               DB   13,10,22h   ;   the caller's text)
023E   E3           PMSG:     EX   (SP),HL   
023F   CD 1C 02               CALL   prstr   
0242   E3                     EX   (SP),HL   
0243   C9                     RET      
0244                          ENDIF      
0244                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0244                             ; HL points past it. Each goes back into the loop that prints the string
0244                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0244                             ;    /a-/z   print the variable, as "#" does
0244                             ;    /{      clear the screen, the cursor to the top left
0244                             ;    /}      clear from the cursor to the end of the line
0244                             ;    /|  /`  show the cursor, hide it
0244                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0244   FE 7E        PESC:     CP   7Eh   
0246   28 1C                  JR   Z,pat   
0248   11 1C 02               LD   DE,PRLOOP   ; the others return into the loop
024B   D5                     PUSH   DE   
024C   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
024E   30 26                  JR   NC,pcon   
0250   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0252   30 2B                  JR   NC,phide   
0254   87                     ADD   A,A   ; the variable's cell
0255   C6 40                  ADD   A,40h   
0257   E5                     PUSH   HL   
0258   6F                     LD   L,A   
0259   26 82                  LD   H,LETPAGE   
025B   7E                     LD   A,(HL)   
025C   2C                     INC   L   
025D   66                     LD   H,(HL)   
025E   6F                     LD   L,A   
025F   CD ED 03               CALL   psgn   
0262   E1                     POP   HL   
0263   C9                     RET      
0264                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0264                             ; the checked build "$" is the routine prstr: its own return address goes
0264                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0264                             ; its two cells are there, and is s if not, before it prints anything.
0264                PAT:         
0264                          IF   CHECKED   
0264   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
0265   21 0A 7E               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
0268   39                     ADD   HL,SP   
0269   DA 8B 04               JP   C,e_under   
026C   E1                     POP   HL   
026D                          ENDIF      
026D   D1                     POP   DE   ; DE = the column
026E   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
026F                          IF   1-ANS   
026F   CD 15 FF               CALL   CONAT   
0272   E1                     POP   HL   
0273   C3 C6 01               JP   PRAGAIN   
0276                             ; With ANSI = 0 the machine's routines do the rest.
0276   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
0279   FE 02                  CP   2   
027B   CA 0F FF               JP   Z,CONEOL   ; /}
027E   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
027F   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0280   C3 12 FF               JP   CONCUR   
0283                          ENDIF      
0283                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    3Bh             ; ';'
                              DS   1-CPM,3Eh   ; ";"
                              DS   1-CPM,3Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Bh   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    48h             ; 'H'
                              DS   1-CPM,3Eh   ; "H"
                              DS   1-CPM,48h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,48h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0283                          ENDIF      
0283                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0283                          ENDIF      
0283                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
0283                          ENDIF      
0283                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0283                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0283                             ; the quotient bits arrive at the bottom of C.
0283                             ; Dividing by 2 is one shift (the spec wants that fast).
0283                          IF   1-QK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
0283                          ENDIF      
0283                          IF   QK   
0283                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0283                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0283   7A           UDIV:     LD   A,D   
0284   B7                     OR   A   
0285   20 1A                  JR   NZ,uq1   ; 256 and up
0287   B3                     OR   E   
0288   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
028A   3D                     DEC   A   
028B   A3                     AND   E   
028C   20 2F                  JR   NZ,udv0   ; not a power of two
028E   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
028F   3D                     DEC   A   ;   r = L & (2^k - 1)
0290   A5                     AND   L   
0291   F5                     PUSH   AF   
0292   CB 3B        UQ2:      SRL   E   
0294   38 06                  JR   C,uq3   
0296   CB 3C                  SRL   H   
0298   CB 1D                  RR   L   
029A   18 F6                  JR   uq2   
029C   F1           UQ3:      POP   AF   
029D   5F                     LD   E,A   
029E   16 00                  LD   D,0   
02A0   C9                     RET      
02A1   7B           UQ1:      LD   A,E   
02A2   B7                     OR   A   
02A3   20 18                  JR   NZ,udv0   
02A5   7A                     LD   A,D   
02A6   3D                     DEC   A   
02A7   A2                     AND   D   
02A8   20 13                  JR   NZ,udv0   ; not a power of two
02AA   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
02AB   3D                     DEC   A   ;   r = HL & (2^k - 1)
02AC   A4                     AND   H   
02AD   5F                     LD   E,A   ; (the remainder's high byte,
02AE   7D                     LD   A,L   ;   and its low byte)
02AF   6C                     LD   L,H   
02B0   26 00                  LD   H,0   
02B2   CB 3A        UQ4:      SRL   D   
02B4   38 04                  JR   C,uq5   
02B6   CB 3D                  SRL   L   
02B8   18 F8                  JR   uq4   
02BA   53           UQ5:      LD   D,E   
02BB   5F                     LD   E,A   
02BC   C9                     RET      
02BD                          ENDIF      
02BD                          IF   1-FAST   
02BD   C5           UDV0:     PUSH   BC   
02BE   7C                     LD   A,H   
02BF   4D                     LD   C,L   
02C0   21 00 00               LD   HL,0   
02C3   06 10                  LD   B,16   
02C5   CB 21        UDV1:     SLA   C   
02C7   17                     RLA      
02C8   ED 6A                  ADC   HL,HL   
02CA   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
02CC   30 02                  JR   NC,udv2   ;   always fits in 16 bits
02CE   19                     ADD   HL,DE   ; too much: put it back, and cancel the
02CF   0D                     DEC   C   ;   INC below
02D0   0C           UDV2:     INC   C   ; a quotient bit
02D1   10 F2                  DJNZ   udv1   
02D3   EB                     EX   DE,HL   ; DE = remainder
02D4   67                     LD   H,A   
02D5   69                     LD   L,C   ; HL = quotient
02D6   C1                     POP   BC   
02D7   C9                     RET      
02D8                          ENDIF      
02D8                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
02D8                          ENDIF      
02D8                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
02D8                             ; non-digit. Values wrap at 16 bits, as the spec says.
02D8   21 00 00     RDNUM:    LD   HL,0   
02DB   0A           RDN1:     LD   A,(BC)   
02DC   D6 30                  SUB   "0"   
02DE   FE 0A                  CP   10   
02E0   D0                     RET   NC   
02E1   03                     INC   BC   
02E2   54                     LD   D,H   
02E3   5D                     LD   E,L   
02E4   29                     ADD   HL,HL   
02E5   29                     ADD   HL,HL   
02E6   19                     ADD   HL,DE   
02E7   29                     ADD   HL,HL   ; HL * 10
02E8   5F                     LD   E,A   
02E9   16 00                  LD   D,0   
02EB   19                     ADD   HL,DE   
02EC   18 ED                  JR   rdn1   
02EE                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02EE                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02EE                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
02EE                          ENDIF      
02EE                          IF   CHECKED   
02EE                             ; The checked build never steps over a NUL: if the text runs out first it
02EE                             ; returns A = 0 with the IP on the NUL.
02EE   0A           SKIPSTR:   LD   A,(BC)   
02EF   B7                     OR   A   
02F0   C8                     RET   Z   
02F1   03                     INC   BC   
02F2   FE 22                  CP   22h   
02F4   C8                     RET   Z   
02F5   FE 2F                  CP   "/"   
02F7   20 F5                  JR   NZ,skipstr   
02F9   0A                     LD   A,(BC)   ; the escaped character
02FA   B7                     OR   A   
02FB   C8                     RET   Z   
02FC   03                     INC   BC   
02FD   18 EF                  JR   skipstr   
02FF                          ENDIF      
02FF                             ; skip: read past text to the closer at this level, and return A = 0 if it
02FF                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02FF                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02FF                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02FF                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02FF                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02FF                             ; 
02FF                             ; The checked build also looks at the character the skip was started by,
02FF                             ; which is always the one just before where it starts: "(" must end at ")",
02FF                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02FF                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
02FF                             ; place where the skip started, for the report.
02FF                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
02FF                          ENDIF      
02FF                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
02FF                          ENDIF      
02FF                          IF   1-QK   
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
02FF                          ENDIF      
02FF                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
02FF                          ENDIF      
02FF                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
02FF                          ENDIF      
02FF                          IF   1-QK   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
02FF                          ENDIF      
02FF                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
02FF                          ENDIF      
02FF                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02FF                          ENDIF      
02FF                          IF   QK   
02FF                             ; The skip cache. Nearly every skip is one that has happened before (a loop
02FF                             ; skips the same false block on every pass), so the first scan from each
02FF                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
02FF                             ; start's low byte. Only skips that start in the program text are kept (the
02FF                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
02FF                             ; A program that changes its own text while it runs is not looked after.
02FF   ED 43 3C 82  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
0303   78                     LD   A,B   ;   checked report's place)
0304   FE 83                  CP   PROG/256   
0306   38 1B                  JR   C,sks   ; below the program text: no cache
0308   79                     LD   A,C   
0309   87                     ADD   A,A   
030A   87                     ADD   A,A   
030B   5F                     LD   E,A   
030C   16 F0                  LD   D,CPAGE   ; DE -> the entry
030E   1A                     LD   A,(DE)   
030F   B9                     CP   C   
0310   20 11                  JR   NZ,sks   
0312   1C                     INC   E   
0313   1A                     LD   A,(DE)   
0314   B8                     CP   B   
0315   20 0C                  JR   NZ,sks   
0317   1C                     INC   E   
0318   1A                     LD   A,(DE)   
0319   4F                     LD   C,A   
031A   1C                     INC   E   
031B   1A                     LD   A,(DE)   
031C   47                     LD   B,A   ; a hit: the IP is past the closer
031D   0B                     DEC   BC   
031E   0A                     LD   A,(BC)   
031F   03                     INC   BC   
0320   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
0322   C9                     RET      
0323                SKS:         
0323                          ENDIF      
0323                          IF   QK*CHECKED   
0323   0B                     DEC   BC   
0324   0A                     LD   A,(BC)   
0325   03                     INC   BC   
0326   5F                     LD   E,A   ; E = the opener: ( [ or \
0327                          ENDIF      
0327                          IF   QK   
0327                             ; The scan. Most characters are nothing to it, and two range tests rule
0327                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
0327   16 00                  LD   D,0   
0329   14           SQ3:      INC   D   ; an opener: one deeper
032A   0A           SQ1:      LD   A,(BC)   
032B   03                     INC   BC   
032C   FE 5E                  CP   5Eh   
032E   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
0330   FE 5B                  CP   5Bh   
0332   30 25                  JR   NC,sqb   ; [ \ ]
0334   FE 2A                  CP   2Ah   
0336   30 F2                  JR   NC,sq1   ; * to Z: nothing
0338   FE 28                  CP   28h   
033A   28 ED                  JR   Z,sq3   ; (
033C   30 25                  JR   NC,sqc   ; )
033E   FE 22                  CP   22h   
0340   28 12                  JR   Z,sqq   ; a string
0342   B7                     OR   A   
0343   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
0345                          ENDIF      
0345                          IF   QK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
0345                          ENDIF      
0345                          IF   QK*CHECKED   
0345   0B                     DEC   BC   ; NUL: the IP stays on it
0346   CB 53                  BIT   2,E   ; the text ran out:
0348   C2 09 FF               JP   NZ,SKEND   ;   "\" with no closer ends the program
034B   ED 4B 3C 82  SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
034F   3E 4E                  LD   A,"N"   
0351   C3 C0 04               JP   errp   ; (errp drops skip's return address)
0354                          ENDIF      
0354                          IF   QK   
0354   CD EE 02     SQQ:      CALL   skipstr   ; step over the string
0357   18 D1                  JR   sq1   
0359   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
035B   28 CD                  JR   Z,sq1   ; "\" is nothing here
035D   38 CA                  JR   C,sq3   ; [
035F   3E 02                  LD   A,2   ; ]
0361   18 01                  JR   sq4   
0363   AF           SQC:      XOR   A   ; )
0364   15           SQ4:      DEC   D   
0365   20 C3                  JR   NZ,sq1   
0367                          ENDIF      
0367                          IF   QK*CHECKED   
0367   57                     LD   D,A   ; the closer at this level (as above): 2 here
0368   AB                     XOR   E   ;   means the wrong closer
0369   E6 06                  AND   6   
036B   FE 02                  CP   2   
036D   7A                     LD   A,D   
036E   28 DB                  JR   Z,sq7   
0370                          ENDIF      
0370                          IF   QK   
0370                             ; The closer at this level: remember the skip (if it started in the program
0370                             ; text), and return A = 0 for ")" or 2 for "]".
0370   F5                     PUSH   AF   
0371   E5                     PUSH   HL   
0372   2A 3C 82               LD   HL,(SKPL)   
0375   7C                     LD   A,H   
0376   FE 83                  CP   PROG/256   
0378   38 11                  JR   C,sq9   
037A   7D                     LD   A,L   
037B   87                     ADD   A,A   
037C   87                     ADD   A,A   
037D   5F                     LD   E,A   
037E   16 F0                  LD   D,CPAGE   
0380   7D                     LD   A,L   
0381   12                     LD   (DE),A   
0382   1C                     INC   E   
0383   7C                     LD   A,H   
0384   12                     LD   (DE),A   
0385   1C                     INC   E   
0386   79                     LD   A,C   
0387   12                     LD   (DE),A   
0388   1C                     INC   E   
0389   78                     LD   A,B   
038A   12                     LD   (DE),A   
038B   E1           SQ9:      POP   HL   
038C   F1                     POP   AF   
038D   C9                     RET      
038E                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
038E   E5           SKCLR:    PUSH   HL   
038F   21 00 F0               LD   HL,CPAGE*256   
0392   36 00        SKC1:     LD   (HL),0   
0394   2C                     INC   L   
0395   20 FB                  JR   NZ,skc1   
0397   E1                     POP   HL   
0398   C9                     RET      
0399                          ENDIF      
0399                             ;  ---- Speed-ups (base builds) -------------------------------------------
0399                             ;  The skip cache is above. These are the handlers' tails that the builds with
0399                             ;  room take, kept here, out of the handlers' first two pages.
0399                          IF   QK   
0399                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
0399                             ; multiplier (most multiplications have one, a count or a small constant).
0399   7C           MULQ:     LD   A,H   
039A   B7                     OR   A   
039B   28 05                  JR   Z,mq8   ; the multiplier is below 256
039D   7A                     LD   A,D   
039E   B7                     OR   A   
039F   20 11                  JR   NZ,mq16   
03A1   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
03A2                          ENDIF      
03A2                          IF   QK*(1-FAST)   
03A2   7D           MQ8:      LD   A,L   
03A3   21 00 00               LD   HL,0   
03A6   C5                     PUSH   BC   
03A7   06 08                  LD   B,8   
03A9   29           MQ1:      ADD   HL,HL   
03AA   17                     RLA      
03AB   30 01                  JR   NC,mq2   
03AD   19                     ADD   HL,DE   
03AE   10 F9        MQ2:      DJNZ   mq1   
03B0   C1                     POP   BC   
03B1                          ;*Macro unroll:  NEXT
03B1   F7                     DS   (1-CPM)*(1-FAST),0F7h   
03B2                          DS   CPM+FAST-CPM*FAST,0DDh   
03B2                          DS   CPM+FAST-CPM*FAST,0E9h   
03B2   C5           MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
03B3   7C                     LD   A,H   
03B4   4D                     LD   C,L   
03B5   21 00 00               LD   HL,0   
03B8   06 10                  LD   B,16   
03BA   29           MQ3:      ADD   HL,HL   
03BB   CB 21                  SLA   C   
03BD   17                     RLA      
03BE   30 01                  JR   NC,mq4   
03C0   19                     ADD   HL,DE   
03C1   10 F7        MQ4:      DJNZ   mq3   
03C3   C1                     POP   BC   
03C4                          ;*Macro unroll:  NEXT
03C4   F7                     DS   (1-CPM)*(1-FAST),0F7h   
03C5                          DS   CPM+FAST-CPM*FAST,0DDh   
03C5                          DS   CPM+FAST-CPM*FAST,0E9h   
03C5                          ENDIF      
03C5                          IF   FAST   
                                 ; (the fast build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
03C5                          ENDIF      
03C5                          IF   QK   
03C5                             ; A true ")" reads the block start where it is, on top of the return stack,
03C5                             ; instead of popping it and pushing it back; the break key is looked at as
03C5                             ; rpushn would.
03C5   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
03C8   FD 46 01               LD   B,(IY+1)   
03CB   E5                     PUSH   HL   
03CC   21 36 82               LD   HL,PCNT   
03CF   35                     DEC   (HL)   
03D0   E1                     POP   HL   
03D1   CC 27 04               CALL   Z,pollk   
03D4                          ;*Macro unroll:  NEXT
03D4   F7                     DS   (1-CPM)*(1-FAST),0F7h   
03D5                          DS   CPM+FAST-CPM*FAST,0DDh   
03D5                          DS   CPM+FAST-CPM*FAST,0E9h   
03D5                          ENDIF      
03D5                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
03D5                          ENDIF      
03D5                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
03D5                          ENDIF      
03D5                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
03D5   CD 8E 03     QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
03D8   C3 72 00               JP   init   
03DB                          ENDIF      
03DB                             ; =============================================================================
03DB                             ;  Dispatch table: the low byte of each handler's address, in code order
03DB                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03DB                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03DB                             ; =============================================================================
03DB                             ; The handlers of the first NPG1 characters start in the image's second page.
03DB                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03DB                             ; differs between the builds, so the count is worked out here.
03DB                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03DB                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03DB                PGBRK:    EQU   (h_break-BASE)/256   
03DB                PGDEF:    EQU   (h_def-BASE)/256   
03DB                PGFET:    EQU   (h_fetch-BASE)/256   
03DB                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03DB                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
03DB                          ENDIF      
03DB                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03DB                             ; and return its value in A with the carry set; otherwise leave the IP and
03DB                             ; return with the carry clear.
03DB   0A           HEXC:     LD   A,(BC)   
03DC   D6 30                  SUB   "0"   
03DE   FE 0A                  CP   10   
03E0   38 09                  JR   C,hc1   
03E2   E6 DF                  AND   0DFh   
03E4   D6 11                  SUB   11h   
03E6   FE 06                  CP   6   
03E8   D0                     RET   NC   
03E9   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03EB   03           HC1:      INC   BC   
03EC   C9                     RET      
03ED                             ; psgn: print HL as a signed number. Keeps BC.
03ED   CB 7C        PSGN:     BIT   7,H   
03EF   28 04                  JR   Z,pdec   
03F1                          ;*Macro unroll:  PUTK    2Dh             ; '-'
03F1   3E                     DS   1-CPM,3Eh   ; "-"
03F2   2D                     DS   1-CPM,2Dh   
03F3   EF                     DS   1-CPM,0EFh   
03F4                          DS   CPM,0CDh   
03F4                          DS   CPM,APTK&0FFh   
03F4                          DS   CPM,APTK/256   
03F4                          DS   CPM,2Dh   
03F4                          ;*Macro unroll:  NEGH
03F4   E7                     DS   1-CPM,0E7h   
03F5                          DS   CPM,0CDh   
03F5                          DS   CPM,ANEG&0FFh   
03F5                          DS   CPM,ANEG/256   
03F5                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03F5                             ; Keeps BC.
03F5   11 0A 00     PDEC:     LD   DE,10   
03F8   CD 83 02               CALL   udiv   ; HL = HL / 10, E = the last digit
03FB   7B                     LD   A,E   
03FC   F5                     PUSH   AF   
03FD   7C                     LD   A,H   
03FE   B5                     OR   L   
03FF   C4 F5 03               CALL   NZ,pdec   
0402   F1                     POP   AF   
0403   C6 30                  ADD   A,"0"   
0405                          ;*Macro unroll:  PUTAR
0405   EF                     DS   1-CPM,0EFh   
0406   C9                     DS   1-CPM,0C9h   
0407                          DS   CPM,0C3h   
0407                          DS   CPM,APUT&0FFh   
0407                          DS   CPM,APUT/256   
0407                             ; (The table goes here instead in the builds where, before psgn, it would
0407                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0407                             ; page: PTPAD is 0 unless it must.)
0407                          IF   (1-TABP0)*PTLATE   
0407                PTPH:     EQU   $ & 0FFh   
0407                PTPX:     EQU   (PTPH + 31) / 256   
0407                PTPAD:    EQU   PTPX * (256 - PTPH)   
0407                          DS   PTPAD   
0407                PTAB:        
0407                          ;*Macro unroll:  PTABLE
0407   B0                     DB   h_store & 0FFh   
0408   B8                     DB   h_str & 0FFh   
0409   CD                     DB   h_num & 0FFh   
040A   C3                     DB   h_print & 0FFh   
040B   A8                     DB   h_swap & 0FFh   
040C   5D                     DB   h_and & 0FFh   
040D   CA                     DB   h_emit & 0FFh   
040E   3C                     DB   h_open & 0FFh   
040F   44                     DB   h_close & 0FFh   
0410   7E                     DB   h_mul & 0FFh   
0411   54                     DB   h_add & 0FFh   
0412   E9                     DB   h_cfetch & 0FFh   
0413   4C                     DB   h_sub & 0FFh   
0414   AA                     DB   h_cstore & 0FFh   
0415   82                     DB   h_div & 0FFh   
0416   A6                     DB   h_dup & 0FFh   
0417   AF                     DB   h_drop & 0FFh   
0418   65                     DB   h_lt & 0FFh   
0419   74                     DB   h_eq & 0FFh   
041A   66                     DB   h_gt & 0FFh   
041B   D1                     DB   h_key & 0FFh   
041C   37                     DB   h_fetch & 0FFh   
041D   13                     DB   h_def & 0FFh   
041E   06                     DB   h_break & 0FFh   
041F   02                     DB   h_ret & 0FFh   
0420   90                     DB   h_xor & 0FFh   
0421   A3                     DB   h_alloc & 0FFh   
0422   EC                     DB   h_grave & 0FFh   
0423   E8                     DB   h_tor & 0FFh   
0424   98                     DB   h_or & 0FFh   
0425   1C                     DB   h_fromr & 0FFh   
0426   A0                     DB   h_not & 0FFh   
0427                PTABEND:      
0427                          ENDIF      
0427                             ; =============================================================================
0427                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0427                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0427                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0427                             ;  they are the host's KEY and CONOUT routines themselves.
0427                             ; 
0427                             ;  A running program reads the keyboard only through getk and pollk, which
0427                             ;  between them give the break key its rules:
0427                             ;    - Ctrl-C stops the program;
0427                             ;    - any other key that the break check reads is held in KEYBUF for the
0427                             ;      next "?", and a newer one takes its place;
0427                             ;    - "?" (getk) takes the held key first;
0427                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0427                             ;      key like any other, but two of them within about 250 ms still stop it.
0427                             ;  Both are called straight from a handler, never from a routine under one:
0427                             ;  the checked build's report counts on finding one return address above the
0427                             ;  data stack.
0427                             ; =============================================================================
0427                          IFN   CPM   
0427                RAWK:     EQU   KEY   
0427                          ENDIF      
0427                             ; pollk: the break check (see rpushn).
0427   CD 06 FF     POLLK:    CALL   rawk   
042A   C8                     RET   Z   ; no key
042B   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
042E   FE 03        PK1:      CP   3   ; (getk joins here)
0430   C0                     RET   NZ   
0431                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0431                             ; the program has turned it off, wait about 250 ms for one more key: a
0431                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0431                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0431   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0434   B7                     OR   A   
0435   CA BE 04     CT0:      JP   Z,brk   
0438   D5                     PUSH   DE   
0439   11 10 27               LD   DE,250*MSLOOP   
043C   CD 06 FF     CT1:      CALL   rawk   
043F   20 05                  JR   NZ,ct2   
0441   1B                     DEC   DE   
0442   7A                     LD   A,D   
0443   B3                     OR   E   
0444   20 F6                  JR   NZ,ct1   
0446   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0447   FE 03                  CP   3   
0449   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
044B   B7                     OR   A   
044C   28 03                  JR   Z,ct3   
044E   32 7A 82               LD   (KEYBUF),A   
0451   3E 03        CT3:      LD   A,3   
0453   B7                     OR   A   
0454   C9                     RET      
0455                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0455   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0456   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0459   7E                     LD   A,(HL)   
045A   36 00                  LD   (HL),0   
045C   E1                     POP   HL   
045D   B7                     OR   A   
045E   C0                     RET   NZ   
045F   CD 06 FF               CALL   rawk   
0462   C8                     RET   Z   
0463   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0465                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0465                          ENDIF      ;   (with the editor, both stacks are cleared);
0465                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0465                          ENDIF      
0465                          IF   CHECKED   
0465                BRK:      EQU   e_break   ;   the checked build reports B
0465                          ENDIF      
0465                          IF   CPM   
                                 ; The routines a generic build keeps in page zero (see there). Here they are
                                 ; out of the way of the handlers, which must fit in the image's first two
                                 ; pages.
                    RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
                              LD   D,(IY+1)   
                              INC   IY   
                              INC   IY   
                              RET      
                    NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
0465                          ENDIF      
0465                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0465                          ENDIF      
0465                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JR   putc   
                    PUTK:     EX   (SP),HL   ; print the byte after the CALL
                              LD   A,(HL)   
                              INC   HL   
                              EX   (SP),HL   
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                                 ; It keeps every register but A and the flags: BDOS may change any of them
                                 ; (IX and IY too, in a Z80 BDOS or BIOS).
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              PUSH   IX   
                              PUSH   IY   
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              POP   IY   
                              POP   IX   
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              OR   A   ; (for getk)
                              RET      
0465                          ENDIF      
0465                             ; =============================================================================
0465                             ;  Checked build: the checks and the error report
0465                             ; =============================================================================
0465                          IF   CHECKED   
0465                             ; chkstk: both stacks are checked once per character, not in every handler.
0465                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0465                             ; the constant carries if it is above (cells were popped that were never
0465                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0465                             ; a character late at most: the bytes above DSTOP and the guard band below
0465                             ; the page take what happens meanwhile. DE is free between characters.
0465   EB           CHKSTK:   EX   DE,HL   
0466   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0469   39                     ADD   HL,SP   
046A   EB                     EX   DE,HL   
046B   38 1E                  JR   C,e_under   
046D   14                     INC   D   
046E   20 17                  JR   NZ,e_over   
0470   FD E5                  PUSH   IY   ; the return stack: in its page (or it has
0472   D1                     POP   DE   ;   overflowed), and not above its empty
0473   7A                     LD   A,D   ;   position (an underflow stays inside the
0474   FE 80                  CP   RSPAGE   ;   page, in the guard band)
0476   7B                     LD   A,E   
0477   20 0B                  JR   NZ,e_rover   
0479   FE E1                  CP   RSTOP&0FFh+1   
047B   D8                     RET   C   
047C   FD 21 E0 80            LD   IY,RSTOP   ; return stack underflow: it counts as empty
0480   3E 72                  LD   A,"r"   
0482   18 3C                  JR   errp   
0484   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0486   11                     DB   11h   ; (LD DE,nn hides the next entry)
0487   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0489   18 35                  JR   errp   
048B   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
048E   3E 73                  LD   A,"s"   
0490   18 48                  JR   error   
0492                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0492                             ; was never defined still holds 0000h, and the byte there is a reserved one
0492                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0492                             ; an undefined word. The call is undone, so the place is the call itself.
0492   04           E_HI:     INC   B   
0493   10 3D                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0495                          ;*Macro unroll:  POPR
0495   CF                     DS   1-CPM,0CFh   
0496                          DS   CPM,0CDh   
0496                          DS   CPM,AROP&0FFh   
0496                          DS   CPM,AROP/256   
0496   42                     LD   B,D   
0497   4B                     LD   C,E   
0498   3E 55                  LD   A,"U"   
049A   18 3E                  JR   error   
049C                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
049C                             ; the count. Stop if the top is not below the limit page, or is below the
049C                             ; program's end.
049C                CHKHP:       
049C                          ENDIF      
049C                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
049C                          ENDIF      
049C                          IF   CHECKED*(1-CPM)   
049C                             ; (Here the program's space is under 32K, so a top that wrapped
049C                             ; round always falls outside it.)
049C   7C                     LD   A,H   
049D   FE F0                  CP   HEAPLIM   
049F   30 09                  JR   NC,e_heap   
04A1                          ENDIF      
04A1                          IF   CHECKED   
04A1   D5                     PUSH   DE   
04A2   EB                     EX   DE,HL   
04A3   2A 38 82               LD   HL,(NPEND)   
04A6   19                     ADD   HL,DE   ; carry: at or above the program's end
04A7   EB                     EX   DE,HL   
04A8   D1                     POP   DE   
04A9   D8                     RET   C   
04AA   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
04AB   ED 52                  SBC   HL,DE   
04AD   3E 48                  LD   A,"H"   
04AF   18 0F                  JR   errp   
04B1                             ; chkst: stop unless HL is in the program's own space: from the letter page
04B1                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
04B1                             ; whatever lies above the limit are safe. Memory above the heap top but
04B1                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
04B1                             ; It is the page of HL + 1 that is tested, so that one test serves both
04B1                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
04B1                             ; Keeps HL and BC. It runs on into its own error entry.
04B1   23           CHKST:    INC   HL   
04B2   7C                     LD   A,H   
04B3   2B                     DEC   HL   
04B4   FE 82                  CP   LETPAGE   
04B6   38 03                  JR   C,e_store   
04B8                          ENDIF      
04B8                          IF   CHECKED*(1-CPM)   
04B8   FE F0                  CP   HEAPLIM   
04BA   D8                     RET   C   
04BB                          ENDIF      
04BB                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
04BB                          ENDIF      
04BB                          IF   CHECKED   
04BB                             ; Error entries. Each loads its letter and then hides the next entry inside
04BB                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
04BB   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
04BD   11                     DB   11h   
04BE   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
04C0                             ; errp: an error found inside a routine: drop its return address first.
04C0   D1           ERRP:     POP   DE   
04C1   18 17                  JR   error   
04C3                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
04C3                             ; back in TOS. prstr"s return address goes first. But if "$' had no
04C3                             ; address at all (the stack was empty), it is s, found now: chkstk, called
04C3                             ; one cell up, sees the stack past its empty place then.
04C3   D1           E_DOLLAR:   POP   DE   
04C4   E1                     POP   HL   
04C5   CD 65 04               CALL   chkstk   
04C8   E5                     PUSH   HL   
04C9   2A 34 82               LD   HL,(RSAVE)   
04CC   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
04CD   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
04CE   4D                     LD   C,L   ;   past the opening quote, which is the place
04CF   3E 51                  LD   A,"Q"   
04D1   11                     DB   11h   
04D2   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
04D4   11                     DB   11h   
04D5   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
04D7   11                     DB   11h   
04D8   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
04DA                             ; error: the report, then the end. A = the letter, BC = one past the place,
04DA                             ; HL = TOS, and both stacks as the report is to show them:
04DA                             ; 
04DA                             ;   Err X @ line,col
04DA                             ;   D:n: the top 8 cells at most, bottom to top
04DA                             ;   R:n
04DA   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
04DB   5F                     LD   E,A   
04DC   CD 38 02               CALL   pnl   
04DF   45 72 72 20 22         DB   "Err ",22h   
04E4   7B                     LD   A,E   
04E5                          ;*Macro unroll:  PUTA
04E5   EF                     DS   1-CPM,0EFh   
04E6                          DS   CPM,0CDh   
04E6                          DS   CPM,APUT&0FFh   
04E6                          DS   CPM,APUT/256   
04E6   CD 3E 02               CALL   pmsg   
04E9   20 40 20 22            DB   " @ ",22h   
04ED   0B                     DEC   BC   ; BC = the place
04EE                             ; The line and column. A place below the program is in the line
04EE                             ; buffer: line 0. Otherwise count the LFs from the program's start;
04EE                             ; DE = the line's number, HL = where it starts.
04EE   21 80 82               LD   HL,LINEBUF   
04F1   11 00 00               LD   DE,0   
04F4   78                     LD   A,B   
04F5   FE 83                  CP   PROG/256   
04F7   38 14                  JR   C,er3   
04F9   24                     INC   H   
04FA   6B                     LD   L,E   ; HL = PROG
04FB   13           ER1:      INC   DE   ; a new line starts at HL
04FC   E5                     PUSH   HL   
04FD   7D           ER2:      LD   A,L   
04FE   91                     SUB   C   
04FF   7C                     LD   A,H   
0500   98                     SBC   A,B   
0501   30 09                  JR   NC,er2x   ; reached the place
0503   7E                     LD   A,(HL)   
0504   23                     INC   HL   
0505   FE 0A                  CP   10   
0507   20 F4                  JR   NZ,er2   
0509   F1                     POP   AF   
050A   18 EF                  JR   er1   
050C   E1           ER2X:     POP   HL   
050D   C5           ER3:      PUSH   BC   
050E   E5                     PUSH   HL   
050F   EB                     EX   DE,HL   
0510   CD F5 03               CALL   pdec   ; the line
0513                          ;*Macro unroll:  PUTK    2Ch             ; ','
0513   3E                     DS   1-CPM,3Eh   ; ","
0514   2C                     DS   1-CPM,2Ch   
0515   EF                     DS   1-CPM,0EFh   
0516                          DS   CPM,0CDh   
0516                          DS   CPM,APTK&0FFh   
0516                          DS   CPM,APTK/256   
0516                          DS   CPM,2Ch   
0516   D1                     POP   DE   
0517   E1                     POP   HL   
0518   B7                     OR   A   
0519   ED 52                  SBC   HL,DE   
051B   23                     INC   HL   
051C   CD F5 03               CALL   pdec   ; the column
051F                             ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
051F                             ;                       R:n
051F                             ; TOS is in memory with the rest (pushed) by now.
051F   CD 38 02               CALL   pnl   
0522   44 3A 22               DB   "D:",22h   
0525   21 FA 81               LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
0528   ED 72                  SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
052A                             ;   and holds nothing; pnl left the carry clear)
052A   CD 70 05               CALL   phalf   ; the depth
052D                          ;*Macro unroll:  PUTK    3Ah             ; ':'
052D   3E                     DS   1-CPM,3Eh   ; ":"
052E   3A                     DS   1-CPM,3Ah   
052F   EF                     DS   1-CPM,0EFh   
0530                          DS   CPM,0CDh   
0530                          DS   CPM,APTK&0FFh   
0530                          DS   CPM,APTK/256   
0530                          DS   CPM,3Ah   
0530   79                     LD   A,C   
0531   FE 09                  CP   9   
0533   38 0A                  JR   C,er6   
0535   CD 3E 02               CALL   pmsg   
0538   20 2E 2E 2E 22         DB   " ...",22h   
053D   0E 08                  LD   C,8   
053F   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0541   69                     LD   L,C   
0542   29                     ADD   HL,HL   
0543   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0544   0C                     INC   C   
0545   0D           ER7:      DEC   C   
0546   28 0F                  JR   Z,er8   
0548   2B                     DEC   HL   
0549   56                     LD   D,(HL)   
054A   2B                     DEC   HL   
054B   5E                     LD   E,(HL)   
054C   E5                     PUSH   HL   
054D                          ;*Macro unroll:  PUTK    20h             ; ' '
054D   3E                     DS   1-CPM,3Eh   ; " "
054E   20                     DS   1-CPM,20h   
054F   EF                     DS   1-CPM,0EFh   
0550                          DS   CPM,0CDh   
0550                          DS   CPM,APTK&0FFh   
0550                          DS   CPM,APTK/256   
0550                          DS   CPM,20h   
0550   EB                     EX   DE,HL   
0551   CD ED 03               CALL   psgn   
0554   E1                     POP   HL   
0555   18 EE                  JR   er7   
0557   CD 38 02     ER8:      CALL   pnl   
055A   52 3A 22               DB   "R:",22h   
055D   FD E5                  PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
055F   E1                     POP   HL   ;   at most one entry below its page), so
0560   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough
0562   95                     SUB   L   
0563   6F                     LD   L,A   
0564   26 00                  LD   H,0   
0566   CD 70 05               CALL   phalf   
0569   CD 38 02               CALL   pnl   
056C   22                     DB   22h   
056D                          ENDIF      
056D                          IF   CHECKED*(1-EDITOR)   
056D   C3 14 00               JP   endprog   
0570                          ENDIF      
0570                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
0570                          ENDIF      
0570                          IF   CHECKED   
0570                             ; phalf: print half of HL, and leave it in C.
0570   CB 3C        PHALF:    SRL   H   
0572   CB 1D                  RR   L   
0574   E5                     PUSH   HL   
0575   CD F5 03               CALL   pdec   
0578   C1                     POP   BC   
0579   C9                     RET      
057A                          ENDIF      
057A                             ; =============================================================================
057A                             ;  The line editor (EDITOR = 1)
057A                             ; 
057A                             ;  The interpreter starts here, and a program that ends comes back here.
057A                             ;  There is no prompt. It follows the spec's suggested standard for a line
057A                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
057A                             ; 
057A                             ;    n text    put the text in as line n; the lines from n on move down. A
057A                             ;              number past the end (or 0) adds the line at the end.
057A                             ;    n         take line n out
057A                             ;    anything else is run at once, as B8Script. (Start such a line with a
057A                             ;    space if it would begin with a digit.)
057A                             ; 
057A                             ;  A command key ends the line too, and takes what was typed as its argument:
057A                             ; 
057A                             ;    ^G        run the program
057A                             ;    n ^L      list from line n (no number: all of it). Any key holds the
057A                             ;              list until another key is pressed; Ctrl-C ends it.
057A                             ;    n ^E      put line n in the input line; Return puts it back, changed
057A                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
057A                             ;              last time). Generic: what is typed, or pasted, from now until
057A                             ;              ^Z replaces the program; it is not echoed.
057A                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
057A                             ;              time). Generic: the text is printed, as it is.
057A                             ;    ^N        new: no program
057A                             ;    ^X        leave (to LEAVE)
057A                             ; 
057A                             ;  In the line: the left and right arrow keys move the cursor;
057A                             ;  a character goes in at the cursor; Backspace and DEL take out the one
057A                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
057A                             ;  sent to the terminal, so any terminal will do.
057A                             ; 
057A                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
057A                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
057A                             ;  125 characters; the one character after a line number separates it from
057A                             ;  the text and is not stored. The text is kept as it is typed, each line
057A                             ;  ending in CR LF, at PROG.
057A                             ; 
057A                             ;  What lasts from one line to the next: the program, the words, the
057A                             ;  variables and the data stack. An error or a break clears both stacks. The
057A                             ;  return stack starts empty for every line.
057A                             ; 
057A                             ;  Things to know:
057A                             ;    - Reset empties the program (generic builds).
057A                             ;    - A word's address points into the program, so run the program again
057A                             ;      after editing it.
057A                             ;    - Nothing is printed between a program's output and what is typed next.
057A                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
057A                             ;      a line that calls -n? and carries on afterwards runs what was typed.
057A                             ;      (The stored program never comes back to the line, so it may.)
057A                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
057A                             ;      read of the other builds.
057A                             ; 
057A                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
057A                             ;  the last line left there, with TOS pushed like the rest.
057A                             ; =============================================================================
057A                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
057A                          ENDIF      
057A                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
057A                          ENDIF      
057A                          IF   EDGEN   
                              JR   edit0   
057A                          ENDIF      
057A                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
057A                          ENDIF      
057A                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
057A                          ENDIF      
057A                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
057A                          ENDIF      
057A                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
057A                          ENDIF      
057A                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
057A                          ENDIF      
057A                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
057A                          ENDIF      
057A                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
057A                          ENDIF      
057A                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
057A                          ENDIF      
057A                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
057A                          ENDIF      
057A                             ; =============================================================================
057A                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
057A                          ENDIF      
057A                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
057A                          ENDIF      
057A                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
057A                          ENDIF      
057A                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
057A                          ENDIF      
057A                          IF   CPM*(1-EDITOR)   
                              JP   st2   
057A                          ENDIF      
057A                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
