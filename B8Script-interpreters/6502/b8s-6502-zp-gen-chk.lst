E380                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E380                             ; the carry is clear. Each returns into the loop.
E380                             ;    /a-/z   print the variable, as "#" does
E380                             ;    /{      clear the screen, the cursor to the top left
E380                             ;    /}      clear from the cursor to the end of the line
E380                             ;    /|  /`  show the cursor, hide it
E380                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E380                             ;            from 0. The two cells under the string's address go.
E380                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E380                             ; E6h-FFh with it clear.
E380                          IF   1-ANSI   
E380                             ; With ANSI = 0 the machine's routines do the work.
E380   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E382   90 0D                  BCC   pe1   
E384   F0 08                  BEQ   pcls   ; {
E386   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E387   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E389   B0 26                  BCS   pat   ; ~
E38B   4C 0F FF               JMP   CONEOL   ; }
E38E   4C 0C FF     PCLS:     JMP   CONCLS   
E391   C9 E6        PE1:      CMP   #0E6h   
E393   B0 03                  BCS   pvar   
E395   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E398                          ENDIF      
E398                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E398                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' prints
E398                             ; it and drops it: TOS is the string's address again.
E398   69 39        PVAR:     ADC   #39h   
E39A   20 FB E4               JSR   lower   
E39D   20 87 E2               JSR   h_fetch   
E3A0   4C 92 E0               JMP   h_num   
E3A3                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into.
                    PESC:     LDY   #M_CLS-MSG   
                              SBC   #7Ah   ; (the carry is clear: - 7Bh)
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E3A3                          ENDIF      
E3A3                          IF   CHECKED+ANSI   
E3A3                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E3A3                             ; past it, at the next message.
E3A3   B9 1E E6     PRS:      LDA   MSG,Y   
E3A6   48                     PHA      
E3A7   29 7F                  AND   #7Fh   
E3A9   20 03 FF               JSR   CONOUT   
E3AC   C8                     INY      
E3AD   68                     PLA      
E3AE   10 F3                  BPL   prs   
E3B0   60                     RTS      
E3B1                          ENDIF      
E3B1                             ; /~: the row is at 4,X, the column at 2,X, the string's address at 0,X.
E3B1                PAT:         
E3B1                          IF   CHECKED   
E3B1   E0 EB                  CPX   #DSE-5   ; fewer than two cells under TOS: s
E3B3   B0 52                  BCS   e_sund   
E3B5                          ENDIF      
E3B5                          IF   1-ANSI   
E3B5   B5 04                  LDA   4,X   ; the row
E3B7   B4 02                  LDY   2,X   ; the column
E3B9   20 15 FF               JSR   CONAT   
E3BC   20 BF E3               JSR   nip   ; two nips leave the address, 4 bytes up
E3BF   20 CD E0     NIP:      JSR   h_swap   ; nip: ( a b -- b )
E3C2   4C 2C E1               JMP   drop   
E3C5                          ENDIF      
E3C5                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). Three swaps put the row on top
                                 ; and the address under the column: "#" prints the row and drops it, prints
                                 ; the column and drops it, and TOS is the string's address again.
                              JSR   h_swap   
                              INX      
                              INX      
                              JSR   h_swap   
                              DEX      
                              DEX      
                              JSR   h_swap   
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E3C5                          ENDIF      
E3C5                          IF   CHECKED   
E3C5                             ; The checked build's inner loop, out of page 1, where it would not fit,
E3C5                             ; and its break check (described with the unchecked one in page 1).
E3C5                             ; pnext: the break check, then (falling through) next. A word call, a true
E3C5                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E3C5                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E3C5                             ; falls in here too, which does no harm.)
E3C5   CE 79 04     PNEXT:    DEC   CDOWN   
E3C8   D0 0B                  BNE   next   
E3CA   20 06 FF               JSR   KEY   
E3CD   F0 06                  BEQ   next   ; no key
E3CF   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E3D2   20 60 E4               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E3D5                NEXT:        
E3D5                             ; Both stacks are checked once per character, after it has run. The
E3D5                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E3D5                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E3D5                             ; more than one entry). The data stack has when X is above DSE (an
E3D5                             ; underflow) or below DSFULL (an overflow). No handler moves X by
E3D5                             ; more than 4 (but "$", whose /~ escapes each look first), so X is
E3D5                             ; caught before it wraps; an overrun by a cell or two writes on the
E3D5                             ; scratch bytes below or above the stack.
E3D5                             ; S is kept in RSV, for the report's R: line (an error found inside
E3D5                             ; a handler has its own calls on the hardware stack), and the place
E3D5                             ; of the character about to run in PLACE.
E3D5   8A                     TXA      ; TSX trashes X: keep it in A
E3D6   BA                     TSX      
E3D7   8E 35 04               STX   RSV   
E3DA   E0 20                  CPX   #RSLIM   
E3DC   AA                     TAX      ; TAX leaves the carry alone
E3DD   90 16                  BCC   e_rstack   
E3DF   E0 F1                  CPX   #DSE+1   
E3E1   B0 24                  BCS   e_sund   
E3E3   E0 10                  CPX   #DSFULL   
E3E5   90 25                  BCC   e_sovr   
E3E7   A5 00                  LDA   IP   
E3E9   85 08                  STA   PLACE   
E3EB   A5 01                  LDA   IP+1   
E3ED   85 09                  STA   PLACE+1   
E3EF   20 A6 E4               JSR   step   
E3F2   4C D5 E3               JMP   next   
E3F5                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E3F5                             ; empty.
E3F5   AD 35 04     E_RSTACK:   LDA   RSV   
E3F8   C9 10                  CMP   #10h   
E3FA   A9 52                  LDA   #"R"   
E3FC   B0 10                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E3FE   A9 FF                  LDA   #0FFh   
E400   8D 35 04               STA   RSV   ; S wrapped to 01h: R:0
E403   A9 72                  LDA   #"r"   
E405   D0 07                  BNE   ejmp   ; always
E407   A2 F0        E_SUND:   LDX   #DSE   ; D:0
E409   A9 73                  LDA   #"s"   
E40B   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E40C   A9 53        E_SOVR:   LDA   #"S"   
E40E   4C 92 E5     EJMP:     JMP   error   
E411                             ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
E411                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E411                             ; which takes either. Meeting the wrong closer at this level, or the end
E411                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E411                             ; which then ends the program as before.
E411   85 04        SKIP:     STA   T0   
E413   A9 00                  LDA   #0   
E415   85 06                  STA   T2   ; depth
E417   20 78 E5     SK1:      JSR   getc   
E41A   F0 26                  BEQ   sknul   
E41C   C9 22                  CMP   #22h   
E41E   D0 05                  BNE   sk2   
E420   20 75 E0               JSR   skipstr   ; leaves A = 11h, which matches nothing below
E423   F0 1D                  BEQ   sknul   ; the string ran into the end
E425   C9 28        SK2:      CMP   #"("   
E427   F0 15                  BEQ   sk3   
E429   C9 5B                  CMP   #"["   
E42B   F0 11                  BEQ   sk3   
E42D   C9 29                  CMP   #")"   
E42F   F0 04                  BEQ   sk4   
E431   C9 5D                  CMP   #"]"   
E433   D0 E2                  BNE   sk1   
E435   C6 06        SK4:      DEC   T2   
E437   10 DE                  BPL   sk1   
E439   C5 04                  CMP   T0   
E43B   F0 0C                  BEQ   e_nest   ; the wrong kind
E43D   60                     RTS      ; the closer at this level
E43E   E6 06        SK3:      INC   T2   
E440   D0 D5                  BNE   sk1   
E442   A5 04        SKNUL:    LDA   T0   
E444   D0 03                  BNE   e_nest   ; ( and [ stop with N
E446   4C 09 FF               JMP   EXIT   ; \ ends the program
E449   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E44B   4C 92 E5               JMP   error   ;   or the end: the place is the opener
E44E                          ENDIF      
E44E                          IF   1-CHECKED   
                    CBREAK:   EQU   endp   ; the unchecked build stops without a word
E44E                          ENDIF      
E44E                          IF   CHECKED   
E44E                CBREAK:   EQU   e_break   ; the checked build reports B
E44E                          ENDIF      
E44E                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E44E                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E44E                             ; taken out of KEYBUF.
E44E   AD 7A 04     GETK:     LDA   KEYBUF   
E451   F0 08                  BEQ   gk1   
E453   48                     PHA      
E454   A9 00                  LDA   #0   
E456   8D 7A 04               STA   KEYBUF   
E459   68                     PLA      
E45A   60                     RTS      
E45B   20 06 FF     GK1:      JSR   KEY   
E45E   F0 04                  BEQ   gk9   
E460                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E460                             ; back if it comes back at all.
E460   C9 03        CHK3:     CMP   #3   
E462   F0 01                  BEQ   ctlc   
E464   60           GK9:      RTS      
E465                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E465                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E465                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E465                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E465                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E465   AD 7B 04     CTLC:     LDA   BRKOFF   
E468   F0 1D                  BEQ   cbreak   
E46A   A9 28                  LDA   #CWAIT+1   
E46C   85 05                  STA   T1   
E46E   20 06 FF     CT2:      JSR   KEY   
E471   D0 0A                  BNE   ct3   
E473   C6 06                  DEC   T2   
E475   D0 F7                  BNE   ct2   
E477   C6 05                  DEC   T1   
E479   D0 F3                  BNE   ct2   
E47B   F0 07                  BEQ   ct9   ; always: none came
E47D   C9 03        CT3:      CMP   #3   
E47F   F0 06                  BEQ   cbreak   
E481   8D 7A 04               STA   KEYBUF   
E484   A9 03        CT9:      LDA   #3   
E486   60                     RTS      
E487                          IF   CHECKED   
E487   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E489   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E48A   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E48C   4C 92 E5     EJMP2:    JMP   error   
E48F                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E48F                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E48F                             ; the call reads a NUL with IP in page zero, where no program can be. The
E48F                             ; call is undone first: the step frame and the return address come off the
E48F                             ; hardware stack, and the place is the call letter (the return address - 1).
E48F   68           E_UNDEF:   PLA      
E490   68                     PLA      ; the step frame
E491   68                     PLA      
E492   38                     SEC      
E493   E9 01                  SBC   #1   
E495   85 08                  STA   PLACE   
E497   68                     PLA      
E498   E9 00                  SBC   #0   
E49A   85 09                  STA   PLACE+1   
E49C   EE 35 04               INC   RSV   
E49F   EE 35 04               INC   RSV   ; R: does not count the call
E4A2   A9 55                  LDA   #"U"   
E4A4   D0 E6                  BNE   ejmp2   ; always
E4A6                          ENDIF      
E4A6                             ; step: read one character and sort it by range.
E4A6                             ;    00h          end of program
E4A6                             ;    01h-20h, 7Fh-FFh   ignored
E4A6                             ;    30h-39h      digit: read a whole number
E4A6                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E4A6                             ;    61h-7Ah      a-z: push the address of that letter's cell
E4A6                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E4A6   20 78 E5     STEP:     JSR   getc   ; flags follow A
E4A9   F0 3D                  BEQ   endp   
E4AB   38                     SEC      
E4AC   E9 21                  SBC   #21h   ; A = c - 21h
E4AE   90 37                  BCC   ign   ; 01h-20h
E4B0   C9 0F                  CMP   #0Fh   
E4B2   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E4B4   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E4B6   C9 0A                  CMP   #10   
E4B8   90 72                  BCC   digit   
E4BA   C9 11                  CMP   #11h   
E4BC   90 18                  BCC   p3a   ; 3Ah-40h
E4BE   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E4C0   C9 1A                  CMP   #1Ah   
E4C2   90 2B                  BCC   upper   ; 41h-5Ah
E4C4   C9 20                  CMP   #20h   
E4C6   90 0C                  BCC   p5b   ; 5Bh-60h
E4C8   C9 3A                  CMP   #3Ah   
E4CA   90 2F                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E4CC   C9 3E                  CMP   #3Eh   
E4CE                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E4CE                          ENDIF      
E4CE                          IF   CHECKED   
E4CE   F0 17                  BEQ   ign   ; 7Fh
E4D0   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
E4D2                          ENDIF      
E4D2                             ; The three adjustments below chain. Each ADC adds the carry the one
E4D2                             ; before it left, which the constants allow for.
E4D2   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E4D4   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E4D6   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E4D8                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E4D8                             ; the index is N1 or more, plus one more if it is N2 or more.
E4D8   C9 08        PUNCT:    CMP   #N1   
E4DA   A8                     TAY      
E4DB   A9 70                  LDA   #HALFPG   
E4DD   2A                     ROL      ; the first page, or the second (carry clear)
E4DE   C0 15                  CPY   #N2   
E4E0   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E4E2   48                     PHA      
E4E3   B9 0C E5               LDA   PTAB,Y   
E4E6   48                     PHA      
E4E7   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E4E8                             ; directly, it just ends an ignored character.
E4E8                ENDP:        ; the program has ended
E4E8                          IF   CHECKED   
E4E8   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E4EA   F0 A3                  BEQ   e_undef   
E4EC                          ENDIF      
E4EC   4C 09 FF               JMP   EXIT   
E4EF                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E4EF                             ; the return stack, and the IP becomes the address in the letter's cell.
E4EF   0A           UPPER:    ASL      
E4F0   A8                     TAY      
E4F1   38                     SEC      
E4F2   4C EE E0               JMP   pushn   
E4F5   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E4F7   A4 01                  LDY   IP+1   
E4F9   D0 03                  BNE   pushay   ; always: no program is in page zero
E4FB                             ; a-z: push the cell's address (the cell is the variable)
E4FB   0A           LOWER:    ASL      
E4FC   A0 04                  LDY   #>LET   
E4FE                             ; pushay: push a cell: A = its low byte, Y = its high byte
E4FE   CA           PUSHAY:   DEX      
E4FF   CA                     DEX      
E500   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E502   94 01                  STY   1,X   
E504   60                     RTS      
E505                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E505   E8           FLAG:     INX      
E506   E8                     INX      
E507   B5 FE                  LDA   0FEh,X   
E509   15 FF                  ORA   0FFh,X   
E50B   60                     RTS      
E50C                             ; =============================================================================
E50C                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E50C                             ;  character, in code order.
E50C                             ; =============================================================================
E50C   BD           PTAB:     DB   (h_store-1) & 0FFh   ; !
E50D   6B                     DB   (h_str-1) & 0FFh   ; "
E50E   91                     DB   (h_num-1) & 0FFh   ; #
E50F   3F                     DB   (h_print-1) & 0FFh   ; $
E510   CC                     DB   (h_swap-1) & 0FFh   ; %
E511   DD                     DB   (h_and-1) & 0FFh   ; &
E512   89                     DB   (h_emit-1) & 0FFh   ; '
E513   E8                     DB   (h_open-1) & 0FFh   ; (
E514   CA                     DB   (h_close-1) & 0FFh   ; )
E515   6D                     DB   (h_mul-1) & 0FFh   ; *
E516   37                     DB   (h_add-1) & 0FFh   ; +
E517   C1                     DB   (h_cfetch-1) & 0FFh   ; ,
E518   2E                     DB   (h_sub-1) & 0FFh   ; -
E519   22                     DB   (h_cstore-1) & 0FFh   ; .
E51A   98                     DB   (h_div-1) & 0FFh   ; /
E51B   1B                     DB   (h_dup-1) & 0FFh   ; :
E51C   2B                     DB   (drop-1) & 0FFh   ; ;
E51D   4C                     DB   (h_lt-1) & 0FFh   ; <
E51E   5D                     DB   (h_eq-1) & 0FFh   ; =
E51F   49                     DB   (h_gt-1) & 0FFh   ; >
E520   D1                     DB   (h_key-1) & 0FFh   ; ?
E521   86                     DB   (h_fetch-1) & 0FFh   ; @
E522   AB                     DB   (h_def-1) & 0FFh   ; [
E523   2E                     DB   (h_break-1) & 0FFh   ; \
E524   42                     DB   (h_ret-1) & 0FFh   ; ]
E525   70                     DB   (h_xor-1) & 0FFh   ; ^
E526   FD                     DB   (h_alloc-1) & 0FFh   ; _
E527   CF                     DB   (h_grave-1) & 0FFh   ; `
E528   54                     DB   (h_tor-1) & 0FFh   ; {
E529   7B                     DB   (h_or-1) & 0FFh   ; |
E52A   60                     DB   (h_fromr-1) & 0FFh   ; }
E52B   6D                     DB   (h_not-1) & 0FFh   ; ~
E52C                             ; Digits: the first one is in A; read the rest of the number.
E52C   A0 00        DIGIT:    LDY   #0   
E52E   20 FE E4               JSR   pushay   
E531                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E531                             ; Returns with the carry set.
E531   20 5E E5     RDNUM:    JSR   isdig   
E534   B0 4D                  BCS   ic9   ; (an RTS)
E536   20 7B E5               JSR   incip   ; (keeps A = the digit)
E539   16 00                  ASL   0,X   
E53B   36 01                  ROL   1,X   ; x2
E53D   18                     CLC      
E53E   75 00                  ADC   0,X   
E540   85 04                  STA   T0   
E542   B5 01                  LDA   1,X   
E544   69 00                  ADC   #0   
E546   A8                     TAY      ; Y:T0 = x2 + digit
E547   16 00                  ASL   0,X   
E549   36 01                  ROL   1,X   
E54B   16 00                  ASL   0,X   
E54D   36 01                  ROL   1,X   ; x8
E54F   18                     CLC      
E550   B5 00                  LDA   0,X   
E552   65 04                  ADC   T0   
E554   95 00                  STA   0,X   
E556   98                     TYA      
E557   75 01                  ADC   1,X   
E559   95 01                  STA   1,X   ; x8 + x2 + digit
E55B   4C 31 E5               JMP   rdnum   
E55E                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E55E                             ; digit. Y = 0.
E55E   20 84 E5     ISDIG:    JSR   peek   
E561   38                     SEC      
E562   E9 30                  SBC   #"0"   
E564   C9 0A                  CMP   #10   
E566   60                     RTS      
E567                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E567                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E567   20 5E E5     RDHEX:    JSR   isdig   
E56A   90 0F                  BCC   incip   
E56C   29 DF                  AND   #0DFh   
E56E   E9 11                  SBC   #11h   ; (the carry is set)
E570   C9 06                  CMP   #6   
E572   B0 0F                  BCS   ic9   
E574   69 0A                  ADC   #10   
E576   D0 03                  BNE   incip   ; always
E578                             ; Reading the program
E578                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E578                             ;    getc: the same, then IP moves on; flags follow A
E578                             ;    incip: IP moves on; keeps A, the carry and Y
E578   20 84 E5     GETC:     JSR   peek   
E57B   E6 00        INCIP:    INC   IP   
E57D   D0 02                  BNE   ic1   
E57F   E6 01                  INC   IP+1   
E581   09 00        IC1:      ORA   #0   
E583   60           IC9:      RTS      
E584   A0 00        PEEK:     LDY   #0   
E586   B1 00                  LDA   (IP),Y   
E588   60                     RTS      
E589                             ; rstip: point IP at the start of the program
E589   A9 00        RSTIP:    LDA   #<PROG   
E58B   85 00                  STA   IP   
E58D   A9 05                  LDA   #>PROG   
E58F   85 01                  STA   IP+1   
E591   60                     RTS      
E592                          IF   CHECKED   
E592                             ; =============================================================================
E592                             ;  Checked build: the error report
E592                             ; =============================================================================
E592                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E592                             ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
E592                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E592                             ; its depth is shown.
E592                             ;   CR LF
E592                             ;   Err X @ line,col CR LF
E592                             ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
E592                             ;   R:n CR LF
E592                             ; The numbers go through "#" (prnum), which pushes them over the data stack
E592                             ; and pops them again, so the stack is shown as it was. With the stack full
E592                             ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
E592   48           ERROR:    PHA      ; the letter
E593   A5 08                  LDA   PLACE   
E595   85 02                  STA   P   
E597   A5 09                  LDA   PLACE+1   
E599   85 03                  STA   P+1   ; (CO is the report's scratch from here on)
E59B   A0 00                  LDY   #M_ERR-MSG   
E59D   20 A3 E3               JSR   prs   ; CR LF "Err "
E5A0   68                     PLA      
E5A1   20 03 FF               JSR   CONOUT   
E5A4   20 A3 E3               JSR   prs   ; " @ " (it follows M_ERR)
E5A7   20 37 E6               JSR   lcol   
E5AA   A5 0A                  LDA   LN   
E5AC   A4 0B                  LDY   LN+1   
E5AE   20 18 E6               JSR   prnum   ; the line
E5B1   A9 2C                  LDA   #","   
E5B3   20 03 FF               JSR   CONOUT   
E5B6   A5 08                  LDA   CO   
E5B8   A4 09                  LDY   CO+1   
E5BA   20 18 E6               JSR   prnum   ; the column
E5BD   A0 0B                  LDY   #M_STK-MSG   
E5BF   20 A3 E3               JSR   prs   ; CR LF "D:"
E5C2   8A                     TXA      
E5C3   49 FF                  EOR   #0FFh   
E5C5   38                     SEC      
E5C6   E9 0F                  SBC   #0FFh-DSE   
E5C8   4A                     LSR      ; the depth, (DSE - X) / 2
E5C9   48                     PHA      
E5CA   20 16 E6               JSR   prnum8   
E5CD   68                     PLA      
E5CE   A0 14                  LDY   #M_C-MSG   ; ":"
E5D0   C9 09                  CMP   #9   
E5D2   90 04                  BCC   er3   
E5D4   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E5D6   A0 0F                  LDY   #M_CD-MSG   
E5D8   85 08        ER3:      STA   CO   ; CO = how many cells to show
E5DA   20 A3 E3               JSR   prs   
E5DD   A5 08        ER4:      LDA   CO   ; cells CO-1 down to 0, the top last: cell i
E5DF   F0 1F                  BEQ   er5   ;   from the top is at X+2i
E5E1   C6 08                  DEC   CO   
E5E3   A9 20                  LDA   #" "   
E5E5   20 03 FF               JSR   CONOUT   
E5E8   A5 08                  LDA   CO   
E5EA   0A                     ASL      
E5EB   85 09                  STA   CO+1   
E5ED   8A                     TXA      
E5EE   65 09                  ADC   CO+1   ; (the carry is clear)
E5F0   A8                     TAY      
E5F1   B9 00 00               LDA   0,Y   
E5F4   48                     PHA      
E5F5   B9 01 00               LDA   1,Y   
E5F8   A8                     TAY      
E5F9   68                     PLA      
E5FA   20 18 E6               JSR   prnum   
E5FD   4C DD E5               JMP   er4   
E600   A0 15        ER5:      LDY   #M_RTN-MSG   
E602   20 A3 E3               JSR   prs   ; CR LF "R:"
E605   AD 35 04               LDA   RSV   
E608   49 FF                  EOR   #0FFh   
E60A   4A                     LSR      ; (FFh - S) / 2 entries
E60B   20 16 E6               JSR   prnum8   
E60E   A0 09                  LDY   #M_NL-MSG   
E610   20 A3 E3               JSR   prs   
E613   4C 09 FF               JMP   EXIT   
E616                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
E616                             ; prnum8: the same for A alone, 0-255.
E616   A0 00        PRNUM8:   LDY   #0   
E618   20 FE E4     PRNUM:    JSR   pushay   
E61B   4C 92 E0               JMP   h_num   
E61E                          ENDIF      
E61E                          IF   CHECKED+ANSI   
E61E                MSG:         
E61E                          ENDIF      
E61E                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
E61E                          ENDIF      
E61E                          IF   CHECKED   
E61E   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E624   20 40 A0               DB   " @"," "+80h   
E627   0D 8A        M_NL:     DB   13,10+80h   
E629   0D 0A 44 BA  M_STK:    DB   13,10,"D",":"+80h   
E62D   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E632   BA           M_C:      DB   ":"+80h   
E633   0D 0A 52 BA  M_RTN:    DB   13,10,"R",":"+80h   
E637                          ENDIF      
E637                          IF   CHECKED   
E637                             ; lcol: the line (LN) and the column (CO) of the place at P, both from
E637                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
E637                             ; column is the place in the buffer. Otherwise IP (free now: the program has
E637                             ; stopped) runs from PROG to the place, counting LFs; CO keeps where the
E637                             ; last line started, and the column is the place minus that, plus 1.
E637   A9 00        LCOL:     LDA   #0   
E639   85 0B                  STA   LN+1   
E63B   85 0A                  STA   LN   
E63D   A9 80                  LDA   #<LINEBUF   
E63F   85 08                  STA   CO   
E641   A9 04                  LDA   #>LINEBUF   
E643   85 09                  STA   CO+1   
E645   A5 02                  LDA   P   
E647   C9 00                  CMP   #<PROG   
E649   A5 03                  LDA   P+1   
E64B   E9 05                  SBC   #>PROG   
E64D   90 26                  BCC   lc9   ; below the program: line 0
E64F   E6 0A                  INC   LN   
E651   20 89 E5               JSR   rstip   
E654   A5 00        LC3:      LDA   IP   ; a line starts here
E656   85 08                  STA   CO   
E658   A5 01                  LDA   IP+1   
E65A   85 09                  STA   CO+1   
E65C   A5 00        LC1:      LDA   IP   
E65E   C5 02                  CMP   P   
E660   A5 01                  LDA   IP+1   
E662   E5 03                  SBC   P+1   
E664   B0 0F                  BCS   lc9   ; at the place
E666   20 78 E5               JSR   getc   
E669   C9 0A                  CMP   #10   
E66B   D0 EF                  BNE   lc1   
E66D   E6 0A                  INC   LN   ; an LF: a new line starts after it
E66F   D0 E3                  BNE   lc3   
E671   E6 0B                  INC   LN+1   
E673   D0 DF                  BNE   lc3   ; always
E675   A5 02        LC9:      LDA   P   
E677   38                     SEC      
E678   E5 08                  SBC   CO   
E67A   85 08                  STA   CO   
E67C   A5 03                  LDA   P+1   
E67E   E5 09                  SBC   CO+1   
E680   85 09                  STA   CO+1   
E682   E6 08                  INC   CO   ; + 1
E684   D0 02                  BNE   lc8   
E686   E6 09                  INC   CO+1   
E688   60           LC8:      RTS      
E689                          ENDIF      


