0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;  A port of the Z80 interpreter (z80/b8s-z80.asm); same behaviour, same
0000                             ;  memory map, same switches.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (CONIN/CONOUT/CONST at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpush and rpop (and the checks) touch it; both
0000                             ;  destroy HL, so each caller makes sure TOS is parked or dead first.
0000                             ; 
0000                             ;  (asm80 wants the vector number: RST 1 = RST 08h, RST 2 = RST 10h.)
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JMP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP D to throw the return address away.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LETPAGE..heap top.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    CONIN:    EQU   0FF00h   ; wait for a key, return it in A
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    CONST:    EQU   0FF06h   ; A = 0 if no key is waiting, else nonzero
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   All three console routines must preserve BC, DE and HL.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and CONST (~100 states each)
0000                CAP:      EQU   127   ; -n? reads at most this many characters
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
0100                          .ORG   0100h   
0100   C3 66 04               JMP   start   
0103                          ENDIF      
0103                          IFN   CPM   
                              .ORG   0000h   
                              LXI   SP,DSTOP   ; 0000h reset: the stack first,
                              JMP   start   ;   then the rest of the startup
                    H_SWAP:   XTHL      ; 0006h the two-byte handlers fill the gaps
                              RST   2   ;   between the vectors
                                 ; ---- RST 08h: drop TOS, then next ------------------------------------------
                              POP   D   ; 0008h discard the RST's return address
                    DROP_NEXT:      
                              POP   H   ; new TOS = NOS
                              JMP   next0   
                    H_DUP:    PUSH   H   ; 000Dh
                              RST   2   
                              DB   0   ; 000Fh spare
                                 ; ---- RST 10h: next character ------------------------------------------------
                              POP   D   ; 0010h discard the RST's return address
0103                          ENDIF      
0103                             ; =============================================================================
0103                             ;  The inner loop: read one character and sort it by range.
0103                             ; 
0103                             ;    00h          end of program
0103                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0103                             ;    30h-39h      digit: read a whole number
0103                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0103                             ;    61h-7Ah      a-z: push the address of that letter's cell
0103                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0103                             ; =============================================================================
0103                NEXT0:       
0103                          IF   CHECKED   
                                 ; Both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the
                                 ; pointer's high byte has left that page. Errors are caught one cell
                                 ; late at most; the page below each stack is a guard band.
                              XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,0   
                              DAD   SP   
                              MOV   A,H   
                              CPI   DSPAGE   
                              JNZ   e_stack   
                              LHLD   RSP   ; the return stack: in its page, and not
                              MOV   A,L   ;   above its empty position (an underflow
                              CPI   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              JNC   e_rstack   ;   guard band)
                              MOV   A,H   
                              CPI   RSPAGE   
                              JNZ   e_rstack   
                              XCHG      ; TOS back
0103                          ENDIF      
0103   0A                     LDAX   B   
0104   03                     INX   B   
0105   D6 21                  SUI   21h   ; A = c - 21h
0107   DA 4A 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
010A   FE 0F                  CPI   0Fh   
010C   DA 3D 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
010F   D6 0F                  SUI   0Fh   ; A = c - 30h
0111   FE 0A                  CPI   0Ah   
0113   DA 67 01               JC   digit   ; 30h-39h
0116   FE 11                  CPI   11h   
0118   D2 20 01               JNC   ab40   
011B   C6 05                  ADI   5   ; 3Ah-40h: index 15-21
011D   C3 3D 01               JMP   punct   
0120   D6 11        AB40:     SUI   11h   ; A = c - 41h
0122   FE 1A                  CPI   1Ah   
0124   DA 58 01               JC   upper   ; 41h-5Ah: A = letter index 0-25
0127   FE 20                  CPI   20h   
0129   D2 31 01               JNC   ab60   
012C   D6 04                  SUI   4   ; 5Bh-60h: index 22-27
012E   C3 3D 01               JMP   punct   
0131   FE 3A        AB60:     CPI   3Ah   
0133   DA 52 01               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0136   FE 3E                  CPI   3Eh   
0138   D2 03 01               JNC   next0   ; 7Fh-FFh: ignored
013B   D6 1E                  SUI   1Eh   ; 7Bh-7Eh: index 28-31
013D                             ; Punctuation: HL holds TOS, so it is parked on the stack while the table is
013D                             ; read, then swapped for the handler's address: XTHL puts TOS back in HL and
013D                             ; leaves the address on the stack for RET to jump to. The stack is balanced
013D                             ; again when the handler starts. PTAB never crosses a page (checked in the
013D                             ; listing), so only L needs adding.
013D   E5           PUNCT:    PUSH   H   
013E   87                     ADD   A   
013F   C6 6D                  ADI   PTAB & 0FFh   
0141   6F                     MOV   L,A   
0142   26 01                  MVI   H,PTAB / 256   
0144   7E                     MOV   A,M   
0145   23                     INX   H   
0146   66                     MOV   H,M   
0147   6F                     MOV   L,A   ; HL = handler
0148   E3                     XTHL      
0149   C9                     RET      
014A   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
014C   C2 03 01               JNZ   next0   
014F                          IF   CPM   
014F   C3 00 00               JMP   endprog   
0152                          ENDIF      
0152                          IFN   CPM   
                    ENDPROG:      
                              JMP   EXIT   ; the program has ended
0152                          ENDIF      
0152                             ; a-z: push the cell's address (the cell is the variable)
0152   E5           LOWER:    PUSH   H   
0153   87                     ADD   A   
0154   6F                     MOV   L,A   
0155   26 07                  MVI   H,LETPAGE   
0157   D7                     RST   2   
0158                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0158                             ; the return stack, and the IP becomes the address in the letter's cell.
0158   E5           UPPER:    PUSH   H   ; keep TOS
0159   87                     ADD   A   
015A   6F                     MOV   L,A   
015B   26 07                  MVI   H,LETPAGE   ; HL -> cell
015D   50                     MOV   D,B   
015E   59                     MOV   E,C   ; DE = return address
015F   4E                     MOV   C,M   
0160   23                     INX   H   
0161   46                     MOV   B,M   ; IP = the word's body
0162   CD C4 01               CALL   rpush   
0165   E1                     POP   H   ; TOS back
0166   D7                     RST   2   
0167                             ; Digits: step back onto the first digit and read the whole number.
0167   E5           DIGIT:    PUSH   H   
0168   0B                     DCX   B   
0169   CD AD 01               CALL   rdnum   
016C   D7                     RST   2   
016D                             ; =============================================================================
016D                             ;  Dispatch table: one handler per punctuation character, in code order.
016D                             ;  It sits right after the inner loop so that it can't cross a page (the
016D                             ;  loop only adds to the low byte of its address).
016D                             ; =============================================================================
016D   CE 02        PTAB:     DW   h_store   ; !
016F   77 03                  DW   h_str   ; "
0171   9F 03                  DW   h_num   ; #
0173   7E 03                  DW   h_print   ; $
0175   BD 02                  DW   h_swap   ; %
0177   83 02                  DW   h_and   ; &
0179   9A 03                  DW   h_emit   ; '
017B   E5 02                  DW   h_open   ; (
017D   F5 02                  DW   h_close   ; )
017F   FB 01                  DW   h_mul   ; *
0181   DB 01                  DW   h_add   ; +
0183   D3 02                  DW   h_cfetch   ; ,
0185   DE 01                  DW   h_sub   ; -
0187   D7 02                  DW   h_cstore   ; .
0189   17 02                  DW   h_div   ; /
018B   0D 00                  DW   h_dup   ; :
018D   09 00                  DW   drop_next   ; ;
018F   A1 02                  DW   h_lt   ; <
0191   B0 02                  DW   h_eq   ; =
0193   A0 02                  DW   h_gt   ; >
0195   C5 03                  DW   h_key   ; ?
0197   C9 02                  DW   h_fetch   ; @
0199   1D 03                  DW   h_def   ; [
019B   06 03                  DW   h_break   ; \
019D   15 03                  DW   h_ret   ; ]
019F   93 02                  DW   h_xor   ; ^
01A1   DA 02                  DW   h_alloc   ; _
01A3   17 04                  DW   h_grave   ; `
01A5   BF 02                  DW   h_tor   ; {
01A7   8B 02                  DW   h_or   ; |
01A9   C4 02                  DW   h_fromr   ; }
01AB   9B 02                  DW   h_not   ; ~
01AD                PTABEND:      
01AD                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
01AD                             ; non-digit. Values wrap at 16 bits, as the spec says.
01AD   21 00 00     RDNUM:    LXI   H,0   
01B0   0A           RDN1:     LDAX   B   
01B1   D6 30                  SUI   "0"   
01B3   FE 0A                  CPI   10   
01B5   D0                     RNC      
01B6   03                     INX   B   
01B7   54                     MOV   D,H   
01B8   5D                     MOV   E,L   
01B9   29                     DAD   H   
01BA   29                     DAD   H   
01BB   19                     DAD   D   
01BC   29                     DAD   H   ; HL * 10
01BD   5F                     MOV   E,A   
01BE   16 00                  MVI   D,0   
01C0   19                     DAD   D   
01C1   C3 B0 01               JMP   rdn1   
01C4                             ; =============================================================================
01C4                             ;  Return stack. rpush pushes DE; rpop pops into HL. RSP is the pointer (a RAM
01C4                             ;  word, growing down). Both destroy HL; rpush also keeps DE, rpop clobbers DE.
01C4                             ; =============================================================================
01C4   2A 34 07     RPUSH:    LHLD   RSP   
01C7   2B                     DCX   H   
01C8   72                     MOV   M,D   
01C9   2B                     DCX   H   
01CA   73                     MOV   M,E   
01CB   22 34 07               SHLD   RSP   
01CE   C9                     RET      
01CF   2A 34 07     RPOP:     LHLD   RSP   
01D2   5E                     MOV   E,M   
01D3   23                     INX   H   
01D4   56                     MOV   D,M   
01D5   23                     INX   H   
01D6   22 34 07               SHLD   RSP   
01D9   EB                     XCHG      
01DA   C9                     RET      
01DB                             ; =============================================================================
01DB                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
01DB                             ; =============================================================================
01DB   D1           H_ADD:    POP   D   
01DC   19                     DAD   D   
01DD   D7                     RST   2   
01DE                             ; "-" has two jobs: directly before a digit it starts a negative number.
01DE                             ; Otherwise a - b is a + (-b): neg16 and DAD are shorter than a byte-wise SUB/SBB.
01DE   0A           H_SUB:    LDAX   B   
01DF   D6 30                  SUI   "0"   
01E1   FE 0A                  CPI   10   
01E3   DA EC 01               JC   negnum   
01E6   D1                     POP   D   
01E7   CD F4 01               CALL   neg16   
01EA   19                     DAD   D   
01EB   D7                     RST   2   
01EC   E5           NEGNUM:   PUSH   H   
01ED   CD AD 01               CALL   rdnum   
01F0   CD F4 01               CALL   neg16   
01F3   D7                     RST   2   
01F4                             ; neg16: HL = -HL (keeps BC, DE)
01F4   AF           NEG16:    XRA   A   
01F5   95                     SUB   L   
01F6   6F                     MOV   L,A   
01F7   9F                     SBB   A   
01F8   94                     SUB   H   
01F9   67                     MOV   H,A   
01FA   C9                     RET      
01FB                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
01FB                             ; multiplier is used up; only the low 16 bits are kept.
01FB   D1           H_MUL:    POP   D   ; DE = multiplicand
01FC   C5                     PUSH   B   
01FD   44                     MOV   B,H   
01FE   4D                     MOV   C,L   ; BC = multiplier
01FF   21 00 00               LXI   H,0   
0202   78           MUL1:     MOV   A,B   
0203   B7                     ORA   A   ; clear carry
0204   1F                     RAR      
0205   47                     MOV   B,A   
0206   79                     MOV   A,C   
0207   1F                     RAR      
0208   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0209   D2 0D 02               JNC   mul2   
020C   19                     DAD   D   
020D   EB           MUL2:     XCHG      
020E   29                     DAD   H   ; multiplicand << 1
020F   EB                     XCHG      
0210   78                     MOV   A,B   
0211   B1                     ORA   C   
0212   C2 02 02               JNZ   mul1   
0215   C1                     POP   B   
0216   D7                     RST   2   
0217                             ; "/" ( a b -- q r ): truncates toward zero; r takes a's sign.
0217                             ; b = 0 gives q = 0, r = a. b = 2 takes a fast shift, as the spec requires.
0217   D1           H_DIV:    POP   D   ; DE = a, HL = b
0218   7C                     MOV   A,H   
0219   B5                     ORA   L   
021A   C2 20 02               JNZ   div1   
021D   E5                     PUSH   H   ; q = 0
021E   EB                     XCHG      ; r = a
021F   D7                     RST   2   
0220   2B           DIV1:     DCX   H   ; b = 2 exactly?
0221   2B                     DCX   H   
0222   7C                     MOV   A,H   
0223   B5                     ORA   L   
0224   23                     INX   H   ; (INX leaves the flags alone)
0225   23                     INX   H   
0226   C2 40 02               JNZ   divg   
0229                             ; a / 2: add 1 if a is negative, then shift right arithmetically
0229   62                     MOV   H,D   
022A   6B                     MOV   L,E   
022B   7A                     MOV   A,D   
022C   17                     RAL      ; carry = sign of a
022D   D2 31 02               JNC   div2   
0230   23                     INX   H   
0231   7C           DIV2:     MOV   A,H   
0232   17                     RAL      ; carry = sign (of a, after the +1)
0233   7C                     MOV   A,H   
0234   1F                     RAR      ; arithmetic shift right, H
0235   67                     MOV   H,A   
0236   7D                     MOV   A,L   
0237   1F                     RAR      
0238   6F                     MOV   L,A   ; HL = q
0239   E5                     PUSH   H   
023A   29                     DAD   H   ; 2q
023B   CD F4 01               CALL   neg16   
023E   19                     DAD   D   ; r = a - 2q
023F   D7                     RST   2   
0240   C5           DIVG:     PUSH   B   
0241   7A                     MOV   A,D   
0242   B7                     ORA   A   
0243   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0244   AC                     XRA   H   
0245   F5                     PUSH   PSW   ; S flag = sign of q
0246   7C                     MOV   A,H   
0247   B7                     ORA   A   
0248   FC F4 01               CM   neg16   ; HL = |b|
024B   EB                     XCHG      
024C   7C                     MOV   A,H   
024D   B7                     ORA   A   
024E   FC F4 01               CM   neg16   ; HL = |a|, DE = |b|
0251   CD 62 02               CALL   udiv   ; HL = q, BC = r
0254   F1                     POP   PSW   
0255   FC F4 01               CM   neg16   ; q's sign
0258   EB                     XCHG      ; DE = q
0259   60                     MOV   H,B   
025A   69                     MOV   L,C   ; HL = r
025B   F1                     POP   PSW   
025C   FC F4 01               CM   neg16   ; r's sign
025F   C1                     POP   B   
0260   D5                     PUSH   D   ; q under r
0261   D7                     RST   2   
0262                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0262                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0262                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0262                             ; lives on the stack, since A is busy with the shifts.
0262   01 00 00     UDIV:     LXI   B,0   
0265   3E 10                  MVI   A,16   
0267   F5                     PUSH   PSW   
0268   29           UDV1:     DAD   H   ; next dividend bit into the carry
0269   79                     MOV   A,C   
026A   17                     RAL      
026B   4F                     MOV   C,A   
026C   78                     MOV   A,B   
026D   17                     RAL      
026E   47                     MOV   B,A   ; BC = BC*2 + bit
026F   79                     MOV   A,C   
0270   93                     SUB   E   
0271   78                     MOV   A,B   
0272   9A                     SBB   D   ; carry if BC < DE
0273   DA 7B 02               JC   udv2   
0276   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0277   79                     MOV   A,C   
0278   93                     SUB   E   
0279   4F                     MOV   C,A   
027A   2C                     INR   L   ; quotient bit
027B   F1           UDV2:     POP   PSW   
027C   3D                     DCR   A   
027D   F5                     PUSH   PSW   
027E   C2 68 02               JNZ   udv1   
0281   F1                     POP   PSW   
0282   C9                     RET      
0283   D1           H_AND:    POP   D   
0284   7C                     MOV   A,H   
0285   A2                     ANA   D   
0286   67                     MOV   H,A   
0287   7D                     MOV   A,L   
0288   A3                     ANA   E   
0289   6F                     MOV   L,A   
028A   D7                     RST   2   
028B   D1           H_OR:     POP   D   
028C   7C                     MOV   A,H   
028D   B2                     ORA   D   
028E   67                     MOV   H,A   
028F   7D                     MOV   A,L   
0290   B3                     ORA   E   
0291   6F                     MOV   L,A   
0292   D7                     RST   2   
0293   D1           H_XOR:    POP   D   
0294   7C                     MOV   A,H   
0295   AA                     XRA   D   
0296   67                     MOV   H,A   
0297   7D                     MOV   A,L   
0298   AB                     XRA   E   
0299   6F                     MOV   L,A   
029A   D7                     RST   2   
029B                             ; ~x is -x - 1: shorter than complementing both bytes.
029B   CD F4 01     H_NOT:    CALL   neg16   
029E   2B                     DCX   H   
029F   D7                     RST   2   
02A0                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
02A0                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
02A0                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
02A0                             ; SBB A turns a carry into -1 or 0 with no branch.
02A0   E3           H_GT:     XTHL      ; a > b  is  b < a
02A1   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
02A2   7B                     MOV   A,E   
02A3   95                     SUB   L   
02A4   7A                     MOV   A,D   
02A5   9C                     SBB   H   
02A6   9F                     SBB   A   ; A = -1 if DE < HL unsigned
02A7   6F                     MOV   L,A   
02A8   7C                     MOV   A,H   
02A9   AA                     XRA   D   
02AA   17                     RAL      ; carry = the signs differ
02AB   9F                     SBB   A   
02AC   AD                     XRA   L   ; flip when they do
02AD   67                     MOV   H,A   
02AE   6F                     MOV   L,A   
02AF   D7                     RST   2   
02B0   D1           H_EQ:     POP   D   
02B1   7D                     MOV   A,L   
02B2   AB                     XRA   E   
02B3   6F                     MOV   L,A   
02B4   7C                     MOV   A,H   
02B5   AA                     XRA   D   
02B6   B5                     ORA   L   ; zero if equal
02B7   D6 01                  SUI   1   ; carry only for zero
02B9   9F                     SBB   A   
02BA   67                     MOV   H,A   
02BB   6F                     MOV   L,A   
02BC   D7                     RST   2   
02BD                             ; =============================================================================
02BD                             ;  Stack
02BD                             ; =============================================================================
02BD                          IF   CPM   
02BD   E3           H_SWAP:   XTHL      
02BE   D7                     RST   2   
02BF                          ENDIF      
02BF   EB           H_TOR:    XCHG      ; "{" TOS to the return stack
02C0   CD C4 01               CALL   rpush   
02C3   CF                     RST   1   
02C4   E5           H_FROMR:   PUSH   H   ; "}" return stack to TOS
02C5   CD CF 01               CALL   rpop   
02C8   D7                     RST   2   
02C9                             ; =============================================================================
02C9                             ;  Storage
02C9                             ; =============================================================================
02C9   5E           H_FETCH:   MOV   E,M   ; "@"
02CA   23                     INX   H   
02CB   56                     MOV   D,M   
02CC   EB                     XCHG      
02CD   D7                     RST   2   
02CE   D1           H_STORE:   POP   D   ; "!" ( n addr -- )
02CF                          IF   CHECKED   
                              INX   H   ; both bytes must be in the program's space
                              CALL   chkst   
                              DCX   H   
02CF                          ENDIF      
02CF   73                     MOV   M,E   
02D0   23                     INX   H   
02D1   72                     MOV   M,D   
02D2   CF                     RST   1   
02D3   6E           H_CFETCH:   MOV   L,M   ; ","
02D4   26 00                  MVI   H,0   
02D6   D7                     RST   2   
02D7   D1           H_CSTORE:   POP   D   ; "." ( c addr -- )
02D8                          IF   CHECKED   
                              CALL   chkst   
02D8                          ENDIF      
02D8   73                     MOV   M,E   
02D9   CF                     RST   1   
02DA                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
02DA   EB           H_ALLOC:   XCHG      
02DB   2A 7C 07               LHLD   HEAP   
02DE   E5                     PUSH   H   
02DF   19                     DAD   D   
02E0                          IF   CHECKED   
                              JC   e_heap   ; a negative count wraps: too big
                              LDA   HLIM   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   ; the new top must stay below the limit page
02E0                          ENDIF      
02E0   22 7C 07               SHLD   HEAP   
02E3   E1                     POP   H   
02E4   D7                     RST   2   
02E5                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   PSW   
                              MOV   A,H   
                              CPI   LETPAGE   
                              JC   chk1   
                              LDA   HLIM   
                              DCR   A   
                              CMP   H   
                    CHK1:     JC   e_store   
                              POP   PSW   
                              RET      
02E5                          ENDIF      
02E5                             ; =============================================================================
02E5                             ;  Flow control
02E5                             ; =============================================================================
02E5                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
02E5                             ; the matching ")".
02E5   7C           H_OPEN:   MOV   A,H   
02E6   B5                     ORA   L   
02E7   CA F0 02               JZ   op_f   
02EA   50                     MOV   D,B   
02EB   59                     MOV   E,C   
02EC   CD C4 01               CALL   rpush   ; (HL, the flag, is dead here)
02EF   CF                     RST   1   ; = POP H, RST 2: the flag is dead, so drop it
02F0   E1           OP_F:     POP   H   
02F1   CD 3E 03     SKIPNX:   CALL   skip   
02F4   D7                     RST   2   
02F5                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
02F5                             ; drops it and carries on.
02F5   7C           H_CLOSE:   MOV   A,H   
02F6   B5                     ORA   L   
02F7   CA 02 03               JZ   rdrop   
02FA                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every loop-back
02FA                          ENDIF      
02FA   2A 34 07               LHLD   RSP   ; peek the block start
02FD   4E                     MOV   C,M   
02FE   23                     INX   H   
02FF   46                     MOV   B,M   
0300   E1                     POP   H   
0301   D7                     RST   2   
0302   CD CF 01     RDROP:    CALL   rpop   ; (HL, the flag, is dead: NOS is next)
0305   CF                     RST   1   
0306                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
0306                             ; drops the block start, "]" returns. No closer at all ends the program.
0306   7C           H_BREAK:   MOV   A,H   
0307   B5                     ORA   L   
0308   C2 0C 03               JNZ   brk1   
030B   CF                     RST   1   
030C   CD 3E 03     BRK1:     CALL   skip   
030F   FE 29                  CPI   ")"   
0311   CA 02 03               JZ   rdrop   
0314   E1                     POP   H   ; and fall into "]"
0315                             ; "]" returns: pop an address and jump to it.
0315   E5           H_RET:    PUSH   H   
0316   CD CF 01               CALL   rpop   
0319   44                     MOV   B,H   
031A   4D                     MOV   C,L   
031B   E1                     POP   H   
031C                          IF   CHECKED   
                              CALL   chkbrk   ; ... and at every word return
031C                          ENDIF      
031C   D7                     RST   2   
031D                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
031D                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
031D                             ; the body"s address instead. Either way it then skips to the matching "]'.
031D   0A           H_DEF:    LDAX   B   
031E   03                     INX   B   
031F   5F                     MOV   E,A   
0320   E6 DF                  ANI   0DFh   ; fold case
0322   D6 41                  SUI   "A"   
0324   FE 1A                  CPI   26   
0326   D2 38 03               JNC   def2   ; not a letter
0329   7B                     MOV   A,E   
032A   D6 41                  SUI   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
032C   87                     ADD   A   
032D   5F                     MOV   E,A   
032E   16 07                  MVI   D,LETPAGE   ; DE -> cell
0330   79                     MOV   A,C   
0331   12                     STAX   D   
0332   1C                     INR   E   
0333   78                     MOV   A,B   
0334   12                     STAX   D   
0335   C3 F1 02               JMP   skipnx   
0338                DEF2:        
0338                          IF   CHECKED   
                              MOV   A,E   
                              CPI   " "   
                              JNZ   e_brack   ; anything but a letter or a space
0338                          ENDIF      
0338   E5                     PUSH   H   ; an anonymous block: push its address
0339   60                     MOV   H,B   
033A   69                     MOV   L,C   
033B   C3 F1 02               JMP   skipnx   
033E                             ; skip: read past text to the closer at this level, and return it in A.
033E                             ; Brackets of both kinds count together; strings are stepped over whole. A
033E                             ; NUL first ends the program (for "\" with no closer; anything else that runs
033E                             ; into the NUL had unbalanced brackets anyway). D counts the open levels,
033E                             ; starting at 1 for the one we are in.
033E   16 01        SKIP:     MVI   D,1   
0340   0A           SK1:      LDAX   B   
0341   03                     INX   B   
0342   B7                     ORA   A   
0343   CA 00 00               JZ   endprog   
0346   FE 22                  CPI   22h   
0348   CC 6A 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
034B   FE 28                  CPI   "("   
034D   CA 64 03               JZ   sk3   
0350   FE 5B                  CPI   "["   
0352   CA 64 03               JZ   sk3   
0355   FE 29                  CPI   ")"   
0357   CA 5F 03               JZ   sk4   
035A   FE 5D                  CPI   "]"   
035C   C2 40 03               JNZ   sk1   
035F   15           SK4:      DCR   D   
0360   C8                     RZ      ; the closer at this level
0361   C3 40 03               JMP   sk1   
0364   14           SK3:      INR   D   ; an opener: one deeper (the DCR below makes
0365   14                     INR   D   ;   it +1 net, and can't reach zero)
0366   C3 5F 03               JMP   sk4   
0369                             ; skipstr: IP is inside a string; step past its closing quote. ">" escapes
0369                             ; the next character, so ">"" does not end it.
0369   03           SS0:      INX   B   
036A   0A           SKIPSTR:   LDAX   B   
036B   03                     INX   B   
036C   FE 3E                  CPI   ">"   
036E   CA 69 03               JZ   ss0   
0371   FE 22                  CPI   22h   
0373   C2 6A 03               JNZ   skipstr   
0376   C9                     RET      
0377                             ; =============================================================================
0377                             ;  Console
0377                             ; =============================================================================
0377                             ; 22h pushes the address of the text after it and skips the string.
0377   E5           H_STR:    PUSH   H   
0378   60                     MOV   H,B   
0379   69                     MOV   L,C   
037A   CD 6A 03               CALL   skipstr   
037D   D7                     RST   2   
037E                             ; "$" prints the string at TOS, decoding escapes: ">" plus a character from
037E                             ; 40h-7Fh clears its bit 6 (>M is CR, >` is space); plus anything lower gives
037E                             ; that character itself.
037E   7E           H_PRINT:   MOV   A,M   
037F   23                     INX   H   
0380   FE 22                  CPI   22h   
0382   CA 99 03               JZ   prdone   
0385   FE 3E                  CPI   ">"   
0387   C2 93 03               JNZ   pr1   
038A   7E                     MOV   A,M   
038B   23                     INX   H   
038C   FE 40                  CPI   40h   
038E   DA 93 03               JC   pr1   
0391   E6 BF                  ANI   0BFh   
0393   CD 58 04     PR1:      CALL   putc   
0396   C3 7E 03               JMP   h_print   
0399   CF           PRDONE:   RST   1   
039A   7D           H_EMIT:   MOV   A,L   ; "'"
039B   CD 58 04               CALL   putc   
039E   CF                     RST   1   
039F                             ; "#" prints TOS as a signed decimal number, with no space after it.
039F   7C           H_NUM:    MOV   A,H   
03A0   B7                     ORA   A   
03A1   F2 AC 03               JP   num1   
03A4   3E 2D                  MVI   A,"-"   
03A6   CD 58 04               CALL   putc   
03A9   CD F4 01               CALL   neg16   
03AC   C5           NUM1:     PUSH   B   
03AD   CD B2 03               CALL   pdec   
03B0   C1                     POP   B   
03B1   CF                     RST   1   
03B2                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
03B2   11 0A 00     PDEC:     LXI   D,10   
03B5   CD 62 02               CALL   udiv   ; HL = HL / 10, BC = digit
03B8   79                     MOV   A,C   
03B9   F5                     PUSH   PSW   
03BA   7C                     MOV   A,H   
03BB   B5                     ORA   L   
03BC   C4 B2 03               CNZ   pdec   
03BF   F1                     POP   PSW   
03C0   C6 30                  ADI   "0"   
03C2   C3 58 04               JMP   putc   
03C5                             ; "?" ( n -- c ) or ( -n -- addr )
03C5                             ;   n > 0: wait about n ms for a key; 0 if none came
03C5                             ;   n = 0: wait for a key
03C5                             ;   n < 0: read a line of at most -n characters (capped at CAP) with echo
03C5   7C           H_KEY:    MOV   A,H   
03C6   B7                     ORA   A   
03C7   FA EE 03               JM   line   
03CA   B5                     ORA   L   
03CB   C2 D8 03               JNZ   kt1   
03CE                KW:          
03CE                          IF   (1-CPM)*(1-CHECKED)   
                              CALL   CONIN   ; 0?: wait (the generic console can block)
03CE                          ENDIF      
03CE                          IF   1-(1-CPM)*(1-CHECKED)   
03CE   CD 53 04               CALL   getk   ; 0?: wait
03D1   CA CE 03               JZ   kw   
03D4                          ENDIF      
03D4   6F           KT3:      MOV   L,A   
03D5   26 00                  MVI   H,0   
03D7   D7                     RST   2   
03D8   11 28 00     KT1:      LXI   D,MSLOOP   ; one millisecond, roughly
03DB   CD 53 04     KT2:      CALL   getk   
03DE   C2 D4 03               JNZ   kt3   
03E1   1B                     DCX   D   
03E2   7A                     MOV   A,D   
03E3   B3                     ORA   E   
03E4   C2 DB 03               JNZ   kt2   
03E7   2B                     DCX   H   
03E8   7C                     MOV   A,H   
03E9   B5                     ORA   L   
03EA   C2 D8 03               JNZ   kt1   
03ED   D7                     RST   2   ; time ran out: HL is already 0
03EE   CD F4 01     LINE:     CALL   neg16   ; HL = the count
03F1   7C                     MOV   A,H   
03F2   B7                     ORA   A   
03F3   C2 FC 03               JNZ   ln0   
03F6   7D                     MOV   A,L   
03F7   FE 80                  CPI   CAP+1   
03F9   DA FE 03               JC   ln1   
03FC   3E 7F        LN0:      MVI   A,CAP   
03FE                LN1:         
03FE                          IF   CPM   
03FE                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
03FE                             ; own line editor). It doesn't store the CR, so it is added here.
03FE   32 7E 07               STA   LBHDR   
0401   C5                     PUSH   B   
0402   11 7E 07               LXI   D,LBHDR   
0405   0E 0A                  MVI   C,10   
0407   CD 05 00               CALL   BDOS   
040A   C1                     POP   B   
040B   21 7F 07               LXI   H,LBHDR+1   
040E   7E                     MOV   A,M   ; count (0-127)
040F   23                     INX   H   ; HL = LINEBUF, whose low byte is 80h:
0410   E5                     PUSH   H   
0411   85                     ADD   L   ;   adding the count to L can't carry
0412   6F                     MOV   L,A   
0413   36 0D                  MVI   M,13   
0415   E1                     POP   H   
0416   D7                     RST   2   
0417                          ENDIF      
0417                          IFN   CPM   
                                 ; Generic: Backspace and DEL erase, CR ends (stored, not echoed),
                                 ; other control keys are ignored, and a full line takes only those.
                              PUSH   B   
                              MOV   C,A   ; C = max
                              MVI   B,0   ; B = length
                              LXI   H,LINEBUF   
0417                          ENDIF      
0417                LN2:         
0417                          IF   (1-CPM)*(1-CHECKED)   
                              CALL   CONIN   ; (the generic console can block)
0417                          ENDIF      
0417                          IF   (1-CPM)*CHECKED   
                              CALL   getk   
                              JZ   ln2   
0417                          ENDIF      
0417                          IFN   CPM   
                              CPI   13   
                              JZ   ln5   
                              CPI   8   
                              JZ   ln4   
                              CPI   7Fh   
                              JZ   ln4   
                              CPI   " "   
                              JC   ln2   
                              MOV   E,A   
                              MOV   A,B   
                              CMP   C   
                              JNC   ln2   ; full
                              MOV   M,E   
                              INX   H   
                              INR   B   
                              MOV   A,E   
                    LN3:      CALL   putc   
                              JMP   ln2   
                    LN4:      MOV   A,B   
                              ORA   A   
                              JZ   ln2   
                              DCR   B   
                              DCX   H   
                              MVI   A,8   
                              CALL   putc   
                              MVI   A," "   
                              CALL   putc   
                              MVI   A,8   
                              JMP   ln3   
                    LN5:      MVI   M,13   
                              POP   B   
                              LXI   H,LINEBUF   
                              RST   2   
0417                          ENDIF      
0417                             ; =============================================================================
0417                             ;  Machine code: the grave
0417                             ; =============================================================================
0417                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
0417                             ; are stored from addr until a non-hex character; then a RET (C9h) is
0417                             ; written and its address is left. An odd last digit is consumed and dropped.
0417                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
0417                             ; code is entered by CALL with the data stack above the return address; it
0417                             ; must keep BC, and on return the top cell becomes the new TOS.
0417   0A           H_GRAVE:   LDAX   B   
0418   CD 42 04               CALL   hexval   
041B   DA 3C 04               JC   exec   
041E   0A           HX1:      LDAX   B   
041F   CD 42 04               CALL   hexval   
0422   DA 39 04               JC   hx2   
0425   03                     INX   B   
0426   87                     ADD   A   
0427   87                     ADD   A   
0428   87                     ADD   A   
0429   87                     ADD   A   
042A   57                     MOV   D,A   
042B   0A                     LDAX   B   
042C   CD 42 04               CALL   hexval   
042F   DA 39 04               JC   hx2   ; odd digit: already consumed, dropped
0432   03                     INX   B   
0433   B2                     ORA   D   
0434                          IF   CHECKED   
                              CALL   chkst   
0434                          ENDIF      
0434   77                     MOV   M,A   
0435   23                     INX   H   
0436   C3 1E 04               JMP   hx1   
0439                HX2:         
0439                          IF   CHECKED   
                              CALL   chkst   
0439                          ENDIF      
0439   36 C9                  MVI   M,0C9h   
043B   D7                     RST   2   
043C   CD 41 04     EXEC:     CALL   exjmp   ; the code returns here, with its top cell on
043F   E1                     POP   H   ;   the stack: that becomes the new TOS
0440   D7                     RST   2   
0441   E9           EXJMP:    PCHL      
0442                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
0442                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
0442   D6 30        HEXVAL:   SUI   "0"   
0444   FE 0A                  CPI   10   
0446   3F                     CMC      
0447   D0                     RNC      
0448   E6 DF                  ANI   0DFh   
044A   D6 11                  SUI   11h   
044C   FE 06                  CPI   6   
044E   3F                     CMC      
044F   D8                     RC      
0450   C6 0A                  ADI   10   
0452   C9                     RET      
0453                             ; =============================================================================
0453                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
0453                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
0453                             ;  Both keep BC, DE and HL.
0453                             ; =============================================================================
0453                GETK:        
0453                          IF   CHECKED   
                              LDA   KEYBUF   ; a key held back by the break check
                              ORA   A   
                              JZ   gk1   
                              PUSH   PSW   
                              XRA   A   
                              STA   KEYBUF   
                              POP   PSW   
                              RET      
                    GK1:         
0453                          ENDIF      
0453                          IF   CPM   
0453   3E FF                  MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0455   C3 58 04               JMP   putc   ; (which ends with ORA A, for the zero flag)
0458                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0458                             ; printing and could swallow a key that BDOS 6 then never sees.
0458   C5           PUTC:     PUSH   B   
0459   D5                     PUSH   D   
045A   E5                     PUSH   H   
045B   5F                     MOV   E,A   
045C   0E 06                  MVI   C,6   
045E   CD 05 00               CALL   BDOS   
0461   E1                     POP   H   
0462   D1                     POP   D   
0463   C1                     POP   B   
0464   B7                     ORA   A   
0465   C9                     RET      
0466                          ENDIF      
0466                          IFN   CPM   
                              CALL   CONST   
                              ORA   A   
                              RZ      
                              CALL   CONIN   
                              ORA   A   
                              RET      
                    PUTC:     EQU   CONOUT   
0466                          ENDIF      
0466                             ; =============================================================================
0466                             ;  Checked build: break key and error reports
0466                             ; =============================================================================
0466                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   LDA   KEYBUF   
                              ORA   A   
                              RNZ      ; one key is already held
                              CALL   getk   
                              RZ      
                              CPI   3   
                              JZ   e_break   
                              STA   KEYBUF   
                              RET      
                    E_STACK:   CALL   error   
                              DB   "stac","k"+80h   
                    E_RSTACK:   CALL   error   
                              DB   "retur","n"+80h   
                    E_BREAK:   CALL   error   
                              DB   "brea","k"+80h   
                    E_HEAP:   CALL   error   
                              DB   "hea","p"+80h   
                    E_STORE:   CALL   error   
                              DB   "stor","e"+80h   
                    E_BRACK:   CALL   error   
                              DB   "["+80h   
                                 ; error: print CR LF, the word after the CALL (last character has bit 7
                                 ; set), " at " and the offset of the reading position in the program.
                    ERROR:    POP   D   ; DE -> the word
                              LXI   SP,DSTOP   ; the stacks may be wrecked: start clean
                              LXI   H,er1   
                              CALL   prs   
                              XCHG      
                              CALL   prs   ; the word
                              LXI   H,er2   
                              CALL   prs   
                              LXI   H,(0-PROG-1)&0FFFFh   
                              DAD   B   ; IP - (PROG+1): the character just read
                              CALL   pdec   
                              JMP   endprog   
                                 ; prs: print the string at HL, whose last character has bit 7 set
                    PRS:      MOV   A,M   
                              INX   H   
                              PUSH   PSW   
                              ANI   7Fh   
                              CALL   putc   
                              POP   PSW   
                              RAL      
                              JNC   prs   
                              RET      
                    ER1:      DB   13,10+80h   
                    ER2:      DB   " at"," "+80h   
0466                          ENDIF      
0466                             ; =============================================================================
0466                             ;  Startup
0466                             ; =============================================================================
0466                START:       
0466                          IF   CPM   
0466   31 FE 06               LXI   SP,DSTOP   
0469                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
0469   21 B7 04               LXI   H,stubs   ; RST 08h and RST 10h stubs into page zero
046C   11 08 00               LXI   D,0008h   
046F   06 0C                  MVI   B,12   
0471   7E           CPY:      MOV   A,M   
0472   12                     STAX   D   
0473   23                     INX   H   
0474   13                     INX   D   
0475   05                     DCR   B   
0476   C2 71 04               JNZ   cpy   
0479   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
047C   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
047E   CD 05 00               CALL   BDOS   ;   and the program is empty)
0481   11 00 08               LXI   D,PROG   
0484   D5           LD1:      PUSH   D   
0485   0E 1A                  MVI   C,26   ; set the DMA address
0487   CD 05 00               CALL   BDOS   
048A   11 5C 00               LXI   D,005Ch   
048D   0E 14                  MVI   C,20   ; read the next 128 bytes
048F   CD 05 00               CALL   BDOS   
