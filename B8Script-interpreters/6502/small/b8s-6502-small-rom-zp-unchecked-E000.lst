                              BVS   fgt1   
                              EOR   #80h   
                    FGT1:     ASL      
                              INX      
                              INX      
                              LDA   #0   
                              ADC   #0FFh   
                              STA   0,X   
                              STA   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_EQ:    LDY   #0   ; =
                              LDA   2,X   
                              CMP   0,X   
                              BNE   feq1   
                              LDA   3,X   
                              CMP   1,X   
                              BNE   feq1   
                              DEY      
                    FEQ1:     INX      
                              INX      
                              STY   0,X   
                              STY   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_AND:   LDA   0,X   ; &
                              AND   2,X   
                              STA   2,X   
                              LDA   1,X   
                              AND   3,X   
                              STA   3,X   
                              INX      
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_OR:    LDA   0,X   ; |
                              ORA   2,X   
                              STA   2,X   
                              LDA   1,X   
                              ORA   3,X   
                              STA   3,X   
                              INX      
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_XOR:   LDA   0,X   ; ^
                              EOR   2,X   
                              STA   2,X   
                              LDA   1,X   
                              EOR   3,X   
                              STA   3,X   
                              INX      
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_NOT:   LDA   0,X   ; ~
                              EOR   #0FFh   
                              STA   0,X   
                              LDA   1,X   
                              EOR   #0FFh   
                              STA   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_MUL:   JSR   h_mul   ; *
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_OPN:   INX      ; (
                              INX      
                              LDA   0FEh,X   
                              ORA   0FFh,X   
                              BEQ   fop1   
                              LDA   IP+1   ; true: the block starts at the IP
                              PHA      
                              LDA   IP   
                              PHA      
                              DEC   CDOWN   
                              BNE   fop2   
                              JSR   fpoll   
                              ;*Macro unroll: fop2:   NEXTF
                    FOP2:     DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FOP1:     JSR   skpo   ; false: skip to the matching )
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_CLS:   INX      ; )
                              INX      
                              LDA   0FEh,X   
                              ORA   0FFh,X   
                              BEQ   fcl1   
                              TXA      ; true: the block start, read where it is
                              TSX      
                              LDY   101h,X   
                              STY   IP   
                              LDY   102h,X   
                              STY   IP+1   
                              TAX      
                              DEC   CDOWN   
                              BNE   fcl2   
                              JSR   fpoll   
                              ;*Macro unroll: fcl2:   NEXTF
                    FCL2:     DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FCL1:     PLA      ; false: drop it
                              PLA      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_RET:   PLA      ; ]
                              STA   IP   
                              PLA      
                              STA   IP+1   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
E483                          ENDIF      
E483                             ; skpo: a false ( skips (the checked build: ] is the wrong closer for it)
E483                          IF   FAST*CHECKED   
                    SKPO:     LDA   #"]"   
                              JMP   skip   
E483                          ENDIF      
E483                          IF   FAST*(1-CHECKED)   
                    SKPO:     JMP   skip   
                                 ; ! and . (unchecked)
                    FT_STO:   LDA   2,X   ; !
                              STA   (0,X)   
                              INC   0,X   
                              BNE   fst1   
                              INC   1,X   
                    FST1:     LDA   3,X   
                              STA   (0,X)   
                              INX      
                              INX      
                              INX      
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
