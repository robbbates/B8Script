0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0000   AF                     XOR   A   ; 00  reset. (This byte, AFh, is also what an
0001                          ENDIF      ;     undefined word runs into: see e_hi.)
0001                          IF   1-EDGEN   
0001   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0004   18 6C                  JR   init   ; 04  (the rest of the startup is close by)
0006   00 00                  DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0008                          ENDIF      
0008                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0008                          ENDIF      
0008                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0008                          ENDIF      
0008                          IF   EDGEN   
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 D6 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 51 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 7C                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 7E                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 70                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 8A 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 DD        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 02                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE F4                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0072   21 00 82     INIT:     LD   HL,LET   
0075   77           INI1:     LD   (HL),A   
0076   2C                     INC   L   
0077   F2 75 00               JP   P,ini1   ; +00h to +7Fh
007A   01 00 83               LD   BC,PROG   ; the IP
007D                          ENDIF      
007D                          IF   (1-CPM)*(1-EDITOR)   
007D   60           ST0:      LD   H,B   
007E   69                     LD   L,C   
007F   AF                     XOR   A   
0080   BE           ST1:      CP   (HL)   
0081   23                     INC   HL   
0082   20 FC                  JR   NZ,st1   
0084                          ENDIF      
0084                          IF   1-EDITOR   
0084   22 7C 82     ST2:      LD   (HEAP),HL   
0087                          ENDIF      
0087                          IF   CHECKED*(1-EDITOR)   
0087   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0088   22 38 82               LD   (NPEND),HL   ;   release below it
008B                          ENDIF      
008B                          IF   1-EDITOR   
008B   D9                     EXX      
008C   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
008F   D9                     EXX      
0090   F7                     RST   30h   ; (its return address is thrown away)
0091                          ENDIF      
0091                             ; In the unchecked generic editor build the table is here, in the first
0091                             ; page, which saves loading D twice. (The other builds have no room for it
0091                             ; here: theirs is further down.)
0091                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0091                          ENDIF      
0091                             ; =============================================================================
0091                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0091                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0091                             ;  is here too: it belongs to "`" and makes the page come out right.
0091                             ; =============================================================================
0091   D1           H_XOR:    POP   DE   
0092   7C                     LD   A,H   
0093   AA                     XOR   D   
0094   67                     LD   H,A   
0095   7D                     LD   A,L   
0096   AB                     XOR   E   
0097   6F                     LD   L,A   
0098   F7                     RST   30h   
0099   D1           H_OR:     POP   DE   
009A   7C                     LD   A,H   
009B   B2                     OR   D   
009C   67                     LD   H,A   
009D   7D                     LD   A,L   
009E   B3                     OR   E   
009F   6F                     LD   L,A   
00A0   F7                     RST   30h   
00A1   E7           H_NOT:    RST   20h   ; ~x = -x - 1
00A2   2B                     DEC   HL   
00A3   F7                     RST   30h   
00A4                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
00A4                             ; the same either way); TOS is the old pointer.
00A4   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A8                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A8                          ENDIF      
00A8   19                     ADD   HL,DE   ; the new top
00A9                          IF   CHECKED   
00A9   CD 17 03               CALL   chkhp   
00AC                          ENDIF      
00AC   22 7C 82               LD   (HEAP),HL   
00AF   EB                     EX   DE,HL   
00B0   F7                     RST   30h   
00B1   D9           EXEC:     EXX      
00B2   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00B5   D9                     EXX      
00B6   CD 2B 00               CALL   jphl   
00B9   D9                     EXX      
00BA   2A 34 82               LD   HL,(RSAVE)   
00BD   D9                     EXX      
00BE   E1                     POP   HL   
00BF   F7                     RST   30h   
00C0                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00C0                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00C0                             ; Digits: step back onto the first digit and read the whole number.
00C0   E5           DIGIT:    PUSH   HL   
00C1   0B                     DEC   BC   
00C2   CD 4D 02               CALL   rdnum   
00C5   F7                     RST   30h   
00C6                             ; a-z: push the cell's address (the cell is the variable)
00C6   E5           LOWER:    PUSH   HL   
00C7   87                     ADD   A,A   
00C8   6F                     LD   L,A   
00C9   26 82                  LD   H,LETPAGE   
00CB   F7                     RST   30h   
00CC                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00CC                             ; the return stack, and the IP becomes the address in the letter's cell.
00CC   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00CD   EB                     EX   DE,HL   ; park TOS
00CE   87                     ADD   A,A   
00CF   6F                     LD   L,A   
00D0   26 82                  LD   H,LETPAGE   ; HL -> cell
00D2   4E                     LD   C,(HL)   
00D3   2C                     INC   L   
00D4   46                     LD   B,(HL)   ; IP = the word's body
00D5   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00D6                             ; rpushn: move the top cell of the data stack (in memory) to the return
00D6                             ; stack, then next. Everything that pushes the return stack ends here.
00D6                RPUSHN:      
00D6                          IF   CHECKED   
00D6   CD 7E 03               CALL   chkbrk   ; Ctrl-C is checked at every word call, block
00D9                          ENDIF      ;   entry, loop-back and "{"
00D9   D9                     EXX      
00DA   D1                     POP   DE   
00DB   2B                     DEC   HL   
00DC   72                     LD   (HL),D   
00DD   2B                     DEC   HL   
00DE   73                     LD   (HL),E   
00DF   D9                     EXX      
00E0   F7                     RST   30h   
00E1                             ; ---- machine code: the grave -----------------------------------------------
00E1                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00E1                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00E1                             ; written and its address is left. An odd last digit is consumed and dropped.
00E1                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00E1                             ; code is entered by CALL with the data stack above the return address; it
00E1                             ; must keep BC, and on return the top cell becomes the new TOS.
00E1   CD CB 02     H_GRAVE:   CALL   hexc   
00E4   30 CB                  JR   NC,exec   
00E6   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00E7   CD CB 02               CALL   hexc   
00EA   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00EC   ED 6F                  RLD      ;   overwrites it
00EE   23                     INC   HL   ; ... and RLD shifts it up under the low one
00EF   CD CB 02               CALL   hexc   
00F2   38 F2                  JR   C,hx1   
00F4   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00F6   F7                     RST   30h   
00F7                             ; ---- where the two pages meet ----------------------------------------------
00F7                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00F7                             ; are in falling code order for this), and where exactly differs between the
00F7                             ; builds: NPG1 follows. Every handler below these four must start in the
00F7                             ; second page, and every one above in the first; chktab.py checks both.
00F7                             ; "]" returns: pop an address and jump to it.
00F7   CF           H_RET:    RST   08h   
00F8   42                     LD   B,D   
00F9   4B                     LD   C,E   
00FA   F7           BRK1:     RST   30h   
00FB                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00FB                             ; drops the block start, "]" returns. No closer at all ends the program.
00FB   7C           H_BREAK:   LD   A,H   
00FC   B5                     OR   L   
00FD   E1                     POP   HL   
00FE   28 FA                  JR   Z,brk1   
0100   CD 74 02               CALL   skip   
0103   B7                     OR   A   ; skip returns 0 for ")"
0104   20 F1                  JR   NZ,h_ret   
0106   CF           RDROP:    RST   08h   
0107   F7                     RST   30h   
0108                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0108                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0108                             ; the body"s address instead. Either way it then skips to the matching "]'.
0108                             ; (The unchecked build takes anything that is not a letter as the space; the
0108                             ; checked build stops on it.)
0108   0A           H_DEF:    LD   A,(BC)   
0109   03                     INC   BC   
010A   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
010C   5F                     LD   E,A   ;   lands 64 bytes up
010D   E6 DF                  AND   0DFh   ; fold case
010F   FE 1A                  CP   26   
0111   30 0B                  JR   NC,def2   ; not a letter
0113   CB 23                  SLA   E   
0115   16 82                  LD   D,LETPAGE   ; DE -> cell
0117   79                     LD   A,C   
0118   12                     LD   (DE),A   
0119   1C                     INC   E   
011A   78                     LD   A,B   
011B   12                     LD   (DE),A   
011C   18 09                  JR   skipnx   
011E                DEF2:        
011E                          IF   CHECKED   
011E   7B                     LD   A,E   
011F   FE DF                  CP   " "-"A"+256   
0121   C2 AA 03               JP   NZ,e_brack   ; anything but a letter or a space
0124                          ENDIF      
0124   E5                     PUSH   HL   ; an anonymous block: push its address
0125   60                     LD   H,B   
0126   69                     LD   L,C   
0127                SKIPNX:      
0127                          IF   CHECKED   
0127   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0128                          ENDIF      ;   opener, the "[", just before where it starts
0128   CD 74 02     SKIPO:    CALL   skip   
012B   F7                     RST   30h   
012C   5E           H_FETCH:   LD   E,(HL)   ; "@"
012D   23                     INC   HL   
012E   56                     LD   D,(HL)   
012F   EB                     EX   DE,HL   
0130   F7                     RST   30h   
0131                             ; =============================================================================
0131                             ;  Handlers that must start in the image's second page.
0131                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0131                             ;  page.
0131                             ; =============================================================================
0131                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0131                             ; the matching ")".
0131   7C           H_OPEN:   LD   A,H   
0132   B5                     OR   L   
0133   E1                     POP   HL   
0134   28 F2                  JR   Z,skipo   
0136   C5                     PUSH   BC   ; the block starts at the IP
0137   18 9D                  JR   rpushn   
0139                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0139                             ; drops it and carries on.
0139   7C           H_CLOSE:   LD   A,H   
013A   B5                     OR   L   
013B   E1                     POP   HL   
013C   28 C8                  JR   Z,rdrop   
013E   CF                     RST   08h   ; pop the block start ...
013F   42                     LD   B,D   
0140   4B                     LD   C,E   
0141   C5                     PUSH   BC   
0142   18 92                  JR   rpushn   ; ... and push it back
0144                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0144                             ; "-" has two jobs: directly before a digit it starts a negative number.
0144   0A           H_SUB:    LD   A,(BC)   
0145   D6 30                  SUB   "0"   
0147   FE 0A                  CP   10   
0149   38 04                  JR   C,negnum   
014B   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
014C   D1           H_ADD:    POP   DE   
014D   19                     ADD   HL,DE   
014E   F7                     RST   30h   
014F   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0150   CD 4D 02               CALL   rdnum   
0153   E7                     RST   20h   
0154   F7                     RST   30h   
0155   D1           H_AND:    POP   DE   
0156   7C                     LD   A,H   
0157   A2                     AND   D   
0158   67                     LD   H,A   
0159   7D                     LD   A,L   
015A   A3                     AND   E   
015B   6F                     LD   L,A   
015C   F7                     RST   30h   
015D                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
015D                             ; cells first. Flipping both sign bits turns a signed compare into an
015D                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
015D                             ; carry into -1 or 0 with no branch.
015D   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
015E   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
015F   7C                     LD   A,H   
0160   EE 80                  XOR   80h   
0162   67                     LD   H,A   
0163   7A                     LD   A,D   
0164   EE 80                  XOR   80h   
0166   57                     LD   D,A   
0167   ED 52                  SBC   HL,DE   ; carry if HL < DE
0169   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
016B   F7                     RST   30h   
016C   D1           H_EQ:     POP   DE   
016D   B7                     OR   A   
016E   ED 52                  SBC   HL,DE   
0170   7C                     LD   A,H   
0171   B5                     OR   L   
0172   FE 01                  CP   1   ; carry only if a - b = 0
0174   18 F3                  JR   tf   
0176                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0176                             ; multiplier shifts up through A:C.
0176   D1           H_MUL:    POP   DE   ; DE = multiplicand
0177   C5                     PUSH   BC   
0178   7C                     LD   A,H   
0179   4D                     LD   C,L   ; A:C = multiplier
017A   21 00 00               LD   HL,0   
017D   06 10                  LD   B,16   
017F   29           MUL1:     ADD   HL,HL   
0180   CB 21                  SLA   C   
0182   17                     RLA      
0183   30 01                  JR   NC,mul2   
0185   19                     ADD   HL,DE   
0186   10 F7        MUL2:     DJNZ   mul1   
0188   C1                     POP   BC   
0189   F7                     RST   30h   
018A                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
018A                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
018A                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
018A                             ; stops on it.
018A                H_DIV:       
018A                          IF   CHECKED   
018A   7C                     LD   A,H   
018B   B5                     OR   L   
018C   CA A7 03               JP   Z,e_zero   
018F                          ENDIF      
018F   D1                     POP   DE   ; DE = a, HL = b
0190   C5                     PUSH   BC   ; free BC for udiv
0191   D5                     PUSH   DE   ; a, for r's sign
0192   7A                     LD   A,D   
0193   AC                     XOR   H   
0194   F5                     PUSH   AF   ; S flag = sign of q
0195   CB 7C                  BIT   7,H   
0197   C4 20 00               CALL   NZ,neg16   ; HL = |b|
019A   EB                     EX   DE,HL   
019B   CB 7C                  BIT   7,H   
019D   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
01A0   CD 27 02               CALL   udiv   ; HL = q, DE = r
01A3   F1                     POP   AF   
01A4   FC 20 00               CALL   M,neg16   ; q's sign
01A7   EB                     EX   DE,HL   ; HL = r, DE = q
01A8   F1                     POP   AF   ; A = a's high byte
01A9   B7                     OR   A   
01AA   FC 20 00               CALL   M,neg16   ; r's sign
01AD   C1                     POP   BC   
01AE   D5                     PUSH   DE   ; q under r
01AF   F7                     RST   30h   
01B0                             ; ---- stack and storage -----------------------------------------------------
01B0   E5           H_DUP:    PUSH   HL   ; ":"
01B1   F7                     RST   30h   
01B2   E3           H_SWAP:   EX   (SP),HL   ; "%"
01B3   F7                     RST   30h   
01B4                             ; (The checked build tests the address before it takes the value off the
01B4                             ; stack, so that an error report shows both.)
01B4                H_CSTORE:      ; "." ( c addr -- )
01B4                          IF   CHECKED   
01B4   CD 0A 03               CALL   chkst   
01B7                          ENDIF      
01B7   D1                     POP   DE   
01B8   73                     LD   (HL),E   
01B9   DF           H_DROP:   RST   18h   ; ";" is this one byte
01BA                H_STORE:      ; "!" ( n addr -- )
01BA                          IF   CHECKED   
01BA   CD 0A 03               CALL   chkst   
01BD                          ENDIF      
01BD   D1                     POP   DE   
01BE   73                     LD   (HL),E   
01BF   23                     INC   HL   
01C0   72                     LD   (HL),D   
01C1   DF                     RST   18h   
01C2                             ; ---- console ---------------------------------------------------------------
01C2                             ; 22h pushes the address of the text after it and skips the string.
01C2   E5           H_STR:    PUSH   HL   
01C3   60                     LD   H,B   
01C4   69                     LD   L,C   
01C5   CD 63 02               CALL   skipstr   
01C8                          IF   CHECKED   
01C8   B7                     OR   A   ; 0: the text ran out before the closing quote
01C9   CA 9F 03               JP   Z,e_quote   
01CC                          ENDIF      
01CC   F7                     RST   30h   
01CD                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01CD                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01CD                             ; bit 6, so // and /" give themselves).
01CD                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
01CD                          ENDIF      
01CD                          IF   CHECKED   
01CD                             ; (The checked build has the loop as a routine, prstr, which the error
01CD                             ; report uses too. The address is kept on the stack meanwhile: a report
01CD                             ; shows the stack as it was before the "$".)
01CD   E5           H_PRINT:   PUSH   HL   
01CE   CD 2B 03               CALL   prstr   
01D1   D1                     POP   DE   
01D2   DF                     RST   18h   
01D3                          ENDIF      
01D3   7D           H_EMIT:   LD   A,L   ; "'"
01D4   EF                     RST   28h   
01D5   DF           PR9:      RST   18h   
01D6                             ; "#" prints TOS as a signed decimal number, with no space after it.
01D6   C5           H_NUM:    PUSH   BC   
01D7   CD B1 02               CALL   psgn   
01DA   C1                     POP   BC   
01DB   DF                     RST   18h   
01DC                             ; "?" ( n -- c ) or ( -n -- addr )
01DC                             ;   n > 0: wait about n ms for a key; 0 if none came
01DC                             ;   n = 0: wait for a key
01DC                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01DC                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01DC   CB 7C        H_KEY:    BIT   7,H   
01DE   20 19                  JR   NZ,line   
01E0   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01E2   CD FD 02     KT2:      CALL   getk   
01E5   20 0E                  JR   NZ,kt3   
01E7   1D                     DEC   E   
01E8   20 F8                  JR   NZ,kt2   
01EA   7C                     LD   A,H   ; 0? never counts down: it waits
01EB   B5                     OR   L   
01EC   28 F2                  JR   Z,kt1   
01EE   2B                     DEC   HL   
01EF   7C                     LD   A,H   
01F0   B5                     OR   L   
01F1   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01F3   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01F4   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01F5   6F           KT3:      LD   L,A   
01F6   26 00                  LD   H,0   
01F8   F7                     RST   30h   
01F9                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
01F9                          ENDIF      
01F9                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
01F9                          ENDIF      
01F9                          IF   CPM   
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01F9                          ENDIF      
01F9                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
01F9                          ENDIF      
01F9                          IF   CPM*EDITOR   
                              RET      
01F9                          ENDIF      
01F9                          IFN   CPM   
01F9                             ; Generic: Backspace takes the last character back (and is echoed as
01F9                             ; it is), CR ends (stored, not echoed), every other key is stored and
01F9                             ; echoed until the line is full. The line buffer starts at offset 80h
01F9                             ; of its page, so L alone is the place in the line: D holds the L of
01F9                             ; a full line.
01F9                          ENDIF      
01F9                          IFN   CPM   
01F9   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01FC   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01FD   9F                     SBC   A,A   
01FE   A5                     AND   L   ; (0 for a count that is too big)
01FF   2F                     CPL      
0200   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
0201                          ENDIF      ;   at most
0201                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
0201                          ENDIF      
0201                          IFN   CPM   
0201   21 80 82               LD   HL,LINEBUF   
0204   CD FD 02     LN2:      CALL   getk   
0207   28 FB                  JR   Z,ln2   
0209   FE 0D                  CP   13   
020B   28 16                  JR   Z,ln5   
020D   FE 08                  CP   8   
020F   28 0B                  JR   Z,ln4   
0211   5F                     LD   E,A   
0212   7D                     LD   A,L   
0213   BA                     CP   D   
0214   28 EE                  JR   Z,ln2   ; full
0216   73                     LD   (HL),E   
0217   2C                     INC   L   
0218   7B                     LD   A,E   
0219   EF           LN3:      RST   28h   
021A   18 E8                  JR   ln2   
021C   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
021D   FA 19 02               JP   M,ln3   ;   unless the line was empty (L left the
0220   2C                     INC   L   ;   upper half of the page)
0221   18 E1                  JR   ln2   
0223   77           LN5:      LD   (HL),A   ; the CR
0224                          ENDIF      
0224                          IF   (1-CPM)*(1-EDITOR)   
0224   2E 80                  LD   L,LINEBUF & 0FFh   
0226   F7                     RST   30h   
0227                          ENDIF      
0227                          IF   EDGEN   
                              RET      
0227                          ENDIF      
0227                             ; =============================================================================
0227                             ;  More routines (no handler starts past this point)
0227                             ; =============================================================================
0227                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0227                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0227                             ; while the quotient bits arrive at the bottom of C.
0227                             ; Dividing by 2 is one shift (the spec wants that fast).
0227   7B           UDIV:     LD   A,E   
0228   EE 02                  XOR   2   
022A   B2                     OR   D   
022B   20 07                  JR   NZ,udv0   
022D   CB 3C                  SRL   H   
022F   CB 1D                  RR   L   ; the quotient
0231   8F                     ADC   A,A   
0232   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0233   C9                     RET      
0234   7C           UDV0:     LD   A,H   
0235   4D                     LD   C,L   
0236   21 00 00               LD   HL,0   
0239   06 10                  LD   B,16   
023B   CB 21        UDV1:     SLA   C   
023D   17                     RLA      
023E   ED 6A                  ADC   HL,HL   
0240   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0242   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0244   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0245   0D                     DEC   C   ;   INC below
0246   0C           UDV2:     INC   C   ; a quotient bit
0247   10 F2                  DJNZ   udv1   
0249   EB                     EX   DE,HL   ; DE = remainder
024A   67                     LD   H,A   
024B   69                     LD   L,C   ; HL = quotient
024C   C9                     RET      
024D                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
024D                             ; non-digit. Values wrap at 16 bits, as the spec says.
024D   21 00 00     RDNUM:    LD   HL,0   
0250   0A           RDN1:     LD   A,(BC)   
0251   D6 30                  SUB   "0"   
0253   FE 0A                  CP   10   
0255   D0                     RET   NC   
0256   03                     INC   BC   
0257   54                     LD   D,H   
0258   5D                     LD   E,L   
0259   29                     ADD   HL,HL   
025A   29                     ADD   HL,HL   
025B   19                     ADD   HL,DE   
025C   29                     ADD   HL,HL   ; HL * 10
025D   5F                     LD   E,A   
025E   16 00                  LD   D,0   
0260   19                     ADD   HL,DE   
0261   18 ED                  JR   rdn1   
0263                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0263                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0263                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0263                          ENDIF      
0263                          IF   CHECKED   
0263                             ; The checked build never steps over a NUL: if the text runs out first it
0263                             ; returns A = 0 with the IP on the NUL.
0263   0A           SKIPSTR:   LD   A,(BC)   
0264   B7                     OR   A   
0265   C8                     RET   Z   
0266   03                     INC   BC   
0267   FE 22                  CP   22h   
0269   C8                     RET   Z   
026A   FE 2F                  CP   "/"   
026C   20 F5                  JR   NZ,skipstr   
026E   0A                     LD   A,(BC)   ; the escaped character
026F   B7                     OR   A   
0270   C8                     RET   Z   
0271   03                     INC   BC   
0272   18 EF                  JR   skipstr   
0274                          ENDIF      
0274                             ; skip: read past text to the closer at this level, and return A = 0 if it
0274                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0274                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0274                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0274                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0274                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0274                             ; 
0274                             ; The checked build also looks at the character the skip was started by,
0274                             ; which is always the one just before where it starts: "(" must end at ")",
0274                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0274                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0274                             ; place where the skip started, for the report.
0274                SKIP:        
0274                          IF   CHECKED   
0274   C5                     PUSH   BC   
0275   DD E1                  POP   IX   
0277   0B                     DEC   BC   
0278   0A                     LD   A,(BC)   
0279   03                     INC   BC   
027A   5F                     LD   E,A   ; E = the opener: ( [ or \
027B                          ENDIF      
027B   16 00                  LD   D,0   
027D   14           SK3:      INC   D   ; an opener: one deeper
027E   0A           SK1:      LD   A,(BC)   
027F                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,endprog   
027F                          ENDIF      
027F                          IF   CHECKED   
027F   B7                     OR   A   
0280   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0282   03                     INC   BC   
0283                          ENDIF      
0283   FE 22                  CP   22h   
0285   CC 63 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0288   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
028A   28 F1                  JR   Z,sk3   
028C   3D                     DEC   A   ; ")"
028D   28 08                  JR   Z,sk4   
028F   D6 32                  SUB   "["-")"   
0291   28 EA                  JR   Z,sk3   
0293   FE 02                  CP   "]"-"["   
0295   20 E7                  JR   NZ,sk1   
0297   15           SK4:      DEC   D   
0298                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0298                          ENDIF      
0298                          IF   CHECKED   
0298   20 E4                  JR   NZ,sk1   
029A   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
029B   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
029C   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
029E   FE 02                  CP   2   ;   closer, and only then
02A0   7A                     LD   A,D   
02A1   C0                     RET   NZ   
02A2   18 05                  JR   sk7   
02A4   CB 53        SK6:      BIT   2,E   ; the text ran out:
02A6   C2 15 00               JP   NZ,endprog   ;   "\" with no closer ends the program
02A9   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
02AB   C1                     POP   BC   
02AC   3E 4E                  LD   A,"N"   
02AE   C3 9C 03               JP   errp   ; (errp drops skip's return address)
02B1                          ENDIF      
02B1                             ; psgn: print HL as a signed number. Uses BC.
02B1   CB 7C        PSGN:     BIT   7,H   
02B3   28 04                  JR   Z,pdec   
02B5   3E 2D                  LD   A,"-"   
02B7   EF                     RST   28h   
02B8   E7                     RST   20h   
02B9                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02B9                             ; Uses BC.
02B9   11 0A 00     PDEC:     LD   DE,10   
02BC   CD 27 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02BF   7B                     LD   A,E   
02C0   F5                     PUSH   AF   
02C1   7C                     LD   A,H   
02C2   B5                     OR   L   
02C3   C4 B9 02               CALL   NZ,pdec   
02C6   F1                     POP   AF   
02C7   C6 30                  ADD   A,"0"   
02C9   EF                     RST   28h   
02CA   C9                     RET      
02CB                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02CB                             ; and return its value in A with the carry set; otherwise leave the IP and
02CB                             ; return with the carry clear.
02CB   0A           HEXC:     LD   A,(BC)   
02CC   D6 30                  SUB   "0"   
02CE   FE 0A                  CP   10   
02D0   38 09                  JR   C,hc1   
02D2   E6 DF                  AND   0DFh   
02D4   D6 11                  SUB   11h   
02D6   FE 06                  CP   6   
02D8   D0                     RET   NC   
02D9   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02DB   03           HC1:      INC   BC   
02DC   C9                     RET      
02DD                             ; =============================================================================
02DD                             ;  Dispatch table: the low byte of each handler's address, in code order
02DD                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02DD                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02DD                             ; =============================================================================
02DD                             ; The handlers of the first NPG1 characters start in the image's second page.
02DD                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02DD                             ; differs between the builds, so the count is worked out here.
02DD                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02DD                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02DD                PGBRK:    EQU   (h_break-BASE)/256   
02DD                PGDEF:    EQU   (h_def-BASE)/256   
02DD                PGFET:    EQU   (h_fetch-BASE)/256   
02DD                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02DD                          IF   1-TABP0   
02DD                PTAB:        
02DD                          ;*Macro unroll:  PTABLE
02DD   BA                     DB   h_store & 0FFh   
02DE   C2                     DB   h_str & 0FFh   
02DF   D6                     DB   h_num & 0FFh   
02E0   CD                     DB   h_print & 0FFh   
02E1   B2                     DB   h_swap & 0FFh   
02E2   55                     DB   h_and & 0FFh   
02E3   D3                     DB   h_emit & 0FFh   
02E4   31                     DB   h_open & 0FFh   
02E5   39                     DB   h_close & 0FFh   
02E6   76                     DB   h_mul & 0FFh   
02E7   4C                     DB   h_add & 0FFh   
02E8   F4                     DB   h_cfetch & 0FFh   
02E9   44                     DB   h_sub & 0FFh   
02EA   B4                     DB   h_cstore & 0FFh   
02EB   8A                     DB   h_div & 0FFh   
02EC   B0                     DB   h_dup & 0FFh   
02ED   B9                     DB   h_drop & 0FFh   
02EE   5D                     DB   h_lt & 0FFh   
02EF   6C                     DB   h_eq & 0FFh   
02F0   5E                     DB   h_gt & 0FFh   
02F1   DC                     DB   h_key & 0FFh   
02F2   2C                     DB   h_fetch & 0FFh   
02F3   08                     DB   h_def & 0FFh   
02F4   FB                     DB   h_break & 0FFh   
02F5   F7                     DB   h_ret & 0FFh   
02F6   91                     DB   h_xor & 0FFh   
02F7   A4                     DB   h_alloc & 0FFh   
02F8   E1                     DB   h_grave & 0FFh   
02F9   2C                     DB   h_tor & 0FFh   
02FA   99                     DB   h_or & 0FFh   
02FB   1C                     DB   h_fromr & 0FFh   
02FC   A1                     DB   h_not & 0FFh   
02FD                PTABEND:      
02FD                          ENDIF      
02FD                             ; =============================================================================
02FD                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02FD                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
02FD                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
02FD                             ;  KEY and CONOUT routines themselves.
02FD                             ; =============================================================================
02FD                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
02FD                          ENDIF      
02FD                          IF   CHECKED   
02FD   E5           GETK:     PUSH   HL   ; a key held back by the break check goes
02FE   21 36 82               LD   HL,KEYBUF   ;   first, and is taken out of the buffer
0301   7E                     LD   A,(HL)   
0302   36 00                  LD   (HL),0   
0304   E1                     POP   HL   
0305   B7                     OR   A   
0306   C0                     RET   NZ   
0307                          ENDIF      
0307                          IF   (1-CPM)*CHECKED   
0307   C3 06 FF               JP   KEY   
030A                          ENDIF      
030A                          IF   CPM*(1-CHECKED)   
                    GETK:        
030A                          ENDIF      
030A                          IF   CPM   
                              LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
030A                          ENDIF      
030A                             ; =============================================================================
030A                             ;  Checked build: the checks and the error report
030A                             ; =============================================================================
030A                          IF   CHECKED   
030A                             ; chkst: stop unless HL is in the program's own space: from the letter page
030A                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
030A                             ; whatever lies above the limit are safe. Memory above the heap top but
030A                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
030A                             ; It is the page of HL + 1 that is tested, so that one test serves both
030A                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
030A                             ; Keeps HL and BC.
030A   23           CHKST:    INC   HL   
030B   7C                     LD   A,H   
030C   2B                     DEC   HL   
030D   FE 82                  CP   LETPAGE   
030F   38 03                  JR   C,chs1   
0311                          ENDIF      
0311                          IF   CHECKED*(1-CPM)   
0311   FE F0                  CP   HEAPLIM   
0313   D8                     RET   C   
0314                          ENDIF      
0314                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0314                          ENDIF      
0314                          IF   CHECKED   
0314   C3 9A 03     CHS1:     JP   e_store   
0317                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0317                             ; the count. Stop if the top is not below the limit page, or is below the
0317                             ; program's end.
0317                CHKHP:       
0317                          ENDIF      
0317                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0317                          ENDIF      
0317                          IF   CHECKED*(1-CPM)   
0317                             ; (Here the program's space is under 32K, so a top that wrapped
0317                             ; round always falls outside it.)
0317   7C                     LD   A,H   
0318   FE F0                  CP   HEAPLIM   
031A   30 09                  JR   NC,e_heap   
031C                          ENDIF      
031C                          IF   CHECKED   
031C   D5                     PUSH   DE   
031D   EB                     EX   DE,HL   
031E   2A 38 82               LD   HL,(NPEND)   
0321   19                     ADD   HL,DE   ; carry: at or above the program's end
0322   EB                     EX   DE,HL   
0323   D1                     POP   DE   
0324   D8                     RET   C   
0325   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0326   ED 52                  SBC   HL,DE   
0328   C3 97 03               JP   e_heap1   
032B                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
032B                             ; "$", and the error report's texts). A NUL first is an error: Q.
032B   7E           PRSTR:    LD   A,(HL)   
032C   23                     INC   HL   
032D   FE 22                  CP   22h   
032F   C8                     RET   Z   
0330   B7                     OR   A   
0331   28 0B                  JR   Z,e_dollar   
0333   FE 2F                  CP   "/"   
0335   20 04                  JR   NZ,prs1   
0337   7E                     LD   A,(HL)   
0338   23                     INC   HL   
0339   E6 BF                  AND   0BFh   
033B   EF           PRS1:     RST   28h   
033C   18 ED                  JR   prstr   
033E   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
033F   E1                     POP   HL   ;   and put the string's address back in TOS
0340   3E 51                  LD   A,"Q"   
0342   C3 AC 03               JP   error   
0345                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0345                             ; pnl: the same, on a new line.
0345   3E 0D        PNL:      LD   A,13   
0347   EF                     RST   28h   
0348   3E 0A                  LD   A,10   
034A   EF                     RST   28h   
034B   E3           PMSG:     EX   (SP),HL   
034C   CD 2B 03               CALL   prstr   
034F   E3                     EX   (SP),HL   
0350   C9                     RET      
0351                             ; chkstk: both stacks are checked once per character, not in every handler.
0351                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0351                             ; the constant carries if it is above (cells were popped that were never
0351                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0351                             ; a character late at most: the bytes above DSTOP and the guard band below
0351                             ; the page take what happens meanwhile. DE is free between characters.
0351   EB           CHKSTK:   EX   DE,HL   
0352   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0355   39                     ADD   HL,SP   
0356   EB                     EX   DE,HL   
0357   38 1E                  JR   C,e_under   
0359   14                     INC   D   
035A   20 17                  JR   NZ,e_over   
035C   D9                     EXX      ; the return stack: in its page (or it has
035D   7C                     LD   A,H   ;   overflowed), and not above its empty
035E   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
0360   7D                     LD   A,L   ;   page, in the guard band)
0361   D9                     EXX      
0362   20 0C                  JR   NZ,e_rover   
0364   FE E1                  CP   RSTOP&0FFh+1   
0366   D8                     RET   C   
0367   D9                     EXX      ; return stack underflow: it counts as empty
0368   21 E0 80               LD   HL,RSTOP   
036B   D9                     EXX      
036C   3E 72                  LD   A,"r"   
036E   18 2C                  JR   errp   
0370   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0372   11                     DB   11h   ; (LD DE,nn hides the next entry)
0373   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0375   18 25                  JR   errp   
0377   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
037A   3E 73                  LD   A,"s"   
037C   18 2E                  JR   error   
037E                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
037E                             ; else is held for the next "?".
037E   CD FD 02     CHKBRK:   CALL   getk   
0381   C8                     RET   Z   
0382   FE 03                  CP   3   
0384   28 0E                  JR   Z,e_break   
0386   32 36 82               LD   (KEYBUF),A   
0389   C9                     RET      
038A                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
038A                             ; was never defined still holds 0000h, and the byte there is a reserved one
038A                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
038A                             ; an undefined word. The call is undone, so the place is the call itself.
038A   04           E_HI:     INC   B   
038B   10 17                  DJNZ   e_resv   ; (B is as it was, and is not 0)
038D   CF                     RST   08h   
038E   42                     LD   B,D   
038F   4B                     LD   C,E   
0390   3E 55                  LD   A,"U"   
0392   18 18                  JR   error   
0394                             ; Error entries. Each loads its letter and then hides the next entry inside
0394                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0394   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside chkbrk)
0396   11                     DB   11h   
0397   3E 48        E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
0399   11                     DB   11h   
039A   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
039C                             ; errp: an error found inside a routine: drop its return address first.
039C   D1           ERRP:     POP   DE   
039D   18 0D                  JR   error   
039F   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
03A0   4D                     LD   C,L   ;   past the opening quote, which is the place
03A1   3E 51                  LD   A,"Q"   
03A3   11                     DB   11h   
03A4   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
03A6   11                     DB   11h   
03A7   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
03A9   11                     DB   11h   
03AA   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
03AC                             ; error: the report, then the end. A = the letter, BC = one past the place,
03AC                             ; HL = TOS, and both stacks as the report is to show them:
03AC                             ; 
03AC                             ;   Err X @ line,col
03AC                             ;   up to 16 characters of the text from the place
03AC                             ;   Stk n: the top 8 cells at most, bottom to top
03AC                             ;   Rtn n
03AC   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
03AD   5F                     LD   E,A   
03AE   CD 45 03               CALL   pnl   
03B1   45 72 72 20 22         DB   "Err ",22h   
03B6   7B                     LD   A,E   
03B7   EF                     RST   28h   
03B8   CD 4B 03               CALL   pmsg   
03BB   20 40 20 22            DB   " @ ",22h   
03BF   0B                     DEC   BC   ; BC = the place
03C0                             ; The line and column. A place below the program is in the line
03C0                             ; buffer: line 0. Otherwise count the LFs from the program's start;
03C0                             ; DE = the line's number, HL = where it starts.
03C0   21 80 82               LD   HL,LINEBUF   
03C3   11 00 00               LD   DE,0   
03C6   78                     LD   A,B   
03C7   FE 83                  CP   PROG/256   
03C9   38 14                  JR   C,er3   
03CB   24                     INC   H   
03CC   6B                     LD   L,E   ; HL = PROG
03CD   13           ER1:      INC   DE   ; a new line starts at HL
03CE   E5                     PUSH   HL   
03CF   7D           ER2:      LD   A,L   
03D0   91                     SUB   C   
03D1   7C                     LD   A,H   
03D2   98                     SBC   A,B   
03D3   30 09                  JR   NC,er2x   ; reached the place
03D5   7E                     LD   A,(HL)   
03D6   23                     INC   HL   
03D7   FE 0A                  CP   10   
03D9   20 F4                  JR   NZ,er2   
03DB   F1                     POP   AF   
03DC   18 EF                  JR   er1   
03DE   E1           ER2X:     POP   HL   
03DF   C5           ER3:      PUSH   BC   
03E0   E5                     PUSH   HL   
03E1   EB                     EX   DE,HL   
03E2   CD B9 02               CALL   pdec   ; the line
03E5   3E 2C                  LD   A,","   
03E7   EF                     RST   28h   
03E8   D1                     POP   DE   
03E9   E1                     POP   HL   
03EA   E5                     PUSH   HL   
03EB   B7                     OR   A   
03EC   ED 52                  SBC   HL,DE   
03EE   23                     INC   HL   
03EF   CD B9 02               CALL   pdec   ; the column
03F2   CD 45 03               CALL   pnl   
03F5   22                     DB   22h   
03F6   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
03F7   06 10                  LD   B,16   ;   if the line or the program ends first
03F9   7E           ER4:      LD   A,(HL)   
03FA   23                     INC   HL   
03FB   B7                     OR   A   
03FC   28 0B                  JR   Z,er5   
03FE   FE 0D                  CP   13   
0400   28 07                  JR   Z,er5   
0402   FE 0A                  CP   10   
0404   28 03                  JR   Z,er5   
0406                          ENDIF      
0406                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0406                          ENDIF      ;   screen on it)
0406                          IF   CHECKED   
0406   EF                     RST   28h   
0407   10 F0                  DJNZ   er4   
0409   CD 45 03     ER5:      CALL   pnl   
040C   53 74 6B 20 22         DB   "Stk ",22h   
0411   21 FA 81               LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
0414   B7                     OR   A   ;   first value and holds nothing)
0415   ED 72                  SBC   HL,SP   
0417   CD 62 04               CALL   phalf   ; the depth
041A   3E 3A                  LD   A,":"   
041C   EF                     RST   28h   
041D   79                     LD   A,C   
041E   FE 09                  CP   9   
0420   38 0A                  JR   C,er6   
0422   CD 4B 03               CALL   pmsg   
0425   20 2E 2E 2E 22         DB   " ...",22h   
042A   0E 08                  LD   C,8   
042C   26 00        ER6:      LD   H,0   ; C = the number of cells to show
042E   69                     LD   L,C   
042F   29                     ADD   HL,HL   
0430   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0431   0C                     INC   C   
0432   0D           ER7:      DEC   C   
0433   28 11                  JR   Z,er8   
0435   2B                     DEC   HL   
0436   56                     LD   D,(HL)   
0437   2B                     DEC   HL   
0438   5E                     LD   E,(HL)   
0439   E5                     PUSH   HL   
043A   C5                     PUSH   BC   
043B   3E 20                  LD   A," "   
043D   EF                     RST   28h   
043E   EB                     EX   DE,HL   
043F   CD B1 02               CALL   psgn   
0442   C1                     POP   BC   
0443   E1                     POP   HL   
0444   18 EC                  JR   er7   
0446   CD 45 03     ER8:      CALL   pnl   
0449   52 74 6E 20 22         DB   "Rtn ",22h   
044E   D9                     EXX      
044F   E5                     PUSH   HL   
0450   D9                     EXX      
0451   D1                     POP   DE   
0452   21 E0 80               LD   HL,RSTOP   
0455   B7                     OR   A   
0456   ED 52                  SBC   HL,DE   
0458   CD 62 04               CALL   phalf   
045B   CD 45 03               CALL   pnl   
045E   22                     DB   22h   
045F   C3 15 00               JP   endprog   
0462                             ; phalf: print half of HL, and leave it in C
0462   CB 3C        PHALF:    SRL   H   
0464   CB 1D                  RR   L   
0466   E5                     PUSH   HL   
0467   CD B9 02               CALL   pdec   
046A   C1                     POP   BC   
046B   C9                     RET      
046C                          ENDIF      
046C                             ; =============================================================================
046C                             ;  The line editor (EDITOR = 1)
046C                             ; 
046C                             ;  The interpreter starts here, and a program that ends comes back here. Type
046C                             ;  a line and press Return:
046C                             ; 
046C                             ;    n text    put the text in as line n; the lines from n on move down.
046C                             ;              A number past the end, or 0, adds the line at the end.
046C                             ;    n         take line n out
046C                             ;    0         run the program
046C                             ;    -n        list the program from line n on (-1 lists all of it). Any key
046C                             ;              stops the list until another key is pressed; Ctrl-C ends it.
046C                             ;    anything else is run at once, as B8Script. (Start such a line with a
046C                             ;    space if it would begin with a digit or a minus sign.)
046C                             ; 
046C                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
046C                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
046C                             ;  125 characters, the line number and the one character after it included;
046C                             ;  that character is not stored. The text is kept as it is typed, each line
046C                             ;  ending in CR LF, at PROG. Nothing is checked.
046C                             ; 
046C                             ;  With CPM = 1 the file named on the command line is the program to start
046C                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
046C                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
046C                             ;  CP/M. Nothing is written back: there is no command to save.
046C                             ; 
046C                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
046C                             ;  its report and comes back here, with both stacks empty. The place is a
046C                             ;  line and column of the program; in a line typed here it is line 0.
046C                             ; 
046C                             ;  Things to know:
046C                             ;    - Reset empties the program (generic builds).
046C                             ;    - Words and variables last from one line to the next. A word's address
046C                             ;      points into the program, so run the program again after editing it.
046C                             ;    - Nothing is printed between a program's output and what is typed next.
046C                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
046C                             ;      a line that calls -n? and carries on afterwards runs what was typed.
046C                             ;      (The stored program never comes back to the line, so it may.)
046C                             ; =============================================================================
046C                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
046C                          ENDIF      
046C                          IF   EDITOR   
                                 ; -n: list from line n. DE = the number of the line at HL.
                    LIST:     INC   BC   
                              CALL   rdnum   ; HL = n
                              PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,edit   ; the end of the text
                              CALL   getk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,edit   ; Ctrl-C
                    LI2:      CALL   getk   ; any other key: wait for one more
                              JR   Z,li2   
                              CP   3   
                              JR   Z,edit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; Take line n (in HL) out: copy everything after it down over it.
                    DEL:      CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
046C                          ENDIF      
046C                          IF   EDITOR*CPM*CHECKED   
                                 ; A key that the break check held back while a program ran is let
                                 ; go: BDOS 10 would not see it, and it would turn up in the next
                                 ; program that asked for a key. (This also serves at the start.)
                              XOR   A   
                              LD   (KEYBUF),A   
046C                          ENDIF      
046C                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
046C                          ENDIF      
046C                          IF   EDITOR*CPM   
                              LD   A,125   
046C                          ENDIF      
046C                          IF   EDITOR   
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   
                              CALL   prl   ; (print the CR LF: a new line)
                              LD   (HL),0   ;   and a NUL after that
                              PUSH   HL   ; the end of what was typed
                              LD   BC,LINEBUF   
                              LD   A,(BC)   
                              CP   "-"   
                              JR   Z,list   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0   ; no number: run the line where it is
                              LD   A,(BC)   
                              SUB   13   
                              JR   NZ,ins   ; text follows the number
                              OR   H   ; the number alone:
                              OR   L   
                              JR   NZ,del   ;   not 0: take that line out
                              LD   BC,PROG   ;   0: run the program
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
                              LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
046C                          ENDIF      
046C                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
046C                          ENDIF      
046C                          IF   EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; Put the typed text in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              INC   BC   ; step over the one character after the number
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                              JR   edit   
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
046C                          ENDIF      
046C                             ; =============================================================================
046C                             ;  CP/M startup (the generic build starts at address 0: see st0)
046C                             ; =============================================================================
046C                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
046C                          ENDIF      
046C                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
046C                          ENDIF      
046C                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:         
046C                          ENDIF      
046C                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
046C                          ENDIF      
046C                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
046C                          ENDIF      
046C                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
046C                          ENDIF      
046C                IMGEND:      


