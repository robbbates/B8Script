01B9   87           HX1:      ADD   A   
01BA   87                     ADD   A   
01BB   87                     ADD   A   
01BC   87                     ADD   A   
01BD   57                     MOV   D,A   ; the high digit
01BE   CD D3 04               CALL   hexc   
01C1   D2 CD 01               JNC   hx2   ; odd digit: consumed and dropped
01C4   B2                     ORA   D   
01C5   77                     MOV   M,A   
01C6   23                     INX   H   
01C7   CD D3 04               CALL   hexc   
01CA   DA B9 01               JC   hx1   
01CD   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
01CF                          ;*Macro unroll:  NEXT
01CF                          DS   (1-CPM)*(1-FAST),0F7h   
01CF   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
01D0   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01D1   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
01D2                             ; ---- where the two pages meet ----------------------------------------------
01D2                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D2                             ; are in falling code order for this), and where exactly differs between the
01D2                             ; builds: NPG1 follows. Every handler below these four must start in the
01D2                             ; second page, and every one above in the first; chktab.py checks both.
01D2                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
01D2                             ; while rpop uses HL, and the drop at the end brings it back.
01D2   E5           H_RET:    PUSH   H   
01D3                          ;*Macro unroll: ret2:   POPR
01D3                RET2:     DS   1-CPM,0CFh   
01D3   CD                     DS   CPM,0CDh   
