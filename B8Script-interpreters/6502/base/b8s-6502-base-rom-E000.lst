                              ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              TAY      
                              LDA   T1   
                              SBC   D1   
                              BCC   uv10   
                              STA   T1   
                              STY   T0   
                              INC   TL   
                    UV10:        
                              ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              TAY      
                              LDA   T1   
                              SBC   D1   
                              BCC   uv11   
                              STA   T1   
                              STY   T0   
                              INC   TL   
                    UV11:        
                              ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              TAY      
                              LDA   T1   
                              SBC   D1   
                              BCC   uv12   
                              STA   T1   
                              STY   T0   
                              INC   TL   
                    UV12:        
                              ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              TAY      
                              LDA   T1   
                              SBC   D1   
                              BCC   uv13   
                              STA   T1   
                              STY   T0   
                              INC   TL   
                    UV13:        
                              ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              TAY      
                              LDA   T1   
                              SBC   D1   
                              BCC   uv14   
                              STA   T1   
                              STY   T0   
                              INC   TL   
                    UV14:        
                              ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              TAY      
                              LDA   T1   
                              SBC   D1   
                              BCC   uv15   
                              STA   T1   
                              STY   T0   
                              INC   TL   
                    UV15:        
                              RTS      
E62F                          ENDIF      
E62F                          IF   1-FAST   
E62F   A0 10        UD0:      LDY   #16   
E631   06 02        UD1:      ASL   TL   
E633   26 03                  ROL   TH   
E635   26 04                  ROL   T0   
E637   26 05                  ROL   T1   
E639   38                     SEC      
E63A   A5 04                  LDA   T0   
E63C   E5 08                  SBC   D0   
E63E   48                     PHA      
E63F   A5 05                  LDA   T1   
E641   E5 09                  SBC   D1   
E643   90 08                  BCC   ud2   
E645   85 05                  STA   T1   
E647   68                     PLA      
E648   85 04                  STA   T0   
E64A   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E64C   24                     DB   24h   ; (BIT zp: steps over the PLA)
E64D   68           UD2:      PLA      
E64E   88                     DEY      
E64F   D0 E0                  BNE   ud1   
E651   60                     RTS      
E652                          ENDIF      
E652                             ; =============================================================================
E652                             ;  Fetches, and the keyboard
E652                             ; =============================================================================
E652   A0 01        H_FETCH:   LDY   #1   ; "@"
E654   B1 02                  LDA   (TL),Y   
E656   48                     PHA      ; the high byte, while "," gets the low one
E657   20 5E E6               JSR   h_cfetch   
E65A   68                     PLA      
E65B   85 03                  STA   TH   
E65D   60                     RTS      
E65E                H_CFETCH:      ; ","
E65E   A0 00                  LDY   #0   
E660   B1 02                  LDA   (TL),Y   
E662   85 02        CF2:      STA   TL   ; TOS = A (low), Y (high)
E664   84 03                  STY   TH   
E666   60                     RTS      
E667                             ; "?" ( n -- c ) or ( -n -- addr )
E667                             ;   n > 0: wait about n ms for a key; 0 if none came
E667                             ;   n = 0: wait for a key
E667                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E667                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E667   A5 03        H_KEY:    LDA   TH   
E669   30 20                  BMI   line   
E66B   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E66D   20 C6 E0     KT2:      JSR   getk   
E670   D0 15                  BNE   kt3   
E672   88                     DEY      
E673   D0 F8                  BNE   kt2   
E675   A5 02                  LDA   TL   ; count the millisecond off:
E677   D0 06                  BNE   kt4   
E679   A5 03                  LDA   TH   
E67B   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E67D   C6 03                  DEC   TH   
E67F   C6 02        KT4:      DEC   TL   
E681   D0 E8                  BNE   kt1   
E683   A5 03                  LDA   TH   
E685   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E687   A0 00        KT3:      LDY   #0   
E689   F0 D7                  BEQ   cf2   ; always: TOS = A
E68B                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E68B                             ; (stored, not echoed), every other key is stored and echoed until the line
E68B                             ; is full. Y = the length so far; TL = the most allowed.
E68B   20 CD E4     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E68E   D0 04                  BNE   ln0   
E690   A5 02                  LDA   TL   
E692   10 04                  BPL   ln1   
E694   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E696   85 02                  STA   TL   
E698   A0 00        LN1:      LDY   #0   
E69A   F0 03                  BEQ   ln2   ; always
E69C   20 03 FF     LN3:      JSR   CONOUT   
E69F   20 C6 E0     LN2:      JSR   getk   
E6A2   F0 FB                  BEQ   ln2   
E6A4   C9 0D                  CMP   #13   
E6A6   F0 14                  BEQ   ln5   
E6A8   C9 08                  CMP   #8   
E6AA   F0 0A                  BEQ   ln4   
E6AC   C4 02                  CPY   TL   
E6AE   B0 EF                  BCS   ln2   ; full
E6B0   99 80 04               STA   LINEBUF,Y   
E6B3   C8                     INY      
E6B4   D0 E6                  BNE   ln3   ; always: echo it
E6B6   88           LN4:      DEY      ; Backspace: one back, and echo it,
E6B7   10 E3                  BPL   ln3   
E6B9   C8                     INY      ;   unless the line was empty
E6BA   F0 E3                  BEQ   ln2   ; always
E6BC   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E6BF   A9 80                  LDA   #<LINEBUF   
E6C1   A0 04                  LDY   #>LINEBUF   
E6C3   D0 9D                  BNE   cf2   ; always: TOS = the line's address
E6C5                             ; =============================================================================
E6C5                             ;  Machine code: the grave
E6C5                             ; =============================================================================
E6C5                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E6C5                             ; are stored from addr until a non-hex character; then a RET (60h) is
E6C5                             ; written and its address is left. An odd last digit is consumed and dropped.
E6C5                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E6C5                             ; contract in the header.
E6C5   20 1D E4     H_GRAVE:   JSR   rdhex   
E6C8   B0 1C                  BCS   exec   
E6CA   0A           HX1:      ASL      
E6CB   0A                     ASL      
E6CC   0A                     ASL      
E6CD   0A                     ASL      
E6CE   85 04                  STA   T0   
E6D0   20 1D E4               JSR   rdhex   
E6D3   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E6D5   05 04                  ORA   T0   
E6D7   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
E6D9   20 1D E3               JSR   inctos   
E6DC   20 1D E4               JSR   rdhex   
E6DF   90 E9                  BCC   hx1   
E6E1   A9 60        HX2:      LDA   #60h   
E6E3   91 02                  STA   (TL),Y   
E6E5   60                     RTS      
E6E6   A5 02        EXEC:     LDA   TL   
E6E8   85 04                  STA   T0   
E6EA   A5 03                  LDA   TH   
E6EC   85 05                  STA   T1   
E6EE   20 71 E4               JSR   drop   ; the address is consumed
E6F1   6C 04 00               JMP   (T0)   
E6F4                          IF   CHECKED   
E6F4                             ; =============================================================================
E6F4                             ;  Checked build: the error report
E6F4                             ; =============================================================================
E6F4                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E6F4                             ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
E6F4                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E6F4                             ; its depth is shown.
E6F4                             ;   CR LF
E6F4                             ;   Err X @ line,col CR LF
E6F4                             ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
E6F4                             ;   R:n CR LF
E6F4                             ; The numbers go through "#" (h_num), each pushed over the data stack first
E6F4                             ; and popped again by "#", so the stack is shown as it was.
E6F4   48           ERROR:    PHA      ; the letter
E6F5   A0 00                  LDY   #M_ERR-MSG   
E6F7   20 82 E3               JSR   prs   ; CR LF "Err "
E6FA   68                     PLA      
E6FB   20 03 FF               JSR   CONOUT   
E6FE   20 82 E3               JSR   prs   ; " @ " (it follows M_ERR)
E701                             ; The line and the column of the place, both from 1. The line is counted in
E701                             ; a cell pushed over the data stack (TOS). A place below the program is in
E701                             ; the -n? line buffer: line 0, and the column is the place in the buffer.
E701                             ; Otherwise IP (free now: the program has stopped) runs from PROG to the
E701                             ; place, counting LFs; CL keeps where the last line started, and the column
E701                             ; is the place minus that, plus 1.
E701   A9 80                  LDA   #<LINEBUF   
E703   85 0A                  STA   CL   
E705   A9 04                  LDA   #>LINEBUF   
E707   85 0B                  STA   CL+1   
E709   A9 00                  LDA   #0   
E70B   A8                     TAY      
E70C   20 78 E1               JSR   pushay   ; TOS = the line, 0 so far
E70F   A5 06                  LDA   PLACE   
E711   C9 00                  CMP   #<PROG   
E713   A5 07                  LDA   PLACE+1   
E715   E9 05                  SBC   #>PROG   
E717   90 23                  BCC   lc9   ; below the program: line 0
E719   E6 02                  INC   TL   
E71B   20 40 E4               JSR   rstip   
E71E   A5 00        LC3:      LDA   IP   ; a line starts here
E720   85 0A                  STA   CL   
E722   A5 01                  LDA   IP+1   
E724   85 0B                  STA   CL+1   
E726   A5 00        LC1:      LDA   IP   
E728   C5 06                  CMP   PLACE   
E72A   A5 01                  LDA   IP+1   
E72C   E5 07                  SBC   PLACE+1   
E72E   B0 0C                  BCS   lc9   ; at the place
E730   20 34 E4               JSR   getc   
E733   C9 0A                  CMP   #10   
E735   D0 EF                  BNE   lc1   
E737   20 1D E3               JSR   inctos   ; an LF: a new line starts after it
E73A   D0 E2                  BNE   lc3   ; always (Z clear: fewer than 65536 lines)
E73C   20 56 E3     LC9:      JSR   h_num   ; the line (and it is dropped)
E73F   A9 2C                  LDA   #","   
E741   20 03 FF               JSR   CONOUT   
E744   38                     SEC      
E745   A5 06                  LDA   PLACE   
E747   E5 0A                  SBC   CL   
E749   48                     PHA      
E74A   A5 07                  LDA   PLACE+1   
E74C   E5 0B                  SBC   CL+1   
E74E   A8                     TAY      
E74F   68                     PLA      
E750   20 78 E1               JSR   pushay   
E753   20 1D E3               JSR   inctos   ; + 1
E756   20 56 E3               JSR   h_num   ; the column
E759   A0 0B                  LDY   #M_STK-MSG   
E75B   20 82 E3               JSR   prs   ; CR LF "D:"
E75E   8A                     TXA      
E75F   49 FF                  EOR   #0FFh   
E761   38                     SEC      
E762   E9 03                  SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
E764   48                     PHA      
E765   20 B0 E7               JSR   prnum8   
E768   68                     PLA      
E769   A0 14                  LDY   #M_C-MSG   ; ":"
E76B   C9 09                  CMP   #9   
E76D   90 04                  BCC   er3   
E76F   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E771   A0 0F                  LDY   #M_CD-MSG   
E773   85 06        ER3:      STA   T2   ; T2 = how many cells to show (the place
E775                             ;   is no longer needed)
E775   20 82 E3               JSR   prs   
E778   20 82 E1               JSR   push   ; TOS into memory with the rest: cell i from
E77B                             ;   the top is at DSL+X+i now
E77B   A5 06        ER4:      LDA   T2   ; cells T2-1 down to 0, the top last
E77D   F0 1B                  BEQ   er5   
E77F   C6 06                  DEC   T2   
E781   A9 20                  LDA   #" "   
E783   20 03 FF               JSR   CONOUT   
E786   8A                     TXA      
E787   18                     CLC      
E788   65 06                  ADC   T2   
E78A   A8                     TAY      
E78B   B9 00 02               LDA   DSL,Y   
E78E   48                     PHA      
E78F   B9 00 03               LDA   DSH,Y   
E792   A8                     TAY      
E793   68                     PLA      
E794   20 B2 E7               JSR   prnum   
E797   4C 7B E7               JMP   er4   
E79A   A0 15        ER5:      LDY   #M_RTN-MSG   
E79C   20 82 E3               JSR   prs   ; CR LF "R:"
E79F   AD 35 04               LDA   RSV   
E7A2   49 FF                  EOR   #0FFh   
E7A4   4A                     LSR      ; (FFh - S) / 2 entries
E7A5   20 B0 E7               JSR   prnum8   
E7A8   A0 09                  LDY   #M_NL-MSG   
E7AA   20 82 E3               JSR   prs   
E7AD   4C 09 FF               JMP   EXIT   
E7B0                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
E7B0                             ; prnum8: the same for A alone, 0-255.
E7B0   A0 00        PRNUM8:   LDY   #0   
E7B2   20 78 E1     PRNUM:    JSR   pushay   
E7B5   4C 56 E3               JMP   h_num   
E7B8                          ENDIF      
E7B8                             ; =============================================================================
E7B8                             ;  The fast build (SPEED = 2)
E7B8                             ; 
E7B8                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
E7B8                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
E7B8                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
E7B8                             ;  so there is no JSR and no RTS per character:
E7B8                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
E7B8                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
E7B8                             ;  The letters and digits have one entry each, which knows its cell or its
E7B8                             ;  value already; the commonest punctuation is written for the table; the
E7B8                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
E7B8                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
E7B8                             ;  and the clear carry they expect.
E7B8                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
E7B8                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
E7B8                             ;  stacks first, as next does in the other builds.
E7B8                             ;  Everything here is read-only: the image can be ROM, as the others are.
E7B8                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
E7B8                             ;  starts after it.
E7B8                             ; =============================================================================
E7B8                          IF   FAST   
                                 ; fnext: the dispatcher, after the checks of the checked build
                    FNEXT:       
E7B8                          ENDIF      
E7B8                          IF   FAST*CHECKED   
                                 ; (the same checks as next in the other checked builds)
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      
                              BCS   fn1   
                              JMP   e_rstack   
                    FN1:      CPX   #DSE+1   
                              BCC   fn3   
                              JMP   e_stack   
                    FN3:      LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E7B8                          ENDIF      
E7B8                          IF   FAST   
                              LDY   #0   
                              LDA   (IP),Y   
                              INC   IP   
                              BNE   fn4   
                              INC   IP+1   
                    FN4:      TAY      
                              LDA   DTL,Y   
                              STA   V   
                              LDA   DTH,Y   
                              STA   V+1   
                              JMP   (V)   
                                 ; fpoll: the break check of pnext, as a subroutine, for the entries that
                                 ; look at the keyboard (a word call, a true ( and a true ))
                    FPOLL:    JSR   KEY   
                              BEQ   fp9   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JMP   chk3   ; (Ctrl-C: back only if the break key is off)
                    FP9:      RTS      
                                 ; The thunks: the rest of the punctuation, through the ordinary handlers
                    FT_STR:   CLC      ; "
                              JSR   h_str   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_NUM:   CLC      ; #
                              JSR   h_num   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_PRT:   CLC      ; $
                              JSR   h_print   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_EMIT:   CLC      ; '
                              JSR   h_emit   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_DIV:   CLC      ; /
                              JSR   h_div   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_KEY:   CLC      ; ?
                              JSR   h_key   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_DEF:   CLC      ; [
                              JSR   h_def   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_BRK:   CLC      ; \
                              JSR   h_break   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_ALC:   CLC      ; _
                              JSR   h_alloc   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_GRV:   CLC      ; `
                              JSR   h_grave   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_TOR:   CLC      ; {
                              JSR   h_tor   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_FRR:   CLC      ; }
                              JSR   h_fromr   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
E7B8                          ENDIF      
E7B8                          IF   FAST*CHECKED   
                    FT_STO:   CLC      ; ! (checked: it checks the address)
                              JSR   h_store   
                              JMP   fnext   
                    FT_CST:   CLC      ; . (the same)
                              JSR   h_cstore   
                              JMP   fnext   
E7B8                          ENDIF      
E7B8                          IF   FAST   
                                 ; The commonest punctuation, written for the table
                    FS_ADD:   CLC      ; +
                              LDA   DSL,X   
                              ADC   TL   
                              STA   TL   
                              LDA   DSH,X   
                              ADC   TH   
                              STA   TH   
                              INX      
