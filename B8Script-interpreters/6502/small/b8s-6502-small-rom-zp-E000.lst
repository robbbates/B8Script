                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_RET:   PLA      ; ]
                              STA   IP   
                              PLA      
                              STA   IP+1   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
