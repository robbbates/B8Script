  1599                              <1> ;  The line editor (EDITOR = 1)
  1600                              <1> ;
  1601                              <1> ;  The interpreter starts here, and a program that ends comes back here.
  1602                              <1> ;  There is no prompt. It follows the spec's suggested standard for a line
  1603                              <1> ;  editor (docs/b8script.md, Environments), and is the Z80's editor, key for
  1604                              <1> ;  key. Type a line and press Return:
  1605                              <1> ;
  1606                              <1> ;    n text    put the text in as line n; the lines from n on move down. A
  1607                              <1> ;              number past the end (or 0) adds the line at the end.
  1608                              <1> ;    n         take line n out
  1609                              <1> ;    anything else is run at once, as B8Script. (Start such a line with a
  1610                              <1> ;    space if it would begin with a digit.)
  1611                              <1> ;
  1612                              <1> ;  A command key ends the line too, and takes what was typed as its argument:
  1613                              <1> ;
  1614                              <1> ;    ^G        run the program
  1615                              <1> ;    n ^L      list from line n (no number: all of it). Any key holds the
  1616                              <1> ;              list until another key is pressed; Ctrl-C ends it.
  1617                              <1> ;    n ^E      put line n in the input line; Return puts it back, changed
  1618                              <1> ;    name ^R   read the file of that name (no name: the current one: the
  1619                              <1> ;              one from the command line, or the last one typed)
  1620                              <1> ;    name ^W   write the program to that file (no name: the current one)
  1621                              <1> ;    ^N        new: no program
  1622                              <1> ;    ^X        leave
  1623                              <1> ;
  1624                              <1> ;  Any other control key does nothing.
  1625                              <1> ;
  1626                              <1> ;  In the line: the left and right arrow keys move the cursor (^B and ^F do
  1627                              <1> ;  nothing);
  1628                              <1> ;  a character goes in at the cursor; Backspace and DEL take out the one
  1629                              <1> ;  before it; Esc drops the line (after Esc it waits 5 ms for a '[': Esc [ C
  1630                              <1> ;  and Esc [ D are right and left too). Only CR, LF, BS and printing
  1631                              <1> ;  characters are sent to the terminal.
  1632                              <1> ;
  1633                              <1> ;  Lines are counted, not numbered. A typed line holds 125 characters; the
  1634                              <1> ;  one character after a line number separates it from the text and is not
  1635                              <1> ;  stored. The text is kept as typed, each line ending in CR LF, at PROG. A
  1636                              <1> ;  file is read up to its first ^Z, and a last line with no line end is
  1637                              <1> ;  given one; it is written as it is, with no padding.
  1638                              <1> ;
  1639                              <1> ;  What lasts from one line to the next: the program, the words, the
  1640                              <1> ;  variables and the data stack (TOS is kept pushed while the editor runs).
  1641                              <1> ;  An error or a break clears both stacks. The return stack starts empty for
  1642                              <1> ;  every line.
  1643                              <1> ;
  1644                              <1> ;  Registers in the editor: EBX = the cursor, EDX = the end of the line
  1645                              <1> ;  (pointers into the line buffer); EDI is free (edit resets it).
  1646                              <1> ; =============================================================================
  1647                              <1> %if EDITOR
  1648                              <1> ; ^E: line n goes into the input line, to be changed. V_EDLN remembers
  1649                              <1> ; which line it was: Return puts the text back in its place.
  1650                              <1> cedln:  CALLP   rdnum
  1651                              <1>         xchg    eax,edx                 ; (find and V_EDLN use only the low
  1652                              <1>         push    eax                     ;   word)
  1653                              <1>         CALLP   find                    ; EDI -> the line, or the NUL
  1654                              <1>         pop     eax
  1655                              <1>         cmp     byte [edi],0
  1656                              <1>         je      .ce9
  1657                              <1>         mov     [V(v_edln)],eax
  1658                              <1>         mov     ebx,ARENA+LINEBUF
  1659                              <1> .ce1:   mov     al,[edi]                ; copy it, and show it, up to its CR
  1660                              <1>         cmp     al,13                   ;   (or LF)
  1661                              <1>         je      .ce2
  1662                              <1>         cmp     al,10
  1663                              <1>         je      .ce2
  1664                              <1>         mov     [ebx],al
  1665                              <1>         CALLP   putc
  1666                              <1>         inc     edi
  1667                              <1>         inc     ebx
  1668                              <1>         cmp     bl,0FDh                 ; (a longer line is cut at 125)
  1669                              <1>         jne     .ce1
  1670                              <1> .ce2:   mov     edx,ebx                 ; the cursor is at the line's end
  1671                              <1>         pop     eax                     ; (not back to edit: on with the line)
  1672                              <1>         jmp     ed1
  1673                              <1> .ce9:   ret
  1674                              <1> 
  1675                              <1> ; right arrow: one to the right, by printing the character there
  1676                              <1> right:  cmp     ebx,edx
  1677                              <1>         je      ed1                     ; at the end
  1678                              <1>         mov     al,[ebx]
  1679                              <1>         inc     ebx
  1680                              <1>         jmp     short lf1
  1681                              <1> 
  1682                              <1> ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
  1683                              <1> ; wait about 5 ms for a second key: after a '[' read on to the letter that
  1684                              <1> ; ends the sequence, and act on C (right) and D (left).
  1685                              <1> esc:    push    5
  1686                              <1>         pop     eax
  1687                              <1>         CALLP   waitk
  1688                              <1>         jnz     .es2
  1689                              <1>         call    fin                     ; no second key: the line is dropped
  1690                              <1>         jmp     edit
  1691                              <1> .es2:   cmp     al,'['
  1692                              <1>         jne     ed1                     ; not a sequence known here
  1693                              <1> .es3:   CALLP   ekey
  1694                              <1>         cmp     al,40h
  1695                              <1>         jb      .es3                    ; (its parameters)
  1696                              <1>         sub     al,'C'
  1697                              <1>         je      right
  1698                              <1>         dec     al                      ; 'D'?
  1699                              <1>         jne     ed1                     ; no: on into left
  1700                              <1> ; left arrow: the cursor goes one to the left
  1701                              <1> left:   cmp     bl,80h
  1702                              <1>         je      ed1                     ; at the start
  1703                              <1>         dec     ebx
  1704                              <1>         mov     al,8
  1705                              <1> lf1:    CALLP   putc
  1706                              <1>         jmp     ed1
  1707                              <1> 
  1708                              <1> ; edit0: an error or a break: both stacks are cleared, and the cursor is
  1709                              <1> ;   shown, in case the program had hidden it and could not show it again.
  1710                              <1> ; skend: a program that ended inside skip: its return address goes.
  1711                              <1> ; edend: a program that ended: TOS joins the rest of the data stack.
  1712                              <1> edit0:  mov     esp,[V(v_dstop)]
  1713                              <1>  %if CHECKED
  1714                              <1>         push    -11                     ; the report went to stderr: back to
  1715                              <1>         call    [V(iat_GetStdHandle)]   ;   stdout
  1716                              <1>         mov     [V(v_outh)],eax
  1717                              <1>         mov     ebx,esi                 ; (the report's texts moved EBX out of
  1718                              <1>  %endif                                 ;   the arena: the cell for TOS)
  1719                              <1>         mov     eax,6835323Fh           ; ESC [ ? 2 5 h: show the cursor
  1720                              <1>         call    pseq
  1721                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1722                              <1> skend:  pop     eax
  1723                              <1> edend:  push    ebx
  1724                              <1> ; edit: start a new input line.
  1725                              <1> edit:   mov     edi,RSTOP               ; the return stack is empty
  1726                              <1>         xor     eax,eax
  1727                              <1>         mov     [ARENA+HELD],ax         ; no key is held, and the break key is on
  1728                              <1>         mov     [V(v_edln)],eax         ; no line is being edited
  1729                              <1>         mov     ebx,ARENA+LINEBUF       ; EBX = the cursor,
  1730                              <1>         mov     edx,ebx                 ;   EDX = the end of the line
  1731                              <1> ed1:    CALLP   ekey
  1732                              <1>         cmp     al,7Fh
  1733                              <1>         je      bsp                     ; DEL
  1734                              <1>         cmp     al,' '
  1735                              <1>         jae     insc
  1736                              <1>         cmp     al,9
  1737                              <1>         je      insc                    ; Tab is text
  1738                              <1>         cmp     al,8
  1739                              <1>         je      bsp
  1740                              <1>         cmp     al,1Ch
  1741                              <1>         je      left                    ; the left arrow key (see waitk)
  1742                              <1>         cmp     al,1Eh
  1743                              <1>         je      right                   ; the right arrow key
  1744                              <1>         cmp     al,1Bh
  1745                              <1>         je      esc
  1746                              <1>         push    edi                     ; a command key? Look it up
  1747                              <1>         mov     edi,ckeys
  1748                              <1>         push    NCMD
  1749                              <1>         pop     ecx
  1750                              <1>         repne   scasb
  1751                              <1>         pop     edi
  1752                              <1>         jne     ed1                     ; no: the key is ignored
  1753                              <1>         push    edit                    ; the command returns to edit
  1754                              <1>         mov     eax,ebp                 ; the command's address (the high word
  1755                              <1>         mov     ax,[ctabr+ecx*2]        ;   is next's): fin returns to it
  1756                              <1>         push    eax
  1757                              <1> ; fin: end the input line: CR LF and a NUL after it, and a new line on the
  1758                              <1> ; terminal. Leaves ESI -> the line.
  1759                              <1> fin:    mov     word [edx],0A0Dh
  1760                              <1>         mov     esi,edx
  1761                              <1>         call    prl                     ; (prints the CR LF)
  1762                              <1>         mov     byte [esi],0
  1763                              <1>         mov     esi,ARENA+LINEBUF
  1764                              <1>         ret
  1765                              <1> 
  1766                              <1> ; Backspace, DEL: the character before the cursor goes. The cursor moves
  1767                              <1> ; left, the rest of the line moves down over it, and the last place (now a
  1768                              <1> ; space) is printed over along with the rest.
  1769                              <1> bsp:    cmp     bl,80h
  1770                              <1>         je      ed1                     ; at the start
  1771                              <1>         dec     ebx
  1772                              <1>         mov     al,8
  1773                              <1>         CALLP   putc
  1774                              <1>         mov     ecx,ebx
  1775                              <1> .bs1:   mov     al,[ecx+1]
  1776                              <1>         mov     [ecx],al
  1777                              <1>         inc     ecx
  1778                              <1>         cmp     ecx,edx
  1779                              <1>         jne     .bs1
  1780                              <1>         mov     byte [ecx-1],' '
  1781                              <1>         dec     edx
  1782                              <1>         jmp     short ic2
  1783                              <1> ; A character goes in at the cursor: it ripples up through the rest of the
  1784                              <1> ; line, the cursor moves on, and the rest is printed again.
  1785                              <1> insc:   cmp     dl,0FDh
  1786                              <1>         je      ed1                     ; the line is full: 125 characters
  1787                              <1>         CALLP   putc
  1788                              <1>         mov     ecx,ebx
  1789                              <1> .ic1:   xchg    al,[ecx]
  1790                              <1>         inc     ecx
  1791                              <1>         cmp     ecx,edx
  1792                              <1>         jbe     .ic1
  1793                              <1>         inc     ebx
  1794                              <1>         inc     edx
  1795                              <1>         mov     ecx,edx
  1796                              <1> ; ic2: print the line from the cursor to ECX, and bring the cursor back
  1797                              <1> ; with backspaces. Nothing at all if the cursor is at ECX.
  1798                              <1> ic2:    mov     esi,ebx
  1799                              <1> .ta1:   cmp     esi,ecx
  1800                              <1>         je      .ta2
  1801                              <1>         lodsb
  1802                              <1>         CALLP   putc
  1803                              <1>         jmp     .ta1
  1804                              <1> .ta2:   cmp     esi,ebx
  1805                              <1>         je      .ta3
  1806                              <1>         mov     al,8
  1807                              <1>         CALLP   putc
  1808                              <1>         dec     esi
  1809                              <1>         jmp     .ta2
  1810                              <1> .ta3:   jmp     ed1
  1811                              <1> 
  1812                              <1> ; ekey: wait for a key
  1813                              <1> ekey:   or      eax,-1
  1814                              <1>         JMPP    waitk
  1815                              <1> 
  1816                              <1> ; The command keys, and where each goes (after fin, which returns to the
  1817                              <1> ; command; the command returns to edit, which is under it on the stack).
  1818                              <1> ; REPNE SCASB leaves ECX = the number of keys after the one found, so the
  1819                              <1> ; table is backwards. (The addresses are kept as their low words: the code
  1820                              <1> ; is all in the one 64 KB as `next`.)
  1821                              <1> ckeys:  db      13, 7, 12, 5, 18, 23, 14, 24
  1822                              <1> NCMD    equ     $-ckeys
  1823                              <1> ctabr:  dw      exit-IB                 ; ^X
  1824                              <1>         dw      cnew-IB                 ; ^N
  1825                              <1>         dw      cwrite-IB               ; ^W
  1826                              <1>         dw      cread-IB                ; ^R
  1827                              <1>         dw      cedln-IB                ; ^E
  1828                              <1>         dw      clist-IB                ; ^L
  1829                              <1>         dw      crun-IB                 ; ^G
  1830                              <1>         dw      cret-IB                 ; Return
  1831                              <1> 
  1832                              <1> ; ^N: no program
  1833                              <1> cnew:   mov     byte [ARENA+PROG],0
  1834                              <1>         ret
  1835                              <1> 
  1836                              <1> ; delln: take line EAX out: copy everything after it down over it. Keeps ESI.
  1837                              <1> delln:  push    esi
  1838                              <1>         CALLP   find
  1839                              <1>         push    edi
  1840                              <1>         call    nxl                     ; EDI -> the next line
  1841                              <1>         mov     esi,edi
  1842                              <1>         pop     edi
  1843                              <1> .de1:   lodsb
  1844                              <1>         stosb
  1845                              <1>         test    al,al
  1846                              <1>         jnz     .de1
  1847                              <1>         pop     esi
  1848                              <1>         ret
  1849                              <1> 
  1850                              <1> ; Return. If ^E put a line here, the text goes back in its place. If not:
  1851                              <1> ; a number and text is a line to put in, a number alone a line to take out,
  1852                              <1> ; and anything else is run where it is.
  1853                              <1> cret:   push    edx                     ; the end of what was typed
  1854                              <1>         mov     eax,[V(v_edln)]
  1855                              <1>         test    eax,eax
  1856                              <1>         jz      .cr1
  1857                              <1>         push    eax
  1858                              <1>         call    delln
  1859                              <1>         pop     eax
  1860                              <1>         jmp     short ins
  1861                              <1> .cr1:   CALLP   rdnum                   ; DX = the number it starts with
  1862                              <1>         mov     eax,esi                 ; ESI's low byte is still 80h if there
  1863                              <1>         cmp     al,80h                  ;   was no number:
  1864                              <1>         je      runln                   ;   then run the line
  1865                              <1>         xchg    eax,edx
  1866                              <1>         cmp     byte [esi],13
  1867                              <1>         jne     .cr2
  1868                              <1>         pop     edx                     ; the number alone: take that line out
  1869                              <1>         jmp     delln
  1870                              <1> .cr2:   inc     esi                     ; step over the one character after it
  1871                              <1> 
  1872                              <1> ; Put the text at ESI in as line EAX: open a gap of its length there, CR
  1873                              <1> ; and LF included, and copy it in.
  1874                              <1> ins:    CALLP   find                    ; EDI -> where it goes
  1875                              <1>         pop     ecx                     ; the end of what was typed
  1876                              <1>         inc     ecx
  1877                              <1>         inc     ecx
  1878                              <1>         sub     ecx,esi                 ; the length, with its CR LF
  1879                              <1>         push    esi                     ; the text
  1880                              <1>         push    ecx                     ; its length
  1881                              <1>         push    edi                     ; where it goes
  1882                              <1>         mov     esi,edi
  1883                              <1> .in1:   lodsb                           ; find the program's NUL
  1884                              <1>         test    al,al
  1885                              <1>         jnz     .in1
  1886                              <1>         dec     esi
  1887                              <1>         mov     ecx,esi
  1888                              <1>         sub     ecx,edi
  1889                              <1>         inc     ecx                     ; the bytes to move up, NUL included
  1890                              <1>         mov     edi,esi
  1891                              <1>         add     edi,[esp+4]             ; the NUL's new place
  1892                              <1>         std
  1893                              <1>         rep     movsb                   ; move the rest of the program up
  1894                              <1>         cld
  1895                              <1>         pop     edi
  1896                              <1>         pop     ecx
  1897                              <1>         pop     esi
  1898                              <1>         rep     movsb
  1899                              <1>         ret
  1900                              <1> 
  1901                              <1> ; ^G: run the program. runln: run the typed line (ESI -> it).
  1902                              <1> crun:   mov     esi,ARENA+PROG
  1903                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1904                              <1> runln:  pop     eax                     ; (the end of what was typed)
  1905                              <1>         pop     eax                     ; (the return to edit: a program that
  1906                              <1>                                         ;   ends goes to edend)
  1907                              <1>         RUN0CODE
  1908                              <1> 
  1909                              <1> ; ^L: list from line n. EDX = the number of the line at ESI.
  1910                              <1> clist:  CALLP   rdnum                   ; DX = n, or 0 if there was none:
  1911                              <1>         movzx   eax,dx
  1912                              <1>         test    eax,eax
  1913                              <1>         jnz     .li0
  1914                              <1>         inc     eax                     ;   then from line 1
  1915                              <1> .li0:   push    eax
  1916                              <1>         CALLP   find
  1917                              <1>         pop     edx
  1918                              <1>         mov     esi,edi
  1919                              <1> .li1:   cmp     byte [esi],0
  1920                              <1>         je      .li9                    ; the end of the text
  1921                              <1>         xor     eax,eax
  1922                              <1>         CALLP   waitk
  1923                              <1>         jz      .li3                    ; no key: carry on
  1924                              <1>         cmp     al,3
  1925                              <1>         je      .li9                    ; Ctrl-C ends the list,
  1926                              <1>         CALLP   ekey                    ;   any other key holds it until the
  1927                              <1>         cmp     al,3                    ;   next (and a Ctrl-C then ends it)
  1928                              <1> .li9:   je      fi9
  1929                              <1> .li3:   push    edx
  1930                              <1>         xchg    eax,edx
  1931                              <1>         CALLP   pdec                    ; the line's number,
  1932                              <1>         mov     al,' '
  1933                              <1>         CALLP   putc                    ;   a space,
  1934                              <1>         pop     edx
  1935                              <1>         inc     edx
  1936                              <1>         call    prl                     ;   and the line
  1937                              <1>         jmp     .li1
  1938                              <1> 
  1939                              <1> ; find: EAX = a line number. Returns EDI -> that line, or -> the NUL at the
  1940                              <1> ; end of the text if there are fewer lines (or the number is 0). Keeps ESI.
  1941                              <1> find:   xchg    eax,ecx
  1942                              <1>         mov     edi,ARENA+PROG
  1943                              <1> .fi1:   dec     cx
  1944                              <1>         jz      fi9
  1945                              <1>         call    nxl
  1946                              <1>         jnz     .fi1
  1947                              <1> fi9:    ret
  1948                              <1> 
  1949                              <1> ; nxl: step EDI over one line, to just past its LF (and return not-zero),
  1950                              <1> ; or stop at the NUL that ends the text (and return zero).
  1951                              <1> nxl:    mov     al,[edi]
  1952                              <1>         test    al,al
  1953                              <1>         jz      .nx1
  1954                              <1>         inc     edi
  1955                              <1>         cmp     al,10
  1956                              <1>         jne     nxl
  1957                              <1>         test    al,al
  1958                              <1> .nx1:   ret
  1959                              <1> 
  1960                              <1> ; prl: print the line at ESI, to its LF; ESI -> just past it.
  1961                              <1> prl:    lodsb
  1962                              <1>         CALLP   putc
  1963                              <1>         cmp     al,10
  1964                              <1>         jne     prl
  1965                              <1>         ret
  1966                              <1> 
  1967                              <1> ; ^R: read the file (cread, at load). ^W: write the file (made anew, or
  1968                              <1> ; emptied first). A name typed before the key is the file's name from now
  1969                              <1> ; on. (A file that can't be made or written is not noticed: nothing is
  1970                              <1> ; written.)
  1971                              <1> cwrite: call    setname
  1972                              <1>         mov     edi,ARENA+PROG
  1973                              <1>         xor     eax,eax
  1974                              <1>         or      ecx,-1
  1975                              <1>         repne   scasb
  1976                              <1>         not     ecx
  1977                              <1>         dec     ecx                     ; the length of the text
  1978                              <1>         push    ecx
  1979                              <1>         push    eax                     ; hTemplateFile
  1980                              <1>         push    eax                     ; dwFlagsAndAttributes
  1981                              <1>         push    2                       ; CREATE_ALWAYS
  1982                              <1>         push    eax                     ; lpSecurityAttributes
  1983                              <1>         push    eax                     ; no sharing
  1984                              <1>         push    40000000h               ; GENERIC_WRITE
  1985                              <1>         push    NAMEBUF
  1986                              <1>         call    [V(iat_CreateFileA)]
  1987                              <1>         pop     ecx
  1988                              <1>         push    eax                     ; (for CloseHandle)
  1989                              <1>         push    0
  1990                              <1>         lea     edx,[V(v_cnt)]
  1991                              <1>         push    edx
  1992                              <1>         push    ecx
  1993                              <1>         push    ARENA+PROG
  1994                              <1>         push    eax
  1995                              <1>         call    [V(iat_WriteFile)]
  1996                              <1>         call    [V(iat_CloseHandle)]
  1997                              <1>         ret
  1998                              <1> 
  1999                              <1> ; setname: if a name was typed (the line does not start with its CR), it is
  2000                              <1> ; the file's name from now on, as typed (a Windows path).
  2001                              <1> setname:mov     esi,ARENA+LINEBUF
  2002                              <1>         cmp     byte [esi],13
  2003                              <1>         je      .sn2
  2004                              <1>         mov     edi,NAMEBUF
  2005                              <1> .sn1:   lodsb
  2006                              <1>         stosb
  2007                              <1>         cmp     al,13
  2008                              <1>         jne     .sn1
  2009                              <1>         mov     byte [edi-1],0          ; (the CR becomes the NUL)
  2010                              <1> .sn2:   ret
  2011                              <1> %endif
  2012                              <1> 
  2013                              <1> ; The dispatch table: each handler's distance from hbase (an error if it
  2014                              <1> ; is not in the window).
  2015                              <1> %macro  PT 1
  2016                              <1>         db      (%1-hbase) & 0FFh
  2017                              <1>         times   -((%1-hbase) > 255) db 0
  2018                              <1> %endmacro
  2019                              <1> %if FAST == 0
  2020                              <1> ptab:   PT h_store      ; !
  2020                              <2> ptab: 
  2016 0000071A 9F                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2021                              <1>         PT h_str        ; "
  2016 0000071B AB                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2022                              <1>         PT h_num        ; #
  2016 0000071C C4                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2023                              <1>         PT h_print      ; $
  2016 0000071D ED                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2024                              <1>         PT h_swap       ; %
  2016 0000071E 90                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2025                              <1>         PT h_and        ; &
  2016 0000071F 4E                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2026                              <1>         PT h_emit       ; '
  2016 00000720 BD                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2027                              <1>         PT h_open       ; (
  2016 00000721 20                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2028                              <1>         PT h_close      ; )
  2016 00000722 16                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2029                              <1>         PT h_mul        ; *
  2016 00000723 65                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2030                              <1>         PT h_add        ; +
  2016 00000724 48                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2031                              <1>         PT h_cfetch     ; ,
  2016 00000725 CD                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2032                              <1>         PT h_sub        ; -
  2016 00000726 3D                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2033                              <1>         PT h_cstore     ; .
  2016 00000727 95                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2034                              <1>         PT h_div        ; /
  2016 00000728 88                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2035                              <1>         PT h_dup        ; :
  2016 00000729 8D                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2036                              <1>         PT h_drop       ; ;
  2016 0000072A A8                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2037                              <1>         PT h_lt         ; <
  2016 0000072B 6C                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2038                              <1>         PT h_eq         ; =
  2016 0000072C 7E                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2039                              <1>         PT h_gt         ; >
  2016 0000072D 6F                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2040                              <1>         PT h_key        ; ?
  2016 0000072E DB                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2041                              <1>         PT h_fetch      ; @
  2016 0000072F 38                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2042                              <1>         PT h_def        ; [
  2016 00000730 D5                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2043                              <1>         PT h_break      ; backslash
  2016 00000731 05                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2044                              <1>         PT h_ret        ; ]
  2016 00000732 00                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2045                              <1>         PT h_xor        ; ^
  2016 00000733 5A                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2046                              <1>         PT h_alloc      ; _
  2016 00000734 D9                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2047                              <1>         PT h_grave      ; `
  2016 00000735 D7                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2048                              <1>         PT h_tor        ; {
  2016 00000736 2E                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2049                              <1>         PT h_or         ; |
  2016 00000737 54                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2050                              <1>         PT h_fromr      ; }
  2016 00000738 33                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2051                              <1>         PT h_not        ; ~
  2016 00000739 60                  <2>  db (%1-hbase) & 0FFh
  2017                              <2>  times -((%1-hbase) > 255) db 0
  2052                              <1> %else
  2053                              <1> ; =============================================================================
  2054                              <1> ;  The fast build (SPEED = 2)
  2055                              <1> ;
  2056                              <1> ;  The inner loop is a table of 256 handlers, one per character, and the
  2057                              <1> ;  dispatcher (NEXTF: MOVZX EAX,BYTE [ESI] / INC ESI / JMP [dtab+EAX*4]) is
  2058                              <1> ;  `next` and is inline at the end of the fast build's own handlers. Those
  2059                              <1> ;  are: one per letter and digit, which knows its cell or its value, and the
  2060                              <1> ;  commonest punctuation (fs_). The rest of the table is the shared
  2061                              <1> ;  handlers, which end with JMP EBP, into `next`.
  2062                              <1> ;
  2063                              <1> ;  A digit's handler pushes its value; the character after it goes through
  2064                              <1> ;  dtabd, which is dtab but for the digits: those go on with the number
  2065                              <1> ;  (fdm). (In the checked build anything else in dtabd is fdx, which goes back
  2066                              <1> ;  through `next`, for its check of the stacks once the number is read.)
  2067                              <1> ; =============================================================================
  2068                              <1> %assign i 0
  2069                              <1> %rep 10
  2070                              <1> fd%[i]: push    ebx                     ; 0-9: a number starts
  2071                              <1>         mov     ebx,ARENA+i
  2072                              <1>         NEXTD
  2073                              <1> %assign i i+1
  2074                              <1> %endrep
  2075                              <1> fdm:    imul    bx,bx,10                ; another digit (EAX = it)
  2076                              <1>         sub     al,'0'
  2077                              <1>         add     bx,ax
  2078                              <1>         NEXTD
  2079                              <1> %if CHECKED
  2080                              <1> fdx:    dec     esi                     ; the number has ended: the character
  2081                              <1>         jmp     ebp                     ;   after it goes through next
  2082                              <1> %endif
  2083                              <1> 
  2084                              <1> ; A-Z: call the word. The return address goes on the return stack, the IP
  2085                              <1> ; becomes the word's body, and the break key is looked at as at rpush.
  2086                              <1> %assign i 0
  2087                              <1> %rep 26
  2088                              <1> fu%[i]: sub     edi,4
  2089                              <1>         mov     [edi],esi
  2090                              <1>         mov     si,[ARENA+LET+2*i]
  2091                              <1>         dec     byte [V(v_pcnt)]
  2092                              <1>         jz      fpoll
  2093                              <1>         NEXTF
  2094                              <1> %assign i i+1
  2095                              <1> %endrep
  2096                              <1> fpoll:  call    pollk                   ; (one time in 256)
  2097                              <1>         jmp     ebp
  2098                              <1> 
  2099                              <1> ; a-z: push the cell's address. In the unchecked build a variable followed
  2100                              <1> ; by '@' or '!' is fetched or stored in the same step.
  2101                              <1> %assign i 0
  2102                              <1> %rep 26
  2103                              <1> %if CHECKED
  2104                              <1> fv%[i]: push    ebx
  2105                              <1>         mov     ebx,ARENA+LET+40h+2*i
  2106                              <1>         NEXTF
  2107                              <1> %else
  2108                              <1> fv%[i]: cmp     byte [esi],'@'
  2109                              <1>         jne     .v1
  2110                              <1>         push    ebx                     ; x@
  2111                              <1>         mov     bx,[ARENA+LET+40h+2*i]
  2112                              <1>         inc     esi
  2113                              <1>         NEXTF
  2114                              <1> .v1:    cmp     byte [esi],'!'
  2115                              <1>         jne     .v2
  2116                              <1>         mov     [ARENA+LET+40h+2*i],bx  ; x!
  2117                              <1>         pop     ebx
  2118                              <1>         inc     esi
  2119                              <1>         NEXTF
  2120                              <1> .v2:    push    ebx
  2121                              <1>         mov     ebx,ARENA+LET+40h+2*i
  2122                              <1>         NEXTF
  2123                              <1> %endif
  2124                              <1> %assign i i+1
  2125                              <1> %endrep
  2126                              <1> 
  2127                              <1> ; The commonest punctuation, written for the fast build (as the shared
  2128                              <1> ; handlers, but with the dispatcher inline; and '%' without XCHG with
  2129                              <1> ; memory, which is locked, and slow).
  2130                              <1> fs_add: pop     edx                     ; +
  2131                              <1>         add     bx,dx
  2132                              <1>         NEXTF
  2133                              <1> fs_sub: mov     al,[esi]                ; -
  2134                              <1>         sub     al,'0'
  2135                              <1>         cmp     al,10
  2136                              <1>         jb      negnum                  ; (a negative number)
  2137                              <1>         pop     edx
  2138                              <1>         sub     dx,bx
  2139                              <1>         mov     bx,dx
  2140                              <1>         NEXTF
  2141                              <1> fs_mul: pop     edx                     ; *
  2142                              <1>         imul    bx,dx
  2143                              <1>         NEXTF
  2144                              <1> %undef  NEXTJ
  2145                              <1> %define NEXTJ   NEXTF
  2146                              <1> fs_div: DIVCODE                         ; /
  2147                              <1> %undef  NEXTJ
  2148                              <1> %define NEXTJ   jmp ebp
  2149                              <1> fs_and: pop     edx                     ; &
  2150                              <1>         and     bx,dx
  2151                              <1>         NEXTF
  2152                              <1> fs_or:  pop     edx                     ; |
  2153                              <1>         or      bx,dx
  2154                              <1>         NEXTF
  2155                              <1> fs_xor: pop     edx                     ; ^
  2156                              <1>         xor     bx,dx
  2157                              <1>         NEXTF
  2158                              <1> fs_not: not     bx                      ; ~
  2159                              <1>         NEXTF
  2160                              <1> fs_lt:  pop     edx                     ; <  (DX = a, BX = b: carry if a < b)
  2161                              <1>         xor     dh,80h
  2162                              <1>         xor     bh,80h
  2163                              <1>         cmp     dx,bx
  2164                              <1>         sbb     bx,bx
  2165                              <1>         NEXTF
  2166                              <1> fs_gt:  pop     edx                     ; >  (carry if b < a)
  2167                              <1>         xor     dh,80h
  2168                              <1>         xor     bh,80h
  2169                              <1>         cmp     bx,dx
  2170                              <1>         sbb     bx,bx
  2171                              <1>         NEXTF
  2172                              <1> fs_eq:  pop     edx                     ; =
  2173                              <1>         sub     bx,dx
  2174                              <1>         cmp     bx,1
  2175                              <1>         sbb     bx,bx
  2176                              <1>         NEXTF
  2177                              <1> fs_dup: push    ebx                     ; :
  2178                              <1>         NEXTF
  2179                              <1> fs_drop:pop     ebx                     ; ;
  2180                              <1>         NEXTF
  2181                              <1> fs_swap:pop     edx                     ; %
  2182                              <1>         push    ebx
  2183                              <1>         mov     ebx,edx
  2184                              <1>         NEXTF
  2185                              <1> fs_fet: mov     bx,[ebx]                ; @
  2186                              <1>         NEXTF
  2187                              <1> fs_cfet:mov     bl,[ebx]                ; ,
  2188                              <1>         mov     bh,0
  2189                              <1>         NEXTF
  2190                              <1> fs_store:                               ; !
  2191                              <1> %if CHECKED
  2192                              <1>         call    chkst2
  2193                              <1> %endif
  2194                              <1>         pop     edx
  2195                              <1>         mov     [ebx],dx
  2196                              <1>         pop     ebx
  2197                              <1>         NEXTF
  2198                              <1> fs_cstore:                              ; .
  2199                              <1> %if CHECKED
  2200                              <1>         call    chkst1
  2201                              <1> %endif
  2202                              <1>         pop     edx
  2203                              <1>         mov     [ebx],dl
  2204                              <1>         pop     ebx
  2205                              <1>         NEXTF
  2206                              <1> fs_open:test    bx,bx                   ; (
  2207                              <1>         pop     ebx
  2208                              <1>         jz      .op1
  2209                              <1>         sub     edi,4                   ; the block start
  2210                              <1>         mov     [edi],esi
  2211                              <1>         dec     byte [V(v_pcnt)]
  2212                              <1>         jz      fpoll
  2213                              <1>         NEXTF
  2214                              <1> .op1:   call    skip
  2215                              <1>         NEXTF
  2216                              <1> fs_close:test   bx,bx                   ; )
  2217                              <1>         pop     ebx
  2218                              <1>         jz      .cl1
  2219                              <1>         mov     esi,[edi]               ; the block start, read where it is
  2220                              <1>         dec     byte [V(v_pcnt)]
  2221                              <1>         jz      fpoll
  2222                              <1>         NEXTF
  2223                              <1> .cl1:   add     edi,4
  2224                              <1>         NEXTF
  2225                              <1> fs_ret: mov     esi,[edi]               ; ]
  2226                              <1>         add     edi,4
  2227                              <1>         NEXTF
  2228                              <1> fs_break:test   bx,bx                   ; backslash
  2229                              <1>         pop     ebx
  2230                              <1>         jz      .br2
  2231                              <1>         call    skip
  2232                              <1>         test    al,al                   ; ')': the block start goes; ']' returns
  2233                              <1>         jz      .br1
  2234                              <1>         mov     esi,[edi]
  2235                              <1> .br1:   add     edi,4
  2236                              <1> .br2:   NEXTF
  2237                              <1> fs_tor: sub     edi,4                   ; {
  2238                              <1>         mov     [edi],ebx
  2239                              <1>         pop     ebx
  2240                              <1>         dec     byte [V(v_pcnt)]
  2241                              <1>         jz      fpoll
  2242                              <1>         NEXTF
  2243                              <1> fs_fromr:push   ebx                     ; }
  2244                              <1>         mov     ebx,[edi]
  2245                              <1>         add     edi,4
  2246                              <1>         NEXTF
  2247                              <1> fign:   NEXTF                           ; control characters, space, DEL (and
  2248                              <1>                                         ;   80h-FFh unchecked): nothing
  2249                              <1> 
  2250                              <1> ; The tables. The punctuation's handlers, by character:
  2251                              <1> %define FP_33   fs_store                ; !
  2252                              <1> %define FP_34   h_str                   ; "
  2253                              <1> %define FP_35   h_num                   ; #
  2254                              <1> %define FP_36   h_print                 ; $
  2255                              <1> %define FP_37   fs_swap                 ; %
  2256                              <1> %define FP_38   fs_and                  ; &
  2257                              <1> %define FP_39   h_emit                  ; '
  2258                              <1> %define FP_40   fs_open                 ; (
  2259                              <1> %define FP_41   fs_close                ; )
  2260                              <1> %define FP_42   fs_mul                  ; *
  2261                              <1> %define FP_43   fs_add                  ; +
  2262                              <1> %define FP_44   fs_cfet                 ; ,
  2263                              <1> %define FP_45   fs_sub                  ; -
  2264                              <1> %define FP_46   fs_cstore               ; .
  2265                              <1> %define FP_47   fs_div                  ; /
  2266                              <1> %define FP_58   fs_dup                  ; :
  2267                              <1> %define FP_59   fs_drop                 ; ;
  2268                              <1> %define FP_60   fs_lt                   ; <
  2269                              <1> %define FP_61   fs_eq                   ; =
  2270                              <1> %define FP_62   fs_gt                   ; >
  2271                              <1> %define FP_63   h_key                   ; ?
  2272                              <1> %define FP_64   fs_fet                  ; @
  2273                              <1> %define FP_91   h_def                   ; [
  2274                              <1> %define FP_92   fs_break                ; backslash
  2275                              <1> %define FP_93   fs_ret                  ; ]
  2276                              <1> %define FP_94   fs_xor                  ; ^
  2277                              <1> %define FP_95   h_alloc                 ; _
  2278                              <1> %define FP_96   h_grave                 ; `
  2279                              <1> %define FP_123  fs_tor                  ; {
  2280                              <1> %define FP_124  fs_or                   ; |
  2281                              <1> %define FP_125  fs_fromr                ; }
  2282                              <1> %define FP_126  fs_not                  ; ~
  2283                              <1> ; DENT c, after: the entry for character c in dtab (after 0) or dtabd (1)
  2284                              <1> %macro  DENT 2
  2285                              <1>  %assign c %1
  2286                              <1>  %if c >= 30h && c <= 39h
  2287                              <1>   %if %2
  2288                              <1>         dd      fdm
  2289                              <1>   %else
  2290                              <1>    %assign d c-30h
  2291                              <1>         dd      fd%[d]
  2292                              <1>   %endif
  2293                              <1>  %elif %2 && CHECKED
  2294                              <1>         dd      fdx
  2295                              <1>  %elif c == 0
  2296                              <1>         dd      endprog                 ; NUL: the end of the program
  2297                              <1>  %elif c < 21h || c == 7Fh
  2298                              <1>         dd      fign
  2299                              <1>  %elif c >= 80h
  2300                              <1>   %if CHECKED
  2301                              <1>         dd      e_hi                    ; reserved (X)
  2302                              <1>   %else
  2303                              <1>         dd      fign
  2304                              <1>   %endif
  2305                              <1>  %elif c >= 41h && c <= 5Ah
  2306                              <1>   %assign d c-41h
  2307                              <1>         dd      fu%[d]
  2308                              <1>  %elif c >= 61h && c <= 7Ah
  2309                              <1>   %assign d c-61h
  2310                              <1>         dd      fv%[d]
  2311                              <1>  %else
  2312                              <1>         dd      FP_%[c]
  2313                              <1>  %endif
  2314                              <1> %endmacro
  2315                              <1>         align   4, db 0
  2316                              <1> dtab:
  2317                              <1> %assign j 0
  2318                              <1> %rep 256
  2319                              <1>         DENT    j, 0
  2320                              <1> %assign j j+1
  2321                              <1> %endrep
  2322                              <1> dtabd:
  2323                              <1> %assign j 0
  2324                              <1> %rep 256
  2325                              <1>         DENT    j, 1
  2326                              <1> %assign j j+1
  2327                              <1> %endrep
  2328                              <1> ; sktab: for skip, 1 for the six characters that count there
  2329                              <1> sktab:
  2330                              <1> %assign j 0
  2331                              <1> %rep 256
  2332                              <1>  %if j == 0 || j == 22h || j == 28h || j == 29h || j == 5Bh || j == 5Dh
  2333                              <1>         db      1
  2334                              <1>  %else
  2335                              <1>         db      0
  2336                              <1>  %endif
  2337                              <1> %assign j j+1
  2338                              <1> %endrep
  2339                              <1> %endif
  2340                              <1> 
  2341                              <1> ; =============================================================================
  2342                              <1> ;  The imports: kernel32.dll only. An import directory entry, the import
  2343                              <1> ;  lookup table, the hint/name entries and the DLL's name; then the import
  2344                              <1> ;  address table, which the loader fills in, right below `next` (with the
  2345                              <1> ;  routine pointers after it), so that CALL [EBP+d8] reaches it.
  2346                              <1> ; =============================================================================
  2347                              <1> %macro  IMPORTS 1
  2348                              <1>         IMP     GetStdHandle
  2349                              <1>         IMP     GetConsoleMode
  2350                              <1>         IMP     SetConsoleMode
  2351                              <1>         IMP     GetCommandLineA
  2352                              <1>         IMP     CreateFileA
  2353                              <1>         IMP     ReadFile
  2354                              <1>         IMP     WriteFile
  2355                              <1> %if EDITOR
  2356                              <1>         IMP     CloseHandle             ; (a runner leaves its file open)
  2357                              <1> %endif
  2358                              <1>         IMP     WaitForMultipleObjects
  2359                              <1>         IMP     CreateWaitableTimerExW
  2360                              <1>         IMP     SetWaitableTimer
  2361                              <1>         IMP     ReadConsoleInputA
  2362                              <1>         IMP     ExitProcess
  2363                              <1> %endmacro
  2364 0000073A 00<rep 2h>          <1>         align   4, db 0
  2365 0000073C [6407C0FF]          <1> idesc:  dd      ilt-IB                  ; OriginalFirstThunk: the lookup table
  2366 00000740 00000000            <1>         dd      0                       ; TimeDateStamp
