0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-11-21). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page ($00-$09). b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  One switch, set in the EQU line below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's four-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   0/ "no"$
0000                             ;                   Stk 2: 5 0
0000                             ;                   Rtn 0
0000                             ;                 and then goes to EXIT.
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                CDOWN:    EQU   07h   ; the break check's countdown (see pnext)
0000                             ; The error report (checked) runs after the program, so it may use the zero
0000                             ; page that machine code has ($0A-$0F):
0000                P:        EQU   0Ah   ; 0A-0B the place being reported
0000                Q:        EQU   0Ch   ; 0C-0D a pointer for counting lines
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PLACE at +36, PEND at +38;
0000                             ;               and every build's: KEYBUF (the held key) at +7A, BRKOFF (the
0000                             ;               break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                RSV:      EQU   LET+35h   ; checked: S as it was before this character
0000                PLACE:    EQU   LET+36h   ; checked: the address of this character
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                LBM1:     EQU   LINEBUF-1   ; (for the error report)
0000                PROGM1:   EQU   PROG-1   
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
E003                             ; The first half of the letter page is zeroed: every variable, every
E003                             ; cell of the interpreter's own (no key held back), and every word
E003                             ; cell, which then points at 0000h: calling an undefined word stops
E003                             ; with U (see e_undef).
E003   E8                     INX      
E004   8A                     TXA      ; A = 0
E005   A0 7F                  LDY   #7Fh   
E007   99 00 04     STZ:      STA   LET,Y   
E00A   88                     DEY      
E00B   10 FA                  BPL   stz   
E00D                          ENDIF      
E00D   20 3C E2               JSR   rstip   
E010   20 30 E2     ST1:      JSR   getc   
E013   D0 FB                  BNE   st1   ; IP ends just past the NUL
E015                          IF   1-CHECKED   
                              STA   KEYBUF   ; (A = 0) no key held, the break key on
                              STA   BRKOFF   
E015                          ENDIF      
E015   A5 00                  LDA   IP   
E017   8D 7C 04               STA   HEAP   
E01A                          IF   CHECKED   
E01A   8D 38 04               STA   PEND   
E01D                          ENDIF      
E01D   A5 01                  LDA   IP+1   
E01F   8D 7D 04               STA   HEAP+1   
E022                          IF   CHECKED   
E022   8D 39 04               STA   PEND+1   
E025                          ENDIF      
E025   20 3C E2               JSR   rstip   
E028   A2 FC                  LDX   #DSE   
E02A                             ; =============================================================================
E02A                             ;  The inner loop
E02A                             ; =============================================================================
E02A                             ; -----------------------------------------------------------------------------
E02A                             ;  The break key. A running program reads the keyboard only through getk
E02A                             ;  (for "?") and pnext (the break check), which between them give the break
E02A                             ;  key its rules:
E02A                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E02A                             ;      build, with the report (B) in the checked one;
E02A                             ;    - any other key that the break check reads is held in KEYBUF for the
E02A                             ;      next "?", and a newer one takes its place;
E02A                             ;    - "?" (getk) takes the held key first;
E02A                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E02A                             ;      key like any other, but two of them within about 250 ms still stop it.
E02A                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E02A                             ; -----------------------------------------------------------------------------
E02A                             ; pnext: the break check, then (falling through) next. A word call, a true
E02A                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E02A                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E02A                             ; falls in here too, which does no harm.)
E02A   C6 07        PNEXT:    DEC   CDOWN   
E02C   D0 0F                  BNE   next   
E02E   20 06 FF               JSR   KEY   
E031   F0 0A                  BEQ   next   ; no key
E033   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E036   C9 03                  CMP   #3   
E038   D0 03                  BNE   next   
E03A   20 7C E5               JSR   ctlc   ; (it comes back only if the break key is off)
E03D                NEXT:        
E03D                          IF   CHECKED   
E03D                             ; Both stacks are checked once per character, after it has run. The
E03D                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E03D                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E03D                             ; more than one entry). The data stack has when X is above DSE: an
E03D                             ; underflow moves X up to FDh or FEh (no handler moves X by more
E03D                             ; than 2), and an overflow wraps it from 00h to FFh.
E03D                             ; S is kept in RSV, for the report's Rtn line (an error found inside
E03D                             ; a handler has its own calls on the hardware stack), and the place
E03D                             ; of the character about to run in PLACE.
E03D   8A                     TXA      ; TSX trashes X: keep it in A
E03E   BA                     TSX      
E03F   8E 35 04               STX   RSV   
E042   E0 20                  CPX   #RSLIM   
E044   AA                     TAX      ; TAX leaves the carry alone
E045   90 71                  BCC   e_rstack   
E047   E0 FD                  CPX   #DSE+1   
E049   B0 7F                  BCS   e_stack   
E04B   A5 00                  LDA   IP   
E04D   8D 36 04               STA   PLACE   
E050   A5 01                  LDA   IP+1   
E052   8D 37 04               STA   PLACE+1   
E055                          ENDIF      
E055   20 5B E0               JSR   step   
E058   4C 3D E0               JMP   next   
E05B                             ; step: read one character and sort it by range.
E05B                             ;    00h          end of program
E05B                             ;    01h-20h, 7Fh-FFh   ignored
E05B                             ;    30h-39h      digit: read a whole number
E05B                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E05B                             ;    61h-7Ah      a-z: push the address of that letter's cell
E05B                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E05B                             ; Every way out of the sort has the carry clear, except "ignored". A checked
E05B                             ; build stops on 80h-FFh (X) and still ignores DEL.
E05B   20 30 E2     STEP:     JSR   getc   ; flags follow A
E05E   F0 38                  BEQ   endprog   
E060   38                     SEC      
E061   E9 21                  SBC   #21h   ; A = c - 21h
E063   90 32                  BCC   ign   ; 01h-20h
E065   C9 0F                  CMP   #0Fh   
E067   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E069   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E06B   C9 0A                  CMP   #10   
E06D   90 70                  BCC   digit   
E06F   C9 11                  CMP   #11h   
E071   90 18                  BCC   p3a   ; 3Ah-40h
E073   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E075   C9 1A                  CMP   #1Ah   
E077   90 61                  BCC   upper   ; 41h-5Ah
E079   C9 20                  CMP   #20h   
E07B   90 0C                  BCC   p5b   ; 5Bh-60h
E07D   C9 3A                  CMP   #3Ah   
E07F   90 66                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E081   C9 3E                  CMP   #3Eh   
E083                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E083                          ENDIF      
E083                          IF   CHECKED   
E083   F0 12                  BEQ   ign   ; 7Fh
E085   B0 4E                  BCS   e_resv   ; 80h-FFh: reserved
E087                          ENDIF      
E087                             ; The three adjustments below chain. Each ADC adds the carry the one
E087                             ; before it left, which the constants allow for.
E087   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E089   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E08B   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E08D   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E08E   A8                     TAY      
E08F   B9 B6 E1               LDA   PTAB+1,Y   
E092   48                     PHA      
E093   B9 B5 E1               LDA   PTAB,Y   
E096   48                     PHA      
E097   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E098                             ; directly, it just ends an ignored character.
E098                ENDPROG:      
E098                          IF   CHECKED   
E098   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E09A   F0 03                  BEQ   e_undef   
E09C                          ENDIF      
E09C   4C 09 FF               JMP   EXIT   
E09F                          IF   CHECKED   
E09F                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E09F                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E09F                             ; the call reads a NUL with IP in page zero, where no program can be. The
E09F                             ; call is undone first: the step frame and the return address come off the
E09F                             ; hardware stack, and the place is the call letter (the return address - 1).
E09F   68           E_UNDEF:   PLA      
E0A0   68                     PLA      ; the step frame
E0A1   68                     PLA      
E0A2   38                     SEC      
E0A3   E9 01                  SBC   #1   
E0A5   8D 36 04               STA   PLACE   
E0A8   68                     PLA      
E0A9   E9 00                  SBC   #0   
E0AB   8D 37 04               STA   PLACE+1   
E0AE   EE 35 04               INC   RSV   
E0B1   EE 35 04               INC   RSV   ; Rtn does not count the call
E0B4   A9 55                  LDA   #"U"   
E0B6   D0 1F                  BNE   ejmp   ; always
E0B8                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E0B8                             ; empty.
E0B8   AD 35 04     E_RSTACK:   LDA   RSV   
E0BB   C9 10                  CMP   #10h   
E0BD   A9 52                  LDA   #"R"   
E0BF   B0 16                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E0C1   A9 FF                  LDA   #0FFh   
E0C3   8D 35 04               STA   RSV   ; S wrapped to 01h: Rtn 0
E0C6   A9 72                  LDA   #"r"   
E0C8   D0 0D                  BNE   ejmp   ; always
E0CA   E0 FF        E_STACK:   CPX   #0FFh   
E0CC   A9 53                  LDA   #"S"   
E0CE   B0 07                  BCS   ejmp   ; X wrapped from 00h to FFh: an overflow
E0D0   A2 FC                  LDX   #DSE   ; an underflow: Stk 0
E0D2   A9 73                  LDA   #"s"   
E0D4   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E0D5   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E0D7   4C A0 E5     EJMP:     JMP   error   
E0DA                          ENDIF      
E0DA                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E0DA                             ; the return stack, and the IP becomes the address in the letter's cell.
E0DA   0A           UPPER:    ASL      
E0DB   A8                     TAY      
E0DC   38                     SEC      
E0DD   B0 2C                  BCS   pushn   ; always
E0DF                             ; Digits: the first one is in A; read the rest of the number.
E0DF   A0 00        DIGIT:    LDY   #0   
E0E1   20 F0 E0               JSR   pushay   
E0E4   4C 1C E2               JMP   rdnum   
E0E7                             ; a-z: push the cell's address (the cell is the variable)
E0E7   0A           LOWER:    ASL      
E0E8   A0 04                  LDY   #>LET   
E0EA   D0 04                  BNE   pushay   ; always
E0EC   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E0EE   A4 01                  LDY   IP+1   
E0F0                             ; pushay: push a cell: A = its low byte, Y = its high byte
E0F0   48           PUSHAY:   PHA      
E0F1   20 FA E0               JSR   push   
E0F4   68                     PLA      
E0F5   85 02                  STA   TL   
E0F7   84 03                  STY   TH   
E0F9   60                     RTS      
E0FA   CA           PUSH:     DEX      ; ":" and every push (keeps Y)
E0FB   A5 02                  LDA   TL   
E0FD   9D 00 02               STA   DSL,X   
E100   A5 03                  LDA   TH   
E102   9D 00 03               STA   DSH,X   
E105   60                     RTS      
E106                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E106                             ; the matching ")".
E106   20 45 E2     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E109                          IF   1-CHECKED   
                              BEQ   skip   
E109                          ENDIF      
E109                          IF   CHECKED   
E109   F0 27                  BEQ   skpar   
E10B                          ENDIF      
E10B                             ; pushn: take the step frame off, push the reading position on the return
E10B                             ; stack, and go on. With the carry set (a word call) the reading position
E10B                             ; then becomes the address in the letter cell at LET,Y.
E10B   68           PUSHN:    PLA      
E10C   68                     PLA      ; drop the step frame
E10D   A5 01                  LDA   IP+1   
E10F   48                     PHA      
E110   A5 00                  LDA   IP   
E112   48                     PHA      
E113   90 0A                  BCC   nxt   
E115   B9 00 04               LDA   LET,Y   
E118   85 00                  STA   IP   
E11A   B9 01 04               LDA   LET+1,Y   
E11D   85 01                  STA   IP+1   
E11F   4C 2A E0     NXT:      JMP   pnext   
E122                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E122                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E122                             ; the body"s address instead. Either way it then skips to the matching "]'.
E122                             ; (The unchecked build takes anything that is not a letter as the space; the
E122                             ; checked build stops on it.)
E122                          IF   CHECKED   
E122   C0 DF        DEF1:     CPY   #" "-"A"+256   
E124   F0 2C                  BEQ   def2   
E126                             ; W: anything but a letter or a space after [. The place is that character,
E126                             ; one past the [.
E126   EE 36 04               INC   PLACE   
E129   D0 03                  BNE   eb1   
E12B   EE 37 04               INC   PLACE+1   
E12E   A9 57        EB1:      LDA   #"W"   
E130   D0 A5                  BNE   ejmp   ; always
E132                             ; A false ( skips: the wrong closer for it is ].
E132   A9 5D        SKPAR:    LDA   #"]"   
E134   D0 21                  BNE   skip   ; always
E136                          ENDIF      
E136   20 30 E2     H_DEF:    JSR   getc   
E139   38                     SEC      
E13A   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E13C   A8                     TAY      ;   lands 64 bytes up
E13D   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E13F   C9 1A                  CMP   #26   
E141                          IF   1-CHECKED   
                              BCS   def2   ; not a letter
E141                          ENDIF      
E141                          IF   CHECKED   
E141   B0 DF                  BCS   def1   
E143                          ENDIF      
E143   98                     TYA      
E144   0A                     ASL      
E145   A8                     TAY      ; Y -> the cell
E146   A5 00                  LDA   IP   
E148   99 00 04               STA   LET,Y   
E14B   A5 01                  LDA   IP+1   
E14D   99 01 04               STA   LET+1,Y   
E150   D0 03                  BNE   skdef   ; always: no program is in page zero
E152   20 EC E0     DEF2:     JSR   puship   ; an anonymous block: push its address
E155                SKDEF:       
E155                          IF   CHECKED   
E155   A9 29                  LDA   #")"   ; the wrong closer for [
E157                          ENDIF      
E157                             ; skip: read past text to the closer at this level, and return it in A.
E157                             ; Brackets of both kinds count together; strings are stepped over whole. A
E157                             ; NUL first ends the program.
E157                             ; In the checked build A holds, on the way in, the wrong closer for the
E157                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E157                             ; which takes either. Meeting the wrong closer at this level, or the end
E157                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E157                             ; which then ends the program as before.
E157                SKIP:        
E157                          IF   CHECKED   
E157   85 04                  STA   T0   
E159                          ENDIF      
E159   A9 00                  LDA   #0   
E15B   85 06                  STA   T2   ; depth
E15D   20 30 E2     SK1:      JSR   getc   
E160                          IF   1-CHECKED   
                              BEQ   endprog   
E160                          ENDIF      
E160                          IF   CHECKED   
E160   F0 26                  BEQ   sknul   
E162                          ENDIF      
E162   C9 22                  CMP   #22h   
E164   D0 05                  BNE   sk2   
E166   20 A0 E1               JSR   skipstr   ; leaves A = 22h (11h when checked), which
E169                             ;   matches nothing below
E169                          IF   CHECKED   
E169   F0 1D                  BEQ   sknul   ; the string ran into the end
E16B                          ENDIF      
E16B   C9 28        SK2:      CMP   #"("   
E16D   F0 15                  BEQ   sk3   
E16F   C9 5B                  CMP   #"["   
E171   F0 11                  BEQ   sk3   
E173   C9 29                  CMP   #")"   
E175   F0 04                  BEQ   sk4   
E177   C9 5D                  CMP   #"]"   
E179   D0 E2                  BNE   sk1   
E17B   C6 06        SK4:      DEC   T2   
E17D   10 DE                  BPL   sk1   
E17F                          IF   CHECKED   
E17F   C5 04                  CMP   T0   
E181   F0 0C                  BEQ   e_nest   ; the wrong kind
E183                          ENDIF      
E183   60                     RTS      ; the closer at this level
E184   E6 06        SK3:      INC   T2   
E186   D0 D5                  BNE   sk1   
E188                          IF   CHECKED   
E188   A5 04        SKNUL:    LDA   T0   
E18A   D0 03                  BNE   e_nest   ; ( and [ stop with N
E18C   4C 09 FF               JMP   EXIT   ; \ ends the program
E18F   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E191   2C                     DB   2Ch   ;   or the end: the place is the opener
E192   A9 51        E_QUOTE:   LDA   #"Q"   ; a string from 22h runs into the end
E194   4C A0 E5               JMP   error   
E197                          ENDIF      
E197                             ; 22h pushes the address of the text after it and skips the string.
E197   20 EC E0     H_STR:    JSR   puship   
E19A                          IF   CHECKED   
E19A   20 A0 E1               JSR   skipstr   
E19D   F0 F3                  BEQ   e_quote   ; it ran into the end: the place is the 22h
E19F   60                     RTS      
E1A0                          ENDIF      
E1A0                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E1A0                             ; the next character, so "/"" does not end it.
E1A0                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E1A0                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E1A0                             ; text ended first (a NUL, also one just after "/").
E1A0                          IF   1-CHECKED   
                    SKIPSTR:   JSR   getc   
                              CMP   #"/"   
                              BEQ   ss0   
                              CMP   #22h   
                              BNE   skipstr   
                              RTS      
                    SS0:      JSR   incip   
                              BNE   skipstr   ; A is "/" here
E1A0                          ENDIF      
E1A0                          IF   CHECKED   
E1A0   20 30 E2     SKIPSTR:   JSR   getc   
E1A3   F0 09                  BEQ   ss9   ; the end
E1A5   C9 2F                  CMP   #"/"   
E1A7   D0 06                  BNE   ss1   
E1A9   20 30 E2               JSR   getc   ; the escaped character
E1AC   D0 F2                  BNE   skipstr   
E1AE   60           SS9:      RTS      ; the end, just after "/"
E1AF   C9 22        SS1:      CMP   #22h   
E1B1   D0 ED                  BNE   skipstr   
E1B3   4A                     LSR      ; A = 11h, Z clear
E1B4   60                     RTS      
E1B5                          ENDIF      
E1B5                             ; =============================================================================
E1B5                             ;  Dispatch table: one handler per punctuation character, in code order.
E1B5                             ;  Entries are handler-1 for the RTS trick.
E1B5                             ; =============================================================================
E1B5   4D E2        PTAB:     DW   h_store-1   ; !
E1B7   96 E1                  DW   h_str-1   ; "
E1B9   7D E4                  DW   h_num-1   ; #
E1BB   4A E4                  DW   h_print-1   ; $
E1BD   6B E3                  DW   h_swap-1   ; %
E1BF   C0 E2                  DW   h_and-1   ; &
E1C1   75 E4                  DW   h_emit-1   ; '
E1C3   05 E1                  DW   h_open-1   ; (
E1C5   93 E2                  DW   h_close-1   ; )
E1C7   43 E3                  DW   h_mul-1   ; *
E1C9   F2 E2                  DW   h_add-1   ; +
E1CB   B8 E4                  DW   h_cfetch-1   ; ,
E1CD   EA E2                  DW   h_sub-1   ; -
E1CF   5F E2                  DW   h_cstore-1   ; .
E1D1   85 E3                  DW   h_div-1   ; /
E1D3   F9 E0                  DW   push-1   ; :
E1D5   6C E2                  DW   drop-1   ; ;
E1D7   21 E3                  DW   h_lt-1   ; <
E1D9   33 E3                  DW   h_eq-1   ; =
E1DB   1E E3                  DW   h_gt-1   ; >
E1DD   C1 E4                  DW   h_key-1   ; ?
E1DF   AC E4                  DW   h_fetch-1   ; @
E1E1   35 E1                  DW   h_def-1   ; [
E1E3   AB E2                  DW   h_break-1   ; \
E1E5   99 E2                  DW   h_ret-1   ; ]
E1E7   DC E2                  DW   h_xor-1   ; ^
E1E9   F9 E3                  DW   h_alloc-1   ; _
E1EB   22 E5                  DW   h_grave-1   ; `
E1ED   78 E2                  DW   h_tor-1   ; {
E1EF   CE E2                  DW   h_or-1   ; |
E1F1   85 E2                  DW   h_fromr-1   ; }
E1F3   0A E3                  DW   h_not-1   ; ~
E1F5                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E1F5                             ; test is at the bottom so the loop closes with a branch. Returns with the
E1F5                             ; carry set.
E1F5   20 33 E2     RD1:      JSR   incip   ; (keeps A = the digit)
E1F8   06 02                  ASL   TL   
E1FA   26 03                  ROL   TH   ; x2
E1FC   18                     CLC      
E1FD   65 02                  ADC   TL   
E1FF   85 04                  STA   T0   
E201   A5 03                  LDA   TH   
E203   69 00                  ADC   #0   
E205   85 05                  STA   T1   ; T = x2 + digit
E207   06 02                  ASL   TL   
E209   26 03                  ROL   TH   
E20B   06 02                  ASL   TL   
E20D   26 03                  ROL   TH   ; x8
E20F   18                     CLC      
E210   A5 02                  LDA   TL   
E212   65 04                  ADC   T0   
E214   85 02                  STA   TL   
E216   A5 03                  LDA   TH   
E218   65 05                  ADC   T1   
E21A   85 03                  STA   TH   ; x8 + x2 + digit
E21C   20 22 E2     RDNUM:    JSR   isdig   
E21F   90 D4                  BCC   rd1   
E221   60                     RTS      
E222                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E222                             ; digit. Y = 0.
E222   20 2B E2     ISDIG:    JSR   peek   
E225   38                     SEC      
E226   E9 30                  SBC   #"0"   
E228   C9 0A                  CMP   #10   
E22A   60                     RTS      
E22B                             ; =============================================================================
E22B                             ;  Reading the program
E22B                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E22B                             ;    getc: the same, then IP moves on; flags follow A
E22B                             ;    incip: IP moves on; keeps A, the carry and Y
E22B                             ; =============================================================================
E22B   A0 00        PEEK:     LDY   #0   
E22D   B1 00                  LDA   (IP),Y   
E22F   60                     RTS      
E230   20 2B E2     GETC:     JSR   peek   
E233   E6 00        INCIP:    INC   IP   
E235   D0 02                  BNE   ic1   
E237   E6 01                  INC   IP+1   
E239   09 00        IC1:      ORA   #0   
E23B   60                     RTS      
E23C                             ; rstip: point IP at the start of the program
E23C   A9 00        RSTIP:    LDA   #<PROG   
E23E   85 00                  STA   IP   
E240   A9 05                  LDA   #>PROG   
E242   85 01                  STA   IP+1   
E244   60                     RTS      
E245                             ; =============================================================================
E245                             ;  Stack
E245                             ; =============================================================================
E245                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E245   A5 02        FLAG:     LDA   TL   
E247   05 03                  ORA   TH   
E249   20 6D E2               JSR   drop   
E24C   A8                     TAY      ; (drop's INX changed the flags)
E24D   60                     RTS      
E24E                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E24E                H_STORE:      
E24E                          IF   CHECKED   
E24E   A5 02                  LDA   TL   ; both bytes must be in the program's space:
E250   69 01                  ADC   #1   ; check the page of addr+1 (the carry is
E252   A5 03                  LDA   TH   ; clear on the way in)
E254   69 00                  ADC   #0   
E256   20 37 E4               JSR   chkst   
E259                          ENDIF      
E259   BD 00 03               LDA   DSH,X   
E25C   A0 01                  LDY   #1   
E25E   91 02                  STA   (TL),Y   
E260                H_CSTORE:      ; "." ( c addr -- )
E260                          IF   CHECKED   
E260   A5 03                  LDA   TH   
E262   20 37 E4               JSR   chkst   
E265                          ENDIF      
E265   BD 00 02               LDA   DSL,X   
E268   A0 00                  LDY   #0   
E26A   91 02                  STA   (TL),Y   
E26C   E8                     INX      ; falls into drop
E26D                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E26D                             ; it returns with Z clear.
E26D   BC 00 02     DROP:     LDY   DSL,X   
E270   84 02                  STY   TL   
E272   BC 00 03               LDY   DSH,X   
E275   84 03                  STY   TH   
E277   E8                     INX      
E278   60                     RTS      
E279                             ; "{" TOS to the return stack, "}" return stack to TOS
E279   68           H_TOR:    PLA      
E27A   68                     PLA      
E27B   A5 03                  LDA   TH   
E27D   48                     PHA      
E27E   A5 02                  LDA   TL   
E280   48                     PHA      
E281   20 6D E2               JSR   drop   
E284   D0 0B                  BNE   nxt2   ; always
E286   68           H_FROMR:   PLA      
E287   68                     PLA      
E288   20 FA E0               JSR   push   
E28B   68                     PLA      
E28C   85 02                  STA   TL   
E28E   68                     PLA      
E28F   85 03                  STA   TH   
E291   4C 3D E0     NXT2:     JMP   next   
E294                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E294                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E294                             ; it is here, the address popped is pushed back.
E294   20 45 E2     H_CLOSE:   JSR   flag   
E297   F0 21                  BEQ   rdrop   
E299   24                     DB   24h   ; (BIT zp: steps over the SEC)
E29A                             ; "]" returns: pull an address and jump to it.
E29A   38           H_RET:    SEC      
E29B   68                     PLA      
E29C   68                     PLA      ; drop the step frame
E29D   68                     PLA      
E29E   85 00                  STA   IP   
E2A0   68                     PLA      
E2A1   85 01                  STA   IP+1   
E2A3   B0 EC                  BCS   nxt2   
E2A5   48                     PHA      ; ")": keep the block start
E2A6   A5 00                  LDA   IP   
E2A8   48                     PHA      
E2A9   4C 2A E0               JMP   pnext   ; a loop-back: the break check
E2AC                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E2AC                             ; drops the block start, "]" returns.
E2AC   20 45 E2     H_BREAK:   JSR   flag   
E2AF   F0 6D                  BEQ   ab9   
E2B1                          IF   CHECKED   
E2B1   A9 00                  LDA   #0   ; \ takes either closer
E2B3                          ENDIF      
E2B3   20 57 E1               JSR   skip   
E2B6   C9 29                  CMP   #")"   
E2B8   D0 E0                  BNE   h_ret   
E2BA   68           RDROP:    PLA      
E2BB   68                     PLA      
E2BC   68                     PLA      
E2BD   68                     PLA      
E2BE   4C 3D E0               JMP   next   
E2C1                             ; =============================================================================
E2C1                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E2C1                             ; =============================================================================
E2C1                             ; The logic operators leave the carry as they found it, clear, so they can
E2C1                             ; branch to fin.
E2C1   BD 00 02     H_AND:    LDA   DSL,X   
E2C4   25 02                  AND   TL   
E2C6   85 02                  STA   TL   
E2C8   BD 00 03               LDA   DSH,X   
E2CB   25 03                  AND   TH   
E2CD   90 31                  BCC   fin   ; always
E2CF   BD 00 02     H_OR:     LDA   DSL,X   
E2D2   05 02                  ORA   TL   
E2D4   85 02                  STA   TL   
E2D6   BD 00 03               LDA   DSH,X   
E2D9   05 03                  ORA   TH   
E2DB   90 23                  BCC   fin   ; always
E2DD   BD 00 02     H_XOR:    LDA   DSL,X   
E2E0   45 02                  EOR   TL   
E2E2   85 02                  STA   TL   
E2E4   BD 00 03               LDA   DSH,X   
E2E7   45 03                  EOR   TH   
E2E9   90 15                  BCC   fin   ; always
E2EB                             ; "-" has two jobs: directly before a digit it starts a negative number.
E2EB   20 22 E2     H_SUB:    JSR   isdig   
E2EE   90 14                  BCC   negnum   
E2F0   20 11 E3     SUB1:     JSR   neg   ; a - b = a + (-b)
E2F3   18           H_ADD:    CLC      
E2F4   BD 00 02               LDA   DSL,X   
E2F7   65 02                  ADC   TL   
E2F9   85 02                  STA   TL   
E2FB   BD 00 03               LDA   DSH,X   
E2FE   65 03                  ADC   TH   ; falls into fin
E300                             ; fin: finish a two-operand op: A = the high byte of the result
E300   85 03        FIN:      STA   TH   
E302   E8                     INX      
E303   60                     RTS      
E304   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E306   20 DF E0               JSR   digit   ; (comes back with the carry set)
E309   B0 06                  BCS   neg   ; always: the number, negated
E30B                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E30B   90 05        H_NOT:    BCC   neg1   ; always
E30D                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E30D   A5 03        ABSV:     LDA   TH   
E30F   10 0D        NEGM:     BPL   ab9   
E311                             ; neg: TOS = -TOS
E311   38           NEG:      SEC      
E312   A9 00        NEG1:     LDA   #0   
E314   E5 02                  SBC   TL   
E316   85 02                  STA   TL   
E318   A9 00                  LDA   #0   
E31A   E5 03                  SBC   TH   
E31C   85 03                  STA   TH   
E31E   60           AB9:      RTS      
E31F                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E31F                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E31F   20 6C E3     H_GT:     JSR   h_swap   ; a > b is b < a
E322   BD 00 02     H_LT:     LDA   DSL,X   
E325   C5 02                  CMP   TL   
E327   BD 00 03               LDA   DSH,X   
E32A   E5 03                  SBC   TH   
E32C   70 02                  BVS   lt1   
E32E   49 80                  EOR   #80h   
E330   0A           LT1:      ASL      
E331   E8                     INX      ; (keeps the carry; never leaves X at 0)
E332   D0 07                  BNE   bool   ; always
E334   20 F0 E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E337   05 02                  ORA   TL   
E339   C9 01                  CMP   #1   ; carry clear if A = 0
E33B   A9 00        BOOL:     LDA   #0   
E33D   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E33F   85 02                  STA   TL   
E341   85 03                  STA   TH   
E343   60                     RTS      
E344                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E344                             ; bottom while the product comes in at the top, through A:T0 above it; after
E344                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E344   A0 10        H_MUL:    LDY   #16   
E346   84 05                  STY   T1   ; the round count
E348   A9 00                  LDA   #0   
E34A   85 04                  STA   T0   ; A:T0 = the upper half
E34C   46 03                  LSR   TH   
E34E   66 02                  ROR   TL   ; the first multiplier bit
E350   90 0D        ML1:      BCC   ml2   
E352   A8                     TAY      
E353   18                     CLC      
E354   A5 04                  LDA   T0   
E356   7D 00 02               ADC   DSL,X   
E359   85 04                  STA   T0   
E35B   98                     TYA      
E35C   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E35F   6A           ML2:      ROR      
E360   66 04                  ROR   T0   
E362   66 03                  ROR   TH   
E364   66 02                  ROR   TL   ; everything one place right; next bit out
E366   C6 05                  DEC   T1   
E368   D0 E6                  BNE   ml1   
E36A   E8                     INX      ; drop the multiplicand
E36B   60                     RTS      
E36C   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E36F   A5 02                  LDA   TL   
E371   9D 00 02               STA   DSL,X   
E374   84 02                  STY   TL   
E376   BC 00 03               LDY   DSH,X   
E379   A5 03                  LDA   TH   
E37B   9D 00 03               STA   DSH,X   
E37E   84 03                  STY   TH   
E380   60                     RTS      
E381                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E381                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E381                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E381                             ; it stops with Z.
E381                          IF   CHECKED   
E381   A9 5A        E_ZERO:   LDA   #"Z"   ; divide by zero, the stack as it was
E383   4C A0 E5               JMP   error   
E386                          ENDIF      
E386                H_DIV:       
E386                          IF   CHECKED   
E386   A5 02                  LDA   TL   
E388   05 03                  ORA   TH   
E38A   F0 F5                  BEQ   e_zero   
E38C                          ENDIF      
E38C   BD 00 03               LDA   DSH,X   
E38F   48                     PHA      ; a's sign: for r
E390   45 03                  EOR   TH   
E392   48                     PHA      ; a xor b: for q
E393   20 0D E3               JSR   absv   
E396   A5 02                  LDA   TL   
E398   85 08                  STA   D0   
E39A   A5 03                  LDA   TH   
E39C   85 09                  STA   D1   ; D = |b|
E39E   BD 00 02               LDA   DSL,X   
E3A1   85 02                  STA   TL   
E3A3   BD 00 03               LDA   DSH,X   
E3A6   85 03                  STA   TH   
E3A8   20 0D E3               JSR   absv   ; TOS = |a|
E3AB   20 B9 E3               JSR   udiv   ; TOS = q, NOS = r
E3AE   68                     PLA      
E3AF   20 0F E3               JSR   negm   ; q's sign
E3B2   20 6C E3               JSR   h_swap   ; r on top
E3B5   68                     PLA      
E3B6   4C 0F E3               JMP   negm   ; r's sign
E3B9                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E3B9                             ; cell the remainder (whatever was there is lost).
E3B9                             ; Dividing by 2 is one shift (the spec wants that fast).
E3B9   A9 00        UDIV:     LDA   #0   
E3BB   9D 00 02               STA   DSL,X   
E3BE   9D 00 03               STA   DSH,X   
E3C1   A5 08                  LDA   D0   
E3C3   49 02                  EOR   #2   
E3C5   05 09                  ORA   D1   
E3C7   D0 08                  BNE   ud0   
E3C9   46 03                  LSR   TH   
E3CB   66 02                  ROR   TL   ; the quotient
E3CD   3E 00 02               ROL   DSL,X   ; the remainder: the bit that fell out
E3D0   60                     RTS      
E3D1   A0 10        UD0:      LDY   #16   
E3D3   06 02        UD1:      ASL   TL   
E3D5   26 03                  ROL   TH   
E3D7   3E 00 02               ROL   DSL,X   
E3DA   3E 00 03               ROL   DSH,X   
E3DD   38                     SEC      
E3DE   BD 00 02               LDA   DSL,X   
E3E1   E5 08                  SBC   D0   
E3E3   85 04                  STA   T0   
E3E5   BD 00 03               LDA   DSH,X   
E3E8   E5 09                  SBC   D1   
E3EA   90 0A                  BCC   ud2   
E3EC   9D 00 03               STA   DSH,X   
E3EF   A5 04                  LDA   T0   
E3F1   9D 00 02               STA   DSL,X   
E3F4   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E3F6   88           UD2:      DEY      
E3F7   D0 DA                  BNE   ud1   
E3F9   60           UD9:      RTS      
E3FA                             ; =============================================================================
E3FA                             ;  Storage
E3FA                             ; =============================================================================
E3FA                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E3FA                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E3FA                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   TL   
                              STA   HEAP   
                              STY   TL   
                              LDA   HEAP+1   
                              TAY      
                              ADC   TH   
                              STA   HEAP+1   
                              STY   TH   
                              RTS      
E3FA                          ENDIF      
E3FA                             ; The checked build works the new top out first, in T0 and Y, and stops with
E3FA                             ; H, the count still on the stack, if it is at or past the limit, below the
E3FA                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E3FA                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E3FA                             ; a signed number from -8000h, so the add overflows exactly when the true
E3FA                             ; sum leaves 0000h-FFFFh.
E3FA                          IF   CHECKED   
E3FA   AD 7C 04     H_ALLOC:   LDA   HEAP   
E3FD   65 02                  ADC   TL   
E3FF   85 04                  STA   T0   
E401   AD 7D 04               LDA   HEAP+1   
E404   49 80                  EOR   #80h   
E406   65 03                  ADC   TH   
E408   70 25                  BVS   e_heap   ; wrapped
E40A   49 80                  EOR   #80h   ; the new top's high byte
E40C   C9 E0                  CMP   #HEAPLIM   
E40E   B0 1F                  BCS   e_heap   ; at or past the limit
E410   A8                     TAY      
E411   A5 04                  LDA   T0   
E413   CD 38 04               CMP   PEND   
E416   98                     TYA      
E417   ED 39 04               SBC   PEND+1   
E41A   90 13                  BCC   e_heap   ; below the program's end
E41C   AD 7C 04               LDA   HEAP   
E41F   85 02                  STA   TL   
E421   A5 04                  LDA   T0   
E423   8D 7C 04               STA   HEAP   
E426   AD 7D 04               LDA   HEAP+1   
E429   85 03                  STA   TH   
E42B   8C 7D 04               STY   HEAP+1   
E42E   60                     RTS      
E42F                             ; Errors found by handlers. The stacks are as they were before the handler.
E42F   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E431   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E432   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E434   4C A0 E5               JMP   error   
E437                             ; chkst: stop unless the page in A is in the program's own space, from the
E437                             ; letter page up to the heap limit. Keeps Y.
E437   C9 04        CHKST:    CMP   #LETPAGE   
E439   90 F7                  BCC   e_store   
E43B   C9 E0                  CMP   #HEAPLIM   
E43D   B0 F3                  BCS   e_store   
E43F   60                     RTS      
E440                          ENDIF      
E440                             ; =============================================================================
E440                             ;  Console
E440                             ; =============================================================================
E440                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E440   A0 00        TOSGET:   LDY   #0   
E442   B1 02                  LDA   (TL),Y   
E444   E6 02        INCTOS:   INC   TL   
E446   D0 02                  BNE   tg1   
E448   E6 03                  INC   TH   
E44A   60           TG1:      RTS      
E44B                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E44B                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E44B                             ; bit 6, so // and /" give themselves).
E44B                             ; The checked build walks a copy of TOS along the string, so that the address
E44B                             ; is still there if it stops with Q on a NUL.
E44B                H_PRINT:      
E44B                          IF   CHECKED   
E44B   20 FA E0               JSR   push   ; the copy
E44E   20 54 E4               JSR   pr0   
E451   4C 6D E2               JMP   drop   
E454                PR0:         
E454                          ENDIF      
E454   20 40 E4               JSR   tosget   
E457   C9 22                  CMP   #22h   
E459   F0 20                  BEQ   pdrop   
E45B                          IF   CHECKED   
E45B   C9 00                  CMP   #0   
E45D   F0 0F                  BEQ   e_qpr   
E45F                          ENDIF      
E45F   C9 2F                  CMP   #"/"   
E461   D0 05                  BNE   pr1   
E463   20 40 E4               JSR   tosget   
E466   29 BF                  AND   #0BFh   
E468   20 03 FF     PR1:      JSR   CONOUT   
E46B                          IF   1-CHECKED   
                              JMP   h_print   
E46B                          ENDIF      
E46B                          IF   CHECKED   
E46B   4C 54 E4               JMP   pr0   
E46E   20 6D E2     E_QPR:    JSR   drop   ; the copy goes: the address is TOS again
E471   A9 51                  LDA   #"Q"   ; $ ran into the end
E473   4C A0 E5               JMP   error   
E476                          ENDIF      
E476   A5 02        H_EMIT:   LDA   TL   ; "'"
E478   20 03 FF               JSR   CONOUT   
E47B   4C 6D E2     PDROP:    JMP   drop   
E47E                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E47E                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E47E                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E47E   A5 03        H_NUM:    LDA   TH   
E480   10 08                  BPL   pn1   
E482   A9 2D                  LDA   #"-"   
E484   20 03 FF               JSR   CONOUT   
E487   20 11 E3               JSR   neg   
E48A   CA           PN1:      DEX      ; the spare cell
E48B   A9 0A                  LDA   #10   
E48D   85 08                  STA   D0   
E48F   A9 00                  LDA   #0   
E491   85 09                  STA   D1   
E493   48                     PHA      ; the end marker
E494   20 B9 E3     PN2:      JSR   udiv   
E497   BD 00 02               LDA   DSL,X   
E49A   09 30                  ORA   #"0"   
E49C   48                     PHA      
E49D   A5 02                  LDA   TL   
E49F   05 03                  ORA   TH   
E4A1   D0 F1                  BNE   pn2   
E4A3   E8                     INX      
E4A4   68           PN3:      PLA      
E4A5   F0 D4                  BEQ   pdrop   
E4A7   20 03 FF               JSR   CONOUT   
E4AA   4C A4 E4               JMP   pn3   
E4AD   A0 01        H_FETCH:   LDY   #1   ; "@"
E4AF   B1 02                  LDA   (TL),Y   
E4B1   48                     PHA      ; the high byte, while "," gets the low one
E4B2   20 B9 E4               JSR   h_cfetch   
E4B5   68                     PLA      
E4B6   85 03                  STA   TH   
E4B8   60                     RTS      
E4B9                H_CFETCH:      ; ","
E4B9   A0 00                  LDY   #0   
E4BB   B1 02                  LDA   (TL),Y   
E4BD   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E4BF   84 03                  STY   TH   
E4C1   60                     RTS      
E4C2                             ; "?" ( n -- c ) or ( -n -- addr )
E4C2                             ;   n > 0: wait about n ms for a key; 0 if none came
E4C2                             ;   n = 0: wait for a key
E4C2                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E4C2                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E4C2   A5 03        H_KEY:    LDA   TH   
E4C4   30 20                  BMI   line   
E4C6   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E4C8   20 65 E5     KT2:      JSR   getk   
E4CB   D0 15                  BNE   kt3   
E4CD   88                     DEY      
E4CE   D0 F8                  BNE   kt2   
E4D0   A5 02                  LDA   TL   ; count the millisecond off:
E4D2   D0 06                  BNE   kt4   
E4D4   A5 03                  LDA   TH   
E4D6   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E4D8   C6 03                  DEC   TH   
E4DA   C6 02        KT4:      DEC   TL   
E4DC   D0 E8                  BNE   kt1   
E4DE   A5 03                  LDA   TH   
E4E0   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E4E2   A0 00        KT3:      LDY   #0   
E4E4   F0 D7                  BEQ   cf2   ; always: TOS = A
E4E6                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E4E6                             ; (stored, not echoed), every other key is stored and echoed until the line
E4E6                             ; is full. Y = the length so far; TL = the most allowed.
E4E6   20 11 E3     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E4E9   D0 04                  BNE   ln0   
E4EB   A5 02                  LDA   TL   
E4ED   10 04                  BPL   ln1   
E4EF   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E4F1   85 02                  STA   TL   
E4F3   A0 00        LN1:      LDY   #0   
E4F5   F0 03                  BEQ   ln2   ; always
E4F7   20 03 FF     LN3:      JSR   CONOUT   
E4FA   20 65 E5     LN2:      JSR   getk   
E4FD   F0 FB                  BEQ   ln2   
E4FF   C9 0D                  CMP   #13   
E501   F0 14                  BEQ   ln5   
E503   C9 08                  CMP   #8   
E505   F0 0A                  BEQ   ln4   
E507   C4 02                  CPY   TL   
E509   B0 EF                  BCS   ln2   ; full
E50B   99 80 04               STA   LINEBUF,Y   
E50E   C8                     INY      
E50F   D0 E6                  BNE   ln3   ; always: echo it
E511   88           LN4:      DEY      ; Backspace: one back, and echo it,
E512   10 E3                  BPL   ln3   
E514   C8                     INY      ;   unless the line was empty
E515   F0 E3                  BEQ   ln2   ; always
E517   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E51A   A9 80                  LDA   #<LINEBUF   
E51C   85 02                  STA   TL   
E51E   A9 04                  LDA   #>LINEBUF   
E520   85 03                  STA   TH   
E522   60                     RTS      
E523                             ; =============================================================================
E523                             ;  Machine code: the grave
E523                             ; =============================================================================
E523                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E523                             ; are stored from addr until a non-hex character; then a RET (60h) is
E523                             ; written and its address is left. An odd last digit is consumed and dropped.
E523                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E523                             ; contract in the header.
E523   20 52 E5     H_GRAVE:   JSR   rdhex   
E526   B0 1C                  BCS   exec   
E528   0A           HX1:      ASL      
E529   0A                     ASL      
E52A   0A                     ASL      
E52B   0A                     ASL      
E52C   85 04                  STA   T0   
E52E   20 52 E5               JSR   rdhex   
E531   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E533   05 04                  ORA   T0   
E535   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
E537   20 44 E4               JSR   inctos   
E53A   20 52 E5               JSR   rdhex   
E53D   90 E9                  BCC   hx1   
E53F   A9 60        HX2:      LDA   #60h   
E541   91 02                  STA   (TL),Y   
E543   60                     RTS      
E544   A5 02        EXEC:     LDA   TL   
E546   85 04                  STA   T0   
E548   A5 03                  LDA   TH   
E54A   85 05                  STA   T1   
E54C   20 6D E2               JSR   drop   ; the address is consumed
E54F   6C 04 00               JMP   (T0)   
E552                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E552                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E552                             ; Y = 0.
E552   20 22 E2     RDHEX:    JSR   isdig   
E555   90 0A                  BCC   rh1   
E557   29 DF                  AND   #0DFh   
E559   E9 11                  SBC   #11h   ; (the carry is set)
E55B   C9 06                  CMP   #6   
E55D   B0 05                  BCS   rh9   
E55F   69 0A                  ADC   #10   
E561   4C 33 E2     RH1:      JMP   incip   
E564   60           RH9:      RTS      
E565                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E565                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E565                             ; taken out of KEYBUF.
E565   AD 7A 04     GETK:     LDA   KEYBUF   
E568   F0 08                  BEQ   gk1   
E56A   48                     PHA      
E56B   A9 00                  LDA   #0   
E56D   8D 7A 04               STA   KEYBUF   
E570   68                     PLA      
E571   60                     RTS      
E572   20 06 FF     GK1:      JSR   KEY   
E575   F0 04                  BEQ   gk9   
E577   C9 03                  CMP   #3   
E579   F0 01                  BEQ   ctlc   ; Ctrl-C: ctlc gives the 03h back, if at all
E57B   60           GK9:      RTS      
E57C                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E57C                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E57C                             ; looks: D0 counts the 256s, D1 runs on from whatever it holds) for one more
E57C                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E57C                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E57C   AD 7B 04     CTLC:     LDA   BRKOFF   
E57F   F0 1D                  BEQ   cbreak   
E581   A9 28                  LDA   #CWAIT+1   
E583   85 08                  STA   D0   
E585   20 06 FF     CT2:      JSR   KEY   
E588   D0 0A                  BNE   ct3   
E58A   C6 09                  DEC   D1   
E58C   D0 F7                  BNE   ct2   
E58E   C6 08                  DEC   D0   
E590   D0 F3                  BNE   ct2   
E592   F0 07                  BEQ   ct9   ; always: none came
E594   C9 03        CT3:      CMP   #3   
E596   F0 06                  BEQ   cbreak   
E598   8D 7A 04               STA   KEYBUF   
E59B   A9 03        CT9:      LDA   #3   
E59D   60                     RTS      
E59E                          IF   1-CHECKED   
                    CBREAK:   JMP   EXIT   ; the unchecked build stops without a word
E59E                          ENDIF      
E59E                          IF   CHECKED   
E59E                CBREAK:      ; the checked build reports B, the stacks as
E59E   A9 42        E_BREAK:   LDA   #"B"   ;   they stand (it falls into error)
E5A0                          ENDIF      
E5A0                          IF   CHECKED   
E5A0                             ; =============================================================================
E5A0                             ;  Checked build: the error report
E5A0                             ; =============================================================================
E5A0                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E5A0                             ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
E5A0                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E5A0                             ; its depth is shown.
E5A0                             ;   CR LF
E5A0                             ;   Err X @ line,col CR LF
E5A0                             ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
E5A0                             ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
E5A0                             ;   Rtn n CR LF
E5A0                             ; The numbers go through "#" (prnum), which pushes them over the data stack
E5A0                             ; and pops them again, so the stack is shown as it was.
E5A0   48           ERROR:    PHA      ; the letter
E5A1   AD 36 04               LDA   PLACE   
E5A4   85 0A                  STA   P   
E5A6   AD 37 04               LDA   PLACE+1   
E5A9   85 0B                  STA   P+1   
E5AB   A0 00                  LDY   #M_ERR-MSG   
E5AD   20 49 E6               JSR   prs   ; CR LF "Err "
E5B0   68                     PLA      
E5B1   20 03 FF               JSR   CONOUT   
E5B4   20 49 E6               JSR   prs   ; " @ " (it follows M_ERR)
E5B7   20 74 E6               JSR   lcol   
E5BA   A5 08                  LDA   D0   
E5BC   A4 09                  LDY   D1   
E5BE   20 43 E6               JSR   prnum   ; the line
E5C1   A9 2C                  LDA   #","   
E5C3   20 03 FF               JSR   CONOUT   
E5C6   A5 05                  LDA   T1   
E5C8   A4 06                  LDY   T2   
E5CA   20 43 E6               JSR   prnum   ; the column
E5CD   A0 09                  LDY   #M_NL-MSG   
E5CF   20 49 E6               JSR   prs   
E5D2   A0 00                  LDY   #0   ; the text at the place
E5D4   B1 0A        ER1:      LDA   (P),Y   
E5D6   F0 10                  BEQ   er2   
E5D8   C9 0D                  CMP   #13   
E5DA   F0 0C                  BEQ   er2   
E5DC   C9 0A                  CMP   #10   
E5DE   F0 08                  BEQ   er2   
E5E0   20 03 FF               JSR   CONOUT   
E5E3   C8                     INY      
E5E4   C0 10                  CPY   #16   
E5E6   D0 EC                  BNE   er1   
E5E8   A0 0B        ER2:      LDY   #M_STK-MSG   
E5EA   20 49 E6               JSR   prs   ; CR LF "Stk "
E5ED   8A                     TXA      
E5EE   49 FF                  EOR   #0FFh   
E5F0   38                     SEC      
E5F1   E9 03                  SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
E5F3   48                     PHA      
E5F4   A0 00                  LDY   #0   
E5F6   20 43 E6               JSR   prnum   
E5F9   68                     PLA      
E5FA   A0 16                  LDY   #M_C-MSG   ; ":"
E5FC   C9 09                  CMP   #9   
E5FE   90 04                  BCC   er3   
E600   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E602   A0 11                  LDY   #M_CD-MSG   
E604   85 05        ER3:      STA   T1   ; T1 = how many cells to show
E606   20 49 E6               JSR   prs   
E609   20 FA E0               JSR   push   ; TOS into memory with the rest: cell i from
E60C                             ;   the top is at DSL+X+i now
E60C   A5 05        ER4:      LDA   T1   ; cells T1-1 down to 0, the top last
E60E   F0 1B                  BEQ   er5   
E610   C6 05                  DEC   T1   
E612   A9 20                  LDA   #" "   
E614   20 03 FF               JSR   CONOUT   
E617   8A                     TXA      
E618   18                     CLC      
E619   65 05                  ADC   T1   
E61B   A8                     TAY      
E61C   B9 00 02               LDA   DSL,Y   
E61F   48                     PHA      
E620   B9 00 03               LDA   DSH,Y   
E623   A8                     TAY      
E624   68                     PLA      
E625   20 43 E6               JSR   prnum   
E628   4C 0C E6               JMP   er4   
E62B   A0 17        ER5:      LDY   #M_RTN-MSG   
E62D   20 49 E6               JSR   prs   ; CR LF "Rtn "
E630   AD 35 04               LDA   RSV   
E633   49 FF                  EOR   #0FFh   
E635   4A                     LSR      ; (FFh - S) / 2 entries
E636   A0 00                  LDY   #0   
E638   20 43 E6               JSR   prnum   
E63B   A0 09                  LDY   #M_NL-MSG   
E63D   20 49 E6               JSR   prs   
E640   4C 09 FF               JMP   EXIT   
E643                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack
E643   20 F0 E0     PRNUM:    JSR   pushay   
E646   4C 7E E4               JMP   h_num   
E649                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E649                             ; past it, at the next message.
E649   B9 57 E6     PRS:      LDA   MSG,Y   
E64C   48                     PHA      
E64D   29 7F                  AND   #7Fh   
E64F   20 03 FF               JSR   CONOUT   
E652   C8                     INY      
E653   68                     PLA      
E654   10 F3                  BPL   prs   
E656   60                     RTS      
E657                MSG:         
E657   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E65D   20 40 A0               DB   " @"," "+80h   
E660   0D 8A        M_NL:     DB   13,10+80h   
E662   0D 0A 53 74 6B A0 M_STK:   DB   13,10,"Stk"," "+80h   
E668   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E66D   BA           M_C:      DB   ":"+80h   
E66E   0D 0A 52 74 6E A0 M_RTN:   DB   13,10,"Rtn"," "+80h   
E674                             ; lcol: the line (D0/D1) and the column (T1/T2) of the place at P, both from
E674                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
E674                             ; column is the place in the buffer. Otherwise the LFs before the place are
E674                             ; counted from PROG; T1/T2 holds the address before the line's first
E674                             ; character (the last LF, or PROG - 1), and the column is P minus that.
E674   A0 00        LCOL:     LDY   #0   
E676   84 09                  STY   D1   
E678   84 08                  STY   D0   
E67A   A9 7F                  LDA   #<LBM1   
E67C   85 05                  STA   T1   
E67E   A9 04                  LDA   #>LBM1   
E680   85 06                  STA   T2   
E682   A5 0A                  LDA   P   
E684   C9 00                  CMP   #<PROG   
E686   A5 0B                  LDA   P+1   
E688   E9 05                  SBC   #>PROG   
E68A   90 34                  BCC   lc9   ; below the program: line 0
E68C   E6 08                  INC   D0   
E68E   A9 FF                  LDA   #<PROGM1   
E690   85 0C                  STA   Q   
E692   85 05                  STA   T1   
E694   A9 04                  LDA   #>PROGM1   
E696   85 0D                  STA   Q+1   
E698   85 06                  STA   T2   
E69A   E6 0C        LC1:      INC   Q   ; the next character
E69C   D0 02                  BNE   lc2   
E69E   E6 0D                  INC   Q+1   
E6A0   A5 0C        LC2:      LDA   Q   
E6A2   C5 0A                  CMP   P   
E6A4   A5 0D                  LDA   Q+1   
E6A6   E5 0B                  SBC   P+1   
E6A8   B0 16                  BCS   lc9   ; at the place
E6AA   B1 0C                  LDA   (Q),Y   
E6AC   C9 0A                  CMP   #10   
E6AE   D0 EA                  BNE   lc1   
E6B0   E6 08                  INC   D0   ; an LF: a new line starts after it
E6B2   D0 02                  BNE   lc3   
E6B4   E6 09                  INC   D1   
E6B6   A5 0C        LC3:      LDA   Q   
E6B8   85 05                  STA   T1   
E6BA   A5 0D                  LDA   Q+1   
E6BC   85 06                  STA   T2   
E6BE   D0 DA                  BNE   lc1   ; always: no program is in page zero
E6C0   A5 0A        LC9:      LDA   P   
E6C2   38                     SEC      
E6C3   E5 05                  SBC   T1   
E6C5   85 05                  STA   T1   
E6C7   A5 0B                  LDA   P+1   
E6C9   E5 06                  SBC   T2   
E6CB   85 06                  STA   T2   
E6CD   60                     RTS      
E6CE                          ENDIF      


