0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC and
                                 ; IY, and all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
                    PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      1-CPM,0DFh      ;   RST 18h
0000                 DS      CPM,0E1h        ;   POP HL
0000                 DS      CPM,0DDh        ;   JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   RST 30h
0000                 DS      CPM,0DDh        ;   JP (IX): IX holds next0
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM,0DDh        ;   LD IX,next0
0000                 DS      CPM,21h
0000                 DS      CPM,ANXT&0FFh
0000                 DS      CPM,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 09               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0103                          ENDIF      
0103                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0103                          ENDIF      
0103                          IF   CPM*EDITOR   
0103   CD 42 07               CALL   load   ; the file named on the command line
0106   C3 F4 04               JP   edit0   
0109                          ENDIF      
0109                          IF   1-CPM   
                                 ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
                    RPOP:     LD   E,(IY+0)   ; 08
                              LD   D,(IY+1)   
                              JR   rp2   ; (the rest is at 2Bh)
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
                              JR   NZ,next0   ;     the rest are ignored
                    ENDPROG:   JP   EXIT   ;     the program has ended
                              NOP      ; 17  spare
                                 ; ---- RST 18h: drop TOS, then next ------------------------------------------
                    RST18:    POP   DE   ; 18  discard the RST's return address
                    DRP:      POP   HL   ;     new TOS = NOS
                              JR   next0   
0109                          ENDIF      
0109   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
010A                          ;*Macro unroll:  POPR
010A                          DS   1-CPM,0CFh   
010A   CD                     DS   CPM,0CDh   
010B   8C                     DS   CPM,AROP&0FFh   
010C   04                     DS   CPM,AROP/256   
010D   EB                     EX   DE,HL   
010E                          ;*Macro unroll:  NEXT
010E                          DS   1-CPM,0F7h   
010E   DD                     DS   CPM,0DDh   
010F   E9                     DS   CPM,0E9h   
0110                          IF   1-CPM   
                                 ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
                    NEG16:    XOR   A   ; 20
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
                              NOP      ; 27  spare
                                 ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
                    RST28:       
                    PUTC:     JP   CONOUT   ; 28
                    RP2:      INC   IY   ; 2B  the rest of rpop
                              INC   IY   
                              RET      
                                 ; ---- RST 30h: next character -----------------------------------------------
                    RST30:    POP   DE   ; 30  discard the RST's return address
0110                          ENDIF      
0110                          IF   CPM   
0110                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0110   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
0112   20 03                  JR   NZ,next0   ; the rest are ignored
0114   C3 FD 04     ENDPROG:   JP   EXIT   ; the program has ended
0117                          ENDIF      
0117                             ; =============================================================================
0117                             ;  The inner loop: read one character and sort it by range.
0117                             ; 
0117                             ;    00h          end of program
0117                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0117                             ;    30h-39h      digit: read a whole number
0117                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0117                             ;    61h-7Ah      a-z: push the address of that letter's cell
0117                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0117                             ; =============================================================================
0117                NEXT0:       
0117                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0117                          ENDIF      
0117   0A                     LD   A,(BC)   
0118   03                     INC   BC   
0119   D6 21                  SUB   21h   ; A = c - 21h
011B   38 F3                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
011D   FE 0F                  CP   0Fh   
011F   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0121   D6 0F                  SUB   0Fh   ; A = c - 30h
0123   FE 0A                  CP   0Ah   
0125   38 61                  JR   C,digit   ; 30h-39h
0127   FE 11                  CP   11h   
0129   38 16                  JR   C,p3a   ; 3Ah-40h
012B   D6 11                  SUB   11h   ; A = c - 41h
012D   FE 1A                  CP   1Ah   
012F   38 65                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0131   FE 20                  CP   20h   
0133   38 0A                  JR   C,p5b   ; 5Bh-60h
0135   FE 3A                  CP   3Ah   
0137   38 56                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0139   FE 3E                  CP   3Eh   
013B                          IF   1-CHECKED   
013B   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
013D                          ENDIF      
013D                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
013D                          ENDIF      
013D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
013F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0141   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0143                .macro PTABLE,
0143                             ; 
0143                 DB      h_store & 0FFh  ; !
0143                 DB      h_str & 0FFh    ; "
0143                 DB      h_num & 0FFh    ; #
0143                 DB      h_print & 0FFh  ; $
0143                 DB      h_swap & 0FFh   ; %
0143                 DB      h_and & 0FFh    ; &
0143                 DB      h_emit & 0FFh   ; '
0143                 DB      h_open & 0FFh   ; (
0143                 DB      h_close & 0FFh  ; )
0143                 DB      h_mul & 0FFh    ; *
0143                 DB      h_add & 0FFh    ; +
0143                 DB      h_cfetch & 0FFh ; ,
0143                 DB      h_sub & 0FFh    ; -
0143                 DB      h_cstore & 0FFh ; .
0143                 DB      h_div & 0FFh    ; /
0143                 DB      h_dup & 0FFh    ; :
0143                 DB      h_drop & 0FFh   ; ;
0143                 DB      h_lt & 0FFh     ; <
0143                 DB      h_eq & 0FFh     ; =
0143                 DB      h_gt & 0FFh     ; >
0143                 DB      h_key & 0FFh    ; ?
0143                 DB      h_fetch & 0FFh  ; @
0143                 DB      h_def & 0FFh    ; [
0143                 DB      h_break & 0FFh  ; \
0143                 DB      h_ret & 0FFh    ; ]
0143                 DB      h_xor & 0FFh    ; ^
0143                 DB      h_alloc & 0FFh  ; _
0143                 DB      h_grave & 0FFh  ; `
0143                 DB      h_tor & 0FFh    ; {
0143                 DB      h_or & 0FFh     ; |
0143                 DB      h_fromr & 0FFh  ; }
0143                 DB      h_not & 0FFh    ; ~
0143                .endm
0143                 
0143                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0143                             ; untouched, and A, DE free.
0143   C6 2E        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0145   5F                     LD   E,A   
0146   16 04                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0148   FE 44                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
014A   1A                     LD   A,(DE)   
014B   5F                     LD   E,A   ; the handler's low byte
014C                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
014C                          ENDIF      
014C                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
014C                          ENDIF      
014C                          IF   CPM   
014C   16 01                  LD   D,1   
014E   30 01                  JR   NC,pu1   
0150   14                     INC   D   ; its page: 1 + carry
0151                PU1:         
0151                          ENDIF      
0151   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0152   C9                     RET      ;   when the handler starts
0153                             ; The rest of the startup: here so that the generic reset code can reach it
0153                             ; with JR. st0: find the program's NUL; the heap starts after it.
0153                             ; (The editor build has its own copy of this, next to the editor.)
0153                             ; A checked build first clears the lower half of the letter page (A = 0):
0153                             ; every variable starts at 0, every word cell holds 0000h, the address an
0153                             ; undefined word is caught at (see e_hi), and no key is held back.
0153                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0153                          ENDIF      
0153                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0153                          ENDIF      
0153                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0153                          ENDIF      
0153                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0153                          ENDIF      
0153                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0153                          ENDIF      ;   these)
0153                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0153                          ENDIF      
0153                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0153                          ENDIF      
0153                          IF   1-EDITOR   
                              ;*Macro unroll:  SETIX
                              DS   CPM,0DDh   
                              DS   CPM,21h   
                              DS   CPM,ANXT&0FFh   
                              DS   CPM,ANXT/256   
                              LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   1-CPM,0F7h   ; (its return address is thrown away)
                              DS   CPM,0DDh   
                              DS   CPM,0E9h   
0153                          ENDIF      
0153                             ; In the unchecked generic editor build the table is here, in the first
0153                             ; page, which saves loading D twice. (The other builds have no room for it
0153                             ; here: theirs is further down.)
0153                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0153                          ENDIF      
0153                             ; =============================================================================
0153                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0153                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0153                             ;  is here too: it belongs to "`" and makes the page come out right.
0153                             ; =============================================================================
0153   D1           H_XOR:    POP   DE   
0154   7C                     LD   A,H   
0155   AA                     XOR   D   
0156   67                     LD   H,A   
0157   7D                     LD   A,L   
0158   AB                     XOR   E   
0159   6F                     LD   L,A   
015A                          ;*Macro unroll:  NEXT
015A                          DS   1-CPM,0F7h   
015A   DD                     DS   CPM,0DDh   
015B   E9                     DS   CPM,0E9h   
015C   D1           H_OR:     POP   DE   
015D   7C                     LD   A,H   
015E   B2                     OR   D   
015F   67                     LD   H,A   
0160   7D                     LD   A,L   
0161   B3                     OR   E   
0162   6F                     LD   L,A   
0163                          ;*Macro unroll:  NEXT
0163                          DS   1-CPM,0F7h   
0163   DD                     DS   CPM,0DDh   
0164   E9                     DS   CPM,0E9h   
0165                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0165                H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0165   CD                     DS   CPM,0CDh   
0166   97                     DS   CPM,ANEG&0FFh   
0167   04                     DS   CPM,ANEG/256   
0168   2B                     DEC   HL   
0169                          ;*Macro unroll:  NEXT
0169                          DS   1-CPM,0F7h   
0169   DD                     DS   CPM,0DDh   
016A   E9                     DS   CPM,0E9h   
016B                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
016B                             ; the same either way); TOS is the old pointer.
016B   ED 5B 7C 0A  H_ALLOC:   LD   DE,(HEAP)   
016F                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
016F                          ENDIF      
016F   19                     ADD   HL,DE   ; the new top
0170                          IF   CHECKED   
                              CALL   chkhp   
0170                          ENDIF      
0170   22 7C 0A               LD   (HEAP),HL   
0173   EB                     EX   DE,HL   
0174                          ;*Macro unroll:  NEXT
0174                          DS   1-CPM,0F7h   
0174   DD                     DS   CPM,0DDh   
0175   E9                     DS   CPM,0E9h   
0176                          IF   1-CPM*CHECKED   
0176   FD 22 34 0A  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
017A   CD B9 01               CALL   jphl   
017D   FD 2A 34 0A            LD   IY,(RSAVE)   
0181                          ;*Macro unroll:  SETIX
0181   DD                     DS   CPM,0DDh   
0182   21                     DS   CPM,21h   
0183   17                     DS   CPM,ANXT&0FFh   
0184   01                     DS   CPM,ANXT/256   
0185   E1                     POP   HL   
0186                          ;*Macro unroll:  NEXT
0186                          DS   1-CPM,0F7h   
0186   DD                     DS   CPM,0DDh   
0187   E9                     DS   CPM,0E9h   
0188                          ENDIF      
0188                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
0188                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
0188                             ; Digits: step back onto the first digit and read the whole number.
0188   E5           DIGIT:    PUSH   HL   
0189   0B                     DEC   BC   
018A   CD BB 03               CALL   rdnum   
018D                          ;*Macro unroll:  NEXT
018D                          DS   1-CPM,0F7h   
018D   DD                     DS   CPM,0DDh   
018E   E9                     DS   CPM,0E9h   
018F                             ; a-z: push the cell's address (the cell is the variable)
018F   E5           LOWER:    PUSH   HL   
0190   87                     ADD   A,A   
0191   6F                     LD   L,A   
0192   26 0A                  LD   H,LETPAGE   
0194                          ;*Macro unroll:  NEXT
0194                          DS   1-CPM,0F7h   
0194   DD                     DS   CPM,0DDh   
0195   E9                     DS   CPM,0E9h   
0196                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0196                             ; the return stack, and the IP becomes the address in the letter's cell.
0196   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
0197   EB                     EX   DE,HL   ; park TOS
0198   87                     ADD   A,A   
0199   6F                     LD   L,A   
019A   26 0A                  LD   H,LETPAGE   ; HL -> cell
019C   4E                     LD   C,(HL)   
019D   2C                     INC   L   
019E   46                     LD   B,(HL)   ; IP = the word's body
019F   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01A0                             ; rpushn: move the top cell of the data stack (in memory) to the return
01A0                             ; stack, then next. Everything that pushes the return stack ends here.
01A0                             ; 
01A0                             ; The break key is looked at here, so at every word call and loop-back (and
01A0                             ; block entry and "{"), but only one time in 256: PCNT counts them.
01A0                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
01A0   D1           RPUSHN:   POP   DE   
01A1   FD 72 FF               LD   (IY-1),D   
01A4   FD 73 FE               LD   (IY-2),E   
01A7   FD 2B                  DEC   IY   
01A9   FD 2B                  DEC   IY   
01AB   E5                     PUSH   HL   
01AC   21 36 0A               LD   HL,PCNT   
01AF   35                     DEC   (HL)   
01B0   E1                     POP   HL   ; (the zero flag lasts)
01B1   CC 4E 04               CALL   Z,pollk   
01B4                          ;*Macro unroll:  NEXT
01B4                          DS   1-CPM,0F7h   
01B4   DD                     DS   CPM,0DDh   
01B5   E9                     DS   CPM,0E9h   
01B6                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
01B6   E3           H_TOR:    EX   (SP),HL   
01B7   18 E7                  JR   rpushn   
01B9   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
01BA                             ; ---- machine code: the grave -----------------------------------------------
01BA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01BA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01BA                             ; written and its address is left. An odd last digit is consumed and dropped.
01BA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01BA                             ; code is entered by CALL with the data stack above the return address; it
01BA                             ; must keep BC, and on return the top cell becomes the new TOS.
01BA   CD FE 03     H_GRAVE:   CALL   hexc   
01BD                          IF   1-CPM*CHECKED   
01BD   30 B7                  JR   NC,exec   
01BF                          ENDIF      
01BF                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
01BF                          ENDIF      
01BF   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01C0   CD FE 03               CALL   hexc   
01C3   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01C5   ED 6F                  RLD      ;   overwrites it
01C7   23                     INC   HL   ; ... and RLD shifts it up under the low one
01C8   CD FE 03               CALL   hexc   
01CB   38 F2                  JR   C,hx1   
01CD   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01CF                          ;*Macro unroll:  NEXT
01CF                          DS   1-CPM,0F7h   
01CF   DD                     DS   CPM,0DDh   
01D0   E9                     DS   CPM,0E9h   
01D1                             ; ---- where the two pages meet ----------------------------------------------
01D1                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D1                             ; are in falling code order for this), and where exactly differs between the
01D1                             ; builds: NPG1 follows. Every handler below these four must start in the
01D1                             ; second page, and every one above in the first; chktab.py checks both.
01D1                             ; "]" returns: pop an address and jump to it.
01D1                          ;*Macro unroll: h_ret:  POPR
01D1                H_RET:    DS   1-CPM,0CFh   
01D1   CD                     DS   CPM,0CDh   
01D2   8C                     DS   CPM,AROP&0FFh   
01D3   04                     DS   CPM,AROP/256   
01D4   42                     LD   B,D   
01D5   4B                     LD   C,E   
01D6                          ;*Macro unroll: brk1:   NEXT
01D6                BRK1:     DS   1-CPM,0F7h   
01D6   DD                     DS   CPM,0DDh   
01D7   E9                     DS   CPM,0E9h   
01D8                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01D8                             ; drops the block start, "]" returns. No closer at all ends the program.
01D8   7C           H_BREAK:   LD   A,H   
01D9   B5                     OR   L   
01DA   E1                     POP   HL   
01DB   28 F9                  JR   Z,brk1   
01DD   CD DD 03               CALL   skip   
01E0   B7                     OR   A   ; skip returns 0 for ")"
01E1   20 EE                  JR   NZ,h_ret   
01E3                          ;*Macro unroll: rdrop:  POPR
01E3                RDROP:    DS   1-CPM,0CFh   
01E3   CD                     DS   CPM,0CDh   
01E4   8C                     DS   CPM,AROP&0FFh   
01E5   04                     DS   CPM,AROP/256   
01E6                          ;*Macro unroll:  NEXT
01E6                          DS   1-CPM,0F7h   
01E6   DD                     DS   CPM,0DDh   
01E7   E9                     DS   CPM,0E9h   
01E8                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01E8                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01E8                             ; the body"s address instead. Either way it then skips to the matching "]'.
01E8                             ; (The unchecked build takes anything that is not a letter as the space; the
01E8                             ; checked build stops on it.)
01E8   0A           H_DEF:    LD   A,(BC)   
01E9   03                     INC   BC   
01EA   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01EC   5F                     LD   E,A   ;   lands 64 bytes up
01ED   E6 DF                  AND   0DFh   ; fold case
01EF   FE 1A                  CP   26   
01F1   30 0B                  JR   NC,def2   ; not a letter
01F3   CB 23                  SLA   E   
01F5   16 0A                  LD   D,LETPAGE   ; DE -> cell
01F7   79                     LD   A,C   
01F8   12                     LD   (DE),A   
01F9   1C                     INC   E   
01FA   78                     LD   A,B   
01FB   12                     LD   (DE),A   
01FC   18 03                  JR   skipnx   
01FE                DEF2:        
01FE                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
01FE                          ENDIF      
01FE   E5                     PUSH   HL   ; an anonymous block: push its address
01FF   60                     LD   H,B   
0200   69                     LD   L,C   
0201                SKIPNX:      
0201                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0201                          ENDIF      ;   opener, the "[", just before where it starts
0201   CD DD 03     SKIPO:    CALL   skip   
0204                          ;*Macro unroll:  NEXT
0204                          DS   1-CPM,0F7h   
0204   DD                     DS   CPM,0DDh   
0205   E9                     DS   CPM,0E9h   
0206   5E           H_FETCH:   LD   E,(HL)   ; "@"
0207   23                     INC   HL   
0208   56                     LD   D,(HL)   
0209   EB                     EX   DE,HL   
020A                          ;*Macro unroll:  NEXT
020A                          DS   1-CPM,0F7h   
020A   DD                     DS   CPM,0DDh   
020B   E9                     DS   CPM,0E9h   
020C                             ; =============================================================================
020C                             ;  Handlers that must start in the image's second page.
020C                             ;  "?" is the last (with "," inside it), so its long tail may run past that
020C                             ;  page.
020C                             ; =============================================================================
020C                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
020C                             ; the matching ")".
020C   7C           H_OPEN:   LD   A,H   
020D   B5                     OR   L   
020E   E1                     POP   HL   
020F   28 F0                  JR   Z,skipo   
0211   C5                     PUSH   BC   ; the block starts at the IP
0212   18 8C                  JR   rpushn   
0214                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0214                             ; drops it and carries on.
0214   7C           H_CLOSE:   LD   A,H   
0215   B5                     OR   L   
0216   E1                     POP   HL   
0217   28 CA                  JR   Z,rdrop   
0219                          ;*Macro unroll:  POPR                    ; pop the block start ...
0219                          DS   1-CPM,0CFh   ; pop the block start ...
0219   CD                     DS   CPM,0CDh   
021A   8C                     DS   CPM,AROP&0FFh   
021B   04                     DS   CPM,AROP/256   
021C   42                     LD   B,D   
021D   4B                     LD   C,E   
021E   C5                     PUSH   BC   
021F                          IF   1-CPM   
                              JR   rpushn   ; ... and push it back
021F                          ENDIF      
021F                          IF   CPM   
021F   C3 A0 01               JP   rpushn   
0222                          ENDIF      
0222                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0222                             ; "-" has two jobs: directly before a digit it starts a negative number.
0222   0A           H_SUB:    LD   A,(BC)   
0223   D6 30                  SUB   "0"   
0225   FE 0A                  CP   10   
0227   38 07                  JR   C,negnum   
0229                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0229                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0229   CD                     DS   CPM,0CDh   
022A   97                     DS   CPM,ANEG&0FFh   
022B   04                     DS   CPM,ANEG/256   
022C   D1           H_ADD:    POP   DE   
022D   19                     ADD   HL,DE   
022E                          ;*Macro unroll:  NEXT
022E                          DS   1-CPM,0F7h   
022E   DD                     DS   CPM,0DDh   
022F   E9                     DS   CPM,0E9h   
0230   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0231   CD BB 03               CALL   rdnum   
0234                          ;*Macro unroll:  NEGH
0234                          DS   1-CPM,0E7h   
0234   CD                     DS   CPM,0CDh   
0235   97                     DS   CPM,ANEG&0FFh   
0236   04                     DS   CPM,ANEG/256   
0237                          ;*Macro unroll:  NEXT
0237                          DS   1-CPM,0F7h   
0237   DD                     DS   CPM,0DDh   
0238   E9                     DS   CPM,0E9h   
0239   D1           H_AND:    POP   DE   
023A   7C                     LD   A,H   
023B   A2                     AND   D   
023C   67                     LD   H,A   
023D   7D                     LD   A,L   
023E   A3                     AND   E   
023F   6F                     LD   L,A   
0240                          ;*Macro unroll:  NEXT
0240                          DS   1-CPM,0F7h   
0240   DD                     DS   CPM,0DDh   
0241   E9                     DS   CPM,0E9h   
0242                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0242                             ; cells first. Flipping both sign bits turns a signed compare into an
0242                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0242                             ; carry into -1 or 0 with no branch.
0242   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0243   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0244   7C                     LD   A,H   
0245   EE 80                  XOR   80h   
0247   67                     LD   H,A   
0248   7A                     LD   A,D   
0249   EE 80                  XOR   80h   
024B   57                     LD   D,A   
024C   ED 52                  SBC   HL,DE   ; carry if HL < DE
024E   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0250                          ;*Macro unroll:  NEXT
0250                          DS   1-CPM,0F7h   
0250   DD                     DS   CPM,0DDh   
0251   E9                     DS   CPM,0E9h   
0252   D1           H_EQ:     POP   DE   
0253   B7                     OR   A   
0254   ED 52                  SBC   HL,DE   
0256   7C                     LD   A,H   
0257   B5                     OR   L   
0258   FE 01                  CP   1   ; carry only if a - b = 0
025A   18 F2                  JR   tf   
025C                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
025C                             ; multiplier shifts up through A:C.
025C   D1           H_MUL:    POP   DE   ; DE = multiplicand
025D   C5                     PUSH   BC   
025E   7C                     LD   A,H   
025F   4D                     LD   C,L   ; A:C = multiplier
0260   21 00 00               LD   HL,0   
0263   06 10                  LD   B,16   
0265   29           MUL1:     ADD   HL,HL   
0266   CB 21                  SLA   C   
0268   17                     RLA      
0269   30 01                  JR   NC,mul2   
026B   19                     ADD   HL,DE   
026C   10 F7        MUL2:     DJNZ   mul1   
026E   C1                     POP   BC   
026F                          ;*Macro unroll:  NEXT
026F                          DS   1-CPM,0F7h   
026F   DD                     DS   CPM,0DDh   
0270   E9                     DS   CPM,0E9h   
0271                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0271                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0271                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0271                             ; stops on it.
0271                H_DIV:       
0271                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0271                          ENDIF      
0271   D1                     POP   DE   ; DE = a, HL = b
0272   D5                     PUSH   DE   ; a, for r's sign
0273   7A                     LD   A,D   
0274   AC                     XOR   H   
0275   F5                     PUSH   AF   ; S flag = sign of q
0276   CB 7C                  BIT   7,H   
0278   C4 97 04               CALL   NZ,neg16   ; HL = |b|
027B   EB                     EX   DE,HL   
027C   CB 7C                  BIT   7,H   
027E   C4 97 04               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0281   CD 93 03               CALL   udiv   ; HL = q, DE = r
0284   F1                     POP   AF   
0285   FC 97 04               CALL   M,neg16   ; q's sign
0288   EB                     EX   DE,HL   ; HL = r, DE = q
0289   F1                     POP   AF   ; A = a's high byte
028A   B7                     OR   A   
028B   FC 97 04               CALL   M,neg16   ; r's sign
028E   D5                     PUSH   DE   ; q under r
028F                          ;*Macro unroll:  NEXT
028F                          DS   1-CPM,0F7h   
028F   DD                     DS   CPM,0DDh   
0290   E9                     DS   CPM,0E9h   
0291                             ; ---- stack and storage -----------------------------------------------------
0291   E5           H_DUP:    PUSH   HL   ; ":"
0292                          ;*Macro unroll:  NEXT
0292                          DS   1-CPM,0F7h   
0292   DD                     DS   CPM,0DDh   
0293   E9                     DS   CPM,0E9h   
0294   E3           H_SWAP:   EX   (SP),HL   ; "%"
0295                          ;*Macro unroll:  NEXT
0295                          DS   1-CPM,0F7h   
0295   DD                     DS   CPM,0DDh   
0296   E9                     DS   CPM,0E9h   
0297                             ; (The checked build tests the address before it takes the value off the
0297                             ; stack, so that an error report shows both.)
0297                H_CSTORE:      ; "." ( c addr -- )
0297                          IF   CHECKED   
                              CALL   chkst   
0297                          ENDIF      
0297   D1                     POP   DE   
0298   73                     LD   (HL),E   
0299                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
0299                H_DROP:   DS   1-CPM,0DFh   ; ";" is this one byte
0299   E1                     DS   CPM,0E1h   
029A   DD                     DS   CPM,0DDh   
029B   E9                     DS   CPM,0E9h   
029C                H_STORE:      ; "!" ( n addr -- )
029C                          IF   CHECKED   
                              CALL   chkst   
029C                          ENDIF      
029C   D1                     POP   DE   
029D   73                     LD   (HL),E   
029E   23                     INC   HL   
029F   72                     LD   (HL),D   
02A0                          ;*Macro unroll:  DROP
02A0                          DS   1-CPM,0DFh   
02A0   E1                     DS   CPM,0E1h   
02A1   DD                     DS   CPM,0DDh   
02A2   E9                     DS   CPM,0E9h   
02A3                             ; ---- console ---------------------------------------------------------------
02A3                             ; 22h pushes the address of the text after it and skips the string.
02A3   E5           H_STR:    PUSH   HL   
02A4   60                     LD   H,B   
02A5   69                     LD   L,C   
02A6   CD D2 03               CALL   skipstr   
02A9                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
02A9                          ENDIF      
02A9                          ;*Macro unroll:  NEXT
02A9                          DS   1-CPM,0F7h   
02A9   DD                     DS   CPM,0DDh   
02AA   E9                     DS   CPM,0E9h   
02AB                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02AB                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02AB                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02AB                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02AB                          IF   1-CHECKED   
02AB   7E           H_PRINT:   LD   A,(HL)   
02AC   23                     INC   HL   
02AD   FE 22                  CP   22h   
02AF   28 19                  JR   Z,pr9   
02B1   FE 2F                  CP   "/"   
02B3   20 0C                  JR   NZ,pr1   
02B5   7E                     LD   A,(HL)   
02B6   23                     INC   HL   
02B7   FE 60                  CP   60h   
02B9   38 04                  JR   C,pr0   
02BB   FE 7F                  CP   7Fh   
02BD   38 63                  JR   C,pesc   
02BF   E6 BF        PR0:      AND   0BFh   
02C1                          ;*Macro unroll: pr1:    PUTA
02C1                PR1:      DS   1-CPM,0EFh   
02C1   CD                     DS   CPM,0CDh   
02C2   A6                     DS   CPM,APUT&0FFh   
02C3   04                     DS   CPM,APUT/256   
02C4   18 E5                  JR   h_print   
02C6                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
02C6                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02C6                          ENDIF      
02C6                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   1-CPM,0DFh   
                              DS   CPM,0E1h   
                              DS   CPM,0DDh   
                              DS   CPM,0E9h   
02C6                          ENDIF      
02C6   7D           H_EMIT:   LD   A,L   ; "'"
02C7                          ;*Macro unroll:  PUTA
02C7                          DS   1-CPM,0EFh   
02C7   CD                     DS   CPM,0CDh   
02C8   A6                     DS   CPM,APUT&0FFh   
02C9   04                     DS   CPM,APUT/256   
02CA                          ;*Macro unroll: pr9:    DROP
02CA                PR9:      DS   1-CPM,0DFh   
02CA   E1                     DS   CPM,0E1h   
02CB   DD                     DS   CPM,0DDh   
02CC   E9                     DS   CPM,0E9h   
02CD                             ; "#" prints TOS as a signed decimal number, with no space after it.
02CD   CD 10 04     H_NUM:    CALL   psgn   
02D0                          ;*Macro unroll:  DROP
02D0                          DS   1-CPM,0DFh   
02D0   E1                     DS   CPM,0E1h   
02D1   DD                     DS   CPM,0DDh   
02D2   E9                     DS   CPM,0E9h   
02D3                             ; "?" ( n -- c ) or ( -n -- addr )
02D3                             ;   n > 0: wait about n ms for a key; 0 if none came
02D3                             ;   n = 0: wait for a key
02D3                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02D3                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02D3   CB 7C        H_KEY:    BIT   7,H   
02D5   20 1A                  JR   NZ,line   
02D7   1E 04        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02D9   CD 7C 04     KT2:      CALL   getk   
02DC   20 0E                  JR   NZ,kt3   
02DE   1D                     DEC   E   
02DF   20 F8                  JR   NZ,kt2   
02E1   7C                     LD   A,H   ; 0? never counts down: it waits
02E2   B5                     OR   L   
02E3   28 F2                  JR   Z,kt1   
02E5   2B                     DEC   HL   
02E6   7C                     LD   A,H   
02E7   B5                     OR   L   
02E8   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02EA   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02EB   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02EC   6F           KT3:      LD   L,A   
02ED   26 00                  LD   H,0   
02EF                          ;*Macro unroll:  NEXT
02EF                          DS   1-CPM,0F7h   
02EF   DD                     DS   CPM,0DDh   
02F0   E9                     DS   CPM,0E9h   
02F1                             ; Backspace takes the last character back (and is echoed as it
02F1                             ; is), CR ends (stored, not echoed), every other key is stored and
02F1                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02F1                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02F1                             ; is the place in the line: D holds the L of a full line.
02F1   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02F4   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02F5   9F                     SBC   A,A   
02F6   A5                     AND   L   ; (0 for a count that is too big)
02F7   2F                     CPL      
02F8   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
02F9                             ;   at most
02F9   21 80 0A               LD   HL,LINEBUF   
02FC   CD 7C 04     LN2:      CALL   getk   
02FF   28 FB                  JR   Z,ln2   
0301   FE 0D                  CP   13   
0303   28 18                  JR   Z,ln5   
0305   FE 08                  CP   8   
0307   28 0D                  JR   Z,ln4   
0309   5F                     LD   E,A   
030A   7D                     LD   A,L   
030B   BA                     CP   D   
030C   28 EE                  JR   Z,ln2   ; full
030E   73                     LD   (HL),E   
030F   2C                     INC   L   
0310   7B                     LD   A,E   
0311                          ;*Macro unroll: ln3:    PUTA
0311                LN3:      DS   1-CPM,0EFh   
0311   CD                     DS   CPM,0CDh   
0312   A6                     DS   CPM,APUT&0FFh   
0313   04                     DS   CPM,APUT/256   
0314   18 E6                  JR   ln2   
0316   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0317   FA 11 03               JP   M,ln3   ;   unless the line was empty (L left the
031A   2C                     INC   L   ;   upper half of the page)
031B   18 DF                  JR   ln2   
031D   77           LN5:      LD   (HL),A   ; the CR
031E   2E 80                  LD   L,LINEBUF & 0FFh   
0320                          ;*Macro unroll:  NEXT
0320                          DS   1-CPM,0F7h   
0320   DD                     DS   CPM,0DDh   
0321   E9                     DS   CPM,0E9h   
0322                             ; =============================================================================
0322                             ;  More routines (no handler starts past this point)
0322                             ; =============================================================================
0322                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
                              DB   13,10,22h   ;   the caller's text)
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
0322                          ENDIF      
0322                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0322                             ; HL points past it. Each goes back into the loop that prints the string
0322                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0322                             ;    /a-/z   print the variable, as "#" does
0322                             ;    /{      clear the screen, the cursor to the top left
0322                             ;    /}      clear from the cursor to the end of the line
0322                             ;    /|  /`  show the cursor, hide it
0322                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0322   FE 7E        PESC:     CP   7Eh   
0324   28 1C                  JR   Z,pat   
0326   11 AB 02               LD   DE,PRLOOP   ; the others return into the loop
0329   D5                     PUSH   DE   
032A   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
032C   30 45                  JR   NC,pcon   
032E   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0330   30 2E                  JR   NC,phide   
0332   87                     ADD   A,A   ; the variable's cell
0333   C6 40                  ADD   A,40h   
0335   E5                     PUSH   HL   
0336   6F                     LD   L,A   
0337   26 0A                  LD   H,LETPAGE   
0339   7E                     LD   A,(HL)   
033A   2C                     INC   L   
033B   66                     LD   H,(HL)   
033C   6F                     LD   L,A   
033D   CD 10 04               CALL   psgn   
0340   E1                     POP   HL   
0341   C9                     RET      
0342                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0342                             ; the checked build "$" is the routine prstr: its own return address goes
0342                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0342                             ; its two cells are there, and is s if not, before it prints anything.
0342                PAT:         
0342                          IF   CHECKED   
                              EX   (SP),HL   ; the text pointer over prstr's return address
                              LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              ADD   HL,SP   
                              JP   C,e_under   
                              POP   HL   
0342                          ENDIF      
0342   D1                     POP   DE   ; DE = the column
0343   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0344                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
0344                          ENDIF      
0344                          IF   ANS   
0344   D5                     PUSH   DE   
0345   CD 88 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0348   23                     INC   HL   
0349   CD 1B 04               CALL   pdec   
034C                          ;*Macro unroll:  PUTK    3Bh             ; ';'
034C                          DS   1-CPM,3Eh   ; ";"
034C                          DS   1-CPM,3Bh   
034C                          DS   1-CPM,0EFh   
034C   CD                     DS   CPM,0CDh   
034D   A2                     DS   CPM,APTK&0FFh   
034E   04                     DS   CPM,APTK/256   
034F   3B                     DS   CPM,3Bh   
0350   E1                     POP   HL   
0351   23                     INC   HL   
0352   CD 1B 04               CALL   pdec   
0355                          ;*Macro unroll:  PUTK    48h             ; 'H'
0355                          DS   1-CPM,3Eh   ; "H"
0355                          DS   1-CPM,48h   
0355                          DS   1-CPM,0EFh   
0355   CD                     DS   CPM,0CDh   
0356   A2                     DS   CPM,APTK&0FFh   
0357   04                     DS   CPM,APTK/256   
0358   48                     DS   CPM,48h   
0359   E1                     POP   HL   
035A   C3 AB 02               JP   PRAGAIN   
035D                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
035D   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
035F   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0360   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0362                          ENDIF      
0362                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0362                          ENDIF      
0362                          IF   ANS*(1-CHECKED)   
0362   3E 3F                  LD   A,"?"   
0364   CD 82 03               CALL   csia   
0367                          ;*Macro unroll:  PUTK    32h             ; '2'
0367                          DS   1-CPM,3Eh   ; "2"
0367                          DS   1-CPM,32h   
0367                          DS   1-CPM,0EFh   
0367   CD                     DS   CPM,0CDh   
0368   A2                     DS   CPM,APTK&0FFh   
0369   04                     DS   CPM,APTK/256   
036A   32                     DS   CPM,32h   
036B                          ;*Macro unroll:  PUTK    35h             ; '5'
036B                          DS   1-CPM,3Eh   ; "5"
036B                          DS   1-CPM,35h   
036B                          DS   1-CPM,0EFh   
036B   CD                     DS   CPM,0CDh   
036C   A2                     DS   CPM,APTK&0FFh   
036D   04                     DS   CPM,APTK/256   
036E   35                     DS   CPM,35h   
036F   7B                     LD   A,E   
0370                          ;*Macro unroll:  PUTAR
0370                          DS   1-CPM,0EFh   
0370                          DS   1-CPM,0C9h   
0370   C3                     DS   CPM,0C3h   
0371   A6                     DS   CPM,APUT&0FFh   
0372   04                     DS   CPM,APUT/256   
0373                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0373   3D           PCON:     DEC   A   
0374   28 E7                  JR   Z,pshow   ; /|
0376   3E 4B                  LD   A,"K"   
0378   F2 82 03               JP   P,csia   ; /}  ESC [ K
037B   3E 48                  LD   A,"H"   ; /{  ESC [ H ESC [ J
037D   CD 82 03               CALL   csia   
0380   3E 4A                  LD   A,"J"   ; (on into csia)
0382                             ; csia: ESC [ and then A. csi: ESC [, keeping A.
0382   CD 88 03     CSIA:     CALL   csi   
0385                          ;*Macro unroll:  PUTAR
0385                          DS   1-CPM,0EFh   
0385                          DS   1-CPM,0C9h   
0385   C3                     DS   CPM,0C3h   
0386   A6                     DS   CPM,APUT&0FFh   
0387   04                     DS   CPM,APUT/256   
0388   F5           CSI:      PUSH   AF   
0389                          ;*Macro unroll:  PUTK    1Bh             ; ESC
0389                          DS   1-CPM,3Eh   ; ESC
0389                          DS   1-CPM,1Bh   
0389                          DS   1-CPM,0EFh   
0389   CD                     DS   CPM,0CDh   
038A   A2                     DS   CPM,APTK&0FFh   
038B   04                     DS   CPM,APTK/256   
038C   1B                     DS   CPM,1Bh   
038D                          ;*Macro unroll:  PUTK    5Bh             ; '['
038D                          DS   1-CPM,3Eh   ; "["
038D                          DS   1-CPM,5Bh   
038D                          DS   1-CPM,0EFh   
038D   CD                     DS   CPM,0CDh   
038E   A2                     DS   CPM,APTK&0FFh   
038F   04                     DS   CPM,APTK/256   
0390   5B                     DS   CPM,5Bh   
0391   F1                     POP   AF   
0392   C9                     RET      
0393                          ENDIF      
0393                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0393                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0393                             ; the quotient bits arrive at the bottom of C.
0393                             ; Dividing by 2 is one shift (the spec wants that fast).
0393   7B           UDIV:     LD   A,E   
0394   EE 02                  XOR   2   
0396   B2                     OR   D   
0397   20 07                  JR   NZ,udv0   
0399   CB 3C                  SRL   H   
039B   CB 1D                  RR   L   ; the quotient
039D   8F                     ADC   A,A   
039E   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
039F   C9                     RET      
03A0   C5           UDV0:     PUSH   BC   
03A1   7C                     LD   A,H   
03A2   4D                     LD   C,L   
03A3   21 00 00               LD   HL,0   
03A6   06 10                  LD   B,16   
03A8   CB 21        UDV1:     SLA   C   
03AA   17                     RLA      
03AB   ED 6A                  ADC   HL,HL   
03AD   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03AF   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03B1   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03B2   0D                     DEC   C   ;   INC below
03B3   0C           UDV2:     INC   C   ; a quotient bit
03B4   10 F2                  DJNZ   udv1   
03B6   EB                     EX   DE,HL   ; DE = remainder
03B7   67                     LD   H,A   
03B8   69                     LD   L,C   ; HL = quotient
03B9   C1                     POP   BC   
03BA   C9                     RET      
03BB                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
03BB                             ; non-digit. Values wrap at 16 bits, as the spec says.
03BB   21 00 00     RDNUM:    LD   HL,0   
03BE   0A           RDN1:     LD   A,(BC)   
03BF   D6 30                  SUB   "0"   
03C1   FE 0A                  CP   10   
03C3   D0                     RET   NC   
03C4   03                     INC   BC   
03C5   54                     LD   D,H   
03C6   5D                     LD   E,L   
03C7   29                     ADD   HL,HL   
03C8   29                     ADD   HL,HL   
03C9   19                     ADD   HL,DE   
03CA   29                     ADD   HL,HL   ; HL * 10
03CB   5F                     LD   E,A   
03CC   16 00                  LD   D,0   
03CE   19                     ADD   HL,DE   
03CF   18 ED                  JR   rdn1   
03D1                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03D1                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03D1                          IF   1-CHECKED   
03D1   03           SS0:      INC   BC   
03D2   0A           SKIPSTR:   LD   A,(BC)   
03D3   03                     INC   BC   
03D4   FE 2F                  CP   "/"   
03D6   28 F9                  JR   Z,ss0   
03D8   FE 22                  CP   22h   
03DA   20 F6                  JR   NZ,skipstr   
03DC   C9                     RET      
03DD                          ENDIF      
03DD                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
03DD                          ENDIF      
03DD                             ; skip: read past text to the closer at this level, and return A = 0 if it
03DD                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03DD                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03DD                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03DD                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03DD                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
03DD                             ; 
03DD                             ; The checked build also looks at the character the skip was started by,
03DD                             ; which is always the one just before where it starts: "(" must end at ")",
03DD                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03DD                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
03DD                             ; place where the skip started, for the report.
03DD                SKIP:        
03DD                          IF   CHECKED   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
03DD                          ENDIF      
03DD   16 00                  LD   D,0   
03DF   14           SK3:      INC   D   ; an opener: one deeper
03E0   0A           SK1:      LD   A,(BC)   
03E1                          IF   1-CHECKED   
03E1   03                     INC   BC   
03E2   B7                     OR   A   
03E3   CA FC 04               JP   Z,SKEND   ; (the end of the program)
03E6                          ENDIF      
03E6                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
03E6                          ENDIF      
03E6   FE 22                  CP   22h   
03E8   CC D2 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
03EB   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
03ED   28 F0                  JR   Z,sk3   
03EF   3D                     DEC   A   ; ")"
03F0   28 08                  JR   Z,sk4   
03F2   D6 32                  SUB   "["-")"   
03F4   28 E9                  JR   Z,sk3   
03F6   FE 02                  CP   "]"-"["   
03F8   20 E6                  JR   NZ,sk1   
03FA   15           SK4:      DEC   D   
03FB                          IF   1-CHECKED   
03FB   C8                     RET   Z   ; the closer at this level
03FC   18 E2                  JR   sk1   
03FE                          ENDIF      
03FE                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
03FE                          ENDIF      
03FE                             ; =============================================================================
03FE                             ;  Dispatch table: the low byte of each handler's address, in code order
03FE                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03FE                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03FE                             ; =============================================================================
03FE                             ; The handlers of the first NPG1 characters start in the image's second page.
03FE                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03FE                             ; differs between the builds, so the count is worked out here.
03FE                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03FE                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03FE                PGBRK:    EQU   (h_break-BASE)/256   
03FE                PGDEF:    EQU   (h_def-BASE)/256   
03FE                PGFET:    EQU   (h_fetch-BASE)/256   
03FE                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03FE                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
03FE                          ENDIF      
03FE                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03FE                             ; and return its value in A with the carry set; otherwise leave the IP and
03FE                             ; return with the carry clear.
03FE   0A           HEXC:     LD   A,(BC)   
03FF   D6 30                  SUB   "0"   
0401   FE 0A                  CP   10   
0403   38 09                  JR   C,hc1   
0405   E6 DF                  AND   0DFh   
0407   D6 11                  SUB   11h   
0409   FE 06                  CP   6   
040B   D0                     RET   NC   
040C   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
040E   03           HC1:      INC   BC   
040F   C9                     RET      
0410                             ; psgn: print HL as a signed number. Keeps BC.
0410   CB 7C        PSGN:     BIT   7,H   
0412   28 07                  JR   Z,pdec   
0414                          ;*Macro unroll:  PUTK    2Dh             ; '-'
0414                          DS   1-CPM,3Eh   ; "-"
0414                          DS   1-CPM,2Dh   
0414                          DS   1-CPM,0EFh   
0414   CD                     DS   CPM,0CDh   
0415   A2                     DS   CPM,APTK&0FFh   
0416   04                     DS   CPM,APTK/256   
0417   2D                     DS   CPM,2Dh   
0418                          ;*Macro unroll:  NEGH
0418                          DS   1-CPM,0E7h   
0418   CD                     DS   CPM,0CDh   
0419   97                     DS   CPM,ANEG&0FFh   
041A   04                     DS   CPM,ANEG/256   
041B                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
041B                             ; Keeps BC.
041B   11 0A 00     PDEC:     LD   DE,10   
041E   CD 93 03               CALL   udiv   ; HL = HL / 10, E = the last digit
0421   7B                     LD   A,E   
0422   F5                     PUSH   AF   
0423   7C                     LD   A,H   
0424   B5                     OR   L   
0425   C4 1B 04               CALL   NZ,pdec   
0428   F1                     POP   AF   
0429   C6 30                  ADD   A,"0"   
042B                          ;*Macro unroll:  PUTAR
042B                          DS   1-CPM,0EFh   
042B                          DS   1-CPM,0C9h   
042B   C3                     DS   CPM,0C3h   
042C   A6                     DS   CPM,APUT&0FFh   
042D   04                     DS   CPM,APUT/256   
042E                             ; (The table goes here instead in the builds where, before psgn, it would
042E                             ; cross a page: PTLATE.)
042E                          IF   (1-TABP0)*PTLATE   
042E                PTAB:        
042E                          ;*Macro unroll:  PTABLE
042E   9C                     DB   h_store & 0FFh   
042F   A3                     DB   h_str & 0FFh   
0430   CD                     DB   h_num & 0FFh   
0431   AB                     DB   h_print & 0FFh   
0432   94                     DB   h_swap & 0FFh   
0433   39                     DB   h_and & 0FFh   
0434   C6                     DB   h_emit & 0FFh   
0435   0C                     DB   h_open & 0FFh   
0436   14                     DB   h_close & 0FFh   
0437   5C                     DB   h_mul & 0FFh   
0438   2C                     DB   h_add & 0FFh   
0439   EB                     DB   h_cfetch & 0FFh   
043A   22                     DB   h_sub & 0FFh   
043B   97                     DB   h_cstore & 0FFh   
043C   71                     DB   h_div & 0FFh   
043D   91                     DB   h_dup & 0FFh   
043E   99                     DB   h_drop & 0FFh   
043F   42                     DB   h_lt & 0FFh   
0440   52                     DB   h_eq & 0FFh   
0441   43                     DB   h_gt & 0FFh   
0442   D3                     DB   h_key & 0FFh   
0443   06                     DB   h_fetch & 0FFh   
0444   E8                     DB   h_def & 0FFh   
0445   D8                     DB   h_break & 0FFh   
0446   D1                     DB   h_ret & 0FFh   
0447   53                     DB   h_xor & 0FFh   
0448   6B                     DB   h_alloc & 0FFh   
0449   BA                     DB   h_grave & 0FFh   
044A   B6                     DB   h_tor & 0FFh   
044B   5C                     DB   h_or & 0FFh   
044C   09                     DB   h_fromr & 0FFh   
044D   65                     DB   h_not & 0FFh   
044E                PTABEND:      
044E                          ENDIF      
044E                             ; =============================================================================
044E                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
044E                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
044E                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
044E                             ;  they are the host's KEY and CONOUT routines themselves.
044E                             ; 
044E                             ;  A running program reads the keyboard only through getk and pollk, which
044E                             ;  between them give the break key its rules:
044E                             ;    - Ctrl-C stops the program;
044E                             ;    - any other key that the break check reads is held in KEYBUF for the
044E                             ;      next "?", and a newer one takes its place;
044E                             ;    - "?" (getk) takes the held key first;
044E                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
044E                             ;      key like any other, but two of them within about 250 ms still stop it.
044E                             ;  Both are called straight from a handler, never from a routine under one:
044E                             ;  the checked build's report counts on finding one return address above the
044E                             ;  data stack.
044E                             ; =============================================================================
044E                          IFN   CPM   
                    RAWK:     EQU   KEY   
044E                          ENDIF      
044E                             ; pollk: the break check (see rpushn).
044E   CD 9E 04     POLLK:    CALL   rawk   
0451   C8                     RET   Z   ; no key
0452   32 7A 0A               LD   (KEYBUF),A   ; held for the next "?"
0455   FE 03        PK1:      CP   3   ; (getk joins here)
0457   C0                     RET   NZ   
0458                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0458                             ; the program has turned it off, wait about 250 ms for one more key: a
0458                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0458                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0458   3A 7B 0A     CTLC:     LD   A,(BRKOFF)   
045B   B7                     OR   A   
045C   CA F4 04     CT0:      JP   Z,brk   
045F   D5                     PUSH   DE   
0460   11 E8 03               LD   DE,250*MSLOOP   
0463   CD 9E 04     CT1:      CALL   rawk   
0466   20 05                  JR   NZ,ct2   
0468   1B                     DEC   DE   
0469   7A                     LD   A,D   
046A   B3                     OR   E   
046B   20 F6                  JR   NZ,ct1   
046D   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
046E   FE 03                  CP   3   
0470   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0472   B7                     OR   A   
0473   28 03                  JR   Z,ct3   
0475   32 7A 0A               LD   (KEYBUF),A   
0478   3E 03        CT3:      LD   A,3   
047A   B7                     OR   A   
047B   C9                     RET      
047C                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
047C   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
047D   21 7A 0A               LD   HL,KEYBUF   ;   the buffer
0480   7E                     LD   A,(HL)   
0481   36 00                  LD   (HL),0   
0483   E1                     POP   HL   
0484   B7                     OR   A   
0485   C0                     RET   NZ   
0486   CD 9E 04               CALL   rawk   
0489   C8                     RET   Z   
048A   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
048C                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
048C                          ENDIF      ;   (with the editor, both stacks are cleared);
048C                          IF   (1-CHECKED)*EDITOR   
048C                BRK:      EQU   edit0   
048C                          ENDIF      
048C                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
048C                          ENDIF      
048C                          IF   CPM   
048C                             ; The routines a generic build keeps in page zero (see there). Here they are
048C                             ; out of the way of the handlers, which must fit in the image's first two
048C                             ; pages.
048C   FD 5E 00     RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
048F   FD 56 01               LD   D,(IY+1)   
0492   FD 23                  INC   IY   
0494   FD 23                  INC   IY   
0496   C9                     RET      
0497   AF           NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
0498   95                     SUB   L   
0499   6F                     LD   L,A   
049A   9F                     SBC   A,A   
049B   94                     SUB   H   
049C   67                     LD   H,A   
049D   C9                     RET      
049E                          ENDIF      
049E                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM,0DDh   
                              DS   CPM,21h   
                              DS   CPM,ANXT&0FFh   
                              DS   CPM,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   1-CPM,0F7h   
                              DS   CPM,0DDh   
                              DS   CPM,0E9h   
049E                          ENDIF      
049E                          IF   CPM   
049E   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
04A0   18 04                  JR   putc   
04A2   E3           PUTK:     EX   (SP),HL   ; print the byte after the CALL
04A3   7E                     LD   A,(HL)   
04A4   23                     INC   HL   
04A5   E3                     EX   (SP),HL   
04A6                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
04A6                             ; printing and could swallow a key that BDOS 6 then never sees.
04A6                             ; It keeps every register but A and the flags: BDOS may change any of them
04A6                             ; (IX and IY too, in a Z80 BDOS or BIOS).
04A6   C5           PUTC:     PUSH   BC   
04A7   D5                     PUSH   DE   
04A8   E5                     PUSH   HL   
04A9   DD E5                  PUSH   IX   
04AB   FD E5                  PUSH   IY   
04AD   5F                     LD   E,A   
04AE   0E 06                  LD   C,6   
04B0   CD 05 00               CALL   BDOS   
04B3   FD E1                  POP   IY   
04B5   DD E1                  POP   IX   
04B7   E1                     POP   HL   
04B8   D1                     POP   DE   
04B9   C1                     POP   BC   
04BA   B7                     OR   A   ; (for getk)
04BB   C9                     RET      
04BC                          ENDIF      
04BC                             ; =============================================================================
04BC                             ;  Checked build: the checks and the error report
04BC                             ; =============================================================================
04BC                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              PUSH   IY   ; the return stack: in its page (or it has
                              POP   DE   ;   overflowed), and not above its empty
                              LD   A,D   ;   position (an underflow stays inside the
                              CP   RSPAGE   ;   page, in the guard band)
                              LD   A,E   
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              LD   IY,RSTOP   ; return stack underflow: it counts as empty
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
04BC                          ENDIF      
04BC                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
04BC                          ENDIF      
04BC                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
04BC                          ENDIF      
04BC                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
04BC                          ENDIF      
04BC                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
04BC                          ENDIF      
04BC                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
04BC                          ENDIF      
04BC                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              ;*Macro unroll:  PUTK    2Ch             ; ','
                              DS   1-CPM,3Eh   ; ","
                              DS   1-CPM,2Ch   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,2Ch   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
                                 ;                       R:n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "D:",22h   
                              LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
                              SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
                                 ;   and holds nothing; pnl left the carry clear)
                              CALL   phalf   ; the depth
                              ;*Macro unroll:  PUTK    3Ah             ; ':'
                              DS   1-CPM,3Eh   ; ":"
                              DS   1-CPM,3Ah   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Ah   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              ;*Macro unroll:  PUTK    20h             ; ' '
                              DS   1-CPM,3Eh   ; " "
                              DS   1-CPM,20h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,20h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
                              POP   HL   ;   at most one entry below its page), so
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough
                              SUB   L   
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
04BC                          ENDIF      
04BC                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
04BC                          ENDIF      
04BC                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
04BC                          ENDIF      
04BC                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
04BC                          ENDIF      
04BC                             ; =============================================================================
04BC                             ;  The line editor (EDITOR = 1)
04BC                             ; 
04BC                             ;  The interpreter starts here, and a program that ends comes back here.
04BC                             ;  There is no prompt. It follows the spec's suggested standard for a line
04BC                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
04BC                             ; 
04BC                             ;    n text    put the text in as line n; the lines from n on move down. A
04BC                             ;              number past the end (or 0) adds the line at the end.
04BC                             ;    n         take line n out
04BC                             ;    anything else is run at once, as B8Script. (Start such a line with a
04BC                             ;    space if it would begin with a digit.)
04BC                             ; 
04BC                             ;  A command key ends the line too, and takes what was typed as its argument:
04BC                             ; 
04BC                             ;    ^G        run the program
04BC                             ;    n ^L      list from line n (no number: all of it). Any key holds the
04BC                             ;              list until another key is pressed; Ctrl-C ends it.
04BC                             ;    n ^E      put line n in the input line; Return puts it back, changed
04BC                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
04BC                             ;              last time). Generic: what is typed, or pasted, from now until
04BC                             ;              ^Z replaces the program; it is not echoed.
04BC                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
04BC                             ;              time). Generic: the text is printed, as it is.
04BC                             ;    ^N        new: no program
04BC                             ;    ^X        leave (to LEAVE)
04BC                             ; 
04BC                             ;  In the line: the left and right arrow keys move the cursor;
04BC                             ;  a character goes in at the cursor; Backspace and DEL take out the one
04BC                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
04BC                             ;  sent to the terminal, so any terminal will do.
04BC                             ; 
04BC                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
04BC                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
04BC                             ;  125 characters; the one character after a line number separates it from
04BC                             ;  the text and is not stored. The text is kept as it is typed, each line
04BC                             ;  ending in CR LF, at PROG.
04BC                             ; 
04BC                             ;  What lasts from one line to the next: the program, the words, the
04BC                             ;  variables and the data stack. An error or a break clears both stacks. The
04BC                             ;  return stack starts empty for every line.
04BC                             ; 
04BC                             ;  Things to know:
04BC                             ;    - Reset empties the program (generic builds).
04BC                             ;    - A word's address points into the program, so run the program again
04BC                             ;      after editing it.
04BC                             ;    - Nothing is printed between a program's output and what is typed next.
04BC                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
04BC                             ;      a line that calls -n? and carries on afterwards runs what was typed.
04BC                             ;      (The stored program never comes back to the line, so it may.)
04BC                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
04BC                             ;      read of the other builds.
04BC                             ; 
04BC                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
04BC                             ;  the last line left there, with TOS pushed like the rest.
04BC                             ; =============================================================================
04BC                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
04BC                          ENDIF      
04BC                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
04BC                          ENDIF      
04BC                          IF   EDGEN   
                              JR   edit0   
04BC                          ENDIF      
04BC                          IF   EDITOR   
04BC                             ; Right arrow: one to the right, by printing the character there
04BC   7D           RIGHT:    LD   A,L   
04BD   BB                     CP   E   
04BE   28 53                  JR   Z,ed1   ; at the end
04C0   7E                     LD   A,(HL)   
04C1   2C                     INC   L   
04C2   18 2B                  JR   lf1   
04C4                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
04C4                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
04C4                             ; ends the sequence, and act on C (right) and D (left).
04C4   01 14 00     ESC:      LD   BC,5*MSLOOP   
04C7   CD 9E 04     ES1:      CALL   rawk   
04CA   20 0A                  JR   NZ,es2   
04CC   0B                     DEC   BC   
04CD   78                     LD   A,B   
04CE   B1                     OR   C   
04CF   20 F6                  JR   NZ,es1   
04D1   CD 40 05               CALL   fin   ; no second key: the line is dropped
04D4   18 28                  JR   edit   
04D6   FE 5B        ES2:      CP   "["   
04D8   20 39                  JR   NZ,ed1   ; not a sequence known here
04DA   CD 9F 05     ES3:      CALL   ekey   
04DD   FE 40                  CP   40h   
04DF   38 F9                  JR   C,es3   ; (its parameters)
04E1   D6 43                  SUB   "C"   
04E3   28 D7                  JR   Z,right   
04E5   3D                     DEC   A   ; "D"?
04E6   20 2B                  JR   NZ,ed1   ; no: on into left
04E8                             ; Left arrow: the cursor goes one to the left
04E8   7D           LEFT:     LD   A,L   
04E9   87                     ADD   A,A   
04EA   28 27                  JR   Z,ed1   ; (L = 80h: at the start)
04EC   2D                     DEC   L   
04ED   3E 08                  LD   A,8   
04EF                          ;*Macro unroll: lf1:    PUTA
04EF                LF1:      DS   1-CPM,0EFh   
04EF   CD                     DS   CPM,0CDh   
04F0   A6                     DS   CPM,APUT&0FFh   
04F1   04                     DS   CPM,APUT/256   
04F2   18 1F                  JR   ed1   
04F4                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
04F4                             ;   is shown, in case the program had hidden it and could not show it again.
04F4                             ; skend: a program that ended inside skip: its return address goes.
04F4                             ; edend: a program that ended: TOS joins the rest of the data stack.
04F4   31 FA 09     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
04F7                          ENDIF      
04F7                          IF   EDITOR*ANS   
04F7   AF                     XOR   A   ; (pshow wants the carry clear)
04F8   CD 5D 03               CALL   pshow   ; ESC [ ? 2 5 h
04FB                          ENDIF      
04FB                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
04FB                          ENDIF      
04FB                          IF   EDITOR   
04FB   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
04FC   D1           SKEND:    POP   DE   
04FD   E5           EDEND:    PUSH   HL   
04FE                             ; edit: start a new input line.
04FE   FD 21 E0 08  EDIT:     LD   IY,RSTOP   ; the return stack is empty
0502                          ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
0502   DD                     DS   CPM,0DDh   ; (a file read or written may have changed IX)
0503   21                     DS   CPM,21h   
0504   17                     DS   CPM,ANXT&0FFh   
0505   01                     DS   CPM,ANXT/256   
0506   21 00 00               LD   HL,0   
0509   22 7A 0A               LD   (KEYBUF),HL   ; no key is held, and the break key is on
050C   22 3A 0A               LD   (EDLN),HL   ; no line is being edited
050F   21 80 0A               LD   HL,LINEBUF   ; HL = the cursor,
0512   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0513   CD 9F 05     ED1:      CALL   ekey   
0516   FE 7F                  CP   7Fh   
0518   28 38                  JR   Z,bsp   ; DEL
051A   FE 20                  CP   " "   
051C   30 4F                  JR   NC,insc   
051E   FE 09                  CP   9   
0520   28 4B                  JR   Z,insc   ; Tab is text
0522   FE 08                  CP   8   
0524   28 2C                  JR   Z,bsp   
0526   FE 1B                  CP   1Bh   
0528   28 9A                  JR   Z,esc   
052A   E5                     PUSH   HL   ; a command key? Look it up
052B   21 A5 05               LD   HL,cmds   
052E   06 08                  LD   B,NCMD   
0530   BE           ED2:      CP   (HL)   
0531   23                     INC   HL   
0532   28 07                  JR   Z,ed3   
0534   23                     INC   HL   
0535   23                     INC   HL   
0536   10 F8                  DJNZ   ed2   
0538   E1                     POP   HL   
0539   18 D8                  JR   ed1   ; no: the key is ignored
053B   7E           ED3:      LD   A,(HL)   
053C   23                     INC   HL   
053D   66                     LD   H,(HL)   
053E   6F                     LD   L,A   
053F   E3                     EX   (SP),HL   ; the command's address: fin returns to it
0540                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
0540                             ; terminal. Leaves BC -> the line and HL -> the NUL.
0540   26 0A        FIN:      LD   H,LETPAGE   
0542   6B                     LD   L,E   
0543   36 0D                  LD   (HL),13   
0545   2C                     INC   L   
0546   36 0A                  LD   (HL),10   
0548   2D                     DEC   L   
0549   CD A4 06               CALL   prl   ; (prints the CR LF)
054C   36 00                  LD   (HL),0   
054E   01 80 0A               LD   BC,LINEBUF   
0551   C9                     RET      
0552                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
0552                             ; left, the rest of the line moves down over it, and the last place (now a
0552                             ; space) is printed over along with the rest.
0552   7D           BSP:      LD   A,L   
0553   87                     ADD   A,A   
0554   28 BD                  JR   Z,ed1   ; at the start
0556   2D                     DEC   L   
0557                          ;*Macro unroll:  PUTK    08h             ; backspace
0557                          DS   1-CPM,3Eh   ; backspace
0557                          DS   1-CPM,08h   
0557                          DS   1-CPM,0EFh   
0557   CD                     DS   CPM,0CDh   
0558   A2                     DS   CPM,APTK&0FFh   
0559   04                     DS   CPM,APTK/256   
055A   08                     DS   CPM,08h   
055B   E5                     PUSH   HL   
055C   2C           BS1:      INC   L   
055D   7E                     LD   A,(HL)   
055E   2D                     DEC   L   
055F   77                     LD   (HL),A   
0560   2C                     INC   L   
0561   7D                     LD   A,L   
0562   BB                     CP   E   
0563   20 F7                  JR   NZ,bs1   
0565   2D                     DEC   L   
0566   36 20                  LD   (HL)," "   
0568   E1                     POP   HL   
0569   53                     LD   D,E   
056A   1D                     DEC   E   
056B   18 17                  JR   ic2   
056D                             ; A character goes in at the cursor: it ripples up through the rest of the
056D                             ; line, the cursor moves on, and the rest is printed again.
056D   47           INSC:     LD   B,A   
056E   7B                     LD   A,E   
056F   FE FD                  CP   0FDh   
0571   28 A0                  JR   Z,ed1   ; the line is full: 125 characters
0573   78                     LD   A,B   
0574                          ;*Macro unroll:  PUTA
0574                          DS   1-CPM,0EFh   
0574   CD                     DS   CPM,0CDh   
0575   A6                     DS   CPM,APUT&0FFh   
0576   04                     DS   CPM,APUT/256   
0577   E5                     PUSH   HL   
0578   7E           IC1:      LD   A,(HL)   
0579   70                     LD   (HL),B   
057A   47                     LD   B,A   
057B   7D                     LD   A,L   
057C   2C                     INC   L   
057D   BB                     CP   E   
057E   20 F8                  JR   NZ,ic1   
0580   E1                     POP   HL   
0581   2C                     INC   L   
0582   1C                     INC   E   
0583   53                     LD   D,E   
0584   CD 89 05     IC2:      CALL   tail   
0587   18 8A                  JR   ed1   
0589                             ; tail: print the line from the cursor to D (a low byte), and bring the
0589                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0589   4D           TAIL:     LD   C,L   
058A   7D           TA1:      LD   A,L   
058B   BA                     CP   D   
058C   28 07                  JR   Z,ta2   
058E   7E                     LD   A,(HL)   
058F                          ;*Macro unroll:  PUTA
058F                          DS   1-CPM,0EFh   
058F   CD                     DS   CPM,0CDh   
0590   A6                     DS   CPM,APUT&0FFh   
0591   04                     DS   CPM,APUT/256   
0592   2C                     INC   L   
0593   18 F5                  JR   ta1   
0595   7D           TA2:      LD   A,L   
0596   B9                     CP   C   
0597   C8                     RET   Z   
0598                          ;*Macro unroll:  PUTK    08h             ; backspace
0598                          DS   1-CPM,3Eh   ; backspace
0598                          DS   1-CPM,08h   
0598                          DS   1-CPM,0EFh   
0598   CD                     DS   CPM,0CDh   
0599   A2                     DS   CPM,APTK&0FFh   
059A   04                     DS   CPM,APTK/256   
059B   08                     DS   CPM,08h   
059C   2D                     DEC   L   
059D   18 F6                  JR   ta2   
059F                             ; ekey: wait for a key
059F   CD 9E 04     EKEY:     CALL   rawk   
05A2   28 FB                  JR   Z,ekey   
05A4   C9                     RET      
05A5                             ; The command keys, and where each goes (after fin).
05A5   0D           CMDS:     DB   13   
05A6   EF 05                  DW   cret   
05A8   07                     DB   7   ; ^G
05A9   37 06                  DW   crun   
05AB   0C                     DB   12   ; ^L
05AC   4A 06                  DW   clist   
05AE   05                     DB   5   ; ^E
05AF   C3 05                  DW   cedln   
05B1   12                     DB   18   ; ^R
05B2   3B 07                  DW   cread   
05B4   17                     DB   23   ; ^W
05B5   AF 06                  DW   cwrite   
05B7   0E                     DB   14   ; ^N
05B8   BD 05                  DW   cnew   
05BA   18                     DB   24   ; ^X
05BB   00 00                  DW   LEAVE   
05BD                NCMD:     EQU   8   
05BD                             ; ^N: no program
05BD   AF           CNEW:     XOR   A   
05BE   32 00 0B               LD   (PROG),A   
05C1   18 71        GED0:     JR   gedit   
05C3                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
05C3                             ; line it was: Return puts the text back in its place.
05C3   CD BB 03     CEDLN:    CALL   rdnum   
05C6   E5                     PUSH   HL   
05C7   CD 8C 06               CALL   find   ; HL -> the line, or the NUL if there is none
05CA   D1                     POP   DE   
05CB   7E                     LD   A,(HL)   
05CC   B7                     OR   A   
05CD   28 F2                  JR   Z,ged0   
05CF   ED 53 3A 0A            LD   (EDLN),DE   
05D3   11 80 0A               LD   DE,LINEBUF   
05D6   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
05D7   FE 0D                  CP   13   
05D9   28 0F                  JR   Z,ce2   
05DB   FE 0A                  CP   10   
05DD   28 0B                  JR   Z,ce2   
05DF   12                     LD   (DE),A   
05E0                          ;*Macro unroll:  PUTA
05E0                          DS   1-CPM,0EFh   
05E0   CD                     DS   CPM,0CDh   
05E1   A6                     DS   CPM,APUT&0FFh   
05E2   04                     DS   CPM,APUT/256   
05E3   23                     INC   HL   
05E4   1C                     INC   E   
05E5   7B                     LD   A,E   
05E6   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
05E8   20 EC                  JR   NZ,ce1   
05EA   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
05EB   5D                     LD   E,L   
05EC   C3 13 05               JP   ed1   
05EF                             ; Return. If ^E put a line here, the text goes back in its place. If not:
05EF                             ; a number and text is a line to put in, a number alone a line to take out,
05EF                             ; and anything else is run where it is.
05EF   E5           CRET:     PUSH   HL   ; the end of what was typed
05F0   2A 3A 0A               LD   HL,(EDLN)   
05F3   7C                     LD   A,H   
05F4   B5                     OR   L   
05F5   28 07                  JR   Z,cr1   
05F7   E5                     PUSH   HL   
05F8   CD 7C 06               CALL   delln   
05FB   E1                     POP   HL   
05FC   18 13                  JR   ins   
05FE   CD BB 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0601   79                     LD   A,C   ; C is still 80h if there was no number:
0602   87                     ADD   A,A   ;   only then is twice it 0
0603   28 36                  JR   Z,st0p   ; no number: run the line
0605   0A                     LD   A,(BC)   
0606   FE 0D                  CP   13   
0608   20 06                  JR   NZ,cr2   
060A   D1                     POP   DE   ; the number alone: take that line out
060B   CD 7C 06               CALL   delln   
060E   18 24                  JR   gedit   
0610   03           CR2:      INC   BC   ; step over the one character after the number
0611                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0611                             ; CR and LF included, and copy it in.
0611   CD 8C 06     INS:      CALL   find   ; HL -> where it goes
0614   D1                     POP   DE   ; the end of what was typed
0615   7B                     LD   A,E   
0616   91                     SUB   C   ; A = the length of the text, with its CR LF
0617   C5                     PUSH   BC   ; the text
0618   4F                     LD   C,A   
0619   06 00                  LD   B,0   
061B   C5                     PUSH   BC   ; its length
061C   54                     LD   D,H   
061D   5D                     LD   E,L   ; DE = where it goes
061E   AF                     XOR   A   
061F   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0620   ED B1                  CPIR      ; HL -> one past the program's NUL
0622   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0624   44                     LD   B,H   
0625   4D                     LD   C,L   
0626   19                     ADD   HL,DE   
0627   2B                     DEC   HL   ; HL -> the NUL
0628   EB                     EX   DE,HL   
0629   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
062A   E5                     PUSH   HL   
062B   19                     ADD   HL,DE   ; the NUL's new place
062C   EB                     EX   DE,HL   
062D   ED B8                  LDDR      ; move the rest of the program up
062F   C1                     POP   BC   ; the length
0630   D1                     POP   DE   ; where it goes
0631   E1                     POP   HL   ; the text
0632   ED B0                  LDIR      
0634   C3 FE 04     GEDIT:    JP   edit   
0637                             ; ^G: run the program. st0p: run the typed line (BC -> it).
0637   01 00 0B     CRUN:     LD   BC,PROG   
063A   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
063B   E1           ST0P:     POP   HL   ; (the end of what was typed)
063C                             ; st0: start running at BC. The heap starts after the stored program's NUL.
063C   21 00 0B     ST0:      LD   HL,PROG   
063F   AF                     XOR   A   
0640   BE           ST1:      CP   (HL)   
0641   23                     INC   HL   
0642   20 FC                  JR   NZ,st1   
0644   22 7C 0A               LD   (HEAP),HL   
0647                          ENDIF      
0647                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0647                          ENDIF      
0647                          IF   EDITOR   
0647   E1                     POP   HL   ; TOS: the data stack is as the last line left it
0648                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0648                          DS   1-CPM,0F7h   ; (its return address is thrown away)
0648   DD                     DS   CPM,0DDh   
0649   E9                     DS   CPM,0E9h   
064A                             ; ^L: list from line n. DE = the number of the line at HL.
064A   CD BB 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
064D   7C                     LD   A,H   
064E   B5                     OR   L   
064F   20 01                  JR   NZ,li0   
0651   2C                     INC   L   ;   then from line 1
0652   E5           LI0:      PUSH   HL   
0653   CD 8C 06               CALL   find   
0656   D1                     POP   DE   
0657   7E           LI1:      LD   A,(HL)   
0658   B7                     OR   A   
0659   28 D9                  JR   Z,gedit   ; the end of the text
065B   CD 9E 04               CALL   rawk   
065E   28 09                  JR   Z,li3   ; no key: carry on
0660   FE 03                  CP   3   
0662   C4 9F 05               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
0665   FE 03                  CP   3   
0667   28 CB                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
0669   E5           LI3:      PUSH   HL   
066A   D5                     PUSH   DE   
066B   EB                     EX   DE,HL   
066C   CD 1B 04               CALL   pdec   ; the line's number,
066F   3E 20                  LD   A," "   
0671                          ;*Macro unroll:  PUTA                    ;   a space,
0671                          DS   1-CPM,0EFh   ;   a space,
0671   CD                     DS   CPM,0CDh   
0672   A6                     DS   CPM,APUT&0FFh   
0673   04                     DS   CPM,APUT/256   
0674   D1                     POP   DE   
0675   E1                     POP   HL   
0676   13                     INC   DE   
0677   CD A4 06               CALL   prl   ;   and the line
067A   18 DB                  JR   li1   
067C                             ; delln: take line n (in HL) out: copy everything after it down over it.
067C   CD 8C 06     DELLN:    CALL   find   
067F   54                     LD   D,H   
0680   5D                     LD   E,L   
0681   CD 9A 06               CALL   nxl   ; HL -> the next line
0684   7E           DE1:      LD   A,(HL)   
0685   12                     LD   (DE),A   
0686   23                     INC   HL   
0687   13                     INC   DE   
0688   B7                     OR   A   
0689   20 F9                  JR   NZ,de1   
068B   C9                     RET      
068C                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
068C                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
068C   EB           FIND:     EX   DE,HL   
068D   21 00 0B               LD   HL,PROG   
0690   1B           FI1:      DEC   DE   
0691   7A                     LD   A,D   
0692   B3                     OR   E   
0693   C8                     RET   Z   
0694   CD 9A 06               CALL   nxl   
0697   20 F7                  JR   NZ,fi1   
0699   C9                     RET      
069A                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
069A                             ; stop at the NUL that ends the text (and return zero).
069A   7E           NXL:      LD   A,(HL)   
069B   B7                     OR   A   
069C   C8                     RET   Z   
069D   23                     INC   HL   
069E   FE 0A                  CP   10   
06A0   20 F8                  JR   NZ,nxl   
06A2   B7                     OR   A   
06A3   C9                     RET      
06A4                             ; prl: print the line at HL, to its LF; HL -> just past it.
06A4   7E           PRL:      LD   A,(HL)   
06A5                          ;*Macro unroll:  PUTA
06A5                          DS   1-CPM,0EFh   
06A5   CD                     DS   CPM,0CDh   
06A6   A6                     DS   CPM,APUT&0FFh   
06A7   04                     DS   CPM,APUT/256   
06A8   7E                     LD   A,(HL)   
06A9   23                     INC   HL   
06AA   FE 0A                  CP   10   
06AC   20 F6                  JR   NZ,prl   
06AE   C9                     RET      
06AF                          ENDIF      
06AF                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
06AF                          ENDIF      
06AF                          IF   EDITOR*CPM   
06AF                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
06AF                             ;   put the one from the command line
06AF                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
06AF                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
06AF                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
06AF                             ; full disk or directory is not noticed: the calls fail and that is all.)
06AF   CD FC 06     CWRITE:   CALL   setname   
06B2   0E 13                  LD   C,19   ; delete
06B4   CD 35 07               CALL   fbdos   
06B7   0E 16                  LD   C,22   ; make
06B9   CD 35 07               CALL   fbdos   
06BC   21 00 0B               LD   HL,PROG   
06BF   AF                     XOR   A   
06C0   BE           CW1:      CP   (HL)   
06C1   23                     INC   HL   
06C2   20 FC                  JR   NZ,cw1   
06C4   2B                     DEC   HL   ; HL -> the NUL
06C5   E5                     PUSH   HL   
06C6   06 80                  LD   B,128   
06C8   36 1A        CW2:      LD   (HL),1Ah   
06CA   23                     INC   HL   
06CB   10 FB                  DJNZ   cw2   
06CD   E1                     POP   HL   
06CE   11 00 0B               LD   DE,PROG   
06D1   7B           CW3:      LD   A,E   ; a record that starts before the end is written
06D2   95                     SUB   L   
06D3   7A                     LD   A,D   
06D4   9C                     SBC   A,H   
06D5   30 09                  JR   NC,cw4   
06D7   E5                     PUSH   HL   
06D8   0E 15                  LD   C,21   ; write, from where the record lies
06DA   CD EA 06               CALL   frec   
06DD   E1                     POP   HL   
06DE   18 F1                  JR   cw3   
06E0   36 00        CW4:      LD   (HL),0   ; the NUL again
06E2   0E 10                  LD   C,16   ; close
06E4   CD 35 07               CALL   fbdos   
06E7   C3 FE 04               JP   edit   
06EA                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
06EA                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
06EA   D5           FREC:     PUSH   DE   
06EB   C5                     PUSH   BC   
06EC   0E 1A                  LD   C,26   ; set the DMA address
06EE   CD 05 00               CALL   BDOS   
06F1   C1                     POP   BC   
06F2   CD 35 07               CALL   fbdos   
06F5   D1                     POP   DE   
06F6   21 80 00               LD   HL,128   
06F9   19                     ADD   HL,DE   
06FA   EB                     EX   DE,HL   
06FB   C9                     RET      
06FC                             ; setname: if a name was typed (the line does not start with its CR), put it
06FC                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
06FC                             ; is the current one. Then, name or no name, clear the FCB after the name,
06FC                             ; as it must be before a file is opened or made.
06FC   11 80 0A     SETNAME:   LD   DE,LINEBUF   
06FF   1A                     LD   A,(DE)   
0700   FE 0D                  CP   13   
0702   28 26                  JR   Z,fcbclr   
0704   21 5C 00               LD   HL,CFCB   
0707   36 00                  LD   (HL),0   ; the current drive
0709   06 0B                  LD   B,11   
070B   2C           SN1:      INC   L   
070C   36 20                  LD   (HL)," "   
070E   10 FB                  DJNZ   sn1   
0710   2E 5D                  LD   L,CFCB+1   
0712   1A           SN2:      LD   A,(DE)   
0713   13                     INC   DE   
0714   FE 0D                  CP   13   
0716   28 12                  JR   Z,fcbclr   
0718   FE 2E                  CP   "."   
071A   20 04                  JR   NZ,sn3   
071C   2E 65                  LD   L,CFCB+9   ; the type
071E   18 F2                  JR   sn2   
0720   FE 61        SN3:      CP   "a"   
0722   38 02                  JR   C,sn4   
0724   E6 5F                  AND   5Fh   ; a capital
0726   77           SN4:      LD   (HL),A   
0727   2C                     INC   L   
0728   18 E8                  JR   sn2   
072A   21 68 00     FCBCLR:   LD   HL,CFCB+12   
072D   06 18                  LD   B,24   
072F   36 00        FC1:      LD   (HL),0   
0731   23                     INC   HL   
0732   10 FB                  DJNZ   fc1   
0734   C9                     RET      
0735                             ; fbdos: BDOS function C on the file
0735   11 5C 00     FBDOS:    LD   DE,CFCB   
0738   C3 05 00               JP   BDOS   
073B                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
073B                             ; from now on. (On into load, which returns to edit.)
073B   CD FC 06     CREAD:    CALL   setname   
073E   21 FE 04               LD   HL,edit   
0741   E5                     PUSH   HL   
0742                             ; load: read the file into PROG. No such file: no program. The text ends at
0742                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0742                             ; goes after the last record, so the search always stops. And every line
0742                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
0742                             ; clear after its name: the CCP left it so, or setname did.)
0742   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
0744   CD 35 07               CALL   fbdos   ;   too)
0747   11 00 0B               LD   DE,PROG   
074A   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
074C   CD EA 06               CALL   frec   
074F   B7                     OR   A   
0750   28 F8                  JR   Z,ld1   
0752   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
0754   21 FF 0A               LD   HL,PROG-1   
0757   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
0759   23           TR1:      INC   HL   
075A   5F                     LD   E,A   ; E = the character before this one
075B   7E                     LD   A,(HL)   
075C   FE 1A                  CP   1Ah   
075E   20 F9                  JR   NZ,tr1   
0760   7B                     LD   A,E   
0761   FE 0A                  CP   10   
0763   28 06                  JR   Z,tr2   
0765   36 0D                  LD   (HL),13   
0767   23                     INC   HL   
0768   36 0A                  LD   (HL),10   
076A   23                     INC   HL   
076B   36 00        TR2:      LD   (HL),0   
076D   C9                     RET      
076E                          ENDIF      
076E                             ; =============================================================================
076E                          IF   CPM   
076E                             ; The RAM pages follow the image; the heap may grow to the BDOS.
076E                START:       
076E                          ENDIF      
076E                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
076E                          ENDIF      
076E                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
076E                          ENDIF      
076E                          IF   CPM   
076E                             ; RAM pages, after the image
076E                RSPAGE:   EQU   (imgend + 255) / 256   
076E                DSPAGE:   EQU   RSPAGE + 1   
076E                LETPAGE:   EQU   RSPAGE + 2   
076E                PROG:     EQU   LETPAGE*256 + 256   
076E                          ENDIF      
076E                IMGEND:      


