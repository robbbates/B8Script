0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as
0000                             ;                 line and column, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC and HL'; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 0A               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 E4 08               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 75 06     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 E5 04               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 BC 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD FE 04               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LD   A,(BC)   
0138   03                     INC   BC   
0139   D6 21                  SUB   21h   ; A = c - 21h
013B   38 D4                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CP   0Fh   
013F   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0141   D6 0F                  SUB   0Fh   ; A = c - 30h
0143   FE 0A                  CP   0Ah   
0145   38 5F                  JR   C,digit   ; 30h-39h
0147   FE 11                  CP   11h   
0149   38 19                  JR   C,p3a   ; 3Ah-40h
014B   D6 11                  SUB   11h   ; A = c - 41h
014D   FE 1A                  CP   1Ah   
014F   38 61                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0151   FE 20                  CP   20h   
0153   38 0D                  JR   C,p5b   ; 5Bh-60h
0155   FE 3A                  CP   3Ah   
0157   38 53                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0159   FE 3E                  CP   3Eh   
015B                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
015B                          ENDIF      
015B                          IF   CHECKED   
015B   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
015D   D2 2A 05               JP   NC,e_hi   ; 80h-FFh: reserved
0160                          ENDIF      
0160   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0162   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0164   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0166                .macro PTABLE,
0166                             ; 
0166                 DB      h_store & 0FFh  ; !
0166                 DB      h_str & 0FFh    ; "
0166                 DB      h_num & 0FFh    ; #
0166                 DB      h_print & 0FFh  ; $
0166                 DB      h_swap & 0FFh   ; %
0166                 DB      h_and & 0FFh    ; &
0166                 DB      h_emit & 0FFh   ; '
0166                 DB      h_open & 0FFh   ; (
0166                 DB      h_close & 0FFh  ; )
0166                 DB      h_mul & 0FFh    ; *
0166                 DB      h_add & 0FFh    ; +
0166                 DB      h_cfetch & 0FFh ; ,
0166                 DB      h_sub & 0FFh    ; -
0166                 DB      h_cstore & 0FFh ; .
0166                 DB      h_div & 0FFh    ; /
0166                 DB      h_dup & 0FFh    ; :
0166                 DB      h_drop & 0FFh   ; ;
0166                 DB      h_lt & 0FFh     ; <
0166                 DB      h_eq & 0FFh     ; =
0166                 DB      h_gt & 0FFh     ; >
0166                 DB      h_key & 0FFh    ; ?
0166                 DB      h_fetch & 0FFh  ; @
0166                 DB      h_def & 0FFh    ; [
0166                 DB      h_break & 0FFh  ; \
0166                 DB      h_ret & 0FFh    ; ]
0166                 DB      h_xor & 0FFh    ; ^
0166                 DB      h_alloc & 0FFh  ; _
0166                 DB      h_grave & 0FFh  ; `
0166                 DB      h_tor & 0FFh    ; {
0166                 DB      h_or & 0FFh     ; |
0166                 DB      h_fromr & 0FFh  ; }
0166                 DB      h_not & 0FFh    ; ~
0166                .endm
0166                 
0166                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0166                             ; untouched, and A, DE free.
0166   C6 73        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0168   5F                     LD   E,A   
0169   16 04                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
016B   FE 89                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016D   1A                     LD   A,(DE)   
016E   5F                     LD   E,A   ; the handler's low byte
016F                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
016F                          ENDIF      
016F                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
016F                          ENDIF      
016F                          IF   CPM   
016F   16 01                  LD   D,1   
0171   30 01                  JR   NC,pu1   
0173   14                     INC   D   ; its page: 1 + carry
0174                PU1:         
0174                          ENDIF      
0174   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0175   C9                     RET      ;   when the handler starts
0176                             ; The rest of the startup: here so that the generic reset code can reach it
0176                             ; with JR. st0: find the program's NUL; the heap starts after it.
0176                             ; (The editor build has its own copy of this, next to the editor.)
0176                             ; A checked build first clears the lower half of the letter page (A = 0):
0176                             ; every variable starts at 0, every word cell holds 0000h, the address an
0176                             ; undefined word is caught at (see e_hi), and no key is held back.
0176                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0176                          ENDIF      
0176                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0176                          ENDIF      
0176                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0176                          ENDIF      
0176                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0176                          ENDIF      ;   these)
0176                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0176                          ENDIF      
0176                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0176                          ENDIF      
0176                             ; In the unchecked generic editor build the table is here, in the first
0176                             ; page, which saves loading D twice. (The other builds have no room for it
0176                             ; here: theirs is further down.)
0176                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0176                          ENDIF      
0176                             ; =============================================================================
0176                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0176                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0176                             ;  is here too: it belongs to "`" and makes the page come out right.
0176                             ; =============================================================================
0176   D1           H_XOR:    POP   DE   
0177   7C                     LD   A,H   
0178   AA                     XOR   D   
0179   67                     LD   H,A   
017A   7D                     LD   A,L   
017B   AB                     XOR   E   
017C   6F                     LD   L,A   
017D   F7                     RST   30h   
017E   D1           H_OR:     POP   DE   
017F   7C                     LD   A,H   
0180   B2                     OR   D   
0181   67                     LD   H,A   
0182   7D                     LD   A,L   
0183   B3                     OR   E   
0184   6F                     LD   L,A   
0185   F7                     RST   30h   
0186   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0187   2B                     DEC   HL   
0188   F7                     RST   30h   
0189                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0189                             ; the same either way); TOS is the old pointer.
0189   ED 5B 7C 0B  H_ALLOC:   LD   DE,(HEAP)   
018D                          IF   CHECKED*CPM   
018D   7C                     LD   A,H   ; the count's sign, for chkhp
018E                          ENDIF      
018E   19                     ADD   HL,DE   ; the new top
018F                          IF   CHECKED   
018F   CD 34 05               CALL   chkhp   
0192                          ENDIF      
0192   22 7C 0B               LD   (HEAP),HL   
0195   EB                     EX   DE,HL   
0196   F7                     RST   30h   
0197   D9           EXEC:     EXX      
0198   22 34 0B               LD   (RSAVE),HL   ; machine code may change the alternates
019B   D9                     EXX      
019C   CD 2B 01               CALL   jphl   
019F   D9                     EXX      
01A0   2A 34 0B               LD   HL,(RSAVE)   
01A3   D9                     EXX      
01A4   E1                     POP   HL   
01A5   F7                     RST   30h   
01A6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01A6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01A6                             ; Digits: step back onto the first digit and read the whole number.
01A6   E5           DIGIT:    PUSH   HL   
01A7   0B                     DEC   BC   
01A8   CD 2A 03               CALL   rdnum   
01AB   F7                     RST   30h   
01AC                             ; a-z: push the cell's address (the cell is the variable)
01AC   E5           LOWER:    PUSH   HL   
01AD   87                     ADD   A,A   
01AE   6F                     LD   L,A   
01AF   26 0B                  LD   H,LETPAGE   
01B1   F7                     RST   30h   
01B2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01B2                             ; the return stack, and the IP becomes the address in the letter's cell.
01B2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01B3   EB                     EX   DE,HL   ; park TOS
01B4   87                     ADD   A,A   
01B5   6F                     LD   L,A   
01B6   26 0B                  LD   H,LETPAGE   ; HL -> cell
01B8   4E                     LD   C,(HL)   
01B9   2C                     INC   L   
01BA   46                     LD   B,(HL)   ; IP = the word's body
01BB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01BC                             ; rpushn: move the top cell of the data stack (in memory) to the return
01BC                             ; stack, then next. Everything that pushes the return stack ends here.
01BC                             ; 
01BC                             ; The break key is looked at here, so at every word call and loop-back (and
01BC                             ; block entry and "{"), but only one time in 256: B', which nothing else
01BC                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
01BC                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
01BC                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
01BC                             ; both ways out.)
01BC   D9           RPUSHN:   EXX      
01BD   D1                     POP   DE   
01BE   2B                     DEC   HL   
01BF   72                     LD   (HL),D   
01C0   2B                     DEC   HL   
01C1   73                     LD   (HL),E   
01C2   05                     DEC   B   
01C3   D9                     EXX      
01C4   CC A5 04               CALL   Z,pollk   
01C7   F7                     RST   30h   
01C8                             ; ---- the grave -------------------------------------------------------------
01C8                             ; The grave is a prefix: with the character after it, it is one command.
01C8                             ; The characters are tested one after another, each SUB taking off the step
01C8                             ; from the one before, so A is 0 (and the carry clear) when a handler is
01C8                             ; reached. Two are here, where they keep the first page as full as the
01C8                             ; layout needs; grave2 has the rest.
01C8                             ; 
01C8                             ;   `!  ( addr -- )  calls the machine code at TOS. The code is entered by
01C8                             ;       CALL with the data stack above the return address; it must keep BC,
01C8                             ;       and on return the top cell becomes the new TOS.
01C8                             ;   `'  ( -- )  new line: CR LF
01C8   0A           H_GRAVE:   LD   A,(BC)   
01C9   03                     INC   BC   
01CA   D6 21                  SUB   "!"   
01CC   28 C9                  JR   Z,exec   
01CE   D6 06                  SUB   27h-"!"   ; "'"
01D0   C2 A8 03               JP   NZ,grave2   
01D3   3E 0D                  LD   A,13   
01D5   EF                     RST   28h   
01D6   3E 0A                  LD   A,10   
01D8   EF                     RST   28h   
01D9   F7                     RST   30h   
01DA                             ; ---- where the two pages meet ----------------------------------------------
01DA                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01DA                             ; are in falling code order for this), and where exactly differs between the
01DA                             ; builds: NPG1 follows. Every handler below these four must start in the
01DA                             ; second page, and every one above in the first; chktab.py checks both.
01DA                             ; "]" returns: pop an address and jump to it.
01DA   CF           H_RET:    RST   08h   
01DB   42                     LD   B,D   
01DC   4B                     LD   C,E   
01DD   F7           BRK1:     RST   30h   
01DE                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01DE                             ; drops the block start, "]" returns. No closer at all ends the program.
01DE   7C           H_BREAK:   LD   A,H   
01DF   B5                     OR   L   
01E0   E1                     POP   HL   
01E1   28 FA                  JR   Z,brk1   
01E3   CD 51 03               CALL   skip   
01E6   B7                     OR   A   ; skip returns 0 for ")"
01E7   20 F1                  JR   NZ,h_ret   
01E9   CF           RDROP:    RST   08h   
01EA   F7                     RST   30h   
01EB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EB                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EB                             ; (The unchecked build takes anything that is not a letter as the space; the
01EB                             ; checked build stops on it.)
01EB   0A           H_DEF:    LD   A,(BC)   
01EC   03                     INC   BC   
01ED   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01EF   5F                     LD   E,A   ;   lands 64 bytes up
01F0   E6 DF                  AND   0DFh   ; fold case
01F2   FE 1A                  CP   26   
01F4   30 0B                  JR   NC,def2   ; not a letter
01F6   CB 23                  SLA   E   
01F8   16 0B                  LD   D,LETPAGE   ; DE -> cell
01FA   79                     LD   A,C   
01FB   12                     LD   (DE),A   
01FC   1C                     INC   E   
01FD   78                     LD   A,B   
01FE   12                     LD   (DE),A   
01FF   18 09                  JR   skipnx   
0201                DEF2:        
0201                          IF   CHECKED   
0201   7B                     LD   A,E   
0202   FE DF                  CP   " "-"A"+256   
0204   C2 75 05               JP   NZ,e_brack   ; anything but a letter or a space
0207                          ENDIF      
0207   E5                     PUSH   HL   ; an anonymous block: push its address
0208   60                     LD   H,B   
0209   69                     LD   L,C   
020A                SKIPNX:      
020A                          IF   CHECKED   
020A   0B                     DEC   BC   ; back onto the letter, so that skip finds its
020B                          ENDIF      ;   opener, the "[", just before where it starts
020B   CD 51 03     SKIPO:    CALL   skip   
020E   F7                     RST   30h   
020F   5E           H_FETCH:   LD   E,(HL)   ; "@"
0210   23                     INC   HL   
0211   56                     LD   D,(HL)   
0212   EB                     EX   DE,HL   
0213   F7                     RST   30h   
0214                             ; =============================================================================
0214                             ;  Handlers that must start in the image's second page.
0214                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0214                             ;  page.
0214                             ; =============================================================================
0214                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0214                             ; the matching ")".
0214   7C           H_OPEN:   LD   A,H   
0215   B5                     OR   L   
0216   E1                     POP   HL   
0217   28 F2                  JR   Z,skipo   
0219   C5                     PUSH   BC   ; the block starts at the IP
021A   18 A0                  JR   rpushn   
021C                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
021C                             ; drops it and carries on.
021C   7C           H_CLOSE:   LD   A,H   
021D   B5                     OR   L   
021E   E1                     POP   HL   
021F   28 C8                  JR   Z,rdrop   
0221   CF                     RST   08h   ; pop the block start ...
0222   42                     LD   B,D   
0223   4B                     LD   C,E   
0224   C5                     PUSH   BC   
0225   18 95                  JR   rpushn   ; ... and push it back
0227                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0227                             ; "-" has two jobs: directly before a digit it starts a negative number.
0227   0A           H_SUB:    LD   A,(BC)   
0228   D6 30                  SUB   "0"   
022A   FE 0A                  CP   10   
022C   38 04                  JR   C,negnum   
022E   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
022F   D1           H_ADD:    POP   DE   
0230   19                     ADD   HL,DE   
0231   F7                     RST   30h   
0232   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0233   CD 2A 03               CALL   rdnum   
0236   E7                     RST   20h   
0237   F7                     RST   30h   
0238   D1           H_AND:    POP   DE   
0239   7C                     LD   A,H   
023A   A2                     AND   D   
023B   67                     LD   H,A   
023C   7D                     LD   A,L   
023D   A3                     AND   E   
023E   6F                     LD   L,A   
023F   F7                     RST   30h   
0240                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0240                             ; cells first. Flipping both sign bits turns a signed compare into an
0240                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0240                             ; carry into -1 or 0 with no branch.
0240   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0241   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0242   7C                     LD   A,H   
0243   EE 80                  XOR   80h   
0245   67                     LD   H,A   
0246   7A                     LD   A,D   
0247   EE 80                  XOR   80h   
0249   57                     LD   D,A   
024A   ED 52                  SBC   HL,DE   ; carry if HL < DE
024C   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
024E   F7                     RST   30h   
024F   D1           H_EQ:     POP   DE   
0250   B7                     OR   A   
0251   ED 52                  SBC   HL,DE   
0253   7C                     LD   A,H   
0254   B5                     OR   L   
0255   FE 01                  CP   1   ; carry only if a - b = 0
0257   18 F3                  JR   tf   
0259                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0259                             ; multiplier shifts up through A:C.
0259   D1           H_MUL:    POP   DE   ; DE = multiplicand
025A   C5                     PUSH   BC   
025B   7C                     LD   A,H   
025C   4D                     LD   C,L   ; A:C = multiplier
025D   21 00 00               LD   HL,0   
0260   06 10                  LD   B,16   
0262   29           MUL1:     ADD   HL,HL   
0263   CB 21                  SLA   C   
0265   17                     RLA      
0266   30 01                  JR   NC,mul2   
0268   19                     ADD   HL,DE   
0269   10 F7        MUL2:     DJNZ   mul1   
026B   C1                     POP   BC   
026C   F7                     RST   30h   
026D                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
026D                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
026D                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
026D                             ; stops on it.
026D                H_DIV:       
026D                          IF   CHECKED   
026D   7C                     LD   A,H   
026E   B5                     OR   L   
026F   CA 72 05               JP   Z,e_zero   
0272                          ENDIF      
0272   D1                     POP   DE   ; DE = a, HL = b
0273   C5                     PUSH   BC   ; free BC for udiv
0274   D5                     PUSH   DE   ; a, for r's sign
0275   7A                     LD   A,D   
0276   AC                     XOR   H   
0277   F5                     PUSH   AF   ; S flag = sign of q
0278   CB 7C                  BIT   7,H   
027A   C4 20 01               CALL   NZ,neg16   ; HL = |b|
027D   EB                     EX   DE,HL   
027E   CB 7C                  BIT   7,H   
0280   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0283   CD 04 03               CALL   udiv   ; HL = q, DE = r
0286   F1                     POP   AF   
0287   FC 20 01               CALL   M,neg16   ; q's sign
028A   EB                     EX   DE,HL   ; HL = r, DE = q
028B   F1                     POP   AF   ; A = a's high byte
028C   B7                     OR   A   
028D   FC 20 01               CALL   M,neg16   ; r's sign
0290   C1                     POP   BC   
0291   D5                     PUSH   DE   ; q under r
0292   F7                     RST   30h   
0293                             ; ---- stack and storage -----------------------------------------------------
0293   E5           H_DUP:    PUSH   HL   ; ":"
0294   F7                     RST   30h   
0295   E3           H_SWAP:   EX   (SP),HL   ; "%"
0296   F7                     RST   30h   
0297                             ; (The checked build tests the address before it takes the value off the
0297                             ; stack, so that an error report shows both.)
0297                H_CSTORE:      ; "." ( c addr -- )
0297                          IF   CHECKED   
0297   CD 51 05               CALL   chkst   
029A                          ENDIF      
029A   D1                     POP   DE   
029B   73                     LD   (HL),E   
029C   DF           H_DROP:   RST   18h   ; ";" is this one byte
029D                H_STORE:      ; "!" ( n addr -- )
029D                          IF   CHECKED   
029D   CD 51 05               CALL   chkst   
02A0                          ENDIF      
02A0   D1                     POP   DE   
02A1   73                     LD   (HL),E   
02A2   23                     INC   HL   
02A3   72                     LD   (HL),D   
02A4   DF                     RST   18h   
02A5                             ; ---- console ---------------------------------------------------------------
02A5                             ; 22h pushes the address of the text after it and skips the string.
02A5   E5           H_STR:    PUSH   HL   
02A6   60                     LD   H,B   
02A7   69                     LD   L,C   
02A8   CD 40 03               CALL   skipstr   
02AB                          IF   CHECKED   
02AB   B7                     OR   A   ; 0: the text ran out before the closing quote
02AC   CA 6A 05               JP   Z,e_quote   
02AF                          ENDIF      
02AF   F7                     RST   30h   
02B0                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02B0                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02B0                             ; bit 6, so // and /" give themselves).
02B0                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
02B0                          ENDIF      
02B0                          IF   CHECKED   
02B0                             ; (The checked build has the loop as a routine, prstr, which the error
02B0                             ; report uses too. The address is kept on the stack meanwhile: a report
02B0                             ; shows the stack as it was before the "$".)
02B0   E5           H_PRINT:   PUSH   HL   
02B1   CD 1A 06               CALL   prstr   
02B4   D1                     POP   DE   
02B5   DF                     RST   18h   
02B6                          ENDIF      
02B6   7D           H_EMIT:   LD   A,L   ; "'"
02B7   EF                     RST   28h   
02B8   DF           PR9:      RST   18h   
02B9                             ; "#" prints TOS as a signed decimal number, with no space after it.
02B9   C5           H_NUM:    PUSH   BC   
02BA   CD 8E 03               CALL   psgn   
02BD   C1                     POP   BC   
02BE   DF                     RST   18h   
02BF                             ; "?" ( n -- c ) or ( -n -- addr )
02BF                             ;   n > 0: wait about n ms for a key; 0 if none came
02BF                             ;   n = 0: wait for a key
02BF                             ;          (both stir the random seed while they wait: see kt2)
02BF                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02BF                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02BF   CB 7C        H_KEY:    BIT   7,H   
02C1   20 22                  JR   NZ,line   
02C3   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02C5   CD D3 04     KT2:      CALL   getk   
02C8   20 17                  JR   NZ,kt3   
02CA   1D                     DEC   E   
02CB   20 F8                  JR   NZ,kt2   
02CD   EB                     EX   DE,HL   ; a millisecond with no key stirs the random
02CE   2A 76 0B               LD   HL,(SEED)   ;   seed by one: how long a key takes to come
02D1   23                     INC   HL   ;   is the one thing here that is not the
02D2   22 76 0B               LD   (SEED),HL   ;   same every time
02D5   EB                     EX   DE,HL   
02D6   7C                     LD   A,H   ; 0? never counts down: it waits
02D7   B5                     OR   L   
02D8   28 E9                  JR   Z,kt1   
02DA   2B                     DEC   HL   
02DB   7C                     LD   A,H   
02DC   B5                     OR   L   
02DD   20 E4                  JR   NZ,kt1   ; A = 0 if the time ran out
02DF   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02E0   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02E1   6F           KT3:      LD   L,A   
02E2   26 00                  LD   H,0   
02E4   F7                     RST   30h   
02E5                          IF   CPM   
02E5                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02E5                             ; own line editor). It doesn't store the CR, so it is added here.
02E5   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E8   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02E9   9F                     SBC   A,A   
02EA   A5                     AND   L   ; (0 for a count that is too big)
02EB   EE 7F                  XOR   127   ; A = the count, 127 at most
02ED   32 7E 0B               LD   (LBHDR),A   
02F0   11 7E 0B               LD   DE,LBHDR   
02F3   3E 0A                  LD   A,10   
02F5   CD F1 04               CALL   bdosx   
02F8   21 7F 0B               LD   HL,LBHDR+1   
02FB   7E                     LD   A,(HL)   ; the count typed (0-127)
02FC   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
02FD   85                     ADD   A,L   ;   adding the count to L can't carry
02FE   6F                     LD   L,A   
02FF   36 0D                  LD   (HL),13   
0301                          ENDIF      
0301                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
                                 ;   at most
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
0301                          ENDIF      
0301   2E 80                  LD   L,LINEBUF & 0FFh   
0303   F7                     RST   30h   
0304                             ; =============================================================================
0304                             ;  More routines (no handler starts past this point)
0304                             ; =============================================================================
0304                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0304                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0304                             ; while the quotient bits arrive at the bottom of C.
0304                             ; Dividing by 2 is one shift (the spec wants that fast).
0304   7B           UDIV:     LD   A,E   
0305   EE 02                  XOR   2   
0307   B2                     OR   D   
0308   20 07                  JR   NZ,udv0   
030A   CB 3C                  SRL   H   
030C   CB 1D                  RR   L   ; the quotient
030E   8F                     ADC   A,A   
030F   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0310   C9                     RET      
0311   7C           UDV0:     LD   A,H   
0312   4D                     LD   C,L   
0313   21 00 00               LD   HL,0   
0316   06 10                  LD   B,16   
0318   CB 21        UDV1:     SLA   C   
031A   17                     RLA      
031B   ED 6A                  ADC   HL,HL   
031D   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
031F   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0321   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0322   0D                     DEC   C   ;   INC below
0323   0C           UDV2:     INC   C   ; a quotient bit
0324   10 F2                  DJNZ   udv1   
0326   EB                     EX   DE,HL   ; DE = remainder
0327   67                     LD   H,A   
0328   69                     LD   L,C   ; HL = quotient
0329   C9                     RET      
032A                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
032A                             ; non-digit. Values wrap at 16 bits, as the spec says.
032A   21 00 00     RDNUM:    LD   HL,0   
032D   0A           RDN1:     LD   A,(BC)   
032E   D6 30                  SUB   "0"   
0330   FE 0A                  CP   10   
0332   D0                     RET   NC   
0333   03                     INC   BC   
0334   54                     LD   D,H   
0335   5D                     LD   E,L   
0336   29                     ADD   HL,HL   
0337   29                     ADD   HL,HL   
0338   19                     ADD   HL,DE   
0339   29                     ADD   HL,HL   ; HL * 10
033A   5F                     LD   E,A   
033B   16 00                  LD   D,0   
033D   19                     ADD   HL,DE   
033E   18 ED                  JR   rdn1   
0340                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0340                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0340                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0340                          ENDIF      
0340                          IF   CHECKED   
0340                             ; The checked build never steps over a NUL: if the text runs out first it
0340                             ; returns A = 0 with the IP on the NUL.
0340   0A           SKIPSTR:   LD   A,(BC)   
0341   B7                     OR   A   
0342   C8                     RET   Z   
0343   03                     INC   BC   
0344   FE 22                  CP   22h   
0346   C8                     RET   Z   
0347   FE 2F                  CP   "/"   
0349   20 F5                  JR   NZ,skipstr   
034B   0A                     LD   A,(BC)   ; the escaped character
034C   B7                     OR   A   
034D   C8                     RET   Z   
034E   03                     INC   BC   
034F   18 EF                  JR   skipstr   
0351                          ENDIF      
0351                             ; skip: read past text to the closer at this level, and return A = 0 if it
0351                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0351                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0351                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0351                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0351                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0351                             ; 
0351                             ; The checked build also looks at the character the skip was started by,
0351                             ; which is always the one just before where it starts: "(" must end at ")",
0351                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0351                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0351                             ; place where the skip started, for the report.
0351                SKIP:        
0351                          IF   CHECKED   
0351   C5                     PUSH   BC   
0352   DD E1                  POP   IX   
0354   0B                     DEC   BC   
0355   0A                     LD   A,(BC)   
0356   03                     INC   BC   
0357   5F                     LD   E,A   ; E = the opener: ( [ or \
0358                          ENDIF      
0358   16 00                  LD   D,0   
035A   14           SK3:      INC   D   ; an opener: one deeper
035B   0A           SK1:      LD   A,(BC)   
035C                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
035C                          ENDIF      
035C                          IF   CHECKED   
035C   B7                     OR   A   
035D   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
035F   03                     INC   BC   
0360                          ENDIF      
0360   FE 22                  CP   22h   
0362   CC 40 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0365   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0367   28 F1                  JR   Z,sk3   
0369   3D                     DEC   A   ; ")"
036A   28 08                  JR   Z,sk4   
036C   D6 32                  SUB   "["-")"   
036E   28 EA                  JR   Z,sk3   
0370   FE 02                  CP   "]"-"["   
0372   20 E7                  JR   NZ,sk1   
0374   15           SK4:      DEC   D   
0375                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0375                          ENDIF      
0375                          IF   CHECKED   
0375   20 E4                  JR   NZ,sk1   
0377   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0378   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0379   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
037B   FE 02                  CP   2   ;   closer, and only then
037D   7A                     LD   A,D   
037E   C0                     RET   NZ   
037F   18 05                  JR   sk7   
0381   CB 53        SK6:      BIT   2,E   ; the text ran out:
0383   C2 74 06               JP   NZ,SKEND   ;   "\" with no closer ends the program
0386   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0388   C1                     POP   BC   
0389   3E 4E                  LD   A,"N"   
038B   C3 64 05               JP   errp   ; (errp drops skip's return address)
038E                          ENDIF      
038E                             ; psgn: print HL as a signed number. Uses BC.
038E   CB 7C        PSGN:     BIT   7,H   
0390   28 04                  JR   Z,pdec   
0392   3E 2D                  LD   A,"-"   
0394   EF                     RST   28h   
0395   E7                     RST   20h   
0396                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0396                             ; Uses BC.
0396   11 0A 00     PDEC:     LD   DE,10   
0399   CD 04 03               CALL   udiv   ; HL = HL / 10, E = the last digit
039C   7B                     LD   A,E   
039D   F5                     PUSH   AF   
039E   7C                     LD   A,H   
039F   B5                     OR   L   
03A0   C4 96 03               CALL   NZ,pdec   
03A3   F1                     POP   AF   
03A4   C6 30                  ADD   A,"0"   
03A6   EF                     RST   28h   
03A7   C9                     RET      
03A8                             ; =============================================================================
03A8                             ;  The grave's other codes. h_grave comes here with A = the character minus
03A8                             ;  27h, not zero; the tests carry on from there. The four characters from
03A8                             ;  "+" to "." follow one another, so one range test finds them and two
03A8                             ;  rotates tell them apart.
03A8                             ; 
03A8                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
03A8                             ;        from addr until a non-hex character; then a RET (C9h) is written
03A8                             ;        and its address is left. An odd last digit is consumed and dropped.
03A8                             ;    `+  ( addr -- n )   add 1 to the cell at addr and leave its new value
03A8                             ;    `,  ( n -- r )      a random number from 0 to n-1 (n is 1 to 32767)
03A8                             ;    `-  ( addr -- n )   subtract 1 from the cell at addr, the same way
03A8                             ;    `.  ( -- addr )     the address of the random seed
03A8                             ;    `<  ( a b -- n )    the smaller of the two (signed)
03A8                             ;    `>  ( a b -- n )    the larger
03A8                             ;    `?  ( flag -- )     the cursor off (0) or on
03A8                             ;    `@  ( row col -- )  the cursor to that row and column, both from 0
03A8                             ;    `^  ( -- )          clear the screen and home the cursor
03A8                             ;    `_  ( -- )          clear from the cursor to the end of the line
03A8                             ; 
03A8                             ;  Any other character is unsafe: the unchecked build takes it as "_", the
03A8                             ;  checked build stops with W.
03A8                             ; =============================================================================
03A8   D6 04        GRAVE2:   SUB   "+"-27h   ; "+" "," "-" "." leave 0 to 3
03AA   FE 04                  CP   4   
03AC   30 3E                  JR   NC,gv2   
03AE   1F                     RRA      ; carry: "," or "."; bit 0 of A: "-" or "."
03AF   38 13                  JR   C,gv3   
03B1                             ; `+ and `-: one routine.
03B1                          IF   CHECKED   
03B1   57                     LD   D,A   ; (the checked build tests the address first,
03B2   CD 51 05               CALL   chkst   ;   as "!" does: the test uses A, and under
03B5   7A                     LD   A,D   ;   CP/M E too)
03B6                          ENDIF      
03B6   5E                     LD   E,(HL)   
03B7   23                     INC   HL   
03B8   56                     LD   D,(HL)   
03B9   1F                     RRA      ; carry: "-"
03BA   38 02                  JR   C,gi1   
03BC   13                     INC   DE   
03BD   13                     INC   DE   
03BE   1B           GI1:      DEC   DE   
03BF   72                     LD   (HL),D   
03C0   2B                     DEC   HL   
03C1   73                     LD   (HL),E   
03C2   EB                     EX   DE,HL   ; the new value is TOS
03C3   F7                     RST   30h   
03C4   1F           GV3:      RRA      ; carry: "."
03C5   38 20                  JR   C,g_seed   
03C7                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
03C7                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
03C7                             ; and the low ones repeat soon, so the high byte is folded into the low
03C7                             ; (XOR) before the remainder of dividing by n is taken.
03C7                             ; n must be 1 to 32767: the checked build stops with Z on anything less
03C7                             ; than 1.
03C7                G_RND:       
03C7                          IF   CHECKED   
03C7   2B                     DEC   HL   
03C8   CB 7C                  BIT   7,H   ; n - 1 negative: n is 0 or less
03CA   23                     INC   HL   
03CB   C2 72 05               JP   NZ,e_zero   
03CE                          ENDIF      
03CE   EB                     EX   DE,HL   ; DE = n
03CF   C5                     PUSH   BC   
03D0   2A 76 0B               LD   HL,(SEED)   
03D3   44                     LD   B,H   
03D4   4D                     LD   C,L   
03D5   29                     ADD   HL,HL   
03D6   29                     ADD   HL,HL   
03D7   09                     ADD   HL,BC   ; * 5
03D8   23                     INC   HL   ; + 1
03D9   7C                     LD   A,H   
03DA   81                     ADD   A,C   
03DB   67                     LD   H,A   ; + * 256: * 261 + 1
03DC   22 76 0B               LD   (SEED),HL   
03DF   AD                     XOR   L   ; (A is still the high byte)
03E0   6F                     LD   L,A   
03E1   CD 04 03               CALL   udiv   ; DE = the remainder
03E4   EB                     EX   DE,HL   
03E5   C1                     POP   BC   
03E6   F7                     RST   30h   
03E7                             ; `. pushes the address of the random seed.
03E7   E5           G_SEED:   PUSH   HL   
03E8   21 76 0B               LD   HL,SEED   
03EB   F7                     RST   30h   
03EC   C6 07        GV2:      ADD   A,"+"-"$"   ; "$"
03EE   20 13                  JR   NZ,gv4   
03F0   CD 93 04     HX1:      CALL   hexc   
03F3   30 0B                  JR   NC,hx2   
03F5   77                     LD   (HL),A   ; the high digit goes in first ...
03F6   CD 93 04               CALL   hexc   
03F9   30 05                  JR   NC,hx2   ; odd digit: consumed, and the RET below
03FB   ED 6F                  RLD      ;   overwrites it
03FD   23                     INC   HL   ; ... and RLD shifts it up under the low one
03FE   18 F0                  JR   hx1   
0400   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
0402   F7                     RST   30h   
0403   D6 18        GV4:      SUB   "<"-"$"   
0405   28 25                  JR   Z,g_min   
0407   D6 02                  SUB   ">"-"<"   
0409   28 20                  JR   Z,g_max   
040B   3D                     DEC   A   ; "?"
040C   28 30                  JR   Z,g_cur   
040E   3D                     DEC   A   ; "@"
040F   28 43                  JR   Z,g_at   
0411   D6 1E                  SUB   "^"-"@"   ; "^" leaves 0 and "_" leaves 1
0413                          IF   CHECKED   
0413   FE 02                  CP   2   
0415   D2 75 05               JP   NC,e_brack   ; anything else: W. The place is the character
0418   B7                     OR   A   
0419                          ENDIF      
0419                          IF   ANSI   
0419   20 07                  JR   NZ,ge1   
041B   CD 6C 04               CALL   csi   ; "^": ESC [ H homes the cursor, and then
041E   3E 48                  LD   A,"H"   ;   ESC [ J clears from there to the end of
0420   EF                     RST   28h   ;   the screen
0421   AF                     XOR   A   
0422   C6 4A        GE1:      ADD   A,"J"   ; "_": ESC [ K clears to the end of the line
0424   5F                     LD   E,A   
0425   CD 6C 04               CALL   csi   
0428   7B                     LD   A,E   
0429   EF                     RST   28h   
042A   F7                     RST   30h   
042B                          ENDIF      
042B                          IF   1-ANSI   
                              JR   NZ,ge1   
                              CALL   CONCLS   
                              RST   30h   
                    GE1:      CALL   CONEOL   
                              RST   30h   
042B                          ENDIF      
042B                             ; `< and `>. The carry says which: set for the larger. The two are put in
042B                             ; order, HL the smaller and DE the larger, and then swapped for ">".
042B                             ; b < a (signed) is the borrow of b - a, turned round if the two signs
042B                             ; differ: RRA puts the borrow in bit 7, where the two XORs meet it.
042B   37           G_MAX:    SCF      ; ("<" comes in with the carry clear)
042C   D1           G_MIN:    POP   DE   ; DE = a, HL = b
042D   F5                     PUSH   AF   
042E   7D                     LD   A,L   
042F   93                     SUB   E   
0430   7C                     LD   A,H   
0431   9A                     SBC   A,D   
0432   1F                     RRA      
0433   AC                     XOR   H   
0434   AA                     XOR   D   
0435   17                     RLA      ; carry: b < a
0436   38 01                  JR   C,gm2   
0438   EB                     EX   DE,HL   
0439   F1           GM2:      POP   AF   
043A   30 01                  JR   NC,gm3   
043C   EB                     EX   DE,HL   
043D   F7           GM3:      RST   30h   
043E                          IF   ANSI   
043E                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
043E   CD 6C 04     G_CUR:    CALL   csi   
0441   3E 3F                  LD   A,"?"   
0443   EF                     RST   28h   
0444   3E 32                  LD   A,"2"   
0446   EF                     RST   28h   
0447   3E 35                  LD   A,"5"   
0449   EF                     RST   28h   
044A   7C                     LD   A,H   
044B   B5                     OR   L   
044C   3E 6C                  LD   A,"l"   
044E   28 02                  JR   Z,gc1   
0450   3E 68                  LD   A,"h"   
0452   EF           GC1:      RST   28h   
0453   DF                     RST   18h   
0454                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
0454   D1           G_AT:     POP   DE   ; DE = the row
0455   C5                     PUSH   BC   ; (pdec uses BC)
0456   E5                     PUSH   HL   ; the column
0457   EB                     EX   DE,HL   
0458   CD 6C 04               CALL   csi   
045B   23                     INC   HL   
045C   CD 96 03               CALL   pdec   
045F   3E 3B                  LD   A,";"   
0461   EF                     RST   28h   
0462   E1                     POP   HL   
0463   23                     INC   HL   
0464   CD 96 03               CALL   pdec   
0467   3E 48                  LD   A,"H"   
0469   EF                     RST   28h   
046A   C1                     POP   BC   
046B   DF                     RST   18h   
046C                             ; csi: print ESC [, which starts every ANSI sequence. Keeps all but A.
046C   3E 1B        CSI:      LD   A,27   
046E   EF                     RST   28h   
046F   3E 5B                  LD   A,"["   
0471   EF                     RST   28h   
0472   C9                     RET      
0473                          ENDIF      
0473                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    LD   A,H   
                              OR   L   
                              CALL   CONCUR   
                              RST   18h   
                    G_AT:     POP   DE   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   18h   
0473                          ENDIF      
0473                             ; =============================================================================
0473                             ;  Dispatch table: the low byte of each handler's address, in code order
0473                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0473                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0473                             ; =============================================================================
0473                             ; The handlers of the first NPG1 characters start in the image's second page.
0473                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0473                             ; differs between the builds, so the count is worked out here.
0473                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0473                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0473                PGBRK:    EQU   (h_break-BASE)/256   
0473                PGDEF:    EQU   (h_def-BASE)/256   
0473                PGFET:    EQU   (h_fetch-BASE)/256   
0473                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0473                          IF   1-TABP0   
0473                PTAB:        
0473                          ;*Macro unroll:  PTABLE
0473   9D                     DB   h_store & 0FFh   
0474   A5                     DB   h_str & 0FFh   
0475   B9                     DB   h_num & 0FFh   
0476   B0                     DB   h_print & 0FFh   
0477   95                     DB   h_swap & 0FFh   
0478   38                     DB   h_and & 0FFh   
0479   B6                     DB   h_emit & 0FFh   
047A   14                     DB   h_open & 0FFh   
047B   1C                     DB   h_close & 0FFh   
047C   59                     DB   h_mul & 0FFh   
047D   2F                     DB   h_add & 0FFh   
047E   E0                     DB   h_cfetch & 0FFh   
047F   27                     DB   h_sub & 0FFh   
0480   97                     DB   h_cstore & 0FFh   
0481   6D                     DB   h_div & 0FFh   
0482   93                     DB   h_dup & 0FFh   
0483   9C                     DB   h_drop & 0FFh   
0484   40                     DB   h_lt & 0FFh   
0485   4F                     DB   h_eq & 0FFh   
0486   41                     DB   h_gt & 0FFh   
0487   BF                     DB   h_key & 0FFh   
0488   0F                     DB   h_fetch & 0FFh   
0489   EB                     DB   h_def & 0FFh   
048A   DE                     DB   h_break & 0FFh   
048B   DA                     DB   h_ret & 0FFh   
048C   76                     DB   h_xor & 0FFh   
048D   89                     DB   h_alloc & 0FFh   
048E   C8                     DB   h_grave & 0FFh   
048F   2C                     DB   h_tor & 0FFh   
0490   7E                     DB   h_or & 0FFh   
0491   1C                     DB   h_fromr & 0FFh   
0492   86                     DB   h_not & 0FFh   
0493                PTABEND:      
0493                          ENDIF      
0493                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0493                             ; and return its value in A with the carry set; otherwise leave the IP and
0493                             ; return with the carry clear.
0493   0A           HEXC:     LD   A,(BC)   
0494   D6 30                  SUB   "0"   
0496   FE 0A                  CP   10   
0498   38 09                  JR   C,hc1   
049A   E6 DF                  AND   0DFh   
049C   D6 11                  SUB   11h   
049E   FE 06                  CP   6   
04A0   D0                     RET   NC   
04A1   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
04A3   03           HC1:      INC   BC   
04A4   C9                     RET      
04A5                             ; =============================================================================
04A5                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
04A5                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
04A5                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
04A5                             ;  they are the host's KEY and CONOUT routines themselves.
04A5                             ; 
04A5                             ;  A running program reads the keyboard only through getk and pollk, which
04A5                             ;  between them give the break key its rules:
04A5                             ;    - Ctrl-C stops the program;
04A5                             ;    - any other key that the break check reads is held in KEYBUF for the
04A5                             ;      next "?", and a newer one takes its place;
04A5                             ;    - "?" (getk) takes the held key first;
04A5                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
04A5                             ;      key like any other, but two of them within about 250 ms still stop it.
04A5                             ;  Both are called straight from a handler, never from a routine under one:
04A5                             ;  the checked build's report counts on finding one return address above the
04A5                             ;  data stack.
04A5                             ; =============================================================================
04A5                          IFN   CPM   
                    RAWK:     EQU   KEY   
04A5                          ENDIF      
04A5                             ; pollk: the break check (see rpushn).
04A5   CD E3 04     POLLK:    CALL   rawk   
04A8   C8                     RET   Z   ; no key
04A9   32 7A 0B               LD   (KEYBUF),A   ; held for the next "?"
04AC   FE 03        PK1:      CP   3   ; (getk joins here)
04AE   C0                     RET   NZ   
04AF                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
04AF                             ; the program has turned it off, wait about 250 ms for one more key: a
04AF                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
04AF                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
04AF   3A 7B 0B     CTLC:     LD   A,(BRKOFF)   
04B2   B7                     OR   A   
04B3   CA 62 05     CT0:      JP   Z,brk   
04B6   D5                     PUSH   DE   
04B7   11 10 27               LD   DE,250*MSLOOP   
04BA   CD E3 04     CT1:      CALL   rawk   
04BD   20 05                  JR   NZ,ct2   
04BF   1B                     DEC   DE   
04C0   7A                     LD   A,D   
04C1   B3                     OR   E   
04C2   20 F6                  JR   NZ,ct1   
04C4   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
04C5   FE 03                  CP   3   
04C7   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
04C9   B7                     OR   A   
04CA   28 03                  JR   Z,ct3   
04CC   32 7A 0B               LD   (KEYBUF),A   
04CF   3E 03        CT3:      LD   A,3   
04D1   B7                     OR   A   
04D2   C9                     RET      
04D3                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04D3   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
04D4   21 7A 0B               LD   HL,KEYBUF   ;   the buffer
04D7   7E                     LD   A,(HL)   
04D8   36 00                  LD   (HL),0   
04DA   E1                     POP   HL   
04DB   B7                     OR   A   
04DC   C0                     RET   NZ   
04DD   CD E3 04               CALL   rawk   
04E0   C8                     RET   Z   
04E1   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
04E3                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
04E3                          ENDIF      ;   (with the editor, both stacks are cleared);
04E3                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
04E3                          ENDIF      
04E3                          IF   CHECKED   
04E3                BRK:      EQU   e_break   ;   the checked build reports B
04E3                          ENDIF      
04E3                          IF   CPM   
04E3   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
04E5                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
04E5                             ; printing and could swallow a key that BDOS 6 then never sees.
04E5   D5           PUTC:     PUSH   DE   
04E6   E5                     PUSH   HL   
04E7   5F                     LD   E,A   
04E8   3E 06                  LD   A,6   
04EA   CD F1 04               CALL   bdosx   
04ED   E1                     POP   HL   
04EE   D1                     POP   DE   
04EF   B7                     OR   A   ; (for getk)
04F0   C9                     RET      
04F1                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
04F1   C5           BDOSX:    PUSH   BC   
04F2   D9                     EXX      
04F3   E5                     PUSH   HL   
04F4   D9                     EXX      
04F5   4F                     LD   C,A   
04F6   CD 05 00               CALL   BDOS   
04F9   D9                     EXX      
04FA   E1                     POP   HL   
04FB   D9                     EXX      
04FC   C1                     POP   BC   
04FD   C9                     RET      
04FE                          ENDIF      
04FE                             ; =============================================================================
04FE                             ;  Checked build: the checks and the error report
04FE                             ; =============================================================================
04FE                          IF   CHECKED   
04FE                             ; chkstk: both stacks are checked once per character, not in every handler.
04FE                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
04FE                             ; the constant carries if it is above (cells were popped that were never
04FE                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
04FE                             ; a character late at most: the bytes above DSTOP and the guard band below
04FE                             ; the page take what happens meanwhile. DE is free between characters.
04FE   EB           CHKSTK:   EX   DE,HL   
04FF   21 05 F5               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0502   39                     ADD   HL,SP   
0503   EB                     EX   DE,HL   
0504   38 1D                  JR   C,e_under   
0506   14                     INC   D   
0507   20 16                  JR   NZ,e_over   
0509   D9                     EXX      ; the return stack: in its page (or it has
050A   7C                     LD   A,H   ;   overflowed), and not above its empty
050B   FE 09                  CP   RSPAGE   ;   position (an underflow stays inside the
050D   7D                     LD   A,L   ;   page, in the guard band)
050E   D9                     EXX      
050F   20 0B                  JR   NZ,e_rover   
0511   FE E1                  CP   RSTOP&0FFh+1   
0513   D8                     RET   C   
0514   D9                     EXX      ; return stack underflow: it counts as empty
0515   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
0517   D9                     EXX      
0518   3E 72                  LD   A,"r"   
051A   18 48                  JR   errp   
051C   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
051E   11                     DB   11h   ; (LD DE,nn hides the next entry)
051F   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0521   18 41                  JR   errp   
0523   31 FC 0A     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0526   3E 73                  LD   A,"s"   
0528   18 4D                  JR   error   
052A                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
052A                             ; was never defined still holds 0000h, and the byte there is a reserved one
052A                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
052A                             ; an undefined word. The call is undone, so the place is the call itself.
052A   04           E_HI:     INC   B   
052B   10 42                  DJNZ   e_resv   ; (B is as it was, and is not 0)
052D   CF                     RST   08h   
052E   42                     LD   B,D   
052F   4B                     LD   C,E   
0530   3E 55                  LD   A,"U"   
0532   18 43                  JR   error   
0534                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0534                             ; the count. Stop if the top is not below the limit page, or is below the
0534                             ; program's end.
0534                CHKHP:       
0534                          ENDIF      
0534                          IF   CHECKED*CPM   
0534                             ; With this much room a top that wrapped round can land back in
0534                             ; range, so the add is tested too: growing (A, the count's high
0534                             ; byte, is positive) must not carry, and releasing must.
0534   1F                     RRA      ; the carry comes in above the sign:
0535   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
0537   87                     ADD   A,A   
0538   38 10                  JR   C,e_heap   
053A   3A 07 00               LD   A,(0007h)   
053D   3D                     DEC   A   
053E   BC                     CP   H   
053F   38 09                  JR   C,e_heap   
0541                          ENDIF      
0541                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0541                          ENDIF      
0541                          IF   CHECKED   
0541   D5                     PUSH   DE   
0542   EB                     EX   DE,HL   
0543   2A 38 0B               LD   HL,(NPEND)   
0546   19                     ADD   HL,DE   ; carry: at or above the program's end
0547   EB                     EX   DE,HL   
0548   D1                     POP   DE   
0549   D8                     RET   C   
054A   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
054B   ED 52                  SBC   HL,DE   
054D   3E 48                  LD   A,"H"   
054F   18 13                  JR   errp   
0551                             ; chkst: stop unless HL is in the program's own space: from the letter page
0551                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0551                             ; whatever lies above the limit are safe. Memory above the heap top but
0551                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0551                             ; It is the page of HL + 1 that is tested, so that one test serves both
0551                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0551                             ; Keeps HL and BC. It runs on into its own error entry.
0551   23           CHKST:    INC   HL   
0552   7C                     LD   A,H   
0553   2B                     DEC   HL   
0554   FE 0B                  CP   LETPAGE   
0556   38 07                  JR   C,e_store   
0558                          ENDIF      
0558                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0558                          ENDIF      
0558                          IF   CHECKED*CPM   
0558   5F                     LD   E,A   
0559   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
055C   3D                     DEC   A   
055D   BB                     CP   E   
055E   D0                     RET   NC   
055F                          ENDIF      
055F                          IF   CHECKED   
055F                             ; Error entries. Each loads its letter and then hides the next entry inside
055F                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
055F   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
0561   11                     DB   11h   
0562   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0564                             ; errp: an error found inside a routine: drop its return address first.
0564   D1           ERRP:     POP   DE   
0565   18 10                  JR   error   
0567   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop prstr's return
0568   E1                     POP   HL   ;   address, put the string's address back in
0569   11                     DB   11h   ;   TOS, and step over the next two bytes: Q
056A   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
056B   4D                     LD   C,L   ;   past the opening quote, which is the place
056C   3E 51                  LD   A,"Q"   
056E   11                     DB   11h   
056F   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
0571   11                     DB   11h   
0572   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0574   11                     DB   11h   
0575   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0577                             ; error: the report, then the end. A = the letter, BC = one past the place,
0577                             ; HL = TOS, and both stacks as the report is to show them:
0577                             ; 
0577                             ;   Err X @ line,col
0577                             ;   Stk n: the top 8 cells at most, bottom to top
0577                             ;   Rtn n
0577   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0578   5F                     LD   E,A   
0579   CD 2E 06               CALL   pnl   
057C   45 72 72 20 22         DB   "Err ",22h   
0581   7B                     LD   A,E   
0582   EF                     RST   28h   
0583   CD 34 06               CALL   pmsg   
0586   20 40 20 22            DB   " @ ",22h   
058A   0B                     DEC   BC   ; BC = the place
058B                             ; The line and column. A place below the program is in the line
058B                             ; buffer: line 0. Otherwise count the LFs from the program's start;
058B                             ; DE = the line's number, HL = where it starts.
058B   21 80 0B               LD   HL,LINEBUF   
058E   11 00 00               LD   DE,0   
0591   78                     LD   A,B   
0592   FE 0C                  CP   PROG/256   
0594   38 14                  JR   C,er3   
0596   24                     INC   H   
0597   6B                     LD   L,E   ; HL = PROG
0598   13           ER1:      INC   DE   ; a new line starts at HL
0599   E5                     PUSH   HL   
059A   7D           ER2:      LD   A,L   
059B   91                     SUB   C   
059C   7C                     LD   A,H   
059D   98                     SBC   A,B   
059E   30 09                  JR   NC,er2x   ; reached the place
05A0   7E                     LD   A,(HL)   
05A1   23                     INC   HL   
05A2   FE 0A                  CP   10   
05A4   20 F4                  JR   NZ,er2   
05A6   F1                     POP   AF   
05A7   18 EF                  JR   er1   
05A9   E1           ER2X:     POP   HL   
05AA   C5           ER3:      PUSH   BC   
05AB   E5                     PUSH   HL   
05AC   EB                     EX   DE,HL   
05AD   CD 96 03               CALL   pdec   ; the line
05B0   3E 2C                  LD   A,","   
05B2   EF                     RST   28h   
05B3   D1                     POP   DE   
05B4   E1                     POP   HL   
05B5   B7                     OR   A   
05B6   ED 52                  SBC   HL,DE   
05B8   23                     INC   HL   
05B9   CD 96 03               CALL   pdec   ; the column
05BC                             ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
05BC                             ;                       Rtn n
05BC                             ; TOS is in memory with the rest (pushed).
05BC   CD 2E 06               CALL   pnl   
05BF   53 74 6B 20 22         DB   "Stk ",22h   
05C4   21 06 F5               LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
05C7   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
05C8   E7                     RST   20h   ;   with the first value and holds nothing)
05C9   CD 10 06               CALL   phalf   ; the depth
05CC   3E 3A                  LD   A,":"   
05CE   EF                     RST   28h   
05CF   79                     LD   A,C   
05D0   FE 09                  CP   9   
05D2   38 0A                  JR   C,er6   
05D4   CD 34 06               CALL   pmsg   
05D7   20 2E 2E 2E 22         DB   " ...",22h   
05DC   0E 08                  LD   C,8   
05DE   60           ER6:      LD   H,B   ; C = the number of cells to show (B is 0:
05DF                             ;   phalf left the depth in BC)
05DF   69                     LD   L,C   
05E0   29                     ADD   HL,HL   
05E1   39                     ADD   HL,SP   ; HL -> just above the deepest of them
05E2   0C                     INC   C   
05E3   0D           ER7:      DEC   C   
05E4   28 11                  JR   Z,er8   
05E6   2B                     DEC   HL   
05E7   56                     LD   D,(HL)   
05E8   2B                     DEC   HL   
05E9   5E                     LD   E,(HL)   
05EA   E5                     PUSH   HL   
05EB   C5                     PUSH   BC   
05EC   3E 20                  LD   A," "   
05EE   EF                     RST   28h   
05EF   EB                     EX   DE,HL   
05F0   CD 8E 03               CALL   psgn   
05F3   C1                     POP   BC   
05F4   E1                     POP   HL   
05F5   18 EC                  JR   er7   
05F7   CD 2E 06     ER8:      CALL   pnl   
05FA   52 74 6E 20 22         DB   "Rtn ",22h   
05FF   D9                     EXX      ; twice the depth is RSTOP less the pointer:
0600   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough, since even an
0602   95                     SUB   L   ;   overflowing stack holds under 128 entries
0603   D9                     EXX      
0604   6F                     LD   L,A   
0605   60                     LD   H,B   ; (B is still 0)
0606   CD 10 06               CALL   phalf   
0609   CD 2E 06               CALL   pnl   
060C   22                     DB   22h   
060D                          ENDIF      
060D                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
060D                          ENDIF      
060D                          IF   CHECKED*EDITOR   
060D   C3 70 06               JP   edit0   ; back to the editor, with both stacks cleared
0610                          ENDIF      
0610                          IF   CHECKED   
0610                             ; phalf: print half of HL, and leave it in C.
0610   CB 3C        PHALF:    SRL   H   
0612   CB 1D                  RR   L   
0614   E5                     PUSH   HL   
0615   CD 96 03               CALL   pdec   
0618   C1                     POP   BC   
0619   C9                     RET      
061A                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
061A                             ; "$", and the texts of the report). A
061A                             ; NUL first is an error: Q.
061A   7E           PRSTR:    LD   A,(HL)   
061B   23                     INC   HL   
061C   FE 22                  CP   22h   
061E   C8                     RET   Z   
061F   B7                     OR   A   
0620   CA 67 05               JP   Z,e_dollar   
0623   FE 2F                  CP   "/"   
0625   20 04                  JR   NZ,prs1   
0627   7E                     LD   A,(HL)   
0628   23                     INC   HL   
0629   E6 BF                  AND   0BFh   
062B   EF           PRS1:     RST   28h   
062C   18 EC                  JR   prstr   
062E                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
062E                             ; pnl: the same, on a new line.
062E   3E 0D        PNL:      LD   A,13   
0630   EF                     RST   28h   
0631   3E 0A                  LD   A,10   
0633   EF                     RST   28h   
0634   E3           PMSG:     EX   (SP),HL   
0635   CD 1A 06               CALL   prstr   
0638   E3                     EX   (SP),HL   
0639   C9                     RET      
063A                          ENDIF      
063A                             ; =============================================================================
063A                             ;  The line editor (EDITOR = 1)
063A                             ; 
063A                             ;  The interpreter starts here, and a program that ends comes back here.
063A                             ;  There is no prompt. It follows the spec's suggested standard for a line
063A                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
063A                             ; 
063A                             ;    n text    put the text in as line n; the lines from n on move down. A
063A                             ;              number past the end (or 0) adds the line at the end.
063A                             ;    n         take line n out
063A                             ;    anything else is run at once, as B8Script. (Start such a line with a
063A                             ;    space if it would begin with a digit.)
063A                             ; 
063A                             ;  A command key ends the line too, and takes what was typed as its argument:
063A                             ; 
063A                             ;    ^G        run the program
063A                             ;    n ^L      list from line n (no number: all of it). Any key holds the
063A                             ;              list until another key is pressed; Ctrl-C ends it.
063A                             ;    n ^E      put line n in the input line; Return puts it back, changed
063A                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
063A                             ;              last time). Generic: what is typed, or pasted, from now until
063A                             ;              ^Z replaces the program; it is not echoed.
063A                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
063A                             ;              time). Generic: the text is printed, as it is.
063A                             ;    ^N ^N     new: no program (the key twice in a row)
063A                             ;    ^X        leave (to LEAVE)
063A                             ; 
063A                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
063A                             ;  a character goes in at the cursor; Backspace and DEL take out the one
063A                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
063A                             ;  sent to the terminal, so any terminal will do.
063A                             ; 
063A                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
063A                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
063A                             ;  125 characters; the one character after a line number separates it from
063A                             ;  the text and is not stored. The text is kept as it is typed, each line
063A                             ;  ending in CR LF, at PROG.
063A                             ; 
063A                             ;  What lasts from one line to the next: the program, the words, the
063A                             ;  variables and the data stack. An error or a break clears both stacks. The
063A                             ;  return stack starts empty for every line.
063A                             ; 
063A                             ;  Things to know:
063A                             ;    - Reset empties the program (generic builds).
063A                             ;    - A word's address points into the program, so run the program again
063A                             ;      after editing it.
063A                             ;    - Nothing is printed between a program's output and what is typed next.
063A                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
063A                             ;      a line that calls -n? and carries on afterwards runs what was typed.
063A                             ;      (The stored program never comes back to the line, so it may.)
063A                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
063A                             ;      read of the other builds (BDOS 10 under CP/M).
063A                             ; 
063A                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
063A                             ;  the last line left there, with TOS pushed like the rest.
063A                             ; =============================================================================
063A                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
063A                          ENDIF      
063A                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
063A                          ENDIF      
063A                          IF   EDGEN   
                              JR   edit0   
063A                          ENDIF      
063A                          IF   EDITOR   
063A                             ; ^F, right arrow: one to the right, by printing the character there
063A   7D           RIGHT:    LD   A,L   
063B   BB                     CP   E   
063C   28 4A                  JR   Z,ed1   ; at the end
063E   7E                     LD   A,(HL)   
063F   2C                     INC   L   
0640   18 2B                  JR   lf1   
0642                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0642                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0642                             ; ends the sequence, and act on C (right) and D (left).
0642   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0645   CD E3 04     ES1:      CALL   rawk   
0648   20 0A                  JR   NZ,es2   
064A   0B                     DEC   BC   
064B   78                     LD   A,B   
064C   B1                     OR   C   
064D   20 F6                  JR   NZ,es1   
064F   CD BD 06               CALL   fin   ; no second key: the line is dropped
0652   18 22                  JR   edit   
0654   FE 5B        ES2:      CP   "["   
0656   20 30                  JR   NZ,ed1   ; not a sequence known here
0658   CD 16 07     ES3:      CALL   ekey   
065B   FE 40                  CP   40h   
065D   38 F9                  JR   C,es3   ; (its parameters)
065F   D6 43                  SUB   "C"   
0661   28 D7                  JR   Z,right   
0663   3D                     DEC   A   ; "D"?
0664   20 22                  JR   NZ,ed1   ; no: on into left
0666                             ; ^B, left arrow: the cursor goes one to the left
0666   7D           LEFT:     LD   A,L   
0667   87                     ADD   A,A   
0668   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
066A   2D                     DEC   L   
066B   3E 08                  LD   A,8   
066D   EF           LF1:      RST   28h   
066E   18 18                  JR   ed1   
0670                             ; edit0: reset, an error or a break: both stacks are cleared.
0670                             ; skend: a program that ended inside skip: its return address goes.
0670                             ; edend: a program that ended: TOS joins the rest of the data stack.
0670   31 FA 0A     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0673   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0674   D1           SKEND:    POP   DE   
0675   E5           EDEND:    PUSH   HL   
0676                             ; edit: start a new input line.
0676   D9           EDIT:     EXX      
0677   21 E0 09               LD   HL,RSTOP   ; the return stack is empty
067A   D9                     EXX      
067B   21 00 00               LD   HL,0   
067E   22 7A 0B               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0681   22 3A 0B               LD   (EDLN),HL   ; no line is being edited
0684   21 80 0B               LD   HL,LINEBUF   ; HL = the cursor,
0687   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0688   CD 16 07     ED1:      CALL   ekey   
068B   FE 7F                  CP   7Fh   
068D   28 40                  JR   Z,bsp   ; DEL
068F   FE 20                  CP   " "   
0691   30 56                  JR   NC,insc   
0693   FE 09                  CP   9   
0695   28 52                  JR   Z,insc   ; Tab is text
0697   FE 08                  CP   8   
0699   28 34                  JR   Z,bsp   
069B   FE 02                  CP   2   
069D   28 C7                  JR   Z,left   ; ^B
069F   FE 06                  CP   6   
06A1   28 97                  JR   Z,right   ; ^F
06A3   FE 1B                  CP   1Bh   
06A5   28 9B                  JR   Z,esc   
06A7   E5                     PUSH   HL   ; a command key? Look it up
06A8   21 1C 07               LD   HL,cmds   
06AB   06 08                  LD   B,NCMD   
06AD   BE           ED2:      CP   (HL)   
06AE   23                     INC   HL   
06AF   28 07                  JR   Z,ed3   
06B1   23                     INC   HL   
06B2   23                     INC   HL   
06B3   10 F8                  DJNZ   ed2   
06B5   E1                     POP   HL   
06B6   18 D0                  JR   ed1   ; no: the key is ignored
06B8   7E           ED3:      LD   A,(HL)   
06B9   23                     INC   HL   
06BA   66                     LD   H,(HL)   
06BB   6F                     LD   L,A   
06BC   E3                     EX   (SP),HL   ; the command's address: fin returns to it
06BD                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
06BD                             ; terminal. Leaves BC -> the line and HL -> the NUL.
06BD   26 0B        FIN:      LD   H,LETPAGE   
06BF   6B                     LD   L,E   
06C0   36 0D                  LD   (HL),13   
06C2   2C                     INC   L   
06C3   36 0A                  LD   (HL),10   
06C5   2D                     DEC   L   
06C6   CD 1E 08               CALL   prl   ; (prints the CR LF)
06C9   36 00                  LD   (HL),0   
06CB   01 80 0B               LD   BC,LINEBUF   
06CE   C9                     RET      
06CF                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
06CF                             ; left, the rest of the line moves down over it, and the last place (now a
06CF                             ; space) is printed over along with the rest.
06CF   7D           BSP:      LD   A,L   
06D0   87                     ADD   A,A   
06D1   28 B5                  JR   Z,ed1   ; at the start
06D3   2D                     DEC   L   
06D4   3E 08                  LD   A,8   
06D6   EF                     RST   28h   
06D7   E5                     PUSH   HL   
06D8   2C           BS1:      INC   L   
06D9   7E                     LD   A,(HL)   
06DA   2D                     DEC   L   
06DB   77                     LD   (HL),A   
06DC   2C                     INC   L   
06DD   7D                     LD   A,L   
06DE   BB                     CP   E   
06DF   20 F7                  JR   NZ,bs1   
06E1   2D                     DEC   L   
06E2   36 20                  LD   (HL)," "   
06E4   E1                     POP   HL   
06E5   53                     LD   D,E   
06E6   1D                     DEC   E   
06E7   18 15                  JR   ic2   
06E9                             ; A character goes in at the cursor: it ripples up through the rest of the
06E9                             ; line, the cursor moves on, and the rest is printed again.
06E9   47           INSC:     LD   B,A   
06EA   7B                     LD   A,E   
06EB   FE FD                  CP   0FDh   
06ED   28 99                  JR   Z,ed1   ; the line is full: 125 characters
06EF   78                     LD   A,B   
06F0   EF                     RST   28h   
06F1   E5                     PUSH   HL   
06F2   7E           IC1:      LD   A,(HL)   
06F3   70                     LD   (HL),B   
06F4   47                     LD   B,A   
06F5   7D                     LD   A,L   
06F6   2C                     INC   L   
06F7   BB                     CP   E   
06F8   20 F8                  JR   NZ,ic1   
06FA   E1                     POP   HL   
06FB   2C                     INC   L   
06FC   1C                     INC   E   
06FD   53                     LD   D,E   
06FE   CD 03 07     IC2:      CALL   tail   
0701   18 85                  JR   ed1   
0703                             ; tail: print the line from the cursor to D (a low byte), and bring the
0703                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0703   4D           TAIL:     LD   C,L   
0704   7D           TA1:      LD   A,L   
0705   BA                     CP   D   
0706   28 05                  JR   Z,ta2   
0708   7E                     LD   A,(HL)   
0709   EF                     RST   28h   
070A   2C                     INC   L   
070B   18 F7                  JR   ta1   
070D   7D           TA2:      LD   A,L   
070E   B9                     CP   C   
070F   C8                     RET   Z   
0710   3E 08                  LD   A,8   
0712   EF                     RST   28h   
0713   2D                     DEC   L   
0714   18 F7                  JR   ta2   
0716                             ; ekey: wait for a key
0716   CD E3 04     EKEY:     CALL   rawk   
0719   28 FB                  JR   Z,ekey   
071B   C9                     RET      
071C                             ; The command keys, and where each goes (after fin).
071C   0D           CMDS:     DB   13   
071D   68 07                  DW   cret   
071F   07                     DB   7   ; ^G
0720   B0 07                  DW   crun   
0722   0C                     DB   12   ; ^L
0723   C6 07                  DW   clist   
0725   05                     DB   5   ; ^E
0726   41 07                  DW   cedln   
0728   12                     DB   18   ; ^R
0729   B1 08                  DW   cread   
072B   17                     DB   23   ; ^W
072C   27 08                  DW   cwrite   
072E   0E                     DB   14   ; ^N
072F   34 07                  DW   cnew   
0731   18                     DB   24   ; ^X
0732   00 00                  DW   LEAVE   
0734                NCMD:     EQU   8   
0734                             ; ^N ^N: no program, if the next key is ^N too
0734   CD 16 07     CNEW:     CALL   ekey   
0737   FE 0E                  CP   14   
0739   20 04                  JR   NZ,ged0   
073B   AF                     XOR   A   
073C   32 00 0C               LD   (PROG),A   
073F   18 6C        GED0:     JR   gedit   
0741                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0741                             ; line it was: Return puts the text back in its place.
0741   CD 2A 03     CEDLN:    CALL   rdnum   
0744   22 3A 0B               LD   (EDLN),HL   ; (no such line: `edit` clears it again)
0747   CD 06 08               CALL   find   ; HL -> the line, or the NUL if there is none
074A   7E                     LD   A,(HL)   
074B   B7                     OR   A   
074C   28 F1                  JR   Z,ged0   
074E   11 80 0B               LD   DE,LINEBUF   
0751   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0752   FE 0D                  CP   13   
0754   28 0D                  JR   Z,ce2   
0756   FE 0A                  CP   10   
0758   28 09                  JR   Z,ce2   
075A   12                     LD   (DE),A   
075B   EF                     RST   28h   
075C   23                     INC   HL   
075D   1C                     INC   E   
075E   7B                     LD   A,E   
075F   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0761   20 EE                  JR   NZ,ce1   
0763   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
0764   5D                     LD   E,L   
0765   C3 88 06               JP   ed1   
0768                             ; Return. If ^E put a line here, the text goes back in its place. If not:
0768                             ; a number and text is a line to put in, a number alone a line to take out,
0768                             ; and anything else is run where it is.
0768   E5           CRET:     PUSH   HL   ; the end of what was typed
0769   2A 3A 0B               LD   HL,(EDLN)   
076C   7C                     LD   A,H   
076D   B5                     OR   L   
076E   28 07                  JR   Z,cr1   
0770   E5                     PUSH   HL   
0771   CD F6 07               CALL   delln   
0774   E1                     POP   HL   
0775   18 13                  JR   ins   
0777   CD 2A 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
077A   79                     LD   A,C   ; C is still 80h if there was no number:
077B   87                     ADD   A,A   ;   only then is twice it 0
077C   28 36                  JR   Z,st0p   ; no number: run the line
077E   0A                     LD   A,(BC)   
077F   FE 0D                  CP   13   
0781   20 06                  JR   NZ,cr2   
0783   D1                     POP   DE   ; the number alone: take that line out
0784   CD F6 07               CALL   delln   
0787   18 24                  JR   gedit   
0789   03           CR2:      INC   BC   ; step over the one character after the number
078A                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
078A                             ; CR and LF included, and copy it in.
078A   CD 06 08     INS:      CALL   find   ; HL -> where it goes
078D   D1                     POP   DE   ; the end of what was typed
078E   7B                     LD   A,E   
078F   91                     SUB   C   ; A = the length of the text, with its CR LF
0790   C5                     PUSH   BC   ; the text
0791   4F                     LD   C,A   
0792   06 00                  LD   B,0   
0794   C5                     PUSH   BC   ; its length
0795   54                     LD   D,H   
0796   5D                     LD   E,L   ; DE = where it goes
0797   AF                     XOR   A   
0798   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0799   ED B1                  CPIR      ; HL -> one past the program's NUL
079B   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
079D   44                     LD   B,H   
079E   4D                     LD   C,L   
079F   19                     ADD   HL,DE   
07A0   2B                     DEC   HL   ; HL -> the NUL
07A1   EB                     EX   DE,HL   
07A2   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
07A3   E5                     PUSH   HL   
07A4   19                     ADD   HL,DE   ; the NUL's new place
07A5   EB                     EX   DE,HL   
07A6   ED B8                  LDDR      ; move the rest of the program up
07A8   C1                     POP   BC   ; the length
07A9   D1                     POP   DE   ; where it goes
07AA   E1                     POP   HL   ; the text
07AB   ED B0                  LDIR      
07AD   C3 76 06     GEDIT:    JP   edit   
07B0                             ; ^G: run the program. st0p: run the typed line (BC -> it).
07B0   01 00 0C     CRUN:     LD   BC,PROG   
07B3   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
07B4   E1           ST0P:     POP   HL   ; (the end of what was typed)
07B5                             ; st0: start running at BC. The heap starts after the stored program's NUL.
07B5   21 00 0C     ST0:      LD   HL,PROG   
07B8   AF                     XOR   A   
07B9   BE           ST1:      CP   (HL)   
07BA   23                     INC   HL   
07BB   20 FC                  JR   NZ,st1   
07BD   22 7C 0B               LD   (HEAP),HL   
07C0                          ENDIF      
07C0                          IF   EDITOR*CHECKED   
07C0   E7                     RST   20h   ; minus the heap"s first address: "_' may not
07C1   22 38 0B               LD   (NPEND),HL   ;   release below it
07C4                          ENDIF      
07C4                          IF   EDITOR   
07C4   E1                     POP   HL   ; TOS: the data stack is as the last line left it
07C5   F7                     RST   30h   ; (its return address is thrown away)
07C6                             ; ^L: list from line n. DE = the number of the line at HL.
07C6   CD 2A 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
07C9   7C                     LD   A,H   
07CA   B5                     OR   L   
07CB   20 01                  JR   NZ,li0   
07CD   2C                     INC   L   ;   then from line 1
07CE   E5           LI0:      PUSH   HL   
07CF   CD 06 08               CALL   find   
07D2   D1                     POP   DE   
07D3   7E           LI1:      LD   A,(HL)   
07D4   B7                     OR   A   
07D5   28 D6                  JR   Z,gedit   ; the end of the text
07D7   CD E3 04               CALL   rawk   
07DA   28 09                  JR   Z,li3   ; no key: carry on
07DC   FE 03                  CP   3   
07DE   C4 16 07               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
07E1   FE 03                  CP   3   
07E3   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
07E5   E5           LI3:      PUSH   HL   
07E6   D5                     PUSH   DE   
07E7   EB                     EX   DE,HL   
07E8   CD 96 03               CALL   pdec   ; the line's number,
07EB   3E 20                  LD   A," "   
07ED   EF                     RST   28h   ;   a space,
07EE   D1                     POP   DE   
07EF   E1                     POP   HL   
07F0   13                     INC   DE   
07F1   CD 1E 08               CALL   prl   ;   and the line
07F4   18 DD                  JR   li1   
07F6                             ; delln: take line n (in HL) out: copy everything after it down over it.
07F6   CD 06 08     DELLN:    CALL   find   
07F9   54                     LD   D,H   
07FA   5D                     LD   E,L   
07FB   CD 14 08               CALL   nxl   ; HL -> the next line
07FE   7E           DE1:      LD   A,(HL)   
07FF   12                     LD   (DE),A   
0800   23                     INC   HL   
0801   13                     INC   DE   
0802   B7                     OR   A   
0803   20 F9                  JR   NZ,de1   
0805   C9                     RET      
0806                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0806                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0806   EB           FIND:     EX   DE,HL   
0807   21 00 0C               LD   HL,PROG   
080A   1B           FI1:      DEC   DE   
080B   7A                     LD   A,D   
080C   B3                     OR   E   
080D   C8                     RET   Z   
080E   CD 14 08               CALL   nxl   
0811   20 F7                  JR   NZ,fi1   
0813   C9                     RET      
0814                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0814                             ; stop at the NUL that ends the text (and return zero).
0814   7E           NXL:      LD   A,(HL)   
0815   B7                     OR   A   
0816   C8                     RET   Z   
0817   23                     INC   HL   
0818   FE 0A                  CP   10   
081A   20 F8                  JR   NZ,nxl   
081C   B7                     OR   A   
081D   C9                     RET      
081E                             ; prl: print the line at HL, to its LF; HL -> just past it.
081E   7E           PRL:      LD   A,(HL)   
081F   EF                     RST   28h   
0820   7E                     LD   A,(HL)   
0821   23                     INC   HL   
0822   FE 0A                  CP   10   
0824   20 F8                  JR   NZ,prl   
0826   C9                     RET      
0827                          ENDIF      
0827                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                    GED1:     JP   edit   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
0827                          ENDIF      
0827                          IF   EDITOR*CPM   
0827                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
0827                             ;   put the one from the command line
0827                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
0827                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
0827                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
0827                             ; full disk or directory is not noticed: the calls fail and that is all.)
0827   CD 78 08     CWRITE:   CALL   setname   
082A   0E 13                  LD   C,19   ; delete
082C   CD 60 08               CALL   fbdos   
082F   0E 16                  LD   C,22   ; make
0831   CD 60 08               CALL   fbdos   
0834   21 00 0C               LD   HL,PROG   
0837   AF                     XOR   A   
0838   BE           CW1:      CP   (HL)   
0839   23                     INC   HL   
083A   20 FC                  JR   NZ,cw1   
083C   2B                     DEC   HL   ; HL -> the NUL
083D   E5                     PUSH   HL   
083E   06 80                  LD   B,128   
0840   36 1A        CW2:      LD   (HL),1Ah   
0842   23                     INC   HL   
0843   10 FB                  DJNZ   cw2   
0845   E1                     POP   HL   
0846   11 00 0C               LD   DE,PROG   
0849   7B           CW3:      LD   A,E   ; a record that starts before the end is written
084A   95                     SUB   L   
084B   7A                     LD   A,D   
084C   9C                     SBC   A,H   
084D   30 09                  JR   NC,cw4   
084F   E5                     PUSH   HL   
0850   0E 15                  LD   C,21   ; write, from where the record lies
0852   CD 66 08               CALL   frec   
0855   E1                     POP   HL   
0856   18 F1                  JR   cw3   
0858   36 00        CW4:      LD   (HL),0   ; the NUL again
085A   0E 10                  LD   C,16   ; close,
085C   21 76 06               LD   HL,edit   ;   and from there back to the editor
085F   E5                     PUSH   HL   
0860                             ; fbdos: BDOS function C on the file. (^W ends by running on into it.)
0860   11 5C 00     FBDOS:    LD   DE,CFCB   
0863   C3 05 00               JP   BDOS   
0866                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
0866                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
0866   D5           FREC:     PUSH   DE   
0867   C5                     PUSH   BC   
0868   0E 1A                  LD   C,26   ; set the DMA address
086A   CD 05 00               CALL   BDOS   
086D   C1                     POP   BC   
086E   CD 60 08               CALL   fbdos   
0871   D1                     POP   DE   
0872   21 80 00               LD   HL,128   
0875   19                     ADD   HL,DE   
0876   EB                     EX   DE,HL   
0877   C9                     RET      
0878                             ; setname: if a name was typed (the line does not start with its CR), put it
0878                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
0878                             ; is the current one. Then, name or no name, clear the FCB after the name,
0878                             ; as it must be before a file is opened or made.
0878   11 80 0B     SETNAME:   LD   DE,LINEBUF   
087B   1A                     LD   A,(DE)   
087C   FE 0D                  CP   13   
087E   28 26                  JR   Z,fcbclr   
0880   21 5C 00               LD   HL,CFCB   
0883   36 00                  LD   (HL),0   ; the current drive
0885   06 0B                  LD   B,11   
0887   2C           SN1:      INC   L   
0888   36 20                  LD   (HL)," "   
088A   10 FB                  DJNZ   sn1   
088C   2E 5D                  LD   L,CFCB+1   
088E   1A           SN2:      LD   A,(DE)   
088F   13                     INC   DE   
0890   FE 0D                  CP   13   
0892   28 12                  JR   Z,fcbclr   
0894   FE 2E                  CP   "."   
0896   20 04                  JR   NZ,sn3   
0898   2E 65                  LD   L,CFCB+9   ; the type
089A   18 F2                  JR   sn2   
089C   FE 61        SN3:      CP   "a"   
089E   38 02                  JR   C,sn4   
08A0   E6 5F                  AND   5Fh   ; a capital
08A2   77           SN4:      LD   (HL),A   
08A3   2C                     INC   L   
08A4   18 E8                  JR   sn2   
08A6   21 68 00     FCBCLR:   LD   HL,CFCB+12   
08A9   06 18                  LD   B,24   
08AB   36 00        FC1:      LD   (HL),0   
08AD   23                     INC   HL   
08AE   10 FB                  DJNZ   fc1   
08B0   C9                     RET      
08B1                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
08B1                             ; from now on. It runs on into load, which returns to the editor.
08B1   CD 78 08     CREAD:    CALL   setname   
08B4   21 76 06               LD   HL,edit   
08B7   E5                     PUSH   HL   
08B8                             ; load: read the file into PROG. No such file: no program. The text ends at
08B8                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
08B8                             ; goes after the last record, so the search always stops. And every line
08B8                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
08B8                             ; clear after its name: the CCP left it so, or setname did.)
08B8   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
08BA   CD 60 08               CALL   fbdos   ;   too)
08BD   11 00 0C               LD   DE,PROG   
08C0   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
08C2   CD 66 08               CALL   frec   
08C5   B7                     OR   A   
08C6   28 F8                  JR   Z,ld1   
08C8   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
08CA   21 FF 0B               LD   HL,PROG-1   
08CD   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
08CF   23           TR1:      INC   HL   
08D0   5F                     LD   E,A   ; E = the character before this one
08D1   7E                     LD   A,(HL)   
08D2   FE 1A                  CP   1Ah   
08D4   20 F9                  JR   NZ,tr1   
08D6   7B                     LD   A,E   
08D7   FE 0A                  CP   10   
08D9   28 06                  JR   Z,tr2   
08DB   36 0D                  LD   (HL),13   
08DD   23                     INC   HL   
08DE   36 0A                  LD   (HL),10   
08E0   23                     INC   HL   
08E1   36 00        TR2:      LD   (HL),0   
08E3   C9                     RET      
08E4                          ENDIF      
08E4                             ; =============================================================================
08E4                          IF   CPM   
08E4                             ; The RAM pages follow the image; the heap may grow to the BDOS.
08E4                START:       
08E4                          ENDIF      
08E4                          IF   CPM*CHECKED   
08E4                             ; Clear the lower half of the letter page: every variable starts at
08E4                             ; 0, every word cell holds 0000h, the address an undefined word is
08E4                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
08E4                             ; is held back.
08E4   21 00 0B               LD   HL,LET   
08E7   AF                     XOR   A   
08E8   77           INI1:     LD   (HL),A   
08E9   2C                     INC   L   
08EA   F2 E8 08               JP   P,ini1   ; +00h to +7Fh
08ED                          ENDIF      
08ED                          IF   CPM   
08ED   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
08F0   11 08 00               LD   DE,0008h   
08F3   01 2C 00               LD   BC,vecend-vecs   
08F6   ED B0                  LDIR      
08F8                          ENDIF      
08F8                          IF   CPM*EDITOR   
08F8   CD B8 08               CALL   load   ; the file named on the command line
08FB   C3 70 06               JP   edit0   
08FE                          ENDIF      
08FE                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
08FE                          ENDIF      
08FE                          IF   CPM   
08FE                             ; RAM pages, after the image
08FE                RSPAGE:   EQU   (imgend + 255) / 256   
08FE                DSPAGE:   EQU   RSPAGE + 1   
08FE                LETPAGE:   EQU   RSPAGE + 2   
08FE                PROG:     EQU   LETPAGE*256 + 256   
08FE                          ENDIF      
08FE                IMGEND:      


