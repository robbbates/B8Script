0460                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0460                             ; non-digit. Values wrap at 16 bits, as the spec says.
0460   21 00 00     RDNUM:    LD   HL,0   
0463   0A           RDN1:     LD   A,(BC)   
0464   D6 30                  SUB   "0"   
0466   FE 0A                  CP   10   
0468   D0                     RET   NC   
0469   03                     INC   BC   
046A   54                     LD   D,H   
046B   5D                     LD   E,L   
046C   29                     ADD   HL,HL   
046D   29                     ADD   HL,HL   
046E   19                     ADD   HL,DE   
