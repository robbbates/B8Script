1400                             ; RAM pages, after the image
1400                CPAGE:    EQU   (imgend + 255) / 256   ; the skip cache (QK builds), first, so
1400                RSPAGE:   EQU   CPAGE + QK   ;   that the letter page is still the one
1400                DSPAGE:   EQU   RSPAGE + 1   ;   just below the program text
1400                LETPAGE:   EQU   RSPAGE + 2   
1400                PROG:     EQU   LETPAGE*256 + 256   
