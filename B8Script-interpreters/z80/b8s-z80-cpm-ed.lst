0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 07               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0103                          ENDIF      
0103                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0103                          ENDIF      
0103                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0103                          ENDIF      
0103                          IF   EDGEN   
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 D1 04               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 42 04     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 EA 03               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 B2 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0134                          ENDIF      
0134   0A                     LD   A,(BC)   
0135   03                     INC   BC   
0136   D6 21                  SUB   21h   ; A = c - 21h
0138   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013A   FE 0F                  CP   0Fh   
013C   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
013E   D6 0F                  SUB   0Fh   ; A = c - 30h
0140   FE 0A                  CP   0Ah   
0142   38 58                  JR   C,digit   ; 30h-39h
0144   FE 11                  CP   11h   
0146   38 16                  JR   C,p3a   ; 3Ah-40h
0148   D6 11                  SUB   11h   ; A = c - 41h
014A   FE 1A                  CP   1Ah   
014C   38 5A                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
014E   FE 20                  CP   20h   
0150   38 0A                  JR   C,p5b   ; 5Bh-60h
0152   FE 3A                  CP   3Ah   
0154   38 4C                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0156   FE 3E                  CP   3Eh   
0158                          IF   1-CHECKED   
0158   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
015A                          ENDIF      
015A                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
015A                          ENDIF      
015A   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
015C   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
015E   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0160                .macro PTABLE,
0160                             ; 
0160                 DB      h_store & 0FFh  ; !
0160                 DB      h_str & 0FFh    ; "
0160                 DB      h_num & 0FFh    ; #
0160                 DB      h_print & 0FFh  ; $
0160                 DB      h_swap & 0FFh   ; %
0160                 DB      h_and & 0FFh    ; &
0160                 DB      h_emit & 0FFh   ; '
0160                 DB      h_open & 0FFh   ; (
0160                 DB      h_close & 0FFh  ; )
0160                 DB      h_mul & 0FFh    ; *
0160                 DB      h_add & 0FFh    ; +
0160                 DB      h_cfetch & 0FFh ; ,
0160                 DB      h_sub & 0FFh    ; -
0160                 DB      h_cstore & 0FFh ; .
0160                 DB      h_div & 0FFh    ; /
0160                 DB      h_dup & 0FFh    ; :
0160                 DB      h_drop & 0FFh   ; ;
0160                 DB      h_lt & 0FFh     ; <
0160                 DB      h_eq & 0FFh     ; =
0160                 DB      h_gt & 0FFh     ; >
0160                 DB      h_key & 0FFh    ; ?
0160                 DB      h_fetch & 0FFh  ; @
0160                 DB      h_def & 0FFh    ; [
0160                 DB      h_break & 0FFh  ; \
0160                 DB      h_ret & 0FFh    ; ]
0160                 DB      h_xor & 0FFh    ; ^
0160                 DB      h_alloc & 0FFh  ; _
0160                 DB      h_grave & 0FFh  ; `
0160                 DB      h_tor & 0FFh    ; {
0160                 DB      h_or & 0FFh     ; |
0160                 DB      h_fromr & 0FFh  ; }
0160                 DB      h_not & 0FFh    ; ~
0160                .endm
0160                 
0160                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0160                             ; untouched, and A, DE free.
0160   C6 74        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0162   5F                     LD   E,A   
0163   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0165   FE 8A                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0167   1A                     LD   A,(DE)   
0168   5F                     LD   E,A   ; the handler's low byte
0169                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0169                          ENDIF      
0169                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
0169                          ENDIF      
0169                          IF   CPM   
0169   16 01                  LD   D,1   
016B   30 01                  JR   NC,pu1   
016D   14                     INC   D   ; its page: 1 + carry
016E                PU1:         
016E                          ENDIF      
016E   D5                     PUSH   DE   ; jump to it; the stack is balanced again
016F   C9                     RET      ;   when the handler starts
0170                             ; The rest of the startup: here so that the generic reset code can reach it
0170                             ; with JR. st0: find the program's NUL; the heap starts after it.
0170                             ; (The editor build has its own copy of this, next to the editor.)
0170                             ; A checked build first clears the lower half of the letter page (A = 0):
0170                             ; every variable starts at 0, every word cell holds 0000h, the address an
0170                             ; undefined word is caught at (see e_hi), and no key is held back.
0170                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0170                          ENDIF      
0170                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0170                          ENDIF      
0170                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0170                          ENDIF      
0170                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0170                          ENDIF      
0170                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   HL,0   ; no key is held, and the break key is on
                              LD   (KEYBUF),HL   ;   (the checked build has cleared these)
0170                          ENDIF      
0170                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0170                          ENDIF      
0170                             ; In the unchecked generic editor build the table is here, in the first
0170                             ; page, which saves loading D twice. (The other builds have no room for it
0170                             ; here: theirs is further down.)
0170                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0170                          ENDIF      
0170                             ; =============================================================================
0170                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0170                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0170                             ;  is here too: it belongs to "`" and makes the page come out right.
0170                             ; =============================================================================
0170   D1           H_XOR:    POP   DE   
0171   7C                     LD   A,H   
0172   AA                     XOR   D   
0173   67                     LD   H,A   
0174   7D                     LD   A,L   
0175   AB                     XOR   E   
0176   6F                     LD   L,A   
0177   F7                     RST   30h   
0178   D1           H_OR:     POP   DE   
0179   7C                     LD   A,H   
017A   B2                     OR   D   
017B   67                     LD   H,A   
017C   7D                     LD   A,L   
017D   B3                     OR   E   
017E   6F                     LD   L,A   
017F   F7                     RST   30h   
0180   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0181   2B                     DEC   HL   
0182   F7                     RST   30h   
0183                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0183                             ; the same either way); TOS is the old pointer.
0183   ED 5B 7C 08  H_ALLOC:   LD   DE,(HEAP)   
0187                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0187                          ENDIF      
0187   19                     ADD   HL,DE   ; the new top
0188                          IF   CHECKED   
                              CALL   chkhp   
0188                          ENDIF      
0188   22 7C 08               LD   (HEAP),HL   
018B   EB                     EX   DE,HL   
018C   F7                     RST   30h   
018D   D9           EXEC:     EXX      
018E   22 34 08               LD   (RSAVE),HL   ; machine code may change the alternates
0191   D9                     EXX      
0192   CD 2B 01               CALL   jphl   
0195   D9                     EXX      
0196   2A 34 08               LD   HL,(RSAVE)   
0199   D9                     EXX      
019A   E1                     POP   HL   
019B   F7                     RST   30h   
019C                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
019C                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
019C                             ; Digits: step back onto the first digit and read the whole number.
019C   E5           DIGIT:    PUSH   HL   
019D   0B                     DEC   BC   
019E   CD 17 03               CALL   rdnum   
01A1   F7                     RST   30h   
01A2                             ; a-z: push the cell's address (the cell is the variable)
01A2   E5           LOWER:    PUSH   HL   
01A3   87                     ADD   A,A   
01A4   6F                     LD   L,A   
01A5   26 08                  LD   H,LETPAGE   
01A7   F7                     RST   30h   
01A8                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01A8                             ; the return stack, and the IP becomes the address in the letter's cell.
01A8   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01A9   EB                     EX   DE,HL   ; park TOS
01AA   87                     ADD   A,A   
01AB   6F                     LD   L,A   
01AC   26 08                  LD   H,LETPAGE   ; HL -> cell
01AE   4E                     LD   C,(HL)   
01AF   2C                     INC   L   
01B0   46                     LD   B,(HL)   ; IP = the word's body
01B1   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01B2                             ; rpushn: move the top cell of the data stack (in memory) to the return
01B2                             ; stack, then next. Everything that pushes the return stack ends here.
01B2                             ; 
01B2                             ; The break key is looked at here, so at every word call and loop-back (and
01B2                             ; block entry and "{"), but only one time in 256: B', which nothing else
01B2                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
01B2                             ; under CP/M), and this way it costs a loop two bytes and 13 T-states.
01B2   D9           RPUSHN:   EXX      
01B3   D1                     POP   DE   
01B4   2B                     DEC   HL   
01B5   72                     LD   (HL),D   
01B6   2B                     DEC   HL   
01B7   73                     LD   (HL),E   
01B8   10 05                  DJNZ   rp1   
01BA   D9                     EXX      
01BB   CD A6 03               CALL   pollk   
01BE   F7                     RST   30h   
01BF   D9           RP1:      EXX      
01C0   F7                     RST   30h   
01C1                             ; ---- machine code: the grave -----------------------------------------------
01C1                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01C1                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01C1                             ; written and its address is left. An odd last digit is consumed and dropped.
01C1                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01C1                             ; code is entered by CALL with the data stack above the return address; it
01C1                             ; must keep BC, and on return the top cell becomes the new TOS.
01C1   CD 94 03     H_GRAVE:   CALL   hexc   
01C4   30 C7                  JR   NC,exec   
01C6   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01C7   CD 94 03               CALL   hexc   
01CA   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01CC   ED 6F                  RLD      ;   overwrites it
01CE   23                     INC   HL   ; ... and RLD shifts it up under the low one
01CF   CD 94 03               CALL   hexc   
01D2   38 F2                  JR   C,hx1   
01D4   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01D6   F7                     RST   30h   
01D7                             ; ---- where the two pages meet ----------------------------------------------
01D7                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D7                             ; are in falling code order for this), and where exactly differs between the
01D7                             ; builds: NPG1 follows. Every handler below these four must start in the
01D7                             ; second page, and every one above in the first; chktab.py checks both.
01D7                             ; "]" returns: pop an address and jump to it.
01D7   CF           H_RET:    RST   08h   
01D8   42                     LD   B,D   
01D9   4B                     LD   C,E   
01DA   F7           BRK1:     RST   30h   
01DB                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01DB                             ; drops the block start, "]" returns. No closer at all ends the program.
01DB   7C           H_BREAK:   LD   A,H   
01DC   B5                     OR   L   
01DD   E1                     POP   HL   
01DE   28 FA                  JR   Z,brk1   
01E0   CD 39 03               CALL   skip   
01E3   B7                     OR   A   ; skip returns 0 for ")"
01E4   20 F1                  JR   NZ,h_ret   
01E6   CF           RDROP:    RST   08h   
01E7   F7                     RST   30h   
01E8                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01E8                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01E8                             ; the body"s address instead. Either way it then skips to the matching "]'.
01E8                             ; (The unchecked build takes anything that is not a letter as the space; the
01E8                             ; checked build stops on it.)
01E8   0A           H_DEF:    LD   A,(BC)   
01E9   03                     INC   BC   
01EA   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01EC   5F                     LD   E,A   ;   lands 64 bytes up
01ED   E6 DF                  AND   0DFh   ; fold case
01EF   FE 1A                  CP   26   
01F1   30 0B                  JR   NC,def2   ; not a letter
01F3   CB 23                  SLA   E   
01F5   16 08                  LD   D,LETPAGE   ; DE -> cell
01F7   79                     LD   A,C   
01F8   12                     LD   (DE),A   
01F9   1C                     INC   E   
01FA   78                     LD   A,B   
01FB   12                     LD   (DE),A   
01FC   18 03                  JR   skipnx   
01FE                DEF2:        
01FE                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
01FE                          ENDIF      
01FE   E5                     PUSH   HL   ; an anonymous block: push its address
01FF   60                     LD   H,B   
0200   69                     LD   L,C   
0201                SKIPNX:      
0201                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0201                          ENDIF      ;   opener, the "[", just before where it starts
0201   CD 39 03     SKIPO:    CALL   skip   
0204   F7                     RST   30h   
0205   5E           H_FETCH:   LD   E,(HL)   ; "@"
0206   23                     INC   HL   
0207   56                     LD   D,(HL)   
0208   EB                     EX   DE,HL   
0209   F7                     RST   30h   
020A                             ; =============================================================================
020A                             ;  Handlers that must start in the image's second page.
020A                             ;  "?" is the last (with "," inside it), so its long tail may run past that
020A                             ;  page.
020A                             ; =============================================================================
020A                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
020A                             ; the matching ")".
020A   7C           H_OPEN:   LD   A,H   
020B   B5                     OR   L   
020C   E1                     POP   HL   
020D   28 F2                  JR   Z,skipo   
020F   C5                     PUSH   BC   ; the block starts at the IP
0210   18 A0                  JR   rpushn   
0212                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0212                             ; drops it and carries on.
0212   7C           H_CLOSE:   LD   A,H   
0213   B5                     OR   L   
0214   E1                     POP   HL   
0215   28 CF                  JR   Z,rdrop   
0217   CF                     RST   08h   ; pop the block start ...
0218   42                     LD   B,D   
0219   4B                     LD   C,E   
021A   C5                     PUSH   BC   
021B   18 95                  JR   rpushn   ; ... and push it back
021D                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
021D                             ; "-" has two jobs: directly before a digit it starts a negative number.
021D   0A           H_SUB:    LD   A,(BC)   
021E   D6 30                  SUB   "0"   
0220   FE 0A                  CP   10   
0222   38 04                  JR   C,negnum   
0224   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0225   D1           H_ADD:    POP   DE   
0226   19                     ADD   HL,DE   
0227   F7                     RST   30h   
0228   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0229   CD 17 03               CALL   rdnum   
022C   E7                     RST   20h   
022D   F7                     RST   30h   
022E   D1           H_AND:    POP   DE   
022F   7C                     LD   A,H   
0230   A2                     AND   D   
0231   67                     LD   H,A   
0232   7D                     LD   A,L   
0233   A3                     AND   E   
0234   6F                     LD   L,A   
0235   F7                     RST   30h   
0236                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0236                             ; cells first. Flipping both sign bits turns a signed compare into an
0236                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0236                             ; carry into -1 or 0 with no branch.
0236   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0237   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0238   7C                     LD   A,H   
0239   EE 80                  XOR   80h   
023B   67                     LD   H,A   
023C   7A                     LD   A,D   
023D   EE 80                  XOR   80h   
023F   57                     LD   D,A   
0240   ED 52                  SBC   HL,DE   ; carry if HL < DE
0242   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0244   F7                     RST   30h   
0245   D1           H_EQ:     POP   DE   
0246   B7                     OR   A   
0247   ED 52                  SBC   HL,DE   
0249   7C                     LD   A,H   
024A   B5                     OR   L   
024B   FE 01                  CP   1   ; carry only if a - b = 0
024D   18 F3                  JR   tf   
024F                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
024F                             ; multiplier shifts up through A:C.
024F   D1           H_MUL:    POP   DE   ; DE = multiplicand
0250   C5                     PUSH   BC   
0251   7C                     LD   A,H   
0252   4D                     LD   C,L   ; A:C = multiplier
0253   21 00 00               LD   HL,0   
0256   06 10                  LD   B,16   
0258   29           MUL1:     ADD   HL,HL   
0259   CB 21                  SLA   C   
025B   17                     RLA      
025C   30 01                  JR   NC,mul2   
025E   19                     ADD   HL,DE   
025F   10 F7        MUL2:     DJNZ   mul1   
0261   C1                     POP   BC   
0262   F7                     RST   30h   
0263                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0263                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0263                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0263                             ; stops on it.
0263                H_DIV:       
0263                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0263                          ENDIF      
0263   D1                     POP   DE   ; DE = a, HL = b
0264   C5                     PUSH   BC   ; free BC for udiv
0265   D5                     PUSH   DE   ; a, for r's sign
0266   7A                     LD   A,D   
0267   AC                     XOR   H   
0268   F5                     PUSH   AF   ; S flag = sign of q
0269   CB 7C                  BIT   7,H   
026B   C4 20 01               CALL   NZ,neg16   ; HL = |b|
026E   EB                     EX   DE,HL   
026F   CB 7C                  BIT   7,H   
0271   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0274   CD F1 02               CALL   udiv   ; HL = q, DE = r
0277   F1                     POP   AF   
0278   FC 20 01               CALL   M,neg16   ; q's sign
027B   EB                     EX   DE,HL   ; HL = r, DE = q
027C   F1                     POP   AF   ; A = a's high byte
027D   B7                     OR   A   
027E   FC 20 01               CALL   M,neg16   ; r's sign
0281   C1                     POP   BC   
0282   D5                     PUSH   DE   ; q under r
0283   F7                     RST   30h   
0284                             ; ---- stack and storage -----------------------------------------------------
0284   E5           H_DUP:    PUSH   HL   ; ":"
0285   F7                     RST   30h   
0286   E3           H_SWAP:   EX   (SP),HL   ; "%"
0287   F7                     RST   30h   
0288                             ; (The checked build tests the address before it takes the value off the
0288                             ; stack, so that an error report shows both.)
0288                H_CSTORE:      ; "." ( c addr -- )
0288                          IF   CHECKED   
                              CALL   chkst   
0288                          ENDIF      
0288   D1                     POP   DE   
0289   73                     LD   (HL),E   
028A   DF           H_DROP:   RST   18h   ; ";" is this one byte
028B                H_STORE:      ; "!" ( n addr -- )
028B                          IF   CHECKED   
                              CALL   chkst   
028B                          ENDIF      
028B   D1                     POP   DE   
028C   73                     LD   (HL),E   
028D   23                     INC   HL   
028E   72                     LD   (HL),D   
028F   DF                     RST   18h   
0290                             ; ---- console ---------------------------------------------------------------
0290                             ; 22h pushes the address of the text after it and skips the string.
0290   E5           H_STR:    PUSH   HL   
0291   60                     LD   H,B   
0292   69                     LD   L,C   
0293   CD 2E 03               CALL   skipstr   
0296                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
0296                          ENDIF      
0296   F7                     RST   30h   
0297                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
0297                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
0297                             ; bit 6, so // and /" give themselves).
0297                          IF   1-CHECKED   
0297   7E           H_PRINT:   LD   A,(HL)   
0298   23                     INC   HL   
0299   FE 22                  CP   22h   
029B   28 0D                  JR   Z,pr9   
029D   FE 2F                  CP   "/"   
029F   20 04                  JR   NZ,pr1   
02A1   7E                     LD   A,(HL)   
02A2   23                     INC   HL   
02A3   E6 BF                  AND   0BFh   
02A5   EF           PR1:      RST   28h   
02A6   18 EF                  JR   h_print   
02A8                          ENDIF      
02A8                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
02A8                          ENDIF      
02A8   7D           H_EMIT:   LD   A,L   ; "'"
02A9   EF                     RST   28h   
02AA   DF           PR9:      RST   18h   
02AB                             ; "#" prints TOS as a signed decimal number, with no space after it.
02AB   C5           H_NUM:    PUSH   BC   
02AC   CD 5A 03               CALL   psgn   
02AF   C1                     POP   BC   
02B0   DF                     RST   18h   
02B1                             ; "?" ( n -- c ) or ( -n -- addr )
02B1                             ;   n > 0: wait about n ms for a key; 0 if none came
02B1                             ;   n = 0: wait for a key
02B1                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02B1                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02B1   CB 7C        H_KEY:    BIT   7,H   
02B3   20 19                  JR   NZ,line   
02B5   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02B7   CD B2 03     KT2:      CALL   getk   
02BA   20 0E                  JR   NZ,kt3   
02BC   1D                     DEC   E   
02BD   20 F8                  JR   NZ,kt2   
02BF   7C                     LD   A,H   ; 0? never counts down: it waits
02C0   B5                     OR   L   
02C1   28 F2                  JR   Z,kt1   
02C3   2B                     DEC   HL   
02C4   7C                     LD   A,H   
02C5   B5                     OR   L   
02C6   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02C8   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02C9   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02CA   6F           KT3:      LD   L,A   
02CB   26 00                  LD   H,0   
02CD   F7                     RST   30h   
02CE                          IF   CPM   
02CE                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02CE                             ; own line editor). It doesn't store the CR, so it is added here.
02CE   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02D1   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02D2   9F                     SBC   A,A   
02D3   A5                     AND   L   ; (0 for a count that is too big)
02D4   EE 7F                  XOR   127   ; A = the count, 127 at most
02D6                          ENDIF      
02D6                          IF   CPM*EDITOR   
02D6   CD DC 02               CALL   rdline   ; (the editor calls rdline too)
02D9   2E 80                  LD   L,LINEBUF & 0FFh   
02DB   F7                     RST   30h   
02DC                             ; rdline: read a line of at most A characters; HL -> the CR that ends it
02DC                RDLINE:      
02DC                          ENDIF      
02DC                          IF   CPM   
02DC   32 7E 08               LD   (LBHDR),A   
02DF   11 7E 08               LD   DE,LBHDR   
02E2   3E 0A                  LD   A,10   
02E4   CD F6 03               CALL   bdosx   
02E7   21 7F 08               LD   HL,LBHDR+1   
02EA   7E                     LD   A,(HL)   ; the count typed (0-127)
02EB   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
02EC   85                     ADD   A,L   ;   adding the count to L can't carry
02ED   6F                     LD   L,A   
02EE   36 0D                  LD   (HL),13   
02F0                          ENDIF      
02F0                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
02F0                          ENDIF      
02F0                          IF   CPM*EDITOR   
02F0   C9                     RET      
02F1                          ENDIF      
02F1                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
02F1                          ENDIF      
02F1                          IFN   CPM   
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
02F1                          ENDIF      ;   at most
02F1                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
02F1                          ENDIF      
02F1                          IFN   CPM   
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
02F1                          ENDIF      
02F1                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
02F1                          ENDIF      
02F1                          IF   EDGEN   
                              RET      
02F1                          ENDIF      
02F1                             ; =============================================================================
02F1                             ;  More routines (no handler starts past this point)
02F1                             ; =============================================================================
02F1                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
02F1                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
02F1                             ; while the quotient bits arrive at the bottom of C.
02F1                             ; Dividing by 2 is one shift (the spec wants that fast).
02F1   7B           UDIV:     LD   A,E   
02F2   EE 02                  XOR   2   
02F4   B2                     OR   D   
02F5   20 07                  JR   NZ,udv0   
02F7   CB 3C                  SRL   H   
02F9   CB 1D                  RR   L   ; the quotient
02FB   8F                     ADC   A,A   
02FC   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
02FD   C9                     RET      
02FE   7C           UDV0:     LD   A,H   
02FF   4D                     LD   C,L   
0300   21 00 00               LD   HL,0   
0303   06 10                  LD   B,16   
0305   CB 21        UDV1:     SLA   C   
0307   17                     RLA      
0308   ED 6A                  ADC   HL,HL   
030A   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
030C   30 02                  JR   NC,udv2   ;   always fits in 16 bits
030E   19                     ADD   HL,DE   ; too much: put it back, and cancel the
030F   0D                     DEC   C   ;   INC below
0310   0C           UDV2:     INC   C   ; a quotient bit
0311   10 F2                  DJNZ   udv1   
0313   EB                     EX   DE,HL   ; DE = remainder
0314   67                     LD   H,A   
0315   69                     LD   L,C   ; HL = quotient
0316   C9                     RET      
0317                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0317                             ; non-digit. Values wrap at 16 bits, as the spec says.
0317   21 00 00     RDNUM:    LD   HL,0   
031A   0A           RDN1:     LD   A,(BC)   
031B   D6 30                  SUB   "0"   
031D   FE 0A                  CP   10   
031F   D0                     RET   NC   
0320   03                     INC   BC   
0321   54                     LD   D,H   
0322   5D                     LD   E,L   
0323   29                     ADD   HL,HL   
0324   29                     ADD   HL,HL   
0325   19                     ADD   HL,DE   
0326   29                     ADD   HL,HL   ; HL * 10
0327   5F                     LD   E,A   
0328   16 00                  LD   D,0   
032A   19                     ADD   HL,DE   
032B   18 ED                  JR   rdn1   
032D                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
032D                             ; the next character, so "/"" does not end it. Leaves A = 22h.
032D                          IF   1-CHECKED   
032D   03           SS0:      INC   BC   
032E   0A           SKIPSTR:   LD   A,(BC)   
032F   03                     INC   BC   
0330   FE 2F                  CP   "/"   
0332   28 F9                  JR   Z,ss0   
0334   FE 22                  CP   22h   
0336   20 F6                  JR   NZ,skipstr   
0338   C9                     RET      
0339                          ENDIF      
0339                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0339                          ENDIF      
0339                             ; skip: read past text to the closer at this level, and return A = 0 if it
0339                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0339                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0339                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0339                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0339                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0339                             ; 
0339                             ; The checked build also looks at the character the skip was started by,
0339                             ; which is always the one just before where it starts: "(" must end at ")",
0339                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0339                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0339                             ; place where the skip started, for the report.
0339                SKIP:        
0339                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0339                          ENDIF      
0339   16 00                  LD   D,0   
033B   14           SK3:      INC   D   ; an opener: one deeper
033C   0A           SK1:      LD   A,(BC)   
033D                          IF   1-CHECKED   
033D   03                     INC   BC   
033E   B7                     OR   A   
033F   CA 15 01               JP   Z,endprog   
0342                          ENDIF      
0342                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0342                          ENDIF      
0342   FE 22                  CP   22h   
0344   CC 2E 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0347   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0349   28 F0                  JR   Z,sk3   
034B   3D                     DEC   A   ; ")"
034C   28 08                  JR   Z,sk4   
034E   D6 32                  SUB   "["-")"   
0350   28 E9                  JR   Z,sk3   
0352   FE 02                  CP   "]"-"["   
0354   20 E6                  JR   NZ,sk1   
0356   15           SK4:      DEC   D   
0357                          IF   1-CHECKED   
0357   C8                     RET   Z   ; the closer at this level
0358   18 E2                  JR   sk1   
035A                          ENDIF      
035A                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,endprog   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
035A                          ENDIF      
035A                             ; psgn: print HL as a signed number. Uses BC.
035A   CB 7C        PSGN:     BIT   7,H   
035C   28 04                  JR   Z,pdec   
035E   3E 2D                  LD   A,"-"   
0360   EF                     RST   28h   
0361   E7                     RST   20h   
0362                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0362                             ; Uses BC.
0362   11 0A 00     PDEC:     LD   DE,10   
0365   CD F1 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0368   7B                     LD   A,E   
0369   F5                     PUSH   AF   
036A   7C                     LD   A,H   
036B   B5                     OR   L   
036C   C4 62 03               CALL   NZ,pdec   
036F   F1                     POP   AF   
0370   C6 30                  ADD   A,"0"   
0372   EF                     RST   28h   
0373   C9                     RET      
0374                             ; =============================================================================
0374                             ;  Dispatch table: the low byte of each handler's address, in code order
0374                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0374                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0374                             ; =============================================================================
0374                             ; The handlers of the first NPG1 characters start in the image's second page.
0374                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0374                             ; differs between the builds, so the count is worked out here.
0374                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0374                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0374                PGBRK:    EQU   (h_break-BASE)/256   
0374                PGDEF:    EQU   (h_def-BASE)/256   
0374                PGFET:    EQU   (h_fetch-BASE)/256   
0374                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0374                          IF   1-TABP0   
0374                PTAB:        
0374                          ;*Macro unroll:  PTABLE
0374   8B                     DB   h_store & 0FFh   
0375   90                     DB   h_str & 0FFh   
0376   AB                     DB   h_num & 0FFh   
0377   97                     DB   h_print & 0FFh   
0378   86                     DB   h_swap & 0FFh   
0379   2E                     DB   h_and & 0FFh   
037A   A8                     DB   h_emit & 0FFh   
037B   0A                     DB   h_open & 0FFh   
037C   12                     DB   h_close & 0FFh   
037D   4F                     DB   h_mul & 0FFh   
037E   25                     DB   h_add & 0FFh   
037F   C9                     DB   h_cfetch & 0FFh   
0380   1D                     DB   h_sub & 0FFh   
0381   88                     DB   h_cstore & 0FFh   
0382   63                     DB   h_div & 0FFh   
0383   84                     DB   h_dup & 0FFh   
0384   8A                     DB   h_drop & 0FFh   
0385   36                     DB   h_lt & 0FFh   
0386   45                     DB   h_eq & 0FFh   
0387   37                     DB   h_gt & 0FFh   
0388   B1                     DB   h_key & 0FFh   
0389   05                     DB   h_fetch & 0FFh   
038A   E8                     DB   h_def & 0FFh   
038B   DB                     DB   h_break & 0FFh   
038C   D7                     DB   h_ret & 0FFh   
038D   70                     DB   h_xor & 0FFh   
038E   83                     DB   h_alloc & 0FFh   
038F   C1                     DB   h_grave & 0FFh   
0390   2C                     DB   h_tor & 0FFh   
0391   78                     DB   h_or & 0FFh   
0392   1C                     DB   h_fromr & 0FFh   
0393   80                     DB   h_not & 0FFh   
0394                PTABEND:      
0394                          ENDIF      
0394                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0394                             ; and return its value in A with the carry set; otherwise leave the IP and
0394                             ; return with the carry clear.
0394   0A           HEXC:     LD   A,(BC)   
0395   D6 30                  SUB   "0"   
0397   FE 0A                  CP   10   
0399   38 09                  JR   C,hc1   
039B   E6 DF                  AND   0DFh   
039D   D6 11                  SUB   11h   
039F   FE 06                  CP   6   
03A1   D0                     RET   NC   
03A2   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03A4   03           HC1:      INC   BC   
03A5   C9                     RET      
03A6                             ; =============================================================================
03A6                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
03A6                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
03A6                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
03A6                             ;  they are the host's KEY and CONOUT routines themselves.
03A6                             ; 
03A6                             ;  A running program reads the keyboard only through getk and pollk, which
03A6                             ;  between them give the break key its rules:
03A6                             ;    - Ctrl-C stops the program;
03A6                             ;    - any other key that the break check reads is held in KEYBUF for the
03A6                             ;      next "?", and a newer one takes its place;
03A6                             ;    - "?" (getk) takes the held key first;
03A6                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
03A6                             ;      key like any other, but two of them within about 250 ms still stop it.
03A6                             ;  Both are called straight from a handler, never from a routine under one:
03A6                             ;  the checked build's report counts on finding one return address above the
03A6                             ;  data stack.
03A6                             ; =============================================================================
03A6                          IFN   CPM   
                    RAWK:     EQU   KEY   
03A6                          ENDIF      
03A6                             ; pollk: the break check (see rpushn).
03A6   CD E8 03     POLLK:    CALL   rawk   
03A9   C8                     RET   Z   ; no key
03AA   32 7A 08               LD   (KEYBUF),A   ; held for the next "?"
03AD   FE 03                  CP   3   
03AF   C0                     RET   NZ   
03B0   18 11                  JR   ctlc   
03B2                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
03B2   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
03B3   21 7A 08               LD   HL,KEYBUF   ;   the buffer
03B6   7E                     LD   A,(HL)   
03B7   36 00                  LD   (HL),0   
03B9   E1                     POP   HL   
03BA   B7                     OR   A   
03BB   C0                     RET   NZ   
03BC   CD E8 03               CALL   rawk   
03BF   C8                     RET   Z   
03C0   FE 03                  CP   3   
03C2   C0                     RET   NZ   
03C3                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
03C3                             ; the program has turned it off, wait about 250 ms for one more key: a
03C3                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
03C3                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
03C3   3A 7B 08     CTLC:     LD   A,(BRKOFF)   
03C6   B7                     OR   A   
03C7   CA 15 01               JP   Z,brk   
03CA   D5                     PUSH   DE   
03CB   11 10 27               LD   DE,250*MSLOOP   
03CE   CD E8 03     CT1:      CALL   rawk   
03D1   20 05                  JR   NZ,ct2   
03D3   1B                     DEC   DE   
03D4   7A                     LD   A,D   
03D5   B3                     OR   E   
03D6   20 F6                  JR   NZ,ct1   
03D8   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
03D9   FE 03                  CP   3   
03DB   CA 15 01               JP   Z,brk   
03DE   B7                     OR   A   
03DF   28 03                  JR   Z,ct3   
03E1   32 7A 08               LD   (KEYBUF),A   
03E4   3E 03        CT3:      LD   A,3   
03E6   B7                     OR   A   
03E7   C9                     RET      
03E8                          IF   1-CHECKED   
03E8                BRK:      EQU   endprog   ; the unchecked build stops without a word;
03E8                          ENDIF      
03E8                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
03E8                          ENDIF      
03E8                          IF   CPM   
03E8   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03EA                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
03EA                             ; printing and could swallow a key that BDOS 6 then never sees.
03EA   D5           PUTC:     PUSH   DE   
03EB   E5                     PUSH   HL   
03EC   5F                     LD   E,A   
03ED   3E 06                  LD   A,6   
03EF   CD F6 03               CALL   bdosx   
03F2   E1                     POP   HL   
03F3   D1                     POP   DE   
03F4   B7                     OR   A   ; (for getk)
03F5   C9                     RET      
03F6                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
03F6   C5           BDOSX:    PUSH   BC   
03F7   D9                     EXX      
03F8   E5                     PUSH   HL   
03F9   D9                     EXX      
03FA   4F                     LD   C,A   
03FB   CD 05 00               CALL   BDOS   
03FE   D9                     EXX      
03FF   E1                     POP   HL   
0400   D9                     EXX      
0401   C1                     POP   BC   
0402   C9                     RET      
0403                          ENDIF      
0403                             ; =============================================================================
0403                             ;  Checked build: the checks and the error report
0403                             ; =============================================================================
0403                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,chs1   
0403                          ENDIF      
0403                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0403                          ENDIF      
0403                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0403                          ENDIF      
0403                          IF   CHECKED   
                    CHS1:     JP   e_store   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
0403                          ENDIF      
0403                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0403                          ENDIF      
0403                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0403                          ENDIF      
0403                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              JP   e_heap1   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JR   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              POP   HL   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   HL,RSTOP   
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              DB   11h   
                    E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
                              DB   11h   
                    E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
0403                          ENDIF      
0403                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0403                          ENDIF      ;   screen on it)
0403                          IF   CHECKED   
                              RST   28h   
                              DJNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
                              OR   A   ;   first value and holds nothing)
                              SBC   HL,SP   
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              PUSH   BC   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   BC   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
                                 ; phalf: print half of HL, and leave it in C
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
0403                          ENDIF      
0403                             ; =============================================================================
0403                             ;  The line editor (EDITOR = 1)
0403                             ; 
0403                             ;  The interpreter starts here, and a program that ends comes back here. Type
0403                             ;  a line and press Return:
0403                             ; 
0403                             ;    n text    put the text in as line n; the lines from n on move down.
0403                             ;              A number past the end, or 0, adds the line at the end.
0403                             ;    n         take line n out
0403                             ;    0         run the program
0403                             ;    -n        list the program from line n on (-1 lists all of it). Any key
0403                             ;              stops the list until another key is pressed; Ctrl-C ends it.
0403                             ;    anything else is run at once, as B8Script. (Start such a line with a
0403                             ;    space if it would begin with a digit or a minus sign.)
0403                             ; 
0403                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0403                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0403                             ;  125 characters, the line number and the one character after it included;
0403                             ;  that character is not stored. The text is kept as it is typed, each line
0403                             ;  ending in CR LF, at PROG. Nothing is checked.
0403                             ; 
0403                             ;  With CPM = 1 the file named on the command line is the program to start
0403                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
0403                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
0403                             ;  CP/M. Nothing is written back: there is no command to save.
0403                             ; 
0403                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
0403                             ;  its report and comes back here, with both stacks empty. The place is a
0403                             ;  line and column of the program; in a line typed here it is line 0.
0403                             ; 
0403                             ;  Things to know:
0403                             ;    - Reset empties the program (generic builds).
0403                             ;    - Words and variables last from one line to the next. A word's address
0403                             ;      points into the program, so run the program again after editing it.
0403                             ;    - Nothing is printed between a program's output and what is typed next.
0403                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0403                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0403                             ;      (The stored program never comes back to the line, so it may.)
0403                             ; =============================================================================
0403                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
0403                          ENDIF      
0403                          IF   EDITOR   
0403                             ; -n: list from line n. DE = the number of the line at HL.
0403   03           LIST:     INC   BC   
0404   CD 17 03               CALL   rdnum   ; HL = n
0407   E5                     PUSH   HL   
0408   CD B0 04               CALL   find   
040B   D1                     POP   DE   
040C   7E           LI1:      LD   A,(HL)   
040D   B7                     OR   A   
040E   28 32                  JR   Z,edit   ; the end of the text
0410   CD E8 03               CALL   rawk   
0413   28 0D                  JR   Z,li3   ; no key: carry on
0415   FE 03                  CP   3   
0417   28 29                  JR   Z,edit   ; Ctrl-C
0419   CD E8 03     LI2:      CALL   rawk   ; any other key: wait for one more
041C   28 FB                  JR   Z,li2   
041E   FE 03                  CP   3   
0420   28 20                  JR   Z,edit   
0422   E5           LI3:      PUSH   HL   
0423   D5                     PUSH   DE   
0424   EB                     EX   DE,HL   
0425   CD 62 03               CALL   pdec   ; the line's number,
0428   3E 20                  LD   A," "   
042A   EF                     RST   28h   ;   a space,
042B   D1                     POP   DE   
042C   E1                     POP   HL   
042D   13                     INC   DE   
042E   CD C8 04               CALL   prl   ;   and the line
0431   18 D9                  JR   li1   
0433                             ; Take line n (in HL) out: copy everything after it down over it.
0433   CD B0 04     DEL:      CALL   find   
0436   54                     LD   D,H   
0437   5D                     LD   E,L   
0438   CD BE 04               CALL   nxl   ; HL -> the next line
043B   7E           DE1:      LD   A,(HL)   
043C   12                     LD   (DE),A   
043D   23                     INC   HL   
043E   13                     INC   DE   
043F   B7                     OR   A   
0440   20 F9                  JR   NZ,de1   ; and fall into the editor
0442   31 FC 07     EDIT:     LD   SP,DSTOP   
0445   AF                     XOR   A   ; a key that the break check held while the
0446   32 7A 08               LD   (KEYBUF),A   ;   program ran is let go (the Ctrl-C that
0449                          ENDIF      ;   stopped it, for one)
0449                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
0449                          ENDIF      
0449                          IF   EDITOR*CPM   
0449   3E 7D                  LD   A,125   
044B                          ENDIF      
044B                          IF   EDITOR   
044B   CD DC 02               CALL   rdline   ; HL -> the CR that ended the line
044E   2C                     INC   L   
044F   36 0A                  LD   (HL),10   ; a LF after it,
0451   2D                     DEC   L   
0452   CD C8 04               CALL   prl   ; (print the CR LF: a new line)
0455   36 00                  LD   (HL),0   ;   and a NUL after that
0457   E5                     PUSH   HL   ; the end of what was typed
0458   01 80 08               LD   BC,LINEBUF   
045B   0A                     LD   A,(BC)   
045C   FE 2D                  CP   "-"   
045E   28 A3                  JR   Z,list   
0460   CD 17 03               CALL   rdnum   ; HL = the number it starts with, BC -> after
0463   79                     LD   A,C   ; C is still 80h if there was no number:
0464   87                     ADD   A,A   ;   only then is twice it 0
0465   28 0C                  JR   Z,st0   ; no number: run the line where it is
0467   0A                     LD   A,(BC)   
0468   D6 0D                  SUB   13   
046A   20 1E                  JR   NZ,ins   ; text follows the number
046C   B4                     OR   H   ; the number alone:
046D   B5                     OR   L   
046E   20 C3                  JR   NZ,del   ;   not 0: take that line out
0470   01 00 09               LD   BC,PROG   ;   0: run the program
0473                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0473   E1           ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
0474   AF                     XOR   A   
0475   67                     LD   H,A   ; no key is held, and the break key is on: a
0476   6F                     LD   L,A   ;   key left over from the last run is let go
0477   22 7A 08               LD   (KEYBUF),HL   
047A   21 00 09               LD   HL,PROG   
047D   BE           ST1:      CP   (HL)   
047E   23                     INC   HL   
047F   20 FC                  JR   NZ,st1   
0481   22 7C 08               LD   (HEAP),HL   
0484                          ENDIF      
0484                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0484                          ENDIF      
0484                          IF   EDITOR   
0484   D9                     EXX      
0485   21 E0 06               LD   HL,RSTOP   ; the return stack is empty
0488   D9                     EXX      
0489   F7                     RST   30h   ; (its return address is thrown away)
048A                             ; Put the typed text in as line n (in HL): open a gap of its length there,
048A                             ; CR and LF included, and copy it in.
048A   CD B0 04     INS:      CALL   find   ; HL -> where it goes
048D   03                     INC   BC   ; step over the one character after the number
048E   D1                     POP   DE   ; the end of what was typed
048F   7B                     LD   A,E   
0490   91                     SUB   C   ; A = the length of the text, with its CR LF
0491   C5                     PUSH   BC   ; the text
0492   4F                     LD   C,A   
0493   06 00                  LD   B,0   
0495   C5                     PUSH   BC   ; its length
0496   54                     LD   D,H   
0497   5D                     LD   E,L   ; DE = where it goes
0498   AF                     XOR   A   
0499   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
049A   ED B1                  CPIR      ; HL -> one past the program's NUL
049C   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
049E   44                     LD   B,H   
049F   4D                     LD   C,L   
04A0   19                     ADD   HL,DE   
04A1   2B                     DEC   HL   ; HL -> the NUL
04A2   EB                     EX   DE,HL   
04A3   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
04A4   E5                     PUSH   HL   
04A5   19                     ADD   HL,DE   ; the NUL's new place
04A6   EB                     EX   DE,HL   
04A7   ED B8                  LDDR      ; move the rest of the program up
04A9   C1                     POP   BC   ; the length
04AA   D1                     POP   DE   ; where it goes
04AB   E1                     POP   HL   ; the text
04AC   ED B0                  LDIR      
04AE   18 92                  JR   edit   
04B0                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
04B0                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
04B0   EB           FIND:     EX   DE,HL   
04B1   21 00 09               LD   HL,PROG   
04B4   1B           FI1:      DEC   DE   
04B5   7A                     LD   A,D   
04B6   B3                     OR   E   
04B7   C8                     RET   Z   
04B8   CD BE 04               CALL   nxl   
04BB   20 F7                  JR   NZ,fi1   
04BD   C9                     RET      
04BE                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
04BE                             ; stop at the NUL that ends the text (and return zero).
04BE   7E           NXL:      LD   A,(HL)   
04BF   B7                     OR   A   
04C0   C8                     RET   Z   
04C1   23                     INC   HL   
04C2   FE 0A                  CP   10   
04C4   20 F8                  JR   NZ,nxl   
04C6   B7                     OR   A   
04C7   C9                     RET      
04C8                             ; prl: print the line at HL, to its LF; HL -> just past it.
04C8   7E           PRL:      LD   A,(HL)   
04C9   EF                     RST   28h   
04CA   7E                     LD   A,(HL)   
04CB   23                     INC   HL   
04CC   FE 0A                  CP   10   
04CE   20 F8                  JR   NZ,prl   
04D0   C9                     RET      
04D1                          ENDIF      
04D1                             ; =============================================================================
04D1                             ;  CP/M startup (the generic build starts at address 0: see st0)
04D1                             ; =============================================================================
04D1                          IF   CPM   
04D1                             ; The RAM pages follow the image; the heap may grow to the BDOS.
04D1                START:       
04D1                          ENDIF      
04D1                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
04D1                          ENDIF      
04D1                          IF   CPM   
04D1   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
04D4   11 08 00               LD   DE,0008h   
04D7   01 2C 00               LD   BC,vecend-vecs   
04DA   ED B0                  LDIR      
04DC   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
04DF   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
04E1   CD 05 00               CALL   BDOS   ;   and the program is empty)
04E4   11 00 09               LD   DE,PROG   
04E7   D5           LD1:      PUSH   DE   
04E8   0E 1A                  LD   C,26   ; set the DMA address
04EA   CD 05 00               CALL   BDOS   
04ED   11 5C 00               LD   DE,005Ch   
04F0   0E 14                  LD   C,20   ; read the next 128 bytes
04F2   CD 05 00               CALL   BDOS   
04F5   E1                     POP   HL   ; HL = the address this record went to
04F6   B7                     OR   A   
04F7   20 07                  JR   NZ,ld2   
04F9   11 80 00               LD   DE,128   
04FC   19                     ADD   HL,DE   
04FD   EB                     EX   DE,HL   
04FE   18 E7                  JR   ld1   
0500                LD2:         
0500                          ENDIF      
0500                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0500                          ENDIF      
0500                          IF   CPM*EDITOR   
0500                             ; The editor wants the text to end where the file's text ends: at
0500                             ; the first ^Z (1Ah), which pads a text file's last record. One more
0500                             ; goes after the last record, so the search always stops. And every
0500                             ; line must end in LF: a last line without one is given a CR LF.
0500   36 1A                  LD   (HL),1Ah   
0502   21 FF 08               LD   HL,PROG-1   
0505   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
0507   23           TR1:      INC   HL   
0508   5F                     LD   E,A   ; E = the character before this one
0509   7E                     LD   A,(HL)   
050A   FE 1A                  CP   1Ah   
050C   20 F9                  JR   NZ,tr1   
050E   7B                     LD   A,E   
050F   FE 0A                  CP   10   
0511   28 06                  JR   Z,tr2   
0513   36 0D                  LD   (HL),13   
0515   23                     INC   HL   
0516   36 0A                  LD   (HL),10   
0518   23                     INC   HL   
0519   36 00        TR2:      LD   (HL),0   
051B   C3 42 04               JP   edit   
051E                          ENDIF      
051E                          IF   CPM   
051E                             ; RAM pages, after the image
051E                RSPAGE:   EQU   (imgend + 255) / 256   
051E                DSPAGE:   EQU   RSPAGE + 1   
051E                LETPAGE:   EQU   RSPAGE + 2   
051E                PROG:     EQU   LETPAGE*256 + 256   
051E                          ENDIF      
051E                IMGEND:      


