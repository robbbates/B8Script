0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpush and rpop (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP DE to throw the return address away.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms: each pass
0000                             ; calls getk once, so tune it for your clock
0000                             ; and your CONST routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
0100                          .ORG   0100h   
0100   C3 B0 04               JP   start   
0103                          ENDIF      
0103                          IFN   CPM   
                              .ORG   0000h   
                              JP   start   ; 0000h reset
                    ENDPROG:      
                              JP   EXIT   ; 0003h the program has ended
                    H_DUP:    PUSH   HL   ; 0006h ":" (two-byte handlers fill the gaps)
                              RST   10h   
                                 ; ---- RST 08h: drop TOS, then next ------------------------------------------
                              POP   DE   ; 0008h discard the RST's return address
                    DROP_NEXT:      
                              POP   HL   ; new TOS = NOS
                              JR   next0   
                    H_SWAP:   EX   (SP),HL   ; 000Ch "%"
                              RST   10h   
                              DB   0,0   ; 000Eh spare
                                 ; ---- RST 10h: next character ------------------------------------------------
                              POP   DE   ; 0010h discard the RST's return address
0103                          ENDIF      
0103                             ; =============================================================================
0103                             ;  The inner loop: read one character and sort it by range.
0103                             ; 
0103                             ;    00h          end of program
0103                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0103                             ;    30h-39h      digit: read a whole number
0103                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0103                             ;    61h-7Ah      a-z: push the address of that letter's cell
0103                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0103                             ; =============================================================================
0103                NEXT0:       
0103                          IF   CHECKED   
0103                             ; Both stacks are checked once per character, not in every handler.
0103                             ; Each stack lives in one page, so it has overrun exactly when the
0103                             ; pointer's high byte has left that page. Errors are caught one cell
0103                             ; late at most; the page below each stack is a guard band.
0103   ED 73 38 08            LD   (SPTMP),SP   
0107   3A 39 08               LD   A,(SPTMP+1)   
010A   FE 07                  CP   DSPAGE   
010C   C2 80 04               JP   NZ,e_stack   
010F   D9                     EXX      ; the return stack: in its page, and not
0110   7D                     LD   A,L   ;   above its empty position (an underflow
0111   FE E1                  CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
0113   7C                     LD   A,H   ;   guard band)
0114   D9                     EXX      
0115   D2 83 04               JP   NC,e_rstack   
0118   FE 06                  CP   RSPAGE   
011A   C2 83 04               JP   NZ,e_rstack   
011D                          ENDIF      
011D   0A                     LD   A,(BC)   
011E   03                     INC   BC   
011F   D6 21                  SUB   21h   ; A = c - 21h
0121   38 38                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0123   FE 0F                  CP   0Fh   
0125   38 26                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0127   D6 0F                  SUB   0Fh   ; A = c - 30h
0129   FE 0A                  CP   0Ah   
012B   38 4A                  JR   C,digit   ; 30h-39h
012D   FE 11                  CP   11h   
012F   30 04                  JR   NC,ab40   
0131   C6 05                  ADD   A,5   ; 3Ah-40h: index 15-21
0133   18 18                  JR   punct   
0135   D6 11        AB40:     SUB   11h   ; A = c - 41h
0137   FE 1A                  CP   1Ah   
0139   38 2D                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
013B   FE 20                  CP   20h   
013D   30 04                  JR   NC,ab60   
013F   D6 04                  SUB   4   ; 5Bh-60h: index 22-27
0141   18 0A                  JR   punct   
0143   FE 3A        AB60:     CP   3Ah   
0145   38 1B                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0147   FE 3E                  CP   3Eh   
0149   30 B8                  JR   NC,next0   ; 7Fh-FFh: ignored
014B   D6 1E                  SUB   1Eh   ; 7Bh-7Eh: index 28-31
014D                             ; Punctuation: HL holds TOS, so it is parked in DE while the table is read.
014D                             ; PTAB never crosses a page (checked at assembly), so only L needs adding.
014D   EB           PUNCT:    EX   DE,HL   ; DE = TOS
014E   87                     ADD   A,A   
014F   C6 7D                  ADD   A,PTAB & 0FFh   
0151   6F                     LD   L,A   
0152   26 01                  LD   H,PTAB / 256   
0154   7E                     LD   A,(HL)   
0155   2C                     INC   L   
0156   66                     LD   H,(HL)   
0157   6F                     LD   L,A   ; HL = handler
0158   EB                     EX   DE,HL   ; HL = TOS, DE = handler
0159   D5                     PUSH   DE   ; jump to it; the stack is balanced again
015A   C9                     RET      ;   when the handler starts
015B   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
015D   20 A4                  JR   NZ,next0   
015F   C3 00 00               JP   endprog   
0162                             ; a-z: push the cell's address (the cell is the variable)
0162   E5           LOWER:    PUSH   HL   
0163   87                     ADD   A,A   
0164   6F                     LD   L,A   
0165   26 08                  LD   H,LETPAGE   
0167   D7                     RST   10h   
0168                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0168                             ; the return stack, and the IP becomes the address in the letter's cell.
0168   E5           UPPER:    PUSH   HL   ; keep TOS
0169   87                     ADD   A,A   
016A   6F                     LD   L,A   
016B   26 08                  LD   H,LETPAGE   ; HL -> cell
016D   5E                     LD   E,(HL)   
016E   2C                     INC   L   
016F   56                     LD   D,(HL)   ; DE = the word's body
0170   E1                     POP   HL   ; TOS back
0171   CD D3 01               CALL   rpush   ; push the return address (IP)
0174   42                     LD   B,D   
0175   4B                     LD   C,E   ; IP = body
0176   D7                     RST   10h   
0177                             ; Digits: step back onto the first digit and read the whole number.
0177   E5           DIGIT:    PUSH   HL   
0178   0B                     DEC   BC   
0179   CD BD 01               CALL   rdnum   
017C   D7                     RST   10h   
017D                             ; =============================================================================
017D                             ;  Dispatch table: one handler per punctuation character, in code order.
017D                             ;  It sits right after the inner loop so that it can't cross a page (the
017D                             ;  loop only adds to the low byte of its address).
017D                             ; =============================================================================
017D   A9 02        PTAB:     DW   h_store   ; !
017F   75 03                  DW   h_str   ; "
0181   99 03                  DW   h_num   ; #
0183   7C 03                  DW   h_print   ; $
0185   94 02                  DW   h_swap   ; %
0187   57 02                  DW   h_and   ; &
0189   94 03                  DW   h_emit   ; '
018B   DF 02                  DW   h_open   ; (
018D   EC 02                  DW   h_close   ; )
018F   04 02                  DW   h_mul   ; *
0191   E5 01                  DW   h_add   ; +
0193   C0 03                  DW   h_cfetch   ; ,
0195   E8 01                  DW   h_sub   ; -
0197   B3 02                  DW   h_cstore   ; .
0199   1A 02                  DW   h_div   ; /
019B   92 02                  DW   h_dup   ; :
019D   09 00                  DW   drop_next   ; ;
019F   77 02                  DW   h_lt   ; <
01A1   87 02                  DW   h_eq   ; =
01A3   74 02                  DW   h_gt   ; >
01A5   C3 03                  DW   h_key   ; ?
01A7   A4 02                  DW   h_fetch   ; @
01A9   19 03                  DW   h_def   ; [
01AB   01 03                  DW   h_break   ; \
01AD   10 03                  DW   h_ret   ; ]
01AF   67 02                  DW   h_xor   ; ^
01B1   B9 02                  DW   h_alloc   ; _
01B3   03 04                  DW   h_grave   ; `
01B5   96 02                  DW   h_tor   ; {
01B7   5F 02                  DW   h_or   ; |
01B9   9E 02                  DW   h_fromr   ; }
01BB   6F 02                  DW   h_not   ; ~
01BD                PTABEND:      
01BD                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
01BD                             ; non-digit. Values wrap at 16 bits, as the spec says.
01BD   21 00 00     RDNUM:    LD   HL,0   
01C0   0A           RDN1:     LD   A,(BC)   
01C1   D6 30                  SUB   "0"   
01C3   FE 0A                  CP   10   
01C5   D0                     RET   NC   
01C6   03                     INC   BC   
01C7   54                     LD   D,H   
01C8   5D                     LD   E,L   
01C9   29                     ADD   HL,HL   
01CA   29                     ADD   HL,HL   
01CB   19                     ADD   HL,DE   
01CC   29                     ADD   HL,HL   ; HL * 10
01CD   5F                     LD   E,A   
01CE   16 00                  LD   D,0   
01D0   19                     ADD   HL,DE   
01D1   18 ED                  JR   rdn1   
01D3                             ; =============================================================================
01D3                             ;  Return stack. rpush pushes BC (nearly always the IP); rpop pops into DE.
01D3                             ;  HL' is the pointer. Both go through the Z80 stack to cross between the
01D3                             ;  register sets.
01D3                             ; =============================================================================
01D3   C5           RPUSH:    PUSH   BC   
01D4   D9                     EXX      
01D5   D1                     POP   DE   
01D6   2B                     DEC   HL   
01D7   72                     LD   (HL),D   
01D8   2B                     DEC   HL   
01D9   73                     LD   (HL),E   
01DA   D9                     EXX      
01DB   C9                     RET      
01DC   D9           RPOP:     EXX      
01DD   5E                     LD   E,(HL)   
01DE   23                     INC   HL   
01DF   56                     LD   D,(HL)   
01E0   23                     INC   HL   
01E1   D5                     PUSH   DE   
01E2   D9                     EXX      
01E3   D1                     POP   DE   
01E4   C9                     RET      
01E5                             ; =============================================================================
01E5                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
01E5                             ; =============================================================================
01E5   D1           H_ADD:    POP   DE   
01E6   19                     ADD   HL,DE   
01E7   D7                     RST   10h   
01E8                             ; "-" has two jobs: directly before a digit it starts a negative number.
01E8   0A           H_SUB:    LD   A,(BC)   
01E9   D6 30                  SUB   "0"   
01EB   FE 0A                  CP   10   
01ED   38 06                  JR   C,negnum   
01EF   CD FD 01               CALL   neg16   ; a - b = a + (-b)
01F2   D1                     POP   DE   
01F3   19                     ADD   HL,DE   
01F4   D7                     RST   10h   
01F5   E5           NEGNUM:   PUSH   HL   
01F6   CD BD 01               CALL   rdnum   
01F9   CD FD 01               CALL   neg16   
01FC   D7                     RST   10h   
01FD                             ; neg16: HL = -HL (keeps BC, DE)
01FD   AF           NEG16:    XOR   A   
01FE   95                     SUB   L   
01FF   6F                     LD   L,A   
0200   9F                     SBC   A,A   
0201   94                     SUB   H   
0202   67                     LD   H,A   
0203   C9                     RET      
0204                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept.
0204   D1           H_MUL:    POP   DE   ; DE = multiplicand
0205   C5                     PUSH   BC   
0206   44                     LD   B,H   
0207   4D                     LD   C,L   ; BC = multiplier
0208   21 00 00               LD   HL,0   
020B   3E 10                  LD   A,16   
020D   29           MUL1:     ADD   HL,HL   
020E   CB 21                  SLA   C   
0210   CB 10                  RL   B   
0212   30 01                  JR   NC,mul2   
0214   19                     ADD   HL,DE   
0215   3D           MUL2:     DEC   A   
0216   20 F5                  JR   NZ,mul1   
0218   C1                     POP   BC   
0219   D7                     RST   10h   
021A                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
021A                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
021A                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
021A   D1           H_DIV:    POP   DE   ; DE = a, HL = b
021B   C5                     PUSH   BC   ; free BC for udiv
021C   7A                     LD   A,D   
021D   AC                     XOR   H   
021E   F5                     PUSH   AF   ; S flag = sign of q
021F   7A                     LD   A,D   
0220   B7                     OR   A   
0221   F5                     PUSH   AF   ; S flag = sign of a (for r)
0222   CB 7C                  BIT   7,H   
0224   C4 FD 01               CALL   NZ,neg16   ; HL = |b|
0227   EB                     EX   DE,HL   
0228   CB 7C                  BIT   7,H   
022A   C4 FD 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
022D   CD 3E 02               CALL   udiv   ; BC = q, HL = r
0230   F1                     POP   AF   
0231   FC FD 01               CALL   M,neg16   ; r's sign
0234   EB                     EX   DE,HL   ; DE = r
0235   60                     LD   H,B   
0236   69                     LD   L,C   ; HL = q
0237   F1                     POP   AF   
0238   FC FD 01               CALL   M,neg16   ; q's sign
023B   C1                     POP   BC   
023C   D5                     PUSH   DE   ; r under q
023D   D7                     RST   10h   
023E                             ; udiv: unsigned HL / DE. Returns BC = quotient, HL = remainder.
023E                             ; Uses A, BC; the caller saves the IP.
023E   44           UDIV:     LD   B,H   
023F   4D                     LD   C,L   
0240   21 00 00               LD   HL,0   
0243   3E 10                  LD   A,16   
0245   CB 21        UDV1:     SLA   C   
0247   CB 10                  RL   B   
0249   ED 6A                  ADC   HL,HL   
024B   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
024D   30 03                  JR   NC,udv2   ;   always fits in 16 bits
024F   19                     ADD   HL,DE   
0250   18 01                  JR   udv3   
0252   0C           UDV2:     INC   C   
0253   3D           UDV3:     DEC   A   
0254   20 EF                  JR   NZ,udv1   
0256   C9                     RET      
0257   D1           H_AND:    POP   DE   
0258   7C                     LD   A,H   
0259   A2                     AND   D   
025A   67                     LD   H,A   
025B   7D                     LD   A,L   
025C   A3                     AND   E   
025D   6F                     LD   L,A   
025E   D7                     RST   10h   
025F   D1           H_OR:     POP   DE   
0260   7C                     LD   A,H   
0261   B2                     OR   D   
0262   67                     LD   H,A   
0263   7D                     LD   A,L   
0264   B3                     OR   E   
0265   6F                     LD   L,A   
0266   D7                     RST   10h   
0267   D1           H_XOR:    POP   DE   
0268   7C                     LD   A,H   
0269   AA                     XOR   D   
026A   67                     LD   H,A   
026B   7D                     LD   A,L   
026C   AB                     XOR   E   
026D   6F                     LD   L,A   
026E   D7                     RST   10h   
026F   CD FD 01     H_NOT:    CALL   neg16   ; ~x = -x - 1
0272   2B                     DEC   HL   
0273   D7                     RST   10h   
0274                             ; Signed compares. Flipping both sign bits turns a signed compare into an
0274                             ; unsigned one; SBC HL,HL then turns the carry into -1 or 0 with no branch.
0274   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0275   18 02                  JR   cmp   
0277   D1           H_LT:     POP   DE   ; a < b: HL = a, DE = b
0278   EB                     EX   DE,HL   
0279   7C           CMP:      LD   A,H   
027A   EE 80                  XOR   80h   
027C   67                     LD   H,A   
027D   7A                     LD   A,D   
027E   EE 80                  XOR   80h   
0280   57                     LD   D,A   
0281   B7                     OR   A   
0282   ED 52                  SBC   HL,DE   ; carry if HL < DE
0284   ED 62                  SBC   HL,HL   
0286   D7                     RST   10h   
0287   D1           H_EQ:     POP   DE   
0288   B7                     OR   A   
0289   ED 52                  SBC   HL,DE   
028B   21 00 00               LD   HL,0   
028E   20 01                  JR   NZ,eq1   
0290   2B                     DEC   HL   
0291   D7           EQ1:      RST   10h   
0292                             ; =============================================================================
0292                             ;  Stack
0292                             ; =============================================================================
0292                          IF   CPM   ; (the generic build has these in page zero)
0292   E5           H_DUP:    PUSH   HL   
0293   D7                     RST   10h   
0294   E3           H_SWAP:   EX   (SP),HL   
0295   D7                     RST   10h   
0296                          ENDIF      
0296   C5           H_TOR:    PUSH   BC   ; "{" TOS to the return stack
0297   44                     LD   B,H   
0298   4D                     LD   C,L   
0299   CD D3 01               CALL   rpush   
029C   C1                     POP   BC   
029D   CF                     RST   08h   
029E   E5           H_FROMR:   PUSH   HL   ; "}" return stack to TOS
029F   CD DC 01               CALL   rpop   
02A2   EB                     EX   DE,HL   
02A3   D7                     RST   10h   
02A4                             ; =============================================================================
02A4                             ;  Storage
02A4                             ; =============================================================================
02A4   5E           H_FETCH:   LD   E,(HL)   ; "@"
02A5   23                     INC   HL   
02A6   56                     LD   D,(HL)   
02A7   EB                     EX   DE,HL   
02A8   D7                     RST   10h   
02A9   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
02AA                          IF   CHECKED   
02AA   23                     INC   HL   ; both bytes must be in the program's space
02AB   CD CF 02               CALL   chkst   
02AE   2B                     DEC   HL   
02AF                          ENDIF      
02AF   73                     LD   (HL),E   
02B0   23                     INC   HL   
02B1   72                     LD   (HL),D   
02B2   CF                     RST   08h   
02B3   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
02B4                          IF   CHECKED   
02B4   CD CF 02               CALL   chkst   
02B7                          ENDIF      
02B7   73                     LD   (HL),E   
02B8   CF                     RST   08h   
02B9                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
02B9   EB           H_ALLOC:   EX   DE,HL   
02BA   2A 7C 08               LD   HL,(HEAP)   
02BD   E5                     PUSH   HL   
02BE   19                     ADD   HL,DE   
02BF                          IF   CHECKED   
02BF   DA 89 04               JP   C,e_heap   ; a negative count wraps: too big
02C2   3A 3A 08               LD   A,(HLIM)   
02C5   3D                     DEC   A   
02C6   BC                     CP   H   
02C7   DA 89 04               JP   C,e_heap   ; the new top must stay below the limit page
02CA                          ENDIF      
02CA   22 7C 08               LD   (HEAP),HL   
02CD   E1                     POP   HL   
02CE   D7                     RST   10h   
02CF                          IF   CHECKED   
02CF                             ; chkst: stop unless HL is in the program's own space: from the letter page
02CF                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
02CF                             ; whatever lies above the limit are safe. Memory above the heap top but
02CF                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
02CF                             ; Keeps every register.
02CF   F5           CHKST:    PUSH   AF   
02D0   7C                     LD   A,H   
02D1   FE 08                  CP   LETPAGE   
02D3   38 05                  JR   C,chk1   
02D5   3A 3A 08               LD   A,(HLIM)   
02D8   3D                     DEC   A   
02D9   BC                     CP   H   
02DA   DA 8C 04     CHK1:     JP   C,e_store   
02DD   F1                     POP   AF   
02DE   C9                     RET      
02DF                          ENDIF      
02DF                             ; =============================================================================
02DF                             ;  Flow control
02DF                             ; =============================================================================
02DF                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
02DF                             ; the matching ")".
02DF   7C           H_OPEN:   LD   A,H   
02E0   B5                     OR   L   
02E1   E1                     POP   HL   
02E2   28 04                  JR   Z,skipnx   
02E4   CD D3 01               CALL   rpush   ; the block starts at the IP
02E7   D7                     RST   10h   
02E8   CD 3D 03     SKIPNX:   CALL   skip   
02EB   D7                     RST   10h   
02EC                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
02EC                             ; drops it and carries on.
02EC   7C           H_CLOSE:   LD   A,H   
02ED   B5                     OR   L   
02EE   E1                     POP   HL   
02EF   28 0C                  JR   Z,rdrop   
02F1                          IF   CHECKED   
02F1   CD 6F 04               CALL   chkbrk   ; Ctrl-C is checked at every loop-back
02F4                          ENDIF      
02F4   CD DC 01               CALL   rpop   ; peek: pop the block start ...
02F7   42                     LD   B,D   
02F8   4B                     LD   C,E   
02F9   CD D3 01               CALL   rpush   ; ... and push it back
02FC   D7                     RST   10h   
02FD   CD DC 01     RDROP:    CALL   rpop   
0300   D7                     RST   10h   
0301                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
0301                             ; drops the block start, "]" returns. No closer at all ends the program.
0301   7C           H_BREAK:   LD   A,H   
0302   B5                     OR   L   
0303   E1                     POP   HL   
0304   28 09                  JR   Z,brk1   
0306   CD 3D 03               CALL   skip   
0309   FE 29                  CP   ")"   
030B   28 F0                  JR   Z,rdrop   
030D   18 01                  JR   h_ret   
030F   D7           BRK1:     RST   10h   
0310                             ; "]" returns: pop an address and jump to it.
0310   CD DC 01     H_RET:    CALL   rpop   
0313   42                     LD   B,D   
0314   4B                     LD   C,E   
0315                          IF   CHECKED   
0315   CD 6F 04               CALL   chkbrk   ; ... and at every word return
0318                          ENDIF      
0318   D7                     RST   10h   
0319                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0319                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0319                             ; the body"s address instead. Either way it then skips to the matching "]'.
0319   0A           H_DEF:    LD   A,(BC)   
031A   03                     INC   BC   
031B   5F                     LD   E,A   
031C   E6 DF                  AND   0DFh   ; fold case
031E   D6 41                  SUB   "A"   
0320   FE 1A                  CP   26   
0322   30 0E                  JR   NC,def2   ; not a letter
0324   7B                     LD   A,E   
0325   D6 41                  SUB   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
0327   87                     ADD   A,A   
0328   5F                     LD   E,A   
0329   16 08                  LD   D,LETPAGE   ; DE -> cell
032B   79                     LD   A,C   
032C   12                     LD   (DE),A   
032D   1C                     INC   E   
032E   78                     LD   A,B   
032F   12                     LD   (DE),A   
0330   18 B6                  JR   skipnx   
0332                DEF2:        
0332                          IF   CHECKED   
0332   7B                     LD   A,E   
0333   FE 20                  CP   " "   
0335   C2 8F 04               JP   NZ,e_brack   ; anything but a letter or a space
0338                          ENDIF      
0338   E5                     PUSH   HL   ; an anonymous block: push its address
0339   60                     LD   H,B   
033A   69                     LD   L,C   
033B   18 AB                  JR   skipnx   
033D                             ; skip: read past text to the closer at this level, and return it in A.
033D                             ; Brackets of both kinds count together; strings are stepped over whole. A
033D                             ; NUL first ends the program (for "\" with no closer; anything else that runs
033D                             ; into the NUL had unbalanced brackets anyway).
033D   16 00        SKIP:     LD   D,0   
033F   0A           SK1:      LD   A,(BC)   
0340   03                     INC   BC   
0341   B7                     OR   A   
0342   CA 00 00               JP   Z,endprog   
0345   FE 22                  CP   22h   
0347   20 05                  JR   NZ,sk2   
0349   CD 67 03               CALL   skipstr   
034C   18 F1                  JR   sk1   
034E   FE 28        SK2:      CP   "("   
0350   28 12                  JR   Z,sk3   
0352   FE 5B                  CP   "["   
0354   28 0E                  JR   Z,sk3   
0356   FE 29                  CP   ")"   
0358   28 04                  JR   Z,sk4   
035A   FE 5D                  CP   "]"   
035C   20 E1                  JR   NZ,sk1   
035E   14           SK4:      INC   D   
035F   15                     DEC   D   
0360   C8                     RET   Z   ; the closer at this level
0361   15                     DEC   D   
0362   18 DB                  JR   sk1   
0364   14           SK3:      INC   D   
0365   18 D8                  JR   sk1   
0367                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0367                             ; the next character, so "/"" does not end it.
0367   0A           SKIPSTR:   LD   A,(BC)   
0368   03                     INC   BC   
0369   FE 2F                  CP   "/"   
036B   20 03                  JR   NZ,ss1   
036D   03                     INC   BC   
036E   18 F7                  JR   skipstr   
0370   FE 22        SS1:      CP   22h   
0372   20 F3                  JR   NZ,skipstr   
0374   C9                     RET      
0375                             ; =============================================================================
0375                             ;  Console
0375                             ; =============================================================================
0375                             ; 22h pushes the address of the text after it and skips the string.
0375   E5           H_STR:    PUSH   HL   
0376   60                     LD   H,B   
0377   69                     LD   L,C   
0378   CD 67 03               CALL   skipstr   
037B   D7                     RST   10h   
037C                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
037C                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
037C                             ; that character itself.
037C   7E           H_PRINT:   LD   A,(HL)   
037D   23                     INC   HL   
037E   FE 22                  CP   22h   
0380   28 11                  JR   Z,prdone   
0382   FE 2F                  CP   "/"   
0384   20 08                  JR   NZ,pr1   
0386   7E                     LD   A,(HL)   
0387   23                     INC   HL   
0388   FE 40                  CP   40h   
038A   38 02                  JR   C,pr1   
038C   E6 BF                  AND   0BFh   
038E   CD 5C 04     PR1:      CALL   putc   
0391   18 E9                  JR   h_print   
0393   CF           PRDONE:   RST   08h   
0394   7D           H_EMIT:   LD   A,L   ; "'"
0395   CD 5C 04               CALL   putc   
0398   CF                     RST   08h   
0399                             ; "#" prints TOS as a signed decimal number, with no space after it.
0399   CB 7C        H_NUM:    BIT   7,H   
039B   28 08                  JR   Z,num1   
039D   3E 2D                  LD   A,"-"   
039F   CD 5C 04               CALL   putc   
03A2   CD FD 01               CALL   neg16   
03A5   C5           NUM1:     PUSH   BC   
03A6   CD AB 03               CALL   pdec   
03A9   C1                     POP   BC   
03AA   CF                     RST   08h   
03AB                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
03AB   11 0A 00     PDEC:     LD   DE,10   
03AE   CD 3E 02               CALL   udiv   ; BC = HL / 10, HL = digit
03B1   7D                     LD   A,L   
03B2   F5                     PUSH   AF   
03B3   60                     LD   H,B   
03B4   69                     LD   L,C   
03B5   7C                     LD   A,H   
03B6   B5                     OR   L   
03B7   C4 AB 03               CALL   NZ,pdec   
03BA   F1                     POP   AF   
03BB   C6 30                  ADD   A,"0"   
03BD   C3 5C 04               JP   putc   
03C0   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
03C1   18 1A                  JR   kt3   
03C3                             ; "?" ( n -- c ) or ( -n -- addr )
03C3                             ;   n > 0: wait about n ms for a key; 0 if none came
03C3                             ;   n = 0: wait for a key
03C3                             ;   n < 0: read a line of at most -n characters, with echo. n is not
03C3                             ;          checked: the buffer holds 127 characters and the CR, so a
03C3                             ;          program must ask for 127 or fewer.
03C3   CB 7C        H_KEY:    BIT   7,H   
03C5   20 1A                  JR   NZ,line   
03C7   11 28 00     KT1:      LD   DE,MSLOOP   ; one millisecond, roughly
03CA   CD 48 04     KT2:      CALL   getk   
03CD   20 0E                  JR   NZ,kt3   
03CF   1B                     DEC   DE   
03D0   7A                     LD   A,D   
03D1   B3                     OR   E   
03D2   20 F6                  JR   NZ,kt2   
03D4   7C                     LD   A,H   ; 0? never counts down: it waits
03D5   B5                     OR   L   
03D6   28 EF                  JR   Z,kt1   
03D8   2B                     DEC   HL   
03D9   7C                     LD   A,H   
03DA   B5                     OR   L   
03DB   20 EA                  JR   NZ,kt1   ; A = 0 if the time ran out
03DD   6F           KT3:      LD   L,A   
03DE   26 00                  LD   H,0   
03E0   D7                     RST   10h   
03E1                          IF   CPM   
03E1                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
03E1                             ; own line editor). It doesn't store the CR, so it is added here.
03E1   AF           LINE:     XOR   A   
03E2   95                     SUB   L   ; A = the count (TOS is minus the count)
03E3   32 7E 08               LD   (LBHDR),A   
03E6   C5                     PUSH   BC   
03E7   D9                     EXX      
03E8   E5                     PUSH   HL   
03E9   D9                     EXX      
03EA   11 7E 08               LD   DE,LBHDR   
03ED   0E 0A                  LD   C,10   
03EF   CD 05 00               CALL   BDOS   
03F2   D9                     EXX      
03F3   E1                     POP   HL   
03F4   D9                     EXX      
03F5   C1                     POP   BC   
03F6   21 7F 08               LD   HL,LBHDR+1   
03F9   5E                     LD   E,(HL)   ; count
03FA   16 00                  LD   D,0   
03FC   23                     INC   HL   ; HL = LINEBUF
03FD   E5                     PUSH   HL   
03FE   19                     ADD   HL,DE   
03FF   36 0D                  LD   (HL),13   
0401   E1                     POP   HL   
0402   D7                     RST   10h   
0403                          ENDIF      
0403                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     LD   A,LINEBUF & 0FFh   
                              SUB   L   ; (TOS is minus the count)
                              LD   D,A   ; D = the L of a full line
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      CALL   putc   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
                              LD   L,LINEBUF & 0FFh   
                              RST   10h   
0403                          ENDIF      
0403                             ; =============================================================================
0403                             ;  Machine code: the grave
0403                             ; =============================================================================
0403                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
0403                             ; are stored from addr until a non-hex character; then a RET (C9h) is
0403                             ; written and its address is left. An odd last digit is consumed and dropped.
0403                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
0403                             ; code is entered by CALL with the data stack above the return address; it
0403                             ; must keep BC, and on return the top cell becomes the new TOS.
0403   0A           H_GRAVE:   LD   A,(BC)   
0404   CD 37 04               CALL   hexval   
0407   38 1D                  JR   C,exec   
0409   0A           HX1:      LD   A,(BC)   
040A   CD 37 04               CALL   hexval   
040D   38 11                  JR   C,hx2   
040F   03                     INC   BC   
0410                          IF   CHECKED   
0410   CD CF 02               CALL   chkst   
0413                          ENDIF      
0413   77                     LD   (HL),A   ; the high digit goes in first ...
0414   0A                     LD   A,(BC)   
0415   CD 37 04               CALL   hexval   
0418   38 06                  JR   C,hx2   ; odd digit: consumed, and the RET below
041A   03                     INC   BC   ;   overwrites it
041B   ED 6F                  RLD      ; ... and RLD shifts it up under the low one
041D   23                     INC   HL   
041E   18 E9                  JR   hx1   
0420                HX2:         
0420                          IF   CHECKED   
0420   CD CF 02               CALL   chkst   
0423                          ENDIF      
0423   36 C9                  LD   (HL),0C9h   
0425   D7                     RST   10h   
0426   D9           EXEC:     EXX      
0427   22 34 08               LD   (RSAVE),HL   ; machine code may change the alternates
042A   D9                     EXX      
042B   11 30 04               LD   DE,exret   
042E   D5                     PUSH   DE   
042F   E9                     JP   (HL)   
0430   D9           EXRET:    EXX      
0431   2A 34 08               LD   HL,(RSAVE)   
0434   D9                     EXX      
0435   E1                     POP   HL   
0436   D7                     RST   10h   
0437                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
0437                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
0437   D6 30        HEXVAL:   SUB   "0"   
0439   FE 0A                  CP   10   
043B   3F                     CCF      
043C   D0                     RET   NC   
043D   E6 DF                  AND   0DFh   
043F   D6 11                  SUB   11h   
0441   FE 06                  CP   6   
0443   3F                     CCF      
0444   D8                     RET   C   
0445   C6 0A                  ADD   A,10   
0447   C9                     RET      
0448                             ; =============================================================================
0448                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
0448                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
0448                             ;  Both keep BC, DE, HL and HL". In the generic build they are the host"s
0448                             ;  KEY and CONOUT routines themselves.
0448                             ; =============================================================================
0448                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
0448                          ENDIF      
0448                          IF   CHECKED   
0448   3A 36 08     GETK:     LD   A,(KEYBUF)   ; a key held back by the break check
044B   B7                     OR   A   
044C   28 07                  JR   Z,gk1   
044E   F5                     PUSH   AF   
044F   AF                     XOR   A   
0450   32 36 08               LD   (KEYBUF),A   
0453   F1                     POP   AF   
0454   C9                     RET      
0455                          ENDIF      
0455                          IF   (1-CPM)*CHECKED   
                    GK1:      JP   KEY   
0455                          ENDIF      
0455                          IF   CPM*(1-CHECKED)   
                    GETK:        
0455                          ENDIF      
0455                          IF   CPM   
0455   3E FF        GK1:      LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0457   CD 5C 04               CALL   putc   
045A   B7                     OR   A   
045B   C9                     RET      
045C                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
045C                             ; printing and could swallow a key that BDOS 6 then never sees.
045C   C5           PUTC:     PUSH   BC   
045D   D5                     PUSH   DE   
045E   E5                     PUSH   HL   
045F   D9                     EXX      
0460   E5                     PUSH   HL   
0461   D9                     EXX      
0462   5F                     LD   E,A   
0463   0E 06                  LD   C,6   
0465   CD 05 00               CALL   BDOS   
0468   D9                     EXX      
0469   E1                     POP   HL   
046A   D9                     EXX      
046B   E1                     POP   HL   
046C   D1                     POP   DE   
046D   C1                     POP   BC   
046E   C9                     RET      
046F                          ENDIF      
046F                          IFN   CPM   
                    PUTC:     EQU   CONOUT   
046F                          ENDIF      
046F                             ; =============================================================================
046F                             ;  Checked build: break key and error reports
046F                             ; =============================================================================
046F                          IF   CHECKED   
046F                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
046F                             ; else is held for the next "?".
046F   3A 36 08     CHKBRK:   LD   A,(KEYBUF)   
0472   B7                     OR   A   
0473   C0                     RET   NZ   ; one key is already held
0474   CD 48 04               CALL   getk   
0477   C8                     RET   Z   
0478   FE 03                  CP   3   
047A   28 0A                  JR   Z,e_break   
047C   32 36 08               LD   (KEYBUF),A   
047F   C9                     RET      
0480                             ; Error entries. Each loads its letter and then hides the next entry inside
0480                             ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
0480   3E 53        E_STACK:   LD   A,"S"   ; data stack over or under
0482   21                     DB   21h   
0483   3E 52        E_RSTACK:   LD   A,"R"   ; return stack over or under
0485   21                     DB   21h   
0486   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C
0488   21                     DB   21h   
0489   3E 48        E_HEAP:   LD   A,"H"   ; heap past the limit
048B   21                     DB   21h   
048C   3E 57        E_STORE:   LD   A,"W"   ; write outside the program's space
048E   21                     DB   21h   
048F   3E 44        E_BRACK:   LD   A,"D"   ; bad character after [
0491                             ; error: print the letter in A, " @ " and the offset in the program of the
0491                             ; character just read, then end. For example: S @ 245
0491   31 FE 07     ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
0494   CD 5C 04               CALL   putc   
0497   3E 20                  LD   A," "   
0499   CD 5C 04               CALL   putc   
049C   3E 40                  LD   A,"@"   
049E   CD 5C 04               CALL   putc   
04A1   3E 20                  LD   A," "   
04A3   CD 5C 04               CALL   putc   
04A6   21 FF F6               LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
04A9   09                     ADD   HL,BC   ;   just read: HL = its offset
04AA   CD AB 03               CALL   pdec   
04AD   C3 00 00               JP   endprog   
04B0                          ENDIF      
04B0                             ; =============================================================================
04B0                             ;  Startup
04B0                             ; =============================================================================
04B0                START:       
04B0                          IF   CPM   
04B0                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
04B0   31 FE 07               LD   SP,DSTOP   
04B3   21 03 05               LD   HL,stubs   ; RST 08h and RST 10h stubs into page zero
04B6   11 08 00               LD   DE,0008h   
04B9   01 0D 00               LD   BC,13   
04BC   ED B0                  LDIR      
04BE   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
04C1   0E 0F                  LD   C,15   
04C3   CD 05 00               CALL   BDOS   
04C6   3C                     INC   A   
04C7   CA 00 00               JP   Z,0   ; no such file: back to CP/M
04CA   11 00 09               LD   DE,PROG   
04CD   D5           LD1:      PUSH   DE   
04CE   0E 1A                  LD   C,26   ; set the DMA address
04D0   CD 05 00               CALL   BDOS   
04D3   11 5C 00               LD   DE,005Ch   
04D6   0E 14                  LD   C,20   ; read the next 128 bytes
04D8   CD 05 00               CALL   BDOS   
04DB   E1                     POP   HL   
04DC   11 80 00               LD   DE,128   
04DF   19                     ADD   HL,DE   
04E0   EB                     EX   DE,HL   
04E1   B7                     OR   A   
04E2   28 E9                  JR   Z,ld1   
04E4   21 80 FF               LD   HL,-128   ; the failed read left nothing: back up
04E7   19                     ADD   HL,DE   
04E8   36 00                  LD   (HL),0   ; the end of the file counts as NUL
04EA   23                     INC   HL   
04EB   22 7C 08               LD   (HEAP),HL   
04EE   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
04F1   32 3A 08               LD   (HLIM),A   
04F4                          ENDIF      
04F4                          IFN   CPM   
                              LD   SP,DSTOP   
                              LD   HL,PROG   ; the heap starts after the program's NUL
                              XOR   A   
                              LD   B,A   
                              LD   C,A   
                              CPIR      
                              LD   (HEAP),HL   
04F4                          ENDIF      
04F4                          IF   (1-CPM)*CHECKED   
                              LD   A,HEAPLIM   
                              LD   (HLIM),A   
04F4                          ENDIF      
04F4   D9                     EXX      
04F5   21 E0 06               LD   HL,RSTOP   
04F8   D9                     EXX      
04F9                          IF   CHECKED   
04F9   AF                     XOR   A   
04FA   32 36 08               LD   (KEYBUF),A   
04FD                          ENDIF      
04FD   01 00 09               LD   BC,PROG   
0500   C3 03 01               JP   next0   
0503                          IF   CPM   
0503   D1           STUBS:    POP   DE   ; 0008h: drop, then next
0504   E1                     POP   HL   
0505   C3 03 01               JP   next0   
0508   00 00 00               DB   0,0,0   
050B   D1                     POP   DE   ; 0010h: next
050C   C3 03 01               JP   next0   
050F                ENDPROG:   EQU   0   ; warm boot
050F                DROP_NEXT:   EQU   0009h   
050F                             ; RAM pages, after the image
050F                RSPAGE:   EQU   (imgend + 255) / 256   
050F                DSPAGE:   EQU   RSPAGE + 1   
050F                LETPAGE:   EQU   RSPAGE + 2   
050F                PROG:     EQU   LETPAGE*256 + 256   
050F                          ENDIF      
050F                IMGEND:      


