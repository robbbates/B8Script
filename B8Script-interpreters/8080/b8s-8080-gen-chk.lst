02CE                             ;  Console
02CE                             ; =============================================================================
02CE                             ; 22h pushes the address of the text after it and skips the string.
02CE   E5           H_STR:    PUSH   H   
02CF   60                     MOV   H,B   
02D0   69                     MOV   L,C   
02D1   CD C1 02               CALL   skipstr   
02D4   D7                     RST   2   
