                              ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              TAY      
                              LDA   T1   
                              SBC   D1   
                              BCC   uv8   
                              STA   T1   
                              STY   T0   
                              INC   TL   
                    UV8:         
                              ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              TAY      
                              LDA   T1   
                              SBC   D1   
                              BCC   uv9   
                              STA   T1   
                              STY   T0   
