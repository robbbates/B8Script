0390                             ; Uses BC.
0390   11 0A 00     PDEC:     LXI   D,10   
0393   CD 7A 02               CALL   udiv   ; HL = HL / 10, C = the last digit
0396   79                     MOV   A,C   
0397   F5                     PUSH   PSW   
0398   7C                     MOV   A,H   
0399   B5                     ORA   L   
039A   C4 90 03               CNZ   pdec   
039D   F1                     POP   PSW   
039E   C6 30                  ADI   "0"   
03A0   EF                     RST   5   
03A1   C9                     RET      
03A2                             ; skip: read past text to the closer at this level, and return A = 0 if it
03A2                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03A2                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03A2                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03A2                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03A2                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
03A2                             ; 
03A2                             ; The checked build also looks at the character the skip was started by,
03A2                             ; which is always the one just before where it starts: "(" must end at ")",
03A2                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03A2                             ; quote counts as running into it. "\" takes either closer. The place where
03A2                             ; the skip started is kept on the stack, for the report.
03A2                SKIP:        
03A2                          IF   CHECKED   
03A2   C5                     PUSH   B   
03A3   0B                     DCX   B   
03A4   0A                     LDAX   B   
03A5   03                     INX   B   
03A6   5F                     MOV   E,A   ; E = the opener: ( [ or \
03A7                          ENDIF      
03A7   16 00                  MVI   D,0   
03A9   14           SK3:      INR   D   ; an opener: one deeper
03AA   0A           SK1:      LDAX   B   
03AB                          IF   1-CHECKED   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
03AB                          ENDIF      
03AB                          IF   CHECKED   
03AB   B7                     ORA   A   
03AC   CA DA 03               JZ   sk6   ; (the IP stays on the NUL)
03AF   03                     INX   B   
03B0                          ENDIF      
03B0   FE 22                  CPI   22h   
03B2   CC E6 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
03B5   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
03B7   CA A9 03               JZ   sk3   
03BA   3D                     DCR   A   ; ")"
03BB   CA C8 03               JZ   sk4   
03BE   D6 32                  SUI   "["-")"   
03C0   CA A9 03               JZ   sk3   
03C3   FE 02                  CPI   "]"-"["   
03C5   C2 AA 03               JNZ   sk1   
03C8   15           SK4:      DCR   D   
03C9                          IF   1-CHECKED   
                              RZ      ; the closer at this level
                              JMP   sk1   
03C9                          ENDIF      
03C9                          IF   CHECKED   
03C9   C2 AA 03               JNZ   sk1   
03CC   57                     MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
03CD   AB                     XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
03CE   E6 06                  ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
03D0   FE 02                  CPI   2   ;   closer, and only then
03D2   7A                     MOV   A,D   
03D3   D1                     POP   D   ; (where the skip started)
03D4   C0                     RNZ      
03D5   42                     MOV   B,D   ; N. The place is the opener
03D6   4B                     MOV   C,E   
03D7   C3 E1 03               JMP   sk7   
03DA   7B           SK6:      MOV   A,E   ; the text ran out:
03DB   E6 04                  ANI   4   
03DD   C2 7F 00               JNZ   endprog   ;   "\" with no closer ends the program
03E0   C1                     POP   B   
03E1   3E 4E        SK7:      MVI   A,"N"   
03E3   C3 F5 04               JMP   errp   ; (errp drops skip's return address)
03E6                          ENDIF      
03E6                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03E6                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03E6                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
03E6                          ENDIF      
03E6                          IF   CHECKED   
03E6                             ; The checked build never steps over a NUL: if the text runs out first it
03E6                             ; returns A = 0 with the IP on the NUL.
03E6   0A           SKIPSTR:   LDAX   B   
03E7   B7                     ORA   A   
03E8   C8                     RZ      
03E9   03                     INX   B   
03EA   FE 22                  CPI   22h   
03EC   C8                     RZ      
03ED   FE 2F                  CPI   "/"   
03EF   C2 E6 03               JNZ   skipstr   
03F2   0A                     LDAX   B   ; the escaped character
03F3   B7                     ORA   A   
03F4   C8                     RZ      
03F5   03                     INX   B   
03F6   C3 E6 03               JMP   skipstr   
03F9                          ENDIF      
03F9                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03F9                             ; and return its value in A with the carry set; otherwise leave the IP and
03F9                             ; return with the carry clear.
03F9   0A           HEXC:     LDAX   B   
03FA   D6 30                  SUI   "0"   
03FC   FE 0A                  CPI   10   
03FE   DA 0A 04               JC   hc1   
0401   E6 DF                  ANI   0DFh   
0403   D6 11                  SUI   11h   
0405   FE 06                  CPI   6   
0407   D0                     RNC      
0408   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
040A   03           HC1:      INX   B   
040B   C9                     RET      
040C                             ; =============================================================================
040C                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
040C                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
040C                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
040C                             ;  the host's KEY and CONOUT routines themselves.
040C                             ; 
040C                             ;  A running program reads the keyboard only through getk and pollk, which
040C                             ;  between them give the break key its rules:
040C                             ;    - Ctrl-C stops the program;
040C                             ;    - any other key that the break check reads is held in KEYBUF for the
040C                             ;      next "?", and a newer one takes its place;
040C                             ;    - "?" (getk) takes the held key first;
040C                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
040C                             ;      key like any other, but two of them within about 250 ms still stop it.
040C                             ;  Both are called straight from a handler, never from a routine under one:
040C                             ;  the checked build's report counts on finding one return address above the
040C                             ;  data stack, and TOS in HL.
040C                             ; =============================================================================
040C                          IFN   CPM   
040C                RAWK:     EQU   KEY   
040C                          ENDIF      
040C                             ; pollk: the break check (see rpushd).
040C   CD 06 FF     POLLK:    CALL   rawk   
040F   C8                     RZ      ; no key
0410   32 7A 82               STA   KEYBUF   ; held for the next "?"
0413   FE 03        PK1:      CPI   3   ; (getk joins here)
0415   C0                     RNZ      
0416                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0416                             ; the program has turned it off, wait about 250 ms for one more key: a
0416                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0416                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0416   3A 7B 82     CTLC:     LDA   BRKOFF   
0419   B7                     ORA   A   
041A   CA 73 04               JZ   brk   
041D   D5                     PUSH   D   
041E   11 10 27               LXI   D,250*MSLOOP   
0421   CD 06 FF     CT1:      CALL   rawk   
0424   C2 2D 04               JNZ   ct2   
0427   1B                     DCX   D   
0428   7A                     MOV   A,D   
0429   B3                     ORA   E   
042A   C2 21 04               JNZ   ct1   
042D   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
042E   FE 03                  CPI   3   
0430   CA 73 04               JZ   brk   
0433   B7                     ORA   A   
0434   CA 3A 04               JZ   ct3   
0437   32 7A 82               STA   KEYBUF   
043A   3E 03        CT3:      MVI   A,3   
043C   B7                     ORA   A   
043D   C9                     RET      
043E                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
043E   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
043F   21 7A 82               LXI   H,KEYBUF   ;   the buffer
0442   7E                     MOV   A,M   
0443   36 00                  MVI   M,0   
0445   E1                     POP   H   
0446   B7                     ORA   A   
0447   C0                     RNZ      
0448   CD 06 FF               CALL   rawk   
044B   C8                     RZ      
044C   C3 13 04               JMP   pk1   ; Ctrl-C? If not, that is the key
044F                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
044F                          ENDIF      
044F                          IF   CHECKED   
044F                BRK:      EQU   e_break   ;   the checked build reports B
044F                          ENDIF      
044F                          IF   CPM   
                    RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
044F                          ENDIF      
044F                             ; =============================================================================
044F                             ;  Checked build: the checks and the error report
044F                             ; =============================================================================
044F                          IF   CHECKED   
044F                             ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
044F                             ; it, and the old top is on the stack under the return address. Stop if the
044F                             ; new top is not below the limit page, or is below the program's end.
044F                CHKHP:       
044F                          ENDIF      
044F                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
044F                          ENDIF      
044F                          IF   CHECKED*(1-CPM)   
044F                             ; (Here the program's space is under 32K, so a top that wrapped
044F                             ; round always falls outside it.)
044F   7C                     MOV   A,H   
0450   FE F0                  CPI   HEAPLIM   
0452   D2 5E 04               JNC   e_heap   
0455                          ENDIF      
0455                          IF   CHECKED   
0455   EB                     XCHG      
0456   E5                     PUSH   H   ; the count
0457   2A 38 82               LHLD   NPEND   
045A   19                     DAD   D   ; carry: at or above the program's end
045B   E1                     POP   H   
045C   EB                     XCHG      
045D   D8                     RC      
045E   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
045F   D1                     POP   D   ;   and drop the return address (errp drops
0460   3E 48                  MVI   A,"H"   ;   the old top)
0462   C3 F5 04               JMP   errp   
0465                             ; chkst: stop unless HL is in the program's own space: from the letter page
0465                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0465                             ; whatever lies above the limit are safe. Memory above the heap top but
0465                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0465                             ; It is the page of HL + 1 that is tested, so that one test serves both
0465                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0465                             ; Keeps HL and BC. It runs on into its own error entry.
0465   23           CHKST:    INX   H   
0466   7C                     MOV   A,H   
0467   2B                     DCX   H   
0468   FE 82                  CPI   LETPAGE   
046A   DA 70 04               JC   e_store   
046D                          ENDIF      
046D                          IF   CHECKED*(1-CPM)   
046D   FE F0                  CPI   HEAPLIM   
046F   D8                     RC      
0470                          ENDIF      
0470                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
0470                          ENDIF      
0470                          IF   CHECKED   
0470                             ; Two error entries for errors found inside a routine: the first hides the
0470                             ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
0470                             ; return address.
0470   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
0472   11                     DB   11h   
0473   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
0475   C3 F5 04               JMP   errp   
0478                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0478                             ; "$", and the error report's texts). A NUL first is an error: Q.
0478   7E           PRSTR:    MOV   A,M   
0479   23                     INX   H   
047A   FE 22                  CPI   22h   
047C   C8                     RZ      
047D   B7                     ORA   A   
047E   CA 8E 04               JZ   e_dollar   
0481   FE 2F                  CPI   "/"   
0483   C2 8A 04               JNZ   prs1   
0486   7E                     MOV   A,M   
0487   23                     INX   H   
0488   E6 BF                  ANI   0BFh   
048A   EF           PRS1:     RST   5   
048B   C3 78 04               JMP   prstr   
048E   D1           E_DOLLAR:   POP   D   ; "$" ran into a NUL: drop the return address,
048F   E1                     POP   H   ;   and put the string's address back in TOS
0490   3E 51                  MVI   A,"Q"   
0492   C3 F6 04               JMP   error   
0495                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0495                             ; pnl: the same, on a new line.
0495   3E 0D        PNL:      MVI   A,13   
0497   EF                     RST   5   
0498   3E 0A                  MVI   A,10   
049A   EF                     RST   5   
049B   E3           PMSG:     XTHL      
049C   CD 78 04               CALL   prstr   
049F   E3                     XTHL      
04A0   C9                     RET      
04A1                             ; chkstk: both stacks are checked once per character, not in every handler.
04A1                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
04A1                             ; the constant carries if it is above (cells were popped that were never
04A1                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
04A1                             ; a character late at most: the bytes above DSTOP and the guard band below
04A1                             ; the page take what happens meanwhile.
04A1   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
04A2   21 05 7E               LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
04A5   39                     DAD   SP   
04A6   DA D0 04               JC   e_under   
04A9   24                     INR   H   
04AA   C2 CA 04               JNZ   e_over   
04AD   2A 34 82               LHLD   RSP   ; the return stack: in its page (or it has
04B0   7C                     MOV   A,H   ;   overflowed), and not above its empty
04B1   FE 80                  CPI   RSPAGE   ;   position (an underflow stays inside the
04B3   C2 C7 04               JNZ   e_rover   ;   page, in the guard band)
04B6   7D                     MOV   A,L   
04B7   FE E1                  CPI   RSTOP&0FFh+1   
04B9   D2 BE 04               JNC   e_runder   
04BC   EB                     XCHG      ; TOS back
04BD   C9                     RET      
04BE   21 E0 80     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
04C1   22 34 82               SHLD   RSP   
04C4   3E 72                  MVI   A,"r"   
04C6   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
04C7   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
04C9   21                     DB   21h   
04CA   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
04CC   EB                     XCHG      ; TOS back
04CD   C3 F5 04               JMP   errp   
04D0   31 FC 81     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
04D3   3E 73                  MVI   A,"s"   
04D5   C3 F6 04               JMP   error   
04D8                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
04D8                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
04D8                             ; every build: if the IP is in page zero, this was a call of an undefined
04D8                             ; word. The call is undone, so the place is the call itself.
04D8   04           E_HI:     INR   B   
04D9   05                     DCR   B   
04DA   C2 EC 04               JNZ   e_resv   
04DD   E5                     PUSH   H   
04DE   CF                     RST   1   
04DF   44                     MOV   B,H   
04E0   4D                     MOV   C,L   
04E1   E1                     POP   H   
04E2   3E 55                  MVI   A,"U"   
04E4   C3 F6 04               JMP   error   
04E7                             ; Error entries. Each loads its letter and then hides the next entry inside
04E7                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
04E7   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
04E8   4D                     MOV   C,L   ;   past the opening quote, which is the place
04E9   3E 51                  MVI   A,"Q"   
04EB   11                     DB   11h   
04EC   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
04EE   11                     DB   11h   
04EF   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
04F1   11                     DB   11h   
04F2   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
04F4   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
04F5                             ; errp: an error found inside a routine: drop its return address first.
04F5   D1           ERRP:     POP   D   
04F6                             ; error: the report, then the end. A = the letter, BC = one past the place,
04F6                             ; HL = TOS, and both stacks as the report is to show them:
04F6                             ; 
04F6                             ;   Err X @ line,col
04F6                             ;   up to 16 characters of the text from the place
04F6                             ;   Stk n: the top 8 cells at most, bottom to top
04F6                             ;   Rtn n
04F6   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
04F7   5F                     MOV   E,A   
04F8   CD 95 04               CALL   pnl   
04FB   45 72 72 20 22         DB   "Err ",22h   
0500   7B                     MOV   A,E   
0501   EF                     RST   5   
0502   CD 9B 04               CALL   pmsg   
0505   20 40 20 22            DB   " @ ",22h   
0509   0B                     DCX   B   ; BC = the place
050A                             ; The line and column. A place below the program is in the line
050A                             ; buffer: line 0. Otherwise count the LFs from the program's start;
050A                             ; DE = the line's number, HL = where it starts.
050A   21 80 82               LXI   H,LINEBUF   
050D   11 00 00               LXI   D,0   
0510   78                     MOV   A,B   
0511   FE 83                  CPI   PROG/256   
0513   DA 2D 05               JC   er3   
0516   24                     INR   H   
0517   6B                     MOV   L,E   ; HL = PROG
0518   13           ER1:      INX   D   ; a new line starts at HL
0519   E5                     PUSH   H   
051A   7D           ER2:      MOV   A,L   
051B   91                     SUB   C   
051C   7C                     MOV   A,H   
051D   98                     SBB   B   
051E   D2 2C 05               JNC   er2x   ; reached the place
0521   7E                     MOV   A,M   
0522   23                     INX   H   
0523   FE 0A                  CPI   10   
0525   C2 1A 05               JNZ   er2   
0528   F1                     POP   PSW   
0529   C3 18 05               JMP   er1   
052C   E1           ER2X:     POP   H   
052D   C5           ER3:      PUSH   B   
052E   E5                     PUSH   H   
052F   EB                     XCHG      
0530   CD 90 03               CALL   pdec   ; the line
0533   3E 2C                  MVI   A,","   
0535   EF                     RST   5   
0536   D1                     POP   D   
0537   E1                     POP   H   
0538   E5                     PUSH   H   
0539   CD C4 05               CALL   sub16   
053C   23                     INX   H   
053D   CD 90 03               CALL   pdec   ; the column
0540   CD 95 04               CALL   pnl   
0543   22                     DB   22h   
0544   E1                     POP   H   ; the text, as it is: 16 characters, or fewer
0545   06 10                  MVI   B,16   ;   if the line or the program ends first
0547   7E           ER4:      MOV   A,M   
0548   23                     INX   H   
0549   B7                     ORA   A   
054A   CA 5C 05               JZ   er5   
054D   FE 0D                  CPI   13   
054F   CA 5C 05               JZ   er5   
0552   FE 0A                  CPI   10   
0554   CA 5C 05               JZ   er5   
0557                          ENDIF      
0557                          IF   CHECKED*CPM   
                              CPI   1Ah   ; (the ^Z that pads a file's last record ends
                              JZ   er5   ;   the text too: some terminals clear the
0557                          ENDIF      ;   screen on it)
0557                          IF   CHECKED   
0557   EF                     RST   5   
0558   05                     DCR   B   
0559   C2 47 05               JNZ   er4   
