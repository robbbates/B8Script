023C                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
023C   CD                     DS   CPM,0CDh   
023D   27                     DS   CPM,ANEG&0FFh   
023E   01                     DS   CPM,ANEG/256   
023F   D1           H_ADD:    POP   D   
0240   19                     DAD   D   
