0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Motorola 6809
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ;  Follows the design of the Z80 interpreter (z80/b8s-z80.asm).
0000                             ; 
0000                             ;  The switches, in the EQU lines below (CPM is always 0: the 6809 has no
0000                             ;  CP/M; the line is kept only so that build.sh works):
0000                             ;    CHECKED  0 = no checks (spec: an unchecked build checks nothing)
0000                             ;             1 = a checked build: variables start at 0, words start
0000                             ;                 undefined, and every error in the spec's table stops the
0000                             ;                 program with the three-line report, then goes to EXIT:
0000                             ;                   Err X @ line,col
0000                             ;                   D:n: ... v v v      (n = depth, then the top 8 values)
0000                             ;                   R:n
0000                             ;                 S/s data stack over/underflow, R/r return stack over/
0000                             ;                 underflow, H heap, O store outside the program's space,
0000                             ;                 W bad character after [, U undefined word, Q no closing
0000                             ;                 quote, X reserved byte, Z divide by zero, N unbalanced or
0000                             ;                 mismatched brackets, B Ctrl-C.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost few bytes: a
0000                             ;                 skip cache, a faster skip, "*" quicker when a high byte is
0000                             ;                 0, "/" by any power of two as a shift, and (unchecked) a
0000                             ;                 variable and its "@" or "!" in one step. See "Speed-ups".
0000                             ;                 The heap limit is a page lower (EF00h): the skip cache has
0000                             ;                 the page above it.
0000                             ;             2 = fast: base, and a dispatch table besides, with
0000                             ;                 no size limit. See "The fast build". The image starts at
0000                             ;                 E000h, the heap limit is DF00h and the skip cache is at
0000                             ;                 DF00h-DFFFh.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (the unchecked build goes
0000                             ;  to EXIT without a word): see the console layer below for the rules, the
0000                             ;  held key and the break-off cell at 827Bh.
0000                             ; 
0000                             ;  Assembler: asm80, M6809 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0 (no CP/M on the 6809)
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   1   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  base build takes; the fast build has its own)
0000                             ; (asm80 can't nest IF, and IF takes any value
0000                             ;  but 0 as true, so IF CHECKED+QK means "either")
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    Y    IP: the address of the next program character to read
0000                             ;    U    the data stack pointer. The stack grows down and U points at the
0000                             ;         top cell (TOS); nothing is cached in a register, because every
0000                             ;         dispatch needs A, B and X as scratch. Cells are big-endian here.
0000                             ;         (Only the stacks are big-endian: cells in RAM that the program can
0000                             ;         see - variables, the heap pointer, anything @ and ! reach - are
0000                             ;         little-endian, as the spec says, so @ and ! swap the bytes.)
0000                             ;    S    the return stack. A word call is a plain push of Y. Entries are
0000                             ;         2 bytes, big-endian. Handlers are called with JSR, so the return
0000                             ;         address of the dispatcher is on top of S while a handler runs.
0000                             ;    DP   the letter page, so the letter-page variables below cost 2-byte
0000                             ;         direct addressing. Nothing else may change DP.
0000                             ;    A B X are scratch. Every handler is entered by JSR and ends in RTS (one
0000                             ;    byte). A handler that pushes or pops the return stack first pulls the
0000                             ;    dispatcher's return address into X (PULS X) and ends with JMP ,X.
0000                             ; 
0000                             ;  Dispatch (unchecked build). PTAB holds one byte per punctuation character:
0000                             ;  the low byte of the handler's distance from PTAB. The handlers of the last
0000                             ;  characters (in code order) start within 256 bytes after PTAB, the handlers
0000                             ;  of the first NPG1 characters in the 256 bytes after that. The assembler
0000                             ;  works NPG1 out from where five handlers landed, and testing/chktab09.py
0000                             ;  checks the layout. The checked build is bigger than that reach, so its
0000                             ;  table holds whole addresses instead. (The fast build has neither: its
0000                             ;  table, FTAB, has an address for every byte. See "The fast build".)
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM areas:
0000                             ; 
0000                             ;    8000h-80FFh  return stack (S); empty = 8100h. Unchecked: 127 entries.
0000                             ;                 Checked: 96 entries (S down to 8040h); the 64 bytes below
0000                             ;                 are a guard band for what a handler, the console routines
0000                             ;                 and interrupts push on top of a full stack before the check
0000                             ;                 runs (the escapes of "$" take up to 22 of them, so 42 are
0000                             ;                 left for CONOUT and interrupts).
0000                             ;    8100h-81FFh  data stack (U). Unchecked: 127 cells, empty = 8200h.
0000                             ;                 Checked: 125 cells (U from 81FCh, empty, down to 8102h):
0000                             ;                 the 4 bytes above are a guard band, so a handler that runs
0000                             ;                 on an empty stack writes there and not on the letter
0000                             ;                 cells. A push past the last cell lands on 8100h, still in
0000                             ;                 this page, and the program stops with S. (It must not
0000                             ;                 reach 80FEh: with the return stack empty, the handler's
0000                             ;                 own return address is there. pdec's cell for its divisor,
0000                             ;                 under "#" or a /a in "$" on a full stack, lands on 8100h
0000                             ;                 too.)
0000                             ;    8200h-82FFh  letter page (LET): A..Z at +00h..+33h, a..z at +40h..+73h
0000                             ;                 (a word cell is always 64 bytes below its variable), the
0000                             ;                 heap pointer at +7Ch (= z10+), interpreter variables in the
0000                             ;                 gaps, and the -n? line buffer at +80h..+FFh. The break-off
0000                             ;                 cell is at +7Bh (827Bh); +7Ah is free.
0000                             ;    8300h-       PROG, the program text, NUL-terminated; the heap starts
0000                             ;                 after the NUL and grows to HEAPLIM*256 (F000h; EF00h
0000                             ;                 with base, DF00h in the fast build)
0000                             ;    EF00h-EFFFh  base: the skip cache (CPAGE), the page at the heap limit,
0000                             ;                 which the heap never reaches. (Fast build: DF00h-DFFFh.)
0000                             ;    F000h-       this image (ROM). The reset vector (FFFEh) must point to
0000                             ;                 `start` (see the listing); the image does not contain it.
0000                             ;                 (The fast build's image starts at E000h.)
0000                             ;    FF03h-FF17h  the console routines (CONOUT, KEY, and with ANSI = 0
0000                             ;                 CONCLS, CONEOL, CONCUR, CONAT) and EXIT are supplied by
0000                             ;                 the system and need no space here.
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LET..HEAPLIM*256.
0000                             ; -----------------------------------------------------------------------------
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (end the
0000                             ;   routine with TSTA / RTS, or a plain LDA).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   Both are called with JSR. They may change A and CC and must preserve
0000                             ;   B, X, Y, U and DP.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these as subroutines (each
0000                             ; ends with RTS). All four may change A, B, X and CC, and must keep Y, U
0000                             ; and DP.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row X, column D, both counted
0000                             ;     from 0
0000                          ENDIF      
0000                RSPAGE:   EQU   80h   
0000                DSPAGE:   EQU   81h   
0000                LETPAGE:   EQU   82h   
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                             ; (the checked startup counts on it being
0000                             ; the page after LETPAGE)
0000                ROM:      EQU   0F000h-FAST*1000h   ; where the image starts (the fast build: E000h)
0000                HEAPLIM:   EQU   ROM/256-QK   ; the heap must stay below F000h (a page);
0000                             ;   with base EF00h, the fast build DF00h
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (base and the speed
0000                             ;   build): the page at the heap limit
0000                MSLOOP:   EQU   20   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (direct-page offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   7Ch   ; z10+, the heap pointer (little-endian)
0000                KEYBUF:   EQU   34h   ; gap after Z: a key held back by the break check
0000                COUNT:    EQU   35h   ; the break check's countdown (1 look in 256)
0000                AT:       EQU   36h   ; checked: the address of the character being
0000                             ;   run (big-endian), the place an error reports
0000                PEND:     EQU   38h   ; checked: the program's end, the first byte
0000                             ;   after its NUL (big-endian): the heap's floor
0000                SSAV:     EQU   3Ah   ; checked: S as each character starts (big-
0000                             ;   endian): the return stack an error reports
0000                PSAV:     EQU   3Ch   ; checked: the address "$" prints from (big-
0000                             ;   endian), put back on the stack for a Q
0000                BRKOFF:   EQU   7Bh   ; the break-off cell (827Bh, z9+): 0 = the
0000                             ;   break key is on
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+100h   ; empty return stack
0000                RSLIM:    EQU   RSPAGE*256+40h   ; checked: S may go no lower between characters
0000                RSREP:    EQU   RSTOP-16   ; checked: S while the error report runs
0000                DSTOP:    EQU   DSPAGE*256+100h-4*CHECKED   ; empty data stack (a guard if checked)
0000                DSLIM:    EQU   DSPAGE*256+2   ; checked: U may go no lower between characters
0000                             ; The fast build's dispatcher, inline at the end of each of its own entries
0000                             ; (see "The fast build", at the end). The checked one calls fchk first.
0000                             ; (A count of 0 makes DS write nothing; DS needs fchk's address before the
0000                             ; first use, so fchk comes first in that part.)
0000                          IF   FAST*CHECKED   
                    ACHK:     EQU   fchk   
0000                          ENDIF      
0000                          IF   1-FAST*CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      CHECKED,0BDh    ; (checked: JSR fchk)
0000                 DS      CHECKED,ACHK/256
0000                 DS      CHECKED,ACHK&0FFh
0000                 LDB     ,Y+             ; the character,
0000                 LDX     #FTAB
0000                 ABX
0000                 ABX                     ;   its entry in the table,
0000                 JMP     [,X]            ;   and its handler
0000                .endm
0000                 
F000                          .ORG   ROM   
F000                             ; =============================================================================
F000                             ;  Startup
F000                             ; =============================================================================
F000   10 CE 81 00  START:    LDS   #RSTOP   
F004   CE 81 FC               LDU   #DSTOP   
F007                          IF   QK   
F007                             ; Empty the skip cache: a start of 0000h matches no skip.
F007   8E EF 00               LDX   #CPAGE*256   
F00A   5F                     CLRB      
F00B   6F 80        SKZ:      CLR   ,X+   
F00D   5A                     DECB      
F00E   26 FB                  BNE   skz   
F010                          ENDIF      
F010   86 82                  LDA   #LETPAGE   
F012   1F 8B                  TFR   A,DP   
F014                          IF   CHECKED   
F014                             ; Zero the whole letter page: every variable starts at 0, every word
F014                             ; cell at 0 (undefined: a call stops with U), and so do the
F014                             ; interpreter's own cells in the gaps (KEYBUF and the rest). A is
F014                             ; still LETPAGE; 256 rounds leave X at the next page, PROG.
F014   5F                     CLRB      
F015   1F 01                  TFR   D,X   
F017   6F 80        SZ:       CLR   ,X+   
F019   5A                     DECB      
F01A   26 FB                  BNE   sz   
F01C                          ENDIF      
F01C                          IF   1-CHECKED   
                              CLR   <KEYBUF   ; no key held
                              CLR   <BRKOFF   ; the break key is on
                              LDX   #PROG   
F01C                          ENDIF      
F01C   1F 12                  TFR   X,Y   ; the reading position; the heap starts
F01E   A6 80        SC:       LDA   ,X+   ;   after the program's NUL
F020   26 FC                  BNE   sc   
F022   1F 10                  TFR   X,D   
F024   D7 7C                  STB   <HEAP   ; (little-endian)
F026   97 7D                  STA   <HEAP+1   
F028                          IF   CHECKED   
F028   9F 38                  STX   <PEND   ; the heap may never go below this
F02A                          ENDIF      
F02A                             ; =============================================================================
F02A                             ;  The inner loop: read one character and sort it by range.
F02A                             ; 
F02A                             ;    00h          end of program
F02A                             ;    01h-20h, 7Fh       ignored (control, space, DEL)
F02A                             ;    80h-FFh      reserved: ignored, or X in the checked build
F02A                             ;    30h-39h      digit: read a whole number
F02A                             ;    41h-5Ah      A-Z: call the word in that letter's cell
F02A                             ;    61h-7Ah      a-z: push the address of that letter's cell
F02A                             ;    the rest     punctuation: JSR through PTAB, 32 entries, in code order
F02A                             ; =============================================================================
F02A                          IF   FAST   
                              JMP   fnext   ; (the fast build has its own: see the end)
F02A                          ENDIF      
F02A                          IF   1-FAST   
F02A                NEXT:        
F02A                          ENDIF      
F02A                          IF   CHECKED*(1-FAST)   
F02A                             ; Both stacks are checked once per character, not in every handler:
F02A                             ; the pointer minus its limit, taken as unsigned, must be no more
F02A                             ; than the stack's size. Below the limit (an overflow) it wraps to
F02A                             ; FFxxh, and the compare leaves N set; above the empty point (an
F02A                             ; underflow) it is just over the size, and N is clear.
F02A   30 C9 7E FE            LEAX   (0-DSLIM)&0FFFFh,U   
F02E   8C 00 FA               CMPX   #DSTOP-DSLIM   
F031   22 61                  BHI   e_ds   
F033   30 E9 7F C0            LEAX   (0-RSLIM)&0FFFFh,S   
F037   8C 00 C0               CMPX   #RSTOP-RSLIM   
F03A   22 61                  BHI   e_rs   
F03C   10 9F 36               STY   <AT   ; the place, should this character fail
F03F   10 DF 3A               STS   <SSAV   ; and the return stack, as it is now
F042                          ENDIF      
F042                          IF   1-FAST   
F042   A6 A0                  LDA   ,Y+   
F044   27 72                  BEQ   fin   ; NUL ends the program
F046   80 21                  SUBA   #21h   ; A = c - 21h
F048   25 E0                  BLO   next   ; 01h-20h ignored
F04A   81 0F                  CMPA   #0Fh   
F04C   25 22                  BLO   punct   ; 21h-2Fh: PTAB index 0-14
F04E   81 19                  CMPA   #19h   
F050   25 26                  BLO   digit   ; 30h-39h
F052   81 20                  CMPA   #20h   
F054   25 18                  BLO   p3a   ; 3Ah-40h: A = 19h-1Fh
F056   80 20                  SUBA   #20h   ; A = c - 41h
F058   81 1A                  CMPA   #1Ah   
F05A   25 28                  BLO   upper   ; 41h-5Ah: A = letter index 0-25
F05C   81 20                  CMPA   #20h   
F05E   25 0C                  BLO   p5b   ; 5Bh-60h
F060   81 3A                  CMPA   #3Ah   
F062   25 1A                  BLO   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
F064   81 3E                  CMPA   #3Eh   
F066                          ENDIF      
F066                          IF   (1-CHECKED)*(1-FAST)   
                              BHS   next   ; 7Fh-FFh: ignored
F066                          ENDIF      
F066                          IF   CHECKED*(1-FAST)   
F066   27 C2                  BEQ   next   ; 7Fh (DEL): ignored
F068   22 43                  BHI   e_resv   ; 80h-FFh: reserved
F06A                          ENDIF      
F06A                          IF   1-FAST   
F06A   80 1A                  SUBA   #1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
F06C   8B 06        P5B:      ADDA   #6   ; 5Bh-60h: -4 in all, index 22-27
F06E   80 0A        P3A:      SUBA   #0Ah   ; 3Ah-40h: index 15-21
F070                             ; Punctuation: A = the PTAB index.
F070   8E F1 22     PUNCT:    LDX   #PTAB   
F073                          ENDIF      
F073                          IF   (1-CHECKED)*(1-FAST)   
                                 ; The handler is at PTAB + D, where B is the table byte and A is 1
                                 ; for the first NPG1 characters, 0 for the rest.
                              LDB   A,X   
                              CMPA   #NPG1   ; carry: one of the first NPG1
                              LDA   #0   ; (leaves the carry alone)
                              ROLA      
                              JSR   D,X   ; the handler ends in RTS
F073                          ENDIF      
F073                          IF   CHECKED*(1-FAST)   
F073   48                     ASLA      ; the table holds whole addresses
F074   AD 96                  JSR   [A,X]   
F076                          ENDIF      
F076                          IF   1-FAST   
F076   20 B2                  BRA   next   
F078                             ; Digits: step back onto the first digit and read the whole number.
F078   31 3F        DIGIT:    LEAY   -1,Y   
F07A   8D 4D                  BSR   rdnum   
F07C   20 AC                  BRA   next   
F07E                          ENDIF      
F07E                             ; a-z: push the cell's address (the cell is the variable)
F07E                             ;  (the unchecked base build does x@ and x! in one step)
F07E                          IF   (1-SBASEU)*(1-FAST)   
F07E   8D 3B        LOWER:    BSR   cellx   
F080   36 10                  PSHU   X   
F082   20 A6                  BRA   next   
F084                          ENDIF      
F084                          IF   SBASEU   
                                 ; a-z, unchecked base: a variable followed by "@" or "!" is fetched or
                                 ; stored in the same step (x@ is the commonest pair in most programs). A
                                 ; checked build checks the stacks between the two, so it keeps them apart.
                    LOWER:    ASLA      ; (cellx, inline)
                              LDX   #LET   
                              LEAX   A,X   
                              LDB   ,Y   
                              CMPB   #"@"   
                              BEQ   lwf   
                              CMPB   #"!"   
                              BEQ   lws   
                              PSHU   X   
                              BRA   next   
                    LWF:      LEAY   1,Y   ; x@: the cell's value (little-endian)
                              LDB   ,X   
                              LDA   1,X   
                              PSHU   D   
                              BRA   next   
                    LWS:      LEAY   1,Y   ; x!: the cell = TOS
                              PULU   D   
                              STB   ,X   
                              STA   1,X   
                              BRA   next   
F084                          ENDIF      
F084                             ; A-Z: call the word. The IP (the address after the letter) goes on the
F084                             ; return stack, and the IP becomes the address in the letter's cell.
F084                             ; Checked: a cell still 0 (high byte 0) was never defined, since every
F084                             ; address in the program's space is 8200h or more. The call has not been
F084                             ; made yet, so the report shows the stacks as they were.
F084                          IF   1-FAST   
F084   8D 35        UPPER:    BSR   cellx   
F086   E6 84                  LDB   ,X   
F088   A6 01                  LDA   1,X   
F08A                          ENDIF      
F08A                          IF   CHECKED*(1-FAST)   
F08A   27 27                  BEQ   e_undef   
F08C                          ENDIF      
F08C                          IF   1-FAST   
F08C   34 20                  PSHS   Y   
F08E   1F 02                  TFR   D,Y   
F090   8D 54                  BSR   pollk   ; the break check, at every word call
F092   20 96                  BRA   next   
F094                          ENDIF      
F094                             ; =============================================================================
F094                             ;  Checked build: the error entries.
F094                             ; 
F094                             ;  Each entry loads its letter and then hides the next entry inside a 3-byte
F094                             ;  CMPX # (the 8Ch), so that a run of them falls through to one place. The
F094                             ;  place an error reports is the address in AT, which the inner loop sets to
F094                             ;  each character before it runs it; the one error that reports another
F094                             ;  place (W, at the character after the [) changes AT before it comes.
F094                             ; 
F094                             ;  The report counts the return stack from SSAV, which the inner loop sets
F094                             ;  to S before each character, so an error may come from any depth of
F094                             ;  calls: a handler, chkst under one, or ctlc under "?" or the break check.
F094                             ;  (An r sets SSAV to the empty stack.) The inner loop's own entries are
F094                             ;  here, where its short branches reach them; those reached from a handler
F094                             ;  are after h_cstore, just ahead of the report.
F094                             ; =============================================================================
F094                          IF   CHECKED   
F094                             ; ---- reached from the inner loop -------------------------------------------
F094                             ; The stack checks branch here with N set for an overflow (the pointer is
F094                             ; below its limit) and clear for an underflow. After an underflow that stack
F094                             ; counts as empty.
F094   2B 11        E_DS:     BMI   e_S   
F096   CE 81 FC               LDU   #DSTOP   ; s
F099   86 73                  LDA   #"s"   
F09B   20 18                  BRA   eall   
F09D   2B 0B        E_RS:     BMI   e_R   
F09F   8E 81 00               LDX   #RSTOP   ; r
F0A2   9F 3A                  STX   <SSAV   
F0A4   86 72                  LDA   #"r"   
F0A6   8C                     FCB   8Ch   
F0A7   86 53        E_S:      LDA   #"S"   
F0A9   8C                     FCB   8Ch   
F0AA   86 52        E_R:      LDA   #"R"   
F0AC   8C                     FCB   8Ch   
F0AD   86 58        E_RESV:   LDA   #"X"   ; a reserved byte (80h-FFh) outside a string
F0AF   8C                     FCB   8Ch   
F0B0   86 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (from ctlc, at any depth)
F0B2   8C                     FCB   8Ch   
F0B3   86 55        E_UNDEF:   LDA   #"U"   ; a word never defined (its cell is still 0)
F0B5   7E F3 39     EALL:     JMP   error   
F0B8                          ENDIF      
F0B8   7E FF 09     FIN:      JMP   EXIT   ; the program has ended
F0BB                             ; cellx: A = letter index (0-25, or 32-57 for lowercase) -> X = cell address
F0BB   48           CELLX:    ASLA      
F0BC   8E 82 00               LDX   #LET   
F0BF   30 86                  LEAX   A,X   
F0C1   39                     RTS      
F0C2                             ; isdig: A = the character at IP minus "0"; the carry is set if it is a digit
F0C2   A6 A4        ISDIG:    LDA   ,Y   
F0C4   80 30                  SUBA   #"0"   
F0C6   81 0A                  CMPA   #10   
F0C8   39           AB9:      RTS      
F0C9                             ; rdnum: read decimal digits at IP and push the value; IP is left on the
F0C9                             ; first non-digit. Values wrap at 16 bits, as the spec says. The running
F0C9                             ; value lives in the new top cell: V = V*10 + digit.
F0C9   4F           RDNUM:    CLRA      
F0CA   5F                     CLRB      
F0CB   36 06                  PSHU   D   
F0CD   8D F3        RD1:      BSR   isdig   
F0CF   24 F7                  BHS   ab9   
F0D1   EC C4                  LDD   ,U   
F0D3   58                     ASLB      
F0D4   49                     ROLA      
F0D5   58                     ASLB      
F0D6   49                     ROLA      
F0D7   E3 C4                  ADDD   ,U   ; 5V
F0D9   58                     ASLB      
F0DA   49                     ROLA      ; 10V
F0DB   EB A0                  ADDB   ,Y+   ; and the digit, read again
F0DD   89 00                  ADCA   #0   
F0DF   83 00 30               SUBD   #30h   ; minus "0" (asm80 would put a quoted "0"
F0E2                             ;   in the high byte of a 16-bit operand)
F0E2   ED C4                  STD   ,U   
F0E4   20 E7                  BRA   rd1   
F0E6                             ; =============================================================================
F0E6                             ;  Console layer: the break key. A running program reads the keyboard only
F0E6                             ;  through pollk and getk, which between them give the break key its rules:
F0E6                             ;    - Ctrl-C (03h) stops the program;
F0E6                             ;    - any other key that the break check reads is held in KEYBUF for the
F0E6                             ;      next "?", and a newer one takes its place;
F0E6                             ;    - "?" (getk) takes the held key first;
F0E6                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
F0E6                             ;      key like any other, but two of them within about 250 ms still stop it.
F0E6                             ;  On a break the unchecked build ends without a word (EXIT); the checked
F0E6                             ;  one reports B. All three keep B, X, Y and U.
F0E6                             ; =============================================================================
F0E6                             ; pollk: the break check, at every word call and every true ")" loop-back.
F0E6                             ; It looks at the keyboard only once in 256 calls.
F0E6   0A 35        POLLK:    DEC   <COUNT   
F0E8   26 37                  BNE   cc9   
F0EA   BD FF 06     PK1:      JSR   KEY   ; (the fast build counts down itself)
F0ED   27 32                  BEQ   cc9   ; no key
F0EF   97 34                  STA   <KEYBUF   ; held for the next "?"
F0F1   20 0C                  BRA   ctlc   
F0F3                             ; getk: a key for "?", or A = 0 with the zero flag set if there is none.
F0F3   96 34        GETK:     LDA   <KEYBUF   ; a held key goes first, and is taken out of
F0F5   0F 34                  CLR   <KEYBUF   ;   the buffer (it has been through ctlc)
F0F7   4D                     TSTA      
F0F8   26 27                  BNE   cc9   
F0FA   BD FF 06               JSR   KEY   
F0FD   27 22                  BEQ   cc9   
F0FF                             ; ctlc: a key has been read. If it is Ctrl-C and the break key is on, that
F0FF                             ; is the end. If the program has turned it off, wait about 250 ms for one
F0FF                             ; more key: a second Ctrl-C is the end too; any other key is held (the
F0FF                             ; newest wins), and the Ctrl-C goes on: A = 3, zero flag clear.
F0FF   81 03        CTLC:     CMPA   #3   
F101   26 1E                  BNE   cc9   
F103   0D 7B                  TST   <BRKOFF   
F105   27 A9                  BEQ   brk   
F107   34 10                  PSHS   X   
F109   8E 13 88               LDX   #250*MSLOOP   
F10C   BD FF 06     CC1:      JSR   KEY   
F10F   26 06                  BNE   cc2   
F111   30 1F                  LEAX   -1,X   
F113   26 F7                  BNE   cc1   
F115   20 06                  BRA   cc3   
F117   81 03        CC2:      CMPA   #3   
F119   27 95                  BEQ   brk   
F11B   97 34                  STA   <KEYBUF   
F11D   86 03        CC3:      LDA   #3   
F11F   35 10                  PULS   X   
F121   39           CC9:      RTS      
F122                          IF   1-CHECKED   
                    BRK:      EQU   fin   ; the unchecked build stops without a word;
F122                          ENDIF      
F122                          IF   CHECKED   
F122                BRK:      EQU   e_break   ;   the checked build reports B (the report
F122                          ENDIF      ;   takes S from SSAV, so the depth of the
F122                             ;   calls here doesn't matter)
F122                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
F122                             ; and return its value in A with the carry set; otherwise leave the IP and
F122                             ; return with the carry clear.
F122                             ; (In the unchecked build it is here, ahead of the table, to leave room in
F122                             ; the two ranges after it; the checked build has it next to the grave, and
F122                             ; so does the unchecked base build, which needs its bytes there instead.)
F122                          IF   (1-CHECKED)*(1-QK)   
                    HEXC:     BSR   isdig   
                              BLO   hv1   ; C = 1
                              ANDA   #0DFh   
                              SUBA   #11h   
                              CMPA   #6   
                              BHS   hv9   ; C = 0
                              SUBA   #0F6h   ; + 10, and sets the carry
                    HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
                    HV9:      RTS      
F122                          ENDIF      
F122                             ; =============================================================================
F122                             ;  Dispatch table, in code order.
F122                             ; 
F122                             ;  Unchecked build: one byte per character, the low byte of the handler's
F122                             ;  distance from PTAB. NPG1 is how many characters, from the start, have
F122                             ;  handlers more than 255 bytes past PTAB. ] \ [ @ ? sit where the two ranges
F122                             ;  meet (in falling code order for this), and which side each lands on is
F122                             ;  worked out here. (One division to a line: asm80 only rounds down when it
F122                             ;  stores a value.)
F122                             ; 
F122                             ;  Checked build: it has more code than the two ranges hold, so its table
F122                             ;  holds whole addresses and there are no rules about where handlers go.
F122                             ; 
F122                             ;  The unchecked base build keeps to the same rules: its skip and udiv are
F122                             ;  out in the tail, and hexc comes into the first range, where the checked
F122                             ;  build has it. The fast build has no PTAB (see "The fast build").
F122                             ; =============================================================================
F122                          IF   (1-CHECKED)*(1-FAST)   
                    PGRET:    EQU   (h_ret-PTAB)/256   ; 0 = first range, 1 = second
                    PGBRK:    EQU   (h_break-PTAB)/256   
                    PGDEF:    EQU   (h_def-PTAB)/256   
                    PGFET:    EQU   (h_fetch-PTAB)/256   
                    PGKEY:    EQU   (h_key-PTAB)/256   
                    NPG1:     EQU   20 + PGKEY + PGFET + PGDEF + PGBRK + PGRET   
F122                          ENDIF      
F122                PTAB:        
F122                          IF   (1-CHECKED)*(1-FAST)   
                              FCB   (h_store-PTAB) & 0FFh   ; !
                              FCB   (h_str-PTAB) & 0FFh   ; "
                              FCB   (h_num-PTAB) & 0FFh   ; #
                              FCB   (h_print-PTAB) & 0FFh   ; $
                              FCB   (h_swap-PTAB) & 0FFh   ; %
                              FCB   (h_and-PTAB) & 0FFh   ; &
                              FCB   (h_emit-PTAB) & 0FFh   ; '
                              FCB   (h_open-PTAB) & 0FFh   ; (
                              FCB   (h_close-PTAB) & 0FFh   ; )
                              FCB   (h_mul-PTAB) & 0FFh   ; *
                              FCB   (h_add-PTAB) & 0FFh   ; +
                              FCB   (h_cfetch-PTAB) & 0FFh   ; ,
                              FCB   (h_sub-PTAB) & 0FFh   ; -
                              FCB   (h_cstore-PTAB) & 0FFh   ; .
                              FCB   (h_div-PTAB) & 0FFh   ; /
                              FCB   (h_dup-PTAB) & 0FFh   ; :
                              FCB   (h_drop-PTAB) & 0FFh   ; ;
                              FCB   (h_lt-PTAB) & 0FFh   ; <
                              FCB   (h_eq-PTAB) & 0FFh   ; =
                              FCB   (h_gt-PTAB) & 0FFh   ; >
                              FCB   (h_key-PTAB) & 0FFh   ; ?
                              FCB   (h_fetch-PTAB) & 0FFh   ; @
                              FCB   (h_def-PTAB) & 0FFh   ; [
                              FCB   (h_break-PTAB) & 0FFh   ; \
                              FCB   (h_ret-PTAB) & 0FFh   ; ]
                              FCB   (h_xor-PTAB) & 0FFh   ; ^
                              FCB   (h_alloc-PTAB) & 0FFh   ; _
                              FCB   (h_grave-PTAB) & 0FFh   ; `
                              FCB   (h_tor-PTAB) & 0FFh   ; {
                              FCB   (h_or-PTAB) & 0FFh   ; |
                              FCB   (h_fromr-PTAB) & 0FFh   ; }
                              FCB   (h_not-PTAB) & 0FFh   ; ~
F122                          ENDIF      
F122                          IF   CHECKED*(1-FAST)   
F122   F3 0F                  FDB   h_store   ; !
F124   F2 21                  FDB   h_str   ; "
F126   F3 E5                  FDB   h_num   ; #
F128   F4 32                  FDB   h_print   ; $
F12A   F2 EC                  FDB   h_swap   ; %
F12C   F3 00                  FDB   h_and   ; &
F12E   F2 F8                  FDB   h_emit   ; '
F130   F2 92                  FDB   h_open   ; (
F132   F2 A6                  FDB   h_close   ; )
F134   F2 B2                  FDB   h_mul   ; *
F136   F3 08                  FDB   h_add   ; +
F138   F2 9E                  FDB   h_cfetch   ; ,
F13A   F4 6A                  FDB   h_sub   ; -
F13C   F3 1B                  FDB   h_cstore   ; .
F13E   F4 0B                  FDB   h_div   ; /
F140   F2 F3                  FDB   h_dup   ; :
F142   F2 FD                  FDB   h_drop   ; ;
F144   F2 D4                  FDB   h_lt   ; <
F146   F2 E0                  FDB   h_eq   ; =
F148   F2 D2                  FDB   h_gt   ; >
F14A   F2 44                  FDB   h_key   ; ?
F14C   F2 3E                  FDB   h_fetch   ; @
F14E   F1 F8                  FDB   h_def   ; [
F150   F1 D8                  FDB   h_break   ; \
F152   F1 D4                  FDB   h_ret   ; ]
F154   F1 6A                  FDB   h_xor   ; ^
F156   F1 86                  FDB   h_alloc   ; _
F158   F1 A2                  FDB   h_grave   ; `
F15A   F1 78                  FDB   h_tor   ; {
F15C   F1 62                  FDB   h_or   ; |
F15E   F1 80                  FDB   h_fromr   ; }
F160   F1 73                  FDB   h_not   ; ~
F162                          ENDIF      
F162                PTABEND:      
F162                             ; =============================================================================
F162                             ;  Handlers that must start in the first range (within 255 bytes of PTAB)
F162                             ;  in the unchecked build: ^ _ ` 00bbIHwg ~
F162                             ; =============================================================================
F162   EC C1        H_OR:     LDD   ,U++   
F164   AA C4                  ORA   ,U   
F166   EA 41                  ORB   1,U   
F168   20 06                  BRA   st0   
F16A   EC C1        H_XOR:    LDD   ,U++   
F16C   A8 C4                  EORA   ,U   
F16E   E8 41                  EORB   1,U   
F170   ED C4        ST0:      STD   ,U   
F172   39                     RTS      
F173   63 C4        H_NOT:    COM   ,U   
F175   63 41                  COM   1,U   
F177   39                     RTS      
F178                             ; "{" ( n -- ) R: ( -- n )     The dispatcher's return address comes off the
F178                             ; return stack first (PULS X) and is jumped to at the end.
F178   35 10        H_TOR:    PULS   X   
F17A   37 06                  PULU   D   
F17C   34 06                  PSHS   D   
F17E   6E 84                  JMP   ,X   
F180                             ; "}" ( -- n ) R: ( n -- )    The dispatcher's return address comes off
F180                             ; into D and the entry under it into X; D is then jumped to.
F180   35 16        H_FROMR:   PULS   D,X   
F182   36 10                  PSHU   X   
F184   1F 05                  TFR   D,PC   
F186                             ; "_" ( n -- addr ): the heap pointer moves by n (signed: a 16-bit add);
F186                             ; TOS is the old pointer.
F186                             ; Checked: the new top must be at least the program's end (PEND) and below
F186                             ; the limit page. That also catches an add that wraps: the top is always
F186                             ; 8301h-EFFFh and n is -32768..32767, so a sum that carries past FFFFh
F186                             ; lands below 7000h, and one that borrows can't happen.
F186   D6 7C        H_ALLOC:   LDB   <HEAP   
F188   96 7D                  LDA   <HEAP+1   
F18A   1F 01                  TFR   D,X   ; the old pointer
F18C   E3 C4                  ADDD   ,U   
F18E                          IF   CHECKED   
F18E   10 93 38               CMPD   <PEND   
F191   25 04                  BLO   ah9   ; below the program's end
F193   81 EF                  CMPA   #HEAPLIM   
F195   25 04                  BLO   ah1   ; the new top must stay below the limit page
F197   86 48        AH9:      LDA   #"H"   
F199   20 5A                  BRA   ejmp   ; (with [ below)
F19B                AH1:         
F19B                          ENDIF      
F19B   D7 7C                  STB   <HEAP   
F19D   97 7D                  STA   <HEAP+1   
F19F   AF C4                  STX   ,U   
F1A1   39                     RTS      
F1A2                             ; ---- machine code: the grave -----------------------------------------------
F1A2                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
F1A2                             ; are stored from addr until a non-hex character; then a RTS (39h) is
F1A2                             ; written and its address is left. An odd last digit is consumed and dropped.
F1A2                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
F1A2                             ; code is entered by JSR (the dispatcher's own), with the address already
F1A2                             ; popped: U points at the top data cell (big-endian, 2 bytes, stack grows
F1A2                             ; down) and the return address is on top of S. The code may pop and push
F1A2                             ; data cells by changing U; on return the cell at ,U is the new TOS. It must
F1A2                             ; keep Y (the interpreter's reading position), DP and S (balanced), and
F1A2                             ; return with RTS. A, B, X, CC may change.
F1A2                             ; Neither the loader's stores nor the code are checked, in either build.
F1A2   8D 1E        H_GRAVE:   BSR   hexc   ; the digit after the grave, if any
F1A4   24 1A                  BCC   exec   
F1A6   AE C4                  LDX   ,U   
F1A8   C6 10        HX1:      LDB   #16   
F1AA   3D                     MUL      ; B = the digit, moved up to the high half
F1AB   E7 84                  STB   ,X   ; (an odd digit is overwritten by the RTS)
F1AD   8D 13                  BSR   hexc   
F1AF   24 08                  BCC   hx2   ; odd digit: already consumed, dropped
F1B1   AA 84                  ORA   ,X   
F1B3   A7 80                  STA   ,X+   
F1B5   8D 0B                  BSR   hexc   
F1B7   25 EF                  BCS   hx1   
F1B9   86 39        HX2:      LDA   #39h   ; RTS
F1BB   A7 84                  STA   ,X   
F1BD   AF C4                  STX   ,U   
F1BF   39                     RTS      
F1C0   37 80        EXEC:     PULU   PC   ; jump to it: the code's RTS returns to the
F1C2                             ;   dispatcher
F1C2                          IF   CHECKED+QK   
F1C2   BD F0 C2     HEXC:     JSR   isdig   
F1C5   25 0A                  BLO   hv1   ; C = 1
F1C7   84 DF                  ANDA   #0DFh   
F1C9   80 11                  SUBA   #11h   
F1CB   81 06                  CMPA   #6   
F1CD   24 04                  BHS   hv9   ; C = 0
F1CF   80 F6                  SUBA   #0F6h   ; + 10, and sets the carry
F1D1   31 21        HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
F1D3   39           HV9:      RTS      
F1D4                          ENDIF      
F1D4                             ; ---- where the two ranges meet ---------------------------------------------
F1D4                             ; The first range ends somewhere among the next five handlers, ] \ [ @ ?
F1D4                             ; (they are in falling code order for this): NPG1 follows. Every handler
F1D4                             ; below them must start in the second range, and every one above in the
F1D4                             ; first.
F1D4                             ; "]" returns: pop an address and jump to it. (PULS X,Y: the dispatcher's
F1D4                             ; return address into X, then the saved IP into Y.)
F1D4   35 30        H_RET:    PULS   X,Y   
F1D6   6E 84                  JMP   ,X   
F1D8                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F1D8                             ; drops the block start, "]" returns. No closer at all ends the program.
F1D8   EC C1        H_BREAK:   LDD   ,U++   
F1DA                          IF   1-QK   
                              BEQ   sk9   ; false: nothing to do
                              BSR   skip   
F1DA                          ENDIF      
F1DA                          IF   QK   
F1DA   27 F7                  BEQ   hv9   ; false: nothing to do (hexc's RTS)
F1DC   BD F4 D1               JSR   skip   ; (base: in the tail, with its cache)
F1DF                          ENDIF      
F1DF   4D                     TSTA      ; skip returns 0 for ")"
F1E0                          IF   CHECKED   
F1E0   10 2B FE D4            LBMI   fin   ; (and FFh for the NUL: the program ends)
F1E4                          ENDIF      
F1E4   26 EE                  BNE   h_ret   
F1E6   35 16        RDROP:    PULS   D,X   ; the return address and the block start
F1E8   1F 05                  TFR   D,PC   ; back to the dispatcher
F1EA                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F1EA                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F1EA                             ; the body"s address instead. Either way it then skips to the matching "]'.
F1EA                             ; (The unchecked build takes anything that is not a letter as the space; the
F1EA                             ; checked build stops on it.)
F1EA                          IF   CHECKED   
F1EA   81 DF        DEF1:     CMPA   #" "-"A"+256   
F1EC   27 20                  BEQ   def2   
F1EE   31 3F                  LEAY   -1,Y   ; anything but a letter or a space: W. The
F1F0   10 9F 36               STY   <AT   ;   place is that character, just read
F1F3   86 57                  LDA   #"W"   
F1F5   7E F3 39     EJMP:     JMP   error   ; (H and N come here too)
F1F8                          ENDIF      
F1F8   A6 A0        H_DEF:    LDA   ,Y+   
F1FA   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
F1FC   1F 89                  TFR   A,B   ;   lands 64 bytes up
F1FE   C4 DF                  ANDB   #0DFh   ; fold case
F200   C1 1A                  CMPB   #26   
F202                          IF   1-CHECKED   
                              BHS   def2   ; not a letter
F202                          ENDIF      
F202                          IF   CHECKED   
F202   24 E6                  BHS   def1   
F204                          ENDIF      
F204   BD F0 BB               JSR   cellx   
F207   1F 20                  TFR   Y,D   
F209   E7 84                  STB   ,X   ; little-endian
F20B   A7 01                  STA   1,X   
F20D   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F20E   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F210                          IF   (1-CHECKED)*(1-QK)   
                                 ; fall into skip
F210                          ENDIF      
F210                          IF   QK*(1-CHECKED)   
                              JMP   skip   ; (base: in the tail, with its cache)
F210                          ENDIF      
F210                          IF   CHECKED   
F210                             ; Checked: the skip must end at a "]" (A = 2), or for a false "(",
F210                             ; which comes to opf, at a ")" (A = 0). Anything else stops with N.
F210                          ENDIF      
F210                          IF   CHECKED*(1-QK)   
                              BSR   skip   
                              SUBA   #2   
                              FCB   8Ch   ; (CMPX #: steps over the BSR)
                    OPF:      BSR   skip   
                              TSTA      
                              BEQ   sk9   ; (an RTS)
                              LDA   #"N"   
                              BRA   ejmp   
F210                          ENDIF      
F210                          IF   CHECKED*QK   
F210   BD F4 D1               JSR   skip   ; (base: in the tail, with its cache)
F213   80 02                  SUBA   #2   
F215   20 03                  BRA   of1   
F217   BD F4 D1     OPF:      JSR   skip   
F21A   4D           OF1:      TSTA      
F21B   27 B6                  BEQ   hv9   ; (an RTS: hexc's)
F21D   86 4E                  LDA   #"N"   
F21F   20 D4                  BRA   ejmp   
F221                          ENDIF      
F221                             ; skip: read past text to the closer at this level, and return A = 0 if it
F221                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F221                             ; strings are stepped over whole. B counts the open levels.
F221                             ; Unchecked: a NUL first ends the program (for "\" with no closer; anything
F221                             ; else that runs into the NUL had unbalanced brackets anyway).
F221                             ; Checked: a NUL, or a string that runs into it, returns A = FFh, and the
F221                             ; caller decides: "\" ends the program, "(" and "[" stop with N, as they do
F221                             ; for a closer of the other kind. The place is the opener, still in AT.
F221                             ; (base has its own, with the skip cache, in the tail: see "Speed-ups".)
F221                          IF   1-QK   
                    SKIP:     CLRB      
                    SK1:      LDA   ,Y+   
F221                          ENDIF      
F221                          IF   (1-CHECKED)*(1-QK)   
                              LBEQ   fin   
F221                          ENDIF      
F221                          IF   CHECKED*(1-QK)   
                              BEQ   ssn   ; A = FFh
F221                          ENDIF      
F221                          IF   1-QK   
                              CMPA   #22h   
                              BNE   sk2   
                              BSR   skipstr   ; leaves A = 22h, which matches nothing below
F221                          ENDIF      
F221                          IF   CHECKED*(1-QK)   
                              BCS   sk9   ; (or FFh, with the carry set: unclosed)
F221                          ENDIF      
F221                          IF   1-QK   
                    SK2:      SUBA   #"("   
                              BEQ   sk3   
                              DECA      ; ")"
                              BEQ   sk4   
                              SUBA   #"["-")"   
                              BEQ   sk3   
                              CMPA   #"]"-"["   
                              BNE   sk1   
                    SK4:      DECB      
                              BPL   sk1   
                    SK9:      RTS      ; the closer at this level
                    SK3:      INCB      
                              BRA   sk1   
F221                          ENDIF      
F221                             ; 22h, checked build (the unchecked one is with the handlers below).
F221                             ; Checked: a NUL ends the string too, even right after a "/"; skipstr then
F221                             ; returns A = FFh with the carry set (the carry is clear at the quote), and
F221                             ; """ stops with Q, the string's address already pushed. (skip comes here
F221                             ; for its own NUL as well.)
F221                          IF   CHECKED   
F221   36 20        H_STR:    PSHU   Y   
F223   8D 09                  BSR   skipstr   
F225   10 25 01 0E            LBCS   e_quote   
F229   39                     RTS      
F22A   A6 A0        SS0:      LDA   ,Y+   ; the character after the "/"
F22C   27 0D                  BEQ   ssn   
F22E   A6 A0        SKIPSTR:   LDA   ,Y+   
F230   27 09                  BEQ   ssn   
F232   81 2F                  CMPA   #"/"   
F234   27 F4                  BEQ   ss0   
F236   81 22                  CMPA   #22h   
F238   26 F4                  BNE   skipstr   
F23A   39                     RTS      ; the quote: C = 0
F23B   80 01        SSN:      SUBA   #1   ; the NUL: A = FFh, C = 1
F23D   39                     RTS      
F23E                          ENDIF      
