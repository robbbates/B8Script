                                 ; the table: low bytes, then high bytes, each a page
                              DS   (256 - ($ & 0FFh)) & 0FFh   
                    DTAB:        
                              DB   fs_nul&0FFh,fign&0FFh,fign&0FFh,fign&0FFh,fign&0FFh,fign&0FFh,fign&0FFh,fign&0FFh   ; 00h
