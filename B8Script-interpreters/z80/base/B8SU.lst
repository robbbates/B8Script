02BF                PR9:      DS   (1-CPM)*(1-FAST),0DFh   
02BF   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02C0   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02C1   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02C2                             ; "#" prints TOS as a signed decimal number, with no space after it.
02C2   CD F3 04     H_NUM:    CALL   psgn   
02C5                          ;*Macro unroll:  DROP
02C5                          DS   (1-CPM)*(1-FAST),0DFh   
02C5   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02C6   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02C7   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02C8                             ; "?" ( n -- c ) or ( -n -- addr )
02C8                             ;   n > 0: wait about n ms for a key; 0 if none came
02C8                             ;   n = 0: wait for a key
02C8                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C8                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C8   CB 7C        H_KEY:    BIT   7,H   
02CA   20 1A                  JR   NZ,line   
02CC   1E 04        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02CE   CD 5F 05     KT2:      CALL   getk   
02D1   20 0E                  JR   NZ,kt3   
02D3   1D                     DEC   E   
02D4   20 F8                  JR   NZ,kt2   
02D6   7C                     LD   A,H   ; 0? never counts down: it waits
02D7   B5                     OR   L   
02D8   28 F2                  JR   Z,kt1   
02DA   2B                     DEC   HL   
02DB   7C                     LD   A,H   
02DC   B5                     OR   L   
02DD   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02DF   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02E0   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02E1   6F           KT3:      LD   L,A   
02E2   26 00                  LD   H,0   
02E4                          ;*Macro unroll:  NEXT
02E4                          DS   (1-CPM)*(1-FAST),0F7h   
02E4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02E5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02E6                             ; Backspace takes the last character back (and is echoed as it
02E6                             ; is), CR ends (stored, not echoed), every other key is stored and
02E6                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02E6                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02E6                             ; is the place in the line: D holds the L of a full line.
02E6   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E9   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02EA   9F                     SBC   A,A   
02EB   A5                     AND   L   ; (0 for a count that is too big)
02EC   2F                     CPL      
02ED   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
02EE                             ;   at most
02EE   21 80 09               LD   HL,LINEBUF   
02F1   CD 5F 05     LN2:      CALL   getk   
02F4   28 FB                  JR   Z,ln2   
02F6   FE 0D                  CP   13   
02F8   28 18                  JR   Z,ln5   
02FA   FE 08                  CP   8   
02FC   28 0D                  JR   Z,ln4   
02FE   5F                     LD   E,A   
02FF   7D                     LD   A,L   
0300   BA                     CP   D   
0301   28 EE                  JR   Z,ln2   ; full
0303   73                     LD   (HL),E   
0304   2C                     INC   L   
0305   7B                     LD   A,E   
0306                          ;*Macro unroll: ln3:    PUTA
0306                LN3:      DS   1-CPM,0EFh   
0306   CD                     DS   CPM,0CDh   
0307   89                     DS   CPM,APUT&0FFh   
0308   05                     DS   CPM,APUT/256   
0309   18 E6                  JR   ln2   
030B   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
030C   FA 06 03               JP   M,ln3   ;   unless the line was empty (L left the
030F   2C                     INC   L   ;   upper half of the page)
0310   18 DF                  JR   ln2   
0312   77           LN5:      LD   (HL),A   ; the CR
0313   2E 80                  LD   L,LINEBUF & 0FFh   
0315                          ;*Macro unroll:  NEXT
0315                          DS   (1-CPM)*(1-FAST),0F7h   
0315   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0316   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0317                             ; =============================================================================
0317                             ;  More routines (no handler starts past this point)
0317                             ; =============================================================================
0317                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
                              DB   13,10,22h   ;   the caller's text)
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
0317                          ENDIF      
0317                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0317                             ; HL points past it. Each goes back into the loop that prints the string
0317                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0317                             ;    /a-/z   print the variable, as "#" does
0317                             ;    /{      clear the screen, the cursor to the top left
0317                             ;    /}      clear from the cursor to the end of the line
0317                             ;    /|  /`  show the cursor, hide it
0317                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0317   FE 7E        PESC:     CP   7Eh   
0319   28 1C                  JR   Z,pat   
031B   11 A0 02               LD   DE,PRLOOP   ; the others return into the loop
031E   D5                     PUSH   DE   
031F   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0321   30 45                  JR   NC,pcon   
0323   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0325   30 2E                  JR   NC,phide   
0327   87                     ADD   A,A   ; the variable's cell
0328   C6 40                  ADD   A,40h   
032A   E5                     PUSH   HL   
032B   6F                     LD   L,A   
032C   26 09                  LD   H,LETPAGE   
032E   7E                     LD   A,(HL)   
032F   2C                     INC   L   
0330   66                     LD   H,(HL)   
0331   6F                     LD   L,A   
0332   CD F3 04               CALL   psgn   
0335   E1                     POP   HL   
0336   C9                     RET      
0337                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0337                             ; the checked build "$" is the routine prstr: its own return address goes
0337                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0337                             ; its two cells are there, and is s if not, before it prints anything.
0337                PAT:         
0337                          IF   CHECKED   
                              EX   (SP),HL   ; the text pointer over prstr's return address
                              LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              ADD   HL,SP   
                              JP   C,e_under   
                              POP   HL   
0337                          ENDIF      
0337   D1                     POP   DE   ; DE = the column
0338   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0339                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
0339                          ENDIF      
0339                          IF   ANS   
0339   D5                     PUSH   DE   
033A   CD 7D 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
033D   23                     INC   HL   
033E   CD FE 04               CALL   pdec   
0341                          ;*Macro unroll:  PUTK    3Bh             ; ';'
0341                          DS   1-CPM,3Eh   ; ";"
0341                          DS   1-CPM,3Bh   
0341                          DS   1-CPM,0EFh   
0341   CD                     DS   CPM,0CDh   
0342   85                     DS   CPM,APTK&0FFh   
0343   05                     DS   CPM,APTK/256   
0344   3B                     DS   CPM,3Bh   
0345   E1                     POP   HL   
0346   23                     INC   HL   
0347   CD FE 04               CALL   pdec   
034A                          ;*Macro unroll:  PUTK    48h             ; 'H'
034A                          DS   1-CPM,3Eh   ; "H"
034A                          DS   1-CPM,48h   
034A                          DS   1-CPM,0EFh   
034A   CD                     DS   CPM,0CDh   
034B   85                     DS   CPM,APTK&0FFh   
034C   05                     DS   CPM,APTK/256   
034D   48                     DS   CPM,48h   
034E   E1                     POP   HL   
034F   C3 A0 02               JP   PRAGAIN   
0352                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0352   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0354   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0355   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0357                          ENDIF      
0357                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0357                          ENDIF      
0357                          IF   ANS*(1-CHECKED)   
0357   3E 3F                  LD   A,"?"   
0359   CD 77 03               CALL   csia   
