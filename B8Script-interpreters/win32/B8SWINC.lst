   611 00000159 FFE5                <1>         jmp     ebp
   612 0000015B 5A                  <1> h_xor:  pop     edx
   613 0000015C 6631D3              <1>         xor     bx,dx
   614 0000015F FFE5                <1>         jmp     ebp
   615 00000161 66F7D3              <1> h_not:  not     bx
