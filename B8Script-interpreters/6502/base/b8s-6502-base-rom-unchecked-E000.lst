0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-11-24). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page ($00-$09). b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's three-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   D:2: 5 0
0000                             ;                   R:0
0000                             ;                 and then goes to EXIT.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build").
0000                             ;  The base and fast builds use one more RAM page, for the skip cache: the page
0000                             ;  at the heap limit, which is DF00h in them (E000h in the others).
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   1   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ;  The fast build (SPEED = 2) dispatches through a full table instead: see
0000                             ;  "The fast build" at the end.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                SKL:      EQU   T1   ; (QK) 05 and 08: where a skip started, for
0000                SKH:      EQU   D0   ;   the skip cache
0000                V:        EQU   T0   ; (FAST) 04-05 the dispatcher's jump vector
0000                          IF   1-CHECKED   
0000                KEYBUF:   EQU   07h   ; a key held back by the break check (0: none)
0000                          ENDIF      
0000                          IF   CHECKED   
                    PLACE:    EQU   06h   ; 06-07 (T2 and $07) the address of the
                                 ;   character being run, for the error report:
                                 ;   no handler of the checked build uses T2.
                                 ;   (Machine code may change T2: that matters
                                 ;   only if it also leaves a stack overrun,
                                 ;   whose report then shows a wrong place.)
                    RSV:      EQU   LET+35h   ; S as it was before this character
                    KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
                                 ; The error report runs after the program, so it may use the zero page that
                                 ; machine code has ($0A-$0F):
                    CL:       EQU   0Ah   ; 0A-0B where the reported line starts
0000                          ENDIF      
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PEND at +38, KEYBUF (the held
0000                             ;               key; $07 in the unchecked build) at +7A; and every build's:
0000                             ;               CDOWN at +79, BRKOFF (the break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    DF00       CPAGE (QK builds only): the skip cache, at the heap limit
0000                             ;    E000       the interpreter (ROM). In the fast build its first two
0000                             ;               pages are the dispatch table, and start is at E200
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these. All four must keep X;
0000                             ; they may change A, Y and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if the carry is set,
0000                             ;     hide it if the carry is clear
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row A, column Y, both
0000                             ;     counted from 0
0000                          ENDIF      
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h-QK   ; the heap must stay below E000h (a page);
0000                             ;   below DF00h in the QK builds, where
0000                CPAGE:    EQU   HEAPLIM   ;   DF00h is the skip cache's page: the page
0000                             ;   at the heap limit, which the heap never reaches
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                CDOWN:    EQU   LET+79h   ; the break check's countdown (see pnext)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
0000                             ; The fast build's dispatcher (SPEED = 2; see "The fast build"), inline at
0000                             ; the end of its own entries. NEXTF reads the next character and jumps
0000                             ; through the table:
0000                             ;     LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
0000                             ;     LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
0000                             ; NEXTA is the same from INC IP on: the character is already in A, and IP is
0000                             ; still at it (it skips the LDY and the LDA); NEXTY is the same with the
0000                             ; character in Y (it skips the TAY too). In the checked build all three are
0000                             ; JMP fnext, which checks the stacks first. (The bytes are written out with
0000                             ; DS, because asm80 does not nest an IF in a macro inside another IF; and
0000                             ; DS takes the addresses as these equates.)
0000                          IF   FAST   
                    ADTL:     EQU   DTL   
                    ADTH:     EQU   DTH   
                    AFNX:     EQU   fnext   
0000                          ENDIF      
0000                          IF   1-FAST   
0000                ADTL:     EQU   0   
0000                ADTH:     EQU   0   
0000                AFNX:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      1-CHECKED,0A0h  ; LDY #0
0000                 DS      1-CHECKED,0
0000                 DS      1-CHECKED,0B1h  ; LDA (IP),Y
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTA,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTY,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                FTAB:     EQU   0E000h   ; (FAST: the fast build's table, two pages,
E000                          .ORG   FTAB+FAST*512   ;   comes first, and the code after it)
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
                                 ; The first half of the letter page is zeroed: every variable, every
                                 ; cell of the interpreter's own (no key held back), and every word
                                 ; cell, which then points at 0000h: calling an undefined word stops
                                 ; with U (see e_undef).
                              INX      
                              TXA      ; A = 0
                              LDY   #7Fh   
                    STZ:      STA   LET,Y   
                              DEY      
                              BPL   stz   
E003                          ENDIF      
E003                          IF   QK   
E003   A9 00                  LDA   #0   ; an empty skip cache (a start of 0000h
E005   A8                     TAY      ;   matches no skip)
E006   99 00 DF     SKC:      STA   CPAGE*256,Y   
E009   C8                     INY      
E00A   D0 FA                  BNE   skc   
E00C                          ENDIF      
E00C   20 92 E3               JSR   rstip   
E00F   20 86 E3     ST1:      JSR   getc   
E012   D0 FB                  BNE   st1   ; IP ends just past the NUL
E014                          IF   1-CHECKED   
E014   85 07                  STA   KEYBUF   ; (A = 0) no key held, the break key on
E016   8D 7B 04               STA   BRKOFF   
E019                          ENDIF      
E019   A5 00                  LDA   IP   
E01B   8D 7C 04               STA   HEAP   
E01E                          IF   CHECKED   
                              STA   PEND   
E01E                          ENDIF      
E01E   A5 01                  LDA   IP+1   
E020   8D 7D 04               STA   HEAP+1   
E023                          IF   CHECKED   
                              STA   PEND+1   
E023                          ENDIF      
E023   20 92 E3               JSR   rstip   
E026   A2 FC                  LDX   #DSE   
E028                             ; =============================================================================
E028                             ;  The inner loop
E028                             ; =============================================================================
E028                             ; -----------------------------------------------------------------------------
E028                             ;  The break key. A running program reads the keyboard only through getk
E028                             ;  (for "?") and pnext (the break check), which between them give the break
E028                             ;  key its rules:
E028                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E028                             ;      build, with the report (B) in the checked one;
E028                             ;    - any other key that the break check reads is held in KEYBUF for the
E028                             ;      next "?", and a newer one takes its place;
E028                             ;    - "?" (getk) takes the held key first;
E028                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E028                             ;      key like any other, but two of them within about 250 ms still stop it.
E028                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E028                             ; -----------------------------------------------------------------------------
E028                             ; pnext: the break check, then (falling through) next. A word call, a true
E028                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E028                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E028                             ; falls in here too, which does no harm.)
E028   CE 79 04     PNEXT:    DEC   CDOWN   
E02B   D0 0A                  BNE   next   
E02D   20 06 FF     PKEY:     JSR   KEY   
E030   F0 05                  BEQ   next   ; no key
E032   85 07                  STA   KEYBUF   ; held for the next "?"
E034   20 93 E0               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E037                NEXT:        
E037                          IF   FAST   
                              JMP   fnext   ; (the fast build: see "The fast build")
E037                          ENDIF      
E037                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE: an
                                 ; underflow moves X up to FDh or FEh (no handler moves X by more
                                 ; than 2, but "$", whose /~ escapes each look first), and an
                                 ; overflow wraps it from 00h to FFh.
                                 ; S is kept in RSV, for the report's R: line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_stack   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E037                          ENDIF      
E037                          IF   1-FAST   
E037   20 B9 E0               JSR   step   
E03A   4C 37 E0               JMP   next   
E03D                          ENDIF      
E03D                          IF   CHECKED   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: R:0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_STACK:   CPX   #0FFh   
                              LDA   #"S"   
                              BCS   ejmp   ; X wrapped from 00h to FFh: an overflow
                              LDX   #DSE   ; an underflow: D:0
                              LDA   #"s"   
                    EJMP:     JMP   error   
E03D                          ENDIF      
E03D                             ; The handlers that work on the return stack sit here, where short branches
E03D                             ; reach next and pnext.
E03D                             ; "{" TOS to the return stack, "}" return stack to TOS
E03D   68           H_TOR:    PLA      
E03E   68                     PLA      
E03F   A5 03                  LDA   TH   
E041   48                     PHA      
E042   A5 02                  LDA   TL   
E044   48                     PHA      
E045   20 B3 E3               JSR   drop   
E048   D0 ED                  BNE   next   ; always
E04A   68           H_FROMR:   PLA      
E04B   68                     PLA      
E04C   20 17 E1               JSR   push   
E04F   68                     PLA      
E050   85 02                  STA   TL   
E052   68                     PLA      
E053   85 03                  STA   TH   
E055   90 E0                  BCC   next   ; always: the carry is clear on the way in
E057                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E057                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E057                             ; it is here, the address popped is pushed back.
E057   20 9B E3     H_CLOSE:   JSR   flag   
E05A   F0 20                  BEQ   rdrop   
E05C                          IF   1-QK   
                              DB   24h   ; (BIT zp: steps over the SEC)
E05C                          ENDIF      
E05C                          IF   QK   
E05C   4C 5D E1               JMP   closeq   ; (QK: see Speed-ups)
E05F                          ENDIF      
E05F                             ; "]" returns: pull an address and jump to it.
E05F   38           H_RET:    SEC      
E060   68                     PLA      
E061   68                     PLA      ; drop the step frame
E062   68                     PLA      
E063   85 00                  STA   IP   
E065   68                     PLA      
E066   85 01                  STA   IP+1   
E068   B0 CD                  BCS   next   
E06A   48                     PHA      ; ")": keep the block start
E06B   A5 00                  LDA   IP   
E06D   48                     PHA      
E06E   90 B8                  BCC   pnext   ; always: a loop-back, with the break check
E070                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E070                             ; drops the block start, "]" returns.
E070   20 9B E3     H_BREAK:   JSR   flag   
E073   F0 22                  BEQ   gk9   ; (an RTS)
E075                          IF   CHECKED   
                              LDA   #0   ; \ takes either closer
E075                          ENDIF      
E075   20 B0 E1               JSR   skip   
E078   C9 29                  CMP   #")"   
E07A   D0 E3                  BNE   h_ret   
E07C   68           RDROP:    PLA      
E07D   68                     PLA      
E07E   68                     PLA      
E07F   68                     PLA      ; (the block start's high byte: never 0)
E080                          IF   1-QK   
                              BNE   next   ; always
E080                          ENDIF      
E080                          IF   QK   
E080   4C 37 E0               JMP   next   ; (closeq moved next out of reach)
E083                          ENDIF      
E083                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E083                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E083                             ; taken out of KEYBUF.
E083   A5 07        GETK:     LDA   KEYBUF   
E085   F0 07                  BEQ   gk1   
E087   48                     PHA      
E088   A9 00                  LDA   #0   
E08A   85 07                  STA   KEYBUF   
E08C   68                     PLA      
E08D   60                     RTS      
E08E   20 06 FF     GK1:      JSR   KEY   
E091   F0 04                  BEQ   gk9   
E093                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E093                             ; back if it comes back at all.
E093   C9 03        CHK3:     CMP   #3   
E095   F0 01                  BEQ   ctlc   
E097   60           GK9:      RTS      
E098                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E098                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E098                             ; looks: D0 counts the 256s, D1 runs on from whatever it holds) for one more
E098                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E098                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E098   AD 7B 04     CTLC:     LDA   BRKOFF   
E09B   F0 57                  BEQ   cbreak   
E09D   A9 28                  LDA   #CWAIT+1   
E09F   85 08                  STA   D0   
E0A1   20 06 FF     CT2:      JSR   KEY   
E0A4   D0 0A                  BNE   ct3   
E0A6   C6 09                  DEC   D1   
E0A8   D0 F7                  BNE   ct2   
E0AA   C6 08                  DEC   D0   
E0AC   D0 F3                  BNE   ct2   
E0AE   F0 06                  BEQ   ct9   ; always: none came
E0B0   C9 03        CT3:      CMP   #3   
E0B2   F0 40                  BEQ   cbreak   
E0B4   85 07                  STA   KEYBUF   
E0B6   A9 03        CT9:      LDA   #3   
E0B8   60                     RTS      
E0B9                          IF   1-CHECKED   
E0B9                CBREAK:   EQU   endprog   ; the unchecked build stops without a word
E0B9                          ENDIF      
E0B9                          IF   CHECKED   
                    CBREAK:   EQU   e_break   ; the checked build reports B
E0B9                          ENDIF      
E0B9                          IF   CHECKED   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
                              DB   2Ch   
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP3:    JMP   error   
E0B9                          ENDIF      
E0B9                          IF   CHECKED   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; R: does not count the call
                              LDA   #"U"   
                              BNE   ejmp3   ; always
E0B9                          ENDIF      
E0B9                             ; step: read one character and sort it by range.
E0B9                             ;    00h          end of program
E0B9                             ;    01h-20h, 7Fh-FFh   ignored
E0B9                             ;    30h-39h      digit: read a whole number
E0B9                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E0B9                             ;    61h-7Ah      a-z: push the address of that letter's cell
E0B9                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E0B9                             ; Every way out of the sort has the carry clear, except "ignored". A checked
E0B9                             ; build stops on 80h-FFh (X) and still ignores DEL.
E0B9   20 86 E3     STEP:     JSR   getc   ; flags follow A
E0BC   F0 36                  BEQ   endprog   
E0BE   38                     SEC      
E0BF   E9 21                  SBC   #21h   ; A = c - 21h
E0C1   90 30                  BCC   ign   ; 01h-20h
E0C3   C9 0F                  CMP   #0Fh   
E0C5   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E0C7   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E0C9   C9 0A                  CMP   #10   
E0CB   90 2F                  BCC   digit   
E0CD   C9 11                  CMP   #11h   
E0CF   90 16                  BCC   p3a   ; 3Ah-40h
E0D1   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E0D3   C9 1A                  CMP   #1Ah   
E0D5   90 20                  BCC   upper   ; 41h-5Ah
E0D7   C9 20                  CMP   #20h   
E0D9   90 0A                  BCC   p5b   ; 5Bh-60h
E0DB   C9 3A                  CMP   #3Ah   
E0DD                          IF   1-SBASEU   
                              BCC   lower   ; 61h-7Ah: A = 20h-39h
E0DD                          ENDIF      
E0DD                          IF   SBASEU   
E0DD   90 44                  BCC   lowq   ; 61h-7Ah: A = 20h-39h
E0DF                          ENDIF      
E0DF   C9 3E                  CMP   #3Eh   
E0E1                          IF   1-CHECKED   
E0E1   B0 10                  BCS   ign   ; 7Fh-FFh
E0E3                          ENDIF      
E0E3                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E0E3                          ENDIF      
E0E3                             ; The three adjustments below chain. Each ADC adds the carry the one
E0E3                             ; before it left, which the constants allow for.
E0E3   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E0E5   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E0E7   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E0E9   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E0EA   A8                     TAY      
E0EB   B9 FC E2               LDA   PTAB+1,Y   
E0EE   48                     PHA      
E0EF   B9 FB E2               LDA   PTAB,Y   
E0F2   48                     PHA      
E0F3   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E0F4                             ; directly, it just ends an ignored character.
E0F4                ENDPROG:      
E0F4                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E0F4                          ENDIF      
E0F4   4C 09 FF               JMP   EXIT   
E0F7                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E0F7                             ; the return stack, and the IP becomes the address in the letter's cell.
E0F7   0A           UPPER:    ASL      
E0F8   A8                     TAY      
E0F9   38                     SEC      
E0FA   B0 7E                  BCS   pushn   ; always
E0FC                             ; Digits: the first one is in A; read the rest of the number.
E0FC   A0 00        DIGIT:    LDY   #0   
E0FE   20 0D E1               JSR   pushay   
E101   4C 60 E3               JMP   rdnum   
E104                             ; a-z: push the cell's address (the cell is the variable)
E104   0A           LOWER:    ASL      
E105   A0 04                  LDY   #>LET   
E107   D0 04                  BNE   pushay   ; always
E109   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E10B   A4 01                  LDY   IP+1   
E10D                             ; pushay: push a cell: A = its low byte, Y = its high byte
E10D   48           PUSHAY:   PHA      
E10E   20 17 E1               JSR   push   
E111   68                     PLA      
E112   85 02                  STA   TL   
E114   84 03                  STY   TH   
E116   60                     RTS      
E117   CA           PUSH:     DEX      ; ":" and every push (keeps Y)
E118   A5 02                  LDA   TL   
E11A   9D 00 02               STA   DSL,X   
E11D   A5 03                  LDA   TH   
E11F   9D 00 03               STA   DSH,X   
E122   60                     RTS      
E123                          IF   SBASEU   
E123                             ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
E123                             ; fetched or stored in the same step (x@ is the commonest pair in most
E123                             ; programs). A checked build checks the stacks between the two, so it keeps
E123                             ; them apart. (pvar calls lower, which only pushes.)
E123   0A           LOWQ:     ASL      
E124   85 04                  STA   T0   ; the cell's offset in the letter page
E126   A0 00                  LDY   #0   
E128   B1 00                  LDA   (IP),Y   
E12A   C9 40                  CMP   #"@"   
E12C   F0 0A                  BEQ   lwf   
E12E   C9 21                  CMP   #"!"   
E130   F0 19                  BEQ   lws   
E132   A5 04                  LDA   T0   
E134   A0 04                  LDY   #>LET   
E136   D0 D5                  BNE   pushay   ; always: the address
E138   20 89 E3     LWF:      JSR   incip   ; x@: TOS = the cell's value
E13B   20 17 E1               JSR   push   
E13E   A4 04                  LDY   T0   
E140   B9 00 04               LDA   LET,Y   
E143   85 02                  STA   TL   
E145   B9 01 04               LDA   LET+1,Y   
E148   85 03                  STA   TH   
E14A   60                     RTS      
E14B   20 89 E3     LWS:      JSR   incip   ; x!: the cell = TOS, and NOS comes up
E14E   A4 04                  LDY   T0   
E150   A5 02                  LDA   TL   
E152   99 00 04               STA   LET,Y   
E155   A5 03                  LDA   TH   
E157   99 01 04               STA   LET+1,Y   
E15A   4C B3 E3               JMP   drop   
E15D                          ENDIF      
E15D                          IF   QK   
E15D                             ;  ---- Speed-ups (QK builds) ---------------------------------------------
E15D                             ;  The skip cache and the faster skip are at skip, "*" at h_mul and "/" at
E15D                             ;  udiv; x@ and x! (unchecked) at lowq, above.
E15D                             ; A true ")" reads the block start where it is, under the step frame,
E15D                             ; instead of popping it and pushing it back. The break key is looked at as
E15D                             ; pnext would.
E15D   8A           CLOSEQ:   TXA      ; (TSX trashes X)
E15E   BA                     TSX      
E15F   BC 03 01               LDY   103h,X   
E162   84 00                  STY   IP   
E164   BC 04 01               LDY   104h,X   
E167   84 01                  STY   IP+1   
E169   AA                     TAX      
E16A   CE 79 04               DEC   CDOWN   
E16D   F0 01                  BEQ   cq1   
E16F   60                     RTS      ; into the loop
E170   68           CQ1:      PLA      
E171   68                     PLA      ; the step frame
E172   4C 2D E0               JMP   pkey   
E175                          ENDIF      
E175                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E175                             ; the matching ")".
E175   20 9B E3     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E178                          IF   1-CHECKED   
E178   F0 36                  BEQ   skip   
E17A                          ENDIF      
E17A                          IF   CHECKED   
                              BEQ   skpar   
E17A                          ENDIF      
E17A                             ; pushn: take the step frame off, push the reading position on the return
E17A                             ; stack, and go on. With the carry set (a word call) the reading position
E17A                             ; then becomes the address in the letter cell at LET,Y.
E17A   68           PUSHN:    PLA      
E17B   68                     PLA      ; drop the step frame
E17C   A5 01                  LDA   IP+1   
E17E   48                     PHA      
E17F   A5 00                  LDA   IP   
E181   48                     PHA      
E182   90 0A                  BCC   nxt   
E184   B9 00 04               LDA   LET,Y   
E187   85 00                  STA   IP   
E189   B9 01 04               LDA   LET+1,Y   
E18C   85 01                  STA   IP+1   
E18E   4C 28 E0     NXT:      JMP   pnext   
E191                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E191                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E191                             ; the body"s address instead. Either way it then skips to the matching "]'.
E191                             ; (The unchecked build takes anything that is not a letter as the space; the
E191                             ; checked build stops on it.)
E191                          IF   CHECKED   
                    DEF1:     CPY   #" "-"A"+256   
                              BEQ   def2   
                                 ; W: anything but a letter or a space after [. The place is that character,
                                 ; one past the [.
                              INC   PLACE   
                              BNE   eb1   
                              INC   PLACE+1   
                    EB1:      LDA   #"W"   
E191                          ENDIF      
E191                          IF   CHECKED*(1-QK)   
                              BNE   ejmp2   ; always
E191                          ENDIF      
E191                          IF   CHECKED*QK   
                              JMP   error   ; (the skip cache moved ejmp2 out of reach)
E191                          ENDIF      
E191                          IF   CHECKED   
                                 ; A false ( skips: the wrong closer for it is ].
                    SKPAR:    LDA   #"]"   
                              BNE   skip   ; always
E191                          ENDIF      
E191   20 86 E3     H_DEF:    JSR   getc   
E194   38                     SEC      
E195   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E197   A8                     TAY      ;   lands 64 bytes up
E198   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E19A   C9 1A                  CMP   #26   
E19C                          IF   1-CHECKED   
E19C   B0 0F                  BCS   def2   ; not a letter
E19E                          ENDIF      
E19E                          IF   CHECKED   
                              BCS   def1   
E19E                          ENDIF      
E19E   98                     TYA      
E19F   0A                     ASL      
E1A0   A8                     TAY      ; Y -> the cell
E1A1   A5 00                  LDA   IP   
E1A3   99 00 04               STA   LET,Y   
E1A6   A5 01                  LDA   IP+1   
E1A8   99 01 04               STA   LET+1,Y   
E1AB   D0 03                  BNE   skdef   ; always: no program is in page zero
E1AD   20 09 E1     DEF2:     JSR   puship   ; an anonymous block: push its address
E1B0                SKDEF:       
E1B0                          IF   CHECKED   
                              LDA   #")"   ; the wrong closer for [
E1B0                          ENDIF      
E1B0                             ; skip: read past text to the closer at this level, and return it in A.
E1B0                             ; Brackets of both kinds count together; strings are stepped over whole. A
E1B0                             ; NUL first ends the program.
E1B0                             ; In the checked build A holds, on the way in, the wrong closer for the
E1B0                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E1B0                             ; which takes either. Meeting the wrong closer at this level, or the end
E1B0                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E1B0                             ; which then ends the program as before.
E1B0                SKIP:        
E1B0                          IF   CHECKED   
                              STA   T0   
E1B0                          ENDIF      
E1B0                          IF   1-QK   
                              LDA   #0   
                              STA   D1   ; depth
                    SK1:      JSR   getc   
E1B0                          ENDIF      
E1B0                          IF   (1-QK)*(1-CHECKED)   
                              BEQ   endprog   
E1B0                          ENDIF      
E1B0                          IF   (1-QK)*CHECKED   
                              BEQ   sknul   
E1B0                          ENDIF      
E1B0                          IF   1-QK   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 22h (11h when checked), which
                                 ;   matches nothing below
E1B0                          ENDIF      
E1B0                          IF   (1-QK)*CHECKED   
                              BEQ   sknul   ; the string ran into the end
E1B0                          ENDIF      
E1B0                          IF   1-QK   
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   D1   
                              BPL   sk1   
E1B0                          ENDIF      
E1B0                          IF   (1-QK)*CHECKED   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
E1B0                          ENDIF      
E1B0                          IF   1-QK   
                              RTS      ; the closer at this level
                    SK3:      INC   D1   
                              BNE   sk1   
E1B0                          ENDIF      
E1B0                          IF   QK   
E1B0                             ; The skip cache (QK builds). Nearly every skip is one that has happened
E1B0                             ; before (a loop skips the same false block on every pass), so the first
E1B0                             ; scan from each place is remembered: 64 entries of {start, the closer's
E1B0                             ; address}, in CPAGE, found by the start's low byte times 4. Only skips that
E1B0                             ; start in the program text are kept (the line buffer changes); the cache is
E1B0                             ; emptied when the program starts. A program that changes its own text while
E1B0                             ; it runs is not looked after.
E1B0   A5 01                  LDA   IP+1   
E1B2   C9 05                  CMP   #>PROG   
E1B4   90 24                  BCC   sks   ; below the program text: no cache
E1B6   A5 00                  LDA   IP   
E1B8   0A                     ASL      
E1B9   0A                     ASL      
E1BA   A8                     TAY      ; Y -> the entry
E1BB   A5 00                  LDA   IP   
E1BD   D9 00 DF               CMP   CPAGE*256,Y   
E1C0   D0 18                  BNE   sks   
E1C2   A5 01                  LDA   IP+1   
E1C4   D9 01 DF               CMP   CPAGE*256+1,Y   
E1C7   D0 11                  BNE   sks   
E1C9   B9 02 DF               LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
E1CC   85 00                  STA   IP   ;   read
E1CE   B9 03 DF               LDA   CPAGE*256+3,Y   
E1D1   85 01                  STA   IP+1   
E1D3   A0 00                  LDY   #0   
E1D5   B1 00                  LDA   (IP),Y   
E1D7   4C 89 E3               JMP   incip   
E1DA   A5 00        SKS:      LDA   IP   
E1DC   85 05                  STA   SKL   
E1DE   A5 01                  LDA   IP+1   
E1E0   85 08                  STA   SKH   
E1E2   A0 00                  LDY   #0   
E1E4   84 09                  STY   D1   ; depth
E1E6                             ; The scan reads at IP+Y. Most characters are nothing to it, and two range
E1E6                             ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
E1E6   B1 00        SQ1:      LDA   (IP),Y   
E1E8   C8                     INY      
E1E9   F0 1D                  BEQ   sqw   
E1EB   C9 5E        SQ2:      CMP   #5Eh   
E1ED   B0 F7                  BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E1EF   C9 5B                  CMP   #5Bh   
E1F1   B0 28                  BCS   sqb   ; [ \ ]
E1F3   C9 2A                  CMP   #2Ah   
E1F5   B0 EF                  BCS   sq1   ; * to Z: nothing
E1F7   C9 28                  CMP   #28h   
E1F9   F0 1B                  BEQ   sqo   ; (
E1FB   B0 24                  BCS   sqc   ; )
E1FD   C9 22                  CMP   #22h   
E1FF   F0 0B                  BEQ   sqq   ; a string
E201   C9 01                  CMP   #1   
E203   B0 E1                  BCS   sq1   ; the rest below "(": nothing
E205                          ENDIF      
E205                          IF   QK*(1-CHECKED)   
E205   4C 09 FF               JMP   EXIT   ; NUL: the end of the program
E208                          ENDIF      
E208                          IF   QK*CHECKED   
                              JMP   sknul   
E208                          ENDIF      
E208                          IF   QK   
E208   E6 01        SQW:      INC   IP+1   ; Y went round: on into the next page
E20A   D0 DF                  BNE   sq2   ; always
E20C   20 4F E2     SQQ:      JSR   sqip   ; a string: step over it
E20F   20 5F E2               JSR   skipstr   
E212                          ENDIF      
E212                          IF   QK*CHECKED   
                              BEQ   sknul   ; the string ran into the end
E212                          ENDIF      
E212                          IF   QK   
E212   A0 00                  LDY   #0   
E214   F0 D0                  BEQ   sq1   ; always
E216   E6 09        SQO:      INC   D1   ; an opener
E218   4C E6 E1               JMP   sq1   
E21B   C9 5C        SQB:      CMP   #5Ch   
E21D   F0 C7                  BEQ   sq1   ; "\" is nothing here
E21F   90 F5                  BCC   sqo   ; [
E221   C6 09        SQC:      DEC   D1   ; ) ]
E223   10 C1                  BPL   sq1   
E225   20 4F E2               JSR   sqip   ; the closer at this level: the IP past it
E228                          ENDIF      
E228                          IF   QK*CHECKED   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
E228                          ENDIF      
E228                          IF   QK   
E228   48                     PHA      
E229   A5 08                  LDA   SKH   ; remember the skip, if it started in the
E22B   C9 05                  CMP   #>PROG   ;   program text
E22D   90 1E                  BCC   sq9   
E22F   A5 05                  LDA   SKL   
E231   0A                     ASL      
E232   0A                     ASL      
E233   A8                     TAY      
E234   A5 05                  LDA   SKL   
E236   99 00 DF               STA   CPAGE*256,Y   
E239   A5 08                  LDA   SKH   
E23B   99 01 DF               STA   CPAGE*256+1,Y   
E23E   A5 00                  LDA   IP   
E240   38                     SEC      
E241   E9 01                  SBC   #1   
E243   99 02 DF               STA   CPAGE*256+2,Y   ; the closer's address
E246   A5 01                  LDA   IP+1   
E248   E9 00                  SBC   #0   
E24A   99 03 DF               STA   CPAGE*256+3,Y   
E24D   68           SQ9:      PLA      
E24E   60                     RTS      ; the closer at this level
E24F                             ; sqip: IP = IP + Y. Keeps A.
E24F   48           SQIP:     PHA      
E250   98                     TYA      
E251   18                     CLC      
E252   65 00                  ADC   IP   
E254   85 00                  STA   IP   
E256   90 02                  BCC   sp1   
E258   E6 01                  INC   IP+1   
E25A   68           SP1:      PLA      
E25B   60                     RTS      
E25C                          ENDIF      
E25C                          IF   CHECKED   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                                 ; The end of "$" (h_print): the string's address goes back into TOS; then a
                                 ; closing quote drops it, and a NUL (the carry clear) is Q.
                    PQ:       PLA      
                              STA   TL   
                              PLA      
                              STA   TH   
                              BCS   pdrop   
                              CPX   #DSE   ; a NUL: Q, unless "$" had nothing on the
                              LDA   #"s"   ;   stack at all (X at the empty mark): s
                              BCS   ejmp2   
                    E_QUOTE:   LDA   #"Q"   ; a string runs into the end
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                    EJMP2:    JMP   error   ;   or the end: the place is the opener
E25C                          ENDIF      
E25C                             ; 22h pushes the address of the text after it and skips the string.
E25C   20 09 E1     H_STR:    JSR   puship   
E25F                          IF   CHECKED   
                              JSR   skipstr   
                              BEQ   e_quote   ; it ran into the end: the place is the 22h
                              RTS      
E25F                          ENDIF      
E25F                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E25F                             ; the next character, so "/"" does not end it.
E25F                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E25F                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E25F                             ; text ended first (a NUL, also one just after "/").
E25F                          IF   1-CHECKED   
E25F   20 86 E3     SKIPSTR:   JSR   getc   
E262   C9 2F                  CMP   #"/"   
E264   F0 05                  BEQ   ss0   
E266   C9 22                  CMP   #22h   
E268   D0 F5                  BNE   skipstr   
E26A   60                     RTS      
E26B   20 89 E3     SS0:      JSR   incip   
E26E   D0 EF                  BNE   skipstr   ; A is "/" here
E270                          ENDIF      
E270                          IF   CHECKED   
                    SKIPSTR:   JSR   getc   
                              BEQ   ss9   ; the end
                              CMP   #"/"   
                              BNE   ss1   
                              JSR   getc   ; the escaped character
                              BNE   skipstr   
                    SS9:      RTS      ; the end, just after "/"
                    SS1:      CMP   #22h   
                              BNE   skipstr   
                              LSR      ; A = 11h, Z clear
                              RTS      
E270                          ENDIF      
E270                             ; =============================================================================
E270                             ;  Console
E270                             ; =============================================================================
E270                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E270                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E270                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
E270                             ; no bit 6, so // and /" give themselves). TOS walks along the string; the
E270                             ; checked build keeps the address on the hardware stack meanwhile, for a Q
E270                             ; report (see pq).
E270                          IF   CHECKED   
                    H_PRINT:   LDA   TH   
                              PHA      
                              LDA   TL   
                              PHA      
                              BCC   pr0   ; always: the carry is clear on the way in
E270                          ENDIF      
E270                          IF   1-CHECKED   
E270                H_PRINT:   EQU   pr0   
E270                          ENDIF      
E270   20 A4 E2     PESC0:    JSR   pesc   ; (an escape, and back into the loop)
E273   20 99 E2     PR0:      JSR   tosget   
E276   C9 22                  CMP   #22h   
E278                          IF   1-CHECKED   
E278   F0 1C                  BEQ   pdrop   
E27A                          ENDIF      
E27A                          IF   CHECKED   
                              BEQ   pq   ; the closing quote, with the carry set
                              TAY      ; (Y is free here)
                              BEQ   pq   ; a NUL, with the carry clear
E27A                          ENDIF      
E27A   C9 2F                  CMP   #"/"   
E27C   D0 0D                  BNE   pr1   
E27E   20 99 E2               JSR   tosget   
E281   C9 60                  CMP   #60h   
E283   90 04                  BCC   pr2   
E285   C9 7F                  CMP   #7Fh   
E287   90 E7                  BCC   pesc0   ; 60h-7Eh, and the carry is clear
E289   29 BF        PR2:      AND   #0BFh   
E28B   20 03 FF     PR1:      JSR   CONOUT   
E28E   4C 73 E2               JMP   pr0   
E291   A5 02        H_EMIT:   LDA   TL   ; "'"
E293   20 03 FF               JSR   CONOUT   
E296   4C B3 E3     PDROP:    JMP   drop   
E299                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E299   A0 00        TOSGET:   LDY   #0   
E29B   B1 02                  LDA   (TL),Y   
E29D   E6 02        INCTOS:   INC   TL   
E29F   D0 02                  BNE   tg1   
E2A1   E6 03                  INC   TH   
E2A3   60           TG1:      RTS      
E2A4                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E2A4                             ; the carry is clear. Each returns into the loop.
E2A4                             ;    /a-/z   print the variable, as "#" does
E2A4                             ;    /{      clear the screen, the cursor to the top left
E2A4                             ;    /}      clear from the cursor to the end of the line
E2A4                             ;    /|  /`  show the cursor, hide it
E2A4                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E2A4                             ;            from 0. The two cells under TOS (the string's address) go.
E2A4                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E2A4                             ; E6h-FFh with it clear.
E2A4                          IF   1-ANSI   
E2A4                             ; With ANSI = 0 the machine's routines do the work.
E2A4   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E2A6   90 0D                  BCC   pe1   
E2A8   F0 08                  BEQ   pcls   ; {
E2AA   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E2AB   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E2AD   B0 0D                  BCS   pat   ; ~
E2AF   4C 0F FF               JMP   CONEOL   ; }
E2B2   4C 0C FF     PCLS:     JMP   CONCLS   
E2B5   C9 E6        PE1:      CMP   #0E6h   
E2B7   B0 0E                  BCS   pvar   
E2B9   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E2BC                          ENDIF      
E2BC                             ; /~: the column is NOS, the row the cell under it.
E2BC                PAT:         
E2BC                          IF   CHECKED   
                              CPX   #DSE-2   ; fewer than two cells under TOS: s
                              BCS   e_atu   
E2BC                          ENDIF      
E2BC                          IF   1-ANSI   
E2BC   BC 00 02               LDY   DSL,X   ; the column
E2BF   BD 01 02               LDA   DSL+1,X   ; the row
E2C2   E8                     INX      
E2C3   E8                     INX      
E2C4   4C 15 FF               JMP   CONAT   
E2C7                          ENDIF      
E2C7                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). The row's cell and TOS change
                                 ; places first: then "#" prints the row and drops it, prints the column and
                                 ; drops it, and TOS is the string's address again.
                              INX      
                              JSR   h_swap   
                              DEX      
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E2C7                          ENDIF      
E2C7                          IF   CHECKED   
                    E_ATU:    JMP   e_stack   ; (X is FAh-FCh: an underflow)
E2C7                          ENDIF      
E2C7                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E2C7                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' (next)
E2C7                             ; prints it and drops it: TOS is the string's address again.
E2C7   69 39        PVAR:     ADC   #39h   
E2C9   20 04 E1               JSR   lower   
E2CC   20 5C E5               JSR   h_fetch   
E2CF                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E2CF                             ; digits are divided off and held on the hardware stack, ended by a 0.
E2CF   A5 03        H_NUM:    LDA   TH   
E2D1   10 08                  BPL   pn1   
E2D3   A9 2D                  LDA   #"-"   
E2D5   20 03 FF               JSR   CONOUT   
E2D8   20 0F E4               JSR   neg   
E2DB   A9 0A        PN1:      LDA   #10   
E2DD   85 08                  STA   D0   
E2DF   A9 00                  LDA   #0   
E2E1   85 09                  STA   D1   
E2E3   48                     PHA      ; the end marker
E2E4   20 F2 E4     PN2:      JSR   udiv   
E2E7   A5 04                  LDA   T0   ; the remainder
E2E9   09 30                  ORA   #"0"   
E2EB   48                     PHA      
E2EC   A5 02                  LDA   TL   
E2EE   05 03                  ORA   TH   
E2F0   D0 F2                  BNE   pn2   
E2F2   68           PN3:      PLA      
E2F3   F0 A1                  BEQ   pdrop   
E2F5   20 03 FF               JSR   CONOUT   
E2F8   4C F2 E2               JMP   pn3   
E2FB                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into. (It sits here, just above prs, for that.)
                    PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh). Y is 0, as
                                 ;   tosget leaves it, and M_CLS is the first
                                 ;   message: Y already points at it
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E2FB                          ENDIF      
E2FB                          IF   CHECKED+ANSI   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
E2FB                          ENDIF      
E2FB                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   ; (the first: pesc counts on it)
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
E2FB                          ENDIF      
E2FB                          IF   CHECKED   
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"D",":"+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"R",":"+80h   
E2FB                          ENDIF      
E2FB                             ; =============================================================================
E2FB                             ;  Dispatch table: one handler per punctuation character, in code order.
E2FB                             ;  Entries are handler-1 for the RTS trick.
E2FB                             ; =============================================================================
E2FB   A3 E3        PTAB:     DW   h_store-1   ; !
E2FD   5B E2                  DW   h_str-1   ; "
E2FF   CE E2                  DW   h_num-1   ; #
E301   72 E2                  DW   h_print-1   ; $
E303   9B E4                  DW   h_swap-1   ; %
E305   BE E3                  DW   h_and-1   ; &
E307   90 E2                  DW   h_emit-1   ; '
E309   74 E1                  DW   h_open-1   ; (
E30B   56 E0                  DW   h_close-1   ; )
E30D   41 E4                  DW   h_mul-1   ; *
E30F   F0 E3                  DW   h_add-1   ; +
E311   67 E5                  DW   h_cfetch-1   ; ,
E313   E8 E3                  DW   h_sub-1   ; -
E315   AA E3                  DW   h_cstore-1   ; .
E317   B0 E4                  DW   h_div-1   ; /
E319   16 E1                  DW   push-1   ; :
E31B   B2 E3                  DW   drop-1   ; ;
E31D   1F E4                  DW   h_lt-1   ; <
E31F   31 E4                  DW   h_eq-1   ; =
E321   1C E4                  DW   h_gt-1   ; >
E323   70 E5                  DW   h_key-1   ; ?
E325   5B E5                  DW   h_fetch-1   ; @
E327   90 E1                  DW   h_def-1   ; [
E329   6F E0                  DW   h_break-1   ; \
E32B   5E E0                  DW   h_ret-1   ; ]
E32D   DA E3                  DW   h_xor-1   ; ^
E32F   DA E4                  DW   h_alloc-1   ; _
E331   CE E5                  DW   h_grave-1   ; `
E333   3C E0                  DW   h_tor-1   ; {
E335   CC E3                  DW   h_or-1   ; |
E337   49 E0                  DW   h_fromr-1   ; }
E339   08 E4                  DW   h_not-1   ; ~
E33B                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E33B                             ; test is at the bottom so the loop closes with a branch. Returns with the
E33B                             ; carry set.
E33B   20 89 E3     RD1:      JSR   incip   ; (keeps A = the digit)
E33E   06 02                  ASL   TL   
E340   26 03                  ROL   TH   ; x2
E342   18                     CLC      
E343   65 02                  ADC   TL   
E345   85 04                  STA   T0   
E347   A5 03                  LDA   TH   
E349   69 00                  ADC   #0   
E34B   A8                     TAY      ; Y:T0 = x2 + digit
E34C   06 02                  ASL   TL   
E34E   26 03                  ROL   TH   
E350   06 02                  ASL   TL   
E352   26 03                  ROL   TH   ; x8
E354   18                     CLC      
E355   A5 02                  LDA   TL   
E357   65 04                  ADC   T0   
E359   85 02                  STA   TL   
E35B   98                     TYA      
E35C   65 03                  ADC   TH   
E35E   85 03                  STA   TH   ; x8 + x2 + digit
E360   20 66 E3     RDNUM:    JSR   isdig   
E363   90 D6                  BCC   rd1   
E365   60                     RTS      
E366                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E366                             ; digit. Y = 0.
E366   20 81 E3     ISDIG:    JSR   peek   
E369   38                     SEC      
E36A   E9 30                  SBC   #"0"   
E36C   C9 0A                  CMP   #10   
E36E   60                     RTS      
E36F                             ; =============================================================================
E36F                             ;  Reading the program
E36F                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E36F                             ;    getc: the same, then IP moves on; flags follow A
E36F                             ;    incip: IP moves on; keeps A, the carry and Y
E36F                             ; =============================================================================
E36F                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E36F                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E36F                             ; Y = 0.
E36F   20 66 E3     RDHEX:    JSR   isdig   
E372   90 0A                  BCC   rh1   
E374   29 DF                  AND   #0DFh   
E376   E9 11                  SBC   #11h   ; (the carry is set)
E378   C9 06                  CMP   #6   
E37A   B0 04                  BCS   rh9   
E37C   69 0A                  ADC   #10   
E37E   90 09        RH1:      BCC   incip   ; always: the carry is clear
E380   60           RH9:      RTS      
E381   A0 00        PEEK:     LDY   #0   
E383   B1 00                  LDA   (IP),Y   
E385   60                     RTS      
E386   20 81 E3     GETC:     JSR   peek   
E389   E6 00        INCIP:    INC   IP   
E38B   D0 02                  BNE   ic1   
E38D   E6 01                  INC   IP+1   
E38F   09 00        IC1:      ORA   #0   
E391   60                     RTS      
E392                             ; rstip: point IP at the start of the program
E392   A9 00        RSTIP:    LDA   #<PROG   
E394   85 00                  STA   IP   
E396   A9 05                  LDA   #>PROG   
E398   85 01                  STA   IP+1   
E39A   60                     RTS      
E39B                             ; =============================================================================
E39B                             ;  Stack
E39B                             ; =============================================================================
E39B                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E39B   A5 02        FLAG:     LDA   TL   
E39D   05 03                  ORA   TH   
E39F   20 B3 E3               JSR   drop   
E3A2   A8                     TAY      ; (drop's INX changed the flags)
E3A3   60                     RTS      
E3A4                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E3A4                H_STORE:      
E3A4                          IF   CHECKED   
                              LDA   TL   ; both bytes must be in the program's space:
                              ADC   #1   ; check the page of addr+1 (the carry is
                              LDA   TH   ; clear on the way in)
                              ADC   #0   
                              JSR   chkst   
E3A4                          ENDIF      
E3A4   BD 00 03               LDA   DSH,X   
E3A7   A0 01                  LDY   #1   
E3A9   91 02                  STA   (TL),Y   
E3AB                H_CSTORE:      ; "." ( c addr -- )
E3AB                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E3AB                          ENDIF      
E3AB   BD 00 02               LDA   DSL,X   
E3AE   A0 00                  LDY   #0   
E3B0   91 02                  STA   (TL),Y   
E3B2   E8                     INX      ; falls into drop
E3B3                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E3B3                             ; it returns with Z clear.
E3B3   BC 00 02     DROP:     LDY   DSL,X   
E3B6   84 02                  STY   TL   
E3B8   BC 00 03               LDY   DSH,X   
E3BB   84 03                  STY   TH   
E3BD   E8                     INX      
E3BE   60                     RTS      
E3BF                             ; =============================================================================
E3BF                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E3BF                             ; =============================================================================
E3BF                             ; The logic operators leave the carry as they found it, clear, so they can
E3BF                             ; branch to fin.
E3BF   BD 00 02     H_AND:    LDA   DSL,X   
E3C2   25 02                  AND   TL   
E3C4   85 02                  STA   TL   
E3C6   BD 00 03               LDA   DSH,X   
E3C9   25 03                  AND   TH   
E3CB   90 31                  BCC   fin   ; always
E3CD   BD 00 02     H_OR:     LDA   DSL,X   
E3D0   05 02                  ORA   TL   
E3D2   85 02                  STA   TL   
E3D4   BD 00 03               LDA   DSH,X   
E3D7   05 03                  ORA   TH   
E3D9   90 23                  BCC   fin   ; always
E3DB   BD 00 02     H_XOR:    LDA   DSL,X   
E3DE   45 02                  EOR   TL   
E3E0   85 02                  STA   TL   
E3E2   BD 00 03               LDA   DSH,X   
E3E5   45 03                  EOR   TH   
E3E7   90 15                  BCC   fin   ; always
E3E9                             ; "-" has two jobs: directly before a digit it starts a negative number.
E3E9   20 66 E3     H_SUB:    JSR   isdig   
E3EC   90 14                  BCC   negnum   
E3EE   20 0F E4     SUB1:     JSR   neg   ; a - b = a + (-b)
E3F1   18           H_ADD:    CLC      
E3F2   BD 00 02               LDA   DSL,X   
E3F5   65 02                  ADC   TL   
E3F7   85 02                  STA   TL   
E3F9   BD 00 03               LDA   DSH,X   
E3FC   65 03                  ADC   TH   ; falls into fin
E3FE                             ; fin: finish a two-operand op: A = the high byte of the result
E3FE   85 03        FIN:      STA   TH   
E400   E8                     INX      
E401   60                     RTS      
E402   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E404   20 FC E0               JSR   digit   ; (comes back with the carry set)
E407   B0 06                  BCS   neg   ; always: the number, negated
E409                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E409   90 05        H_NOT:    BCC   neg1   ; always
E40B                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E40B   A5 03        ABSV:     LDA   TH   
E40D   10 0D        NEGM:     BPL   ab9   
E40F                             ; neg: TOS = -TOS
E40F   38           NEG:      SEC      
E410   A9 00        NEG1:     LDA   #0   
E412   E5 02                  SBC   TL   
E414   85 02                  STA   TL   
E416   A9 00                  LDA   #0   
E418   E5 03                  SBC   TH   
E41A   85 03                  STA   TH   
E41C   60           AB9:      RTS      
E41D                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E41D                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E41D   20 9C E4     H_GT:     JSR   h_swap   ; a > b is b < a
E420   BD 00 02     H_LT:     LDA   DSL,X   
E423   C5 02                  CMP   TL   
E425   BD 00 03               LDA   DSH,X   
E428   E5 03                  SBC   TH   
E42A   70 02                  BVS   lt1   
E42C   49 80                  EOR   #80h   
E42E   0A           LT1:      ASL      
E42F   E8                     INX      ; (keeps the carry; never leaves X at 0)
E430   D0 07                  BNE   bool   ; always
E432   20 EE E3     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E435   05 02                  ORA   TL   
E437   C9 01                  CMP   #1   ; carry clear if A = 0
E439   A9 00        BOOL:     LDA   #0   
E43B   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E43D   85 02                  STA   TL   
E43F   85 03                  STA   TH   
E441   60                     RTS      
E442                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E442                             ; bottom while the product comes in at the top, through A:T0 above it; after
E442                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E442                          IF   FAST   
                                 ; (the fast build: as QK below, the rounds unrolled, with Y for the upper
                                 ; half's high byte while the low one is added)
                    H_MUL:    LDA   TH   
                              BEQ   mq8   
                              LDA   DSH,X   
                              BEQ   mqs   
                              JMP   mq16   ; (out of a branch's reach)
                    MQS:      JSR   h_swap   
                    MQ8:      LDA   #0   
                              STA   T0   
                              LSR   TL   
                              BCC   mu0   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
                              ADC   DSH,X   
                    MU0:      ROR      
                              ROR   T0   
                              ROR   TL   
                              BCC   mu1   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
                              ADC   DSH,X   
                    MU1:      ROR      
                              ROR   T0   
                              ROR   TL   
                              BCC   mu2   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
