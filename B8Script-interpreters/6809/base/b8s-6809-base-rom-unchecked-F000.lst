0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Motorola 6809
0000                             ;  Required Notice: Copyright 2026 Robb Bates (https://github.com/robbbates)
0000                             ;  Licence: PolyForm Noncommercial License 1.0.0 (LICENSE.md at the top of
0000                             ;  the repository, or https://polyformproject.org/licenses/noncommercial/1.0.0)
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ;  Follows the design of the Z80 interpreter (z80/b8s-z80.asm).
0000                             ; 
0000                             ;  The switches, in the EQU lines below (CPM is always 0: the 6809 has no
0000                             ;  CP/M; the line is kept only so that build.sh works):
0000                             ;    CHECKED  0 = no checks (spec: an unchecked build checks nothing)
0000                             ;             1 = a checked build: variables start at 0, words start
0000                             ;                 undefined, and every error in the spec's table stops the
0000                             ;                 program with the three-line report, then goes to EXIT:
0000                             ;                   Err X @ line,col
0000                             ;                   D:n: ... v v v      (n = depth, then the top 8 values)
0000                             ;                   R:n
0000                             ;                 S/s data stack over/underflow, R/r return stack over/
0000                             ;                 underflow, H heap, O store outside the program's space,
0000                             ;                 W bad character after [, U undefined word, Q no closing
0000                             ;                 quote, X reserved byte, Z divide by zero, N unbalanced or
0000                             ;                 mismatched brackets, B Ctrl-C.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost few bytes: a
0000                             ;                 skip cache, a faster skip, "*" quicker when a high byte is
0000                             ;                 0, "/" by any power of two as a shift, and (unchecked) a
0000                             ;                 variable and its "@" or "!" in one step. See "Speed-ups".
0000                             ;                 The heap limit is a page lower (EF00h): the skip cache has
0000                             ;                 the page above it.
0000                             ;             2 = fast: base, and a dispatch table besides, with
0000                             ;                 no size limit. See "The fast build". The image starts at
0000                             ;                 E000h, the heap limit is DF00h and the skip cache is at
0000                             ;                 DF00h-DFFFh.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (the unchecked build goes
0000                             ;  to EXIT without a word): see the console layer below for the rules, the
0000                             ;  held key and the break-off cell at 827Bh.
0000                             ; 
0000                             ;  Assembler: asm80, M6809 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0 (no CP/M on the 6809)
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   1   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  base build takes; the fast build has its own)
0000                             ; (asm80 can't nest IF, and IF takes any value
0000                             ;  but 0 as true, so IF CHECKED+QK means "either")
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    Y    IP: the address of the next program character to read
0000                             ;    U    the data stack pointer. The stack grows down and U points at the
0000                             ;         top cell (TOS); nothing is cached in a register, because every
0000                             ;         dispatch needs A, B and X as scratch. Cells are big-endian here.
0000                             ;         (Only the stacks are big-endian: cells in RAM that the program can
0000                             ;         see - variables, the heap pointer, anything @ and ! reach - are
0000                             ;         little-endian, as the spec says, so @ and ! swap the bytes.)
0000                             ;    S    the return stack. A word call is a plain push of Y. Entries are
0000                             ;         2 bytes, big-endian. Handlers are called with JSR, so the return
0000                             ;         address of the dispatcher is on top of S while a handler runs.
0000                             ;    DP   the letter page, so the letter-page variables below cost 2-byte
0000                             ;         direct addressing. Nothing else may change DP.
0000                             ;    A B X are scratch. Every handler is entered by JSR and ends in RTS (one
0000                             ;    byte). A handler that pushes or pops the return stack first pulls the
0000                             ;    dispatcher's return address into X (PULS X) and ends with JMP ,X.
0000                             ; 
0000                             ;  Dispatch (unchecked build). PTAB holds one byte per punctuation character:
0000                             ;  the low byte of the handler's distance from PTAB. The handlers of the last
0000                             ;  characters (in code order) start within 256 bytes after PTAB, the handlers
0000                             ;  of the first NPG1 characters in the 256 bytes after that. The assembler
0000                             ;  works NPG1 out from where five handlers landed, and testing/chktab09.py
0000                             ;  checks the layout. The checked build is bigger than that reach, so its
0000                             ;  table holds whole addresses instead. (The fast build has neither: its
0000                             ;  table, FTAB, has an address for every byte. See "The fast build".)
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM areas:
0000                             ; 
0000                             ;    8000h-80FFh  return stack (S); empty = 8100h. Unchecked: 127 entries.
0000                             ;                 Checked: 96 entries (S down to 8040h); the 64 bytes below
0000                             ;                 are a guard band for what a handler, the console routines
0000                             ;                 and interrupts push on top of a full stack before the check
0000                             ;                 runs (the escapes of "$" take up to 22 of them, so 42 are
0000                             ;                 left for CONOUT and interrupts).
0000                             ;    8100h-81FFh  data stack (U). Unchecked: 127 cells, empty = 8200h.
0000                             ;                 Checked: 125 cells (U from 81FCh, empty, down to 8102h):
0000                             ;                 the 4 bytes above are a guard band, so a handler that runs
0000                             ;                 on an empty stack writes there and not on the letter
0000                             ;                 cells. A push past the last cell lands on 8100h, still in
0000                             ;                 this page, and the program stops with S. (It must not
0000                             ;                 reach 80FEh: with the return stack empty, the handler's
0000                             ;                 own return address is there. pdec's cell for its divisor,
0000                             ;                 under "#" or a /a in "$" on a full stack, lands on 8100h
0000                             ;                 too.)
0000                             ;    8200h-82FFh  letter page (LET): A..Z at +00h..+33h, a..z at +40h..+73h
0000                             ;                 (a word cell is always 64 bytes below its variable), the
0000                             ;                 heap pointer at +7Ch (= z10+), interpreter variables in the
0000                             ;                 gaps, and the -n? line buffer at +80h..+FFh. The break-off
0000                             ;                 cell is at +7Bh (827Bh); +7Ah is free.
0000                             ;    8300h-       PROG, the program text, NUL-terminated; the heap starts
0000                             ;                 after the NUL and grows to HEAPLIM*256 (F000h; EF00h
0000                             ;                 with base, DF00h in the fast build)
0000                             ;    EF00h-EFFFh  base: the skip cache (CPAGE), the page at the heap limit,
0000                             ;                 which the heap never reaches. (Fast build: DF00h-DFFFh.)
0000                             ;    F000h-       this image (ROM). The reset vector (FFFEh) must point to
0000                             ;                 `start` (see the listing); the image does not contain it.
0000                             ;                 (The fast build's image starts at E000h.)
0000                             ;    FF03h-FF17h  the console routines (CONOUT, KEY, and with ANSI = 0
0000                             ;                 CONCLS, CONEOL, CONCUR, CONAT) and EXIT are supplied by
0000                             ;                 the system and need no space here.
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LET..HEAPLIM*256.
0000                             ; -----------------------------------------------------------------------------
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (end the
0000                             ;   routine with TSTA / RTS, or a plain LDA).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   Both are called with JSR. They may change A and CC and must preserve
0000                             ;   B, X, Y, U and DP.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these as subroutines (each
0000                             ; ends with RTS). All four may change A, B, X and CC, and must keep Y, U
0000                             ; and DP.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row X, column D, both counted
0000                             ;     from 0
0000                          ENDIF      
0000                RSPAGE:   EQU   80h   
0000                DSPAGE:   EQU   81h   
0000                LETPAGE:   EQU   82h   
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                             ; (the checked startup counts on it being
0000                             ; the page after LETPAGE)
0000                ROM:      EQU   0F000h-FAST*1000h   ; where the image starts (the fast build: E000h)
0000                HEAPLIM:   EQU   ROM/256-QK   ; the heap must stay below F000h (a page);
0000                             ;   with base EF00h, the fast build DF00h
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (base and the fast
0000                             ;   build): the page at the heap limit
0000                MSLOOP:   EQU   20   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (direct-page offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   7Ch   ; z10+, the heap pointer (little-endian)
0000                KEYBUF:   EQU   34h   ; gap after Z: a key held back by the break check
0000                COUNT:    EQU   35h   ; the break check's countdown (1 look in 256)
0000                AT:       EQU   36h   ; checked: the address of the character being
0000                             ;   run (big-endian), the place an error reports
0000                PEND:     EQU   38h   ; checked: the program's end, the first byte
0000                             ;   after its NUL (big-endian): the heap's floor
0000                SSAV:     EQU   3Ah   ; checked: S as each character starts (big-
0000                             ;   endian): the return stack an error reports
0000                PSAV:     EQU   3Ch   ; checked: the address "$" prints from (big-
0000                             ;   endian), put back on the stack for a Q
0000                BRKOFF:   EQU   7Bh   ; the break-off cell (827Bh, z9+): 0 = the
0000                             ;   break key is on
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+100h   ; empty return stack
0000                RSLIM:    EQU   RSPAGE*256+40h   ; checked: S may go no lower between characters
0000                RSREP:    EQU   RSTOP-16   ; checked: S while the error report runs
0000                DSTOP:    EQU   DSPAGE*256+100h-4*CHECKED   ; empty data stack (a guard if checked)
0000                DSLIM:    EQU   DSPAGE*256+2   ; checked: U may go no lower between characters
0000                             ; The fast build's dispatcher, inline at the end of each of its own entries
0000                             ; (see "The fast build", at the end). The checked one calls fchk first.
0000                             ; (A count of 0 makes DS write nothing; DS needs fchk's address before the
0000                             ; first use, so fchk comes first in that part.)
0000                          IF   FAST*CHECKED   
                    ACHK:     EQU   fchk   
0000                          ENDIF      
0000                          IF   1-FAST*CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      CHECKED,0BDh    ; (checked: JSR fchk)
0000                 DS      CHECKED,ACHK/256
0000                 DS      CHECKED,ACHK&0FFh
0000                 LDB     ,Y+             ; the character,
0000                 LDX     #FTAB
0000                 ABX
0000                 ABX                     ;   its entry in the table,
0000                 JMP     [,X]            ;   and its handler
0000                .endm
0000                 
F000                          .ORG   ROM   
F000                             ; =============================================================================
F000                             ;  Startup
F000                             ; =============================================================================
F000   10 CE 81 00  START:    LDS   #RSTOP   
F004   CE 82 00               LDU   #DSTOP   
F007                          IF   QK   
F007                             ; Empty the skip cache: a start of 0000h matches no skip.
F007   8E EF 00               LDX   #CPAGE*256   
F00A   5F                     CLRB      
F00B   6F 80        SKZ:      CLR   ,X+   
F00D   5A                     DECB      
F00E   26 FB                  BNE   skz   
F010                          ENDIF      
F010   86 82                  LDA   #LETPAGE   
F012   1F 8B                  TFR   A,DP   
F014                          IF   CHECKED   
                                 ; Zero the whole letter page: every variable starts at 0, every word
                                 ; cell at 0 (undefined: a call stops with U), and so do the
                                 ; interpreter's own cells in the gaps (KEYBUF and the rest). A is
                                 ; still LETPAGE; 256 rounds leave X at the next page, PROG.
                              CLRB      
                              TFR   D,X   
                    SZ:       CLR   ,X+   
                              DECB      
                              BNE   sz   
F014                          ENDIF      
F014                          IF   1-CHECKED   
F014   0F 34                  CLR   <KEYBUF   ; no key held
F016   0F 7B                  CLR   <BRKOFF   ; the break key is on
F018   8E 83 00               LDX   #PROG   
F01B                          ENDIF      
F01B   1F 12                  TFR   X,Y   ; the reading position; the heap starts
F01D   A6 80        SC:       LDA   ,X+   ;   after the program's NUL
F01F   26 FC                  BNE   sc   
F021   1F 10                  TFR   X,D   
F023   D7 7C                  STB   <HEAP   ; (little-endian)
F025   97 7D                  STA   <HEAP+1   
F027                          IF   CHECKED   
                              STX   <PEND   ; the heap may never go below this
F027                          ENDIF      
F027                             ; =============================================================================
F027                             ;  The inner loop: read one character and sort it by range.
F027                             ; 
F027                             ;    00h          end of program
F027                             ;    01h-20h, 7Fh       ignored (control, space, DEL)
F027                             ;    80h-FFh      reserved: ignored, or X in the checked build
F027                             ;    30h-39h      digit: read a whole number
F027                             ;    41h-5Ah      A-Z: call the word in that letter's cell
F027                             ;    61h-7Ah      a-z: push the address of that letter's cell
F027                             ;    the rest     punctuation: JSR through PTAB, 32 entries, in code order
F027                             ; =============================================================================
F027                          IF   FAST   
                              JMP   fnext   ; (the fast build has its own: see the end)
F027                          ENDIF      
F027                          IF   1-FAST   
F027                NEXT:        
F027                          ENDIF      
F027                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, not in every handler:
                                 ; the pointer minus its limit, taken as unsigned, must be no more
                                 ; than the stack's size. Below the limit (an overflow) it wraps to
                                 ; FFxxh, and the compare leaves N set; above the empty point (an
                                 ; underflow) it is just over the size, and N is clear.
                              LEAX   (0-DSLIM)&0FFFFh,U   
                              CMPX   #DSTOP-DSLIM   
                              BHI   e_ds   
                              LEAX   (0-RSLIM)&0FFFFh,S   
                              CMPX   #RSTOP-RSLIM   
                              BHI   e_rs   
                              STY   <AT   ; the place, should this character fail
                              STS   <SSAV   ; and the return stack, as it is now
F027                          ENDIF      
F027                          IF   1-FAST   
F027   A6 A0                  LDA   ,Y+   
F029   27 72                  BEQ   fin   ; NUL ends the program
F02B   80 21                  SUBA   #21h   ; A = c - 21h
F02D   25 F8                  BLO   next   ; 01h-20h ignored
F02F   81 0F                  CMPA   #0Fh   
F031   25 20                  BLO   punct   ; 21h-2Fh: PTAB index 0-14
F033   81 19                  CMPA   #19h   
F035   25 2A                  BLO   digit   ; 30h-39h
F037   81 20                  CMPA   #20h   
F039   25 16                  BLO   p3a   ; 3Ah-40h: A = 19h-1Fh
F03B   80 20                  SUBA   #20h   ; A = c - 41h
F03D   81 1A                  CMPA   #1Ah   
F03F   25 4E                  BLO   upper   ; 41h-5Ah: A = letter index 0-25
F041   81 20                  CMPA   #20h   
F043   25 0A                  BLO   p5b   ; 5Bh-60h
F045   81 3A                  CMPA   #3Ah   
F047   25 1E                  BLO   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
F049   81 3E                  CMPA   #3Eh   
F04B                          ENDIF      
F04B                          IF   (1-CHECKED)*(1-FAST)   
F04B   24 DA                  BHS   next   ; 7Fh-FFh: ignored
F04D                          ENDIF      
F04D                          IF   CHECKED*(1-FAST)   
                              BEQ   next   ; 7Fh (DEL): ignored
                              BHI   e_resv   ; 80h-FFh: reserved
F04D                          ENDIF      
F04D                          IF   1-FAST   
F04D   80 1A                  SUBA   #1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
F04F   8B 06        P5B:      ADDA   #6   ; 5Bh-60h: -4 in all, index 22-27
F051   80 0A        P3A:      SUBA   #0Ah   ; 3Ah-40h: index 15-21
F053                             ; Punctuation: A = the PTAB index.
F053   8E F1 07     PUNCT:    LDX   #PTAB   
F056                          ENDIF      
F056                          IF   (1-CHECKED)*(1-FAST)   
F056                             ; The handler is at PTAB + D, where B is the table byte and A is 1
F056                             ; for the first NPG1 characters, 0 for the rest.
F056   E6 86                  LDB   A,X   
F058   81 14                  CMPA   #NPG1   ; carry: one of the first NPG1
F05A   86 00                  LDA   #0   ; (leaves the carry alone)
F05C   49                     ROLA      
F05D   AD 8B                  JSR   D,X   ; the handler ends in RTS
F05F                          ENDIF      
F05F                          IF   CHECKED*(1-FAST)   
                              ASLA      ; the table holds whole addresses
                              JSR   [A,X]   
F05F                          ENDIF      
F05F                          IF   1-FAST   
F05F   20 C6                  BRA   next   
F061                             ; Digits: step back onto the first digit and read the whole number.
F061   31 3F        DIGIT:    LEAY   -1,Y   
F063   8D 49                  BSR   rdnum   
F065   20 C0                  BRA   next   
F067                          ENDIF      
F067                             ; a-z: push the cell's address (the cell is the variable)
F067                             ;  (the unchecked base build does x@ and x! in one step)
F067                          IF   (1-SBASEU)*(1-FAST)   
                    LOWER:    BSR   cellx   
                              PSHU   X   
                              BRA   next   
F067                          ENDIF      
F067                          IF   SBASEU   
F067                             ; a-z, unchecked base: a variable followed by "@" or "!" is fetched or
F067                             ; stored in the same step (x@ is the commonest pair in most programs). A
F067                             ; checked build checks the stacks between the two, so it keeps them apart.
F067   48           LOWER:    ASLA      ; (cellx, inline)
F068   8E 82 00               LDX   #LET   
F06B   30 86                  LEAX   A,X   
F06D   E6 A4                  LDB   ,Y   
F06F   C1 40                  CMPB   #"@"   
F071   27 08                  BEQ   lwf   
F073   C1 21                  CMPB   #"!"   
F075   27 0E                  BEQ   lws   
F077   36 10                  PSHU   X   
F079   20 AC                  BRA   next   
F07B   31 21        LWF:      LEAY   1,Y   ; x@: the cell's value (little-endian)
F07D   E6 84                  LDB   ,X   
F07F   A6 01                  LDA   1,X   
F081   36 06                  PSHU   D   
F083   20 A2                  BRA   next   
F085   31 21        LWS:      LEAY   1,Y   ; x!: the cell = TOS
F087   37 06                  PULU   D   
F089   E7 84                  STB   ,X   
F08B   A7 01                  STA   1,X   
F08D   20 98                  BRA   next   
F08F                          ENDIF      
F08F                             ; A-Z: call the word. The IP (the address after the letter) goes on the
F08F                             ; return stack, and the IP becomes the address in the letter's cell.
F08F                             ; Checked: a cell still 0 (high byte 0) was never defined, since every
F08F                             ; address in the program's space is 8200h or more. The call has not been
F08F                             ; made yet, so the report shows the stacks as they were.
F08F                          IF   1-FAST   
F08F   8D 0F        UPPER:    BSR   cellx   
F091   E6 84                  LDB   ,X   
F093   A6 01                  LDA   1,X   
F095                          ENDIF      
F095                          IF   CHECKED*(1-FAST)   
                              BEQ   e_undef   
F095                          ENDIF      
F095                          IF   1-FAST   
F095   34 20                  PSHS   Y   
F097   1F 02                  TFR   D,Y   
F099   8D 30                  BSR   pollk   ; the break check, at every word call
F09B   20 8A                  BRA   next   
F09D                          ENDIF      
F09D                             ; =============================================================================
F09D                             ;  Checked build: the error entries.
F09D                             ; 
F09D                             ;  Each entry loads its letter and then hides the next entry inside a 3-byte
F09D                             ;  CMPX # (the 8Ch), so that a run of them falls through to one place. The
F09D                             ;  place an error reports is the address in AT, which the inner loop sets to
F09D                             ;  each character before it runs it; the one error that reports another
F09D                             ;  place (W, at the character after the [) changes AT before it comes.
F09D                             ; 
F09D                             ;  The report counts the return stack from SSAV, which the inner loop sets
F09D                             ;  to S before each character, so an error may come from any depth of
F09D                             ;  calls: a handler, chkst under one, or ctlc under "?" or the break check.
F09D                             ;  (An r sets SSAV to the empty stack.) The inner loop's own entries are
F09D                             ;  here, where its short branches reach them; those reached from a handler
F09D                             ;  are after h_cstore, just ahead of the report.
F09D                             ; =============================================================================
F09D                          IF   CHECKED   
                                 ; ---- reached from the inner loop -------------------------------------------
                                 ; The stack checks branch here with N set for an overflow (the pointer is
                                 ; below its limit) and clear for an underflow. After an underflow that stack
                                 ; counts as empty.
                    E_DS:     BMI   e_S   
                              LDU   #DSTOP   ; s
                              LDA   #"s"   
                              BRA   eall   
                    E_RS:     BMI   e_R   
                              LDX   #RSTOP   ; r
                              STX   <SSAV   
                              LDA   #"r"   
                              FCB   8Ch   
                    E_S:      LDA   #"S"   
                              FCB   8Ch   
                    E_R:      LDA   #"R"   
                              FCB   8Ch   
                    E_RESV:   LDA   #"X"   ; a reserved byte (80h-FFh) outside a string
                              FCB   8Ch   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (from ctlc, at any depth)
                              FCB   8Ch   
                    E_UNDEF:   LDA   #"U"   ; a word never defined (its cell is still 0)
                    EALL:     JMP   error   
F09D                          ENDIF      
F09D   7E FF 09     FIN:      JMP   EXIT   ; the program has ended
F0A0                             ; cellx: A = letter index (0-25, or 32-57 for lowercase) -> X = cell address
F0A0   48           CELLX:    ASLA      
F0A1   8E 82 00               LDX   #LET   
F0A4   30 86                  LEAX   A,X   
F0A6   39                     RTS      
F0A7                             ; isdig: A = the character at IP minus "0"; the carry is set if it is a digit
F0A7   A6 A4        ISDIG:    LDA   ,Y   
F0A9   80 30                  SUBA   #"0"   
F0AB   81 0A                  CMPA   #10   
F0AD   39           AB9:      RTS      
F0AE                             ; rdnum: read decimal digits at IP and push the value; IP is left on the
F0AE                             ; first non-digit. Values wrap at 16 bits, as the spec says. The running
F0AE                             ; value lives in the new top cell: V = V*10 + digit.
F0AE   4F           RDNUM:    CLRA      
F0AF   5F                     CLRB      
F0B0   36 06                  PSHU   D   
F0B2   8D F3        RD1:      BSR   isdig   
F0B4   24 F7                  BHS   ab9   
F0B6   EC C4                  LDD   ,U   
F0B8   58                     ASLB      
F0B9   49                     ROLA      
F0BA   58                     ASLB      
F0BB   49                     ROLA      
F0BC   E3 C4                  ADDD   ,U   ; 5V
F0BE   58                     ASLB      
F0BF   49                     ROLA      ; 10V
F0C0   EB A0                  ADDB   ,Y+   ; and the digit, read again
F0C2   89 00                  ADCA   #0   
F0C4   83 00 30               SUBD   #30h   ; minus "0" (asm80 would put a quoted "0"
F0C7                             ;   in the high byte of a 16-bit operand)
F0C7   ED C4                  STD   ,U   
F0C9   20 E7                  BRA   rd1   
F0CB                             ; =============================================================================
F0CB                             ;  Console layer: the break key. A running program reads the keyboard only
F0CB                             ;  through pollk and getk, which between them give the break key its rules:
F0CB                             ;    - Ctrl-C (03h) stops the program;
F0CB                             ;    - any other key that the break check reads is held in KEYBUF for the
F0CB                             ;      next "?", and a newer one takes its place;
F0CB                             ;    - "?" (getk) takes the held key first;
F0CB                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
F0CB                             ;      key like any other, but two of them within about 250 ms still stop it.
F0CB                             ;  On a break the unchecked build ends without a word (EXIT); the checked
F0CB                             ;  one reports B. All three keep B, X, Y and U.
F0CB                             ; =============================================================================
F0CB                             ; pollk: the break check, at every word call and every true ")" loop-back.
F0CB                             ; It looks at the keyboard only once in 256 calls.
F0CB   0A 35        POLLK:    DEC   <COUNT   
F0CD   26 37                  BNE   cc9   
F0CF   BD FF 06     PK1:      JSR   KEY   ; (the fast build counts down itself)
F0D2   27 32                  BEQ   cc9   ; no key
F0D4   97 34                  STA   <KEYBUF   ; held for the next "?"
F0D6   20 0C                  BRA   ctlc   
F0D8                             ; getk: a key for "?", or A = 0 with the zero flag set if there is none.
F0D8   96 34        GETK:     LDA   <KEYBUF   ; a held key goes first, and is taken out of
F0DA   0F 34                  CLR   <KEYBUF   ;   the buffer (it has been through ctlc)
F0DC   4D                     TSTA      
F0DD   26 27                  BNE   cc9   
F0DF   BD FF 06               JSR   KEY   
F0E2   27 22                  BEQ   cc9   
F0E4                             ; ctlc: a key has been read. If it is Ctrl-C and the break key is on, that
F0E4                             ; is the end. If the program has turned it off, wait about 250 ms for one
F0E4                             ; more key: a second Ctrl-C is the end too; any other key is held (the
F0E4                             ; newest wins), and the Ctrl-C goes on: A = 3, zero flag clear.
F0E4   81 03        CTLC:     CMPA   #3   
F0E6   26 1E                  BNE   cc9   
F0E8   0D 7B                  TST   <BRKOFF   
F0EA   27 B1                  BEQ   brk   
F0EC   34 10                  PSHS   X   
F0EE   8E 13 88               LDX   #250*MSLOOP   
F0F1   BD FF 06     CC1:      JSR   KEY   
F0F4   26 06                  BNE   cc2   
F0F6   30 1F                  LEAX   -1,X   
F0F8   26 F7                  BNE   cc1   
F0FA   20 06                  BRA   cc3   
F0FC   81 03        CC2:      CMPA   #3   
F0FE   27 9D                  BEQ   brk   
F100   97 34                  STA   <KEYBUF   
F102   86 03        CC3:      LDA   #3   
F104   35 10                  PULS   X   
F106   39           CC9:      RTS      
F107                          IF   1-CHECKED   
F107                BRK:      EQU   fin   ; the unchecked build stops without a word;
F107                          ENDIF      
F107                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B (the report
F107                          ENDIF      ;   takes S from SSAV, so the depth of the
F107                             ;   calls here doesn't matter)
F107                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
F107                             ; and return its value in A with the carry set; otherwise leave the IP and
F107                             ; return with the carry clear.
F107                             ; (In the unchecked build it is here, ahead of the table, to leave room in
F107                             ; the two ranges after it; the checked build has it next to the grave, and
F107                             ; so does the unchecked base build, which needs its bytes there instead.)
F107                          IF   (1-CHECKED)*(1-QK)   
                    HEXC:     BSR   isdig   
                              BLO   hv1   ; C = 1
                              ANDA   #0DFh   
                              SUBA   #11h   
                              CMPA   #6   
                              BHS   hv9   ; C = 0
                              SUBA   #0F6h   ; + 10, and sets the carry
                    HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
                    HV9:      RTS      
F107                          ENDIF      
F107                             ; =============================================================================
F107                             ;  Dispatch table, in code order.
F107                             ; 
F107                             ;  Unchecked build: one byte per character, the low byte of the handler's
F107                             ;  distance from PTAB. NPG1 is how many characters, from the start, have
F107                             ;  handlers more than 255 bytes past PTAB. ] \ [ @ ? sit where the two ranges
F107                             ;  meet (in falling code order for this), and which side each lands on is
F107                             ;  worked out here. (One division to a line: asm80 only rounds down when it
F107                             ;  stores a value.)
F107                             ; 
F107                             ;  Checked build: it has more code than the two ranges hold, so its table
F107                             ;  holds whole addresses and there are no rules about where handlers go.
F107                             ; 
F107                             ;  The unchecked base build keeps to the same rules: its skip and udiv are
F107                             ;  out in the tail, and hexc comes into the first range, where the checked
F107                             ;  build has it. The fast build has no PTAB (see "The fast build").
F107                             ; =============================================================================
F107                          IF   (1-CHECKED)*(1-FAST)   
F107                PGRET:    EQU   (h_ret-PTAB)/256   ; 0 = first range, 1 = second
F107                PGBRK:    EQU   (h_break-PTAB)/256   
F107                PGDEF:    EQU   (h_def-PTAB)/256   
F107                PGFET:    EQU   (h_fetch-PTAB)/256   
F107                PGKEY:    EQU   (h_key-PTAB)/256   
F107                NPG1:     EQU   20 + PGKEY + PGFET + PGDEF + PGBRK + PGRET   
F107                          ENDIF      
F107                PTAB:        
F107                          IF   (1-CHECKED)*(1-FAST)   
F107   9D                     FCB   (h_store-PTAB) & 0FFh   ; !
F108   12                     FCB   (h_str-PTAB) & 0FFh   ; "
F109   AB                     FCB   (h_num-PTAB) & 0FFh   ; #
F10A   F0                     FCB   (h_print-PTAB) & 0FFh   ; $
F10B   70                     FCB   (h_swap-PTAB) & 0FFh   ; %
F10C   83                     FCB   (h_and-PTAB) & 0FFh   ; &
F10D   7C                     FCB   (h_emit-PTAB) & 0FFh   ; '
F10E   06                     FCB   (h_open-PTAB) & 0FFh   ; (
F10F   2A                     FCB   (h_close-PTAB) & 0FFh   ; )
F110   36                     FCB   (h_mul-PTAB) & 0FFh   ; *
F111   8B                     FCB   (h_add-PTAB) & 0FFh   ; +
F112   22                     FCB   (h_cfetch-PTAB) & 0FFh   ; ,
F113   92                     FCB   (h_sub-PTAB) & 0FFh   ; -
F114   A4                     FCB   (h_cstore-PTAB) & 0FFh   ; .
F115   CF                     FCB   (h_div-PTAB) & 0FFh   ; /
F116   77                     FCB   (h_dup-PTAB) & 0FFh   ; :
F117   80                     FCB   (h_drop-PTAB) & 0FFh   ; ;
F118   58                     FCB   (h_lt-PTAB) & 0FFh   ; <
F119   64                     FCB   (h_eq-PTAB) & 0FFh   ; =
F11A   56                     FCB   (h_gt-PTAB) & 0FFh   ; >
F11B   B8                     FCB   (h_key-PTAB) & 0FFh   ; ?
F11C   B2                     FCB   (h_fetch-PTAB) & 0FFh   ; @
F11D   97                     FCB   (h_def-PTAB) & 0FFh   ; [
F11E   89                     FCB   (h_break-PTAB) & 0FFh   ; \
F11F   85                     FCB   (h_ret-PTAB) & 0FFh   ; ]
F120   28                     FCB   (h_xor-PTAB) & 0FFh   ; ^
F121   44                     FCB   (h_alloc-PTAB) & 0FFh   ; _
F122   53                     FCB   (h_grave-PTAB) & 0FFh   ; `
F123   36                     FCB   (h_tor-PTAB) & 0FFh   ; {
F124   20                     FCB   (h_or-PTAB) & 0FFh   ; |
F125   3E                     FCB   (h_fromr-PTAB) & 0FFh   ; }
F126   31                     FCB   (h_not-PTAB) & 0FFh   ; ~
F127                          ENDIF      
F127                          IF   CHECKED*(1-FAST)   
                              FDB   h_store   ; !
                              FDB   h_str   ; "
                              FDB   h_num   ; #
                              FDB   h_print   ; $
                              FDB   h_swap   ; %
                              FDB   h_and   ; &
                              FDB   h_emit   ; '
                              FDB   h_open   ; (
                              FDB   h_close   ; )
                              FDB   h_mul   ; *
                              FDB   h_add   ; +
                              FDB   h_cfetch   ; ,
                              FDB   h_sub   ; -
                              FDB   h_cstore   ; .
                              FDB   h_div   ; /
                              FDB   h_dup   ; :
                              FDB   h_drop   ; ;
                              FDB   h_lt   ; <
                              FDB   h_eq   ; =
                              FDB   h_gt   ; >
                              FDB   h_key   ; ?
                              FDB   h_fetch   ; @
                              FDB   h_def   ; [
                              FDB   h_break   ; \
                              FDB   h_ret   ; ]
                              FDB   h_xor   ; ^
                              FDB   h_alloc   ; _
                              FDB   h_grave   ; `
                              FDB   h_tor   ; {
                              FDB   h_or   ; |
                              FDB   h_fromr   ; }
                              FDB   h_not   ; ~
F127                          ENDIF      
F127                PTABEND:      
F127                             ; =============================================================================
F127                             ;  Handlers that must start in the first range (within 255 bytes of PTAB)
F127                             ;  in the unchecked build: ^ _ ` 00bbIHwg ~
F127                             ; =============================================================================
F127   EC C1        H_OR:     LDD   ,U++   
F129   AA C4                  ORA   ,U   
F12B   EA 41                  ORB   1,U   
F12D   20 06                  BRA   st0   
F12F   EC C1        H_XOR:    LDD   ,U++   
F131   A8 C4                  EORA   ,U   
F133   E8 41                  EORB   1,U   
F135   ED C4        ST0:      STD   ,U   
F137   39                     RTS      
F138   63 C4        H_NOT:    COM   ,U   
F13A   63 41                  COM   1,U   
F13C   39                     RTS      
F13D                             ; "{" ( n -- ) R: ( -- n )     The dispatcher's return address comes off the
F13D                             ; return stack first (PULS X) and is jumped to at the end.
F13D   35 10        H_TOR:    PULS   X   
F13F   37 06                  PULU   D   
F141   34 06                  PSHS   D   
F143   6E 84                  JMP   ,X   
F145                             ; "}" ( -- n ) R: ( n -- )    The dispatcher's return address comes off
F145                             ; into D and the entry under it into X; D is then jumped to.
F145   35 16        H_FROMR:   PULS   D,X   
F147   36 10                  PSHU   X   
F149   1F 05                  TFR   D,PC   
F14B                             ; "_" ( n -- addr ): the heap pointer moves by n (signed: a 16-bit add);
F14B                             ; TOS is the old pointer.
F14B                             ; Checked: the new top must be at least the program's end (PEND) and below
F14B                             ; the limit page. That also catches an add that wraps: the top is always
F14B                             ; 8301h-EFFFh and n is -32768..32767, so a sum that carries past FFFFh
F14B                             ; lands below 7000h, and one that borrows can't happen.
F14B   D6 7C        H_ALLOC:   LDB   <HEAP   
F14D   96 7D                  LDA   <HEAP+1   
F14F   1F 01                  TFR   D,X   ; the old pointer
F151   E3 C4                  ADDD   ,U   
F153                          IF   CHECKED   
                              CMPD   <PEND   
                              BLO   ah9   ; below the program's end
                              CMPA   #HEAPLIM   
                              BLO   ah1   ; the new top must stay below the limit page
                    AH9:      LDA   #"H"   
                              BRA   ejmp   ; (with [ below)
                    AH1:         
F153                          ENDIF      
F153   D7 7C                  STB   <HEAP   
F155   97 7D                  STA   <HEAP+1   
F157   AF C4                  STX   ,U   
F159   39                     RTS      
F15A                             ; ---- machine code: the grave -----------------------------------------------
F15A                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
F15A                             ; are stored from addr until a non-hex character; then a RTS (39h) is
F15A                             ; written and its address is left. An odd last digit is consumed and dropped.
F15A                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
F15A                             ; code is entered by JSR (the dispatcher's own), with the address already
F15A                             ; popped: U points at the top data cell (big-endian, 2 bytes, stack grows
F15A                             ; down) and the return address is on top of S. The code may pop and push
F15A                             ; data cells by changing U; on return the cell at ,U is the new TOS. It must
F15A                             ; keep Y (the interpreter's reading position), DP and S (balanced), and
F15A                             ; return with RTS. A, B, X, CC may change.
F15A                             ; Neither the loader's stores nor the code are checked, in either build.
F15A   8D 1E        H_GRAVE:   BSR   hexc   ; the digit after the grave, if any
F15C   24 1A                  BCC   exec   
F15E   AE C4                  LDX   ,U   
F160   C6 10        HX1:      LDB   #16   
F162   3D                     MUL      ; B = the digit, moved up to the high half
F163   E7 84                  STB   ,X   ; (an odd digit is overwritten by the RTS)
F165   8D 13                  BSR   hexc   
F167   24 08                  BCC   hx2   ; odd digit: already consumed, dropped
F169   AA 84                  ORA   ,X   
F16B   A7 80                  STA   ,X+   
F16D   8D 0B                  BSR   hexc   
F16F   25 EF                  BCS   hx1   
F171   86 39        HX2:      LDA   #39h   ; RTS
F173   A7 84                  STA   ,X   
F175   AF C4                  STX   ,U   
F177   39                     RTS      
F178   37 80        EXEC:     PULU   PC   ; jump to it: the code's RTS returns to the
F17A                             ;   dispatcher
F17A                          IF   CHECKED+QK   
F17A   BD F0 A7     HEXC:     JSR   isdig   
F17D   25 0A                  BLO   hv1   ; C = 1
F17F   84 DF                  ANDA   #0DFh   
F181   80 11                  SUBA   #11h   
F183   81 06                  CMPA   #6   
F185   24 04                  BHS   hv9   ; C = 0
F187   80 F6                  SUBA   #0F6h   ; + 10, and sets the carry
F189   31 21        HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
F18B   39           HV9:      RTS      
F18C                          ENDIF      
F18C                             ; ---- where the two ranges meet ---------------------------------------------
F18C                             ; The first range ends somewhere among the next five handlers, ] \ [ @ ?
F18C                             ; (they are in falling code order for this): NPG1 follows. Every handler
F18C                             ; below them must start in the second range, and every one above in the
F18C                             ; first.
F18C                             ; "]" returns: pop an address and jump to it. (PULS X,Y: the dispatcher's
F18C                             ; return address into X, then the saved IP into Y.)
F18C   35 30        H_RET:    PULS   X,Y   
F18E   6E 84                  JMP   ,X   
F190                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F190                             ; drops the block start, "]" returns. No closer at all ends the program.
F190   EC C1        H_BREAK:   LDD   ,U++   
F192                          IF   1-QK   
                              BEQ   sk9   ; false: nothing to do
                              BSR   skip   
F192                          ENDIF      
F192                          IF   QK   
F192   27 F7                  BEQ   hv9   ; false: nothing to do (hexc's RTS)
F194   BD F3 6F               JSR   skip   ; (base: in the tail, with its cache)
F197                          ENDIF      
F197   4D                     TSTA      ; skip returns 0 for ")"
F198                          IF   CHECKED   
                              LBMI   fin   ; (and FFh for the NUL: the program ends)
F198                          ENDIF      
F198   26 F2                  BNE   h_ret   
F19A   35 16        RDROP:    PULS   D,X   ; the return address and the block start
F19C   1F 05                  TFR   D,PC   ; back to the dispatcher
F19E                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F19E                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F19E                             ; the body"s address instead. Either way it then skips to the matching "]'.
F19E                             ; (The unchecked build takes anything that is not a letter as the space; the
F19E                             ; checked build stops on it.)
F19E                          IF   CHECKED   
                    DEF1:     CMPA   #" "-"A"+256   
                              BEQ   def2   
                              LEAY   -1,Y   ; anything but a letter or a space: W. The
                              STY   <AT   ;   place is that character, just read
                              LDA   #"W"   
                    EJMP:     JMP   error   ; (H and N come here too)
F19E                          ENDIF      
F19E   A6 A0        H_DEF:    LDA   ,Y+   
F1A0   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
F1A2   1F 89                  TFR   A,B   ;   lands 64 bytes up
F1A4   C4 DF                  ANDB   #0DFh   ; fold case
F1A6   C1 1A                  CMPB   #26   
F1A8                          IF   1-CHECKED   
F1A8   24 0A                  BHS   def2   ; not a letter
F1AA                          ENDIF      
F1AA                          IF   CHECKED   
                              BHS   def1   
F1AA                          ENDIF      
F1AA   BD F0 A0               JSR   cellx   
F1AD   1F 20                  TFR   Y,D   
F1AF   E7 84                  STB   ,X   ; little-endian
F1B1   A7 01                  STA   1,X   
F1B3   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F1B4   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F1B6                          IF   (1-CHECKED)*(1-QK)   
                                 ; fall into skip
F1B6                          ENDIF      
F1B6                          IF   QK*(1-CHECKED)   
F1B6   7E F3 6F               JMP   skip   ; (base: in the tail, with its cache)
F1B9                          ENDIF      
F1B9                          IF   CHECKED   
                                 ; Checked: the skip must end at a "]" (A = 2), or for a false "(",
                                 ; which comes to opf, at a ")" (A = 0). Anything else stops with N.
F1B9                          ENDIF      
F1B9                          IF   CHECKED*(1-QK)   
                              BSR   skip   
                              SUBA   #2   
                              FCB   8Ch   ; (CMPX #: steps over the BSR)
                    OPF:      BSR   skip   
                              TSTA      
                              BEQ   sk9   ; (an RTS)
                              LDA   #"N"   
                              BRA   ejmp   
F1B9                          ENDIF      
F1B9                          IF   CHECKED*QK   
                              JSR   skip   ; (base: in the tail, with its cache)
                              SUBA   #2   
                              BRA   of1   
                    OPF:      JSR   skip   
                    OF1:      TSTA      
                              BEQ   hv9   ; (an RTS: hexc's)
                              LDA   #"N"   
                              BRA   ejmp   
F1B9                          ENDIF      
F1B9                             ; skip: read past text to the closer at this level, and return A = 0 if it
F1B9                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F1B9                             ; strings are stepped over whole. B counts the open levels.
F1B9                             ; Unchecked: a NUL first ends the program (for "\" with no closer; anything
F1B9                             ; else that runs into the NUL had unbalanced brackets anyway).
F1B9                             ; Checked: a NUL, or a string that runs into it, returns A = FFh, and the
F1B9                             ; caller decides: "\" ends the program, "(" and "[" stop with N, as they do
F1B9                             ; for a closer of the other kind. The place is the opener, still in AT.
F1B9                             ; (base has its own, with the skip cache, in the tail: see "Speed-ups".)
F1B9                          IF   1-QK   
                    SKIP:     CLRB      
                    SK1:      LDA   ,Y+   
F1B9                          ENDIF      
F1B9                          IF   (1-CHECKED)*(1-QK)   
                              LBEQ   fin   
F1B9                          ENDIF      
F1B9                          IF   CHECKED*(1-QK)   
                              BEQ   ssn   ; A = FFh
F1B9                          ENDIF      
F1B9                          IF   1-QK   
                              CMPA   #22h   
                              BNE   sk2   
                              BSR   skipstr   ; leaves A = 22h, which matches nothing below
F1B9                          ENDIF      
F1B9                          IF   CHECKED*(1-QK)   
                              BCS   sk9   ; (or FFh, with the carry set: unclosed)
F1B9                          ENDIF      
F1B9                          IF   1-QK   
                    SK2:      SUBA   #"("   
                              BEQ   sk3   
                              DECA      ; ")"
                              BEQ   sk4   
                              SUBA   #"["-")"   
                              BEQ   sk3   
                              CMPA   #"]"-"["   
                              BNE   sk1   
                    SK4:      DECB      
                              BPL   sk1   
                    SK9:      RTS      ; the closer at this level
                    SK3:      INCB      
                              BRA   sk1   
F1B9                          ENDIF      
F1B9                             ; 22h, checked build (the unchecked one is with the handlers below).
F1B9                             ; Checked: a NUL ends the string too, even right after a "/"; skipstr then
F1B9                             ; returns A = FFh with the carry set (the carry is clear at the quote), and
F1B9                             ; """ stops with Q, the string's address already pushed. (skip comes here
F1B9                             ; for its own NUL as well.)
F1B9                          IF   CHECKED   
                    H_STR:    PSHU   Y   
                              BSR   skipstr   
                              LBCS   e_quote   
                              RTS      
                    SS0:      LDA   ,Y+   ; the character after the "/"
                              BEQ   ssn   
                    SKIPSTR:   LDA   ,Y+   
                              BEQ   ssn   
                              CMPA   #"/"   
                              BEQ   ss0   
                              CMPA   #22h   
                              BNE   skipstr   
                              RTS      ; the quote: C = 0
                    SSN:      SUBA   #1   ; the NUL: A = FFh, C = 1
                              RTS      
F1B9                          ENDIF      
F1B9   AE C4        H_FETCH:   LDX   ,U   ; "@" (the cell in memory is little-endian)
F1BB   A6 01                  LDA   1,X   
F1BD   20 6D                  BRA   cf1   
F1BF                             ; "?" ( n -- c ) or ( -n -- addr )
F1BF                             ;   n > 0: wait about n ms for a key; 0 if none came
F1BF                             ;   n = 0: wait for a key
F1BF                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
F1BF                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
F1BF   AE C4        H_KEY:    LDX   ,U   
F1C1   2B 17                  BMI   line   
F1C3   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F1C5   BD F0 D8     KT2:      JSR   getk   
F1C8   26 0B                  BNE   kt3   
F1CA   5A                     DECB      
F1CB   26 F8                  BNE   kt2   
F1CD   30 1F                  LEAX   -1,X   
F1CF   26 F2                  BNE   kt1   ; A = 0 if the time ran out
F1D1   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F1D3   27 EE                  BEQ   kt1   ;   run it again, until a key comes
F1D5   6F C4        KT3:      CLR   ,U   
F1D7   A7 41                  STA   1,U   
F1D9   39                     RTS      
F1DA                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F1DA                             ; (stored, not echoed), every other key is stored and echoed until the line
F1DA                             ; is full. B = the length so far; the low byte of the top cell becomes the
F1DA                             ; most allowed (it holds minus the count on entry).
F1DA   8C FF 81     LINE:     CMPX   #-127   ; (X = TOS, minus the count)
F1DD   24 04                  BHS   ln1   
F1DF   86 81                  LDA   #-127   ; more than 127 is taken as 127
F1E1   A7 41                  STA   1,U   
F1E3   60 41        LN1:      NEG   1,U   
F1E5   8E 82 80               LDX   #LINEBUF   
F1E8   5F                     CLRB      
F1E9   BD F0 D8     LN2:      JSR   getk   
F1EC   27 FB                  BEQ   ln2   
F1EE   81 0D                  CMPA   #13   
F1F0   27 16                  BEQ   ln5   
F1F2   81 08                  CMPA   #8   
F1F4   27 0C                  BEQ   ln4   
F1F6   E1 41                  CMPB   1,U   
F1F8   24 EF                  BHS   ln2   ; full
F1FA   A7 85                  STA   B,X   
F1FC   5C                     INCB      
F1FD   BD FF 03     LN3:      JSR   CONOUT   
F200   20 E7                  BRA   ln2   
F202   5D           LN4:      TSTB      ; Backspace: nothing to take back?
F203   27 E4                  BEQ   ln2   
F205   5A                     DECB      
F206   20 F5                  BRA   ln3   ; echo it
F208   A7 85        LN5:      STA   B,X   ; A = 13
F20A   AF C4                  STX   ,U   
F20C   39                     RTS      
F20D                             ; =============================================================================
F20D                             ;  Handlers that must start in the second range (unchecked build).
F20D                             ; =============================================================================
F20D                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
F20D                             ; the matching ")".
F20D   EC C1        H_OPEN:   LDD   ,U++   
F20F                          IF   (1-CHECKED)*(1-QK)   
                              BEQ   skip   ; tail call: skip ends in RTS
F20F                          ENDIF      
