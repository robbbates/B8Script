E303   85 04                  STA   T0   
E305   AD 7D 04               LDA   HEAP+1   
E308   49 80                  EOR   #80h   
E30A   75 01                  ADC   1,X   
E30C   70 25                  BVS   e_heap   ; wrapped
E30E   49 80                  EOR   #80h   ; the new top's high byte
E310   C9 E0                  CMP   #HEAPLIM   
E312   B0 1F                  BCS   e_heap   ; at or past the limit
E314   A8                     TAY      
E315   A5 04                  LDA   T0   
E317   CD 38 04               CMP   PEND   
E31A   98                     TYA      
E31B   ED 39 04               SBC   PEND+1   
E31E   90 13                  BCC   e_heap   ; below the program's end
E320   AD 7C 04               LDA   HEAP   
E323   95 00                  STA   0,X   
E325   A5 04                  LDA   T0   
E327   8D 7C 04               STA   HEAP   
E32A   AD 7D 04               LDA   HEAP+1   
E32D   95 01                  STA   1,X   
E32F   8C 7D 04               STY   HEAP+1   
E332   60                     RTS      
E333                             ; Errors found by handlers. The stacks are as they were before the handler.
E333   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E335   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E336   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E338   4C 92 E5               JMP   error   
E33B                             ; chkst: stop unless the address in the top cell is in the program's own
E33B                             ; space, from the letter page up to the heap limit. Keeps A and Y.
E33B   48           CHKST:    PHA      
