0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                PRSUB:    EQU   CHECKED   ; (1: "$" is the routine prstr)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-CPM*EDITOR*(1-CHECKED)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; HL'; CONCLS, CONEOL and CONCUR also DE and HL.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 AF 04               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 F4 04     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 B7 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 88 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 5D                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 5F                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 51                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 B4 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 2A        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE 40                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0072                          ENDIF      
0072                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0072                          ENDIF      
0072                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0072                          ENDIF      ;   these)
0072                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0072                          ENDIF      
0072                             ; In the unchecked generic editor build the table is here, in the first
0072                             ; page, which saves loading D twice. (The other builds have no room for it
0072                             ; here: theirs is further down.)
0072                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0072                          ENDIF      
0072                             ; =============================================================================
0072                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0072                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0072                             ;  is here too: it belongs to "`" and makes the page come out right.
0072                             ; =============================================================================
0072   D1           H_XOR:    POP   DE   
0073   7C                     LD   A,H   
0074   AA                     XOR   D   
0075   67                     LD   H,A   
0076   7D                     LD   A,L   
0077   AB                     XOR   E   
0078   6F                     LD   L,A   
0079   F7                     RST   30h   
007A   D1           H_OR:     POP   DE   
007B   7C                     LD   A,H   
007C   B2                     OR   D   
007D   67                     LD   H,A   
007E   7D                     LD   A,L   
007F   B3                     OR   E   
0080   6F                     LD   L,A   
0081   F7                     RST   30h   
0082   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0083   2B                     DEC   HL   
0084   F7                     RST   30h   
0085                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0085                             ; the same either way); TOS is the old pointer.
0085   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0089                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0089                          ENDIF      
0089   19                     ADD   HL,DE   ; the new top
008A                          IF   CHECKED   
008A   CD BE 03               CALL   chkhp   
008D                          ENDIF      
008D   22 7C 82               LD   (HEAP),HL   
0090   EB                     EX   DE,HL   
0091   F7                     RST   30h   
0092   D9           EXEC:     EXX      
0093   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
0096   D9                     EXX      
0097   CD 2B 00               CALL   jphl   
009A   D9                     EXX      
009B   2A 34 82               LD   HL,(RSAVE)   
009E   D9                     EXX      
009F   E1                     POP   HL   
00A0   F7                     RST   30h   
00A1                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00A1                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00A1                             ; Digits: step back onto the first digit and read the whole number.
00A1   E5           DIGIT:    PUSH   HL   
00A2   0B                     DEC   BC   
00A3   CD 9A 02               CALL   rdnum   
00A6   F7                     RST   30h   
00A7                             ; a-z: push the cell's address (the cell is the variable)
00A7   E5           LOWER:    PUSH   HL   
00A8   87                     ADD   A,A   
00A9   6F                     LD   L,A   
00AA   26 82                  LD   H,LETPAGE   
00AC   F7                     RST   30h   
00AD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00AD                             ; the return stack, and the IP becomes the address in the letter's cell.
00AD   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00AE   EB                     EX   DE,HL   ; park TOS
00AF   87                     ADD   A,A   
00B0   6F                     LD   L,A   
00B1   26 82                  LD   H,LETPAGE   ; HL -> cell
00B3   4E                     LD   C,(HL)   
00B4   2C                     INC   L   
00B5   46                     LD   B,(HL)   ; IP = the word's body
00B6   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B7                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B7                             ; stack, then next. Everything that pushes the return stack ends here.
00B7                             ; 
00B7                             ; The break key is looked at here, so at every word call and loop-back (and
00B7                             ; block entry and "{"), but only one time in 256: B', which nothing else
00B7                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00B7                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00B7                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00B7                             ; both ways out.)
00B7   D9           RPUSHN:   EXX      
00B8   D1                     POP   DE   
00B9   2B                     DEC   HL   
00BA   72                     LD   (HL),D   
00BB   2B                     DEC   HL   
00BC   73                     LD   (HL),E   
00BD   05                     DEC   B   
00BE   D9                     EXX      
00BF   CC 4A 03               CALL   Z,pollk   
00C2   F7                     RST   30h   
00C3                             ; ---- machine code: the grave -----------------------------------------------
00C3                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00C3                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00C3                             ; written and its address is left. An odd last digit is consumed and dropped.
00C3                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00C3                             ; code is entered by CALL with the data stack above the return address; it
00C3                             ; must keep BC, and on return the top cell becomes the new TOS.
00C3   CD FE 02     H_GRAVE:   CALL   hexc   
00C6   30 CA                  JR   NC,exec   
00C8   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00C9   CD FE 02               CALL   hexc   
00CC   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00CE   ED 6F                  RLD      ;   overwrites it
00D0   23                     INC   HL   ; ... and RLD shifts it up under the low one
00D1   CD FE 02               CALL   hexc   
00D4   38 F2                  JR   C,hx1   
00D6   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00D8   F7                     RST   30h   
00D9                             ; ---- where the two pages meet ----------------------------------------------
00D9                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00D9                             ; are in falling code order for this), and where exactly differs between the
00D9                             ; builds: NPG1 follows. Every handler below these four must start in the
00D9                             ; second page, and every one above in the first; chktab.py checks both.
00D9                             ; "]" returns: pop an address and jump to it.
00D9   CF           H_RET:    RST   08h   
00DA   42                     LD   B,D   
00DB   4B                     LD   C,E   
00DC   F7           BRK1:     RST   30h   
00DD                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00DD                             ; drops the block start, "]" returns. No closer at all ends the program.
00DD   7C           H_BREAK:   LD   A,H   
00DE   B5                     OR   L   
00DF   E1                     POP   HL   
00E0   28 FA                  JR   Z,brk1   
00E2   CD C1 02               CALL   skip   
00E5   B7                     OR   A   ; skip returns 0 for ")"
00E6   20 F1                  JR   NZ,h_ret   
00E8   CF           RDROP:    RST   08h   
00E9   F7                     RST   30h   
00EA                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00EA                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00EA                             ; the body"s address instead. Either way it then skips to the matching "]'.
00EA                             ; (The unchecked build takes anything that is not a letter as the space; the
00EA                             ; checked build stops on it.)
00EA   0A           H_DEF:    LD   A,(BC)   
00EB   03                     INC   BC   
00EC   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00EE   5F                     LD   E,A   ;   lands 64 bytes up
00EF   E6 DF                  AND   0DFh   ; fold case
00F1   FE 1A                  CP   26   
00F3   30 0B                  JR   NC,def2   ; not a letter
00F5   CB 23                  SLA   E   
00F7   16 82                  LD   D,LETPAGE   ; DE -> cell
00F9   79                     LD   A,C   
00FA   12                     LD   (DE),A   
00FB   1C                     INC   E   
00FC   78                     LD   A,B   
00FD   12                     LD   (DE),A   
00FE   18 09                  JR   skipnx   
0100                DEF2:        
0100                          IF   CHECKED   
0100   7B                     LD   A,E   
0101   FE DF                  CP   " "-"A"+256   
0103   C2 F0 03               JP   NZ,e_brack   ; anything but a letter or a space
0106                          ENDIF      
0106   E5                     PUSH   HL   ; an anonymous block: push its address
0107   60                     LD   H,B   
0108   69                     LD   L,C   
0109                SKIPNX:      
0109                          IF   CHECKED   
0109   0B                     DEC   BC   ; back onto the letter, so that skip finds its
010A                          ENDIF      ;   opener, the "[", just before where it starts
010A   CD C1 02     SKIPO:    CALL   skip   
010D   F7                     RST   30h   
010E   5E           H_FETCH:   LD   E,(HL)   ; "@"
010F   23                     INC   HL   
0110   56                     LD   D,(HL)   
0111   EB                     EX   DE,HL   
0112   F7                     RST   30h   
0113                             ; =============================================================================
0113                             ;  Handlers that must start in the image's second page.
0113                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0113                             ;  page.
0113                             ; =============================================================================
0113                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0113                             ; the matching ")".
0113   7C           H_OPEN:   LD   A,H   
0114   B5                     OR   L   
0115   E1                     POP   HL   
0116   28 F2                  JR   Z,skipo   
0118   C5                     PUSH   BC   ; the block starts at the IP
0119   18 9C                  JR   rpushn   
011B                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
011B                             ; drops it and carries on.
011B   7C           H_CLOSE:   LD   A,H   
011C   B5                     OR   L   
011D   E1                     POP   HL   
011E   28 C8                  JR   Z,rdrop   
0120   CF                     RST   08h   ; pop the block start ...
0121   42                     LD   B,D   
0122   4B                     LD   C,E   
0123   C5                     PUSH   BC   
0124   18 91                  JR   rpushn   ; ... and push it back
0126                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0126                             ; "-" has two jobs: directly before a digit it starts a negative number.
0126   0A           H_SUB:    LD   A,(BC)   
0127   D6 30                  SUB   "0"   
0129   FE 0A                  CP   10   
012B   38 04                  JR   C,negnum   
012D   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
012E   D1           H_ADD:    POP   DE   
012F   19                     ADD   HL,DE   
0130   F7                     RST   30h   
0131   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0132   CD 9A 02               CALL   rdnum   
0135   E7                     RST   20h   
0136   F7                     RST   30h   
0137   D1           H_AND:    POP   DE   
0138   7C                     LD   A,H   
0139   A2                     AND   D   
013A   67                     LD   H,A   
013B   7D                     LD   A,L   
013C   A3                     AND   E   
013D   6F                     LD   L,A   
013E   F7                     RST   30h   
013F                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
013F                             ; cells first. Flipping both sign bits turns a signed compare into an
013F                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
013F                             ; carry into -1 or 0 with no branch.
013F   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0140   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0141   7C                     LD   A,H   
0142   EE 80                  XOR   80h   
0144   67                     LD   H,A   
0145   7A                     LD   A,D   
0146   EE 80                  XOR   80h   
0148   57                     LD   D,A   
0149   ED 52                  SBC   HL,DE   ; carry if HL < DE
014B   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
014D   F7                     RST   30h   
014E   D1           H_EQ:     POP   DE   
014F   B7                     OR   A   
0150   ED 52                  SBC   HL,DE   
0152   7C                     LD   A,H   
0153   B5                     OR   L   
0154   FE 01                  CP   1   ; carry only if a - b = 0
0156   18 F3                  JR   tf   
0158                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0158                             ; multiplier shifts up through A:C.
0158   D1           H_MUL:    POP   DE   ; DE = multiplicand
0159   C5                     PUSH   BC   
015A   7C                     LD   A,H   
015B   4D                     LD   C,L   ; A:C = multiplier
015C   21 00 00               LD   HL,0   
015F   06 10                  LD   B,16   
0161   29           MUL1:     ADD   HL,HL   
0162   CB 21                  SLA   C   
0164   17                     RLA      
0165   30 01                  JR   NC,mul2   
0167   19                     ADD   HL,DE   
0168   10 F7        MUL2:     DJNZ   mul1   
016A   C1                     POP   BC   
016B   F7                     RST   30h   
016C                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
016C                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
016C                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
016C                             ; stops on it.
016C                H_DIV:       
016C                          IF   CHECKED   
016C   7C                     LD   A,H   
016D   B5                     OR   L   
016E   CA ED 03               JP   Z,e_zero   
0171                          ENDIF      
0171   D1                     POP   DE   ; DE = a, HL = b
0172   D5                     PUSH   DE   ; a, for r's sign
0173   7A                     LD   A,D   
0174   AC                     XOR   H   
0175   F5                     PUSH   AF   ; S flag = sign of q
0176   CB 7C                  BIT   7,H   
0178   C4 20 00               CALL   NZ,neg16   ; HL = |b|
017B   EB                     EX   DE,HL   
017C   CB 7C                  BIT   7,H   
017E   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0181   CD 72 02               CALL   udiv   ; HL = q, DE = r
0184   F1                     POP   AF   
0185   FC 20 00               CALL   M,neg16   ; q's sign
0188   EB                     EX   DE,HL   ; HL = r, DE = q
0189   F1                     POP   AF   ; A = a's high byte
018A   B7                     OR   A   
018B   FC 20 00               CALL   M,neg16   ; r's sign
018E   D5                     PUSH   DE   ; q under r
018F   F7                     RST   30h   
0190                             ; ---- stack and storage -----------------------------------------------------
0190   E5           H_DUP:    PUSH   HL   ; ":"
0191   F7                     RST   30h   
0192   E3           H_SWAP:   EX   (SP),HL   ; "%"
0193   F7                     RST   30h   
0194                             ; (The checked build tests the address before it takes the value off the
0194                             ; stack, so that an error report shows both.)
0194                H_CSTORE:      ; "." ( c addr -- )
0194                          IF   CHECKED   
0194   CD D3 03               CALL   chkst   
0197                          ENDIF      
0197   D1                     POP   DE   
0198   73                     LD   (HL),E   
0199   DF           H_DROP:   RST   18h   ; ";" is this one byte
019A                H_STORE:      ; "!" ( n addr -- )
019A                          IF   CHECKED   
019A   CD D3 03               CALL   chkst   
019D                          ENDIF      
019D   D1                     POP   DE   
019E   73                     LD   (HL),E   
019F   23                     INC   HL   
01A0   72                     LD   (HL),D   
01A1   DF                     RST   18h   
01A2                             ; ---- console ---------------------------------------------------------------
01A2                             ; 22h pushes the address of the text after it and skips the string.
01A2   E5           H_STR:    PUSH   HL   
01A3   60                     LD   H,B   
01A4   69                     LD   L,C   
01A5   CD B0 02               CALL   skipstr   
01A8                          IF   CHECKED   
01A8   B7                     OR   A   ; 0: the text ran out before the closing quote
01A9   CA E5 03               JP   Z,e_quote   
01AC                          ENDIF      
01AC   F7                     RST   30h   
01AD                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01AD                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01AD                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
01AD                             ; no bit 6, so // and /" give themselves).
01AD                          IF   1-PRSUB   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01AD                          ENDIF      
01AD                          IF   CHECKED   
01AD                             ; (The checked build has the loop as a routine, prstr, which the error
01AD                             ; report uses too. The address is kept meanwhile, for a report: it shows
01AD                             ; the stack as it was before the "$". /~ comes back to hp1.)
01AD   22 34 82     H_PRINT:   LD   (RSAVE),HL   
01B0   CD 06 02     HP1:      CALL   prstr   
01B3   DF                     RST   18h   
01B4                          ENDIF      
01B4   7D           H_EMIT:   LD   A,L   ; "'"
01B5   EF                     RST   28h   
01B6   DF           PR9:      RST   18h   
01B7                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B7   CD 10 03     H_NUM:    CALL   psgn   
01BA   DF                     RST   18h   
01BB                             ; "?" ( n -- c ) or ( -n -- addr )
01BB                             ;   n > 0: wait about n ms for a key; 0 if none came
01BB                             ;   n = 0: wait for a key
01BB                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BB                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BB   CB 7C        H_KEY:    BIT   7,H   
01BD   20 19                  JR   NZ,line   
01BF   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C1   CD 78 03     KT2:      CALL   getk   
01C4   20 0E                  JR   NZ,kt3   
01C6   1D                     DEC   E   
01C7   20 F8                  JR   NZ,kt2   
01C9   7C                     LD   A,H   ; 0? never counts down: it waits
01CA   B5                     OR   L   
01CB   28 F2                  JR   Z,kt1   
01CD   2B                     DEC   HL   
01CE   7C                     LD   A,H   
01CF   B5                     OR   L   
01D0   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01D2   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01D3   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01D4   6F           KT3:      LD   L,A   
01D5   26 00                  LD   H,0   
01D7   F7                     RST   30h   
01D8                             ; Backspace takes the last character back (and is echoed as
01D8                             ; it is), CR ends (stored, not echoed), every other key is stored and
01D8                             ; echoed until the line is full. The line buffer starts at offset 80h
01D8                             ; of its page, so L alone is the place in the line: D holds the L of
01D8                             ; a full line.
01D8   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01DB   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01DC   9F                     SBC   A,A   
01DD   A5                     AND   L   ; (0 for a count that is too big)
01DE   2F                     CPL      
01DF   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E0                             ;   at most
01E0   21 80 82               LD   HL,LINEBUF   
01E3   CD 78 03     LN2:      CALL   getk   
01E6   28 FB                  JR   Z,ln2   
01E8   FE 0D                  CP   13   
01EA   28 16                  JR   Z,ln5   
01EC   FE 08                  CP   8   
01EE   28 0B                  JR   Z,ln4   
01F0   5F                     LD   E,A   
01F1   7D                     LD   A,L   
01F2   BA                     CP   D   
01F3   28 EE                  JR   Z,ln2   ; full
01F5   73                     LD   (HL),E   
01F6   2C                     INC   L   
01F7   7B                     LD   A,E   
01F8   EF           LN3:      RST   28h   
01F9   18 E8                  JR   ln2   
01FB   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
01FC   FA F8 01               JP   M,ln3   ;   unless the line was empty (L left the
01FF   2C                     INC   L   ;   upper half of the page)
0200   18 E1                  JR   ln2   
0202   77           LN5:      LD   (HL),A   ; the CR
0203   2E 80                  LD   L,LINEBUF & 0FFh   
0205   F7                     RST   30h   
0206                             ; =============================================================================
0206                             ;  More routines (no handler starts past this point)
0206                             ; =============================================================================
0206                          IF   CHECKED   
0206                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0206                             ; "$", and the texts of the report). A NUL first is an error: Q.
0206   7E           PRSTR:    LD   A,(HL)   
0207   23                     INC   HL   
0208   FE 22                  CP   22h   
020A   C8                     RET   Z   
020B   B7                     OR   A   
020C   28 1F                  JR   Z,e_dollar   
020E   FE 2F                  CP   "/"   
0210   20 0C                  JR   NZ,prs1   
0212   7E                     LD   A,(HL)   
0213   23                     INC   HL   
0214   FE 60                  CP   60h   
0216   38 04                  JR   C,prs0   
0218   FE 7F                  CP   7Fh   
021A   38 1A                  JR   C,pesc   
021C   E6 BF        PRS0:     AND   0BFh   
021E   EF           PRS1:     RST   28h   
021F   18 E5                  JR   prstr   
0221                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0221                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0221                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0221                             ; pnl: the same, on a new line.
0221   3E 0D        PNL:      LD   A,13   
0223   EF                     RST   28h   
0224   3E 0A                  LD   A,10   
0226   EF                     RST   28h   
0227   E3           PMSG:     EX   (SP),HL   
0228   CD 06 02               CALL   prstr   
022B   E3                     EX   (SP),HL   
022C   C9                     RET      
022D   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
022E   2A 34 82               LD   HL,(RSAVE)   ;   and put the string's address back in TOS
0231   3E 51                  LD   A,"Q"   
0233   C3 F2 03               JP   error   
0236                          ENDIF      
0236                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0236                             ; HL points past it. Each goes back into the loop that prints the string
0236                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0236                             ;    /a-/z   print the variable, as "#" does
0236                             ;    /{      clear the screen, the cursor to the top left
0236                             ;    /}      clear from the cursor to the end of the line
0236                             ;    /|  /`  show the cursor, hide it
0236                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0236   FE 7E        PESC:     CP   7Eh   
0238   28 1C                  JR   Z,pat   
023A   11 06 02               LD   DE,PRLOOP   ; the others return into the loop
023D   D5                     PUSH   DE   
023E   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0240   30 25                  JR   NC,pcon   
0242   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0244   30 1D                  JR   NC,phide   
0246   87                     ADD   A,A   ; the variable's cell
0247   C6 40                  ADD   A,40h   
0249   E5                     PUSH   HL   
024A   6F                     LD   L,A   
024B   26 82                  LD   H,LETPAGE   
024D   7E                     LD   A,(HL)   
024E   2C                     INC   L   
024F   66                     LD   H,(HL)   
0250   6F                     LD   L,A   
0251   CD 10 03               CALL   psgn   
0254   E1                     POP   HL   
0255   C9                     RET      
0256                             ; /~ ( row col addr -- ): the two cells under the string's address go. Where
0256                             ; "$" is the routine prstr, its own return address goes first, and hp1
0256                             ; calls it again afterwards. (The checked build looks first, through
0256                             ; chkstk, that there is a column at least: with less, it is s. With a
0256                             ; column but no row it is s after the "$", as for any other character; the
0256                             ; spare bytes above the stack take what is written meanwhile.)
0256                PAT:         
0256                          IF   PRSUB   
0256   D1                     POP   DE   
0257                          ENDIF      
0257                          IF   CHECKED   
0257   CD 88 03               CALL   chkstk   
025A                          ENDIF      
025A   D1                     POP   DE   ; DE = the column
025B   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
025C                          IF   1-ANS   
025C   CD 15 FF               CALL   CONAT   
025F   E1                     POP   HL   
0260   C3 B0 01               JP   PRAGAIN   
0263                             ; With ANSI = 0 the machine's routines do the rest.
0263   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0264   C3 12 FF               JP   CONCUR   
0267   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
026A   FE 02                  CP   2   
026C   CA 0F FF               JP   Z,CONEOL   ; /}
026F   C3 12 FF               JP   CONCUR   ; /|  (A = 1: show)
0272                          ENDIF      
0272                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              LD   A,";"   
                              RST   28h   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              LD   A,"H"   
                              RST   28h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   
                              JR   csia   
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
                              LD   A,"?"   
                              CALL   csia   
                              LD   A,"2"   
                              RST   28h   
                              LD   A,"5"   
                              RST   28h   
                              LD   A,E   
                              RST   28h   
                              RET      
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              RST   28h   
                              RET      
                    CSI:      PUSH   AF   
                              LD   A,27   
                              RST   28h   
                              LD   A,"["   
                              RST   28h   
                              POP   AF   
                              RET      
0272                          ENDIF      
0272                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0272                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0272                             ; the quotient bits arrive at the bottom of C.
0272                             ; Dividing by 2 is one shift (the spec wants that fast).
0272   7B           UDIV:     LD   A,E   
0273   EE 02                  XOR   2   
0275   B2                     OR   D   
0276   20 07                  JR   NZ,udv0   
0278   CB 3C                  SRL   H   
027A   CB 1D                  RR   L   ; the quotient
027C   8F                     ADC   A,A   
027D   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
027E   C9                     RET      
027F   C5           UDV0:     PUSH   BC   
0280   7C                     LD   A,H   
0281   4D                     LD   C,L   
0282   21 00 00               LD   HL,0   
0285   06 10                  LD   B,16   
0287   CB 21        UDV1:     SLA   C   
0289   17                     RLA      
028A   ED 6A                  ADC   HL,HL   
028C   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
028E   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0290   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0291   0D                     DEC   C   ;   INC below
0292   0C           UDV2:     INC   C   ; a quotient bit
0293   10 F2                  DJNZ   udv1   
0295   EB                     EX   DE,HL   ; DE = remainder
0296   67                     LD   H,A   
0297   69                     LD   L,C   ; HL = quotient
0298   C1                     POP   BC   
0299   C9                     RET      
029A                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
029A                             ; non-digit. Values wrap at 16 bits, as the spec says.
029A   21 00 00     RDNUM:    LD   HL,0   
029D   0A           RDN1:     LD   A,(BC)   
029E   D6 30                  SUB   "0"   
02A0   FE 0A                  CP   10   
02A2   D0                     RET   NC   
02A3   03                     INC   BC   
02A4   54                     LD   D,H   
02A5   5D                     LD   E,L   
02A6   29                     ADD   HL,HL   
02A7   29                     ADD   HL,HL   
02A8   19                     ADD   HL,DE   
02A9   29                     ADD   HL,HL   ; HL * 10
02AA   5F                     LD   E,A   
02AB   16 00                  LD   D,0   
02AD   19                     ADD   HL,DE   
02AE   18 ED                  JR   rdn1   
02B0                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02B0                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02B0                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
02B0                          ENDIF      
02B0                          IF   CHECKED   
02B0                             ; The checked build never steps over a NUL: if the text runs out first it
02B0                             ; returns A = 0 with the IP on the NUL.
02B0   0A           SKIPSTR:   LD   A,(BC)   
02B1   B7                     OR   A   
02B2   C8                     RET   Z   
02B3   03                     INC   BC   
02B4   FE 22                  CP   22h   
02B6   C8                     RET   Z   
02B7   FE 2F                  CP   "/"   
02B9   20 F5                  JR   NZ,skipstr   
02BB   0A                     LD   A,(BC)   ; the escaped character
02BC   B7                     OR   A   
02BD   C8                     RET   Z   
02BE   03                     INC   BC   
02BF   18 EF                  JR   skipstr   
02C1                          ENDIF      
02C1                             ; skip: read past text to the closer at this level, and return A = 0 if it
02C1                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02C1                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02C1                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02C1                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02C1                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02C1                             ; 
02C1                             ; The checked build also looks at the character the skip was started by,
02C1                             ; which is always the one just before where it starts: "(" must end at ")",
02C1                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02C1                             ; quote counts as running into it. "\" takes either closer. IX keeps the
02C1                             ; place where the skip started, for the report.
02C1                SKIP:        
02C1                          IF   CHECKED   
02C1   C5                     PUSH   BC   
02C2   DD E1                  POP   IX   
02C4   0B                     DEC   BC   
02C5   0A                     LD   A,(BC)   
02C6   03                     INC   BC   
02C7   5F                     LD   E,A   ; E = the opener: ( [ or \
02C8                          ENDIF      
02C8   16 00                  LD   D,0   
02CA   14           SK3:      INC   D   ; an opener: one deeper
02CB   0A           SK1:      LD   A,(BC)   
02CC                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
02CC                          ENDIF      
02CC                          IF   CHECKED   
02CC   B7                     OR   A   
02CD   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
02CF   03                     INC   BC   
02D0                          ENDIF      
02D0   FE 22                  CP   22h   
02D2   CC B0 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02D5   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02D7   28 F1                  JR   Z,sk3   
02D9   3D                     DEC   A   ; ")"
02DA   28 08                  JR   Z,sk4   
02DC   D6 32                  SUB   "["-")"   
02DE   28 EA                  JR   Z,sk3   
02E0   FE 02                  CP   "]"-"["   
02E2   20 E7                  JR   NZ,sk1   
02E4   15           SK4:      DEC   D   
02E5                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
02E5                          ENDIF      
02E5                          IF   CHECKED   
02E5   20 E4                  JR   NZ,sk1   
02E7   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
02E8   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
02E9   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
02EB   FE 02                  CP   2   ;   closer, and only then
02ED   7A                     LD   A,D   
02EE   C0                     RET   NZ   
02EF   18 05                  JR   sk7   
02F1   CB 53        SK6:      BIT   2,E   ; the text ran out:
02F3   C2 F3 04               JP   NZ,SKEND   ;   "\" with no closer ends the program
02F6   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
02F8   C1                     POP   BC   
02F9   3E 4E                  LD   A,"N"   
02FB   C3 E2 03               JP   errp   ; (errp drops skip's return address)
02FE                          ENDIF      
02FE                             ; =============================================================================
02FE                             ;  Dispatch table: the low byte of each handler's address, in code order
02FE                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02FE                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02FE                             ; =============================================================================
02FE                             ; The handlers of the first NPG1 characters start in the image's second page.
02FE                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02FE                             ; differs between the builds, so the count is worked out here.
02FE                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02FE                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02FE                PGBRK:    EQU   (h_break-BASE)/256   
02FE                PGDEF:    EQU   (h_def-BASE)/256   
02FE                PGFET:    EQU   (h_fetch-BASE)/256   
02FE                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02FE                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02FE                          ENDIF      
02FE                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02FE                             ; and return its value in A with the carry set; otherwise leave the IP and
02FE                             ; return with the carry clear.
02FE   0A           HEXC:     LD   A,(BC)   
02FF   D6 30                  SUB   "0"   
0301   FE 0A                  CP   10   
0303   38 09                  JR   C,hc1   
0305   E6 DF                  AND   0DFh   
0307   D6 11                  SUB   11h   
0309   FE 06                  CP   6   
030B   D0                     RET   NC   
030C   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
030E   03           HC1:      INC   BC   
030F   C9                     RET      
0310                             ; psgn: print HL as a signed number. Keeps BC.
0310   CB 7C        PSGN:     BIT   7,H   
0312   28 04                  JR   Z,pdec   
0314   3E 2D                  LD   A,"-"   
0316   EF                     RST   28h   
0317   E7                     RST   20h   
0318                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0318                             ; Keeps BC.
0318   11 0A 00     PDEC:     LD   DE,10   
031B   CD 72 02               CALL   udiv   ; HL = HL / 10, E = the last digit
031E   7B                     LD   A,E   
031F   F5                     PUSH   AF   
0320   7C                     LD   A,H   
0321   B5                     OR   L   
0322   C4 18 03               CALL   NZ,pdec   
0325   F1                     POP   AF   
0326   C6 30                  ADD   A,"0"   
0328   EF                     RST   28h   
0329   C9                     RET      
032A                             ; (The table goes here instead in the builds where, before psgn, it would
032A                             ; cross a page: PTLATE.)
032A                          IF   (1-TABP0)*PTLATE   
032A                PTAB:        
032A                          ;*Macro unroll:  PTABLE
032A   9A                     DB   h_store & 0FFh   
032B   A2                     DB   h_str & 0FFh   
032C   B7                     DB   h_num & 0FFh   
032D   AD                     DB   h_print & 0FFh   
032E   92                     DB   h_swap & 0FFh   
032F   37                     DB   h_and & 0FFh   
0330   B4                     DB   h_emit & 0FFh   
0331   13                     DB   h_open & 0FFh   
0332   1B                     DB   h_close & 0FFh   
0333   58                     DB   h_mul & 0FFh   
0334   2E                     DB   h_add & 0FFh   
0335   D3                     DB   h_cfetch & 0FFh   
0336   26                     DB   h_sub & 0FFh   
0337   94                     DB   h_cstore & 0FFh   
0338   6C                     DB   h_div & 0FFh   
0339   90                     DB   h_dup & 0FFh   
033A   99                     DB   h_drop & 0FFh   
033B   3F                     DB   h_lt & 0FFh   
033C   4E                     DB   h_eq & 0FFh   
033D   40                     DB   h_gt & 0FFh   
033E   BB                     DB   h_key & 0FFh   
033F   0E                     DB   h_fetch & 0FFh   
0340   EA                     DB   h_def & 0FFh   
0341   DD                     DB   h_break & 0FFh   
0342   D9                     DB   h_ret & 0FFh   
0343   72                     DB   h_xor & 0FFh   
0344   85                     DB   h_alloc & 0FFh   
0345   C3                     DB   h_grave & 0FFh   
0346   2C                     DB   h_tor & 0FFh   
0347   7A                     DB   h_or & 0FFh   
0348   1C                     DB   h_fromr & 0FFh   
0349   82                     DB   h_not & 0FFh   
034A                PTABEND:      
034A                          ENDIF      
034A                             ; =============================================================================
034A                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
034A                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
034A                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
034A                             ;  they are the host's KEY and CONOUT routines themselves.
034A                             ; 
034A                             ;  A running program reads the keyboard only through getk and pollk, which
034A                             ;  between them give the break key its rules:
034A                             ;    - Ctrl-C stops the program;
034A                             ;    - any other key that the break check reads is held in KEYBUF for the
034A                             ;      next "?", and a newer one takes its place;
034A                             ;    - "?" (getk) takes the held key first;
034A                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
034A                             ;      key like any other, but two of them within about 250 ms still stop it.
034A                             ;  Both are called straight from a handler, never from a routine under one:
034A                             ;  the checked build's report counts on finding one return address above the
034A                             ;  data stack.
034A                             ; =============================================================================
034A                          IFN   CPM   
034A                RAWK:     EQU   KEY   
034A                          ENDIF      
034A                             ; pollk: the break check (see rpushn).
034A   CD 06 FF     POLLK:    CALL   rawk   
034D   C8                     RET   Z   ; no key
034E   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0351   FE 03        PK1:      CP   3   ; (getk joins here)
0353   C0                     RET   NZ   
0354                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0354                             ; the program has turned it off, wait about 250 ms for one more key: a
0354                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0354                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0354   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0357   B7                     OR   A   
0358   CA E0 03     CT0:      JP   Z,brk   
035B   D5                     PUSH   DE   
035C   11 10 27               LD   DE,250*MSLOOP   
035F   CD 06 FF     CT1:      CALL   rawk   
0362   20 05                  JR   NZ,ct2   
0364   1B                     DEC   DE   
0365   7A                     LD   A,D   
0366   B3                     OR   E   
0367   20 F6                  JR   NZ,ct1   
0369   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
036A   FE 03                  CP   3   
036C   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
036E   B7                     OR   A   
036F   28 03                  JR   Z,ct3   
0371   32 7A 82               LD   (KEYBUF),A   
0374   3E 03        CT3:      LD   A,3   
0376   B7                     OR   A   
0377   C9                     RET      
0378                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0378   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0379   21 7A 82               LD   HL,KEYBUF   ;   the buffer
037C   7E                     LD   A,(HL)   
037D   36 00                  LD   (HL),0   
037F   E1                     POP   HL   
0380   B7                     OR   A   
0381   C0                     RET   NZ   
0382   CD 06 FF               CALL   rawk   
0385   C8                     RET   Z   
0386   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0388                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0388                          ENDIF      ;   (with the editor, both stacks are cleared);
0388                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0388                          ENDIF      
0388                          IF   CHECKED   
0388                BRK:      EQU   e_break   ;   the checked build reports B
0388                          ENDIF      
0388                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0388                          ENDIF      
0388                             ; =============================================================================
0388                             ;  Checked build: the checks and the error report
0388                             ; =============================================================================
0388                          IF   CHECKED   
0388                             ; chkstk: both stacks are checked once per character, not in every handler.
0388                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0388                             ; the constant carries if it is above (cells were popped that were never
0388                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0388                             ; a character late at most: the bytes above DSTOP and the guard band below
0388                             ; the page take what happens meanwhile. DE is free between characters.
0388   EB           CHKSTK:   EX   DE,HL   
0389   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
038C   39                     ADD   HL,SP   
038D   EB                     EX   DE,HL   
038E   38 1D                  JR   C,e_under   
0390   14                     INC   D   
0391   20 16                  JR   NZ,e_over   
0393   D9                     EXX      ; the return stack: in its page (or it has
0394   7C                     LD   A,H   ;   overflowed), and not above its empty
0395   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
0397   7D                     LD   A,L   ;   page, in the guard band)
0398   D9                     EXX      
0399   20 0B                  JR   NZ,e_rover   
039B   FE E1                  CP   RSTOP&0FFh+1   
039D   D8                     RET   C   
039E   D9                     EXX      ; return stack underflow: it counts as empty
039F   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
03A1   D9                     EXX      
03A2   3E 72                  LD   A,"r"   
03A4   18 3C                  JR   errp   
03A6   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
03A8   11                     DB   11h   ; (LD DE,nn hides the next entry)
03A9   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
03AB   18 35                  JR   errp   
03AD   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
03B0   3E 73                  LD   A,"s"   
03B2   18 3E                  JR   error   
03B4                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
03B4                             ; was never defined still holds 0000h, and the byte there is a reserved one
03B4                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
03B4                             ; an undefined word. The call is undone, so the place is the call itself.
03B4   04           E_HI:     INC   B   
03B5   10 33                  DJNZ   e_resv   ; (B is as it was, and is not 0)
03B7   CF                     RST   08h   
03B8   42                     LD   B,D   
03B9   4B                     LD   C,E   
03BA   3E 55                  LD   A,"U"   
03BC   18 34                  JR   error   
03BE                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
03BE                             ; the count. Stop if the top is not below the limit page, or is below the
03BE                             ; program's end.
03BE                CHKHP:       
03BE                          ENDIF      
03BE                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03BE                          ENDIF      
03BE                          IF   CHECKED*(1-CPM)   
03BE                             ; (Here the program's space is under 32K, so a top that wrapped
03BE                             ; round always falls outside it.)
03BE   7C                     LD   A,H   
03BF   FE F0                  CP   HEAPLIM   
03C1   30 09                  JR   NC,e_heap   
03C3                          ENDIF      
03C3                          IF   CHECKED   
03C3   D5                     PUSH   DE   
03C4   EB                     EX   DE,HL   
03C5   2A 38 82               LD   HL,(NPEND)   
03C8   19                     ADD   HL,DE   ; carry: at or above the program's end
03C9   EB                     EX   DE,HL   
03CA   D1                     POP   DE   
03CB   D8                     RET   C   
03CC   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
03CD   ED 52                  SBC   HL,DE   
03CF   3E 48                  LD   A,"H"   
03D1   18 0F                  JR   errp   
03D3                             ; chkst: stop unless HL is in the program's own space: from the letter page
03D3                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
03D3                             ; whatever lies above the limit are safe. Memory above the heap top but
03D3                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
03D3                             ; It is the page of HL + 1 that is tested, so that one test serves both
03D3                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
03D3                             ; Keeps HL and BC. It runs on into its own error entry.
03D3   23           CHKST:    INC   HL   
03D4   7C                     LD   A,H   
03D5   2B                     DEC   HL   
03D6   FE 82                  CP   LETPAGE   
03D8   38 03                  JR   C,e_store   
03DA                          ENDIF      
03DA                          IF   CHECKED*(1-CPM)   
03DA   FE F0                  CP   HEAPLIM   
03DC   D8                     RET   C   
03DD                          ENDIF      
03DD                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03DD                          ENDIF      
03DD                          IF   CHECKED   
03DD                             ; Error entries. Each loads its letter and then hides the next entry inside
03DD                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
03DD   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
03DF   11                     DB   11h   
03E0   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
03E2                             ; errp: an error found inside a routine: drop its return address first.
03E2   D1           ERRP:     POP   DE   
03E3   18 0D                  JR   error   
03E5   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
03E6   4D                     LD   C,L   ;   past the opening quote, which is the place
03E7   3E 51                  LD   A,"Q"   
03E9   11                     DB   11h   
03EA   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
03EC   11                     DB   11h   
03ED   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
03EF   11                     DB   11h   
03F0   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
03F2                             ; error: the report, then the end. A = the letter, BC = one past the place,
03F2                             ; HL = TOS, and both stacks as the report is to show them:
03F2                             ; 
03F2                             ;   Err X @ line,col
03F2                             ;   up to 16 characters of the text from the place
03F2                             ;   Stk n: the top 8 cells at most, bottom to top
03F2                             ;   Rtn n
03F2   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
03F3   5F                     LD   E,A   
03F4   CD 21 02               CALL   pnl   
03F7   45 72 72 20 22         DB   "Err ",22h   
03FC   7B                     LD   A,E   
03FD   EF                     RST   28h   
03FE   CD 27 02               CALL   pmsg   
0401   20 40 20 22            DB   " @ ",22h   
0405   0B                     DEC   BC   ; BC = the place
0406                             ; The line and column. A place below the program is in the line
0406                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0406                             ; DE = the line's number, HL = where it starts.
0406   21 80 82               LD   HL,LINEBUF   
0409   11 00 00               LD   DE,0   
040C   78                     LD   A,B   
040D   FE 83                  CP   PROG/256   
040F   38 14                  JR   C,er3   
0411   24                     INC   H   
0412   6B                     LD   L,E   ; HL = PROG
0413   13           ER1:      INC   DE   ; a new line starts at HL
0414   E5                     PUSH   HL   
0415   7D           ER2:      LD   A,L   
0416   91                     SUB   C   
0417   7C                     LD   A,H   
0418   98                     SBC   A,B   
0419   30 09                  JR   NC,er2x   ; reached the place
041B   7E                     LD   A,(HL)   
041C   23                     INC   HL   
041D   FE 0A                  CP   10   
041F   20 F4                  JR   NZ,er2   
0421   F1                     POP   AF   
0422   18 EF                  JR   er1   
0424   E1           ER2X:     POP   HL   
0425   C5           ER3:      PUSH   BC   
0426   E5                     PUSH   HL   
0427   EB                     EX   DE,HL   
0428   CD 18 03               CALL   pdec   ; the line
042B   3E 2C                  LD   A,","   
042D   EF                     RST   28h   
042E   D1                     POP   DE   
042F   E1                     POP   HL   
0430   E5                     PUSH   HL   
0431   B7                     OR   A   
0432   ED 52                  SBC   HL,DE   
0434   23                     INC   HL   
0435   CD 18 03               CALL   pdec   ; the column
0438   CD 21 02               CALL   pnl   
043B   22                     DB   22h   
043C   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
043D   06 10                  LD   B,16   ;   if the line or the program ends first
043F   7E           ER4:      LD   A,(HL)   
0440   23                     INC   HL   
0441   B7                     OR   A   
0442   28 0B                  JR   Z,er5   
0444   FE 0D                  CP   13   
0446   28 07                  JR   Z,er5   
0448   FE 0A                  CP   10   
044A   28 03                  JR   Z,er5   
044C                          ENDIF      
044C                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
044C                          ENDIF      ;   screen on it. The editor's loader ends
044C                          IF   CHECKED   ;   the text at the first ^Z.)
044C   EF                     RST   28h   
044D   10 F0                  DJNZ   er4   
044F                ER5:         ; (on into the two stack lines)
044F                             ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
044F                             ;                       Rtn n
044F                             ; TOS is in memory with the rest (pushed) by now.
044F   CD 21 02               CALL   pnl   
0452   53 74 6B 20 22         DB   "Stk ",22h   
0457   21 06 7E               LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
045A   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
045B   E7                     RST   20h   ;   with the first value and holds nothing)
045C   CD A5 04               CALL   phalf   ; the depth
045F   3E 3A                  LD   A,":"   
0461   EF                     RST   28h   
0462   79                     LD   A,C   
0463   FE 09                  CP   9   
0465   38 0A                  JR   C,er6   
0467   CD 27 02               CALL   pmsg   
046A   20 2E 2E 2E 22         DB   " ...",22h   
046F   0E 08                  LD   C,8   
0471   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0473   69                     LD   L,C   
0474   29                     ADD   HL,HL   
0475   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0476   0C                     INC   C   
0477   0D           ER7:      DEC   C   
0478   28 0F                  JR   Z,er8   
047A   2B                     DEC   HL   
047B   56                     LD   D,(HL)   
047C   2B                     DEC   HL   
047D   5E                     LD   E,(HL)   
047E   E5                     PUSH   HL   
047F   3E 20                  LD   A," "   
0481   EF                     RST   28h   
0482   EB                     EX   DE,HL   
0483   CD 10 03               CALL   psgn   
0486   E1                     POP   HL   
0487   18 EE                  JR   er7   
0489   CD 21 02     ER8:      CALL   pnl   
048C   52 74 6E 20 22         DB   "Rtn ",22h   
0491   D9                     EXX      
0492   E5                     PUSH   HL   
0493   D9                     EXX      
0494   D1                     POP   DE   
0495   21 E0 80               LD   HL,RSTOP   
0498   B7                     OR   A   
0499   ED 52                  SBC   HL,DE   
049B   CD A5 04               CALL   phalf   
049E   CD 21 02               CALL   pnl   
04A1   22                     DB   22h   
04A2                          ENDIF      
04A2                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
04A2                          ENDIF      
04A2                          IF   CHECKED*EDITOR   
04A2   C3 EF 04               JP   edit0   ; back to the editor, with both stacks cleared
04A5                          ENDIF      
04A5                          IF   CHECKED   
04A5                             ; phalf: print half of HL, and leave it in C.
04A5   CB 3C        PHALF:    SRL   H   
04A7   CB 1D                  RR   L   
04A9   E5                     PUSH   HL   
04AA   CD 18 03               CALL   pdec   
04AD   C1                     POP   BC   
04AE   C9                     RET      
04AF                          ENDIF      
04AF                             ; =============================================================================
04AF                             ;  The line editor (EDITOR = 1)
04AF                             ; 
04AF                             ;  The interpreter starts here, and a program that ends comes back here.
04AF                             ;  There is no prompt. It follows the spec's suggested standard for a line
04AF                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
04AF                             ; 
04AF                             ;    n text    put the text in as line n; the lines from n on move down. A
04AF                             ;              number past the end (or 0) adds the line at the end.
04AF                             ;    n         take line n out
04AF                             ;    anything else is run at once, as B8Script. (Start such a line with a
04AF                             ;    space if it would begin with a digit.)
04AF                             ; 
04AF                             ;  A command key ends the line too, and takes what was typed as its argument:
04AF                             ; 
04AF                             ;    ^G        run the program
04AF                             ;    n ^L      list from line n (no number: all of it). Any key holds the
04AF                             ;              list until another key is pressed; Ctrl-C ends it.
04AF                             ;    n ^E      put line n in the input line; Return puts it back, changed
04AF                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
04AF                             ;              last time). Generic: what is typed, or pasted, from now until
04AF                             ;              ^Z replaces the program; it is not echoed.
04AF                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
04AF                             ;              time). Generic: the text is printed, as it is.
04AF                             ;    ^N ^N     new: no program (the key twice in a row)
04AF                             ;    ^X        leave (to LEAVE)
04AF                             ; 
04AF                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
04AF                             ;  a character goes in at the cursor; Backspace and DEL take out the one
04AF                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
04AF                             ;  sent to the terminal, so any terminal will do.
04AF                             ; 
04AF                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
04AF                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
04AF                             ;  125 characters; the one character after a line number separates it from
04AF                             ;  the text and is not stored. The text is kept as it is typed, each line
04AF                             ;  ending in CR LF, at PROG.
04AF                             ; 
04AF                             ;  What lasts from one line to the next: the program, the words, the
04AF                             ;  variables and the data stack. An error or a break clears both stacks. The
04AF                             ;  return stack starts empty for every line.
04AF                             ; 
04AF                             ;  Things to know:
04AF                             ;    - Reset empties the program (generic builds).
04AF                             ;    - A word's address points into the program, so run the program again
04AF                             ;      after editing it.
04AF                             ;    - Nothing is printed between a program's output and what is typed next.
04AF                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
04AF                             ;      a line that calls -n? and carries on afterwards runs what was typed.
04AF                             ;      (The stored program never comes back to the line, so it may.)
04AF                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
04AF                             ;      read of the other builds.
04AF                             ; 
04AF                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
04AF                             ;  the last line left there, with TOS pushed like the rest.
04AF                             ; =============================================================================
04AF                          IF   EDGEN   
04AF                INIT:        ; reset (A = 0)
04AF                          ENDIF      
04AF                          IF   EDGEN*CHECKED   
04AF                             ; Clear the lower half of the letter page: every variable starts at 0, and
04AF                             ; every word cell holds 0000h, the address an undefined word is caught at
04AF                             ; (see e_hi).
04AF   21 00 82               LD   HL,LET   
04B2   77           INI1:     LD   (HL),A   
04B3   2C                     INC   L   
04B4   F2 B2 04               JP   P,ini1   ; +00h to +7Fh
04B7                          ENDIF      
04B7                          IF   EDGEN   
04B7   18 36                  JR   edit0   
04B9                          ENDIF      
04B9                          IF   EDITOR   
04B9                             ; ^F, right arrow: one to the right, by printing the character there
04B9   7D           RIGHT:    LD   A,L   
04BA   BB                     CP   E   
04BB   28 4A                  JR   Z,ed1   ; at the end
04BD   7E                     LD   A,(HL)   
04BE   2C                     INC   L   
04BF   18 2B                  JR   lf1   
04C1                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
04C1                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
04C1                             ; ends the sequence, and act on C (right) and D (left).
04C1   01 C8 00     ESC:      LD   BC,5*MSLOOP   
04C4   CD 06 FF     ES1:      CALL   rawk   
04C7   20 0A                  JR   NZ,es2   
04C9   0B                     DEC   BC   
04CA   78                     LD   A,B   
04CB   B1                     OR   C   
04CC   20 F6                  JR   NZ,es1   
04CE   CD 3C 05               CALL   fin   ; no second key: the line is dropped
04D1   18 22                  JR   edit   
04D3   FE 5B        ES2:      CP   "["   
04D5   20 30                  JR   NZ,ed1   ; not a sequence known here
04D7   CD 95 05     ES3:      CALL   ekey   
04DA   FE 40                  CP   40h   
04DC   38 F9                  JR   C,es3   ; (its parameters)
04DE   D6 43                  SUB   "C"   
04E0   28 D7                  JR   Z,right   
04E2   3D                     DEC   A   ; "D"?
04E3   20 22                  JR   NZ,ed1   ; no: on into left
04E5                             ; ^B, left arrow: the cursor goes one to the left
04E5   7D           LEFT:     LD   A,L   
04E6   87                     ADD   A,A   
04E7   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
04E9   2D                     DEC   L   
04EA   3E 08                  LD   A,8   
04EC   EF           LF1:      RST   28h   
04ED   18 18                  JR   ed1   
04EF                             ; edit0: reset, an error or a break: both stacks are cleared.
04EF                             ; skend: a program that ended inside skip: its return address goes.
04EF                             ; edend: a program that ended: TOS joins the rest of the data stack.
04EF   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
04F2   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
04F3   D1           SKEND:    POP   DE   
04F4   E5           EDEND:    PUSH   HL   
04F5                             ; edit: start a new input line.
04F5   D9           EDIT:     EXX      
04F6   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
04F9   D9                     EXX      
04FA   21 00 00               LD   HL,0   
04FD   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0500   22 3A 82               LD   (EDLN),HL   ; no line is being edited
0503   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
0506   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0507   CD 95 05     ED1:      CALL   ekey   
050A   FE 7F                  CP   7Fh   
050C   28 40                  JR   Z,bsp   ; DEL
050E   FE 20                  CP   " "   
0510   30 56                  JR   NC,insc   
0512   FE 09                  CP   9   
0514   28 52                  JR   Z,insc   ; Tab is text
0516   FE 08                  CP   8   
0518   28 34                  JR   Z,bsp   
051A   FE 02                  CP   2   
051C   28 C7                  JR   Z,left   ; ^B
051E   FE 06                  CP   6   
0520   28 97                  JR   Z,right   ; ^F
0522   FE 1B                  CP   1Bh   
0524   28 9B                  JR   Z,esc   
0526   E5                     PUSH   HL   ; a command key? Look it up
0527   21 9B 05               LD   HL,cmds   
052A   06 08                  LD   B,NCMD   
052C   BE           ED2:      CP   (HL)   
052D   23                     INC   HL   
052E   28 07                  JR   Z,ed3   
0530   23                     INC   HL   
0531   23                     INC   HL   
0532   10 F8                  DJNZ   ed2   
0534   E1                     POP   HL   
0535   18 D0                  JR   ed1   ; no: the key is ignored
0537   7E           ED3:      LD   A,(HL)   
0538   23                     INC   HL   
0539   66                     LD   H,(HL)   
053A   6F                     LD   L,A   
053B   E3                     EX   (SP),HL   ; the command's address: fin returns to it
053C                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
053C                             ; terminal. Leaves BC -> the line and HL -> the NUL.
053C   26 82        FIN:      LD   H,LETPAGE   
053E   6B                     LD   L,E   
053F   36 0D                  LD   (HL),13   
0541   2C                     INC   L   
0542   36 0A                  LD   (HL),10   
0544   2D                     DEC   L   
0545   CD A4 06               CALL   prl   ; (prints the CR LF)
0548   36 00                  LD   (HL),0   
054A   01 80 82               LD   BC,LINEBUF   
054D   C9                     RET      
054E                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
054E                             ; left, the rest of the line moves down over it, and the last place (now a
054E                             ; space) is printed over along with the rest.
054E   7D           BSP:      LD   A,L   
054F   87                     ADD   A,A   
0550   28 B5                  JR   Z,ed1   ; at the start
0552   2D                     DEC   L   
0553   3E 08                  LD   A,8   
0555   EF                     RST   28h   
0556   E5                     PUSH   HL   
0557   2C           BS1:      INC   L   
0558   7E                     LD   A,(HL)   
0559   2D                     DEC   L   
055A   77                     LD   (HL),A   
055B   2C                     INC   L   
055C   7D                     LD   A,L   
055D   BB                     CP   E   
055E   20 F7                  JR   NZ,bs1   
0560   2D                     DEC   L   
0561   36 20                  LD   (HL)," "   
0563   E1                     POP   HL   
0564   53                     LD   D,E   
0565   1D                     DEC   E   
0566   18 15                  JR   ic2   
0568                             ; A character goes in at the cursor: it ripples up through the rest of the
0568                             ; line, the cursor moves on, and the rest is printed again.
0568   47           INSC:     LD   B,A   
0569   7B                     LD   A,E   
056A   FE FD                  CP   0FDh   
056C   28 99                  JR   Z,ed1   ; the line is full: 125 characters
056E   78                     LD   A,B   
056F   EF                     RST   28h   
0570   E5                     PUSH   HL   
0571   7E           IC1:      LD   A,(HL)   
0572   70                     LD   (HL),B   
0573   47                     LD   B,A   
0574   7D                     LD   A,L   
0575   2C                     INC   L   
0576   BB                     CP   E   
0577   20 F8                  JR   NZ,ic1   
0579   E1                     POP   HL   
057A   2C                     INC   L   
057B   1C                     INC   E   
057C   53                     LD   D,E   
057D   CD 82 05     IC2:      CALL   tail   
0580   18 85                  JR   ed1   
0582                             ; tail: print the line from the cursor to D (a low byte), and bring the
0582                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0582   4D           TAIL:     LD   C,L   
0583   7D           TA1:      LD   A,L   
0584   BA                     CP   D   
0585   28 05                  JR   Z,ta2   
0587   7E                     LD   A,(HL)   
0588   EF                     RST   28h   
0589   2C                     INC   L   
058A   18 F7                  JR   ta1   
058C   7D           TA2:      LD   A,L   
058D   B9                     CP   C   
058E   C8                     RET   Z   
058F   3E 08                  LD   A,8   
0591   EF                     RST   28h   
0592   2D                     DEC   L   
0593   18 F7                  JR   ta2   
0595                             ; ekey: wait for a key
0595   CD 06 FF     EKEY:     CALL   rawk   
0598   28 FB                  JR   Z,ekey   
059A   C9                     RET      
059B                             ; The command keys, and where each goes (after fin).
059B   0D           CMDS:     DB   13   
059C   EB 05                  DW   cret   
059E   07                     DB   7   ; ^G
059F   33 06                  DW   crun   
05A1   0C                     DB   12   ; ^L
05A2   49 06                  DW   clist   
05A4   05                     DB   5   ; ^E
05A5   C1 05                  DW   cedln   
05A7   12                     DB   18   ; ^R
05A8   AD 06                  DW   cread   
05AA   17                     DB   23   ; ^W
05AB   DA 06                  DW   cwrite   
05AD   0E                     DB   14   ; ^N
05AE   B3 05                  DW   cnew   
05B0   18                     DB   24   ; ^X
05B1   09 FF                  DW   LEAVE   
05B3                NCMD:     EQU   8   
05B3                             ; ^N ^N: no program, if the next key is ^N too
05B3   CD 95 05     CNEW:     CALL   ekey   
05B6   FE 0E                  CP   14   
05B8   20 04                  JR   NZ,ged0   
05BA   AF                     XOR   A   
05BB   32 00 83               LD   (PROG),A   
05BE   C3 F5 04     GED0:     JP   edit   
05C1                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
05C1                             ; line it was: Return puts the text back in its place.
05C1   CD 9A 02     CEDLN:    CALL   rdnum   
05C4   E5                     PUSH   HL   
05C5   CD 8C 06               CALL   find   ; HL -> the line, or the NUL if there is none
05C8   D1                     POP   DE   
05C9   7E                     LD   A,(HL)   
05CA   B7                     OR   A   
05CB   28 F1                  JR   Z,ged0   
05CD   ED 53 3A 82            LD   (EDLN),DE   
05D1   11 80 82               LD   DE,LINEBUF   
05D4   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
05D5   FE 0D                  CP   13   
05D7   28 0D                  JR   Z,ce2   
05D9   FE 0A                  CP   10   
05DB   28 09                  JR   Z,ce2   
05DD   12                     LD   (DE),A   
05DE   EF                     RST   28h   
05DF   23                     INC   HL   
05E0   1C                     INC   E   
05E1   7B                     LD   A,E   
05E2   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
05E4   20 EE                  JR   NZ,ce1   
05E6   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
05E7   5D                     LD   E,L   
05E8   C3 07 05               JP   ed1   
05EB                             ; Return. If ^E put a line here, the text goes back in its place. If not:
05EB                             ; a number and text is a line to put in, a number alone a line to take out,
05EB                             ; and anything else is run where it is.
05EB   E5           CRET:     PUSH   HL   ; the end of what was typed
05EC   2A 3A 82               LD   HL,(EDLN)   
05EF   7C                     LD   A,H   
05F0   B5                     OR   L   
05F1   28 07                  JR   Z,cr1   
05F3   E5                     PUSH   HL   
05F4   CD 7C 06               CALL   delln   
05F7   E1                     POP   HL   
05F8   18 13                  JR   ins   
05FA   CD 9A 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
05FD   79                     LD   A,C   ; C is still 80h if there was no number:
05FE   87                     ADD   A,A   ;   only then is twice it 0
05FF   28 36                  JR   Z,st0p   ; no number: run the line
0601   0A                     LD   A,(BC)   
0602   FE 0D                  CP   13   
0604   20 06                  JR   NZ,cr2   
0606   D1                     POP   DE   ; the number alone: take that line out
0607   CD 7C 06               CALL   delln   
060A   18 24                  JR   gedit   
060C   03           CR2:      INC   BC   ; step over the one character after the number
060D                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
060D                             ; CR and LF included, and copy it in.
060D   CD 8C 06     INS:      CALL   find   ; HL -> where it goes
0610   D1                     POP   DE   ; the end of what was typed
0611   7B                     LD   A,E   
0612   91                     SUB   C   ; A = the length of the text, with its CR LF
0613   C5                     PUSH   BC   ; the text
0614   4F                     LD   C,A   
0615   06 00                  LD   B,0   
0617   C5                     PUSH   BC   ; its length
0618   54                     LD   D,H   
0619   5D                     LD   E,L   ; DE = where it goes
061A   AF                     XOR   A   
061B   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
061C   ED B1                  CPIR      ; HL -> one past the program's NUL
061E   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0620   44                     LD   B,H   
0621   4D                     LD   C,L   
0622   19                     ADD   HL,DE   
0623   2B                     DEC   HL   ; HL -> the NUL
0624   EB                     EX   DE,HL   
0625   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0626   E5                     PUSH   HL   
0627   19                     ADD   HL,DE   ; the NUL's new place
0628   EB                     EX   DE,HL   
0629   ED B8                  LDDR      ; move the rest of the program up
062B   C1                     POP   BC   ; the length
062C   D1                     POP   DE   ; where it goes
062D   E1                     POP   HL   ; the text
062E   ED B0                  LDIR      
0630   C3 F5 04     GEDIT:    JP   edit   
0633                             ; ^G: run the program. st0p: run the typed line (BC -> it).
0633   01 00 83     CRUN:     LD   BC,PROG   
0636   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
0637   E1           ST0P:     POP   HL   ; (the end of what was typed)
0638                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0638   21 00 83     ST0:      LD   HL,PROG   
063B   AF                     XOR   A   
063C   BE           ST1:      CP   (HL)   
063D   23                     INC   HL   
063E   20 FC                  JR   NZ,st1   
0640   22 7C 82               LD   (HEAP),HL   
0643                          ENDIF      
0643                          IF   EDITOR*CHECKED   
0643   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0644   22 38 82               LD   (NPEND),HL   ;   release below it
0647                          ENDIF      
0647                          IF   EDITOR   
0647   E1                     POP   HL   ; TOS: the data stack is as the last line left it
0648   F7                     RST   30h   ; (its return address is thrown away)
0649                             ; ^L: list from line n. DE = the number of the line at HL.
0649   CD 9A 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
064C   7C                     LD   A,H   
064D   B5                     OR   L   
064E   20 01                  JR   NZ,li0   
0650   2C                     INC   L   ;   then from line 1
0651   E5           LI0:      PUSH   HL   
0652   CD 8C 06               CALL   find   
0655   D1                     POP   DE   
0656   7E           LI1:      LD   A,(HL)   
0657   B7                     OR   A   
0658   28 D6                  JR   Z,gedit   ; the end of the text
065A   CD 06 FF               CALL   rawk   
065D   28 09                  JR   Z,li3   ; no key: carry on
065F   FE 03                  CP   3   
0661   C4 95 05               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
0664   FE 03                  CP   3   
0666   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
0668   E5           LI3:      PUSH   HL   
0669   D5                     PUSH   DE   
066A   EB                     EX   DE,HL   
066B   CD 18 03               CALL   pdec   ; the line's number,
066E   3E 20                  LD   A," "   
0670   EF                     RST   28h   ;   a space,
0671   D1                     POP   DE   
0672   E1                     POP   HL   
0673   13                     INC   DE   
0674   CD A4 06               CALL   prl   ;   and the line
0677   18 DD                  JR   li1   
0679   C3 F5 04     GED1:     JP   edit   
067C                             ; delln: take line n (in HL) out: copy everything after it down over it.
067C   CD 8C 06     DELLN:    CALL   find   
067F   54                     LD   D,H   
0680   5D                     LD   E,L   
0681   CD 9A 06               CALL   nxl   ; HL -> the next line
0684   7E           DE1:      LD   A,(HL)   
0685   12                     LD   (DE),A   
0686   23                     INC   HL   
0687   13                     INC   DE   
0688   B7                     OR   A   
0689   20 F9                  JR   NZ,de1   
068B   C9                     RET      
068C                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
068C                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
068C   EB           FIND:     EX   DE,HL   
068D   21 00 83               LD   HL,PROG   
0690   1B           FI1:      DEC   DE   
0691   7A                     LD   A,D   
0692   B3                     OR   E   
0693   C8                     RET   Z   
0694   CD 9A 06               CALL   nxl   
0697   20 F7                  JR   NZ,fi1   
0699   C9                     RET      
069A                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
069A                             ; stop at the NUL that ends the text (and return zero).
069A   7E           NXL:      LD   A,(HL)   
069B   B7                     OR   A   
069C   C8                     RET   Z   
069D   23                     INC   HL   
069E   FE 0A                  CP   10   
06A0   20 F8                  JR   NZ,nxl   
06A2   B7                     OR   A   
06A3   C9                     RET      
06A4                             ; prl: print the line at HL, to its LF; HL -> just past it.
06A4   7E           PRL:      LD   A,(HL)   
06A5   EF                     RST   28h   
06A6   7E                     LD   A,(HL)   
06A7   23                     INC   HL   
06A8   FE 0A                  CP   10   
06AA   20 F8                  JR   NZ,prl   
06AC   C9                     RET      
06AD                          ENDIF      
06AD                          IF   EDGEN   
06AD                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
06AD                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
06AD                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
06AD                             ; line with no end is given one. Nothing is echoed, and there is no check
06AD                             ; for running out of memory.
06AD   21 FF 82     CREAD:    LD   HL,PROG-1   
06B0   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
06B2   23                     INC   HL   ;   the line buffer's last, and spare)
06B3   CD 95 05     RD1:      CALL   ekey   
06B6   4F                     LD   C,A   
06B7   FE 1A                  CP   1Ah   
06B9   20 02                  JR   NZ,rd2   
06BB   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
06BD   FE 0A        RD2:      CP   10   
06BF   20 07                  JR   NZ,rd3   
06C1   2B                     DEC   HL   
06C2   BE                     CP   (HL)   
06C3   23                     INC   HL   
06C4   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
06C6   3E 0D                  LD   A,13   ; anywhere else it ends the line
06C8   77           RD3:      LD   (HL),A   
06C9   23                     INC   HL   
06CA   FE 0D                  CP   13   
06CC   20 03                  JR   NZ,rd4   
06CE   36 0A                  LD   (HL),10   ; after a CR goes a LF
06D0   23                     INC   HL   
06D1   79           RD4:      LD   A,C   
06D2   FE 1A                  CP   1Ah   
06D4   20 DD                  JR   NZ,rd1   
06D6   36 00                  LD   (HL),0   
06D8   18 9F                  JR   ged1   
06DA                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
06DA   21 00 83     CWRITE:   LD   HL,PROG   
06DD   7E           CW1:      LD   A,(HL)   
06DE   B7                     OR   A   
06DF   28 98                  JR   Z,ged1   
06E1   EF                     RST   28h   
06E2   23                     INC   HL   
06E3   18 F8                  JR   cw1   
06E5                          ENDIF      
06E5                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
06E5                          ENDIF      
06E5                             ; =============================================================================
06E5                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
06E5                          ENDIF      
06E5                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
06E5                          ENDIF      
06E5                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
06E5                          ENDIF      
06E5                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
06E5                          ENDIF      
06E5                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
06E5                          ENDIF      
06E5                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
06E5                          ENDIF      
06E5                IMGEND:      


