E37A                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E37A                             ; the carry is clear. Each returns into the loop.
E37A                             ;    /a-/z   print the variable, as "#" does
E37A                             ;    /{      clear the screen, the cursor to the top left
E37A                             ;    /}      clear from the cursor to the end of the line
E37A                             ;    /|  /`  show the cursor, hide it
E37A                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E37A                             ;            from 0. The two cells under the string's address go.
E37A                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E37A                             ; E6h-FFh with it clear.
E37A                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's routines do the work.
                    PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
                              BCC   pe1   
                              BEQ   pcls   ; {
                              LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
                              BEQ   pcur   ; |  show: the carry is set
                              BCS   pat   ; ~
                              JMP   CONEOL   ; }
                    PCLS:     JMP   CONCLS   
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                    PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E37A                          ENDIF      
E37A                          IF   ANSI   
E37A                             ; With ANSI = 1 they are sequences, each a message at MSG (see prs).
E37A   A0 00        PESC:     LDY   #M_CLS-MSG   
E37C   E9 7A                  SBC   #7Ah   ; (the carry is clear: - 7Bh)
E37E   90 0D                  BCC   pe1   
E380   F0 1E                  BEQ   prs   ; {  ESC [ H ESC [ J
E382   A0 06                  LDY   #M_SHOW-MSG   
E384   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for ~
E385   F0 19                  BEQ   prs   ; |  ESC [ ? 2 5 h
E387   B0 25                  BCS   pat   ; ~
E389   A0 12                  LDY   #M_EOL-MSG   ; }  ESC [ K
E38B   D0 13                  BNE   prs   ; always
E38D   C9 E6        PE1:      CMP   #0E6h   
E38F   B0 04                  BCS   pvar   
E391   A0 0C                  LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l
E393   D0 0B                  BNE   prs   ; always
E395                          ENDIF      
E395                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E395                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' prints
E395                             ; it and drops it: TOS is the string's address again.
E395   69 39        PVAR:     ADC   #39h   
E397   20 10 E5               JSR   lower   
E39A   20 81 E2               JSR   h_fetch   
E39D   4C 8C E0               JMP   h_num   
E3A0                          IF   CHECKED+ANSI   
E3A0                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E3A0                             ; past it, at the next message.
E3A0   B9 4E E6     PRS:      LDA   MSG,Y   
E3A3   48                     PHA      
E3A4   29 7F                  AND   #7Fh   
E3A6   20 03 FF               JSR   CONOUT   
E3A9   C8                     INY      
E3AA   68                     PLA      
E3AB   10 F3                  BPL   prs   
E3AD   60                     RTS      
E3AE                          ENDIF      
E3AE                             ; /~: the row is at 4,X, the column at 2,X, the string's address at 0,X.
E3AE                PAT:         
E3AE                          IF   CHECKED   
E3AE   E0 EB                  CPX   #DSE-5   ; fewer than two cells under TOS: s
E3B0   B0 6A                  BCS   e_sund   
E3B2                          ENDIF      
E3B2                          IF   1-ANSI   
                              LDA   4,X   ; the row
                              LDY   2,X   ; the column
                              JSR   CONAT   
                              JSR   nip   ; two nips leave the address, 4 bytes up
                    NIP:      JSR   h_swap   ; nip: ( a b -- b )
                              JMP   drop   
E3B2                          ENDIF      
E3B2                          IF   ANSI   
E3B2                             ; ESC [ row+1 ; col+1 H (ANSI counts from 1). Three swaps put the row on top
E3B2                             ; and the address under the column: "#" prints the row and drops it, prints
E3B2                             ; the column and drops it, and TOS is the string's address again.
E3B2   20 C7 E0               JSR   h_swap   
E3B5   E8                     INX      
E3B6   E8                     INX      
E3B7   20 C7 E0               JSR   h_swap   
E3BA   CA                     DEX      
E3BB   CA                     DEX      
E3BC   20 C7 E0               JSR   h_swap   
E3BF   A0 15                  LDY   #M_CSI-MSG   
E3C1   20 A0 E3               JSR   prs   ; ESC [
E3C4   20 90 E2               JSR   inctos   
E3C7   20 8C E0               JSR   h_num   ; the row + 1
E3CA   A9 3B                  LDA   #";"   
E3CC   20 03 FF               JSR   CONOUT   
E3CF   20 90 E2               JSR   inctos   
E3D2   20 8C E0               JSR   h_num   ; the column + 1
E3D5   A9 48                  LDA   #"H"   
E3D7   4C 03 FF               JMP   CONOUT   
E3DA                          ENDIF      
E3DA                          IF   CHECKED   
E3DA                             ; The checked build's inner loop, out of page 1, where it would not fit,
E3DA                             ; and its break check (described with the unchecked one in page 1).
E3DA                             ; pnext: the break check, then (falling through) next. A word call, a true
E3DA                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E3DA                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E3DA                             ; falls in here too, which does no harm.)
E3DA   CE 79 04     PNEXT:    DEC   CDOWN   
E3DD   D0 0B                  BNE   next   
E3DF   20 06 FF               JSR   KEY   
E3E2   F0 06                  BEQ   next   ; no key
E3E4   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E3E7   20 75 E4               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E3EA                NEXT:        
E3EA                             ; Both stacks are checked once per character, after it has run. The
E3EA                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E3EA                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E3EA                             ; more than one entry). The data stack has when X is above DSE (an
E3EA                             ; underflow) or below DSFULL (an overflow). No handler moves X by
E3EA                             ; more than 4 (but "$", whose /~ escapes each look first), so X is
E3EA                             ; caught before it wraps; an overrun by a cell or two writes on the
E3EA                             ; scratch bytes below or above the stack.
E3EA                             ; S is kept in RSV, for the report's Rtn line (an error found inside
E3EA                             ; a handler has its own calls on the hardware stack), and the place
E3EA                             ; of the character about to run in PLACE.
E3EA   8A                     TXA      ; TSX trashes X: keep it in A
E3EB   BA                     TSX      
E3EC   8E 35 04               STX   RSV   
E3EF   E0 20                  CPX   #RSLIM   
E3F1   AA                     TAX      ; TAX leaves the carry alone
E3F2   90 16                  BCC   e_rstack   
E3F4   E0 F1                  CPX   #DSE+1   
E3F6   B0 24                  BCS   e_sund   
E3F8   E0 10                  CPX   #DSFULL   
E3FA   90 25                  BCC   e_sovr   
E3FC   A5 00                  LDA   IP   
E3FE   85 08                  STA   PLACE   
E400   A5 01                  LDA   IP+1   
E402   85 09                  STA   PLACE+1   
E404   20 BB E4               JSR   step   
E407   4C EA E3               JMP   next   
E40A                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E40A                             ; empty.
E40A   AD 35 04     E_RSTACK:   LDA   RSV   
E40D   C9 10                  CMP   #10h   
E40F   A9 52                  LDA   #"R"   
E411   B0 10                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E413   A9 FF                  LDA   #0FFh   
E415   8D 35 04               STA   RSV   ; S wrapped to 01h: Rtn 0
E418   A9 72                  LDA   #"r"   
E41A   D0 07                  BNE   ejmp   ; always
E41C   A2 F0        E_SUND:   LDX   #DSE   ; Stk 0
E41E   A9 73                  LDA   #"s"   
E420   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E421   A9 53        E_SOVR:   LDA   #"S"   
E423   4C A7 E5     EJMP:     JMP   error   
E426                             ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
E426                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E426                             ; which takes either. Meeting the wrong closer at this level, or the end
E426                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E426                             ; which then ends the program as before.
E426   85 04        SKIP:     STA   T0   
E428   A9 00                  LDA   #0   
E42A   85 06                  STA   T2   ; depth
E42C   20 8D E5     SK1:      JSR   getc   
E42F   F0 26                  BEQ   sknul   
E431   C9 22                  CMP   #22h   
E433   D0 05                  BNE   sk2   
E435   20 6F E0               JSR   skipstr   ; leaves A = 11h, which matches nothing below
E438   F0 1D                  BEQ   sknul   ; the string ran into the end
E43A   C9 28        SK2:      CMP   #"("   
E43C   F0 15                  BEQ   sk3   
E43E   C9 5B                  CMP   #"["   
E440   F0 11                  BEQ   sk3   
E442   C9 29                  CMP   #")"   
E444   F0 04                  BEQ   sk4   
E446   C9 5D                  CMP   #"]"   
E448   D0 E2                  BNE   sk1   
E44A   C6 06        SK4:      DEC   T2   
E44C   10 DE                  BPL   sk1   
E44E   C5 04                  CMP   T0   
E450   F0 0C                  BEQ   e_nest   ; the wrong kind
E452   60                     RTS      ; the closer at this level
E453   E6 06        SK3:      INC   T2   
E455   D0 D5                  BNE   sk1   
E457   A5 04        SKNUL:    LDA   T0   
E459   D0 03                  BNE   e_nest   ; ( and [ stop with N
E45B   4C 09 FF               JMP   EXIT   ; \ ends the program
E45E   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E460   4C A7 E5               JMP   error   ;   or the end: the place is the opener
E463                          ENDIF      
E463                          IF   1-CHECKED   
                    CBREAK:   EQU   endp   ; the unchecked build stops without a word
E463                          ENDIF      
E463                          IF   CHECKED   
E463                CBREAK:   EQU   e_break   ; the checked build reports B
E463                          ENDIF      
E463                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E463                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E463                             ; taken out of KEYBUF.
E463   AD 7A 04     GETK:     LDA   KEYBUF   
E466   F0 08                  BEQ   gk1   
E468   48                     PHA      
E469   A9 00                  LDA   #0   
E46B   8D 7A 04               STA   KEYBUF   
E46E   68                     PLA      
E46F   60                     RTS      
E470   20 06 FF     GK1:      JSR   KEY   
E473   F0 04                  BEQ   gk9   
E475                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E475                             ; back if it comes back at all.
E475   C9 03        CHK3:     CMP   #3   
E477   F0 01                  BEQ   ctlc   
E479   60           GK9:      RTS      
E47A                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E47A                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E47A                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E47A                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E47A                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E47A   AD 7B 04     CTLC:     LDA   BRKOFF   
E47D   F0 1D                  BEQ   cbreak   
E47F   A9 28                  LDA   #CWAIT+1   
E481   85 05                  STA   T1   
E483   20 06 FF     CT2:      JSR   KEY   
E486   D0 0A                  BNE   ct3   
E488   C6 06                  DEC   T2   
E48A   D0 F7                  BNE   ct2   
E48C   C6 05                  DEC   T1   
E48E   D0 F3                  BNE   ct2   
E490   F0 07                  BEQ   ct9   ; always: none came
E492   C9 03        CT3:      CMP   #3   
E494   F0 06                  BEQ   cbreak   
E496   8D 7A 04               STA   KEYBUF   
E499   A9 03        CT9:      LDA   #3   
E49B   60                     RTS      
E49C                          IF   CHECKED   
E49C   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E49E   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E49F   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E4A1   4C A7 E5     EJMP2:    JMP   error   
E4A4                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E4A4                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E4A4                             ; the call reads a NUL with IP in page zero, where no program can be. The
E4A4                             ; call is undone first: the step frame and the return address come off the
E4A4                             ; hardware stack, and the place is the call letter (the return address - 1).
E4A4   68           E_UNDEF:   PLA      
E4A5   68                     PLA      ; the step frame
E4A6   68                     PLA      
E4A7   38                     SEC      
E4A8   E9 01                  SBC   #1   
E4AA   85 08                  STA   PLACE   
E4AC   68                     PLA      
E4AD   E9 00                  SBC   #0   
E4AF   85 09                  STA   PLACE+1   
E4B1   EE 35 04               INC   RSV   
E4B4   EE 35 04               INC   RSV   ; Rtn does not count the call
E4B7   A9 55                  LDA   #"U"   
E4B9   D0 E6                  BNE   ejmp2   ; always
E4BB                          ENDIF      
E4BB                             ; step: read one character and sort it by range.
E4BB                             ;    00h          end of program
E4BB                             ;    01h-20h, 7Fh-FFh   ignored
E4BB                             ;    30h-39h      digit: read a whole number
E4BB                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E4BB                             ;    61h-7Ah      a-z: push the address of that letter's cell
E4BB                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E4BB   20 8D E5     STEP:     JSR   getc   ; flags follow A
E4BE   F0 3D                  BEQ   endp   
E4C0   38                     SEC      
E4C1   E9 21                  SBC   #21h   ; A = c - 21h
E4C3   90 37                  BCC   ign   ; 01h-20h
E4C5   C9 0F                  CMP   #0Fh   
E4C7   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E4C9   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E4CB   C9 0A                  CMP   #10   
E4CD   90 72                  BCC   digit   
E4CF   C9 11                  CMP   #11h   
E4D1   90 18                  BCC   p3a   ; 3Ah-40h
E4D3   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E4D5   C9 1A                  CMP   #1Ah   
E4D7   90 2B                  BCC   upper   ; 41h-5Ah
E4D9   C9 20                  CMP   #20h   
E4DB   90 0C                  BCC   p5b   ; 5Bh-60h
E4DD   C9 3A                  CMP   #3Ah   
E4DF   90 2F                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E4E1   C9 3E                  CMP   #3Eh   
E4E3                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E4E3                          ENDIF      
E4E3                          IF   CHECKED   
E4E3   F0 17                  BEQ   ign   ; 7Fh
E4E5   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
E4E7                          ENDIF      
E4E7                             ; The three adjustments below chain. Each ADC adds the carry the one
E4E7                             ; before it left, which the constants allow for.
E4E7   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E4E9   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E4EB   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E4ED                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E4ED                             ; the index is N1 or more, plus one more if it is N2 or more.
E4ED   C9 08        PUNCT:    CMP   #N1   
E4EF   A8                     TAY      
E4F0   A9 70                  LDA   #HALFPG   
E4F2   2A                     ROL      ; the first page, or the second (carry clear)
E4F3   C0 15                  CPY   #N2   
E4F5   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E4F7   48                     PHA      
E4F8   B9 21 E5               LDA   PTAB,Y   
E4FB   48                     PHA      
E4FC   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E4FD                             ; directly, it just ends an ignored character.
E4FD                ENDP:        ; the program has ended
E4FD                          IF   CHECKED   
E4FD   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E4FF   F0 A3                  BEQ   e_undef   
E501                          ENDIF      
E501   4C 09 FF               JMP   EXIT   
E504                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E504                             ; the return stack, and the IP becomes the address in the letter's cell.
E504   0A           UPPER:    ASL      
E505   A8                     TAY      
E506   38                     SEC      
E507   4C E8 E0               JMP   pushn   
E50A   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E50C   A4 01                  LDY   IP+1   
E50E   D0 03                  BNE   pushay   ; always: no program is in page zero
E510                             ; a-z: push the cell's address (the cell is the variable)
E510   0A           LOWER:    ASL      
E511   A0 04                  LDY   #>LET   
E513                             ; pushay: push a cell: A = its low byte, Y = its high byte
E513   CA           PUSHAY:   DEX      
E514   CA                     DEX      
E515   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E517   94 01                  STY   1,X   
E519   60                     RTS      
E51A                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E51A   E8           FLAG:     INX      
E51B   E8                     INX      
E51C   B5 FE                  LDA   0FEh,X   
E51E   15 FF                  ORA   0FFh,X   
E520   60                     RTS      
E521                             ; =============================================================================
E521                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E521                             ;  character, in code order.
E521                             ; =============================================================================
E521   B7           PTAB:     DB   (h_store-1) & 0FFh   ; !
E522   65                     DB   (h_str-1) & 0FFh   ; "
E523   8B                     DB   (h_num-1) & 0FFh   ; #
E524   39                     DB   (h_print-1) & 0FFh   ; $
E525   C6                     DB   (h_swap-1) & 0FFh   ; %
E526   D7                     DB   (h_and-1) & 0FFh   ; &
E527   83                     DB   (h_emit-1) & 0FFh   ; '
E528   E2                     DB   (h_open-1) & 0FFh   ; (
E529   C4                     DB   (h_close-1) & 0FFh   ; )
E52A   67                     DB   (h_mul-1) & 0FFh   ; *
E52B   31                     DB   (h_add-1) & 0FFh   ; +
E52C   BB                     DB   (h_cfetch-1) & 0FFh   ; ,
E52D   28                     DB   (h_sub-1) & 0FFh   ; -
E52E   1C                     DB   (h_cstore-1) & 0FFh   ; .
E52F   92                     DB   (h_div-1) & 0FFh   ; /
E530   15                     DB   (h_dup-1) & 0FFh   ; :
E531   25                     DB   (drop-1) & 0FFh   ; ;
E532   46                     DB   (h_lt-1) & 0FFh   ; <
E533   57                     DB   (h_eq-1) & 0FFh   ; =
E534   43                     DB   (h_gt-1) & 0FFh   ; >
E535   CB                     DB   (h_key-1) & 0FFh   ; ?
E536   80                     DB   (h_fetch-1) & 0FFh   ; @
E537   A5                     DB   (h_def-1) & 0FFh   ; [
E538   28                     DB   (h_break-1) & 0FFh   ; \
E539   3C                     DB   (h_ret-1) & 0FFh   ; ]
E53A   6A                     DB   (h_xor-1) & 0FFh   ; ^
E53B   F7                     DB   (h_alloc-1) & 0FFh   ; _
E53C   C9                     DB   (h_grave-1) & 0FFh   ; `
E53D   4E                     DB   (h_tor-1) & 0FFh   ; {
E53E   75                     DB   (h_or-1) & 0FFh   ; |
E53F   5A                     DB   (h_fromr-1) & 0FFh   ; }
E540   67                     DB   (h_not-1) & 0FFh   ; ~
E541                             ; Digits: the first one is in A; read the rest of the number.
E541   A0 00        DIGIT:    LDY   #0   
E543   20 13 E5               JSR   pushay   
E546                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E546                             ; Returns with the carry set.
E546   20 73 E5     RDNUM:    JSR   isdig   
E549   B0 4D                  BCS   ic9   ; (an RTS)
E54B   20 90 E5               JSR   incip   ; (keeps A = the digit)
E54E   16 00                  ASL   0,X   
E550   36 01                  ROL   1,X   ; x2
E552   18                     CLC      
E553   75 00                  ADC   0,X   
E555   85 04                  STA   T0   
E557   B5 01                  LDA   1,X   
E559   69 00                  ADC   #0   
E55B   A8                     TAY      ; Y:T0 = x2 + digit
E55C   16 00                  ASL   0,X   
E55E   36 01                  ROL   1,X   
E560   16 00                  ASL   0,X   
E562   36 01                  ROL   1,X   ; x8
E564   18                     CLC      
E565   B5 00                  LDA   0,X   
E567   65 04                  ADC   T0   
E569   95 00                  STA   0,X   
E56B   98                     TYA      
E56C   75 01                  ADC   1,X   
E56E   95 01                  STA   1,X   ; x8 + x2 + digit
E570   4C 46 E5               JMP   rdnum   
E573                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E573                             ; digit. Y = 0.
E573   20 99 E5     ISDIG:    JSR   peek   
E576   38                     SEC      
E577   E9 30                  SBC   #"0"   
E579   C9 0A                  CMP   #10   
E57B   60                     RTS      
E57C                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E57C                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E57C   20 73 E5     RDHEX:    JSR   isdig   
E57F   90 0F                  BCC   incip   
E581   29 DF                  AND   #0DFh   
E583   E9 11                  SBC   #11h   ; (the carry is set)
E585   C9 06                  CMP   #6   
E587   B0 0F                  BCS   ic9   
E589   69 0A                  ADC   #10   
E58B   D0 03                  BNE   incip   ; always
E58D                             ; Reading the program
E58D                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E58D                             ;    getc: the same, then IP moves on; flags follow A
E58D                             ;    incip: IP moves on; keeps A, the carry and Y
E58D   20 99 E5     GETC:     JSR   peek   
E590   E6 00        INCIP:    INC   IP   
E592   D0 02                  BNE   ic1   
E594   E6 01                  INC   IP+1   
E596   09 00        IC1:      ORA   #0   
E598   60           IC9:      RTS      
E599   A0 00        PEEK:     LDY   #0   
E59B   B1 00                  LDA   (IP),Y   
E59D   60                     RTS      
E59E                             ; rstip: point IP at the start of the program
E59E   A9 00        RSTIP:    LDA   #<PROG   
E5A0   85 00                  STA   IP   
E5A2   A9 05                  LDA   #>PROG   
E5A4   85 01                  STA   IP+1   
E5A6   60                     RTS      
E5A7                          IF   CHECKED   
E5A7                             ; =============================================================================
E5A7                             ;  Checked build: the error report
E5A7                             ; =============================================================================
E5A7                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E5A7                             ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
E5A7                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E5A7                             ; its depth is shown.
E5A7                             ;   CR LF
E5A7                             ;   Err X @ line,col CR LF
E5A7                             ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
E5A7                             ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
E5A7                             ;   Rtn n CR LF
E5A7                             ; The numbers go through "#" (prnum), which pushes them over the data stack
E5A7                             ; and pops them again, so the stack is shown as it was. With the stack full
E5A7                             ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
E5A7   48           ERROR:    PHA      ; the letter
E5A8   A5 08                  LDA   PLACE   
E5AA   85 02                  STA   P   
E5AC   A5 09                  LDA   PLACE+1   
E5AE   85 03                  STA   P+1   ; (CO is the report's scratch from here on)
E5B0   A0 17                  LDY   #M_ERR-MSG   
E5B2   20 A0 E3               JSR   prs   ; CR LF "Err "
E5B5   68                     PLA      
E5B6   20 03 FF               JSR   CONOUT   
E5B9   20 A0 E3               JSR   prs   ; " @ " (it follows M_ERR)
E5BC   20 82 E6               JSR   lcol   
E5BF   A5 0A                  LDA   LN   
E5C1   A4 0B                  LDY   LN+1   
E5C3   20 48 E6               JSR   prnum   ; the line
E5C6   A9 2C                  LDA   #","   
E5C8   20 03 FF               JSR   CONOUT   
E5CB   A5 08                  LDA   CO   
E5CD   A4 09                  LDY   CO+1   
E5CF   20 48 E6               JSR   prnum   ; the column
E5D2   A0 20                  LDY   #M_NL-MSG   
E5D4   20 A0 E3               JSR   prs   
E5D7   A0 00                  LDY   #0   ; the text at the place
E5D9   B1 02        ER1:      LDA   (P),Y   
E5DB   F0 10                  BEQ   er2   
E5DD   C9 0D                  CMP   #13   
E5DF   F0 0C                  BEQ   er2   
E5E1   C9 0A                  CMP   #10   
E5E3   F0 08                  BEQ   er2   
E5E5   20 03 FF               JSR   CONOUT   
E5E8   C8                     INY      
E5E9   C0 10                  CPY   #16   
E5EB   D0 EC                  BNE   er1   
E5ED   A0 22        ER2:      LDY   #M_STK-MSG   
E5EF   20 A0 E3               JSR   prs   ; CR LF "Stk "
E5F2   8A                     TXA      
E5F3   49 FF                  EOR   #0FFh   
E5F5   38                     SEC      
E5F6   E9 0F                  SBC   #0FFh-DSE   
E5F8   4A                     LSR      ; the depth, (DSE - X) / 2
E5F9   48                     PHA      
E5FA   20 46 E6               JSR   prnum8   
E5FD   68                     PLA      
E5FE   A0 2D                  LDY   #M_C-MSG   ; ":"
E600   C9 09                  CMP   #9   
E602   90 04                  BCC   er3   
E604   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E606   A0 28                  LDY   #M_CD-MSG   
E608   85 08        ER3:      STA   CO   ; CO = how many cells to show
E60A   20 A0 E3               JSR   prs   
E60D   A5 08        ER4:      LDA   CO   ; cells CO-1 down to 0, the top last: cell i
E60F   F0 1F                  BEQ   er5   ;   from the top is at X+2i
E611   C6 08                  DEC   CO   
E613   A9 20                  LDA   #" "   
E615   20 03 FF               JSR   CONOUT   
E618   A5 08                  LDA   CO   
E61A   0A                     ASL      
E61B   85 09                  STA   CO+1   
E61D   8A                     TXA      
E61E   65 09                  ADC   CO+1   ; (the carry is clear)
E620   A8                     TAY      
E621   B9 00 00               LDA   0,Y   
E624   48                     PHA      
E625   B9 01 00               LDA   1,Y   
E628   A8                     TAY      
E629   68                     PLA      
E62A   20 48 E6               JSR   prnum   
E62D   4C 0D E6               JMP   er4   
E630   A0 2E        ER5:      LDY   #M_RTN-MSG   
E632   20 A0 E3               JSR   prs   ; CR LF "Rtn "
E635   AD 35 04               LDA   RSV   
E638   49 FF                  EOR   #0FFh   
E63A   4A                     LSR      ; (FFh - S) / 2 entries
E63B   20 46 E6               JSR   prnum8   
E63E   A0 20                  LDY   #M_NL-MSG   
E640   20 A0 E3               JSR   prs   
E643   4C 09 FF               JMP   EXIT   
E646                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
E646                             ; prnum8: the same for A alone, 0-255.
E646   A0 00        PRNUM8:   LDY   #0   
E648   20 13 E5     PRNUM:    JSR   pushay   
E64B   4C 8C E0               JMP   h_num   
E64E                          ENDIF      
E64E                          IF   CHECKED+ANSI   
E64E                MSG:         
E64E                          ENDIF      
E64E                          IF   ANSI   
E64E   1B 5B 48 1B 5B CA M_CLS:   DB   27,"[","H",27,"[","J"+80h   
E654   1B 5B 3F 32 35 E8 M_SHOW:   DB   27,"[","?","2","5","h"+80h   
E65A   1B 5B 3F 32 35 EC M_HIDE:   DB   27,"[","?","2","5","l"+80h   
E660   1B 5B CB     M_EOL:    DB   27,"[","K"+80h   
E663   1B DB        M_CSI:    DB   27,"["+80h   
E665                          ENDIF      
E665                          IF   CHECKED   
E665   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E66B   20 40 A0               DB   " @"," "+80h   
E66E   0D 8A        M_NL:     DB   13,10+80h   
E670   0D 0A 53 74 6B A0 M_STK:   DB   13,10,"Stk"," "+80h   
E676   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E67B   BA           M_C:      DB   ":"+80h   
E67C   0D 0A 52 74 6E A0 M_RTN:   DB   13,10,"Rtn"," "+80h   
E682                          ENDIF      
E682                          IF   CHECKED   
E682                             ; lcol: the line (LN) and the column (CO) of the place at P, both from
E682                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
E682                             ; column is the place in the buffer. Otherwise IP (free now: the program has
E682                             ; stopped) runs from PROG to the place, counting LFs; CO keeps where the
E682                             ; last line started, and the column is the place minus that, plus 1.
E682   A9 00        LCOL:     LDA   #0   
E684   85 0B                  STA   LN+1   
E686   85 0A                  STA   LN   
E688   A9 80                  LDA   #<LINEBUF   
E68A   85 08                  STA   CO   
E68C   A9 04                  LDA   #>LINEBUF   
E68E   85 09                  STA   CO+1   
E690   A5 02                  LDA   P   
E692   C9 00                  CMP   #<PROG   
E694   A5 03                  LDA   P+1   
E696   E9 05                  SBC   #>PROG   
E698   90 26                  BCC   lc9   ; below the program: line 0
E69A   E6 0A                  INC   LN   
E69C   20 9E E5               JSR   rstip   
E69F   A5 00        LC3:      LDA   IP   ; a line starts here
E6A1   85 08                  STA   CO   
E6A3   A5 01                  LDA   IP+1   
E6A5   85 09                  STA   CO+1   
E6A7   A5 00        LC1:      LDA   IP   
E6A9   C5 02                  CMP   P   
E6AB   A5 01                  LDA   IP+1   
E6AD   E5 03                  SBC   P+1   
E6AF   B0 0F                  BCS   lc9   ; at the place
E6B1   20 8D E5               JSR   getc   
E6B4   C9 0A                  CMP   #10   
E6B6   D0 EF                  BNE   lc1   
E6B8   E6 0A                  INC   LN   ; an LF: a new line starts after it
E6BA   D0 E3                  BNE   lc3   
E6BC   E6 0B                  INC   LN+1   
E6BE   D0 DF                  BNE   lc3   ; always
E6C0   A5 02        LC9:      LDA   P   
E6C2   38                     SEC      
E6C3   E5 08                  SBC   CO   
E6C5   85 08                  STA   CO   
E6C7   A5 03                  LDA   P+1   
E6C9   E5 09                  SBC   CO+1   
E6CB   85 09                  STA   CO+1   
E6CD   E6 08                  INC   CO   ; + 1
E6CF   D0 02                  BNE   lc8   
E6D1   E6 09                  INC   CO+1   
E6D3   60           LC8:      RTS      
E6D4                          ENDIF      


