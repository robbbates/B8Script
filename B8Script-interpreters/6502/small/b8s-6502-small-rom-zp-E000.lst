                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_OR:    LDA   0,X   ; |
                              ORA   2,X   
                              STA   2,X   
                              LDA   1,X   
                              ORA   3,X   
                              STA   3,X   
                              INX      
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
