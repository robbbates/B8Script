                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUM:      PSHS   Y   ; M
                              LDB   <18h   
                              LDA   <19h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuM1   
                              JSR   pk1   
                              ;*Macro unroll: fuM1:   NEXTF
                    FUM1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUN:      PSHS   Y   ; N
                              LDB   <1Ah   
                              LDA   <1Bh   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuN1   
                              JSR   pk1   
                              ;*Macro unroll: fuN1:   NEXTF
                    FUN1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUO:      PSHS   Y   ; O
                              LDB   <1Ch   
                              LDA   <1Dh   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuO1   
                              JSR   pk1   
                              ;*Macro unroll: fuO1:   NEXTF
                    FUO1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUP:      PSHS   Y   ; P
                              LDB   <1Eh   
                              LDA   <1Fh   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuP1   
                              JSR   pk1   
                              ;*Macro unroll: fuP1:   NEXTF
                    FUP1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
