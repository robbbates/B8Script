021F   4D                     MOV   C,L   ; ... jump to it ...
0220   EB                     XCHG      
0221   C3 06 05               JMP   rpushd   ; ... and push it back (which drops the flag)
0224                          ENDIF      
0224                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0224                             ; "-" has two jobs: directly before a digit it starts a negative number.
0224   0A           H_SUB:    LDAX   B   
