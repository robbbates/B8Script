0661                             ; HL = TOS, and both stacks as the report is to show them:
0661                             ; 
0661                             ;   Err X @ line,col
0661                             ;   D:n: the top 8 cells at most, bottom to top
0661                             ;   R:n
0661   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
0662   5F                     MOV   E,A   
0663   CD F6 05               CALL   pnl   
0666   45 72 72 20 22         DB   "Err ",22h   
066B   7B                     MOV   A,E   
066C                          ;*Macro unroll:  PUTA
066C   EF                     DS   1-CPM,0EFh   
066D                          DS   CPM,0CDh   
066D                          DS   CPM,APUT&0FFh   
066D                          DS   CPM,APUT/256   
066D   CD FC 05               CALL   pmsg   
0670   20 40 20 22            DB   " @ ",22h   
0674   0B                     DCX   B   ; BC = the place
