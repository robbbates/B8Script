                    H_MUL:    LDA   3,U   
                              LDB   ,U   
                              MUL      ; al*bh
                              STB   ,U   ; (bh is no longer needed)
                              LDA   2,U   
                              LDB   1,U   
                              MUL      ; ah*bl
                              ADDB   ,U   
                              STB   ,U   ; the cross terms, low byte
E1AA                          ENDIF      
