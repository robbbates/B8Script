   914 000002BE 7505                <1>         jne     .sk2
   915 000002C0 E8E1FFFFFF          <1>         call    skipstr                 ; leaves AL = 22h, which matches
   916 000002C5 2C28                <1> .sk2:   sub     al,'('                  ;   nothing below (or 0: then the
   917 000002C7 74E9                <1>         jz      .sk3                    ;   NUL is read next)
   918 000002C9 FEC8                <1>         dec     al                      ; ')'
   919 000002CB 7408                <1>         jz      .sk4
   920 000002CD 2C32                <1>         sub     al,'['-')'
   921 000002CF 74E1                <1>         jz      .sk3
