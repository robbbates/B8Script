E4DA   60           RH9:      RTS      
E4DB                             ; =============================================================================
E4DB                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E4DB                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E4DB                             ;  Both keep X and Y.
E4DB                             ; =============================================================================
E4DB                GETK:        
E4DB                          IF   CHECKED   
                              LDA   KEYBUF   ; a key held back by the break check
                              BEQ   gk1   
                              PHA      
                              LDA   #0   
                              STA   KEYBUF   
                              PLA      
                              RTS      
                    GK1:         
E4DB                          ENDIF      
E4DB   20 06 FF               JSR   CONST   
E4DE   C9 00                  CMP   #0   
E4E0   F0 05                  BEQ   gk9   
E4E2   20 00 FF               JSR   CONIN   
E4E5   C9 00                  CMP   #0   
E4E7   60           GK9:      RTS      
E4E8                             ; =============================================================================
E4E8                             ;  Checked build: break key and error reports
E4E8                             ; =============================================================================
E4E8                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   LDA   KEYBUF   
                              BNE   cb9   ; one key is already held
                              JSR   getk   
                              BEQ   cb9   
                              CMP   #3   
                              BEQ   e_break   
                              STA   KEYBUF   
                    CB9:      RTS      
                    E_BREAK:   JSR   error   
                              DB   "brea","k"+80h   
                                 ; error: print CR LF, the word after the JSR (last character has bit 7
                                 ; set), " at " and the offset of the reading position in the program.
                    ERROR:    PLA      
                              STA   T0   
                              PLA      
                              STA   T1   ; (T0) + 1 = the word
                              LDX   #0FFh   
                              TXS      ; the stacks may be wrecked: start clean
                              LDX   #DSE   
                              LDA   #13   
                              JSR   CONOUT   
                              LDA   #10   
                              JSR   CONOUT   
                              LDY   #1   
                    ER1:      LDA   (T0),Y   
                              INY      
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              PLA      
                              BPL   er1   
                              LDY   #0   
                    ER3:      LDA   er2,Y   
                              JSR   CONOUT   
                              INY      
                              CPY   #4   
                              BNE   er3   
                              LDA   IP   
                              SEC      
                              SBC   #<PROG1   ; the character just read
                              STA   TL   
                              LDA   IP+1   
                              SBC   #>PROG1   
                              STA   TH   
                              JSR   h_num   
                              JMP   endprog   
                    ER2:      DB   " at "   
E4E8                          ENDIF      


