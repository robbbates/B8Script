  1773                              <1> 
  1774                              <1> ; =============================================================================
  1775                              <1> ;  The letters and digits, the return stack's push, and the inner loop
  1776                              <1> ; =============================================================================
  1777                              <1> 
  1778                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
  1779                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
  1780 00000BD0 89F2                <1> upper:  mov     edx,esi
  1781 00000BD2 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
  1782                              <1> 
  1783                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
  1784                              <1> ; return stack ends here, and the true ')' comes to rpoll.
  1785                              <1> ;
  1786                              <1> ; The break key is looked at here, so at every word call and loop-back (and
  1787                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
  1788 00000BDA 83EF04              <1> rpush:  sub     edi,4
  1789 00000BDD 8917                <1>         mov     [edi],edx
  1790 00000BDF FE4D6B              <1> rpoll:  dec     byte [V(v_pcnt)]
  1791 00000BE2 7505                <1>         jnz     .rp1
  1792 00000BE4 E8D5F9FFFF          <1>         call    pollk
  1793 00000BE9 FFE5                <1> .rp1:   jmp     ebp
  1794                              <1> 
  1795                              <1> ; =============================================================================
  1796                              <1> ;  The inner loop: read one character and sort it by range.
  1797                              <1> ;
  1798                              <1> ;    00h          end of program
  1799                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1800                              <1> ;                 build stops on 80h-FFh: X)
  1801                              <1> ;    30h-39h      digit: read a whole number
  1802                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1803                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1804                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1805                              <1> ; =============================================================================
  1806                              <1> ; Digits: step back onto the first digit and read the whole number.
  1807 00000BEB 53                  <1> digit:  push    ebx
  1808 00000BEC 4E                  <1>         dec     esi
  1809 00000BED E81CF8FFFF          <1>         call    rdnum
  1810 00000BF2 FFE5                <1>         jmp     ebp
  1811                              <1> 
  1812                              <1> ; a-z: push the cell's address (the cell is the variable).
  1813 00000BF4 53                  <1> lower:  push    ebx
  1814 00000BF5 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1815 00000BFC FFE5                <1>         jmp     ebp
  1816                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1817                              <1> ; next in reach)
  1818 00000BFE 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1819 00000C00 750C                <1>         jnz     next                    ; the rest are ignored
  1820 00000C02 E9F2F9FFFF          <1>         jmp     endprog
  1821                              <1> %if CHECKED
  1822 00000C07 B058                <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1823 00000C09 E9FEF6FFFF          <1>         jmp     error
  1824                              <1> %endif
  1825                              <1> next:
  1826                              <1> %if CHECKED
  1827 00000C0E E8A7F6FFFF          <1>         call    chkstk                  ; both stacks, once per character
  1828                              <1> %endif
  1829 00000C13 31C0                <1>         xor     eax,eax
  1830 00000C15 AC                  <1>         lodsb
  1831 00000C16 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1832 00000C18 72E4                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1833 00000C1A 3C0F                <1>         cmp     al,0Fh
  1834 00000C1C 7224                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1835 00000C1E 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1836 00000C20 3C0A                <1>         cmp     al,0Ah
  1837 00000C22 72C7                <1>         jb      digit                   ; 30h-39h
  1838 00000C24 3C11                <1>         cmp     al,11h
  1839 00000C26 7218                <1>         jb      p3a                     ; 3Ah-40h
  1840 00000C28 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1841 00000C2A 3C1A                <1>         cmp     al,1Ah
  1842 00000C2C 72A2                <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1843 00000C2E 3C20                <1>         cmp     al,20h
  1844 00000C30 720C                <1>         jb      p5b                     ; 5Bh-60h
  1845 00000C32 3C3A                <1>         cmp     al,3Ah
  1846 00000C34 72BE                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1847 00000C36 3C3E                <1>         cmp     al,3Eh
  1848                              <1> %if CHECKED
  1849 00000C38 74D4                <1>         je      next                    ; 7Fh, DEL: ignored
  1850 00000C3A 73CB                <1>         jae     e_hi                    ; 80h-FFh: reserved
  1851                              <1> %else
  1852                              <1>         jae     next                    ; 7Fh-FFh: ignored
  1853                              <1> %endif
  1854 00000C3C 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1855 00000C3E 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1856 00000C40 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1857 00000C42 8A80[080A0000]      <1> punct:  mov     al,[ptab+eax]
  1858 00000C48 8D80[F8000000]      <1>         lea     eax,[hbase+eax]
  1859 00000C4E FFE0                <1>         jmp     eax
  1860                              <1> 
  1861                              <1> codeend:
  1862                              <1> 
  1863                              <1> rawend:
  1864                              <1> RAWSIZE equ     (rawend-tstart+1FFh) & ~1FFh
  1865 00000C50 00<rep 1B0h>        <1>         times   (-(rawend-tstart)) & 1FFh db 0
  1866                              <1> 
  1867                              <1> ; ---- the interpreter's variables, after the code (zero at the start) -------
  1868                              <1> ; They are in the zeros that pad the section to its FileAlignment, or past
  1869                              <1> ; them in the uninitialised part: within 127 bytes of `next` either way.
  1870                              <1>         absolute rawend
  1871 00000C50 <res 14h>           <1> v_rec:  resb    20              ; an INPUT_RECORD; ReadFile's byte
  1872 00000C64 ????????            <1> v_cnt:  resd    1               ; a count for ReadFile and the like
  1873 00000C68 ????????            <1> v_hin:  resd    1               ; the standard input handle
  1874 00000C6C ????????            <1> v_htm:  resd    1               ; the timer, or 0 (must follow v_hin)
  1875 00000C70 ????????            <1> v_outh: resd    1               ; the handle putc writes to
  1876 00000C74 ????????            <1> v_dstop:resd    1               ; ESP for the empty data stack
  1877 00000C78 ??                  <1> v_iscon:resb    1               ; non-zero if the input is a console
  1878 00000C79 ??                  <1> v_pcnt: resb    1               ; the break key's countdown
  1879 00000C7A ????????            <1> v_mode: resd    1               ; the console's input mode at the start
  1880 00000C7E ????????            <1> v_npend:resd    1               ; the heap's first address (checked '_')
  1881 00000C82 ????????            <1> v_skat: resd    1               ; where the skip started (checked N)
  1882 00000C86 ????????            <1> v_edln: resd    1               ; the editor: the line ^E put in the input
  1883                              <1> v_end:
  1884                              <1>         times   -((v_end-next) > 128) db 0      ; (an error if out of reach)
  1885                              <1>         times   -((next-iat) > 128) db 0
