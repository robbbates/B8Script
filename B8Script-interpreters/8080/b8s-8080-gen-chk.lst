031A   22 76 82               SHLD   SEED   
031D   AD                     XRA   L   ; (A is still the high byte)
031E   6F                     MOV   L,A   
031F   CD 7A 02               CALL   udiv   ; BC = the remainder
0322   60                     MOV   H,B   
0323   69                     MOV   L,C   
0324   C1                     POP   B   
0325   F7                     RST   6   
0326                             ; `< and `>: one routine. b < a (signed) is the borrow of b - a, turned
0326                             ; round if the two signs differ: RAR puts the borrow in bit 7, where the two
0326                             ; XRAs meet it. Then the character is read again, 3Ch or 3Eh: RAR leaves
0326                             ; 1Eh or 1Fh under the flag, and adding 61h carries into the flag for 1Fh
0326                             ; only. So the carry ends up saying "keep b" for either character.
0326   D1           G_MIN:    POP   D   ; DE = a, HL = b
0327   7D                     MOV   A,L   
0328   93                     SUB   E   
0329   7C                     MOV   A,H   
032A   9A                     SBB   D   
032B   1F                     RAR      
032C   AC                     XRA   H   
032D   AA                     XRA   D   
032E   17                     RAL      ; carry: b < a
032F   0B                     DCX   B   
0330   0A                     LDAX   B   
0331   03                     INX   B   
0332   1F                     RAR      
