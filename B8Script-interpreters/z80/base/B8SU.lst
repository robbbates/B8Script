0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as line
0000                             ;                 and column, and both stacks. See `error`.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   1   ; 0 = small, 1 = base, 2 = fast (not with EDITOR) (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
0000                EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC and
                                 ; IY, and all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
                                 ;   at the heap limit, which the heap never reaches
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
                    PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
                    ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (fast build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (fast build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 08               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM*(1-EDITOR)   
0103   C3 9F 05               JP   start   ; 03
0106                          ENDIF      
0106                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0106                          ENDIF      
0106                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0106                          ENDIF      
0106                          IF   1-CPM   
                                 ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
                    RPOP:     LD   E,(IY+0)   ; 08
                              LD   D,(IY+1)   
                              JR   rp2   ; (the rest is at 2Bh)
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
                              JR   NZ,next0   ;     the rest are ignored
                    ENDPROG:   JP   EXIT   ;     the program has ended
                              NOP      ; 17  spare
                                 ; ---- RST 18h: drop TOS, then next ------------------------------------------
                    RST18:    POP   DE   ; 18  discard the RST's return address
                    DRP:      POP   HL   ;     new TOS = NOS
                              JR   next0   
0106                          ENDIF      
0106   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
0107                          ;*Macro unroll:  POPR
0107                          DS   1-CPM,0CFh   
0107   CD                     DS   CPM,0CDh   
0108   6F                     DS   CPM,AROP&0FFh   
0109   05                     DS   CPM,AROP/256   
010A   EB                     EX   DE,HL   
010B                          ;*Macro unroll:  NEXTZ
010B                          DS   1-CPM,0F7h   
010B   DD                     DS   CPM,0DDh   
010C   E9                     DS   CPM,0E9h   
010D                          IF   1-CPM   
                                 ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
                    NEG16:    XOR   A   ; 20
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
                              NOP      ; 27  spare
                                 ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
                    RST28:       
                    PUTC:     JP   CONOUT   ; 28
                    RP2:      INC   IY   ; 2B  the rest of rpop
                              INC   IY   
                              RET      
                                 ; ---- RST 30h: next character -----------------------------------------------
                    RST30:    POP   DE   ; 30  discard the RST's return address
010D                          ENDIF      
010D                          IF   CPM   
010D                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
010D   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
010F   20 03                  JR   NZ,next0   ; the rest are ignored
0111   C3 00 00     ENDPROG:   JP   EXIT   ; the program has ended
0114                          ENDIF      
0114                             ; =============================================================================
0114                             ;  The inner loop: read one character and sort it by range.
0114                             ; 
0114                             ;    00h          end of program
0114                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0114                             ;    30h-39h      digit: read a whole number
0114                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0114                             ;    61h-7Ah      a-z: push the address of that letter's cell
0114                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0114                             ; =============================================================================
0114                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0114                          ENDIF      
0114                          IF   1-FAST   
0114                NEXT0:       
0114                          ENDIF      
0114                          IF   CHECKED*(1-FAST)   
                              CALL   chkstk   ; both stacks are checked once per character
0114                          ENDIF      
0114                          IF   1-FAST   
0114   0A                     LD   A,(BC)   
0115   03                     INC   BC   
0116   D6 21                  SUB   21h   ; A = c - 21h
0118   38 F3                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
011A   FE 0F                  CP   0Fh   
011C   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
011E   D6 0F                  SUB   0Fh   ; A = c - 30h
0120   FE 0A                  CP   0Ah   
0122   38 74                  JR   C,digit   ; 30h-39h
0124   FE 11                  CP   11h   
0126   38 16                  JR   C,p3a   ; 3Ah-40h
0128   D6 11                  SUB   11h   ; A = c - 41h
012A   FE 1A                  CP   1Ah   
012C   38 74                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
012E   FE 20                  CP   20h   
0130   38 0A                  JR   C,p5b   ; 5Bh-60h
0132   FE 3A                  CP   3Ah   
0134   38 69                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0136   FE 3E                  CP   3Eh   
0138                          ENDIF      
0138                          IF   (1-CHECKED)*(1-FAST)   
0138   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
013A                          ENDIF      
013A                          IF   CHECKED*(1-FAST)   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
013A                          ENDIF      
013A                          IF   1-FAST   
013A   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
013C   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
013E   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0140                          ENDIF      
0140                .macro PTABLE,
0140                             ; 
0140                 DB      h_store & 0FFh  ; !
0140                 DB      h_str & 0FFh    ; "
0140                 DB      h_num & 0FFh    ; #
0140                 DB      h_print & 0FFh  ; $
0140                 DB      h_swap & 0FFh   ; %
0140                 DB      h_and & 0FFh    ; &
0140                 DB      h_emit & 0FFh   ; '
0140                 DB      h_open & 0FFh   ; (
0140                 DB      h_close & 0FFh  ; )
0140                 DB      h_mul & 0FFh    ; *
0140                 DB      h_add & 0FFh    ; +
0140                 DB      h_cfetch & 0FFh ; ,
0140                 DB      h_sub & 0FFh    ; -
0140                 DB      h_cstore & 0FFh ; .
0140                 DB      h_div & 0FFh    ; /
0140                 DB      h_dup & 0FFh    ; :
0140                 DB      h_drop & 0FFh   ; ;
0140                 DB      h_lt & 0FFh     ; <
0140                 DB      h_eq & 0FFh     ; =
0140                 DB      h_gt & 0FFh     ; >
0140                 DB      h_key & 0FFh    ; ?
0140                 DB      h_fetch & 0FFh  ; @
0140                 DB      h_def & 0FFh    ; [
0140                 DB      h_break & 0FFh  ; \
0140                 DB      h_ret & 0FFh    ; ]
0140                 DB      h_xor & 0FFh    ; ^
0140                 DB      h_alloc & 0FFh  ; _
0140                 DB      h_grave & 0FFh  ; `
0140                 DB      h_tor & 0FFh    ; {
0140                 DB      h_or & 0FFh     ; |
0140                 DB      h_fromr & 0FFh  ; }
0140                 DB      h_not & 0FFh    ; ~
0140                .endm
0140                 
0140                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0140                             ; untouched, and A, DE free.
0140                          IF   1-FAST   
0140   C6 11        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0142   5F                     LD   E,A   
0143   16 05                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0145   FE 27                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0147   1A                     LD   A,(DE)   
0148   5F                     LD   E,A   ; the handler's low byte
0149                          ENDIF      
0149                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
                              LD   D,0   
0149                          ENDIF      
0149                          IF   (1-CPM)*(1-FAST)   
                              RL   D   ; its page: 0 + carry
0149                          ENDIF      
0149                          IF   CPM*(1-FAST)   
0149   16 01                  LD   D,1   
014B   30 01                  JR   NC,pu1   
014D   14                     INC   D   ; its page: 1 + carry
014E                PU1:         
014E                          ENDIF      
014E                          IF   1-FAST   
014E   D5                     PUSH   DE   ; jump to it; the stack is balanced again
014F   C9                     RET      ;   when the handler starts
0150                          ENDIF      
0150                             ; The rest of the startup: here so that the generic reset code can reach it
0150                             ; with JR. st0: find the program's NUL; the heap starts after it.
0150                             ; (The editor build has its own copy of this, next to the editor.)
0150                             ; A checked build first clears the lower half of the letter page (A = 0):
0150                             ; every variable starts at 0, every word cell holds 0000h, the address an
0150                             ; undefined word is caught at (see e_hi), and no key is held back.
0150                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0150                          ENDIF      
0150                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0150                          ENDIF      
0150                          IF   1-EDITOR   
0150   22 7C 09     ST2:      LD   (HEAP),HL   
0153                          ENDIF      
0153                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0153                          ENDIF      
0153                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0153                          ENDIF      ;   these)
0153                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
0153   21 00 00               LD   HL,0   
0156                          ENDIF      
0156                          IF   (1-CHECKED)*(1-EDITOR)   
0156   22 7A 09               LD   (KEYBUF),HL   
0159                          ENDIF      
0159                          IF   1-EDITOR   
0159                          ;*Macro unroll:  SETIX
0159   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
015A   21                     DS   CPM+FAST-CPM*FAST,21h   
015B   14                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
015C   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
015D   FD 21 E0 07            LD   IY,RSTOP   ; the return stack is empty
0161                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0161                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0161   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0162   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0163                          ENDIF      
0163                             ; In the unchecked generic editor build the table is here, in the first
0163                             ; page, which saves loading D twice. (The other builds have no room for it
0163                             ; here: theirs is further down.)
0163                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0163                          ENDIF      
0163                             ; =============================================================================
0163                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0163                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0163                             ;  is here too: it belongs to "`" and makes the page come out right.
0163                             ; =============================================================================
0163   D1           H_XOR:    POP   DE   
0164   7C                     LD   A,H   
0165   AA                     XOR   D   
0166   67                     LD   H,A   
0167   7D                     LD   A,L   
0168   AB                     XOR   E   
0169   6F                     LD   L,A   
016A                          ;*Macro unroll:  NEXT
016A                          DS   (1-CPM)*(1-FAST),0F7h   
016A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
016B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
016C   D1           H_OR:     POP   DE   
016D   7C                     LD   A,H   
016E   B2                     OR   D   
016F   67                     LD   H,A   
0170   7D                     LD   A,L   
0171   B3                     OR   E   
0172   6F                     LD   L,A   
0173                          ;*Macro unroll:  NEXT
0173                          DS   (1-CPM)*(1-FAST),0F7h   
0173   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0174   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0175                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0175                H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0175   CD                     DS   CPM,0CDh   
0176   7A                     DS   CPM,ANEG&0FFh   
0177   05                     DS   CPM,ANEG/256   
0178   2B                     DEC   HL   
0179                          ;*Macro unroll:  NEXT
0179                          DS   (1-CPM)*(1-FAST),0F7h   
0179   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
017A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
017B                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
017B                             ; the same either way); TOS is the old pointer.
017B   ED 5B 7C 09  H_ALLOC:   LD   DE,(HEAP)   
017F                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
017F                          ENDIF      
017F   19                     ADD   HL,DE   ; the new top
0180                          IF   CHECKED   
                              CALL   chkhp   
0180                          ENDIF      
0180   22 7C 09               LD   (HEAP),HL   
0183   EB                     EX   DE,HL   
0184                          ;*Macro unroll:  NEXT
0184                          DS   (1-CPM)*(1-FAST),0F7h   
0184   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0185   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0186                          IF   1-CPM*CHECKED   
0186   FD 22 34 09  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
018A   CD C5 01               CALL   jphl   
018D   FD 2A 34 09            LD   IY,(RSAVE)   
0191                          ;*Macro unroll:  SETIX
0191   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0192   21                     DS   CPM+FAST-CPM*FAST,21h   
0193   14                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0194   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0195   E1                     POP   HL   
0196                          ;*Macro unroll:  NEXT
0196                          DS   (1-CPM)*(1-FAST),0F7h   
0196   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0197   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0198                          ENDIF      
0198                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
0198                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
0198                             ; Digits: step back onto the first digit and read the whole number.
0198   E5           DIGIT:    PUSH   HL   
0199   0B                     DEC   BC   
019A   CD DD 03               CALL   rdnum   
019D                          ;*Macro unroll:  NEXT
019D                          DS   (1-CPM)*(1-FAST),0F7h   
019D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
019E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
019F                             ; a-z: push the cell's address (the cell is the variable)
019F                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
019F                          IF   1-SBASEU   
                    LOWER:    PUSH   HL   
                              ADD   A,A   
                              LD   L,A   
                              LD   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
019F                          ENDIF      
019F                          IF   SBASEU   
019F   C3 BF 04     LOWER:    JP   lowq   
01A2                          ENDIF      
01A2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01A2                             ; the return stack, and the IP becomes the address in the letter's cell.
01A2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01A3   EB                     EX   DE,HL   ; park TOS
01A4   87                     ADD   A,A   
01A5   6F                     LD   L,A   
01A6   26 09                  LD   H,LETPAGE   ; HL -> cell
01A8   4E                     LD   C,(HL)   
01A9   2C                     INC   L   
01AA   46                     LD   B,(HL)   ; IP = the word's body
01AB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01AC                             ; rpushn: move the top cell of the data stack (in memory) to the return
01AC                             ; stack, then next. Everything that pushes the return stack ends here.
01AC                             ; 
01AC                             ; The break key is looked at here, so at every word call and loop-back (and
01AC                             ; block entry and "{"), but only one time in 256: PCNT counts them.
01AC                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
01AC   D1           RPUSHN:   POP   DE   
01AD   FD 72 FF               LD   (IY-1),D   
01B0   FD 73 FE               LD   (IY-2),E   
01B3   FD 2B                  DEC   IY   
01B5   FD 2B                  DEC   IY   
01B7   E5                     PUSH   HL   
01B8   21 36 09               LD   HL,PCNT   
01BB   35                     DEC   (HL)   
01BC   E1                     POP   HL   ; (the zero flag lasts)
01BD   CC 31 05               CALL   Z,pollk   
01C0                          ;*Macro unroll:  NEXT
01C0                          DS   (1-CPM)*(1-FAST),0F7h   
01C0   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01C1   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01C2                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
01C2   E3           H_TOR:    EX   (SP),HL   
01C3   18 E7                  JR   rpushn   
01C5   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
01C6                             ; ---- machine code: the grave -----------------------------------------------
01C6                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01C6                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01C6                             ; written and its address is left. An odd last digit is consumed and dropped.
01C6                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01C6                             ; code is entered by CALL with the data stack above the return address; it
01C6                             ; must keep BC, and on return the top cell becomes the new TOS.
01C6   CD E1 04     H_GRAVE:   CALL   hexc   
01C9                          IF   1-CPM*CHECKED   
01C9   30 BB                  JR   NC,exec   
01CB                          ENDIF      
01CB                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
01CB                          ENDIF      
01CB   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01CC   CD E1 04               CALL   hexc   
01CF   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01D1   ED 6F                  RLD      ;   overwrites it
01D3   23                     INC   HL   ; ... and RLD shifts it up under the low one
01D4   CD E1 04               CALL   hexc   
01D7   38 F2                  JR   C,hx1   
01D9   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01DB                          ;*Macro unroll:  NEXT
01DB                          DS   (1-CPM)*(1-FAST),0F7h   
01DB   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01DC   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01DD                             ; ---- where the two pages meet ----------------------------------------------
01DD                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01DD                             ; are in falling code order for this), and where exactly differs between the
01DD                             ; builds: NPG1 follows. Every handler below these four must start in the
01DD                             ; second page, and every one above in the first; chktab.py checks both.
01DD                             ; "]" returns: pop an address and jump to it.
01DD                          ;*Macro unroll: h_ret:  POPR
01DD                H_RET:    DS   1-CPM,0CFh   
01DD   CD                     DS   CPM,0CDh   
01DE   6F                     DS   CPM,AROP&0FFh   
01DF   05                     DS   CPM,AROP/256   
01E0   42                     LD   B,D   
01E1   4B                     LD   C,E   
01E2                          ;*Macro unroll: brk1:   NEXT
01E2                BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
01E2   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01E3   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01E4                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E4                             ; drops the block start, "]" returns. No closer at all ends the program.
01E4   7C           H_BREAK:   LD   A,H   
01E5   B5                     OR   L   
01E6   E1                     POP   HL   
01E7   28 F9                  JR   Z,brk1   
01E9   CD FF 03               CALL   skip   
01EC   B7                     OR   A   ; skip returns 0 for ")"
01ED   20 EE                  JR   NZ,h_ret   
01EF                          ;*Macro unroll: rdrop:  POPR
01EF                RDROP:    DS   1-CPM,0CFh   
01EF   CD                     DS   CPM,0CDh   
01F0   6F                     DS   CPM,AROP&0FFh   
01F1   05                     DS   CPM,AROP/256   
01F2                          ;*Macro unroll:  NEXT
01F2                          DS   (1-CPM)*(1-FAST),0F7h   
01F2   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01F3   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01F4                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01F4                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01F4                             ; the body"s address instead. Either way it then skips to the matching "]'.
01F4                             ; (The unchecked build takes anything that is not a letter as the space; the
01F4                             ; checked build stops on it.)
01F4   0A           H_DEF:    LD   A,(BC)   
01F5   03                     INC   BC   
01F6   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01F8   5F                     LD   E,A   ;   lands 64 bytes up
01F9   E6 DF                  AND   0DFh   ; fold case
01FB   FE 1A                  CP   26   
01FD   30 0B                  JR   NC,def2   ; not a letter
01FF   CB 23                  SLA   E   
0201   16 09                  LD   D,LETPAGE   ; DE -> cell
0203   79                     LD   A,C   
0204   12                     LD   (DE),A   
0205   1C                     INC   E   
0206   78                     LD   A,B   
0207   12                     LD   (DE),A   
0208   18 03                  JR   skipnx   
020A                DEF2:        
020A                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
020A                          ENDIF      
020A   E5                     PUSH   HL   ; an anonymous block: push its address
020B   60                     LD   H,B   
020C   69                     LD   L,C   
020D                SKIPNX:      
020D                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
020D                          ENDIF      ;   opener, the "[", just before where it starts
020D   CD FF 03     SKIPO:    CALL   skip   
0210                          ;*Macro unroll:  NEXT
0210                          DS   (1-CPM)*(1-FAST),0F7h   
0210   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0211   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0212   5E           H_FETCH:   LD   E,(HL)   ; "@"
0213   23                     INC   HL   
0214   56                     LD   D,(HL)   
0215   EB                     EX   DE,HL   
0216                          ;*Macro unroll:  NEXT
0216                          DS   (1-CPM)*(1-FAST),0F7h   
0216   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0217   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0218                             ; =============================================================================
0218                             ;  Handlers that must start in the image's second page.
0218                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0218                             ;  page.
0218                             ; =============================================================================
0218                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0218                             ; the matching ")".
0218   7C           H_OPEN:   LD   A,H   
0219   B5                     OR   L   
021A   E1                     POP   HL   
021B   28 F0                  JR   Z,skipo   
021D   C5                     PUSH   BC   ; the block starts at the IP
021E   18 8C                  JR   rpushn   
0220                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0220                             ; drops it and carries on.
0220   7C           H_CLOSE:   LD   A,H   
0221   B5                     OR   L   
0222   E1                     POP   HL   
0223   28 CA                  JR   Z,rdrop   
0225                          IF   QK   
0225   C3 AE 04               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
0228                          ENDIF      
0228                          IF   1-QK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
0228                          ENDIF      
0228                          IF   (1-QK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
0228                          ENDIF      
0228                          IF   (1-QK)*CPM   
                              JP   rpushn   
0228                          ENDIF      
0228                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0228                             ; "-" has two jobs: directly before a digit it starts a negative number.
0228   0A           H_SUB:    LD   A,(BC)   
0229   D6 30                  SUB   "0"   
022B   FE 0A                  CP   10   
022D   38 07                  JR   C,negnum   
022F                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
022F                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
022F   CD                     DS   CPM,0CDh   
0230   7A                     DS   CPM,ANEG&0FFh   
0231   05                     DS   CPM,ANEG/256   
0232   D1           H_ADD:    POP   DE   
0233   19                     ADD   HL,DE   
0234                          ;*Macro unroll:  NEXT
0234                          DS   (1-CPM)*(1-FAST),0F7h   
0234   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0235   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0236   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0237   CD DD 03               CALL   rdnum   
023A                          ;*Macro unroll:  NEGH
023A                          DS   1-CPM,0E7h   
023A   CD                     DS   CPM,0CDh   
023B   7A                     DS   CPM,ANEG&0FFh   
023C   05                     DS   CPM,ANEG/256   
023D                          ;*Macro unroll:  NEXT
023D                          DS   (1-CPM)*(1-FAST),0F7h   
023D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
023E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
023F   D1           H_AND:    POP   DE   
0240   7C                     LD   A,H   
0241   A2                     AND   D   
0242   67                     LD   H,A   
0243   7D                     LD   A,L   
0244   A3                     AND   E   
0245   6F                     LD   L,A   
0246                          ;*Macro unroll:  NEXT
0246                          DS   (1-CPM)*(1-FAST),0F7h   
0246   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0247   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0248                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0248                             ; cells first. Flipping both sign bits turns a signed compare into an
0248                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0248                             ; carry into -1 or 0 with no branch.
0248   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0249   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
024A   7C                     LD   A,H   
024B   EE 80                  XOR   80h   
024D   67                     LD   H,A   
024E   7A                     LD   A,D   
024F   EE 80                  XOR   80h   
0251   57                     LD   D,A   
0252   ED 52                  SBC   HL,DE   ; carry if HL < DE
0254   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0256                          ;*Macro unroll:  NEXT
0256                          DS   (1-CPM)*(1-FAST),0F7h   
0256   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0257   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0258   D1           H_EQ:     POP   DE   
0259   B7                     OR   A   
025A   ED 52                  SBC   HL,DE   
025C   7C                     LD   A,H   
025D   B5                     OR   L   
025E   FE 01                  CP   1   ; carry only if a - b = 0
0260   18 F2                  JR   tf   
0262                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0262                             ; multiplier shifts up through A:C.
0262                          IF   1-QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0262                          ENDIF      
0262                          IF   QK   
0262   D1           H_MUL:    POP   DE   ; DE = multiplicand
0263   C3 80 04               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0266                          ENDIF      
0266                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0266                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0266                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0266                             ; stops on it.
0266                H_DIV:       
0266                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0266                          ENDIF      
0266   D1                     POP   DE   ; DE = a, HL = b
0267   D5                     PUSH   DE   ; a, for r's sign
0268   7A                     LD   A,D   
0269   AC                     XOR   H   
026A   F5                     PUSH   AF   ; S flag = sign of q
026B   CB 7C                  BIT   7,H   
026D   C4 7A 05               CALL   NZ,neg16   ; HL = |b|
0270   EB                     EX   DE,HL   
0271   CB 7C                  BIT   7,H   
0273   C4 7A 05               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0276   CD 88 03               CALL   udiv   ; HL = q, DE = r
0279   F1                     POP   AF   
027A   FC 7A 05               CALL   M,neg16   ; q's sign
027D   EB                     EX   DE,HL   ; HL = r, DE = q
027E   F1                     POP   AF   ; A = a's high byte
027F   B7                     OR   A   
0280   FC 7A 05               CALL   M,neg16   ; r's sign
0283   D5                     PUSH   DE   ; q under r
0284                          ;*Macro unroll:  NEXT
0284                          DS   (1-CPM)*(1-FAST),0F7h   
0284   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0285   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0286                             ; ---- stack and storage -----------------------------------------------------
0286   E5           H_DUP:    PUSH   HL   ; ":"
0287                          ;*Macro unroll:  NEXT
0287                          DS   (1-CPM)*(1-FAST),0F7h   
0287   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0288   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0289   E3           H_SWAP:   EX   (SP),HL   ; "%"
028A                          ;*Macro unroll:  NEXT
028A                          DS   (1-CPM)*(1-FAST),0F7h   
028A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
028B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
028C                             ; (The checked build tests the address before it takes the value off the
028C                             ; stack, so that an error report shows both.)
028C                H_CSTORE:      ; "." ( c addr -- )
028C                          IF   CHECKED   
                              CALL   chkst   
028C                          ENDIF      
028C   D1                     POP   DE   
028D   73                     LD   (HL),E   
