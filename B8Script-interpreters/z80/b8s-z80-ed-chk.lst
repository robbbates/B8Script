0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet
0001   32 00 83               LD   (PROG),A   
0004                          ENDIF      
0004                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0004                          ENDIF      
0004                          IF   EDGEN*CHECKED   
0004   C3 7E 04               JP   init   ; 04  (and no key held back)
0007                          ENDIF      
0007                          IF   EDGEN   
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 C7 04     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 B7 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 6F 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 5D                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 5F                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 51                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 9C 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 B4        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 02                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE CA                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0072                          ENDIF      
0072                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0072                          ENDIF      
0072                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   HL,0   ; no key is held, and the break key is on
                              LD   (KEYBUF),HL   ;   (the checked build has cleared these)
0072                          ENDIF      
0072                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0072                          ENDIF      
0072                             ; In the unchecked generic editor build the table is here, in the first
0072                             ; page, which saves loading D twice. (The other builds have no room for it
0072                             ; here: theirs is further down.)
0072                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0072                          ENDIF      
0072                             ; =============================================================================
0072                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0072                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0072                             ;  is here too: it belongs to "`" and makes the page come out right.
0072                             ; =============================================================================
0072   D1           H_XOR:    POP   DE   
0073   7C                     LD   A,H   
0074   AA                     XOR   D   
0075   67                     LD   H,A   
0076   7D                     LD   A,L   
0077   AB                     XOR   E   
0078   6F                     LD   L,A   
0079   F7                     RST   30h   
007A   D1           H_OR:     POP   DE   
007B   7C                     LD   A,H   
007C   B2                     OR   D   
007D   67                     LD   H,A   
007E   7D                     LD   A,L   
007F   B3                     OR   E   
0080   6F                     LD   L,A   
0081   F7                     RST   30h   
0082   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0083   2B                     DEC   HL   
0084   F7                     RST   30h   
0085                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0085                             ; the same either way); TOS is the old pointer.
0085   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0089                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0089                          ENDIF      
0089   19                     ADD   HL,DE   ; the new top
008A                          IF   CHECKED   
008A   CD 35 03               CALL   chkhp   
008D                          ENDIF      
008D   22 7C 82               LD   (HEAP),HL   
0090   EB                     EX   DE,HL   
0091   F7                     RST   30h   
0092   D9           EXEC:     EXX      
0093   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
0096   D9                     EXX      
0097   CD 2B 00               CALL   jphl   
009A   D9                     EXX      
009B   2A 34 82               LD   HL,(RSAVE)   
009E   D9                     EXX      
009F   E1                     POP   HL   
00A0   F7                     RST   30h   
00A1                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00A1                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00A1                             ; Digits: step back onto the first digit and read the whole number.
00A1   E5           DIGIT:    PUSH   HL   
00A2   0B                     DEC   BC   
00A3   CD 36 02               CALL   rdnum   
00A6   F7                     RST   30h   
00A7                             ; a-z: push the cell's address (the cell is the variable)
00A7   E5           LOWER:    PUSH   HL   
00A8   87                     ADD   A,A   
00A9   6F                     LD   L,A   
00AA   26 82                  LD   H,LETPAGE   
00AC   F7                     RST   30h   
00AD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00AD                             ; the return stack, and the IP becomes the address in the letter's cell.
00AD   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00AE   EB                     EX   DE,HL   ; park TOS
00AF   87                     ADD   A,A   
00B0   6F                     LD   L,A   
00B1   26 82                  LD   H,LETPAGE   ; HL -> cell
00B3   4E                     LD   C,(HL)   
00B4   2C                     INC   L   
00B5   46                     LD   B,(HL)   ; IP = the word's body
00B6   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B7                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B7                             ; stack, then next. Everything that pushes the return stack ends here.
00B7                             ; 
00B7                             ; The break key is looked at here, so at every word call and loop-back (and
00B7                             ; block entry and "{"), but only one time in 256: B', which nothing else
00B7                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00B7                             ; under CP/M), and this way it costs a loop two bytes and 13 T-states.
00B7   D9           RPUSHN:   EXX      
00B8   D1                     POP   DE   
00B9   2B                     DEC   HL   
00BA   72                     LD   (HL),D   
00BB   2B                     DEC   HL   
00BC   73                     LD   (HL),E   
00BD   10 05                  DJNZ   rp1   
00BF   D9                     EXX      
00C0   CD E6 02               CALL   pollk   
00C3   F7                     RST   30h   
00C4   D9           RP1:      EXX      
00C5   F7                     RST   30h   
00C6                             ; ---- machine code: the grave -----------------------------------------------
00C6                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00C6                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00C6                             ; written and its address is left. An odd last digit is consumed and dropped.
00C6                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00C6                             ; code is entered by CALL with the data stack above the return address; it
00C6                             ; must keep BC, and on return the top cell becomes the new TOS.
00C6   CD D4 02     H_GRAVE:   CALL   hexc   
00C9   30 C7                  JR   NC,exec   
00CB   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00CC   CD D4 02               CALL   hexc   
00CF   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00D1   ED 6F                  RLD      ;   overwrites it
00D3   23                     INC   HL   ; ... and RLD shifts it up under the low one
00D4   CD D4 02               CALL   hexc   
00D7   38 F2                  JR   C,hx1   
00D9   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00DB   F7                     RST   30h   
00DC                             ; ---- where the two pages meet ----------------------------------------------
00DC                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00DC                             ; are in falling code order for this), and where exactly differs between the
00DC                             ; builds: NPG1 follows. Every handler below these four must start in the
00DC                             ; second page, and every one above in the first; chktab.py checks both.
00DC                             ; "]" returns: pop an address and jump to it.
00DC   CF           H_RET:    RST   08h   
00DD   42                     LD   B,D   
00DE   4B                     LD   C,E   
00DF   F7           BRK1:     RST   30h   
00E0                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00E0                             ; drops the block start, "]" returns. No closer at all ends the program.
00E0   7C           H_BREAK:   LD   A,H   
00E1   B5                     OR   L   
00E2   E1                     POP   HL   
00E3   28 FA                  JR   Z,brk1   
00E5   CD 5D 02               CALL   skip   
00E8   B7                     OR   A   ; skip returns 0 for ")"
00E9   20 F1                  JR   NZ,h_ret   
00EB   CF           RDROP:    RST   08h   
00EC   F7                     RST   30h   
00ED                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00ED                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00ED                             ; the body"s address instead. Either way it then skips to the matching "]'.
00ED                             ; (The unchecked build takes anything that is not a letter as the space; the
00ED                             ; checked build stops on it.)
00ED   0A           H_DEF:    LD   A,(BC)   
00EE   03                     INC   BC   
00EF   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00F1   5F                     LD   E,A   ;   lands 64 bytes up
00F2   E6 DF                  AND   0DFh   ; fold case
00F4   FE 1A                  CP   26   
00F6   30 0B                  JR   NC,def2   ; not a letter
00F8   CB 23                  SLA   E   
00FA   16 82                  LD   D,LETPAGE   ; DE -> cell
00FC   79                     LD   A,C   
00FD   12                     LD   (DE),A   
00FE   1C                     INC   E   
00FF   78                     LD   A,B   
0100   12                     LD   (DE),A   
0101   18 09                  JR   skipnx   
0103                DEF2:        
0103                          IF   CHECKED   
0103   7B                     LD   A,E   
0104   FE DF                  CP   " "-"A"+256   
0106   C2 BC 03               JP   NZ,e_brack   ; anything but a letter or a space
0109                          ENDIF      
0109   E5                     PUSH   HL   ; an anonymous block: push its address
010A   60                     LD   H,B   
010B   69                     LD   L,C   
010C                SKIPNX:      
010C                          IF   CHECKED   
010C   0B                     DEC   BC   ; back onto the letter, so that skip finds its
010D                          ENDIF      ;   opener, the "[", just before where it starts
010D   CD 5D 02     SKIPO:    CALL   skip   
0110   F7                     RST   30h   
0111   5E           H_FETCH:   LD   E,(HL)   ; "@"
0112   23                     INC   HL   
0113   56                     LD   D,(HL)   
0114   EB                     EX   DE,HL   
0115   F7                     RST   30h   
0116                             ; =============================================================================
0116                             ;  Handlers that must start in the image's second page.
0116                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0116                             ;  page.
0116                             ; =============================================================================
0116                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0116                             ; the matching ")".
0116   7C           H_OPEN:   LD   A,H   
0117   B5                     OR   L   
0118   E1                     POP   HL   
0119   28 F2                  JR   Z,skipo   
011B   C5                     PUSH   BC   ; the block starts at the IP
011C   18 99                  JR   rpushn   
011E                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
011E                             ; drops it and carries on.
011E   7C           H_CLOSE:   LD   A,H   
011F   B5                     OR   L   
0120   E1                     POP   HL   
0121   28 C8                  JR   Z,rdrop   
0123   CF                     RST   08h   ; pop the block start ...
0124   42                     LD   B,D   
0125   4B                     LD   C,E   
0126   C5                     PUSH   BC   
0127   18 8E                  JR   rpushn   ; ... and push it back
0129                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0129                             ; "-" has two jobs: directly before a digit it starts a negative number.
0129   0A           H_SUB:    LD   A,(BC)   
012A   D6 30                  SUB   "0"   
012C   FE 0A                  CP   10   
012E   38 04                  JR   C,negnum   
0130   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0131   D1           H_ADD:    POP   DE   
0132   19                     ADD   HL,DE   
0133   F7                     RST   30h   
0134   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0135   CD 36 02               CALL   rdnum   
0138   E7                     RST   20h   
0139   F7                     RST   30h   
013A   D1           H_AND:    POP   DE   
013B   7C                     LD   A,H   
013C   A2                     AND   D   
013D   67                     LD   H,A   
013E   7D                     LD   A,L   
013F   A3                     AND   E   
0140   6F                     LD   L,A   
0141   F7                     RST   30h   
0142                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0142                             ; cells first. Flipping both sign bits turns a signed compare into an
0142                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0142                             ; carry into -1 or 0 with no branch.
0142   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0143   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0144   7C                     LD   A,H   
0145   EE 80                  XOR   80h   
0147   67                     LD   H,A   
0148   7A                     LD   A,D   
0149   EE 80                  XOR   80h   
014B   57                     LD   D,A   
014C   ED 52                  SBC   HL,DE   ; carry if HL < DE
014E   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0150   F7                     RST   30h   
0151   D1           H_EQ:     POP   DE   
0152   B7                     OR   A   
0153   ED 52                  SBC   HL,DE   
0155   7C                     LD   A,H   
0156   B5                     OR   L   
0157   FE 01                  CP   1   ; carry only if a - b = 0
0159   18 F3                  JR   tf   
015B                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
015B                             ; multiplier shifts up through A:C.
015B   D1           H_MUL:    POP   DE   ; DE = multiplicand
015C   C5                     PUSH   BC   
015D   7C                     LD   A,H   
015E   4D                     LD   C,L   ; A:C = multiplier
015F   21 00 00               LD   HL,0   
0162   06 10                  LD   B,16   
0164   29           MUL1:     ADD   HL,HL   
0165   CB 21                  SLA   C   
0167   17                     RLA      
0168   30 01                  JR   NC,mul2   
016A   19                     ADD   HL,DE   
016B   10 F7        MUL2:     DJNZ   mul1   
016D   C1                     POP   BC   
016E   F7                     RST   30h   
016F                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
016F                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
016F                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
016F                             ; stops on it.
016F                H_DIV:       
016F                          IF   CHECKED   
016F   7C                     LD   A,H   
0170   B5                     OR   L   
0171   CA B9 03               JP   Z,e_zero   
0174                          ENDIF      
0174   D1                     POP   DE   ; DE = a, HL = b
0175   C5                     PUSH   BC   ; free BC for udiv
0176   D5                     PUSH   DE   ; a, for r's sign
0177   7A                     LD   A,D   
0178   AC                     XOR   H   
0179   F5                     PUSH   AF   ; S flag = sign of q
017A   CB 7C                  BIT   7,H   
017C   C4 20 00               CALL   NZ,neg16   ; HL = |b|
017F   EB                     EX   DE,HL   
0180   CB 7C                  BIT   7,H   
0182   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0185   CD 10 02               CALL   udiv   ; HL = q, DE = r
0188   F1                     POP   AF   
0189   FC 20 00               CALL   M,neg16   ; q's sign
018C   EB                     EX   DE,HL   ; HL = r, DE = q
018D   F1                     POP   AF   ; A = a's high byte
018E   B7                     OR   A   
018F   FC 20 00               CALL   M,neg16   ; r's sign
0192   C1                     POP   BC   
0193   D5                     PUSH   DE   ; q under r
0194   F7                     RST   30h   
0195                             ; ---- stack and storage -----------------------------------------------------
0195   E5           H_DUP:    PUSH   HL   ; ":"
0196   F7                     RST   30h   
0197   E3           H_SWAP:   EX   (SP),HL   ; "%"
0198   F7                     RST   30h   
0199                             ; (The checked build tests the address before it takes the value off the
0199                             ; stack, so that an error report shows both.)
0199                H_CSTORE:      ; "." ( c addr -- )
0199                          IF   CHECKED   
0199   CD 28 03               CALL   chkst   
019C                          ENDIF      
019C   D1                     POP   DE   
019D   73                     LD   (HL),E   
019E   DF           H_DROP:   RST   18h   ; ";" is this one byte
019F                H_STORE:      ; "!" ( n addr -- )
019F                          IF   CHECKED   
019F   CD 28 03               CALL   chkst   
01A2                          ENDIF      
01A2   D1                     POP   DE   
01A3   73                     LD   (HL),E   
01A4   23                     INC   HL   
01A5   72                     LD   (HL),D   
01A6   DF                     RST   18h   
01A7                             ; ---- console ---------------------------------------------------------------
01A7                             ; 22h pushes the address of the text after it and skips the string.
01A7   E5           H_STR:    PUSH   HL   
01A8   60                     LD   H,B   
01A9   69                     LD   L,C   
01AA   CD 4C 02               CALL   skipstr   
01AD                          IF   CHECKED   
01AD   B7                     OR   A   ; 0: the text ran out before the closing quote
01AE   CA B1 03               JP   Z,e_quote   
01B1                          ENDIF      
01B1   F7                     RST   30h   
01B2                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01B2                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01B2                             ; bit 6, so // and /" give themselves).
01B2                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
01B2                          ENDIF      
01B2                          IF   CHECKED   
01B2                             ; (The checked build has the loop as a routine, prstr, which the error
01B2                             ; report uses too. The address is kept on the stack meanwhile: a report
01B2                             ; shows the stack as it was before the "$".)
01B2   E5           H_PRINT:   PUSH   HL   
01B3   CD 49 03               CALL   prstr   
01B6   D1                     POP   DE   
01B7   DF                     RST   18h   
01B8                          ENDIF      
01B8   7D           H_EMIT:   LD   A,L   ; "'"
01B9   EF                     RST   28h   
01BA   DF           PR9:      RST   18h   
01BB                             ; "#" prints TOS as a signed decimal number, with no space after it.
01BB   C5           H_NUM:    PUSH   BC   
01BC   CD 9A 02               CALL   psgn   
01BF   C1                     POP   BC   
01C0   DF                     RST   18h   
01C1                             ; "?" ( n -- c ) or ( -n -- addr )
01C1                             ;   n > 0: wait about n ms for a key; 0 if none came
01C1                             ;   n = 0: wait for a key
01C1                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C1                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C1   CB 7C        H_KEY:    BIT   7,H   
01C3   20 19                  JR   NZ,line   
01C5   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C7   CD F2 02     KT2:      CALL   getk   
01CA   20 0E                  JR   NZ,kt3   
01CC   1D                     DEC   E   
01CD   20 F8                  JR   NZ,kt2   
01CF   7C                     LD   A,H   ; 0? never counts down: it waits
01D0   B5                     OR   L   
01D1   28 F2                  JR   Z,kt1   
01D3   2B                     DEC   HL   
01D4   7C                     LD   A,H   
01D5   B5                     OR   L   
01D6   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01D8   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01D9   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DA   6F           KT3:      LD   L,A   
01DB   26 00                  LD   H,0   
01DD   F7                     RST   30h   
01DE                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
01DE                          ENDIF      
01DE                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
01DE                          ENDIF      
01DE                          IF   CPM   
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01DE                          ENDIF      
01DE                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
01DE                          ENDIF      
01DE                          IF   CPM*EDITOR   
                              RET      
01DE                          ENDIF      
01DE                          IFN   CPM   
01DE                             ; Generic: Backspace takes the last character back (and is echoed as
01DE                             ; it is), CR ends (stored, not echoed), every other key is stored and
01DE                             ; echoed until the line is full. The line buffer starts at offset 80h
01DE                             ; of its page, so L alone is the place in the line: D holds the L of
01DE                             ; a full line.
01DE                          ENDIF      
01DE                          IFN   CPM   
01DE   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E1   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E2   9F                     SBC   A,A   
01E3   A5                     AND   L   ; (0 for a count that is too big)
01E4   2F                     CPL      
01E5   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E6                          ENDIF      ;   at most
01E6                          IF   EDGEN   
01E6   CD EC 01               CALL   rdline   ; (the editor calls rdline too)
01E9   2E 80                  LD   L,LINEBUF & 0FFh   
01EB   F7                     RST   30h   
01EC                             ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
01EC                RDLINE:      
01EC                          ENDIF      
01EC                          IFN   CPM   
01EC   21 80 82               LD   HL,LINEBUF   
01EF   CD F2 02     LN2:      CALL   getk   
01F2   28 FB                  JR   Z,ln2   
01F4   FE 0D                  CP   13   
01F6   28 16                  JR   Z,ln5   
01F8   FE 08                  CP   8   
01FA   28 0B                  JR   Z,ln4   
01FC   5F                     LD   E,A   
01FD   7D                     LD   A,L   
01FE   BA                     CP   D   
01FF   28 EE                  JR   Z,ln2   ; full
0201   73                     LD   (HL),E   
0202   2C                     INC   L   
0203   7B                     LD   A,E   
0204   EF           LN3:      RST   28h   
0205   18 E8                  JR   ln2   
0207   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0208   FA 04 02               JP   M,ln3   ;   unless the line was empty (L left the
020B   2C                     INC   L   ;   upper half of the page)
020C   18 E1                  JR   ln2   
020E   77           LN5:      LD   (HL),A   ; the CR
020F                          ENDIF      
020F                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
020F                          ENDIF      
020F                          IF   EDGEN   
020F   C9                     RET      
0210                          ENDIF      
0210                             ; =============================================================================
0210                             ;  More routines (no handler starts past this point)
0210                             ; =============================================================================
0210                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0210                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0210                             ; while the quotient bits arrive at the bottom of C.
0210                             ; Dividing by 2 is one shift (the spec wants that fast).
0210   7B           UDIV:     LD   A,E   
0211   EE 02                  XOR   2   
0213   B2                     OR   D   
0214   20 07                  JR   NZ,udv0   
0216   CB 3C                  SRL   H   
0218   CB 1D                  RR   L   ; the quotient
021A   8F                     ADC   A,A   
021B   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
021C   C9                     RET      
021D   7C           UDV0:     LD   A,H   
021E   4D                     LD   C,L   
021F   21 00 00               LD   HL,0   
0222   06 10                  LD   B,16   
0224   CB 21        UDV1:     SLA   C   
0226   17                     RLA      
0227   ED 6A                  ADC   HL,HL   
0229   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
022B   30 02                  JR   NC,udv2   ;   always fits in 16 bits
022D   19                     ADD   HL,DE   ; too much: put it back, and cancel the
022E   0D                     DEC   C   ;   INC below
022F   0C           UDV2:     INC   C   ; a quotient bit
0230   10 F2                  DJNZ   udv1   
0232   EB                     EX   DE,HL   ; DE = remainder
0233   67                     LD   H,A   
0234   69                     LD   L,C   ; HL = quotient
0235   C9                     RET      
0236                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0236                             ; non-digit. Values wrap at 16 bits, as the spec says.
0236   21 00 00     RDNUM:    LD   HL,0   
0239   0A           RDN1:     LD   A,(BC)   
023A   D6 30                  SUB   "0"   
023C   FE 0A                  CP   10   
023E   D0                     RET   NC   
023F   03                     INC   BC   
0240   54                     LD   D,H   
0241   5D                     LD   E,L   
0242   29                     ADD   HL,HL   
0243   29                     ADD   HL,HL   
0244   19                     ADD   HL,DE   
0245   29                     ADD   HL,HL   ; HL * 10
0246   5F                     LD   E,A   
0247   16 00                  LD   D,0   
0249   19                     ADD   HL,DE   
024A   18 ED                  JR   rdn1   
024C                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
024C                             ; the next character, so "/"" does not end it. Leaves A = 22h.
024C                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
024C                          ENDIF      
024C                          IF   CHECKED   
024C                             ; The checked build never steps over a NUL: if the text runs out first it
024C                             ; returns A = 0 with the IP on the NUL.
024C   0A           SKIPSTR:   LD   A,(BC)   
024D   B7                     OR   A   
024E   C8                     RET   Z   
024F   03                     INC   BC   
0250   FE 22                  CP   22h   
0252   C8                     RET   Z   
0253   FE 2F                  CP   "/"   
0255   20 F5                  JR   NZ,skipstr   
0257   0A                     LD   A,(BC)   ; the escaped character
0258   B7                     OR   A   
0259   C8                     RET   Z   
025A   03                     INC   BC   
025B   18 EF                  JR   skipstr   
025D                          ENDIF      
025D                             ; skip: read past text to the closer at this level, and return A = 0 if it
025D                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
025D                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
025D                             ; no closer; anything else that runs into the NUL had unbalanced brackets
025D                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
025D                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
025D                             ; 
025D                             ; The checked build also looks at the character the skip was started by,
025D                             ; which is always the one just before where it starts: "(" must end at ")",
025D                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
025D                             ; quote counts as running into it. "\" takes either closer. IX keeps the
025D                             ; place where the skip started, for the report.
025D                SKIP:        
025D                          IF   CHECKED   
025D   C5                     PUSH   BC   
025E   DD E1                  POP   IX   
0260   0B                     DEC   BC   
0261   0A                     LD   A,(BC)   
0262   03                     INC   BC   
0263   5F                     LD   E,A   ; E = the opener: ( [ or \
0264                          ENDIF      
0264   16 00                  LD   D,0   
0266   14           SK3:      INC   D   ; an opener: one deeper
0267   0A           SK1:      LD   A,(BC)   
0268                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,endprog   
0268                          ENDIF      
0268                          IF   CHECKED   
0268   B7                     OR   A   
0269   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
026B   03                     INC   BC   
026C                          ENDIF      
026C   FE 22                  CP   22h   
026E   CC 4C 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0271   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0273   28 F1                  JR   Z,sk3   
0275   3D                     DEC   A   ; ")"
0276   28 08                  JR   Z,sk4   
0278   D6 32                  SUB   "["-")"   
027A   28 EA                  JR   Z,sk3   
027C   FE 02                  CP   "]"-"["   
027E   20 E7                  JR   NZ,sk1   
0280   15           SK4:      DEC   D   
0281                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0281                          ENDIF      
0281                          IF   CHECKED   
0281   20 E4                  JR   NZ,sk1   
0283   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0284   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0285   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0287   FE 02                  CP   2   ;   closer, and only then
0289   7A                     LD   A,D   
028A   C0                     RET   NZ   
028B   18 05                  JR   sk7   
028D   CB 53        SK6:      BIT   2,E   ; the text ran out:
028F   C2 15 00               JP   NZ,endprog   ;   "\" with no closer ends the program
0292   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0294   C1                     POP   BC   
0295   3E 4E                  LD   A,"N"   
0297   C3 AE 03               JP   errp   ; (errp drops skip's return address)
029A                          ENDIF      
029A                             ; psgn: print HL as a signed number. Uses BC.
029A   CB 7C        PSGN:     BIT   7,H   
029C   28 04                  JR   Z,pdec   
029E   3E 2D                  LD   A,"-"   
02A0   EF                     RST   28h   
02A1   E7                     RST   20h   
02A2                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02A2                             ; Uses BC.
02A2   11 0A 00     PDEC:     LD   DE,10   
02A5   CD 10 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02A8   7B                     LD   A,E   
02A9   F5                     PUSH   AF   
02AA   7C                     LD   A,H   
02AB   B5                     OR   L   
02AC   C4 A2 02               CALL   NZ,pdec   
02AF   F1                     POP   AF   
02B0   C6 30                  ADD   A,"0"   
02B2   EF                     RST   28h   
02B3   C9                     RET      
02B4                             ; =============================================================================
02B4                             ;  Dispatch table: the low byte of each handler's address, in code order
02B4                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02B4                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02B4                             ; =============================================================================
02B4                             ; The handlers of the first NPG1 characters start in the image's second page.
02B4                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02B4                             ; differs between the builds, so the count is worked out here.
02B4                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02B4                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02B4                PGBRK:    EQU   (h_break-BASE)/256   
02B4                PGDEF:    EQU   (h_def-BASE)/256   
02B4                PGFET:    EQU   (h_fetch-BASE)/256   
02B4                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02B4                          IF   1-TABP0   
02B4                PTAB:        
02B4                          ;*Macro unroll:  PTABLE
02B4   9F                     DB   h_store & 0FFh   
02B5   A7                     DB   h_str & 0FFh   
02B6   BB                     DB   h_num & 0FFh   
02B7   B2                     DB   h_print & 0FFh   
02B8   97                     DB   h_swap & 0FFh   
02B9   3A                     DB   h_and & 0FFh   
02BA   B8                     DB   h_emit & 0FFh   
02BB   16                     DB   h_open & 0FFh   
02BC   1E                     DB   h_close & 0FFh   
02BD   5B                     DB   h_mul & 0FFh   
02BE   31                     DB   h_add & 0FFh   
02BF   D9                     DB   h_cfetch & 0FFh   
02C0   29                     DB   h_sub & 0FFh   
02C1   99                     DB   h_cstore & 0FFh   
02C2   6F                     DB   h_div & 0FFh   
02C3   95                     DB   h_dup & 0FFh   
02C4   9E                     DB   h_drop & 0FFh   
02C5   42                     DB   h_lt & 0FFh   
02C6   51                     DB   h_eq & 0FFh   
02C7   43                     DB   h_gt & 0FFh   
02C8   C1                     DB   h_key & 0FFh   
02C9   11                     DB   h_fetch & 0FFh   
02CA   ED                     DB   h_def & 0FFh   
02CB   E0                     DB   h_break & 0FFh   
02CC   DC                     DB   h_ret & 0FFh   
02CD   72                     DB   h_xor & 0FFh   
02CE   85                     DB   h_alloc & 0FFh   
02CF   C6                     DB   h_grave & 0FFh   
02D0   2C                     DB   h_tor & 0FFh   
02D1   7A                     DB   h_or & 0FFh   
02D2   1C                     DB   h_fromr & 0FFh   
02D3   82                     DB   h_not & 0FFh   
02D4                PTABEND:      
02D4                          ENDIF      
02D4                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02D4                             ; and return its value in A with the carry set; otherwise leave the IP and
02D4                             ; return with the carry clear.
02D4   0A           HEXC:     LD   A,(BC)   
02D5   D6 30                  SUB   "0"   
02D7   FE 0A                  CP   10   
02D9   38 09                  JR   C,hc1   
02DB   E6 DF                  AND   0DFh   
02DD   D6 11                  SUB   11h   
02DF   FE 06                  CP   6   
02E1   D0                     RET   NC   
02E2   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02E4   03           HC1:      INC   BC   
02E5   C9                     RET      
02E6                             ; =============================================================================
02E6                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
02E6                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
02E6                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
02E6                             ;  they are the host's KEY and CONOUT routines themselves.
02E6                             ; 
02E6                             ;  A running program reads the keyboard only through getk and pollk, which
02E6                             ;  between them give the break key its rules:
02E6                             ;    - Ctrl-C stops the program;
02E6                             ;    - any other key that the break check reads is held in KEYBUF for the
02E6                             ;      next "?", and a newer one takes its place;
02E6                             ;    - "?" (getk) takes the held key first;
02E6                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
02E6                             ;      key like any other, but two of them within about 250 ms still stop it.
02E6                             ;  Both are called straight from a handler, never from a routine under one:
02E6                             ;  the checked build's report counts on finding one return address above the
02E6                             ;  data stack.
02E6                             ; =============================================================================
02E6                          IFN   CPM   
02E6                RAWK:     EQU   KEY   
02E6                          ENDIF      
02E6                             ; pollk: the break check (see rpushn).
02E6   CD 06 FF     POLLK:    CALL   rawk   
02E9   C8                     RET   Z   ; no key
02EA   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
02ED   FE 03                  CP   3   
02EF   C0                     RET   NZ   
02F0   18 11                  JR   ctlc   
02F2                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
02F2   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
02F3   21 7A 82               LD   HL,KEYBUF   ;   the buffer
02F6   7E                     LD   A,(HL)   
02F7   36 00                  LD   (HL),0   
02F9   E1                     POP   HL   
02FA   B7                     OR   A   
02FB   C0                     RET   NZ   
02FC   CD 06 FF               CALL   rawk   
02FF   C8                     RET   Z   
0300   FE 03                  CP   3   
0302   C0                     RET   NZ   
0303                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0303                             ; the program has turned it off, wait about 250 ms for one more key: a
0303                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0303                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0303   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0306   B7                     OR   A   
0307   CA A6 03               JP   Z,brk   
030A   D5                     PUSH   DE   
030B   11 10 27               LD   DE,250*MSLOOP   
030E   CD 06 FF     CT1:      CALL   rawk   
0311   20 05                  JR   NZ,ct2   
0313   1B                     DEC   DE   
0314   7A                     LD   A,D   
0315   B3                     OR   E   
0316   20 F6                  JR   NZ,ct1   
0318   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0319   FE 03                  CP   3   
031B   CA A6 03               JP   Z,brk   
031E   B7                     OR   A   
031F   28 03                  JR   Z,ct3   
0321   32 7A 82               LD   (KEYBUF),A   
0324   3E 03        CT3:      LD   A,3   
0326   B7                     OR   A   
0327   C9                     RET      
0328                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
0328                          ENDIF      
0328                          IF   CHECKED   
0328                BRK:      EQU   e_break   ;   the checked build reports B
0328                          ENDIF      
0328                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0328                          ENDIF      
0328                             ; =============================================================================
0328                             ;  Checked build: the checks and the error report
0328                             ; =============================================================================
0328                          IF   CHECKED   
0328                             ; chkst: stop unless HL is in the program's own space: from the letter page
0328                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0328                             ; whatever lies above the limit are safe. Memory above the heap top but
0328                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0328                             ; It is the page of HL + 1 that is tested, so that one test serves both
0328                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0328                             ; Keeps HL and BC.
0328   23           CHKST:    INC   HL   
0329   7C                     LD   A,H   
032A   2B                     DEC   HL   
032B   FE 82                  CP   LETPAGE   
032D   38 03                  JR   C,chs1   
032F                          ENDIF      
032F                          IF   CHECKED*(1-CPM)   
032F   FE F0                  CP   HEAPLIM   
0331   D8                     RET   C   
0332                          ENDIF      
0332                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0332                          ENDIF      
0332                          IF   CHECKED   
0332   C3 AC 03     CHS1:     JP   e_store   
0335                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0335                             ; the count. Stop if the top is not below the limit page, or is below the
0335                             ; program's end.
0335                CHKHP:       
0335                          ENDIF      
0335                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0335                          ENDIF      
0335                          IF   CHECKED*(1-CPM)   
0335                             ; (Here the program's space is under 32K, so a top that wrapped
0335                             ; round always falls outside it.)
0335   7C                     LD   A,H   
0336   FE F0                  CP   HEAPLIM   
0338   30 09                  JR   NC,e_heap   
033A                          ENDIF      
033A                          IF   CHECKED   
033A   D5                     PUSH   DE   
033B   EB                     EX   DE,HL   
033C   2A 38 82               LD   HL,(NPEND)   
033F   19                     ADD   HL,DE   ; carry: at or above the program's end
0340   EB                     EX   DE,HL   
0341   D1                     POP   DE   
0342   D8                     RET   C   
0343   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0344   ED 52                  SBC   HL,DE   
0346   C3 A9 03               JP   e_heap1   
0349                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0349                             ; "$", and the error report's texts). A NUL first is an error: Q.
0349   7E           PRSTR:    LD   A,(HL)   
034A   23                     INC   HL   
034B   FE 22                  CP   22h   
034D   C8                     RET   Z   
034E   B7                     OR   A   
034F   28 0B                  JR   Z,e_dollar   
0351   FE 2F                  CP   "/"   
0353   20 04                  JR   NZ,prs1   
0355   7E                     LD   A,(HL)   
0356   23                     INC   HL   
0357   E6 BF                  AND   0BFh   
0359   EF           PRS1:     RST   28h   
035A   18 ED                  JR   prstr   
035C   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
035D   E1                     POP   HL   ;   and put the string's address back in TOS
035E   3E 51                  LD   A,"Q"   
0360   C3 BE 03               JP   error   
0363                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0363                             ; pnl: the same, on a new line.
0363   3E 0D        PNL:      LD   A,13   
0365   EF                     RST   28h   
0366   3E 0A                  LD   A,10   
0368   EF                     RST   28h   
0369   E3           PMSG:     EX   (SP),HL   
036A   CD 49 03               CALL   prstr   
036D   E3                     EX   (SP),HL   
036E   C9                     RET      
036F                             ; chkstk: both stacks are checked once per character, not in every handler.
036F                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
036F                             ; the constant carries if it is above (cells were popped that were never
036F                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
036F                             ; a character late at most: the bytes above DSTOP and the guard band below
036F                             ; the page take what happens meanwhile. DE is free between characters.
036F   EB           CHKSTK:   EX   DE,HL   
0370   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0373   39                     ADD   HL,SP   
0374   EB                     EX   DE,HL   
0375   38 1E                  JR   C,e_under   
0377   14                     INC   D   
0378   20 17                  JR   NZ,e_over   
037A   D9                     EXX      ; the return stack: in its page (or it has
037B   7C                     LD   A,H   ;   overflowed), and not above its empty
037C   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
037E   7D                     LD   A,L   ;   page, in the guard band)
037F   D9                     EXX      
0380   20 0C                  JR   NZ,e_rover   
0382   FE E1                  CP   RSTOP&0FFh+1   
0384   D8                     RET   C   
0385   D9                     EXX      ; return stack underflow: it counts as empty
0386   21 E0 80               LD   HL,RSTOP   
0389   D9                     EXX      
038A   3E 72                  LD   A,"r"   
038C   18 20                  JR   errp   
038E   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0390   11                     DB   11h   ; (LD DE,nn hides the next entry)
0391   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0393   18 19                  JR   errp   
0395   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0398   3E 73                  LD   A,"s"   
039A   18 22                  JR   error   
039C                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
039C                             ; was never defined still holds 0000h, and the byte there is a reserved one
039C                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
039C                             ; an undefined word. The call is undone, so the place is the call itself.
039C   04           E_HI:     INC   B   
039D   10 17                  DJNZ   e_resv   ; (B is as it was, and is not 0)
039F   CF                     RST   08h   
03A0   42                     LD   B,D   
03A1   4B                     LD   C,E   
03A2   3E 55                  LD   A,"U"   
03A4   18 18                  JR   error   
03A6                             ; Error entries. Each loads its letter and then hides the next entry inside
03A6                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
03A6   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
03A8   11                     DB   11h   
03A9   3E 48        E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
03AB   11                     DB   11h   
03AC   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
03AE                             ; errp: an error found inside a routine: drop its return address first.
03AE   D1           ERRP:     POP   DE   
03AF   18 0D                  JR   error   
03B1   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
03B2   4D                     LD   C,L   ;   past the opening quote, which is the place
03B3   3E 51                  LD   A,"Q"   
03B5   11                     DB   11h   
03B6   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
03B8   11                     DB   11h   
03B9   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
03BB   11                     DB   11h   
03BC   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
03BE                             ; error: the report, then the end. A = the letter, BC = one past the place,
03BE                             ; HL = TOS, and both stacks as the report is to show them:
03BE                             ; 
03BE                             ;   Err X @ line,col
03BE                             ;   up to 16 characters of the text from the place
03BE                             ;   Stk n: the top 8 cells at most, bottom to top
03BE                             ;   Rtn n
03BE   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
03BF   5F                     LD   E,A   
03C0   CD 63 03               CALL   pnl   
03C3   45 72 72 20 22         DB   "Err ",22h   
03C8   7B                     LD   A,E   
03C9   EF                     RST   28h   
03CA   CD 69 03               CALL   pmsg   
03CD   20 40 20 22            DB   " @ ",22h   
03D1   0B                     DEC   BC   ; BC = the place
03D2                             ; The line and column. A place below the program is in the line
03D2                             ; buffer: line 0. Otherwise count the LFs from the program's start;
03D2                             ; DE = the line's number, HL = where it starts.
03D2   21 80 82               LD   HL,LINEBUF   
03D5   11 00 00               LD   DE,0   
03D8   78                     LD   A,B   
03D9   FE 83                  CP   PROG/256   
03DB   38 14                  JR   C,er3   
03DD   24                     INC   H   
03DE   6B                     LD   L,E   ; HL = PROG
03DF   13           ER1:      INC   DE   ; a new line starts at HL
03E0   E5                     PUSH   HL   
03E1   7D           ER2:      LD   A,L   
03E2   91                     SUB   C   
03E3   7C                     LD   A,H   
03E4   98                     SBC   A,B   
03E5   30 09                  JR   NC,er2x   ; reached the place
03E7   7E                     LD   A,(HL)   
03E8   23                     INC   HL   
03E9   FE 0A                  CP   10   
03EB   20 F4                  JR   NZ,er2   
03ED   F1                     POP   AF   
03EE   18 EF                  JR   er1   
03F0   E1           ER2X:     POP   HL   
03F1   C5           ER3:      PUSH   BC   
03F2   E5                     PUSH   HL   
03F3   EB                     EX   DE,HL   
03F4   CD A2 02               CALL   pdec   ; the line
03F7   3E 2C                  LD   A,","   
03F9   EF                     RST   28h   
03FA   D1                     POP   DE   
03FB   E1                     POP   HL   
03FC   E5                     PUSH   HL   
03FD   B7                     OR   A   
03FE   ED 52                  SBC   HL,DE   
0400   23                     INC   HL   
0401   CD A2 02               CALL   pdec   ; the column
0404   CD 63 03               CALL   pnl   
0407   22                     DB   22h   
0408   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
0409   06 10                  LD   B,16   ;   if the line or the program ends first
040B   7E           ER4:      LD   A,(HL)   
040C   23                     INC   HL   
040D   B7                     OR   A   
040E   28 0B                  JR   Z,er5   
0410   FE 0D                  CP   13   
0412   28 07                  JR   Z,er5   
0414   FE 0A                  CP   10   
0416   28 03                  JR   Z,er5   
0418                          ENDIF      
0418                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0418                          ENDIF      ;   screen on it)
0418                          IF   CHECKED   
0418   EF                     RST   28h   
0419   10 F0                  DJNZ   er4   
041B   CD 63 03     ER5:      CALL   pnl   
041E   53 74 6B 20 22         DB   "Stk ",22h   
0423   21 FA 81               LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
0426   B7                     OR   A   ;   first value and holds nothing)
0427   ED 72                  SBC   HL,SP   
0429   CD 74 04               CALL   phalf   ; the depth
042C   3E 3A                  LD   A,":"   
042E   EF                     RST   28h   
042F   79                     LD   A,C   
0430   FE 09                  CP   9   
0432   38 0A                  JR   C,er6   
0434   CD 69 03               CALL   pmsg   
0437   20 2E 2E 2E 22         DB   " ...",22h   
043C   0E 08                  LD   C,8   
043E   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0440   69                     LD   L,C   
0441   29                     ADD   HL,HL   
0442   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0443   0C                     INC   C   
0444   0D           ER7:      DEC   C   
0445   28 11                  JR   Z,er8   
0447   2B                     DEC   HL   
0448   56                     LD   D,(HL)   
0449   2B                     DEC   HL   
044A   5E                     LD   E,(HL)   
044B   E5                     PUSH   HL   
044C   C5                     PUSH   BC   
044D   3E 20                  LD   A," "   
044F   EF                     RST   28h   
0450   EB                     EX   DE,HL   
0451   CD 9A 02               CALL   psgn   
0454   C1                     POP   BC   
0455   E1                     POP   HL   
0456   18 EC                  JR   er7   
0458   CD 63 03     ER8:      CALL   pnl   
045B   52 74 6E 20 22         DB   "Rtn ",22h   
0460   D9                     EXX      
0461   E5                     PUSH   HL   
0462   D9                     EXX      
0463   D1                     POP   DE   
0464   21 E0 80               LD   HL,RSTOP   
0467   B7                     OR   A   
0468   ED 52                  SBC   HL,DE   
046A   CD 74 04               CALL   phalf   
046D   CD 63 03               CALL   pnl   
0470   22                     DB   22h   
0471   C3 15 00               JP   endprog   
0474                             ; phalf: print half of HL, and leave it in C
0474   CB 3C        PHALF:    SRL   H   
0476   CB 1D                  RR   L   
0478   E5                     PUSH   HL   
0479   CD A2 02               CALL   pdec   
047C   C1                     POP   BC   
047D   C9                     RET      
047E                          ENDIF      
047E                             ; =============================================================================
047E                             ;  The line editor (EDITOR = 1)
047E                             ; 
047E                             ;  The interpreter starts here, and a program that ends comes back here. Type
047E                             ;  a line and press Return:
047E                             ; 
047E                             ;    n text    put the text in as line n; the lines from n on move down.
047E                             ;              A number past the end, or 0, adds the line at the end.
047E                             ;    n         take line n out
047E                             ;    0         run the program
047E                             ;    -n        list the program from line n on (-1 lists all of it). Any key
047E                             ;              stops the list until another key is pressed; Ctrl-C ends it.
047E                             ;    anything else is run at once, as B8Script. (Start such a line with a
047E                             ;    space if it would begin with a digit or a minus sign.)
047E                             ; 
047E                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
047E                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
047E                             ;  125 characters, the line number and the one character after it included;
047E                             ;  that character is not stored. The text is kept as it is typed, each line
047E                             ;  ending in CR LF, at PROG. Nothing is checked.
047E                             ; 
047E                             ;  With CPM = 1 the file named on the command line is the program to start
047E                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
047E                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
047E                             ;  CP/M. Nothing is written back: there is no command to save.
047E                             ; 
047E                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
047E                             ;  its report and comes back here, with both stacks empty. The place is a
047E                             ;  line and column of the program; in a line typed here it is line 0.
047E                             ; 
047E                             ;  Things to know:
047E                             ;    - Reset empties the program (generic builds).
047E                             ;    - Words and variables last from one line to the next. A word's address
047E                             ;      points into the program, so run the program again after editing it.
047E                             ;    - Nothing is printed between a program's output and what is typed next.
047E                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
047E                             ;      a line that calls -n? and carries on afterwards runs what was typed.
047E                             ;      (The stored program never comes back to the line, so it may.)
047E                             ; =============================================================================
047E                          IF   EDGEN*CHECKED   
047E                             ; Reset (A = 0): clear the lower half of the letter page. Every variable
047E                             ; starts at 0, every word cell holds 0000h, the address an undefined word is
047E                             ; caught at (see e_hi), and no key is held back.
047E   21 00 82     INIT:     LD   HL,LET   
0481   77           INI1:     LD   (HL),A   
0482   2C                     INC   L   
0483   F2 81 04               JP   P,ini1   ; +00h to +7Fh
0486   18 3F                  JR   edit   
0488                          ENDIF      
0488                          IF   EDITOR   
0488                             ; -n: list from line n. DE = the number of the line at HL.
0488   03           LIST:     INC   BC   
0489   CD 36 02               CALL   rdnum   ; HL = n
048C   E5                     PUSH   HL   
048D   CD 39 05               CALL   find   
0490   D1                     POP   DE   
0491   7E           LI1:      LD   A,(HL)   
0492   B7                     OR   A   
0493   28 32                  JR   Z,edit   ; the end of the text
0495   CD 06 FF               CALL   rawk   
0498   28 0D                  JR   Z,li3   ; no key: carry on
049A   FE 03                  CP   3   
049C   28 29                  JR   Z,edit   ; Ctrl-C
049E   CD 06 FF     LI2:      CALL   rawk   ; any other key: wait for one more
04A1   28 FB                  JR   Z,li2   
04A3   FE 03                  CP   3   
04A5   28 20                  JR   Z,edit   
04A7   E5           LI3:      PUSH   HL   
04A8   D5                     PUSH   DE   
04A9   EB                     EX   DE,HL   
04AA   CD A2 02               CALL   pdec   ; the line's number,
04AD   3E 20                  LD   A," "   
04AF   EF                     RST   28h   ;   a space,
04B0   D1                     POP   DE   
04B1   E1                     POP   HL   
04B2   13                     INC   DE   
04B3   CD 51 05               CALL   prl   ;   and the line
04B6   18 D9                  JR   li1   
04B8                             ; Take line n (in HL) out: copy everything after it down over it.
04B8   CD 39 05     DEL:      CALL   find   
04BB   54                     LD   D,H   
04BC   5D                     LD   E,L   
04BD   CD 47 05               CALL   nxl   ; HL -> the next line
04C0   7E           DE1:      LD   A,(HL)   
04C1   12                     LD   (DE),A   
04C2   23                     INC   HL   
04C3   13                     INC   DE   
04C4   B7                     OR   A   
04C5   20 F9                  JR   NZ,de1   ; and fall into the editor
04C7   31 FC 81     EDIT:     LD   SP,DSTOP   
04CA   AF                     XOR   A   ; a key that the break check held while the
04CB   32 7A 82               LD   (KEYBUF),A   ;   program ran is let go (the Ctrl-C that
04CE                          ENDIF      ;   stopped it, for one)
04CE                          IF   EDGEN   
04CE   16 FD                  LD   D,0FDh   ; 125 characters at most
04D0                          ENDIF      
04D0                          IF   EDITOR*CPM   
                              LD   A,125   
04D0                          ENDIF      
04D0                          IF   EDITOR   
04D0   CD EC 01               CALL   rdline   ; HL -> the CR that ended the line
04D3   2C                     INC   L   
04D4   36 0A                  LD   (HL),10   ; a LF after it,
04D6   2D                     DEC   L   
04D7   CD 51 05               CALL   prl   ; (print the CR LF: a new line)
04DA   36 00                  LD   (HL),0   ;   and a NUL after that
04DC   E5                     PUSH   HL   ; the end of what was typed
04DD   01 80 82               LD   BC,LINEBUF   
04E0   0A                     LD   A,(BC)   
04E1   FE 2D                  CP   "-"   
04E3   28 A3                  JR   Z,list   
04E5   CD 36 02               CALL   rdnum   ; HL = the number it starts with, BC -> after
04E8   79                     LD   A,C   ; C is still 80h if there was no number:
04E9   87                     ADD   A,A   ;   only then is twice it 0
04EA   28 0C                  JR   Z,st0   ; no number: run the line where it is
04EC   0A                     LD   A,(BC)   
04ED   D6 0D                  SUB   13   
04EF   20 22                  JR   NZ,ins   ; text follows the number
04F1   B4                     OR   H   ; the number alone:
04F2   B5                     OR   L   
04F3   20 C3                  JR   NZ,del   ;   not 0: take that line out
04F5   01 00 83               LD   BC,PROG   ;   0: run the program
04F8                             ; st0: start running at BC. The heap starts after the stored program's NUL.
04F8   E1           ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
04F9   AF                     XOR   A   
04FA   67                     LD   H,A   ; no key is held, and the break key is on: a
04FB   6F                     LD   L,A   ;   key left over from the last run is let go
04FC   22 7A 82               LD   (KEYBUF),HL   
04FF   21 00 83               LD   HL,PROG   
0502   BE           ST1:      CP   (HL)   
0503   23                     INC   HL   
0504   20 FC                  JR   NZ,st1   
0506   22 7C 82               LD   (HEAP),HL   
0509                          ENDIF      
0509                          IF   EDITOR*CHECKED   
0509   E7                     RST   20h   ; minus the heap"s first address: "_' may not
050A   22 38 82               LD   (NPEND),HL   ;   release below it
050D                          ENDIF      
050D                          IF   EDITOR   
050D   D9                     EXX      
050E   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
0511   D9                     EXX      
0512   F7                     RST   30h   ; (its return address is thrown away)
0513                             ; Put the typed text in as line n (in HL): open a gap of its length there,
0513                             ; CR and LF included, and copy it in.
0513   CD 39 05     INS:      CALL   find   ; HL -> where it goes
0516   03                     INC   BC   ; step over the one character after the number
0517   D1                     POP   DE   ; the end of what was typed
0518   7B                     LD   A,E   
0519   91                     SUB   C   ; A = the length of the text, with its CR LF
051A   C5                     PUSH   BC   ; the text
051B   4F                     LD   C,A   
051C   06 00                  LD   B,0   
051E   C5                     PUSH   BC   ; its length
051F   54                     LD   D,H   
0520   5D                     LD   E,L   ; DE = where it goes
0521   AF                     XOR   A   
0522   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0523   ED B1                  CPIR      ; HL -> one past the program's NUL
0525   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0527   44                     LD   B,H   
0528   4D                     LD   C,L   
0529   19                     ADD   HL,DE   
052A   2B                     DEC   HL   ; HL -> the NUL
052B   EB                     EX   DE,HL   
052C   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
052D   E5                     PUSH   HL   
052E   19                     ADD   HL,DE   ; the NUL's new place
052F   EB                     EX   DE,HL   
0530   ED B8                  LDDR      ; move the rest of the program up
0532   C1                     POP   BC   ; the length
0533   D1                     POP   DE   ; where it goes
0534   E1                     POP   HL   ; the text
0535   ED B0                  LDIR      
0537   18 8E                  JR   edit   
0539                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0539                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0539   EB           FIND:     EX   DE,HL   
053A   21 00 83               LD   HL,PROG   
053D   1B           FI1:      DEC   DE   
053E   7A                     LD   A,D   
053F   B3                     OR   E   
0540   C8                     RET   Z   
0541   CD 47 05               CALL   nxl   
0544   20 F7                  JR   NZ,fi1   
0546   C9                     RET      
0547                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0547                             ; stop at the NUL that ends the text (and return zero).
0547   7E           NXL:      LD   A,(HL)   
0548   B7                     OR   A   
0549   C8                     RET   Z   
054A   23                     INC   HL   
054B   FE 0A                  CP   10   
054D   20 F8                  JR   NZ,nxl   
054F   B7                     OR   A   
0550   C9                     RET      
0551                             ; prl: print the line at HL, to its LF; HL -> just past it.
0551   7E           PRL:      LD   A,(HL)   
0552   EF                     RST   28h   
0553   7E                     LD   A,(HL)   
0554   23                     INC   HL   
0555   FE 0A                  CP   10   
0557   20 F8                  JR   NZ,prl   
0559   C9                     RET      
055A                          ENDIF      
055A                             ; =============================================================================
055A                             ;  CP/M startup (the generic build starts at address 0: see st0)
055A                             ; =============================================================================
055A                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
055A                          ENDIF      
055A                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
055A                          ENDIF      
055A                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:         
055A                          ENDIF      
055A                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
055A                          ENDIF      
055A                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
055A                          ENDIF      
055A                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
055A                          ENDIF      
055A                IMGEND:      


