E369                             ; The checked build's inner loop, out of page 1, where it would not fit,
E369                             ; and its break check (described with the unchecked one in page 1).
E369                             ; pnext: the break check, then (falling through) next. A word call, a true
E369                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E369                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E369                             ; falls in here too, which does no harm.)
E369   CE 79 04     PNEXT:    DEC   CDOWN   
E36C   D0 0B                  BNE   next   
E36E   20 06 FF               JSR   KEY   
E371   F0 06                  BEQ   next   ; no key
E373   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E376   20 04 E4               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E379                NEXT:        
E379                             ; Both stacks are checked once per character, after it has run. The
E379                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E379                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E379                             ; more than one entry). The data stack has when X is above DSE (an
E379                             ; underflow) or below DSFULL (an overflow). No handler moves X by
E379                             ; more than 4, so X is caught before it wraps; an overrun by a cell
E379                             ; or two writes on the scratch bytes below or above the stack.
E379                             ; S is kept in RSV, for the report's Rtn line (an error found inside
E379                             ; a handler has its own calls on the hardware stack), and the place
E379                             ; of the character about to run in PLACE.
E379   8A                     TXA      ; TSX trashes X: keep it in A
E37A   BA                     TSX      
E37B   8E 35 04               STX   RSV   
E37E   E0 20                  CPX   #RSLIM   
E380   AA                     TAX      ; TAX leaves the carry alone
E381   90 16                  BCC   e_rstack   
E383   E0 F1                  CPX   #DSE+1   
E385   B0 24                  BCS   e_sund   
E387   E0 10                  CPX   #DSFULL   
E389   90 25                  BCC   e_sovr   
E38B   A5 00                  LDA   IP   
E38D   85 08                  STA   PLACE   
E38F   A5 01                  LDA   IP+1   
E391   85 09                  STA   PLACE+1   
E393   20 4A E4               JSR   step   
E396   4C 79 E3               JMP   next   
E399                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E399                             ; empty.
E399   AD 35 04     E_RSTACK:   LDA   RSV   
E39C   C9 10                  CMP   #10h   
E39E   A9 52                  LDA   #"R"   
E3A0   B0 10                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E3A2   A9 FF                  LDA   #0FFh   
E3A4   8D 35 04               STA   RSV   ; S wrapped to 01h: Rtn 0
E3A7   A9 72                  LDA   #"r"   
E3A9   D0 07                  BNE   ejmp   ; always
E3AB   A2 F0        E_SUND:   LDX   #DSE   ; Stk 0
E3AD   A9 73                  LDA   #"s"   
E3AF   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E3B0   A9 53        E_SOVR:   LDA   #"S"   
E3B2   4C 38 E5     EJMP:     JMP   error   
E3B5                             ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
E3B5                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E3B5                             ; which takes either. Meeting the wrong closer at this level, or the end
E3B5                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E3B5                             ; which then ends the program as before.
E3B5   85 04        SKIP:     STA   T0   
E3B7   A9 00                  LDA   #0   
E3B9   85 06                  STA   T2   ; depth
E3BB   20 1E E5     SK1:      JSR   getc   
E3BE   F0 26                  BEQ   sknul   
E3C0   C9 22                  CMP   #22h   
E3C2   D0 05                  BNE   sk2   
E3C4   20 5E E0               JSR   skipstr   ; leaves A = 11h, which matches nothing below
E3C7   F0 1D                  BEQ   sknul   ; the string ran into the end
E3C9   C9 28        SK2:      CMP   #"("   
E3CB   F0 15                  BEQ   sk3   
E3CD   C9 5B                  CMP   #"["   
E3CF   F0 11                  BEQ   sk3   
E3D1   C9 29                  CMP   #")"   
E3D3   F0 04                  BEQ   sk4   
E3D5   C9 5D                  CMP   #"]"   
E3D7   D0 E2                  BNE   sk1   
E3D9   C6 06        SK4:      DEC   T2   
E3DB   10 DE                  BPL   sk1   
E3DD   C5 04                  CMP   T0   
E3DF   F0 0C                  BEQ   e_nest   ; the wrong kind
E3E1   60                     RTS      ; the closer at this level
E3E2   E6 06        SK3:      INC   T2   
E3E4   D0 D5                  BNE   sk1   
E3E6   A5 04        SKNUL:    LDA   T0   
E3E8   D0 03                  BNE   e_nest   ; ( and [ stop with N
E3EA   4C 09 FF               JMP   EXIT   ; \ ends the program
E3ED   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E3EF   4C 38 E5               JMP   error   ;   or the end: the place is the opener
E3F2                          ENDIF      
E3F2                          IF   1-CHECKED   
                    CBREAK:   EQU   endp   ; the unchecked build stops without a word
E3F2                          ENDIF      
E3F2                          IF   CHECKED   
E3F2                CBREAK:   EQU   e_break   ; the checked build reports B
E3F2                          ENDIF      
E3F2                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E3F2                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E3F2                             ; taken out of KEYBUF.
E3F2   AD 7A 04     GETK:     LDA   KEYBUF   
E3F5   F0 08                  BEQ   gk1   
E3F7   48                     PHA      
E3F8   A9 00                  LDA   #0   
E3FA   8D 7A 04               STA   KEYBUF   
E3FD   68                     PLA      
E3FE   60                     RTS      
E3FF   20 06 FF     GK1:      JSR   KEY   
E402   F0 04                  BEQ   gk9   
E404                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E404                             ; back if it comes back at all.
E404   C9 03        CHK3:     CMP   #3   
E406   F0 01                  BEQ   ctlc   
E408   60           GK9:      RTS      
E409                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E409                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E409                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E409                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E409                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y. (Not D0/D1:
E409                             ; they hold the place in the checked build.)
E409   AD 7B 04     CTLC:     LDA   BRKOFF   
E40C   F0 1D                  BEQ   cbreak   
E40E   A9 28                  LDA   #CWAIT+1   
E410   85 05                  STA   T1   
E412   20 06 FF     CT2:      JSR   KEY   
E415   D0 0A                  BNE   ct3   
E417   C6 06                  DEC   T2   
E419   D0 F7                  BNE   ct2   
E41B   C6 05                  DEC   T1   
E41D   D0 F3                  BNE   ct2   
E41F   F0 07                  BEQ   ct9   ; always: none came
E421   C9 03        CT3:      CMP   #3   
E423   F0 06                  BEQ   cbreak   
E425   8D 7A 04               STA   KEYBUF   
E428   A9 03        CT9:      LDA   #3   
E42A   60                     RTS      
E42B                          IF   CHECKED   
E42B   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E42D   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E42E   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E430   4C 38 E5     EJMP2:    JMP   error   
E433                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E433                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E433                             ; the call reads a NUL with IP in page zero, where no program can be. The
E433                             ; call is undone first: the step frame and the return address come off the
E433                             ; hardware stack, and the place is the call letter (the return address - 1).
E433   68           E_UNDEF:   PLA      
E434   68                     PLA      ; the step frame
E435   68                     PLA      
E436   38                     SEC      
E437   E9 01                  SBC   #1   
E439   85 08                  STA   PLACE   
E43B   68                     PLA      
E43C   E9 00                  SBC   #0   
E43E   85 09                  STA   PLACE+1   
E440   EE 35 04               INC   RSV   
E443   EE 35 04               INC   RSV   ; Rtn does not count the call
E446   A9 55                  LDA   #"U"   
E448   D0 E6                  BNE   ejmp2   ; always
E44A                          ENDIF      
E44A                             ; step: read one character and sort it by range.
E44A                             ;    00h          end of program
E44A                             ;    01h-20h, 7Fh-FFh   ignored
E44A                             ;    30h-39h      digit: read a whole number
E44A                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E44A                             ;    61h-7Ah      a-z: push the address of that letter's cell
E44A                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E44A   20 1E E5     STEP:     JSR   getc   ; flags follow A
E44D   F0 3D                  BEQ   endp   
E44F   38                     SEC      
E450   E9 21                  SBC   #21h   ; A = c - 21h
E452   90 37                  BCC   ign   ; 01h-20h
E454   C9 0F                  CMP   #0Fh   
E456   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E458   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E45A   C9 0A                  CMP   #10   
E45C   90 72                  BCC   digit   
E45E   C9 11                  CMP   #11h   
E460   90 18                  BCC   p3a   ; 3Ah-40h
E462   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E464   C9 1A                  CMP   #1Ah   
E466   90 2B                  BCC   upper   ; 41h-5Ah
E468   C9 20                  CMP   #20h   
E46A   90 0C                  BCC   p5b   ; 5Bh-60h
E46C   C9 3A                  CMP   #3Ah   
E46E   90 2F                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E470   C9 3E                  CMP   #3Eh   
E472                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E472                          ENDIF      
E472                          IF   CHECKED   
E472   F0 17                  BEQ   ign   ; 7Fh
E474   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
E476                          ENDIF      
E476                             ; The three adjustments below chain. Each ADC adds the carry the one
E476                             ; before it left, which the constants allow for.
E476   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E478   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E47A   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E47C                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E47C                             ; the index is N1 or more, plus one more if it is N2 or more.
E47C   C9 08        PUNCT:    CMP   #N1   
E47E   A8                     TAY      
E47F   A9 70                  LDA   #HALFPG   
E481   2A                     ROL      ; the first page, or the second (carry clear)
E482   C0 15                  CPY   #N2   
E484   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E486   48                     PHA      
E487   B9 B0 E4               LDA   PTAB,Y   
E48A   48                     PHA      
E48B   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E48C                             ; directly, it just ends an ignored character.
E48C                ENDP:        ; the program has ended
E48C                          IF   CHECKED   
E48C   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E48E   F0 A3                  BEQ   e_undef   
E490                          ENDIF      
E490   4C 09 FF               JMP   EXIT   
E493                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E493                             ; the return stack, and the IP becomes the address in the letter's cell.
E493   0A           UPPER:    ASL      
E494   A8                     TAY      
E495   38                     SEC      
E496   4C D7 E0               JMP   pushn   
E499   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E49B   A4 01                  LDY   IP+1   
E49D   D0 03                  BNE   pushay   ; always: no program is in page zero
E49F                             ; a-z: push the cell's address (the cell is the variable)
E49F   0A           LOWER:    ASL      
E4A0   A0 04                  LDY   #>LET   
E4A2                             ; pushay: push a cell: A = its low byte, Y = its high byte
E4A2   CA           PUSHAY:   DEX      
E4A3   CA                     DEX      
E4A4   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E4A6   94 01                  STY   1,X   
E4A8   60                     RTS      
E4A9                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E4A9   E8           FLAG:     INX      
E4AA   E8                     INX      
E4AB   B5 FE                  LDA   0FEh,X   
E4AD   15 FF                  ORA   0FFh,X   
E4AF   60                     RTS      
E4B0                             ; =============================================================================
E4B0                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E4B0                             ;  character, in code order.
E4B0                             ; =============================================================================
E4B0   A6           PTAB:     DB   (h_store-1) & 0FFh   ; !
E4B1   54                     DB   (h_str-1) & 0FFh   ; "
E4B2   7A                     DB   (h_num-1) & 0FFh   ; #
E4B3   2C                     DB   (h_print-1) & 0FFh   ; $
E4B4   B5                     DB   (h_swap-1) & 0FFh   ; %
E4B5   C6                     DB   (h_and-1) & 0FFh   ; &
E4B6   72                     DB   (h_emit-1) & 0FFh   ; '
E4B7   D1                     DB   (h_open-1) & 0FFh   ; (
E4B8   B3                     DB   (h_close-1) & 0FFh   ; )
E4B9   56                     DB   (h_mul-1) & 0FFh   ; *
E4BA   20                     DB   (h_add-1) & 0FFh   ; +
E4BB   AA                     DB   (h_cfetch-1) & 0FFh   ; ,
E4BC   17                     DB   (h_sub-1) & 0FFh   ; -
E4BD   0B                     DB   (h_cstore-1) & 0FFh   ; .
E4BE   81                     DB   (h_div-1) & 0FFh   ; /
E4BF   04                     DB   (h_dup-1) & 0FFh   ; :
E4C0   14                     DB   (drop-1) & 0FFh   ; ;
E4C1   35                     DB   (h_lt-1) & 0FFh   ; <
E4C2   46                     DB   (h_eq-1) & 0FFh   ; =
E4C3   32                     DB   (h_gt-1) & 0FFh   ; >
E4C4   BA                     DB   (h_key-1) & 0FFh   ; ?
E4C5   6F                     DB   (h_fetch-1) & 0FFh   ; @
E4C6   94                     DB   (h_def-1) & 0FFh   ; [
E4C7   17                     DB   (h_break-1) & 0FFh   ; \
E4C8   2B                     DB   (h_ret-1) & 0FFh   ; ]
E4C9   59                     DB   (h_xor-1) & 0FFh   ; ^
E4CA   E6                     DB   (h_alloc-1) & 0FFh   ; _
E4CB   B8                     DB   (h_grave-1) & 0FFh   ; `
E4CC   3D                     DB   (h_tor-1) & 0FFh   ; {
E4CD   64                     DB   (h_or-1) & 0FFh   ; |
E4CE   49                     DB   (h_fromr-1) & 0FFh   ; }
E4CF   56                     DB   (h_not-1) & 0FFh   ; ~
E4D0                             ; Digits: the first one is in A; read the rest of the number.
E4D0   A0 00        DIGIT:    LDY   #0   
E4D2   20 A2 E4               JSR   pushay   
E4D5                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E4D5                             ; Returns with the carry set.
E4D5   20 04 E5     RDNUM:    JSR   isdig   
E4D8   B0 4F                  BCS   ic9   ; (an RTS)
E4DA   20 21 E5               JSR   incip   ; (keeps A = the digit)
E4DD   16 00                  ASL   0,X   
E4DF   36 01                  ROL   1,X   ; x2
E4E1   18                     CLC      
E4E2   75 00                  ADC   0,X   
E4E4   85 04                  STA   T0   
E4E6   B5 01                  LDA   1,X   
E4E8   69 00                  ADC   #0   
E4EA   85 05                  STA   T1   ; T = x2 + digit
E4EC   16 00                  ASL   0,X   
E4EE   36 01                  ROL   1,X   
E4F0   16 00                  ASL   0,X   
E4F2   36 01                  ROL   1,X   ; x8
E4F4   18                     CLC      
E4F5   B5 00                  LDA   0,X   
E4F7   65 04                  ADC   T0   
E4F9   95 00                  STA   0,X   
E4FB   B5 01                  LDA   1,X   
E4FD   65 05                  ADC   T1   
E4FF   95 01                  STA   1,X   ; x8 + x2 + digit
E501   4C D5 E4               JMP   rdnum   
E504                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E504                             ; digit. Y = 0.
E504   20 2A E5     ISDIG:    JSR   peek   
E507   38                     SEC      
E508   E9 30                  SBC   #"0"   
E50A   C9 0A                  CMP   #10   
E50C   60                     RTS      
