E76E                             ; udiv (QK): as the macro UDIV, and any power of two is shifts: 2, and 32,
E76E                             ; 64, 256 and the like, which fixed point and byte work use all the time.
E76E   A9 00        UDIV:     LDA   #0   
E770   95 FE                  STA   0FEh,X   
E772   95 FF                  STA   0FFh,X   
E774   A4 05                  LDY   D0   
E776   A5 06                  LDA   D1   
E778   D0 12                  BNE   uq1   ; 256 and up
E77A   98                     TYA      
E77B   F0 38                  BEQ   ud0   ; by 0: the long way (it means nothing anyway)
E77D   88                     DEY      
E77E   98                     TYA      
E77F   25 05                  AND   D0   
E781   D0 32                  BNE   ud0   ; not a power of two
E783   98                     TYA      ; by 2^k below 256: r = a & (2^k - 1),
E784   35 00                  AND   0,X   
E786   95 FE                  STA   0FEh,X   
E788   A5 05                  LDA   D0   ;   and q = a >> k
E78A   D0 1E                  BNE   uq2   ; always
E78C   98           UQ1:      TYA      
E78D   D0 26                  BNE   ud0   ; not a power of two
E78F   A4 06                  LDY   D1   
E791   88                     DEY      
E792   98                     TYA      
E793   25 06                  AND   D1   
E795   D0 1E                  BNE   ud0   ; not a power of two
E797   98                     TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
E798   35 01                  AND   1,X   
E79A   95 FF                  STA   0FFh,X   
E79C   B5 00                  LDA   0,X   
E79E   95 FE                  STA   0FEh,X   
E7A0   B5 01                  LDA   1,X   ;   and q = (a >> 8) >> (k - 8)
E7A2   95 00                  STA   0,X   
E7A4   A9 00                  LDA   #0   
E7A6   95 01                  STA   1,X   
E7A8   A5 06                  LDA   D1   
E7AA   4A           UQ2:      LSR      ; a bit of 2^k: one shift for each 0 below
E7AB   B0 07                  BCS   uq9   ;   the 1
E7AD   56 01        UQ3:      LSR   1,X   
E7AF   76 00                  ROR   0,X   
E7B1   4A                     LSR      
E7B2   90 F9                  BCC   uq3   
E7B4   60           UQ9:      RTS      
