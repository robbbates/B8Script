  1233 00000549 2C25                <1>         sub     al,25h                  ; VK_LEFT 0, VK_RIGHT 2
  1234 0000054B A8FD                <1>         test    al,0FDh
  1235 0000054D 75BF                <1>         jnz     .wk1                    ; anything else: passed over
  1236 0000054F 041C                <1>         add     al,1Ch                  ; 1Ch, 1Eh
  1237 00000551 EB23                <1>         jmp     .wk9
