   360                              <1> 
   361                              <1> ; ---- before the window: what its handlers jump to, within a short jump --
   362                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
   363                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
   364 000000DB 89F2                <1> upper:  mov     edx,esi
   365 000000DD 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
   366                              <1> 
   367                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
   368                              <1> ; return stack ends here, and the true ')' comes to rpoll.
   369                              <1> ;
   370                              <1> ; The break key is looked at here, so at every word call and loop-back (and
   371                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
   372 000000E5 83EF04              <1> rpush:  sub     edi,4
   373 000000E8 8917                <1>         mov     [edi],edx
   374 000000EA FE4D5B              <1> rpoll:  dec     byte [V(v_pcnt)]
   375 000000ED 7505                <1>         jnz     .rp1
   376 000000EF E8A0040000          <1>         call    pollk
   377 000000F4 FFE5                <1> .rp1:   jmp     ebp
   378                              <1> 
   379                              <1> ; negnum, for '-'
   380 000000F6 53                  <1> negnum: push    ebx
   381                              <1>         CALLP   rdnum
   192                              <2>  %if P_%1
   193                              <2>  call [V(p_%1)]
   194                              <2>  %else
   195 000000F7 E887050000          <2>  call %1
   196                              <2>  %endif
