E740   48                     PHA      
E741   B4 FE                  LDY   0FEh,X   ; the entry, if the skip is kept
E743   C0 01                  CPY   #1   
E745   F0 0F                  BEQ   sq9   
E747   A5 00                  LDA   IP   
E749   38                     SEC      
E74A   E9 01                  SBC   #1   
E74C   99 02 02               STA   CPAGE*256+2,Y   ; the closer's address
E74F   A5 01                  LDA   IP+1   
E751   E9 00                  SBC   #0   
E753   99 03 02               STA   CPAGE*256+3,Y   
E756   68           SQ9:      PLA      
E757   60                     RTS      ; the closer at this level
E758                             ; sqip: IP = IP + Y. Keeps A.
E758   48           SQIP:     PHA      
E759   98                     TYA      
E75A   18                     CLC      
E75B   65 00                  ADC   IP   
E75D   85 00                  STA   IP   
E75F   90 02                  BCC   sp1   
