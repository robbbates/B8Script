                              ORA   TH   
                              LDY   DSL,X   
                              STY   TL   
                              LDY   DSH,X   
                              STY   TH   
                              INX      
                              TAY      
                              BEQ   fcl1   
                              TXA      ; true: the block start, read where it is
                              TSX      
                              LDY   101h,X   
                              STY   IP   
                              LDY   102h,X   
                              STY   IP+1   
                              TAX      
                              DEC   CDOWN   
                              BNE   fcl2   
                              JSR   fpoll   
                              ;*Macro unroll: fcl2:   NEXTF
                    FCL2:     DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
