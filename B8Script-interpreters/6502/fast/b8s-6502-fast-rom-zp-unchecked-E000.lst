E8BB   E5 05                  SBC   D0   
E8BD   A8                     TAY      
E8BE   B5 FF                  LDA   0FFh,X   
E8C0   E5 06                  SBC   D1   
E8C2   90 06                  BCC   uv10   
E8C4   95 FF                  STA   0FFh,X   
E8C6   94 FE                  STY   0FEh,X   
E8C8   F6 00                  INC   0,X   
E8CA                UV10:        
