01A8   FE 22                  CP   22h   
01AA   28 0D                  JR   Z,pr9   
01AC   FE 2F                  CP   "/"   
01AE   20 04                  JR   NZ,pr1   
01B0   7E                     LD   A,(HL)   
01B1   23                     INC   HL   
01B2   E6 BF                  AND   0BFh   
01B4   EF           PR1:      RST   28h   
01B5   18 EF                  JR   h_print   
01B7   7D           H_EMIT:   LD   A,L   ; "'"
01B8   EF                     RST   28h   
01B9   DF           PR9:      RST   18h   
01BA                             ; "#" prints TOS as a signed decimal number, with no space after it.
