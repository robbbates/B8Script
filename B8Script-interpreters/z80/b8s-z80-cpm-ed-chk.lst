0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC and
                                 ; IY, and all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
                    PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      1-CPM,0DFh      ;   RST 18h
0000                 DS      CPM,0E1h        ;   POP HL
0000                 DS      CPM,0DDh        ;   JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   RST 30h
0000                 DS      CPM,0DDh        ;   JP (IX): IX holds next0
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM,0DDh        ;   LD IX,next0
0000                 DS      CPM,21h
0000                 DS      CPM,ANXT&0FFh
0000                 DS      CPM,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 0A               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0103                          ENDIF      
0103                          IF   CPM*EDITOR*CHECKED   
0103                             ; Clear the lower half of the letter page: every variable starts at
0103                             ; 0, every word cell holds 0000h, the address an undefined word is
0103                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
0103                             ; is held back.
0103   21 00 0B               LD   HL,LET   
0106   AF                     XOR   A   
0107   77           INI1:     LD   (HL),A   
0108   2C                     INC   L   
0109   F2 07 01               JP   P,ini1   ; +00h to +7Fh
010C                          ENDIF      
010C                          IF   CPM*EDITOR   
010C   CD D4 08               CALL   load   ; the file named on the command line
010F   C3 80 06               JP   edit0   
0112                          ENDIF      
0112                          IF   1-CPM   
                                 ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
                    RPOP:     LD   E,(IY+0)   ; 08
                              LD   D,(IY+1)   
                              JR   rp2   ; (the rest is at 2Bh)
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
                              JR   NZ,next0   ;     the rest are ignored
                    ENDPROG:   JP   EXIT   ;     the program has ended
                              NOP      ; 17  spare
                                 ; ---- RST 18h: drop TOS, then next ------------------------------------------
                    RST18:    POP   DE   ; 18  discard the RST's return address
                    DRP:      POP   HL   ;     new TOS = NOS
                              JR   next0   
0112                          ENDIF      
0112   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
0113                          ;*Macro unroll:  POPR
0113                          DS   1-CPM,0CFh   
0113   CD                     DS   CPM,0CDh   
0114   DF                     DS   CPM,AROP&0FFh   
0115   04                     DS   CPM,AROP/256   
0116   EB                     EX   DE,HL   
0117                          ;*Macro unroll:  NEXT
0117                          DS   1-CPM,0F7h   
0117   DD                     DS   CPM,0DDh   
0118   E9                     DS   CPM,0E9h   
0119                          IF   1-CPM   
                                 ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
                    NEG16:    XOR   A   ; 20
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
                              NOP      ; 27  spare
                                 ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
                    RST28:       
                    PUTC:     JP   CONOUT   ; 28
                    RP2:      INC   IY   ; 2B  the rest of rpop
                              INC   IY   
                              RET      
                                 ; ---- RST 30h: next character -----------------------------------------------
                    RST30:    POP   DE   ; 30  discard the RST's return address
0119                          ENDIF      
0119                          IF   CPM   
0119                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0119   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
011B   20 03                  JR   NZ,next0   ; the rest are ignored
011D   C3 89 06     ENDPROG:   JP   EXIT   ; the program has ended
0120                          ENDIF      
0120                             ; =============================================================================
0120                             ;  The inner loop: read one character and sort it by range.
0120                             ; 
0120                             ;    00h          end of program
0120                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0120                             ;    30h-39h      digit: read a whole number
0120                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0120                             ;    61h-7Ah      a-z: push the address of that letter's cell
0120                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0120                             ; =============================================================================
0120                NEXT0:       
0120                          IF   CHECKED   
0120   CD 21 05               CALL   chkstk   ; both stacks are checked once per character
0123                          ENDIF      
0123   0A                     LD   A,(BC)   
0124   03                     INC   BC   
0125   D6 21                  SUB   21h   ; A = c - 21h
0127   38 F0                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0129   FE 0F                  CP   0Fh   
012B   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
012D   D6 0F                  SUB   0Fh   ; A = c - 30h
012F   FE 0A                  CP   0Ah   
0131   38 56                  JR   C,digit   ; 30h-39h
0133   FE 11                  CP   11h   
0135   38 19                  JR   C,p3a   ; 3Ah-40h
0137   D6 11                  SUB   11h   ; A = c - 41h
0139   FE 1A                  CP   1Ah   
013B   38 5A                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
013D   FE 20                  CP   20h   
013F   38 0D                  JR   C,p5b   ; 5Bh-60h
0141   FE 3A                  CP   3Ah   
0143   38 4B                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0145   FE 3E                  CP   3Eh   
0147                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0147                          ENDIF      
0147                          IF   CHECKED   
0147   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
0149   D2 4E 05               JP   NC,e_hi   ; 80h-FFh: reserved
014C                          ENDIF      
014C   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
014E   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0150   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0152                .macro PTABLE,
0152                             ; 
0152                 DB      h_store & 0FFh  ; !
0152                 DB      h_str & 0FFh    ; "
0152                 DB      h_num & 0FFh    ; #
0152                 DB      h_print & 0FFh  ; $
0152                 DB      h_swap & 0FFh   ; %
0152                 DB      h_and & 0FFh    ; &
0152                 DB      h_emit & 0FFh   ; '
0152                 DB      h_open & 0FFh   ; (
0152                 DB      h_close & 0FFh  ; )
0152                 DB      h_mul & 0FFh    ; *
0152                 DB      h_add & 0FFh    ; +
0152                 DB      h_cfetch & 0FFh ; ,
0152                 DB      h_sub & 0FFh    ; -
0152                 DB      h_cstore & 0FFh ; .
0152                 DB      h_div & 0FFh    ; /
0152                 DB      h_dup & 0FFh    ; :
0152                 DB      h_drop & 0FFh   ; ;
0152                 DB      h_lt & 0FFh     ; <
0152                 DB      h_eq & 0FFh     ; =
0152                 DB      h_gt & 0FFh     ; >
0152                 DB      h_key & 0FFh    ; ?
0152                 DB      h_fetch & 0FFh  ; @
0152                 DB      h_def & 0FFh    ; [
0152                 DB      h_break & 0FFh  ; \
0152                 DB      h_ret & 0FFh    ; ]
0152                 DB      h_xor & 0FFh    ; ^
0152                 DB      h_alloc & 0FFh  ; _
0152                 DB      h_grave & 0FFh  ; `
0152                 DB      h_tor & 0FFh    ; {
0152                 DB      h_or & 0FFh     ; |
0152                 DB      h_fromr & 0FFh  ; }
0152                 DB      h_not & 0FFh    ; ~
0152                .endm
0152                 
0152                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0152                             ; untouched, and A, DE free.
0152   C6 81        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0154   5F                     LD   E,A   
0155   16 04                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0157   FE 97                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0159   1A                     LD   A,(DE)   
015A   5F                     LD   E,A   ; the handler's low byte
015B                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
015B                          ENDIF      
015B                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
015B                          ENDIF      
015B                          IF   CPM   
015B   16 01                  LD   D,1   
015D   30 01                  JR   NC,pu1   
015F   14                     INC   D   ; its page: 1 + carry
0160                PU1:         
0160                          ENDIF      
0160   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0161   C9                     RET      ;   when the handler starts
0162                             ; The rest of the startup: here so that the generic reset code can reach it
0162                             ; with JR. st0: find the program's NUL; the heap starts after it.
0162                             ; (The editor build has its own copy of this, next to the editor.)
0162                             ; A checked build first clears the lower half of the letter page (A = 0):
0162                             ; every variable starts at 0, every word cell holds 0000h, the address an
0162                             ; undefined word is caught at (see e_hi), and no key is held back.
0162                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0162                          ENDIF      
0162                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0162                          ENDIF      
0162                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0162                          ENDIF      
0162                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0162                          ENDIF      
0162                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0162                          ENDIF      ;   these)
0162                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0162                          ENDIF      
0162                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0162                          ENDIF      
0162                          IF   1-EDITOR   
                              ;*Macro unroll:  SETIX
                              DS   CPM,0DDh   
                              DS   CPM,21h   
                              DS   CPM,ANXT&0FFh   
                              DS   CPM,ANXT/256   
                              LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   1-CPM,0F7h   ; (its return address is thrown away)
                              DS   CPM,0DDh   
                              DS   CPM,0E9h   
0162                          ENDIF      
0162                             ; In the unchecked generic editor build the table is here, in the first
0162                             ; page, which saves loading D twice. (The other builds have no room for it
0162                             ; here: theirs is further down.)
0162                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0162                          ENDIF      
0162                             ; =============================================================================
0162                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0162                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0162                             ;  is here too: it belongs to "`" and makes the page come out right.
0162                             ; =============================================================================
0162   D1           H_XOR:    POP   DE   
0163   7C                     LD   A,H   
0164   AA                     XOR   D   
0165   67                     LD   H,A   
0166   7D                     LD   A,L   
0167   AB                     XOR   E   
0168   6F                     LD   L,A   
0169                          ;*Macro unroll:  NEXT
0169                          DS   1-CPM,0F7h   
0169   DD                     DS   CPM,0DDh   
016A   E9                     DS   CPM,0E9h   
016B   D1           H_OR:     POP   DE   
016C   7C                     LD   A,H   
016D   B2                     OR   D   
016E   67                     LD   H,A   
016F   7D                     LD   A,L   
0170   B3                     OR   E   
0171   6F                     LD   L,A   
0172                          ;*Macro unroll:  NEXT
0172                          DS   1-CPM,0F7h   
0172   DD                     DS   CPM,0DDh   
0173   E9                     DS   CPM,0E9h   
0174                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0174                H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0174   CD                     DS   CPM,0CDh   
0175   EA                     DS   CPM,ANEG&0FFh   
0176   04                     DS   CPM,ANEG/256   
0177   2B                     DEC   HL   
0178                          ;*Macro unroll:  NEXT
0178                          DS   1-CPM,0F7h   
0178   DD                     DS   CPM,0DDh   
0179   E9                     DS   CPM,0E9h   
017A                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
017A                             ; the same either way); TOS is the old pointer.
017A   ED 5B 7C 0B  H_ALLOC:   LD   DE,(HEAP)   
017E                          IF   CHECKED*CPM   
017E   7C                     LD   A,H   ; the count's sign, for chkhp
017F                          ENDIF      
017F   19                     ADD   HL,DE   ; the new top
0180                          IF   CHECKED   
0180   CD 5A 05               CALL   chkhp   
0183                          ENDIF      
0183   22 7C 0B               LD   (HEAP),HL   
0186   EB                     EX   DE,HL   
0187                          ;*Macro unroll:  NEXT
0187                          DS   1-CPM,0F7h   
0187   DD                     DS   CPM,0DDh   
0188   E9                     DS   CPM,0E9h   
0189                          IF   1-CPM*CHECKED   
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM,0DDh   
                              DS   CPM,21h   
                              DS   CPM,ANXT&0FFh   
                              DS   CPM,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   1-CPM,0F7h   
                              DS   CPM,0DDh   
                              DS   CPM,0E9h   
0189                          ENDIF      
0189                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
0189                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
0189                             ; Digits: step back onto the first digit and read the whole number.
0189   E5           DIGIT:    PUSH   HL   
018A   0B                     DEC   BC   
018B   CD EB 03               CALL   rdnum   
018E                          ;*Macro unroll:  NEXT
018E                          DS   1-CPM,0F7h   
018E   DD                     DS   CPM,0DDh   
018F   E9                     DS   CPM,0E9h   
0190                             ; a-z: push the cell's address (the cell is the variable)
0190   E5           LOWER:    PUSH   HL   
0191   87                     ADD   A,A   
0192   6F                     LD   L,A   
0193   26 0B                  LD   H,LETPAGE   
0195                          ;*Macro unroll:  NEXT
0195                          DS   1-CPM,0F7h   
0195   DD                     DS   CPM,0DDh   
0196   E9                     DS   CPM,0E9h   
0197                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0197                             ; the return stack, and the IP becomes the address in the letter's cell.
0197   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
0198   EB                     EX   DE,HL   ; park TOS
0199   87                     ADD   A,A   
019A   6F                     LD   L,A   
019B   26 0B                  LD   H,LETPAGE   ; HL -> cell
019D   4E                     LD   C,(HL)   
019E   2C                     INC   L   
019F   46                     LD   B,(HL)   ; IP = the word's body
01A0   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01A1                             ; rpushn: move the top cell of the data stack (in memory) to the return
01A1                             ; stack, then next. Everything that pushes the return stack ends here.
01A1                             ; 
01A1                             ; The break key is looked at here, so at every word call and loop-back (and
01A1                             ; block entry and "{"), but only one time in 256: PCNT counts them.
01A1                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
01A1   D1           RPUSHN:   POP   DE   
01A2   FD 72 FF               LD   (IY-1),D   
01A5   FD 73 FE               LD   (IY-2),E   
01A8   FD 2B                  DEC   IY   
01AA   FD 2B                  DEC   IY   
01AC   E5                     PUSH   HL   
01AD   21 36 0B               LD   HL,PCNT   
01B0   35                     DEC   (HL)   
01B1   E1                     POP   HL   ; (the zero flag lasts)
01B2   CC A1 04               CALL   Z,pollk   
01B5                          ;*Macro unroll:  NEXT
01B5                          DS   1-CPM,0F7h   
01B5   DD                     DS   CPM,0DDh   
01B6   E9                     DS   CPM,0E9h   
01B7                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
01B7   E3           H_TOR:    EX   (SP),HL   
01B8   18 E7                  JR   rpushn   
01BA   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
01BB                             ; ---- machine code: the grave -----------------------------------------------
01BB                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01BB                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01BB                             ; written and its address is left. An odd last digit is consumed and dropped.
01BB                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01BB                             ; code is entered by CALL with the data stack above the return address; it
01BB                             ; must keep BC, and on return the top cell becomes the new TOS.
01BB   CD 51 04     H_GRAVE:   CALL   hexc   
01BE                          IF   1-CPM*CHECKED   
                              JR   NC,exec   
01BE                          ENDIF      
01BE                          IF   CPM*CHECKED   
01BE   D2 F1 04               JP   NC,exec   ; (out of the way: see rpop)
01C1                          ENDIF      
01C1   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01C2   CD 51 04               CALL   hexc   
01C5   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01C7   ED 6F                  RLD      ;   overwrites it
01C9   23                     INC   HL   ; ... and RLD shifts it up under the low one
01CA   CD 51 04               CALL   hexc   
01CD   38 F2                  JR   C,hx1   
01CF   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01D1                          ;*Macro unroll:  NEXT
01D1                          DS   1-CPM,0F7h   
01D1   DD                     DS   CPM,0DDh   
01D2   E9                     DS   CPM,0E9h   
01D3                             ; ---- where the two pages meet ----------------------------------------------
01D3                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D3                             ; are in falling code order for this), and where exactly differs between the
01D3                             ; builds: NPG1 follows. Every handler below these four must start in the
01D3                             ; second page, and every one above in the first; chktab.py checks both.
01D3                             ; "]" returns: pop an address and jump to it.
01D3                          ;*Macro unroll: h_ret:  POPR
01D3                H_RET:    DS   1-CPM,0CFh   
01D3   CD                     DS   CPM,0CDh   
01D4   DF                     DS   CPM,AROP&0FFh   
01D5   04                     DS   CPM,AROP/256   
01D6   42                     LD   B,D   
01D7   4B                     LD   C,E   
01D8                          ;*Macro unroll: brk1:   NEXT
01D8                BRK1:     DS   1-CPM,0F7h   
01D8   DD                     DS   CPM,0DDh   
01D9   E9                     DS   CPM,0E9h   
01DA                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01DA                             ; drops the block start, "]" returns. No closer at all ends the program.
01DA   7C           H_BREAK:   LD   A,H   
01DB   B5                     OR   L   
01DC   E1                     POP   HL   
01DD   28 F9                  JR   Z,brk1   
01DF   CD 12 04               CALL   skip   
01E2   B7                     OR   A   ; skip returns 0 for ")"
01E3   20 EE                  JR   NZ,h_ret   
01E5                          ;*Macro unroll: rdrop:  POPR
01E5                RDROP:    DS   1-CPM,0CFh   
01E5   CD                     DS   CPM,0CDh   
01E6   DF                     DS   CPM,AROP&0FFh   
01E7   04                     DS   CPM,AROP/256   
01E8                          ;*Macro unroll:  NEXT
01E8                          DS   1-CPM,0F7h   
01E8   DD                     DS   CPM,0DDh   
01E9   E9                     DS   CPM,0E9h   
01EA                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EA                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EA                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EA                             ; (The unchecked build takes anything that is not a letter as the space; the
01EA                             ; checked build stops on it.)
01EA   0A           H_DEF:    LD   A,(BC)   
01EB   03                     INC   BC   
01EC   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01EE   5F                     LD   E,A   ;   lands 64 bytes up
01EF   E6 DF                  AND   0DFh   ; fold case
01F1   FE 1A                  CP   26   
01F3   30 0B                  JR   NC,def2   ; not a letter
01F5   CB 23                  SLA   E   
01F7   16 0B                  LD   D,LETPAGE   ; DE -> cell
01F9   79                     LD   A,C   
01FA   12                     LD   (DE),A   
01FB   1C                     INC   E   
01FC   78                     LD   A,B   
01FD   12                     LD   (DE),A   
01FE   18 09                  JR   skipnx   
0200                DEF2:        
0200                          IF   CHECKED   
0200   7B                     LD   A,E   
0201   FE DF                  CP   " "-"A"+256   
0203   C2 A2 05               JP   NZ,e_brack   ; anything but a letter or a space
0206                          ENDIF      
0206   E5                     PUSH   HL   ; an anonymous block: push its address
0207   60                     LD   H,B   
0208   69                     LD   L,C   
0209                SKIPNX:      
0209                          IF   CHECKED   
0209   0B                     DEC   BC   ; back onto the letter, so that skip finds its
020A                          ENDIF      ;   opener, the "[", just before where it starts
020A   CD 12 04     SKIPO:    CALL   skip   
020D                          ;*Macro unroll:  NEXT
020D                          DS   1-CPM,0F7h   
020D   DD                     DS   CPM,0DDh   
020E   E9                     DS   CPM,0E9h   
020F   5E           H_FETCH:   LD   E,(HL)   ; "@"
0210   23                     INC   HL   
0211   56                     LD   D,(HL)   
0212   EB                     EX   DE,HL   
0213                          ;*Macro unroll:  NEXT
0213                          DS   1-CPM,0F7h   
0213   DD                     DS   CPM,0DDh   
0214   E9                     DS   CPM,0E9h   
0215                             ; =============================================================================
0215                             ;  Handlers that must start in the image's second page.
0215                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0215                             ;  page.
0215                             ; =============================================================================
0215                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0215                             ; the matching ")".
0215   7C           H_OPEN:   LD   A,H   
0216   B5                     OR   L   
0217   E1                     POP   HL   
0218   28 F0                  JR   Z,skipo   
021A   C5                     PUSH   BC   ; the block starts at the IP
021B   18 84                  JR   rpushn   
021D                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
021D                             ; drops it and carries on.
021D   7C           H_CLOSE:   LD   A,H   
021E   B5                     OR   L   
021F   E1                     POP   HL   
0220   28 C3                  JR   Z,rdrop   
0222                          ;*Macro unroll:  POPR                    ; pop the block start ...
0222                          DS   1-CPM,0CFh   ; pop the block start ...
0222   CD                     DS   CPM,0CDh   
0223   DF                     DS   CPM,AROP&0FFh   
0224   04                     DS   CPM,AROP/256   
0225   42                     LD   B,D   
0226   4B                     LD   C,E   
0227   C5                     PUSH   BC   
0228                          IF   1-CPM   
                              JR   rpushn   ; ... and push it back
0228                          ENDIF      
0228                          IF   CPM   
0228   C3 A1 01               JP   rpushn   
022B                          ENDIF      
022B                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022B                             ; "-" has two jobs: directly before a digit it starts a negative number.
022B   0A           H_SUB:    LD   A,(BC)   
022C   D6 30                  SUB   "0"   
022E   FE 0A                  CP   10   
0230   38 07                  JR   C,negnum   
0232                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0232                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0232   CD                     DS   CPM,0CDh   
0233   EA                     DS   CPM,ANEG&0FFh   
0234   04                     DS   CPM,ANEG/256   
0235   D1           H_ADD:    POP   DE   
0236   19                     ADD   HL,DE   
0237                          ;*Macro unroll:  NEXT
0237                          DS   1-CPM,0F7h   
0237   DD                     DS   CPM,0DDh   
0238   E9                     DS   CPM,0E9h   
0239   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
023A   CD EB 03               CALL   rdnum   
023D                          ;*Macro unroll:  NEGH
023D                          DS   1-CPM,0E7h   
023D   CD                     DS   CPM,0CDh   
023E   EA                     DS   CPM,ANEG&0FFh   
023F   04                     DS   CPM,ANEG/256   
0240                          ;*Macro unroll:  NEXT
0240                          DS   1-CPM,0F7h   
0240   DD                     DS   CPM,0DDh   
0241   E9                     DS   CPM,0E9h   
0242   D1           H_AND:    POP   DE   
0243   7C                     LD   A,H   
0244   A2                     AND   D   
0245   67                     LD   H,A   
0246   7D                     LD   A,L   
0247   A3                     AND   E   
0248   6F                     LD   L,A   
0249                          ;*Macro unroll:  NEXT
0249                          DS   1-CPM,0F7h   
0249   DD                     DS   CPM,0DDh   
024A   E9                     DS   CPM,0E9h   
024B                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
024B                             ; cells first. Flipping both sign bits turns a signed compare into an
024B                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
024B                             ; carry into -1 or 0 with no branch.
024B   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
024C   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
024D   7C                     LD   A,H   
024E   EE 80                  XOR   80h   
0250   67                     LD   H,A   
0251   7A                     LD   A,D   
0252   EE 80                  XOR   80h   
0254   57                     LD   D,A   
0255   ED 52                  SBC   HL,DE   ; carry if HL < DE
0257   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0259                          ;*Macro unroll:  NEXT
0259                          DS   1-CPM,0F7h   
0259   DD                     DS   CPM,0DDh   
025A   E9                     DS   CPM,0E9h   
025B   D1           H_EQ:     POP   DE   
025C   B7                     OR   A   
025D   ED 52                  SBC   HL,DE   
025F   7C                     LD   A,H   
0260   B5                     OR   L   
0261   FE 01                  CP   1   ; carry only if a - b = 0
0263   18 F2                  JR   tf   
0265                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0265                             ; multiplier shifts up through A:C.
0265   D1           H_MUL:    POP   DE   ; DE = multiplicand
0266   C5                     PUSH   BC   
0267   7C                     LD   A,H   
0268   4D                     LD   C,L   ; A:C = multiplier
0269   21 00 00               LD   HL,0   
026C   06 10                  LD   B,16   
026E   29           MUL1:     ADD   HL,HL   
026F   CB 21                  SLA   C   
0271   17                     RLA      
0272   30 01                  JR   NC,mul2   
0274   19                     ADD   HL,DE   
0275   10 F7        MUL2:     DJNZ   mul1   
0277   C1                     POP   BC   
0278                          ;*Macro unroll:  NEXT
0278                          DS   1-CPM,0F7h   
0278   DD                     DS   CPM,0DDh   
0279   E9                     DS   CPM,0E9h   
027A                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
027A                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
027A                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
027A                             ; stops on it.
027A                H_DIV:       
027A                          IF   CHECKED   
027A   7C                     LD   A,H   
027B   B5                     OR   L   
027C   CA 9F 05               JP   Z,e_zero   
027F                          ENDIF      
027F   D1                     POP   DE   ; DE = a, HL = b
0280   D5                     PUSH   DE   ; a, for r's sign
0281   7A                     LD   A,D   
0282   AC                     XOR   H   
0283   F5                     PUSH   AF   ; S flag = sign of q
0284   CB 7C                  BIT   7,H   
0286   C4 EA 04               CALL   NZ,neg16   ; HL = |b|
0289   EB                     EX   DE,HL   
028A   CB 7C                  BIT   7,H   
028C   C4 EA 04               CALL   NZ,neg16   ; HL = |a|, DE = |b|
028F   CD C3 03               CALL   udiv   ; HL = q, DE = r
0292   F1                     POP   AF   
0293   FC EA 04               CALL   M,neg16   ; q's sign
0296   EB                     EX   DE,HL   ; HL = r, DE = q
0297   F1                     POP   AF   ; A = a's high byte
0298   B7                     OR   A   
0299   FC EA 04               CALL   M,neg16   ; r's sign
029C   D5                     PUSH   DE   ; q under r
029D                          ;*Macro unroll:  NEXT
029D                          DS   1-CPM,0F7h   
029D   DD                     DS   CPM,0DDh   
029E   E9                     DS   CPM,0E9h   
029F                             ; ---- stack and storage -----------------------------------------------------
029F   E5           H_DUP:    PUSH   HL   ; ":"
02A0                          ;*Macro unroll:  NEXT
02A0                          DS   1-CPM,0F7h   
02A0   DD                     DS   CPM,0DDh   
02A1   E9                     DS   CPM,0E9h   
02A2   E3           H_SWAP:   EX   (SP),HL   ; "%"
02A3                          ;*Macro unroll:  NEXT
02A3                          DS   1-CPM,0F7h   
02A3   DD                     DS   CPM,0DDh   
02A4   E9                     DS   CPM,0E9h   
02A5                             ; (The checked build tests the address before it takes the value off the
02A5                             ; stack, so that an error report shows both.)
02A5                H_CSTORE:      ; "." ( c addr -- )
02A5                          IF   CHECKED   
02A5   CD 77 05               CALL   chkst   
02A8                          ENDIF      
02A8   D1                     POP   DE   
02A9   73                     LD   (HL),E   
02AA                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
02AA                H_DROP:   DS   1-CPM,0DFh   ; ";" is this one byte
02AA   E1                     DS   CPM,0E1h   
02AB   DD                     DS   CPM,0DDh   
02AC   E9                     DS   CPM,0E9h   
02AD                H_STORE:      ; "!" ( n addr -- )
02AD                          IF   CHECKED   
02AD   CD 77 05               CALL   chkst   
02B0                          ENDIF      
02B0   D1                     POP   DE   
02B1   73                     LD   (HL),E   
02B2   23                     INC   HL   
02B3   72                     LD   (HL),D   
02B4                          ;*Macro unroll:  DROP
02B4                          DS   1-CPM,0DFh   
02B4   E1                     DS   CPM,0E1h   
02B5   DD                     DS   CPM,0DDh   
02B6   E9                     DS   CPM,0E9h   
02B7                             ; ---- console ---------------------------------------------------------------
02B7                             ; 22h pushes the address of the text after it and skips the string.
02B7   E5           H_STR:    PUSH   HL   
02B8   60                     LD   H,B   
02B9   69                     LD   L,C   
02BA   CD 01 04               CALL   skipstr   
02BD                          IF   CHECKED   
02BD   B7                     OR   A   ; 0: the text ran out before the closing quote
02BE   CA 97 05               JP   Z,e_quote   
02C1                          ENDIF      
02C1                          ;*Macro unroll:  NEXT
02C1                          DS   1-CPM,0F7h   
02C1   DD                     DS   CPM,0DDh   
02C2   E9                     DS   CPM,0E9h   
02C3                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02C3                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02C3                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02C3                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02C3                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02C3                          ENDIF      
02C3                          IF   CHECKED   
02C3                             ; (The checked build has the loop as a routine, prstr, which the error
02C3                             ; report uses too. The address is kept meanwhile, for a report: it shows
02C3                             ; the stack as it was before the "$". /~ comes back to hp1.)
02C3   22 34 0B     H_PRINT:   LD   (RSAVE),HL   
02C6   CD 28 03     HP1:      CALL   prstr   
02C9                          ;*Macro unroll:  DROP
02C9                          DS   1-CPM,0DFh   
02C9   E1                     DS   CPM,0E1h   
02CA   DD                     DS   CPM,0DDh   
02CB   E9                     DS   CPM,0E9h   
02CC                          ENDIF      
02CC   7D           H_EMIT:   LD   A,L   ; "'"
02CD                          ;*Macro unroll:  PUTA
02CD                          DS   1-CPM,0EFh   
02CD   CD                     DS   CPM,0CDh   
02CE   0B                     DS   CPM,APUT&0FFh   
02CF   05                     DS   CPM,APUT/256   
02D0                          ;*Macro unroll: pr9:    DROP
02D0                PR9:      DS   1-CPM,0DFh   
02D0   E1                     DS   CPM,0E1h   
02D1   DD                     DS   CPM,0DDh   
02D2   E9                     DS   CPM,0E9h   
02D3                             ; "#" prints TOS as a signed decimal number, with no space after it.
02D3   CD 63 04     H_NUM:    CALL   psgn   
02D6                          ;*Macro unroll:  DROP
02D6                          DS   1-CPM,0DFh   
02D6   E1                     DS   CPM,0E1h   
02D7   DD                     DS   CPM,0DDh   
02D8   E9                     DS   CPM,0E9h   
02D9                             ; "?" ( n -- c ) or ( -n -- addr )
02D9                             ;   n > 0: wait about n ms for a key; 0 if none came
02D9                             ;   n = 0: wait for a key
02D9                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02D9                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02D9   CB 7C        H_KEY:    BIT   7,H   
02DB   20 1A                  JR   NZ,line   
02DD   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02DF   CD CF 04     KT2:      CALL   getk   
02E2   20 0E                  JR   NZ,kt3   
02E4   1D                     DEC   E   
02E5   20 F8                  JR   NZ,kt2   
02E7   7C                     LD   A,H   ; 0? never counts down: it waits
02E8   B5                     OR   L   
02E9   28 F2                  JR   Z,kt1   
02EB   2B                     DEC   HL   
02EC   7C                     LD   A,H   
02ED   B5                     OR   L   
02EE   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02F0   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02F1   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02F2   6F           KT3:      LD   L,A   
02F3   26 00                  LD   H,0   
02F5                          ;*Macro unroll:  NEXT
02F5                          DS   1-CPM,0F7h   
02F5   DD                     DS   CPM,0DDh   
02F6   E9                     DS   CPM,0E9h   
02F7                             ; Backspace takes the last character back (and is echoed as it
02F7                             ; is), CR ends (stored, not echoed), every other key is stored and
02F7                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02F7                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02F7                             ; is the place in the line: D holds the L of a full line.
02F7   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02FA   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02FB   9F                     SBC   A,A   
02FC   A5                     AND   L   ; (0 for a count that is too big)
02FD   2F                     CPL      
02FE   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
02FF                             ;   at most
02FF   21 80 0B               LD   HL,LINEBUF   
0302   CD CF 04     LN2:      CALL   getk   
0305   28 FB                  JR   Z,ln2   
0307   FE 0D                  CP   13   
0309   28 18                  JR   Z,ln5   
030B   FE 08                  CP   8   
030D   28 0D                  JR   Z,ln4   
030F   5F                     LD   E,A   
0310   7D                     LD   A,L   
0311   BA                     CP   D   
0312   28 EE                  JR   Z,ln2   ; full
0314   73                     LD   (HL),E   
0315   2C                     INC   L   
0316   7B                     LD   A,E   
0317                          ;*Macro unroll: ln3:    PUTA
0317                LN3:      DS   1-CPM,0EFh   
0317   CD                     DS   CPM,0CDh   
0318   0B                     DS   CPM,APUT&0FFh   
0319   05                     DS   CPM,APUT/256   
031A   18 E6                  JR   ln2   
031C   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
031D   FA 17 03               JP   M,ln3   ;   unless the line was empty (L left the
0320   2C                     INC   L   ;   upper half of the page)
0321   18 DF                  JR   ln2   
0323   77           LN5:      LD   (HL),A   ; the CR
0324   2E 80                  LD   L,LINEBUF & 0FFh   
0326                          ;*Macro unroll:  NEXT
0326                          DS   1-CPM,0F7h   
0326   DD                     DS   CPM,0DDh   
0327   E9                     DS   CPM,0E9h   
0328                             ; =============================================================================
0328                             ;  More routines (no handler starts past this point)
0328                             ; =============================================================================
0328                          IF   CHECKED   
0328                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0328                             ; "$", and the texts of the report). A NUL first is an error: Q.
0328   7E           PRSTR:    LD   A,(HL)   
0329   23                     INC   HL   
032A   FE 22                  CP   22h   
032C   C8                     RET   Z   
032D   B7                     OR   A   
032E   CA 8D 05               JP   Z,e_dollar   
0331   FE 2F                  CP   "/"   
0333   20 0C                  JR   NZ,prs1   
0335   7E                     LD   A,(HL)   
0336   23                     INC   HL   
0337   FE 60                  CP   60h   
0339   38 04                  JR   C,prs0   
033B   FE 7F                  CP   7Fh   
033D   38 13                  JR   C,pesc   
033F   E6 BF        PRS0:     AND   0BFh   
0341                          ;*Macro unroll: prs1:   PUTA
0341                PRS1:     DS   1-CPM,0EFh   
0341   CD                     DS   CPM,0CDh   
0342   0B                     DS   CPM,APUT&0FFh   
0343   05                     DS   CPM,APUT/256   
0344   18 E2                  JR   prstr   
0346                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0346                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0346                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0346                             ; pnl: the same, on a new line.
0346   CD 4C 03     PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
0349   0D 0A 22               DB   13,10,22h   ;   the caller's text)
034C   E3           PMSG:     EX   (SP),HL   
034D   CD 28 03               CALL   prstr   
0350   E3                     EX   (SP),HL   
0351   C9                     RET      
0352                          ENDIF      
0352                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0352                             ; HL points past it. Each goes back into the loop that prints the string
0352                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0352                             ;    /a-/z   print the variable, as "#" does
0352                             ;    /{      clear the screen, the cursor to the top left
0352                             ;    /}      clear from the cursor to the end of the line
0352                             ;    /|  /`  show the cursor, hide it
0352                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0352   FE 7E        PESC:     CP   7Eh   
0354   28 1C                  JR   Z,pat   
0356   11 28 03               LD   DE,PRLOOP   ; the others return into the loop
0359   D5                     PUSH   DE   
035A   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
035C   30 4A                  JR   NC,pcon   
035E   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0360   30 37                  JR   NC,phide   
0362   87                     ADD   A,A   ; the variable's cell
0363   C6 40                  ADD   A,40h   
0365   E5                     PUSH   HL   
0366   6F                     LD   L,A   
0367   26 0B                  LD   H,LETPAGE   
0369   7E                     LD   A,(HL)   
036A   2C                     INC   L   
036B   66                     LD   H,(HL)   
036C   6F                     LD   L,A   
036D   CD 63 04               CALL   psgn   
0370   E1                     POP   HL   
0371   C9                     RET      
0372                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0372                             ; the checked build "$" is the routine prstr: its own return address goes
0372                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0372                             ; its two cells are there, and is s if not, before it prints anything.
0372                PAT:         
0372                          IF   CHECKED   
0372   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
0373   21 0A F5               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
0376   39                     ADD   HL,SP   
0377   DA 47 05               JP   C,e_under   
037A   E1                     POP   HL   
037B                          ENDIF      
037B   D1                     POP   DE   ; DE = the column
037C   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
037D                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
037D                          ENDIF      
037D                          IF   ANS   
037D   D5                     PUSH   DE   
037E   CD BC 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0381   23                     INC   HL   
0382   CD 6E 04               CALL   pdec   
0385                          ;*Macro unroll:  PUTK    3Bh             ; ';'
0385                          DS   1-CPM,3Eh   ; ";"
0385                          DS   1-CPM,3Bh   
0385                          DS   1-CPM,0EFh   
0385   CD                     DS   CPM,0CDh   
0386   07                     DS   CPM,APTK&0FFh   
0387   05                     DS   CPM,APTK/256   
0388   3B                     DS   CPM,3Bh   
0389   E1                     POP   HL   
038A   23                     INC   HL   
038B   CD 6E 04               CALL   pdec   
038E                          ;*Macro unroll:  PUTK    48h             ; 'H'
038E                          DS   1-CPM,3Eh   ; "H"
038E                          DS   1-CPM,48h   
038E                          DS   1-CPM,0EFh   
038E   CD                     DS   CPM,0CDh   
038F   07                     DS   CPM,APTK&0FFh   
0390   05                     DS   CPM,APTK/256   
0391   48                     DS   CPM,48h   
0392   E1                     POP   HL   
0393   C3 C6 02               JP   PRAGAIN   
0396                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0396   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0398   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0399   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
039B                          ENDIF      
039B                          IF   ANS*CHECKED   
039B                             ; (The checked build prints the fixed parts with pmsg, which it has for the
039B                             ; report: shorter than a character at a time.)
039B   CD 4C 03               CALL   pmsg   
039E   1B 5B 3F 32 35 22      DB   27,"[?25",22h   
03A4   7B           PSE:      LD   A,E   ; then E
03A5                          ;*Macro unroll:  PUTAR
03A5                          DS   1-CPM,0EFh   
03A5                          DS   1-CPM,0C9h   
03A5   C3                     DS   CPM,0C3h   
03A6   0B                     DS   CPM,APUT&0FFh   
03A7   05                     DS   CPM,APUT/256   
03A8                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
03A8   3D           PCON:     DEC   A   
03A9   28 EB                  JR   Z,pshow   ; /|
03AB   1E 4B                  LD   E,"K"   
03AD   F2 B7 03               JP   P,cse   ; /}  ESC [ K
03B0   1E 48                  LD   E,"H"   ; /{  ESC [ H ESC [ J
03B2   CD B7 03               CALL   cse   
03B5   1E 4A                  LD   E,"J"   ; (on into cse)
03B7                             ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
03B7   CD BC 03     CSE:      CALL   csi   
03BA   18 E8                  JR   pse   
03BC   CD 4C 03     CSI:      CALL   pmsg   
03BF   1B 5B 22               DB   27,"[",22h   
03C2   C9                     RET      
03C3                          ENDIF      
03C3                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
03C3                          ENDIF      
03C3                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
03C3                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
03C3                             ; the quotient bits arrive at the bottom of C.
03C3                             ; Dividing by 2 is one shift (the spec wants that fast).
03C3   7B           UDIV:     LD   A,E   
03C4   EE 02                  XOR   2   
03C6   B2                     OR   D   
03C7   20 07                  JR   NZ,udv0   
03C9   CB 3C                  SRL   H   
03CB   CB 1D                  RR   L   ; the quotient
03CD   8F                     ADC   A,A   
03CE   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
03CF   C9                     RET      
03D0   C5           UDV0:     PUSH   BC   
03D1   7C                     LD   A,H   
03D2   4D                     LD   C,L   
03D3   21 00 00               LD   HL,0   
03D6   06 10                  LD   B,16   
03D8   CB 21        UDV1:     SLA   C   
03DA   17                     RLA      
03DB   ED 6A                  ADC   HL,HL   
03DD   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03DF   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03E1   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03E2   0D                     DEC   C   ;   INC below
03E3   0C           UDV2:     INC   C   ; a quotient bit
03E4   10 F2                  DJNZ   udv1   
03E6   EB                     EX   DE,HL   ; DE = remainder
03E7   67                     LD   H,A   
03E8   69                     LD   L,C   ; HL = quotient
03E9   C1                     POP   BC   
03EA   C9                     RET      
03EB                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
03EB                             ; non-digit. Values wrap at 16 bits, as the spec says.
03EB   21 00 00     RDNUM:    LD   HL,0   
03EE   0A           RDN1:     LD   A,(BC)   
03EF   D6 30                  SUB   "0"   
03F1   FE 0A                  CP   10   
03F3   D0                     RET   NC   
03F4   03                     INC   BC   
03F5   54                     LD   D,H   
03F6   5D                     LD   E,L   
03F7   29                     ADD   HL,HL   
03F8   29                     ADD   HL,HL   
03F9   19                     ADD   HL,DE   
03FA   29                     ADD   HL,HL   ; HL * 10
03FB   5F                     LD   E,A   
03FC   16 00                  LD   D,0   
03FE   19                     ADD   HL,DE   
03FF   18 ED                  JR   rdn1   
0401                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0401                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0401                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0401                          ENDIF      
0401                          IF   CHECKED   
0401                             ; The checked build never steps over a NUL: if the text runs out first it
0401                             ; returns A = 0 with the IP on the NUL.
0401   0A           SKIPSTR:   LD   A,(BC)   
0402   B7                     OR   A   
0403   C8                     RET   Z   
0404   03                     INC   BC   
0405   FE 22                  CP   22h   
0407   C8                     RET   Z   
0408   FE 2F                  CP   "/"   
040A   20 F5                  JR   NZ,skipstr   
040C   0A                     LD   A,(BC)   ; the escaped character
040D   B7                     OR   A   
040E   C8                     RET   Z   
040F   03                     INC   BC   
0410   18 EF                  JR   skipstr   
0412                          ENDIF      
0412                             ; skip: read past text to the closer at this level, and return A = 0 if it
0412                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0412                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0412                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0412                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0412                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0412                             ; 
0412                             ; The checked build also looks at the character the skip was started by,
0412                             ; which is always the one just before where it starts: "(" must end at ")",
0412                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0412                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
0412                             ; place where the skip started, for the report.
0412                SKIP:        
0412                          IF   CHECKED   
0412   ED 43 3C 0B            LD   (SKPL),BC   
0416   0B                     DEC   BC   
0417   0A                     LD   A,(BC)   
0418   03                     INC   BC   
0419   5F                     LD   E,A   ; E = the opener: ( [ or \
041A                          ENDIF      
041A   16 00                  LD   D,0   
041C   14           SK3:      INC   D   ; an opener: one deeper
041D   0A           SK1:      LD   A,(BC)   
041E                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
041E                          ENDIF      
041E                          IF   CHECKED   
041E   B7                     OR   A   
041F   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0421   03                     INC   BC   
0422                          ENDIF      
0422   FE 22                  CP   22h   
0424   CC 01 04               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0427   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0429   28 F1                  JR   Z,sk3   
042B   3D                     DEC   A   ; ")"
042C   28 08                  JR   Z,sk4   
042E   D6 32                  SUB   "["-")"   
0430   28 EA                  JR   Z,sk3   
0432   FE 02                  CP   "]"-"["   
0434   20 E7                  JR   NZ,sk1   
0436   15           SK4:      DEC   D   
0437                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0437                          ENDIF      
0437                          IF   CHECKED   
0437   20 E4                  JR   NZ,sk1   
0439   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
043A   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
043B   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
043D   FE 02                  CP   2   ;   closer, and only then
043F   7A                     LD   A,D   
0440   C0                     RET   NZ   
0441   18 05                  JR   sk7   
0443   CB 53        SK6:      BIT   2,E   ; the text ran out:
0445   C2 88 06               JP   NZ,SKEND   ;   "\" with no closer ends the program
0448   ED 4B 3C 0B  SK7:      LD   BC,(SKPL)   ; N. The place is the opener
044C   3E 4E                  LD   A,"N"   
044E   C3 8A 05               JP   errp   ; (errp drops skip's return address)
0451                          ENDIF      
0451                             ; =============================================================================
0451                             ;  Dispatch table: the low byte of each handler's address, in code order
0451                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0451                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0451                             ; =============================================================================
0451                             ; The handlers of the first NPG1 characters start in the image's second page.
0451                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0451                             ; differs between the builds, so the count is worked out here.
0451                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0451                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0451                PGBRK:    EQU   (h_break-BASE)/256   
0451                PGDEF:    EQU   (h_def-BASE)/256   
0451                PGFET:    EQU   (h_fetch-BASE)/256   
0451                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0451                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0451                          ENDIF      
0451                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0451                             ; and return its value in A with the carry set; otherwise leave the IP and
0451                             ; return with the carry clear.
0451   0A           HEXC:     LD   A,(BC)   
0452   D6 30                  SUB   "0"   
0454   FE 0A                  CP   10   
0456   38 09                  JR   C,hc1   
0458   E6 DF                  AND   0DFh   
045A   D6 11                  SUB   11h   
045C   FE 06                  CP   6   
045E   D0                     RET   NC   
045F   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0461   03           HC1:      INC   BC   
0462   C9                     RET      
0463                             ; psgn: print HL as a signed number. Keeps BC.
0463   CB 7C        PSGN:     BIT   7,H   
0465   28 07                  JR   Z,pdec   
0467                          ;*Macro unroll:  PUTK    2Dh             ; '-'
0467                          DS   1-CPM,3Eh   ; "-"
0467                          DS   1-CPM,2Dh   
0467                          DS   1-CPM,0EFh   
0467   CD                     DS   CPM,0CDh   
0468   07                     DS   CPM,APTK&0FFh   
0469   05                     DS   CPM,APTK/256   
046A   2D                     DS   CPM,2Dh   
046B                          ;*Macro unroll:  NEGH
046B                          DS   1-CPM,0E7h   
046B   CD                     DS   CPM,0CDh   
046C   EA                     DS   CPM,ANEG&0FFh   
046D   04                     DS   CPM,ANEG/256   
046E                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
046E                             ; Keeps BC.
046E   11 0A 00     PDEC:     LD   DE,10   
0471   CD C3 03               CALL   udiv   ; HL = HL / 10, E = the last digit
0474   7B                     LD   A,E   
0475   F5                     PUSH   AF   
0476   7C                     LD   A,H   
0477   B5                     OR   L   
0478   C4 6E 04               CALL   NZ,pdec   
047B   F1                     POP   AF   
047C   C6 30                  ADD   A,"0"   
047E                          ;*Macro unroll:  PUTAR
047E                          DS   1-CPM,0EFh   
047E                          DS   1-CPM,0C9h   
047E   C3                     DS   CPM,0C3h   
047F   0B                     DS   CPM,APUT&0FFh   
0480   05                     DS   CPM,APUT/256   
0481                             ; (The table goes here instead in the builds where, before psgn, it would
0481                             ; cross a page: PTLATE.)
0481                          IF   (1-TABP0)*PTLATE   
0481                PTAB:        
0481                          ;*Macro unroll:  PTABLE
0481   AD                     DB   h_store & 0FFh   
0482   B7                     DB   h_str & 0FFh   
0483   D3                     DB   h_num & 0FFh   
0484   C3                     DB   h_print & 0FFh   
0485   A2                     DB   h_swap & 0FFh   
0486   42                     DB   h_and & 0FFh   
0487   CC                     DB   h_emit & 0FFh   
0488   15                     DB   h_open & 0FFh   
0489   1D                     DB   h_close & 0FFh   
048A   65                     DB   h_mul & 0FFh   
048B   35                     DB   h_add & 0FFh   
048C   F1                     DB   h_cfetch & 0FFh   
048D   2B                     DB   h_sub & 0FFh   
048E   A5                     DB   h_cstore & 0FFh   
048F   7A                     DB   h_div & 0FFh   
0490   9F                     DB   h_dup & 0FFh   
0491   AA                     DB   h_drop & 0FFh   
0492   4B                     DB   h_lt & 0FFh   
0493   5B                     DB   h_eq & 0FFh   
0494   4C                     DB   h_gt & 0FFh   
0495   D9                     DB   h_key & 0FFh   
0496   0F                     DB   h_fetch & 0FFh   
0497   EA                     DB   h_def & 0FFh   
0498   DA                     DB   h_break & 0FFh   
0499   D3                     DB   h_ret & 0FFh   
049A   62                     DB   h_xor & 0FFh   
049B   7A                     DB   h_alloc & 0FFh   
049C   BB                     DB   h_grave & 0FFh   
049D   B7                     DB   h_tor & 0FFh   
049E   6B                     DB   h_or & 0FFh   
049F   12                     DB   h_fromr & 0FFh   
04A0   74                     DB   h_not & 0FFh   
04A1                PTABEND:      
04A1                          ENDIF      
04A1                             ; =============================================================================
04A1                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
04A1                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
04A1                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
04A1                             ;  they are the host's KEY and CONOUT routines themselves.
04A1                             ; 
04A1                             ;  A running program reads the keyboard only through getk and pollk, which
04A1                             ;  between them give the break key its rules:
04A1                             ;    - Ctrl-C stops the program;
04A1                             ;    - any other key that the break check reads is held in KEYBUF for the
04A1                             ;      next "?", and a newer one takes its place;
04A1                             ;    - "?" (getk) takes the held key first;
04A1                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
04A1                             ;      key like any other, but two of them within about 250 ms still stop it.
04A1                             ;  Both are called straight from a handler, never from a routine under one:
04A1                             ;  the checked build's report counts on finding one return address above the
04A1                             ;  data stack.
04A1                             ; =============================================================================
04A1                          IFN   CPM   
                    RAWK:     EQU   KEY   
04A1                          ENDIF      
04A1                             ; pollk: the break check (see rpushn).
04A1   CD 03 05     POLLK:    CALL   rawk   
04A4   C8                     RET   Z   ; no key
04A5   32 7A 0B               LD   (KEYBUF),A   ; held for the next "?"
04A8   FE 03        PK1:      CP   3   ; (getk joins here)
04AA   C0                     RET   NZ   
04AB                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
04AB                             ; the program has turned it off, wait about 250 ms for one more key: a
04AB                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
04AB                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
04AB   3A 7B 0B     CTLC:     LD   A,(BRKOFF)   
04AE   B7                     OR   A   
04AF   CA 88 05     CT0:      JP   Z,brk   
04B2   D5                     PUSH   DE   
04B3   11 10 27               LD   DE,250*MSLOOP   
04B6   CD 03 05     CT1:      CALL   rawk   
04B9   20 05                  JR   NZ,ct2   
04BB   1B                     DEC   DE   
04BC   7A                     LD   A,D   
04BD   B3                     OR   E   
04BE   20 F6                  JR   NZ,ct1   
04C0   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
04C1   FE 03                  CP   3   
04C3   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
04C5   B7                     OR   A   
04C6   28 03                  JR   Z,ct3   
04C8   32 7A 0B               LD   (KEYBUF),A   
04CB   3E 03        CT3:      LD   A,3   
04CD   B7                     OR   A   
04CE   C9                     RET      
04CF                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04CF   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
04D0   21 7A 0B               LD   HL,KEYBUF   ;   the buffer
04D3   7E                     LD   A,(HL)   
04D4   36 00                  LD   (HL),0   
04D6   E1                     POP   HL   
04D7   B7                     OR   A   
04D8   C0                     RET   NZ   
04D9   CD 03 05               CALL   rawk   
04DC   C8                     RET   Z   
04DD   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
04DF                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
04DF                          ENDIF      ;   (with the editor, both stacks are cleared);
04DF                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
04DF                          ENDIF      
04DF                          IF   CHECKED   
04DF                BRK:      EQU   e_break   ;   the checked build reports B
04DF                          ENDIF      
04DF                          IF   CPM   
04DF                             ; The routines a generic build keeps in page zero (see there). Here they are
04DF                             ; out of the way of the handlers, which must fit in the image's first two
04DF                             ; pages.
04DF   FD 5E 00     RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
04E2   FD 56 01               LD   D,(IY+1)   
04E5   FD 23                  INC   IY   
04E7   FD 23                  INC   IY   
04E9   C9                     RET      
04EA   AF           NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
04EB   95                     SUB   L   
04EC   6F                     LD   L,A   
04ED   9F                     SBC   A,A   
04EE   94                     SUB   H   
04EF   67                     LD   H,A   
04F0   C9                     RET      
04F1                          ENDIF      
04F1                          IF   CPM*CHECKED   ; (the checked builds need the room)
04F1   FD 22 34 0B  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
04F5   CD BA 01               CALL   jphl   
04F8   FD 2A 34 0B            LD   IY,(RSAVE)   
04FC                          ;*Macro unroll:  SETIX
04FC   DD                     DS   CPM,0DDh   
04FD   21                     DS   CPM,21h   
04FE   20                     DS   CPM,ANXT&0FFh   
04FF   01                     DS   CPM,ANXT/256   
0500   E1                     POP   HL   
0501                          ;*Macro unroll:  NEXT
0501                          DS   1-CPM,0F7h   
0501   DD                     DS   CPM,0DDh   
0502   E9                     DS   CPM,0E9h   
0503                          ENDIF      
0503                          IF   CPM   
0503   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0505   18 04                  JR   putc   
0507   E3           PUTK:     EX   (SP),HL   ; print the byte after the CALL
0508   7E                     LD   A,(HL)   
0509   23                     INC   HL   
050A   E3                     EX   (SP),HL   
050B                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
050B                             ; printing and could swallow a key that BDOS 6 then never sees.
050B                             ; It keeps every register but A and the flags: BDOS may change any of them
050B                             ; (IX and IY too, in a Z80 BDOS or BIOS).
050B   C5           PUTC:     PUSH   BC   
050C   D5                     PUSH   DE   
050D   E5                     PUSH   HL   
050E   DD E5                  PUSH   IX   
0510   FD E5                  PUSH   IY   
0512   5F                     LD   E,A   
0513   0E 06                  LD   C,6   
0515   CD 05 00               CALL   BDOS   
0518   FD E1                  POP   IY   
051A   DD E1                  POP   IX   
051C   E1                     POP   HL   
051D   D1                     POP   DE   
051E   C1                     POP   BC   
051F   B7                     OR   A   ; (for getk)
0520   C9                     RET      
0521                          ENDIF      
0521                             ; =============================================================================
0521                             ;  Checked build: the checks and the error report
0521                             ; =============================================================================
0521                          IF   CHECKED   
0521                             ; chkstk: both stacks are checked once per character, not in every handler.
0521                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0521                             ; the constant carries if it is above (cells were popped that were never
0521                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0521                             ; a character late at most: the bytes above DSTOP and the guard band below
0521                             ; the page take what happens meanwhile. DE is free between characters.
0521   EB           CHKSTK:   EX   DE,HL   
0522   21 05 F5               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0525   39                     ADD   HL,SP   
0526   EB                     EX   DE,HL   
0527   38 1E                  JR   C,e_under   
0529   14                     INC   D   
052A   20 17                  JR   NZ,e_over   
052C   FD E5                  PUSH   IY   ; the return stack: in its page (or it has
052E   D1                     POP   DE   ;   overflowed), and not above its empty
052F   7A                     LD   A,D   ;   position (an underflow stays inside the
0530   FE 09                  CP   RSPAGE   ;   page, in the guard band)
0532   7B                     LD   A,E   
0533   20 0B                  JR   NZ,e_rover   
0535   FE E1                  CP   RSTOP&0FFh+1   
0537   D8                     RET   C   
0538   FD 21 E0 09            LD   IY,RSTOP   ; return stack underflow: it counts as empty
053C   3E 72                  LD   A,"r"   
053E   18 4A                  JR   errp   
0540   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0542   11                     DB   11h   ; (LD DE,nn hides the next entry)
0543   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0545   18 43                  JR   errp   
0547   31 FC 0A     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
054A   3E 73                  LD   A,"s"   
054C   18 56                  JR   error   
054E                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
054E                             ; was never defined still holds 0000h, and the byte there is a reserved one
054E                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
054E                             ; an undefined word. The call is undone, so the place is the call itself.
054E   04           E_HI:     INC   B   
054F   10 4B                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0551                          ;*Macro unroll:  POPR
0551                          DS   1-CPM,0CFh   
0551   CD                     DS   CPM,0CDh   
0552   DF                     DS   CPM,AROP&0FFh   
0553   04                     DS   CPM,AROP/256   
0554   42                     LD   B,D   
0555   4B                     LD   C,E   
0556   3E 55                  LD   A,"U"   
0558   18 4A                  JR   error   
055A                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
055A                             ; the count. Stop if the top is not below the limit page, or is below the
055A                             ; program's end.
055A                CHKHP:       
055A                          ENDIF      
055A                          IF   CHECKED*CPM   
055A                             ; With this much room a top that wrapped round can land back in
055A                             ; range, so the add is tested too: growing (A, the count's high
055A                             ; byte, is positive) must not carry, and releasing must.
055A   1F                     RRA      ; the carry comes in above the sign:
055B   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
055D   87                     ADD   A,A   
055E   38 10                  JR   C,e_heap   
0560   3A 07 00               LD   A,(0007h)   
0563   3D                     DEC   A   
0564   BC                     CP   H   
0565   38 09                  JR   C,e_heap   
0567                          ENDIF      
0567                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0567                          ENDIF      
0567                          IF   CHECKED   
0567   D5                     PUSH   DE   
0568   EB                     EX   DE,HL   
0569   2A 38 0B               LD   HL,(NPEND)   
056C   19                     ADD   HL,DE   ; carry: at or above the program's end
056D   EB                     EX   DE,HL   
056E   D1                     POP   DE   
056F   D8                     RET   C   
0570   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0571   ED 52                  SBC   HL,DE   
0573   3E 48                  LD   A,"H"   
0575   18 13                  JR   errp   
0577                             ; chkst: stop unless HL is in the program's own space: from the letter page
0577                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0577                             ; whatever lies above the limit are safe. Memory above the heap top but
0577                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0577                             ; It is the page of HL + 1 that is tested, so that one test serves both
0577                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0577                             ; Keeps HL and BC. It runs on into its own error entry.
0577   23           CHKST:    INC   HL   
0578   7C                     LD   A,H   
0579   2B                     DEC   HL   
057A   FE 0B                  CP   LETPAGE   
057C   38 07                  JR   C,e_store   
057E                          ENDIF      
057E                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
057E                          ENDIF      
057E                          IF   CHECKED*CPM   
057E   5F                     LD   E,A   
057F   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0582   3D                     DEC   A   
0583   BB                     CP   E   
0584   D0                     RET   NC   
0585                          ENDIF      
0585                          IF   CHECKED   
0585                             ; Error entries. Each loads its letter and then hides the next entry inside
0585                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0585   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
0587   11                     DB   11h   
0588   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
058A                             ; errp: an error found inside a routine: drop its return address first.
058A   D1           ERRP:     POP   DE   
058B   18 17                  JR   error   
058D                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
058D                             ; back in TOS. prstr"s return address goes first. But if "$' had no
058D                             ; address at all (the stack was empty), it is s, found now: chkstk, called
058D                             ; one cell up, sees the stack past its empty place then.
058D   D1           E_DOLLAR:   POP   DE   
058E   E1                     POP   HL   
058F   CD 21 05               CALL   chkstk   
0592   E5                     PUSH   HL   
0593   2A 34 0B               LD   HL,(RSAVE)   
0596   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
0597   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0598   4D                     LD   C,L   ;   past the opening quote, which is the place
0599   3E 51                  LD   A,"Q"   
059B   11                     DB   11h   
059C   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
059E   11                     DB   11h   
059F   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
05A1   11                     DB   11h   
05A2   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
05A4                             ; error: the report, then the end. A = the letter, BC = one past the place,
05A4                             ; HL = TOS, and both stacks as the report is to show them:
05A4                             ; 
05A4                             ;   Err X @ line,col
05A4                             ;   D:n: the top 8 cells at most, bottom to top
05A4                             ;   R:n
05A4   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
05A5   5F                     LD   E,A   
05A6   CD 46 03               CALL   pnl   
05A9   45 72 72 20 22         DB   "Err ",22h   
05AE   7B                     LD   A,E   
05AF                          ;*Macro unroll:  PUTA
05AF                          DS   1-CPM,0EFh   
05AF   CD                     DS   CPM,0CDh   
05B0   0B                     DS   CPM,APUT&0FFh   
05B1   05                     DS   CPM,APUT/256   
05B2   CD 4C 03               CALL   pmsg   
05B5   20 40 20 22            DB   " @ ",22h   
05B9   0B                     DEC   BC   ; BC = the place
05BA                             ; The line and column. A place below the program is in the line
05BA                             ; buffer: line 0. Otherwise count the LFs from the program's start;
05BA                             ; DE = the line's number, HL = where it starts.
05BA   21 80 0B               LD   HL,LINEBUF   
05BD   11 00 00               LD   DE,0   
05C0   78                     LD   A,B   
05C1   FE 0C                  CP   PROG/256   
05C3   38 14                  JR   C,er3   
05C5   24                     INC   H   
05C6   6B                     LD   L,E   ; HL = PROG
05C7   13           ER1:      INC   DE   ; a new line starts at HL
05C8   E5                     PUSH   HL   
05C9   7D           ER2:      LD   A,L   
05CA   91                     SUB   C   
05CB   7C                     LD   A,H   
05CC   98                     SBC   A,B   
05CD   30 09                  JR   NC,er2x   ; reached the place
05CF   7E                     LD   A,(HL)   
05D0   23                     INC   HL   
05D1   FE 0A                  CP   10   
05D3   20 F4                  JR   NZ,er2   
05D5   F1                     POP   AF   
05D6   18 EF                  JR   er1   
05D8   E1           ER2X:     POP   HL   
05D9   C5           ER3:      PUSH   BC   
05DA   E5                     PUSH   HL   
05DB   EB                     EX   DE,HL   
05DC   CD 6E 04               CALL   pdec   ; the line
05DF                          ;*Macro unroll:  PUTK    2Ch             ; ','
05DF                          DS   1-CPM,3Eh   ; ","
05DF                          DS   1-CPM,2Ch   
05DF                          DS   1-CPM,0EFh   
05DF   CD                     DS   CPM,0CDh   
05E0   07                     DS   CPM,APTK&0FFh   
05E1   05                     DS   CPM,APTK/256   
05E2   2C                     DS   CPM,2Ch   
05E3   D1                     POP   DE   
05E4   E1                     POP   HL   
05E5   B7                     OR   A   
05E6   ED 52                  SBC   HL,DE   
05E8   23                     INC   HL   
05E9   CD 6E 04               CALL   pdec   ; the column
05EC                             ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
05EC                             ;                       R:n
05EC                             ; TOS is in memory with the rest (pushed) by now.
05EC   CD 46 03               CALL   pnl   
05EF   44 3A 22               DB   "D:",22h   
05F2   21 FA 0A               LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
05F5   ED 72                  SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
05F7                             ;   and holds nothing; pnl left the carry clear)
05F7   CD 3E 06               CALL   phalf   ; the depth
05FA                          ;*Macro unroll:  PUTK    3Ah             ; ':'
05FA                          DS   1-CPM,3Eh   ; ":"
05FA                          DS   1-CPM,3Ah   
05FA                          DS   1-CPM,0EFh   
05FA   CD                     DS   CPM,0CDh   
05FB   07                     DS   CPM,APTK&0FFh   
05FC   05                     DS   CPM,APTK/256   
05FD   3A                     DS   CPM,3Ah   
05FE   79                     LD   A,C   
05FF   FE 09                  CP   9   
0601   38 0A                  JR   C,er6   
0603   CD 4C 03               CALL   pmsg   
0606   20 2E 2E 2E 22         DB   " ...",22h   
060B   0E 08                  LD   C,8   
060D   26 00        ER6:      LD   H,0   ; C = the number of cells to show
060F   69                     LD   L,C   
0610   29                     ADD   HL,HL   
0611   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0612   0C                     INC   C   
0613   0D           ER7:      DEC   C   
0614   28 10                  JR   Z,er8   
0616   2B                     DEC   HL   
0617   56                     LD   D,(HL)   
0618   2B                     DEC   HL   
0619   5E                     LD   E,(HL)   
061A   E5                     PUSH   HL   
061B                          ;*Macro unroll:  PUTK    20h             ; ' '
061B                          DS   1-CPM,3Eh   ; " "
061B                          DS   1-CPM,20h   
061B                          DS   1-CPM,0EFh   
061B   CD                     DS   CPM,0CDh   
061C   07                     DS   CPM,APTK&0FFh   
061D   05                     DS   CPM,APTK/256   
061E   20                     DS   CPM,20h   
061F   EB                     EX   DE,HL   
0620   CD 63 04               CALL   psgn   
0623   E1                     POP   HL   
0624   18 ED                  JR   er7   
0626   CD 46 03     ER8:      CALL   pnl   
0629   52 3A 22               DB   "R:",22h   
062C   FD E5                  PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
062E   E1                     POP   HL   ;   at most one entry below its page), so
062F   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough
0631   95                     SUB   L   
0632   6F                     LD   L,A   
0633   26 00                  LD   H,0   
0635   CD 3E 06               CALL   phalf   
0638   CD 46 03               CALL   pnl   
063B   22                     DB   22h   
063C                          ENDIF      
063C                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
063C                          ENDIF      
063C                          IF   CHECKED*EDITOR   
063C   18 42                  JR   edit0   ; back to the editor, with both stacks cleared
063E                          ENDIF      
063E                          IF   CHECKED   
063E                             ; phalf: print half of HL, and leave it in C.
063E   CB 3C        PHALF:    SRL   H   
0640   CB 1D                  RR   L   
0642   E5                     PUSH   HL   
0643   CD 6E 04               CALL   pdec   
0646   C1                     POP   BC   
0647   C9                     RET      
0648                          ENDIF      
0648                             ; =============================================================================
0648                             ;  The line editor (EDITOR = 1)
0648                             ; 
0648                             ;  The interpreter starts here, and a program that ends comes back here.
0648                             ;  There is no prompt. It follows the spec's suggested standard for a line
0648                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0648                             ; 
0648                             ;    n text    put the text in as line n; the lines from n on move down. A
0648                             ;              number past the end (or 0) adds the line at the end.
0648                             ;    n         take line n out
0648                             ;    anything else is run at once, as B8Script. (Start such a line with a
0648                             ;    space if it would begin with a digit.)
0648                             ; 
0648                             ;  A command key ends the line too, and takes what was typed as its argument:
0648                             ; 
0648                             ;    ^G        run the program
0648                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0648                             ;              list until another key is pressed; Ctrl-C ends it.
0648                             ;    n ^E      put line n in the input line; Return puts it back, changed
0648                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0648                             ;              last time). Generic: what is typed, or pasted, from now until
0648                             ;              ^Z replaces the program; it is not echoed.
0648                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0648                             ;              time). Generic: the text is printed, as it is.
0648                             ;    ^N        new: no program
0648                             ;    ^X        leave (to LEAVE)
0648                             ; 
0648                             ;  In the line: the left and right arrow keys move the cursor;
0648                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0648                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0648                             ;  sent to the terminal, so any terminal will do.
0648                             ; 
0648                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0648                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0648                             ;  125 characters; the one character after a line number separates it from
0648                             ;  the text and is not stored. The text is kept as it is typed, each line
0648                             ;  ending in CR LF, at PROG.
0648                             ; 
0648                             ;  What lasts from one line to the next: the program, the words, the
0648                             ;  variables and the data stack. An error or a break clears both stacks. The
0648                             ;  return stack starts empty for every line.
0648                             ; 
0648                             ;  Things to know:
0648                             ;    - Reset empties the program (generic builds).
0648                             ;    - A word's address points into the program, so run the program again
0648                             ;      after editing it.
0648                             ;    - Nothing is printed between a program's output and what is typed next.
0648                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0648                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0648                             ;      (The stored program never comes back to the line, so it may.)
0648                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0648                             ;      read of the other builds.
0648                             ; 
0648                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0648                             ;  the last line left there, with TOS pushed like the rest.
0648                             ; =============================================================================
0648                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
0648                          ENDIF      
0648                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0648                          ENDIF      
0648                          IF   EDGEN   
                              JR   edit0   
0648                          ENDIF      
0648                          IF   EDITOR   
0648                             ; Right arrow: one to the right, by printing the character there
0648   7D           RIGHT:    LD   A,L   
0649   BB                     CP   E   
064A   28 53                  JR   Z,ed1   ; at the end
064C   7E                     LD   A,(HL)   
064D   2C                     INC   L   
064E   18 2B                  JR   lf1   
0650                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0650                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0650                             ; ends the sequence, and act on C (right) and D (left).
0650   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0653   CD 03 05     ES1:      CALL   rawk   
0656   20 0A                  JR   NZ,es2   
0658   0B                     DEC   BC   
0659   78                     LD   A,B   
065A   B1                     OR   C   
065B   20 F6                  JR   NZ,es1   
065D   CD CC 06               CALL   fin   ; no second key: the line is dropped
0660   18 28                  JR   edit   
0662   FE 5B        ES2:      CP   "["   
0664   20 39                  JR   NZ,ed1   ; not a sequence known here
0666   CD 2B 07     ES3:      CALL   ekey   
0669   FE 40                  CP   40h   
066B   38 F9                  JR   C,es3   ; (its parameters)
066D   D6 43                  SUB   "C"   
066F   28 D7                  JR   Z,right   
0671   3D                     DEC   A   ; "D"?
0672   20 2B                  JR   NZ,ed1   ; no: on into left
0674                             ; Left arrow: the cursor goes one to the left
0674   7D           LEFT:     LD   A,L   
0675   87                     ADD   A,A   
0676   28 27                  JR   Z,ed1   ; (L = 80h: at the start)
0678   2D                     DEC   L   
0679   3E 08                  LD   A,8   
067B                          ;*Macro unroll: lf1:    PUTA
067B                LF1:      DS   1-CPM,0EFh   
067B   CD                     DS   CPM,0CDh   
067C   0B                     DS   CPM,APUT&0FFh   
067D   05                     DS   CPM,APUT/256   
067E   18 1F                  JR   ed1   
0680                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
0680                             ;   is shown, in case the program had hidden it and could not show it again.
0680                             ; skend: a program that ended inside skip: its return address goes.
0680                             ; edend: a program that ended: TOS joins the rest of the data stack.
0680   31 FA 0A     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0683                          ENDIF      
0683                          IF   EDITOR*ANS   
0683   AF                     XOR   A   ; (pshow wants the carry clear)
0684   CD 96 03               CALL   pshow   ; ESC [ ? 2 5 h
0687                          ENDIF      
0687                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
0687                          ENDIF      
0687                          IF   EDITOR   
0687   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0688   D1           SKEND:    POP   DE   
0689   E5           EDEND:    PUSH   HL   
068A                             ; edit: start a new input line.
068A   FD 21 E0 09  EDIT:     LD   IY,RSTOP   ; the return stack is empty
068E                          ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
068E   DD                     DS   CPM,0DDh   ; (a file read or written may have changed IX)
068F   21                     DS   CPM,21h   
0690   20                     DS   CPM,ANXT&0FFh   
0691   01                     DS   CPM,ANXT/256   
0692   21 00 00               LD   HL,0   
0695   22 7A 0B               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0698   22 3A 0B               LD   (EDLN),HL   ; no line is being edited
069B   21 80 0B               LD   HL,LINEBUF   ; HL = the cursor,
069E   5D                     LD   E,L   ;   E = the end of the line (its low byte)
069F   CD 2B 07     ED1:      CALL   ekey   
06A2   FE 7F                  CP   7Fh   
06A4   28 38                  JR   Z,bsp   ; DEL
06A6   FE 20                  CP   " "   
06A8   30 4F                  JR   NC,insc   
06AA   FE 09                  CP   9   
06AC   28 4B                  JR   Z,insc   ; Tab is text
06AE   FE 08                  CP   8   
06B0   28 2C                  JR   Z,bsp   
06B2   FE 1B                  CP   1Bh   
06B4   28 9A                  JR   Z,esc   
06B6   E5                     PUSH   HL   ; a command key? Look it up
06B7   21 31 07               LD   HL,cmds   
06BA   06 08                  LD   B,NCMD   
06BC   BE           ED2:      CP   (HL)   
06BD   23                     INC   HL   
06BE   28 07                  JR   Z,ed3   
06C0   23                     INC   HL   
06C1   23                     INC   HL   
06C2   10 F8                  DJNZ   ed2   
06C4   E1                     POP   HL   
06C5   18 D8                  JR   ed1   ; no: the key is ignored
06C7   7E           ED3:      LD   A,(HL)   
06C8   23                     INC   HL   
06C9   66                     LD   H,(HL)   
06CA   6F                     LD   L,A   
06CB   E3                     EX   (SP),HL   ; the command's address: fin returns to it
06CC                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
06CC                             ; terminal. Leaves BC -> the line and HL -> the NUL.
06CC   26 0B        FIN:      LD   H,LETPAGE   
06CE   6B                     LD   L,E   
06CF   36 0D                  LD   (HL),13   
06D1   2C                     INC   L   
06D2   36 0A                  LD   (HL),10   
06D4   2D                     DEC   L   
06D5   CD 36 08               CALL   prl   ; (prints the CR LF)
06D8   36 00                  LD   (HL),0   
06DA   01 80 0B               LD   BC,LINEBUF   
06DD   C9                     RET      
06DE                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
06DE                             ; left, the rest of the line moves down over it, and the last place (now a
06DE                             ; space) is printed over along with the rest.
06DE   7D           BSP:      LD   A,L   
06DF   87                     ADD   A,A   
06E0   28 BD                  JR   Z,ed1   ; at the start
06E2   2D                     DEC   L   
06E3                          ;*Macro unroll:  PUTK    08h             ; backspace
06E3                          DS   1-CPM,3Eh   ; backspace
06E3                          DS   1-CPM,08h   
06E3                          DS   1-CPM,0EFh   
06E3   CD                     DS   CPM,0CDh   
06E4   07                     DS   CPM,APTK&0FFh   
06E5   05                     DS   CPM,APTK/256   
06E6   08                     DS   CPM,08h   
06E7   E5                     PUSH   HL   
06E8   2C           BS1:      INC   L   
06E9   7E                     LD   A,(HL)   
06EA   2D                     DEC   L   
06EB   77                     LD   (HL),A   
06EC   2C                     INC   L   
06ED   7D                     LD   A,L   
06EE   BB                     CP   E   
06EF   20 F7                  JR   NZ,bs1   
06F1   2D                     DEC   L   
06F2   36 20                  LD   (HL)," "   
06F4   E1                     POP   HL   
06F5   53                     LD   D,E   
06F6   1D                     DEC   E   
06F7   18 17                  JR   ic2   
06F9                             ; A character goes in at the cursor: it ripples up through the rest of the
06F9                             ; line, the cursor moves on, and the rest is printed again.
06F9   47           INSC:     LD   B,A   
06FA   7B                     LD   A,E   
06FB   FE FD                  CP   0FDh   
06FD   28 A0                  JR   Z,ed1   ; the line is full: 125 characters
06FF   78                     LD   A,B   
0700                          ;*Macro unroll:  PUTA
0700                          DS   1-CPM,0EFh   
0700   CD                     DS   CPM,0CDh   
0701   0B                     DS   CPM,APUT&0FFh   
0702   05                     DS   CPM,APUT/256   
0703   E5                     PUSH   HL   
0704   7E           IC1:      LD   A,(HL)   
0705   70                     LD   (HL),B   
0706   47                     LD   B,A   
0707   7D                     LD   A,L   
0708   2C                     INC   L   
0709   BB                     CP   E   
070A   20 F8                  JR   NZ,ic1   
070C   E1                     POP   HL   
070D   2C                     INC   L   
070E   1C                     INC   E   
070F   53                     LD   D,E   
0710   CD 15 07     IC2:      CALL   tail   
0713   18 8A                  JR   ed1   
0715                             ; tail: print the line from the cursor to D (a low byte), and bring the
0715                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0715   4D           TAIL:     LD   C,L   
0716   7D           TA1:      LD   A,L   
0717   BA                     CP   D   
0718   28 07                  JR   Z,ta2   
071A   7E                     LD   A,(HL)   
071B                          ;*Macro unroll:  PUTA
071B                          DS   1-CPM,0EFh   
071B   CD                     DS   CPM,0CDh   
071C   0B                     DS   CPM,APUT&0FFh   
071D   05                     DS   CPM,APUT/256   
071E   2C                     INC   L   
071F   18 F5                  JR   ta1   
0721   7D           TA2:      LD   A,L   
0722   B9                     CP   C   
0723   C8                     RET   Z   
0724                          ;*Macro unroll:  PUTK    08h             ; backspace
0724                          DS   1-CPM,3Eh   ; backspace
0724                          DS   1-CPM,08h   
0724                          DS   1-CPM,0EFh   
0724   CD                     DS   CPM,0CDh   
0725   07                     DS   CPM,APTK&0FFh   
0726   05                     DS   CPM,APTK/256   
0727   08                     DS   CPM,08h   
0728   2D                     DEC   L   
0729   18 F6                  JR   ta2   
072B                             ; ekey: wait for a key
072B   CD 03 05     EKEY:     CALL   rawk   
072E   28 FB                  JR   Z,ekey   
0730   C9                     RET      
0731                             ; The command keys, and where each goes (after fin).
0731   0D           CMDS:     DB   13   
0732   7B 07                  DW   cret   
0734   07                     DB   7   ; ^G
0735   C3 07                  DW   crun   
0737   0C                     DB   12   ; ^L
0738   DC 07                  DW   clist   
073A   05                     DB   5   ; ^E
073B   4F 07                  DW   cedln   
073D   12                     DB   18   ; ^R
073E   CD 08                  DW   cread   
0740   17                     DB   23   ; ^W
0741   41 08                  DW   cwrite   
0743   0E                     DB   14   ; ^N
0744   49 07                  DW   cnew   
0746   18                     DB   24   ; ^X
0747   00 00                  DW   LEAVE   
0749                NCMD:     EQU   8   
0749                             ; ^N: no program
0749   AF           CNEW:     XOR   A   
074A   32 00 0C               LD   (PROG),A   
074D   18 71        GED0:     JR   gedit   
074F                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
074F                             ; line it was: Return puts the text back in its place.
074F   CD EB 03     CEDLN:    CALL   rdnum   
0752   E5                     PUSH   HL   
0753   CD 1E 08               CALL   find   ; HL -> the line, or the NUL if there is none
0756   D1                     POP   DE   
0757   7E                     LD   A,(HL)   
0758   B7                     OR   A   
0759   28 F2                  JR   Z,ged0   
075B   ED 53 3A 0B            LD   (EDLN),DE   
075F   11 80 0B               LD   DE,LINEBUF   
0762   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0763   FE 0D                  CP   13   
0765   28 0F                  JR   Z,ce2   
0767   FE 0A                  CP   10   
0769   28 0B                  JR   Z,ce2   
076B   12                     LD   (DE),A   
076C                          ;*Macro unroll:  PUTA
076C                          DS   1-CPM,0EFh   
076C   CD                     DS   CPM,0CDh   
076D   0B                     DS   CPM,APUT&0FFh   
076E   05                     DS   CPM,APUT/256   
076F   23                     INC   HL   
0770   1C                     INC   E   
0771   7B                     LD   A,E   
0772   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0774   20 EC                  JR   NZ,ce1   
0776   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
0777   5D                     LD   E,L   
0778   C3 9F 06               JP   ed1   
077B                             ; Return. If ^E put a line here, the text goes back in its place. If not:
077B                             ; a number and text is a line to put in, a number alone a line to take out,
077B                             ; and anything else is run where it is.
077B   E5           CRET:     PUSH   HL   ; the end of what was typed
077C   2A 3A 0B               LD   HL,(EDLN)   
077F   7C                     LD   A,H   
0780   B5                     OR   L   
0781   28 07                  JR   Z,cr1   
0783   E5                     PUSH   HL   
0784   CD 0E 08               CALL   delln   
0787   E1                     POP   HL   
0788   18 13                  JR   ins   
078A   CD EB 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
078D   79                     LD   A,C   ; C is still 80h if there was no number:
078E   87                     ADD   A,A   ;   only then is twice it 0
078F   28 36                  JR   Z,st0p   ; no number: run the line
0791   0A                     LD   A,(BC)   
0792   FE 0D                  CP   13   
0794   20 06                  JR   NZ,cr2   
0796   D1                     POP   DE   ; the number alone: take that line out
0797   CD 0E 08               CALL   delln   
079A   18 24                  JR   gedit   
079C   03           CR2:      INC   BC   ; step over the one character after the number
079D                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
079D                             ; CR and LF included, and copy it in.
079D   CD 1E 08     INS:      CALL   find   ; HL -> where it goes
07A0   D1                     POP   DE   ; the end of what was typed
07A1   7B                     LD   A,E   
07A2   91                     SUB   C   ; A = the length of the text, with its CR LF
07A3   C5                     PUSH   BC   ; the text
07A4   4F                     LD   C,A   
07A5   06 00                  LD   B,0   
07A7   C5                     PUSH   BC   ; its length
07A8   54                     LD   D,H   
07A9   5D                     LD   E,L   ; DE = where it goes
07AA   AF                     XOR   A   
07AB   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
07AC   ED B1                  CPIR      ; HL -> one past the program's NUL
07AE   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
07B0   44                     LD   B,H   
07B1   4D                     LD   C,L   
07B2   19                     ADD   HL,DE   
07B3   2B                     DEC   HL   ; HL -> the NUL
07B4   EB                     EX   DE,HL   
07B5   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
07B6   E5                     PUSH   HL   
07B7   19                     ADD   HL,DE   ; the NUL's new place
07B8   EB                     EX   DE,HL   
07B9   ED B8                  LDDR      ; move the rest of the program up
07BB   C1                     POP   BC   ; the length
07BC   D1                     POP   DE   ; where it goes
07BD   E1                     POP   HL   ; the text
07BE   ED B0                  LDIR      
07C0   C3 8A 06     GEDIT:    JP   edit   
07C3                             ; ^G: run the program. st0p: run the typed line (BC -> it).
07C3   01 00 0C     CRUN:     LD   BC,PROG   
07C6   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
07C7   E1           ST0P:     POP   HL   ; (the end of what was typed)
07C8                             ; st0: start running at BC. The heap starts after the stored program's NUL.
07C8   21 00 0C     ST0:      LD   HL,PROG   
07CB   AF                     XOR   A   
07CC   BE           ST1:      CP   (HL)   
07CD   23                     INC   HL   
07CE   20 FC                  JR   NZ,st1   
07D0   22 7C 0B               LD   (HEAP),HL   
07D3                          ENDIF      
07D3                          IF   EDITOR*CHECKED   
07D3                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
07D3                          DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
07D3   CD                     DS   CPM,0CDh   
07D4   EA                     DS   CPM,ANEG&0FFh   
07D5   04                     DS   CPM,ANEG/256   
07D6   22 38 0B               LD   (NPEND),HL   ;   release below it
07D9                          ENDIF      
07D9                          IF   EDITOR   
07D9   E1                     POP   HL   ; TOS: the data stack is as the last line left it
07DA                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
07DA                          DS   1-CPM,0F7h   ; (its return address is thrown away)
07DA   DD                     DS   CPM,0DDh   
07DB   E9                     DS   CPM,0E9h   
07DC                             ; ^L: list from line n. DE = the number of the line at HL.
07DC   CD EB 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
07DF   7C                     LD   A,H   
07E0   B5                     OR   L   
07E1   20 01                  JR   NZ,li0   
07E3   2C                     INC   L   ;   then from line 1
07E4   E5           LI0:      PUSH   HL   
07E5   CD 1E 08               CALL   find   
07E8   D1                     POP   DE   
07E9   7E           LI1:      LD   A,(HL)   
07EA   B7                     OR   A   
07EB   28 D3                  JR   Z,gedit   ; the end of the text
07ED   CD 03 05               CALL   rawk   
07F0   28 09                  JR   Z,li3   ; no key: carry on
07F2   FE 03                  CP   3   
07F4   C4 2B 07               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
07F7   FE 03                  CP   3   
07F9   28 C5                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
07FB   E5           LI3:      PUSH   HL   
07FC   D5                     PUSH   DE   
07FD   EB                     EX   DE,HL   
07FE   CD 6E 04               CALL   pdec   ; the line's number,
0801   3E 20                  LD   A," "   
0803                          ;*Macro unroll:  PUTA                    ;   a space,
0803                          DS   1-CPM,0EFh   ;   a space,
0803   CD                     DS   CPM,0CDh   
0804   0B                     DS   CPM,APUT&0FFh   
0805   05                     DS   CPM,APUT/256   
0806   D1                     POP   DE   
0807   E1                     POP   HL   
0808   13                     INC   DE   
0809   CD 36 08               CALL   prl   ;   and the line
080C   18 DB                  JR   li1   
080E                             ; delln: take line n (in HL) out: copy everything after it down over it.
080E   CD 1E 08     DELLN:    CALL   find   
0811   54                     LD   D,H   
0812   5D                     LD   E,L   
0813   CD 2C 08               CALL   nxl   ; HL -> the next line
0816   7E           DE1:      LD   A,(HL)   
0817   12                     LD   (DE),A   
0818   23                     INC   HL   
0819   13                     INC   DE   
081A   B7                     OR   A   
081B   20 F9                  JR   NZ,de1   
081D   C9                     RET      
081E                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
081E                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
081E   EB           FIND:     EX   DE,HL   
081F   21 00 0C               LD   HL,PROG   
0822   1B           FI1:      DEC   DE   
0823   7A                     LD   A,D   
0824   B3                     OR   E   
0825   C8                     RET   Z   
0826   CD 2C 08               CALL   nxl   
0829   20 F7                  JR   NZ,fi1   
082B   C9                     RET      
082C                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
082C                             ; stop at the NUL that ends the text (and return zero).
082C   7E           NXL:      LD   A,(HL)   
082D   B7                     OR   A   
082E   C8                     RET   Z   
082F   23                     INC   HL   
0830   FE 0A                  CP   10   
0832   20 F8                  JR   NZ,nxl   
0834   B7                     OR   A   
0835   C9                     RET      
0836                             ; prl: print the line at HL, to its LF; HL -> just past it.
0836   7E           PRL:      LD   A,(HL)   
0837                          ;*Macro unroll:  PUTA
0837                          DS   1-CPM,0EFh   
0837   CD                     DS   CPM,0CDh   
0838   0B                     DS   CPM,APUT&0FFh   
0839   05                     DS   CPM,APUT/256   
083A   7E                     LD   A,(HL)   
083B   23                     INC   HL   
083C   FE 0A                  CP   10   
083E   20 F6                  JR   NZ,prl   
0840   C9                     RET      
0841                          ENDIF      
0841                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
0841                          ENDIF      
0841                          IF   EDITOR*CPM   
0841                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
0841                             ;   put the one from the command line
0841                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
0841                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
0841                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
0841                             ; full disk or directory is not noticed: the calls fail and that is all.)
0841   CD 8E 08     CWRITE:   CALL   setname   
0844   0E 13                  LD   C,19   ; delete
0846   CD C7 08               CALL   fbdos   
0849   0E 16                  LD   C,22   ; make
084B   CD C7 08               CALL   fbdos   
084E   21 00 0C               LD   HL,PROG   
0851   AF                     XOR   A   
0852   BE           CW1:      CP   (HL)   
0853   23                     INC   HL   
0854   20 FC                  JR   NZ,cw1   
0856   2B                     DEC   HL   ; HL -> the NUL
0857   E5                     PUSH   HL   
0858   06 80                  LD   B,128   
085A   36 1A        CW2:      LD   (HL),1Ah   
085C   23                     INC   HL   
085D   10 FB                  DJNZ   cw2   
085F   E1                     POP   HL   
0860   11 00 0C               LD   DE,PROG   
0863   7B           CW3:      LD   A,E   ; a record that starts before the end is written
0864   95                     SUB   L   
0865   7A                     LD   A,D   
0866   9C                     SBC   A,H   
0867   30 09                  JR   NC,cw4   
0869   E5                     PUSH   HL   
086A   0E 15                  LD   C,21   ; write, from where the record lies
086C   CD 7C 08               CALL   frec   
086F   E1                     POP   HL   
0870   18 F1                  JR   cw3   
0872   36 00        CW4:      LD   (HL),0   ; the NUL again
0874   0E 10                  LD   C,16   ; close
0876   CD C7 08               CALL   fbdos   
0879   C3 8A 06               JP   edit   
087C                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
087C                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
087C   D5           FREC:     PUSH   DE   
087D   C5                     PUSH   BC   
087E   0E 1A                  LD   C,26   ; set the DMA address
0880   CD 05 00               CALL   BDOS   
0883   C1                     POP   BC   
0884   CD C7 08               CALL   fbdos   
0887   D1                     POP   DE   
0888   21 80 00               LD   HL,128   
088B   19                     ADD   HL,DE   
088C   EB                     EX   DE,HL   
088D   C9                     RET      
088E                             ; setname: if a name was typed (the line does not start with its CR), put it
088E                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
088E                             ; is the current one. Then, name or no name, clear the FCB after the name,
088E                             ; as it must be before a file is opened or made.
088E   11 80 0B     SETNAME:   LD   DE,LINEBUF   
0891   1A                     LD   A,(DE)   
0892   FE 0D                  CP   13   
0894   28 26                  JR   Z,fcbclr   
0896   21 5C 00               LD   HL,CFCB   
0899   36 00                  LD   (HL),0   ; the current drive
089B   06 0B                  LD   B,11   
089D   2C           SN1:      INC   L   
089E   36 20                  LD   (HL)," "   
08A0   10 FB                  DJNZ   sn1   
08A2   2E 5D                  LD   L,CFCB+1   
08A4   1A           SN2:      LD   A,(DE)   
08A5   13                     INC   DE   
08A6   FE 0D                  CP   13   
08A8   28 12                  JR   Z,fcbclr   
08AA   FE 2E                  CP   "."   
08AC   20 04                  JR   NZ,sn3   
08AE   2E 65                  LD   L,CFCB+9   ; the type
08B0   18 F2                  JR   sn2   
08B2   FE 61        SN3:      CP   "a"   
08B4   38 02                  JR   C,sn4   
08B6   E6 5F                  AND   5Fh   ; a capital
08B8   77           SN4:      LD   (HL),A   
08B9   2C                     INC   L   
08BA   18 E8                  JR   sn2   
08BC   21 68 00     FCBCLR:   LD   HL,CFCB+12   
08BF   06 18                  LD   B,24   
08C1   36 00        FC1:      LD   (HL),0   
08C3   23                     INC   HL   
08C4   10 FB                  DJNZ   fc1   
08C6   C9                     RET      
08C7                             ; fbdos: BDOS function C on the file
08C7   11 5C 00     FBDOS:    LD   DE,CFCB   
08CA   C3 05 00               JP   BDOS   
08CD                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
08CD                             ; from now on. (On into load, which returns to edit.)
08CD   CD 8E 08     CREAD:    CALL   setname   
08D0   21 8A 06               LD   HL,edit   
08D3   E5                     PUSH   HL   
08D4                             ; load: read the file into PROG. No such file: no program. The text ends at
08D4                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
08D4                             ; goes after the last record, so the search always stops. And every line
08D4                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
08D4                             ; clear after its name: the CCP left it so, or setname did.)
08D4   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
08D6   CD C7 08               CALL   fbdos   ;   too)
08D9   11 00 0C               LD   DE,PROG   
08DC   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
08DE   CD 7C 08               CALL   frec   
08E1   B7                     OR   A   
08E2   28 F8                  JR   Z,ld1   
08E4   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
08E6   21 FF 0B               LD   HL,PROG-1   
08E9   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
08EB   23           TR1:      INC   HL   
08EC   5F                     LD   E,A   ; E = the character before this one
08ED   7E                     LD   A,(HL)   
08EE   FE 1A                  CP   1Ah   
08F0   20 F9                  JR   NZ,tr1   
08F2   7B                     LD   A,E   
08F3   FE 0A                  CP   10   
08F5   28 06                  JR   Z,tr2   
08F7   36 0D                  LD   (HL),13   
08F9   23                     INC   HL   
08FA   36 0A                  LD   (HL),10   
08FC   23                     INC   HL   
08FD   36 00        TR2:      LD   (HL),0   
08FF   C9                     RET      
0900                          ENDIF      
0900                             ; =============================================================================
0900                          IF   CPM   
0900                             ; The RAM pages follow the image; the heap may grow to the BDOS.
0900                START:       
0900                          ENDIF      
0900                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0900                          ENDIF      
0900                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0900                          ENDIF      
0900                          IF   CPM   
0900                             ; RAM pages, after the image
0900                RSPAGE:   EQU   (imgend + 255) / 256   
0900                DSPAGE:   EQU   RSPAGE + 1   
0900                LETPAGE:   EQU   RSPAGE + 2   
0900                PROG:     EQU   LETPAGE*256 + 256   
0900                          ENDIF      
0900                IMGEND:      


