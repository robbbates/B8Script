076C   21 00 0C               LD   HL,PROG   
076F   11 FF FF               LD   DE,0FFFFh   
0772   13           CV1:      INC   DE   ; count the lines, and find the end
0773   CD D4 07               CALL   nxl   
0776   20 FA                  JR   NZ,cv1   
0778   E5                     PUSH   HL   ; the NUL
0779   D5                     PUSH   DE   ; the lines
077A   11 00 F4               LD   DE,(0-PROG)&0FFFFh   
077D   19                     ADD   HL,DE   
077E   CD 7C 05               CALL   pnl   
0781   50 72 6F 67 20 22      DB   "Prog ",22h   
0787   CD 91 03               CALL   pdec   ; the program's size
078A   E1                     POP   HL   
078B   CD 7C 05               CALL   pnl   
078E   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
0795   CD 91 03               CALL   pdec   
0798   D1                     POP   DE   
0799                          ENDIF      
0799                          IF   EDGEN   
                              LD   HL,HEAPLIM*256-1   
0799                          ENDIF      
0799                          IF   EDITOR*CPM   
0799   3A 07 00               LD   A,(0007h)   ; the BDOS page is the limit
079C   67                     LD   H,A   
079D   2E 00                  LD   L,0   
079F   2B                     DEC   HL   
07A0                          ENDIF      
07A0                          IF   EDITOR   
07A0   B7                     OR   A   
07A1   ED 52                  SBC   HL,DE   
07A3   CD 7C 05               CALL   pnl   
07A6   46 72 65 65 20 22      DB   "Free ",22h   
07AC   CD 91 03               CALL   pdec   ; the room left for text and heap
07AF   CD 7C 05               CALL   pnl   
07B2   22                     DB   22h   
07B3   C3 CB 05     GED1:     JP   edit   
07B6                             ; delln: take line n (in HL) out: copy everything after it down over it.
07B6   CD C6 07     DELLN:    CALL   find   
07B9   54                     LD   D,H   
07BA   5D                     LD   E,L   
07BB   CD D4 07               CALL   nxl   ; HL -> the next line
07BE   7E           DE1:      LD   A,(HL)   
07BF   12                     LD   (DE),A   
07C0   23                     INC   HL   
07C1   13                     INC   DE   
07C2   B7                     OR   A   
07C3   20 F9                  JR   NZ,de1   
07C5   C9                     RET      
07C6                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
07C6                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
07C6   EB           FIND:     EX   DE,HL   
07C7   21 00 0C               LD   HL,PROG   
07CA   1B           FI1:      DEC   DE   
07CB   7A                     LD   A,D   
07CC   B3                     OR   E   
07CD   C8                     RET   Z   
07CE   CD D4 07               CALL   nxl   
07D1   20 F7                  JR   NZ,fi1   
07D3   C9                     RET      
07D4                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
07D4                             ; stop at the NUL that ends the text (and return zero).
07D4   7E           NXL:      LD   A,(HL)   
07D5   B7                     OR   A   
07D6   C8                     RET   Z   
07D7   23                     INC   HL   
07D8   FE 0A                  CP   10   
07DA   20 F8                  JR   NZ,nxl   
07DC   B7                     OR   A   
07DD   C9                     RET      
07DE                             ; prl: print the line at HL, to its LF; HL -> just past it.
07DE   7E           PRL:      LD   A,(HL)   
07DF   EF                     RST   28h   
07E0   7E                     LD   A,(HL)   
07E1   23                     INC   HL   
07E2   FE 0A                  CP   10   
07E4   20 F8                  JR   NZ,prl   
07E6   C9                     RET      
07E7                          ENDIF      
07E7                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
07E7                          ENDIF      
07E7                          IF   EDITOR*CPM   
07E7                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
07E7                             ;   put the one from the command line
07E7                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
07E7                             ; from now on.
07E7   CD 3E 08     CREAD:    CALL   setname   
07EA   CD 7D 08               CALL   load   
07ED   C3 CB 05               JP   edit   
07F0                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
07F0                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
07F0                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
07F0                             ; full disk or directory is not noticed: the calls fail and that is all.)
07F0   CD 3E 08     CWRITE:   CALL   setname   
07F3   0E 13                  LD   C,19   ; delete
07F5   CD 77 08               CALL   fbdos   
07F8   0E 16                  LD   C,22   ; make
07FA   CD 77 08               CALL   fbdos   
07FD   21 00 0C               LD   HL,PROG   
0800   AF                     XOR   A   
0801   BE           CW1:      CP   (HL)   
0802   23                     INC   HL   
0803   20 FC                  JR   NZ,cw1   
0805   2B                     DEC   HL   ; HL -> the NUL
0806   E5                     PUSH   HL   
0807   06 80                  LD   B,128   
0809   36 1A        CW2:      LD   (HL),1Ah   
080B   23                     INC   HL   
080C   10 FB                  DJNZ   cw2   
080E   E1                     POP   HL   
080F   11 00 0C               LD   DE,PROG   
0812   7B           CW3:      LD   A,E   ; a record that starts before the end is written
0813   95                     SUB   L   
0814   7A                     LD   A,D   
0815   9C                     SBC   A,H   
0816   30 09                  JR   NC,cw4   
0818   E5                     PUSH   HL   
0819   0E 15                  LD   C,21   ; write, from where the record lies
081B   CD 2B 08               CALL   frec   
081E   E1                     POP   HL   
081F   18 F1                  JR   cw3   
0821   36 00        CW4:      LD   (HL),0   ; the NUL again
0823   0E 10                  LD   C,16   ; close
0825   CD 77 08               CALL   fbdos   
0828   C3 CB 05               JP   edit   
082B                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
082B                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
082B   D5           FREC:     PUSH   DE   
082C   C5                     PUSH   BC   
082D   0E 1A                  LD   C,26   ; set the DMA address
082F   CD 05 00               CALL   BDOS   
0832   C1                     POP   BC   
0833   CD 77 08               CALL   fbdos   
0836   E1                     POP   HL   
0837   11 80 00               LD   DE,128   
083A   EB                     EX   DE,HL   
083B   19                     ADD   HL,DE   
083C   EB                     EX   DE,HL   
083D   C9                     RET      
083E                             ; setname: if a name was typed (the line does not start with its CR), put it
083E                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
083E                             ; is the current one. Then, name or no name, clear the FCB after the name,
083E                             ; as it must be before a file is opened or made.
083E   11 80 0B     SETNAME:   LD   DE,LINEBUF   
0841   1A                     LD   A,(DE)   
0842   FE 0D                  CP   13   
0844   28 26                  JR   Z,fcbclr   
0846   21 5C 00               LD   HL,CFCB   
0849   36 00                  LD   (HL),0   ; the current drive
084B   06 0B                  LD   B,11   
084D   2C           SN1:      INC   L   
084E   36 20                  LD   (HL)," "   
0850   10 FB                  DJNZ   sn1   
0852   2E 5D                  LD   L,CFCB+1   
0854   1A           SN2:      LD   A,(DE)   
0855   13                     INC   DE   
0856   FE 0D                  CP   13   
0858   28 12                  JR   Z,fcbclr   
085A   FE 2E                  CP   "."   
085C   20 04                  JR   NZ,sn3   
085E   2E 65                  LD   L,CFCB+9   ; the type
0860   18 F2                  JR   sn2   
0862   FE 61        SN3:      CP   "a"   
0864   38 02                  JR   C,sn4   
0866   E6 5F                  AND   5Fh   ; a capital
0868   77           SN4:      LD   (HL),A   
0869   2C                     INC   L   
086A   18 E8                  JR   sn2   
086C   21 68 00     FCBCLR:   LD   HL,CFCB+12   
086F   06 18                  LD   B,24   
0871   36 00        FC1:      LD   (HL),0   
0873   23                     INC   HL   
0874   10 FB                  DJNZ   fc1   
0876   C9                     RET      
0877                             ; fbdos: BDOS function C on the file
0877   11 5C 00     FBDOS:    LD   DE,CFCB   
087A   C3 05 00               JP   BDOS   
087D                             ; load: read the file into PROG. No such file: no program. The text ends at
087D                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
087D                             ; goes after the last record, so the search always stops. And every line
087D                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
087D                             ; clear after its name: the CCP left it so, or setname did.)
087D   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
087F   CD 77 08               CALL   fbdos   ;   too)
0882   11 00 0C               LD   DE,PROG   
0885   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
0887   CD 2B 08               CALL   frec   
088A   B7                     OR   A   
088B   28 F8                  JR   Z,ld1   
088D   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
088F   21 FF 0B               LD   HL,PROG-1   
0892   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
0894   23           TR1:      INC   HL   
0895   5F                     LD   E,A   ; E = the character before this one
0896   7E                     LD   A,(HL)   
0897   FE 1A                  CP   1Ah   
0899   20 F9                  JR   NZ,tr1   
089B   7B                     LD   A,E   
089C   FE 0A                  CP   10   
089E   28 06                  JR   Z,tr2   
08A0   36 0D                  LD   (HL),13   
08A2   23                     INC   HL   
08A3   36 0A                  LD   (HL),10   
08A5   23                     INC   HL   
08A6   36 00        TR2:      LD   (HL),0   
08A8   C9                     RET      
08A9                          ENDIF      
08A9                             ; =============================================================================
08A9                          IF   CPM   
08A9                             ; The RAM pages follow the image; the heap may grow to the BDOS.
08A9                START:       
08A9                          ENDIF      
08A9                          IF   CPM*CHECKED   
08A9                             ; Clear the lower half of the letter page: every variable starts at
08A9                             ; 0, every word cell holds 0000h, the address an undefined word is
08A9                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
08A9                             ; is held back.
08A9   21 00 0B               LD   HL,LET   
08AC   AF                     XOR   A   
08AD   77           INI1:     LD   (HL),A   
08AE   2C                     INC   L   
08AF   F2 AD 08               JP   P,ini1   ; +00h to +7Fh
08B2                          ENDIF      
08B2                          IF   CPM   
08B2   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
08B5   11 08 00               LD   DE,0008h   
08B8   01 2C 00               LD   BC,vecend-vecs   
08BB   ED B0                  LDIR      
08BD                          ENDIF      
08BD                          IF   CPM*EDITOR   
08BD   CD 7D 08               CALL   load   ; the file named on the command line
08C0   C3 C5 05               JP   edit0   
08C3                          ENDIF      
08C3                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
08C3                          ENDIF      
08C3                          IF   CPM   
08C3                             ; RAM pages, after the image
08C3                RSPAGE:   EQU   (imgend + 255) / 256   
08C3                DSPAGE:   EQU   RSPAGE + 1   
08C3                LETPAGE:   EQU   RSPAGE + 2   
08C3                PROG:     EQU   LETPAGE*256 + 256   
08C3                          ENDIF      
08C3                IMGEND:      


