E451   A9 55                  LDA   #"U"   
E453   D0 E4                  BNE   ejmp2   ; always
E455                          ENDIF      
E455                             ; step: read one character and sort it by range.
E455                             ;    00h          end of program
E455                             ;    01h-20h, 7Fh-FFh   ignored
E455                             ;    30h-39h      digit: read a whole number
E455                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E455                             ;    61h-7Ah      a-z: push the address of that letter's cell
E455                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E455   20 29 E5     STEP:     JSR   getc   ; flags follow A
E458   F0 3D                  BEQ   endp   
E45A   38                     SEC      
E45B   E9 21                  SBC   #21h   ; A = c - 21h
E45D   90 37                  BCC   ign   ; 01h-20h
E45F   C9 0F                  CMP   #0Fh   
E461   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E463   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E465   C9 0A                  CMP   #10   
E467   90 72                  BCC   digit   
E469   C9 11                  CMP   #11h   
E46B   90 18                  BCC   p3a   ; 3Ah-40h
E46D   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E46F   C9 1A                  CMP   #1Ah   
E471   90 2B                  BCC   upper   ; 41h-5Ah
E473   C9 20                  CMP   #20h   
E475   90 0C                  BCC   p5b   ; 5Bh-60h
E477   C9 3A                  CMP   #3Ah   
E479   90 2F                  BCC   lower   ; 61h-7Ah: A = 20h-39h
