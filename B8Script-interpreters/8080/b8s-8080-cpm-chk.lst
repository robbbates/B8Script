06DF                             ; =============================================================================
06DF                             ;  Startup
06DF                             ; =============================================================================
06DF                START:       
06DF                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
06DF                          ENDIF      
06DF                          IF   CHECKED   
06DF                             ; Clear the lower half of the letter page: every variable starts at
06DF                             ; 0, every word cell holds 0000h, the address an undefined word is
06DF                             ; caught at (see e_hi), and no key is held back.
06DF   21 00 0A               LXI   H,LET   
06E2   AF                     XRA   A   
06E3   77           INI1:     MOV   M,A   
06E4   2C                     INR   L   
06E5   F2 E3 06               JP   ini1   ; +00h to +7Fh
06E8                          ENDIF      
06E8                          IF   CPM   
06E8                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
06E8   21 08 01               LXI   H,vecs   ; the RST routines go down into page zero
06EB   11 08 00               LXI   D,0008h   
06EE   06 2C                  MVI   B,vecend-vecs   
06F0   7E           CPY:      MOV   A,M   
06F1   12                     STAX   D   
06F2   23                     INX   H   
06F3   13                     INX   D   
06F4   05                     DCR   B   
