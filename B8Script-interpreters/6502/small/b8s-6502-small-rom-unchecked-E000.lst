                              ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              TAY      
                              LDA   T1   
                              SBC   D1   
                              BCC   uv1   
                              STA   T1   
                              STY   T0   
                              INC   TL   
