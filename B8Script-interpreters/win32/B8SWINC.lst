   555                              <1> ; ---- the grave --------------------------------------------------------------
   556                              <1> ; The grave is a prefix: with the character after it, it is one command.
   557                              <1> ; gtab holds each character with its handler's distance from that entry
   558                              <1> ; of the table (so the search's own pointer is the base). A
   559                              <1> ; handler starts with AL = the character and EBX = TOS, and ends with JMP
   560                              <1> ; EBP. A character that is not in the table is unsafe: the unchecked build
   561                              <1> ; searches on through memory, the checked build stops with W.
   562                              <1> ;
   563                              <1> ;   `!  ( addr -- )        call the machine code at addr (the contract is below)
   564                              <1> ;   `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
   565                              <1> ;                          from addr until a non-hex character; then a RET
   566                              <1> ;                          (C3h) is written and its address is left. An odd
   567                              <1> ;                          last digit is consumed and its byte is
   568                              <1> ;                          overwritten by the RET. (Never range-checked.)
   569                              <1> ;   `'  ( -- )             new line: CR LF
   570                              <1> ;   `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
   571                              <1> ;   `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
   572                              <1> ;   `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
   573                              <1> ;   `.  ( -- addr )        the address of the random seed
   574                              <1> ;   `<  ( a b -- n )       the smaller of the two (signed)
   575                              <1> ;   `>  ( a b -- n )       the larger
   576                              <1> ;   `?  ( flag -- )        the cursor off (0) or on
   577                              <1> ;   `@  ( row col -- )     the cursor to that row and column, both from 0
   578                              <1> ;   `^  ( -- )             clear the screen and home the cursor
   579                              <1> ;   `_  ( -- )             clear from the cursor to the end of the line
   580                              <1> ;
   581                              <1> ; The four console codes send ANSI escape sequences: the startup has put
   582                              <1> ; the console in its virtual terminal mode, so it obeys them as a terminal
   583                              <1> ; does.
   584 000001E7 AC                  <1> grave1: lodsb
   585 000001E8 BA[56040000]        <1>         mov     edx,gtab-2
   586 000001ED 42                  <1> .g1:    inc     edx
   587 000001EE 42                  <1>         inc     edx
   588                              <1> %if CHECKED
   589 000001EF 803A00              <1>         cmp     byte [edx],0            ; the end of the table: W. The place
   590 000001F2 0F84E2000000        <1>         je      e_brack                 ;   is the character
   591                              <1> %endif
   592 000001F8 3A02                <1>         cmp     al,[edx]
