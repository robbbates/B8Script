E8A1   E5 05                  SBC   D0   
E8A3   A8                     TAY      
E8A4   B5 FF                  LDA   0FFh,X   
E8A6   E5 06                  SBC   D1   
E8A8   90 06                  BCC   uv9   
E8AA   95 FF                  STA   0FFh,X   
E8AC   94 FE                  STY   0FEh,X   
E8AE   F6 00                  INC   0,X   
