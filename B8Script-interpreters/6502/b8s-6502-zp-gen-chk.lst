E523   D0 02                  BNE   ic1   
E525   E6 01                  INC   IP+1   
E527   09 00        IC1:      ORA   #0   
E529   60           IC9:      RTS      
E52A   A0 00        PEEK:     LDY   #0   
E52C   B1 00                  LDA   (IP),Y   
E52E   60                     RTS      
E52F                             ; rstip: point IP at the start of the program
E52F   A9 00        RSTIP:    LDA   #<PROG   
E531   85 00                  STA   IP   
E533   A9 05                  LDA   #>PROG   
E535   85 01                  STA   IP+1   
E537   60                     RTS      
