E2CC   85 04                  STA   T0   
E2CE   B5 01                  LDA   1,X   
E2D0   85 05                  STA   T1   
E2D2   E8                     INX      ; the address is consumed
E2D3   E8                     INX      
E2D4   6C 04 00               JMP   (T0)   
E2D7                             ; ---- "_" is the last handler: its body may leave the page
E2D7                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E2D7                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E2D7                          IF   1-CHECKED   
E2D7   AD 7C 04     H_ALLOC:   LDA   HEAP   
E2DA   A8                     TAY      
E2DB   75 00                  ADC   0,X   
E2DD   8D 7C 04               STA   HEAP   
E2E0   94 00                  STY   0,X   
E2E2   AD 7D 04               LDA   HEAP+1   
E2E5   A8                     TAY      
E2E6   75 01                  ADC   1,X   
E2E8   8D 7D 04               STA   HEAP+1   
E2EB   94 01                  STY   1,X   
E2ED   60                     RTS      
E2EE                          ENDIF      
E2EE                             ; The checked build works the new top out first, in T0 and Y, and stops with
E2EE                             ; H, the count still on the stack, if it is at or past the limit, below the
E2EE                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E2EE                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E2EE                             ; a signed number from -8000h, so the add overflows exactly when the true
E2EE                             ; sum leaves 0000h-FFFFh.
E2EE                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   0,X   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   1,X   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   0,X   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   1,X   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the address in the top cell is in the program's own
                                 ; space, from the letter page up to the heap limit. Keeps A and Y.
                    CHKST:    PHA      
                              LDA   1,X   
                              CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              PLA      
                              RTS      
E2EE                          ENDIF      
E2EE                             ; =============================================================================
E2EE                             ;  The rest: no handler starts past this point
E2EE                             ; =============================================================================
E2EE                          ;*Macro unroll:  UDIV
E2EE   A9 00        UDIV:     LDA   #0   
E2F0   95 FE                  STA   0FEh,X   
E2F2   95 FF                  STA   0FFh,X   
E2F4   A5 08                  LDA   D0   
E2F6   49 02                  EOR   #2   
E2F8   05 09                  ORA   D1   
E2FA   D0 07                  BNE   ud0   
E2FC   56 01                  LSR   1,X   
E2FE   76 00                  ROR   0,X   
E300   36 FE                  ROL   0FEh,X   
E302   60                     RTS      
