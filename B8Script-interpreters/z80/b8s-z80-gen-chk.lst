0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-CPM*EDITOR*(1-CHECKED)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; HL'; CONCLS, CONEOL and CONCUR also DE and HL.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0000   AF                     XOR   A   ; 00  reset. (This byte, AFh, is also what an
0001                          ENDIF      ;     undefined word runs into: see e_hi.)
0001                          IF   1-EDGEN   
0001   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0004   18 6C                  JR   init   ; 04  (the rest of the startup is close by)
0006   00 00                  DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 D6 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 9D 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 7C                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 7E                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 70                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 C9 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 3F        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE 56                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0072   21 00 82     INIT:     LD   HL,LET   
0075   77           INI1:     LD   (HL),A   
0076   2C                     INC   L   
0077   F2 75 00               JP   P,ini1   ; +00h to +7Fh
007A   01 00 83               LD   BC,PROG   ; the IP
007D                          ENDIF      
007D                          IF   (1-CPM)*(1-EDITOR)   
007D   60           ST0:      LD   H,B   
007E   69                     LD   L,C   
007F   AF                     XOR   A   
0080   BE           ST1:      CP   (HL)   
0081   23                     INC   HL   
0082   20 FC                  JR   NZ,st1   
0084                          ENDIF      
0084                          IF   1-EDITOR   
0084   22 7C 82     ST2:      LD   (HEAP),HL   
0087                          ENDIF      
0087                          IF   CHECKED*(1-EDITOR)   
0087   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0088   22 38 82               LD   (NPEND),HL   ;   release below it
008B                          ENDIF      
008B                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
008B                          ENDIF      ;   these)
008B                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
008B                          ENDIF      
008B                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
008B                          ENDIF      
008B                          IF   1-EDITOR   
008B   D9                     EXX      
008C   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
008F   D9                     EXX      
0090   F7                     RST   30h   ; (its return address is thrown away)
0091                          ENDIF      
0091                             ; In the unchecked generic editor build the table is here, in the first
0091                             ; page, which saves loading D twice. (The other builds have no room for it
0091                             ; here: theirs is further down.)
0091                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0091                          ENDIF      
0091                             ; =============================================================================
0091                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0091                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0091                             ;  is here too: it belongs to "`" and makes the page come out right.
0091                             ; =============================================================================
0091   D1           H_XOR:    POP   DE   
0092   7C                     LD   A,H   
0093   AA                     XOR   D   
0094   67                     LD   H,A   
0095   7D                     LD   A,L   
0096   AB                     XOR   E   
0097   6F                     LD   L,A   
0098   F7                     RST   30h   
0099   D1           H_OR:     POP   DE   
009A   7C                     LD   A,H   
009B   B2                     OR   D   
009C   67                     LD   H,A   
009D   7D                     LD   A,L   
009E   B3                     OR   E   
009F   6F                     LD   L,A   
00A0   F7                     RST   30h   
00A1   E7           H_NOT:    RST   20h   ; ~x = -x - 1
00A2   2B                     DEC   HL   
00A3   F7                     RST   30h   
00A4                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
00A4                             ; the same either way); TOS is the old pointer.
00A4   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A8                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A8                          ENDIF      
00A8   19                     ADD   HL,DE   ; the new top
00A9                          IF   CHECKED   
00A9   CD D3 03               CALL   chkhp   
00AC                          ENDIF      
00AC   22 7C 82               LD   (HEAP),HL   
00AF   EB                     EX   DE,HL   
00B0   F7                     RST   30h   
00B1   D9           EXEC:     EXX      
00B2   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00B5   D9                     EXX      
00B6   CD 2B 00               CALL   jphl   
00B9   D9                     EXX      
00BA   2A 34 82               LD   HL,(RSAVE)   
00BD   D9                     EXX      
00BE   E1                     POP   HL   
00BF   F7                     RST   30h   
00C0                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00C0                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00C0                             ; Digits: step back onto the first digit and read the whole number.
00C0   E5           DIGIT:    PUSH   HL   
00C1   0B                     DEC   BC   
00C2   CD AF 02               CALL   rdnum   
00C5   F7                     RST   30h   
00C6                             ; a-z: push the cell's address (the cell is the variable)
00C6   E5           LOWER:    PUSH   HL   
00C7   87                     ADD   A,A   
00C8   6F                     LD   L,A   
00C9   26 82                  LD   H,LETPAGE   
00CB   F7                     RST   30h   
00CC                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00CC                             ; the return stack, and the IP becomes the address in the letter's cell.
00CC   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00CD   EB                     EX   DE,HL   ; park TOS
00CE   87                     ADD   A,A   
00CF   6F                     LD   L,A   
00D0   26 82                  LD   H,LETPAGE   ; HL -> cell
00D2   4E                     LD   C,(HL)   
00D3   2C                     INC   L   
00D4   46                     LD   B,(HL)   ; IP = the word's body
00D5   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00D6                             ; rpushn: move the top cell of the data stack (in memory) to the return
00D6                             ; stack, then next. Everything that pushes the return stack ends here.
00D6                             ; 
00D6                             ; The break key is looked at here, so at every word call and loop-back (and
00D6                             ; block entry and "{"), but only one time in 256: B', which nothing else
00D6                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00D6                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00D6                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00D6                             ; both ways out.)
00D6   D9           RPUSHN:   EXX      
00D7   D1                     POP   DE   
00D8   2B                     DEC   HL   
00D9   72                     LD   (HL),D   
00DA   2B                     DEC   HL   
00DB   73                     LD   (HL),E   
00DC   05                     DEC   B   
00DD   D9                     EXX      
00DE   CC 5F 03               CALL   Z,pollk   
00E1   F7                     RST   30h   
00E2                             ; ---- machine code: the grave -----------------------------------------------
00E2                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00E2                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00E2                             ; written and its address is left. An odd last digit is consumed and dropped.
00E2                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00E2                             ; code is entered by CALL with the data stack above the return address; it
00E2                             ; must keep BC, and on return the top cell becomes the new TOS.
00E2   CD 13 03     H_GRAVE:   CALL   hexc   
00E5   30 CA                  JR   NC,exec   
00E7   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00E8   CD 13 03               CALL   hexc   
00EB   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00ED   ED 6F                  RLD      ;   overwrites it
00EF   23                     INC   HL   ; ... and RLD shifts it up under the low one
00F0   CD 13 03               CALL   hexc   
00F3   38 F2                  JR   C,hx1   
00F5   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00F7   F7                     RST   30h   
00F8                             ; ---- where the two pages meet ----------------------------------------------
00F8                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00F8                             ; are in falling code order for this), and where exactly differs between the
00F8                             ; builds: NPG1 follows. Every handler below these four must start in the
00F8                             ; second page, and every one above in the first; chktab.py checks both.
00F8                             ; "]" returns: pop an address and jump to it.
00F8   CF           H_RET:    RST   08h   
00F9   42                     LD   B,D   
00FA   4B                     LD   C,E   
00FB   F7           BRK1:     RST   30h   
00FC                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00FC                             ; drops the block start, "]" returns. No closer at all ends the program.
00FC   7C           H_BREAK:   LD   A,H   
00FD   B5                     OR   L   
00FE   E1                     POP   HL   
00FF   28 FA                  JR   Z,brk1   
0101   CD D6 02               CALL   skip   
0104   B7                     OR   A   ; skip returns 0 for ")"
0105   20 F1                  JR   NZ,h_ret   
0107   CF           RDROP:    RST   08h   
0108   F7                     RST   30h   
0109                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0109                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0109                             ; the body"s address instead. Either way it then skips to the matching "]'.
0109                             ; (The unchecked build takes anything that is not a letter as the space; the
0109                             ; checked build stops on it.)
0109   0A           H_DEF:    LD   A,(BC)   
010A   03                     INC   BC   
010B   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
010D   5F                     LD   E,A   ;   lands 64 bytes up
010E   E6 DF                  AND   0DFh   ; fold case
0110   FE 1A                  CP   26   
0112   30 0B                  JR   NC,def2   ; not a letter
0114   CB 23                  SLA   E   
0116   16 82                  LD   D,LETPAGE   ; DE -> cell
0118   79                     LD   A,C   
0119   12                     LD   (DE),A   
011A   1C                     INC   E   
011B   78                     LD   A,B   
011C   12                     LD   (DE),A   
011D   18 09                  JR   skipnx   
011F                DEF2:        
011F                          IF   CHECKED   
011F   7B                     LD   A,E   
0120   FE DF                  CP   " "-"A"+256   
0122   C2 0F 04               JP   NZ,e_brack   ; anything but a letter or a space
0125                          ENDIF      
0125   E5                     PUSH   HL   ; an anonymous block: push its address
0126   60                     LD   H,B   
0127   69                     LD   L,C   
0128                SKIPNX:      
0128                          IF   CHECKED   
0128   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0129                          ENDIF      ;   opener, the "[", just before where it starts
0129   CD D6 02     SKIPO:    CALL   skip   
012C   F7                     RST   30h   
012D   5E           H_FETCH:   LD   E,(HL)   ; "@"
012E   23                     INC   HL   
012F   56                     LD   D,(HL)   
0130   EB                     EX   DE,HL   
0131   F7                     RST   30h   
0132                             ; =============================================================================
0132                             ;  Handlers that must start in the image's second page.
0132                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0132                             ;  page.
0132                             ; =============================================================================
0132                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0132                             ; the matching ")".
0132   7C           H_OPEN:   LD   A,H   
0133   B5                     OR   L   
0134   E1                     POP   HL   
0135   28 F2                  JR   Z,skipo   
0137   C5                     PUSH   BC   ; the block starts at the IP
0138   18 9C                  JR   rpushn   
013A                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
013A                             ; drops it and carries on.
013A   7C           H_CLOSE:   LD   A,H   
013B   B5                     OR   L   
013C   E1                     POP   HL   
013D   28 C8                  JR   Z,rdrop   
013F   CF                     RST   08h   ; pop the block start ...
0140   42                     LD   B,D   
0141   4B                     LD   C,E   
0142   C5                     PUSH   BC   
0143   18 91                  JR   rpushn   ; ... and push it back
0145                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0145                             ; "-" has two jobs: directly before a digit it starts a negative number.
0145   0A           H_SUB:    LD   A,(BC)   
0146   D6 30                  SUB   "0"   
0148   FE 0A                  CP   10   
014A   38 04                  JR   C,negnum   
014C   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
014D   D1           H_ADD:    POP   DE   
014E   19                     ADD   HL,DE   
014F   F7                     RST   30h   
0150   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0151   CD AF 02               CALL   rdnum   
0154   E7                     RST   20h   
0155   F7                     RST   30h   
0156   D1           H_AND:    POP   DE   
0157   7C                     LD   A,H   
0158   A2                     AND   D   
0159   67                     LD   H,A   
015A   7D                     LD   A,L   
015B   A3                     AND   E   
015C   6F                     LD   L,A   
015D   F7                     RST   30h   
015E                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
015E                             ; cells first. Flipping both sign bits turns a signed compare into an
015E                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
015E                             ; carry into -1 or 0 with no branch.
015E   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
015F   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0160   7C                     LD   A,H   
0161   EE 80                  XOR   80h   
0163   67                     LD   H,A   
0164   7A                     LD   A,D   
0165   EE 80                  XOR   80h   
0167   57                     LD   D,A   
0168   ED 52                  SBC   HL,DE   ; carry if HL < DE
016A   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
016C   F7                     RST   30h   
016D   D1           H_EQ:     POP   DE   
016E   B7                     OR   A   
016F   ED 52                  SBC   HL,DE   
0171   7C                     LD   A,H   
0172   B5                     OR   L   
0173   FE 01                  CP   1   ; carry only if a - b = 0
0175   18 F3                  JR   tf   
0177                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0177                             ; multiplier shifts up through A:C.
0177   D1           H_MUL:    POP   DE   ; DE = multiplicand
0178   C5                     PUSH   BC   
0179   7C                     LD   A,H   
017A   4D                     LD   C,L   ; A:C = multiplier
017B   21 00 00               LD   HL,0   
017E   06 10                  LD   B,16   
0180   29           MUL1:     ADD   HL,HL   
0181   CB 21                  SLA   C   
0183   17                     RLA      
0184   30 01                  JR   NC,mul2   
0186   19                     ADD   HL,DE   
0187   10 F7        MUL2:     DJNZ   mul1   
0189   C1                     POP   BC   
018A   F7                     RST   30h   
018B                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
018B                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
018B                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
018B                             ; stops on it.
018B                H_DIV:       
018B                          IF   CHECKED   
018B   7C                     LD   A,H   
018C   B5                     OR   L   
018D   CA 0C 04               JP   Z,e_zero   
0190                          ENDIF      
0190   D1                     POP   DE   ; DE = a, HL = b
0191   D5                     PUSH   DE   ; a, for r's sign
0192   7A                     LD   A,D   
0193   AC                     XOR   H   
0194   F5                     PUSH   AF   ; S flag = sign of q
0195   CB 7C                  BIT   7,H   
0197   C4 20 00               CALL   NZ,neg16   ; HL = |b|
019A   EB                     EX   DE,HL   
019B   CB 7C                  BIT   7,H   
019D   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
01A0   CD 87 02               CALL   udiv   ; HL = q, DE = r
01A3   F1                     POP   AF   
01A4   FC 20 00               CALL   M,neg16   ; q's sign
01A7   EB                     EX   DE,HL   ; HL = r, DE = q
01A8   F1                     POP   AF   ; A = a's high byte
01A9   B7                     OR   A   
01AA   FC 20 00               CALL   M,neg16   ; r's sign
01AD   D5                     PUSH   DE   ; q under r
01AE   F7                     RST   30h   
01AF                             ; ---- stack and storage -----------------------------------------------------
01AF   E5           H_DUP:    PUSH   HL   ; ":"
01B0   F7                     RST   30h   
01B1   E3           H_SWAP:   EX   (SP),HL   ; "%"
01B2   F7                     RST   30h   
01B3                             ; (The checked build tests the address before it takes the value off the
01B3                             ; stack, so that an error report shows both.)
01B3                H_CSTORE:      ; "." ( c addr -- )
01B3                          IF   CHECKED   
01B3   CD E8 03               CALL   chkst   
01B6                          ENDIF      
01B6   D1                     POP   DE   
01B7   73                     LD   (HL),E   
01B8   DF           H_DROP:   RST   18h   ; ";" is this one byte
01B9                H_STORE:      ; "!" ( n addr -- )
01B9                          IF   CHECKED   
01B9   CD E8 03               CALL   chkst   
01BC                          ENDIF      
01BC   D1                     POP   DE   
01BD   73                     LD   (HL),E   
01BE   23                     INC   HL   
01BF   72                     LD   (HL),D   
01C0   DF                     RST   18h   
01C1                             ; ---- console ---------------------------------------------------------------
01C1                             ; 22h pushes the address of the text after it and skips the string.
01C1   E5           H_STR:    PUSH   HL   
01C2   60                     LD   H,B   
01C3   69                     LD   L,C   
01C4   CD C5 02               CALL   skipstr   
01C7                          IF   CHECKED   
01C7   B7                     OR   A   ; 0: the text ran out before the closing quote
01C8   CA 04 04               JP   Z,e_quote   
01CB                          ENDIF      
01CB   F7                     RST   30h   
01CC                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01CC                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01CC                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01CC                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01CC                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01CC                          ENDIF      
01CC                          IF   CHECKED   
01CC                             ; (The checked build has the loop as a routine, prstr, which the error
01CC                             ; report uses too. The address is kept meanwhile, for a report: it shows
01CC                             ; the stack as it was before the "$". /~ comes back to hp1.)
01CC   22 34 82     H_PRINT:   LD   (RSAVE),HL   
01CF   CD 25 02     HP1:      CALL   prstr   
01D2   DF                     RST   18h   
01D3                          ENDIF      
01D3   7D           H_EMIT:   LD   A,L   ; "'"
01D4   EF                     RST   28h   
01D5   DF           PR9:      RST   18h   
01D6                             ; "#" prints TOS as a signed decimal number, with no space after it.
01D6   CD 25 03     H_NUM:    CALL   psgn   
01D9   DF                     RST   18h   
01DA                             ; "?" ( n -- c ) or ( -n -- addr )
01DA                             ;   n > 0: wait about n ms for a key; 0 if none came
01DA                             ;   n = 0: wait for a key
01DA                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01DA                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01DA   CB 7C        H_KEY:    BIT   7,H   
01DC   20 19                  JR   NZ,line   
01DE   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01E0   CD 8D 03     KT2:      CALL   getk   
01E3   20 0E                  JR   NZ,kt3   
01E5   1D                     DEC   E   
01E6   20 F8                  JR   NZ,kt2   
01E8   7C                     LD   A,H   ; 0? never counts down: it waits
01E9   B5                     OR   L   
01EA   28 F2                  JR   Z,kt1   
01EC   2B                     DEC   HL   
01ED   7C                     LD   A,H   
01EE   B5                     OR   L   
01EF   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01F1   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01F2   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01F3   6F           KT3:      LD   L,A   
01F4   26 00                  LD   H,0   
01F6   F7                     RST   30h   
01F7                             ; Backspace takes the last character back (and is echoed as it
01F7                             ; is), CR ends (stored, not echoed), every other key is stored and
01F7                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01F7                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01F7                             ; is the place in the line: D holds the L of a full line.
01F7   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01FA   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01FB   9F                     SBC   A,A   
01FC   A5                     AND   L   ; (0 for a count that is too big)
01FD   2F                     CPL      
01FE   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01FF                             ;   at most
01FF   21 80 82               LD   HL,LINEBUF   
0202   CD 8D 03     LN2:      CALL   getk   
0205   28 FB                  JR   Z,ln2   
0207   FE 0D                  CP   13   
0209   28 16                  JR   Z,ln5   
020B   FE 08                  CP   8   
020D   28 0B                  JR   Z,ln4   
020F   5F                     LD   E,A   
0210   7D                     LD   A,L   
0211   BA                     CP   D   
0212   28 EE                  JR   Z,ln2   ; full
0214   73                     LD   (HL),E   
0215   2C                     INC   L   
0216   7B                     LD   A,E   
0217   EF           LN3:      RST   28h   
0218   18 E8                  JR   ln2   
021A   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
021B   FA 17 02               JP   M,ln3   ;   unless the line was empty (L left the
021E   2C                     INC   L   ;   upper half of the page)
021F   18 E1                  JR   ln2   
0221   77           LN5:      LD   (HL),A   ; the CR
0222   2E 80                  LD   L,LINEBUF & 0FFh   
0224   F7                     RST   30h   
0225                             ; =============================================================================
0225                             ;  More routines (no handler starts past this point)
0225                             ; =============================================================================
0225                          IF   CHECKED   
0225                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0225                             ; "$", and the texts of the report). A NUL first is an error: Q.
0225   7E           PRSTR:    LD   A,(HL)   
0226   23                     INC   HL   
0227   FE 22                  CP   22h   
0229   C8                     RET   Z   
022A   B7                     OR   A   
022B   CA FA 03               JP   Z,e_dollar   
022E   FE 2F                  CP   "/"   
0230   20 0C                  JR   NZ,prs1   
0232   7E                     LD   A,(HL)   
0233   23                     INC   HL   
0234   FE 60                  CP   60h   
0236   38 04                  JR   C,prs0   
0238   FE 7F                  CP   7Fh   
023A   38 11                  JR   C,pesc   
023C   E6 BF        PRS0:     AND   0BFh   
023E   EF           PRS1:     RST   28h   
023F   18 E4                  JR   prstr   
0241                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0241                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0241                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0241                             ; pnl: the same, on a new line.
0241   3E 0D        PNL:      LD   A,13   
0243   EF                     RST   28h   
0244   3E 0A                  LD   A,10   
0246   EF                     RST   28h   
0247   E3           PMSG:     EX   (SP),HL   
0248   CD 25 02               CALL   prstr   
024B   E3                     EX   (SP),HL   
024C   C9                     RET      
024D                          ENDIF      
024D                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
024D                             ; HL points past it. Each goes back into the loop that prints the string
024D                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
024D                             ;    /a-/z   print the variable, as "#" does
024D                             ;    /{      clear the screen, the cursor to the top left
024D                             ;    /}      clear from the cursor to the end of the line
024D                             ;    /|  /`  show the cursor, hide it
024D                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
024D   FE 7E        PESC:     CP   7Eh   
024F   28 1C                  JR   Z,pat   
0251   11 25 02               LD   DE,PRLOOP   ; the others return into the loop
0254   D5                     PUSH   DE   
0255   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0257   30 21                  JR   NC,pcon   
0259   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
025B   30 26                  JR   NC,phide   
025D   87                     ADD   A,A   ; the variable's cell
025E   C6 40                  ADD   A,40h   
0260   E5                     PUSH   HL   
0261   6F                     LD   L,A   
0262   26 82                  LD   H,LETPAGE   
0264   7E                     LD   A,(HL)   
0265   2C                     INC   L   
0266   66                     LD   H,(HL)   
0267   6F                     LD   L,A   
0268   CD 25 03               CALL   psgn   
026B   E1                     POP   HL   
026C   C9                     RET      
026D                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
026D                             ; the checked build "$" is the routine prstr: its own return address goes
026D                             ; first, and hp1 calls it again afterwards. There a /~ that takes cells
026D                             ; that aren"t there is s after the "$' (or at its NUL: see e_dollar), as for
026D                             ; any other character. chkstk stops a /~ only when the stack is already
026D                             ; past its empty place, so that, however many there are, what they write
026D                             ; stays in the spare bytes above the stack.
026D                PAT:         
026D                          IF   CHECKED   
026D   D1                     POP   DE   
026E   CD 9D 03               CALL   chkstk   
0271                          ENDIF      
0271   D1                     POP   DE   ; DE = the column
0272   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0273                          IF   1-ANS   
0273   CD 15 FF               CALL   CONAT   
0276   E1                     POP   HL   
0277   C3 CF 01               JP   PRAGAIN   
027A                             ; With ANSI = 0 the machine's routines do the rest.
027A   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
027D   FE 02                  CP   2   
027F   CA 0F FF               JP   Z,CONEOL   ; /}
0282   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
0283   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0284   C3 12 FF               JP   CONCUR   
0287                          ENDIF      
0287                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              LD   A,";"   
                              RST   28h   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              LD   A,"H"   
                              RST   28h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
                              LD   A,"?"   
                              CALL   csia   
                              LD   A,"2"   
                              RST   28h   
                              LD   A,"5"   
                              RST   28h   
                              LD   A,E   
                              RST   28h   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              RST   28h   
                              RET      
                    CSI:      PUSH   AF   
                              LD   A,27   
                              RST   28h   
                              LD   A,"["   
                              RST   28h   
                              POP   AF   
                              RET      
0287                          ENDIF      
0287                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0287                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0287                             ; the quotient bits arrive at the bottom of C.
0287                             ; Dividing by 2 is one shift (the spec wants that fast).
0287   7B           UDIV:     LD   A,E   
0288   EE 02                  XOR   2   
028A   B2                     OR   D   
028B   20 07                  JR   NZ,udv0   
028D   CB 3C                  SRL   H   
028F   CB 1D                  RR   L   ; the quotient
0291   8F                     ADC   A,A   
0292   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0293   C9                     RET      
0294   C5           UDV0:     PUSH   BC   
0295   7C                     LD   A,H   
0296   4D                     LD   C,L   
0297   21 00 00               LD   HL,0   
029A   06 10                  LD   B,16   
029C   CB 21        UDV1:     SLA   C   
029E   17                     RLA      
029F   ED 6A                  ADC   HL,HL   
02A1   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
02A3   30 02                  JR   NC,udv2   ;   always fits in 16 bits
02A5   19                     ADD   HL,DE   ; too much: put it back, and cancel the
02A6   0D                     DEC   C   ;   INC below
02A7   0C           UDV2:     INC   C   ; a quotient bit
02A8   10 F2                  DJNZ   udv1   
02AA   EB                     EX   DE,HL   ; DE = remainder
02AB   67                     LD   H,A   
02AC   69                     LD   L,C   ; HL = quotient
02AD   C1                     POP   BC   
02AE   C9                     RET      
02AF                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
02AF                             ; non-digit. Values wrap at 16 bits, as the spec says.
02AF   21 00 00     RDNUM:    LD   HL,0   
02B2   0A           RDN1:     LD   A,(BC)   
02B3   D6 30                  SUB   "0"   
02B5   FE 0A                  CP   10   
02B7   D0                     RET   NC   
02B8   03                     INC   BC   
02B9   54                     LD   D,H   
02BA   5D                     LD   E,L   
02BB   29                     ADD   HL,HL   
02BC   29                     ADD   HL,HL   
02BD   19                     ADD   HL,DE   
02BE   29                     ADD   HL,HL   ; HL * 10
02BF   5F                     LD   E,A   
02C0   16 00                  LD   D,0   
02C2   19                     ADD   HL,DE   
02C3   18 ED                  JR   rdn1   
02C5                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02C5                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02C5                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
02C5                          ENDIF      
02C5                          IF   CHECKED   
02C5                             ; The checked build never steps over a NUL: if the text runs out first it
02C5                             ; returns A = 0 with the IP on the NUL.
02C5   0A           SKIPSTR:   LD   A,(BC)   
02C6   B7                     OR   A   
02C7   C8                     RET   Z   
02C8   03                     INC   BC   
02C9   FE 22                  CP   22h   
02CB   C8                     RET   Z   
02CC   FE 2F                  CP   "/"   
02CE   20 F5                  JR   NZ,skipstr   
02D0   0A                     LD   A,(BC)   ; the escaped character
02D1   B7                     OR   A   
02D2   C8                     RET   Z   
02D3   03                     INC   BC   
02D4   18 EF                  JR   skipstr   
02D6                          ENDIF      
02D6                             ; skip: read past text to the closer at this level, and return A = 0 if it
02D6                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02D6                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02D6                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02D6                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02D6                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02D6                             ; 
02D6                             ; The checked build also looks at the character the skip was started by,
02D6                             ; which is always the one just before where it starts: "(" must end at ")",
02D6                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02D6                             ; quote counts as running into it. "\" takes either closer. IX keeps the
02D6                             ; place where the skip started, for the report.
02D6                SKIP:        
02D6                          IF   CHECKED   
02D6   C5                     PUSH   BC   
02D7   DD E1                  POP   IX   
02D9   0B                     DEC   BC   
02DA   0A                     LD   A,(BC)   
02DB   03                     INC   BC   
02DC   5F                     LD   E,A   ; E = the opener: ( [ or \
02DD                          ENDIF      
02DD   16 00                  LD   D,0   
02DF   14           SK3:      INC   D   ; an opener: one deeper
02E0   0A           SK1:      LD   A,(BC)   
02E1                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
02E1                          ENDIF      
02E1                          IF   CHECKED   
02E1   B7                     OR   A   
02E2   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
02E4   03                     INC   BC   
02E5                          ENDIF      
02E5   FE 22                  CP   22h   
02E7   CC C5 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02EA   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02EC   28 F1                  JR   Z,sk3   
02EE   3D                     DEC   A   ; ")"
02EF   28 08                  JR   Z,sk4   
02F1   D6 32                  SUB   "["-")"   
02F3   28 EA                  JR   Z,sk3   
02F5   FE 02                  CP   "]"-"["   
02F7   20 E7                  JR   NZ,sk1   
02F9   15           SK4:      DEC   D   
02FA                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
02FA                          ENDIF      
02FA                          IF   CHECKED   
02FA   20 E4                  JR   NZ,sk1   
02FC   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
02FD   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
02FE   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0300   FE 02                  CP   2   ;   closer, and only then
0302   7A                     LD   A,D   
0303   C0                     RET   NZ   
0304   18 05                  JR   sk7   
0306   CB 53        SK6:      BIT   2,E   ; the text ran out:
0308   C2 09 FF               JP   NZ,SKEND   ;   "\" with no closer ends the program
030B   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
030D   C1                     POP   BC   
030E   3E 4E                  LD   A,"N"   
0310   C3 F7 03               JP   errp   ; (errp drops skip's return address)
0313                          ENDIF      
0313                             ; =============================================================================
0313                             ;  Dispatch table: the low byte of each handler's address, in code order
0313                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0313                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0313                             ; =============================================================================
0313                             ; The handlers of the first NPG1 characters start in the image's second page.
0313                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0313                             ; differs between the builds, so the count is worked out here.
0313                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0313                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0313                PGBRK:    EQU   (h_break-BASE)/256   
0313                PGDEF:    EQU   (h_def-BASE)/256   
0313                PGFET:    EQU   (h_fetch-BASE)/256   
0313                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0313                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0313                          ENDIF      
0313                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0313                             ; and return its value in A with the carry set; otherwise leave the IP and
0313                             ; return with the carry clear.
0313   0A           HEXC:     LD   A,(BC)   
0314   D6 30                  SUB   "0"   
0316   FE 0A                  CP   10   
0318   38 09                  JR   C,hc1   
031A   E6 DF                  AND   0DFh   
031C   D6 11                  SUB   11h   
031E   FE 06                  CP   6   
0320   D0                     RET   NC   
0321   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0323   03           HC1:      INC   BC   
0324   C9                     RET      
0325                             ; psgn: print HL as a signed number. Keeps BC.
0325   CB 7C        PSGN:     BIT   7,H   
0327   28 04                  JR   Z,pdec   
0329   3E 2D                  LD   A,"-"   
032B   EF                     RST   28h   
032C   E7                     RST   20h   
032D                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
032D                             ; Keeps BC.
032D   11 0A 00     PDEC:     LD   DE,10   
0330   CD 87 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0333   7B                     LD   A,E   
0334   F5                     PUSH   AF   
0335   7C                     LD   A,H   
0336   B5                     OR   L   
0337   C4 2D 03               CALL   NZ,pdec   
033A   F1                     POP   AF   
033B   C6 30                  ADD   A,"0"   
033D   EF                     RST   28h   
033E   C9                     RET      
033F                             ; (The table goes here instead in the builds where, before psgn, it would
033F                             ; cross a page: PTLATE.)
033F                          IF   (1-TABP0)*PTLATE   
033F                PTAB:        
033F                          ;*Macro unroll:  PTABLE
033F   B9                     DB   h_store & 0FFh   
0340   C1                     DB   h_str & 0FFh   
0341   D6                     DB   h_num & 0FFh   
0342   CC                     DB   h_print & 0FFh   
0343   B1                     DB   h_swap & 0FFh   
0344   56                     DB   h_and & 0FFh   
0345   D3                     DB   h_emit & 0FFh   
0346   32                     DB   h_open & 0FFh   
0347   3A                     DB   h_close & 0FFh   
0348   77                     DB   h_mul & 0FFh   
0349   4D                     DB   h_add & 0FFh   
034A   F2                     DB   h_cfetch & 0FFh   
034B   45                     DB   h_sub & 0FFh   
034C   B3                     DB   h_cstore & 0FFh   
034D   8B                     DB   h_div & 0FFh   
034E   AF                     DB   h_dup & 0FFh   
034F   B8                     DB   h_drop & 0FFh   
0350   5E                     DB   h_lt & 0FFh   
0351   6D                     DB   h_eq & 0FFh   
0352   5F                     DB   h_gt & 0FFh   
0353   DA                     DB   h_key & 0FFh   
0354   2D                     DB   h_fetch & 0FFh   
0355   09                     DB   h_def & 0FFh   
0356   FC                     DB   h_break & 0FFh   
0357   F8                     DB   h_ret & 0FFh   
0358   91                     DB   h_xor & 0FFh   
0359   A4                     DB   h_alloc & 0FFh   
035A   E2                     DB   h_grave & 0FFh   
035B   2C                     DB   h_tor & 0FFh   
035C   99                     DB   h_or & 0FFh   
035D   1C                     DB   h_fromr & 0FFh   
035E   A1                     DB   h_not & 0FFh   
035F                PTABEND:      
035F                          ENDIF      
035F                             ; =============================================================================
035F                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
035F                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
035F                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
035F                             ;  they are the host's KEY and CONOUT routines themselves.
035F                             ; 
035F                             ;  A running program reads the keyboard only through getk and pollk, which
035F                             ;  between them give the break key its rules:
035F                             ;    - Ctrl-C stops the program;
035F                             ;    - any other key that the break check reads is held in KEYBUF for the
035F                             ;      next "?", and a newer one takes its place;
035F                             ;    - "?" (getk) takes the held key first;
035F                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
035F                             ;      key like any other, but two of them within about 250 ms still stop it.
035F                             ;  Both are called straight from a handler, never from a routine under one:
035F                             ;  the checked build's report counts on finding one return address above the
035F                             ;  data stack.
035F                             ; =============================================================================
035F                          IFN   CPM   
035F                RAWK:     EQU   KEY   
035F                          ENDIF      
035F                             ; pollk: the break check (see rpushn).
035F   CD 06 FF     POLLK:    CALL   rawk   
0362   C8                     RET   Z   ; no key
0363   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0366   FE 03        PK1:      CP   3   ; (getk joins here)
0368   C0                     RET   NZ   
0369                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0369                             ; the program has turned it off, wait about 250 ms for one more key: a
0369                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0369                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0369   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
036C   B7                     OR   A   
036D   CA F5 03     CT0:      JP   Z,brk   
0370   D5                     PUSH   DE   
0371   11 10 27               LD   DE,250*MSLOOP   
0374   CD 06 FF     CT1:      CALL   rawk   
0377   20 05                  JR   NZ,ct2   
0379   1B                     DEC   DE   
037A   7A                     LD   A,D   
037B   B3                     OR   E   
037C   20 F6                  JR   NZ,ct1   
037E   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
037F   FE 03                  CP   3   
0381   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0383   B7                     OR   A   
0384   28 03                  JR   Z,ct3   
0386   32 7A 82               LD   (KEYBUF),A   
0389   3E 03        CT3:      LD   A,3   
038B   B7                     OR   A   
038C   C9                     RET      
038D                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
038D   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
038E   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0391   7E                     LD   A,(HL)   
0392   36 00                  LD   (HL),0   
0394   E1                     POP   HL   
0395   B7                     OR   A   
0396   C0                     RET   NZ   
0397   CD 06 FF               CALL   rawk   
039A   C8                     RET   Z   
039B   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
039D                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
039D                          ENDIF      ;   (with the editor, both stacks are cleared);
039D                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
039D                          ENDIF      
039D                          IF   CHECKED   
039D                BRK:      EQU   e_break   ;   the checked build reports B
039D                          ENDIF      
039D                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
039D                          ENDIF      
039D                             ; =============================================================================
039D                             ;  Checked build: the checks and the error report
039D                             ; =============================================================================
039D                          IF   CHECKED   
039D                             ; chkstk: both stacks are checked once per character, not in every handler.
039D                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
039D                             ; the constant carries if it is above (cells were popped that were never
039D                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
039D                             ; a character late at most: the bytes above DSTOP and the guard band below
039D                             ; the page take what happens meanwhile. DE is free between characters.
039D   EB           CHKSTK:   EX   DE,HL   
039E   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
03A1   39                     ADD   HL,SP   
03A2   EB                     EX   DE,HL   
03A3   38 1D                  JR   C,e_under   
03A5   14                     INC   D   
03A6   20 16                  JR   NZ,e_over   
03A8   D9                     EXX      ; the return stack: in its page (or it has
03A9   7C                     LD   A,H   ;   overflowed), and not above its empty
03AA   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
03AC   7D                     LD   A,L   ;   page, in the guard band)
03AD   D9                     EXX      
03AE   20 0B                  JR   NZ,e_rover   
03B0   FE E1                  CP   RSTOP&0FFh+1   
03B2   D8                     RET   C   
03B3   D9                     EXX      ; return stack underflow: it counts as empty
03B4   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
03B6   D9                     EXX      
03B7   3E 72                  LD   A,"r"   
03B9   18 3C                  JR   errp   
03BB   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
03BD   11                     DB   11h   ; (LD DE,nn hides the next entry)
03BE   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
03C0   18 35                  JR   errp   
03C2   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
03C5   3E 73                  LD   A,"s"   
03C7   18 48                  JR   error   
03C9                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
03C9                             ; was never defined still holds 0000h, and the byte there is a reserved one
03C9                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
03C9                             ; an undefined word. The call is undone, so the place is the call itself.
03C9   04           E_HI:     INC   B   
03CA   10 3D                  DJNZ   e_resv   ; (B is as it was, and is not 0)
03CC   CF                     RST   08h   
03CD   42                     LD   B,D   
03CE   4B                     LD   C,E   
03CF   3E 55                  LD   A,"U"   
03D1   18 3E                  JR   error   
03D3                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
03D3                             ; the count. Stop if the top is not below the limit page, or is below the
03D3                             ; program's end.
03D3                CHKHP:       
03D3                          ENDIF      
03D3                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03D3                          ENDIF      
03D3                          IF   CHECKED*(1-CPM)   
03D3                             ; (Here the program's space is under 32K, so a top that wrapped
03D3                             ; round always falls outside it.)
03D3   7C                     LD   A,H   
03D4   FE F0                  CP   HEAPLIM   
03D6   30 09                  JR   NC,e_heap   
03D8                          ENDIF      
03D8                          IF   CHECKED   
03D8   D5                     PUSH   DE   
03D9   EB                     EX   DE,HL   
03DA   2A 38 82               LD   HL,(NPEND)   
03DD   19                     ADD   HL,DE   ; carry: at or above the program's end
03DE   EB                     EX   DE,HL   
03DF   D1                     POP   DE   
03E0   D8                     RET   C   
03E1   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
03E2   ED 52                  SBC   HL,DE   
03E4   3E 48                  LD   A,"H"   
03E6   18 0F                  JR   errp   
03E8                             ; chkst: stop unless HL is in the program's own space: from the letter page
03E8                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
03E8                             ; whatever lies above the limit are safe. Memory above the heap top but
03E8                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
03E8                             ; It is the page of HL + 1 that is tested, so that one test serves both
03E8                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
03E8                             ; Keeps HL and BC. It runs on into its own error entry.
03E8   23           CHKST:    INC   HL   
03E9   7C                     LD   A,H   
03EA   2B                     DEC   HL   
03EB   FE 82                  CP   LETPAGE   
03ED   38 03                  JR   C,e_store   
03EF                          ENDIF      
03EF                          IF   CHECKED*(1-CPM)   
03EF   FE F0                  CP   HEAPLIM   
03F1   D8                     RET   C   
03F2                          ENDIF      
03F2                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03F2                          ENDIF      
03F2                          IF   CHECKED   
03F2                             ; Error entries. Each loads its letter and then hides the next entry inside
03F2                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
03F2   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
03F4   11                     DB   11h   
03F5   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
03F7                             ; errp: an error found inside a routine: drop its return address first.
03F7   D1           ERRP:     POP   DE   
03F8   18 17                  JR   error   
03FA                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
03FA                             ; back in TOS. prstr's return address goes first. But if a /~ took cells
03FA                             ; that weren't there, it is s, found now: chkstk, called one cell up, sees
03FA                             ; the stack past its empty place then.
03FA   D1           E_DOLLAR:   POP   DE   
03FB   E1                     POP   HL   
03FC   CD 9D 03               CALL   chkstk   
03FF   E5                     PUSH   HL   
0400   2A 34 82               LD   HL,(RSAVE)   
0403   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
0404   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0405   4D                     LD   C,L   ;   past the opening quote, which is the place
0406   3E 51                  LD   A,"Q"   
0408   11                     DB   11h   
0409   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
040B   11                     DB   11h   
040C   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
040E   11                     DB   11h   
040F   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0411                             ; error: the report, then the end. A = the letter, BC = one past the place,
0411                             ; HL = TOS, and both stacks as the report is to show them:
0411                             ; 
0411                             ;   Err X @ line,col
0411                             ;   up to 16 characters of the text from the place
0411                             ;   Stk n: the top 8 cells at most, bottom to top
0411                             ;   Rtn n
0411   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0412   5F                     LD   E,A   
0413   CD 41 02               CALL   pnl   
0416   45 72 72 20 22         DB   "Err ",22h   
041B   7B                     LD   A,E   
041C   EF                     RST   28h   
041D   CD 47 02               CALL   pmsg   
0420   20 40 20 22            DB   " @ ",22h   
0424   0B                     DEC   BC   ; BC = the place
0425                             ; The line and column. A place below the program is in the line
0425                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0425                             ; DE = the line's number, HL = where it starts.
0425   21 80 82               LD   HL,LINEBUF   
0428   11 00 00               LD   DE,0   
042B   78                     LD   A,B   
042C   FE 83                  CP   PROG/256   
042E   38 14                  JR   C,er3   
0430   24                     INC   H   
0431   6B                     LD   L,E   ; HL = PROG
0432   13           ER1:      INC   DE   ; a new line starts at HL
0433   E5                     PUSH   HL   
0434   7D           ER2:      LD   A,L   
0435   91                     SUB   C   
0436   7C                     LD   A,H   
0437   98                     SBC   A,B   
0438   30 09                  JR   NC,er2x   ; reached the place
043A   7E                     LD   A,(HL)   
043B   23                     INC   HL   
043C   FE 0A                  CP   10   
043E   20 F4                  JR   NZ,er2   
0440   F1                     POP   AF   
0441   18 EF                  JR   er1   
0443   E1           ER2X:     POP   HL   
0444   C5           ER3:      PUSH   BC   
0445   E5                     PUSH   HL   
0446   EB                     EX   DE,HL   
0447   CD 2D 03               CALL   pdec   ; the line
044A   3E 2C                  LD   A,","   
044C   EF                     RST   28h   
044D   D1                     POP   DE   
044E   E1                     POP   HL   
044F   E5                     PUSH   HL   
0450   B7                     OR   A   
0451   ED 52                  SBC   HL,DE   
0453   23                     INC   HL   
0454   CD 2D 03               CALL   pdec   ; the column
0457   CD 41 02               CALL   pnl   
045A   22                     DB   22h   
045B   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
045C   06 10                  LD   B,16   ;   if the line or the program ends first
045E   7E           ER4:      LD   A,(HL)   
045F   23                     INC   HL   
0460   B7                     OR   A   
0461   28 0B                  JR   Z,er5   
0463   FE 0D                  CP   13   
0465   28 07                  JR   Z,er5   
0467   FE 0A                  CP   10   
0469   28 03                  JR   Z,er5   
046B                          ENDIF      
046B                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
046B                          ENDIF      ;   screen on it. The editor's loader ends
046B                          IF   CHECKED   ;   the text at the first ^Z.)
046B   EF                     RST   28h   
046C   10 F0                  DJNZ   er4   
046E                ER5:         ; (on into the two stack lines)
046E                             ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
046E                             ;                       Rtn n
046E                             ; TOS is in memory with the rest (pushed) by now.
046E   CD 41 02               CALL   pnl   
0471   53 74 6B 20 22         DB   "Stk ",22h   
0476   21 06 7E               LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
0479   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
047A   E7                     RST   20h   ;   with the first value and holds nothing)
047B   CD C2 04               CALL   phalf   ; the depth
047E   3E 3A                  LD   A,":"   
0480   EF                     RST   28h   
0481   79                     LD   A,C   
0482   FE 09                  CP   9   
0484   38 0A                  JR   C,er6   
0486   CD 47 02               CALL   pmsg   
0489   20 2E 2E 2E 22         DB   " ...",22h   
048E   0E 08                  LD   C,8   
0490   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0492   69                     LD   L,C   
0493   29                     ADD   HL,HL   
0494   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0495   0C                     INC   C   
0496   0D           ER7:      DEC   C   
0497   28 0F                  JR   Z,er8   
0499   2B                     DEC   HL   
049A   56                     LD   D,(HL)   
049B   2B                     DEC   HL   
049C   5E                     LD   E,(HL)   
049D   E5                     PUSH   HL   
049E   3E 20                  LD   A," "   
04A0   EF                     RST   28h   
04A1   EB                     EX   DE,HL   
04A2   CD 25 03               CALL   psgn   
04A5   E1                     POP   HL   
04A6   18 EE                  JR   er7   
04A8   CD 41 02     ER8:      CALL   pnl   
04AB   52 74 6E 20 22         DB   "Rtn ",22h   
04B0   D9                     EXX      ; RSTOP - HL' is under 256 (the pointer is
04B1   3E E0                  LD   A,RSTOP&0FFh   ;   at most one entry below its page), so
04B3   95                     SUB   L   ;   the low bytes are enough
04B4   D9                     EXX      
04B5   6F                     LD   L,A   
04B6   26 00                  LD   H,0   
04B8   CD C2 04               CALL   phalf   
04BB   CD 41 02               CALL   pnl   
04BE   22                     DB   22h   
04BF                          ENDIF      
04BF                          IF   CHECKED*(1-EDITOR)   
04BF   C3 15 00               JP   endprog   
04C2                          ENDIF      
04C2                          IF   CHECKED*EDITOR   
                              JP   edit0   ; back to the editor, with both stacks cleared
04C2                          ENDIF      
04C2                          IF   CHECKED   
04C2                             ; phalf: print half of HL, and leave it in C.
04C2   CB 3C        PHALF:    SRL   H   
04C4   CB 1D                  RR   L   
04C6   E5                     PUSH   HL   
04C7   CD 2D 03               CALL   pdec   
04CA   C1                     POP   BC   
04CB   C9                     RET      
04CC                          ENDIF      
04CC                             ; =============================================================================
04CC                             ;  The line editor (EDITOR = 1)
04CC                             ; 
04CC                             ;  The interpreter starts here, and a program that ends comes back here.
04CC                             ;  There is no prompt. It follows the spec's suggested standard for a line
04CC                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
04CC                             ; 
04CC                             ;    n text    put the text in as line n; the lines from n on move down. A
04CC                             ;              number past the end (or 0) adds the line at the end.
04CC                             ;    n         take line n out
04CC                             ;    anything else is run at once, as B8Script. (Start such a line with a
04CC                             ;    space if it would begin with a digit.)
04CC                             ; 
04CC                             ;  A command key ends the line too, and takes what was typed as its argument:
04CC                             ; 
04CC                             ;    ^G        run the program
04CC                             ;    n ^L      list from line n (no number: all of it). Any key holds the
04CC                             ;              list until another key is pressed; Ctrl-C ends it.
04CC                             ;    n ^E      put line n in the input line; Return puts it back, changed
04CC                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
04CC                             ;              last time). Generic: what is typed, or pasted, from now until
04CC                             ;              ^Z replaces the program; it is not echoed.
04CC                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
04CC                             ;              time). Generic: the text is printed, as it is.
04CC                             ;    ^N ^N     new: no program (the key twice in a row)
04CC                             ;    ^X        leave (to LEAVE)
04CC                             ; 
04CC                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
04CC                             ;  a character goes in at the cursor; Backspace and DEL take out the one
04CC                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
04CC                             ;  sent to the terminal, so any terminal will do.
04CC                             ; 
04CC                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
04CC                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
04CC                             ;  125 characters; the one character after a line number separates it from
04CC                             ;  the text and is not stored. The text is kept as it is typed, each line
04CC                             ;  ending in CR LF, at PROG.
04CC                             ; 
04CC                             ;  What lasts from one line to the next: the program, the words, the
04CC                             ;  variables and the data stack. An error or a break clears both stacks. The
04CC                             ;  return stack starts empty for every line.
04CC                             ; 
04CC                             ;  Things to know:
04CC                             ;    - Reset empties the program (generic builds).
04CC                             ;    - A word's address points into the program, so run the program again
04CC                             ;      after editing it.
04CC                             ;    - Nothing is printed between a program's output and what is typed next.
04CC                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
04CC                             ;      a line that calls -n? and carries on afterwards runs what was typed.
04CC                             ;      (The stored program never comes back to the line, so it may.)
04CC                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
04CC                             ;      read of the other builds.
04CC                             ; 
04CC                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
04CC                             ;  the last line left there, with TOS pushed like the rest.
04CC                             ; =============================================================================
04CC                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
04CC                          ENDIF      
04CC                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
04CC                          ENDIF      
04CC                          IF   EDGEN   
                              JR   edit0   
04CC                          ENDIF      
04CC                          IF   EDITOR   
                                 ; ^F, right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; ^B, left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                    LF1:      RST   28h   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
04CC                          ENDIF      
04CC                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
04CC                          ENDIF      
04CC                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
04CC                          ENDIF      
04CC                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   2   
                              JR   Z,left   ; ^B
                              CP   6   
                              JR   Z,right   ; ^F
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              LD   A,8   
                              RST   28h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              RST   28h   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              RST   28h   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              LD   A,8   
                              RST   28h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N ^N: no program, if the next key is ^N too
                    CNEW:     CALL   ekey   
                              CP   14   
                              JR   NZ,ged0   
                              XOR   A   
                              LD   (PROG),A   
                    GED0:     JP   edit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              RST   28h   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
04CC                          ENDIF      
04CC                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
04CC                          ENDIF      
04CC                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              RST   30h   ; (its return address is thrown away)
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
04CC                          ENDIF      
04CC                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
04CC                          ENDIF      
04CC                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
04CC                          ENDIF      
04CC                             ; =============================================================================
04CC                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
04CC                          ENDIF      
04CC                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
04CC                          ENDIF      
04CC                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
04CC                          ENDIF      
04CC                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
04CC                          ENDIF      
04CC                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
04CC                          ENDIF      
04CC                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
04CC                          ENDIF      
04CC                IMGEND:      


