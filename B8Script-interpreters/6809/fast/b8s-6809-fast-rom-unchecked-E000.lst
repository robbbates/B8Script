E233   34 04                  PSHS   B   
E235   EC C1                  LDD   ,U++   ; the quotient: if it is not 0, it goes
E237   27 04                  BEQ   pd1   ;   back for the rest of the digits
E239   36 06                  PSHU   D   
E23B   8D EC                  BSR   pdec   
E23D   35 02        PD1:      PULS   A   
E23F   8B 30                  ADDA   #"0"   ; and fall into putc
E241   7E FF 03     PUTC:     JMP   CONOUT   
E244                             ; ---- the tail ---------------------------------------------------------------
E244                             ; "$" is the last handler, so what follows its first byte may lie past the
E244                             ; second range: its loop, the escapes, and the routines of "/".
E244                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E244                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E244                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E244                             ; it stops with Z, both operands still on the stack.
E244                H_DIV:       
E244                          IF   CHECKED   
                              LDD   ,U   
                              LBEQ   e_zero   
E244                          ENDIF      
E244   A6 42                  LDA   2,U   
E246   34 02                  PSHS   A   ; a's sign: for r
E248   A8 C4                  EORA   ,U   
E24A   34 02                  PSHS   A   ; a xor b: for q
E24C   30 42                  LEAX   2,U   
E24E   8D 45                  BSR   absx   ; |a|
E250   1F 31                  TFR   U,X   
E252   8D 41                  BSR   absx   ; |b|
E254                          IF   1-QK   
                              BSR   udiv   ; NOS = q, TOS = r
E254                          ENDIF      
E254                          IF   QK   
E254   BD E3 1B               JSR   udiv   ; (base: with the speed-ups)
E257                          ENDIF      
E257   30 42                  LEAX   2,U   
E259   6D E0                  TST   ,S+   
E25B   2A 02                  BPL   dv1   
E25D   8D 2F                  BSR   negx   ; q's sign
E25F   6D E0        DV1:      TST   ,S+   
E261   2A 31                  BPL   ng9   
E263   20 27                  BRA   negt   ; r's sign
E265                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E265                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E265                             ; clears that character"s bit 6 (/M is CR, "/" and DEL is "?"; "/", ""'
E265                             ; and "?" have no bit 6, so //, /" and /? give themselves). The address
E265                             ; comes off the stack first, and Y walks the string (the IP waits on S), so
E265                             ; that /~ finds its row and column on top, and an escape may use A, B, X
E265                             ; and the routines.
E265                             ; Checked: a NUL (not one escaped by "/") stops with Q, the string's
E265                             ; address put back on the stack (from PSAV) over what any /~ left.
E265   34 20        H_PRINT:   PSHS   Y   
E267   37 20                  PULU   Y   
E269                          IF   CHECKED   
                              CMPU   #DSTOP   ; "$" with nothing on the stack: s, before it
                              LBHI   e_ds   ;   prints from an address of no meaning (N
                              STY   <PSAV   ;   is clear: an underflow)
E269                          ENDIF      
E269   A6 A0        PR0:      LDA   ,Y+   
E26B                          IF   CHECKED   
                              BEQ   prq   
E26B                          ENDIF      
E26B   81 22                  CMPA   #22h   
E26D   27 18                  BEQ   pr9   
E26F   81 2F                  CMPA   #"/"   
E271   26 10                  BNE   pr1   
E273   A6 A0                  LDA   ,Y+   
E275   80 60                  SUBA   #60h   ; ` 0, a-z 1-26, 00bbIDI3LCB8IDI4LCA= 29, ~ 30
E277   81 1F                  CMPA   #1Fh   
E279   24 04                  BHS   pr2   
E27B   8D 21                  BSR   pesc   
E27D   20 EA                  BRA   pr0   
E27F   8B 60        PR2:      ADDA   #60h   ; any other: bit 6 goes
E281   84 BF                  ANDA   #0BFh   
E283   8D BC        PR1:      BSR   putc   
E285   20 E2                  BRA   pr0   
E287   35 A0        PR9:      PULS   Y,PC   
E289                          IF   CHECKED   
                    PRQ:      LDX   <PSAV   
                              PSHU   X   
                              JMP   e_quote   
E289                          ENDIF      
E289                             ; "-", checked build (see the unchecked one, before "!").
E289                          IF   CHECKED   
                    H_SUB:    JSR   isdig   
                              BLO   negnum   
                              LDD   2,U   
                              SUBD   ,U++   
                              BRA   ud3   ; (STD ,U / RTS)
E289                          ENDIF      
E289   BD E0 3B     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
E28C   1F 31        NEGT:     TFR   U,X   
E28E   4F           NEGX:     CLRA      ; negx: negate the cell at X
E28F   5F                     CLRB      
E290   A3 84                  SUBD   ,X   
E292   ED 84                  STD   ,X   
E294   39           NG9:      RTS      
E295   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
E297   2A FB                  BPL   ng9   
E299   20 F3                  BRA   negx   
E29B                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
E29B                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
E29B                             ; the TOS cell the remainder. The remainder is built in D (always < the
E29B                             ; divisor, so 2R+1 fits in 16 bits).
E29B                             ; Dividing by 2 is one shift (the spec wants that fast). (base divides
E29B                             ; by any power of two with shifts: its udiv is with the speed-ups, and
E29B                             ; comes to ud0 for the rest; pdec, whose divisor is 10, goes straight there.)
E29B                          IF   1-QK   
                    UDIV:     LDD   ,U   
                              SUBD   #2   
                              BNE   ud0   
                              LSR   2,U   
                              ROR   3,U   ; the quotient
                              ROLB      ; the remainder: the bit that fell out (D was 0)
                              BRA   ud3   
E29B                          ENDIF      
E29B                          IF   1-FAST   
                    UD0:      LDX   #16   
                              CLRA      
                              CLRB      
                    UD1:      ASL   3,U   
                              ROL   2,U   ; the dividend's top bit ...
                              ROLB      
                              ROLA      ; ... into the remainder
                              CMPD   ,U   
                              BLO   ud2   
                              SUBD   ,U   
                              INC   3,U   ; a quotient bit
                    UD2:      LEAX   -1,X   
                              BNE   ud1   
E29B                          ENDIF      ; (the fast build's is unrolled: see the end)
E29B   ED C4        UD3:      STD   ,U   
E29D   39                     RTS      
E29E                             ; pesc: the escapes of "$". A = the character after the "/", minus 60h
E29E                             ; (0 to 30); Y points past it. Each returns to the loop with an RTS, its
E29E                             ; own or that of the routine it ends by jumping to. A, B and X are free.
E29E                             ;    /a-/z   print the variable, as "#" does
E29E                             ;    /{      clear the screen, the cursor to the top left
E29E                             ;    /}      clear from the cursor to the end of the line
E29E                             ;    /|  /`  show the cursor, hide it
E29E                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
E29E   81 1B        PESC:     CMPA   #27   
E2A0   24 0F                  BHS   pcon   
E2A2   48                     ASLA      ; (` leaves A = 0: hide)
E2A3   27 18                  BEQ   phide   
E2A5   8E 82 3E               LDX   #LET+40h-2   ; the variable's cell (little-endian)
E2A8   EC 86                  LDD   A,X   
E2AA   1E 89                  EXG   A,B   
E2AC   36 06                  PSHU   D   
E2AE   7E E2 1F               JMP   h_num   
E2B1                          IF   1-ANSI   
E2B1   10 27 1C 57  PCON:     LBEQ   CONCLS   ; /{
E2B5   81 1D                  CMPA   #29   
E2B7   10 27 1C 54            LBEQ   CONEOL   ; /}
E2BB   22 03                  BHI   pat   
E2BD   7E FF 12     PHIDE:    JMP   CONCUR   ; /|  (A = 28: show), /`  (A = 0: hide)
E2C0                          ENDIF      
E2C0                PAT:         
E2C0                          IF   CHECKED   
                                 ; /~ checks first that there are a row and a column (with less it
                                 ; is s, and the stack counts as empty): U is never let past the
                                 ; top of the stack, however many /~ there are.
                              CMPU   #DSTOP-4   
                              LBHI   e_ds   ; (N is clear: an underflow)
E2C0                          ENDIF      
E2C0                          IF   1-ANSI   
E2C0   37 16                  PULU   D,X   ; /~  D = the column, X = the row
E2C2   7E FF 15               JMP   CONAT   
E2C5                          ENDIF      
E2C5                          IF   ANSI   
                                 ; /~  ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              PULU   D,X   ; D = the column, X = the row
                              ADDD   #1   
                              LEAX   1,X   
                              PSHU   D   
                              PSHU   X   
                              BSR   csi   
                              JSR   pdec   
                              BSR   pm   
                              FCB   ";"+80h   
                              JSR   pdec   
                              BSR   pm   
                              FCB   "H"+80h   
                              RTS      
                    PCON:     BEQ   pcls   ; /{
                              CMPA   #29   
                              BEQ   peol   ; /}
                              BHI   pat   
                              BSR   pcsi   ; /|  ESC [ ? 2 5 h
                              FCB   "?25","h"+80h   
                              RTS      
                    PHIDE:    BSR   pcsi   ; /`  ESC [ ? 2 5 l
                              FCB   "?25","l"+80h   
                              RTS      
                    PCLS:     BSR   pcsi   ; /{  ESC [ H ESC [ J
                              FCB   "H"+80h   
                              BSR   pcsi   
                              FCB   "J"+80h   
                              RTS      
                    PEOL:     BSR   pcsi   ; /}  ESC [ K
                              FCB   "K"+80h   
                              RTS      
                                 ; pcsi: ESC [ and then the text after the call, as pmsg. csi: ESC [.
                    CSI:      BSR   pm   
                              FCB   27,"["+80h   
                              RTS      
                    PCSI:     BSR   csi   
E2C5                          ENDIF      
E2C5                          IF   ANSI*(1-CHECKED)   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                                 ; (The checked build has its own, with the report: pm leads to it.)
                    PM:          
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              JSR   CONOUT   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
E2C5                          ENDIF      
E2C5                          IF   ANSI*CHECKED   
                    PM:       JMP   pmsg   
E2C5                          ENDIF      
E2C5                          IF   QK   
E2C5                             ; =============================================================================
E2C5                             ;  Speed-ups (base, and the fast build)
E2C5                             ; 
E2C5                             ;  The rest of them are with their handlers: "*" (h_mul), the unchecked
E2C5                             ;  a-z (lower), pdec (straight to the long divide) and the startup, which
E2C5                             ;  empties the skip cache. (A true ")" already reads the block start where
E2C5                             ;  it is, in every build, so there is nothing to gain there.)
E2C5                             ; =============================================================================
E2C5                             ; skip, with the skip cache. Nearly every skip is one that has happened
E2C5                             ; before (a loop skips the same false block on every pass), so the end of
E2C5                             ; each scan is remembered: 64 entries of 00bbc3RhcnQsIGVuZA== (big-endian), in the
E2C5                             ; page CPAGE, found by the start's low byte times 4. Only skips that start
E2C5                             ; in the program text hit (the line buffer changes); the cache is emptied
E2C5                             ; whenever a run starts. A program that changes its own text while it runs
E2C5                             ; is not looked after. A hit returns as the scan would: Y past the closer,
E2C5                             ; and A = 0 for ")" or 2 for "]".
E2C5   1F 20        SKIP:     TFR   Y,D   ; the start: the cache's key
E2C7   58                     ASLB      
E2C8   58                     ASLB      
E2C9   8E DF 00               LDX   #CPAGE*256   
E2CC   3A                     ABX      ; X -> the entry
E2CD   10 AC 84               CMPY   ,X   
E2D0   26 0F                  BNE   sks   
E2D2   10 8C 83 00            CMPY   #PROG   
E2D6   25 09                  BLO   sks   ; below the program text: never a hit
E2D8   10 AE 02               LDY   2,X   ; a hit: the IP is past the closer,
E2DB   A6 3F                  LDA   -1,Y   ;   ")" (29h) or "]" (5Dh): 0 or 2
E2DD   44                     LSRA      
E2DE   84 02                  ANDA   #2   
E2E0   39                     RTS      
E2E1                             ; The scan, which fills the entry (X is kept throughout). A scan that fails
E2E1                             ; ends the program, so an entry is never left half written for a later run
E2E1                             ; to find. Two range tests rule most characters out: ^ and up, and * to Z.
E2E1                             ; Only NUL " ( ) [ ] count. B counts the open levels.
E2E1   10 AF 84     SKS:      STY   ,X   ; the key
E2E4   C6 FF                  LDB   #0FFh   
E2E6   5C           SQ3:      INCB      ; an opener: one deeper
E2E7   A6 A0        SQ1:      LDA   ,Y+   
E2E9   81 5E                  CMPA   #5Eh   
E2EB   24 FA                  BHS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E2ED   81 5B                  CMPA   #5Bh   
E2EF   24 19                  BHS   sqb   ; [ \ ]
E2F1   81 2A                  CMPA   #2Ah   
E2F3   24 F2                  BHS   sq1   ; * to Z: nothing
E2F5   81 28                  CMPA   #28h   
E2F7   27 ED                  BEQ   sq3   ; (
E2F9   22 18                  BHI   sqc   ; )
E2FB   81 22                  CMPA   #22h   
E2FD   27 06                  BEQ   sqq   ; a string
E2FF   4D                     TSTA      
E300   26 E5                  BNE   sq1   ; the rest below "(": nothing
E302                          ENDIF      
E302                          IF   QK*(1-CHECKED)   
E302   7E E0 2A               JMP   fin   ; NUL: the end of the program
E305   BD E1 8B     SQQ:      JSR   skipstr   ; step over the string
E308   20 DD                  BRA   sq1   
E30A                          ENDIF      
E30A                          IF   QK*CHECKED   
                              DECA      ; NUL: A = FFh, and the caller decides
                              RTS      
                    SQQ:      JSR   skipstr   ; step over the string; A = FFh with the
                              BCC   sq1   ;   carry set if it ran into the NUL
                              RTS      
E30A                          ENDIF      
E30A                          IF   QK   
E30A   80 5C        SQB:      SUBA   #5Ch   ; [ -1, \ 0, ] 1
E30C   27 D9                  BEQ   sq1   ; "\" is nothing here
E30E   25 D6                  BLO   sq3   ; [
E310   86 02                  LDA   #2   ; ]
E312   21                     FCB   21h   ; (BRN: steps over the CLRA)
E313   4F           SQC:      CLRA      ; )
E314   5A                     DECB      
E315   2A D0                  BPL   sq1   
E317   10 AF 02               STY   2,X   ; the closer at this level: the entry's end
E31A   39                     RTS      
E31B                             ; base: a power of two, 2^k, is a shift: q = a >> k and r = a AND (2^k - 1).
E31B                             ; That is 2, and 256 for a high byte, and the 32 or 64 of fixed point.
E31B   EC C4        UDIV:     LDD   ,U   
E31D   10 27 0C 18            LBEQ   ud0   ; by 0: the long way (it means nothing anyway)
E321   83 00 01               SUBD   #1   
E324   1F 01                  TFR   D,X   ; X = d - 1
E326   A4 C4                  ANDA   ,U   
E328   10 26 0C 0D            LBNE   ud0   
E32C   E4 41                  ANDB   1,U   
E32E   10 26 0C 07            LBNE   ud0   ; not a power of two
E332   1F 10                  TFR   X,D   
E334   A4 42                  ANDA   2,U   
E336   E4 43                  ANDB   3,U   
E338   34 06                  PSHS   D   ; r
E33A   6D 41                  TST   1,U   
E33C   26 09                  BNE   uq0   ; d < 256
E33E   A6 C4                  LDA   ,U   ; 256 and up: d and a move a byte down
E340   A7 41                  STA   1,U   ;   (the low byte of d is all the loop
E342   E6 42                  LDB   2,U   ;   looks at)
E344   4F                     CLRA      
E345   20 02                  BRA   uq1   
E347   EC 42        UQ0:      LDD   2,U   
E349   64 41        UQ1:      LSR   1,U   ; a moves down until d's one bit falls out
E34B   25 04                  BCS   uq2   
E34D   44                     LSRA      
E34E   56                     RORB      
E34F   20 F8                  BRA   uq1   
E351   ED 42        UQ2:      STD   2,U   ; q
E353   35 06                  PULS   D   
E355   ED C4                  STD   ,U   
E357   39                     RTS      
E358                          ENDIF      
E358                          IF   FAST   
E358                             ; =============================================================================
E358                             ;  The fast build (SPEED = 2)
E358                             ; 
E358                             ;  The inner loop is a table of 256 handler addresses, FTAB, one for every
E358                             ;  byte, and the dispatcher (NEXTF, at the top) is inline at the end of each
E358                             ;  of the fast build's own entries, so there is no return to a loop:
E358                             ; 
E358                             ;      LDB ,Y+ / LDX #FTAB / ABX / ABX / JMP [,X]
E358                             ; 
E358                             ;  (21 cycles; the checked build calls fchk first, which checks the stacks
E358                             ;  and keeps the place, as the ordinary inner loop does.) The entries are
E358                             ;  jumped to, not called, so nothing of the dispatcher's is on the return
E358                             ;  stack while they run. The letters and digits have one entry each, which
E358                             ;  knows its cell or its value already; the commonest punctuation has its
E358                             ;  own; the rest are thunks, JSR to the ordinary handler, which returns
E358                             ;  with its RTS as it would to the ordinary dispatcher.
E358                             ; =============================================================================
E358                          ENDIF      
E358                          IF   FAST*CHECKED   
                                 ; fchk: the checks of the inner loop, for the checked fast build (S is 2
                                 ; lower in here than when the character starts).
                    FCHK:     LEAX   (0-DSLIM)&0FFFFh,U   
                              CMPX   #DSTOP-DSLIM   
                              LBHI   e_ds   
                              LEAX   (2-RSLIM)&0FFFFh,S   
                              CMPX   #RSTOP-RSLIM   
                              LBHI   e_rs   
                              STY   <AT   ; the place, should this character fail
                              LEAX   2,S   
                              STX   <SSAV   ; and the return stack, as it is then
                              RTS      
                    FOPF:     EQU   opf   ; (a false "(": the checked skip)
                    FSTORE:   EQU   ft_store   ; ("!" and "." are checked: the thunks)
                    FCSTORE:   EQU   ft_cstore   
                    FHIGH:    EQU   fhi   ; (80h-FFh: X)
                    FHI:      JMP   e_resv   ; 80h-FFh: reserved
E358                          ENDIF      
E358                          IF   FAST*(1-CHECKED)   
E358                FOPF:     EQU   skip   
E358                FSTORE:   EQU   fs_store   
E358                FCSTORE:   EQU   fs_cstore   
E358                FHIGH:    EQU   fign   ; (80h-FFh are ignored)
E358                          ENDIF      
E358                          IF   FAST   
E358                          ;*Macro unroll: fnext:  NEXTF                   ; the startup comes here
E358                FNEXT:    DS   CHECKED,0BDh   ; the startup comes here
E358                          DS   CHECKED,ACHK/256   
E358                          DS   CHECKED,ACHK&0FFh   
E358   E6 A0                  LDB   ,Y+   
E35A   8E F0 2E               LDX   #FTAB   
E35D   3A                     ABX      
E35E   3A                     ABX      
E35F   6E 94                  JMP   [,X]   
E361   7E FF 09     FNUL:     JMP   EXIT   ; NUL: the end of the program
E364                          ;*Macro unroll: fign:   NEXTF                   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
E364                FIGN:     DS   CHECKED,0BDh   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
E364                          DS   CHECKED,ACHK/256   
E364                          DS   CHECKED,ACHK&0FFh   
E364   E6 A0                  LDB   ,Y+   
E366   8E F0 2E               LDX   #FTAB   
E369   3A                     ABX      
E36A   3A                     ABX      
