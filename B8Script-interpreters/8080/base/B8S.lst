029F                             ; stack, so that an error report shows both.)
029F                H_STORE:      ; "!" ( n addr -- )
029F                          IF   CHECKED   
029F   CD 2B 06               CALL   chkst   
02A2                          ENDIF      
02A2   D1                     POP   D   
02A3   73                     MOV   M,E   
02A4   23                     INX   H   
02A5   72                     MOV   M,D   
02A6                          ;*Macro unroll:  DROP
02A6                          DS   (1-CPM)*(1-FAST),0DFh   
02A6   C3                     DS   CPM*(1-FAST),0C3h   
02A7   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02A8   01                     DS   CPM*(1-FAST),ADRP/256   
02A9                          DS   FAST,0E1h   
02A9                          DS   FAST,0C3h   
02A9                          DS   FAST,ANXT&0FFh   
02A9                          DS   FAST,ANXT/256   
02A9                H_CSTORE:      ; "." ( c addr -- )
02A9                          IF   CHECKED   
02A9   CD 2B 06               CALL   chkst   
02AC                          ENDIF      
02AC   D1                     POP   D   
02AD   73                     MOV   M,E   
02AE                          ;*Macro unroll:  DROP
02AE                          DS   (1-CPM)*(1-FAST),0DFh   
02AE   C3                     DS   CPM*(1-FAST),0C3h   
02AF   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02B0   01                     DS   CPM*(1-FAST),ADRP/256   
02B1                          DS   FAST,0E1h   
02B1                          DS   FAST,0C3h   
02B1                          DS   FAST,ANXT&0FFh   
02B1                          DS   FAST,ANXT/256   
02B1                             ; ---- console ---------------------------------------------------------------
02B1                             ; 22h pushes the address of the text after it and skips the string.
02B1   E5           H_STR:    PUSH   H   
02B2   60                     MOV   H,B   
02B3   69                     MOV   L,C   
02B4   CD 1D 05               CALL   skipstr   
02B7                          IF   CHECKED   
02B7   B7                     ORA   A   ; 0: the text ran out before the closing quote
02B8   CA C6 06               JZ   e_quote   
02BB                          ENDIF      
02BB                          ;*Macro unroll:  NEXT
02BB                          DS   (1-CPM)*(1-FAST),0F7h   
02BB   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02BC   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02BD   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02BE                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02BE                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02BE                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02BE                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02BE                          IF   1-CHECKED   
                    H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
                    PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
                    PRAGAIN:   EQU   prlp   ;   the image's first two pages)
02BE                          ENDIF      
02BE                          IF   CHECKED   
02BE                             ; (The checked build has the loop as a routine, prstr, which the error
02BE                             ; report uses too. The address is kept meanwhile, for a report: it shows
02BE                             ; the stack as it was before the "$". /~ comes back to hp1.)
02BE   22 3A 0B     H_PRINT:   SHLD   PSAVE   
02C1   CD 42 06     HP1:      CALL   prstr   
02C4                          ;*Macro unroll:  DROP
02C4                          DS   (1-CPM)*(1-FAST),0DFh   
02C4   C3                     DS   CPM*(1-FAST),0C3h   
02C5   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02C6   01                     DS   CPM*(1-FAST),ADRP/256   
02C7                          DS   FAST,0E1h   
02C7                          DS   FAST,0C3h   
02C7                          DS   FAST,ANXT&0FFh   
02C7                          DS   FAST,ANXT/256   
02C7                          ENDIF      
02C7   7D           H_EMIT:   MOV   A,L   ; "'"
02C8                          ;*Macro unroll:  PUTA
02C8                          DS   1-CPM,0EFh   
02C8   CD                     DS   CPM,0CDh   
02C9   FD                     DS   CPM,APUT&0FFh   
02CA   05                     DS   CPM,APUT/256   
02CB                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
02CB                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
02CB   C3                     DS   CPM*(1-FAST),0C3h   
02CC   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02CD   01                     DS   CPM*(1-FAST),ADRP/256   
02CE                          DS   FAST,0E1h   
02CE                          DS   FAST,0C3h   
02CE                          DS   FAST,ANXT&0FFh   
02CE                          DS   FAST,ANXT/256   
02CE                             ; "#" prints TOS as a signed decimal number, with no space after it.
02CE   C5           H_NUM:    PUSH   B   
02CF   CD D7 03               CALL   psgn   
02D2   C1                     POP   B   
02D3                          ;*Macro unroll:  DROP
02D3                          DS   (1-CPM)*(1-FAST),0DFh   
02D3   C3                     DS   CPM*(1-FAST),0C3h   
02D4   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02D5   01                     DS   CPM*(1-FAST),ADRP/256   
02D6                          DS   FAST,0E1h   
02D6                          DS   FAST,0C3h   
02D6                          DS   FAST,ANXT&0FFh   
02D6                          DS   FAST,ANXT/256   
02D6                          IF   CHECKED   ; (the checked build has no room to start ","
02D6   6E           H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
02D7   26 00                  MVI   H,0   ;   the end of "?")
02D9                          ;*Macro unroll:  NEXT
02D9                          DS   (1-CPM)*(1-FAST),0F7h   
02D9   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02DA   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02DB   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02DC                          ENDIF      
02DC                             ; "?" ( n -- c ) or ( -n -- addr )
02DC                             ;   n > 0: wait about n ms for a key; 0 if none came
02DC                             ;   n = 0: wait for a key
02DC                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02DC                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02DC   7C           H_KEY:    MOV   A,H   
02DD   B7                     ORA   A   
02DE   FA FE 02               JM   line   
02E1   1E 04        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
02E3   CD C3 05     KT2:      CALL   getk   
02E6   C2 F8 02               JNZ   kt3   
02E9   1D                     DCR   E   
02EA   C2 E3 02               JNZ   kt2   
02ED   7C                     MOV   A,H   ; 0? never counts down: it waits
02EE   B5                     ORA   L   
02EF   CA E1 02               JZ   kt1   
02F2   2B                     DCX   H   
02F3   7C                     MOV   A,H   
02F4   B5                     ORA   L   
02F5   C2 E1 02               JNZ   kt1   ; A = 0 if the time ran out
02F8                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
02F8                          ENDIF      
02F8   6F           KT3:      MOV   L,A   
02F9   26 00                  MVI   H,0   
02FB                          ;*Macro unroll:  NEXT
02FB                          DS   (1-CPM)*(1-FAST),0F7h   
02FB   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02FC   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02FD   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02FE                             ; Backspace takes the last character back (and is echoed as
02FE                             ; it is), CR ends (stored, not echoed), every other key is stored and
02FE                             ; echoed until the line is full. The line buffer starts at offset 80h
02FE                             ; of its page, so L alone is the place in the line: D holds the L of
02FE                             ; a full line.
02FE   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
0301   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
0302   9F                     SBB   A   
0303   A5                     ANA   L   ; (0 for a count that is too big)
0304   2F                     CMA      
0305   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
0306                             ;   at most
0306   21 80 0B               LXI   H,LINEBUF   
0309   CD C3 05     LN2:      CALL   getk   
030C   CA 09 03               JZ   ln2   
030F   FE 0D                  CPI   13   
0311   CA 30 03               JZ   ln5   
0314   FE 08                  CPI   8   
0316   CA 28 03               JZ   ln4   
0319   5F                     MOV   E,A   
031A   7D                     MOV   A,L   
031B   BA                     CMP   D   
031C   CA 09 03               JZ   ln2   ; full
031F   73                     MOV   M,E   
0320   2C                     INR   L   
0321   7B                     MOV   A,E   
0322                          ;*Macro unroll: ln3:    PUTA
0322                LN3:      DS   1-CPM,0EFh   
0322   CD                     DS   CPM,0CDh   
0323   FD                     DS   CPM,APUT&0FFh   
0324   05                     DS   CPM,APUT/256   
0325   C3 09 03               JMP   ln2   
0328   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0329   FA 22 03               JM   ln3   ;   unless the line was empty (L left the
032C   2C                     INR   L   ;   upper half of the page)
032D   C3 09 03               JMP   ln2   
0330   77           LN5:      MOV   M,A   ; the CR
0331   2E 80                  MVI   L,LINEBUF & 0FFh   
0333                          ;*Macro unroll:  NEXT
0333                          DS   (1-CPM)*(1-FAST),0F7h   
0333   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0334   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0335   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0336                             ; =============================================================================
0336                             ;  Dispatch table: the low byte of each handler's address, in code order.
0336                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0336                             ; =============================================================================
0336                             ; The handlers of the first NPG1 characters start in the image's second page.
0336                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0336                             ; differs between the builds, so the count is worked out here.
0336                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0336                          IF   1-FAST   
0336                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0336                PGBRK:    EQU   (h_break-BASE)/256   
0336                PGDEF:    EQU   (h_def-BASE)/256   
0336                PGFET:    EQU   (h_fetch-BASE)/256   
0336                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0336                          ENDIF      
0336                          IF   (1-FAST)*(1-PTLATE)   
0336                PTAB:        
0336                          ;*Macro unroll:  PTABLE
0336   9F                     DB   h_store & 0FFh   
0337   B1                     DB   h_str & 0FFh   
0338   CE                     DB   h_num & 0FFh   
0339   BE                     DB   h_print & 0FFh   
033A   9B                     DB   h_swap & 0FFh   
033B   3E                     DB   h_and & 0FFh   
033C   C7                     DB   h_emit & 0FFh   
033D   1A                     DB   h_open & 0FFh   
033E   26                     DB   h_close & 0FFh   
033F   69                     DB   h_mul & 0FFh   
0340   39                     DB   h_add & 0FFh   
0341   D6                     DB   h_cfetch & 0FFh   
0342   2E                     DB   h_sub & 0FFh   
0343   A9                     DB   h_cstore & 0FFh   
0344   6D                     DB   h_div & 0FFh   
0345   97                     DB   h_dup & 0FFh   
0346   CB                     DB   h_drop & 0FFh   
0347   49                     DB   h_lt & 0FFh   
0348   5A                     DB   h_eq & 0FFh   
0349   48                     DB   h_gt & 0FFh   
034A   DC                     DB   h_key & 0FFh   
034B   13                     DB   h_fetch & 0FFh   
034C   EA                     DB   h_def & 0FFh   
034D   DB                     DB   h_break & 0FFh   
034E   D2                     DB   h_ret & 0FFh   
034F   88                     DB   h_xor & 0FFh   
0350   A3                     DB   h_alloc & 0FFh   
0351   B3                     DB   h_grave & 0FFh   
0352   18                     DB   h_tor & 0FFh   
0353   92                     DB   h_or & 0FFh   
0354   20                     DB   h_fromr & 0FFh   
0355   9C                     DB   h_not & 0FFh   
0356                PTABEND:      
0356                          ENDIF      
0356                             ; =============================================================================
0356                             ;  Routines (no handler starts past this point)
0356                             ; =============================================================================
0356                             ; Digits: step back onto the first digit and read the whole number.
0356   E5           DIGIT:    PUSH   H   
0357   0B                     DCX   B   
0358   CD 68 03               CALL   rdnum   
035B                          ;*Macro unroll:  NEXT
035B                          DS   (1-CPM)*(1-FAST),0F7h   
035B   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
035C   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
035D   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
035E                             ; negnum: "-" directly before a digit: read the number, negate it.
035E   E5           NEGNUM:   PUSH   H   
035F   CD 68 03               CALL   rdnum   
0362                          ;*Macro unroll:  NEGH
0362                          DS   1-CPM,0E7h   
0362   CD                     DS   CPM,0CDh   
0363   27                     DS   CPM,ANEG&0FFh   
0364   01                     DS   CPM,ANEG/256   
0365                          ;*Macro unroll:  NEXT
0365                          DS   (1-CPM)*(1-FAST),0F7h   
0365   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0366   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0367   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0368                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0368                             ; non-digit. Values wrap at 16 bits, as the spec says.
0368   21 00 00     RDNUM:    LXI   H,0   
036B   0A           RDN1:     LDAX   B   
036C   D6 30                  SUI   "0"   
036E   FE 0A                  CPI   10   
0370   D0                     RNC      
0371   03                     INX   B   
0372   54                     MOV   D,H   
0373   5D                     MOV   E,L   
0374   29                     DAD   H   
0375   29                     DAD   H   
0376   19                     DAD   D   
0377   29                     DAD   H   ; HL * 10
0378   5F                     MOV   E,A   
0379   16 00                  MVI   D,0   
037B   19                     DAD   D   
037C   C3 6B 03               JMP   rdn1   
037F                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
037F                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
037F                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
037F                             ; lives on the stack, since A is busy with the shifts.
037F                             ; Dividing by 2 is one shift (the spec wants that fast).
037F   01 00 00     UDIV:     LXI   B,0   
0382                          IF   1-QK   
                              MOV   A,E   
                              XRI   2   
                              ORA   D   
                              JNZ   udv0   
                              ORA   H   ; A was 0, and the carry is clear
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   ; the quotient
                              MOV   A,B   
                              RAL      
                              MOV   C,A   ; the remainder: the bit that fell out
                              RET      
0382                          ENDIF      
0382                          IF   QK   
0382                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0382                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0382   7A                     MOV   A,D   
0383   B7                     ORA   A   
0384   C2 A2 03               JNZ   uq1   ; 256 and up
0387   B3                     ORA   E   
0388   CA B9 03               JZ   udv0   ; by 0: the long way (it means nothing anyway)
038B   3D                     DCR   A   
038C   A3                     ANA   E   
038D   C2 B9 03               JNZ   udv0   ; not a power of two
0390   7B                     MOV   A,E   ; by 2^k below 256: q = HL >> k, and
0391   3D                     DCR   A   ;   r = L & (2^k - 1)
0392   A5                     ANA   L   
0393   4F                     MOV   C,A   
0394                          ENDIF      
0394                          IF   QK*(1-FAST)   
0394   7B           UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
0395   B7                     ORA   A   
0396   1F                     RAR      
0397   D8                     RC      
0398   5F                     MOV   E,A   
0399   7C                     MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
039A   1F                     RAR      
039B   67                     MOV   H,A   
039C   7D                     MOV   A,L   
039D   1F                     RAR      
039E   6F                     MOV   L,A   
039F   C3 94 03               JMP   uq2   
03A2                          ENDIF      
03A2                          IF   FAST   
                                 ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
                                 ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
                    UQ2:      MOV   A,E   
                              CPI   16   
                              JNC   uqh   
                              CPI   2   
                              RC      ; by 1
                              JZ   ur1   
                              CPI   4   
                              JZ   ur2   
                    UR3:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR2:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR1:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              RET      
                    UQH:      CPI   64   
                              MVI   A,0   
                              JZ   ul2   
                              JNC   ul1   
                              MOV   A,E   
                              CPI   32   
                              MVI   A,0   
                              JZ   ul3   
                              DAD   H   ; by 16
                              ADC   A   
                    UL3:      DAD   H   
                              ADC   A   
                    UL2:      DAD   H   
                              ADC   A   
                    UL1:      DAD   H   
                              ADC   A   
                              MOV   L,H   
                              MOV   H,A   
                              RET      
03A2                          ENDIF      
03A2                          IF   QK   
03A2   7B           UQ1:      MOV   A,E   
03A3   B7                     ORA   A   
03A4   C2 B9 03               JNZ   udv0   
03A7   7A                     MOV   A,D   
03A8   3D                     DCR   A   
03A9   A2                     ANA   D   
03AA   C2 B9 03               JNZ   udv0   ; not a power of two
03AD   7A                     MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
03AE   3D                     DCR   A   ;   q = H >> (k - 8)
03AF   A4                     ANA   H   
03B0   47                     MOV   B,A   
03B1   4D                     MOV   C,L   
03B2   6C                     MOV   L,H   
03B3   26 00                  MVI   H,0   
03B5   5A                     MOV   E,D   
03B6   C3 94 03               JMP   uq2   
03B9                          ENDIF      
03B9                          IF   1-FAST   
03B9   3E 10        UDV0:     MVI   A,16   
03BB   F5                     PUSH   PSW   
03BC   29           UDV1:     DAD   H   ; next dividend bit into the carry
03BD   79                     MOV   A,C   
03BE   17                     RAL      
03BF   4F                     MOV   C,A   
03C0   78                     MOV   A,B   
03C1   17                     RAL      
03C2   47                     MOV   B,A   ; BC = BC*2 + bit
03C3   79                     MOV   A,C   
03C4   93                     SUB   E   
03C5   78                     MOV   A,B   
03C6   9A                     SBB   D   ; carry if BC < DE
03C7   DA CF 03               JC   udv2   
03CA   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
03CB   79                     MOV   A,C   
03CC   93                     SUB   E   
03CD   4F                     MOV   C,A   
03CE   2C                     INR   L   ; quotient bit
03CF   F1           UDV2:     POP   PSW   
03D0   3D                     DCR   A   
03D1   F5                     PUSH   PSW   
03D2   C2 BC 03               JNZ   udv1   
03D5   F1                     POP   PSW   
03D6   C9                     RET      
03D7                          ENDIF      
03D7                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
                                 ; starts 8 bits up and takes only the last 8, since its first 8 would only
                                 ; shift zeros)
                    UDV0:     MOV   A,H   
                              ORA   A   
                              JZ   uvs   
                    UV0:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw0   
