E73D                          IF   SBASEU   
                                 ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
                                 ; fetched or stored in the same step (x@ is the commonest pair in most
                                 ; programs). A checked build checks the stacks between the two, so it keeps
                                 ; them apart. (pvar calls lowp, which only pushes.)
                    LOWQ:     ASL      
                              STA   T0   ; the cell's offset in the letter page
                              LDY   #0   
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   lwf   
                              CMP   #"!"   
                              BEQ   lws   
                              LDA   T0   
                              LDY   #>LET   
                              JMP   pushay   ; the address
                    LWF:      JSR   incip   ; x@: TOS = the cell's value
                              LDY   T0   
                              DEX      
                              DEX      
                              LDA   LET,Y   
                              STA   0,X   
                              LDA   LET+1,Y   
                              STA   1,X   
                              RTS      
                    LWS:      JSR   incip   ; x!: the cell = TOS, and it is dropped
                              LDY   T0   
                              LDA   0,X   
                              STA   LET,Y   
                              LDA   1,X   
                              STA   LET+1,Y   
                              INX      
                              INX      
                              RTS      
E73D                          ENDIF      
E73D                          IF   QK   
E73D                             ; The skip cache. Nearly every skip is one that has happened before (a loop
E73D                             ; skips the same false block on every pass), so the first scan from each
E73D                             ; place is remembered: 64 entries of 00bbc3RhcnQsIHRoZSBjbG9zZXIncyBhZGRyZXNz, in CPAGE,
E73D                             ; found by the start's low byte times 4. Only skips that start in the
E73D                             ; program text are kept (the line buffer changes); the cache is emptied when
E73D                             ; the program starts. A program that changes its own text while it runs is
E73D                             ; not looked after. A miss writes the start into its entry at once, and
E73D                             ; keeps the entry's place in the scratch under the top cell, $FE,X (1, which
E73D                             ; no entry has, for a skip that is not kept), so that the end can go in when
E73D                             ; the scan finds it. A scan that fails ends the program, and the next run
E73D                             ; empties the cache, so a half-written entry is never found. (The checked
E73D                             ; build: A holds the wrong closer on the way in, as at the checked skip above.)
E73D                SKIP:        
E73D                          ENDIF      
E73D                          IF   CHECKED*QK   
E73D   85 04                  STA   T0   
E73F                          ENDIF      
E73F                          IF   QK   
E73F   A0 01                  LDY   #1   ; (no entry)
E741   A5 01                  LDA   IP+1   
E743   C9 05                  CMP   #>PROG   
E745   90 2E                  BCC   sks   ; below the program text: no cache
E747   A5 00                  LDA   IP   
E749   0A                     ASL      
E74A   0A                     ASL      
E74B   A8                     TAY      ; Y -> the entry
E74C   A5 00                  LDA   IP   
E74E   D9 00 02               CMP   CPAGE*256,Y   
E751   D0 18                  BNE   skm   
E753   A5 01                  LDA   IP+1   
E755   D9 01 02               CMP   CPAGE*256+1,Y   
E758   D0 11                  BNE   skm   
E75A   B9 02 02               LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
E75D   85 00                  STA   IP   ;   read
E75F   B9 03 02               LDA   CPAGE*256+3,Y   
E762   85 01                  STA   IP+1   
E764   A0 00                  LDY   #0   
E766   B1 00                  LDA   (IP),Y   
E768   4C 83 EB               JMP   incip   
E76B   A5 00        SKM:      LDA   IP   ; a miss: the entry's start now, its end when
E76D   99 00 02               STA   CPAGE*256,Y   ;   the scan has found it
E770   A5 01                  LDA   IP+1   
E772   99 01 02               STA   CPAGE*256+1,Y   
E775   94 FE        SKS:      STY   0FEh,X   ; the entry, or 1 for none
E777   A0 00                  LDY   #0   
E779   84 06                  STY   T2   ; depth
E77B                             ; The scan reads at IP+Y. Most characters are nothing to it, and two range
E77B                             ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
E77B   B1 00        SQ1:      LDA   (IP),Y   
E77D   C8                     INY      
E77E   F0 1D                  BEQ   sqw   
E780   C9 5E        SQ2:      CMP   #5Eh   
E782   B0 F7                  BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E784   C9 5B                  CMP   #5Bh   
E786   B0 2D                  BCS   sqb   ; [ \ ]
E788   C9 2A                  CMP   #2Ah   
E78A   B0 EF                  BCS   sq1   ; * to Z: nothing
E78C   C9 28                  CMP   #28h   
E78E   F0 20                  BEQ   sqo   ; (
E790   B0 29                  BCS   sqc   ; )
E792   C9 22                  CMP   #22h   
E794   F0 0B                  BEQ   sqq   ; a string
E796   C9 01                  CMP   #1   
E798   B0 E1                  BCS   sq1   ; the rest below "(": nothing
E79A                          ENDIF      
E79A                          IF   QK*(1-CHECKED)   
                              JMP   EXIT   ; NUL: the end of the program
E79A                          ENDIF      
E79A                          IF   QK*CHECKED   
E79A   4C 4A EA               JMP   sknul   
E79D                          ENDIF      
E79D                          IF   QK   
E79D   E6 01        SQW:      INC   IP+1   ; Y went round: on into the next page
E79F   D0 DF                  BNE   sq2   ; always
E7A1   20 E1 E7     SQQ:      JSR   sqip   ; a string: step over it
E7A4   20 7E E2               JSR   skipstr   
E7A7                          ENDIF      
E7A7                          IF   QK*CHECKED   
E7A7   D0 03                  BNE   sqq1   
E7A9   4C 4A EA               JMP   sknul   ; the string ran into the end
E7AC                SQQ1:        
E7AC                          ENDIF      
E7AC                          IF   QK   
E7AC   A0 00                  LDY   #0   
E7AE   F0 CB                  BEQ   sq1   ; always
E7B0   E6 06        SQO:      INC   T2   ; an opener
E7B2   4C 7B E7               JMP   sq1   
E7B5   C9 5C        SQB:      CMP   #5Ch   
E7B7   F0 C2                  BEQ   sq1   ; "\" is nothing here
E7B9   90 F5                  BCC   sqo   ; [
E7BB   C6 06        SQC:      DEC   T2   ; ) ]
E7BD   10 BC                  BPL   sq1   
E7BF   20 E1 E7               JSR   sqip   ; the closer at this level: the IP past it
E7C2                          ENDIF      
E7C2                          IF   QK*CHECKED   
E7C2   C5 04                  CMP   T0   
E7C4   D0 03                  BNE   sqc1   
