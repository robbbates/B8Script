0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three. (asm80 wants the vector number: RST 1 = RST 08h.)
0000                             ; 
0000                             ;    RST 1  08h  rpop    pop the return stack into HL
0000                             ;    RST 3  18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 4  20h  neg16   HL = -HL
0000                             ;    RST 5  28h  putc    print A
0000                             ;    RST 6  30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block has no jumps inside itself, so it works at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    EXIT:     EQU   0000h   ; warm boot
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with ORA A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve BC, DE and HL.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   1-(1-CPM)*CHECKED   
0000   31 FC 81               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003                          ENDIF      
0003   C3 F1 02               JMP   start   ; In the checked generic build this is at 0000h
0006                             ;   (and `start` sets SP): its first byte, C3h,
0006                             ;   is what an undefined word runs into, as
0006                             ;   CP/M's own JMP at 0000h is in a .COM: e_hi.
0006                          IF   (1-CPM)*CHECKED   
                              DB   0,0,0   ; 03  spare
0006                          ENDIF      
0006   CF           RDROP:    RST   1   ; 06  drop the top of the return stack, then
0007   DF                     RST   3   ;     drop TOS (a spent flag) and go on
0008                VECS:        
0008                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
0008   2A 34 82     RPOP:     LHLD   RSP   ; 08
000B   5E                     MOV   E,M   
000C   23                     INX   H   
000D   56                     MOV   D,M   
000E   23                     INX   H   
000F   22 34 82               SHLD   RSP   
0012   EB                     XCHG      
0013   C9                     RET      ; 13  (so RST 2 is not used)
0014   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0015   C3 AA 00               JMP   rpushd   ;     brings up the new TOS
0018                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
0018   D1           RST18:    POP   D   ; 18  discard the RST's return address
0019   E1                     POP   H   ;     new TOS = NOS
001A   C3 31 00               JMP   next0   
001D   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
001E   CF                     RST   1   
001F   F7                     RST   6   
0020                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0020   AF           NEG16:    XRA   A   ; 20
0021   95                     SUB   L   
0022   6F                     MOV   L,A   
0023   9F                     SBB   A   
0024   94                     SUB   H   
0025   67                     MOV   H,A   
0026   C9                     RET      
0027   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
0028                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JMP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JMP   putc   ; 28
002B                          ENDIF      
002B                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
002B                             ; returns here, with its top cell on the stack: that becomes the new TOS.
002B   CD 27 00     EXEC:     CALL   jphl   ; 2B
002E   E1                     POP   H   
002F   F7                     RST   6   
0030                             ; ---- RST 6: next character --------------------------------------------------
0030   D1           RST30:    POP   D   ; 30  discard the RST's return address
0031                          IF   CPM   
                              JMP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LDAX   B   
0032   03                     INX   B   
0033   D6 21                  SUI   21h   ; A = c - 21h
0035   DA 74 00               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
0038   FE 0F                  CPI   0Fh   
003A   DA 65 00               JC   punct   ; 21h-2Fh: PTAB index 0-14
003D   D6 0F                  SUI   0Fh   ; A = c - 30h
003F   FE 0A                  CPI   0Ah   
0041   DA 3A 02               JC   digit   ; 30h-39h
0044   FE 11                  CPI   11h   
0046   DA 63 00               JC   p3a   ; 3Ah-40h
0049   D6 11                  SUI   11h   ; A = c - 41h
004B   FE 1A                  CPI   1Ah   
004D   DA A0 00               JC   upper   ; 41h-5Ah: A = letter index 0-25
0050   FE 20                  CPI   20h   
0052   DA 61 00               JC   p5b   ; 5Bh-60h
0055   FE 3A                  CPI   3Ah   
0057   DA 9A 00               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
005A   FE 3E                  CPI   3Eh   
005C                          IF   CHECKED   
                              JZ   next0   ; 7Fh, DEL: ignored
                              JNC   e_hi   ; 80h-FFh: reserved
005C                          ENDIF      
005C                          IF   1-CHECKED   
005C   D2 31 00               JNC   next0   ; 7Fh-FFh: ignored
005F                          ENDIF      
005F   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0061   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
0063   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
0065                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0065                             ; untouched, and A, DE free.
0065   C6 1A        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
0067   5F                     MOV   E,A   
0068   16 02                  MVI   D,PTAB / 256   
006A   FE 30                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006C   1A                     LDAX   D   
006D   5F                     MOV   E,A   ; the handler's low byte
006E                          IFN   CPM   
006E   3E 00                  MVI   A,0   
0070   17                     RAL      ; its page: 0 + carry
0071                          ENDIF      
0071                          IF   CPM   
                              MVI   A,1   
                              ACI   0   ; its page: 1 + carry
0071                          ENDIF      
0071   57                     MOV   D,A   
0072   D5                     PUSH   D   ; jump to it; the stack is balanced again
0073   C9                     RET      ;   when the handler starts
0074                             ; ctl: characters below 21h. A = c - 21h.
0074   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
0076   C2 31 00               JNZ   next0   ; the rest are ignored
0079   C3 09 FF     ENDPROG:   JMP   EXIT   ; the program has ended
007C                             ; =============================================================================
007C                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
007C                             ;  (00bbIGFuZCA= are up among the RST routines.)
007C                             ; =============================================================================
007C   D1           H_XOR:    POP   D   
007D   7C                     MOV   A,H   
007E   AA                     XRA   D   
007F   67                     MOV   H,A   
0080   7D                     MOV   A,L   
0081   AB                     XRA   E   
0082   6F                     MOV   L,A   
0083   F7                     RST   6   
0084   D1           H_OR:     POP   D   
0085   7C                     MOV   A,H   
0086   B2                     ORA   D   
0087   67                     MOV   H,A   
0088   7D                     MOV   A,L   
0089   B3                     ORA   E   
008A   6F                     MOV   L,A   
008B   F7                     RST   6   
008C   E7           H_NOT:    RST   4   ; ~x = -x - 1
008D   2B                     DCX   H   
008E   F7                     RST   6   
008F                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
008F                             ; the same either way); TOS is the old pointer.
008F   EB           H_ALLOC:   XCHG      
0090   2A 7C 82               LHLD   HEAP   
0093   E5                     PUSH   H   
0094   19                     DAD   D   ; the new top
0095                          IF   CHECKED   
                              CALL   chkhp   
0095                          ENDIF      
0095   22 7C 82               SHLD   HEAP   
0098   E1                     POP   H   
0099   F7                     RST   6   
009A                             ; ---- the letters and digits --------------------------------------------------
009A                             ; a-z: push the cell's address (the cell is the variable)
009A   E5           LOWER:    PUSH   H   
009B   87                     ADD   A   
009C   6F                     MOV   L,A   
009D   26 82                  MVI   H,LETPAGE   
009F   F7                     RST   6   
00A0                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00A0                             ; the return stack, and the IP becomes the address in the letter's cell.
00A0   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
00A1   87                     ADD   A   
00A2   6F                     MOV   L,A   
00A3   26 82                  MVI   H,LETPAGE   ; HL -> cell
00A5   50                     MOV   D,B   
00A6   59                     MOV   E,C   ; DE = the return address
00A7   4E                     MOV   C,M   
00A8   23                     INX   H   
00A9   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
00AA                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
00AA                             ; go on. Every push of the return stack ends here: for a word call the cell
00AA                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
00AA                             ; the one that was used up.
00AA                RPUSHD:      
00AA                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every word call, block
00AA                          ENDIF      ;   entry, loop-back and "{"
00AA   2A 34 82               LHLD   RSP   
00AD   2B                     DCX   H   
00AE   72                     MOV   M,D   
00AF   2B                     DCX   H   
00B0   73                     MOV   M,E   
00B1   22 34 82               SHLD   RSP   
00B4   E1                     POP   H   
00B5   F7                     RST   6   
00B6                             ; ---- machine code: the grave -----------------------------------------------
00B6                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00B6                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00B6                             ; written and its address is left. An odd last digit is consumed and dropped.
00B6                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00B6                             ; code is entered by CALL with the data stack above the return address; it
00B6                             ; must keep BC, and on return the top cell becomes the new TOS.
00B6   CD DE 02     H_GRAVE:   CALL   hexc   
00B9   D2 2B 00               JNC   exec   
00BC   87           HX1:      ADD   A   
00BD   87                     ADD   A   
00BE   87                     ADD   A   
00BF   87                     ADD   A   
00C0   57                     MOV   D,A   ; the high digit
00C1   CD DE 02               CALL   hexc   
00C4   D2 D0 00               JNC   hx2   ; odd digit: consumed and dropped
00C7   B2                     ORA   D   
00C8   77                     MOV   M,A   
00C9   23                     INX   H   
00CA   CD DE 02               CALL   hexc   
00CD   DA BC 00               JC   hx1   
00D0   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
00D2   F7                     RST   6   
00D3                             ; ---- where the two pages meet ----------------------------------------------
00D3                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00D3                             ; are in falling code order for this), and where exactly differs between the
00D3                             ; builds: NPG1 follows. Every handler below these four must start in the
00D3                             ; second page, and every one above in the first; chktab.py checks both.
00D3                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
00D3                             ; while rpop uses HL, and the drop at the end brings it back.
00D3   E5           H_RET:    PUSH   H   
00D4   CF           RET2:     RST   1   
00D5   44                     MOV   B,H   
00D6   4D                     MOV   C,L   
00D7   DF                     RST   3   
00D8                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00D8                             ; drops the block start, "]" returns. No closer at all ends the program.
00D8                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
00D8   7C           H_BREAK:   MOV   A,H   
00D9   B5                     ORA   L   
00DA   CA BD 01               JZ   h_drop   ; false: just drop the flag
00DD   CD AA 02               CALL   skip   
00E0   B7                     ORA   A   ; skip returns 0 for ")"
00E1   C2 D4 00               JNZ   ret2   
00E4   C3 06 00               JMP   rdrop   
00E7                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00E7                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00E7                             ; the body"s address instead. Either way it then skips to the matching "]'.
00E7                             ; (The unchecked build takes anything that is not a letter as the space; the
00E7                             ; checked build stops on it.)
00E7   0A           H_DEF:    LDAX   B   
00E8   03                     INX   B   
00E9   D6 41                  SUI   "A"   ; a letter gives 0-25 or 32-57: lowercase
00EB   5F                     MOV   E,A   ;   lands 64 bytes up
00EC   E6 DF                  ANI   0DFh   ; fold case
00EE   FE 1A                  CPI   26   
00F0   D2 00 01               JNC   def2   ; not a letter
00F3   7B                     MOV   A,E   
00F4   87                     ADD   A   
00F5   5F                     MOV   E,A   
00F6   16 82                  MVI   D,LETPAGE   ; DE -> cell
00F8   79                     MOV   A,C   
00F9   12                     STAX   D   
00FA   1C                     INR   E   
00FB   78                     MOV   A,B   
00FC   12                     STAX   D   
00FD   C3 03 01               JMP   skipnx   
0100                DEF2:        
0100                          IF   CHECKED   
                              MOV   A,E   
                              CPI   " "-"A"+256   
                              JNZ   e_brack   ; anything but a letter or a space
0100                          ENDIF      
0100   E5                     PUSH   H   ; an anonymous block: push its address
0101   60                     MOV   H,B   
0102   69                     MOV   L,C   
0103                SKIPNX:      
0103                          IF   CHECKED   
                              DCX   B   ; back onto the letter, so that skip finds its
0103                          ENDIF      ;   opener, the "[", just before where it starts
0103   CD AA 02     SKIPO:    CALL   skip   
0106   F7                     RST   6   
0107   5E           H_FETCH:   MOV   E,M   ; "@"
0108   23                     INX   H   
0109   56                     MOV   D,M   
010A   EB                     XCHG      
010B   F7                     RST   6   
010C                             ; =============================================================================
010C                             ;  Handlers that must start in the image's second page.
010C                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
010C                             ;  tail may run past that page.
010C                             ; =============================================================================
010C                             ; ---- flow control ----------------------------------------------------------
010C                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
010C                             ; the matching ")".
010C   7C           H_OPEN:   MOV   A,H   
010D   B5                     ORA   L   
010E   E1                     POP   H   
010F   CA 03 01               JZ   skipo   
0112   E5                     PUSH   H   ; (rpushd pops it again)
0113   50                     MOV   D,B   
0114   59                     MOV   E,C   ; the block starts at the IP
0115   C3 AA 00               JMP   rpushd   
0118                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0118                             ; drops it and carries on.
0118   7C           H_CLOSE:   MOV   A,H   
0119   B5                     ORA   L   
011A   CA 06 00               JZ   rdrop   
011D   CF                     RST   1   ; pop the block start ...
011E   44                     MOV   B,H   
011F   4D                     MOV   C,L   ; ... jump to it ...
0120   EB                     XCHG      
0121   C3 AA 00               JMP   rpushd   ; ... and push it back (which drops the flag)
0124                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0124                             ; "-" has two jobs: directly before a digit it starts a negative number.
0124   0A           H_SUB:    LDAX   B   
0125   D6 30                  SUI   "0"   
0127   FE 0A                  CPI   10   
0129   DA 40 02               JC   negnum   
012C   E7                     RST   4   ; a - b = a + (-b): fall into "+"
012D   D1           H_ADD:    POP   D   
012E   19                     DAD   D   
012F   F7                     RST   6   
0130   D1           H_AND:    POP   D   
0131   7C                     MOV   A,H   
0132   A2                     ANA   D   
0133   67                     MOV   H,A   
0134   7D                     MOV   A,L   
0135   A3                     ANA   E   
0136   6F                     MOV   L,A   
0137   F7                     RST   6   
0138                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0138                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0138                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0138                             ; SBB A turns a carry into -1 or 0 with no branch.
0138   E3           H_GT:     XTHL      ; a > b  is  b < a
0139   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
013A   7B                     MOV   A,E   
013B   95                     SUB   L   
013C   7A                     MOV   A,D   
013D   9C                     SBB   H   
013E   9F                     SBB   A   ; A = -1 if DE < HL unsigned
013F   6F                     MOV   L,A   
0140   7C                     MOV   A,H   
0141   AA                     XRA   D   
0142   17                     RAL      ; carry = the signs differ
0143   9F                     SBB   A   
0144   AD                     XRA   L   ; flip when they do
0145   67                     MOV   H,A   
0146   6F                     MOV   L,A   
0147   F7                     RST   6   
0148   D1           H_EQ:     POP   D   
0149   7D                     MOV   A,L   
014A   AB                     XRA   E   
014B   6F                     MOV   L,A   
014C   7C                     MOV   A,H   
014D   AA                     XRA   D   
014E   B5                     ORA   L   ; zero if equal
014F   D6 01                  SUI   1   ; carry only for zero
0151   9F                     SBB   A   
0152   67                     MOV   H,A   
0153   6F                     MOV   L,A   
0154   F7                     RST   6   
0155                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0155                             ; multiplier is used up; only the low 16 bits are kept.
0155   D1           H_MUL:    POP   D   ; DE = multiplicand
0156   C5                     PUSH   B   
0157   44                     MOV   B,H   
0158   4D                     MOV   C,L   ; BC = multiplier
0159   21 00 00               LXI   H,0   
015C   78           MUL1:     MOV   A,B   
015D   B7                     ORA   A   ; clear carry
015E   1F                     RAR      
015F   47                     MOV   B,A   
0160   79                     MOV   A,C   
0161   1F                     RAR      
0162   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0163   D2 67 01               JNC   mul2   
0166   19                     DAD   D   
0167   EB           MUL2:     XCHG      
0168   29                     DAD   H   ; multiplicand << 1
0169   EB                     XCHG      
016A   78                     MOV   A,B   
016B   B1                     ORA   C   
016C   C2 5C 01               JNZ   mul1   
016F   C1                     POP   B   
0170   F7                     RST   6   
0171                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0171                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0171                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0171                             ; stops on it.
0171                H_DIV:       
0171                          IF   CHECKED   
                              MOV   A,H   
                              ORA   L   
                              JZ   e_zero   
0171                          ENDIF      
0171   D1                     POP   D   ; DE = a, HL = b
0172   C5                     PUSH   B   
0173   7A                     MOV   A,D   
0174   B7                     ORA   A   
0175   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0176   AC                     XRA   H   
0177   F5                     PUSH   PSW   ; S flag = sign of q
0178   7C                     MOV   A,H   
0179   B7                     ORA   A   
017A   FC 20 00               CM   neg16   ; HL = |b|
017D   EB                     XCHG      
017E   7C                     MOV   A,H   
017F   B7                     ORA   A   
0180   FC 20 00               CM   neg16   ; HL = |a|, DE = |b|
0183   CD 5D 02               CALL   udiv   ; HL = q, BC = r
0186   F1                     POP   PSW   
0187   FC 20 00               CM   neg16   ; q's sign
018A   EB                     XCHG      ; DE = q
018B   60                     MOV   H,B   
018C   69                     MOV   L,C   ; HL = r
018D   F1                     POP   PSW   
018E   FC 20 00               CM   neg16   ; r's sign
0191   C1                     POP   B   
0192   D5                     PUSH   D   ; q under r
0193   F7                     RST   6   
0194                             ; ---- stack and storage -----------------------------------------------------
0194   E5           H_DUP:    PUSH   H   ; ":"
0195   F7                     RST   6   
0196   E3           H_SWAP:   XTHL      ; "%"
0197   F7                     RST   6   
0198                             ; (The checked build tests the address before it takes the value off the
0198                             ; stack, so that an error report shows both.)
0198                H_STORE:      ; "!" ( n addr -- )
0198                          IF   CHECKED   
                              CALL   chkst   
0198                          ENDIF      
0198   D1                     POP   D   
0199   73                     MOV   M,E   
019A   23                     INX   H   
019B   72                     MOV   M,D   
019C   DF                     RST   3   
019D                H_CSTORE:      ; "." ( c addr -- )
019D                          IF   CHECKED   
                              CALL   chkst   
019D                          ENDIF      
019D   D1                     POP   D   
019E   73                     MOV   M,E   
019F   DF                     RST   3   
01A0                             ; ---- console ---------------------------------------------------------------
01A0                             ; 22h pushes the address of the text after it and skips the string.
01A0   E5           H_STR:    PUSH   H   
01A1   60                     MOV   H,B   
01A2   69                     MOV   L,C   
01A3   CD D1 02               CALL   skipstr   
01A6                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
01A6                          ENDIF      
01A6   F7                     RST   6   
01A7                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01A7                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01A7                             ; bit 6, so // and /" give themselves).
01A7                          IF   1-CHECKED   
01A7   7E           H_PRINT:   MOV   A,M   
01A8   23                     INX   H   
01A9   FE 22                  CPI   22h   
01AB   CA BD 01               JZ   h_drop   
01AE   FE 2F                  CPI   "/"   
01B0   C2 B7 01               JNZ   pr1   
01B3   7E                     MOV   A,M   
01B4   23                     INX   H   
01B5   E6 BF                  ANI   0BFh   
01B7   EF           PR1:      RST   5   
01B8   C3 A7 01               JMP   h_print   
01BB                          ENDIF      
01BB                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   H   
                              CALL   prstr   
                              POP   D   
                              RST   3   
01BB                          ENDIF      
01BB   7D           H_EMIT:   MOV   A,L   ; "'"
01BC   EF                     RST   5   
01BD   DF           H_DROP:   RST   3   ; ";" is this one byte
01BE                             ; "#" prints TOS as a signed decimal number, with no space after it.
01BE   C5           H_NUM:    PUSH   B   
01BF   CD 8F 02               CALL   psgn   
01C2   C1                     POP   B   
01C3   DF                     RST   3   
01C4                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              RST   6   
01C4                          ENDIF      
01C4                             ; "?" ( n -- c ) or ( -n -- addr )
01C4                             ;   n > 0: wait about n ms for a key; 0 if none came
01C4                             ;   n = 0: wait for a key
01C4                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C4                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C4   7C           H_KEY:    MOV   A,H   
01C5   B7                     ORA   A   
01C6   FA E6 01               JM   line   
01C9   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
01CB   CD 06 FF     KT2:      CALL   getk   
01CE   C2 E2 01               JNZ   kt3   
01D1   1D                     DCR   E   
01D2   C2 CB 01               JNZ   kt2   
01D5   7C                     MOV   A,H   ; 0? never counts down: it waits
01D6   B5                     ORA   L   
01D7   CA C9 01               JZ   kt1   
01DA   2B                     DCX   H   
01DB   7C                     MOV   A,H   
01DC   B5                     ORA   L   
01DD   C2 C9 01               JNZ   kt1   ; A = 0 if the time ran out
01E0                          IF   1-CHECKED   
01E0   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
01E1   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01E2                          ENDIF      
01E2   6F           KT3:      MOV   L,A   
01E3   26 00                  MVI   H,0   
01E5   F7                     RST   6   
01E6                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
                              DAD   D   ;   only for 1 to 127, and leaves 127 - count
                              SBB   A   
                              ANA   L   ; (0 for a count that is too big)
                              XRI   127   ; A = the count, 127 at most
                              STA   LBHDR   
                              PUSH   B   
                              LXI   D,LBHDR   
                              MVI   C,10   
                              CALL   BDOS   
                              POP   B   
                              LXI   H,LBHDR+1   
                              MOV   A,M   ; the count typed (0-127)
                              INR   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   L   ;   adding the count to L can't carry
                              MOV   L,A   
                              MVI   M,13   
                              MVI   L,LINEBUF & 0FFh   
                              RST   6   
01E6                          ENDIF      
01E6                          IFN   CPM   
01E6                             ; Generic: Backspace takes the last character back (and is echoed as
01E6                             ; it is), CR ends (stored, not echoed), every other key is stored and
01E6                             ; echoed until the line is full. The line buffer starts at offset 80h
01E6                             ; of its page, so L alone is the place in the line: D holds the L of
01E6                             ; a full line.
01E6   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
01E9   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
01EA   9F                     SBB   A   
01EB   A5                     ANA   L   ; (0 for a count that is too big)
01EC   2F                     CMA      
01ED   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
01EE                             ;   at most
01EE   21 80 82               LXI   H,LINEBUF   
01F1   CD 06 FF     LN2:      CALL   getk   
01F4   CA F1 01               JZ   ln2   
01F7   FE 0D                  CPI   13   
01F9   CA 16 02               JZ   ln5   
01FC   FE 08                  CPI   8   
01FE   CA 0E 02               JZ   ln4   
0201   5F                     MOV   E,A   
0202   7D                     MOV   A,L   
0203   BA                     CMP   D   
0204   CA F1 01               JZ   ln2   ; full
0207   73                     MOV   M,E   
0208   2C                     INR   L   
0209   7B                     MOV   A,E   
020A   EF           LN3:      RST   5   
020B   C3 F1 01               JMP   ln2   
020E   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
020F   FA 0A 02               JM   ln3   ;   unless the line was empty (L left the
0212   2C                     INR   L   ;   upper half of the page)
0213   C3 F1 01               JMP   ln2   
0216   77           LN5:      MOV   M,A   ; the CR
0217   2E 80                  MVI   L,LINEBUF & 0FFh   
0219   F7                     RST   6   
021A                          ENDIF      
021A                             ; =============================================================================
021A                             ;  Dispatch table: the low byte of each handler's address, in code order.
021A                             ;  It must not cross a page (the dispatcher only adds to its low byte).
021A                             ; =============================================================================
021A                             ; The handlers of the first NPG1 characters start in the image's second page.
021A                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
021A                             ; differs between the builds, so the count is worked out here.
021A                             ; (One division to a line: asm80 only rounds down when it stores a value.)
021A                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
021A                PGBRK:    EQU   (h_break-BASE)/256   
021A                PGDEF:    EQU   (h_def-BASE)/256   
021A                PGFET:    EQU   (h_fetch-BASE)/256   
021A                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
021A   98           PTAB:     DB   h_store & 0FFh   ; !
021B   A0                     DB   h_str & 0FFh   ; "
021C   BE                     DB   h_num & 0FFh   ; #
021D   A7                     DB   h_print & 0FFh   ; $
021E   96                     DB   h_swap & 0FFh   ; %
021F   30                     DB   h_and & 0FFh   ; &
0220   BB                     DB   h_emit & 0FFh   ; '
0221   0C                     DB   h_open & 0FFh   ; (
0222   18                     DB   h_close & 0FFh   ; )
0223   55                     DB   h_mul & 0FFh   ; *
0224   2D                     DB   h_add & 0FFh   ; +
0225   E1                     DB   h_cfetch & 0FFh   ; ,
0226   24                     DB   h_sub & 0FFh   ; -
0227   9D                     DB   h_cstore & 0FFh   ; .
0228   71                     DB   h_div & 0FFh   ; /
0229   94                     DB   h_dup & 0FFh   ; :
022A   BD                     DB   h_drop & 0FFh   ; ;
022B   39                     DB   h_lt & 0FFh   ; <
022C   48                     DB   h_eq & 0FFh   ; =
022D   38                     DB   h_gt & 0FFh   ; >
022E   C4                     DB   h_key & 0FFh   ; ?
022F   07                     DB   h_fetch & 0FFh   ; @
0230   E7                     DB   h_def & 0FFh   ; [
0231   D8                     DB   h_break & 0FFh   ; \
0232   D3                     DB   h_ret & 0FFh   ; ]
0233   7C                     DB   h_xor & 0FFh   ; ^
0234   8F                     DB   h_alloc & 0FFh   ; _
0235   B6                     DB   h_grave & 0FFh   ; `
0236   14                     DB   h_tor & 0FFh   ; {
0237   84                     DB   h_or & 0FFh   ; |
0238   1D                     DB   h_fromr & 0FFh   ; }
0239   8C                     DB   h_not & 0FFh   ; ~
023A                PTABEND:      
023A                             ; =============================================================================
023A                             ;  Routines (no handler starts past this point)
023A                             ; =============================================================================
023A                             ; Digits: step back onto the first digit and read the whole number.
023A   E5           DIGIT:    PUSH   H   
023B   0B                     DCX   B   
023C   CD 46 02               CALL   rdnum   
023F   F7                     RST   6   
0240                             ; negnum: "-" directly before a digit: read the number, negate it.
0240   E5           NEGNUM:   PUSH   H   
0241   CD 46 02               CALL   rdnum   
0244   E7                     RST   4   
0245   F7                     RST   6   
0246                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0246                             ; non-digit. Values wrap at 16 bits, as the spec says.
0246   21 00 00     RDNUM:    LXI   H,0   
0249   0A           RDN1:     LDAX   B   
024A   D6 30                  SUI   "0"   
024C   FE 0A                  CPI   10   
024E   D0                     RNC      
024F   03                     INX   B   
0250   54                     MOV   D,H   
0251   5D                     MOV   E,L   
0252   29                     DAD   H   
0253   29                     DAD   H   
0254   19                     DAD   D   
0255   29                     DAD   H   ; HL * 10
0256   5F                     MOV   E,A   
0257   16 00                  MVI   D,0   
0259   19                     DAD   D   
025A   C3 49 02               JMP   rdn1   
025D                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
025D                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
025D                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
025D                             ; lives on the stack, since A is busy with the shifts.
025D                             ; Dividing by 2 is one shift (the spec wants that fast).
025D   01 00 00     UDIV:     LXI   B,0   
0260   7B                     MOV   A,E   
0261   EE 02                  XRI   2   
0263   B2                     ORA   D   
0264   C2 71 02               JNZ   udv0   
0267   B4                     ORA   H   ; A was 0, and the carry is clear
0268   1F                     RAR      
0269   67                     MOV   H,A   
026A   7D                     MOV   A,L   
026B   1F                     RAR      
026C   6F                     MOV   L,A   ; the quotient
026D   78                     MOV   A,B   
026E   17                     RAL      
026F   4F                     MOV   C,A   ; the remainder: the bit that fell out
0270   C9                     RET      
0271   3E 10        UDV0:     MVI   A,16   
0273   F5                     PUSH   PSW   
0274   29           UDV1:     DAD   H   ; next dividend bit into the carry
0275   79                     MOV   A,C   
0276   17                     RAL      
0277   4F                     MOV   C,A   
0278   78                     MOV   A,B   
0279   17                     RAL      
027A   47                     MOV   B,A   ; BC = BC*2 + bit
027B   79                     MOV   A,C   
027C   93                     SUB   E   
027D   78                     MOV   A,B   
027E   9A                     SBB   D   ; carry if BC < DE
027F   DA 87 02               JC   udv2   
0282   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0283   79                     MOV   A,C   
0284   93                     SUB   E   
0285   4F                     MOV   C,A   
0286   2C                     INR   L   ; quotient bit
0287   F1           UDV2:     POP   PSW   
0288   3D                     DCR   A   
0289   F5                     PUSH   PSW   
028A   C2 74 02               JNZ   udv1   
028D   F1                     POP   PSW   
028E   C9                     RET      
028F                             ; psgn: print HL as a signed number. Uses BC.
028F   7C           PSGN:     MOV   A,H   
0290   B7                     ORA   A   
0291   F2 98 02               JP   pdec   
0294   3E 2D                  MVI   A,"-"   
0296   EF                     RST   5   
0297   E7                     RST   4   
0298                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0298                             ; Uses BC.
0298   11 0A 00     PDEC:     LXI   D,10   
029B   CD 5D 02               CALL   udiv   ; HL = HL / 10, C = the last digit
029E   79                     MOV   A,C   
029F   F5                     PUSH   PSW   
02A0   7C                     MOV   A,H   
02A1   B5                     ORA   L   
02A2   C4 98 02               CNZ   pdec   
02A5   F1                     POP   PSW   
02A6   C6 30                  ADI   "0"   
02A8   EF                     RST   5   
02A9   C9                     RET      
02AA                             ; skip: read past text to the closer at this level, and return A = 0 if it
02AA                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02AA                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02AA                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02AA                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02AA                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
02AA                             ; 
02AA                             ; The checked build also looks at the character the skip was started by,
02AA                             ; which is always the one just before where it starts: "(" must end at ")",
02AA                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02AA                             ; quote counts as running into it. "\" takes either closer. The place where
02AA                             ; the skip started is kept on the stack, for the report.
02AA                SKIP:        
02AA                          IF   CHECKED   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
02AA                          ENDIF      
02AA   16 00                  MVI   D,0   
02AC   14           SK3:      INR   D   ; an opener: one deeper
02AD   0A           SK1:      LDAX   B   
02AE                          IF   1-CHECKED   
02AE   03                     INX   B   
02AF   B7                     ORA   A   
02B0   CA 79 00               JZ   endprog   
02B3                          ENDIF      
02B3                          IF   CHECKED   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
02B3                          ENDIF      
02B3   FE 22                  CPI   22h   
02B5   CC D1 02               CZ   skipstr   ; leaves A = 22h, which matches nothing below
02B8   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
02BA   CA AC 02               JZ   sk3   
02BD   3D                     DCR   A   ; ")"
02BE   CA CB 02               JZ   sk4   
02C1   D6 32                  SUI   "["-")"   
02C3   CA AC 02               JZ   sk3   
02C6   FE 02                  CPI   "]"-"["   
02C8   C2 AD 02               JNZ   sk1   
02CB   15           SK4:      DCR   D   
02CC                          IF   1-CHECKED   
02CC   C8                     RZ      ; the closer at this level
02CD   C3 AD 02               JMP   sk1   
02D0                          ENDIF      
02D0                          IF   CHECKED   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
02D0                          ENDIF      
02D0                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02D0                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02D0                          IF   1-CHECKED   
02D0   03           SS0:      INX   B   
02D1   0A           SKIPSTR:   LDAX   B   
02D2   03                     INX   B   
02D3   FE 2F                  CPI   "/"   
02D5   CA D0 02               JZ   ss0   
02D8   FE 22                  CPI   22h   
02DA   C2 D1 02               JNZ   skipstr   
02DD   C9                     RET      
02DE                          ENDIF      
02DE                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
02DE                          ENDIF      
02DE                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02DE                             ; and return its value in A with the carry set; otherwise leave the IP and
02DE                             ; return with the carry clear.
02DE   0A           HEXC:     LDAX   B   
02DF   D6 30                  SUI   "0"   
02E1   FE 0A                  CPI   10   
02E3   DA EF 02               JC   hc1   
02E6   E6 DF                  ANI   0DFh   
02E8   D6 11                  SUI   11h   
02EA   FE 06                  CPI   6   
02EC   D0                     RNC      
02ED   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
02EF   03           HC1:      INX   B   
02F0   C9                     RET      
02F1                             ; =============================================================================
02F1                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02F1                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 5) prints A.
02F1                             ;  Both keep BC, DE and HL. In the generic build they are the host's KEY and
02F1                             ;  CONOUT routines themselves.
02F1                             ; =============================================================================
02F1                          IF   (1-CPM)*(1-CHECKED)   
02F1                GETK:     EQU   KEY   ; the host's routine does the whole job
02F1                          ENDIF      
02F1                          IF   CHECKED   
                    GETK:     PUSH   H   ; a key held back by the break check goes
                              LXI   H,KEYBUF   ;   first, and is taken out of the buffer
                              MOV   A,M   
                              MVI   M,0   
                              POP   H   
                              ORA   A   
                              RNZ      
02F1                          ENDIF      
02F1                          IF   (1-CPM)*CHECKED   
                              JMP   KEY   
02F1                          ENDIF      
02F1                          IF   CPM*(1-CHECKED)   
                    GETK:        
02F1                          ENDIF      
02F1                          IF   CPM   
                              MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
02F1                          ENDIF      
02F1                             ; =============================================================================
02F1                             ;  Checked build: the checks and the error report
02F1                             ; =============================================================================
02F1                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
02F1                          ENDIF      
02F1                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
02F1                          ENDIF      
02F1                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
02F1                          ENDIF      
02F1                          IF   CHECKED   
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              JMP   errp   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
02F1                          ENDIF      
02F1                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
02F1                          ENDIF      
02F1                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
02F1                          ENDIF      
02F1                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address and the old
                              MVI   A,"H"   ;   top
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              ANI   0BFh   
                    PRS1:     RST   5   
                              JMP   prstr   
                    E_DOLLAR:   POP   D   ; "$" ran into a NUL: drop the return address,
                              POP   H   ;   and put the string's address back in TOS
                              MVI   A,"Q"   
                              JMP   error   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              RST   5   
                              MVI   A,10   
                              RST   5   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?". Keeps BC, DE, HL.
                    CHKBRK:   CALL   getk   
                              RZ      
                              CPI   3   
                              STA   KEYBUF   
                              RNZ      
                              XRA   A   
                              STA   KEYBUF   
                              POP   D   ; Ctrl-C. Drop the return address; the cell on
                              POP   H   ;   top of the stack is the TOS that rpushd
                              MVI   A,"B"   ;   was about to bring back
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              RST   1   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              RST   5   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              RST   5   
                              POP   D   
                              POP   H   
                              PUSH   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   H   ; the text, as it is: 16 characters, or fewer
                              MVI   B,16   ;   if the line or the program ends first
                    ER4:      MOV   A,M   
                              INX   H   
                              ORA   A   
                              JZ   er5   
                              CPI   13   
                              JZ   er5   
                              CPI   10   
                              JZ   er5   
02F1                          ENDIF      
02F1                          IF   CHECKED*CPM   
                              CPI   1Ah   ; (the ^Z that pads a file's last record ends
                              JZ   er5   ;   the text too: some terminals clear the
02F1                          ENDIF      ;   screen on it)
02F1                          IF   CHECKED   
                              RST   5   
                              DCR   B   
                              JNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LXI   H,0   
                              DAD   SP   
                              XCHG      
                              LXI   H,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
                              CALL   phalf   ;   first value and holds nothing): the depth
                              MVI   A,":"   
                              RST   5   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              RST   5   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                              ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
02F1                          ENDIF      
02F1                             ; =============================================================================
02F1                             ;  Startup
02F1                             ; =============================================================================
02F1                START:       
02F1                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
02F1                          ENDIF      
02F1                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
02F1                          ENDIF      
02F1                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   H,vecs   ; the RST routines go down into page zero
                              LXI   D,0008h   
                              MVI   B,vecend-vecs   
                    CPY:      MOV   A,M   
                              STAX   D   
                              INX   H   
                              INX   D   
                              DCR   B   
                              JNZ   cpy   
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
02F1                          ENDIF      
02F1                          IFN   CPM   
02F1   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
02F4   7E           FNUL:     MOV   A,M   
02F5   23                     INX   H   
02F6   B7                     ORA   A   
02F7   C2 F4 02               JNZ   fnul   
02FA                          ENDIF      
02FA   22 7C 82               SHLD   HEAP   
02FD                          IF   CHECKED   
                              RST   4   ; minus the heap"s first address: "_' may not
                              SHLD   NPEND   ;   release below it
02FD                          ENDIF      
02FD   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
0300   22 34 82               SHLD   RSP   
0303   01 00 83               LXI   B,PROG   ; the IP
0306   F7                     RST   6   ; (its return address is thrown away)
0307                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0307                          ENDIF      
0307                IMGEND:      


