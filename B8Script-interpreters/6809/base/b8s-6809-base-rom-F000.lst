F2AF   7E F0 E6               JMP   pollk   ; the break check, at every loop-back
F2B2                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
F2B2                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F2B2                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F2B2                             ; (base leaves out a cross term whose high byte is 0, which most
F2B2                             ; multiplications have: a count or a small constant.)
F2B2                          IF   1-QK   
                    H_MUL:    LDA   3,U   
                              LDB   ,U   
                              MUL      ; al*bh
                              STB   ,U   ; (bh is no longer needed)
                              LDA   2,U   
                              LDB   1,U   
                              MUL      ; ah*bl
                              ADDB   ,U   
                              STB   ,U   ; the cross terms, low byte
F2B2                          ENDIF      
F2B2                          IF   QK   
F2B2   A6 43        H_MUL:    LDA   3,U   
F2B4   E6 C4                  LDB   ,U   
F2B6   27 03                  BEQ   mu1   ; bh = 0: no al*bh (and ,U is 0 already)
F2B8   3D                     MUL      ; al*bh
F2B9   E7 C4                  STB   ,U   ; (bh is no longer needed)
F2BB   A6 42        MU1:      LDA   2,U   
F2BD   27 07                  BEQ   mu2   ; ah = 0: no ah*bl
F2BF   E6 41                  LDB   1,U   
F2C1   3D                     MUL      ; ah*bl
F2C2   EB C4                  ADDB   ,U   
F2C4   E7 C4                  STB   ,U   ; the cross terms, low byte
F2C6                MU2:         
F2C6                          ENDIF      
F2C6   A6 43                  LDA   3,U   
F2C8   E6 41                  LDB   1,U   
F2CA   3D                     MUL      ; al*bl
F2CB   AB C4                  ADDA   ,U   
F2CD   33 42                  LEAU   2,U   
F2CF   ED C4                  STD   ,U   
F2D1   39                     RTS      
F2D2                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F2D2   8D 18        H_GT:     BSR   h_swap   ; a > b is b < a
F2D4   8D 10        H_LT:     BSR   cmp   
F2D6   2D 02                  BLT   true   
F2D8   5F           FALSE:    CLRB      
F2D9   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F2DA   C6 FF        TRUE:     LDB   #0FFh   
F2DC   1D                     SEX      ; D = 0000 or FFFF
F2DD   ED C4                  STD   ,U   
F2DF   39                     RTS      
F2E0   8D 04        H_EQ:     BSR   cmp   
F2E2   27 F6                  BEQ   true   
F2E4   20 F2                  BRA   false   
F2E6   EC 42        CMP:      LDD   2,U   
F2E8   10 A3 C1               CMPD   ,U++   
F2EB   39                     RTS      
