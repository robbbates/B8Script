E268                             ; "!" ( n addr -- ) is "." with the high byte stored first. The cell in
E268                             ; memory is little-endian.
E268                             ; Checked: both bytes must be in the program's space, and they are tested
E268                             ; before either is stored (chkst stops with O, the stack untouched).
E268                          IF   1-CHECKED   
                    H_STORE:   PULU   X   
                              LDA   ,U   
                              STA   1,X   
E268                          ENDIF      
E268                          IF   CHECKED   
E268   AE C4        H_STORE:   LDX   ,U   
E26A   8D 13                  BSR   chkst   
E26C   30 01                  LEAX   1,X   
E26E   8D 0F                  BSR   chkst   
E270   A6 42                  LDA   2,U   
E272   A7 84                  STA   ,X   
E274                             ; and fall into ".", which loads X again (and checks it again)
E274                          ENDIF      
