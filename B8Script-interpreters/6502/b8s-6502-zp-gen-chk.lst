E61E   E5 03                  SBC   P+1   
E620   B0 16                  BCS   lc9   ; at the place
E622   B1 0A                  LDA   (Q),Y   
E624   C9 0A                  CMP   #10   
E626   D0 EA                  BNE   lc1   
E628   E6 08                  INC   D0   ; an LF: a new line starts after it
E62A   D0 02                  BNE   lc3   
E62C   E6 09                  INC   D1   
E62E   A5 0A        LC3:      LDA   Q   
E630   85 05                  STA   T1   
E632   A5 0B                  LDA   Q+1   
