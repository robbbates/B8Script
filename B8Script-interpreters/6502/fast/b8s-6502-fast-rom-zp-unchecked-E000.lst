E40A   B5 00                  LDA   0,X   
E40C   48                     PHA      
E40D   E8                     INX      
E40E   E8                     INX      
E40F   D0 0A                  BNE   nxt2   ; always: X is never 0
E411   68           H_FROMR:   PLA      
E412   68                     PLA      
E413   CA                     DEX      
E414   CA                     DEX      
E415   68                     PLA      
E416   95 00                  STA   0,X   
E418   68                     PLA      
E419   95 01                  STA   1,X   
E41B   4C 39 E2     NXT2:     JMP   next   
E41E                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E41E   4C F1 E2     H_NOT:    JMP   neg1   
E421   20 24 E4     H_XOR:    JSR   xr1   
