F36B   8D E4                  BSR   pmsg   
F36D   AC                     FCB   ","+80h   
F36E   8D 79                  BSR   pdec   ; the column
F370   8D DF                  BSR   pmsg   
F372   0D 8A                  FCB   13,10+80h   
F374                             ; the text at the place
F374   9E 36                  LDX   <AT   
F376   C6 10                  LDB   #16   
F378   A6 80        TX1:      LDA   ,X+   
F37A   27 0D                  BEQ   tx9   
F37C   81 0A                  CMPA   #10   
F37E   27 09                  BEQ   tx9   
F380   81 0D                  CMPA   #13   
F382   27 05                  BEQ   tx9   
F384   8D 7B                  BSR   putc   
F386   5A                     DECB      
F387   26 EF                  BNE   tx1   
F389   8D C6        TX9:      BSR   pmsg   
F38B   0D 0A 53 74 6B A0      FCB   13,10,"Stk"," "+80h   
