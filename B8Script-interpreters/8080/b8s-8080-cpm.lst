0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as line
0000                             ;                 and column, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 1  08h  rpop    pop the return stack into HL
0000                             ;    DROP   RST 3  18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 4  20h  neg16   HL = -HL
0000                             ;    PUTA   RST 5  28h  putc    print A
0000                             ;    NEXT   RST 6  30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone (CP/M keeps it for interrupts, and
0000                             ;  RomWBW's BIOS calls itself through RST 1): there the macros are CALLs, and
0000                             ;  DROP and NEXT are JMPs.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                EXIT:     EQU   0000h   ; warm boot
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with ORA A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE and HL.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC, and
                                 ; all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255;
0000                             ; the wait for a second Ctrl-C uses it too):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                BRKCNT:   EQU   LET+36h   ;   the break check's countdown;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                PSAVE:    EQU   LET+3Ah   ;   the checked build: the address "$" prints
0000                             ;   from, for a report
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls (see the header). asm80 can't nest IF, so these
0000                             ; are written with DS: a count of 0 writes nothing. DS can't take a label
0000                             ; that comes later, but EQU can, and DS can take that.
0000                AROP:     EQU   rpop   
0000                ADRP:     EQU   drp   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                ANXT:     EQU   next0   
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 1
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      1-CPM,0DFh      ;   RST 3
0000                 DS      CPM,0C3h        ;   JMP drp
0000                 DS      CPM,ADRP&0FFh
0000                 DS      CPM,ADRP/256
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 4
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 5
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   RST 6
0000                 DS      CPM,0C3h        ;   JMP next0
0000                 DS      CPM,ANXT&0FFh
0000                 DS      CPM,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   1-(1-CPM)*CHECKED   
0100   31 FC 07               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103   C3 2B 05               JMP   start   ; In the checked generic build this is at 0000h
0106                             ;   (and `start` sets SP): its first byte, C3h,
0106                             ;   is what an undefined word runs into, as
0106                             ;   CP/M's own JMP at 0000h is in a .COM: e_hi.
0106                          IF   (1-CPM)*CHECKED   
                              DB   0,0,0   ; 03  spare
0106                          ENDIF      
0106                          ;*Macro unroll: rdrop:  POPR                    ; 06  drop the top of the return stack, then
0106                RDROP:    DS   1-CPM,0CFh   ; 06  drop the top of the return stack, then
0106   CD                     DS   CPM,0CDh   
0107   0C                     DS   CPM,AROP&0FFh   
0108   01                     DS   CPM,AROP/256   
0109                          ;*Macro unroll:  DROP                    ;     drop TOS (a spent flag) and go on
0109                          DS   1-CPM,0DFh   ;     drop TOS (a spent flag) and go on
0109   C3                     DS   CPM,0C3h   
010A   1C                     DS   CPM,ADRP&0FFh   
010B   01                     DS   CPM,ADRP/256   
010C                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
010C   2A 34 08     RPOP:     LHLD   RSP   ; 08
010F   5E                     MOV   E,M   
0110   23                     INX   H   
0111   56                     MOV   D,M   
0112   23                     INX   H   
0113   22 34 08               SHLD   RSP   
0116   EB                     XCHG      
0117   C9                     RET      ; 13  (so RST 2 is not used)
0118   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0119   C3 06 05               JMP   rpushd   ;     brings up the new TOS
011C                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
011C                          IF   1-CPM   
                    RST18:    POP   D   ; 18  discard the RST's return address
011C                          ENDIF      
011C   E1           DRP:      POP   H   ;     new TOS = NOS
011D   C3 36 01               JMP   next0   
0120   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
0121                          ;*Macro unroll:  POPR
0121                          DS   1-CPM,0CFh   
0121   CD                     DS   CPM,0CDh   
0122   0C                     DS   CPM,AROP&0FFh   
0123   01                     DS   CPM,AROP/256   
0124                          ;*Macro unroll:  NEXT
0124                          DS   1-CPM,0F7h   
0124   C3                     DS   CPM,0C3h   
0125   36                     DS   CPM,ANXT&0FFh   
0126   01                     DS   CPM,ANXT/256   
0127                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0127   AF           NEG16:    XRA   A   ; 20
0128   95                     SUB   L   
0129   6F                     MOV   L,A   
012A   9F                     SBB   A   
012B   94                     SUB   H   
012C   67                     MOV   H,A   
012D   C9                     RET      
012E   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
012F                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
012F                          IFN   CPM   
                    RST28:       
                    PUTC:     JMP   CONOUT   ; 28
012F                          ENDIF      
012F                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
012F                             ; returns here, with its top cell on the stack: that becomes the new TOS.
012F   CD 2E 01     EXEC:     CALL   jphl   ; 2B
0132   E1                     POP   H   
0133                          ;*Macro unroll:  NEXT
0133                          DS   1-CPM,0F7h   
0133   C3                     DS   CPM,0C3h   
0134   36                     DS   CPM,ANXT&0FFh   
0135   01                     DS   CPM,ANXT/256   
0136                             ; ---- RST 6: next character --------------------------------------------------
0136                          IF   1-CPM   
                    RST30:    POP   D   ; 30  discard the RST's return address
0136                          ENDIF      
0136                             ; =============================================================================
0136                             ;  The inner loop: read one character and sort it by range.
0136                             ; 
0136                             ;    00h          end of program
0136                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0136                             ;    30h-39h      digit: read a whole number
0136                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0136                             ;    61h-7Ah      a-z: push the address of that letter's cell
0136                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0136                             ; =============================================================================
0136                NEXT0:       
0136                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0136                          ENDIF      
0136   0A                     LDAX   B   
0137   03                     INX   B   
0138   D6 21                  SUI   21h   ; A = c - 21h
013A   DA 7A 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CPI   0Fh   
013F   DA 6A 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
0142   D6 0F                  SUI   0Fh   ; A = c - 30h
0144   FE 0A                  CPI   0Ah   
0146   DA 4D 03               JC   digit   ; 30h-39h
0149   FE 11                  CPI   11h   
014B   DA 68 01               JC   p3a   ; 3Ah-40h
014E   D6 11                  SUI   11h   ; A = c - 41h
0150   FE 1A                  CPI   1Ah   
0152   DA FC 04               JC   upper   ; 41h-5Ah: A = letter index 0-25
0155   FE 20                  CPI   20h   
0157   DA 66 01               JC   p5b   ; 5Bh-60h
015A   FE 3A                  CPI   3Ah   
015C   DA F4 04               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
015F   FE 3E                  CPI   3Eh   
0161                          IF   CHECKED   
                              JZ   next0   ; 7Fh, DEL: ignored
                              JNC   e_hi   ; 80h-FFh: reserved
0161                          ENDIF      
0161                          IF   1-CHECKED   
0161   D2 36 01               JNC   next0   ; 7Fh-FFh: ignored
0164                          ENDIF      
0164   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0166   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
0168   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
016A                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
016A                             ; untouched, and A, DE free.
016A   C6 2D        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
016C   5F                     MOV   E,A   
016D   16 03                  MVI   D,PTAB / 256   
016F   FE 43                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0171   1A                     LDAX   D   
0172   5F                     MOV   E,A   ; the handler's low byte
0173                          IFN   CPM   
                              MVI   A,0   
                              RAL      ; its page: 0 + carry
0173                          ENDIF      
0173                          IF   CPM   
0173   3E 01                  MVI   A,1   
0175   CE 00                  ACI   0   ; its page: 1 + carry
0177                          ENDIF      
0177   57                     MOV   D,A   
0178   D5                     PUSH   D   ; jump to it; the stack is balanced again
0179   C9                     RET      ;   when the handler starts
017A                             ; ctl: characters below 21h. A = c - 21h.
017A   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
017C   C2 36 01               JNZ   next0   ; the rest are ignored
017F   C3 00 00     ENDPROG:   JMP   EXIT   ; the program has ended
0182                             ; =============================================================================
0182                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0182                             ;  (00bbIGFuZCA= are up among the RST routines.)
0182                             ; =============================================================================
0182   D1           H_XOR:    POP   D   
0183   7C                     MOV   A,H   
0184   AA                     XRA   D   
0185   67                     MOV   H,A   
0186   7D                     MOV   A,L   
0187   AB                     XRA   E   
0188   6F                     MOV   L,A   
0189                          ;*Macro unroll:  NEXT
0189                          DS   1-CPM,0F7h   
0189   C3                     DS   CPM,0C3h   
018A   36                     DS   CPM,ANXT&0FFh   
018B   01                     DS   CPM,ANXT/256   
018C   D1           H_OR:     POP   D   
018D   7C                     MOV   A,H   
018E   B2                     ORA   D   
018F   67                     MOV   H,A   
0190   7D                     MOV   A,L   
0191   B3                     ORA   E   
0192   6F                     MOV   L,A   
0193                          ;*Macro unroll:  NEXT
0193                          DS   1-CPM,0F7h   
0193   C3                     DS   CPM,0C3h   
0194   36                     DS   CPM,ANXT&0FFh   
0195   01                     DS   CPM,ANXT/256   
0196                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0196                H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0196   CD                     DS   CPM,0CDh   
0197   27                     DS   CPM,ANEG&0FFh   
0198   01                     DS   CPM,ANEG/256   
0199   2B                     DCX   H   
019A                          ;*Macro unroll:  NEXT
019A                          DS   1-CPM,0F7h   
019A   C3                     DS   CPM,0C3h   
019B   36                     DS   CPM,ANXT&0FFh   
019C   01                     DS   CPM,ANXT/256   
019D                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
019D                             ; the same either way); TOS is the old pointer.
019D   EB           H_ALLOC:   XCHG      
019E   2A 7C 08               LHLD   HEAP   
01A1   E5                     PUSH   H   
01A2   19                     DAD   D   ; the new top
01A3                          IF   CHECKED   
                              CALL   chkhp   
01A3                          ENDIF      
01A3   22 7C 08               SHLD   HEAP   
01A6   E1                     POP   H   
01A7                          ;*Macro unroll:  NEXT
01A7                          DS   1-CPM,0F7h   
01A7   C3                     DS   CPM,0C3h   
01A8   36                     DS   CPM,ANXT&0FFh   
01A9   01                     DS   CPM,ANXT/256   
01AA                          IF   1-CPM   
                                 ; ---- the letters and digits --------------------------------------------------
                                 ; a-z: push the cell's address (the cell is the variable)
                    LOWER:    PUSH   H   
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   1-CPM,0F7h   
                              DS   CPM,0C3h   
                              DS   CPM,ANXT&0FFh   
                              DS   CPM,ANXT/256   
                                 ; A-Z: call the word. The return address (the IP after the letter) goes on
                                 ; the return stack, and the IP becomes the address in the letter's cell.
                    UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   ; HL -> cell
                              MOV   D,B   
                              MOV   E,C   ; DE = the return address
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   ; IP = the word's body, and fall into rpushd
                                 ; rpushd: push DE on the return stack, then pop TOS off the data stack and
                                 ; go on. Every push of the return stack ends here: for a word call the cell
                                 ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
                                 ; the one that was used up.
                                 ; 
                                 ; The break key is looked at here, so at every word call and loop-back (and
                                 ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
                                 ; the keyboard can be slow (it is a BDOS call under CP/M).
                    RPUSHD:   LHLD   RSP   
                              DCX   H   
                              MOV   M,D   
                              DCX   H   
                              MOV   M,E   
                              SHLD   RSP   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXT
                              DS   1-CPM,0F7h   
                              DS   CPM,0C3h   
                              DS   CPM,ANXT&0FFh   
                              DS   CPM,ANXT/256   
01AA                          ENDIF      
01AA                             ; ---- machine code: the grave -----------------------------------------------
01AA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01AA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01AA                             ; written and its address is left. An odd last digit is consumed and dropped.
01AA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01AA                             ; code is entered by CALL with the data stack above the return address; it
01AA                             ; must keep BC, and on return the top cell becomes the new TOS.
01AA   CD 9E 04     H_GRAVE:   CALL   hexc   
01AD   D2 2F 01               JNC   exec   
01B0   87           HX1:      ADD   A   
01B1   87                     ADD   A   
01B2   87                     ADD   A   
01B3   87                     ADD   A   
01B4   57                     MOV   D,A   ; the high digit
01B5   CD 9E 04               CALL   hexc   
01B8   D2 C4 01               JNC   hx2   ; odd digit: consumed and dropped
01BB   B2                     ORA   D   
01BC   77                     MOV   M,A   
01BD   23                     INX   H   
01BE   CD 9E 04               CALL   hexc   
01C1   DA B0 01               JC   hx1   
01C4   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
01C6                          ;*Macro unroll:  NEXT
01C6                          DS   1-CPM,0F7h   
01C6   C3                     DS   CPM,0C3h   
01C7   36                     DS   CPM,ANXT&0FFh   
01C8   01                     DS   CPM,ANXT/256   
01C9                             ; ---- where the two pages meet ----------------------------------------------
01C9                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01C9                             ; are in falling code order for this), and where exactly differs between the
01C9                             ; builds: NPG1 follows. Every handler below these four must start in the
01C9                             ; second page, and every one above in the first; chktab.py checks both.
01C9                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
01C9                             ; while rpop uses HL, and the drop at the end brings it back.
01C9   E5           H_RET:    PUSH   H   
01CA                          ;*Macro unroll: ret2:   POPR
01CA                RET2:     DS   1-CPM,0CFh   
01CA   CD                     DS   CPM,0CDh   
01CB   0C                     DS   CPM,AROP&0FFh   
01CC   01                     DS   CPM,AROP/256   
01CD   44                     MOV   B,H   
01CE   4D                     MOV   C,L   
01CF                          ;*Macro unroll:  DROP
01CF                          DS   1-CPM,0DFh   
01CF   C3                     DS   CPM,0C3h   
01D0   1C                     DS   CPM,ADRP&0FFh   
01D1   01                     DS   CPM,ADRP/256   
01D2                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01D2                             ; drops the block start, "]" returns. No closer at all ends the program.
01D2                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
01D2   7C           H_BREAK:   MOV   A,H   
01D3   B5                     ORA   L   
01D4   CA C6 02               JZ   h_drop   ; false: just drop the flag
01D7   CD 6A 04               CALL   skip   
01DA   B7                     ORA   A   ; skip returns 0 for ")"
01DB   C2 CA 01               JNZ   ret2   
01DE   C3 06 01               JMP   rdrop   
01E1                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01E1                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01E1                             ; the body"s address instead. Either way it then skips to the matching "]'.
01E1                             ; (The unchecked build takes anything that is not a letter as the space; the
01E1                             ; checked build stops on it.)
01E1   0A           H_DEF:    LDAX   B   
01E2   03                     INX   B   
01E3   D6 41                  SUI   "A"   ; a letter gives 0-25 or 32-57: lowercase
01E5   5F                     MOV   E,A   ;   lands 64 bytes up
01E6   E6 DF                  ANI   0DFh   ; fold case
01E8   FE 1A                  CPI   26   
01EA   D2 FA 01               JNC   def2   ; not a letter
01ED   7B                     MOV   A,E   
01EE   87                     ADD   A   
01EF   5F                     MOV   E,A   
01F0   16 08                  MVI   D,LETPAGE   ; DE -> cell
01F2   79                     MOV   A,C   
01F3   12                     STAX   D   
01F4   1C                     INR   E   
01F5   78                     MOV   A,B   
01F6   12                     STAX   D   
01F7   C3 FD 01               JMP   skipnx   
01FA                DEF2:        
01FA                          IF   CHECKED   
                              MOV   A,E   
                              CPI   " "-"A"+256   
                              JNZ   e_brack   ; anything but a letter or a space
01FA                          ENDIF      
01FA   E5                     PUSH   H   ; an anonymous block: push its address
01FB   60                     MOV   H,B   
01FC   69                     MOV   L,C   
01FD                SKIPNX:      
01FD                          IF   CHECKED   
                              DCX   B   ; back onto the letter, so that skip finds its
01FD                          ENDIF      ;   opener, the "[", just before where it starts
01FD   CD 6A 04     SKIPO:    CALL   skip   
0200                          ;*Macro unroll:  NEXT
0200                          DS   1-CPM,0F7h   
0200   C3                     DS   CPM,0C3h   
0201   36                     DS   CPM,ANXT&0FFh   
0202   01                     DS   CPM,ANXT/256   
0203   5E           H_FETCH:   MOV   E,M   ; "@"
0204   23                     INX   H   
0205   56                     MOV   D,M   
0206   EB                     XCHG      
0207                          ;*Macro unroll:  NEXT
0207                          DS   1-CPM,0F7h   
0207   C3                     DS   CPM,0C3h   
0208   36                     DS   CPM,ANXT&0FFh   
0209   01                     DS   CPM,ANXT/256   
020A                             ; =============================================================================
020A                             ;  Handlers that must start in the image's second page.
020A                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
020A                             ;  tail may run past that page.
020A                             ; =============================================================================
020A                             ; ---- flow control ----------------------------------------------------------
020A                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
020A                             ; the matching ")".
020A   7C           H_OPEN:   MOV   A,H   
020B   B5                     ORA   L   
020C   E1                     POP   H   
020D   CA FD 01               JZ   skipo   
0210   E5                     PUSH   H   ; (rpushd pops it again)
0211   50                     MOV   D,B   
0212   59                     MOV   E,C   ; the block starts at the IP
0213   C3 06 05               JMP   rpushd   
0216                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0216                             ; drops it and carries on.
0216   7C           H_CLOSE:   MOV   A,H   
0217   B5                     ORA   L   
0218   CA 06 01               JZ   rdrop   
021B                          ;*Macro unroll:  POPR                    ; pop the block start ...
021B                          DS   1-CPM,0CFh   ; pop the block start ...
021B   CD                     DS   CPM,0CDh   
021C   0C                     DS   CPM,AROP&0FFh   
021D   01                     DS   CPM,AROP/256   
021E   44                     MOV   B,H   
021F   4D                     MOV   C,L   ; ... jump to it ...
0220   EB                     XCHG      
0221   C3 06 05               JMP   rpushd   ; ... and push it back (which drops the flag)
0224                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0224                             ; "-" has two jobs: directly before a digit it starts a negative number.
0224   0A           H_SUB:    LDAX   B   
0225   D6 30                  SUI   "0"   
0227   FE 0A                  CPI   10   
0229   DA 55 03               JC   negnum   
022C                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
022C                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
022C   CD                     DS   CPM,0CDh   
022D   27                     DS   CPM,ANEG&0FFh   
022E   01                     DS   CPM,ANEG/256   
022F   D1           H_ADD:    POP   D   
0230   19                     DAD   D   
0231                          ;*Macro unroll:  NEXT
0231                          DS   1-CPM,0F7h   
0231   C3                     DS   CPM,0C3h   
0232   36                     DS   CPM,ANXT&0FFh   
0233   01                     DS   CPM,ANXT/256   
0234   D1           H_AND:    POP   D   
0235   7C                     MOV   A,H   
0236   A2                     ANA   D   
0237   67                     MOV   H,A   
0238   7D                     MOV   A,L   
0239   A3                     ANA   E   
023A   6F                     MOV   L,A   
023B                          ;*Macro unroll:  NEXT
023B                          DS   1-CPM,0F7h   
023B   C3                     DS   CPM,0C3h   
023C   36                     DS   CPM,ANXT&0FFh   
023D   01                     DS   CPM,ANXT/256   
023E                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
023E                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
023E                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
023E                             ; SBB A turns a carry into -1 or 0 with no branch.
023E   E3           H_GT:     XTHL      ; a > b  is  b < a
023F   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0240   7B                     MOV   A,E   
0241   95                     SUB   L   
0242   7A                     MOV   A,D   
0243   9C                     SBB   H   
0244   9F                     SBB   A   ; A = -1 if DE < HL unsigned
0245   6F                     MOV   L,A   
0246   7C                     MOV   A,H   
0247   AA                     XRA   D   
0248   17                     RAL      ; carry = the signs differ
0249   9F                     SBB   A   
024A   AD                     XRA   L   ; flip when they do
024B   67                     MOV   H,A   
024C   6F                     MOV   L,A   
024D                          ;*Macro unroll:  NEXT
024D                          DS   1-CPM,0F7h   
024D   C3                     DS   CPM,0C3h   
024E   36                     DS   CPM,ANXT&0FFh   
024F   01                     DS   CPM,ANXT/256   
0250   D1           H_EQ:     POP   D   
0251   7D                     MOV   A,L   
0252   AB                     XRA   E   
0253   6F                     MOV   L,A   
0254   7C                     MOV   A,H   
0255   AA                     XRA   D   
0256   B5                     ORA   L   ; zero if equal
0257   D6 01                  SUI   1   ; carry only for zero
0259   9F                     SBB   A   
025A   67                     MOV   H,A   
025B   6F                     MOV   L,A   
025C                          ;*Macro unroll:  NEXT
025C                          DS   1-CPM,0F7h   
025C   C3                     DS   CPM,0C3h   
025D   36                     DS   CPM,ANXT&0FFh   
025E   01                     DS   CPM,ANXT/256   
025F                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
025F                             ; multiplier is used up; only the low 16 bits are kept.
025F   D1           H_MUL:    POP   D   ; DE = multiplicand
0260   C5                     PUSH   B   
0261   44                     MOV   B,H   
0262   4D                     MOV   C,L   ; BC = multiplier
0263   21 00 00               LXI   H,0   
0266   78           MUL1:     MOV   A,B   
0267   B7                     ORA   A   ; clear carry
0268   1F                     RAR      
0269   47                     MOV   B,A   
026A   79                     MOV   A,C   
026B   1F                     RAR      
026C   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
026D   D2 71 02               JNC   mul2   
0270   19                     DAD   D   
0271   EB           MUL2:     XCHG      
0272   29                     DAD   H   ; multiplicand << 1
0273   EB                     XCHG      
0274   78                     MOV   A,B   
0275   B1                     ORA   C   
0276   C2 66 02               JNZ   mul1   
0279   C1                     POP   B   
027A                          ;*Macro unroll:  NEXT
027A                          DS   1-CPM,0F7h   
027A   C3                     DS   CPM,0C3h   
027B   36                     DS   CPM,ANXT&0FFh   
027C   01                     DS   CPM,ANXT/256   
027D                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
027D                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
027D                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
027D                             ; stops on it.
027D                H_DIV:       
027D                          IF   CHECKED   
                              MOV   A,H   
                              ORA   L   
                              JZ   e_zero   
027D                          ENDIF      
027D   D1                     POP   D   ; DE = a, HL = b
027E   C5                     PUSH   B   
027F   7A                     MOV   A,D   
0280   B7                     ORA   A   
0281   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0282   AC                     XRA   H   
0283   F5                     PUSH   PSW   ; S flag = sign of q
0284   7C                     MOV   A,H   
0285   B7                     ORA   A   
0286   FC 27 01               CM   neg16   ; HL = |b|
0289   EB                     XCHG      
028A   7C                     MOV   A,H   
028B   B7                     ORA   A   
028C   FC 27 01               CM   neg16   ; HL = |a|, DE = |b|
028F   CD 76 03               CALL   udiv   ; HL = q, BC = r
0292   F1                     POP   PSW   
0293   FC 27 01               CM   neg16   ; q's sign
0296   EB                     XCHG      ; DE = q
0297   60                     MOV   H,B   
0298   69                     MOV   L,C   ; HL = r
0299   F1                     POP   PSW   
029A   FC 27 01               CM   neg16   ; r's sign
029D   C1                     POP   B   
029E   D5                     PUSH   D   ; q under r
029F                          ;*Macro unroll:  NEXT
029F                          DS   1-CPM,0F7h   
029F   C3                     DS   CPM,0C3h   
02A0   36                     DS   CPM,ANXT&0FFh   
02A1   01                     DS   CPM,ANXT/256   
02A2                             ; ---- stack and storage -----------------------------------------------------
02A2   E5           H_DUP:    PUSH   H   ; ":"
02A3                          ;*Macro unroll:  NEXT
02A3                          DS   1-CPM,0F7h   
02A3   C3                     DS   CPM,0C3h   
02A4   36                     DS   CPM,ANXT&0FFh   
02A5   01                     DS   CPM,ANXT/256   
02A6   E3           H_SWAP:   XTHL      ; "%"
02A7                          ;*Macro unroll:  NEXT
02A7                          DS   1-CPM,0F7h   
02A7   C3                     DS   CPM,0C3h   
02A8   36                     DS   CPM,ANXT&0FFh   
02A9   01                     DS   CPM,ANXT/256   
02AA                             ; (The checked build tests the address before it takes the value off the
02AA                             ; stack, so that an error report shows both.)
02AA                H_STORE:      ; "!" ( n addr -- )
02AA                          IF   CHECKED   
                              CALL   chkst   
02AA                          ENDIF      
02AA   D1                     POP   D   
02AB   73                     MOV   M,E   
02AC   23                     INX   H   
02AD   72                     MOV   M,D   
02AE                          ;*Macro unroll:  DROP
02AE                          DS   1-CPM,0DFh   
02AE   C3                     DS   CPM,0C3h   
02AF   1C                     DS   CPM,ADRP&0FFh   
02B0   01                     DS   CPM,ADRP/256   
02B1                H_CSTORE:      ; "." ( c addr -- )
02B1                          IF   CHECKED   
                              CALL   chkst   
02B1                          ENDIF      
02B1   D1                     POP   D   
02B2   73                     MOV   M,E   
02B3                          ;*Macro unroll:  DROP
02B3                          DS   1-CPM,0DFh   
02B3   C3                     DS   CPM,0C3h   
02B4   1C                     DS   CPM,ADRP&0FFh   
02B5   01                     DS   CPM,ADRP/256   
02B6                             ; ---- console ---------------------------------------------------------------
02B6                             ; 22h pushes the address of the text after it and skips the string.
02B6   E5           H_STR:    PUSH   H   
02B7   60                     MOV   H,B   
02B8   69                     MOV   L,C   
02B9   CD 91 04               CALL   skipstr   
02BC                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
02BC                          ENDIF      
02BC                          ;*Macro unroll:  NEXT
02BC                          DS   1-CPM,0F7h   
02BC   C3                     DS   CPM,0C3h   
02BD   36                     DS   CPM,ANXT&0FFh   
02BE   01                     DS   CPM,ANXT/256   
02BF                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02BF                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02BF                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02BF                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02BF                          IF   1-CHECKED   
02BF   C3 C9 03     H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
02C2                PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
02C2                PRAGAIN:   EQU   prlp   ;   the image's first two pages)
02C2                          ENDIF      
02C2                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   SHLD   PSAVE   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   1-CPM,0DFh   
                              DS   CPM,0C3h   
                              DS   CPM,ADRP&0FFh   
                              DS   CPM,ADRP/256   
02C2                          ENDIF      
02C2   7D           H_EMIT:   MOV   A,L   ; "'"
02C3                          ;*Macro unroll:  PUTA
02C3                          DS   1-CPM,0EFh   
02C3   CD                     DS   CPM,0CDh   
02C4   1D                     DS   CPM,APUT&0FFh   
02C5   05                     DS   CPM,APUT/256   
02C6                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
02C6                H_DROP:   DS   1-CPM,0DFh   ; ";" is this one byte
02C6   C3                     DS   CPM,0C3h   
02C7   1C                     DS   CPM,ADRP&0FFh   
02C8   01                     DS   CPM,ADRP/256   
02C9                             ; "#" prints TOS as a signed decimal number, with no space after it.
02C9   C5           H_NUM:    PUSH   B   
02CA   CD A8 03               CALL   psgn   
02CD   C1                     POP   B   
02CE                          ;*Macro unroll:  DROP
02CE                          DS   1-CPM,0DFh   
02CE   C3                     DS   CPM,0C3h   
02CF   1C                     DS   CPM,ADRP&0FFh   
02D0   01                     DS   CPM,ADRP/256   
02D1                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
