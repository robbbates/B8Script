0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        "/" leaves ( r q ), the quotient on top; dividing by zero is not
0000                             ;        checked. -n? does no more editing than Backspace.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    EXIT:     EQU   0000h   ; warm boot
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000   31 FE 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003                          IFN   CPM   
0003   01 00 83               LD   BC,PROG   ; 03  the IP
0006   18 67                  JR   st0   ; 06  (the rest of the startup is close by)
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 C8 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD D8 02               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 6E                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 16                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 70                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0A                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 62                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058   30 D7                  JR   NC,next0   ; 7Fh-FFh: ignored
005A   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005C   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005E   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0060                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0060                             ; untouched, and A, DE free.
0060   C6 AB        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0062   5F                     LD   E,A   
0063   16 02                  LD   D,PTAB / 256   
0065   FE C2                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0067   1A                     LD   A,(DE)   
0068   5F                     LD   E,A   ; the handler's low byte
0069                          IFN   CPM   
0069   16 00                  LD   D,0   
006B   CB 12                  RL   D   ; its page: 0 + carry
006D                          ENDIF      
006D                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
006D                          ENDIF      
006D   D5                     PUSH   DE   ; jump to it; the stack is balanced again
006E   C9                     RET      ;   when the handler starts
006F                             ; The rest of the startup: here so that the generic reset code can reach it
006F                             ; with JR. st0: find the program's NUL; the heap starts after it.
006F                          IFN   CPM   
006F   60           ST0:      LD   H,B   
0070   69                     LD   L,C   
0071   AF                     XOR   A   
0072   BE           ST1:      CP   (HL)   
0073   23                     INC   HL   
0074   20 FC                  JR   NZ,st1   
0076                          ENDIF      
0076   22 7C 82     ST2:      LD   (HEAP),HL   
0079   D9                     EXX      
007A   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
007D   D9                     EXX      
007E                          IF   CHECKED   
007E   AF                     XOR   A   
007F   32 36 82               LD   (KEYBUF),A   ; no key held back
0082                          ENDIF      
0082   F7                     RST   30h   ; (its return address is thrown away)
0083                             ; =============================================================================
0083                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0083                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0083                             ;  is here too: it belongs to "`" and makes the page come out right.
0083                             ; =============================================================================
0083   D1           H_XOR:    POP   DE   
0084   7C                     LD   A,H   
0085   AA                     XOR   D   
0086   67                     LD   H,A   
0087   7D                     LD   A,L   
0088   AB                     XOR   E   
0089   6F                     LD   L,A   
008A   F7                     RST   30h   
008B   D1           H_OR:     POP   DE   
008C   7C                     LD   A,H   
008D   B2                     OR   D   
008E   67                     LD   H,A   
008F   7D                     LD   A,L   
0090   B3                     OR   E   
0091   6F                     LD   L,A   
0092   F7                     RST   30h   
0093   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0094   2B                     DEC   HL   
0095   F7                     RST   30h   
0096                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
0096   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
009A   19                     ADD   HL,DE   ; the new top
009B                          IF   CHECKED   
009B   CD 08 03               CALL   chkhp   
009E                          ENDIF      
009E   22 7C 82               LD   (HEAP),HL   
00A1   EB                     EX   DE,HL   
00A2   F7                     RST   30h   
00A3   D9           EXEC:     EXX      
00A4   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00A7   D9                     EXX      
00A8   CD 2B 00               CALL   jphl   
00AB   D9                     EXX      
00AC   2A 34 82               LD   HL,(RSAVE)   
00AF   D9                     EXX      
00B0   E1                     POP   HL   
00B1   F7                     RST   30h   
00B2                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00B2                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00B2                             ; Digits: step back onto the first digit and read the whole number.
00B2   E5           DIGIT:    PUSH   HL   
00B3   0B                     DEC   BC   
00B4   CD 42 02               CALL   rdnum   
00B7   F7                     RST   30h   
00B8                             ; a-z: push the cell's address (the cell is the variable)
00B8   E5           LOWER:    PUSH   HL   
00B9   87                     ADD   A,A   
00BA   6F                     LD   L,A   
00BB   26 82                  LD   H,LETPAGE   
00BD   F7                     RST   30h   
00BE                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00BE                             ; the return stack, and the IP becomes the address in the letter's cell.
00BE   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00BF   EB                     EX   DE,HL   ; park TOS
00C0   87                     ADD   A,A   
00C1   6F                     LD   L,A   
00C2   26 82                  LD   H,LETPAGE   ; HL -> cell
00C4   4E                     LD   C,(HL)   
00C5   2C                     INC   L   
00C6   46                     LD   B,(HL)   ; IP = the word's body
00C7   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00C8                             ; rpushn: move the top cell of the data stack (in memory) to the return
00C8                             ; stack, then next. Everything that pushes the return stack ends here.
00C8                RPUSHN:      
00C8                          IF   CHECKED   
00C8   CD F0 02               CALL   chkbrk   ; Ctrl-C is checked at every word call, block
00CB                          ENDIF      ;   entry, loop-back and "{"
00CB   D9                     EXX      
00CC   D1                     POP   DE   
00CD   2B                     DEC   HL   
00CE   72                     LD   (HL),D   
00CF   2B                     DEC   HL   
00D0   73                     LD   (HL),E   
00D1   D9                     EXX      
00D2   F7                     RST   30h   
00D3                             ; ---- machine code: the grave -----------------------------------------------
00D3                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00D3                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00D3                             ; written and its address is left. An odd last digit is consumed and dropped.
00D3                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00D3                             ; code is entered by CALL with the data stack above the return address; it
00D3                             ; must keep BC, and on return the top cell becomes the new TOS.
00D3   CD 99 02     H_GRAVE:   CALL   hexc   
00D6   30 CB                  JR   NC,exec   
00D8                HX1:         
00D8                          IF   CHECKED   
00D8   CD FC 02               CALL   chkst   
00DB                          ENDIF      
00DB   77                     LD   (HL),A   ; the high digit goes in first ...
00DC   CD 99 02               CALL   hexc   
00DF   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00E1   ED 6F                  RLD      ;   overwrites it
00E3   23                     INC   HL   ; ... and RLD shifts it up under the low one
00E4   CD 99 02               CALL   hexc   
00E7   38 EF                  JR   C,hx1   
00E9                HX2:         
00E9                          IF   CHECKED   
00E9   CD FC 02               CALL   chkst   
00EC                          ENDIF      
00EC   36 C9                  LD   (HL),0C9h   
00EE   F7                     RST   30h   
00EF                             ; ---- where the two pages meet ----------------------------------------------
00EF                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00EF                             ; are in falling code order for this), and where exactly differs between the
00EF                             ; builds: NPG1 follows. Every handler below these four must start in the
00EF                             ; second page, and every one above in the first; chktab.py checks both.
00EF                             ; "]" returns: pop an address and jump to it.
00EF   CF           H_RET:    RST   08h   
00F0   42                     LD   B,D   
00F1   4B                     LD   C,E   
00F2   F7           BRK1:     RST   30h   
00F3                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00F3                             ; drops the block start, "]" returns. No closer at all ends the program.
00F3   7C           H_BREAK:   LD   A,H   
00F4   B5                     OR   L   
00F5   E1                     POP   HL   
00F6   28 FA                  JR   Z,brk1   
00F8   CD 64 02               CALL   skip   
00FB   B7                     OR   A   ; skip returns 0 for ")"
00FC   20 F1                  JR   NZ,h_ret   
00FE   CF           RDROP:    RST   08h   
00FF   F7                     RST   30h   
0100                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0100                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0100                             ; the body"s address instead. Either way it then skips to the matching "]'.
0100                             ; (The unchecked build takes anything below "A" as the space, and anything
0100                             ; from "A" up as a letter.)
0100   0A           H_DEF:    LD   A,(BC)   
0101   03                     INC   BC   
0102                          IF   CHECKED   
0102   FE 20                  CP   " "   
0104   28 18                  JR   Z,def2   
0106   5F                     LD   E,A   
0107   E6 DF                  AND   0DFh   ; fold case
0109   D6 41                  SUB   "A"   
010B   FE 1A                  CP   26   
010D   D2 1D 03               JP   NC,e_brack   ; anything but a letter or a space
0110   7B                     LD   A,E   
0111                          ENDIF      
0111   D6 41                  SUB   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
0113                          IF   1-CHECKED   
                              JR   C,def2   
0113                          ENDIF      
0113   87                     ADD   A,A   
0114   5F                     LD   E,A   
0115   16 82                  LD   D,LETPAGE   ; DE -> cell
0117   79                     LD   A,C   
0118   12                     LD   (DE),A   
0119   1C                     INC   E   
011A   78                     LD   A,B   
011B   12                     LD   (DE),A   
011C   18 03                  JR   skipnx   
011E   E5           DEF2:     PUSH   HL   ; an anonymous block: push its address
011F   60                     LD   H,B   
0120   69                     LD   L,C   
0121   CD 64 02     SKIPNX:   CALL   skip   
0124   F7                     RST   30h   
0125   5E           H_FETCH:   LD   E,(HL)   ; "@"
0126   23                     INC   HL   
0127   56                     LD   D,(HL)   
0128   EB                     EX   DE,HL   
0129   F7                     RST   30h   
012A                             ; =============================================================================
012A                             ;  Handlers that must start in the image's second page.
012A                             ;  "?" is the last (with "," inside it), so its long tail may run past that
012A                             ;  page.
012A                             ; =============================================================================
012A                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
012A                             ; the matching ")".
012A   7C           H_OPEN:   LD   A,H   
012B   B5                     OR   L   
012C   E1                     POP   HL   
012D   28 F2                  JR   Z,skipnx   
012F   C5                     PUSH   BC   ; the block starts at the IP
0130   18 96                  JR   rpushn   
0132                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0132                             ; drops it and carries on.
0132   7C           H_CLOSE:   LD   A,H   
0133   B5                     OR   L   
0134   E1                     POP   HL   
0135   28 C7                  JR   Z,rdrop   
0137   CF                     RST   08h   ; pop the block start ...
0138   42                     LD   B,D   
0139   4B                     LD   C,E   
013A   C5                     PUSH   BC   
013B   18 8B                  JR   rpushn   ; ... and push it back
013D                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
013D                             ; "-" has two jobs: directly before a digit it starts a negative number.
013D   0A           H_SUB:    LD   A,(BC)   
013E   D6 30                  SUB   "0"   
0140   FE 0A                  CP   10   
0142   38 04                  JR   C,negnum   
0144   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0145   D1           H_ADD:    POP   DE   
0146   19                     ADD   HL,DE   
0147   F7                     RST   30h   
0148   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0149   CD 42 02               CALL   rdnum   
014C   E7                     RST   20h   
014D   F7                     RST   30h   
014E   D1           H_AND:    POP   DE   
014F   7C                     LD   A,H   
0150   A2                     AND   D   
0151   67                     LD   H,A   
0152   7D                     LD   A,L   
0153   A3                     AND   E   
0154   6F                     LD   L,A   
0155   F7                     RST   30h   
0156                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0156                             ; cells first. Flipping both sign bits turns a signed compare into an
0156                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0156                             ; carry into -1 or 0 with no branch.
0156   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0157   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0158   7C                     LD   A,H   
0159   EE 80                  XOR   80h   
015B   67                     LD   H,A   
015C   7A                     LD   A,D   
015D   EE 80                  XOR   80h   
015F   57                     LD   D,A   
0160   ED 52                  SBC   HL,DE   ; carry if HL < DE
0162   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0164   F7                     RST   30h   
0165   D1           H_EQ:     POP   DE   
0166   B7                     OR   A   
0167   ED 52                  SBC   HL,DE   
0169   7C                     LD   A,H   
016A   B5                     OR   L   
016B   FE 01                  CP   1   ; carry only if a - b = 0
016D   18 F3                  JR   tf   
016F                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
016F                             ; multiplier shifts up through A:C.
016F   D1           H_MUL:    POP   DE   ; DE = multiplicand
0170   C5                     PUSH   BC   
0171   7C                     LD   A,H   
0172   4D                     LD   C,L   ; A:C = multiplier
0173   21 00 00               LD   HL,0   
0176   06 10                  LD   B,16   
0178   29           MUL1:     ADD   HL,HL   
0179   CB 21                  SLA   C   
017B   17                     RLA      
017C   30 01                  JR   NC,mul2   
017E   19                     ADD   HL,DE   
017F   10 F7        MUL2:     DJNZ   mul1   
0181   C1                     POP   BC   
0182   F7                     RST   30h   
0183                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
0183                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0183                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0183   D1           H_DIV:    POP   DE   ; DE = a, HL = b
0184   C5                     PUSH   BC   ; free BC for udiv
0185   D5                     PUSH   DE   ; a, for r's sign
0186   7A                     LD   A,D   
0187   AC                     XOR   H   
0188   F5                     PUSH   AF   ; S flag = sign of q
0189   CB 7C                  BIT   7,H   
018B   C4 20 00               CALL   NZ,neg16   ; HL = |b|
018E   EB                     EX   DE,HL   
018F   CB 7C                  BIT   7,H   
0191   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0194   CD 29 02               CALL   udiv   ; HL = q, DE = r
0197   F1                     POP   AF   
0198   FC 20 00               CALL   M,neg16   ; q's sign
019B   EB                     EX   DE,HL   ; HL = r, DE = q
019C   F1                     POP   AF   ; A = a's high byte
019D   B7                     OR   A   
019E   FC 20 00               CALL   M,neg16   ; r's sign
01A1   EB                     EX   DE,HL   ; HL = q, DE = r
01A2   C1                     POP   BC   
01A3   D5                     PUSH   DE   ; r under q
01A4   F7                     RST   30h   
01A5                             ; ---- stack and storage -----------------------------------------------------
01A5   E5           H_DUP:    PUSH   HL   ; ":"
01A6   F7                     RST   30h   
01A7   E3           H_SWAP:   EX   (SP),HL   ; "%"
01A8   F7                     RST   30h   
01A9   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
01AA                          IF   CHECKED   
01AA   CD FC 02               CALL   chkst   
01AD                          ENDIF      
01AD   73                     LD   (HL),E   
01AE   DF           H_DROP:   RST   18h   ; ";" is this one byte
01AF   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
01B0                          IF   CHECKED   
01B0   23                     INC   HL   ; both bytes must be in the program's space
01B1   CD FC 02               CALL   chkst   
01B4   2B                     DEC   HL   
01B5                          ENDIF      
01B5   73                     LD   (HL),E   
01B6   23                     INC   HL   
01B7   72                     LD   (HL),D   
01B8   DF                     RST   18h   
01B9                             ; ---- console ---------------------------------------------------------------
01B9                             ; 22h pushes the address of the text after it and skips the string.
01B9   E5           H_STR:    PUSH   HL   
01BA   60                     LD   H,B   
01BB   69                     LD   L,C   
01BC   CD 59 02               CALL   skipstr   
01BF   F7                     RST   30h   
01C0                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01C0                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01C0                             ; bit 6, so // and /" give themselves).
01C0   7E           H_PRINT:   LD   A,(HL)   
01C1   23                     INC   HL   
01C2   FE 22                  CP   22h   
01C4   28 0D                  JR   Z,pr9   
01C6   FE 2F                  CP   "/"   
01C8   20 04                  JR   NZ,pr1   
01CA   7E                     LD   A,(HL)   
01CB   23                     INC   HL   
01CC   E6 BF                  AND   0BFh   
01CE   EF           PR1:      RST   28h   
01CF   18 EF                  JR   h_print   
01D1   7D           H_EMIT:   LD   A,L   ; "'"
01D2   EF                     RST   28h   
01D3   DF           PR9:      RST   18h   
01D4                             ; "#" prints TOS as a signed decimal number, with no space after it.
01D4   CB 7C        H_NUM:    BIT   7,H   
01D6   28 04                  JR   Z,num1   
01D8   3E 2D                  LD   A,"-"   
01DA   EF                     RST   28h   
01DB   E7                     RST   20h   
01DC   C5           NUM1:     PUSH   BC   
01DD   CD 87 02               CALL   pdec   
01E0   C1                     POP   BC   
01E1   DF                     RST   18h   
01E2                             ; "?" ( n -- c ) or ( -n -- addr )
01E2                             ;   n > 0: wait about n ms for a key; 0 if none came
01E2                             ;   n = 0: wait for a key
01E2                             ;   n < 0: read a line of at most -n characters, with echo. n is not
01E2                             ;          checked: the buffer holds 127 characters and the CR, so a
01E2                             ;          program must ask for 127 or fewer.
01E2   CB 7C        H_KEY:    BIT   7,H   
01E4   20 19                  JR   NZ,line   
01E6   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01E8   CD CB 02     KT2:      CALL   getk   
01EB   20 0E                  JR   NZ,kt3   
01ED   1D                     DEC   E   
01EE   20 F8                  JR   NZ,kt2   
01F0   7C                     LD   A,H   ; 0? never counts down: it waits
01F1   B5                     OR   L   
01F2   28 F2                  JR   Z,kt1   
01F4   2B                     DEC   HL   
01F5   7C                     LD   A,H   
01F6   B5                     OR   L   
01F7   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01F9   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01FA   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01FB   6F           KT3:      LD   L,A   
01FC   26 00                  LD   H,0   
01FE   F7                     RST   30h   
01FF                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     XOR   A   
                              SUB   L   ; A = the count (TOS is minus the count)
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
01FF                          ENDIF      
01FF                          IFN   CPM   
01FF                             ; Generic: Backspace takes the last character back (and is echoed as
01FF                             ; it is), CR ends (stored, not echoed), every other key is stored and
01FF                             ; echoed until the line is full. The line buffer starts at offset 80h
01FF                             ; of its page, so L alone is the place in the line: D holds the L of
01FF                             ; a full line.
01FF   3E 80        LINE:     LD   A,LINEBUF & 0FFh   
0201   95                     SUB   L   ; (TOS is minus the count)
0202   57                     LD   D,A   ; D = the L of a full line
0203   21 80 82               LD   HL,LINEBUF   
0206   CD CB 02     LN2:      CALL   getk   
0209   28 FB                  JR   Z,ln2   
020B   FE 0D                  CP   13   
020D   28 16                  JR   Z,ln5   
020F   FE 08                  CP   8   
0211   28 0B                  JR   Z,ln4   
0213   5F                     LD   E,A   
0214   7D                     LD   A,L   
0215   BA                     CP   D   
0216   28 EE                  JR   Z,ln2   ; full
0218   73                     LD   (HL),E   
0219   2C                     INC   L   
021A   7B                     LD   A,E   
021B   EF           LN3:      RST   28h   
021C   18 E8                  JR   ln2   
021E   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
021F   FA 1B 02               JP   M,ln3   ;   unless the line was empty (L left the
0222   2C                     INC   L   ;   upper half of the page)
0223   18 E1                  JR   ln2   
0225   77           LN5:      LD   (HL),A   ; the CR
0226   2E 80                  LD   L,LINEBUF & 0FFh   
0228   F7                     RST   30h   
0229                          ENDIF      
0229                             ; =============================================================================
0229                             ;  More routines (no handler starts past this point)
0229                             ; =============================================================================
0229                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0229                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0229                             ; while the quotient bits arrive at the bottom of C.
0229   7C           UDIV:     LD   A,H   
022A   4D                     LD   C,L   
022B   21 00 00               LD   HL,0   
022E   06 10                  LD   B,16   
0230   CB 21        UDV1:     SLA   C   
0232   17                     RLA      
0233   ED 6A                  ADC   HL,HL   
0235   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0237   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0239   19                     ADD   HL,DE   ; too much: put it back, and cancel the
023A   0D                     DEC   C   ;   INC below
023B   0C           UDV2:     INC   C   ; a quotient bit
023C   10 F2                  DJNZ   udv1   
023E   EB                     EX   DE,HL   ; DE = remainder
023F   67                     LD   H,A   
0240   69                     LD   L,C   ; HL = quotient
0241   C9                     RET      
0242                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0242                             ; non-digit. Values wrap at 16 bits, as the spec says.
0242   21 00 00     RDNUM:    LD   HL,0   
0245   0A           RDN1:     LD   A,(BC)   
0246   D6 30                  SUB   "0"   
0248   FE 0A                  CP   10   
024A   D0                     RET   NC   
024B   03                     INC   BC   
024C   54                     LD   D,H   
024D   5D                     LD   E,L   
024E   29                     ADD   HL,HL   
024F   29                     ADD   HL,HL   
0250   19                     ADD   HL,DE   
0251   29                     ADD   HL,HL   ; HL * 10
0252   5F                     LD   E,A   
0253   16 00                  LD   D,0   
0255   19                     ADD   HL,DE   
0256   18 ED                  JR   rdn1   
0258                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0258                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0258   03           SS0:      INC   BC   
0259   0A           SKIPSTR:   LD   A,(BC)   
025A   03                     INC   BC   
025B   FE 2F                  CP   "/"   
025D   28 F9                  JR   Z,ss0   
025F   FE 22                  CP   22h   
0261   20 F6                  JR   NZ,skipstr   
0263   C9                     RET      
0264                             ; skip: read past text to the closer at this level, and return A = 0 if it
0264                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0264                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0264                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0264                             ; anyway). D counts the open levels, starting at 1 for the one we are in.
0264   16 01        SKIP:     LD   D,1   
0266   0A           SK1:      LD   A,(BC)   
0267   03                     INC   BC   
0268   B7                     OR   A   
0269   CA 15 00               JP   Z,endprog   
026C   FE 22                  CP   22h   
026E   CC 59 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0271   D6 28                  SUB   "("   
0273   28 0F                  JR   Z,sk3   
0275   3D                     DEC   A   ; ")"
0276   28 08                  JR   Z,sk4   
0278   D6 32                  SUB   "["-")"   
027A   28 08                  JR   Z,sk3   
027C   FE 02                  CP   "]"-"["   
027E   20 E6                  JR   NZ,sk1   
0280   15           SK4:      DEC   D   
0281   C8                     RET   Z   ; the closer at this level
0282   18 E2                  JR   sk1   
0284   14           SK3:      INC   D   
0285   18 DF                  JR   sk1   
0287                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0287                             ; Uses BC.
0287   11 0A 00     PDEC:     LD   DE,10   
028A   CD 29 02               CALL   udiv   ; HL = HL / 10, E = the last digit
028D   7B                     LD   A,E   
028E   F5                     PUSH   AF   
028F   7C                     LD   A,H   
0290   B5                     OR   L   
0291   C4 87 02               CALL   NZ,pdec   
0294   F1                     POP   AF   
0295   C6 30                  ADD   A,"0"   
0297   EF                     RST   28h   
0298   C9                     RET      
0299                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0299                             ; and return its value in A with the carry set; otherwise leave the IP and
0299                             ; return with the carry clear.
0299   0A           HEXC:     LD   A,(BC)   
029A   D6 30                  SUB   "0"   
029C   FE 0A                  CP   10   
029E   38 09                  JR   C,hc1   
02A0   E6 DF                  AND   0DFh   
02A2   D6 11                  SUB   11h   
02A4   FE 06                  CP   6   
02A6   D0                     RET   NC   
02A7   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02A9   03           HC1:      INC   BC   
02AA   C9                     RET      
02AB                             ; =============================================================================
02AB                             ;  Dispatch table: the low byte of each handler's address, in code order.
02AB                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02AB                             ; =============================================================================
02AB                             ; The handlers of the first NPG1 characters start in the image's second page.
02AB                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02AB                             ; differs between the builds, so the count is worked out here.
02AB                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02AB                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02AB                PGBRK:    EQU   (h_break-BASE)/256   
02AB                PGDEF:    EQU   (h_def-BASE)/256   
02AB                PGFET:    EQU   (h_fetch-BASE)/256   
02AB                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02AB   AF           PTAB:     DB   h_store & 0FFh   ; !
02AC   B9                     DB   h_str & 0FFh   ; "
02AD   D4                     DB   h_num & 0FFh   ; #
02AE   C0                     DB   h_print & 0FFh   ; $
02AF   A7                     DB   h_swap & 0FFh   ; %
02B0   4E                     DB   h_and & 0FFh   ; &
02B1   D1                     DB   h_emit & 0FFh   ; '
02B2   2A                     DB   h_open & 0FFh   ; (
02B3   32                     DB   h_close & 0FFh   ; )
02B4   6F                     DB   h_mul & 0FFh   ; *
02B5   45                     DB   h_add & 0FFh   ; +
02B6   FA                     DB   h_cfetch & 0FFh   ; ,
02B7   3D                     DB   h_sub & 0FFh   ; -
02B8   A9                     DB   h_cstore & 0FFh   ; .
02B9   83                     DB   h_div & 0FFh   ; /
02BA   A5                     DB   h_dup & 0FFh   ; :
02BB   AE                     DB   h_drop & 0FFh   ; ;
02BC   56                     DB   h_lt & 0FFh   ; <
02BD   65                     DB   h_eq & 0FFh   ; =
02BE   57                     DB   h_gt & 0FFh   ; >
02BF   E2                     DB   h_key & 0FFh   ; ?
02C0   25                     DB   h_fetch & 0FFh   ; @
02C1   00                     DB   h_def & 0FFh   ; [
02C2   F3                     DB   h_break & 0FFh   ; \
02C3   EF                     DB   h_ret & 0FFh   ; ]
02C4   83                     DB   h_xor & 0FFh   ; ^
02C5   96                     DB   h_alloc & 0FFh   ; _
02C6   D3                     DB   h_grave & 0FFh   ; `
02C7   2C                     DB   h_tor & 0FFh   ; {
02C8   8B                     DB   h_or & 0FFh   ; |
02C9   1C                     DB   h_fromr & 0FFh   ; }
02CA   93                     DB   h_not & 0FFh   ; ~
02CB                PTABEND:      
02CB                             ; =============================================================================
02CB                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02CB                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
02CB                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
02CB                             ;  KEY and CONOUT routines themselves.
02CB                             ; =============================================================================
02CB                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
02CB                          ENDIF      
02CB                          IF   CHECKED   
02CB   E5           GETK:     PUSH   HL   ; a key held back by the break check goes
02CC   21 36 82               LD   HL,KEYBUF   ;   first, and is taken out of the buffer
02CF   7E                     LD   A,(HL)   
02D0   36 00                  LD   (HL),0   
02D2   E1                     POP   HL   
02D3   B7                     OR   A   
02D4   C0                     RET   NZ   
02D5                          ENDIF      
02D5                          IF   (1-CPM)*CHECKED   
02D5   C3 06 FF               JP   KEY   
02D8                          ENDIF      
02D8                          IF   CPM*(1-CHECKED)   
                    GETK:        
02D8                          ENDIF      
02D8                          IF   CPM   
                              LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
02D8                          ENDIF      
02D8                             ; =============================================================================
02D8                             ;  Checked build: the checks and the error report
02D8                             ; =============================================================================
02D8                          IF   CHECKED   
02D8                             ; chkstk: both stacks are checked once per character, not in every handler.
02D8                             ; Each stack lives in one page, so it has overrun exactly when the pointer's
02D8                             ; high byte has left that page. Errors are caught one cell late at most; the
02D8                             ; page below each stack is a guard band. (The call itself is on the data
02D8                             ; stack, but in the same page whenever the stack is in range.)
02D8   ED 73 38 82  CHKSTK:   LD   (SPTMP),SP   
02DC   3A 39 82               LD   A,(SPTMP+1)   
02DF   FE 81                  CP   DSPAGE   
02E1   20 31                  JR   NZ,e_stack   
02E3   D9                     EXX      ; the return stack: in its page, and not
02E4   7D                     LD   A,L   ;   above its empty position (an underflow
02E5   FE E1                  CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
02E7   7C                     LD   A,H   ;   guard band)
02E8   D9                     EXX      
02E9   30 2C                  JR   NC,e_rstack   
02EB   FE 80                  CP   RSPAGE   
02ED   C8                     RET   Z   
02EE   18 27                  JR   e_rstack   
02F0                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
02F0                             ; else is held for the next "?".
02F0   CD CB 02     CHKBRK:   CALL   getk   
02F3   C8                     RET   Z   
02F4   FE 03                  CP   3   
02F6   28 22                  JR   Z,e_break   
02F8   32 36 82               LD   (KEYBUF),A   
02FB   C9                     RET      
02FC                             ; chkst: stop unless HL is in the program's own space: from the letter page
02FC                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
02FC                             ; whatever lies above the limit are safe. Memory above the heap top but
02FC                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
02FC                             ; Keeps every register.
02FC   F5           CHKST:    PUSH   AF   
02FD   7C                     LD   A,H   
02FE   FE 82                  CP   LETPAGE   
0300   38 0F                  JR   C,e_store   
0302                          ENDIF      
0302                          IF   CHECKED*(1-CPM)   
0302   FE F0                  CP   HEAPLIM   
0304   30 0B                  JR   NC,e_store   
0306                          ENDIF      
0306                          IF   CHECKED*CPM   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   H   
                              JR   C,e_store   
0306                          ENDIF      
0306                          IF   CHECKED   
0306   F1                     POP   AF   
0307   C9                     RET      
0308                             ; chkhp: stop if working out the new heap top carried (a negative count
0308                             ; wraps: too big), or if the new top in HL is not below the limit page.
0308   38 04        CHKHP:    JR   C,e_heap   
030A                          ENDIF      
030A                          IF   CHECKED*(1-CPM)   
030A   7C                     LD   A,H   
030B   FE F0                  CP   HEAPLIM   
030D   D8                     RET   C   
030E                          ENDIF      
030E                          IF   CHECKED*CPM   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              RET   NC   
030E                          ENDIF      
030E                          IF   CHECKED   
030E                             ; Error entries. Each loads its letter and then hides the next entry inside
030E                             ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
030E   3E 48        E_HEAP:   LD   A,"H"   ; heap past the limit
0310   21                     DB   21h   
0311   3E 57        E_STORE:   LD   A,"W"   ; write outside the program's space
0313   21                     DB   21h   
0314   3E 53        E_STACK:   LD   A,"S"   ; data stack over or under
0316   21                     DB   21h   
0317   3E 52        E_RSTACK:   LD   A,"R"   ; return stack over or under
0319   21                     DB   21h   
031A   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C
031C   21                     DB   21h   
031D   3E 44        E_BRACK:   LD   A,"D"   ; bad character after [
031F                             ; error: print the letter in A, " @ " and the offset in the program of the
031F                             ; character just read, then end. For example: S @ 245
031F   31 FE 81     ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
0322   EF                     RST   28h   
0323   3E 20                  LD   A," "   
0325   EF                     RST   28h   
0326   3E 40                  LD   A,"@"   
0328   EF                     RST   28h   
0329   3E 20                  LD   A," "   
032B   EF                     RST   28h   
032C   21 FF 7C               LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
032F   09                     ADD   HL,BC   ;   just read: HL = its offset
0330   CD 87 02               CALL   pdec   
0333   C3 15 00               JP   endprog   
0336                          ENDIF      
0336                             ; =============================================================================
0336                             ;  CP/M startup (the generic build starts at address 0: see st0)
0336                             ; =============================================================================
0336                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:    LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0336                          ENDIF      
0336                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0336                          ENDIF      
0336                IMGEND:      


